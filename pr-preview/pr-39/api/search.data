:53435,"_37177":53438,"_37179":53441,"_37181":53444,"_37183":53447,"_37185":53450,"_37187":53453,"_37189":53456,"_37191":53459,"_37193":53462,"_37195":53465,"_37197":53468,"_37199":53471,"_37201":53474,"_37203":53477,"_37205":53480,"_37207":53483,"_37209":53486,"_37211":53489,"_37214":53492,"_37216":53495,"_37218":53498,"_37220":53501},{"_3162":15,"_27842":15,"_5":13585,"_2660":45217,"_28185":45218,"_19309":45222,"_25368":15},"Deploy from AWS Marketplace",[45219,45220,45221],"Docs","Deployment","Other models",[],{"_3162":16,"_27842":15,"_19309":45224,"_5":13254,"_25368":15,"_2660":45225},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3162":17,"_27842":15,"_5":28182,"_19309":45227,"_25368":45228,"_2660":45229},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3162":18,"_27842":15,"_5":28182,"_19309":45231,"_25368":45232,"_2660":45233},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3162":19,"_27842":15,"_5":28182,"_19309":45235,"_25368":45236,"_2660":45237},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3162":20,"_27842":15,"_5":28182,"_19309":45239,"_25368":45240,"_2660":45241},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3162":21,"_27842":15,"_5":28182,"_19309":45243,"_25368":45244,"_2660":45245},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3162":22,"_27842":15,"_5":28182,"_19309":45247,"_25368":45248,"_2660":45249},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3162":23,"_27842":15,"_5":28182,"_19309":45251,"_25368":45252,"_2660":45253},[],"/docs/pr-preview/pr-39/deployment/aws-marketplace#next-step","Next step",{"_3162":24,"_27842":15,"_19309":45255,"_5":13254,"_25368":15,"_2660":45256},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3162":25,"_27842":15,"_19309":45258,"_5":13254,"_25368":45228,"_2660":45259},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3162":26,"_27842":15,"_19309":45261,"_5":13254,"_25368":45228,"_2660":45262},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3162":27,"_27842":15,"_19309":45264,"_5":13254,"_25368":45228,"_2660":45265},[],"A security group allowing the necessary endpoints.",{"_3162":28,"_27842":15,"_19309":45267,"_5":13254,"_25368":45232,"_2660":45268},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3162":29,"_27842":15,"_19309":45270,"_5":13254,"_25368":45232,"_2660":45271},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3162":30,"_27842":15,"_19309":45273,"_5":13254,"_25368":45232,"_2660":45274},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3162":31,"_27842":15,"_19309":45276,"_5":13254,"_25368":45236,"_2660":45277},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3162":32,"_27842":15,"_19309":45279,"_5":13254,"_25368":45240,"_2660":45280},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3162":33,"_27842":15,"_19309":45282,"_5":13254,"_25368":45244,"_2660":45283},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3162":34,"_27842":15,"_19309":45285,"_5":13254,"_25368":45248,"_2660":45286},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3162":35,"_27842":15,"_19309":45288,"_5":13254,"_25368":45252,"_2660":45289},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3162":36,"_27842":36,"_5":13585,"_2660":45291,"_28185":45292,"_19309":45293,"_25368":36},"Deploy Lamassu",[45219,45220],[],{"_3162":37,"_27842":36,"_19309":45295,"_5":13254,"_25368":36,"_2660":45296},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3162":38,"_27842":36,"_5":28182,"_19309":45298,"_25368":45299,"_2660":45300},[],"/docs/pr-preview/pr-39/deployment/overview#choose-a-model","Choose a model",{"_3162":39,"_27842":36,"_5":28182,"_19309":45302,"_25368":45303,"_2660":45304},[],"/docs/pr-preview/pr-39/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3162":40,"_27842":36,"_5":28182,"_19309":45306,"_25368":45307,"_2660":45308},[],"/docs/pr-preview/pr-39/deployment/overview#after-deployment","After deployment",{"_3162":41,"_27842":36,"_19309":45310,"_5":13254,"_25368":36,"_2660":45311},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3162":42,"_27842":36,"_19309":45313,"_5":13254,"_25368":45299,"_2660":45314},[],"Model",{"_3162":43,"_27842":36,"_19309":45316,"_5":13254,"_25368":45299,"_2660":45317},[],"Recommended for",{"_3162":44,"_27842":36,"_19309":45319,"_5":13254,"_25368":45299,"_2660":45320},[],"Who operates the infrastructure",{"_3162":45,"_27842":36,"_19309":45322,"_5":13254,"_25368":45299,"_2660":45323},[],"Starting point",{"_3162":46,"_27842":36,"_19309":45325,"_5":13254,"_25368":45299,"_2660":45326},[],"Kubernetes self-managed",{"_3162":47,"_27842":36,"_19309":45328,"_5":13254,"_25368":45299,"_2660":45329},[],"Production, regulated environments and custom deployments",{"_3162":48,"_27842":36,"_19309":45331,"_5":13254,"_25368":45299,"_2660":45332},[],"Your team",{"_3162":49,"_27842":36,"_19309":45334,"_5":13254,"_25368":45299,"_2660":45335},[],"Helm or Fastlane",{"_3162":50,"_27842":36,"_19309":45337,"_5":13254,"_25368":45299,"_2660":45338},[],"AWS Marketplace",{"_3162":51,"_27842":36,"_19309":45340,"_5":13254,"_25368":45299,"_2660":45341},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3162":52,"_27842":36,"_19309":45343,"_5":13254,"_25368":45299,"_2660":45332},[],{"_3162":53,"_27842":36,"_19309":45345,"_5":13254,"_25368":45299,"_2660":45346},[],"Preconfigured image on EC2",{"_3162":54,"_27842":36,"_19309":45348,"_5":13254,"_25368":45299,"_2660":45349},[],"SaaS",{"_3162":55,"_27842":36,"_19309":45351,"_5":13254,"_25368":45299,"_2660":45352},[],"Teams that want to use the platform without operating it",{"_3162":56,"_27842":36,"_19309":45354,"_5":13254,"_25368":45299,"_2660":45355},[],"Lamassu",{"_3162":57,"_27842":36,"_19309":45357,"_5":13254,"_25368":45299,"_2660":45358},[],"Managed subscription",{"_3162":58,"_27842":36,"_19309":45360,"_5":13254,"_25368":45299,"_2660":45361},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3162":59,"_27842":36,"_19309":45363,"_5":13254,"_25368":45299,"_2660":45364},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3162":60,"_27842":36,"_19309":45366,"_5":13254,"_25368":45299,"_2660":45367},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3162":61,"_27842":36,"_19309":45369,"_5":13254,"_25368":45303,"_2660":45370},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3162":62,"_27842":36,"_19309":45372,"_5":13254,"_25368":45307,"_2660":45373},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3162":63,"_27842":63,"_5":13585,"_2660":45375,"_28185":45376,"_19309":45377,"_25368":63},"Use Lamassu as SaaS",[45219,45220,45221],[],{"_3162":64,"_27842":63,"_19309":45379,"_5":13254,"_25368":63,"_2660":45380},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3162":65,"_27842":63,"_5":28182,"_19309":45382,"_25368":45383,"_2660":45384},[],"/docs/pr-preview/pr-39/deployment/saas#what-the-service-manages","What the service manages",{"_3162":66,"_27842":63,"_5":28182,"_19309":45386,"_25368":45387,"_2660":45388},[],"/docs/pr-preview/pr-39/deployment/saas#plans","Plans",{"_3162":67,"_27842":63,"_5":28182,"_19309":45390,"_25368":45391,"_2660":45392},[],"/docs/pr-preview/pr-39/deployment/saas#request-access","Request access",{"_3162":68,"_27842":63,"_19309":45394,"_5":13254,"_25368":63,"_2660":45395},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3162":69,"_27842":63,"_19309":45397,"_5":13254,"_25368":45383,"_2660":45398},[],"Platform availability and maintenance.",{"_3162":70,"_27842":63,"_19309":45400,"_5":13254,"_25368":45383,"_2660":45401},[],"Automatic backups.",{"_3162":71,"_27842":63,"_19309":45403,"_5":13254,"_25368":45383,"_2660":45404},[],"Version upgrades.",{"_3162":72,"_27842":63,"_19309":45406,"_5":13254,"_25368":45383,"_2660":45407},[],"Technical support and SLA according to your plan.",{"_3162":73,"_27842":63,"_19309":45409,"_5":13254,"_25368":45387,"_2660":45410},[],"Plan",{"_3162":74,"_27842":63,"_19309":45412,"_5":13254,"_25368":45387,"_2660":45413},[],"Devices",{"_3162":75,"_27842":63,"_19309":45415,"_5":13254,"_25368":45387,"_2660":45416},[],"Support",{"_3162":76,"_27842":63,"_19309":45418,"_5":13254,"_25368":45387,"_2660":45419},[],"SLA",{"_3162":77,"_27842":63,"_19309":45421,"_5":13254,"_25368":45387,"_2660":45422},[],"Starter",{"_3162":78,"_27842":63,"_19309":45424,"_5":13254,"_25368":45387,"_2660":45425},[],"Up to 1,000",{"_3162":79,"_27842":63,"_19309":45427,"_5":13254,"_25368":45387,"_2660":45428},[],"Email",{"_3162":80,"_27842":63,"_19309":45430,"_5":13254,"_25368":45387,"_2660":45431},[],"99.5 %",{"_3162":81,"_27842":63,"_19309":45433,"_5":13254,"_25368":45387,"_2660":45434},[],"Professional",{"_3162":82,"_27842":63,"_19309":45436,"_5":13254,"_25368":45387,"_2660":45437},[],"Up to 10,000",{"_3162":83,"_27842":63,"_19309":45439,"_5":13254,"_25368":45387,"_2660":45440},[],"Email and chat",{"_3162":84,"_27842":63,"_19309":45442,"_5":13254,"_25368":45387,"_2660":45443},[],"99.9 %",{"_3162":85,"_27842":63,"_19309":45445,"_5":13254,"_25368":45387,"_2660":45446},[],"Enterprise",{"_3162":86,"_27842":63,"_19309":45448,"_5":13254,"_25368":45387,"_2660":45449},[],"Unlimited",{"_3162":87,"_27842":63,"_19309":45451,"_5":13254,"_25368":45387,"_2660":45452},[],"Dedicated",{"_3162":88,"_27842":63,"_19309":45454,"_5":13254,"_25368":45387,"_2660":45455},[],"99.99 %",{"_3162":89,"_27842":63,"_19309":45457,"_5":13254,"_25368":45391,"_2660":45458},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3162":90,"_27842":63,"_19309":45460,"_5":13254,"_25368":45391,"_2660":45461},[],"When you receive your instance's credentials, continue with Get started.",{"_3162":91,"_27842":91,"_5":13585,"_2660":45463,"_28185":45464,"_19309":45465,"_25368":91},"Fastlane",[45219,45220,45326],[],{"_3162":92,"_27842":91,"_19309":45467,"_5":13254,"_25368":91,"_2660":45468},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3162":93,"_27842":91,"_5":28182,"_19309":45470,"_25368":45471,"_2660":45472},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3162":94,"_27842":91,"_5":28182,"_19309":45474,"_25368":45475,"_2660":45476},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3162":95,"_27842":91,"_5":28182,"_19309":45478,"_25368":45479,"_2660":45229},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#before-you-begin",{"_3162":96,"_27842":91,"_5":28182,"_19309":45481,"_25368":45482,"_2660":45483},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3162":97,"_27842":91,"_5":28182,"_19309":45485,"_25368":45486,"_2660":45487},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3162":98,"_27842":91,"_5":28182,"_19309":45489,"_25368":45490,"_2660":45491},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3162":99,"_27842":91,"_5":28182,"_19309":45493,"_25368":45494,"_2660":45495},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3162":100,"_27842":91,"_5":28182,"_19309":45497,"_25368":45498,"_2660":45499},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3162":101,"_27842":91,"_5":28182,"_19309":45501,"_25368":45502,"_2660":45503},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3162":102,"_27842":91,"_5":28182,"_19309":45505,"_25368":45506,"_2660":45507},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3162":103,"_27842":91,"_5":28182,"_19309":45509,"_25368":45510,"_2660":45511},[],"/docs/pr-preview/pr-39/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3162":104,"_27842":91,"_19309":45513,"_5":13254,"_25368":45471,"_2660":45514},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3162":105,"_27842":91,"_19309":45516,"_5":13254,"_25368":45471,"_2660":45517},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3162":106,"_27842":91,"_19309":45519,"_5":13254,"_25368":45475,"_2660":45520},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3162":107,"_27842":91,"_19309":45522,"_5":13254,"_25368":45475,"_2660":45523},[],"Fastlane installs or configures",{"_3162":108,"_27842":91,"_19309":45525,"_5":13254,"_25368":45475,"_2660":45526},[],"You still provide",{"_3162":109,"_27842":91,"_19309":45528,"_5":13254,"_25368":45475,"_2660":45529},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3162":110,"_27842":91,"_19309":45531,"_5":13254,"_25368":45475,"_2660":45532},[],"The Kubernetes cluster, nodes and persistent storage",{"_3162":111,"_27842":91,"_19309":45534,"_5":13254,"_25368":45475,"_2660":45535},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3162":112,"_27842":91,"_19309":45537,"_5":13254,"_25368":45475,"_2660":45538},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3162":113,"_27842":91,"_19309":45540,"_5":13254,"_25368":45475,"_2660":45541},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3162":114,"_27842":91,"_19309":45543,"_5":13254,"_25368":45475,"_2660":45544},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3162":115,"_27842":91,"_19309":45546,"_5":13254,"_25368":45475,"_2660":45547},[],"Optional observability and lab HSM components",{"_3162":116,"_27842":91,"_19309":45549,"_5":13254,"_25368":45475,"_2660":45550},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3162":117,"_27842":91,"_19309":45552,"_5":13254,"_25368":45475,"_2660":45553},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3162":118,"_27842":91,"_19309":45555,"_5":13254,"_25368":45479,"_2660":45556},[],"You need:",{"_3162":119,"_27842":91,"_19309":45558,"_5":13254,"_25368":45479,"_2660":45559},[],"an existing Kubernetes cluster",{"_3162":120,"_27842":91,"_19309":45561,"_5":13254,"_25368":45479,"_2660":45562},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3162":121,"_27842":91,"_19309":45564,"_5":13254,"_25368":45479,"_2660":45565},[],"`yq`",{"_3162":122,"_27842":91,"_19309":45567,"_5":13254,"_25368":45479,"_2660":21871},[],{"_3162":123,"_27842":91,"_19309":45569,"_5":13254,"_25368":45479,"_2660":45570},[],"`jq` only when using `--sample-data` or `--development`",{"_3162":124,"_27842":91,"_19309":45572,"_5":13254,"_25368":45479,"_2660":45573},[],"`ssh-keygen` only when using `--with-hsm`",{"_3162":125,"_27842":91,"_19309":45575,"_5":13254,"_25368":45479,"_2660":45576},[],"free external ports 80 and 443 on a single-node K3s host",{"_3162":126,"_27842":91,"_19309":45578,"_5":13254,"_25368":45479,"_2660":45579},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3162":127,"_27842":91,"_19309":45581,"_5":13254,"_25368":45479,"_2660":45582},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3162":128,"_27842":91,"_19309":45584,"_5":13254,"_25368":45482,"_2660":45585},[],"Run the script from a clone of the Helm repository:",{"_3162":129,"_27842":91,"_19309":45587,"_5":13254,"_25368":45482,"_2660":45588},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3162":130,"_27842":91,"_19309":45590,"_5":13254,"_25368":45486,"_2660":45591},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3162":131,"_27842":91,"_19309":45593,"_5":13254,"_25368":45486,"_2660":45594},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3162":132,"_27842":91,"_19309":45596,"_5":13254,"_25368":45486,"_2660":45597},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3162":133,"_27842":91,"_19309":45599,"_5":13254,"_25368":45486,"_2660":45600},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3162":134,"_27842":91,"_19309":45602,"_5":13254,"_25368":45490,"_2660":45603},[],"Option",{"_3162":135,"_27842":91,"_19309":45605,"_5":13254,"_25368":45490,"_2660":45606},[],"Default",{"_3162":136,"_27842":91,"_19309":45608,"_5":13254,"_25368":45490,"_2660":45609},[],"Purpose",{"_3162":137,"_27842":91,"_19309":45611,"_5":13254,"_25368":45490,"_2660":45612},[],"`-h`, `--help`",{"_3162":138,"_27842":91,"_19309":45614,"_5":13254,"_25368":45490,"_2660":45615},[],"—",{"_3162":139,"_27842":91,"_19309":45617,"_5":13254,"_25368":45490,"_2660":45618},[],"Show help",{"_3162":140,"_27842":91,"_19309":45620,"_5":13254,"_25368":45490,"_2660":45621},[],"`-c`, `--context`",{"_3162":141,"_27842":91,"_19309":45623,"_5":13254,"_25368":45490,"_2660":45624},[],"current context",{"_3162":142,"_27842":91,"_19309":45626,"_5":13254,"_25368":45490,"_2660":45627},[],"Select the kubeconfig context for kubectl and Helm",{"_3162":143,"_27842":91,"_19309":45629,"_5":13254,"_25368":45490,"_2660":45630},[],"`-n`, `--non-interactive`",{"_3162":144,"_27842":91,"_19309":45632,"_5":13254,"_25368":45490,"_2660":5931},[],{"_3162":145,"_27842":91,"_19309":45634,"_5":13254,"_25368":45490,"_2660":45635},[],"Skip prompts and generate dependency credentials",{"_3162":146,"_27842":91,"_19309":45637,"_5":13254,"_25368":45490,"_2660":45638},[],"`-ns`, `--namespace`",{"_3162":147,"_27842":91,"_19309":45640,"_5":13254,"_25368":45490,"_2660":45641},[],"`lamassu-dev`",{"_3162":148,"_27842":91,"_19309":45643,"_5":13254,"_25368":45490,"_2660":45644},[],"Namespace for the installation",{"_3162":149,"_27842":91,"_19309":45646,"_5":13254,"_25368":45490,"_2660":45647},[],"`-d`, `--domain`",{"_3162":150,"_27842":91,"_19309":45649,"_5":13254,"_25368":45490,"_2660":45650},[],"`dev.lamassu.io`",{"_3162":151,"_27842":91,"_19309":45652,"_5":13254,"_25368":45490,"_2660":45653},[],"Domain used by the UI, OIDC and certificate",{"_3162":152,"_27842":91,"_19309":45655,"_5":13254,"_25368":45490,"_2660":45656},[],"`-v`, `--version`",{"_3162":153,"_27842":91,"_19309":45658,"_5":13254,"_25368":45490,"_2660":13879},[],{"_3162":154,"_27842":91,"_19309":45660,"_5":13254,"_25368":45490,"_2660":45661},[],"Lamassu chart version",{"_3162":155,"_27842":91,"_19309":45663,"_5":13254,"_25368":45490,"_2660":45664},[],"`--https-port`",{"_3162":156,"_27842":91,"_19309":45666,"_5":13254,"_25368":45490,"_2660":45667},[],"`443`",{"_3162":157,"_27842":91,"_19309":45669,"_5":13254,"_25368":45490,"_2660":45670},[],"Gateway HTTPS listener port",{"_3162":158,"_27842":91,"_19309":45672,"_5":13254,"_25368":45490,"_2660":45673},[],"`--http-port`",{"_3162":159,"_27842":91,"_19309":45675,"_5":13254,"_25368":45490,"_2660":45676},[],"`80`",{"_3162":160,"_27842":91,"_19309":45678,"_5":13254,"_25368":45490,"_2660":45679},[],"Gateway HTTP listener port",{"_3162":161,"_27842":91,"_19309":45681,"_5":13254,"_25368":45490,"_2660":45682},[],"`--tls-crt`",{"_3162":162,"_27842":91,"_19309":45684,"_5":13254,"_25368":45490,"_2660":45615},[],{"_3162":163,"_27842":91,"_19309":45686,"_5":13254,"_25368":45490,"_2660":45687},[],"PEM certificate for downstream TLS",{"_3162":164,"_27842":91,"_19309":45689,"_5":13254,"_25368":45490,"_2660":45690},[],"`--tls-key`",{"_3162":165,"_27842":91,"_19309":45692,"_5":13254,"_25368":45490,"_2660":45615},[],{"_3162":166,"_27842":91,"_19309":45694,"_5":13254,"_25368":45490,"_2660":45695},[],"PEM private key for downstream TLS",{"_3162":167,"_27842":91,"_19309":45697,"_5":13254,"_25368":45490,"_2660":45698},[],"`-l`, `--local-chart-path`",{"_3162":168,"_27842":91,"_19309":45700,"_5":13254,"_25368":45490,"_2660":45701},[],"repository chart",{"_3162":169,"_27842":91,"_19309":45703,"_5":13254,"_25368":45490,"_2660":45704},[],"Use an unpacked local Lamassu chart",{"_3162":170,"_27842":91,"_19309":45706,"_5":13254,"_25368":45490,"_2660":45707},[],"`-ip`, `--gateway-ip`",{"_3162":171,"_27842":91,"_19309":45709,"_5":13254,"_25368":45490,"_2660":7984},[],{"_3162":172,"_27842":91,"_19309":45711,"_5":13254,"_25368":45490,"_2660":45712},[],"Override the address written to `gateway.addresses`",{"_3162":173,"_27842":91,"_19309":45714,"_5":13254,"_25368":45490,"_2660":45715},[],"`--otel`",{"_3162":174,"_27842":91,"_19309":45717,"_5":13254,"_25368":45490,"_2660":5931},[],{"_3162":175,"_27842":91,"_19309":45719,"_5":13254,"_25368":45490,"_2660":45720},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3162":176,"_27842":91,"_19309":45722,"_5":13254,"_25368":45490,"_2660":45723},[],"`--development`",{"_3162":177,"_27842":91,"_19309":45725,"_5":13254,"_25368":45490,"_2660":5931},[],{"_3162":178,"_27842":91,"_19309":45727,"_5":13254,"_25368":45490,"_2660":45728},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3162":179,"_27842":91,"_19309":45730,"_5":13254,"_25368":45490,"_2660":45731},[],"`--sample-data`",{"_3162":180,"_27842":91,"_19309":45733,"_5":13254,"_25368":45490,"_2660":5931},[],{"_3162":181,"_27842":91,"_19309":45735,"_5":13254,"_25368":45490,"_2660":45736},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3162":182,"_27842":91,"_19309":45738,"_5":13254,"_25368":45490,"_2660":45739},[],"`--with-hsm`",{"_3162":183,"_27842":91,"_19309":45741,"_5":13254,"_25368":45490,"_2660":5931},[],{"_3162":184,"_27842":91,"_19309":45743,"_5":13254,"_25368":45490,"_2660":45744},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3162":185,"_27842":91,"_19309":45746,"_5":13254,"_25368":45490,"_2660":45747},[],"`--softhsm-chart-path`",{"_3162":186,"_27842":91,"_19309":45749,"_5":13254,"_25368":45490,"_2660":45750},[],"`./charts/softhsm`",{"_3162":187,"_27842":91,"_19309":45752,"_5":13254,"_25368":45490,"_2660":45753},[],"Use a different local SoftHSM chart",{"_3162":188,"_27842":91,"_19309":45755,"_5":13254,"_25368":45490,"_2660":45756},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3162":189,"_27842":91,"_19309":45758,"_5":13254,"_25368":45494,"_2660":45759},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3162":190,"_27842":91,"_19309":45761,"_5":13254,"_25368":45494,"_2660":45762},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3162":191,"_27842":91,"_19309":45764,"_5":13254,"_25368":45494,"_2660":45765},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3162":192,"_27842":91,"_19309":45767,"_5":13254,"_25368":45494,"_2660":45768},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3162":193,"_27842":91,"_19309":45770,"_5":13254,"_25368":45494,"_2660":45771},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3162":194,"_27842":91,"_19309":45773,"_5":13254,"_25368":45494,"_2660":45774},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3162":195,"_27842":91,"_19309":45776,"_5":13254,"_25368":45498,"_2660":45777},[],"Fastlane:",{"_3162":196,"_27842":91,"_19309":45779,"_5":13254,"_25368":45498,"_2660":45780},[],"validates local tools and the selected cluster",{"_3162":197,"_27842":91,"_19309":45782,"_5":13254,"_25368":45498,"_2660":45783},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3162":198,"_27842":91,"_19309":45785,"_5":13254,"_25368":45498,"_2660":45786},[],"creates the namespace",{"_3162":199,"_27842":91,"_19309":45788,"_5":13254,"_25368":45498,"_2660":45789},[],"installs PostgreSQL and creates the required databases",{"_3162":200,"_27842":91,"_19309":45791,"_5":13254,"_25368":45498,"_2660":45792},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3162":201,"_27842":91,"_19309":45794,"_5":13254,"_25368":45498,"_2660":45795},[],"installs RabbitMQ",{"_3162":202,"_27842":91,"_19309":45797,"_5":13254,"_25368":45498,"_2660":45798},[],"optionally installs observability and lab HSM components",{"_3162":203,"_27842":91,"_19309":45800,"_5":13254,"_25368":45498,"_2660":45801},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3162":204,"_27842":91,"_19309":45803,"_5":13254,"_25368":45498,"_2660":45804},[],"optionally loads sample data",{"_3162":205,"_27842":91,"_19309":45806,"_5":13254,"_25368":45498,"_2660":45807},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3162":206,"_27842":91,"_19309":45809,"_5":13254,"_25368":45502,"_2660":45810},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3162":207,"_27842":91,"_19309":45812,"_5":13254,"_25368":45502,"_2660":45813},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3162":208,"_27842":91,"_19309":45815,"_5":13254,"_25368":45506,"_2660":45816},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3162":209,"_27842":91,"_19309":45818,"_5":13254,"_25368":45506,"_2660":45819},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3162":210,"_27842":91,"_19309":45821,"_5":13254,"_25368":45506,"_2660":45822},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3162":211,"_27842":91,"_19309":45824,"_5":13254,"_25368":45510,"_2660":45825},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3162":212,"_27842":212,"_5":13585,"_2660":45827,"_28185":45828,"_19309":45829,"_25368":212},"Install with Helm",[45219,45220,45326],[],{"_3162":213,"_27842":212,"_19309":45831,"_5":13254,"_25368":212,"_2660":45832},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3162":214,"_27842":212,"_5":28182,"_19309":45834,"_25368":45835,"_2660":45836},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3162":215,"_27842":212,"_5":28182,"_19309":45838,"_25368":45839,"_2660":45229},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#before-you-begin",{"_3162":216,"_27842":212,"_5":28182,"_19309":45841,"_25368":45842,"_2660":45843},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3162":217,"_27842":212,"_5":28182,"_19309":45845,"_25368":45846,"_2660":45847},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3162":218,"_27842":212,"_5":28182,"_19309":45849,"_25368":45850,"_2660":45851},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3162":219,"_27842":212,"_5":28182,"_19309":45853,"_25368":45854,"_2660":45855},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3162":220,"_27842":212,"_5":28182,"_19309":45857,"_25368":45858,"_2660":45859},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3162":221,"_27842":212,"_5":28182,"_19309":45861,"_25368":45862,"_2660":45863},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3162":222,"_27842":212,"_5":28182,"_19309":45865,"_25368":45866,"_2660":45867},[],"/docs/pr-preview/pr-39/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3162":223,"_27842":212,"_19309":45869,"_5":13254,"_25368":45835,"_2660":45870},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3162":224,"_27842":212,"_19309":45872,"_5":13254,"_25368":45839,"_2660":45873},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3162":225,"_27842":212,"_19309":45875,"_5":13254,"_25368":45839,"_2660":45876},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3162":226,"_27842":212,"_19309":45878,"_5":13254,"_25368":45839,"_2660":45879},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3162":227,"_27842":212,"_19309":45881,"_5":13254,"_25368":45839,"_2660":45882},[],"a reachable RabbitMQ broker and credentials",{"_3162":228,"_27842":212,"_19309":45884,"_5":13254,"_25368":45839,"_2660":45885},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3162":229,"_27842":212,"_19309":45887,"_5":13254,"_25368":45839,"_2660":45888},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3162":230,"_27842":212,"_19309":45890,"_5":13254,"_25368":45839,"_2660":45891},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3162":231,"_27842":212,"_19309":45893,"_5":13254,"_25368":45839,"_2660":45894},[],"a StorageClass and an external traffic design",{"_3162":232,"_27842":212,"_19309":45896,"_5":13254,"_25368":45839,"_2660":45897},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3162":233,"_27842":212,"_19309":45899,"_5":13254,"_25368":45839,"_2660":45900},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3162":234,"_27842":212,"_19309":45902,"_5":13254,"_25368":45839,"_2660":45903},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3162":235,"_27842":212,"_19309":45905,"_5":13254,"_25368":45842,"_2660":45906},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3162":236,"_27842":212,"_19309":45908,"_5":13254,"_25368":45842,"_2660":45909},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3162":237,"_27842":212,"_19309":45911,"_5":13254,"_25368":45842,"_2660":45912},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_3162":238,"_27842":212,"_19309":45914,"_5":13254,"_25368":45846,"_2660":45915},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3162":239,"_27842":212,"_19309":45917,"_5":13254,"_25368":45846,"_2660":45918},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3162":240,"_27842":212,"_19309":45920,"_5":13254,"_25368":45846,"_2660":45921},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3162":241,"_27842":212,"_19309":45923,"_5":13254,"_25368":45850,"_2660":45924},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_3162":242,"_27842":212,"_19309":45926,"_5":13254,"_25368":45854,"_2660":45927},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3162":243,"_27842":212,"_19309":45929,"_5":13254,"_25368":45854,"_2660":45930},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3162":244,"_27842":212,"_19309":45932,"_5":13254,"_25368":45854,"_2660":45933},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3162":245,"_27842":212,"_19309":45935,"_5":13254,"_25368":45854,"_2660":45936},[],"See Access control for the principal and policy model.",{"_3162":246,"_27842":212,"_19309":45938,"_5":13254,"_25368":45858,"_2660":45939},[],"To install a local checkout instead:",{"_3162":247,"_27842":212,"_19309":45941,"_5":13254,"_25368":45862,"_2660":45942},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3162":248,"_27842":212,"_19309":45944,"_5":13254,"_25368":45862,"_2660":45945},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3162":249,"_27842":212,"_19309":45947,"_5":13254,"_25368":45866,"_2660":45948},[],"Before going live, review:",{"_3162":250,"_27842":212,"_19309":45950,"_5":13254,"_25368":45866,"_2660":45951},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3162":251,"_27842":212,"_19309":45953,"_5":13254,"_25368":45866,"_2660":45954},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3162":252,"_27842":212,"_19309":45956,"_5":13254,"_25368":45866,"_2660":45957},[],"shared VA storage before increasing VA replicas",{"_3162":253,"_27842":212,"_19309":45959,"_5":13254,"_25368":45866,"_2660":45960},[],"managed OIDC roles and removal of evaluation credentials",{"_3162":254,"_27842":212,"_19309":45962,"_5":13254,"_25368":45866,"_2660":45963},[],"a trusted TLS issuer or externally managed certificate",{"_3162":255,"_27842":212,"_19309":45965,"_5":13254,"_25368":45866,"_2660":45966},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3162":256,"_27842":212,"_19309":45968,"_5":13254,"_25368":45866,"_2660":45969},[],"SMTP, observability and alert delivery",{"_3162":257,"_27842":212,"_19309":45971,"_5":13254,"_25368":45866,"_2660":45972},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3162":258,"_27842":212,"_19309":45974,"_5":13254,"_25368":45866,"_2660":45975},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3162":259,"_27842":259,"_5":13585,"_2660":45977,"_28185":45978,"_19309":45979,"_25368":259},"Expose the Gateway",[45219,45220,45326],[],{"_3162":260,"_27842":259,"_19309":45981,"_5":13254,"_25368":259,"_2660":45982},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3162":261,"_27842":259,"_5":28182,"_19309":45984,"_25368":45985,"_2660":45986},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3162":262,"_27842":259,"_5":28182,"_19309":45988,"_25368":45989,"_2660":45990},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3162":263,"_27842":259,"_5":28182,"_19309":45992,"_25368":45993,"_2660":45994},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3162":264,"_27842":259,"_5":28182,"_19309":45996,"_25368":45997,"_2660":45998},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#k3s","K3s",{"_3162":265,"_27842":259,"_5":28182,"_19309":46000,"_25368":46001,"_2660":46002},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3162":266,"_27842":259,"_5":28182,"_19309":46004,"_25368":46005,"_2660":46006},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3162":267,"_27842":259,"_5":28182,"_19309":46008,"_25368":46009,"_2660":46010},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3162":268,"_27842":259,"_5":28182,"_19309":46012,"_25368":46013,"_2660":46014},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3162":269,"_27842":259,"_5":28182,"_19309":46016,"_25368":46017,"_2660":46018},[],"/docs/pr-preview/pr-39/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3162":270,"_27842":259,"_19309":46020,"_5":13254,"_25368":45985,"_2660":46021},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3162":271,"_27842":259,"_19309":46023,"_5":13254,"_25368":45985,"_2660":46024},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3162":272,"_27842":259,"_19309":46026,"_5":13254,"_25368":45989,"_2660":46027},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3162":273,"_27842":259,"_19309":46029,"_5":13254,"_25368":45989,"_2660":46030},[],"Set it only when:",{"_3162":274,"_27842":259,"_19309":46032,"_5":13254,"_25368":45989,"_2660":46033},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3162":275,"_27842":259,"_19309":46035,"_5":13254,"_25368":45989,"_2660":46036},[],"that address is allocated to this Gateway",{"_3162":276,"_27842":259,"_19309":46038,"_5":13254,"_25368":45989,"_2660":46039},[],"the surrounding network already routes traffic for it to the cluster",{"_3162":277,"_27842":259,"_19309":46041,"_5":13254,"_25368":45989,"_2660":46042},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3162":278,"_27842":259,"_19309":46044,"_5":13254,"_25368":45989,"_2660":46045},[],"Keep these two settings separate:",{"_3162":279,"_27842":259,"_19309":46047,"_5":13254,"_25368":45989,"_2660":46048},[],"`gateway.addresses` requests an address for the Gateway.",{"_3162":280,"_27842":259,"_19309":46050,"_5":13254,"_25368":45989,"_2660":46051},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3162":281,"_27842":259,"_19309":46053,"_5":13254,"_25368":45989,"_2660":46054},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3162":282,"_27842":259,"_19309":46056,"_5":13254,"_25368":45993,"_2660":46057},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3162":283,"_27842":259,"_19309":46059,"_5":13254,"_25368":45993,"_2660":46060},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3162":284,"_27842":259,"_19309":46062,"_5":13254,"_25368":45997,"_2660":46063},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3162":285,"_27842":259,"_19309":46065,"_5":13254,"_25368":45997,"_2660":46066},[],"For the recommended design:",{"_3162":286,"_27842":259,"_19309":46068,"_5":13254,"_25368":45997,"_2660":46069},[],"Use only one externally exposed Lamassu Gateway.",{"_3162":287,"_27842":259,"_19309":46071,"_5":13254,"_25368":45997,"_2660":46072},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3162":288,"_27842":259,"_19309":46074,"_5":13254,"_25368":45997,"_2660":46075},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3162":289,"_27842":259,"_19309":46077,"_5":13254,"_25368":45997,"_2660":46078},[],"Point DNS at the VM's reachable address.",{"_3162":290,"_27842":259,"_19309":46080,"_5":13254,"_25368":45997,"_2660":46081},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3162":291,"_27842":259,"_19309":46083,"_5":13254,"_25368":46001,"_2660":46084},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3162":292,"_27842":259,"_19309":46086,"_5":13254,"_25368":46005,"_2660":46087},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3162":293,"_27842":259,"_19309":46089,"_5":13254,"_25368":46005,"_2660":46090},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3162":294,"_27842":259,"_19309":46092,"_5":13254,"_25368":46009,"_2660":46093},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3162":295,"_27842":259,"_19309":46095,"_5":13254,"_25368":46009,"_2660":46096},[],"Requirement",{"_3162":296,"_27842":259,"_19309":46098,"_5":13254,"_25368":46009,"_2660":46099},[],"Recommended design",{"_3162":297,"_27842":259,"_19309":46101,"_5":13254,"_25368":46009,"_2660":46102},[],"Consequence",{"_3162":298,"_27842":259,"_19309":46104,"_5":13254,"_25368":46009,"_2660":46105},[],"Several Lamassu URLs or services",{"_3162":299,"_27842":259,"_19309":46107,"_5":13254,"_25368":46009,"_2660":46108},[],"One Gateway with multiple routes",{"_3162":300,"_27842":259,"_19309":46110,"_5":13254,"_25368":46009,"_2660":46111},[],"One IP and one proxy fleet; this is the chart default",{"_3162":301,"_27842":259,"_19309":46113,"_5":13254,"_25368":46009,"_2660":46114},[],"Independent Gateways and separate external IPs",{"_3162":302,"_27842":259,"_19309":46116,"_5":13254,"_25368":46009,"_2660":46117},[],"One VIP per Gateway",{"_3162":303,"_27842":259,"_19309":46119,"_5":13254,"_25368":46009,"_2660":46120},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3162":304,"_27842":259,"_19309":46122,"_5":13254,"_25368":46009,"_2660":46123},[],"Independent Gateways on one node and one IP",{"_3162":305,"_27842":259,"_19309":46125,"_5":13254,"_25368":46009,"_2660":46126},[],"Use different external ports",{"_3162":306,"_27842":259,"_19309":46128,"_5":13254,"_25368":46009,"_2660":46129},[],"Clients must include non-standard ports",{"_3162":307,"_27842":259,"_19309":46131,"_5":13254,"_25368":46009,"_2660":46132},[],"Separate TLS/mTLS termination behind one IP",{"_3162":308,"_27842":259,"_19309":46134,"_5":13254,"_25368":46009,"_2660":46135},[],"Front-door SNI routing to internal Gateways",{"_3162":309,"_27842":259,"_19309":46137,"_5":13254,"_25368":46009,"_2660":46138},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3162":310,"_27842":259,"_19309":46140,"_5":13254,"_25368":46009,"_2660":46141},[],"Separate Gateway resources but shared proxy infrastructure",{"_3162":311,"_27842":259,"_19309":46143,"_5":13254,"_25368":46009,"_2660":46144},[],"Envoy merged-Gateway mode",{"_3162":312,"_27842":259,"_19309":46146,"_5":13254,"_25368":46009,"_2660":46147},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3162":313,"_27842":259,"_19309":46149,"_5":13254,"_25368":46009,"_2660":46150},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3162":314,"_27842":259,"_19309":46152,"_5":13254,"_25368":46009,"_2660":46153},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3162":315,"_27842":259,"_19309":46155,"_5":13254,"_25368":46009,"_2660":46156},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3162":316,"_27842":259,"_19309":46158,"_5":13254,"_25368":46009,"_2660":46159},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3162":317,"_27842":259,"_19309":46161,"_5":13254,"_25368":46013,"_2660":46162},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3162":318,"_27842":259,"_19309":46164,"_5":13254,"_25368":46013,"_2660":46165},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3162":319,"_27842":259,"_19309":46167,"_5":13254,"_25368":46013,"_2660":46168},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3162":320,"_27842":259,"_19309":46170,"_5":13254,"_25368":46013,"_2660":46171},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3162":321,"_27842":259,"_19309":46173,"_5":13254,"_25368":46013,"_2660":46174},[],"If none of those are possible, use different external ports or change the external network design.",{"_3162":322,"_27842":259,"_19309":46176,"_5":13254,"_25368":46017,"_2660":46177},[],"Check, in order:",{"_3162":323,"_27842":259,"_19309":46179,"_5":13254,"_25368":46017,"_2660":46180},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3162":324,"_27842":259,"_19309":46182,"_5":13254,"_25368":46017,"_2660":46183},[],"Its status contains the expected address.",{"_3162":325,"_27842":259,"_19309":46185,"_5":13254,"_25368":46017,"_2660":46186},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3162":326,"_27842":259,"_19309":46188,"_5":13254,"_25368":46017,"_2660":46189},[],"Port 443 reaches that address from the client network.",{"_3162":327,"_27842":259,"_19309":46191,"_5":13254,"_25368":46017,"_2660":46192},[],"DNS resolves to the externally reachable endpoint.",{"_3162":328,"_27842":259,"_19309":46194,"_5":13254,"_25368":46017,"_2660":46195},[],"The certificate contains the DNS name or IP used by the client.",{"_3162":329,"_27842":259,"_19309":46197,"_5":13254,"_25368":46017,"_2660":46198},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3162":330,"_27842":330,"_5":13585,"_2660":45326,"_28185":46200,"_19309":46201,"_25368":330},[45219,45220,45326],[],{"_3162":331,"_27842":330,"_19309":46203,"_5":13254,"_25368":330,"_2660":46204},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3162":332,"_27842":330,"_5":28182,"_19309":46206,"_25368":46207,"_2660":46208},[],"/docs/pr-preview/pr-39/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3162":333,"_27842":330,"_5":28182,"_19309":46210,"_25368":46211,"_2660":46212},[],"/docs/pr-preview/pr-39/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3162":334,"_27842":330,"_5":28182,"_19309":46214,"_25368":46215,"_2660":46216},[],"/docs/pr-preview/pr-39/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3162":335,"_27842":330,"_5":28182,"_19309":46218,"_25368":46219,"_2660":46220},[],"/docs/pr-preview/pr-39/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3162":336,"_27842":330,"_5":28182,"_19309":46222,"_25368":46223,"_2660":46224},[],"/docs/pr-preview/pr-39/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3162":337,"_27842":330,"_5":28182,"_19309":46226,"_25368":46227,"_2660":46228},[],"/docs/pr-preview/pr-39/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3162":338,"_27842":330,"_19309":46230,"_5":13254,"_25368":46207,"_2660":46231},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3162":339,"_27842":330,"_19309":46233,"_5":13254,"_25368":46211,"_2660":46234},[],"Workflow",{"_3162":340,"_27842":330,"_19309":46236,"_5":13254,"_25368":46211,"_2660":46237},[],"Use it for",{"_3162":341,"_27842":330,"_19309":46239,"_5":13254,"_25368":46211,"_2660":46240},[],"What it installs",{"_3162":342,"_27842":330,"_19309":46242,"_5":13254,"_25368":46211,"_2660":46243},[],"Helm",{"_3162":343,"_27842":330,"_19309":46245,"_5":13254,"_25368":46211,"_2660":46246},[],"Production and controlled environments",{"_3162":344,"_27842":330,"_19309":46248,"_5":13254,"_25368":46211,"_2660":46249},[],"Lamassu services and Gateway API resources",{"_3162":345,"_27842":330,"_19309":46251,"_5":13254,"_25368":46211,"_2660":45463},[],{"_3162":346,"_27842":330,"_19309":46253,"_5":13254,"_25368":46211,"_2660":46254},[],"Evaluation, demos, CI and small lab clusters",{"_3162":347,"_27842":330,"_19309":46256,"_5":13254,"_25368":46211,"_2660":46257},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3162":348,"_27842":330,"_19309":46259,"_5":13254,"_25368":46215,"_2660":46260},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3162":349,"_27842":330,"_19309":46262,"_5":13254,"_25368":46215,"_2660":46263},[],"Area",{"_3162":350,"_27842":330,"_19309":46265,"_5":13254,"_25368":46215,"_2660":46266},[],"The Lamassu chart provides",{"_3162":351,"_27842":330,"_19309":46268,"_5":13254,"_25368":46215,"_2660":46269},[],"You provide",{"_3162":352,"_27842":330,"_19309":46271,"_5":13254,"_25368":46215,"_2660":46272},[],"Lamassu applications",{"_3162":353,"_27842":330,"_19309":46274,"_5":13254,"_25368":46215,"_2660":46275},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3162":354,"_27842":330,"_19309":46277,"_5":13254,"_25368":46215,"_2660":46278},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3162":355,"_27842":330,"_19309":46280,"_5":13254,"_25368":46215,"_2660":46281},[],"PostgreSQL data",{"_3162":356,"_27842":330,"_19309":46283,"_5":13254,"_25368":46215,"_2660":46284},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3162":357,"_27842":330,"_19309":46286,"_5":13254,"_25368":46215,"_2660":46287},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3162":358,"_27842":330,"_19309":46289,"_5":13254,"_25368":46215,"_2660":46290},[],"Messaging",{"_3162":359,"_27842":330,"_19309":46292,"_5":13254,"_25368":46215,"_2660":46293},[],"RabbitMQ connection configuration for the Lamassu services",{"_3162":360,"_27842":330,"_19309":46295,"_5":13254,"_25368":46215,"_2660":46296},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3162":361,"_27842":330,"_19309":46298,"_5":13254,"_25368":46215,"_2660":46299},[],"Identity",{"_3162":362,"_27842":330,"_19309":46301,"_5":13254,"_25368":46215,"_2660":46302},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3162":363,"_27842":330,"_19309":46304,"_5":13254,"_25368":46215,"_2660":46305},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3162":364,"_27842":330,"_19309":46307,"_5":13254,"_25368":46215,"_2660":46308},[],"External routing",{"_3162":365,"_27842":330,"_19309":46310,"_5":13254,"_25368":46215,"_2660":46311},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3162":366,"_27842":330,"_19309":46313,"_5":13254,"_25368":46215,"_2660":46314},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3162":367,"_27842":330,"_19309":46316,"_5":13254,"_25368":46215,"_2660":46317},[],"TLS",{"_3162":368,"_27842":330,"_19309":46319,"_5":13254,"_25368":46215,"_2660":46320},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_3162":369,"_27842":330,"_19309":46322,"_5":13254,"_25368":46215,"_2660":46323},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3162":370,"_27842":330,"_19309":46325,"_5":13254,"_25368":46215,"_2660":46326},[],"Persistent application data",{"_3162":371,"_27842":330,"_19309":46328,"_5":13254,"_25368":46215,"_2660":46329},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3162":372,"_27842":330,"_19309":46331,"_5":13254,"_25368":46215,"_2660":46332},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3162":373,"_27842":330,"_19309":46334,"_5":13254,"_25368":46215,"_2660":46335},[],"Optional integrations",{"_3162":374,"_27842":330,"_19309":46337,"_5":13254,"_25368":46215,"_2660":46338},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3162":375,"_27842":330,"_19309":46340,"_5":13254,"_25368":46215,"_2660":46341},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3162":376,"_27842":330,"_19309":46343,"_5":13254,"_25368":46215,"_2660":46344},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3162":377,"_27842":330,"_19309":46346,"_5":13254,"_25368":46215,"_2660":46347},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3162":378,"_27842":330,"_19309":46349,"_5":13254,"_25368":46219,"_2660":46350},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3162":379,"_27842":330,"_19309":46352,"_5":13254,"_25368":46219,"_2660":46353},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3162":380,"_27842":330,"_19309":46355,"_5":13254,"_25368":46223,"_2660":46356},[],"Kubernetes 1.24 or newer",{"_3162":381,"_27842":330,"_19309":46358,"_5":13254,"_25368":46223,"_2660":46359},[],"Helm 3.2 or newer",{"_3162":382,"_27842":330,"_19309":46361,"_5":13254,"_25368":46223,"_2660":46362},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3162":383,"_27842":330,"_19309":46364,"_5":13254,"_25368":46223,"_2660":46365},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_3162":384,"_27842":330,"_19309":46367,"_5":13254,"_25368":46223,"_2660":46368},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3162":385,"_27842":330,"_19309":46370,"_5":13254,"_25368":46223,"_2660":46371},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3162":386,"_27842":330,"_19309":46373,"_5":13254,"_25368":46223,"_2660":46374},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3162":387,"_27842":330,"_19309":46376,"_5":13254,"_25368":46227,"_2660":46377},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3162":388,"_27842":330,"_19309":46379,"_5":13254,"_25368":46227,"_2660":46380},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3162":389,"_27842":330,"_19309":46382,"_5":13254,"_25368":46227,"_2660":46383},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3162":390,"_27842":330,"_19309":46385,"_5":13254,"_25368":46227,"_2660":46386},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3162":391,"_27842":391,"_5":13585,"_2660":46388,"_28185":46389,"_19309":46391,"_25368":391},"Deployment troubleshooting",[45219,45220,46390],"Operations",[],{"_3162":392,"_27842":391,"_19309":46393,"_5":13254,"_25368":391,"_2660":46394},[],"Diagnose access, service health and infrastructure dependencies.",{"_3162":393,"_27842":391,"_5":28182,"_19309":46396,"_25368":46397,"_2660":46398},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3162":394,"_27842":391,"_5":28182,"_19309":46400,"_25368":46401,"_2660":46402},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3162":395,"_27842":391,"_5":28182,"_19309":46404,"_25368":46405,"_2660":46406},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3162":396,"_27842":391,"_5":28182,"_19309":46408,"_25368":46409,"_2660":46410},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3162":397,"_27842":391,"_5":28182,"_19309":46412,"_25368":46413,"_2660":46414},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3162":398,"_27842":391,"_5":28182,"_19309":46416,"_25368":46417,"_2660":46418},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3162":399,"_27842":391,"_5":28182,"_19309":46420,"_25368":46421,"_2660":46422},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3162":400,"_27842":391,"_5":28182,"_19309":46424,"_25368":46425,"_2660":46426},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3162":401,"_27842":391,"_5":28182,"_19309":46428,"_25368":46429,"_2660":46430},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3162":402,"_27842":391,"_5":28182,"_19309":46432,"_25368":46433,"_2660":46434},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3162":403,"_27842":391,"_5":28182,"_19309":46436,"_25368":46437,"_2660":46438},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3162":404,"_27842":391,"_5":28182,"_19309":46440,"_25368":46441,"_2660":46442},[],"/docs/pr-preview/pr-39/deployment/troubleshooting#observability","Observability",{"_3162":405,"_27842":391,"_19309":46444,"_5":13254,"_25368":391,"_2660":46445},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3162":406,"_27842":391,"_19309":46447,"_5":13254,"_25368":46401,"_2660":46448},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3162":407,"_27842":391,"_19309":46450,"_5":13254,"_25368":46405,"_2660":46451},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3162":408,"_27842":391,"_19309":46453,"_5":13254,"_25368":46409,"_2660":46454},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3162":409,"_27842":391,"_19309":46456,"_5":13254,"_25368":46413,"_2660":46457},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3162":410,"_27842":391,"_19309":46459,"_5":13254,"_25368":46417,"_2660":46460},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3162":411,"_27842":391,"_19309":46462,"_5":13254,"_25368":46421,"_2660":46463},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3162":412,"_27842":391,"_19309":46465,"_5":13254,"_25368":46421,"_2660":46466},[],"Also run the chart's connectivity test:",{"_3162":413,"_27842":391,"_19309":46468,"_5":13254,"_25368":46421,"_2660":46469},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3162":414,"_27842":391,"_19309":46471,"_5":13254,"_25368":46421,"_2660":46472},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3162":415,"_27842":391,"_19309":46474,"_5":13254,"_25368":46425,"_2660":46475},[],"If you receive a 401:",{"_3162":416,"_27842":391,"_19309":46477,"_5":13254,"_25368":46425,"_2660":46478},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3162":417,"_27842":391,"_19309":46480,"_5":13254,"_25368":46425,"_2660":46481},[],"verify issuer, audience and expiration of the token;",{"_3162":418,"_27842":391,"_19309":46483,"_5":13254,"_25368":46425,"_2660":46484},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3162":419,"_27842":391,"_19309":46486,"_5":13254,"_25368":46425,"_2660":46487},[],"check that the provider's public and internal routes point to the same realm.",{"_3162":420,"_27842":391,"_19309":46489,"_5":13254,"_25368":46425,"_2660":46490},[],"If login succeeds but the APIs return 403:",{"_3162":421,"_27842":391,"_19309":46492,"_5":13254,"_25368":46425,"_2660":46493},[],"inspect the token's real claims;",{"_3162":422,"_27842":391,"_19309":46495,"_5":13254,"_25368":46425,"_2660":46496},[],"confirm they match an active principal;",{"_3162":423,"_27842":391,"_19309":46498,"_5":13254,"_25368":46425,"_2660":46499},[],"review the policies granted to that principal;",{"_3162":424,"_27842":391,"_19309":46501,"_5":13254,"_25368":46425,"_2660":46502},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3162":425,"_27842":391,"_19309":46504,"_5":13254,"_25368":46425,"_2660":46505},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3162":426,"_27842":391,"_19309":46507,"_5":13254,"_25368":46429,"_2660":46508},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3162":427,"_27842":391,"_19309":46510,"_5":13254,"_25368":46429,"_2660":46511},[],"Locate the authz pod and Service.",{"_3162":428,"_27842":391,"_19309":46513,"_5":13254,"_25368":46429,"_2660":46514},[],"Check /health, logs and its database connection.",{"_3162":429,"_27842":391,"_19309":46516,"_5":13254,"_25368":46429,"_2660":46517},[],"Verify the DNS and port configured in externalAuthorization.",{"_3162":430,"_27842":391,"_19309":46519,"_5":13254,"_25368":46429,"_2660":46520},[],"Check the check route is /v1/ext\\_authz/check.",{"_3162":431,"_27842":391,"_19309":46522,"_5":13254,"_25368":46429,"_2660":46523},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3162":432,"_27842":391,"_19309":46525,"_5":13254,"_25368":46433,"_2660":46526},[],"Review kubectl describe pod first. Common causes are:",{"_3162":433,"_27842":391,"_19309":46528,"_5":13254,"_25368":46433,"_2660":46529},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3162":434,"_27842":391,"_19309":46531,"_5":13254,"_25368":46433,"_2660":46532},[],"unbound persistent volume;",{"_3162":435,"_27842":391,"_19309":46534,"_5":13254,"_25368":46433,"_2660":46535},[],"inaccessible image or incorrect pull policy;",{"_3162":436,"_27842":391,"_19309":46537,"_5":13254,"_25368":46433,"_2660":46538},[],"invalid cryptographic engine configuration;",{"_3162":437,"_27842":391,"_19309":46540,"_5":13254,"_25368":46433,"_2660":46541},[],"CPU or memory limits set too low;",{"_3162":438,"_27842":391,"_19309":46543,"_5":13254,"_25368":46433,"_2660":46544},[],"an incomplete prior migration.",{"_3162":439,"_27842":391,"_19309":46546,"_5":13254,"_25368":46433,"_2660":46547},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3162":440,"_27842":391,"_19309":46549,"_5":13254,"_25368":46433,"_2660":46550},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3162":441,"_27842":391,"_19309":46552,"_5":13254,"_25368":46437,"_2660":46553},[],"Domain and audit events depend on the bus publisher:",{"_3162":442,"_27842":391,"_19309":46555,"_5":13254,"_25368":46437,"_2660":46556},[],"verify it is enabled in the emitting service;",{"_3162":443,"_27842":391,"_19309":46558,"_5":13254,"_25368":46437,"_2660":46559},[],"check AMQP connectivity and credentials;",{"_3162":444,"_27842":391,"_19309":46561,"_5":13254,"_25368":46437,"_2660":46562},[],"review exchange, routing key, queues and consumers;",{"_3162":445,"_27842":391,"_19309":46564,"_5":13254,"_25368":46437,"_2660":46565},[],"inspect dead-letter queues;",{"_3162":446,"_27842":391,"_19309":46567,"_5":13254,"_25368":46437,"_2660":46568},[],"alert on orphan durable queues and backlog growth.",{"_3162":447,"_27842":391,"_19309":46570,"_5":13254,"_25368":46437,"_2660":46571},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3162":448,"_27842":391,"_19309":46573,"_5":13254,"_25368":46441,"_2660":46574},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3162":449,"_27842":391,"_19309":46576,"_5":13254,"_25368":46441,"_2660":46577},[],"Before closing an incident, record:",{"_3162":450,"_27842":391,"_19309":46579,"_5":13254,"_25368":46441,"_2660":46580},[],"the confirmed cause;",{"_3162":451,"_27842":391,"_19309":46582,"_5":13254,"_25368":46441,"_2660":46583},[],"the time scope and affected resources;",{"_3162":452,"_27842":391,"_19309":46585,"_5":13254,"_25368":46441,"_2660":46586},[],"the commands or queries used;",{"_3162":453,"_27842":391,"_19309":46588,"_5":13254,"_25368":46441,"_2660":46589},[],"the applied change and how to revert it;",{"_3162":454,"_27842":391,"_19309":46591,"_5":13254,"_25368":46441,"_2660":46592},[],"validation from a consumer;",{"_3162":455,"_27842":391,"_19309":46594,"_5":13254,"_25368":46441,"_2660":46595},[],"the preventive action and its owner.",{"_3162":456,"_27842":456,"_5":13585,"_2660":46597,"_28185":46598,"_19309":46601,"_25368":456},"Access control",[45219,46599,46600],"Platform","Administration",[],{"_3162":457,"_27842":456,"_19309":46603,"_5":13254,"_25368":456,"_2660":46604},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3162":458,"_27842":456,"_5":28182,"_19309":46606,"_25368":46607,"_2660":46608},[],"/docs/pr-preview/pr-39/platform/administration/access-control#essential-concepts","Essential concepts",{"_3162":459,"_27842":456,"_5":28182,"_19309":46610,"_25368":46611,"_2660":46612},[],"/docs/pr-preview/pr-39/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3162":460,"_27842":456,"_5":28182,"_19309":46614,"_25368":46615,"_2660":46616},[],"/docs/pr-preview/pr-39/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3162":461,"_27842":456,"_5":28182,"_19309":46618,"_25368":46619,"_2660":46620},[],"/docs/pr-preview/pr-39/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3162":462,"_27842":456,"_5":28182,"_19309":46622,"_25368":46623,"_2660":46624},[],"/docs/pr-preview/pr-39/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3162":463,"_27842":456,"_5":28182,"_19309":46626,"_25368":46627,"_2660":46628},[],"/docs/pr-preview/pr-39/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3162":464,"_27842":456,"_5":28182,"_19309":46630,"_25368":46631,"_2660":46632},[],"/docs/pr-preview/pr-39/platform/administration/access-control#oidc-principals","OIDC principals",{"_3162":465,"_27842":456,"_5":28182,"_19309":46634,"_25368":46635,"_2660":46636},[],"/docs/pr-preview/pr-39/platform/administration/access-control#x509-principals","X.509 principals",{"_3162":466,"_27842":456,"_5":28182,"_19309":46638,"_25368":46639,"_2660":46640},[],"/docs/pr-preview/pr-39/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3162":467,"_27842":456,"_5":28182,"_19309":46642,"_25368":46643,"_2660":46644},[],"/docs/pr-preview/pr-39/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3162":468,"_27842":456,"_5":28182,"_19309":46646,"_25368":46647,"_2660":46648},[],"/docs/pr-preview/pr-39/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3162":469,"_27842":456,"_5":28182,"_19309":46650,"_25368":46651,"_2660":46652},[],"/docs/pr-preview/pr-39/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3162":470,"_27842":456,"_5":28182,"_19309":46654,"_25368":46655,"_2660":46656},[],"/docs/pr-preview/pr-39/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3162":471,"_27842":456,"_5":28182,"_19309":46658,"_25368":46659,"_2660":46660},[],"/docs/pr-preview/pr-39/platform/administration/access-control#http-rules","HTTP rules",{"_3162":472,"_27842":456,"_5":28182,"_19309":46662,"_25368":46663,"_2660":46664},[],"/docs/pr-preview/pr-39/platform/administration/access-control#included-policies","Included policies",{"_3162":473,"_27842":456,"_5":28182,"_19309":46666,"_25368":46667,"_2660":45855},[],"/docs/pr-preview/pr-39/platform/administration/access-control#provision-the-first-administrator",{"_3162":474,"_27842":456,"_5":28182,"_19309":46669,"_25368":46670,"_2660":46671},[],"/docs/pr-preview/pr-39/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3162":475,"_27842":456,"_5":28182,"_19309":46673,"_25368":46674,"_2660":46675},[],"/docs/pr-preview/pr-39/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3162":476,"_27842":456,"_5":28182,"_19309":46677,"_25368":46678,"_2660":46679},[],"/docs/pr-preview/pr-39/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3162":477,"_27842":456,"_5":28182,"_19309":46681,"_25368":46682,"_2660":46683},[],"/docs/pr-preview/pr-39/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3162":478,"_27842":456,"_5":28182,"_19309":46685,"_25368":46686,"_2660":46687},[],"/docs/pr-preview/pr-39/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3162":479,"_27842":456,"_5":28182,"_19309":46689,"_25368":46690,"_2660":46691},[],"/docs/pr-preview/pr-39/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3162":480,"_27842":456,"_5":28182,"_19309":46693,"_25368":46694,"_2660":46695},[],"/docs/pr-preview/pr-39/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3162":481,"_27842":456,"_5":28182,"_19309":46697,"_25368":46698,"_2660":46699},[],"/docs/pr-preview/pr-39/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3162":482,"_27842":456,"_5":28182,"_19309":46701,"_25368":46702,"_2660":46703},[],"/docs/pr-preview/pr-39/platform/administration/access-control#operational-checklist","Operational checklist",{"_3162":483,"_27842":456,"_5":28182,"_19309":46705,"_25368":46706,"_2660":46707},[],"/docs/pr-preview/pr-39/platform/administration/access-control#diagnostics","Diagnostics",{"_3162":484,"_27842":456,"_5":28182,"_19309":46709,"_25368":46710,"_2660":46711},[],"/docs/pr-preview/pr-39/platform/administration/access-control#the-response-is-401","The response is 401",{"_3162":485,"_27842":456,"_5":28182,"_19309":46713,"_25368":46714,"_2660":46715},[],"/docs/pr-preview/pr-39/platform/administration/access-control#the-response-is-403","The response is 403",{"_3162":486,"_27842":456,"_5":28182,"_19309":46717,"_25368":46718,"_2660":46719},[],"/docs/pr-preview/pr-39/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3162":487,"_27842":456,"_5":28182,"_19309":46721,"_25368":46722,"_2660":46723},[],"/docs/pr-preview/pr-39/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3162":488,"_27842":456,"_5":28182,"_19309":46725,"_25368":46726,"_2660":46727},[],"/docs/pr-preview/pr-39/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3162":489,"_27842":456,"_19309":46729,"_5":13254,"_25368":456,"_2660":46730},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3162":490,"_27842":456,"_19309":46732,"_5":13254,"_25368":456,"_2660":46733},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3162":491,"_27842":456,"_19309":46735,"_5":13254,"_25368":456,"_2660":46736},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3162":492,"_27842":456,"_19309":46738,"_5":13254,"_25368":46607,"_2660":46739},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3162":493,"_27842":456,"_19309":46741,"_5":13254,"_25368":46607,"_2660":46742},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3162":494,"_27842":456,"_19309":46744,"_5":13254,"_25368":46607,"_2660":46745},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3162":495,"_27842":456,"_19309":46747,"_5":13254,"_25368":46607,"_2660":46748},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3162":496,"_27842":456,"_19309":46750,"_5":13254,"_25368":46607,"_2660":46751},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3162":497,"_27842":456,"_19309":46753,"_5":13254,"_25368":46607,"_2660":46754},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3162":498,"_27842":456,"_19309":46756,"_5":13254,"_25368":46611,"_2660":46757},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3162":499,"_27842":456,"_19309":46759,"_5":13254,"_25368":46611,"_2660":46760},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3162":500,"_27842":456,"_19309":46762,"_5":13254,"_25368":46615,"_2660":46763},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3162":501,"_27842":456,"_19309":46765,"_5":13254,"_25368":46615,"_2660":46766},[],"The decision is made **before forwarding the request to the service**:",{"_3162":502,"_27842":456,"_19309":46768,"_5":13254,"_25368":46615,"_2660":46769},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3162":503,"_27842":456,"_19309":46771,"_5":13254,"_25368":46615,"_2660":46772},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3162":504,"_27842":456,"_19309":46774,"_5":13254,"_25368":46615,"_2660":46775},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3162":505,"_27842":456,"_19309":46777,"_5":13254,"_25368":46615,"_2660":46778},[],"It separately loads the policies granted to each principal.",{"_3162":506,"_27842":456,"_19309":46780,"_5":13254,"_25368":46615,"_2660":46781},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3162":507,"_27842":456,"_19309":46783,"_5":13254,"_25368":46615,"_2660":46784},[],"`authz` looks for an HTTP rule granting that action.",{"_3162":508,"_27842":456,"_19309":46786,"_5":13254,"_25368":46615,"_2660":46787},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3162":509,"_27842":456,"_19309":46789,"_5":13254,"_25368":46615,"_2660":46790},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3162":510,"_27842":456,"_19309":46792,"_5":13254,"_25368":46615,"_2660":46793},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3162":511,"_27842":456,"_19309":46795,"_5":13254,"_25368":46615,"_2660":46796},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3162":512,"_27842":456,"_19309":46798,"_5":13254,"_25368":46619,"_2660":46799},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3162":513,"_27842":456,"_19309":46801,"_5":13254,"_25368":46619,"_2660":46802},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3162":514,"_27842":456,"_19309":46804,"_5":13254,"_25368":46619,"_2660":46805},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3162":515,"_27842":456,"_19309":46807,"_5":13254,"_25368":46619,"_2660":46808},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3162":516,"_27842":456,"_19309":46810,"_5":13254,"_25368":46619,"_2660":46811},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3162":517,"_27842":456,"_19309":46813,"_5":13254,"_25368":46619,"_2660":46814},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3162":518,"_27842":456,"_19309":46816,"_5":13254,"_25368":46619,"_2660":46817},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3162":519,"_27842":456,"_19309":46819,"_5":13254,"_25368":46619,"_2660":46820},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3162":520,"_27842":456,"_19309":46822,"_5":13254,"_25368":46623,"_2660":46823},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3162":521,"_27842":456,"_19309":46825,"_5":13254,"_25368":46623,"_2660":46826},[],"The decision is made with the domain operation context:",{"_3162":522,"_27842":456,"_19309":46828,"_5":13254,"_25368":46623,"_2660":46829},[],"The middleware extracts the credential and resolves the matching principals.",{"_3162":523,"_27842":456,"_19309":46831,"_5":13254,"_25368":46623,"_2660":46832},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3162":524,"_27842":456,"_19309":46834,"_5":13254,"_25368":46623,"_2660":46835},[],"`authz` gathers the entity rules of the granted policies.",{"_3162":525,"_27842":456,"_19309":46837,"_5":13254,"_25368":46623,"_2660":46838},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3162":526,"_27842":456,"_19309":46840,"_5":13254,"_25368":46623,"_2660":46841},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3162":527,"_27842":456,"_19309":46843,"_5":13254,"_25368":46623,"_2660":46844},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3162":528,"_27842":456,"_19309":46846,"_5":13254,"_25368":46623,"_2660":46847},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3162":529,"_27842":456,"_19309":46849,"_5":13254,"_25368":46623,"_2660":46850},[],"Actions fall into two groups:",{"_3162":530,"_27842":456,"_19309":46852,"_5":13254,"_25368":46623,"_2660":46853},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3162":531,"_27842":456,"_19309":46855,"_5":13254,"_25368":46623,"_2660":46856},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3162":532,"_27842":456,"_19309":46858,"_5":13254,"_25368":46623,"_2660":46859},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3162":533,"_27842":456,"_19309":46861,"_5":13254,"_25368":46627,"_2660":46862},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3162":534,"_27842":456,"_19309":46864,"_5":13254,"_25368":46627,"_2660":46865},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3162":535,"_27842":456,"_19309":46867,"_5":13254,"_25368":46627,"_2660":46868},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3162":536,"_27842":456,"_19309":46870,"_5":13254,"_25368":46631,"_2660":46871},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3162":537,"_27842":456,"_19309":46873,"_5":13254,"_25368":46631,"_2660":46874},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3162":538,"_27842":456,"_19309":46876,"_5":13254,"_25368":46631,"_2660":46877},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3162":539,"_27842":456,"_19309":46879,"_5":13254,"_25368":46631,"_2660":46880},[],"The implemented operators are:",{"_3162":540,"_27842":456,"_19309":46882,"_5":13254,"_25368":46631,"_2660":46883},[],"`equals`, for exact equality;",{"_3162":541,"_27842":456,"_19309":46885,"_5":13254,"_25368":46631,"_2660":46886},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3162":542,"_27842":456,"_19309":46888,"_5":13254,"_25368":46631,"_2660":46889},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3162":543,"_27842":456,"_19309":46891,"_5":13254,"_25368":46631,"_2660":46892},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3162":544,"_27842":456,"_19309":46894,"_5":13254,"_25368":46635,"_2660":46895},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3162":545,"_27842":456,"_19309":46897,"_5":13254,"_25368":46635,"_2660":46898},[],"The available modes are:",{"_3162":546,"_27842":456,"_19309":46900,"_5":13254,"_25368":46635,"_2660":46901},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3162":547,"_27842":456,"_19309":46903,"_5":13254,"_25368":46635,"_2660":46904},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3162":548,"_27842":456,"_19309":46906,"_5":13254,"_25368":46635,"_2660":46907},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3162":549,"_27842":456,"_19309":46909,"_5":13254,"_25368":46635,"_2660":46910},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3162":550,"_27842":456,"_19309":46912,"_5":13254,"_25368":46635,"_2660":46913},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3162":551,"_27842":456,"_19309":46915,"_5":13254,"_25368":46635,"_2660":46916},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3162":552,"_27842":456,"_19309":46918,"_5":13254,"_25368":46639,"_2660":46919},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3162":553,"_27842":456,"_19309":46921,"_5":13254,"_25368":46639,"_2660":46922},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3162":554,"_27842":456,"_19309":46924,"_5":13254,"_25368":46639,"_2660":46925},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3162":555,"_27842":456,"_19309":46927,"_5":13254,"_25368":46639,"_2660":46928},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3162":556,"_27842":456,"_19309":46930,"_5":13254,"_25368":46647,"_2660":46931},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3162":557,"_27842":456,"_19309":46933,"_5":13254,"_25368":46647,"_2660":46934},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3162":558,"_27842":456,"_19309":46936,"_5":13254,"_25368":46651,"_2660":46937},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3162":559,"_27842":456,"_19309":46939,"_5":13254,"_25368":46651,"_2660":46940},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3162":560,"_27842":456,"_19309":46942,"_5":13254,"_25368":46655,"_2660":46943},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3162":561,"_27842":456,"_19309":46945,"_5":13254,"_25368":46655,"_2660":46946},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3162":562,"_27842":456,"_19309":46948,"_5":13254,"_25368":46655,"_2660":46949},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3162":563,"_27842":456,"_19309":46951,"_5":13254,"_25368":46659,"_2660":46952},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3162":564,"_27842":456,"_19309":46954,"_5":13254,"_25368":46659,"_2660":46955},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3162":565,"_27842":456,"_19309":46957,"_5":13254,"_25368":46659,"_2660":46958},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3162":566,"_27842":456,"_19309":46960,"_5":13254,"_25368":46659,"_2660":46961},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3162":567,"_27842":456,"_19309":46963,"_5":13254,"_25368":46659,"_2660":46964},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3162":568,"_27842":456,"_19309":46966,"_5":13254,"_25368":46659,"_2660":46967},[],"Note that:",{"_3162":569,"_27842":456,"_19309":46969,"_5":13254,"_25368":46659,"_2660":46970},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3162":570,"_27842":456,"_19309":46972,"_5":13254,"_25368":46659,"_2660":46973},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3162":571,"_27842":456,"_19309":46975,"_5":13254,"_25368":46659,"_2660":46976},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3162":572,"_27842":456,"_19309":46978,"_5":13254,"_25368":46663,"_2660":46979},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3162":573,"_27842":456,"_19309":46981,"_5":13254,"_25368":46663,"_2660":46982},[],"full and read-only access to certificates and authorities;",{"_3162":574,"_27842":456,"_19309":46984,"_5":13254,"_25368":46663,"_2660":46985},[],"full and read-only access to the KMS;",{"_3162":575,"_27842":456,"_19309":46987,"_5":13254,"_25368":46663,"_2660":46988},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3162":576,"_27842":456,"_19309":46990,"_5":13254,"_25368":46663,"_2660":46991},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3162":577,"_27842":456,"_19309":46993,"_5":13254,"_25368":46663,"_2660":46994},[],"console access;",{"_3162":578,"_27842":456,"_19309":46996,"_5":13254,"_25368":46663,"_2660":46997},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3162":579,"_27842":456,"_19309":46999,"_5":13254,"_25368":46663,"_2660":47000},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3162":580,"_27842":456,"_19309":47002,"_5":13254,"_25368":46663,"_2660":47003},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3162":581,"_27842":456,"_19309":47005,"_5":13254,"_25368":46667,"_2660":47006},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3162":582,"_27842":456,"_19309":47008,"_5":13254,"_25368":46667,"_2660":47009},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3162":583,"_27842":456,"_19309":47011,"_5":13254,"_25368":46667,"_2660":47012},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3162":584,"_27842":456,"_19309":47014,"_5":13254,"_25368":46670,"_2660":47015},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3162":585,"_27842":456,"_19309":47017,"_5":13254,"_25368":46674,"_2660":47018},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3162":586,"_27842":456,"_19309":47020,"_5":13254,"_25368":46674,"_2660":47021},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3162":587,"_27842":456,"_19309":47023,"_5":13254,"_25368":46678,"_2660":47024},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3162":588,"_27842":456,"_19309":47026,"_5":13254,"_25368":46682,"_2660":47027},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3162":589,"_27842":456,"_19309":47029,"_5":13254,"_25368":46686,"_2660":47030},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3162":590,"_27842":456,"_19309":47032,"_5":13254,"_25368":46690,"_2660":47033},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3162":591,"_27842":456,"_19309":47035,"_5":13254,"_25368":46690,"_2660":47036},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3162":592,"_27842":456,"_19309":47038,"_5":13254,"_25368":46694,"_2660":47039},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3162":593,"_27842":456,"_19309":47041,"_5":13254,"_25368":46694,"_2660":47042},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3162":594,"_27842":456,"_19309":47044,"_5":13254,"_25368":46694,"_2660":47045},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3162":595,"_27842":456,"_19309":47047,"_5":13254,"_25368":46694,"_2660":47048},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3162":596,"_27842":456,"_19309":47050,"_5":13254,"_25368":46694,"_2660":47051},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3162":597,"_27842":456,"_19309":47053,"_5":13254,"_25368":46694,"_2660":47054},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3162":598,"_27842":456,"_19309":47056,"_5":13254,"_25368":46694,"_2660":47057},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3162":599,"_27842":456,"_19309":47059,"_5":13254,"_25368":46694,"_2660":47060},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3162":600,"_27842":456,"_19309":47062,"_5":13254,"_25368":46698,"_2660":47063},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3162":601,"_27842":456,"_19309":47065,"_5":13254,"_25368":46698,"_2660":47066},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3162":602,"_27842":456,"_19309":47068,"_5":13254,"_25368":46698,"_2660":47069},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3162":603,"_27842":456,"_19309":47071,"_5":13254,"_25368":46702,"_2660":47072},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3162":604,"_27842":456,"_19309":47074,"_5":13254,"_25368":46702,"_2660":47075},[],"Use groups or stable roles for people and independent identities for automations.",{"_3162":605,"_27842":456,"_19309":47077,"_5":13254,"_25368":46702,"_2660":47078},[],"Keep at least two recovery administrators and test their access periodically.",{"_3162":606,"_27842":456,"_19309":47080,"_5":13254,"_25368":46702,"_2660":47081},[],"Review active principals, their matches and their grants after IdP changes.",{"_3162":607,"_27842":456,"_19309":47083,"_5":13254,"_25368":46702,"_2660":47084},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3162":608,"_27842":456,"_19309":47086,"_5":13254,"_25368":46702,"_2660":47087},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3162":609,"_27842":456,"_19309":47089,"_5":13254,"_25368":46702,"_2660":47090},[],"Always test one allowed and one denied operation for each role.",{"_3162":610,"_27842":456,"_19309":47092,"_5":13254,"_25368":46702,"_2660":47093},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3162":611,"_27842":456,"_19309":47095,"_5":13254,"_25368":46710,"_2660":47096},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3162":612,"_27842":456,"_19309":47098,"_5":13254,"_25368":46714,"_2660":47099},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3162":613,"_27842":456,"_19309":47101,"_5":13254,"_25368":46714,"_2660":47102},[],"that an active principal of the correct type exists;",{"_3162":614,"_27842":456,"_19309":47104,"_5":13254,"_25368":46714,"_2660":47105},[],"that the claim paths and values match the real token exactly;",{"_3162":615,"_27842":456,"_19309":47107,"_5":13254,"_25368":46714,"_2660":47108},[],"that all of the principal's conditions hold;",{"_3162":616,"_27842":456,"_19309":47110,"_5":13254,"_25368":46714,"_2660":47111},[],"that the principal has the expected policy granted;",{"_3162":617,"_27842":456,"_19309":47113,"_5":13254,"_25368":46714,"_2660":47114},[],"that the policy includes the action and the requested resource type or route;",{"_3162":618,"_27842":456,"_19309":47116,"_5":13254,"_25368":46714,"_2660":47117},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3162":619,"_27842":456,"_19309":47119,"_5":13254,"_25368":46714,"_2660":47120},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3162":620,"_27842":456,"_19309":47122,"_5":13254,"_25368":46718,"_2660":47123},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3162":621,"_27842":456,"_19309":47125,"_5":13254,"_25368":46722,"_2660":47126},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3162":622,"_27842":456,"_19309":47128,"_5":13254,"_25368":46726,"_2660":47129},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3162":623,"_27842":456,"_19309":47131,"_5":13254,"_25368":46726,"_2660":47132},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3162":624,"_27842":624,"_5":13585,"_2660":47134,"_28185":47135,"_19309":47136,"_25368":624},"Alerts and subscriptions",[45219,46599,46600],[],{"_3162":625,"_27842":624,"_19309":47138,"_5":13254,"_25368":624,"_2660":47139},[],"Send PKI events to people and external systems.",{"_3162":626,"_27842":624,"_5":28182,"_19309":47141,"_25368":47142,"_2660":47143},[],"/docs/pr-preview/pr-39/platform/administration/alerts#how-it-works","How it works",{"_3162":627,"_27842":624,"_5":28182,"_19309":47145,"_25368":47146,"_2660":47147},[],"/docs/pr-preview/pr-39/platform/administration/alerts#available-channels","Available channels",{"_3162":628,"_27842":624,"_5":28182,"_19309":47149,"_25368":47150,"_2660":47151},[],"/docs/pr-preview/pr-39/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3162":629,"_27842":624,"_5":28182,"_19309":47153,"_25368":47154,"_2660":47155},[],"/docs/pr-preview/pr-39/platform/administration/alerts#choose-the-event","Choose the event",{"_3162":630,"_27842":624,"_5":28182,"_19309":47157,"_25368":47158,"_2660":47159},[],"/docs/pr-preview/pr-39/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3162":631,"_27842":624,"_5":28182,"_19309":47161,"_25368":47162,"_2660":47163},[],"/docs/pr-preview/pr-39/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3162":632,"_27842":624,"_5":28182,"_19309":47165,"_25368":47166,"_2660":47167},[],"/docs/pr-preview/pr-39/platform/administration/alerts#review-and-activate","Review and activate",{"_3162":633,"_27842":624,"_5":28182,"_19309":47169,"_25368":47170,"_2660":47171},[],"/docs/pr-preview/pr-39/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3162":634,"_27842":624,"_5":28182,"_19309":47173,"_25368":47174,"_2660":47175},[],"/docs/pr-preview/pr-39/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3162":635,"_27842":624,"_5":28182,"_19309":47177,"_25368":47178,"_2660":47179},[],"/docs/pr-preview/pr-39/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3162":636,"_27842":624,"_5":28182,"_19309":47181,"_25368":47182,"_2660":47183},[],"/docs/pr-preview/pr-39/platform/administration/alerts#event-families","Event families",{"_3162":637,"_27842":624,"_19309":47185,"_5":13254,"_25368":624,"_2660":47186},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3162":638,"_27842":624,"_19309":47188,"_5":13254,"_25368":47142,"_2660":47189},[],"A service publishes a domain event.",{"_3162":639,"_27842":624,"_19309":47191,"_5":13254,"_25368":47142,"_2660":47192},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3162":640,"_27842":624,"_19309":47194,"_5":13254,"_25368":47142,"_2660":47195},[],"Each subscription's filter decides whether it should be notified.",{"_3162":641,"_27842":624,"_19309":47197,"_5":13254,"_25368":47142,"_2660":47198},[],"Lamassu delivers the event to the configured channel.",{"_3162":642,"_27842":624,"_19309":47200,"_5":13254,"_25368":47142,"_2660":47201},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3162":643,"_27842":624,"_19309":47203,"_5":13254,"_25368":47146,"_2660":47204},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3162":644,"_27842":624,"_19309":47206,"_5":13254,"_25368":47146,"_2660":47207},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3162":645,"_27842":624,"_19309":47209,"_5":13254,"_25368":47146,"_2660":47210},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3162":646,"_27842":624,"_19309":47212,"_5":13254,"_25368":47146,"_2660":47213},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3162":647,"_27842":624,"_19309":47215,"_5":13254,"_25368":47146,"_2660":47216},[],"`apikey_options` requires `header` and `key`.",{"_3162":648,"_27842":624,"_19309":47218,"_5":13254,"_25368":47146,"_2660":47219},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3162":649,"_27842":624,"_19309":47221,"_5":13254,"_25368":47146,"_2660":47222},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3162":650,"_27842":624,"_19309":47224,"_5":13254,"_25368":47146,"_2660":47225},[],"The alerts API reference documents the full `http_client` schema.",{"_3162":651,"_27842":624,"_19309":47227,"_5":13254,"_25368":47154,"_2660":47228},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3162":652,"_27842":624,"_19309":47230,"_5":13254,"_25368":47158,"_2660":47231},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3162":653,"_27842":624,"_19309":47233,"_5":13254,"_25368":47162,"_2660":47234},[],"Add a filter if you don't want to receive every instance of the event.",{"_3162":654,"_27842":624,"_19309":47236,"_5":13254,"_25368":47162,"_2660":47237},[],"**None** notifies all instances of the event.",{"_3162":655,"_27842":624,"_19309":47239,"_5":13254,"_25368":47162,"_2660":47240},[],"**JSON Path** evaluates one or more specific fields.",{"_3162":656,"_27842":624,"_19309":47242,"_5":13254,"_25368":47162,"_2660":47243},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3162":657,"_27842":624,"_19309":47245,"_5":13254,"_25368":47162,"_2660":47246},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3162":658,"_27842":624,"_19309":47248,"_5":13254,"_25368":47162,"_2660":47249},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3162":659,"_27842":624,"_19309":47251,"_5":13254,"_25368":47166,"_2660":47252},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3162":660,"_27842":624,"_19309":47254,"_5":13254,"_25368":47170,"_2660":47255},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3162":661,"_27842":624,"_19309":47257,"_5":13254,"_25368":47170,"_2660":47258},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3162":662,"_27842":624,"_19309":47260,"_5":13254,"_25368":47170,"_2660":47261},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3162":663,"_27842":624,"_19309":47263,"_5":13254,"_25368":47170,"_2660":47264},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3162":664,"_27842":624,"_19309":47266,"_5":13254,"_25368":47170,"_2660":47267},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3162":665,"_27842":624,"_19309":47269,"_5":13254,"_25368":47170,"_2660":47270},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3162":666,"_27842":624,"_19309":47272,"_5":13254,"_25368":47170,"_2660":47273},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3162":667,"_27842":624,"_19309":47275,"_5":13254,"_25368":47170,"_2660":47276},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3162":668,"_27842":624,"_19309":47278,"_5":13254,"_25368":47174,"_2660":47279},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3162":669,"_27842":624,"_19309":47281,"_5":13254,"_25368":47174,"_2660":47282},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3162":670,"_27842":624,"_19309":47284,"_5":13254,"_25368":47174,"_2660":47285},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3162":671,"_27842":624,"_19309":47287,"_5":13254,"_25368":47174,"_2660":47288},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3162":672,"_27842":624,"_19309":47290,"_5":13254,"_25368":47174,"_2660":47291},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3162":673,"_27842":624,"_19309":47293,"_5":13254,"_25368":47174,"_2660":47294},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3162":674,"_27842":624,"_19309":47296,"_5":13254,"_25368":47174,"_2660":47297},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3162":675,"_27842":624,"_19309":47299,"_5":13254,"_25368":47174,"_2660":47300},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3162":676,"_27842":624,"_19309":47302,"_5":13254,"_25368":47178,"_2660":47303},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3162":677,"_27842":624,"_19309":47305,"_5":13254,"_25368":47178,"_2660":47306},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3162":678,"_27842":624,"_19309":47308,"_5":13254,"_25368":47182,"_2660":47309},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3162":679,"_27842":624,"_19309":47311,"_5":13254,"_25368":47182,"_2660":47312},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3162":680,"_27842":624,"_19309":47314,"_5":13254,"_25368":47182,"_2660":47315},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3162":681,"_27842":624,"_19309":47317,"_5":13254,"_25368":47182,"_2660":47318},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3162":682,"_27842":624,"_19309":47320,"_5":13254,"_25368":47182,"_2660":47321},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3162":683,"_27842":624,"_19309":47323,"_5":13254,"_25368":47182,"_2660":47324},[],"**Validation:** `va.role.crl.create`.",{"_3162":684,"_27842":624,"_19309":47326,"_5":13254,"_25368":47182,"_2660":47327},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3162":685,"_27842":624,"_19309":47329,"_5":13254,"_25368":47182,"_2660":47330},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3162":686,"_27842":686,"_5":13585,"_2660":47332,"_28185":47333,"_19309":47334,"_25368":686},"Audit logs",[45219,46599,46600],[],{"_3162":687,"_27842":686,"_19309":47336,"_5":13254,"_25368":686,"_2660":47337},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3162":688,"_27842":686,"_5":28182,"_19309":47339,"_25368":47340,"_2660":47341},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3162":689,"_27842":686,"_5":28182,"_19309":47343,"_25368":47344,"_2660":47345},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#coverage","Coverage",{"_3162":690,"_27842":686,"_5":28182,"_19309":47347,"_25368":47348,"_2660":47349},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3162":691,"_27842":686,"_5":28182,"_19309":47351,"_25368":47352,"_2660":47353},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3162":692,"_27842":686,"_5":28182,"_19309":47355,"_25368":47356,"_2660":47357},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3162":693,"_27842":686,"_5":28182,"_19309":47359,"_25368":47360,"_2660":47361},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3162":694,"_27842":686,"_5":28182,"_19309":47363,"_25368":47364,"_2660":47365},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3162":695,"_27842":686,"_5":28182,"_19309":47367,"_25368":47368,"_2660":47369},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3162":696,"_27842":686,"_5":28182,"_19309":47371,"_25368":47372,"_2660":47373},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3162":697,"_27842":686,"_5":28182,"_19309":47375,"_25368":47376,"_2660":47377},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3162":698,"_27842":686,"_5":28182,"_19309":47379,"_25368":47380,"_2660":47381},[],"/docs/pr-preview/pr-39/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3162":699,"_27842":686,"_19309":47383,"_5":13254,"_25368":686,"_2660":47384},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3162":700,"_27842":686,"_19309":47386,"_5":13254,"_25368":47340,"_2660":47387},[],"The audit body includes:",{"_3162":701,"_27842":686,"_19309":47389,"_5":13254,"_25368":47340,"_2660":47390},[],"input: data received by the operation;",{"_3162":702,"_27842":686,"_19309":47392,"_5":13254,"_25368":47340,"_2660":47393},[],"has\\_error: whether the service returned an error;",{"_3162":703,"_27842":686,"_19309":47395,"_5":13254,"_25368":47340,"_2660":47396},[],"output: produced result or error message;",{"_3162":704,"_27842":686,"_19309":47398,"_5":13254,"_25368":47340,"_2660":47399},[],"principals: identifiers of the principals that matched the request.",{"_3162":705,"_27842":686,"_19309":47401,"_5":13254,"_25368":47340,"_2660":47402},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3162":706,"_27842":686,"_19309":47404,"_5":13254,"_25368":47340,"_2660":47405},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3162":707,"_27842":686,"_19309":47407,"_5":13254,"_25368":47344,"_2660":47408},[],"The backend applies auditing to mutations of:",{"_3162":708,"_27842":686,"_19309":47410,"_5":13254,"_25368":47344,"_2660":47411},[],"authorities, certificates and issuance profiles;",{"_3162":709,"_27842":686,"_19309":47413,"_5":13254,"_25368":47344,"_2660":47414},[],"keys and KMS engines;",{"_3162":710,"_27842":686,"_19309":47416,"_5":13254,"_25368":47344,"_2660":47417},[],"devices and identities;",{"_3162":711,"_27842":686,"_19309":47419,"_5":13254,"_25368":47344,"_2660":47420},[],"DMSs and enrollment operations;",{"_3162":712,"_27842":686,"_19309":47422,"_5":13254,"_25368":47344,"_2660":47423},[],"validation functions and CRL;",{"_3162":713,"_27842":686,"_19309":47425,"_5":13254,"_25368":47344,"_2660":47426},[],"principals, policies and authorization grants.",{"_3162":714,"_27842":686,"_19309":47428,"_5":13254,"_25368":47344,"_2660":47429},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3162":715,"_27842":686,"_19309":47431,"_5":13254,"_25368":47348,"_2660":47432},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3162":716,"_27842":686,"_19309":47434,"_5":13254,"_25368":47348,"_2660":47435},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3162":717,"_27842":686,"_19309":47437,"_5":13254,"_25368":47348,"_2660":47438},[],"Design the consumer to:",{"_3162":718,"_27842":686,"_19309":47440,"_5":13254,"_25368":47348,"_2660":47441},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3162":719,"_27842":686,"_19309":47443,"_5":13254,"_25368":47348,"_2660":47444},[],"keep the complete CloudEvent unmodified;",{"_3162":720,"_27842":686,"_19309":47446,"_5":13254,"_25368":47348,"_2660":47447},[],"record the ingestion time and detect duplicates by ID;",{"_3162":721,"_27842":686,"_19309":47449,"_5":13254,"_25368":47348,"_2660":47450},[],"encrypt in transit and at rest;",{"_3162":722,"_27842":686,"_19309":47452,"_5":13254,"_25368":47348,"_2660":47453},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3162":723,"_27842":686,"_19309":47455,"_5":13254,"_25368":47348,"_2660":47456},[],"apply an explicit retention and legal hold policy;",{"_3162":724,"_27842":686,"_19309":47458,"_5":13254,"_25368":47348,"_2660":47459},[],"alert if it stops consuming or the pending queue grows.",{"_3162":725,"_27842":686,"_19309":47461,"_5":13254,"_25368":47352,"_2660":47462},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3162":726,"_27842":686,"_19309":47464,"_5":13254,"_25368":47352,"_2660":47465},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3162":727,"_27842":686,"_19309":47467,"_5":13254,"_25368":47360,"_2660":47468},[],"Start from the reported time and normalize every source to UTC.",{"_3162":728,"_27842":686,"_19309":47470,"_5":13254,"_25368":47364,"_2660":47471},[],"Filter by event type, service source and resource identifier.",{"_3162":729,"_27842":686,"_19309":47473,"_5":13254,"_25368":47368,"_2660":47474},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3162":730,"_27842":686,"_19309":47476,"_5":13254,"_25368":47372,"_2660":47477},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3162":731,"_27842":686,"_19309":47479,"_5":13254,"_25368":47376,"_2660":47480},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3162":732,"_27842":686,"_19309":47482,"_5":13254,"_25368":47380,"_2660":47483},[],"Generate a controlled mutation in a test environment and check that:",{"_3162":733,"_27842":686,"_19309":47485,"_5":13254,"_25368":47380,"_2660":47486},[],"a successful audit event appears;",{"_3162":734,"_27842":686,"_19309":47488,"_5":13254,"_25368":47380,"_2660":47489},[],"the principal matches the identity used;",{"_3162":735,"_27842":686,"_19309":47491,"_5":13254,"_25368":47380,"_2660":47492},[],"the consumer persists it exactly once;",{"_3162":736,"_27842":686,"_19309":47494,"_5":13254,"_25368":47380,"_2660":47495},[],"it can be retrieved by resource, actor and period;",{"_3162":737,"_27842":686,"_19309":47497,"_5":13254,"_25368":47380,"_2660":47498},[],"a consumer outage raises an alert.",{"_3162":738,"_27842":686,"_19309":47500,"_5":13254,"_25368":47380,"_2660":47501},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3162":739,"_27842":739,"_5":13585,"_2660":47503,"_28185":47504,"_19309":47505,"_25368":739},"Platform architecture",[45219,46599],[],{"_3162":740,"_27842":739,"_19309":47507,"_5":13254,"_25368":739,"_2660":47508},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3162":741,"_27842":739,"_5":28182,"_19309":47510,"_25368":47511,"_2660":47512},[],"/docs/pr-preview/pr-39/platform/concepts/architecture#control-plane","Control plane",{"_3162":742,"_27842":739,"_5":28182,"_19309":47514,"_25368":47515,"_2660":47516},[],"/docs/pr-preview/pr-39/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3162":743,"_27842":739,"_5":28182,"_19309":47518,"_25368":47519,"_2660":47520},[],"/docs/pr-preview/pr-39/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3162":744,"_27842":739,"_5":28182,"_19309":47522,"_25368":47523,"_2660":47524},[],"/docs/pr-preview/pr-39/platform/concepts/architecture#status-and-validation","Status and validation",{"_3162":745,"_27842":739,"_5":28182,"_19309":47526,"_25368":47527,"_2660":47528},[],"/docs/pr-preview/pr-39/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3162":746,"_27842":739,"_19309":47530,"_5":13254,"_25368":739,"_2660":47531},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3162":747,"_27842":739,"_19309":47533,"_5":13254,"_25368":739,"_2660":47534},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3162":748,"_27842":739,"_19309":47536,"_5":13254,"_25368":47511,"_2660":47537},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3162":749,"_27842":739,"_19309":47539,"_5":13254,"_25368":47515,"_2660":47540},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3162":750,"_27842":739,"_19309":47542,"_5":13254,"_25368":47519,"_2660":47543},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3162":751,"_27842":739,"_19309":47545,"_5":13254,"_25368":47523,"_2660":47546},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3162":752,"_27842":739,"_19309":47548,"_5":13254,"_25368":47527,"_2660":47549},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3162":753,"_27842":753,"_5":13585,"_2660":47551,"_28185":47552,"_19309":47553,"_25368":753},"How Lamassu works",[45219,46599],[],{"_3162":754,"_27842":753,"_19309":47555,"_5":13254,"_25368":753,"_2660":47556},[],"The mental model of trust, keys, certificates and devices.",{"_3162":755,"_27842":753,"_5":28182,"_19309":47558,"_25368":47559,"_2660":47560},[],"/docs/pr-preview/pr-39/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3162":756,"_27842":753,"_5":28182,"_19309":47562,"_25368":47563,"_2660":47564},[],"/docs/pr-preview/pr-39/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3162":757,"_27842":753,"_19309":47566,"_5":13254,"_25368":753,"_2660":47567},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3162":758,"_27842":753,"_19309":47569,"_5":13254,"_25368":47559,"_2660":47570},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3162":759,"_27842":753,"_19309":47572,"_5":13254,"_25368":47559,"_2660":47573},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3162":760,"_27842":753,"_19309":47575,"_5":13254,"_25368":47559,"_2660":47576},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3162":761,"_27842":753,"_19309":47578,"_5":13254,"_25368":47559,"_2660":47579},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3162":762,"_27842":753,"_19309":47581,"_5":13254,"_25368":47559,"_2660":47582},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3162":763,"_27842":753,"_19309":47584,"_5":13254,"_25368":47563,"_2660":47585},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3162":764,"_27842":753,"_19309":47587,"_5":13254,"_25368":47563,"_2660":47588},[],"A DMS relates that CA to an enrollment policy.",{"_3162":765,"_27842":753,"_19309":47590,"_5":13254,"_25368":47563,"_2660":47591},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3162":766,"_27842":753,"_19309":47593,"_5":13254,"_25368":47563,"_2660":47594},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3162":767,"_27842":753,"_19309":47596,"_5":13254,"_25368":47563,"_2660":47597},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3162":768,"_27842":753,"_19309":47599,"_5":13254,"_25368":47563,"_2660":47600},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3162":769,"_27842":753,"_19309":47602,"_5":13254,"_25368":47563,"_2660":47603},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3162":770,"_27842":770,"_5":13585,"_2660":47605,"_28185":47606,"_19309":47608,"_25368":770},"Devices and identities",[45219,46599,47607,47605],"IoT Fleets",[],{"_3162":771,"_27842":770,"_19309":47610,"_5":13254,"_25368":770,"_2660":47611},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3162":772,"_27842":770,"_5":28182,"_19309":47613,"_25368":47614,"_2660":47615},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#device-states","Device states",{"_3162":773,"_27842":770,"_5":28182,"_19309":47617,"_25368":47618,"_2660":47619},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3162":774,"_27842":770,"_5":28182,"_19309":47621,"_25368":47622,"_2660":47623},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3162":775,"_27842":770,"_5":28182,"_19309":47625,"_25368":47626,"_2660":47627},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3162":776,"_27842":770,"_5":28182,"_19309":47629,"_25368":47630,"_2660":47631},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3162":777,"_27842":770,"_5":28182,"_19309":47633,"_25368":47634,"_2660":47635},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3162":778,"_27842":770,"_5":28182,"_19309":47637,"_25368":47638,"_2660":47639},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3162":779,"_27842":770,"_5":28182,"_19309":47641,"_25368":47642,"_2660":47643},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3162":780,"_27842":770,"_5":28182,"_19309":47645,"_25368":47646,"_2660":47647},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3162":781,"_27842":770,"_5":28182,"_19309":47649,"_25368":47650,"_2660":47651},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3162":782,"_27842":770,"_5":28182,"_19309":47653,"_25368":47654,"_2660":47655},[],"/docs/pr-preview/pr-39/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3162":783,"_27842":770,"_19309":47657,"_5":13254,"_25368":770,"_2660":47658},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3162":784,"_27842":770,"_19309":47660,"_5":13254,"_25368":770,"_2660":47661},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3162":785,"_27842":770,"_19309":47663,"_5":13254,"_25368":47614,"_2660":47664},[],"Operational view",{"_3162":786,"_27842":770,"_19309":47666,"_5":13254,"_25368":47614,"_2660":47667},[],"Meaning",{"_3162":787,"_27842":770,"_19309":47669,"_5":13254,"_25368":47614,"_2660":47670},[],"**No Identity**",{"_3162":788,"_27842":770,"_19309":47672,"_5":13254,"_25368":47614,"_2660":47673},[],"A record exists without an associated identity.",{"_3162":789,"_27842":770,"_19309":47675,"_5":13254,"_25368":47614,"_2660":47676},[],"**Active**",{"_3162":790,"_27842":770,"_19309":47678,"_5":13254,"_25368":47614,"_2660":47679},[],"The slot is active; also check certificate dates, status and usages.",{"_3162":791,"_27842":770,"_19309":47681,"_5":13254,"_25368":47614,"_2660":47682},[],"**Renewal Pending**",{"_3162":792,"_27842":770,"_19309":47684,"_5":13254,"_25368":47614,"_2660":47685},[],"The identity is in the operational renewal window.",{"_3162":793,"_27842":770,"_19309":47687,"_5":13254,"_25368":47614,"_2660":47688},[],"**Expiring Soon**",{"_3162":794,"_27842":770,"_19309":47690,"_5":13254,"_25368":47614,"_2660":47691},[],"Expiration is approaching according to configured thresholds.",{"_3162":795,"_27842":770,"_19309":47693,"_5":13254,"_25368":47614,"_2660":47694},[],"**Expired**",{"_3162":796,"_27842":770,"_19309":47696,"_5":13254,"_25368":47614,"_2660":47697},[],"The identity has expired.",{"_3162":797,"_27842":770,"_19309":47699,"_5":13254,"_25368":47614,"_2660":47700},[],"**Revoked**",{"_3162":798,"_27842":770,"_19309":47702,"_5":13254,"_25368":47614,"_2660":47703},[],"The identity is marked revoked.",{"_3162":799,"_27842":770,"_19309":47705,"_5":13254,"_25368":47614,"_2660":47706},[],"**Decommissioned**",{"_3162":800,"_27842":770,"_19309":47708,"_5":13254,"_25368":47614,"_2660":47709},[],"The record is retired and ordinary updates do not restore operation.",{"_3162":801,"_27842":770,"_19309":47711,"_5":13254,"_25368":47614,"_2660":47712},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3162":802,"_27842":770,"_19309":47714,"_5":13254,"_25368":47618,"_2660":47715},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3162":803,"_27842":770,"_19309":47717,"_5":13254,"_25368":47618,"_2660":47718},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3162":804,"_27842":770,"_19309":47720,"_5":13254,"_25368":47618,"_2660":47721},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3162":805,"_27842":770,"_19309":47723,"_5":13254,"_25368":47618,"_2660":47724},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3162":806,"_27842":770,"_19309":47726,"_5":13254,"_25368":47622,"_2660":47727},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3162":807,"_27842":770,"_19309":47729,"_5":13254,"_25368":47626,"_2660":47730},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3162":808,"_27842":770,"_19309":47732,"_5":13254,"_25368":47630,"_2660":47733},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3162":809,"_27842":770,"_19309":47735,"_5":13254,"_25368":47634,"_2660":47736},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3162":810,"_27842":770,"_19309":47738,"_5":13254,"_25368":47638,"_2660":47739},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3162":811,"_27842":770,"_19309":47741,"_5":13254,"_25368":47638,"_2660":47742},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3162":812,"_27842":770,"_19309":47744,"_5":13254,"_25368":47642,"_2660":47745},[],"From **No Identity**, use **Assign Identity**:",{"_3162":813,"_27842":770,"_19309":47747,"_5":13254,"_25368":47642,"_2660":47748},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3162":814,"_27842":770,"_19309":47750,"_5":13254,"_25368":47642,"_2660":47751},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3162":815,"_27842":770,"_19309":47753,"_5":13254,"_25368":47642,"_2660":47754},[],"Confirm and read the serial, active version and history again.",{"_3162":816,"_27842":770,"_19309":47756,"_5":13254,"_25368":47642,"_2660":47757},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3162":817,"_27842":770,"_19309":47759,"_5":13254,"_25368":47642,"_2660":47760},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3162":818,"_27842":770,"_19309":47762,"_5":13254,"_25368":47646,"_2660":47763},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3162":819,"_27842":770,"_19309":47765,"_5":13254,"_25368":47646,"_2660":47766},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3162":820,"_27842":770,"_19309":47768,"_5":13254,"_25368":47650,"_2660":47769},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3162":821,"_27842":770,"_19309":47771,"_5":13254,"_25368":47650,"_2660":47772},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3162":822,"_27842":770,"_19309":47774,"_5":13254,"_25368":47650,"_2660":47775},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3162":823,"_27842":770,"_19309":47777,"_5":13254,"_25368":47650,"_2660":47778},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3162":824,"_27842":770,"_19309":47780,"_5":13254,"_25368":47654,"_2660":47781},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3162":825,"_27842":770,"_19309":47783,"_5":13254,"_25368":47654,"_2660":47784},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3162":826,"_27842":826,"_5":13585,"_2660":47786,"_28185":47787,"_19309":47789,"_25368":826},"Bootstrap identity and authentication",[45219,46599,47607,47605,47788],"Enrollment with PKI",[],{"_3162":827,"_27842":826,"_19309":47791,"_5":13254,"_25368":826,"_2660":47792},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3162":828,"_27842":826,"_5":28182,"_19309":47794,"_25368":47795,"_2660":47796},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3162":829,"_27842":826,"_5":28182,"_19309":47798,"_25368":47799,"_2660":47800},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3162":830,"_27842":826,"_5":28182,"_19309":47802,"_25368":47803,"_2660":47804},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3162":831,"_27842":826,"_5":28182,"_19309":47806,"_25368":47807,"_2660":47808},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3162":832,"_27842":826,"_5":28182,"_19309":47810,"_25368":47811,"_2660":47812},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3162":833,"_27842":826,"_19309":47814,"_5":13254,"_25368":826,"_2660":47815},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3162":834,"_27842":826,"_19309":47817,"_5":13254,"_25368":47795,"_2660":47818},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3162":835,"_27842":826,"_19309":47820,"_5":13254,"_25368":47795,"_2660":47821},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3162":836,"_27842":826,"_19309":47823,"_5":13254,"_25368":47799,"_2660":47824},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3162":837,"_27842":826,"_19309":47826,"_5":13254,"_25368":47799,"_2660":47827},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3162":838,"_27842":826,"_19309":47829,"_5":13254,"_25368":47799,"_2660":47830},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3162":839,"_27842":826,"_19309":47832,"_5":13254,"_25368":47803,"_2660":47833},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3162":840,"_27842":826,"_19309":47835,"_5":13254,"_25368":47803,"_2660":47836},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3162":841,"_27842":826,"_19309":47838,"_5":13254,"_25368":47807,"_2660":47839},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3162":842,"_27842":826,"_19309":47841,"_5":13254,"_25368":47807,"_2660":47842},[],"Example body:",{"_3162":843,"_27842":826,"_19309":47844,"_5":13254,"_25368":47807,"_2660":47845},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3162":844,"_27842":826,"_19309":47847,"_5":13254,"_25368":47807,"_2660":47848},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3162":845,"_27842":826,"_19309":47850,"_5":13254,"_25368":47807,"_2660":47851},[],"Continuation requires a successful HTTP response and JSON:",{"_3162":846,"_27842":826,"_19309":47853,"_5":13254,"_25368":47807,"_2660":47854},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3162":847,"_27842":826,"_19309":47856,"_5":13254,"_25368":47811,"_2660":47857},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3162":848,"_27842":826,"_19309":47859,"_5":13254,"_25368":47811,"_2660":47860},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3162":849,"_27842":849,"_5":13585,"_2660":47862,"_28185":47863,"_19309":47864,"_25368":849},"Configure and operate the DMS",[45219,46599,47607,47605,47788],[],{"_3162":850,"_27842":849,"_19309":47866,"_5":13254,"_25368":849,"_2660":47867},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3162":851,"_27842":849,"_5":28182,"_19309":47869,"_25368":47870,"_2660":45229},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3162":852,"_27842":849,"_5":28182,"_19309":47872,"_25368":47873,"_2660":47874},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3162":853,"_27842":849,"_5":28182,"_19309":47876,"_25368":47877,"_2660":47878},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3162":854,"_27842":849,"_5":28182,"_19309":47880,"_25368":47881,"_2660":47882},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3162":855,"_27842":849,"_5":28182,"_19309":47884,"_25368":47885,"_2660":47886},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3162":856,"_27842":849,"_5":28182,"_19309":47888,"_25368":47889,"_2660":47890},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3162":857,"_27842":849,"_5":28182,"_19309":47892,"_25368":47893,"_2660":47894},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3162":858,"_27842":849,"_5":28182,"_19309":47896,"_25368":47897,"_2660":47898},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3162":859,"_27842":849,"_5":28182,"_19309":47900,"_25368":47901,"_2660":47902},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3162":860,"_27842":849,"_5":28182,"_19309":47904,"_25368":47905,"_2660":47906},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3162":861,"_27842":849,"_5":28182,"_19309":47908,"_25368":47909,"_2660":47910},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3162":862,"_27842":849,"_5":28182,"_19309":47912,"_25368":47913,"_2660":47914},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3162":863,"_27842":849,"_5":28182,"_19309":47916,"_25368":47917,"_2660":47918},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3162":864,"_27842":849,"_5":28182,"_19309":47920,"_25368":47921,"_2660":47922},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3162":865,"_27842":849,"_5":28182,"_19309":47924,"_25368":47925,"_2660":47926},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3162":866,"_27842":849,"_5":28182,"_19309":47928,"_25368":47929,"_2660":47930},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3162":867,"_27842":849,"_5":28182,"_19309":47932,"_25368":47933,"_2660":47934},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3162":868,"_27842":849,"_5":28182,"_19309":47936,"_25368":47937,"_2660":47938},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3162":869,"_27842":849,"_19309":47940,"_5":13254,"_25368":849,"_2660":47941},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3162":870,"_27842":849,"_19309":47943,"_5":13254,"_25368":47870,"_2660":47944},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3162":871,"_27842":849,"_19309":47946,"_5":13254,"_25368":47870,"_2660":47947},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3162":872,"_27842":849,"_19309":47949,"_5":13254,"_25368":47877,"_2660":47950},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3162":873,"_27842":849,"_19309":47952,"_5":13254,"_25368":47881,"_2660":47953},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3162":874,"_27842":849,"_19309":47955,"_5":13254,"_25368":47885,"_2660":47956},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3162":875,"_27842":849,"_19309":47958,"_5":13254,"_25368":47889,"_2660":47959},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3162":876,"_27842":849,"_19309":47961,"_5":13254,"_25368":47893,"_2660":47962},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3162":877,"_27842":849,"_19309":47964,"_5":13254,"_25368":47901,"_2660":47965},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3162":878,"_27842":849,"_19309":47967,"_5":13254,"_25368":47901,"_2660":47968},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3162":879,"_27842":849,"_19309":47970,"_5":13254,"_25368":47905,"_2660":47971},[],"`settings.enrollment_settings` field",{"_3162":880,"_27842":849,"_19309":47973,"_5":13254,"_25368":47905,"_2660":47974},[],"Decision",{"_3162":881,"_27842":849,"_19309":47976,"_5":13254,"_25368":47905,"_2660":47977},[],"`protocol`",{"_3162":882,"_27842":849,"_19309":47979,"_5":13254,"_25368":47905,"_2660":47980},[],"`EST_RFC7030` for these operations.",{"_3162":883,"_27842":849,"_19309":47982,"_5":13254,"_25368":47905,"_2660":47983},[],"`enrollment_ca`",{"_3162":884,"_27842":849,"_19309":47985,"_5":13254,"_25368":47905,"_2660":47986},[],"ID of the signing CA.",{"_3162":885,"_27842":849,"_19309":47988,"_5":13254,"_25368":47905,"_2660":47989},[],"`verify_csr_signature`",{"_3162":886,"_27842":849,"_19309":47991,"_5":13254,"_25368":47905,"_2660":47992},[],"Keep `true` to verify CSR key possession.",{"_3162":887,"_27842":849,"_19309":47994,"_5":13254,"_25368":47905,"_2660":47995},[],"`enable_replaceable_enrollment`",{"_3162":888,"_27842":849,"_19309":47997,"_5":13254,"_25368":47905,"_2660":47998},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3162":889,"_27842":849,"_19309":48000,"_5":13254,"_25368":47905,"_2660":48001},[],"`est_rfc7030_settings.auth_mode`",{"_3162":890,"_27842":849,"_19309":48003,"_5":13254,"_25368":47905,"_2660":48004},[],"One of the four authentication modes.",{"_3162":891,"_27842":849,"_19309":48006,"_5":13254,"_25368":47905,"_2660":48007},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3162":892,"_27842":849,"_19309":48009,"_5":13254,"_25368":47909,"_2660":48010},[],"The blocks are independent:",{"_3162":893,"_27842":849,"_19309":48012,"_5":13254,"_25368":47909,"_2660":48013},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3162":894,"_27842":849,"_19309":48015,"_5":13254,"_25368":47909,"_2660":48016},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3162":895,"_27842":849,"_19309":48018,"_5":13254,"_25368":47909,"_2660":48019},[],"`auth_mode`",{"_3162":896,"_27842":849,"_19309":48021,"_5":13254,"_25368":47909,"_2660":48022},[],"Control applied in the configured operation",{"_3162":897,"_27842":849,"_19309":48024,"_5":13254,"_25368":47909,"_2660":48025},[],"`CLIENT_CERTIFICATE`",{"_3162":898,"_27842":849,"_19309":48027,"_5":13254,"_25368":47909,"_2660":48028},[],"Presented certificate validation.",{"_3162":899,"_27842":849,"_19309":48030,"_5":13254,"_25368":47909,"_2660":48031},[],"`EXTERNAL_WEBHOOK`",{"_3162":900,"_27842":849,"_19309":48033,"_5":13254,"_25368":47909,"_2660":48034},[],"Configured webhook authorization.",{"_3162":901,"_27842":849,"_19309":48036,"_5":13254,"_25368":47909,"_2660":48037},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3162":902,"_27842":849,"_19309":48039,"_5":13254,"_25368":47909,"_2660":48040},[],"Certificate validation followed by webhook approval.",{"_3162":903,"_27842":849,"_19309":48042,"_5":13254,"_25368":47909,"_2660":48043},[],"`NO_AUTH`",{"_3162":904,"_27842":849,"_19309":48045,"_5":13254,"_25368":47909,"_2660":48046},[],"No DMS requester authentication.",{"_3162":905,"_27842":849,"_19309":48048,"_5":13254,"_25368":47909,"_2660":48049},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3162":906,"_27842":849,"_19309":48051,"_5":13254,"_25368":47909,"_2660":48052},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3162":907,"_27842":849,"_19309":48054,"_5":13254,"_25368":47909,"_2660":48055},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3162":908,"_27842":849,"_19309":48057,"_5":13254,"_25368":47909,"_2660":48058},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3162":909,"_27842":849,"_19309":48060,"_5":13254,"_25368":47913,"_2660":48061},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3162":910,"_27842":849,"_19309":48063,"_5":13254,"_25368":47913,"_2660":48064},[],"`external_webhook_settings` field",{"_3162":911,"_27842":849,"_19309":48066,"_5":13254,"_25368":47913,"_2660":47974},[],{"_3162":912,"_27842":849,"_19309":48068,"_5":13254,"_25368":47913,"_2660":48069},[],"`url`",{"_3162":913,"_27842":849,"_19309":48071,"_5":13254,"_25368":47913,"_2660":48072},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3162":914,"_27842":849,"_19309":48074,"_5":13254,"_25368":47913,"_2660":48075},[],"`method`",{"_3162":915,"_27842":849,"_19309":48077,"_5":13254,"_25368":47913,"_2660":48078},[],"`POST` or `PUT`; `POST` by default.",{"_3162":916,"_27842":849,"_19309":48080,"_5":13254,"_25368":47913,"_2660":48081},[],"`name`",{"_3162":917,"_27842":849,"_19309":48083,"_5":13254,"_25368":47913,"_2660":48084},[],"Label used in service logs.",{"_3162":918,"_27842":849,"_19309":48086,"_5":13254,"_25368":47913,"_2660":48087},[],"`config.auth_mode`",{"_3162":919,"_27842":849,"_19309":48089,"_5":13254,"_25368":47913,"_2660":48090},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3162":920,"_27842":849,"_19309":48092,"_5":13254,"_25368":47913,"_2660":48093},[],"`config.log_level`",{"_3162":921,"_27842":849,"_19309":48095,"_5":13254,"_25368":47913,"_2660":48096},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3162":922,"_27842":849,"_19309":48098,"_5":13254,"_25368":47913,"_2660":48099},[],"`config.apikey_options`",{"_3162":923,"_27842":849,"_19309":48101,"_5":13254,"_25368":47913,"_2660":48102},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3162":924,"_27842":849,"_19309":48104,"_5":13254,"_25368":47913,"_2660":48105},[],"`config.jwt_options`",{"_3162":925,"_27842":849,"_19309":48107,"_5":13254,"_25368":47913,"_2660":48108},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3162":926,"_27842":849,"_19309":48110,"_5":13254,"_25368":47913,"_2660":48111},[],"`config.mtls_options`",{"_3162":927,"_27842":849,"_19309":48113,"_5":13254,"_25368":47913,"_2660":48114},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3162":928,"_27842":849,"_19309":48116,"_5":13254,"_25368":47913,"_2660":48117},[],"`config.insecure_skip_verify`",{"_3162":929,"_27842":849,"_19309":48119,"_5":13254,"_25368":47913,"_2660":48120},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3162":930,"_27842":849,"_19309":48122,"_5":13254,"_25368":47913,"_2660":48123},[],"`config.call_timeout`",{"_3162":931,"_27842":849,"_19309":48125,"_5":13254,"_25368":47913,"_2660":48126},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3162":932,"_27842":849,"_19309":48128,"_5":13254,"_25368":47913,"_2660":48129},[],"Rules for that configuration:",{"_3162":933,"_27842":849,"_19309":48131,"_5":13254,"_25368":47913,"_2660":48132},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3162":934,"_27842":849,"_19309":48134,"_5":13254,"_25368":47913,"_2660":48135},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3162":935,"_27842":849,"_19309":48137,"_5":13254,"_25368":47913,"_2660":48138},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3162":936,"_27842":849,"_19309":48140,"_5":13254,"_25368":47913,"_2660":48141},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3162":937,"_27842":849,"_19309":48143,"_5":13254,"_25368":47913,"_2660":48144},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3162":938,"_27842":849,"_19309":48146,"_5":13254,"_25368":47913,"_2660":48147},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3162":939,"_27842":849,"_19309":48149,"_5":13254,"_25368":47913,"_2660":48150},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3162":940,"_27842":849,"_19309":48152,"_5":13254,"_25368":47913,"_2660":48153},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3162":941,"_27842":849,"_19309":48155,"_5":13254,"_25368":47913,"_2660":48156},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3162":942,"_27842":849,"_19309":48158,"_5":13254,"_25368":47917,"_2660":48159},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3162":943,"_27842":849,"_19309":48161,"_5":13254,"_25368":47921,"_2660":48162},[],"`settings.reenrollment_settings` field",{"_3162":944,"_27842":849,"_19309":48164,"_5":13254,"_25368":47921,"_2660":45609},[],{"_3162":945,"_27842":849,"_19309":48166,"_5":13254,"_25368":47921,"_2660":48167},[],"`reenrollment_delta`",{"_3162":946,"_27842":849,"_19309":48169,"_5":13254,"_25368":47921,"_2660":48170},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3162":947,"_27842":849,"_19309":48172,"_5":13254,"_25368":47921,"_2660":48173},[],"`preventive_delta`",{"_3162":948,"_27842":849,"_19309":48175,"_5":13254,"_25368":47921,"_2660":48176},[],"Preventive operational monitoring threshold.",{"_3162":949,"_27842":849,"_19309":48178,"_5":13254,"_25368":47921,"_2660":48179},[],"`critical_delta`",{"_3162":950,"_27842":849,"_19309":48181,"_5":13254,"_25368":47921,"_2660":48182},[],"Critical operational monitoring threshold.",{"_3162":951,"_27842":849,"_19309":48184,"_5":13254,"_25368":47921,"_2660":48185},[],"`enable_expired_renewal`",{"_3162":952,"_27842":849,"_19309":48187,"_5":13254,"_25368":47921,"_2660":48188},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3162":953,"_27842":849,"_19309":48190,"_5":13254,"_25368":47921,"_2660":48191},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3162":954,"_27842":849,"_19309":48193,"_5":13254,"_25368":47921,"_2660":48194},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3162":955,"_27842":849,"_19309":48196,"_5":13254,"_25368":47921,"_2660":48197},[],"`revoke_on_reenrollment`",{"_3162":956,"_27842":849,"_19309":48199,"_5":13254,"_25368":47921,"_2660":48200},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3162":957,"_27842":849,"_19309":48202,"_5":13254,"_25368":47921,"_2660":48203},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3162":958,"_27842":849,"_19309":48205,"_5":13254,"_25368":47925,"_2660":48206},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3162":959,"_27842":849,"_19309":48208,"_5":13254,"_25368":47929,"_2660":45603},[],{"_3162":960,"_27842":849,"_19309":48210,"_5":13254,"_25368":47929,"_2660":48211},[],"Published material",{"_3162":961,"_27842":849,"_19309":48213,"_5":13254,"_25368":47929,"_2660":48214},[],"**Include Lamassu System CA**",{"_3162":962,"_27842":849,"_19309":48216,"_5":13254,"_25368":47929,"_2660":48217},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3162":963,"_27842":849,"_19309":48219,"_5":13254,"_25368":47929,"_2660":48220},[],"**Include Enrollment CA**",{"_3162":964,"_27842":849,"_19309":48222,"_5":13254,"_25368":47929,"_2660":48223},[],"Selected issuing CA certificate.",{"_3162":965,"_27842":849,"_19309":48225,"_5":13254,"_25368":47929,"_2660":48226},[],"**Managed CAs**",{"_3162":966,"_27842":849,"_19309":48228,"_5":13254,"_25368":47929,"_2660":48229},[],"Explicitly selected CA certificates.",{"_3162":967,"_27842":849,"_19309":48231,"_5":13254,"_25368":47929,"_2660":48232},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3162":968,"_27842":849,"_19309":48234,"_5":13254,"_25368":47933,"_2660":48235},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_3162":969,"_27842":849,"_19309":48237,"_5":13254,"_25368":47933,"_2660":48238},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3162":970,"_27842":849,"_19309":48240,"_5":13254,"_25368":47933,"_2660":48241},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3162":971,"_27842":849,"_19309":48243,"_5":13254,"_25368":47937,"_2660":48244},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3162":972,"_27842":972,"_5":13585,"_2660":48246,"_28185":48247,"_19309":48248,"_25368":972},"Integrate the EST client",[45219,46599,47607,47605,47788],[],{"_3162":973,"_27842":972,"_19309":48250,"_5":13254,"_25368":972,"_2660":48251},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3162":974,"_27842":972,"_5":28182,"_19309":48253,"_25368":48254,"_2660":45229},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3162":975,"_27842":972,"_5":28182,"_19309":48256,"_25368":48257,"_2660":48258},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3162":976,"_27842":972,"_5":28182,"_19309":48260,"_25368":48261,"_2660":48262},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3162":977,"_27842":972,"_5":28182,"_19309":48264,"_25368":48265,"_2660":48266},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3162":978,"_27842":972,"_5":28182,"_19309":48268,"_25368":48269,"_2660":48270},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3162":979,"_27842":972,"_5":28182,"_19309":48272,"_25368":48273,"_2660":48274},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3162":980,"_27842":972,"_19309":48276,"_5":13254,"_25368":972,"_2660":48277},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3162":981,"_27842":972,"_19309":48279,"_5":13254,"_25368":48254,"_2660":48280},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3162":982,"_27842":972,"_19309":48282,"_5":13254,"_25368":48254,"_2660":48283},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3162":983,"_27842":972,"_19309":48285,"_5":13254,"_25368":48254,"_2660":48286},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3162":984,"_27842":972,"_19309":48288,"_5":13254,"_25368":48257,"_2660":48289},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3162":985,"_27842":972,"_19309":48291,"_5":13254,"_25368":48257,"_2660":48292},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3162":986,"_27842":972,"_19309":48294,"_5":13254,"_25368":48261,"_2660":48295},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3162":987,"_27842":972,"_19309":48297,"_5":13254,"_25368":48261,"_2660":48298},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3162":988,"_27842":972,"_19309":48300,"_5":13254,"_25368":48265,"_2660":48301},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3162":989,"_27842":972,"_19309":48303,"_5":13254,"_25368":48265,"_2660":48304},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3162":990,"_27842":972,"_19309":48306,"_5":13254,"_25368":48269,"_2660":48307},[],"For a root that issues directly:",{"_3162":991,"_27842":972,"_19309":48309,"_5":13254,"_25368":48269,"_2660":48310},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3162":992,"_27842":972,"_19309":48312,"_5":13254,"_25368":48269,"_2660":48313},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3162":993,"_27842":972,"_19309":48315,"_5":13254,"_25368":48273,"_2660":48316},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3162":994,"_27842":994,"_5":13585,"_2660":48318,"_28185":48319,"_19309":48320,"_25368":994},"EST reference",[45219,46599,47607,47605,47788],[],{"_3162":995,"_27842":994,"_19309":48322,"_5":13254,"_25368":994,"_2660":48323},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3162":996,"_27842":994,"_5":28182,"_19309":48325,"_25368":48326,"_2660":48327},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3162":997,"_27842":994,"_5":28182,"_19309":48329,"_25368":48330,"_2660":20990},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3162":998,"_27842":994,"_5":28182,"_19309":48332,"_25368":48333,"_2660":24059},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3162":999,"_27842":994,"_5":28182,"_19309":48335,"_25368":48336,"_2660":24066},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3162":1000,"_27842":994,"_5":28182,"_19309":48338,"_25368":48339,"_2660":23411},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3162":1001,"_27842":994,"_5":28182,"_19309":48341,"_25368":48342,"_2660":48343},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3162":1002,"_27842":994,"_5":28182,"_19309":48345,"_25368":48346,"_2660":48347},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3162":1003,"_27842":994,"_5":28182,"_19309":48349,"_25368":48350,"_2660":48351},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3162":1004,"_27842":994,"_19309":48353,"_5":13254,"_25368":994,"_2660":48354},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3162":1005,"_27842":994,"_19309":48356,"_5":13254,"_25368":48326,"_2660":48357},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3162":1006,"_27842":994,"_19309":48359,"_5":13254,"_25368":48326,"_2660":48360},[],"Operation",{"_3162":1007,"_27842":994,"_19309":48362,"_5":13254,"_25368":48326,"_2660":48363},[],"Method",{"_3162":1008,"_27842":994,"_19309":48365,"_5":13254,"_25368":48326,"_2660":48366},[],"Authentication and condition",{"_3162":1009,"_27842":994,"_19309":48368,"_5":13254,"_25368":48326,"_2660":48369},[],"`/cacerts`",{"_3162":1010,"_27842":994,"_19309":48371,"_5":13254,"_25368":48326,"_2660":48372},[],"GET",{"_3162":1011,"_27842":994,"_19309":48374,"_5":13254,"_25368":48326,"_2660":48375},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3162":1012,"_27842":994,"_19309":48377,"_5":13254,"_25368":48326,"_2660":48378},[],"`/simpleenroll`",{"_3162":1013,"_27842":994,"_19309":48380,"_5":13254,"_25368":48326,"_2660":48381},[],"POST",{"_3162":1014,"_27842":994,"_19309":48383,"_5":13254,"_25368":48326,"_2660":48384},[],"Initial authentication and DMS registration/replacement policy.",{"_3162":1015,"_27842":994,"_19309":48386,"_5":13254,"_25368":48326,"_2660":48387},[],"`/simplereenroll`",{"_3162":1016,"_27842":994,"_19309":48389,"_5":13254,"_25368":48326,"_2660":48381},[],{"_3162":1017,"_27842":994,"_19309":48391,"_5":13254,"_25368":48326,"_2660":48392},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3162":1018,"_27842":994,"_19309":48394,"_5":13254,"_25368":48326,"_2660":48395},[],"`/serverkeygen`",{"_3162":1019,"_27842":994,"_19309":48397,"_5":13254,"_25368":48326,"_2660":48381},[],{"_3162":1020,"_27842":994,"_19309":48399,"_5":13254,"_25368":48326,"_2660":48400},[],"Initial authentication and admission; server generation enabled.",{"_3162":1021,"_27842":994,"_19309":48402,"_5":13254,"_25368":48326,"_2660":48403},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3162":1022,"_27842":994,"_19309":48405,"_5":13254,"_25368":48330,"_2660":48406},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3162":1023,"_27842":994,"_19309":48408,"_5":13254,"_25368":48330,"_2660":48409},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3162":1024,"_27842":994,"_19309":48411,"_5":13254,"_25368":48333,"_2660":48412},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3162":1025,"_27842":994,"_19309":48414,"_5":13254,"_25368":48333,"_2660":48415},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3162":1026,"_27842":994,"_19309":48417,"_5":13254,"_25368":48336,"_2660":48418},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3162":1027,"_27842":994,"_19309":48420,"_5":13254,"_25368":48336,"_2660":48421},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3162":1028,"_27842":994,"_19309":48423,"_5":13254,"_25368":48339,"_2660":48424},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3162":1029,"_27842":994,"_19309":48426,"_5":13254,"_25368":48339,"_2660":48427},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3162":1030,"_27842":994,"_19309":48429,"_5":13254,"_25368":48342,"_2660":48430},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3162":1031,"_27842":994,"_19309":48432,"_5":13254,"_25368":48342,"_2660":48433},[],"Part",{"_3162":1032,"_27842":994,"_19309":48435,"_5":13254,"_25368":48342,"_2660":48436},[],"Content after decoding its Base64",{"_3162":1033,"_27842":994,"_19309":48438,"_5":13254,"_25368":48342,"_2660":48439},[],"`application/pkcs8`",{"_3162":1034,"_27842":994,"_19309":48441,"_5":13254,"_25368":48342,"_2660":48442},[],"Unencrypted DER PKCS#8 private key.",{"_3162":1035,"_27842":994,"_19309":48444,"_5":13254,"_25368":48342,"_2660":48445},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3162":1036,"_27842":994,"_19309":48447,"_5":13254,"_25368":48342,"_2660":48448},[],"DER PKCS#7 containing the issued certificate.",{"_3162":1037,"_27842":994,"_19309":48450,"_5":13254,"_25368":48342,"_2660":48451},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3162":1038,"_27842":994,"_19309":48453,"_5":13254,"_25368":48346,"_2660":48454},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3162":1039,"_27842":994,"_19309":48456,"_5":13254,"_25368":48346,"_2660":48457},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3162":1040,"_27842":994,"_19309":48459,"_5":13254,"_25368":48346,"_2660":48460},[],"Convert and check the result:",{"_3162":1041,"_27842":994,"_19309":48462,"_5":13254,"_25368":48346,"_2660":48463},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3162":1042,"_27842":994,"_19309":48465,"_5":13254,"_25368":48350,"_2660":48466},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3162":1043,"_27842":994,"_19309":48468,"_5":13254,"_25368":48350,"_2660":48469},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3162":1044,"_27842":1044,"_5":13585,"_2660":47788,"_28185":48471,"_19309":48472,"_25368":1044},[45219,46599,47607,47605,47788],[],{"_3162":1045,"_27842":1044,"_19309":48474,"_5":13254,"_25368":1044,"_2660":48475},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3162":1046,"_27842":1044,"_5":28182,"_19309":48477,"_25368":48478,"_2660":48479},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3162":1047,"_27842":1044,"_5":28182,"_19309":48481,"_25368":48482,"_2660":48483},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3162":1048,"_27842":1044,"_5":28182,"_19309":48485,"_25368":48486,"_2660":48487},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3162":1049,"_27842":1044,"_5":28182,"_19309":48489,"_25368":48490,"_2660":48491},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3162":1050,"_27842":1044,"_19309":48493,"_5":13254,"_25368":1044,"_2660":48494},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3162":1051,"_27842":1044,"_19309":48496,"_5":13254,"_25368":48478,"_2660":48497},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3162":1052,"_27842":1044,"_19309":48499,"_5":13254,"_25368":48478,"_2660":48500},[],"The integrator installs initial EST server trust and an admission credential.",{"_3162":1053,"_27842":1044,"_19309":48502,"_5":13254,"_25368":48478,"_2660":48503},[],"The client requests an identity for its `Device ID` through EST.",{"_3162":1054,"_27842":1044,"_19309":48505,"_5":13254,"_25368":48478,"_2660":48506},[],"Certificate, device binding and key/certificate installation are checked.",{"_3162":1055,"_27842":1044,"_19309":48508,"_5":13254,"_25368":48478,"_2660":48509},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3162":1056,"_27842":1044,"_19309":48511,"_5":13254,"_25368":48478,"_2660":48512},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3162":1057,"_27842":1044,"_19309":48514,"_5":13254,"_25368":48482,"_2660":48515},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3162":1058,"_27842":1044,"_19309":48517,"_5":13254,"_25368":48482,"_2660":48518},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3162":1059,"_27842":1044,"_19309":48520,"_5":13254,"_25368":48482,"_2660":48521},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3162":1060,"_27842":1044,"_19309":48523,"_5":13254,"_25368":48482,"_2660":48524},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3162":1061,"_27842":1044,"_19309":48526,"_5":13254,"_25368":48486,"_2660":48527},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3162":1062,"_27842":1044,"_19309":48529,"_5":13254,"_25368":48486,"_2660":48530},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3162":1063,"_27842":1044,"_19309":48532,"_5":13254,"_25368":48486,"_2660":48533},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3162":1064,"_27842":1044,"_19309":48535,"_5":13254,"_25368":48486,"_2660":48536},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3162":1065,"_27842":1044,"_19309":48538,"_5":13254,"_25368":48490,"_2660":48539},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3162":1066,"_27842":1044,"_19309":48541,"_5":13254,"_25368":48490,"_2660":48542},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3162":1067,"_27842":1067,"_5":13585,"_2660":48544,"_28185":48545,"_19309":48546,"_25368":1067},"Provisioning strategies",[45219,46599,47607,47605,47788],[],{"_3162":1068,"_27842":1067,"_19309":48548,"_5":13254,"_25368":1067,"_2660":48549},[],"Choose device registration, identity authorization and key generation.",{"_3162":1069,"_27842":1067,"_5":28182,"_19309":48551,"_25368":48552,"_2660":48553},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3162":1070,"_27842":1067,"_5":28182,"_19309":48555,"_25368":48556,"_2660":48557},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3162":1071,"_27842":1067,"_5":28182,"_19309":48559,"_25368":48560,"_2660":48561},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3162":1072,"_27842":1067,"_5":28182,"_19309":48563,"_25368":48564,"_2660":48565},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3162":1073,"_27842":1067,"_5":28182,"_19309":48567,"_25368":48568,"_2660":48569},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3162":1074,"_27842":1067,"_19309":48571,"_5":13254,"_25368":1067,"_2660":48572},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3162":1075,"_27842":1067,"_19309":48574,"_5":13254,"_25368":48552,"_2660":48575},[],"Path",{"_3162":1076,"_27842":1067,"_19309":48577,"_5":13254,"_25368":48552,"_2660":48578},[],"When the device exists",{"_3162":1077,"_27842":1067,"_19309":48580,"_5":13254,"_25368":48552,"_2660":48581},[],"What to check",{"_3162":1078,"_27842":1067,"_19309":48583,"_5":13254,"_25368":48552,"_2660":48584},[],"Manual assignment",{"_3162":1079,"_27842":1067,"_19309":48586,"_5":13254,"_25368":48552,"_2660":48587},[],"An operator creates it before associating a certificate.",{"_3162":1080,"_27842":1067,"_19309":48589,"_5":13254,"_25368":48552,"_2660":48590},[],"ID, owning DMS, certificate CN and bound serial.",{"_3162":1081,"_27842":1067,"_19309":48592,"_5":13254,"_25368":48552,"_2660":48593},[],"EST with `JITP`",{"_3162":1082,"_27842":1067,"_19309":48595,"_5":13254,"_25368":48552,"_2660":48596},[],"Created for an unknown CN during `/simpleenroll`.",{"_3162":1083,"_27842":1067,"_19309":48598,"_5":13254,"_25368":48552,"_2660":48599},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3162":1084,"_27842":1067,"_19309":48601,"_5":13254,"_25368":48552,"_2660":48602},[],"EST with `PRE_REGISTRATION`",{"_3162":1085,"_27842":1067,"_19309":48604,"_5":13254,"_25368":48552,"_2660":48605},[],"Must exist before `/simpleenroll`.",{"_3162":1086,"_27842":1067,"_19309":48607,"_5":13254,"_25368":48552,"_2660":48608},[],"Approved record, same DMS and replacement conditions for your version.",{"_3162":1087,"_27842":1067,"_19309":48610,"_5":13254,"_25368":48552,"_2660":48611},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3162":1088,"_27842":1067,"_19309":48613,"_5":13254,"_25368":48552,"_2660":48614},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3162":1089,"_27842":1067,"_19309":48616,"_5":13254,"_25368":48556,"_2660":48617},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3162":1090,"_27842":1067,"_19309":48619,"_5":13254,"_25368":48556,"_2660":48620},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3162":1091,"_27842":1067,"_19309":48622,"_5":13254,"_25368":48556,"_2660":48623},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3162":1092,"_27842":1067,"_19309":48625,"_5":13254,"_25368":48560,"_2660":48626},[],"Decide initial enrollment and re-enrollment separately:",{"_3162":1093,"_27842":1067,"_19309":48628,"_5":13254,"_25368":48560,"_2660":48629},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3162":1094,"_27842":1067,"_19309":48631,"_5":13254,"_25368":48560,"_2660":48632},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3162":1095,"_27842":1067,"_19309":48634,"_5":13254,"_25368":48560,"_2660":48635},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3162":1096,"_27842":1067,"_19309":48637,"_5":13254,"_25368":48560,"_2660":48638},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3162":1097,"_27842":1067,"_19309":48640,"_5":13254,"_25368":48560,"_2660":48641},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3162":1098,"_27842":1067,"_19309":48643,"_5":13254,"_25368":48564,"_2660":45603},[],{"_3162":1099,"_27842":1067,"_19309":48645,"_5":13254,"_25368":48564,"_2660":48646},[],"Material crossing EST",{"_3162":1100,"_27842":1067,"_19309":48648,"_5":13254,"_25368":48564,"_2660":48649},[],"Device-generated key",{"_3162":1101,"_27842":1067,"_19309":48651,"_5":13254,"_25368":48564,"_2660":48652},[],"Public CSR and certificate; the key stays on the client.",{"_3162":1102,"_27842":1067,"_19309":48654,"_5":13254,"_25368":48564,"_2660":48655},[],"Existing device key",{"_3162":1103,"_27842":1067,"_19309":48657,"_5":13254,"_25368":48564,"_2660":48658},[],"CSR signed with that key and a new certificate.",{"_3162":1104,"_27842":1067,"_19309":48660,"_5":13254,"_25368":48564,"_2660":47926},[],{"_3162":1105,"_27842":1067,"_19309":48662,"_5":13254,"_25368":48564,"_2660":48663},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3162":1106,"_27842":1067,"_19309":48665,"_5":13254,"_25368":48564,"_2660":48666},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3162":1107,"_27842":1067,"_19309":48668,"_5":13254,"_25368":48568,"_2660":48669},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3162":1108,"_27842":1108,"_5":13585,"_2660":48671,"_28185":48672,"_19309":48673,"_25368":1108},"Renewal and recovery",[45219,46599,47607,47605,47788],[],{"_3162":1109,"_27842":1108,"_19309":48675,"_5":13254,"_25368":1108,"_2660":48676},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3162":1110,"_27842":1108,"_5":28182,"_19309":48678,"_25368":48679,"_2660":48680},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3162":1111,"_27842":1108,"_5":28182,"_19309":48682,"_25368":48683,"_2660":48684},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3162":1112,"_27842":1108,"_5":28182,"_19309":48686,"_25368":48687,"_2660":48688},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3162":1113,"_27842":1108,"_5":28182,"_19309":48690,"_25368":48691,"_2660":48692},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3162":1114,"_27842":1108,"_5":28182,"_19309":48694,"_25368":48695,"_2660":48696},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3162":1115,"_27842":1108,"_19309":48698,"_5":13254,"_25368":1108,"_2660":48699},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3162":1116,"_27842":1108,"_19309":48701,"_5":13254,"_25368":48679,"_2660":48702},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3162":1117,"_27842":1108,"_19309":48704,"_5":13254,"_25368":48679,"_2660":48705},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3162":1118,"_27842":1108,"_19309":48707,"_5":13254,"_25368":48679,"_2660":48708},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3162":1119,"_27842":1108,"_19309":48710,"_5":13254,"_25368":48679,"_2660":48711},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3162":1120,"_27842":1108,"_19309":48713,"_5":13254,"_25368":48683,"_2660":48714},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3162":1121,"_27842":1108,"_19309":48716,"_5":13254,"_25368":48683,"_2660":48717},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3162":1122,"_27842":1108,"_19309":48719,"_5":13254,"_25368":48687,"_2660":48720},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3162":1123,"_27842":1108,"_19309":48722,"_5":13254,"_25368":48687,"_2660":48723},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3162":1124,"_27842":1108,"_19309":48725,"_5":13254,"_25368":48687,"_2660":48726},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3162":1125,"_27842":1108,"_19309":48728,"_5":13254,"_25368":48691,"_2660":48729},[],"Situation",{"_3162":1126,"_27842":1108,"_19309":48731,"_5":13254,"_25368":48691,"_2660":48732},[],"Procedure",{"_3162":1127,"_27842":1108,"_19309":48734,"_5":13254,"_25368":48691,"_2660":48735},[],"Valid certificate, outside the window",{"_3162":1128,"_27842":1108,"_19309":48737,"_5":13254,"_25368":48691,"_2660":48738},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3162":1129,"_27842":1108,"_19309":48740,"_5":13254,"_25368":48691,"_2660":48741},[],"Expired certificate, key available",{"_3162":1130,"_27842":1108,"_19309":48743,"_5":13254,"_25368":48691,"_2660":48744},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3162":1131,"_27842":1108,"_19309":48746,"_5":13254,"_25368":48691,"_2660":48747},[],"Renewal through webhook or `NO_AUTH`",{"_3162":1132,"_27842":1108,"_19309":48749,"_5":13254,"_25368":48691,"_2660":48750},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3162":1133,"_27842":1108,"_19309":48752,"_5":13254,"_25368":48691,"_2660":48753},[],"Lost or inaccessible key",{"_3162":1134,"_27842":1108,"_19309":48755,"_5":13254,"_25368":48691,"_2660":48756},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3162":1135,"_27842":1108,"_19309":48758,"_5":13254,"_25368":48691,"_2660":48759},[],"Current identity revoked",{"_3162":1136,"_27842":1108,"_19309":48761,"_5":13254,"_25368":48691,"_2660":48762},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3162":1137,"_27842":1108,"_19309":48764,"_5":13254,"_25368":48691,"_2660":48765},[],"Device without an identity",{"_3162":1138,"_27842":1108,"_19309":48767,"_5":13254,"_25368":48691,"_2660":48768},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3162":1139,"_27842":1108,"_19309":48770,"_5":13254,"_25368":48691,"_2660":48771},[],"Retired device",{"_3162":1140,"_27842":1108,"_19309":48773,"_5":13254,"_25368":48691,"_2660":48774},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3162":1141,"_27842":1108,"_19309":48776,"_5":13254,"_25368":48691,"_2660":48777},[],"Timeout, HTTP 500 or installation failure",{"_3162":1142,"_27842":1108,"_19309":48779,"_5":13254,"_25368":48691,"_2660":48780},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3162":1143,"_27842":1108,"_19309":48782,"_5":13254,"_25368":48695,"_2660":48783},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3162":1144,"_27842":1108,"_19309":48785,"_5":13254,"_25368":48695,"_2660":48786},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3162":1145,"_27842":1145,"_5":13585,"_2660":48788,"_28185":48789,"_19309":48790,"_25368":1145},"Enrollment troubleshooting",[45219,46599,47607,47605,47788],[],{"_3162":1146,"_27842":1145,"_19309":48792,"_5":13254,"_25368":1145,"_2660":48793},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3162":1147,"_27842":1145,"_5":28182,"_19309":48795,"_25368":48796,"_2660":48797},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3162":1148,"_27842":1145,"_5":28182,"_19309":48799,"_25368":48800,"_2660":48801},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3162":1149,"_27842":1145,"_5":28182,"_19309":48803,"_25368":48804,"_2660":48351},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3162":1150,"_27842":1145,"_5":28182,"_19309":48806,"_25368":48807,"_2660":48808},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3162":1151,"_27842":1145,"_19309":48810,"_5":13254,"_25368":1145,"_2660":48811},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3162":1152,"_27842":1145,"_19309":48813,"_5":13254,"_25368":48800,"_2660":48814},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3162":1153,"_27842":1145,"_19309":48816,"_5":13254,"_25368":48800,"_2660":48817},[],"Symptom or message",{"_3162":1154,"_27842":1145,"_19309":48819,"_5":13254,"_25368":48800,"_2660":48581},[],{"_3162":1155,"_27842":1145,"_19309":48821,"_5":13254,"_25368":48800,"_2660":48822},[],"curl rejects TLS, name or issuer",{"_3162":1156,"_27842":1145,"_19309":48824,"_5":13254,"_25368":48800,"_2660":48825},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3162":1157,"_27842":1145,"_19309":48827,"_5":13254,"_25368":48800,"_2660":48828},[],"404 or missing APS",{"_3162":1158,"_27842":1145,"_19309":48830,"_5":13254,"_25368":48800,"_2660":48831},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3162":1159,"_27842":1145,"_19309":48833,"_5":13254,"_25368":48800,"_2660":48834},[],"400, CSR or format error",{"_3162":1160,"_27842":1145,"_19309":48836,"_5":13254,"_25368":48800,"_2660":48837},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3162":1161,"_27842":1145,"_19309":48839,"_5":13254,"_25368":48800,"_2660":48840},[],"Missing credential or invalid certificate",{"_3162":1162,"_27842":1145,"_19309":48842,"_5":13254,"_25368":48800,"_2660":48843},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3162":1163,"_27842":1145,"_19309":48845,"_5":13254,"_25368":48800,"_2660":48846},[],"Webhook denies, times out or responds without authorization",{"_3162":1164,"_27842":1145,"_19309":48848,"_5":13254,"_25368":48800,"_2660":48849},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3162":1165,"_27842":1145,"_19309":48851,"_5":13254,"_25368":48800,"_2660":48852},[],"`unexpected status code: <n>: redirects are not followed`",{"_3162":1166,"_27842":1145,"_19309":48854,"_5":13254,"_25368":48800,"_2660":48855},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3162":1167,"_27842":1145,"_19309":48857,"_5":13254,"_25368":48800,"_2660":48858},[],"`webhook response exceeds 1048576 bytes`",{"_3162":1168,"_27842":1145,"_19309":48860,"_5":13254,"_25368":48800,"_2660":48861},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3162":1169,"_27842":1145,"_19309":48863,"_5":13254,"_25368":48800,"_2660":48864},[],"`webhook config must not reference files`",{"_3162":1170,"_27842":1145,"_19309":48866,"_5":13254,"_25368":48800,"_2660":48867},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3162":1171,"_27842":1145,"_19309":48869,"_5":13254,"_25368":48800,"_2660":48870},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3162":1172,"_27842":1145,"_19309":48872,"_5":13254,"_25368":48800,"_2660":48873},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3162":1173,"_27842":1145,"_19309":48875,"_5":13254,"_25368":48800,"_2660":48876},[],"`webhook mTLS certificate and key are invalid: …`",{"_3162":1174,"_27842":1145,"_19309":48878,"_5":13254,"_25368":48800,"_2660":48879},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3162":1175,"_27842":1145,"_19309":48881,"_5":13254,"_25368":48800,"_2660":48882},[],"400 `struct validation error` creating or updating a DMS",{"_3162":1176,"_27842":1145,"_19309":48884,"_5":13254,"_25368":48800,"_2660":48885},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3162":1177,"_27842":1145,"_19309":48887,"_5":13254,"_25368":48800,"_2660":48888},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3162":1178,"_27842":1145,"_19309":48890,"_5":13254,"_25368":48800,"_2660":48891},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3162":1179,"_27842":1145,"_19309":48893,"_5":13254,"_25368":48800,"_2660":48894},[],"`device not preregistered`",{"_3162":1180,"_27842":1145,"_19309":48896,"_5":13254,"_25368":48800,"_2660":48897},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3162":1181,"_27842":1145,"_19309":48899,"_5":13254,"_25368":48800,"_2660":48900},[],"`forbiddenNewEnrollment`",{"_3162":1182,"_27842":1145,"_19309":48902,"_5":13254,"_25368":48800,"_2660":48903},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3162":1183,"_27842":1145,"_19309":48905,"_5":13254,"_25368":48800,"_2660":48906},[],"Different owning DMS",{"_3162":1184,"_27842":1145,"_19309":48908,"_5":13254,"_25368":48800,"_2660":48909},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3162":1185,"_27842":1145,"_19309":48911,"_5":13254,"_25368":48800,"_2660":48912},[],"`invalid RawSubject bytes`",{"_3162":1186,"_27842":1145,"_19309":48914,"_5":13254,"_25368":48800,"_2660":48915},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3162":1187,"_27842":1145,"_19309":48917,"_5":13254,"_25368":48800,"_2660":48918},[],"`invalid reenroll window`",{"_3162":1188,"_27842":1145,"_19309":48920,"_5":13254,"_25368":48800,"_2660":48921},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3162":1189,"_27842":1145,"_19309":48923,"_5":13254,"_25368":48800,"_2660":48924},[],"Current certificate revoked",{"_3162":1190,"_27842":1145,"_19309":48926,"_5":13254,"_25368":48800,"_2660":48927},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3162":1191,"_27842":1145,"_19309":48929,"_5":13254,"_25368":48800,"_2660":48930},[],"CA, profile or signing error",{"_3162":1192,"_27842":1145,"_19309":48932,"_5":13254,"_25368":48800,"_2660":48933},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3162":1193,"_27842":1145,"_19309":48935,"_5":13254,"_25368":48800,"_2660":48936},[],"HTTP 200 without a device connection",{"_3162":1194,"_27842":1145,"_19309":48938,"_5":13254,"_25368":48800,"_2660":48939},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3162":1195,"_27842":1145,"_19309":48941,"_5":13254,"_25368":48800,"_2660":48942},[],"Timeout or error after issuance",{"_3162":1196,"_27842":1145,"_19309":48944,"_5":13254,"_25368":48800,"_2660":48945},[],"New certificates, current slot and previous identity's state before retrying.",{"_3162":1197,"_27842":1145,"_19309":48947,"_5":13254,"_25368":48804,"_2660":48948},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3162":1198,"_27842":1145,"_19309":48950,"_5":13254,"_25368":48804,"_2660":48951},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3162":1199,"_27842":1145,"_19309":48953,"_5":13254,"_25368":48807,"_2660":48954},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3162":1200,"_27842":1145,"_19309":48956,"_5":13254,"_25368":48807,"_2660":48957},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3162":1201,"_27842":1145,"_19309":48959,"_5":13254,"_25368":48807,"_2660":48960},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3162":1202,"_27842":1145,"_19309":48962,"_5":13254,"_25368":48807,"_2660":48963},[],"Make one request, save headers/body and query the device and certificates.",{"_3162":1203,"_27842":1145,"_19309":48965,"_5":13254,"_25368":48807,"_2660":48966},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3162":1204,"_27842":1145,"_19309":48968,"_5":13254,"_25368":48807,"_2660":48969},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3162":1205,"_27842":1145,"_19309":48971,"_5":13254,"_25368":48807,"_2660":48972},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3162":1206,"_27842":1206,"_5":13585,"_2660":48974,"_28185":48975,"_19309":48976,"_25368":1206},"Trust distribution and updates",[45219,46599,47607,47605,47788],[],{"_3162":1207,"_27842":1206,"_19309":48978,"_5":13254,"_25368":1206,"_2660":48979},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3162":1208,"_27842":1206,"_5":28182,"_19309":48981,"_25368":48982,"_2660":48983},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3162":1209,"_27842":1206,"_5":28182,"_19309":48985,"_25368":48986,"_2660":48987},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3162":1210,"_27842":1206,"_5":28182,"_19309":48989,"_25368":48990,"_2660":48991},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3162":1211,"_27842":1206,"_5":28182,"_19309":48993,"_25368":48994,"_2660":48995},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3162":1212,"_27842":1206,"_5":28182,"_19309":48997,"_25368":48998,"_2660":48999},[],"/docs/pr-preview/pr-39/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3162":1213,"_27842":1206,"_19309":49001,"_5":13254,"_25368":1206,"_2660":49002},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3162":1214,"_27842":1206,"_19309":49004,"_5":13254,"_25368":48982,"_2660":49005},[],"Relationship",{"_3162":1215,"_27842":1206,"_19309":49007,"_5":13254,"_25368":48982,"_2660":49008},[],"Material prepared by its owner",{"_3162":1216,"_27842":1206,"_19309":49010,"_5":13254,"_25368":48982,"_2660":49011},[],"Device → EST server",{"_3162":1217,"_27842":1206,"_19309":49013,"_5":13254,"_25368":48982,"_2660":49014},[],"Previously verified server root, chain or pin and TLS name.",{"_3162":1218,"_27842":1206,"_19309":49016,"_5":13254,"_25368":48982,"_2660":49017},[],"DMS → requester",{"_3162":1219,"_27842":1206,"_19309":49019,"_5":13254,"_25368":48982,"_2660":49020},[],"CAs and rules authorizing initial or renewal credentials.",{"_3162":1220,"_27842":1206,"_19309":49022,"_5":13254,"_25368":48982,"_2660":49023},[],"Consumer → device",{"_3162":1221,"_27842":1206,"_19309":49025,"_5":13254,"_25368":48982,"_2660":49026},[],"Operational identity roots, intermediates, validation and permissions.",{"_3162":1222,"_27842":1206,"_19309":49028,"_5":13254,"_25368":48982,"_2660":49029},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3162":1223,"_27842":1206,"_19309":49031,"_5":13254,"_25368":48986,"_2660":49032},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3162":1224,"_27842":1206,"_19309":49034,"_5":13254,"_25368":48986,"_2660":49035},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3162":1225,"_27842":1206,"_19309":49037,"_5":13254,"_25368":48990,"_2660":49038},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3162":1226,"_27842":1206,"_19309":49040,"_5":13254,"_25368":48990,"_2660":49041},[],"Select policy-approved roots as anchors.",{"_3162":1227,"_27842":1206,"_19309":49043,"_5":13254,"_25368":48990,"_2660":49044},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3162":1228,"_27842":1206,"_19309":49046,"_5":13254,"_25368":48990,"_2660":49047},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3162":1229,"_27842":1206,"_19309":49049,"_5":13254,"_25368":48990,"_2660":49050},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3162":1230,"_27842":1206,"_19309":49052,"_5":13254,"_25368":48990,"_2660":49053},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3162":1231,"_27842":1206,"_19309":49055,"_5":13254,"_25368":48994,"_2660":49056},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3162":1232,"_27842":1206,"_19309":49058,"_5":13254,"_25368":48994,"_2660":49059},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3162":1233,"_27842":1206,"_19309":49061,"_5":13254,"_25368":48994,"_2660":49062},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3162":1234,"_27842":1206,"_19309":49064,"_5":13254,"_25368":48998,"_2660":49065},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3162":1235,"_27842":1235,"_5":13585,"_2660":49067,"_28185":49068,"_19309":49070,"_25368":1235},"AWS IoT Core",[45219,46599,47607,47605,49069],"Integrations",[],{"_3162":1236,"_27842":1235,"_19309":49072,"_5":13254,"_25368":1235,"_2660":49073},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3162":1237,"_27842":1235,"_5":28182,"_19309":49075,"_25368":49076,"_2660":49077},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3162":1238,"_27842":1235,"_5":28182,"_19309":49079,"_25368":49080,"_2660":49081},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3162":1239,"_27842":1235,"_5":28182,"_19309":49083,"_25368":49084,"_2660":49085},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3162":1240,"_27842":1235,"_5":28182,"_19309":49087,"_25368":49088,"_2660":49089},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3162":1241,"_27842":1235,"_5":28182,"_19309":49091,"_25368":49092,"_2660":49093},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3162":1242,"_27842":1235,"_5":28182,"_19309":49095,"_25368":49096,"_2660":49097},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3162":1243,"_27842":1235,"_5":28182,"_19309":49099,"_25368":49100,"_2660":49101},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3162":1244,"_27842":1235,"_5":28182,"_19309":49103,"_25368":49104,"_2660":49105},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3162":1245,"_27842":1235,"_5":28182,"_19309":49107,"_25368":49108,"_2660":49109},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3162":1246,"_27842":1235,"_5":28182,"_19309":49111,"_25368":49112,"_2660":49113},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3162":1247,"_27842":1235,"_5":28182,"_19309":49115,"_25368":49116,"_2660":49117},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3162":1248,"_27842":1235,"_5":28182,"_19309":49119,"_25368":49120,"_2660":49121},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3162":1249,"_27842":1235,"_5":28182,"_19309":49123,"_25368":49124,"_2660":49125},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3162":1250,"_27842":1235,"_5":28182,"_19309":49127,"_25368":49128,"_2660":49129},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3162":1251,"_27842":1235,"_5":28182,"_19309":49131,"_25368":49132,"_2660":49133},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3162":1252,"_27842":1235,"_5":28182,"_19309":49135,"_25368":49136,"_2660":49137},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3162":1253,"_27842":1235,"_5":28182,"_19309":49139,"_25368":49140,"_2660":49141},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3162":1254,"_27842":1235,"_5":28182,"_19309":49143,"_25368":49144,"_2660":49145},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3162":1255,"_27842":1235,"_5":28182,"_19309":49147,"_25368":49148,"_2660":49149},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3162":1256,"_27842":1235,"_5":28182,"_19309":49151,"_25368":49152,"_2660":49153},[],"/docs/pr-preview/pr-39/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3162":1257,"_27842":1235,"_19309":49155,"_5":13254,"_25368":1235,"_2660":49156},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3162":1258,"_27842":1235,"_19309":49158,"_5":13254,"_25368":1235,"_2660":49159},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3162":1259,"_27842":1235,"_19309":49161,"_5":13254,"_25368":1235,"_2660":49162},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3162":1260,"_27842":1235,"_19309":49164,"_5":13254,"_25368":49076,"_2660":49165},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3162":1261,"_27842":1235,"_19309":49167,"_5":13254,"_25368":49076,"_2660":49168},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3162":1262,"_27842":1235,"_19309":49170,"_5":13254,"_25368":49076,"_2660":49171},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3162":1263,"_27842":1235,"_19309":49173,"_5":13254,"_25368":49076,"_2660":49174},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3162":1264,"_27842":1235,"_19309":49176,"_5":13254,"_25368":49080,"_2660":49177},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3162":1265,"_27842":1235,"_19309":49179,"_5":13254,"_25368":49084,"_2660":49180},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3162":1266,"_27842":1235,"_19309":49182,"_5":13254,"_25368":49084,"_2660":49183},[],"IAM action",{"_3162":1267,"_27842":1235,"_19309":49185,"_5":13254,"_25368":49084,"_2660":45609},[],{"_3162":1268,"_27842":1235,"_19309":49187,"_5":13254,"_25368":49084,"_2660":49188},[],"`iot:GetRegistrationCode`",{"_3162":1269,"_27842":1235,"_19309":49190,"_5":13254,"_25368":49084,"_2660":49191},[],"Obtain the verification code for CA registration in the Primary Account",{"_3162":1270,"_27842":1235,"_19309":49193,"_5":13254,"_25368":49084,"_2660":49194},[],"`iot:RegisterCACertificate`",{"_3162":1271,"_27842":1235,"_19309":49196,"_5":13254,"_25368":49084,"_2660":49197},[],"Register the CA in AWS IoT",{"_3162":1272,"_27842":1235,"_19309":49199,"_5":13254,"_25368":49084,"_2660":49200},[],"`iot:DescribeCACertificate`",{"_3162":1273,"_27842":1235,"_19309":49202,"_5":13254,"_25368":49084,"_2660":49203},[],"Check the CA registration status",{"_3162":1274,"_27842":1235,"_19309":49205,"_5":13254,"_25368":49084,"_2660":49206},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3162":1275,"_27842":1235,"_19309":49208,"_5":13254,"_25368":49084,"_2660":49209},[],"Create or update Things in IoT Core",{"_3162":1276,"_27842":1235,"_19309":49211,"_5":13254,"_25368":49084,"_2660":49212},[],"`iot:RegisterThing`",{"_3162":1277,"_27842":1235,"_19309":49214,"_5":13254,"_25368":49084,"_2660":49215},[],"Provision Things through a template",{"_3162":1278,"_27842":1235,"_19309":49217,"_5":13254,"_25368":49084,"_2660":49218},[],"`iot:RegisterCertificate`",{"_3162":1279,"_27842":1235,"_19309":49220,"_5":13254,"_25368":49084,"_2660":49221},[],"Register device certificates",{"_3162":1280,"_27842":1235,"_19309":49223,"_5":13254,"_25368":49084,"_2660":49224},[],"`iot:UpdateCertificate`",{"_3162":1281,"_27842":1235,"_19309":49226,"_5":13254,"_25368":49084,"_2660":49227},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3162":1282,"_27842":1235,"_19309":49229,"_5":13254,"_25368":49084,"_2660":49230},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3162":1283,"_27842":1235,"_19309":49232,"_5":13254,"_25368":49084,"_2660":49233},[],"Create and attach IoT policies",{"_3162":1284,"_27842":1235,"_19309":49235,"_5":13254,"_25368":49084,"_2660":49236},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3162":1285,"_27842":1235,"_19309":49238,"_5":13254,"_25368":49084,"_2660":49239},[],"Manage Thing groups",{"_3162":1286,"_27842":1235,"_19309":49241,"_5":13254,"_25368":49084,"_2660":49242},[],"`iot:CreateProvisioningTemplate`",{"_3162":1287,"_27842":1235,"_19309":49244,"_5":13254,"_25368":49084,"_2660":49245},[],"Create JITP templates",{"_3162":1288,"_27842":1235,"_19309":49247,"_5":13254,"_25368":49084,"_2660":49248},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3162":1289,"_27842":1235,"_19309":49250,"_5":13254,"_25368":49084,"_2660":49251},[],"Read and write the Device Shadow",{"_3162":1290,"_27842":1235,"_19309":49253,"_5":13254,"_25368":49084,"_2660":49254},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3162":1291,"_27842":1235,"_19309":49256,"_5":13254,"_25368":49088,"_2660":49257},[],"Parameter",{"_3162":1292,"_27842":1235,"_19309":49259,"_5":13254,"_25368":49088,"_2660":49260},[],"Type",{"_3162":1293,"_27842":1235,"_19309":49262,"_5":13254,"_25368":49088,"_2660":49263},[],"Required",{"_3162":1294,"_27842":1235,"_19309":49265,"_5":13254,"_25368":49088,"_2660":49266},[],"Description",{"_3162":1295,"_27842":1235,"_19309":49268,"_5":13254,"_25368":49088,"_2660":49269},[],"`connector_id`",{"_3162":1296,"_27842":1235,"_19309":49271,"_5":13254,"_25368":49088,"_2660":23088},[],{"_3162":1297,"_27842":1235,"_19309":49273,"_5":13254,"_25368":49088,"_2660":49274},[],"Yes",{"_3162":1298,"_27842":1235,"_19309":49276,"_5":13254,"_25368":49088,"_2660":49277},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3162":1299,"_27842":1235,"_19309":49279,"_5":13254,"_25368":49088,"_2660":49280},[],"`aws_config.region`",{"_3162":1300,"_27842":1235,"_19309":49282,"_5":13254,"_25368":49088,"_2660":23088},[],{"_3162":1301,"_27842":1235,"_19309":49284,"_5":13254,"_25368":49088,"_2660":49274},[],{"_3162":1302,"_27842":1235,"_19309":49286,"_5":13254,"_25368":49088,"_2660":49287},[],"AWS region where the connector operates.",{"_3162":1303,"_27842":1235,"_19309":49289,"_5":13254,"_25368":49088,"_2660":49290},[],"`aws_config.auth_method`",{"_3162":1304,"_27842":1235,"_19309":49292,"_5":13254,"_25368":49088,"_2660":23088},[],{"_3162":1305,"_27842":1235,"_19309":49294,"_5":13254,"_25368":49088,"_2660":49274},[],{"_3162":1306,"_27842":1235,"_19309":49296,"_5":13254,"_25368":49088,"_2660":49297},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3162":1307,"_27842":1235,"_19309":49299,"_5":13254,"_25368":49088,"_2660":49300},[],"`aws_config.access_key_id`",{"_3162":1308,"_27842":1235,"_19309":49302,"_5":13254,"_25368":49088,"_2660":23088},[],{"_3162":1309,"_27842":1235,"_19309":49304,"_5":13254,"_25368":49088,"_2660":49305},[],"Only with `auth_method=static`",{"_3162":1310,"_27842":1235,"_19309":49307,"_5":13254,"_25368":49088,"_2660":49308},[],"AWS access key.",{"_3162":1311,"_27842":1235,"_19309":49310,"_5":13254,"_25368":49088,"_2660":49311},[],"`aws_config.secret_access_key`",{"_3162":1312,"_27842":1235,"_19309":49313,"_5":13254,"_25368":49088,"_2660":23088},[],{"_3162":1313,"_27842":1235,"_19309":49315,"_5":13254,"_25368":49088,"_2660":49305},[],{"_3162":1314,"_27842":1235,"_19309":49317,"_5":13254,"_25368":49088,"_2660":49318},[],"AWS secret key.",{"_3162":1315,"_27842":1235,"_19309":49320,"_5":13254,"_25368":49088,"_2660":49321},[],"`aws_config.session_token`",{"_3162":1316,"_27842":1235,"_19309":49323,"_5":13254,"_25368":49088,"_2660":23088},[],{"_3162":1317,"_27842":1235,"_19309":49325,"_5":13254,"_25368":49088,"_2660":49326},[],"No",{"_3162":1318,"_27842":1235,"_19309":49328,"_5":13254,"_25368":49088,"_2660":49329},[],"Session token (with `auth_method=static`).",{"_3162":1319,"_27842":1235,"_19309":49331,"_5":13254,"_25368":49088,"_2660":49332},[],"`aws_config.role_arn`",{"_3162":1320,"_27842":1235,"_19309":49334,"_5":13254,"_25368":49088,"_2660":23088},[],{"_3162":1321,"_27842":1235,"_19309":49336,"_5":13254,"_25368":49088,"_2660":49337},[],"Only with `auth_method=role`",{"_3162":1322,"_27842":1235,"_19309":49339,"_5":13254,"_25368":49088,"_2660":49340},[],"ARN of the role to assume.",{"_3162":1323,"_27842":1235,"_19309":49342,"_5":13254,"_25368":49088,"_2660":49343},[],"`aws_config.endpoint_url`",{"_3162":1324,"_27842":1235,"_19309":49345,"_5":13254,"_25368":49088,"_2660":23088},[],{"_3162":1325,"_27842":1235,"_19309":49347,"_5":13254,"_25368":49088,"_2660":49326},[],{"_3162":1326,"_27842":1235,"_19309":49349,"_5":13254,"_25368":49088,"_2660":49350},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3162":1327,"_27842":1235,"_19309":49352,"_5":13254,"_25368":49088,"_2660":49353},[],"`subscriber_event_bus`",{"_3162":1328,"_27842":1235,"_19309":49355,"_5":13254,"_25368":49088,"_2660":16263},[],{"_3162":1329,"_27842":1235,"_19309":49357,"_5":13254,"_25368":49088,"_2660":49274},[],{"_3162":1330,"_27842":1235,"_19309":49359,"_5":13254,"_25368":49088,"_2660":49360},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3162":1331,"_27842":1235,"_19309":49362,"_5":13254,"_25368":49088,"_2660":49363},[],"`dms_manager_client`",{"_3162":1332,"_27842":1235,"_19309":49365,"_5":13254,"_25368":49088,"_2660":23088},[],{"_3162":1333,"_27842":1235,"_19309":49367,"_5":13254,"_25368":49088,"_2660":49274},[],{"_3162":1334,"_27842":1235,"_19309":49369,"_5":13254,"_25368":49088,"_2660":49370},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3162":1335,"_27842":1235,"_19309":49372,"_5":13254,"_25368":49088,"_2660":49373},[],"`device_manager_client`",{"_3162":1336,"_27842":1235,"_19309":49375,"_5":13254,"_25368":49088,"_2660":23088},[],{"_3162":1337,"_27842":1235,"_19309":49377,"_5":13254,"_25368":49088,"_2660":49274},[],{"_3162":1338,"_27842":1235,"_19309":49379,"_5":13254,"_25368":49088,"_2660":49380},[],"HTTP URL of Lamassu's Device Manager.",{"_3162":1339,"_27842":1235,"_19309":49382,"_5":13254,"_25368":49088,"_2660":49383},[],"`ca_client`",{"_3162":1340,"_27842":1235,"_19309":49385,"_5":13254,"_25368":49088,"_2660":23088},[],{"_3162":1341,"_27842":1235,"_19309":49387,"_5":13254,"_25368":49088,"_2660":49274},[],{"_3162":1342,"_27842":1235,"_19309":49389,"_5":13254,"_25368":49088,"_2660":49390},[],"HTTP URL of Lamassu's CA service.",{"_3162":1343,"_27842":1235,"_19309":49392,"_5":13254,"_25368":49092,"_2660":49393},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3162":1344,"_27842":1235,"_19309":49395,"_5":13254,"_25368":49096,"_2660":49396},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3162":1345,"_27842":1235,"_19309":49398,"_5":13254,"_25368":49096,"_2660":49399},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3162":1346,"_27842":1235,"_19309":49401,"_5":13254,"_25368":49100,"_2660":49402},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3162":1347,"_27842":1235,"_19309":49404,"_5":13254,"_25368":49100,"_2660":49405},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3162":1348,"_27842":1235,"_19309":49407,"_5":13254,"_25368":49100,"_2660":49408},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3162":1349,"_27842":1235,"_19309":49410,"_5":13254,"_25368":49100,"_2660":49411},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3162":1350,"_27842":1235,"_19309":49413,"_5":13254,"_25368":49100,"_2660":49414},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3162":1351,"_27842":1235,"_19309":49416,"_5":13254,"_25368":49100,"_2660":49417},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3162":1352,"_27842":1235,"_19309":49419,"_5":13254,"_25368":49104,"_2660":49420},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3162":1353,"_27842":1235,"_19309":49422,"_5":13254,"_25368":49108,"_2660":49423},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3162":1354,"_27842":1235,"_19309":49425,"_5":13254,"_25368":49108,"_2660":49426},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3162":1355,"_27842":1235,"_19309":49428,"_5":13254,"_25368":49112,"_2660":49429},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3162":1356,"_27842":1235,"_19309":49431,"_5":13254,"_25368":49116,"_2660":49432},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3162":1357,"_27842":1235,"_19309":49434,"_5":13254,"_25368":49116,"_2660":49435},[],"Creates or updates the IoT policies configured in the DMS.",{"_3162":1358,"_27842":1235,"_19309":49437,"_5":13254,"_25368":49116,"_2660":49438},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3162":1359,"_27842":1235,"_19309":49440,"_5":13254,"_25368":49116,"_2660":49441},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3162":1360,"_27842":1235,"_19309":49443,"_5":13254,"_25368":49116,"_2660":49444},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3162":1361,"_27842":1235,"_19309":49446,"_5":13254,"_25368":49116,"_2660":49447},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3162":1362,"_27842":1235,"_19309":49449,"_5":13254,"_25368":49116,"_2660":49450},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3162":1363,"_27842":1235,"_19309":49452,"_5":13254,"_25368":49120,"_2660":49453},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3162":1364,"_27842":1235,"_19309":49455,"_5":13254,"_25368":49120,"_2660":49456},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3162":1365,"_27842":1235,"_19309":49458,"_5":13254,"_25368":49120,"_2660":49459},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3162":1366,"_27842":1235,"_19309":49461,"_5":13254,"_25368":49124,"_2660":49462},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3162":1367,"_27842":1235,"_19309":49464,"_5":13254,"_25368":49124,"_2660":49465},[],"The full flow from the device's perspective is:",{"_3162":1368,"_27842":1235,"_19309":49467,"_5":13254,"_25368":49124,"_2660":49468},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3162":1369,"_27842":1235,"_19309":49470,"_5":13254,"_25368":49128,"_2660":49471},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3162":1370,"_27842":1235,"_19309":49473,"_5":13254,"_25368":49128,"_2660":49474},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3162":1371,"_27842":1235,"_19309":49476,"_5":13254,"_25368":49128,"_2660":49477},[],"For the JITP flow to work correctly:",{"_3162":1372,"_27842":1235,"_19309":49479,"_5":13254,"_25368":49128,"_2660":49480},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3162":1373,"_27842":1235,"_19309":49482,"_5":13254,"_25368":49128,"_2660":49483},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3162":1374,"_27842":1235,"_19309":49485,"_5":13254,"_25368":49128,"_2660":49486},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3162":1375,"_27842":1235,"_19309":49488,"_5":13254,"_25368":49128,"_2660":49489},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3162":1376,"_27842":1235,"_19309":49491,"_5":13254,"_25368":49132,"_2660":49492},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3162":1377,"_27842":1235,"_19309":49494,"_5":13254,"_25368":49132,"_2660":49495},[],"Status in Lamassu",{"_3162":1378,"_27842":1235,"_19309":49497,"_5":13254,"_25368":49132,"_2660":49498},[],"Revocation reason",{"_3162":1379,"_27842":1235,"_19309":49500,"_5":13254,"_25368":49132,"_2660":49501},[],"Status in AWS IoT Core",{"_3162":1380,"_27842":1235,"_19309":49503,"_5":13254,"_25368":49132,"_2660":49504},[],"`Active`",{"_3162":1381,"_27842":1235,"_19309":49506,"_5":13254,"_25368":49132,"_2660":49507},[],"None",{"_3162":1382,"_27842":1235,"_19309":49509,"_5":13254,"_25368":49132,"_2660":49510},[],"`ACTIVE`",{"_3162":1383,"_27842":1235,"_19309":49512,"_5":13254,"_25368":49132,"_2660":49513},[],"`Revoked`",{"_3162":1384,"_27842":1235,"_19309":49515,"_5":13254,"_25368":49132,"_2660":49516},[],"`certificateHold`",{"_3162":1385,"_27842":1235,"_19309":49518,"_5":13254,"_25368":49132,"_2660":49519},[],"`INACTIVE`",{"_3162":1386,"_27842":1235,"_19309":49521,"_5":13254,"_25368":49132,"_2660":49513},[],{"_3162":1387,"_27842":1235,"_19309":49523,"_5":13254,"_25368":49132,"_2660":49524},[],"Any other reason",{"_3162":1388,"_27842":1235,"_19309":49526,"_5":13254,"_25368":49132,"_2660":49527},[],"`REVOKED`",{"_3162":1389,"_27842":1235,"_19309":49529,"_5":13254,"_25368":49132,"_2660":49530},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3162":1390,"_27842":1235,"_19309":49532,"_5":13254,"_25368":49136,"_2660":49533},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3162":1391,"_27842":1235,"_19309":49535,"_5":13254,"_25368":49136,"_2660":49536},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3162":1392,"_27842":1235,"_19309":49538,"_5":13254,"_25368":49136,"_2660":49539},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3162":1393,"_27842":1235,"_19309":49541,"_5":13254,"_25368":49140,"_2660":49542},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3162":1394,"_27842":1235,"_19309":49544,"_5":13254,"_25368":49140,"_2660":49545},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3162":1395,"_27842":1235,"_19309":49547,"_5":13254,"_25368":49144,"_2660":49548},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3162":1396,"_27842":1235,"_19309":49550,"_5":13254,"_25368":49144,"_2660":49551},[],"There are two action types:",{"_3162":1397,"_27842":1235,"_19309":49553,"_5":13254,"_25368":49144,"_2660":49554},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3162":1398,"_27842":1235,"_19309":49556,"_5":13254,"_25368":49144,"_2660":49557},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3162":1399,"_27842":1235,"_19309":49559,"_5":13254,"_25368":49144,"_2660":49560},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3162":1400,"_27842":1235,"_19309":49562,"_5":13254,"_25368":49148,"_2660":49563},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3162":1401,"_27842":1235,"_19309":49565,"_5":13254,"_25368":49148,"_2660":49566},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3162":1402,"_27842":1235,"_19309":49568,"_5":13254,"_25368":49148,"_2660":49569},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3162":1403,"_27842":1235,"_19309":49571,"_5":13254,"_25368":49152,"_2660":49572},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3162":1404,"_27842":1235,"_19309":49574,"_5":13254,"_25368":49152,"_2660":49575},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3162":1405,"_27842":1235,"_19309":49577,"_5":13254,"_25368":49152,"_2660":49578},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3162":1406,"_27842":1235,"_19309":49580,"_5":13254,"_25368":49152,"_2660":49581},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3162":1407,"_27842":1235,"_19309":49583,"_5":13254,"_25368":49152,"_2660":49584},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3162":1408,"_27842":1235,"_19309":49586,"_5":13254,"_25368":49152,"_2660":49587},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3162":1409,"_27842":1235,"_19309":49589,"_5":13254,"_25368":49152,"_2660":49590},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3162":1410,"_27842":1235,"_19309":49592,"_5":13254,"_25368":49152,"_2660":49593},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3162":1411,"_27842":1235,"_19309":49595,"_5":13254,"_25368":49152,"_2660":49596},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3162":1412,"_27842":1235,"_19309":49598,"_5":13254,"_25368":49152,"_2660":49599},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3162":1413,"_27842":1235,"_19309":49601,"_5":13254,"_25368":49152,"_2660":49602},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3162":1414,"_27842":1235,"_19309":49604,"_5":13254,"_25368":49152,"_2660":49605},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3162":1415,"_27842":1235,"_19309":49607,"_5":13254,"_25368":49152,"_2660":49608},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3162":1416,"_27842":1235,"_19309":49610,"_5":13254,"_25368":49152,"_2660":49611},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3162":1417,"_27842":1235,"_19309":49613,"_5":13254,"_25368":49152,"_2660":49614},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3162":1418,"_27842":1235,"_19309":49616,"_5":13254,"_25368":49152,"_2660":49617},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3162":1419,"_27842":1235,"_19309":49619,"_5":13254,"_25368":49152,"_2660":49620},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3162":1420,"_27842":1235,"_19309":49622,"_5":13254,"_25368":49152,"_2660":49623},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3162":1421,"_27842":1235,"_19309":49625,"_5":13254,"_25368":49152,"_2660":49626},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3162":1422,"_27842":1235,"_19309":49628,"_5":13254,"_25368":49152,"_2660":49629},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3162":1423,"_27842":1235,"_19309":49631,"_5":13254,"_25368":49152,"_2660":49632},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3162":1424,"_27842":1424,"_5":13585,"_2660":47607,"_28185":49634,"_19309":49635,"_25368":1424},[45219,46599,47607],[],{"_3162":1425,"_27842":1424,"_19309":49637,"_5":13254,"_25368":1424,"_2660":49638},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3162":1426,"_27842":1424,"_5":28182,"_19309":49640,"_25368":49641,"_2660":49642},[],"/docs/pr-preview/pr-39/platform/iot-fleets/overview#start-here","Start here",{"_3162":1427,"_27842":1424,"_5":28182,"_19309":49644,"_25368":49645,"_2660":47605},[],"/docs/pr-preview/pr-39/platform/iot-fleets/overview#devices-and-identities",{"_3162":1428,"_27842":1424,"_5":28182,"_19309":49647,"_25368":49648,"_2660":47788},[],"/docs/pr-preview/pr-39/platform/iot-fleets/overview#enrollment-with-pki",{"_3162":1429,"_27842":1424,"_5":28182,"_19309":49650,"_25368":49651,"_2660":49069},[],"/docs/pr-preview/pr-39/platform/iot-fleets/overview#integrations",{"_3162":1430,"_27842":1424,"_5":28182,"_19309":49653,"_25368":49654,"_2660":49655},[],"/docs/pr-preview/pr-39/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3162":1431,"_27842":1424,"_19309":49657,"_5":13254,"_25368":1424,"_2660":49658},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3162":1432,"_27842":1424,"_19309":49660,"_5":13254,"_25368":49641,"_2660":49661},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3162":1433,"_27842":1424,"_19309":49663,"_5":13254,"_25368":49641,"_2660":49664},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3162":1434,"_27842":1424,"_19309":49666,"_5":13254,"_25368":49645,"_2660":49667},[],"Resource",{"_3162":1435,"_27842":1424,"_19309":49669,"_5":13254,"_25368":49645,"_2660":49670},[],"What it represents",{"_3162":1436,"_27842":1424,"_19309":49672,"_5":13254,"_25368":49645,"_2660":49673},[],"**Device**",{"_3162":1437,"_27842":1424,"_19309":49675,"_5":13254,"_25368":49645,"_2660":49676},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3162":1438,"_27842":1424,"_19309":49678,"_5":13254,"_25368":49645,"_2660":49679},[],"**Identity**",{"_3162":1439,"_27842":1424,"_19309":49681,"_5":13254,"_25368":49645,"_2660":49682},[],"The device's association with its certificates: an active version and a history.",{"_3162":1440,"_27842":1424,"_19309":49684,"_5":13254,"_25368":49645,"_2660":49685},[],"**DMS**",{"_3162":1441,"_27842":1424,"_19309":49687,"_5":13254,"_25368":49645,"_2660":49688},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3162":1442,"_27842":1424,"_19309":49690,"_5":13254,"_25368":49645,"_2660":49691},[],"**Fleet**",{"_3162":1443,"_27842":1424,"_19309":49693,"_5":13254,"_25368":49645,"_2660":49694},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3162":1444,"_27842":1424,"_19309":49696,"_5":13254,"_25368":49645,"_2660":49697},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3162":1445,"_27842":1424,"_19309":49699,"_5":13254,"_25368":49645,"_2660":49700},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3162":1446,"_27842":1424,"_19309":49702,"_5":13254,"_25368":49648,"_2660":49703},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3162":1447,"_27842":1424,"_19309":49705,"_5":13254,"_25368":49648,"_2660":49706},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3162":1448,"_27842":1424,"_19309":49708,"_5":13254,"_25368":49648,"_2660":49709},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3162":1449,"_27842":1424,"_19309":49711,"_5":13254,"_25368":49648,"_2660":49712},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3162":1450,"_27842":1424,"_19309":49714,"_5":13254,"_25368":49648,"_2660":49715},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3162":1451,"_27842":1424,"_19309":49717,"_5":13254,"_25368":49648,"_2660":49718},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3162":1452,"_27842":1424,"_19309":49720,"_5":13254,"_25368":49648,"_2660":49721},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3162":1453,"_27842":1424,"_19309":49723,"_5":13254,"_25368":49648,"_2660":49724},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3162":1454,"_27842":1424,"_19309":49726,"_5":13254,"_25368":49651,"_2660":49727},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3162":1455,"_27842":1424,"_19309":49729,"_5":13254,"_25368":49651,"_2660":49730},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3162":1456,"_27842":1424,"_19309":49732,"_5":13254,"_25368":49654,"_2660":49733},[],"Participant",{"_3162":1457,"_27842":1424,"_19309":49735,"_5":13254,"_25368":49654,"_2660":49736},[],"Responsibility",{"_3162":1458,"_27842":1424,"_19309":49738,"_5":13254,"_25368":49654,"_2660":49739},[],"PKI administrator",{"_3162":1459,"_27842":1424,"_19309":49741,"_5":13254,"_25368":49654,"_2660":49742},[],"CA, issuance profile, chain and revocation publication.",{"_3162":1460,"_27842":1424,"_19309":49744,"_5":13254,"_25368":49654,"_2660":49745},[],"Provisioning administrator",{"_3162":1461,"_27842":1424,"_19309":49747,"_5":13254,"_25368":49654,"_2660":49748},[],"DMS, admission, authentication per operation and inventory.",{"_3162":1462,"_27842":1424,"_19309":49750,"_5":13254,"_25368":49654,"_2660":49751},[],"Device integrator",{"_3162":1463,"_27842":1424,"_19309":49753,"_5":13254,"_25368":49654,"_2660":49754},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3162":1464,"_27842":1424,"_19309":49756,"_5":13254,"_25368":49654,"_2660":49757},[],"Consumer integrator",{"_3162":1465,"_27842":1424,"_19309":49759,"_5":13254,"_25368":49654,"_2660":49760},[],"Trusted issuers, validation and device permissions in the destination.",{"_3162":1466,"_27842":1424,"_19309":49762,"_5":13254,"_25368":49654,"_2660":49763},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3162":1467,"_27842":1467,"_5":13585,"_2660":49765,"_28185":49766,"_19309":49768,"_25368":1467},"Enroll and connect your first device",[45219,46599,47607,49767],"Getting started",[],{"_3162":1468,"_27842":1467,"_19309":49770,"_5":13254,"_25368":1467,"_2660":49771},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3162":1469,"_27842":1467,"_5":28182,"_19309":49773,"_25368":49774,"_2660":45229},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3162":1470,"_27842":1467,"_5":28182,"_19309":49776,"_25368":49777,"_2660":49778},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3162":1471,"_27842":1467,"_5":28182,"_19309":49780,"_25368":49781,"_2660":49782},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3162":1472,"_27842":1467,"_5":28182,"_19309":49784,"_25368":49785,"_2660":49786},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3162":1473,"_27842":1467,"_5":28182,"_19309":49788,"_25368":49789,"_2660":49790},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3162":1474,"_27842":1467,"_5":28182,"_19309":49792,"_25368":49793,"_2660":49794},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3162":1475,"_27842":1467,"_5":28182,"_19309":49796,"_25368":49797,"_2660":49798},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3162":1476,"_27842":1467,"_5":28182,"_19309":49800,"_25368":49801,"_2660":49802},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3162":1477,"_27842":1467,"_19309":49804,"_5":13254,"_25368":1467,"_2660":49805},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3162":1478,"_27842":1467,"_19309":49807,"_5":13254,"_25368":49774,"_2660":49808},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3162":1479,"_27842":1467,"_19309":49810,"_5":13254,"_25368":49774,"_2660":49811},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3162":1480,"_27842":1467,"_19309":49813,"_5":13254,"_25368":49774,"_2660":49814},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3162":1481,"_27842":1467,"_19309":49816,"_5":13254,"_25368":49774,"_2660":49817},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3162":1482,"_27842":1467,"_19309":49819,"_5":13254,"_25368":49774,"_2660":49820},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3162":1483,"_27842":1467,"_19309":49822,"_5":13254,"_25368":49777,"_2660":49823},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3162":1484,"_27842":1467,"_19309":49825,"_5":13254,"_25368":49777,"_2660":49826},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3162":1485,"_27842":1467,"_19309":49828,"_5":13254,"_25368":49781,"_2660":49829},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3162":1486,"_27842":1467,"_19309":49831,"_5":13254,"_25368":49781,"_2660":49832},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3162":1487,"_27842":1467,"_19309":49834,"_5":13254,"_25368":49781,"_2660":49835},[],"Setting",{"_3162":1488,"_27842":1467,"_19309":49837,"_5":13254,"_25368":49781,"_2660":49838},[],"Evaluation value",{"_3162":1489,"_27842":1467,"_19309":49840,"_5":13254,"_25368":49781,"_2660":49841},[],"Enrollment CA",{"_3162":1490,"_27842":1467,"_19309":49843,"_5":13254,"_25368":49781,"_2660":49844},[],"Issuing root from `device-root.pem`.",{"_3162":1491,"_27842":1467,"_19309":49846,"_5":13254,"_25368":49781,"_2660":47918},[],{"_3162":1492,"_27842":1467,"_19309":49848,"_5":13254,"_25368":49781,"_2660":49849},[],"The 1-hour leaf profile you just prepared.",{"_3162":1493,"_27842":1467,"_19309":49851,"_5":13254,"_25368":49781,"_2660":49852},[],"Protocol / Registration Mode",{"_3162":1494,"_27842":1467,"_19309":49854,"_5":13254,"_25368":49781,"_2660":49855},[],"`EST_RFC7030` / `JITP`.",{"_3162":1495,"_27842":1467,"_19309":49857,"_5":13254,"_25368":49781,"_2660":49858},[],"Verify CSR Signature",{"_3162":1496,"_27842":1467,"_19309":49860,"_5":13254,"_25368":49781,"_2660":49861},[],"Enabled.",{"_3162":1497,"_27842":1467,"_19309":49863,"_5":13254,"_25368":49781,"_2660":49864},[],"Enable Replaceable Enrollment",{"_3162":1498,"_27842":1467,"_19309":49866,"_5":13254,"_25368":49781,"_2660":49867},[],"Disabled; the ID must be new.",{"_3162":1499,"_27842":1467,"_19309":49869,"_5":13254,"_25368":49781,"_2660":49870},[],"Initial authentication",{"_3162":1500,"_27842":1467,"_19309":49872,"_5":13254,"_25368":49781,"_2660":49873},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3162":1501,"_27842":1467,"_19309":49875,"_5":13254,"_25368":49781,"_2660":49876},[],"Renewal authentication",{"_3162":1502,"_27842":1467,"_19309":49878,"_5":13254,"_25368":49781,"_2660":49879},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3162":1503,"_27842":1467,"_19309":49881,"_5":13254,"_25368":49781,"_2660":49882},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3162":1504,"_27842":1467,"_19309":49884,"_5":13254,"_25368":49781,"_2660":49885},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3162":1505,"_27842":1467,"_19309":49887,"_5":13254,"_25368":49781,"_2660":49888},[],"Re-enrollment Delta",{"_3162":1506,"_27842":1467,"_19309":49890,"_5":13254,"_25368":49781,"_2660":49891},[],"1 hour.",{"_3162":1507,"_27842":1467,"_19309":49893,"_5":13254,"_25368":49781,"_2660":49894},[],"Preventive / Critical Delta",{"_3162":1508,"_27842":1467,"_19309":49896,"_5":13254,"_25368":49781,"_2660":49897},[],"30 minutes / 10 minutes.",{"_3162":1509,"_27842":1467,"_19309":49899,"_5":13254,"_25368":49781,"_2660":49900},[],"Revoke on Re-enrollment",{"_3162":1510,"_27842":1467,"_19309":49902,"_5":13254,"_25368":49781,"_2660":49903},[],"Disabled to test the successor before retiring the previous identity.",{"_3162":1511,"_27842":1467,"_19309":49905,"_5":13254,"_25368":49781,"_2660":47926},[],{"_3162":1512,"_27842":1467,"_19309":49907,"_5":13254,"_25368":49781,"_2660":49908},[],"Disabled; the operational key is generated in the client.",{"_3162":1513,"_27842":1467,"_19309":49910,"_5":13254,"_25368":49781,"_2660":49911},[],"CA Distribution",{"_3162":1514,"_27842":1467,"_19309":49913,"_5":13254,"_25368":49781,"_2660":49914},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3162":1515,"_27842":1467,"_19309":49916,"_5":13254,"_25368":49781,"_2660":49917},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3162":1516,"_27842":1467,"_19309":49919,"_5":13254,"_25368":49785,"_2660":49920},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3162":1517,"_27842":1467,"_19309":49922,"_5":13254,"_25368":49785,"_2660":49923},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3162":1518,"_27842":1467,"_19309":49925,"_5":13254,"_25368":49789,"_2660":49926},[],"Generate a new key and CSR with the selected identifier:",{"_3162":1519,"_27842":1467,"_19309":49928,"_5":13254,"_25368":49789,"_2660":49929},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3162":1520,"_27842":1467,"_19309":49931,"_5":13254,"_25368":49789,"_2660":49932},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3162":1521,"_27842":1467,"_19309":49934,"_5":13254,"_25368":49793,"_2660":49935},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3162":1522,"_27842":1467,"_19309":49937,"_5":13254,"_25368":49793,"_2660":49938},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3162":1523,"_27842":1467,"_19309":49940,"_5":13254,"_25368":49797,"_2660":49941},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3162":1524,"_27842":1467,"_19309":49943,"_5":13254,"_25368":49797,"_2660":49944},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3162":1525,"_27842":1467,"_19309":49946,"_5":13254,"_25368":49797,"_2660":49947},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3162":1526,"_27842":1467,"_19309":49949,"_5":13254,"_25368":49797,"_2660":49950},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3162":1527,"_27842":1467,"_19309":49952,"_5":13254,"_25368":49797,"_2660":49953},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3162":1528,"_27842":1467,"_19309":49955,"_5":13254,"_25368":49801,"_2660":49956},[],"Check",{"_3162":1529,"_27842":1467,"_19309":49958,"_5":13254,"_25368":49801,"_2660":49959},[],"Expected result",{"_3162":1530,"_27842":1467,"_19309":49961,"_5":13254,"_25368":49801,"_2660":49962},[],"Registration",{"_3162":1531,"_27842":1467,"_19309":49964,"_5":13254,"_25368":49801,"_2660":49965},[],"ID created automatically and correct DMS.",{"_3162":1532,"_27842":1467,"_19309":49967,"_5":13254,"_25368":49801,"_2660":49968},[],"Certificate",{"_3162":1533,"_27842":1467,"_19309":49970,"_5":13254,"_25368":49801,"_2660":49971},[],"CN, profile, serial and key verified.",{"_3162":1534,"_27842":1467,"_19309":49973,"_5":13254,"_25368":49801,"_2660":49974},[],"Inventory",{"_3162":1535,"_27842":1467,"_19309":49976,"_5":13254,"_25368":49801,"_2660":49977},[],"Received serial visible as the current identity and in history.",{"_3162":1536,"_27842":1467,"_19309":49979,"_5":13254,"_25368":49801,"_2660":49980},[],"Consumer",{"_3162":1537,"_27842":1467,"_19309":49982,"_5":13254,"_25368":49801,"_2660":49983},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3162":1538,"_27842":1467,"_19309":49985,"_5":13254,"_25368":49801,"_2660":49986},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3162":1539,"_27842":1467,"_19309":49988,"_5":13254,"_25368":49801,"_2660":49989},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3162":1540,"_27842":1540,"_5":13585,"_2660":47623,"_28185":49991,"_19309":49992,"_25368":1540},[45219,46599,47607,49767],[],{"_3162":1541,"_27842":1540,"_19309":49994,"_5":13254,"_25368":1540,"_2660":49995},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3162":1542,"_27842":1540,"_5":28182,"_19309":49997,"_25368":49998,"_2660":45229},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3162":1543,"_27842":1540,"_5":28182,"_19309":50000,"_25368":50001,"_2660":50002},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3162":1544,"_27842":1540,"_5":28182,"_19309":50004,"_25368":50005,"_2660":50006},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3162":1545,"_27842":1540,"_5":28182,"_19309":50008,"_25368":50009,"_2660":50010},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3162":1546,"_27842":1540,"_5":28182,"_19309":50012,"_25368":50013,"_2660":50014},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3162":1547,"_27842":1540,"_5":28182,"_19309":50016,"_25368":50017,"_2660":50018},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3162":1548,"_27842":1540,"_5":28182,"_19309":50020,"_25368":50021,"_2660":49959},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3162":1549,"_27842":1540,"_5":28182,"_19309":50023,"_25368":50024,"_2660":50025},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3162":1550,"_27842":1540,"_5":28182,"_19309":50027,"_25368":50028,"_2660":50029},[],"/docs/pr-preview/pr-39/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3162":1551,"_27842":1540,"_19309":50031,"_5":13254,"_25368":1540,"_2660":50032},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3162":1552,"_27842":1540,"_19309":50034,"_5":13254,"_25368":1540,"_2660":50035},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3162":1553,"_27842":1540,"_19309":50037,"_5":13254,"_25368":49998,"_2660":50038},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3162":1554,"_27842":1540,"_19309":50040,"_5":13254,"_25368":49998,"_2660":50041},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3162":1555,"_27842":1540,"_19309":50043,"_5":13254,"_25368":49998,"_2660":50044},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3162":1556,"_27842":1540,"_19309":50046,"_5":13254,"_25368":49998,"_2660":50047},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3162":1557,"_27842":1540,"_19309":50049,"_5":13254,"_25368":50001,"_2660":50050},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3162":1558,"_27842":1540,"_19309":50052,"_5":13254,"_25368":50001,"_2660":50053},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3162":1559,"_27842":1540,"_19309":50055,"_5":13254,"_25368":50001,"_2660":50056},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3162":1560,"_27842":1540,"_19309":50058,"_5":13254,"_25368":50001,"_2660":50059},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3162":1561,"_27842":1540,"_19309":50061,"_5":13254,"_25368":50001,"_2660":50062},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3162":1562,"_27842":1540,"_19309":50064,"_5":13254,"_25368":50001,"_2660":50065},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3162":1563,"_27842":1540,"_19309":50067,"_5":13254,"_25368":50001,"_2660":50068},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3162":1564,"_27842":1540,"_19309":50070,"_5":13254,"_25368":50001,"_2660":50071},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3162":1565,"_27842":1540,"_19309":50073,"_5":13254,"_25368":50005,"_2660":50074},[],"Open **Managed Devices** and the registration action. Complete:",{"_3162":1566,"_27842":1540,"_19309":50076,"_5":13254,"_25368":50005,"_2660":50077},[],"**Device ID**: `device-001`.",{"_3162":1567,"_27842":1540,"_19309":50079,"_5":13254,"_25368":50005,"_2660":50080},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3162":1568,"_27842":1540,"_19309":50082,"_5":13254,"_25368":50005,"_2660":50083},[],"**Icon** and **Tags**: optional classification.",{"_3162":1569,"_27842":1540,"_19309":50085,"_5":13254,"_25368":50005,"_2660":50086},[],"Confirm registration.",{"_3162":1570,"_27842":1540,"_19309":50088,"_5":13254,"_25368":50009,"_2660":50089},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3162":1571,"_27842":1540,"_19309":50091,"_5":13254,"_25368":50009,"_2660":50092},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3162":1572,"_27842":1540,"_19309":50094,"_5":13254,"_25368":50013,"_2660":50095},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3162":1573,"_27842":1540,"_19309":50097,"_5":13254,"_25368":50013,"_2660":50098},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3162":1574,"_27842":1540,"_19309":50100,"_5":13254,"_25368":50017,"_2660":50101},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3162":1575,"_27842":1540,"_19309":50103,"_5":13254,"_25368":50017,"_2660":50104},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3162":1576,"_27842":1540,"_19309":50106,"_5":13254,"_25368":50021,"_2660":49956},[],{"_3162":1577,"_27842":1540,"_19309":50108,"_5":13254,"_25368":50021,"_2660":50109},[],"Result",{"_3162":1578,"_27842":1540,"_19309":50111,"_5":13254,"_25368":50021,"_2660":50112},[],"Device",{"_3162":1579,"_27842":1540,"_19309":50114,"_5":13254,"_25368":50021,"_2660":50115},[],"`device-001` appears in inventory with the expected DMS.",{"_3162":1580,"_27842":1540,"_19309":50117,"_5":13254,"_25368":50021,"_2660":50118},[],"Current identity",{"_3162":1581,"_27842":1540,"_19309":50120,"_5":13254,"_25368":50021,"_2660":50121},[],"The associated certificate matches the one you verified in PKI.",{"_3162":1582,"_27842":1540,"_19309":50123,"_5":13254,"_25368":50021,"_2660":50124},[],"History",{"_3162":1583,"_27842":1540,"_19309":50126,"_5":13254,"_25368":50021,"_2660":50127},[],"The associated issuance appears with its serial number and dates.",{"_3162":1584,"_27842":1540,"_19309":50129,"_5":13254,"_25368":50021,"_2660":50130},[],"Key and certificate",{"_3162":1585,"_27842":1540,"_19309":50132,"_5":13254,"_25368":50021,"_2660":50133},[],"You have the verified pair ready to install on the device.",{"_3162":1586,"_27842":1540,"_19309":50135,"_5":13254,"_25368":50024,"_2660":50136},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3162":1587,"_27842":1540,"_19309":50138,"_5":13254,"_25368":50024,"_2660":50139},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3162":1588,"_27842":1540,"_19309":50141,"_5":13254,"_25368":50024,"_2660":50142},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3162":1589,"_27842":1540,"_19309":50144,"_5":13254,"_25368":50024,"_2660":50145},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3162":1590,"_27842":1540,"_19309":50147,"_5":13254,"_25368":50028,"_2660":50148},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3162":1591,"_27842":1540,"_19309":50150,"_5":13254,"_25368":50028,"_2660":50151},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3162":1592,"_27842":1540,"_19309":50153,"_5":13254,"_25368":50028,"_2660":50154},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3162":1593,"_27842":1593,"_5":13585,"_2660":50156,"_28185":50157,"_19309":50158,"_25368":1593},"Lamassu IoT Platform",[45219,46599],[],{"_3162":1594,"_27842":1593,"_19309":50160,"_5":13254,"_25368":1593,"_2660":50161},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3162":1595,"_27842":1593,"_5":28182,"_19309":50163,"_25368":50164,"_2660":49642},[],"/docs/pr-preview/pr-39/platform/overview#start-here",{"_3162":1596,"_27842":1593,"_5":28182,"_19309":50166,"_25368":50167,"_2660":50168},[],"/docs/pr-preview/pr-39/platform/overview#choose-your-path","Choose your path",{"_3162":1597,"_27842":1593,"_5":28182,"_19309":50170,"_25368":50171,"_2660":50172},[],"/docs/pr-preview/pr-39/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3162":1598,"_27842":1593,"_5":28182,"_19309":50174,"_25368":50175,"_2660":50176},[],"/docs/pr-preview/pr-39/platform/overview#core-capabilities","Core capabilities",{"_3162":1599,"_27842":1593,"_5":28182,"_19309":50178,"_25368":50179,"_2660":50180},[],"/docs/pr-preview/pr-39/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3162":1600,"_27842":1593,"_5":28182,"_19309":50182,"_25368":50183,"_2660":50184},[],"/docs/pr-preview/pr-39/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3162":1601,"_27842":1593,"_5":28182,"_19309":50186,"_25368":50187,"_2660":50188},[],"/docs/pr-preview/pr-39/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3162":1602,"_27842":1593,"_5":28182,"_19309":50190,"_25368":50191,"_2660":50192},[],"/docs/pr-preview/pr-39/platform/overview#automate-device-identities","Automate device identities",{"_3162":1603,"_27842":1593,"_5":28182,"_19309":50194,"_25368":50195,"_2660":50196},[],"/docs/pr-preview/pr-39/platform/overview#publish-validation-status","Publish validation status",{"_3162":1604,"_27842":1593,"_5":28182,"_19309":50198,"_25368":50199,"_2660":50200},[],"/docs/pr-preview/pr-39/platform/overview#react-to-events","React to events",{"_3162":1605,"_27842":1593,"_5":28182,"_19309":50202,"_25368":50203,"_2660":50204},[],"/docs/pr-preview/pr-39/platform/overview#operational-reference","Operational reference",{"_3162":1606,"_27842":1593,"_19309":50206,"_5":13254,"_25368":1593,"_2660":50207},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3162":1607,"_27842":1593,"_19309":50209,"_5":13254,"_25368":50164,"_2660":50210},[],"Choose the result you need:",{"_3162":1608,"_27842":1593,"_19309":50212,"_5":13254,"_25368":50164,"_2660":50213},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3162":1609,"_27842":1593,"_19309":50215,"_5":13254,"_25368":50164,"_2660":50216},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3162":1610,"_27842":1593,"_19309":50218,"_5":13254,"_25368":50164,"_2660":50219},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3162":1611,"_27842":1593,"_19309":50221,"_5":13254,"_25368":50167,"_2660":50222},[],"Section",{"_3162":1612,"_27842":1593,"_19309":50224,"_5":13254,"_25368":50167,"_2660":50225},[],"What you manage",{"_3162":1613,"_27842":1593,"_19309":50227,"_5":13254,"_25368":50167,"_2660":50228},[],"Entry point",{"_3162":1614,"_27842":1593,"_19309":50230,"_5":13254,"_25368":50167,"_2660":50231},[],"**PKI**",{"_3162":1615,"_27842":1593,"_19309":50233,"_5":13254,"_25368":50167,"_2660":50234},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3162":1616,"_27842":1593,"_19309":50236,"_5":13254,"_25368":50167,"_2660":50237},[],"PKI overview",{"_3162":1617,"_27842":1593,"_19309":50239,"_5":13254,"_25368":50167,"_2660":50240},[],"**IoT Fleets**",{"_3162":1618,"_27842":1593,"_19309":50242,"_5":13254,"_25368":50167,"_2660":50243},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3162":1619,"_27842":1593,"_19309":50245,"_5":13254,"_25368":50167,"_2660":50246},[],"IoT Fleets overview",{"_3162":1620,"_27842":1593,"_19309":50248,"_5":13254,"_25368":50167,"_2660":50249},[],"**Administration**",{"_3162":1621,"_27842":1593,"_19309":50251,"_5":13254,"_25368":50167,"_2660":50252},[],"Operator permissions, audit and event subscriptions.",{"_3162":1622,"_27842":1593,"_19309":50254,"_5":13254,"_25368":50167,"_2660":46597},[],{"_3162":1623,"_27842":1593,"_19309":50256,"_5":13254,"_25368":50167,"_2660":50257},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3162":1624,"_27842":1593,"_19309":50259,"_5":13254,"_25368":50171,"_2660":50260},[],"An identity's journey connects four responsibilities:",{"_3162":1625,"_27842":1593,"_19309":50262,"_5":13254,"_25368":50171,"_2660":50263},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3162":1626,"_27842":1593,"_19309":50265,"_5":13254,"_25368":50171,"_2660":50266},[],"The provisioning administrator configures the DMS and initial trust.",{"_3162":1627,"_27842":1593,"_19309":50268,"_5":13254,"_25368":50171,"_2660":50269},[],"The device client requests a certificate and installs it with the matching key.",{"_3162":1628,"_27842":1593,"_19309":50271,"_5":13254,"_25368":50171,"_2660":50272},[],"The consumer validates the identity and applies its access permissions.",{"_3162":1629,"_27842":1593,"_19309":50274,"_5":13254,"_25368":50171,"_2660":50275},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3162":1630,"_27842":1593,"_19309":50277,"_5":13254,"_25368":50179,"_2660":50278},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3162":1631,"_27842":1593,"_19309":50280,"_5":13254,"_25368":50183,"_2660":50281},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3162":1632,"_27842":1593,"_19309":50283,"_5":13254,"_25368":50187,"_2660":50284},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3162":1633,"_27842":1593,"_19309":50286,"_5":13254,"_25368":50191,"_2660":50287},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3162":1634,"_27842":1593,"_19309":50289,"_5":13254,"_25368":50195,"_2660":50290},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3162":1635,"_27842":1593,"_19309":50292,"_5":13254,"_25368":50199,"_2660":50293},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3162":1636,"_27842":1593,"_19309":50295,"_5":13254,"_25368":50203,"_2660":49736},[],{"_3162":1637,"_27842":1593,"_19309":50297,"_5":13254,"_25368":50203,"_2660":50298},[],"What it prepares or checks",{"_3162":1638,"_27842":1593,"_19309":50300,"_5":13254,"_25368":50203,"_2660":49739},[],{"_3162":1639,"_27842":1593,"_19309":50302,"_5":13254,"_25368":50203,"_2660":50303},[],"Key custody, CA hierarchy, profiles and validation.",{"_3162":1640,"_27842":1593,"_19309":50305,"_5":13254,"_25368":50203,"_2660":50306},[],"Fleet administrator",{"_3162":1641,"_27842":1593,"_19309":50308,"_5":13254,"_25368":50203,"_2660":50309},[],"DMS, device admission, renewal policy and inventory.",{"_3162":1642,"_27842":1593,"_19309":50311,"_5":13254,"_25368":50203,"_2660":49751},[],{"_3162":1643,"_27842":1593,"_19309":50313,"_5":13254,"_25368":50203,"_2660":50314},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3162":1644,"_27842":1593,"_19309":50316,"_5":13254,"_25368":50203,"_2660":49757},[],{"_3162":1645,"_27842":1593,"_19309":50318,"_5":13254,"_25368":50203,"_2660":50319},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3162":1646,"_27842":1593,"_19309":50321,"_5":13254,"_25368":50203,"_2660":50322},[],"Infrastructure operator",{"_3162":1647,"_27842":1593,"_19309":50324,"_5":13254,"_25368":50203,"_2660":50325},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3162":1648,"_27842":1593,"_19309":50327,"_5":13254,"_25368":50203,"_2660":50328},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3162":1649,"_27842":1649,"_5":13585,"_2660":50330,"_28185":50331,"_19309":50334,"_25368":1649},"CA hierarchy and rotation",[45219,46599,50332,50333],"PKI","Keys, authorities and certificates",[],{"_3162":1650,"_27842":1649,"_19309":50336,"_5":13254,"_25368":1649,"_2660":50337},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3162":1651,"_27842":1649,"_5":28182,"_19309":50339,"_25368":50340,"_2660":50341},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3162":1652,"_27842":1649,"_5":28182,"_19309":50343,"_25368":50344,"_2660":50345},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3162":1653,"_27842":1649,"_5":28182,"_19309":50347,"_25368":50348,"_2660":50349},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3162":1654,"_27842":1649,"_5":28182,"_19309":50351,"_25368":50352,"_2660":50353},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3162":1655,"_27842":1649,"_5":28182,"_19309":50355,"_25368":50356,"_2660":50357},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3162":1656,"_27842":1649,"_5":28182,"_19309":50359,"_25368":50360,"_2660":50361},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3162":1657,"_27842":1649,"_5":28182,"_19309":50363,"_25368":50364,"_2660":50365},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3162":1658,"_27842":1649,"_5":28182,"_19309":50367,"_25368":50368,"_2660":50369},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3162":1659,"_27842":1649,"_5":28182,"_19309":50371,"_25368":50372,"_2660":50373},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3162":1660,"_27842":1649,"_5":28182,"_19309":50375,"_25368":50376,"_2660":50377},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3162":1661,"_27842":1649,"_5":28182,"_19309":50379,"_25368":50380,"_2660":50381},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3162":1662,"_27842":1649,"_5":28182,"_19309":50383,"_25368":50384,"_2660":50385},[],"/docs/pr-preview/pr-39/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3162":1663,"_27842":1649,"_19309":50387,"_5":13254,"_25368":1649,"_2660":50388},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3162":1664,"_27842":1649,"_19309":50390,"_5":13254,"_25368":1649,"_2660":50391},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3162":1665,"_27842":1649,"_19309":50393,"_5":13254,"_25368":50340,"_2660":50394},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3162":1666,"_27842":1649,"_19309":50396,"_5":13254,"_25368":50340,"_2660":50397},[],"environment, such as production and preproduction;",{"_3162":1667,"_27842":1649,"_19309":50399,"_5":13254,"_25368":50340,"_2660":50400},[],"owner or operating team;",{"_3162":1668,"_27842":1649,"_19309":50402,"_5":13254,"_25368":50340,"_2660":50403},[],"device family or manufacturing process;",{"_3162":1669,"_27842":1649,"_19309":50405,"_5":13254,"_25368":50340,"_2660":50406},[],"region or regulatory requirement;",{"_3162":1670,"_27842":1649,"_19309":50408,"_5":13254,"_25368":50340,"_2660":50409},[],"cryptographic engine or key policy;",{"_3162":1671,"_27842":1649,"_19309":50411,"_5":13254,"_25368":50340,"_2660":50412},[],"maintenance window and renewal cadence.",{"_3162":1672,"_27842":1649,"_19309":50414,"_5":13254,"_25368":50340,"_2660":50415},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3162":1673,"_27842":1649,"_19309":50417,"_5":13254,"_25368":50340,"_2660":50418},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3162":1674,"_27842":1649,"_19309":50420,"_5":13254,"_25368":50344,"_2660":50421},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3162":1675,"_27842":1649,"_19309":50423,"_5":13254,"_25368":50344,"_2660":50424},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3162":1676,"_27842":1649,"_19309":50426,"_5":13254,"_25368":50344,"_2660":50427},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3162":1677,"_27842":1649,"_19309":50429,"_5":13254,"_25368":50348,"_2660":50430},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3162":1678,"_27842":1649,"_19309":50432,"_5":13254,"_25368":50348,"_2660":50433},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3162":1679,"_27842":1649,"_19309":50435,"_5":13254,"_25368":50348,"_2660":50436},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3162":1680,"_27842":1649,"_19309":50438,"_5":13254,"_25368":50348,"_2660":50439},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3162":1681,"_27842":1649,"_19309":50441,"_5":13254,"_25368":50356,"_2660":50442},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3162":1682,"_27842":1649,"_19309":50444,"_5":13254,"_25368":50360,"_2660":50445},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3162":1683,"_27842":1649,"_19309":50447,"_5":13254,"_25368":50364,"_2660":50448},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3162":1684,"_27842":1649,"_19309":50450,"_5":13254,"_25368":50368,"_2660":50451},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3162":1685,"_27842":1649,"_19309":50453,"_5":13254,"_25368":50372,"_2660":50454},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3162":1686,"_27842":1649,"_19309":50456,"_5":13254,"_25368":50376,"_2660":50457},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3162":1687,"_27842":1649,"_19309":50459,"_5":13254,"_25368":50380,"_2660":50460},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3162":1688,"_27842":1649,"_19309":50462,"_5":13254,"_25368":50380,"_2660":50463},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3162":1689,"_27842":1649,"_19309":50465,"_5":13254,"_25368":50380,"_2660":50466},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3162":1690,"_27842":1649,"_19309":50468,"_5":13254,"_25368":50380,"_2660":50469},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3162":1691,"_27842":1649,"_19309":50471,"_5":13254,"_25368":50384,"_2660":50472},[],"The new chain ends in an anchor installed by the consumer.",{"_3162":1692,"_27842":1649,"_19309":50474,"_5":13254,"_25368":50384,"_2660":50475},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3162":1693,"_27842":1649,"_19309":50477,"_5":13254,"_25368":50384,"_2660":50478},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3162":1694,"_27842":1649,"_19309":50480,"_5":13254,"_25368":50384,"_2660":50481},[],"Re-enrollment accepts the old identity during the planned period.",{"_3162":1695,"_27842":1649,"_19309":50483,"_5":13254,"_25368":50384,"_2660":50484},[],"OCSP and CRL respond for the authorities that remain active.",{"_3162":1696,"_27842":1649,"_19309":50486,"_5":13254,"_25368":50384,"_2660":50487},[],"No DMS is left accidentally issuing from the old CA.",{"_3162":1697,"_27842":1649,"_19309":50489,"_5":13254,"_25368":50384,"_2660":50490},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3162":1698,"_27842":1698,"_5":13585,"_2660":50492,"_28185":50493,"_19309":50494,"_25368":1698},"Certification authorities",[45219,46599,50332,50333],[],{"_3162":1699,"_27842":1698,"_19309":50496,"_5":13254,"_25368":1698,"_2660":50497},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3162":1700,"_27842":1698,"_5":28182,"_19309":50499,"_25368":50500,"_2660":50501},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3162":1701,"_27842":1698,"_5":28182,"_19309":50503,"_25368":50504,"_2660":50505},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3162":1702,"_27842":1698,"_5":28182,"_19309":50507,"_25368":50508,"_2660":45229},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#before-you-begin",{"_3162":1703,"_27842":1698,"_5":28182,"_19309":50510,"_25368":50511,"_2660":50512},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3162":1704,"_27842":1698,"_5":28182,"_19309":50514,"_25368":50515,"_2660":50516},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3162":1705,"_27842":1698,"_5":28182,"_19309":50518,"_25368":50519,"_2660":50520},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3162":1706,"_27842":1698,"_5":28182,"_19309":50522,"_25368":50523,"_2660":50524},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3162":1707,"_27842":1698,"_5":28182,"_19309":50526,"_25368":50527,"_2660":50528},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3162":1708,"_27842":1698,"_5":28182,"_19309":50530,"_25368":50531,"_2660":50532},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3162":1709,"_27842":1698,"_5":28182,"_19309":50534,"_25368":50535,"_2660":50536},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3162":1710,"_27842":1698,"_5":28182,"_19309":50538,"_25368":50539,"_2660":50540},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3162":1711,"_27842":1698,"_5":28182,"_19309":50542,"_25368":50543,"_2660":50544},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3162":1712,"_27842":1698,"_5":28182,"_19309":50546,"_25368":50547,"_2660":50548},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3162":1713,"_27842":1698,"_5":28182,"_19309":50550,"_25368":50551,"_2660":50552},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3162":1714,"_27842":1698,"_5":28182,"_19309":50554,"_25368":50555,"_2660":50556},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3162":1715,"_27842":1698,"_5":28182,"_19309":50558,"_25368":50559,"_2660":50560},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3162":1716,"_27842":1698,"_5":28182,"_19309":50562,"_25368":50563,"_2660":50564},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3162":1717,"_27842":1698,"_5":28182,"_19309":50566,"_25368":50567,"_2660":50568},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3162":1718,"_27842":1698,"_5":28182,"_19309":50570,"_25368":50571,"_2660":50572},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3162":1719,"_27842":1698,"_5":28182,"_19309":50574,"_25368":50575,"_2660":50576},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3162":1720,"_27842":1698,"_5":28182,"_19309":50578,"_25368":50579,"_2660":50580},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3162":1721,"_27842":1698,"_5":28182,"_19309":50582,"_25368":50583,"_2660":50584},[],"/docs/pr-preview/pr-39/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3162":1722,"_27842":1698,"_19309":50586,"_5":13254,"_25368":1698,"_2660":50587},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3162":1723,"_27842":1698,"_19309":50589,"_5":13254,"_25368":1698,"_2660":50590},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3162":1724,"_27842":1698,"_19309":50592,"_5":13254,"_25368":1698,"_2660":50593},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3162":1725,"_27842":1698,"_19309":50595,"_5":13254,"_25368":50500,"_2660":50596},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3162":1726,"_27842":1698,"_19309":50598,"_5":13254,"_25368":50500,"_2660":50599},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3162":1727,"_27842":1698,"_19309":50601,"_5":13254,"_25368":50500,"_2660":50602},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3162":1728,"_27842":1698,"_19309":50604,"_5":13254,"_25368":50500,"_2660":50605},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3162":1729,"_27842":1698,"_19309":50607,"_5":13254,"_25368":50500,"_2660":50608},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3162":1730,"_27842":1698,"_19309":50610,"_5":13254,"_25368":50508,"_2660":50611},[],"Decide whether the CA will be a root or an intermediate.",{"_3162":1731,"_27842":1698,"_19309":50613,"_5":13254,"_25368":50508,"_2660":50614},[],"Choose the engine that will keep the key.",{"_3162":1732,"_27842":1698,"_19309":50616,"_5":13254,"_25368":50508,"_2660":50617},[],"Define a validity longer than that of the certificates it will issue.",{"_3162":1733,"_27842":1698,"_19309":50619,"_5":13254,"_25368":50508,"_2660":50620},[],"For an intermediate CA, make sure the parent CA is active.",{"_3162":1734,"_27842":1698,"_19309":50622,"_5":13254,"_25368":50511,"_2660":50623},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3162":1735,"_27842":1698,"_19309":50625,"_5":13254,"_25368":50515,"_2660":50626},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3162":1736,"_27842":1698,"_19309":50628,"_5":13254,"_25368":50515,"_2660":50629},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3162":1737,"_27842":1698,"_19309":50631,"_5":13254,"_25368":50519,"_2660":50632},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3162":1738,"_27842":1698,"_19309":50634,"_5":13254,"_25368":50523,"_2660":50635},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3162":1739,"_27842":1698,"_19309":50637,"_5":13254,"_25368":50523,"_2660":50638},[],"`C`: two-letter ISO 3166-1 country code.",{"_3162":1740,"_27842":1698,"_19309":50640,"_5":13254,"_25368":50523,"_2660":50641},[],"`ST`: state or province.",{"_3162":1741,"_27842":1698,"_19309":50643,"_5":13254,"_25368":50523,"_2660":50644},[],"`L`: locality.",{"_3162":1742,"_27842":1698,"_19309":50646,"_5":13254,"_25368":50523,"_2660":50647},[],"`O`: organization.",{"_3162":1743,"_27842":1698,"_19309":50649,"_5":13254,"_25368":50523,"_2660":50650},[],"`OU`: organizational unit.",{"_3162":1744,"_27842":1698,"_19309":50652,"_5":13254,"_25368":50523,"_2660":50653},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3162":1745,"_27842":1698,"_19309":50655,"_5":13254,"_25368":50527,"_2660":50656},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3162":1746,"_27842":1698,"_19309":50658,"_5":13254,"_25368":50527,"_2660":50659},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3162":1747,"_27842":1698,"_19309":50661,"_5":13254,"_25368":50531,"_2660":50662},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3162":1748,"_27842":1698,"_19309":50664,"_5":13254,"_25368":50531,"_2660":50665},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3162":1749,"_27842":1698,"_19309":50667,"_5":13254,"_25368":50535,"_2660":50668},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3162":1750,"_27842":1698,"_19309":50670,"_5":13254,"_25368":50535,"_2660":50671},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3162":1751,"_27842":1698,"_19309":50673,"_5":13254,"_25368":50539,"_2660":50674},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3162":1752,"_27842":1698,"_19309":50676,"_5":13254,"_25368":50543,"_2660":50677},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3162":1753,"_27842":1698,"_19309":50679,"_5":13254,"_25368":50547,"_2660":50680},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3162":1754,"_27842":1698,"_19309":50682,"_5":13254,"_25368":50551,"_2660":50683},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3162":1755,"_27842":1698,"_19309":50685,"_5":13254,"_25368":50555,"_2660":50686},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3162":1756,"_27842":1698,"_19309":50688,"_5":13254,"_25368":50555,"_2660":50689},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3162":1757,"_27842":1698,"_19309":50691,"_5":13254,"_25368":50559,"_2660":50692},[],"Open a CA from the inventory to review:",{"_3162":1758,"_27842":1698,"_19309":50694,"_5":13254,"_25368":50559,"_2660":50695},[],"Status and validity period.",{"_3162":1759,"_27842":1698,"_19309":50697,"_5":13254,"_25368":50559,"_2660":50698},[],"Certificate and chain in PEM format.",{"_3162":1760,"_27842":1698,"_19309":50700,"_5":13254,"_25368":50559,"_2660":50701},[],"Number of active, expired and revoked certificates.",{"_3162":1761,"_27842":1698,"_19309":50703,"_5":13254,"_25368":50559,"_2660":50704},[],"Certificates issued in **Issued Certificates**.",{"_3162":1762,"_27842":1698,"_19309":50706,"_5":13254,"_25368":50559,"_2660":50707},[],"The CRL linked to the authority.",{"_3162":1763,"_27842":1698,"_19309":50709,"_5":13254,"_25368":50559,"_2660":50710},[],"Metadata and the associated cryptographic engine.",{"_3162":1764,"_27842":1698,"_19309":50712,"_5":13254,"_25368":50559,"_2660":50713},[],"You can filter the inventory by name, status and CA type.",{"_3162":1765,"_27842":1698,"_19309":50715,"_5":13254,"_25368":50563,"_2660":50716},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3162":1766,"_27842":1698,"_19309":50718,"_5":13254,"_25368":50563,"_2660":50719},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3162":1767,"_27842":1698,"_19309":50721,"_5":13254,"_25368":50563,"_2660":50722},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3162":1768,"_27842":1698,"_19309":50724,"_5":13254,"_25368":50563,"_2660":50725},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3162":1769,"_27842":1698,"_19309":50727,"_5":13254,"_25368":50567,"_2660":50728},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3162":1770,"_27842":1698,"_19309":50730,"_5":13254,"_25368":50571,"_2660":50731},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3162":1771,"_27842":1698,"_19309":50733,"_5":13254,"_25368":50575,"_2660":50734},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3162":1772,"_27842":1698,"_19309":50736,"_5":13254,"_25368":50579,"_2660":50737},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3162":1773,"_27842":1698,"_19309":50739,"_5":13254,"_25368":50583,"_2660":50740},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3162":1774,"_27842":1698,"_19309":50742,"_5":13254,"_25368":50583,"_2660":50743},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3162":1775,"_27842":1775,"_5":13585,"_2660":50745,"_28185":50746,"_19309":50747,"_25368":1775},"Certificate profiles",[45219,46599,50332,50333],[],{"_3162":1776,"_27842":1775,"_19309":50749,"_5":13254,"_25368":1775,"_2660":50750},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3162":1777,"_27842":1775,"_5":28182,"_19309":50752,"_25368":50753,"_2660":50754},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3162":1778,"_27842":1775,"_5":28182,"_19309":50756,"_25368":50757,"_2660":50758},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#validity","Validity",{"_3162":1779,"_27842":1775,"_5":28182,"_19309":50760,"_25368":50761,"_2660":50762},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3162":1780,"_27842":1775,"_5":28182,"_19309":50764,"_25368":50765,"_2660":50766},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3162":1781,"_27842":1775,"_5":28182,"_19309":50768,"_25368":50769,"_2660":50770},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#subject","Subject",{"_3162":1782,"_27842":1775,"_5":28182,"_19309":50772,"_25368":50773,"_2660":50774},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3162":1783,"_27842":1775,"_5":28182,"_19309":50776,"_25368":50777,"_2660":50778},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3162":1784,"_27842":1775,"_5":28182,"_19309":50780,"_25368":50781,"_2660":50782},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3162":1785,"_27842":1775,"_5":28182,"_19309":50784,"_25368":50785,"_2660":50786},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3162":1786,"_27842":1775,"_5":28182,"_19309":50788,"_25368":50789,"_2660":50790},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3162":1787,"_27842":1775,"_5":28182,"_19309":50792,"_25368":50793,"_2660":50794},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3162":1788,"_27842":1775,"_5":28182,"_19309":50796,"_25368":50797,"_2660":50798},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3162":1789,"_27842":1775,"_5":28182,"_19309":50800,"_25368":50801,"_2660":50802},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3162":1790,"_27842":1775,"_5":28182,"_19309":50804,"_25368":50805,"_2660":50806},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3162":1791,"_27842":1775,"_5":28182,"_19309":50808,"_25368":50809,"_2660":50810},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#design-examples","Design examples",{"_3162":1792,"_27842":1775,"_5":28182,"_19309":50812,"_25368":50813,"_2660":50814},[],"/docs/pr-preview/pr-39/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3162":1793,"_27842":1775,"_19309":50816,"_5":13254,"_25368":1775,"_2660":50817},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3162":1794,"_27842":1775,"_19309":50819,"_5":13254,"_25368":1775,"_2660":50820},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3162":1795,"_27842":1775,"_19309":50822,"_5":13254,"_25368":50757,"_2660":50823},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3162":1796,"_27842":1775,"_19309":50825,"_5":13254,"_25368":50757,"_2660":50826},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3162":1797,"_27842":1775,"_19309":50828,"_5":13254,"_25368":50761,"_2660":50829},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3162":1798,"_27842":1775,"_19309":50831,"_5":13254,"_25368":50765,"_2660":50832},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3162":1799,"_27842":1775,"_19309":50834,"_5":13254,"_25368":50765,"_2660":50835},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3162":1800,"_27842":1775,"_19309":50837,"_5":13254,"_25368":50765,"_2660":50838},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3162":1801,"_27842":1775,"_19309":50840,"_5":13254,"_25368":50769,"_2660":50841},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3162":1802,"_27842":1775,"_19309":50843,"_5":13254,"_25368":50773,"_2660":50844},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3162":1803,"_27842":1775,"_19309":50846,"_5":13254,"_25368":50773,"_2660":50847},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3162":1804,"_27842":1775,"_19309":50849,"_5":13254,"_25368":50777,"_2660":50850},[],"The cryptographic enforcement can:",{"_3162":1805,"_27842":1775,"_19309":50852,"_5":13254,"_25368":50777,"_2660":50853},[],"allow or block RSA keys;",{"_3162":1806,"_27842":1775,"_19309":50855,"_5":13254,"_25368":50777,"_2660":50856},[],"limit the supported RSA sizes;",{"_3162":1807,"_27842":1775,"_19309":50858,"_5":13254,"_25368":50777,"_2660":50859},[],"allow or block ECDSA keys;",{"_3162":1808,"_27842":1775,"_19309":50861,"_5":13254,"_25368":50777,"_2660":50862},[],"limit the supported ECDSA sizes or curves.",{"_3162":1809,"_27842":1775,"_19309":50864,"_5":13254,"_25368":50777,"_2660":50865},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3162":1810,"_27842":1775,"_19309":50867,"_5":13254,"_25368":50781,"_2660":50868},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3162":1811,"_27842":1775,"_19309":50870,"_5":13254,"_25368":50781,"_2660":48360},[],{"_3162":1812,"_27842":1775,"_19309":50872,"_5":13254,"_25368":50781,"_2660":50873},[],"First choice",{"_3162":1813,"_27842":1775,"_19309":50875,"_5":13254,"_25368":50781,"_2660":50876},[],"Second choice",{"_3162":1814,"_27842":1775,"_19309":50878,"_5":13254,"_25368":50781,"_2660":50879},[],"If neither is supplied",{"_3162":1815,"_27842":1775,"_19309":50881,"_5":13254,"_25368":50781,"_2660":50882},[],"Direct signing with a CA",{"_3162":1816,"_27842":1775,"_19309":50884,"_5":13254,"_25368":50781,"_2660":50885},[],"`issuance_profile` embedded in the request",{"_3162":1817,"_27842":1775,"_19309":50887,"_5":13254,"_25368":50781,"_2660":50888},[],"Request `issuance_profile_id`",{"_3162":1818,"_27842":1775,"_19309":50890,"_5":13254,"_25368":50781,"_2660":50891},[],"CA default profile (`profile_id`).",{"_3162":1819,"_27842":1775,"_19309":50893,"_5":13254,"_25368":50781,"_2660":50894},[],"Issuance through a DMS",{"_3162":1820,"_27842":1775,"_19309":50896,"_5":13254,"_25368":50781,"_2660":50897},[],"`settings.issuance_profile_id`",{"_3162":1821,"_27842":1775,"_19309":50899,"_5":13254,"_25368":50781,"_2660":50900},[],"`settings.issuance_profile` embedded in the DMS",{"_3162":1822,"_27842":1775,"_19309":50902,"_5":13254,"_25368":50781,"_2660":50903},[],"Enrollment CA default profile.",{"_3162":1823,"_27842":1775,"_19309":50905,"_5":13254,"_25368":50781,"_2660":50906},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3162":1824,"_27842":1775,"_19309":50908,"_5":13254,"_25368":50781,"_2660":50909},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3162":1825,"_27842":1775,"_19309":50911,"_5":13254,"_25368":50789,"_2660":50912},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3162":1826,"_27842":1775,"_19309":50914,"_5":13254,"_25368":50793,"_2660":50915},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3162":1827,"_27842":1775,"_19309":50917,"_5":13254,"_25368":50797,"_2660":50918},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3162":1828,"_27842":1775,"_19309":50920,"_5":13254,"_25368":50801,"_2660":50921},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3162":1829,"_27842":1775,"_19309":50923,"_5":13254,"_25368":50805,"_2660":50924},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3162":1830,"_27842":1775,"_19309":50926,"_5":13254,"_25368":50805,"_2660":50927},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3162":1831,"_27842":1775,"_19309":50929,"_5":13254,"_25368":50809,"_2660":50930},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3162":1832,"_27842":1775,"_19309":50932,"_5":13254,"_25368":50809,"_2660":50933},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3162":1833,"_27842":1775,"_19309":50935,"_5":13254,"_25368":50809,"_2660":50936},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3162":1834,"_27842":1775,"_19309":50938,"_5":13254,"_25368":50809,"_2660":50939},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3162":1835,"_27842":1775,"_19309":50941,"_5":13254,"_25368":50813,"_2660":50942},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3162":1836,"_27842":1775,"_19309":50944,"_5":13254,"_25368":50813,"_2660":50945},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3162":1837,"_27842":1837,"_5":13585,"_2660":50947,"_28185":50948,"_19309":50950,"_25368":1837},"Certificate validation",[45219,46599,50332,50949],"Validation",[],{"_3162":1838,"_27842":1837,"_19309":50952,"_5":13254,"_25368":1837,"_2660":50953},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3162":1839,"_27842":1837,"_5":28182,"_19309":50955,"_25368":50956,"_2660":50957},[],"/docs/pr-preview/pr-39/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3162":1840,"_27842":1837,"_5":28182,"_19309":50959,"_25368":50960,"_2660":50961},[],"/docs/pr-preview/pr-39/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3162":1841,"_27842":1837,"_5":28182,"_19309":50963,"_25368":50964,"_2660":50965},[],"/docs/pr-preview/pr-39/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3162":1842,"_27842":1837,"_19309":50967,"_5":13254,"_25368":1837,"_2660":50968},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3162":1843,"_27842":1837,"_19309":50970,"_5":13254,"_25368":50956,"_2660":50971},[],"Verify these criteria together:",{"_3162":1844,"_27842":1837,"_19309":50973,"_5":13254,"_25368":50956,"_2660":49956},[],{"_3162":1845,"_27842":1837,"_19309":50975,"_5":13254,"_25368":50956,"_2660":50976},[],"Required result",{"_3162":1846,"_27842":1837,"_19309":50978,"_5":13254,"_25368":50956,"_2660":50979},[],"Chain and signature",{"_3162":1847,"_27842":1837,"_19309":50981,"_5":13254,"_25368":50956,"_2660":50982},[],"Valid chain to a root deliberately installed in the consumer.",{"_3162":1848,"_27842":1837,"_19309":50984,"_5":13254,"_25368":50956,"_2660":50985},[],"Dates",{"_3162":1849,"_27842":1837,"_19309":50987,"_5":13254,"_25368":50956,"_2660":50988},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3162":1850,"_27842":1837,"_19309":50990,"_5":13254,"_25368":50956,"_2660":46299},[],{"_3162":1851,"_27842":1837,"_19309":50992,"_5":13254,"_25368":50956,"_2660":50993},[],"Name, SAN or identifier matches the expected peer.",{"_3162":1852,"_27842":1837,"_19309":50995,"_5":13254,"_25368":50956,"_2660":45609},[],{"_3162":1853,"_27842":1837,"_19309":50997,"_5":13254,"_25368":50956,"_2660":50998},[],"KU, EKU and constraints permit the specific operation.",{"_3162":1854,"_27842":1837,"_19309":51000,"_5":13254,"_25368":50956,"_2660":51001},[],"Revocation",{"_3162":1855,"_27842":1837,"_19309":51003,"_5":13254,"_25368":50956,"_2660":51004},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3162":1856,"_27842":1837,"_19309":51006,"_5":13254,"_25368":50956,"_2660":51007},[],"Authorization",{"_3162":1857,"_27842":1837,"_19309":51009,"_5":13254,"_25368":50956,"_2660":51010},[],"The application permits that identity to perform the action.",{"_3162":1858,"_27842":1837,"_19309":51012,"_5":13254,"_25368":50956,"_2660":51013},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3162":1859,"_27842":1837,"_19309":51015,"_5":13254,"_25368":50960,"_2660":51016},[],"Mechanism",{"_3162":1860,"_27842":1837,"_19309":51018,"_5":13254,"_25368":50960,"_2660":51019},[],"When to use it",{"_3162":1861,"_27842":1837,"_19309":51021,"_5":13254,"_25368":50960,"_2660":51022},[],"What you must maintain",{"_3162":1862,"_27842":1837,"_19309":51024,"_5":13254,"_25368":50960,"_2660":51025},[],"OCSP",{"_3162":1863,"_27842":1837,"_19309":51027,"_5":13254,"_25368":50960,"_2660":51028},[],"Status query for a specific certificate.",{"_3162":1864,"_27842":1837,"_19309":51030,"_5":13254,"_25368":50960,"_2660":51031},[],"Responder access, signature verification and cache/freshness policy.",{"_3162":1865,"_27842":1837,"_19309":51033,"_5":13254,"_25368":50960,"_2660":51034},[],"CRL",{"_3162":1866,"_27842":1837,"_19309":51036,"_5":13254,"_25368":50960,"_2660":51037},[],"Local checks for many certificates or offline operation.",{"_3162":1867,"_27842":1837,"_19309":51039,"_5":13254,"_25368":50960,"_2660":51040},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3162":1868,"_27842":1837,"_19309":51042,"_5":13254,"_25368":50960,"_2660":51043},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3162":1869,"_27842":1837,"_19309":51045,"_5":13254,"_25368":50960,"_2660":51046},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3162":1870,"_27842":1837,"_19309":51048,"_5":13254,"_25368":50964,"_2660":51049},[],"Accept a current, authorized certificate with a known chain.",{"_3162":1871,"_27842":1837,"_19309":51051,"_5":13254,"_25368":50964,"_2660":51052},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3162":1872,"_27842":1837,"_19309":51054,"_5":13254,"_25368":50964,"_2660":51055},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3162":1873,"_27842":1837,"_19309":51057,"_5":13254,"_25368":50964,"_2660":51058},[],"Check that a new connection with that identity is rejected.",{"_3162":1874,"_27842":1837,"_19309":51060,"_5":13254,"_25368":50964,"_2660":51061},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3162":1875,"_27842":1837,"_19309":51063,"_5":13254,"_25368":50964,"_2660":51064},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3162":1876,"_27842":1837,"_19309":51066,"_5":13254,"_25368":50964,"_2660":51067},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3162":1877,"_27842":1837,"_19309":51069,"_5":13254,"_25368":50964,"_2660":51070},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3162":1878,"_27842":1837,"_19309":51072,"_5":13254,"_25368":50964,"_2660":51073},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3162":1879,"_27842":1879,"_5":13585,"_2660":51075,"_28185":51076,"_19309":51077,"_25368":1879},"Certificates",[45219,46599,50332,50333],[],{"_3162":1880,"_27842":1879,"_19309":51079,"_5":13254,"_25368":1879,"_2660":51080},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3162":1881,"_27842":1879,"_5":28182,"_19309":51082,"_25368":51083,"_2660":51084},[],"/docs/pr-preview/pr-39/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3162":1882,"_27842":1879,"_5":28182,"_19309":51086,"_25368":51087,"_2660":51088},[],"/docs/pr-preview/pr-39/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3162":1883,"_27842":1879,"_5":28182,"_19309":51090,"_25368":51091,"_2660":51092},[],"/docs/pr-preview/pr-39/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3162":1884,"_27842":1879,"_5":28182,"_19309":51094,"_25368":51095,"_2660":51096},[],"/docs/pr-preview/pr-39/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3162":1885,"_27842":1879,"_5":28182,"_19309":51098,"_25368":51099,"_2660":51100},[],"/docs/pr-preview/pr-39/platform/pki/certificates#open-the-action","Open the action",{"_3162":1886,"_27842":1879,"_5":28182,"_19309":51102,"_25368":51103,"_2660":51104},[],"/docs/pr-preview/pr-39/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3162":1887,"_27842":1879,"_5":28182,"_19309":51106,"_25368":51107,"_2660":51108},[],"/docs/pr-preview/pr-39/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3162":1888,"_27842":1879,"_5":28182,"_19309":51110,"_25368":51111,"_2660":51112},[],"/docs/pr-preview/pr-39/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3162":1889,"_27842":1879,"_5":28182,"_19309":51114,"_25368":51115,"_2660":51116},[],"/docs/pr-preview/pr-39/platform/pki/certificates#continue","Continue",{"_3162":1890,"_27842":1879,"_19309":51118,"_5":13254,"_25368":1879,"_2660":51119},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3162":1891,"_27842":1879,"_19309":51121,"_5":13254,"_25368":51083,"_2660":51122},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3162":1892,"_27842":1879,"_19309":51124,"_5":13254,"_25368":51083,"_2660":51125},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3162":1893,"_27842":1879,"_19309":51127,"_5":13254,"_25368":51087,"_2660":51128},[],"Download the PEM and inspect it:",{"_3162":1894,"_27842":1879,"_19309":51130,"_5":13254,"_25368":51087,"_2660":51131},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3162":1895,"_27842":1879,"_19309":51133,"_5":13254,"_25368":51091,"_2660":51134},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3162":1896,"_27842":1879,"_19309":51136,"_5":13254,"_25368":51091,"_2660":51137},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3162":1897,"_27842":1879,"_19309":51139,"_5":13254,"_25368":51091,"_2660":51140},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3162":1898,"_27842":1879,"_19309":51142,"_5":13254,"_25368":51091,"_2660":51143},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3162":1899,"_27842":1879,"_19309":51145,"_5":13254,"_25368":51091,"_2660":51146},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3162":1900,"_27842":1879,"_19309":51148,"_5":13254,"_25368":51091,"_2660":51149},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3162":1901,"_27842":1879,"_19309":51151,"_5":13254,"_25368":51091,"_2660":51152},[],"For browser key generation, follow Issue your first certificate.",{"_3162":1902,"_27842":1879,"_19309":51154,"_5":13254,"_25368":51095,"_2660":51155},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3162":1903,"_27842":1879,"_19309":51157,"_5":13254,"_25368":51099,"_2660":51158},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3162":1904,"_27842":1879,"_19309":51160,"_5":13254,"_25368":51103,"_2660":51161},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3162":1905,"_27842":1879,"_19309":51163,"_5":13254,"_25368":51107,"_2660":51164},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3162":1906,"_27842":1879,"_19309":51166,"_5":13254,"_25368":51107,"_2660":51167},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3162":1907,"_27842":1879,"_19309":51169,"_5":13254,"_25368":51107,"_2660":51170},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3162":1908,"_27842":1879,"_19309":51172,"_5":13254,"_25368":51111,"_2660":51173},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3162":1909,"_27842":1879,"_19309":51175,"_5":13254,"_25368":51111,"_2660":51176},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3162":1910,"_27842":1879,"_19309":51178,"_5":13254,"_25368":51111,"_2660":51179},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3162":1911,"_27842":1879,"_19309":51181,"_5":13254,"_25368":51115,"_2660":51182},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3162":1912,"_27842":1879,"_19309":51184,"_5":13254,"_25368":51115,"_2660":51185},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3162":1913,"_27842":1913,"_5":13585,"_2660":51187,"_28185":51188,"_19309":51190,"_25368":1913},"Certificate lifecycle",[45219,46599,50332,51189],"Concepts",[],{"_3162":1914,"_27842":1913,"_19309":51192,"_5":13254,"_25368":1913,"_2660":51193},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3162":1915,"_27842":1913,"_5":28182,"_19309":51195,"_25368":51196,"_2660":51197},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3162":1916,"_27842":1913,"_5":28182,"_19309":51199,"_25368":51200,"_2660":51201},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3162":1917,"_27842":1913,"_5":28182,"_19309":51203,"_25368":51204,"_2660":51205},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3162":1918,"_27842":1913,"_5":28182,"_19309":51207,"_25368":51208,"_2660":51209},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3162":1919,"_27842":1913,"_5":28182,"_19309":51211,"_25368":51212,"_2660":51213},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3162":1920,"_27842":1913,"_5":28182,"_19309":51215,"_25368":51216,"_2660":51217},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3162":1921,"_27842":1913,"_5":28182,"_19309":51219,"_25368":51220,"_2660":51221},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3162":1922,"_27842":1913,"_5":28182,"_19309":51223,"_25368":51224,"_2660":51225},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3162":1923,"_27842":1913,"_5":28182,"_19309":51227,"_25368":51228,"_2660":51229},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3162":1924,"_27842":1913,"_5":28182,"_19309":51231,"_25368":51232,"_2660":51233},[],"/docs/pr-preview/pr-39/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3162":1925,"_27842":1913,"_19309":51235,"_5":13254,"_25368":1913,"_2660":51236},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3162":1926,"_27842":1913,"_19309":51238,"_5":13254,"_25368":51200,"_2660":51239},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3162":1927,"_27842":1913,"_19309":51241,"_5":13254,"_25368":51204,"_2660":51242},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3162":1928,"_27842":1913,"_19309":51244,"_5":13254,"_25368":51208,"_2660":51245},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3162":1929,"_27842":1913,"_19309":51247,"_5":13254,"_25368":51212,"_2660":51248},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3162":1930,"_27842":1913,"_19309":51250,"_5":13254,"_25368":51216,"_2660":51251},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3162":1931,"_27842":1913,"_19309":51253,"_5":13254,"_25368":51220,"_2660":51254},[],"Lamassu persists four X.509 states:",{"_3162":1932,"_27842":1913,"_19309":51256,"_5":13254,"_25368":51220,"_2660":51257},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3162":1933,"_27842":1913,"_19309":51259,"_5":13254,"_25368":51220,"_2660":51260},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3162":1934,"_27842":1913,"_19309":51262,"_5":13254,"_25368":51220,"_2660":51263},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3162":1935,"_27842":1913,"_19309":51265,"_5":13254,"_25368":51220,"_2660":51266},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3162":1936,"_27842":1913,"_19309":51268,"_5":13254,"_25368":51220,"_2660":51269},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3162":1937,"_27842":1913,"_19309":51271,"_5":13254,"_25368":51224,"_2660":51272},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3162":1938,"_27842":1913,"_19309":51274,"_5":13254,"_25368":51224,"_2660":51275},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3162":1939,"_27842":1913,"_19309":51277,"_5":13254,"_25368":51224,"_2660":51278},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3162":1940,"_27842":1913,"_19309":51280,"_5":13254,"_25368":51228,"_2660":51281},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3162":1941,"_27842":1913,"_19309":51283,"_5":13254,"_25368":51228,"_2660":51284},[],"Before confirming:",{"_3162":1942,"_27842":1913,"_19309":51286,"_5":13254,"_25368":51228,"_2660":51287},[],"Identify DMSs, devices and services that trust that chain.",{"_3162":1943,"_27842":1913,"_19309":51289,"_5":13254,"_25368":51228,"_2660":51290},[],"Distribute the new chain of trust.",{"_3162":1944,"_27842":1913,"_19309":51292,"_5":13254,"_25368":51228,"_2660":51293},[],"Reissue the necessary identities.",{"_3162":1945,"_27842":1913,"_19309":51295,"_5":13254,"_25368":51228,"_2660":51296},[],"Check OCSP and CRL from a real consumer.",{"_3162":1946,"_27842":1913,"_19309":51298,"_5":13254,"_25368":51228,"_2660":51299},[],"Revoke the old CA once no legitimate traffic remains.",{"_3162":1947,"_27842":1913,"_19309":51301,"_5":13254,"_25368":51228,"_2660":51302},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3162":1948,"_27842":1913,"_19309":51304,"_5":13254,"_25368":51232,"_2660":51305},[],"Certificates entering the preventive or critical renewal window.",{"_3162":1949,"_27842":1913,"_19309":51307,"_5":13254,"_25368":51232,"_2660":51308},[],"Repeated enrollment or re-enrollment failures.",{"_3162":1950,"_27842":1913,"_19309":51310,"_5":13254,"_25368":51232,"_2660":51311},[],"Status changes and revocation reasons.",{"_3162":1951,"_27842":1913,"_19309":51313,"_5":13254,"_25368":51232,"_2660":51314},[],"OCSP and CRL publication and validity.",{"_3162":1952,"_27842":1913,"_19309":51316,"_5":13254,"_25368":51232,"_2660":51317},[],"Dependencies still presenting a replaced certificate.",{"_3162":1953,"_27842":1913,"_19309":51319,"_5":13254,"_25368":51232,"_2660":51320},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3162":1954,"_27842":1954,"_5":13585,"_2660":51322,"_28185":51323,"_19309":51324,"_25368":1954},"Trust model",[45219,46599,50332,51189],[],{"_3162":1955,"_27842":1954,"_19309":51326,"_5":13254,"_25368":1954,"_2660":51327},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3162":1956,"_27842":1954,"_5":28182,"_19309":51329,"_25368":51330,"_2660":51331},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3162":1957,"_27842":1954,"_5":28182,"_19309":51333,"_25368":51334,"_2660":51335},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3162":1958,"_27842":1954,"_5":28182,"_19309":51337,"_25368":51338,"_2660":51339},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3162":1959,"_27842":1954,"_5":28182,"_19309":51341,"_25368":51342,"_2660":51343},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3162":1960,"_27842":1954,"_5":28182,"_19309":51345,"_25368":51346,"_2660":51347},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3162":1961,"_27842":1954,"_5":28182,"_19309":51349,"_25368":51350,"_2660":51351},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3162":1962,"_27842":1954,"_5":28182,"_19309":51353,"_25368":51354,"_2660":51355},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3162":1963,"_27842":1954,"_5":28182,"_19309":51357,"_25368":51358,"_2660":51359},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3162":1964,"_27842":1954,"_5":28182,"_19309":51361,"_25368":51362,"_2660":51363},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3162":1965,"_27842":1954,"_5":28182,"_19309":51365,"_25368":51366,"_2660":51367},[],"/docs/pr-preview/pr-39/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3162":1966,"_27842":1954,"_19309":51369,"_5":13254,"_25368":1954,"_2660":51370},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3162":1967,"_27842":1954,"_19309":51372,"_5":13254,"_25368":51334,"_2660":51373},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3162":1968,"_27842":1954,"_19309":51375,"_5":13254,"_25368":51338,"_2660":51376},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3162":1969,"_27842":1954,"_19309":51378,"_5":13254,"_25368":51342,"_2660":51379},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3162":1970,"_27842":1954,"_19309":51381,"_5":13254,"_25368":51346,"_2660":51382},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3162":1971,"_27842":1954,"_19309":51384,"_5":13254,"_25368":51350,"_2660":51385},[],"The device proves it can enroll according to the DMS policy.",{"_3162":1972,"_27842":1954,"_19309":51387,"_5":13254,"_25368":51350,"_2660":51388},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3162":1973,"_27842":1954,"_19309":51390,"_5":13254,"_25368":51350,"_2660":51391},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3162":1974,"_27842":1954,"_19309":51393,"_5":13254,"_25368":51350,"_2660":51394},[],"The device installs the certificate and the chain it needs.",{"_3162":1975,"_27842":1954,"_19309":51396,"_5":13254,"_25368":51350,"_2660":51397},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3162":1976,"_27842":1954,"_19309":51399,"_5":13254,"_25368":51350,"_2660":51400},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3162":1977,"_27842":1954,"_19309":51402,"_5":13254,"_25368":51354,"_2660":51403},[],"A DMS relates three sets that are worth designing separately:",{"_3162":1978,"_27842":1954,"_19309":51405,"_5":13254,"_25368":51354,"_2660":51406},[],"**Enrollment CA:** signs the new identities.",{"_3162":1979,"_27842":1954,"_19309":51408,"_5":13254,"_25368":51354,"_2660":51409},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3162":1980,"_27842":1954,"_19309":51411,"_5":13254,"_25368":51354,"_2660":51412},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3162":1981,"_27842":1954,"_19309":51414,"_5":13254,"_25368":51354,"_2660":51415},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3162":1982,"_27842":1954,"_19309":51417,"_5":13254,"_25368":51358,"_2660":51418},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3162":1983,"_27842":1954,"_19309":51420,"_5":13254,"_25368":51358,"_2660":51421},[],"that the current date is between `Not Before` and `Not After`;",{"_3162":1984,"_27842":1954,"_19309":51423,"_5":13254,"_25368":51358,"_2660":51424},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3162":1985,"_27842":1954,"_19309":51426,"_5":13254,"_25368":51358,"_2660":51427},[],"that names, SANs and subject match the expected identity;",{"_3162":1986,"_27842":1954,"_19309":51429,"_5":13254,"_25368":51358,"_2660":51430},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3162":1987,"_27842":1954,"_19309":51432,"_5":13254,"_25368":51358,"_2660":51433},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3162":1988,"_27842":1954,"_19309":51435,"_5":13254,"_25368":51358,"_2660":51436},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3162":1989,"_27842":1954,"_19309":51438,"_5":13254,"_25368":51362,"_2660":51439},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3162":1990,"_27842":1954,"_19309":51441,"_5":13254,"_25368":51366,"_2660":51442},[],"Keep the root out of daily operations, or with very restricted access.",{"_3162":1991,"_27842":1954,"_19309":51444,"_5":13254,"_25368":51366,"_2660":51445},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3162":1992,"_27842":1954,"_19309":51447,"_5":13254,"_25368":51366,"_2660":51448},[],"Assign explicit profiles to every use case.",{"_3162":1993,"_27842":1954,"_19309":51450,"_5":13254,"_25368":51366,"_2660":51451},[],"Distribute the new trust before starting a rotation.",{"_3162":1994,"_27842":1954,"_19309":51453,"_5":13254,"_25368":51366,"_2660":51454},[],"Keep enough overlap to renew a disconnected fleet.",{"_3162":1995,"_27842":1954,"_19309":51456,"_5":13254,"_25368":51366,"_2660":51457},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3162":1996,"_27842":1954,"_19309":51459,"_5":13254,"_25368":51366,"_2660":51460},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3162":1997,"_27842":1997,"_5":13585,"_2660":51462,"_28185":51463,"_19309":51464,"_25368":1997},"Revocation lists (CRL)",[45219,46599,50332,50949],[],{"_3162":1998,"_27842":1997,"_19309":51466,"_5":13254,"_25368":1997,"_2660":51467},[],"Generate and distribute signed lists to validate certificates offline.",{"_3162":1999,"_27842":1997,"_5":28182,"_19309":51469,"_25368":51470,"_2660":51471},[],"/docs/pr-preview/pr-39/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3162":2000,"_27842":1997,"_5":28182,"_19309":51473,"_25368":51474,"_2660":51475},[],"/docs/pr-preview/pr-39/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3162":2001,"_27842":1997,"_5":28182,"_19309":51477,"_25368":51478,"_2660":51479},[],"/docs/pr-preview/pr-39/platform/pki/crl#crl-contents","CRL contents",{"_3162":2002,"_27842":1997,"_5":28182,"_19309":51481,"_25368":51482,"_2660":51483},[],"/docs/pr-preview/pr-39/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3162":2003,"_27842":1997,"_5":28182,"_19309":51485,"_25368":51486,"_2660":51487},[],"/docs/pr-preview/pr-39/platform/pki/crl#va-role-management-api","VA role management API",{"_3162":2004,"_27842":1997,"_5":28182,"_19309":51489,"_25368":51490,"_2660":51491},[],"/docs/pr-preview/pr-39/platform/pki/crl#from-the-interface","From the interface",{"_3162":2005,"_27842":1997,"_5":28182,"_19309":51493,"_25368":51494,"_2660":51495},[],"/docs/pr-preview/pr-39/platform/pki/crl#references","References",{"_3162":2006,"_27842":1997,"_19309":51497,"_5":13254,"_25368":1997,"_2660":51498},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3162":2007,"_27842":1997,"_19309":51500,"_5":13254,"_25368":51470,"_2660":51501},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3162":2008,"_27842":1997,"_19309":51503,"_5":13254,"_25368":51470,"_2660":51504},[],"`crl_options` field",{"_3162":2009,"_27842":1997,"_19309":51506,"_5":13254,"_25368":51470,"_2660":45609},[],{"_3162":2010,"_27842":1997,"_19309":51508,"_5":13254,"_25368":51470,"_2660":51509},[],"Backend initial value",{"_3162":2011,"_27842":1997,"_19309":51511,"_5":13254,"_25368":51470,"_2660":51512},[],"`validity`",{"_3162":2012,"_27842":1997,"_19309":51514,"_5":13254,"_25368":51470,"_2660":51515},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3162":2013,"_27842":1997,"_19309":51517,"_5":13254,"_25368":51470,"_2660":51518},[],"7 days.",{"_3162":2014,"_27842":1997,"_19309":51520,"_5":13254,"_25368":51470,"_2660":51521},[],"`refresh_interval`",{"_3162":2015,"_27842":1997,"_19309":51523,"_5":13254,"_25368":51470,"_2660":51524},[],"Time since publication that triggers scheduled renewal.",{"_3162":2016,"_27842":1997,"_19309":51526,"_5":13254,"_25368":51470,"_2660":51527},[],"6 days and 23 hours.",{"_3162":2017,"_27842":1997,"_19309":51529,"_5":13254,"_25368":51470,"_2660":51530},[],"`regenerate_on_revoke`",{"_3162":2018,"_27842":1997,"_19309":51532,"_5":13254,"_25368":51470,"_2660":51533},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3162":2019,"_27842":1997,"_19309":51535,"_5":13254,"_25368":51470,"_2660":51536},[],"`true`.",{"_3162":2020,"_27842":1997,"_19309":51538,"_5":13254,"_25368":51470,"_2660":51539},[],"`subject_key_id_signer`",{"_3162":2021,"_27842":1997,"_19309":51541,"_5":13254,"_25368":51470,"_2660":51542},[],"Configuration field initialized with the CA’s SKI.",{"_3162":2022,"_27842":1997,"_19309":51544,"_5":13254,"_25368":51470,"_2660":51545},[],"CA SKI.",{"_3162":2023,"_27842":1997,"_19309":51547,"_5":13254,"_25368":51470,"_2660":51548},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_3162":2024,"_27842":1997,"_19309":51550,"_5":13254,"_25368":51470,"_2660":51551},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3162":2025,"_27842":1997,"_19309":51553,"_5":13254,"_25368":51474,"_2660":51554},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3162":2026,"_27842":1997,"_19309":51556,"_5":13254,"_25368":51474,"_2660":51557},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3162":2027,"_27842":1997,"_19309":51559,"_5":13254,"_25368":51474,"_2660":51560},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3162":2028,"_27842":1997,"_19309":51562,"_5":13254,"_25368":51478,"_2660":51563},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3162":2029,"_27842":1997,"_19309":51565,"_5":13254,"_25368":51478,"_2660":51566},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3162":2030,"_27842":1997,"_19309":51568,"_5":13254,"_25368":51482,"_2660":51569},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3162":2031,"_27842":1997,"_19309":51571,"_5":13254,"_25368":51482,"_2660":51572},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3162":2032,"_27842":1997,"_19309":51574,"_5":13254,"_25368":51482,"_2660":51575},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3162":2033,"_27842":1997,"_19309":51577,"_5":13254,"_25368":51482,"_2660":51578},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3162":2034,"_27842":1997,"_19309":51580,"_5":13254,"_25368":51482,"_2660":51581},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3162":2035,"_27842":1997,"_19309":51583,"_5":13254,"_25368":51486,"_2660":51584},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3162":2036,"_27842":1997,"_19309":51586,"_5":13254,"_25368":51486,"_2660":48363},[],{"_3162":2037,"_27842":1997,"_19309":51588,"_5":13254,"_25368":51486,"_2660":51589},[],"Relative path",{"_3162":2038,"_27842":1997,"_19309":51591,"_5":13254,"_25368":51486,"_2660":48360},[],{"_3162":2039,"_27842":1997,"_19309":51593,"_5":13254,"_25368":51486,"_2660":51594},[],"`GET`",{"_3162":2040,"_27842":1997,"_19309":51596,"_5":13254,"_25368":51486,"_2660":51597},[],"`/v1/roles/{ca-ski}`",{"_3162":2041,"_27842":1997,"_19309":51599,"_5":13254,"_25368":51486,"_2660":51600},[],"Read `crl_options` and `latest_crl`.",{"_3162":2042,"_27842":1997,"_19309":51602,"_5":13254,"_25368":51486,"_2660":51603},[],"`PUT`",{"_3162":2043,"_27842":1997,"_19309":51605,"_5":13254,"_25368":51486,"_2660":51597},[],{"_3162":2044,"_27842":1997,"_19309":51607,"_5":13254,"_25368":51486,"_2660":51608},[],"Replace CRL configuration.",{"_3162":2045,"_27842":1997,"_19309":51610,"_5":13254,"_25368":51486,"_2660":51611},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3162":2046,"_27842":1997,"_19309":51613,"_5":13254,"_25368":51486,"_2660":51614},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3162":2047,"_27842":1997,"_19309":51616,"_5":13254,"_25368":51490,"_2660":51617},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3162":2048,"_27842":1997,"_19309":51619,"_5":13254,"_25368":51494,"_2660":51620},[],"RFC 5280: X.509 and CRL profile.",{"_3162":2049,"_27842":1997,"_19309":51622,"_5":13254,"_25368":51494,"_2660":51623},[],"OpenSSL: openssl-crl.",{"_3162":2050,"_27842":1997,"_19309":51625,"_5":13254,"_25368":51494,"_2660":51626},[],"OpenSSL: openssl-verify.",{"_3162":2051,"_27842":1997,"_19309":51628,"_5":13254,"_25368":51494,"_2660":51629},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3162":2052,"_27842":1997,"_19309":51631,"_5":13254,"_25368":51494,"_2660":51632},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3162":2053,"_27842":2053,"_5":13585,"_2660":51634,"_28185":51635,"_19309":51636,"_25368":2053},"Keys and cryptographic engines",[45219,46599,50332,50333],[],{"_3162":2054,"_27842":2053,"_19309":51638,"_5":13254,"_25368":2053,"_2660":51639},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3162":2055,"_27842":2053,"_5":28182,"_19309":51641,"_25368":51642,"_2660":51643},[],"/docs/pr-preview/pr-39/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3162":2056,"_27842":2053,"_5":28182,"_19309":51645,"_25368":51646,"_2660":51647},[],"/docs/pr-preview/pr-39/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3162":2057,"_27842":2053,"_5":28182,"_19309":51649,"_25368":51650,"_2660":51651},[],"/docs/pr-preview/pr-39/platform/pki/key-management#file-system","File System",{"_3162":2058,"_27842":2053,"_5":28182,"_19309":51653,"_25368":51654,"_2660":51655},[],"/docs/pr-preview/pr-39/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3162":2059,"_27842":2053,"_5":28182,"_19309":51657,"_25368":51658,"_2660":51659},[],"/docs/pr-preview/pr-39/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3162":2060,"_27842":2053,"_5":28182,"_19309":51661,"_25368":51662,"_2660":51663},[],"/docs/pr-preview/pr-39/platform/pki/key-management#aws-kms","AWS KMS",{"_3162":2061,"_27842":2053,"_5":28182,"_19309":51665,"_25368":51666,"_2660":51667},[],"/docs/pr-preview/pr-39/platform/pki/key-management#pkcs11","PKCS#11",{"_3162":2062,"_27842":2053,"_5":28182,"_19309":51669,"_25368":51670,"_2660":51671},[],"/docs/pr-preview/pr-39/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3162":2063,"_27842":2053,"_5":28182,"_19309":51673,"_25368":51674,"_2660":51675},[],"/docs/pr-preview/pr-39/platform/pki/key-management#key-inventory","Key inventory",{"_3162":2064,"_27842":2053,"_5":28182,"_19309":51677,"_25368":51678,"_2660":51679},[],"/docs/pr-preview/pr-39/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3162":2065,"_27842":2053,"_5":28182,"_19309":51681,"_25368":51682,"_2660":51683},[],"/docs/pr-preview/pr-39/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3162":2066,"_27842":2053,"_5":28182,"_19309":51685,"_25368":51686,"_2660":51687},[],"/docs/pr-preview/pr-39/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3162":2067,"_27842":2053,"_5":28182,"_19309":51689,"_25368":51690,"_2660":51691},[],"/docs/pr-preview/pr-39/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3162":2068,"_27842":2053,"_5":28182,"_19309":51693,"_25368":51694,"_2660":51695},[],"/docs/pr-preview/pr-39/platform/pki/key-management#view-details","View details",{"_3162":2069,"_27842":2053,"_5":28182,"_19309":51697,"_25368":51698,"_2660":51699},[],"/docs/pr-preview/pr-39/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3162":2070,"_27842":2053,"_5":28182,"_19309":51701,"_25368":51702,"_2660":51703},[],"/docs/pr-preview/pr-39/platform/pki/key-management#sign","Sign",{"_3162":2071,"_27842":2053,"_5":28182,"_19309":51705,"_25368":51706,"_2660":51707},[],"/docs/pr-preview/pr-39/platform/pki/key-management#verify","Verify",{"_3162":2072,"_27842":2053,"_5":28182,"_19309":51709,"_25368":51710,"_2660":51711},[],"/docs/pr-preview/pr-39/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3162":2073,"_27842":2053,"_5":28182,"_19309":51713,"_25368":51714,"_2660":51715},[],"/docs/pr-preview/pr-39/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3162":2074,"_27842":2053,"_5":28182,"_19309":51717,"_25368":51718,"_2660":51719},[],"/docs/pr-preview/pr-39/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3162":2075,"_27842":2053,"_19309":51721,"_5":13254,"_25368":2053,"_2660":51722},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3162":2076,"_27842":2053,"_19309":51724,"_5":13254,"_25368":2053,"_2660":51725},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3162":2077,"_27842":2053,"_19309":51727,"_5":13254,"_25368":51642,"_2660":51728},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3162":2078,"_27842":2053,"_19309":51730,"_5":13254,"_25368":51642,"_2660":51731},[],"In practice, it lets you:",{"_3162":2079,"_27842":2053,"_19309":51733,"_5":13254,"_25368":51642,"_2660":51734},[],"Generate new key pairs from Lamassu IoT.",{"_3162":2080,"_27842":2053,"_19309":51736,"_5":13254,"_25368":51642,"_2660":51737},[],"Import keys created externally.",{"_3162":2081,"_27842":2053,"_19309":51739,"_5":13254,"_25368":51642,"_2660":51740},[],"Delegate custody and cryptographic operations to external engines.",{"_3162":2082,"_27842":2053,"_19309":51742,"_5":13254,"_25368":51642,"_2660":51743},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3162":2083,"_27842":2053,"_19309":51745,"_5":13254,"_25368":51646,"_2660":51746},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3162":2084,"_27842":2053,"_19309":51748,"_5":13254,"_25368":51646,"_2660":51749},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3162":2085,"_27842":2053,"_19309":51751,"_5":13254,"_25368":51646,"_2660":51752},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3162":2086,"_27842":2053,"_19309":51754,"_5":13254,"_25368":51650,"_2660":51755},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3162":2087,"_27842":2053,"_19309":51757,"_5":13254,"_25368":51654,"_2660":51758},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3162":2088,"_27842":2053,"_19309":51760,"_5":13254,"_25368":51658,"_2660":51761},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3162":2089,"_27842":2053,"_19309":51763,"_5":13254,"_25368":51662,"_2660":51764},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3162":2090,"_27842":2053,"_19309":51766,"_5":13254,"_25368":51666,"_2660":51767},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3162":2091,"_27842":2053,"_19309":51769,"_5":13254,"_25368":51670,"_2660":51770},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3162":2092,"_27842":2053,"_19309":51772,"_5":13254,"_25368":51670,"_2660":51773},[],"Lamassu shows the enabled engines in the console.",{"_3162":2093,"_27842":2053,"_19309":51775,"_5":13254,"_25368":51670,"_2660":51776},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3162":2094,"_27842":2053,"_19309":51778,"_5":13254,"_25368":51670,"_2660":51779},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3162":2095,"_27842":2053,"_19309":51781,"_5":13254,"_25368":51674,"_2660":51782},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3162":2096,"_27842":2053,"_19309":51784,"_5":13254,"_25368":51674,"_2660":51785},[],"The table includes the following fields:",{"_3162":2097,"_27842":2053,"_19309":51787,"_5":13254,"_25368":51674,"_2660":51788},[],"**Name**: descriptive name of the key.",{"_3162":2098,"_27842":2053,"_19309":51790,"_5":13254,"_25368":51674,"_2660":51791},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3162":2099,"_27842":2053,"_19309":51793,"_5":13254,"_25368":51674,"_2660":51794},[],"**Strength**: visual indicator of cryptographic strength.",{"_3162":2100,"_27842":2053,"_19309":51796,"_5":13254,"_25368":51674,"_2660":51797},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3162":2101,"_27842":2053,"_19309":51799,"_5":13254,"_25368":51674,"_2660":51800},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3162":2102,"_27842":2053,"_19309":51802,"_5":13254,"_25368":51674,"_2660":51803},[],"**Aliases**: alternative names associated with the key.",{"_3162":2103,"_27842":2053,"_19309":51805,"_5":13254,"_25368":51674,"_2660":51806},[],"**Tags**: labels for classification and search.",{"_3162":2104,"_27842":2053,"_19309":51808,"_5":13254,"_25368":51674,"_2660":51809},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3162":2105,"_27842":2053,"_19309":51811,"_5":13254,"_25368":51674,"_2660":51812},[],"From this view you also reach the most common actions:",{"_3162":2106,"_27842":2053,"_19309":51814,"_5":13254,"_25368":51674,"_2660":51815},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3162":2107,"_27842":2053,"_19309":51817,"_5":13254,"_25368":51674,"_2660":51818},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3162":2108,"_27842":2053,"_19309":51820,"_5":13254,"_25368":51674,"_2660":51821},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3162":2109,"_27842":2053,"_19309":51823,"_5":13254,"_25368":51674,"_2660":51824},[],"**Delete Key** to remove the key from the system.",{"_3162":2110,"_27842":2053,"_19309":51826,"_5":13254,"_25368":51678,"_2660":51827},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3162":2111,"_27842":2053,"_19309":51829,"_5":13254,"_25368":51682,"_2660":51830},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3162":2112,"_27842":2053,"_19309":51832,"_5":13254,"_25368":51682,"_2660":51833},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3162":2113,"_27842":2053,"_19309":51835,"_5":13254,"_25368":51682,"_2660":51836},[],"**Key Name**: unique and descriptive name.",{"_3162":2114,"_27842":2053,"_19309":51838,"_5":13254,"_25368":51682,"_2660":51839},[],"**Crypto Engine**: engine that will keep the key.",{"_3162":2115,"_27842":2053,"_19309":51841,"_5":13254,"_25368":51682,"_2660":51842},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3162":2116,"_27842":2053,"_19309":51844,"_5":13254,"_25368":51682,"_2660":51845},[],"**Tags**: metadata to classify the key.",{"_3162":2117,"_27842":2053,"_19309":51847,"_5":13254,"_25368":51682,"_2660":51848},[],"**Metadata**: additional information for advanced uses.",{"_3162":2118,"_27842":2053,"_19309":51850,"_5":13254,"_25368":51686,"_2660":51851},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3162":2119,"_27842":2053,"_19309":51853,"_5":13254,"_25368":51686,"_2660":51854},[],"When you have an exportable private key and the destination engine supports import.",{"_3162":2120,"_27842":2053,"_19309":51856,"_5":13254,"_25368":51686,"_2660":51857},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3162":2121,"_27842":2053,"_19309":51859,"_5":13254,"_25368":51686,"_2660":51860},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3162":2122,"_27842":2053,"_19309":51862,"_5":13254,"_25368":51686,"_2660":51863},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3162":2123,"_27842":2053,"_19309":51865,"_5":13254,"_25368":51686,"_2660":51866},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3162":2124,"_27842":2053,"_19309":51868,"_5":13254,"_25368":51686,"_2660":51869},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3162":2125,"_27842":2053,"_19309":51871,"_5":13254,"_25368":51686,"_2660":51872},[],"**Tags**: labels for organization and search.",{"_3162":2126,"_27842":2053,"_19309":51874,"_5":13254,"_25368":51686,"_2660":51875},[],"**Metadata**: additional optional information.",{"_3162":2127,"_27842":2053,"_19309":51877,"_5":13254,"_25368":51686,"_2660":51878},[],"**Private Key (PEM)**: private key in PEM format.",{"_3162":2128,"_27842":2053,"_19309":51880,"_5":13254,"_25368":51686,"_2660":51881},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3162":2129,"_27842":2053,"_19309":51883,"_5":13254,"_25368":51690,"_2660":51884},[],"Each registered key has a detail view and several operational actions.",{"_3162":2130,"_27842":2053,"_19309":51886,"_5":13254,"_25368":51694,"_2660":51887},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3162":2131,"_27842":2053,"_19309":51889,"_5":13254,"_25368":51694,"_2660":51890},[],"The **Overview** tab shows, among others, these fields:",{"_3162":2132,"_27842":2053,"_19309":51892,"_5":13254,"_25368":51694,"_2660":51893},[],"**Key Name**: descriptive name.",{"_3162":2133,"_27842":2053,"_19309":51895,"_5":13254,"_25368":51694,"_2660":51896},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3162":2134,"_27842":2053,"_19309":51898,"_5":13254,"_25368":51694,"_2660":51899},[],"**Tags**: associated labels.",{"_3162":2135,"_27842":2053,"_19309":51901,"_5":13254,"_25368":51694,"_2660":51902},[],"**Aliases**: alternative names.",{"_3162":2136,"_27842":2053,"_19309":51904,"_5":13254,"_25368":51694,"_2660":51905},[],"**Crypto Engine**: engine where the key resides.",{"_3162":2137,"_27842":2053,"_19309":51907,"_5":13254,"_25368":51694,"_2660":51908},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3162":2138,"_27842":2053,"_19309":51910,"_5":13254,"_25368":51694,"_2660":51911},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3162":2139,"_27842":2053,"_19309":51913,"_5":13254,"_25368":51694,"_2660":51914},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3162":2140,"_27842":2053,"_19309":51916,"_5":13254,"_25368":51698,"_2660":51917},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3162":2141,"_27842":2053,"_19309":51919,"_5":13254,"_25368":51698,"_2660":51920},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3162":2142,"_27842":2053,"_19309":51922,"_5":13254,"_25368":51698,"_2660":51923},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3162":2143,"_27842":2053,"_19309":51925,"_5":13254,"_25368":51702,"_2660":51926},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3162":2144,"_27842":2053,"_19309":51928,"_5":13254,"_25368":51702,"_2660":51929},[],"Main fields:",{"_3162":2145,"_27842":2053,"_19309":51931,"_5":13254,"_25368":51702,"_2660":51932},[],"**Algorithm**: signing algorithm available for the key type.",{"_3162":2146,"_27842":2053,"_19309":51934,"_5":13254,"_25368":51702,"_2660":51935},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3162":2147,"_27842":2053,"_19309":51937,"_5":13254,"_25368":51702,"_2660":51938},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3162":2148,"_27842":2053,"_19309":51940,"_5":13254,"_25368":51702,"_2660":51941},[],"**Message**: content to sign.",{"_3162":2149,"_27842":2053,"_19309":51943,"_5":13254,"_25368":51702,"_2660":51944},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3162":2150,"_27842":2053,"_19309":51946,"_5":13254,"_25368":51706,"_2660":51947},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3162":2151,"_27842":2053,"_19309":51949,"_5":13254,"_25368":51706,"_2660":51929},[],{"_3162":2152,"_27842":2053,"_19309":51951,"_5":13254,"_25368":51706,"_2660":51952},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3162":2153,"_27842":2053,"_19309":51954,"_5":13254,"_25368":51706,"_2660":51955},[],"**Message Type**: `Raw` or `Digest`.",{"_3162":2154,"_27842":2053,"_19309":51957,"_5":13254,"_25368":51706,"_2660":51958},[],"**Payload Encoding**: encoding of the message.",{"_3162":2155,"_27842":2053,"_19309":51960,"_5":13254,"_25368":51706,"_2660":51961},[],"**Message**: original message or hash.",{"_3162":2156,"_27842":2053,"_19309":51963,"_5":13254,"_25368":51706,"_2660":51964},[],"**Signature**: signature to check.",{"_3162":2157,"_27842":2053,"_19309":51966,"_5":13254,"_25368":51706,"_2660":51967},[],"**Result**: indicator of the validation result.",{"_3162":2158,"_27842":2053,"_19309":51969,"_5":13254,"_25368":51710,"_2660":51970},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3162":2159,"_27842":2053,"_19309":51972,"_5":13254,"_25368":51710,"_2660":51973},[],"This flow is useful for:",{"_3162":2160,"_27842":2053,"_19309":51975,"_5":13254,"_25368":51710,"_2660":51976},[],"Requesting certificates from an external CA.",{"_3162":2161,"_27842":2053,"_19309":51978,"_5":13254,"_25368":51710,"_2660":51979},[],"Renewing an identity while keeping the same key.",{"_3162":2162,"_27842":2053,"_19309":51981,"_5":13254,"_25368":51710,"_2660":51982},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3162":2163,"_27842":2053,"_19309":51984,"_5":13254,"_25368":51710,"_2660":51985},[],"**Common Name (CN)**: main name of the identity.",{"_3162":2164,"_27842":2053,"_19309":51987,"_5":13254,"_25368":51710,"_2660":51988},[],"**Organization (O)**: organization or company.",{"_3162":2165,"_27842":2053,"_19309":51990,"_5":13254,"_25368":51710,"_2660":51991},[],"**Organizational Unit (OU)**: department or unit.",{"_3162":2166,"_27842":2053,"_19309":51993,"_5":13254,"_25368":51710,"_2660":51994},[],"**Country (C)**: two-letter country code.",{"_3162":2167,"_27842":2053,"_19309":51996,"_5":13254,"_25368":51710,"_2660":51997},[],"**State / Province (ST)**: state or province.",{"_3162":2168,"_27842":2053,"_19309":51999,"_5":13254,"_25368":51710,"_2660":52000},[],"**Locality (L)**: city or locality.",{"_3162":2169,"_27842":2053,"_19309":52002,"_5":13254,"_25368":51710,"_2660":52003},[],"**Email Address**: contact email.",{"_3162":2170,"_27842":2053,"_19309":52005,"_5":13254,"_25368":51710,"_2660":52006},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3162":2171,"_27842":2053,"_19309":52008,"_5":13254,"_25368":51710,"_2660":52009},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3162":2172,"_27842":2053,"_19309":52011,"_5":13254,"_25368":51714,"_2660":52012},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3162":2173,"_27842":2053,"_19309":52014,"_5":13254,"_25368":51714,"_2660":52015},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3162":2174,"_27842":2053,"_19309":52017,"_5":13254,"_25368":51718,"_2660":52018},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3162":2175,"_27842":2175,"_5":13585,"_2660":52020,"_28185":52021,"_19309":52022,"_25368":2175},"Online validation with OCSP",[45219,46599,50332,50949],[],{"_3162":2176,"_27842":2175,"_19309":52024,"_5":13254,"_25368":2175,"_2660":52025},[],"Query signed status and verify the responder’s response.",{"_3162":2177,"_27842":2175,"_5":28182,"_19309":52027,"_25368":52028,"_2660":52029},[],"/docs/pr-preview/pr-39/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3162":2178,"_27842":2175,"_5":28182,"_19309":52031,"_25368":52032,"_2660":52033},[],"/docs/pr-preview/pr-39/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3162":2179,"_27842":2175,"_5":28182,"_19309":52035,"_25368":52036,"_2660":52037},[],"/docs/pr-preview/pr-39/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3162":2180,"_27842":2175,"_5":28182,"_19309":52039,"_25368":52040,"_2660":52041},[],"/docs/pr-preview/pr-39/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3162":2181,"_27842":2175,"_5":28182,"_19309":52043,"_25368":52044,"_2660":52045},[],"/docs/pr-preview/pr-39/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3162":2182,"_27842":2175,"_5":28182,"_19309":52047,"_25368":52048,"_2660":51495},[],"/docs/pr-preview/pr-39/platform/pki/ocsp#references",{"_3162":2183,"_27842":2175,"_19309":52050,"_5":13254,"_25368":2175,"_2660":52051},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3162":2184,"_27842":2175,"_19309":52053,"_5":13254,"_25368":52028,"_2660":52054},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3162":2185,"_27842":2175,"_19309":52056,"_5":13254,"_25368":52028,"_2660":52057},[],"Record status",{"_3162":2186,"_27842":2175,"_19309":52059,"_5":13254,"_25368":52028,"_2660":52060},[],"Signed response",{"_3162":2187,"_27842":2175,"_19309":52062,"_5":13254,"_25368":52028,"_2660":49510},[],{"_3162":2188,"_27842":2175,"_19309":52064,"_5":13254,"_25368":52028,"_2660":52065},[],"`Good`.",{"_3162":2189,"_27842":2175,"_19309":52067,"_5":13254,"_25368":52028,"_2660":49527},[],{"_3162":2190,"_27842":2175,"_19309":52069,"_5":13254,"_25368":52028,"_2660":52070},[],"`Revoked`, with revocation reason and timestamp.",{"_3162":2191,"_27842":2175,"_19309":52072,"_5":13254,"_25368":52028,"_2660":52073},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3162":2192,"_27842":2175,"_19309":52075,"_5":13254,"_25368":52028,"_2660":52076},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3162":2193,"_27842":2175,"_19309":52078,"_5":13254,"_25368":52028,"_2660":52079},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3162":2194,"_27842":2175,"_19309":52081,"_5":13254,"_25368":52028,"_2660":52082},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3162":2195,"_27842":2175,"_19309":52084,"_5":13254,"_25368":52028,"_2660":52085},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3162":2196,"_27842":2175,"_19309":52087,"_5":13254,"_25368":52032,"_2660":52088},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3162":2197,"_27842":2175,"_19309":52090,"_5":13254,"_25368":52032,"_2660":52091},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3162":2198,"_27842":2175,"_19309":52093,"_5":13254,"_25368":52036,"_2660":52094},[],"The service accepts:",{"_3162":2199,"_27842":2175,"_19309":52096,"_5":13254,"_25368":52036,"_2660":48363},[],{"_3162":2200,"_27842":2175,"_19309":52098,"_5":13254,"_25368":52036,"_2660":52099},[],"VA service path",{"_3162":2201,"_27842":2175,"_19309":52101,"_5":13254,"_25368":52036,"_2660":52102},[],"Format",{"_3162":2202,"_27842":2175,"_19309":52104,"_5":13254,"_25368":52036,"_2660":52105},[],"`POST`",{"_3162":2203,"_27842":2175,"_19309":52107,"_5":13254,"_25368":52036,"_2660":52108},[],"`/ocsp`",{"_3162":2204,"_27842":2175,"_19309":52110,"_5":13254,"_25368":52036,"_2660":52111},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3162":2205,"_27842":2175,"_19309":52113,"_5":13254,"_25368":52036,"_2660":51594},[],{"_3162":2206,"_27842":2175,"_19309":52115,"_5":13254,"_25368":52036,"_2660":52116},[],"`/ocsp/{ocsp_request}`",{"_3162":2207,"_27842":2175,"_19309":52118,"_5":13254,"_25368":52036,"_2660":52119},[],"DER request encoded using padded URL Base64.",{"_3162":2208,"_27842":2175,"_19309":52121,"_5":13254,"_25368":52036,"_2660":52122},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3162":2209,"_27842":2175,"_19309":52124,"_5":13254,"_25368":52040,"_2660":52125},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3162":2210,"_27842":2175,"_19309":52127,"_5":13254,"_25368":52040,"_2660":52128},[],"Generate the request:",{"_3162":2211,"_27842":2175,"_19309":52130,"_5":13254,"_25368":52040,"_2660":52131},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3162":2212,"_27842":2175,"_19309":52133,"_5":13254,"_25368":52040,"_2660":52134},[],"Replace the example URL with the inspected endpoint:",{"_3162":2213,"_27842":2175,"_19309":52136,"_5":13254,"_25368":52040,"_2660":52137},[],"Verify the returned DER:",{"_3162":2214,"_27842":2175,"_19309":52139,"_5":13254,"_25368":52040,"_2660":52140},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3162":2215,"_27842":2175,"_19309":52142,"_5":13254,"_25368":52044,"_2660":52143},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3162":2216,"_27842":2175,"_19309":52145,"_5":13254,"_25368":52044,"_2660":52146},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3162":2217,"_27842":2175,"_19309":52148,"_5":13254,"_25368":52048,"_2660":52149},[],"RFC 6960: OCSP.",{"_3162":2218,"_27842":2175,"_19309":52151,"_5":13254,"_25368":52048,"_2660":52152},[],"OpenSSL: openssl-ocsp.",{"_3162":2219,"_27842":2175,"_19309":52154,"_5":13254,"_25368":52048,"_2660":52155},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3162":2220,"_27842":2175,"_19309":52157,"_5":13254,"_25368":52048,"_2660":51632},[],{"_3162":2221,"_27842":2221,"_5":13585,"_2660":50332,"_28185":52159,"_19309":52160,"_25368":2221},[45219,46599,50332],[],{"_3162":2222,"_27842":2221,"_19309":52162,"_5":13254,"_25368":2221,"_2660":52163},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3162":2223,"_27842":2221,"_5":28182,"_19309":52165,"_25368":52166,"_2660":49642},[],"/docs/pr-preview/pr-39/platform/pki/overview#start-here",{"_3162":2224,"_27842":2221,"_5":28182,"_19309":52168,"_25368":52169,"_2660":52170},[],"/docs/pr-preview/pr-39/platform/pki/overview#what-you-need","What you need",{"_3162":2225,"_27842":2221,"_5":28182,"_19309":52172,"_25368":52173,"_2660":50176},[],"/docs/pr-preview/pr-39/platform/pki/overview#core-capabilities",{"_3162":2226,"_27842":2221,"_5":28182,"_19309":52175,"_25368":52176,"_2660":50180},[],"/docs/pr-preview/pr-39/platform/pki/overview#build-your-trust-hierarchy",{"_3162":2227,"_27842":2221,"_5":28182,"_19309":52178,"_25368":52179,"_2660":50184},[],"/docs/pr-preview/pr-39/platform/pki/overview#protect-cryptographic-keys",{"_3162":2228,"_27842":2221,"_5":28182,"_19309":52181,"_25368":52182,"_2660":50188},[],"/docs/pr-preview/pr-39/platform/pki/overview#issue-and-control-certificates",{"_3162":2229,"_27842":2221,"_5":28182,"_19309":52184,"_25368":52185,"_2660":50196},[],"/docs/pr-preview/pr-39/platform/pki/overview#publish-validation-status",{"_3162":2230,"_27842":2221,"_5":28182,"_19309":52187,"_25368":52188,"_2660":52189},[],"/docs/pr-preview/pr-39/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3162":2231,"_27842":2221,"_5":28182,"_19309":52191,"_25368":52192,"_2660":51116},[],"/docs/pr-preview/pr-39/platform/pki/overview#continue",{"_3162":2232,"_27842":2221,"_19309":52194,"_5":13254,"_25368":2221,"_2660":52195},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3162":2233,"_27842":2221,"_19309":52197,"_5":13254,"_25368":52166,"_2660":52198},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3162":2234,"_27842":2221,"_19309":52200,"_5":13254,"_25368":52166,"_2660":52201},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3162":2235,"_27842":2221,"_19309":52203,"_5":13254,"_25368":52169,"_2660":52204},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3162":2236,"_27842":2221,"_19309":52206,"_5":13254,"_25368":52169,"_2660":52207},[],"An available cryptographic engine to keep the authority's key.",{"_3162":2237,"_27842":2221,"_19309":52209,"_5":13254,"_25368":52169,"_2660":52210},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3162":2238,"_27842":2221,"_19309":52212,"_5":13254,"_25368":52169,"_2660":52213},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3162":2239,"_27842":2221,"_19309":52215,"_5":13254,"_25368":52169,"_2660":52216},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3162":2240,"_27842":2221,"_19309":52218,"_5":13254,"_25368":52176,"_2660":52219},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3162":2241,"_27842":2221,"_19309":52221,"_5":13254,"_25368":52179,"_2660":52222},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3162":2242,"_27842":2221,"_19309":52224,"_5":13254,"_25368":52182,"_2660":52225},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3162":2243,"_27842":2221,"_19309":52227,"_5":13254,"_25368":52185,"_2660":52228},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3162":2244,"_27842":2221,"_19309":52230,"_5":13254,"_25368":52188,"_2660":52231},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3162":2245,"_27842":2221,"_19309":52233,"_5":13254,"_25368":52188,"_2660":52234},[],"its subject and extensions identify the expected client;",{"_3162":2246,"_27842":2221,"_19309":52236,"_5":13254,"_25368":52188,"_2660":52237},[],"its public key matches the client's private key;",{"_3162":2247,"_27842":2221,"_19309":52239,"_5":13254,"_25368":52188,"_2660":52240},[],"its chain reaches a root trusted by the consumer;",{"_3162":2248,"_27842":2221,"_19309":52242,"_5":13254,"_25368":52188,"_2660":52243},[],"its dates and usages allow the operation;",{"_3162":2249,"_27842":2221,"_19309":52245,"_5":13254,"_25368":52188,"_2660":52246},[],"the consumer applies revocation checks and authorization.",{"_3162":2250,"_27842":2221,"_19309":52248,"_5":13254,"_25368":52188,"_2660":52249},[],"The issuance path includes the first independent checks.",{"_3162":2251,"_27842":2221,"_19309":52251,"_5":13254,"_25368":52192,"_2660":52252},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3162":2252,"_27842":2221,"_19309":52254,"_5":13254,"_25368":52192,"_2660":52255},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3162":2253,"_27842":2221,"_19309":52257,"_5":13254,"_25368":52192,"_2660":52258},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3162":2254,"_27842":2254,"_5":13585,"_2660":52260,"_28185":52261,"_19309":52262,"_25368":2254},"Create your first CA",[45219,46599,50332,49767],[],{"_3162":2255,"_27842":2254,"_19309":52264,"_5":13254,"_25368":2254,"_2660":52265},[],"Create an evaluation root and check its certificate before issuing.",{"_3162":2256,"_27842":2254,"_5":28182,"_19309":52267,"_25368":52268,"_2660":45229},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3162":2257,"_27842":2254,"_5":28182,"_19309":52270,"_25368":52271,"_2660":52272},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3162":2258,"_27842":2254,"_5":28182,"_19309":52274,"_25368":52275,"_2660":52276},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3162":2259,"_27842":2254,"_5":28182,"_19309":52278,"_25368":52279,"_2660":52280},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3162":2260,"_27842":2254,"_5":28182,"_19309":52282,"_25368":52283,"_2660":52284},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3162":2261,"_27842":2254,"_5":28182,"_19309":52286,"_25368":52287,"_2660":52288},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3162":2262,"_27842":2254,"_5":28182,"_19309":52290,"_25368":52291,"_2660":52292},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3162":2263,"_27842":2254,"_5":28182,"_19309":52294,"_25368":52295,"_2660":50025},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3162":2264,"_27842":2254,"_5":28182,"_19309":52297,"_25368":52298,"_2660":45253},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3162":2265,"_27842":2254,"_19309":52300,"_5":13254,"_25368":2254,"_2660":52301},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3162":2266,"_27842":2254,"_19309":52303,"_5":13254,"_25368":52268,"_2660":52304},[],"Console access and permission to create keys and authorities.",{"_3162":2267,"_27842":2254,"_19309":52306,"_5":13254,"_25368":52268,"_2660":52307},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3162":2268,"_27842":2254,"_19309":52309,"_5":13254,"_25368":52268,"_2660":52310},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3162":2269,"_27842":2254,"_19309":52312,"_5":13254,"_25368":52268,"_2660":52313},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3162":2270,"_27842":2254,"_19309":52315,"_5":13254,"_25368":52271,"_2660":52316},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3162":2271,"_27842":2254,"_19309":52318,"_5":13254,"_25368":52271,"_2660":52319},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3162":2272,"_27842":2254,"_19309":52321,"_5":13254,"_25368":52275,"_2660":52322},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3162":2273,"_27842":2254,"_19309":52324,"_5":13254,"_25368":52275,"_2660":52325},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3162":2274,"_27842":2254,"_19309":52327,"_5":13254,"_25368":52279,"_2660":52328},[],"Select **Root CA** and complete:",{"_3162":2275,"_27842":2254,"_19309":52330,"_5":13254,"_25368":52279,"_2660":52331},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3162":2276,"_27842":2254,"_19309":52333,"_5":13254,"_25368":52279,"_2660":52334},[],"**Subject**: organization and country details for your evaluation.",{"_3162":2277,"_27842":2254,"_19309":52336,"_5":13254,"_25368":52279,"_2660":52337},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3162":2278,"_27842":2254,"_19309":52339,"_5":13254,"_25368":52279,"_2660":52340},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3162":2279,"_27842":2254,"_19309":52342,"_5":13254,"_25368":52279,"_2660":52343},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3162":2280,"_27842":2254,"_19309":52345,"_5":13254,"_25368":52283,"_2660":52346},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3162":2281,"_27842":2254,"_19309":52348,"_5":13254,"_25368":52287,"_2660":52349},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3162":2282,"_27842":2254,"_19309":52351,"_5":13254,"_25368":52287,"_2660":52352},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3162":2283,"_27842":2254,"_19309":52354,"_5":13254,"_25368":52291,"_2660":52355},[],"Run from the directory where you saved `ca.pem`:",{"_3162":2284,"_27842":2254,"_19309":52357,"_5":13254,"_25368":52291,"_2660":52358},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3162":2285,"_27842":2254,"_19309":52360,"_5":13254,"_25368":52291,"_2660":52361},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3162":2286,"_27842":2254,"_19309":52363,"_5":13254,"_25368":52295,"_2660":52364},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3162":2287,"_27842":2254,"_19309":52366,"_5":13254,"_25368":52295,"_2660":52367},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3162":2288,"_27842":2254,"_19309":52369,"_5":13254,"_25368":52295,"_2660":52370},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3162":2289,"_27842":2254,"_19309":52372,"_5":13254,"_25368":52295,"_2660":52373},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3162":2290,"_27842":2254,"_19309":52375,"_5":13254,"_25368":52298,"_2660":52376},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3162":2291,"_27842":2291,"_5":13585,"_2660":52378,"_28185":52379,"_19309":52380,"_25368":2291},"Issue and verify a certificate",[45219,46599,50332,49767],[],{"_3162":2292,"_27842":2291,"_19309":52382,"_5":13254,"_25368":2291,"_2660":52383},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3162":2293,"_27842":2291,"_5":28182,"_19309":52385,"_25368":52386,"_2660":45229},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3162":2294,"_27842":2291,"_5":28182,"_19309":52388,"_25368":52389,"_2660":52390},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3162":2295,"_27842":2291,"_5":28182,"_19309":52392,"_25368":52393,"_2660":52394},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3162":2296,"_27842":2291,"_5":28182,"_19309":52396,"_25368":52397,"_2660":52398},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3162":2297,"_27842":2291,"_5":28182,"_19309":52400,"_25368":52401,"_2660":52402},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3162":2298,"_27842":2291,"_5":28182,"_19309":52404,"_25368":52405,"_2660":52406},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3162":2299,"_27842":2291,"_5":28182,"_19309":52408,"_25368":52409,"_2660":52288},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3162":2300,"_27842":2291,"_5":28182,"_19309":52411,"_25368":52412,"_2660":52413},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3162":2301,"_27842":2291,"_5":28182,"_19309":52415,"_25368":52416,"_2660":52417},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3162":2302,"_27842":2291,"_5":28182,"_19309":52419,"_25368":52420,"_2660":52421},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3162":2303,"_27842":2291,"_5":28182,"_19309":52423,"_25368":52424,"_2660":50025},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3162":2304,"_27842":2291,"_5":28182,"_19309":52426,"_25368":52427,"_2660":45253},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/issue-certificate#next-step",{"_3162":2305,"_27842":2291,"_19309":52429,"_5":13254,"_25368":2291,"_2660":52430},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3162":2306,"_27842":2291,"_19309":52432,"_5":13254,"_25368":52386,"_2660":52433},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3162":2307,"_27842":2291,"_19309":52435,"_5":13254,"_25368":52386,"_2660":52436},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3162":2308,"_27842":2291,"_19309":52438,"_5":13254,"_25368":52386,"_2660":52439},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3162":2309,"_27842":2291,"_19309":52441,"_5":13254,"_25368":52386,"_2660":52442},[],"A client identifier: here we use `device-001`.",{"_3162":2310,"_27842":2291,"_19309":52444,"_5":13254,"_25368":52386,"_2660":52445},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3162":2311,"_27842":2291,"_19309":52447,"_5":13254,"_25368":52389,"_2660":52448},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3162":2312,"_27842":2291,"_19309":52450,"_5":13254,"_25368":52393,"_2660":52451},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3162":2313,"_27842":2291,"_19309":52453,"_5":13254,"_25368":52393,"_2660":52454},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3162":2314,"_27842":2291,"_19309":52456,"_5":13254,"_25368":52397,"_2660":52457},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3162":2315,"_27842":2291,"_19309":52459,"_5":13254,"_25368":52397,"_2660":52460},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3162":2316,"_27842":2291,"_19309":52462,"_5":13254,"_25368":52401,"_2660":52463},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3162":2317,"_27842":2291,"_19309":52465,"_5":13254,"_25368":52401,"_2660":52466},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3162":2318,"_27842":2291,"_19309":52468,"_5":13254,"_25368":52405,"_2660":52469},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3162":2319,"_27842":2291,"_19309":52471,"_5":13254,"_25368":52409,"_2660":52472},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3162":2320,"_27842":2291,"_19309":52474,"_5":13254,"_25368":52412,"_2660":52475},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3162":2321,"_27842":2291,"_19309":52477,"_5":13254,"_25368":52416,"_2660":52478},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3162":2322,"_27842":2291,"_19309":52480,"_5":13254,"_25368":52416,"_2660":52481},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3162":2323,"_27842":2291,"_19309":52483,"_5":13254,"_25368":52416,"_2660":52484},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3162":2324,"_27842":2291,"_19309":52486,"_5":13254,"_25368":52420,"_2660":52487},[],"In Bash, compare the two public-key digests:",{"_3162":2325,"_27842":2291,"_19309":52489,"_5":13254,"_25368":52420,"_2660":52490},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3162":2326,"_27842":2291,"_19309":52492,"_5":13254,"_25368":52420,"_2660":52493},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3162":2327,"_27842":2291,"_19309":52495,"_5":13254,"_25368":52424,"_2660":50109},[],{"_3162":2328,"_27842":2291,"_19309":52497,"_5":13254,"_25368":52424,"_2660":52498},[],"What to review",{"_3162":2329,"_27842":2291,"_19309":52500,"_5":13254,"_25368":52424,"_2660":52501},[],"The CA rejects issuance",{"_3162":2330,"_27842":2291,"_19309":52503,"_5":13254,"_25368":52424,"_2660":52504},[],"Permissions, CA state and key, algorithm and profile.",{"_3162":2331,"_27842":2291,"_19309":52506,"_5":13254,"_25368":52424,"_2660":52507},[],"Different subject or usages",{"_3162":2332,"_27842":2291,"_19309":52509,"_5":13254,"_25368":52424,"_2660":52510},[],"Applied profile and requested values.",{"_3162":2333,"_27842":2291,"_19309":52512,"_5":13254,"_25368":52424,"_2660":52513},[],"Issuer cannot be found",{"_3162":2334,"_27842":2291,"_19309":52515,"_5":13254,"_25368":52424,"_2660":52516},[],"Downloaded CA and required intermediate chain.",{"_3162":2335,"_27842":2291,"_19309":52518,"_5":13254,"_25368":52424,"_2660":52519},[],"Validity fails",{"_3162":2336,"_27842":2291,"_19309":52521,"_5":13254,"_25368":52424,"_2660":52522},[],"Certificate and CA dates, and the computer's clock.",{"_3162":2337,"_27842":2291,"_19309":52524,"_5":13254,"_25368":52424,"_2660":52525},[],"Public-key digests differ",{"_3162":2338,"_27842":2291,"_19309":52527,"_5":13254,"_25368":52424,"_2660":52528},[],"Certificate and key files from the same issuance.",{"_3162":2339,"_27842":2291,"_19309":52530,"_5":13254,"_25368":52424,"_2660":52531},[],"See PKI diagnostics to narrow an issuance failure.",{"_3162":2340,"_27842":2291,"_19309":52533,"_5":13254,"_25368":52427,"_2660":52534},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3162":2341,"_27842":2291,"_19309":52536,"_5":13254,"_25368":52427,"_2660":52537},[],"Manage certificates for inspection, status and revocation.",{"_3162":2342,"_27842":2291,"_19309":52539,"_5":13254,"_25368":52427,"_2660":52540},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3162":2343,"_27842":2291,"_19309":52542,"_5":13254,"_25368":52427,"_2660":52543},[],"Prepare EST for the device to request its next identities.",{"_3162":2344,"_27842":2291,"_19309":52545,"_5":13254,"_25368":52427,"_2660":52546},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3162":2345,"_27842":2345,"_5":13585,"_2660":52548,"_28185":52549,"_19309":52550,"_25368":2345},"PKI getting started",[45219,46599,50332,49767],[],{"_3162":2346,"_27842":2345,"_19309":52552,"_5":13254,"_25368":2345,"_2660":52553},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3162":2347,"_27842":2345,"_5":28182,"_19309":52555,"_25368":52556,"_2660":45229},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/overview#before-you-begin",{"_3162":2348,"_27842":2345,"_5":28182,"_19309":52558,"_25368":52559,"_2660":52560},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3162":2349,"_27842":2345,"_5":28182,"_19309":52562,"_25368":52563,"_2660":49959},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/overview#expected-result",{"_3162":2350,"_27842":2345,"_5":28182,"_19309":52565,"_25368":52566,"_2660":52567},[],"/docs/pr-preview/pr-39/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3162":2351,"_27842":2345,"_19309":52569,"_5":13254,"_25368":2345,"_2660":52570},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3162":2352,"_27842":2345,"_19309":52572,"_5":13254,"_25368":52556,"_2660":52573},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3162":2353,"_27842":2345,"_19309":52575,"_5":13254,"_25368":52556,"_2660":52576},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3162":2354,"_27842":2345,"_19309":52578,"_5":13254,"_25368":52556,"_2660":52579},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3162":2355,"_27842":2345,"_19309":52581,"_5":13254,"_25368":52556,"_2660":52582},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3162":2356,"_27842":2345,"_19309":52584,"_5":13254,"_25368":52556,"_2660":52585},[],"A working directory with restricted access for the downloaded key.",{"_3162":2357,"_27842":2345,"_19309":52587,"_5":13254,"_25368":52559,"_2660":52588},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3162":2358,"_27842":2345,"_19309":52590,"_5":13254,"_25368":52559,"_2660":52591},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3162":2359,"_27842":2345,"_19309":52593,"_5":13254,"_25368":52559,"_2660":52594},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3162":2360,"_27842":2345,"_19309":52596,"_5":13254,"_25368":52559,"_2660":52597},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3162":2361,"_27842":2345,"_19309":52599,"_5":13254,"_25368":52563,"_2660":52600},[],"File or resource",{"_3162":2362,"_27842":2345,"_19309":52602,"_5":13254,"_25368":52563,"_2660":49956},[],{"_3162":2363,"_27842":2345,"_19309":52604,"_5":13254,"_25368":52563,"_2660":52605},[],"Active root CA and `ca.pem`",{"_3162":2364,"_27842":2345,"_19309":52607,"_5":13254,"_25368":52563,"_2660":52608},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3162":2365,"_27842":2345,"_19309":52610,"_5":13254,"_25368":52563,"_2660":52611},[],"End-entity certificate and `device.crt`",{"_3162":2366,"_27842":2345,"_19309":52613,"_5":13254,"_25368":52563,"_2660":52614},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3162":2367,"_27842":2345,"_19309":52616,"_5":13254,"_25368":52563,"_2660":52617},[],"Private key `device.key`",{"_3162":2368,"_27842":2345,"_19309":52619,"_5":13254,"_25368":52563,"_2660":52620},[],"Its public key matches the one included in `device.crt`.",{"_3162":2369,"_27842":2345,"_19309":52622,"_5":13254,"_25368":52563,"_2660":52623},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3162":2370,"_27842":2345,"_19309":52625,"_5":13254,"_25368":52566,"_2660":52626},[],"To operate certificates, continue with Certificates and Validation.",{"_3162":2371,"_27842":2345,"_19309":52628,"_5":13254,"_25368":52566,"_2660":52629},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3162":2372,"_27842":2345,"_19309":52631,"_5":13254,"_25368":52566,"_2660":52632},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3162":2373,"_27842":2373,"_5":13585,"_2660":52634,"_28185":52635,"_19309":52636,"_25368":2373},"PKI troubleshooting",[45219,46599,50332,49153],[],{"_3162":2374,"_27842":2373,"_19309":52638,"_5":13254,"_25368":2373,"_2660":52639},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3162":2375,"_27842":2373,"_5":28182,"_19309":52641,"_25368":52642,"_2660":52643},[],"/docs/pr-preview/pr-39/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3162":2376,"_27842":2373,"_5":28182,"_19309":52645,"_25368":52646,"_2660":52647},[],"/docs/pr-preview/pr-39/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3162":2377,"_27842":2373,"_5":28182,"_19309":52649,"_25368":52650,"_2660":52651},[],"/docs/pr-preview/pr-39/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3162":2378,"_27842":2373,"_19309":52653,"_5":13254,"_25368":2373,"_2660":52654},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3162":2379,"_27842":2373,"_19309":52656,"_5":13254,"_25368":2373,"_2660":52657},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3162":2380,"_27842":2373,"_19309":52659,"_5":13254,"_25368":52642,"_2660":49956},[],{"_3162":2381,"_27842":2373,"_19309":52661,"_5":13254,"_25368":52642,"_2660":52662},[],"What to inspect",{"_3162":2382,"_27842":2373,"_19309":52664,"_5":13254,"_25368":52642,"_2660":45253},[],{"_3162":2383,"_27842":2373,"_19309":52666,"_5":13254,"_25368":52642,"_2660":52667},[],"CA",{"_3162":2384,"_27842":2373,"_19309":52669,"_5":13254,"_25368":52642,"_2660":52670},[],"Exists, is active and has usable dates.",{"_3162":2385,"_27842":2373,"_19309":52672,"_5":13254,"_25368":52642,"_2660":52673},[],"Authorities.",{"_3162":2386,"_27842":2373,"_19309":52675,"_5":13254,"_25368":52642,"_2660":52676},[],"Key",{"_3162":2387,"_27842":2373,"_19309":52678,"_5":13254,"_25368":52642,"_2660":52679},[],"The record has a usable private key and the engine can sign.",{"_3162":2388,"_27842":2373,"_19309":52681,"_5":13254,"_25368":52642,"_2660":52682},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3162":2389,"_27842":2373,"_19309":52684,"_5":13254,"_25368":52642,"_2660":52685},[],"CSR",{"_3162":2390,"_27842":2373,"_19309":52687,"_5":13254,"_25368":52642,"_2660":52688},[],"Correct PEM and verifiable signature.",{"_3162":2391,"_27842":2373,"_19309":52690,"_5":13254,"_25368":52642,"_2660":52691},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3162":2392,"_27842":2373,"_19309":52693,"_5":13254,"_25368":52642,"_2660":52694},[],"Profile",{"_3162":2393,"_27842":2373,"_19309":52696,"_5":13254,"_25368":52642,"_2660":52697},[],"Selected source, existing ID, allowed algorithm and size.",{"_3162":2394,"_27842":2373,"_19309":52699,"_5":13254,"_25368":52642,"_2660":52700},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3162":2395,"_27842":2373,"_19309":52702,"_5":13254,"_25368":52642,"_2660":50109},[],{"_3162":2396,"_27842":2373,"_19309":52704,"_5":13254,"_25368":52642,"_2660":52705},[],"Appropriate subject, SAN, usages and dates.",{"_3162":2397,"_27842":2373,"_19309":52707,"_5":13254,"_25368":52642,"_2660":52708},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3162":2398,"_27842":2373,"_19309":52710,"_5":13254,"_25368":52642,"_2660":52711},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3162":2399,"_27842":2373,"_19309":52713,"_5":13254,"_25368":52642,"_2660":52714},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3162":2400,"_27842":2373,"_19309":52716,"_5":13254,"_25368":52646,"_2660":52717},[],"Check each boundary independently:",{"_3162":2401,"_27842":2373,"_19309":52719,"_5":13254,"_25368":52646,"_2660":52720},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3162":2402,"_27842":2373,"_19309":52722,"_5":13254,"_25368":52646,"_2660":52723},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3162":2403,"_27842":2373,"_19309":52725,"_5":13254,"_25368":52646,"_2660":52726},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3162":2404,"_27842":2373,"_19309":52728,"_5":13254,"_25368":52646,"_2660":52729},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3162":2405,"_27842":2373,"_19309":52731,"_5":13254,"_25368":52646,"_2660":52732},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3162":2406,"_27842":2373,"_19309":52734,"_5":13254,"_25368":52646,"_2660":52735},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3162":2407,"_27842":2373,"_19309":52737,"_5":13254,"_25368":52650,"_2660":52738},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3162":2408,"_27842":2373,"_19309":52740,"_5":13254,"_25368":52650,"_2660":52741},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3162":2409,"_27842":2409,"_5":13585,"_2660":52743,"_28185":52744,"_19309":52746,"_25368":2409},"3.8.0 to 4.0.0",[45219,52745],"Upgrades",[],{"_3162":2410,"_27842":2409,"_19309":52748,"_5":13254,"_25368":2409,"_2660":52749},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3162":2411,"_27842":2409,"_5":28182,"_19309":52751,"_25368":52752,"_2660":52753},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3162":2412,"_27842":2409,"_5":28182,"_19309":52755,"_25368":52756,"_2660":52757},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3162":2413,"_27842":2409,"_5":28182,"_19309":52759,"_25368":52760,"_2660":52761},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3162":2414,"_27842":2409,"_5":28182,"_19309":52763,"_25368":52764,"_2660":52765},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3162":2415,"_27842":2409,"_5":28182,"_19309":52767,"_25368":52768,"_2660":52769},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3162":2416,"_27842":2409,"_5":28182,"_19309":52771,"_25368":52772,"_2660":52773},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3162":2417,"_27842":2409,"_5":28182,"_19309":52775,"_25368":52776,"_2660":52777},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3162":2418,"_27842":2409,"_5":28182,"_19309":52779,"_25368":52780,"_2660":52781},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3162":2419,"_27842":2409,"_5":28182,"_19309":52783,"_25368":52784,"_2660":52785},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3162":2420,"_27842":2409,"_5":28182,"_19309":52787,"_25368":52788,"_2660":52789},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3162":2421,"_27842":2409,"_5":28182,"_19309":52791,"_25368":52792,"_2660":52793},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3162":2422,"_27842":2409,"_5":28182,"_19309":52795,"_25368":52796,"_2660":52797},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3162":2423,"_27842":2409,"_5":28182,"_19309":52799,"_25368":52800,"_2660":52801},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3162":2424,"_27842":2409,"_5":28182,"_19309":52803,"_25368":52804,"_2660":52805},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3162":2425,"_27842":2409,"_5":28182,"_19309":52807,"_25368":52808,"_2660":52809},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3162":2426,"_27842":2409,"_5":28182,"_19309":52811,"_25368":52812,"_2660":52813},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3162":2427,"_27842":2409,"_5":28182,"_19309":52815,"_25368":52816,"_2660":52817},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3162":2428,"_27842":2409,"_5":28182,"_19309":52819,"_25368":52820,"_2660":52821},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3162":2429,"_27842":2409,"_5":28182,"_19309":52823,"_25368":52824,"_2660":52825},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3162":2430,"_27842":2409,"_5":28182,"_19309":52827,"_25368":52828,"_2660":52829},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3162":2431,"_27842":2409,"_5":28182,"_19309":52831,"_25368":52832,"_2660":52833},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3162":2432,"_27842":2409,"_5":28182,"_19309":52835,"_25368":52836,"_2660":52837},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3162":2433,"_27842":2409,"_5":28182,"_19309":52839,"_25368":52840,"_2660":52841},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3162":2434,"_27842":2409,"_5":28182,"_19309":52843,"_25368":52844,"_2660":52845},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3162":2435,"_27842":2409,"_5":28182,"_19309":52847,"_25368":52848,"_2660":52849},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3162":2436,"_27842":2409,"_5":28182,"_19309":52851,"_25368":52852,"_2660":52853},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3162":2437,"_27842":2409,"_5":28182,"_19309":52855,"_25368":52856,"_2660":52857},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3162":2438,"_27842":2409,"_5":28182,"_19309":52859,"_25368":52860,"_2660":52861},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3162":2439,"_27842":2409,"_5":28182,"_19309":52863,"_25368":52864,"_2660":52865},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3162":2440,"_27842":2409,"_5":28182,"_19309":52867,"_25368":52868,"_2660":52869},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3162":2441,"_27842":2409,"_5":28182,"_19309":52871,"_25368":52872,"_2660":52873},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3162":2442,"_27842":2409,"_5":28182,"_19309":52875,"_25368":52876,"_2660":52877},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3162":2443,"_27842":2409,"_5":28182,"_19309":52879,"_25368":52880,"_2660":52881},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3162":2444,"_27842":2409,"_5":28182,"_19309":52883,"_25368":52884,"_2660":49153},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3162":2445,"_27842":2409,"_5":28182,"_19309":52886,"_25368":52887,"_2660":52888},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3162":2446,"_27842":2409,"_5":28182,"_19309":52890,"_25368":52891,"_2660":52892},[],"/docs/pr-preview/pr-39/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3162":2447,"_27842":2409,"_19309":52894,"_5":13254,"_25368":2409,"_2660":52895},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3162":2448,"_27842":2409,"_19309":52897,"_5":13254,"_25368":2409,"_2660":52898},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3162":2449,"_27842":2409,"_19309":52900,"_5":13254,"_25368":2409,"_2660":52901},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3162":2450,"_27842":2409,"_19309":52903,"_5":13254,"_25368":2409,"_2660":52904},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3162":2451,"_27842":2409,"_19309":52906,"_5":13254,"_25368":2409,"_2660":52907},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3162":2452,"_27842":2409,"_19309":52909,"_5":13254,"_25368":2409,"_2660":52910},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3162":2453,"_27842":2409,"_19309":52912,"_5":13254,"_25368":2409,"_2660":52913},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3162":2454,"_27842":2409,"_19309":52915,"_5":13254,"_25368":52756,"_2660":52916},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3162":2455,"_27842":2409,"_19309":52918,"_5":13254,"_25368":52756,"_2660":52919},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3162":2456,"_27842":2409,"_19309":52921,"_5":13254,"_25368":52760,"_2660":52922},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3162":2457,"_27842":2409,"_19309":52924,"_5":13254,"_25368":52760,"_2660":52925},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3162":2458,"_27842":2409,"_19309":52927,"_5":13254,"_25368":52764,"_2660":52928},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3162":2459,"_27842":2409,"_19309":52930,"_5":13254,"_25368":52768,"_2660":52931},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3162":2460,"_27842":2409,"_19309":52933,"_5":13254,"_25368":52768,"_2660":52934},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3162":2461,"_27842":2409,"_19309":52936,"_5":13254,"_25368":52768,"_2660":52937},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3162":2462,"_27842":2409,"_19309":52939,"_5":13254,"_25368":52768,"_2660":52940},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3162":2463,"_27842":2409,"_19309":52942,"_5":13254,"_25368":52768,"_2660":52943},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3162":2464,"_27842":2409,"_19309":52945,"_5":13254,"_25368":52772,"_2660":52946},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3162":2465,"_27842":2409,"_19309":52948,"_5":13254,"_25368":52772,"_2660":52949},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3162":2466,"_27842":2409,"_19309":52951,"_5":13254,"_25368":52772,"_2660":52952},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3162":2467,"_27842":2409,"_19309":52954,"_5":13254,"_25368":52772,"_2660":52955},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3162":2468,"_27842":2409,"_19309":52957,"_5":13254,"_25368":52772,"_2660":52958},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3162":2469,"_27842":2409,"_19309":52960,"_5":13254,"_25368":52776,"_2660":52961},[],"Change",{"_3162":2470,"_27842":2409,"_19309":52963,"_5":13254,"_25368":52776,"_2660":52964},[],"Who is affected",{"_3162":2471,"_27842":2409,"_19309":52966,"_5":13254,"_25368":52776,"_2660":52967},[],"Severity",{"_3162":2472,"_27842":2409,"_19309":52969,"_5":13254,"_25368":52776,"_2660":52970},[],"Action",{"_3162":2473,"_27842":2409,"_19309":52972,"_5":13254,"_25368":52776,"_2660":52785},[],{"_3162":2474,"_27842":2409,"_19309":52974,"_5":13254,"_25368":52776,"_2660":52975},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3162":2475,"_27842":2409,"_19309":52977,"_5":13254,"_25368":52776,"_2660":52978},[],"High: KMS and VA start on empty volumes",{"_3162":2476,"_27842":2409,"_19309":52980,"_5":13254,"_25368":52776,"_2660":52981},[],"Copy the data into the new volumes",{"_3162":2477,"_27842":2409,"_19309":52983,"_5":13254,"_25368":52776,"_2660":52789},[],{"_3162":2478,"_27842":2409,"_19309":52985,"_5":13254,"_25368":52776,"_2660":52986},[],"Every Helm release",{"_3162":2479,"_27842":2409,"_19309":52988,"_5":13254,"_25368":52776,"_2660":52989},[],"High: `helm upgrade` fails",{"_3162":2480,"_27842":2409,"_19309":52991,"_5":13254,"_25368":52776,"_2660":52992},[],"Remove or rename legacy keys",{"_3162":2481,"_27842":2409,"_19309":52994,"_5":13254,"_25368":52776,"_2660":52793},[],{"_3162":2482,"_27842":2409,"_19309":52996,"_5":13254,"_25368":52776,"_2660":52997},[],"Every deployment",{"_3162":2483,"_27842":2409,"_19309":52999,"_5":13254,"_25368":52776,"_2660":53000},[],"High: without a bootstrap principal there is no administrator",{"_3162":2484,"_27842":2409,"_19309":53002,"_5":13254,"_25368":52776,"_2660":53003},[],"Configure `services.authz`",{"_3162":2485,"_27842":2409,"_19309":53005,"_5":13254,"_25368":52776,"_2660":52797},[],{"_3162":2486,"_27842":2409,"_19309":53007,"_5":13254,"_25368":52776,"_2660":52986},[],{"_3162":2487,"_27842":2409,"_19309":53009,"_5":13254,"_25368":52776,"_2660":53010},[],"High: `helm upgrade` fails on the old keys",{"_3162":2488,"_27842":2409,"_19309":53012,"_5":13254,"_25368":52776,"_2660":53013},[],"Move JWKS and roles into `services.authz`",{"_3162":2489,"_27842":2409,"_19309":53015,"_5":13254,"_25368":52776,"_2660":52817},[],{"_3162":2490,"_27842":2409,"_19309":53017,"_5":13254,"_25368":52776,"_2660":53018},[],"3.8.0 deployments with per-service databases",{"_3162":2491,"_27842":2409,"_19309":53020,"_5":13254,"_25368":52776,"_2660":53021},[],"High: services find no data, or a migration aborts",{"_3162":2492,"_27842":2409,"_19309":53023,"_5":13254,"_25368":52776,"_2660":53024},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3162":2493,"_27842":2409,"_19309":53026,"_5":13254,"_25368":52776,"_2660":52821},[],{"_3162":2494,"_27842":2409,"_19309":53028,"_5":13254,"_25368":52776,"_2660":53029},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3162":2495,"_27842":2409,"_19309":53031,"_5":13254,"_25368":52776,"_2660":53032},[],"High: the backend no longer starts with them",{"_3162":2496,"_27842":2409,"_19309":53034,"_5":13254,"_25368":52776,"_2660":53035},[],"Move to PostgreSQL before upgrading",{"_3162":2497,"_27842":2409,"_19309":53037,"_5":13254,"_25368":52776,"_2660":53038},[],"Webhooks with file references",{"_3162":2498,"_27842":2409,"_19309":53040,"_5":13254,"_25368":52776,"_2660":53041},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3162":2499,"_27842":2409,"_19309":53043,"_5":13254,"_25368":52776,"_2660":53044},[],"High: enrollments calling the webhook fail",{"_3162":2500,"_27842":2409,"_19309":53046,"_5":13254,"_25368":52776,"_2660":53047},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3162":2501,"_27842":2409,"_19309":53049,"_5":13254,"_25368":52776,"_2660":52801},[],{"_3162":2502,"_27842":2409,"_19309":53051,"_5":13254,"_25368":52776,"_2660":53052},[],"Releases with per-service identity overrides or mounted key material",{"_3162":2503,"_27842":2409,"_19309":53054,"_5":13254,"_25368":52776,"_2660":53055},[],"Medium: services cannot read their files",{"_3162":2504,"_27842":2409,"_19309":53057,"_5":13254,"_25368":52776,"_2660":53058},[],"Remove the overrides and fix volume ownership",{"_3162":2505,"_27842":2409,"_19309":53060,"_5":13254,"_25368":52776,"_2660":52805},[],{"_3162":2506,"_27842":2409,"_19309":53062,"_5":13254,"_25368":52776,"_2660":53063},[],"Releases that set `amqp.tls`",{"_3162":2507,"_27842":2409,"_19309":53065,"_5":13254,"_25368":52776,"_2660":53066},[],"Medium: clients connect to the wrong port",{"_3162":2508,"_27842":2409,"_19309":53068,"_5":13254,"_25368":52776,"_2660":53069},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3162":2509,"_27842":2409,"_19309":53071,"_5":13254,"_25368":52776,"_2660":52825},[],{"_3162":2510,"_27842":2409,"_19309":53073,"_5":13254,"_25368":52776,"_2660":53074},[],"Installations whose CA keys predate the KMS",{"_3162":2511,"_27842":2409,"_19309":53076,"_5":13254,"_25368":52776,"_2660":53077},[],"Medium: CA keys stay unmanaged",{"_3162":2512,"_27842":2409,"_19309":53079,"_5":13254,"_25368":52776,"_2660":53080},[],"Run the CA-to-KMS migration",{"_3162":2513,"_27842":2409,"_19309":53082,"_5":13254,"_25368":52776,"_2660":53083},[],"Receiver certificate verification",{"_3162":2514,"_27842":2409,"_19309":53085,"_5":13254,"_25368":52776,"_2660":53086},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3162":2515,"_27842":2409,"_19309":53088,"_5":13254,"_25368":52776,"_2660":53089},[],"Medium: credentials go to an unverified receiver",{"_3162":2516,"_27842":2409,"_19309":53091,"_5":13254,"_25368":52776,"_2660":53092},[],"Set `insecure_skip_verify` to `false`",{"_3162":2517,"_27842":2409,"_19309":53094,"_5":13254,"_25368":52776,"_2660":52837},[],{"_3162":2518,"_27842":2409,"_19309":53096,"_5":13254,"_25368":52776,"_2660":53097},[],"Scripts and consoles that edit DMSs through the API",{"_3162":2519,"_27842":2409,"_19309":53099,"_5":13254,"_25368":52776,"_2660":53100},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3162":2520,"_27842":2409,"_19309":53102,"_5":13254,"_25368":52776,"_2660":53103},[],"Read the DMS before editing and use the new field",{"_3162":2521,"_27842":2409,"_19309":53105,"_5":13254,"_25368":52776,"_2660":52853},[],{"_3162":2522,"_27842":2409,"_19309":53107,"_5":13254,"_25368":52776,"_2660":53108},[],"Consumers that read the device `events` field",{"_3162":2523,"_27842":2409,"_19309":53110,"_5":13254,"_25368":52776,"_2660":53111},[],"Medium: the field disappears",{"_3162":2524,"_27842":2409,"_19309":53113,"_5":13254,"_25368":52776,"_2660":53114},[],"Use the new event endpoints",{"_3162":2525,"_27842":2409,"_19309":53116,"_5":13254,"_25368":52776,"_2660":52809},[],{"_3162":2526,"_27842":2409,"_19309":53118,"_5":13254,"_25368":52776,"_2660":53119},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3162":2527,"_27842":2409,"_19309":53121,"_5":13254,"_25368":52776,"_2660":53122},[],"Low to medium: validation errors or changed defaults",{"_3162":2528,"_27842":2409,"_19309":53124,"_5":13254,"_25368":52776,"_2660":53125},[],"Update the values file",{"_3162":2529,"_27842":2409,"_19309":53127,"_5":13254,"_25368":52776,"_2660":52845},[],{"_3162":2530,"_27842":2409,"_19309":53129,"_5":13254,"_25368":52776,"_2660":53130},[],"Clients that send the DMS ID in the update body",{"_3162":2531,"_27842":2409,"_19309":53132,"_5":13254,"_25368":52776,"_2660":53133},[],"Low: the ID in the URL wins",{"_3162":2532,"_27842":2409,"_19309":53135,"_5":13254,"_25368":52776,"_2660":53136},[],"Send the ID in the URL",{"_3162":2533,"_27842":2409,"_19309":53138,"_5":13254,"_25368":52776,"_2660":52849},[],{"_3162":2534,"_27842":2409,"_19309":53140,"_5":13254,"_25368":52776,"_2660":53141},[],"Consumers that match on certificate `type`",{"_3162":2535,"_27842":2409,"_19309":53143,"_5":13254,"_25368":52776,"_2660":53144},[],"Low: two values are renamed",{"_3162":2536,"_27842":2409,"_19309":53146,"_5":13254,"_25368":52776,"_2660":53147},[],"Adapt consumers",{"_3162":2537,"_27842":2409,"_19309":53149,"_5":13254,"_25368":52776,"_2660":52841},[],{"_3162":2538,"_27842":2409,"_19309":53151,"_5":13254,"_25368":52776,"_2660":53152},[],"Any DMS",{"_3162":2539,"_27842":2409,"_19309":53154,"_5":13254,"_25368":52776,"_2660":53155},[],"Low: informational",{"_3162":2540,"_27842":2409,"_19309":53157,"_5":13254,"_25368":52776,"_2660":53158},[],"Read both blocks before editing",{"_3162":2541,"_27842":2409,"_19309":53160,"_5":13254,"_25368":52784,"_2660":53161},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3162":2542,"_27842":2409,"_19309":53163,"_5":13254,"_25368":52784,"_2660":53164},[],"Step 4 of the migration guide copies the data.",{"_3162":2543,"_27842":2409,"_19309":53166,"_5":13254,"_25368":52788,"_2660":53167},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3162":2544,"_27842":2409,"_19309":53169,"_5":13254,"_25368":52792,"_2660":53170},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3162":2545,"_27842":2409,"_19309":53172,"_5":13254,"_25368":52796,"_2660":53173},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3162":2546,"_27842":2409,"_19309":53175,"_5":13254,"_25368":52800,"_2660":53176},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3162":2547,"_27842":2409,"_19309":53178,"_5":13254,"_25368":52800,"_2660":53179},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3162":2548,"_27842":2409,"_19309":53181,"_5":13254,"_25368":52804,"_2660":53182},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3162":2549,"_27842":2409,"_19309":53184,"_5":13254,"_25368":52808,"_2660":53185},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3162":2550,"_27842":2409,"_19309":53187,"_5":13254,"_25368":52808,"_2660":53188},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3162":2551,"_27842":2409,"_19309":53190,"_5":13254,"_25368":52808,"_2660":53191},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3162":2552,"_27842":2409,"_19309":53193,"_5":13254,"_25368":52808,"_2660":53194},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3162":2553,"_27842":2409,"_19309":53196,"_5":13254,"_25368":52808,"_2660":53197},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3162":2554,"_27842":2409,"_19309":53199,"_5":13254,"_25368":52808,"_2660":53200},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3162":2555,"_27842":2409,"_19309":53202,"_5":13254,"_25368":52816,"_2660":53203},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3162":2556,"_27842":2409,"_19309":53205,"_5":13254,"_25368":52816,"_2660":53206},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3162":2557,"_27842":2409,"_19309":53208,"_5":13254,"_25368":52816,"_2660":53209},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3162":2558,"_27842":2409,"_19309":53211,"_5":13254,"_25368":52816,"_2660":53212},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3162":2559,"_27842":2409,"_19309":53214,"_5":13254,"_25368":52816,"_2660":53215},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3162":2560,"_27842":2409,"_19309":53217,"_5":13254,"_25368":52820,"_2660":53218},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3162":2561,"_27842":2409,"_19309":53220,"_5":13254,"_25368":52824,"_2660":53221},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3162":2562,"_27842":2409,"_19309":53223,"_5":13254,"_25368":52824,"_2660":53224},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3162":2563,"_27842":2409,"_19309":53226,"_5":13254,"_25368":52824,"_2660":53227},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3162":2564,"_27842":2409,"_19309":53229,"_5":13254,"_25368":52824,"_2660":53230},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3162":2565,"_27842":2409,"_19309":53232,"_5":13254,"_25368":52824,"_2660":53233},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3162":2566,"_27842":2409,"_19309":53235,"_5":13254,"_25368":52824,"_2660":53236},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3162":2567,"_27842":2409,"_19309":53238,"_5":13254,"_25368":52832,"_2660":53239},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3162":2568,"_27842":2409,"_19309":53241,"_5":13254,"_25368":52832,"_2660":53242},[],"Field in 3.8.0",{"_3162":2569,"_27842":2409,"_19309":53244,"_5":13254,"_25368":52832,"_2660":53245},[],"Field in 4.0.0",{"_3162":2570,"_27842":2409,"_19309":53247,"_5":13254,"_25368":52832,"_2660":53248},[],"`validate_server_cert`",{"_3162":2571,"_27842":2409,"_19309":53250,"_5":13254,"_25368":52832,"_2660":53251},[],"`insecure_skip_verify` (value negated)",{"_3162":2572,"_27842":2409,"_19309":53253,"_5":13254,"_25368":52832,"_2660":53254},[],"`oidc`",{"_3162":2573,"_27842":2409,"_19309":53256,"_5":13254,"_25368":52832,"_2660":53257},[],"`jwt_options`",{"_3162":2574,"_27842":2409,"_19309":53259,"_5":13254,"_25368":52832,"_2660":53260},[],"`apikey`",{"_3162":2575,"_27842":2409,"_19309":53262,"_5":13254,"_25368":52832,"_2660":53263},[],"`apikey_options`",{"_3162":2576,"_27842":2409,"_19309":53265,"_5":13254,"_25368":52832,"_2660":53266},[],"`mtls`",{"_3162":2577,"_27842":2409,"_19309":53268,"_5":13254,"_25368":52832,"_2660":53269},[],"`mtls_options`",{"_3162":2578,"_27842":2409,"_19309":53271,"_5":13254,"_25368":52832,"_2660":53272},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3162":2579,"_27842":2409,"_19309":53274,"_5":13254,"_25368":52832,"_2660":53275},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3162":2580,"_27842":2409,"_19309":53277,"_5":13254,"_25368":52832,"_2660":53278},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3162":2581,"_27842":2409,"_19309":53280,"_5":13254,"_25368":52836,"_2660":53281},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3162":2582,"_27842":2409,"_19309":53283,"_5":13254,"_25368":52836,"_2660":53284},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3162":2583,"_27842":2409,"_19309":53286,"_5":13254,"_25368":52836,"_2660":53287},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3162":2584,"_27842":2409,"_19309":53289,"_5":13254,"_25368":52840,"_2660":53290},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. If the console version does not expose independent settings, edit them through the DMS API.",{"_3162":2585,"_27842":2409,"_19309":53292,"_5":13254,"_25368":52844,"_2660":53293},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3162":2586,"_27842":2409,"_19309":53295,"_5":13254,"_25368":52848,"_2660":53296},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3162":2587,"_27842":2409,"_19309":53298,"_5":13254,"_25368":52852,"_2660":53299},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3162":2588,"_27842":2409,"_19309":53301,"_5":13254,"_25368":52852,"_2660":53302},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3162":2589,"_27842":2409,"_19309":53304,"_5":13254,"_25368":52852,"_2660":53305},[],"`POST /v1/devices/:id/events` creates an event.",{"_3162":2590,"_27842":2409,"_19309":53307,"_5":13254,"_25368":52852,"_2660":53308},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3162":2591,"_27842":2409,"_19309":53310,"_5":13254,"_25368":52856,"_2660":53311},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3162":2592,"_27842":2409,"_19309":53313,"_5":13254,"_25368":52860,"_2660":53314},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3162":2593,"_27842":2409,"_19309":53316,"_5":13254,"_25368":52860,"_2660":53317},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3162":2594,"_27842":2409,"_19309":53319,"_5":13254,"_25368":52860,"_2660":53320},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3162":2595,"_27842":2409,"_19309":53322,"_5":13254,"_25368":52860,"_2660":53323},[],"Record the names of your local-storage PVCs:",{"_3162":2596,"_27842":2409,"_19309":53325,"_5":13254,"_25368":52860,"_2660":53326},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3162":2597,"_27842":2409,"_19309":53328,"_5":13254,"_25368":52864,"_2660":53329},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3162":2598,"_27842":2409,"_19309":53331,"_5":13254,"_25368":52864,"_2660":53332},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3162":2599,"_27842":2409,"_19309":53334,"_5":13254,"_25368":52864,"_2660":53335},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3162":2600,"_27842":2409,"_19309":53337,"_5":13254,"_25368":52864,"_2660":53338},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3162":2601,"_27842":2409,"_19309":53340,"_5":13254,"_25368":52864,"_2660":53341},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3162":2602,"_27842":2409,"_19309":53343,"_5":13254,"_25368":52864,"_2660":53344},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3162":2603,"_27842":2409,"_19309":53346,"_5":13254,"_25368":52864,"_2660":53347},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3162":2604,"_27842":2409,"_19309":53349,"_5":13254,"_25368":52864,"_2660":53350},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3162":2605,"_27842":2409,"_19309":53352,"_5":13254,"_25368":52864,"_2660":53353},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3162":2606,"_27842":2409,"_19309":53355,"_5":13254,"_25368":52864,"_2660":53356},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3162":2607,"_27842":2409,"_19309":53358,"_5":13254,"_25368":52864,"_2660":53359},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3162":2608,"_27842":2409,"_19309":53361,"_5":13254,"_25368":52864,"_2660":53362},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3162":2609,"_27842":2409,"_19309":53364,"_5":13254,"_25368":52868,"_2660":53365},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3162":2610,"_27842":2409,"_19309":53367,"_5":13254,"_25368":52868,"_2660":53368},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3162":2611,"_27842":2409,"_19309":53370,"_5":13254,"_25368":52872,"_2660":53371},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3162":2612,"_27842":2409,"_19309":53373,"_5":13254,"_25368":52872,"_2660":53374},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3162":2613,"_27842":2409,"_19309":53376,"_5":13254,"_25368":52872,"_2660":53377},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3162":2614,"_27842":2409,"_19309":53379,"_5":13254,"_25368":52872,"_2660":53380},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3162":2615,"_27842":2409,"_19309":53382,"_5":13254,"_25368":52872,"_2660":53383},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3162":2616,"_27842":2409,"_19309":53385,"_5":13254,"_25368":52872,"_2660":53386},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3162":2617,"_27842":2409,"_19309":53388,"_5":13254,"_25368":52872,"_2660":53389},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3162":2618,"_27842":2409,"_19309":53391,"_5":13254,"_25368":52872,"_2660":53392},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3162":2619,"_27842":2409,"_19309":53394,"_5":13254,"_25368":52872,"_2660":53395},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3162":2620,"_27842":2409,"_19309":53397,"_5":13254,"_25368":52872,"_2660":53398},[],"**Remove the helper and restore the recorded replica counts:**",{"_3162":2621,"_27842":2409,"_19309":53400,"_5":13254,"_25368":52872,"_2660":53401},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3162":2622,"_27842":2409,"_19309":53403,"_5":13254,"_25368":52876,"_2660":53404},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3162":2623,"_27842":2409,"_19309":53406,"_5":13254,"_25368":52876,"_2660":53407},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3162":2624,"_27842":2409,"_19309":53409,"_5":13254,"_25368":52880,"_2660":53410},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3162":2625,"_27842":2409,"_19309":53412,"_5":13254,"_25368":52880,"_2660":53413},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3162":2626,"_27842":2409,"_19309":53415,"_5":13254,"_25368":52880,"_2660":53416},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3162":2627,"_27842":2409,"_19309":53418,"_5":13254,"_25368":52880,"_2660":53419},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3162":2628,"_27842":2409,"_19309":53421,"_5":13254,"_25368":52880,"_2660":53422},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3162":2629,"_27842":2409,"_19309":53424,"_5":13254,"_25368":52884,"_2660":53425},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3162":2630,"_27842":2409,"_19309":53427,"_5":13254,"_25368":52884,"_2660":53428},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3162":2631,"_27842":2409,"_19309":53430,"_5":13254,"_25368":52884,"_2660":53431},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3162":2632,"_27842":2409,"_19309":53433,"_5":13254,"_25368":52884,"_2660":53434},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3162":2633,"_27842":2409,"_19309":53436,"_5":13254,"_25368":52884,"_2660":53437},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3162":2634,"_27842":2409,"_19309":53439,"_5":13254,"_25368":52884,"_2660":53440},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3162":2635,"_27842":2409,"_19309":53442,"_5":13254,"_25368":52884,"_2660":53443},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3162":2636,"_27842":2409,"_19309":53445,"_5":13254,"_25368":52887,"_2660":53446},[],"After the upgrade, check in this order:",{"_3162":2637,"_27842":2409,"_19309":53448,"_5":13254,"_25368":52887,"_2660":53449},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3162":2638,"_27842":2409,"_19309":53451,"_5":13254,"_25368":52887,"_2660":53452},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3162":2639,"_27842":2409,"_19309":53454,"_5":13254,"_25368":52887,"_2660":53455},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3162":2640,"_27842":2409,"_19309":53457,"_5":13254,"_25368":52887,"_2660":53458},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3162":2641,"_27842":2409,"_19309":53460,"_5":13254,"_25368":52887,"_2660":53461},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3162":2642,"_27842":2409,"_19309":53463,"_5":13254,"_25368":52887,"_2660":53464},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3162":2643,"_27842":2409,"_19309":53466,"_5":13254,"_25368":52887,"_2660":53467},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3162":2644,"_27842":2409,"_19309":53469,"_5":13254,"_25368":52887,"_2660":53470},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3162":2645,"_27842":2409,"_19309":53472,"_5":13254,"_25368":52887,"_2660":53473},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3162":2646,"_27842":2409,"_19309":53475,"_5":13254,"_25368":52887,"_2660":53476},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3162":2647,"_27842":2409,"_19309":53478,"_5":13254,"_25368":52887,"_2660":53479},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3162":2648,"_27842":2409,"_19309":53481,"_5":13254,"_25368":52887,"_2660":53482},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3162":2649,"_27842":2409,"_19309":53484,"_5":13254,"_25368":52887,"_2660":53485},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3162":2650,"_27842":2409,"_19309":53487,"_5":13254,"_25368":52887,"_2660":53488},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3162":2651,"_27842":2409,"_19309":53490,"_5":13254,"_25368":52891,"_2660":53491},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3162":2652,"_27842":2409,"_19309":53493,"_5":13254,"_25368":52891,"_2660":53494},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3162":2653,"_27842":2409,"_19309":53496,"_5":13254,"_25368":52891,"_2660":53497},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3162":2654,"_27842":2409,"_19309":53499,"_5":13254,"_25368":52891,"_2660":53500},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3162":2655,"_27842":2409,"_19309":53502,"_5":13254,"_25368":52891,"_2660":53503},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_53506":53507,"_53508":53509,"_53510":53511,"_53512":53513,"_16827":2682,"_64091":2682},"language","engl