2943,"_33546":102946,"_33548":102948,"_33550":102951,"_33552":102954,"_33554":102957,"_33556":102959,"_33558":102962,"_33560":102965,"_33562":102968,"_33564":102971,"_33566":102974,"_33568":102977,"_33570":102980,"_33572":102983,"_33574":102986,"_33576":102989,"_33578":102992,"_33580":102995},{"_2856":57668,"_25078":57668,"_5":12261,"_2383":95736,"_25413":95737,"_17499":95740,"_23735":57668},"Despliega desde AWS Marketplace",[40749,95738,95739],"Despliegue","Otros modelos",[],{"_2856":57669,"_25078":57668,"_17499":95742,"_5":17394,"_23735":57668,"_2383":95743},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2856":57670,"_25078":57668,"_5":25410,"_17499":95745,"_23735":95746,"_2383":95747},[],"/docs/pr-preview/pr-40/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2856":57671,"_25078":57668,"_5":25410,"_17499":95749,"_23735":95750,"_2383":95751},[],"/docs/pr-preview/pr-40/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2856":57672,"_25078":57668,"_5":25410,"_17499":95753,"_23735":95754,"_2383":95755},[],"/docs/pr-preview/pr-40/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2856":57673,"_25078":57668,"_5":25410,"_17499":95757,"_23735":95758,"_2383":95759},[],"/docs/pr-preview/pr-40/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2856":57674,"_25078":57668,"_5":25410,"_17499":95761,"_23735":95762,"_2383":95763},[],"/docs/pr-preview/pr-40/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2856":57675,"_25078":57668,"_5":25410,"_17499":95765,"_23735":95766,"_2383":95767},[],"/docs/pr-preview/pr-40/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2856":57676,"_25078":57668,"_5":25410,"_17499":95769,"_23735":95770,"_2383":95771},[],"/docs/pr-preview/pr-40/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2856":57677,"_25078":57668,"_17499":95773,"_5":17394,"_23735":57668,"_2383":95774},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2856":57678,"_25078":57668,"_17499":95776,"_5":17394,"_23735":95746,"_2383":95777},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2856":57679,"_25078":57668,"_17499":95779,"_5":17394,"_23735":95746,"_2383":95780},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2856":57680,"_25078":57668,"_17499":95782,"_5":17394,"_23735":95746,"_2383":95783},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2856":57681,"_25078":57668,"_17499":95785,"_5":17394,"_23735":95750,"_2383":95786},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2856":57682,"_25078":57668,"_17499":95788,"_5":17394,"_23735":95750,"_2383":95789},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2856":57683,"_25078":57668,"_17499":95791,"_5":17394,"_23735":95750,"_2383":95792},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2856":57684,"_25078":57668,"_17499":95794,"_5":17394,"_23735":95754,"_2383":95795},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2856":57685,"_25078":57668,"_17499":95797,"_5":17394,"_23735":95758,"_2383":95798},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2856":57686,"_25078":57668,"_17499":95800,"_5":17394,"_23735":95762,"_2383":95801},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2856":57687,"_25078":57668,"_17499":95803,"_5":17394,"_23735":95766,"_2383":95804},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2856":57688,"_25078":57668,"_17499":95806,"_5":17394,"_23735":95770,"_2383":95807},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2856":57689,"_25078":57689,"_5":12261,"_2383":95809,"_25413":95810,"_17499":95811,"_23735":57689},"Despliega Lamassu",[40749,95738],[],{"_2856":57690,"_25078":57689,"_17499":95813,"_5":17394,"_23735":57689,"_2383":95814},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2856":57691,"_25078":57689,"_5":25410,"_17499":95816,"_23735":95817,"_2383":95818},[],"/docs/pr-preview/pr-40/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2856":57692,"_25078":57689,"_5":25410,"_17499":95820,"_23735":95821,"_2383":95822},[],"/docs/pr-preview/pr-40/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2856":57693,"_25078":57689,"_5":25410,"_17499":95824,"_23735":95825,"_2383":95826},[],"/docs/pr-preview/pr-40/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2856":57694,"_25078":57689,"_17499":95828,"_5":17394,"_23735":57689,"_2383":95829},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2856":57695,"_25078":57689,"_17499":95831,"_5":17394,"_23735":95817,"_2383":95832},[],"Modelo",{"_2856":57696,"_25078":57689,"_17499":95834,"_5":17394,"_23735":95817,"_2383":95835},[],"Recomendado para",{"_2856":57697,"_25078":57689,"_17499":95837,"_5":17394,"_23735":95817,"_2383":95838},[],"Quién opera la infraestructura",{"_2856":57698,"_25078":57689,"_17499":95840,"_5":17394,"_23735":95817,"_2383":95841},[],"Punto de partida",{"_2856":57699,"_25078":57689,"_17499":95843,"_5":17394,"_23735":95817,"_2383":40856},[],{"_2856":57700,"_25078":57689,"_17499":95845,"_5":17394,"_23735":95817,"_2383":95846},[],"Producción, entornos regulados y despliegues personalizados",{"_2856":57701,"_25078":57689,"_17499":95848,"_5":17394,"_23735":95817,"_2383":95849},[],"Tu equipo",{"_2856":57702,"_25078":57689,"_17499":95851,"_5":17394,"_23735":95817,"_2383":95852},[],"Helm o Fastlane",{"_2856":57703,"_25078":57689,"_17499":95854,"_5":17394,"_23735":95817,"_2383":40868},[],{"_2856":57704,"_25078":57689,"_17499":95856,"_5":17394,"_23735":95817,"_2383":95857},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2856":57705,"_25078":57689,"_17499":95859,"_5":17394,"_23735":95817,"_2383":95849},[],{"_2856":57706,"_25078":57689,"_17499":95861,"_5":17394,"_23735":95817,"_2383":95862},[],"Imagen preconfigurada en EC2",{"_2856":57707,"_25078":57689,"_17499":95864,"_5":17394,"_23735":95817,"_2383":40879},[],{"_2856":57708,"_25078":57689,"_17499":95866,"_5":17394,"_23735":95817,"_2383":95867},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2856":57709,"_25078":57689,"_17499":95869,"_5":17394,"_23735":95817,"_2383":40885},[],{"_2856":57710,"_25078":57689,"_17499":95871,"_5":17394,"_23735":95817,"_2383":95872},[],"Suscripción gestionada",{"_2856":57711,"_25078":57689,"_17499":95874,"_5":17394,"_23735":95817,"_2383":95875},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2856":57712,"_25078":57689,"_17499":95877,"_5":17394,"_23735":95817,"_2383":95878},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2856":57713,"_25078":57689,"_17499":95880,"_5":17394,"_23735":95817,"_2383":95881},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2856":57714,"_25078":57689,"_17499":95883,"_5":17394,"_23735":95821,"_2383":95884},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2856":57715,"_25078":57689,"_17499":95886,"_5":17394,"_23735":95825,"_2383":95887},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2856":57716,"_25078":57716,"_5":12261,"_2383":95889,"_25413":95890,"_17499":95891,"_23735":57716},"Utiliza Lamassu como SaaS",[40749,95738,95739],[],{"_2856":57717,"_25078":57716,"_17499":95893,"_5":17394,"_23735":57716,"_2383":95894},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2856":57718,"_25078":57716,"_5":25410,"_17499":95896,"_23735":95897,"_2383":95898},[],"/docs/pr-preview/pr-40/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2856":57719,"_25078":57716,"_5":25410,"_17499":95900,"_23735":95901,"_2383":95902},[],"/docs/pr-preview/pr-40/es/deployment/saas#planes","Planes",{"_2856":57720,"_25078":57716,"_5":25410,"_17499":95904,"_23735":95905,"_2383":95906},[],"/docs/pr-preview/pr-40/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2856":57721,"_25078":57716,"_17499":95908,"_5":17394,"_23735":57716,"_2383":95909},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2856":57722,"_25078":57716,"_17499":95911,"_5":17394,"_23735":95897,"_2383":95912},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2856":57723,"_25078":57716,"_17499":95914,"_5":17394,"_23735":95897,"_2383":95915},[],"Copias de seguridad automáticas.",{"_2856":57724,"_25078":57716,"_17499":95917,"_5":17394,"_23735":95897,"_2383":95918},[],"Actualizaciones de versión.",{"_2856":57725,"_25078":57716,"_17499":95920,"_5":17394,"_23735":95897,"_2383":95921},[],"Soporte técnico y SLA según el plan contratado.",{"_2856":57726,"_25078":57716,"_17499":95923,"_5":17394,"_23735":95901,"_2383":40940},[],{"_2856":57727,"_25078":57716,"_17499":95925,"_5":17394,"_23735":95901,"_2383":95926},[],"Dispositivos",{"_2856":57728,"_25078":57716,"_17499":95928,"_5":17394,"_23735":95901,"_2383":95929},[],"Soporte",{"_2856":57729,"_25078":57716,"_17499":95931,"_5":17394,"_23735":95901,"_2383":40949},[],{"_2856":57730,"_25078":57716,"_17499":95933,"_5":17394,"_23735":95901,"_2383":40952},[],{"_2856":57731,"_25078":57716,"_17499":95935,"_5":17394,"_23735":95901,"_2383":95936},[],"Hasta 1.000",{"_2856":57732,"_25078":57716,"_17499":95938,"_5":17394,"_23735":95901,"_2383":40958},[],{"_2856":57733,"_25078":57716,"_17499":95940,"_5":17394,"_23735":95901,"_2383":95941},[],"99,5 %",{"_2856":57734,"_25078":57716,"_17499":95943,"_5":17394,"_23735":95901,"_2383":40964},[],{"_2856":57735,"_25078":57716,"_17499":95945,"_5":17394,"_23735":95901,"_2383":95946},[],"Hasta 10.000",{"_2856":57736,"_25078":57716,"_17499":95948,"_5":17394,"_23735":95901,"_2383":95949},[],"Email y chat",{"_2856":57737,"_25078":57716,"_17499":95951,"_5":17394,"_23735":95901,"_2383":95952},[],"99,9 %",{"_2856":57738,"_25078":57716,"_17499":95954,"_5":17394,"_23735":95901,"_2383":40976},[],{"_2856":57739,"_25078":57716,"_17499":95956,"_5":17394,"_23735":95901,"_2383":95957},[],"Ilimitados",{"_2856":57740,"_25078":57716,"_17499":95959,"_5":17394,"_23735":95901,"_2383":95960},[],"Dedicado",{"_2856":57741,"_25078":57716,"_17499":95962,"_5":17394,"_23735":95901,"_2383":95963},[],"99,99 %",{"_2856":57742,"_25078":57716,"_17499":95965,"_5":17394,"_23735":95905,"_2383":95966},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2856":57743,"_25078":57716,"_17499":95968,"_5":17394,"_23735":95905,"_2383":95969},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2856":57744,"_25078":57744,"_5":12261,"_2383":40993,"_25413":95971,"_17499":95973,"_23735":57744},[40749,95738,95972],"Kubernetes autogestionado",[],{"_2856":57745,"_25078":57744,"_17499":95975,"_5":17394,"_23735":57744,"_2383":95976},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2856":57746,"_25078":57744,"_5":25410,"_17499":95978,"_23735":95979,"_2383":95980},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2856":57747,"_25078":57744,"_5":25410,"_17499":95982,"_23735":95983,"_2383":95984},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2856":57748,"_25078":57744,"_5":25410,"_17499":95986,"_23735":95987,"_2383":95988},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2856":57749,"_25078":57744,"_5":25410,"_17499":95990,"_23735":95991,"_2383":95992},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2856":57750,"_25078":57744,"_5":25410,"_17499":95994,"_23735":95995,"_2383":95996},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2856":57751,"_25078":57744,"_5":25410,"_17499":95998,"_23735":95999,"_2383":96000},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2856":57752,"_25078":57744,"_5":25410,"_17499":96002,"_23735":96003,"_2383":96004},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2856":57753,"_25078":57744,"_5":25410,"_17499":96006,"_23735":96007,"_2383":96008},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2856":57754,"_25078":57744,"_5":25410,"_17499":96010,"_23735":96011,"_2383":96012},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2856":57755,"_25078":57744,"_5":25410,"_17499":96014,"_23735":96015,"_2383":96016},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2856":57756,"_25078":57744,"_17499":96018,"_5":17394,"_23735":95979,"_2383":96019},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2856":57757,"_25078":57744,"_17499":96021,"_5":17394,"_23735":95979,"_2383":96022},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2856":57758,"_25078":57744,"_17499":96024,"_5":17394,"_23735":95983,"_2383":96025},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2856":57759,"_25078":57744,"_17499":96027,"_5":17394,"_23735":95983,"_2383":96028},[],"Fastlane instala o configura",{"_2856":57760,"_25078":57744,"_17499":96030,"_5":17394,"_23735":95983,"_2383":96031},[],"Tú sigues proporcionando",{"_2856":57761,"_25078":57744,"_17499":96033,"_5":17394,"_23735":95983,"_2383":96034},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2856":57762,"_25078":57744,"_17499":96036,"_5":17394,"_23735":95983,"_2383":96037},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2856":57763,"_25078":57744,"_17499":96039,"_5":17394,"_23735":95983,"_2383":96040},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2856":57764,"_25078":57744,"_17499":96042,"_5":17394,"_23735":95983,"_2383":96043},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2856":57765,"_25078":57744,"_17499":96045,"_5":17394,"_23735":95983,"_2383":96046},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2856":57766,"_25078":57744,"_17499":96048,"_5":17394,"_23735":95983,"_2383":96049},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2856":57767,"_25078":57744,"_17499":96051,"_5":17394,"_23735":95983,"_2383":96052},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2856":57768,"_25078":57744,"_17499":96054,"_5":17394,"_23735":95983,"_2383":96055},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2856":57769,"_25078":57744,"_17499":96057,"_5":17394,"_23735":95983,"_2383":96058},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2856":57770,"_25078":57744,"_17499":96060,"_5":17394,"_23735":95987,"_2383":96061},[],"Necesitas:",{"_2856":57771,"_25078":57744,"_17499":96063,"_5":17394,"_23735":95987,"_2383":96064},[],"un clúster Kubernetes existente",{"_2856":57772,"_25078":57744,"_17499":96066,"_5":17394,"_23735":95987,"_2383":96067},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2856":57773,"_25078":57744,"_17499":96069,"_5":17394,"_23735":95987,"_2383":41091},[],{"_2856":57774,"_25078":57744,"_17499":96071,"_5":17394,"_23735":95987,"_2383":19804},[],{"_2856":57775,"_25078":57744,"_17499":96073,"_5":17394,"_23735":95987,"_2383":96074},[],"`jq` solo si usas `--sample-data`",{"_2856":57776,"_25078":57744,"_17499":96076,"_5":17394,"_23735":95987,"_2383":96077},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2856":57777,"_25078":57744,"_17499":96079,"_5":17394,"_23735":95987,"_2383":96080},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2856":57778,"_25078":57744,"_17499":96082,"_5":17394,"_23735":95987,"_2383":96083},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2856":57779,"_25078":57744,"_17499":96085,"_5":17394,"_23735":95991,"_2383":96086},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2856":57780,"_25078":57744,"_17499":96088,"_5":17394,"_23735":95991,"_2383":96089},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2856":57781,"_25078":57744,"_17499":96091,"_5":17394,"_23735":95995,"_2383":96092},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2856":57782,"_25078":57744,"_17499":96094,"_5":17394,"_23735":95995,"_2383":96095},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2856":57783,"_25078":57744,"_17499":96097,"_5":17394,"_23735":95995,"_2383":96098},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2856":57784,"_25078":57744,"_17499":96100,"_5":17394,"_23735":95995,"_2383":96101},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2856":57785,"_25078":57744,"_17499":96103,"_5":17394,"_23735":95999,"_2383":96104},[],"Opción",{"_2856":57786,"_25078":57744,"_17499":96106,"_5":17394,"_23735":95999,"_2383":96107},[],"Valor predeterminado",{"_2856":57787,"_25078":57744,"_17499":96109,"_5":17394,"_23735":95999,"_2383":96110},[],"Propósito",{"_2856":57788,"_25078":57744,"_17499":96112,"_5":17394,"_23735":95999,"_2383":41135},[],{"_2856":57789,"_25078":57744,"_17499":96114,"_5":17394,"_23735":95999,"_2383":41138},[],{"_2856":57790,"_25078":57744,"_17499":96116,"_5":17394,"_23735":95999,"_2383":96117},[],"Muestra la ayuda",{"_2856":57791,"_25078":57744,"_17499":96119,"_5":17394,"_23735":95999,"_2383":41144},[],{"_2856":57792,"_25078":57744,"_17499":96121,"_5":17394,"_23735":95999,"_2383":96122},[],"contexto actual",{"_2856":57793,"_25078":57744,"_17499":96124,"_5":17394,"_23735":95999,"_2383":96125},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2856":57794,"_25078":57744,"_17499":96127,"_5":17394,"_23735":95999,"_2383":41153},[],{"_2856":57795,"_25078":57744,"_17499":96129,"_5":17394,"_23735":95999,"_2383":5346},[],{"_2856":57796,"_25078":57744,"_17499":96131,"_5":17394,"_23735":95999,"_2383":96132},[],"Omite prompts y genera credenciales para las dependencias",{"_2856":57797,"_25078":57744,"_17499":96134,"_5":17394,"_23735":95999,"_2383":41161},[],{"_2856":57798,"_25078":57744,"_17499":96136,"_5":17394,"_23735":95999,"_2383":41164},[],{"_2856":57799,"_25078":57744,"_17499":96138,"_5":17394,"_23735":95999,"_2383":96139},[],"Namespace de la instalación",{"_2856":57800,"_25078":57744,"_17499":96141,"_5":17394,"_23735":95999,"_2383":41170},[],{"_2856":57801,"_25078":57744,"_17499":96143,"_5":17394,"_23735":95999,"_2383":41173},[],{"_2856":57802,"_25078":57744,"_17499":96145,"_5":17394,"_23735":95999,"_2383":96146},[],"Dominio usado por la UI, OIDC y el certificado",{"_2856":57803,"_25078":57744,"_17499":96148,"_5":17394,"_23735":95999,"_2383":41179},[],{"_2856":57804,"_25078":57744,"_17499":96150,"_5":17394,"_23735":95999,"_2383":12494},[],{"_2856":57805,"_25078":57744,"_17499":96152,"_5":17394,"_23735":95999,"_2383":96153},[],"Versión del chart de Lamassu",{"_2856":57806,"_25078":57744,"_17499":96155,"_5":17394,"_23735":95999,"_2383":41187},[],{"_2856":57807,"_25078":57744,"_17499":96157,"_5":17394,"_23735":95999,"_2383":41190},[],{"_2856":57808,"_25078":57744,"_17499":96159,"_5":17394,"_23735":95999,"_2383":96160},[],"Puerto del listener HTTPS",{"_2856":57809,"_25078":57744,"_17499":96162,"_5":17394,"_23735":95999,"_2383":41196},[],{"_2856":57810,"_25078":57744,"_17499":96164,"_5":17394,"_23735":95999,"_2383":41199},[],{"_2856":57811,"_25078":57744,"_17499":96166,"_5":17394,"_23735":95999,"_2383":96167},[],"Puerto del listener HTTP",{"_2856":57812,"_25078":57744,"_17499":96169,"_5":17394,"_23735":95999,"_2383":41205},[],{"_2856":57813,"_25078":57744,"_17499":96171,"_5":17394,"_23735":95999,"_2383":41138},[],{"_2856":57814,"_25078":57744,"_17499":96173,"_5":17394,"_23735":95999,"_2383":96174},[],"Certificado PEM para TLS downstream",{"_2856":57815,"_25078":57744,"_17499":96176,"_5":17394,"_23735":95999,"_2383":41213},[],{"_2856":57816,"_25078":57744,"_17499":96178,"_5":17394,"_23735":95999,"_2383":41138},[],{"_2856":57817,"_25078":57744,"_17499":96180,"_5":17394,"_23735":95999,"_2383":96181},[],"Clave privada PEM para TLS downstream",{"_2856":57818,"_25078":57744,"_17499":96183,"_5":17394,"_23735":95999,"_2383":41221},[],{"_2856":57819,"_25078":57744,"_17499":96185,"_5":17394,"_23735":95999,"_2383":96186},[],"chart del repositorio",{"_2856":57820,"_25078":57744,"_17499":96188,"_5":17394,"_23735":95999,"_2383":96189},[],"Usa un chart local de Lamassu sin empaquetar",{"_2856":57821,"_25078":57744,"_17499":96191,"_5":17394,"_23735":95999,"_2383":41230},[],{"_2856":57822,"_25078":57744,"_17499":96193,"_5":17394,"_23735":95999,"_2383":96194},[],"detección automática",{"_2856":57823,"_25078":57744,"_17499":96196,"_5":17394,"_23735":95999,"_2383":96197},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2856":57824,"_25078":57744,"_17499":96199,"_5":17394,"_23735":95999,"_2383":41238},[],{"_2856":57825,"_25078":57744,"_17499":96201,"_5":17394,"_23735":95999,"_2383":5346},[],{"_2856":57826,"_25078":57744,"_17499":96203,"_5":17394,"_23735":95999,"_2383":96204},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2856":57827,"_25078":57744,"_17499":96206,"_5":17394,"_23735":95999,"_2383":41246},[],{"_2856":57828,"_25078":57744,"_17499":96208,"_5":17394,"_23735":95999,"_2383":5346},[],{"_2856":57829,"_25078":57744,"_17499":96210,"_5":17394,"_23735":95999,"_2383":96211},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2856":57830,"_25078":57744,"_17499":96213,"_5":17394,"_23735":95999,"_2383":41254},[],{"_2856":57831,"_25078":57744,"_17499":96215,"_5":17394,"_23735":95999,"_2383":5346},[],{"_2856":57832,"_25078":57744,"_17499":96217,"_5":17394,"_23735":95999,"_2383":96218},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2856":57833,"_25078":57744,"_17499":96220,"_5":17394,"_23735":95999,"_2383":41262},[],{"_2856":57834,"_25078":57744,"_17499":96222,"_5":17394,"_23735":95999,"_2383":41265},[],{"_2856":57835,"_25078":57744,"_17499":96224,"_5":17394,"_23735":95999,"_2383":96225},[],"Usa otro chart local de SoftHSM",{"_2856":57836,"_25078":57744,"_17499":96227,"_5":17394,"_23735":95999,"_2383":96228},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2856":57837,"_25078":57744,"_17499":96230,"_5":17394,"_23735":96003,"_2383":41274},[],{"_2856":57838,"_25078":57744,"_17499":96232,"_5":17394,"_23735":96003,"_2383":96233},[],"valida las herramientas locales y el clúster seleccionado",{"_2856":57839,"_25078":57744,"_17499":96235,"_5":17394,"_23735":96003,"_2383":96236},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2856":57840,"_25078":57744,"_17499":96238,"_5":17394,"_23735":96003,"_2383":96239},[],"crea el namespace",{"_2856":57841,"_25078":57744,"_17499":96241,"_5":17394,"_23735":96003,"_2383":96242},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2856":57842,"_25078":57744,"_17499":96244,"_5":17394,"_23735":96003,"_2383":96245},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2856":57843,"_25078":57744,"_17499":96247,"_5":17394,"_23735":96003,"_2383":96248},[],"instala RabbitMQ",{"_2856":57844,"_25078":57744,"_17499":96250,"_5":17394,"_23735":96003,"_2383":96251},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2856":57845,"_25078":57744,"_17499":96253,"_5":17394,"_23735":96003,"_2383":96254},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2856":57846,"_25078":57744,"_17499":96256,"_5":17394,"_23735":96003,"_2383":96257},[],"carga datos de ejemplo opcionalmente",{"_2856":57847,"_25078":57744,"_17499":96259,"_5":17394,"_23735":96003,"_2383":96260},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2856":57848,"_25078":57744,"_17499":96262,"_5":17394,"_23735":96007,"_2383":96263},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2856":57849,"_25078":57744,"_17499":96265,"_5":17394,"_23735":96007,"_2383":96266},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2856":57850,"_25078":57744,"_17499":96268,"_5":17394,"_23735":96011,"_2383":96269},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2856":57851,"_25078":57744,"_17499":96271,"_5":17394,"_23735":96011,"_2383":96272},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2856":57852,"_25078":57744,"_17499":96274,"_5":17394,"_23735":96011,"_2383":96275},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2856":57853,"_25078":57744,"_17499":96277,"_5":17394,"_23735":96015,"_2383":96278},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2856":57854,"_25078":57854,"_5":12261,"_2383":96280,"_25413":96281,"_17499":96282,"_23735":57854},"Instala con Helm",[40749,95738,95972],[],{"_2856":57855,"_25078":57854,"_17499":96284,"_5":17394,"_23735":57854,"_2383":96285},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2856":57856,"_25078":57854,"_5":25410,"_17499":96287,"_23735":96288,"_2383":96289},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2856":57857,"_25078":57854,"_5":25410,"_17499":96291,"_23735":96292,"_2383":95988},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2856":57858,"_25078":57854,"_5":25410,"_17499":96294,"_23735":96295,"_2383":96296},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2856":57859,"_25078":57854,"_5":25410,"_17499":96298,"_23735":96299,"_2383":96300},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2856":57860,"_25078":57854,"_5":25410,"_17499":96302,"_23735":96303,"_2383":96304},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2856":57861,"_25078":57854,"_5":25410,"_17499":96306,"_23735":96307,"_2383":96308},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2856":57862,"_25078":57854,"_5":25410,"_17499":96310,"_23735":96311,"_2383":96312},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2856":57863,"_25078":57854,"_5":25410,"_17499":96314,"_23735":96315,"_2383":96316},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2856":57864,"_25078":57854,"_5":25410,"_17499":96318,"_23735":96319,"_2383":96320},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2856":57865,"_25078":57854,"_17499":96322,"_5":17394,"_23735":96288,"_2383":96323},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2856":57866,"_25078":57854,"_17499":96325,"_5":17394,"_23735":96292,"_2383":96326},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2856":57867,"_25078":57854,"_17499":96328,"_5":17394,"_23735":96292,"_2383":96329},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2856":57868,"_25078":57854,"_17499":96331,"_5":17394,"_23735":96292,"_2383":96332},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2856":57869,"_25078":57854,"_17499":96334,"_5":17394,"_23735":96292,"_2383":96335},[],"un broker RabbitMQ accesible y sus credenciales",{"_2856":57870,"_25078":57854,"_17499":96337,"_5":17394,"_23735":96292,"_2383":96338},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2856":57871,"_25078":57854,"_17499":96340,"_5":17394,"_23735":96292,"_2383":96341},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2856":57872,"_25078":57854,"_17499":96343,"_5":17394,"_23735":96292,"_2383":96344},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2856":57873,"_25078":57854,"_17499":96346,"_5":17394,"_23735":96292,"_2383":96347},[],"una StorageClass y un diseño de tráfico externo",{"_2856":57874,"_25078":57854,"_17499":96349,"_5":17394,"_23735":96292,"_2383":96350},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2856":57875,"_25078":57854,"_17499":96352,"_5":17394,"_23735":96292,"_2383":96353},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2856":57876,"_25078":57854,"_17499":96355,"_5":17394,"_23735":96292,"_2383":96356},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2856":57877,"_25078":57854,"_17499":96358,"_5":17394,"_23735":96295,"_2383":96359},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2856":57878,"_25078":57854,"_17499":96361,"_5":17394,"_23735":96295,"_2383":96362},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2856":57879,"_25078":57854,"_17499":96364,"_5":17394,"_23735":96295,"_2383":96365},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2856":57880,"_25078":57854,"_17499":96367,"_5":17394,"_23735":96299,"_2383":96368},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2856":57881,"_25078":57854,"_17499":96370,"_5":17394,"_23735":96299,"_2383":96371},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2856":57882,"_25078":57854,"_17499":96373,"_5":17394,"_23735":96299,"_2383":96374},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2856":57883,"_25078":57854,"_17499":96376,"_5":17394,"_23735":96303,"_2383":96377},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2856":57884,"_25078":57854,"_17499":96379,"_5":17394,"_23735":96307,"_2383":96380},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2856":57885,"_25078":57854,"_17499":96382,"_5":17394,"_23735":96307,"_2383":96383},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2856":57886,"_25078":57854,"_17499":96385,"_5":17394,"_23735":96307,"_2383":96386},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2856":57887,"_25078":57854,"_17499":96388,"_5":17394,"_23735":96307,"_2383":96389},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2856":57888,"_25078":57854,"_17499":96391,"_5":17394,"_23735":96311,"_2383":96392},[],"Para instalar un checkout local:",{"_2856":57889,"_25078":57854,"_17499":96394,"_5":17394,"_23735":96315,"_2383":96395},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2856":57890,"_25078":57854,"_17499":96397,"_5":17394,"_23735":96315,"_2383":96398},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2856":57891,"_25078":57854,"_17499":96400,"_5":17394,"_23735":96319,"_2383":96401},[],"Antes de pasar a producción, revisa:",{"_2856":57892,"_25078":57854,"_17499":96403,"_5":17394,"_23735":96319,"_2383":96404},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2856":57893,"_25078":57854,"_17499":96406,"_5":17394,"_23735":96319,"_2383":96407},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2856":57894,"_25078":57854,"_17499":96409,"_5":17394,"_23735":96319,"_2383":96410},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2856":57895,"_25078":57854,"_17499":96412,"_5":17394,"_23735":96319,"_2383":96413},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2856":57896,"_25078":57854,"_17499":96415,"_5":17394,"_23735":96319,"_2383":96416},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2856":57897,"_25078":57854,"_17499":96418,"_5":17394,"_23735":96319,"_2383":96419},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2856":57898,"_25078":57854,"_17499":96421,"_5":17394,"_23735":96319,"_2383":96422},[],"SMTP, observabilidad y entrega de alertas",{"_2856":57899,"_25078":57854,"_17499":96424,"_5":17394,"_23735":96319,"_2383":96425},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2856":57900,"_25078":57854,"_17499":96427,"_5":17394,"_23735":96319,"_2383":96428},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2856":57901,"_25078":57901,"_5":12261,"_2383":96430,"_25413":96431,"_17499":96432,"_23735":57901},"Expón el Gateway",[40749,95738,95972],[],{"_2856":57902,"_25078":57901,"_17499":96434,"_5":17394,"_23735":57901,"_2383":96435},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2856":57903,"_25078":57901,"_5":25410,"_17499":96437,"_23735":96438,"_2383":96439},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2856":57904,"_25078":57901,"_5":25410,"_17499":96441,"_23735":96442,"_2383":96443},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2856":57905,"_25078":57901,"_5":25410,"_17499":96445,"_23735":96446,"_2383":96447},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2856":57906,"_25078":57901,"_5":25410,"_17499":96449,"_23735":96450,"_2383":41495},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#k3s",{"_2856":57907,"_25078":57901,"_5":25410,"_17499":96452,"_23735":96453,"_2383":96454},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2856":57908,"_25078":57901,"_5":25410,"_17499":96456,"_23735":96457,"_2383":96458},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2856":57909,"_25078":57901,"_5":25410,"_17499":96460,"_23735":96461,"_2383":96462},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2856":57910,"_25078":57901,"_5":25410,"_17499":96464,"_23735":96465,"_2383":96466},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2856":57911,"_25078":57901,"_5":25410,"_17499":96468,"_23735":96469,"_2383":96470},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2856":57912,"_25078":57901,"_17499":96472,"_5":17394,"_23735":96438,"_2383":96473},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2856":57913,"_25078":57901,"_17499":96475,"_5":17394,"_23735":96438,"_2383":96476},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2856":57914,"_25078":57901,"_17499":96478,"_5":17394,"_23735":96442,"_2383":96479},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2856":57915,"_25078":57901,"_17499":96481,"_5":17394,"_23735":96442,"_2383":96482},[],"Defínelo únicamente cuando:",{"_2856":57916,"_25078":57901,"_17499":96484,"_5":17394,"_23735":96442,"_2383":96485},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2856":57917,"_25078":57901,"_17499":96487,"_5":17394,"_23735":96442,"_2383":96488},[],"esa dirección está asignada a este Gateway",{"_2856":57918,"_25078":57901,"_17499":96490,"_5":17394,"_23735":96442,"_2383":96491},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2856":57919,"_25078":57901,"_17499":96493,"_5":17394,"_23735":96442,"_2383":96494},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2856":57920,"_25078":57901,"_17499":96496,"_5":17394,"_23735":96442,"_2383":96497},[],"No confundas estos valores:",{"_2856":57921,"_25078":57901,"_17499":96499,"_5":17394,"_23735":96442,"_2383":96500},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2856":57922,"_25078":57901,"_17499":96502,"_5":17394,"_23735":96442,"_2383":96503},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2856":57923,"_25078":57901,"_17499":96505,"_5":17394,"_23735":96442,"_2383":96506},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2856":57924,"_25078":57901,"_17499":96508,"_5":17394,"_23735":96446,"_2383":96509},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2856":57925,"_25078":57901,"_17499":96511,"_5":17394,"_23735":96446,"_2383":96512},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2856":57926,"_25078":57901,"_17499":96514,"_5":17394,"_23735":96450,"_2383":96515},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2856":57927,"_25078":57901,"_17499":96517,"_5":17394,"_23735":96450,"_2383":96518},[],"Para el diseño recomendado:",{"_2856":57928,"_25078":57901,"_17499":96520,"_5":17394,"_23735":96450,"_2383":96521},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2856":57929,"_25078":57901,"_17499":96523,"_5":17394,"_23735":96450,"_2383":96524},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2856":57930,"_25078":57901,"_17499":96526,"_5":17394,"_23735":96450,"_2383":96527},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2856":57931,"_25078":57901,"_17499":96529,"_5":17394,"_23735":96450,"_2383":96530},[],"Apunta DNS a la dirección accesible de la VM.",{"_2856":57932,"_25078":57901,"_17499":96532,"_5":17394,"_23735":96450,"_2383":96533},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2856":57933,"_25078":57901,"_17499":96535,"_5":17394,"_23735":96453,"_2383":96536},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2856":57934,"_25078":57901,"_17499":96538,"_5":17394,"_23735":96457,"_2383":96539},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2856":57935,"_25078":57901,"_17499":96541,"_5":17394,"_23735":96457,"_2383":96542},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2856":57936,"_25078":57901,"_17499":96544,"_5":17394,"_23735":96461,"_2383":96545},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2856":57937,"_25078":57901,"_17499":96547,"_5":17394,"_23735":96461,"_2383":96548},[],"Requisito",{"_2856":57938,"_25078":57901,"_17499":96550,"_5":17394,"_23735":96461,"_2383":96551},[],"Diseño recomendado",{"_2856":57939,"_25078":57901,"_17499":96553,"_5":17394,"_23735":96461,"_2383":96554},[],"Consecuencia",{"_2856":57940,"_25078":57901,"_17499":96556,"_5":17394,"_23735":96461,"_2383":96557},[],"Varias URL o servicios de Lamassu",{"_2856":57941,"_25078":57901,"_17499":96559,"_5":17394,"_23735":96461,"_2383":96560},[],"Un Gateway con varias rutas",{"_2856":57942,"_25078":57901,"_17499":96562,"_5":17394,"_23735":96461,"_2383":96563},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2856":57943,"_25078":57901,"_17499":96565,"_5":17394,"_23735":96461,"_2383":96566},[],"Gateways independientes e IP externas distintas",{"_2856":57944,"_25078":57901,"_17499":96568,"_5":17394,"_23735":96461,"_2383":96569},[],"Una VIP por Gateway",{"_2856":57945,"_25078":57901,"_17499":96571,"_5":17394,"_23735":96461,"_2383":96572},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2856":57946,"_25078":57901,"_17499":96574,"_5":17394,"_23735":96461,"_2383":96575},[],"Gateways independientes, un nodo y una IP",{"_2856":57947,"_25078":57901,"_17499":96577,"_5":17394,"_23735":96461,"_2383":96578},[],"Puertos externos diferentes",{"_2856":57948,"_25078":57901,"_17499":96580,"_5":17394,"_23735":96461,"_2383":96581},[],"Los clientes deben indicar puertos no estándar",{"_2856":57949,"_25078":57901,"_17499":96583,"_5":17394,"_23735":96461,"_2383":96584},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2856":57950,"_25078":57901,"_17499":96586,"_5":17394,"_23735":96461,"_2383":96587},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2856":57951,"_25078":57901,"_17499":96589,"_5":17394,"_23735":96461,"_2383":96590},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2856":57952,"_25078":57901,"_17499":96592,"_5":17394,"_23735":96461,"_2383":96593},[],"Recursos Gateway separados pero proxy compartido",{"_2856":57953,"_25078":57901,"_17499":96595,"_5":17394,"_23735":96461,"_2383":96596},[],"Modo merged Gateway de Envoy",{"_2856":57954,"_25078":57901,"_17499":96598,"_5":17394,"_23735":96461,"_2383":96599},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2856":57955,"_25078":57901,"_17499":96601,"_5":17394,"_23735":96461,"_2383":96602},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2856":57956,"_25078":57901,"_17499":96604,"_5":17394,"_23735":96461,"_2383":96605},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2856":57957,"_25078":57901,"_17499":96607,"_5":17394,"_23735":96461,"_2383":96608},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2856":57958,"_25078":57901,"_17499":96610,"_5":17394,"_23735":96461,"_2383":96611},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2856":57959,"_25078":57901,"_17499":96613,"_5":17394,"_23735":96465,"_2383":96614},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2856":57960,"_25078":57901,"_17499":96616,"_5":17394,"_23735":96465,"_2383":96617},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2856":57961,"_25078":57901,"_17499":96619,"_5":17394,"_23735":96465,"_2383":96620},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2856":57962,"_25078":57901,"_17499":96622,"_5":17394,"_23735":96465,"_2383":96623},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2856":57963,"_25078":57901,"_17499":96625,"_5":17394,"_23735":96465,"_2383":96626},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2856":57964,"_25078":57901,"_17499":96628,"_5":17394,"_23735":96469,"_2383":96629},[],"Comprueba, en orden:",{"_2856":57965,"_25078":57901,"_17499":96631,"_5":17394,"_23735":96469,"_2383":96632},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2856":57966,"_25078":57901,"_17499":96634,"_5":17394,"_23735":96469,"_2383":96635},[],"Su estado contiene la dirección esperada.",{"_2856":57967,"_25078":57901,"_17499":96637,"_5":17394,"_23735":96469,"_2383":96638},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2856":57968,"_25078":57901,"_17499":96640,"_5":17394,"_23735":96469,"_2383":96641},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2856":57969,"_25078":57901,"_17499":96643,"_5":17394,"_23735":96469,"_2383":96644},[],"DNS resuelve al endpoint accesible externamente.",{"_2856":57970,"_25078":57901,"_17499":96646,"_5":17394,"_23735":96469,"_2383":96647},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2856":57971,"_25078":57901,"_17499":96649,"_5":17394,"_23735":96469,"_2383":96650},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2856":57972,"_25078":57972,"_5":12261,"_2383":40856,"_25413":96652,"_17499":96653,"_23735":57972},[40749,95738,95972],[],{"_2856":57973,"_25078":57972,"_17499":96655,"_5":17394,"_23735":57972,"_2383":96656},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2856":57974,"_25078":57972,"_5":25410,"_17499":96658,"_23735":96659,"_2383":96660},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2856":57975,"_25078":57972,"_5":25410,"_17499":96662,"_23735":96663,"_2383":96664},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2856":57976,"_25078":57972,"_5":25410,"_17499":96666,"_23735":96667,"_2383":96668},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2856":57977,"_25078":57972,"_5":25410,"_17499":96670,"_23735":96671,"_2383":96672},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2856":57978,"_25078":57972,"_5":25410,"_17499":96674,"_23735":96675,"_2383":96676},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2856":57979,"_25078":57972,"_5":25410,"_17499":96678,"_23735":96679,"_2383":96680},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2856":57980,"_25078":57972,"_17499":96682,"_5":17394,"_23735":96659,"_2383":96683},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2856":57981,"_25078":57972,"_17499":96685,"_5":17394,"_23735":96663,"_2383":96686},[],"Flujo",{"_2856":57982,"_25078":57972,"_17499":96688,"_5":17394,"_23735":96663,"_2383":96689},[],"Úsalo para",{"_2856":57983,"_25078":57972,"_17499":96691,"_5":17394,"_23735":96663,"_2383":96692},[],"Qué instala",{"_2856":57984,"_25078":57972,"_17499":96694,"_5":17394,"_23735":96663,"_2383":41740},[],{"_2856":57985,"_25078":57972,"_17499":96696,"_5":17394,"_23735":96663,"_2383":96697},[],"Producción y entornos controlados",{"_2856":57986,"_25078":57972,"_17499":96699,"_5":17394,"_23735":96663,"_2383":96700},[],"Servicios de Lamassu y recursos de Gateway API",{"_2856":57987,"_25078":57972,"_17499":96702,"_5":17394,"_23735":96663,"_2383":40993},[],{"_2856":57988,"_25078":57972,"_17499":96704,"_5":17394,"_23735":96663,"_2383":96705},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2856":57989,"_25078":57972,"_17499":96707,"_5":17394,"_23735":96663,"_2383":96708},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2856":57990,"_25078":57972,"_17499":96710,"_5":17394,"_23735":96667,"_2383":96711},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2856":57991,"_25078":57972,"_17499":96713,"_5":17394,"_23735":96667,"_2383":96714},[],"Área",{"_2856":57992,"_25078":57972,"_17499":96716,"_5":17394,"_23735":96667,"_2383":96717},[],"El chart de Lamassu proporciona",{"_2856":57993,"_25078":57972,"_17499":96719,"_5":17394,"_23735":96667,"_2383":96720},[],"Tú proporcionas",{"_2856":57994,"_25078":57972,"_17499":96722,"_5":17394,"_23735":96667,"_2383":96723},[],"Aplicaciones Lamassu",{"_2856":57995,"_25078":57972,"_17499":96725,"_5":17394,"_23735":96667,"_2383":96726},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2856":57996,"_25078":57972,"_17499":96728,"_5":17394,"_23735":96667,"_2383":96729},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2856":57997,"_25078":57972,"_17499":96731,"_5":17394,"_23735":96667,"_2383":96732},[],"Datos PostgreSQL",{"_2856":57998,"_25078":57972,"_17499":96734,"_5":17394,"_23735":96667,"_2383":96735},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2856":57999,"_25078":57972,"_17499":96737,"_5":17394,"_23735":96667,"_2383":96738},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2856":58000,"_25078":57972,"_17499":96740,"_5":17394,"_23735":96667,"_2383":96741},[],"Mensajería",{"_2856":58001,"_25078":57972,"_17499":96743,"_5":17394,"_23735":96667,"_2383":96744},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2856":58002,"_25078":57972,"_17499":96746,"_5":17394,"_23735":96667,"_2383":96747},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2856":58003,"_25078":57972,"_17499":96749,"_5":17394,"_23735":96667,"_2383":96750},[],"Identidad",{"_2856":58004,"_25078":57972,"_17499":96752,"_5":17394,"_23735":96667,"_2383":96753},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2856":58005,"_25078":57972,"_17499":96755,"_5":17394,"_23735":96667,"_2383":96756},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2856":58006,"_25078":57972,"_17499":96758,"_5":17394,"_23735":96667,"_2383":96759},[],"Enrutamiento externo",{"_2856":58007,"_25078":57972,"_17499":96761,"_5":17394,"_23735":96667,"_2383":96762},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2856":58008,"_25078":57972,"_17499":96764,"_5":17394,"_23735":96667,"_2383":96765},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2856":58009,"_25078":57972,"_17499":96767,"_5":17394,"_23735":96667,"_2383":41814},[],{"_2856":58010,"_25078":57972,"_17499":96769,"_5":17394,"_23735":96667,"_2383":96770},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2856":58011,"_25078":57972,"_17499":96772,"_5":17394,"_23735":96667,"_2383":96773},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2856":58012,"_25078":57972,"_17499":96775,"_5":17394,"_23735":96667,"_2383":96776},[],"Datos persistentes de la aplicación",{"_2856":58013,"_25078":57972,"_17499":96778,"_5":17394,"_23735":96667,"_2383":96779},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2856":58014,"_25078":57972,"_17499":96781,"_5":17394,"_23735":96667,"_2383":96782},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2856":58015,"_25078":57972,"_17499":96784,"_5":17394,"_23735":96667,"_2383":96785},[],"Integraciones opcionales",{"_2856":58016,"_25078":57972,"_17499":96787,"_5":17394,"_23735":96667,"_2383":96788},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2856":58017,"_25078":57972,"_17499":96790,"_5":17394,"_23735":96667,"_2383":96791},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2856":58018,"_25078":57972,"_17499":96793,"_5":17394,"_23735":96667,"_2383":96794},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2856":58019,"_25078":57972,"_17499":96796,"_5":17394,"_23735":96667,"_2383":96797},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2856":58020,"_25078":57972,"_17499":96799,"_5":17394,"_23735":96671,"_2383":96800},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2856":58021,"_25078":57972,"_17499":96802,"_5":17394,"_23735":96671,"_2383":96803},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2856":58022,"_25078":57972,"_17499":96805,"_5":17394,"_23735":96675,"_2383":96806},[],"Kubernetes 1.24 o posterior",{"_2856":58023,"_25078":57972,"_17499":96808,"_5":17394,"_23735":96675,"_2383":96809},[],"Helm 3.2 o posterior",{"_2856":58024,"_25078":57972,"_17499":96811,"_5":17394,"_23735":96675,"_2383":96812},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2856":58025,"_25078":57972,"_17499":96814,"_5":17394,"_23735":96675,"_2383":96815},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2856":58026,"_25078":57972,"_17499":96817,"_5":17394,"_23735":96675,"_2383":96818},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2856":58027,"_25078":57972,"_17499":96820,"_5":17394,"_23735":96675,"_2383":96821},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2856":58028,"_25078":57972,"_17499":96823,"_5":17394,"_23735":96675,"_2383":96824},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2856":58029,"_25078":57972,"_17499":96826,"_5":17394,"_23735":96679,"_2383":96827},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2856":58030,"_25078":57972,"_17499":96829,"_5":17394,"_23735":96679,"_2383":96830},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2856":58031,"_25078":57972,"_17499":96832,"_5":17394,"_23735":96679,"_2383":96833},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2856":58032,"_25078":58032,"_5":12261,"_2383":96835,"_25413":96836,"_17499":96838,"_23735":58032},"Resolución de problemas de despliegue",[40749,95738,96837],"Operación",[],{"_2856":58033,"_25078":58032,"_17499":96840,"_5":17394,"_23735":58032,"_2383":96841},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2856":58034,"_25078":58032,"_5":25410,"_17499":96843,"_23735":96844,"_2383":96845},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2856":58035,"_25078":58032,"_5":25410,"_17499":96847,"_23735":96848,"_2383":96849},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2856":58036,"_25078":58032,"_5":25410,"_17499":96851,"_23735":96852,"_2383":96853},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2856":58037,"_25078":58032,"_5":25410,"_17499":96855,"_23735":96856,"_2383":96857},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2856":58038,"_25078":58032,"_5":25410,"_17499":96859,"_23735":96860,"_2383":96861},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2856":58039,"_25078":58032,"_5":25410,"_17499":96863,"_23735":96864,"_2383":96865},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2856":58040,"_25078":58032,"_5":25410,"_17499":96867,"_23735":96868,"_2383":96869},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2856":58041,"_25078":58032,"_5":25410,"_17499":96871,"_23735":96872,"_2383":96873},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2856":58042,"_25078":58032,"_5":25410,"_17499":96875,"_23735":96876,"_2383":96877},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2856":58043,"_25078":58032,"_5":25410,"_17499":96879,"_23735":96880,"_2383":96881},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2856":58044,"_25078":58032,"_5":25410,"_17499":96883,"_23735":96884,"_2383":96885},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2856":58045,"_25078":58032,"_5":25410,"_17499":96887,"_23735":96888,"_2383":96889},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2856":58046,"_25078":58032,"_17499":96891,"_5":17394,"_23735":58032,"_2383":96892},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2856":58047,"_25078":58032,"_17499":96894,"_5":17394,"_23735":96848,"_2383":96895},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2856":58048,"_25078":58032,"_17499":96897,"_5":17394,"_23735":96852,"_2383":96898},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2856":58049,"_25078":58032,"_17499":96900,"_5":17394,"_23735":96856,"_2383":96901},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2856":58050,"_25078":58032,"_17499":96903,"_5":17394,"_23735":96860,"_2383":96904},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2856":58051,"_25078":58032,"_17499":96906,"_5":17394,"_23735":96864,"_2383":96907},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2856":58052,"_25078":58032,"_17499":96909,"_5":17394,"_23735":96868,"_2383":96910},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2856":58053,"_25078":58032,"_17499":96912,"_5":17394,"_23735":96868,"_2383":96913},[],"Ejecuta también la prueba de conectividad del chart:",{"_2856":58054,"_25078":58032,"_17499":96915,"_5":17394,"_23735":96868,"_2383":96916},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2856":58055,"_25078":58032,"_17499":96918,"_5":17394,"_23735":96868,"_2383":96919},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2856":58056,"_25078":58032,"_17499":96921,"_5":17394,"_23735":96872,"_2383":96922},[],"Si recibes un 401:",{"_2856":58057,"_25078":58032,"_17499":96924,"_5":17394,"_23735":96872,"_2383":96925},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2856":58058,"_25078":58032,"_17499":96927,"_5":17394,"_23735":96872,"_2383":96928},[],"verifica emisor, audiencia y expiración del token;",{"_2856":58059,"_25078":58032,"_17499":96930,"_5":17394,"_23735":96872,"_2383":96931},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2856":58060,"_25078":58032,"_17499":96933,"_5":17394,"_23735":96872,"_2383":96934},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2856":58061,"_25078":58032,"_17499":96936,"_5":17394,"_23735":96872,"_2383":96937},[],"Si el login termina pero las APIs devuelven 403:",{"_2856":58062,"_25078":58032,"_17499":96939,"_5":17394,"_23735":96872,"_2383":96940},[],"inspecciona los claims reales del token;",{"_2856":58063,"_25078":58032,"_17499":96942,"_5":17394,"_23735":96872,"_2383":96943},[],"confirma que coinciden con un principal activo;",{"_2856":58064,"_25078":58032,"_17499":96945,"_5":17394,"_23735":96872,"_2383":96946},[],"revisa las políticas concedidas al principal;",{"_2856":58065,"_25078":58032,"_17499":96948,"_5":17394,"_23735":96872,"_2383":96949},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2856":58066,"_25078":58032,"_17499":96951,"_5":17394,"_23735":96872,"_2383":96952},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2856":58067,"_25078":58032,"_17499":96954,"_5":17394,"_23735":96876,"_2383":96955},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2856":58068,"_25078":58032,"_17499":96957,"_5":17394,"_23735":96876,"_2383":96958},[],"Localiza el pod y Service de authz.",{"_2856":58069,"_25078":58032,"_17499":96960,"_5":17394,"_23735":96876,"_2383":96961},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2856":58070,"_25078":58032,"_17499":96963,"_5":17394,"_23735":96876,"_2383":96964},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2856":58071,"_25078":58032,"_17499":96966,"_5":17394,"_23735":96876,"_2383":96967},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2856":58072,"_25078":58032,"_17499":96969,"_5":17394,"_23735":96876,"_2383":96970},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2856":58073,"_25078":58032,"_17499":96972,"_5":17394,"_23735":96880,"_2383":96973},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2856":58074,"_25078":58032,"_17499":96975,"_5":17394,"_23735":96880,"_2383":96976},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2856":58075,"_25078":58032,"_17499":96978,"_5":17394,"_23735":96880,"_2383":96979},[],"volumen persistente sin enlazar;",{"_2856":58076,"_25078":58032,"_17499":96981,"_5":17394,"_23735":96880,"_2383":96982},[],"imagen inaccesible o política de pull incorrecta;",{"_2856":58077,"_25078":58032,"_17499":96984,"_5":17394,"_23735":96880,"_2383":96985},[],"configuración inválida del motor criptográfico;",{"_2856":58078,"_25078":58032,"_17499":96987,"_5":17394,"_23735":96880,"_2383":96988},[],"límites de CPU o memoria demasiado bajos;",{"_2856":58079,"_25078":58032,"_17499":96990,"_5":17394,"_23735":96880,"_2383":96991},[],"migración previa incompleta.",{"_2856":58080,"_25078":58032,"_17499":96993,"_5":17394,"_23735":96880,"_2383":96994},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2856":58081,"_25078":58032,"_17499":96996,"_5":17394,"_23735":96880,"_2383":96997},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2856":58082,"_25078":58032,"_17499":96999,"_5":17394,"_23735":96884,"_2383":97000},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2856":58083,"_25078":58032,"_17499":97002,"_5":17394,"_23735":96884,"_2383":97003},[],"verifica que esté habilitado en el servicio emisor;",{"_2856":58084,"_25078":58032,"_17499":97005,"_5":17394,"_23735":96884,"_2383":97006},[],"comprueba conectividad y credenciales AMQP;",{"_2856":58085,"_25078":58032,"_17499":97008,"_5":17394,"_23735":96884,"_2383":97009},[],"revisa exchange, routing key, colas y consumidores;",{"_2856":58086,"_25078":58032,"_17499":97011,"_5":17394,"_23735":96884,"_2383":97012},[],"inspecciona dead-letter queues;",{"_2856":58087,"_25078":58032,"_17499":97014,"_5":17394,"_23735":96884,"_2383":97015},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2856":58088,"_25078":58032,"_17499":97017,"_5":17394,"_23735":96884,"_2383":97018},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2856":58089,"_25078":58032,"_17499":97020,"_5":17394,"_23735":96888,"_2383":97021},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2856":58090,"_25078":58032,"_17499":97023,"_5":17394,"_23735":96888,"_2383":97024},[],"Antes de cerrar una incidencia, guarda:",{"_2856":58091,"_25078":58032,"_17499":97026,"_5":17394,"_23735":96888,"_2383":97027},[],"causa confirmada;",{"_2856":58092,"_25078":58032,"_17499":97029,"_5":17394,"_23735":96888,"_2383":97030},[],"alcance temporal y recursos afectados;",{"_2856":58093,"_25078":58032,"_17499":97032,"_5":17394,"_23735":96888,"_2383":97033},[],"comandos o consultas utilizados;",{"_2856":58094,"_25078":58032,"_17499":97035,"_5":17394,"_23735":96888,"_2383":97036},[],"cambio aplicado y forma de revertirlo;",{"_2856":58095,"_25078":58032,"_17499":97038,"_5":17394,"_23735":96888,"_2383":97039},[],"validación desde un consumidor;",{"_2856":58096,"_25078":58032,"_17499":97041,"_5":17394,"_23735":96888,"_2383":97042},[],"acción preventiva y propietario.",{"_2856":58097,"_25078":58097,"_5":12261,"_2383":97044,"_25413":97045,"_17499":97048,"_23735":58097},"Control de acceso",[40749,97046,97047],"Plataforma","Administración",[],{"_2856":58098,"_25078":58097,"_17499":97050,"_5":17394,"_23735":58097,"_2383":97051},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2856":58099,"_25078":58097,"_5":25410,"_17499":97053,"_23735":97054,"_2383":97055},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2856":58100,"_25078":58097,"_5":25410,"_17499":97057,"_23735":97058,"_2383":97059},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2856":58101,"_25078":58097,"_5":25410,"_17499":97061,"_23735":97062,"_2383":97063},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2856":58102,"_25078":58097,"_5":25410,"_17499":97065,"_23735":97066,"_2383":97067},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2856":58103,"_25078":58097,"_5":25410,"_17499":97069,"_23735":97070,"_2383":97071},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2856":58104,"_25078":58097,"_5":25410,"_17499":97073,"_23735":97074,"_2383":97075},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2856":58105,"_25078":58097,"_5":25410,"_17499":97077,"_23735":97078,"_2383":97079},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2856":58106,"_25078":58097,"_5":25410,"_17499":97081,"_23735":97082,"_2383":97083},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2856":58107,"_25078":58097,"_5":25410,"_17499":97085,"_23735":97086,"_2383":97087},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2856":58108,"_25078":58097,"_5":25410,"_17499":97089,"_23735":97090,"_2383":97091},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2856":58109,"_25078":58097,"_5":25410,"_17499":97093,"_23735":97094,"_2383":97095},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2856":58110,"_25078":58097,"_5":25410,"_17499":97097,"_23735":97098,"_2383":97099},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2856":58111,"_25078":58097,"_5":25410,"_17499":97101,"_23735":97102,"_2383":97103},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2856":58112,"_25078":58097,"_5":25410,"_17499":97105,"_23735":97106,"_2383":97107},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2856":58113,"_25078":58097,"_5":25410,"_17499":97109,"_23735":97110,"_2383":97111},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2856":58114,"_25078":58097,"_5":25410,"_17499":97113,"_23735":97114,"_2383":96308},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2856":58115,"_25078":58097,"_5":25410,"_17499":97116,"_23735":97117,"_2383":97118},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2856":58116,"_25078":58097,"_5":25410,"_17499":97120,"_23735":97121,"_2383":97122},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2856":58117,"_25078":58097,"_5":25410,"_17499":97124,"_23735":97125,"_2383":97126},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2856":58118,"_25078":58097,"_5":25410,"_17499":97128,"_23735":97129,"_2383":97130},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2856":58119,"_25078":58097,"_5":25410,"_17499":97132,"_23735":97133,"_2383":97134},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2856":58120,"_25078":58097,"_5":25410,"_17499":97136,"_23735":97137,"_2383":97138},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2856":58121,"_25078":58097,"_5":25410,"_17499":97140,"_23735":97141,"_2383":97142},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2856":58122,"_25078":58097,"_5":25410,"_17499":97144,"_23735":97145,"_2383":97146},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2856":58123,"_25078":58097,"_5":25410,"_17499":97148,"_23735":97149,"_2383":97150},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2856":58124,"_25078":58097,"_5":25410,"_17499":97152,"_23735":97153,"_2383":97154},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2856":58125,"_25078":58097,"_5":25410,"_17499":97156,"_23735":97157,"_2383":97158},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2856":58126,"_25078":58097,"_5":25410,"_17499":97160,"_23735":97161,"_2383":97162},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2856":58127,"_25078":58097,"_5":25410,"_17499":97164,"_23735":97165,"_2383":97166},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2856":58128,"_25078":58097,"_5":25410,"_17499":97168,"_23735":97169,"_2383":97170},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2856":58129,"_25078":58097,"_5":25410,"_17499":97172,"_23735":97173,"_2383":97174},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2856":58130,"_25078":58097,"_17499":97176,"_5":17394,"_23735":58097,"_2383":97177},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2856":58131,"_25078":58097,"_17499":97179,"_5":17394,"_23735":58097,"_2383":97180},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2856":58132,"_25078":58097,"_17499":97182,"_5":17394,"_23735":58097,"_2383":97183},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2856":58133,"_25078":58097,"_17499":97185,"_5":17394,"_23735":97054,"_2383":97186},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2856":58134,"_25078":58097,"_17499":97188,"_5":17394,"_23735":97054,"_2383":97189},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2856":58135,"_25078":58097,"_17499":97191,"_5":17394,"_23735":97054,"_2383":97192},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2856":58136,"_25078":58097,"_17499":97194,"_5":17394,"_23735":97054,"_2383":97195},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2856":58137,"_25078":58097,"_17499":97197,"_5":17394,"_23735":97054,"_2383":97198},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2856":58138,"_25078":58097,"_17499":97200,"_5":17394,"_23735":97054,"_2383":97201},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2856":58139,"_25078":58097,"_17499":97203,"_5":17394,"_23735":97058,"_2383":97204},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2856":58140,"_25078":58097,"_17499":97206,"_5":17394,"_23735":97058,"_2383":97207},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2856":58141,"_25078":58097,"_17499":97209,"_5":17394,"_23735":97062,"_2383":97210},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2856":58142,"_25078":58097,"_17499":97212,"_5":17394,"_23735":97062,"_2383":97213},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2856":58143,"_25078":58097,"_17499":97215,"_5":17394,"_23735":97062,"_2383":97216},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2856":58144,"_25078":58097,"_17499":97218,"_5":17394,"_23735":97062,"_2383":97219},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2856":58145,"_25078":58097,"_17499":97221,"_5":17394,"_23735":97062,"_2383":97222},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2856":58146,"_25078":58097,"_17499":97224,"_5":17394,"_23735":97062,"_2383":97225},[],"Carga por separado las políticas concedidas a cada principal.",{"_2856":58147,"_25078":58097,"_17499":97227,"_5":17394,"_23735":97062,"_2383":97228},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2856":58148,"_25078":58097,"_17499":97230,"_5":17394,"_23735":97062,"_2383":97231},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2856":58149,"_25078":58097,"_17499":97233,"_5":17394,"_23735":97062,"_2383":97234},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2856":58150,"_25078":58097,"_17499":97236,"_5":17394,"_23735":97062,"_2383":97237},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2856":58151,"_25078":58097,"_17499":97239,"_5":17394,"_23735":97062,"_2383":97240},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2856":58152,"_25078":58097,"_17499":97242,"_5":17394,"_23735":97062,"_2383":97243},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2856":58153,"_25078":58097,"_17499":97245,"_5":17394,"_23735":97066,"_2383":97246},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2856":58154,"_25078":58097,"_17499":97248,"_5":17394,"_23735":97066,"_2383":97249},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2856":58155,"_25078":58097,"_17499":97251,"_5":17394,"_23735":97066,"_2383":97252},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2856":58156,"_25078":58097,"_17499":97254,"_5":17394,"_23735":97066,"_2383":97255},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2856":58157,"_25078":58097,"_17499":97257,"_5":17394,"_23735":97066,"_2383":97258},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2856":58158,"_25078":58097,"_17499":97260,"_5":17394,"_23735":97066,"_2383":97261},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2856":58159,"_25078":58097,"_17499":97263,"_5":17394,"_23735":97066,"_2383":97264},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2856":58160,"_25078":58097,"_17499":97266,"_5":17394,"_23735":97066,"_2383":97267},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2856":58161,"_25078":58097,"_17499":97269,"_5":17394,"_23735":97070,"_2383":97270},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2856":58162,"_25078":58097,"_17499":97272,"_5":17394,"_23735":97070,"_2383":97273},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2856":58163,"_25078":58097,"_17499":97275,"_5":17394,"_23735":97070,"_2383":97276},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2856":58164,"_25078":58097,"_17499":97278,"_5":17394,"_23735":97070,"_2383":97279},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2856":58165,"_25078":58097,"_17499":97281,"_5":17394,"_23735":97070,"_2383":97282},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2856":58166,"_25078":58097,"_17499":97284,"_5":17394,"_23735":97070,"_2383":97285},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2856":58167,"_25078":58097,"_17499":97287,"_5":17394,"_23735":97070,"_2383":97288},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2856":58168,"_25078":58097,"_17499":97290,"_5":17394,"_23735":97070,"_2383":97291},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2856":58169,"_25078":58097,"_17499":97293,"_5":17394,"_23735":97070,"_2383":97294},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2856":58170,"_25078":58097,"_17499":97296,"_5":17394,"_23735":97070,"_2383":97297},[],"Las acciones se dividen en dos grupos:",{"_2856":58171,"_25078":58097,"_17499":97299,"_5":17394,"_23735":97070,"_2383":97300},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2856":58172,"_25078":58097,"_17499":97302,"_5":17394,"_23735":97070,"_2383":97303},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2856":58173,"_25078":58097,"_17499":97305,"_5":17394,"_23735":97070,"_2383":97306},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2856":58174,"_25078":58097,"_17499":97308,"_5":17394,"_23735":97074,"_2383":97309},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2856":58175,"_25078":58097,"_17499":97311,"_5":17394,"_23735":97074,"_2383":97312},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2856":58176,"_25078":58097,"_17499":97314,"_5":17394,"_23735":97074,"_2383":97315},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2856":58177,"_25078":58097,"_17499":97317,"_5":17394,"_23735":97078,"_2383":97318},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2856":58178,"_25078":58097,"_17499":97320,"_5":17394,"_23735":97078,"_2383":97321},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2856":58179,"_25078":58097,"_17499":97323,"_5":17394,"_23735":97078,"_2383":97324},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2856":58180,"_25078":58097,"_17499":97326,"_5":17394,"_23735":97078,"_2383":97327},[],"Los operadores implementados son:",{"_2856":58181,"_25078":58097,"_17499":97329,"_5":17394,"_23735":97078,"_2383":97330},[],"`equals`, para igualdad exacta;",{"_2856":58182,"_25078":58097,"_17499":97332,"_5":17394,"_23735":97078,"_2383":97333},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2856":58183,"_25078":58097,"_17499":97335,"_5":17394,"_23735":97078,"_2383":97336},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2856":58184,"_25078":58097,"_17499":97338,"_5":17394,"_23735":97078,"_2383":97339},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2856":58185,"_25078":58097,"_17499":97341,"_5":17394,"_23735":97082,"_2383":97342},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2856":58186,"_25078":58097,"_17499":97344,"_5":17394,"_23735":97082,"_2383":97345},[],"Los modos disponibles son:",{"_2856":58187,"_25078":58097,"_17499":97347,"_5":17394,"_23735":97082,"_2383":97348},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2856":58188,"_25078":58097,"_17499":97350,"_5":17394,"_23735":97082,"_2383":97351},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2856":58189,"_25078":58097,"_17499":97353,"_5":17394,"_23735":97082,"_2383":97354},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2856":58190,"_25078":58097,"_17499":97356,"_5":17394,"_23735":97082,"_2383":97357},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2856":58191,"_25078":58097,"_17499":97359,"_5":17394,"_23735":97082,"_2383":97360},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2856":58192,"_25078":58097,"_17499":97362,"_5":17394,"_23735":97082,"_2383":97363},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2856":58193,"_25078":58097,"_17499":97365,"_5":17394,"_23735":97086,"_2383":97366},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2856":58194,"_25078":58097,"_17499":97368,"_5":17394,"_23735":97086,"_2383":97369},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2856":58195,"_25078":58097,"_17499":97371,"_5":17394,"_23735":97086,"_2383":97372},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2856":58196,"_25078":58097,"_17499":97374,"_5":17394,"_23735":97086,"_2383":97375},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2856":58197,"_25078":58097,"_17499":97377,"_5":17394,"_23735":97094,"_2383":97378},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2856":58198,"_25078":58097,"_17499":97380,"_5":17394,"_23735":97094,"_2383":97381},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2856":58199,"_25078":58097,"_17499":97383,"_5":17394,"_23735":97098,"_2383":97384},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2856":58200,"_25078":58097,"_17499":97386,"_5":17394,"_23735":97098,"_2383":97387},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2856":58201,"_25078":58097,"_17499":97389,"_5":17394,"_23735":97102,"_2383":97390},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2856":58202,"_25078":58097,"_17499":97392,"_5":17394,"_23735":97102,"_2383":97393},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2856":58203,"_25078":58097,"_17499":97395,"_5":17394,"_23735":97102,"_2383":97396},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2856":58204,"_25078":58097,"_17499":97398,"_5":17394,"_23735":97106,"_2383":97399},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2856":58205,"_25078":58097,"_17499":97401,"_5":17394,"_23735":97106,"_2383":97402},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2856":58206,"_25078":58097,"_17499":97404,"_5":17394,"_23735":97106,"_2383":97405},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2856":58207,"_25078":58097,"_17499":97407,"_5":17394,"_23735":97106,"_2383":97408},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2856":58208,"_25078":58097,"_17499":97410,"_5":17394,"_23735":97106,"_2383":97411},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2856":58209,"_25078":58097,"_17499":97413,"_5":17394,"_23735":97106,"_2383":97414},[],"Ten en cuenta que:",{"_2856":58210,"_25078":58097,"_17499":97416,"_5":17394,"_23735":97106,"_2383":97417},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2856":58211,"_25078":58097,"_17499":97419,"_5":17394,"_23735":97106,"_2383":97420},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2856":58212,"_25078":58097,"_17499":97422,"_5":17394,"_23735":97106,"_2383":97423},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2856":58213,"_25078":58097,"_17499":97425,"_5":17394,"_23735":97110,"_2383":97426},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2856":58214,"_25078":58097,"_17499":97428,"_5":17394,"_23735":97110,"_2383":97429},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2856":58215,"_25078":58097,"_17499":97431,"_5":17394,"_23735":97110,"_2383":97432},[],"acceso completo y de solo lectura a KMS;",{"_2856":58216,"_25078":58097,"_17499":97434,"_5":17394,"_23735":97110,"_2383":97435},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2856":58217,"_25078":58097,"_17499":97437,"_5":17394,"_23735":97110,"_2383":97438},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2856":58218,"_25078":58097,"_17499":97440,"_5":17394,"_23735":97110,"_2383":97441},[],"acceso a la interfaz;",{"_2856":58219,"_25078":58097,"_17499":97443,"_5":17394,"_23735":97110,"_2383":97444},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2856":58220,"_25078":58097,"_17499":97446,"_5":17394,"_23735":97110,"_2383":97447},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2856":58221,"_25078":58097,"_17499":97449,"_5":17394,"_23735":97110,"_2383":97450},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2856":58222,"_25078":58097,"_17499":97452,"_5":17394,"_23735":97114,"_2383":97453},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2856":58223,"_25078":58097,"_17499":97455,"_5":17394,"_23735":97114,"_2383":97456},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2856":58224,"_25078":58097,"_17499":97458,"_5":17394,"_23735":97114,"_2383":97459},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2856":58225,"_25078":58097,"_17499":97461,"_5":17394,"_23735":97117,"_2383":97462},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2856":58226,"_25078":58097,"_17499":97464,"_5":17394,"_23735":97121,"_2383":97465},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2856":58227,"_25078":58097,"_17499":97467,"_5":17394,"_23735":97125,"_2383":97468},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2856":58228,"_25078":58097,"_17499":97470,"_5":17394,"_23735":97129,"_2383":97471},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2856":58229,"_25078":58097,"_17499":97473,"_5":17394,"_23735":97133,"_2383":97474},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2856":58230,"_25078":58097,"_17499":97476,"_5":17394,"_23735":97137,"_2383":97477},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2856":58231,"_25078":58097,"_17499":97479,"_5":17394,"_23735":97137,"_2383":97480},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2856":58232,"_25078":58097,"_17499":97482,"_5":17394,"_23735":97141,"_2383":97483},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2856":58233,"_25078":58097,"_17499":97485,"_5":17394,"_23735":97141,"_2383":97486},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2856":58234,"_25078":58097,"_17499":97488,"_5":17394,"_23735":97141,"_2383":97489},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2856":58235,"_25078":58097,"_17499":97491,"_5":17394,"_23735":97141,"_2383":97492},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2856":58236,"_25078":58097,"_17499":97494,"_5":17394,"_23735":97141,"_2383":97495},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2856":58237,"_25078":58097,"_17499":97497,"_5":17394,"_23735":97141,"_2383":97498},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2856":58238,"_25078":58097,"_17499":97500,"_5":17394,"_23735":97141,"_2383":97501},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2856":58239,"_25078":58097,"_17499":97503,"_5":17394,"_23735":97141,"_2383":97504},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2856":58240,"_25078":58097,"_17499":97506,"_5":17394,"_23735":97145,"_2383":97507},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2856":58241,"_25078":58097,"_17499":97509,"_5":17394,"_23735":97145,"_2383":97510},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2856":58242,"_25078":58097,"_17499":97512,"_5":17394,"_23735":97145,"_2383":97513},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2856":58243,"_25078":58097,"_17499":97515,"_5":17394,"_23735":97149,"_2383":97516},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2856":58244,"_25078":58097,"_17499":97518,"_5":17394,"_23735":97149,"_2383":97519},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2856":58245,"_25078":58097,"_17499":97521,"_5":17394,"_23735":97149,"_2383":97522},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2856":58246,"_25078":58097,"_17499":97524,"_5":17394,"_23735":97149,"_2383":97525},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2856":58247,"_25078":58097,"_17499":97527,"_5":17394,"_23735":97149,"_2383":97528},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2856":58248,"_25078":58097,"_17499":97530,"_5":17394,"_23735":97149,"_2383":97531},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2856":58249,"_25078":58097,"_17499":97533,"_5":17394,"_23735":97149,"_2383":97534},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2856":58250,"_25078":58097,"_17499":97536,"_5":17394,"_23735":97149,"_2383":97537},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2856":58251,"_25078":58097,"_17499":97539,"_5":17394,"_23735":97157,"_2383":97540},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2856":58252,"_25078":58097,"_17499":97542,"_5":17394,"_23735":97161,"_2383":97543},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2856":58253,"_25078":58097,"_17499":97545,"_5":17394,"_23735":97161,"_2383":97546},[],"que exista un principal activo del tipo correcto;",{"_2856":58254,"_25078":58097,"_17499":97548,"_5":17394,"_23735":97161,"_2383":97549},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2856":58255,"_25078":58097,"_17499":97551,"_5":17394,"_23735":97161,"_2383":97552},[],"que todas las condiciones del principal se cumplan;",{"_2856":58256,"_25078":58097,"_17499":97554,"_5":17394,"_23735":97161,"_2383":97555},[],"que el principal tenga concedida la política esperada;",{"_2856":58257,"_25078":58097,"_17499":97557,"_5":17394,"_23735":97161,"_2383":97558},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2856":58258,"_25078":58097,"_17499":97560,"_5":17394,"_23735":97161,"_2383":97561},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2856":58259,"_25078":58097,"_17499":97563,"_5":17394,"_23735":97161,"_2383":97564},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2856":58260,"_25078":58097,"_17499":97566,"_5":17394,"_23735":97165,"_2383":97567},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2856":58261,"_25078":58097,"_17499":97569,"_5":17394,"_23735":97169,"_2383":97570},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2856":58262,"_25078":58097,"_17499":97572,"_5":17394,"_23735":97173,"_2383":97573},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2856":58263,"_25078":58097,"_17499":97575,"_5":17394,"_23735":97173,"_2383":97576},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2856":58264,"_25078":58264,"_5":12261,"_2383":97578,"_25413":97579,"_17499":97580,"_23735":58264},"Alertas y suscripciones",[40749,97046,97047],[],{"_2856":58265,"_25078":58264,"_17499":97582,"_5":17394,"_23735":58264,"_2383":97583},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2856":58266,"_25078":58264,"_5":25410,"_17499":97585,"_23735":97586,"_2383":97587},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2856":58267,"_25078":58264,"_5":25410,"_17499":97589,"_23735":97590,"_2383":97591},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2856":58268,"_25078":58264,"_5":25410,"_17499":97593,"_23735":97594,"_2383":97595},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2856":58269,"_25078":58264,"_5":25410,"_17499":97597,"_23735":97598,"_2383":97599},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2856":58270,"_25078":58264,"_5":25410,"_17499":97601,"_23735":97602,"_2383":97603},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2856":58271,"_25078":58264,"_5":25410,"_17499":97605,"_23735":97606,"_2383":97607},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2856":58272,"_25078":58264,"_5":25410,"_17499":97609,"_23735":97610,"_2383":97611},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2856":58273,"_25078":58264,"_5":25410,"_17499":97613,"_23735":97614,"_2383":97615},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2856":58274,"_25078":58264,"_5":25410,"_17499":97617,"_23735":97618,"_2383":97619},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2856":58275,"_25078":58264,"_5":25410,"_17499":97621,"_23735":97622,"_2383":97623},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2856":58276,"_25078":58264,"_17499":97625,"_5":17394,"_23735":58264,"_2383":97626},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2856":58277,"_25078":58264,"_17499":97628,"_5":17394,"_23735":97586,"_2383":97629},[],"Un servicio publica un evento de dominio.",{"_2856":58278,"_25078":58264,"_17499":97631,"_5":17394,"_23735":97586,"_2383":97632},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2856":58279,"_25078":58264,"_17499":97634,"_5":17394,"_23735":97586,"_2383":97635},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2856":58280,"_25078":58264,"_17499":97637,"_5":17394,"_23735":97586,"_2383":97638},[],"Lamassu entrega el evento al canal configurado.",{"_2856":58281,"_25078":58264,"_17499":97640,"_5":17394,"_23735":97586,"_2383":97641},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2856":58282,"_25078":58264,"_17499":97643,"_5":17394,"_23735":97590,"_2383":97644},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2856":58283,"_25078":58264,"_17499":97646,"_5":17394,"_23735":97590,"_2383":97647},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2856":58284,"_25078":58264,"_17499":97649,"_5":17394,"_23735":97590,"_2383":97650},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2856":58285,"_25078":58264,"_17499":97652,"_5":17394,"_23735":97590,"_2383":97653},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2856":58286,"_25078":58264,"_17499":97655,"_5":17394,"_23735":97590,"_2383":97656},[],"`apikey_options` necesita `header` y `key`.",{"_2856":58287,"_25078":58264,"_17499":97658,"_5":17394,"_23735":97590,"_2383":97659},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2856":58288,"_25078":58264,"_17499":97661,"_5":17394,"_23735":97590,"_2383":97662},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2856":58289,"_25078":58264,"_17499":97664,"_5":17394,"_23735":97590,"_2383":97665},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2856":58290,"_25078":58264,"_17499":97667,"_5":17394,"_23735":97598,"_2383":97668},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2856":58291,"_25078":58264,"_17499":97670,"_5":17394,"_23735":97602,"_2383":97671},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2856":58292,"_25078":58264,"_17499":97673,"_5":17394,"_23735":97606,"_2383":97674},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2856":58293,"_25078":58264,"_17499":97676,"_5":17394,"_23735":97606,"_2383":97677},[],"**None** notifica todas las instancias del evento.",{"_2856":58294,"_25078":58264,"_17499":97679,"_5":17394,"_23735":97606,"_2383":97680},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2856":58295,"_25078":58264,"_17499":97682,"_5":17394,"_23735":97606,"_2383":97683},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2856":58296,"_25078":58264,"_17499":97685,"_5":17394,"_23735":97606,"_2383":97686},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2856":58297,"_25078":58264,"_17499":97688,"_5":17394,"_23735":97606,"_2383":97689},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2856":58298,"_25078":58264,"_17499":97691,"_5":17394,"_23735":97610,"_2383":97692},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2856":58299,"_25078":58264,"_17499":97694,"_5":17394,"_23735":97614,"_2383":97695},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2856":58300,"_25078":58264,"_17499":97697,"_5":17394,"_23735":97614,"_2383":97698},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2856":58301,"_25078":58264,"_17499":97700,"_5":17394,"_23735":97614,"_2383":97701},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2856":58302,"_25078":58264,"_17499":97703,"_5":17394,"_23735":97614,"_2383":97704},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2856":58303,"_25078":58264,"_17499":97706,"_5":17394,"_23735":97614,"_2383":97707},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2856":58304,"_25078":58264,"_17499":97709,"_5":17394,"_23735":97614,"_2383":97710},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2856":58305,"_25078":58264,"_17499":97712,"_5":17394,"_23735":97614,"_2383":97713},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2856":58306,"_25078":58264,"_17499":97715,"_5":17394,"_23735":97614,"_2383":97716},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2856":58307,"_25078":58264,"_17499":97718,"_5":17394,"_23735":97618,"_2383":97719},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2856":58308,"_25078":58264,"_17499":97721,"_5":17394,"_23735":97622,"_2383":97722},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2856":58309,"_25078":58264,"_17499":97724,"_5":17394,"_23735":97622,"_2383":97725},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2856":58310,"_25078":58264,"_17499":97727,"_5":17394,"_23735":97622,"_2383":97728},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2856":58311,"_25078":58264,"_17499":97730,"_5":17394,"_23735":97622,"_2383":97731},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2856":58312,"_25078":58264,"_17499":97733,"_5":17394,"_23735":97622,"_2383":97734},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2856":58313,"_25078":58264,"_17499":97736,"_5":17394,"_23735":97622,"_2383":97737},[],"**Validación:** `va.role.crl.create`.",{"_2856":58314,"_25078":58264,"_17499":97739,"_5":17394,"_23735":97622,"_2383":97740},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2856":58315,"_25078":58264,"_17499":97742,"_5":17394,"_23735":97622,"_2383":97743},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2856":58316,"_25078":58316,"_5":12261,"_2383":97745,"_25413":97746,"_17499":97747,"_23735":58316},"Registros de auditoría",[40749,97046,97047],[],{"_2856":58317,"_25078":58316,"_17499":97749,"_5":17394,"_23735":58316,"_2383":97750},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2856":58318,"_25078":58316,"_5":25410,"_17499":97752,"_23735":97753,"_2383":97754},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2856":58319,"_25078":58316,"_5":25410,"_17499":97756,"_23735":97757,"_2383":97758},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2856":58320,"_25078":58316,"_5":25410,"_17499":97760,"_23735":97761,"_2383":97762},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2856":58321,"_25078":58316,"_5":25410,"_17499":97764,"_23735":97765,"_2383":97766},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2856":58322,"_25078":58316,"_5":25410,"_17499":97768,"_23735":97769,"_2383":97770},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2856":58323,"_25078":58316,"_5":25410,"_17499":97772,"_23735":97773,"_2383":97774},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2856":58324,"_25078":58316,"_5":25410,"_17499":97776,"_23735":97777,"_2383":97778},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2856":58325,"_25078":58316,"_5":25410,"_17499":97780,"_23735":97781,"_2383":97782},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2856":58326,"_25078":58316,"_5":25410,"_17499":97784,"_23735":97785,"_2383":97786},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2856":58327,"_25078":58316,"_5":25410,"_17499":97788,"_23735":97789,"_2383":97790},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2856":58328,"_25078":58316,"_5":25410,"_17499":97792,"_23735":97793,"_2383":97794},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2856":58329,"_25078":58316,"_17499":97796,"_5":17394,"_23735":58316,"_2383":97797},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2856":58330,"_25078":58316,"_17499":97799,"_5":17394,"_23735":97753,"_2383":97800},[],"El cuerpo de auditoría incluye:",{"_2856":58331,"_25078":58316,"_17499":97802,"_5":17394,"_23735":97753,"_2383":97803},[],"input: datos recibidos por la operación;",{"_2856":58332,"_25078":58316,"_17499":97805,"_5":17394,"_23735":97753,"_2383":97806},[],"has\\_error: indica si el servicio devolvió un error;",{"_2856":58333,"_25078":58316,"_17499":97808,"_5":17394,"_23735":97753,"_2383":97809},[],"output: resultado producido o mensaje de error;",{"_2856":58334,"_25078":58316,"_17499":97811,"_5":17394,"_23735":97753,"_2383":97812},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2856":58335,"_25078":58316,"_17499":97814,"_5":17394,"_23735":97753,"_2383":97815},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2856":58336,"_25078":58316,"_17499":97817,"_5":17394,"_23735":97753,"_2383":97818},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2856":58337,"_25078":58316,"_17499":97820,"_5":17394,"_23735":97757,"_2383":97821},[],"El backend aplica auditoría a mutaciones de:",{"_2856":58338,"_25078":58316,"_17499":97823,"_5":17394,"_23735":97757,"_2383":97824},[],"autoridades, certificados y perfiles de emisión;",{"_2856":58339,"_25078":58316,"_17499":97826,"_5":17394,"_23735":97757,"_2383":97827},[],"claves y motores KMS;",{"_2856":58340,"_25078":58316,"_17499":97829,"_5":17394,"_23735":97757,"_2383":97830},[],"dispositivos e identidades;",{"_2856":58341,"_25078":58316,"_17499":97832,"_5":17394,"_23735":97757,"_2383":97833},[],"DMS y operaciones de enrolamiento;",{"_2856":58342,"_25078":58316,"_17499":97835,"_5":17394,"_23735":97757,"_2383":97836},[],"funciones de validación y CRL;",{"_2856":58343,"_25078":58316,"_17499":97838,"_5":17394,"_23735":97757,"_2383":97839},[],"principales, políticas y concesiones de autorización.",{"_2856":58344,"_25078":58316,"_17499":97841,"_5":17394,"_23735":97757,"_2383":97842},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2856":58345,"_25078":58316,"_17499":97844,"_5":17394,"_23735":97761,"_2383":97845},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2856":58346,"_25078":58316,"_17499":97847,"_5":17394,"_23735":97761,"_2383":97848},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2856":58347,"_25078":58316,"_17499":97850,"_5":17394,"_23735":97761,"_2383":97851},[],"Diseña el consumidor para:",{"_2856":58348,"_25078":58316,"_17499":97853,"_5":17394,"_23735":97761,"_2383":97854},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2856":58349,"_25078":58316,"_17499":97856,"_5":17394,"_23735":97761,"_2383":97857},[],"conservar el CloudEvent completo sin modificar;",{"_2856":58350,"_25078":58316,"_17499":97859,"_5":17394,"_23735":97761,"_2383":97860},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2856":58351,"_25078":58316,"_17499":97862,"_5":17394,"_23735":97761,"_2383":97863},[],"cifrar en tránsito y en reposo;",{"_2856":58352,"_25078":58316,"_17499":97865,"_5":17394,"_23735":97761,"_2383":97866},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2856":58353,"_25078":58316,"_17499":97868,"_5":17394,"_23735":97761,"_2383":97869},[],"aplicar una política explícita de retención y legal hold;",{"_2856":58354,"_25078":58316,"_17499":97871,"_5":17394,"_23735":97761,"_2383":97872},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2856":58355,"_25078":58316,"_17499":97874,"_5":17394,"_23735":97765,"_2383":97875},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2856":58356,"_25078":58316,"_17499":97877,"_5":17394,"_23735":97765,"_2383":97878},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2856":58357,"_25078":58316,"_17499":97880,"_5":17394,"_23735":97773,"_2383":97881},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2856":58358,"_25078":58316,"_17499":97883,"_5":17394,"_23735":97777,"_2383":97884},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2856":58359,"_25078":58316,"_17499":97886,"_5":17394,"_23735":97781,"_2383":97887},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2856":58360,"_25078":58316,"_17499":97889,"_5":17394,"_23735":97785,"_2383":97890},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2856":58361,"_25078":58316,"_17499":97892,"_5":17394,"_23735":97789,"_2383":97893},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2856":58362,"_25078":58316,"_17499":97895,"_5":17394,"_23735":97793,"_2383":97896},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2856":58363,"_25078":58316,"_17499":97898,"_5":17394,"_23735":97793,"_2383":97899},[],"aparece un evento de auditoría correcto;",{"_2856":58364,"_25078":58316,"_17499":97901,"_5":17394,"_23735":97793,"_2383":97902},[],"el principal coincide con la identidad utilizada;",{"_2856":58365,"_25078":58316,"_17499":97904,"_5":17394,"_23735":97793,"_2383":97905},[],"el consumidor lo persiste una sola vez;",{"_2856":58366,"_25078":58316,"_17499":97907,"_5":17394,"_23735":97793,"_2383":97908},[],"puede recuperarse por recurso, actor y periodo;",{"_2856":58367,"_25078":58316,"_17499":97910,"_5":17394,"_23735":97793,"_2383":97911},[],"una interrupción del consumidor produce una alerta.",{"_2856":58368,"_25078":58316,"_17499":97913,"_5":17394,"_23735":97793,"_2383":97914},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2856":58369,"_25078":58369,"_5":12261,"_2383":97916,"_25413":97917,"_17499":97918,"_23735":58369},"Arquitectura de la plataforma",[40749,97046],[],{"_2856":58370,"_25078":58369,"_17499":97920,"_5":17394,"_23735":58369,"_2383":97921},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2856":58371,"_25078":58369,"_5":25410,"_17499":97923,"_23735":97924,"_2383":97925},[],"/docs/pr-preview/pr-40/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2856":58372,"_25078":58369,"_5":25410,"_17499":97927,"_23735":97928,"_2383":97929},[],"/docs/pr-preview/pr-40/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2856":58373,"_25078":58369,"_5":25410,"_17499":97931,"_23735":97932,"_2383":97933},[],"/docs/pr-preview/pr-40/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2856":58374,"_25078":58369,"_5":25410,"_17499":97935,"_23735":97936,"_2383":97937},[],"/docs/pr-preview/pr-40/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2856":58375,"_25078":58369,"_5":25410,"_17499":97939,"_23735":97940,"_2383":97941},[],"/docs/pr-preview/pr-40/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2856":58376,"_25078":58369,"_17499":97943,"_5":17394,"_23735":58369,"_2383":97944},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2856":58377,"_25078":58369,"_17499":97946,"_5":17394,"_23735":58369,"_2383":97947},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2856":58378,"_25078":58369,"_17499":97949,"_5":17394,"_23735":97924,"_2383":97950},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2856":58379,"_25078":58369,"_17499":97952,"_5":17394,"_23735":97928,"_2383":97953},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2856":58380,"_25078":58369,"_17499":97955,"_5":17394,"_23735":97932,"_2383":97956},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2856":58381,"_25078":58369,"_17499":97958,"_5":17394,"_23735":97936,"_2383":97959},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2856":58382,"_25078":58369,"_17499":97961,"_5":17394,"_23735":97940,"_2383":97962},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2856":58383,"_25078":58383,"_5":12261,"_2383":97964,"_25413":97965,"_17499":97966,"_23735":58383},"Cómo funciona Lamassu",[40749,97046],[],{"_2856":58384,"_25078":58383,"_17499":97968,"_5":17394,"_23735":58383,"_2383":97969},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2856":58385,"_25078":58383,"_5":25410,"_17499":97971,"_23735":97972,"_2383":97973},[],"/docs/pr-preview/pr-40/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2856":58386,"_25078":58383,"_5":25410,"_17499":97975,"_23735":97976,"_2383":97977},[],"/docs/pr-preview/pr-40/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2856":58387,"_25078":58383,"_17499":97979,"_5":17394,"_23735":58383,"_2383":97980},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2856":58388,"_25078":58383,"_17499":97982,"_5":17394,"_23735":97972,"_2383":97983},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2856":58389,"_25078":58383,"_17499":97985,"_5":17394,"_23735":97972,"_2383":97986},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2856":58390,"_25078":58383,"_17499":97988,"_5":17394,"_23735":97972,"_2383":97989},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2856":58391,"_25078":58383,"_17499":97991,"_5":17394,"_23735":97972,"_2383":97992},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2856":58392,"_25078":58383,"_17499":97994,"_5":17394,"_23735":97972,"_2383":97995},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2856":58393,"_25078":58383,"_17499":97997,"_5":17394,"_23735":97976,"_2383":97998},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2856":58394,"_25078":58383,"_17499":98000,"_5":17394,"_23735":97976,"_2383":98001},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2856":58395,"_25078":58383,"_17499":98003,"_5":17394,"_23735":97976,"_2383":98004},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2856":58396,"_25078":58383,"_17499":98006,"_5":17394,"_23735":97976,"_2383":98007},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2856":58397,"_25078":58383,"_17499":98009,"_5":17394,"_23735":97976,"_2383":98010},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2856":58398,"_25078":58383,"_17499":98012,"_5":17394,"_23735":97976,"_2383":98013},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2856":58399,"_25078":58383,"_17499":98015,"_5":17394,"_23735":97976,"_2383":98016},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2856":58400,"_25078":58400,"_5":12261,"_2383":98018,"_25413":98019,"_17499":98020,"_23735":58400},"Dispositivos e identidades",[40749,97046,43067,98018],[],{"_2856":58401,"_25078":58400,"_17499":98022,"_5":17394,"_23735":58400,"_2383":98023},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2856":58402,"_25078":58400,"_5":25410,"_17499":98025,"_23735":98026,"_2383":98027},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2856":58403,"_25078":58400,"_5":25410,"_17499":98029,"_23735":98030,"_2383":98031},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2856":58404,"_25078":58400,"_5":25410,"_17499":98033,"_23735":98034,"_2383":98035},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2856":58405,"_25078":58400,"_5":25410,"_17499":98037,"_23735":98038,"_2383":98039},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2856":58406,"_25078":58400,"_5":25410,"_17499":98041,"_23735":98042,"_2383":98043},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2856":58407,"_25078":58400,"_5":25410,"_17499":98045,"_23735":98046,"_2383":98047},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2856":58408,"_25078":58400,"_5":25410,"_17499":98049,"_23735":98050,"_2383":98051},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2856":58409,"_25078":58400,"_5":25410,"_17499":98053,"_23735":98054,"_2383":98055},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2856":58410,"_25078":58400,"_5":25410,"_17499":98057,"_23735":98058,"_2383":98059},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2856":58411,"_25078":58400,"_5":25410,"_17499":98061,"_23735":98062,"_2383":98063},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2856":58412,"_25078":58400,"_5":25410,"_17499":98065,"_23735":98066,"_2383":98067},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2856":58413,"_25078":58400,"_17499":98069,"_5":17394,"_23735":58400,"_2383":98070},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2856":58414,"_25078":58400,"_17499":98072,"_5":17394,"_23735":58400,"_2383":98073},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2856":58415,"_25078":58400,"_17499":98075,"_5":17394,"_23735":98026,"_2383":98076},[],"Vista operativa",{"_2856":58416,"_25078":58400,"_17499":98078,"_5":17394,"_23735":98026,"_2383":98079},[],"Interpretación",{"_2856":58417,"_25078":58400,"_17499":98081,"_5":17394,"_23735":98026,"_2383":43130},[],{"_2856":58418,"_25078":58400,"_17499":98083,"_5":17394,"_23735":98026,"_2383":98084},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2856":58419,"_25078":58400,"_17499":98086,"_5":17394,"_23735":98026,"_2383":43136},[],{"_2856":58420,"_25078":58400,"_17499":98088,"_5":17394,"_23735":98026,"_2383":98089},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2856":58421,"_25078":58400,"_17499":98091,"_5":17394,"_23735":98026,"_2383":43142},[],{"_2856":58422,"_25078":58400,"_17499":98093,"_5":17394,"_23735":98026,"_2383":98094},[],"La identidad está en la ventana operativa de renovación.",{"_2856":58423,"_25078":58400,"_17499":98096,"_5":17394,"_23735":98026,"_2383":43148},[],{"_2856":58424,"_25078":58400,"_17499":98098,"_5":17394,"_23735":98026,"_2383":98099},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2856":58425,"_25078":58400,"_17499":98101,"_5":17394,"_23735":98026,"_2383":43154},[],{"_2856":58426,"_25078":58400,"_17499":98103,"_5":17394,"_23735":98026,"_2383":98104},[],"La identidad ha vencido.",{"_2856":58427,"_25078":58400,"_17499":98106,"_5":17394,"_23735":98026,"_2383":43160},[],{"_2856":58428,"_25078":58400,"_17499":98108,"_5":17394,"_23735":98026,"_2383":98109},[],"La identidad está marcada como revocada.",{"_2856":58429,"_25078":58400,"_17499":98111,"_5":17394,"_23735":98026,"_2383":43166},[],{"_2856":58430,"_25078":58400,"_17499":98113,"_5":17394,"_23735":98026,"_2383":98114},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2856":58431,"_25078":58400,"_17499":98116,"_5":17394,"_23735":98026,"_2383":98117},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2856":58432,"_25078":58400,"_17499":98119,"_5":17394,"_23735":98030,"_2383":98120},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2856":58433,"_25078":58400,"_17499":98122,"_5":17394,"_23735":98030,"_2383":98123},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2856":58434,"_25078":58400,"_17499":98125,"_5":17394,"_23735":98030,"_2383":98126},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2856":58435,"_25078":58400,"_17499":98128,"_5":17394,"_23735":98030,"_2383":98129},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2856":58436,"_25078":58400,"_17499":98131,"_5":17394,"_23735":98034,"_2383":98132},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2856":58437,"_25078":58400,"_17499":98134,"_5":17394,"_23735":98038,"_2383":98135},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2856":58438,"_25078":58400,"_17499":98137,"_5":17394,"_23735":98042,"_2383":98138},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2856":58439,"_25078":58400,"_17499":98140,"_5":17394,"_23735":98046,"_2383":98141},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2856":58440,"_25078":58400,"_17499":98143,"_5":17394,"_23735":98050,"_2383":98144},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2856":58441,"_25078":58400,"_17499":98146,"_5":17394,"_23735":98050,"_2383":98147},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2856":58442,"_25078":58400,"_17499":98149,"_5":17394,"_23735":98054,"_2383":98150},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2856":58443,"_25078":58400,"_17499":98152,"_5":17394,"_23735":98054,"_2383":98153},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2856":58444,"_25078":58400,"_17499":98155,"_5":17394,"_23735":98054,"_2383":98156},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2856":58445,"_25078":58400,"_17499":98158,"_5":17394,"_23735":98054,"_2383":98159},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2856":58446,"_25078":58400,"_17499":98161,"_5":17394,"_23735":98054,"_2383":98162},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2856":58447,"_25078":58400,"_17499":98164,"_5":17394,"_23735":98054,"_2383":98165},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2856":58448,"_25078":58400,"_17499":98167,"_5":17394,"_23735":98058,"_2383":98168},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2856":58449,"_25078":58400,"_17499":98170,"_5":17394,"_23735":98058,"_2383":98171},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2856":58450,"_25078":58400,"_17499":98173,"_5":17394,"_23735":98062,"_2383":98174},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2856":58451,"_25078":58400,"_17499":98176,"_5":17394,"_23735":98062,"_2383":98177},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2856":58452,"_25078":58400,"_17499":98179,"_5":17394,"_23735":98062,"_2383":98180},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2856":58453,"_25078":58400,"_17499":98182,"_5":17394,"_23735":98062,"_2383":98183},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2856":58454,"_25078":58400,"_17499":98185,"_5":17394,"_23735":98066,"_2383":98186},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2856":58455,"_25078":58400,"_17499":98188,"_5":17394,"_23735":98066,"_2383":98189},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2856":58456,"_25078":58456,"_5":12261,"_2383":98191,"_25413":98192,"_17499":98194,"_23735":58456},"Identidad inicial y autenticación",[40749,97046,43067,98018,98193],"Enrolamiento con PKI",[],{"_2856":58457,"_25078":58456,"_17499":98196,"_5":17394,"_23735":58456,"_2383":98197},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2856":58458,"_25078":58456,"_5":25410,"_17499":98199,"_23735":98200,"_2383":98201},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2856":58459,"_25078":58456,"_5":25410,"_17499":98203,"_23735":98204,"_2383":98205},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2856":58460,"_25078":58456,"_5":25410,"_17499":98207,"_23735":98208,"_2383":98209},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2856":58461,"_25078":58456,"_5":25410,"_17499":98211,"_23735":98212,"_2383":98213},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2856":58462,"_25078":58456,"_5":25410,"_17499":98215,"_23735":98216,"_2383":98217},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2856":58463,"_25078":58456,"_17499":98219,"_5":17394,"_23735":58456,"_2383":98220},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2856":58464,"_25078":58456,"_17499":98222,"_5":17394,"_23735":98200,"_2383":98223},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2856":58465,"_25078":58456,"_17499":98225,"_5":17394,"_23735":98200,"_2383":98226},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2856":58466,"_25078":58456,"_17499":98228,"_5":17394,"_23735":98204,"_2383":98229},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2856":58467,"_25078":58456,"_17499":98231,"_5":17394,"_23735":98204,"_2383":98232},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2856":58468,"_25078":58456,"_17499":98234,"_5":17394,"_23735":98204,"_2383":98235},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2856":58469,"_25078":58456,"_17499":98237,"_5":17394,"_23735":98208,"_2383":98238},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2856":58470,"_25078":58456,"_17499":98240,"_5":17394,"_23735":98208,"_2383":98241},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2856":58471,"_25078":58456,"_17499":98243,"_5":17394,"_23735":98212,"_2383":98244},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2856":58472,"_25078":58456,"_17499":98246,"_5":17394,"_23735":98212,"_2383":98247},[],"Ejemplo de cuerpo:",{"_2856":58473,"_25078":58456,"_17499":98249,"_5":17394,"_23735":98212,"_2383":98250},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2856":58474,"_25078":58456,"_17499":98252,"_5":17394,"_23735":98212,"_2383":98253},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2856":58475,"_25078":58456,"_17499":98255,"_5":17394,"_23735":98212,"_2383":98256},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2856":58476,"_25078":58456,"_17499":98258,"_5":17394,"_23735":98212,"_2383":98259},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2856":58477,"_25078":58456,"_17499":98261,"_5":17394,"_23735":98216,"_2383":98262},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2856":58478,"_25078":58456,"_17499":98264,"_5":17394,"_23735":98216,"_2383":98265},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2856":58479,"_25078":58479,"_5":12261,"_2383":98267,"_25413":98268,"_17499":98269,"_23735":58479},"Configura y opera el DMS",[40749,97046,43067,98018,98193],[],{"_2856":58480,"_25078":58479,"_17499":98271,"_5":17394,"_23735":58479,"_2383":98272},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2856":58481,"_25078":58479,"_5":25410,"_17499":98274,"_23735":98275,"_2383":95747},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2856":58482,"_25078":58479,"_5":25410,"_17499":98277,"_23735":98278,"_2383":98279},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2856":58483,"_25078":58479,"_5":25410,"_17499":98281,"_23735":98282,"_2383":98283},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2856":58484,"_25078":58479,"_5":25410,"_17499":98285,"_23735":98286,"_2383":98287},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2856":58485,"_25078":58479,"_5":25410,"_17499":98289,"_23735":98290,"_2383":98291},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2856":58486,"_25078":58479,"_5":25410,"_17499":98293,"_23735":98294,"_2383":98295},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2856":58487,"_25078":58479,"_5":25410,"_17499":98297,"_23735":98298,"_2383":98299},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2856":58488,"_25078":58479,"_5":25410,"_17499":98301,"_23735":98302,"_2383":98303},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2856":58489,"_25078":58479,"_5":25410,"_17499":98305,"_23735":98306,"_2383":43362},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2856":58490,"_25078":58479,"_5":25410,"_17499":98308,"_23735":98309,"_2383":43366},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2856":58491,"_25078":58479,"_5":25410,"_17499":98311,"_23735":98312,"_2383":98313},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2856":58492,"_25078":58479,"_5":25410,"_17499":98315,"_23735":98316,"_2383":98317},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2856":58493,"_25078":58479,"_5":25410,"_17499":98319,"_23735":98320,"_2383":98321},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2856":58494,"_25078":58479,"_5":25410,"_17499":98323,"_23735":98324,"_2383":98325},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2856":58495,"_25078":58479,"_5":25410,"_17499":98327,"_23735":98328,"_2383":43386},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2856":58496,"_25078":58479,"_5":25410,"_17499":98330,"_23735":98331,"_2383":98332},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2856":58497,"_25078":58479,"_5":25410,"_17499":98334,"_23735":98335,"_2383":98336},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2856":58498,"_25078":58479,"_5":25410,"_17499":98338,"_23735":98339,"_2383":98340},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2856":58499,"_25078":58479,"_17499":98342,"_5":17394,"_23735":58479,"_2383":98343},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2856":58500,"_25078":58479,"_17499":98345,"_5":17394,"_23735":98275,"_2383":98346},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2856":58501,"_25078":58479,"_17499":98348,"_5":17394,"_23735":98275,"_2383":98349},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2856":58502,"_25078":58479,"_17499":98351,"_5":17394,"_23735":98282,"_2383":98352},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2856":58503,"_25078":58479,"_17499":98354,"_5":17394,"_23735":98286,"_2383":98355},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2856":58504,"_25078":58479,"_17499":98357,"_5":17394,"_23735":98290,"_2383":98358},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2856":58505,"_25078":58479,"_17499":98360,"_5":17394,"_23735":98294,"_2383":98361},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2856":58506,"_25078":58479,"_17499":98363,"_5":17394,"_23735":98298,"_2383":98364},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2856":58507,"_25078":58479,"_17499":98366,"_5":17394,"_23735":98306,"_2383":98367},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2856":58508,"_25078":58479,"_17499":98369,"_5":17394,"_23735":98306,"_2383":98370},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2856":58509,"_25078":58479,"_17499":98372,"_5":17394,"_23735":98309,"_2383":98373},[],"Campo de `settings.enrollment_settings`",{"_2856":58510,"_25078":58479,"_17499":98375,"_5":17394,"_23735":98309,"_2383":98376},[],"Decisión",{"_2856":58511,"_25078":58479,"_17499":98378,"_5":17394,"_23735":98309,"_2383":43437},[],{"_2856":58512,"_25078":58479,"_17499":98380,"_5":17394,"_23735":98309,"_2383":98381},[],"`EST_RFC7030` para estas operaciones.",{"_2856":58513,"_25078":58479,"_17499":98383,"_5":17394,"_23735":98309,"_2383":43443},[],{"_2856":58514,"_25078":58479,"_17499":98385,"_5":17394,"_23735":98309,"_2383":98386},[],"ID de la CA que firmará.",{"_2856":58515,"_25078":58479,"_17499":98388,"_5":17394,"_23735":98309,"_2383":43449},[],{"_2856":58516,"_25078":58479,"_17499":98390,"_5":17394,"_23735":98309,"_2383":98391},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2856":58517,"_25078":58479,"_17499":98393,"_5":17394,"_23735":98309,"_2383":43455},[],{"_2856":58518,"_25078":58479,"_17499":98395,"_5":17394,"_23735":98309,"_2383":98396},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2856":58519,"_25078":58479,"_17499":98398,"_5":17394,"_23735":98309,"_2383":43461},[],{"_2856":58520,"_25078":58479,"_17499":98400,"_5":17394,"_23735":98309,"_2383":98401},[],"Uno de los cuatro modos de autenticación.",{"_2856":58521,"_25078":58479,"_17499":98403,"_5":17394,"_23735":98309,"_2383":98404},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2856":58522,"_25078":58479,"_17499":98406,"_5":17394,"_23735":98312,"_2383":98407},[],"Los bloques son independientes:",{"_2856":58523,"_25078":58479,"_17499":98409,"_5":17394,"_23735":98312,"_2383":98410},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2856":58524,"_25078":58479,"_17499":98412,"_5":17394,"_23735":98312,"_2383":98413},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2856":58525,"_25078":58479,"_17499":98415,"_5":17394,"_23735":98312,"_2383":43479},[],{"_2856":58526,"_25078":58479,"_17499":98417,"_5":17394,"_23735":98312,"_2383":98418},[],"Control aplicado en la operación configurada",{"_2856":58527,"_25078":58479,"_17499":98420,"_5":17394,"_23735":98312,"_2383":43485},[],{"_2856":58528,"_25078":58479,"_17499":98422,"_5":17394,"_23735":98312,"_2383":98423},[],"Validación del certificado presentado.",{"_2856":58529,"_25078":58479,"_17499":98425,"_5":17394,"_23735":98312,"_2383":43491},[],{"_2856":58530,"_25078":58479,"_17499":98427,"_5":17394,"_23735":98312,"_2383":98428},[],"Autorización del webhook configurado.",{"_2856":58531,"_25078":58479,"_17499":98430,"_5":17394,"_23735":98312,"_2383":43497},[],{"_2856":58532,"_25078":58479,"_17499":98432,"_5":17394,"_23735":98312,"_2383":98433},[],"Validación del certificado y, después, aprobación del webhook.",{"_2856":58533,"_25078":58479,"_17499":98435,"_5":17394,"_23735":98312,"_2383":43503},[],{"_2856":58534,"_25078":58479,"_17499":98437,"_5":17394,"_23735":98312,"_2383":98438},[],"Sin autenticación del solicitante por el DMS.",{"_2856":58535,"_25078":58479,"_17499":98440,"_5":17394,"_23735":98312,"_2383":98441},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2856":58536,"_25078":58479,"_17499":98443,"_5":17394,"_23735":98312,"_2383":98444},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2856":58537,"_25078":58479,"_17499":98446,"_5":17394,"_23735":98312,"_2383":98447},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas` y `enable_expired_renewal`. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento; el validador de reenrolamiento no lee las `validation_cas` del bloque inicial.",{"_2856":58538,"_25078":58479,"_17499":98449,"_5":17394,"_23735":98312,"_2383":98450},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2856":58539,"_25078":58479,"_17499":98452,"_5":17394,"_23735":98316,"_2383":98453},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2856":58540,"_25078":58479,"_17499":98455,"_5":17394,"_23735":98316,"_2383":98456},[],"Campo de `external_webhook_settings`",{"_2856":58541,"_25078":58479,"_17499":98458,"_5":17394,"_23735":98316,"_2383":98376},[],{"_2856":58542,"_25078":58479,"_17499":98460,"_5":17394,"_23735":98316,"_2383":43529},[],{"_2856":58543,"_25078":58479,"_17499":98462,"_5":17394,"_23735":98316,"_2383":98463},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2856":58544,"_25078":58479,"_17499":98465,"_5":17394,"_23735":98316,"_2383":43535},[],{"_2856":58545,"_25078":58479,"_17499":98467,"_5":17394,"_23735":98316,"_2383":98468},[],"`POST` o `PUT`; `POST` por defecto.",{"_2856":58546,"_25078":58479,"_17499":98470,"_5":17394,"_23735":98316,"_2383":43541},[],{"_2856":58547,"_25078":58479,"_17499":98472,"_5":17394,"_23735":98316,"_2383":98473},[],"Etiqueta usada en los logs del servicio.",{"_2856":58548,"_25078":58479,"_17499":98475,"_5":17394,"_23735":98316,"_2383":43547},[],{"_2856":58549,"_25078":58479,"_17499":98477,"_5":17394,"_23735":98316,"_2383":98478},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2856":58550,"_25078":58479,"_17499":98480,"_5":17394,"_23735":98316,"_2383":43553},[],{"_2856":58551,"_25078":58479,"_17499":98482,"_5":17394,"_23735":98316,"_2383":98483},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2856":58552,"_25078":58479,"_17499":98485,"_5":17394,"_23735":98316,"_2383":43559},[],{"_2856":58553,"_25078":58479,"_17499":98487,"_5":17394,"_23735":98316,"_2383":98488},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2856":58554,"_25078":58479,"_17499":98490,"_5":17394,"_23735":98316,"_2383":43565},[],{"_2856":58555,"_25078":58479,"_17499":98492,"_5":17394,"_23735":98316,"_2383":98493},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2856":58556,"_25078":58479,"_17499":98495,"_5":17394,"_23735":98316,"_2383":43571},[],{"_2856":58557,"_25078":58479,"_17499":98497,"_5":17394,"_23735":98316,"_2383":98498},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2856":58558,"_25078":58479,"_17499":98500,"_5":17394,"_23735":98316,"_2383":43577},[],{"_2856":58559,"_25078":58479,"_17499":98502,"_5":17394,"_23735":98316,"_2383":98503},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2856":58560,"_25078":58479,"_17499":98505,"_5":17394,"_23735":98316,"_2383":98506},[],"Reglas de esa configuración:",{"_2856":58561,"_25078":58479,"_17499":98508,"_5":17394,"_23735":98316,"_2383":98509},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2856":58562,"_25078":58479,"_17499":98511,"_5":17394,"_23735":98316,"_2383":98512},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2856":58563,"_25078":58479,"_17499":98514,"_5":17394,"_23735":98316,"_2383":98515},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2856":58564,"_25078":58479,"_17499":98517,"_5":17394,"_23735":98316,"_2383":98518},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2856":58565,"_25078":58479,"_17499":98520,"_5":17394,"_23735":98316,"_2383":98521},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2856":58566,"_25078":58479,"_17499":98523,"_5":17394,"_23735":98316,"_2383":98524},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2856":58567,"_25078":58479,"_17499":98526,"_5":17394,"_23735":98316,"_2383":98527},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2856":58568,"_25078":58479,"_17499":98529,"_5":17394,"_23735":98316,"_2383":98530},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2856":58569,"_25078":58479,"_17499":98532,"_5":17394,"_23735":98320,"_2383":98533},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2856":58570,"_25078":58479,"_17499":98535,"_5":17394,"_23735":98324,"_2383":98536},[],"Campo de `settings.reenrollment_settings`",{"_2856":58571,"_25078":58479,"_17499":98538,"_5":17394,"_23735":98324,"_2383":98539},[],"Función",{"_2856":58572,"_25078":58479,"_17499":98541,"_5":17394,"_23735":98324,"_2383":43618},[],{"_2856":58573,"_25078":58479,"_17499":98543,"_5":17394,"_23735":98324,"_2383":98544},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2856":58574,"_25078":58479,"_17499":98546,"_5":17394,"_23735":98324,"_2383":43624},[],{"_2856":58575,"_25078":58479,"_17499":98548,"_5":17394,"_23735":98324,"_2383":98549},[],"Umbral operativo preventivo de monitorización.",{"_2856":58576,"_25078":58479,"_17499":98551,"_5":17394,"_23735":98324,"_2383":43630},[],{"_2856":58577,"_25078":58479,"_17499":98553,"_5":17394,"_23735":98324,"_2383":98554},[],"Umbral operativo crítico de monitorización.",{"_2856":58578,"_25078":58479,"_17499":98556,"_5":17394,"_23735":98324,"_2383":43636},[],{"_2856":58579,"_25078":58479,"_17499":98558,"_5":17394,"_23735":98324,"_2383":98559},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2856":58580,"_25078":58479,"_17499":98561,"_5":17394,"_23735":98324,"_2383":43642},[],{"_2856":58581,"_25078":58479,"_17499":98563,"_5":17394,"_23735":98324,"_2383":98564},[],"CAs de validación de reenrolamiento; opcional, porque la CA de enrolamiento siempre es confiable.",{"_2856":58582,"_25078":58479,"_17499":98566,"_5":17394,"_23735":98324,"_2383":43648},[],{"_2856":58583,"_25078":58479,"_17499":98568,"_5":17394,"_23735":98324,"_2383":98569},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2856":58584,"_25078":58479,"_17499":98571,"_5":17394,"_23735":98324,"_2383":98572},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2856":58585,"_25078":58479,"_17499":98574,"_5":17394,"_23735":98328,"_2383":98575},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2856":58586,"_25078":58479,"_17499":98577,"_5":17394,"_23735":98331,"_2383":96104},[],{"_2856":58587,"_25078":58479,"_17499":98579,"_5":17394,"_23735":98331,"_2383":98580},[],"Qué publica",{"_2856":58588,"_25078":58479,"_17499":98582,"_5":17394,"_23735":98331,"_2383":43665},[],{"_2856":58589,"_25078":58479,"_17499":98584,"_5":17394,"_23735":98331,"_2383":98585},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2856":58590,"_25078":58479,"_17499":98587,"_5":17394,"_23735":98331,"_2383":43671},[],{"_2856":58591,"_25078":58479,"_17499":98589,"_5":17394,"_23735":98331,"_2383":98590},[],"Certificado de la CA emisora seleccionada.",{"_2856":58592,"_25078":58479,"_17499":98592,"_5":17394,"_23735":98331,"_2383":43677},[],{"_2856":58593,"_25078":58479,"_17499":98594,"_5":17394,"_23735":98331,"_2383":98595},[],"Certificados de las CAs elegidas explícitamente.",{"_2856":58594,"_25078":58479,"_17499":98597,"_5":17394,"_23735":98331,"_2383":98598},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2856":58595,"_25078":58479,"_17499":98600,"_5":17394,"_23735":98335,"_2383":98601},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2856":58596,"_25078":58479,"_17499":98603,"_5":17394,"_23735":98335,"_2383":98604},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2856":58597,"_25078":58479,"_17499":98606,"_5":17394,"_23735":98335,"_2383":98607},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2856":58598,"_25078":58479,"_17499":98609,"_5":17394,"_23735":98339,"_2383":98610},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2856":58599,"_25078":58599,"_5":12261,"_2383":98612,"_25413":98613,"_17499":98614,"_23735":58599},"Integra el cliente EST",[40749,97046,43067,98018,98193],[],{"_2856":58600,"_25078":58599,"_17499":98616,"_5":17394,"_23735":58599,"_2383":98617},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2856":58601,"_25078":58599,"_5":25410,"_17499":98619,"_23735":98620,"_2383":95747},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2856":58602,"_25078":58599,"_5":25410,"_17499":98622,"_23735":98623,"_2383":98624},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2856":58603,"_25078":58599,"_5":25410,"_17499":98626,"_23735":98627,"_2383":98628},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2856":58604,"_25078":58599,"_5":25410,"_17499":98630,"_23735":98631,"_2383":98632},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2856":58605,"_25078":58599,"_5":25410,"_17499":98634,"_23735":98635,"_2383":98636},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2856":58606,"_25078":58599,"_5":25410,"_17499":98638,"_23735":98639,"_2383":98640},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2856":58607,"_25078":58599,"_17499":98642,"_5":17394,"_23735":58599,"_2383":98643},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2856":58608,"_25078":58599,"_17499":98645,"_5":17394,"_23735":98620,"_2383":98646},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2856":58609,"_25078":58599,"_17499":98648,"_5":17394,"_23735":98620,"_2383":98649},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2856":58610,"_25078":58599,"_17499":98651,"_5":17394,"_23735":98620,"_2383":98652},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2856":58611,"_25078":58599,"_17499":98654,"_5":17394,"_23735":98623,"_2383":98655},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2856":58612,"_25078":58599,"_17499":98657,"_5":17394,"_23735":98623,"_2383":98658},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2856":58613,"_25078":58599,"_17499":98660,"_5":17394,"_23735":98627,"_2383":98661},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2856":58614,"_25078":58599,"_17499":98663,"_5":17394,"_23735":98627,"_2383":98664},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2856":58615,"_25078":58599,"_17499":98666,"_5":17394,"_23735":98631,"_2383":98667},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2856":58616,"_25078":58599,"_17499":98669,"_5":17394,"_23735":98631,"_2383":98670},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2856":58617,"_25078":58599,"_17499":98672,"_5":17394,"_23735":98635,"_2383":98673},[],"Para el caso de una raíz que emite directamente:",{"_2856":58618,"_25078":58599,"_17499":98675,"_5":17394,"_23735":98635,"_2383":98676},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2856":58619,"_25078":58599,"_17499":98678,"_5":17394,"_23735":98635,"_2383":98679},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2856":58620,"_25078":58599,"_17499":98681,"_5":17394,"_23735":98639,"_2383":98682},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2856":58621,"_25078":58621,"_5":12261,"_2383":98684,"_25413":98685,"_17499":98686,"_23735":58621},"Referencia EST",[40749,97046,43067,98018,98193],[],{"_2856":58622,"_25078":58621,"_17499":98688,"_5":17394,"_23735":58621,"_2383":98689},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2856":58623,"_25078":58621,"_5":25410,"_17499":98691,"_23735":98692,"_2383":98693},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2856":58624,"_25078":58621,"_5":25410,"_17499":98695,"_23735":98696,"_2383":19003},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2856":58625,"_25078":58621,"_5":25410,"_17499":98698,"_23735":98699,"_2383":21768},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2856":58626,"_25078":58621,"_5":25410,"_17499":98701,"_23735":98702,"_2383":21775},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2856":58627,"_25078":58621,"_5":25410,"_17499":98704,"_23735":98705,"_2383":21145},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2856":58628,"_25078":58621,"_5":25410,"_17499":98707,"_23735":98708,"_2383":98709},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2856":58629,"_25078":58621,"_5":25410,"_17499":98711,"_23735":98712,"_2383":98713},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2856":58630,"_25078":58621,"_5":25410,"_17499":98715,"_23735":98716,"_2383":98717},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2856":58631,"_25078":58621,"_17499":98719,"_5":17394,"_23735":58621,"_2383":98720},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2856":58632,"_25078":58621,"_17499":98722,"_5":17394,"_23735":98692,"_2383":98723},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2856":58633,"_25078":58621,"_17499":98725,"_5":17394,"_23735":98692,"_2383":96837},[],{"_2856":58634,"_25078":58621,"_17499":98727,"_5":17394,"_23735":98692,"_2383":98728},[],"Método",{"_2856":58635,"_25078":58621,"_17499":98730,"_5":17394,"_23735":98692,"_2383":98731},[],"Autenticación y condición",{"_2856":58636,"_25078":58621,"_17499":98733,"_5":17394,"_23735":98692,"_2383":43820},[],{"_2856":58637,"_25078":58621,"_17499":98735,"_5":17394,"_23735":98692,"_2383":43823},[],{"_2856":58638,"_25078":58621,"_17499":98737,"_5":17394,"_23735":98692,"_2383":98738},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2856":58639,"_25078":58621,"_17499":98740,"_5":17394,"_23735":98692,"_2383":43829},[],{"_2856":58640,"_25078":58621,"_17499":98742,"_5":17394,"_23735":98692,"_2383":43832},[],{"_2856":58641,"_25078":58621,"_17499":98744,"_5":17394,"_23735":98692,"_2383":98745},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2856":58642,"_25078":58621,"_17499":98747,"_5":17394,"_23735":98692,"_2383":43838},[],{"_2856":58643,"_25078":58621,"_17499":98749,"_5":17394,"_23735":98692,"_2383":43832},[],{"_2856":58644,"_25078":58621,"_17499":98751,"_5":17394,"_23735":98692,"_2383":98752},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2856":58645,"_25078":58621,"_17499":98754,"_5":17394,"_23735":98692,"_2383":43846},[],{"_2856":58646,"_25078":58621,"_17499":98756,"_5":17394,"_23735":98692,"_2383":43832},[],{"_2856":58647,"_25078":58621,"_17499":98758,"_5":17394,"_23735":98692,"_2383":98759},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2856":58648,"_25078":58621,"_17499":98761,"_5":17394,"_23735":98692,"_2383":98762},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2856":58649,"_25078":58621,"_17499":98764,"_5":17394,"_23735":98696,"_2383":98765},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2856":58650,"_25078":58621,"_17499":98767,"_5":17394,"_23735":98696,"_2383":98768},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2856":58651,"_25078":58621,"_17499":98770,"_5":17394,"_23735":98699,"_2383":98771},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2856":58652,"_25078":58621,"_17499":98773,"_5":17394,"_23735":98699,"_2383":98774},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2856":58653,"_25078":58621,"_17499":98776,"_5":17394,"_23735":98702,"_2383":98777},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2856":58654,"_25078":58621,"_17499":98779,"_5":17394,"_23735":98702,"_2383":98780},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2856":58655,"_25078":58621,"_17499":98782,"_5":17394,"_23735":98705,"_2383":98783},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2856":58656,"_25078":58621,"_17499":98785,"_5":17394,"_23735":98705,"_2383":98786},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2856":58657,"_25078":58621,"_17499":98788,"_5":17394,"_23735":98708,"_2383":98789},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2856":58658,"_25078":58621,"_17499":98791,"_5":17394,"_23735":98708,"_2383":98792},[],"Parte",{"_2856":58659,"_25078":58621,"_17499":98794,"_5":17394,"_23735":98708,"_2383":98795},[],"Contenido tras decodificar su Base64",{"_2856":58660,"_25078":58621,"_17499":98797,"_5":17394,"_23735":98708,"_2383":43890},[],{"_2856":58661,"_25078":58621,"_17499":98799,"_5":17394,"_23735":98708,"_2383":98800},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2856":58662,"_25078":58621,"_17499":98802,"_5":17394,"_23735":98708,"_2383":43896},[],{"_2856":58663,"_25078":58621,"_17499":98804,"_5":17394,"_23735":98708,"_2383":98805},[],"PKCS#7 DER con el certificado emitido.",{"_2856":58664,"_25078":58621,"_17499":98807,"_5":17394,"_23735":98708,"_2383":98808},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2856":58665,"_25078":58621,"_17499":98810,"_5":17394,"_23735":98712,"_2383":98811},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2856":58666,"_25078":58621,"_17499":98813,"_5":17394,"_23735":98712,"_2383":98814},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2856":58667,"_25078":58621,"_17499":98816,"_5":17394,"_23735":98712,"_2383":98817},[],"Convierte y comprueba el resultado:",{"_2856":58668,"_25078":58621,"_17499":98819,"_5":17394,"_23735":98712,"_2383":98820},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2856":58669,"_25078":58621,"_17499":98822,"_5":17394,"_23735":98716,"_2383":98823},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2856":58670,"_25078":58621,"_17499":98825,"_5":17394,"_23735":98716,"_2383":98826},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2856":58671,"_25078":58671,"_5":12261,"_2383":98193,"_25413":98828,"_17499":98829,"_23735":58671},[40749,97046,43067,98018,98193],[],{"_2856":58672,"_25078":58671,"_17499":98831,"_5":17394,"_23735":58671,"_2383":98832},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2856":58673,"_25078":58671,"_5":25410,"_17499":98834,"_23735":98835,"_2383":98836},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2856":58674,"_25078":58671,"_5":25410,"_17499":98838,"_23735":98839,"_2383":98840},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2856":58675,"_25078":58671,"_5":25410,"_17499":98842,"_23735":98843,"_2383":98844},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2856":58676,"_25078":58671,"_5":25410,"_17499":98846,"_23735":98847,"_2383":98848},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2856":58677,"_25078":58671,"_17499":98850,"_5":17394,"_23735":58671,"_2383":98851},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2856":58678,"_25078":58671,"_17499":98853,"_5":17394,"_23735":98835,"_2383":98854},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2856":58679,"_25078":58671,"_17499":98856,"_5":17394,"_23735":98835,"_2383":98857},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2856":58680,"_25078":58671,"_17499":98859,"_5":17394,"_23735":98835,"_2383":98860},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2856":58681,"_25078":58671,"_17499":98862,"_5":17394,"_23735":98835,"_2383":98863},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2856":58682,"_25078":58671,"_17499":98865,"_5":17394,"_23735":98835,"_2383":98866},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2856":58683,"_25078":58671,"_17499":98868,"_5":17394,"_23735":98835,"_2383":98869},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2856":58684,"_25078":58671,"_17499":98871,"_5":17394,"_23735":98839,"_2383":98872},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2856":58685,"_25078":58671,"_17499":98874,"_5":17394,"_23735":98839,"_2383":98875},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":58686,"_25078":58671,"_17499":98877,"_5":17394,"_23735":98839,"_2383":98878},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2856":58687,"_25078":58671,"_17499":98880,"_5":17394,"_23735":98839,"_2383":98881},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2856":58688,"_25078":58671,"_17499":98883,"_5":17394,"_23735":98843,"_2383":98884},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2856":58689,"_25078":58671,"_17499":98886,"_5":17394,"_23735":98843,"_2383":98887},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2856":58690,"_25078":58671,"_17499":98889,"_5":17394,"_23735":98843,"_2383":98890},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2856":58691,"_25078":58671,"_17499":98892,"_5":17394,"_23735":98843,"_2383":98893},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2856":58692,"_25078":58671,"_17499":98895,"_5":17394,"_23735":98847,"_2383":98896},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2856":58693,"_25078":58671,"_17499":98898,"_5":17394,"_23735":98847,"_2383":98899},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2856":58694,"_25078":58694,"_5":12261,"_2383":98901,"_25413":98902,"_17499":98903,"_23735":58694},"Estrategias de aprovisionamiento",[40749,97046,43067,98018,98193],[],{"_2856":58695,"_25078":58694,"_17499":98905,"_5":17394,"_23735":58694,"_2383":98906},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2856":58696,"_25078":58694,"_5":25410,"_17499":98908,"_23735":98909,"_2383":98910},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2856":58697,"_25078":58694,"_5":25410,"_17499":98912,"_23735":98913,"_2383":98914},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2856":58698,"_25078":58694,"_5":25410,"_17499":98916,"_23735":98917,"_2383":98918},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2856":58699,"_25078":58694,"_5":25410,"_17499":98920,"_23735":98921,"_2383":98922},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2856":58700,"_25078":58694,"_5":25410,"_17499":98924,"_23735":98925,"_2383":98926},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2856":58701,"_25078":58694,"_17499":98928,"_5":17394,"_23735":58694,"_2383":98929},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2856":58702,"_25078":58694,"_17499":98931,"_5":17394,"_23735":98909,"_2383":98932},[],"Recorrido",{"_2856":58703,"_25078":58694,"_17499":98934,"_5":17394,"_23735":98909,"_2383":98935},[],"Cuándo existe el dispositivo",{"_2856":58704,"_25078":58694,"_17499":98937,"_5":17394,"_23735":98909,"_2383":98938},[],"Qué compruebas",{"_2856":58705,"_25078":58694,"_17499":98940,"_5":17394,"_23735":98909,"_2383":98941},[],"Asignación manual",{"_2856":58706,"_25078":58694,"_17499":98943,"_5":17394,"_23735":98909,"_2383":98944},[],"El operador lo crea antes de asociar un certificado.",{"_2856":58707,"_25078":58694,"_17499":98946,"_5":17394,"_23735":98909,"_2383":98947},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2856":58708,"_25078":58694,"_17499":98949,"_5":17394,"_23735":98909,"_2383":98950},[],"EST con `JITP`",{"_2856":58709,"_25078":58694,"_17499":98952,"_5":17394,"_23735":98909,"_2383":98953},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2856":58710,"_25078":58694,"_17499":98955,"_5":17394,"_23735":98909,"_2383":98956},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2856":58711,"_25078":58694,"_17499":98958,"_5":17394,"_23735":98909,"_2383":98959},[],"EST con `PRE_REGISTRATION`",{"_2856":58712,"_25078":58694,"_17499":98961,"_5":17394,"_23735":98909,"_2383":98962},[],"Debe existir antes de `/simpleenroll`.",{"_2856":58713,"_25078":58694,"_17499":98964,"_5":17394,"_23735":98909,"_2383":98965},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2856":58714,"_25078":58694,"_17499":98967,"_5":17394,"_23735":98909,"_2383":98968},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2856":58715,"_25078":58694,"_17499":98970,"_5":17394,"_23735":98909,"_2383":98971},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2856":58716,"_25078":58694,"_17499":98973,"_5":17394,"_23735":98913,"_2383":98974},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2856":58717,"_25078":58694,"_17499":98976,"_5":17394,"_23735":98913,"_2383":98977},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2856":58718,"_25078":58694,"_17499":98979,"_5":17394,"_23735":98913,"_2383":98980},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2856":58719,"_25078":58694,"_17499":98982,"_5":17394,"_23735":98917,"_2383":98983},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2856":58720,"_25078":58694,"_17499":98985,"_5":17394,"_23735":98917,"_2383":98986},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2856":58721,"_25078":58694,"_17499":98988,"_5":17394,"_23735":98917,"_2383":98989},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2856":58722,"_25078":58694,"_17499":98991,"_5":17394,"_23735":98917,"_2383":98992},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2856":58723,"_25078":58694,"_17499":98994,"_5":17394,"_23735":98917,"_2383":98995},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2856":58724,"_25078":58694,"_17499":98997,"_5":17394,"_23735":98917,"_2383":98998},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2856":58725,"_25078":58694,"_17499":99000,"_5":17394,"_23735":98921,"_2383":96104},[],{"_2856":58726,"_25078":58694,"_17499":99002,"_5":17394,"_23735":98921,"_2383":99003},[],"Material que atraviesa EST",{"_2856":58727,"_25078":58694,"_17499":99005,"_5":17394,"_23735":98921,"_2383":99006},[],"Clave generada por el dispositivo",{"_2856":58728,"_25078":58694,"_17499":99008,"_5":17394,"_23735":98921,"_2383":99009},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2856":58729,"_25078":58694,"_17499":99011,"_5":17394,"_23735":98921,"_2383":99012},[],"Clave ya disponible en el dispositivo",{"_2856":58730,"_25078":58694,"_17499":99014,"_5":17394,"_23735":98921,"_2383":99015},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2856":58731,"_25078":58694,"_17499":99017,"_5":17394,"_23735":98921,"_2383":43386},[],{"_2856":58732,"_25078":58694,"_17499":99019,"_5":17394,"_23735":98921,"_2383":99020},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2856":58733,"_25078":58694,"_17499":99022,"_5":17394,"_23735":98921,"_2383":99023},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2856":58734,"_25078":58694,"_17499":99025,"_5":17394,"_23735":98925,"_2383":99026},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2856":58735,"_25078":58735,"_5":12261,"_2383":99028,"_25413":99029,"_17499":99030,"_23735":58735},"Renovación y recuperación",[40749,97046,43067,98018,98193],[],{"_2856":58736,"_25078":58735,"_17499":99032,"_5":17394,"_23735":58735,"_2383":99033},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2856":58737,"_25078":58735,"_5":25410,"_17499":99035,"_23735":99036,"_2383":99037},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2856":58738,"_25078":58735,"_5":25410,"_17499":99039,"_23735":99040,"_2383":99041},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2856":58739,"_25078":58735,"_5":25410,"_17499":99043,"_23735":99044,"_2383":99045},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2856":58740,"_25078":58735,"_5":25410,"_17499":99047,"_23735":99048,"_2383":99049},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2856":58741,"_25078":58735,"_5":25410,"_17499":99051,"_23735":99052,"_2383":99053},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2856":58742,"_25078":58735,"_17499":99055,"_5":17394,"_23735":58735,"_2383":99056},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2856":58743,"_25078":58735,"_17499":99058,"_5":17394,"_23735":99036,"_2383":99059},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2856":58744,"_25078":58735,"_17499":99061,"_5":17394,"_23735":99036,"_2383":99062},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2856":58745,"_25078":58735,"_17499":99064,"_5":17394,"_23735":99036,"_2383":99065},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2856":58746,"_25078":58735,"_17499":99067,"_5":17394,"_23735":99036,"_2383":99068},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2856":58747,"_25078":58735,"_17499":99070,"_5":17394,"_23735":99040,"_2383":99071},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2856":58748,"_25078":58735,"_17499":99073,"_5":17394,"_23735":99040,"_2383":99074},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2856":58749,"_25078":58735,"_17499":99076,"_5":17394,"_23735":99044,"_2383":99077},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2856":58750,"_25078":58735,"_17499":99079,"_5":17394,"_23735":99044,"_2383":99080},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2856":58751,"_25078":58735,"_17499":99082,"_5":17394,"_23735":99044,"_2383":99083},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2856":58752,"_25078":58735,"_17499":99085,"_5":17394,"_23735":99048,"_2383":99086},[],"Situación",{"_2856":58753,"_25078":58735,"_17499":99088,"_5":17394,"_23735":99048,"_2383":99089},[],"Procedimiento",{"_2856":58754,"_25078":58735,"_17499":99091,"_5":17394,"_23735":99048,"_2383":99092},[],"Certificado vigente, fuera de ventana",{"_2856":58755,"_25078":58735,"_17499":99094,"_5":17394,"_23735":99048,"_2383":99095},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2856":58756,"_25078":58735,"_17499":99097,"_5":17394,"_23735":99048,"_2383":99098},[],"Certificado vencido, clave disponible",{"_2856":58757,"_25078":58735,"_17499":99100,"_5":17394,"_23735":99048,"_2383":99101},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2856":58758,"_25078":58735,"_17499":99103,"_5":17394,"_23735":99048,"_2383":99104},[],"Renovación por webhook o `NO_AUTH`",{"_2856":58759,"_25078":58735,"_17499":99106,"_5":17394,"_23735":99048,"_2383":99107},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2856":58760,"_25078":58735,"_17499":99109,"_5":17394,"_23735":99048,"_2383":99110},[],"Clave perdida o inaccesible",{"_2856":58761,"_25078":58735,"_17499":99112,"_5":17394,"_23735":99048,"_2383":99113},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2856":58762,"_25078":58735,"_17499":99115,"_5":17394,"_23735":99048,"_2383":99116},[],"Identidad actual revocada",{"_2856":58763,"_25078":58735,"_17499":99118,"_5":17394,"_23735":99048,"_2383":99119},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2856":58764,"_25078":58735,"_17499":99121,"_5":17394,"_23735":99048,"_2383":99122},[],"Dispositivo sin identidad",{"_2856":58765,"_25078":58735,"_17499":99124,"_5":17394,"_23735":99048,"_2383":99125},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2856":58766,"_25078":58735,"_17499":99127,"_5":17394,"_23735":99048,"_2383":99128},[],"Dispositivo retirado",{"_2856":58767,"_25078":58735,"_17499":99130,"_5":17394,"_23735":99048,"_2383":99131},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2856":58768,"_25078":58735,"_17499":99133,"_5":17394,"_23735":99048,"_2383":99134},[],"Timeout, HTTP 500 o fallo de instalación",{"_2856":58769,"_25078":58735,"_17499":99136,"_5":17394,"_23735":99048,"_2383":99137},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2856":58770,"_25078":58735,"_17499":99139,"_5":17394,"_23735":99052,"_2383":99140},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2856":58771,"_25078":58735,"_17499":99142,"_5":17394,"_23735":99052,"_2383":99143},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2856":58772,"_25078":58772,"_5":12261,"_2383":99145,"_25413":99146,"_17499":99147,"_23735":58772},"Diagnóstico de enrolamiento",[40749,97046,43067,98018,98193],[],{"_2856":58773,"_25078":58772,"_17499":99149,"_5":17394,"_23735":58772,"_2383":99150},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2856":58774,"_25078":58772,"_5":25410,"_17499":99152,"_23735":99153,"_2383":99154},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2856":58775,"_25078":58772,"_5":25410,"_17499":99156,"_23735":99157,"_2383":99158},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2856":58776,"_25078":58772,"_5":25410,"_17499":99160,"_23735":99161,"_2383":98717},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2856":58777,"_25078":58772,"_5":25410,"_17499":99163,"_23735":99164,"_2383":99165},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2856":58778,"_25078":58772,"_17499":99167,"_5":17394,"_23735":58772,"_2383":99168},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2856":58779,"_25078":58772,"_17499":99170,"_5":17394,"_23735":99157,"_2383":99171},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2856":58780,"_25078":58772,"_17499":99173,"_5":17394,"_23735":99157,"_2383":99174},[],"Síntoma o mensaje",{"_2856":58781,"_25078":58772,"_17499":99176,"_5":17394,"_23735":99157,"_2383":99177},[],"Qué revisar",{"_2856":58782,"_25078":58772,"_17499":99179,"_5":17394,"_23735":99157,"_2383":99180},[],"curl rechaza TLS, nombre o emisor",{"_2856":58783,"_25078":58772,"_17499":99182,"_5":17394,"_23735":99157,"_2383":99183},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2856":58784,"_25078":58772,"_17499":99185,"_5":17394,"_23735":99157,"_2383":99186},[],"404 o APS ausente",{"_2856":58785,"_25078":58772,"_17499":99188,"_5":17394,"_23735":99157,"_2383":99189},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2856":58786,"_25078":58772,"_17499":99191,"_5":17394,"_23735":99157,"_2383":99192},[],"400, error de CSR o formato",{"_2856":58787,"_25078":58772,"_17499":99194,"_5":17394,"_23735":99157,"_2383":99195},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2856":58788,"_25078":58772,"_17499":99197,"_5":17394,"_23735":99157,"_2383":99198},[],"Credencial ausente o certificado no válido",{"_2856":58789,"_25078":58772,"_17499":99200,"_5":17394,"_23735":99157,"_2383":99201},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2856":58790,"_25078":58772,"_17499":99203,"_5":17394,"_23735":99157,"_2383":99204},[],"Webhook deniega, expira o responde sin autorización",{"_2856":58791,"_25078":58772,"_17499":99206,"_5":17394,"_23735":99157,"_2383":99207},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2856":58792,"_25078":58772,"_17499":99209,"_5":17394,"_23735":99157,"_2383":44303},[],{"_2856":58793,"_25078":58772,"_17499":99211,"_5":17394,"_23735":99157,"_2383":99212},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2856":58794,"_25078":58772,"_17499":99214,"_5":17394,"_23735":99157,"_2383":44309},[],{"_2856":58795,"_25078":58772,"_17499":99216,"_5":17394,"_23735":99157,"_2383":99217},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2856":58796,"_25078":58772,"_17499":99219,"_5":17394,"_23735":99157,"_2383":44315},[],{"_2856":58797,"_25078":58772,"_17499":99221,"_5":17394,"_23735":99157,"_2383":99222},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2856":58798,"_25078":58772,"_17499":99224,"_5":17394,"_23735":99157,"_2383":99225},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2856":58799,"_25078":58772,"_17499":99227,"_5":17394,"_23735":99157,"_2383":99228},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2856":58800,"_25078":58772,"_17499":99230,"_5":17394,"_23735":99157,"_2383":99231},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2856":58801,"_25078":58772,"_17499":99233,"_5":17394,"_23735":99157,"_2383":99234},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2856":58802,"_25078":58772,"_17499":99236,"_5":17394,"_23735":99157,"_2383":44333},[],{"_2856":58803,"_25078":58772,"_17499":99238,"_5":17394,"_23735":99157,"_2383":99239},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2856":58804,"_25078":58772,"_17499":99241,"_5":17394,"_23735":99157,"_2383":44339},[],{"_2856":58805,"_25078":58772,"_17499":99243,"_5":17394,"_23735":99157,"_2383":99244},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2856":58806,"_25078":58772,"_17499":99246,"_5":17394,"_23735":99157,"_2383":99247},[],"DMS propietario distinto",{"_2856":58807,"_25078":58772,"_17499":99249,"_5":17394,"_23735":99157,"_2383":99250},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2856":58808,"_25078":58772,"_17499":99252,"_5":17394,"_23735":99157,"_2383":44351},[],{"_2856":58809,"_25078":58772,"_17499":99254,"_5":17394,"_23735":99157,"_2383":99255},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2856":58810,"_25078":58772,"_17499":99257,"_5":17394,"_23735":99157,"_2383":44357},[],{"_2856":58811,"_25078":58772,"_17499":99259,"_5":17394,"_23735":99157,"_2383":99260},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2856":58812,"_25078":58772,"_17499":99262,"_5":17394,"_23735":99157,"_2383":99263},[],"Certificado actual revocado",{"_2856":58813,"_25078":58772,"_17499":99265,"_5":17394,"_23735":99157,"_2383":99266},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2856":58814,"_25078":58772,"_17499":99268,"_5":17394,"_23735":99157,"_2383":99269},[],"Error de CA, perfil o firma",{"_2856":58815,"_25078":58772,"_17499":99271,"_5":17394,"_23735":99157,"_2383":99272},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2856":58816,"_25078":58772,"_17499":99274,"_5":17394,"_23735":99157,"_2383":99275},[],"HTTP 200 sin conexión del dispositivo",{"_2856":58817,"_25078":58772,"_17499":99277,"_5":17394,"_23735":99157,"_2383":99278},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2856":58818,"_25078":58772,"_17499":99280,"_5":17394,"_23735":99157,"_2383":99281},[],"Timeout o error después de emitir",{"_2856":58819,"_25078":58772,"_17499":99283,"_5":17394,"_23735":99157,"_2383":99284},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2856":58820,"_25078":58772,"_17499":99286,"_5":17394,"_23735":99161,"_2383":99287},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2856":58821,"_25078":58772,"_17499":99289,"_5":17394,"_23735":99161,"_2383":99290},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2856":58822,"_25078":58772,"_17499":99292,"_5":17394,"_23735":99164,"_2383":99293},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2856":58823,"_25078":58772,"_17499":99295,"_5":17394,"_23735":99164,"_2383":99296},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2856":58824,"_25078":58772,"_17499":99298,"_5":17394,"_23735":99164,"_2383":99299},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2856":58825,"_25078":58772,"_17499":99301,"_5":17394,"_23735":99164,"_2383":99302},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2856":58826,"_25078":58772,"_17499":99304,"_5":17394,"_23735":99164,"_2383":99305},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2856":58827,"_25078":58772,"_17499":99307,"_5":17394,"_23735":99164,"_2383":99308},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2856":58828,"_25078":58772,"_17499":99310,"_5":17394,"_23735":99164,"_2383":99311},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2856":58829,"_25078":58829,"_5":12261,"_2383":99313,"_25413":99314,"_17499":99315,"_23735":58829},"Distribución y actualización de confianza",[40749,97046,43067,98018,98193],[],{"_2856":58830,"_25078":58829,"_17499":99317,"_5":17394,"_23735":58829,"_2383":99318},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2856":58831,"_25078":58829,"_5":25410,"_17499":99320,"_23735":99321,"_2383":99322},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2856":58832,"_25078":58829,"_5":25410,"_17499":99324,"_23735":99325,"_2383":99326},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2856":58833,"_25078":58829,"_5":25410,"_17499":99328,"_23735":99329,"_2383":99330},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2856":58834,"_25078":58829,"_5":25410,"_17499":99332,"_23735":99333,"_2383":99334},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2856":58835,"_25078":58829,"_5":25410,"_17499":99336,"_23735":99337,"_2383":99338},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2856":58836,"_25078":58829,"_17499":99340,"_5":17394,"_23735":58829,"_2383":99341},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2856":58837,"_25078":58829,"_17499":99343,"_5":17394,"_23735":99321,"_2383":99344},[],"Relación",{"_2856":58838,"_25078":58829,"_17499":99346,"_5":17394,"_23735":99321,"_2383":99347},[],"Material que prepara el responsable",{"_2856":58839,"_25078":58829,"_17499":99349,"_5":17394,"_23735":99321,"_2383":99350},[],"Dispositivo → servidor EST",{"_2856":58840,"_25078":58829,"_17499":99352,"_5":17394,"_23735":99321,"_2383":99353},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2856":58841,"_25078":58829,"_17499":99355,"_5":17394,"_23735":99321,"_2383":99356},[],"DMS → solicitante",{"_2856":58842,"_25078":58829,"_17499":99358,"_5":17394,"_23735":99321,"_2383":99359},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2856":58843,"_25078":58829,"_17499":99361,"_5":17394,"_23735":99321,"_2383":99362},[],"Consumidor → dispositivo",{"_2856":58844,"_25078":58829,"_17499":99364,"_5":17394,"_23735":99321,"_2383":99365},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2856":58845,"_25078":58829,"_17499":99367,"_5":17394,"_23735":99321,"_2383":99368},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2856":58846,"_25078":58829,"_17499":99370,"_5":17394,"_23735":99325,"_2383":99371},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2856":58847,"_25078":58829,"_17499":99373,"_5":17394,"_23735":99325,"_2383":99374},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2856":58848,"_25078":58829,"_17499":99376,"_5":17394,"_23735":99329,"_2383":99377},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2856":58849,"_25078":58829,"_17499":99379,"_5":17394,"_23735":99329,"_2383":99380},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2856":58850,"_25078":58829,"_17499":99382,"_5":17394,"_23735":99329,"_2383":99383},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2856":58851,"_25078":58829,"_17499":99385,"_5":17394,"_23735":99329,"_2383":99386},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2856":58852,"_25078":58829,"_17499":99388,"_5":17394,"_23735":99329,"_2383":99389},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2856":58853,"_25078":58829,"_17499":99391,"_5":17394,"_23735":99329,"_2383":99392},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2856":58854,"_25078":58829,"_17499":99394,"_5":17394,"_23735":99333,"_2383":99395},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2856":58855,"_25078":58829,"_17499":99397,"_5":17394,"_23735":99333,"_2383":99398},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento. El validador acepta la hoja recibida cuando encadena a la CA de enrolamiento o a una de esas CAs; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2856":58856,"_25078":58829,"_17499":99400,"_5":17394,"_23735":99333,"_2383":99401},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2856":58857,"_25078":58829,"_17499":99403,"_5":17394,"_23735":99337,"_2383":99404},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2856":58858,"_25078":58858,"_5":12261,"_2383":44506,"_25413":99406,"_17499":99408,"_23735":58858},[40749,97046,43067,98018,99407],"Integraciones",[],{"_2856":58859,"_25078":58858,"_17499":99410,"_5":17394,"_23735":58858,"_2383":99411},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2856":58860,"_25078":58858,"_5":25410,"_17499":99413,"_23735":99414,"_2383":99415},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2856":58861,"_25078":58858,"_5":25410,"_17499":99417,"_23735":99418,"_2383":99419},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2856":58862,"_25078":58858,"_5":25410,"_17499":99421,"_23735":99422,"_2383":99423},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2856":58863,"_25078":58858,"_5":25410,"_17499":99425,"_23735":99426,"_2383":99427},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2856":58864,"_25078":58858,"_5":25410,"_17499":99429,"_23735":99430,"_2383":99431},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2856":58865,"_25078":58858,"_5":25410,"_17499":99433,"_23735":99434,"_2383":99435},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2856":58866,"_25078":58858,"_5":25410,"_17499":99437,"_23735":99438,"_2383":44540},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2856":58867,"_25078":58858,"_5":25410,"_17499":99440,"_23735":99441,"_2383":44544},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2856":58868,"_25078":58858,"_5":25410,"_17499":99443,"_23735":99444,"_2383":99445},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2856":58869,"_25078":58858,"_5":25410,"_17499":99447,"_23735":99448,"_2383":99449},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2856":58870,"_25078":58858,"_5":25410,"_17499":99451,"_23735":99452,"_2383":99453},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2856":58871,"_25078":58858,"_5":25410,"_17499":99455,"_23735":99456,"_2383":99457},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2856":58872,"_25078":58858,"_5":25410,"_17499":99459,"_23735":99460,"_2383":99461},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2856":58873,"_25078":58858,"_5":25410,"_17499":99463,"_23735":99464,"_2383":99465},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2856":58874,"_25078":58858,"_5":25410,"_17499":99467,"_23735":99468,"_2383":99469},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2856":58875,"_25078":58858,"_5":25410,"_17499":99471,"_23735":99472,"_2383":99473},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2856":58876,"_25078":58858,"_5":25410,"_17499":99475,"_23735":99476,"_2383":99477},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2856":58877,"_25078":58858,"_5":25410,"_17499":99479,"_23735":99480,"_2383":99481},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2856":58878,"_25078":58858,"_5":25410,"_17499":99483,"_23735":99484,"_2383":99485},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2856":58879,"_25078":58858,"_5":25410,"_17499":99487,"_23735":99488,"_2383":99489},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2856":58880,"_25078":58858,"_17499":99491,"_5":17394,"_23735":58858,"_2383":99492},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2856":58881,"_25078":58858,"_17499":99494,"_5":17394,"_23735":58858,"_2383":99495},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2856":58882,"_25078":58858,"_17499":99497,"_5":17394,"_23735":58858,"_2383":99498},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2856":58883,"_25078":58858,"_17499":99500,"_5":17394,"_23735":99414,"_2383":99501},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2856":58884,"_25078":58858,"_17499":99503,"_5":17394,"_23735":99414,"_2383":99504},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2856":58885,"_25078":58858,"_17499":99506,"_5":17394,"_23735":99414,"_2383":99507},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2856":58886,"_25078":58858,"_17499":99509,"_5":17394,"_23735":99414,"_2383":99510},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2856":58887,"_25078":58858,"_17499":99512,"_5":17394,"_23735":99418,"_2383":99513},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2856":58888,"_25078":58858,"_17499":99515,"_5":17394,"_23735":99422,"_2383":99516},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2856":58889,"_25078":58858,"_17499":99518,"_5":17394,"_23735":99422,"_2383":99519},[],"Acción IAM",{"_2856":58890,"_25078":58858,"_17499":99521,"_5":17394,"_23735":99422,"_2383":96110},[],{"_2856":58891,"_25078":58858,"_17499":99523,"_5":17394,"_23735":99422,"_2383":44627},[],{"_2856":58892,"_25078":58858,"_17499":99525,"_5":17394,"_23735":99422,"_2383":99526},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2856":58893,"_25078":58858,"_17499":99528,"_5":17394,"_23735":99422,"_2383":44633},[],{"_2856":58894,"_25078":58858,"_17499":99530,"_5":17394,"_23735":99422,"_2383":99531},[],"Registrar la CA en AWS IoT",{"_2856":58895,"_25078":58858,"_17499":99533,"_5":17394,"_23735":99422,"_2383":44639},[],{"_2856":58896,"_25078":58858,"_17499":99535,"_5":17394,"_23735":99422,"_2383":99536},[],"Consultar el estado del registro de la CA",{"_2856":58897,"_25078":58858,"_17499":99538,"_5":17394,"_23735":99422,"_2383":44645},[],{"_2856":58898,"_25078":58858,"_17499":99540,"_5":17394,"_23735":99422,"_2383":99541},[],"Crear o actualizar Things en IoT Core",{"_2856":58899,"_25078":58858,"_17499":99543,"_5":17394,"_23735":99422,"_2383":44651},[],{"_2856":58900,"_25078":58858,"_17499":99545,"_5":17394,"_23735":99422,"_2383":99546},[],"Aprovisionar Things mediante plantilla",{"_2856":58901,"_25078":58858,"_17499":99548,"_5":17394,"_23735":99422,"_2383":44657},[],{"_2856":58902,"_25078":58858,"_17499":99550,"_5":17394,"_23735":99422,"_2383":99551},[],"Registrar certificados de dispositivo",{"_2856":58903,"_25078":58858,"_17499":99553,"_5":17394,"_23735":99422,"_2383":44663},[],{"_2856":58904,"_25078":58858,"_17499":99555,"_5":17394,"_23735":99422,"_2383":99556},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2856":58905,"_25078":58858,"_17499":99558,"_5":17394,"_23735":99422,"_2383":44669},[],{"_2856":58906,"_25078":58858,"_17499":99560,"_5":17394,"_23735":99422,"_2383":99561},[],"Crear y adjuntar políticas IoT",{"_2856":58907,"_25078":58858,"_17499":99563,"_5":17394,"_23735":99422,"_2383":44675},[],{"_2856":58908,"_25078":58858,"_17499":99565,"_5":17394,"_23735":99422,"_2383":99566},[],"Gestionar grupos de Things",{"_2856":58909,"_25078":58858,"_17499":99568,"_5":17394,"_23735":99422,"_2383":44681},[],{"_2856":58910,"_25078":58858,"_17499":99570,"_5":17394,"_23735":99422,"_2383":99571},[],"Crear plantillas JITP",{"_2856":58911,"_25078":58858,"_17499":99573,"_5":17394,"_23735":99422,"_2383":44687},[],{"_2856":58912,"_25078":58858,"_17499":99575,"_5":17394,"_23735":99422,"_2383":99576},[],"Leer y escribir el Device Shadow",{"_2856":58913,"_25078":58858,"_17499":99578,"_5":17394,"_23735":99422,"_2383":99579},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2856":58914,"_25078":58858,"_17499":99581,"_5":17394,"_23735":99426,"_2383":99582},[],"Parámetro",{"_2856":58915,"_25078":58858,"_17499":99584,"_5":17394,"_23735":99426,"_2383":99585},[],"Tipo",{"_2856":58916,"_25078":58858,"_17499":99587,"_5":17394,"_23735":99426,"_2383":99588},[],"Requerido",{"_2856":58917,"_25078":58858,"_17499":99590,"_5":17394,"_23735":99426,"_2383":99591},[],"Descripción",{"_2856":58918,"_25078":58858,"_17499":99593,"_5":17394,"_23735":99426,"_2383":44708},[],{"_2856":58919,"_25078":58858,"_17499":99595,"_5":17394,"_23735":99426,"_2383":20884},[],{"_2856":58920,"_25078":58858,"_17499":99597,"_5":17394,"_23735":99426,"_2383":99598},[],"Sí",{"_2856":58921,"_25078":58858,"_17499":99600,"_5":17394,"_23735":99426,"_2383":99601},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2856":58922,"_25078":58858,"_17499":99603,"_5":17394,"_23735":99426,"_2383":44719},[],{"_2856":58923,"_25078":58858,"_17499":99605,"_5":17394,"_23735":99426,"_2383":20884},[],{"_2856":58924,"_25078":58858,"_17499":99607,"_5":17394,"_23735":99426,"_2383":99598},[],{"_2856":58925,"_25078":58858,"_17499":99609,"_5":17394,"_23735":99426,"_2383":99610},[],"Región AWS donde opera el conector.",{"_2856":58926,"_25078":58858,"_17499":99612,"_5":17394,"_23735":99426,"_2383":44729},[],{"_2856":58927,"_25078":58858,"_17499":99614,"_5":17394,"_23735":99426,"_2383":20884},[],{"_2856":58928,"_25078":58858,"_17499":99616,"_5":17394,"_23735":99426,"_2383":99598},[],{"_2856":58929,"_25078":58858,"_17499":99618,"_5":17394,"_23735":99426,"_2383":99619},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2856":58930,"_25078":58858,"_17499":99621,"_5":17394,"_23735":99426,"_2383":44739},[],{"_2856":58931,"_25078":58858,"_17499":99623,"_5":17394,"_23735":99426,"_2383":20884},[],{"_2856":58932,"_25078":58858,"_17499":99625,"_5":17394,"_23735":99426,"_2383":99626},[],"Solo con `auth_method=static`",{"_2856":58933,"_25078":58858,"_17499":99628,"_5":17394,"_23735":99426,"_2383":99629},[],"Clave de acceso AWS.",{"_2856":58934,"_25078":58858,"_17499":99631,"_5":17394,"_23735":99426,"_2383":44750},[],{"_2856":58935,"_25078":58858,"_17499":99633,"_5":17394,"_23735":99426,"_2383":20884},[],{"_2856":58936,"_25078":58858,"_17499":99635,"_5":17394,"_23735":99426,"_2383":99626},[],{"_2856":58937,"_25078":58858,"_17499":99637,"_5":17394,"_23735":99426,"_2383":99638},[],"Clave secreta AWS.",{"_2856":58938,"_25078":58858,"_17499":99640,"_5":17394,"_23735":99426,"_2383":44760},[],{"_2856":58939,"_25078":58858,"_17499":99642,"_5":17394,"_23735":99426,"_2383":20884},[],{"_2856":58940,"_25078":58858,"_17499":99644,"_5":17394,"_23735":99426,"_2383":44765},[],{"_2856":58941,"_25078":58858,"_17499":99646,"_5":17394,"_23735":99426,"_2383":99647},[],"Token de sesión (con `auth_method=static`).",{"_2856":58942,"_25078":58858,"_17499":99649,"_5":17394,"_23735":99426,"_2383":44771},[],{"_2856":58943,"_25078":58858,"_17499":99651,"_5":17394,"_23735":99426,"_2383":20884},[],{"_2856":58944,"_25078":58858,"_17499":99653,"_5":17394,"_23735":99426,"_2383":99654},[],"Solo con `auth_method=role`",{"_2856":58945,"_25078":58858,"_17499":99656,"_5":17394,"_23735":99426,"_2383":99657},[],"ARN del rol a asumir.",{"_2856":58946,"_25078":58858,"_17499":99659,"_5":17394,"_23735":99426,"_2383":44782},[],{"_2856":58947,"_25078":58858,"_17499":99661,"_5":17394,"_23735":99426,"_2383":20884},[],{"_2856":58948,"_25078":58858,"_17499":99663,"_5":17394,"_23735":99426,"_2383":44765},[],{"_2856":58949,"_25078":58858,"_17499":99665,"_5":17394,"_23735":99426,"_2383":99666},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2856":58950,"_25078":58858,"_17499":99668,"_5":17394,"_23735":99426,"_2383":44792},[],{"_2856":58951,"_25078":58858,"_17499":99670,"_5":17394,"_23735":99426,"_2383":14693},[],{"_2856":58952,"_25078":58858,"_17499":99672,"_5":17394,"_23735":99426,"_2383":99598},[],{"_2856":58953,"_25078":58858,"_17499":99674,"_5":17394,"_23735":99426,"_2383":99675},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2856":58954,"_25078":58858,"_17499":99677,"_5":17394,"_23735":99426,"_2383":44802},[],{"_2856":58955,"_25078":58858,"_17499":99679,"_5":17394,"_23735":99426,"_2383":20884},[],{"_2856":58956,"_25078":58858,"_17499":99681,"_5":17394,"_23735":99426,"_2383":99598},[],{"_2856":58957,"_25078":58858,"_17499":99683,"_5":17394,"_23735":99426,"_2383":99684},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2856":58958,"_25078":58858,"_17499":99686,"_5":17394,"_23735":99426,"_2383":44812},[],{"_2856":58959,"_25078":58858,"_17499":99688,"_5":17394,"_23735":99426,"_2383":20884},[],{"_2856":58960,"_25078":58858,"_17499":99690,"_5":17394,"_23735":99426,"_2383":99598},[],{"_2856":58961,"_25078":58858,"_17499":99692,"_5":17394,"_23735":99426,"_2383":99693},[],"URL HTTP del Device Manager de Lamassu.",{"_2856":58962,"_25078":58858,"_17499":99695,"_5":17394,"_23735":99426,"_2383":44822},[],{"_2856":58963,"_25078":58858,"_17499":99697,"_5":17394,"_23735":99426,"_2383":20884},[],{"_2856":58964,"_25078":58858,"_17499":99699,"_5":17394,"_23735":99426,"_2383":99598},[],{"_2856":58965,"_25078":58858,"_17499":99701,"_5":17394,"_23735":99426,"_2383":99702},[],"URL HTTP del servicio de CA de Lamassu.",{"_2856":58966,"_25078":58858,"_17499":99704,"_5":17394,"_23735":99430,"_2383":99705},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2856":58967,"_25078":58858,"_17499":99707,"_5":17394,"_23735":99434,"_2383":99708},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2856":58968,"_25078":58858,"_17499":99710,"_5":17394,"_23735":99434,"_2383":99711},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2856":58969,"_25078":58858,"_17499":99713,"_5":17394,"_23735":99438,"_2383":99714},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2856":58970,"_25078":58858,"_17499":99716,"_5":17394,"_23735":99438,"_2383":99717},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2856":58971,"_25078":58858,"_17499":99719,"_5":17394,"_23735":99438,"_2383":99720},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2856":58972,"_25078":58858,"_17499":99722,"_5":17394,"_23735":99438,"_2383":99723},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2856":58973,"_25078":58858,"_17499":99725,"_5":17394,"_23735":99438,"_2383":99726},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2856":58974,"_25078":58858,"_17499":99728,"_5":17394,"_23735":99438,"_2383":99729},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2856":58975,"_25078":58858,"_17499":99731,"_5":17394,"_23735":99441,"_2383":99732},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2856":58976,"_25078":58858,"_17499":99734,"_5":17394,"_23735":99444,"_2383":99735},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2856":58977,"_25078":58858,"_17499":99737,"_5":17394,"_23735":99444,"_2383":99738},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2856":58978,"_25078":58858,"_17499":99740,"_5":17394,"_23735":99448,"_2383":99741},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2856":58979,"_25078":58858,"_17499":99743,"_5":17394,"_23735":99452,"_2383":99744},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2856":58980,"_25078":58858,"_17499":99746,"_5":17394,"_23735":99452,"_2383":99747},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2856":58981,"_25078":58858,"_17499":99749,"_5":17394,"_23735":99452,"_2383":99750},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2856":58982,"_25078":58858,"_17499":99752,"_5":17394,"_23735":99452,"_2383":99753},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2856":58983,"_25078":58858,"_17499":99755,"_5":17394,"_23735":99452,"_2383":99756},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2856":58984,"_25078":58858,"_17499":99758,"_5":17394,"_23735":99452,"_2383":99759},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2856":58985,"_25078":58858,"_17499":99761,"_5":17394,"_23735":99456,"_2383":99762},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2856":58986,"_25078":58858,"_17499":99764,"_5":17394,"_23735":99456,"_2383":99765},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2856":58987,"_25078":58858,"_17499":99767,"_5":17394,"_23735":99456,"_2383":99768},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2856":58988,"_25078":58858,"_17499":99770,"_5":17394,"_23735":99460,"_2383":99771},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2856":58989,"_25078":58858,"_17499":99773,"_5":17394,"_23735":99460,"_2383":99774},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2856":58990,"_25078":58858,"_17499":99776,"_5":17394,"_23735":99460,"_2383":99777},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2856":58991,"_25078":58858,"_17499":99779,"_5":17394,"_23735":99464,"_2383":99780},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2856":58992,"_25078":58858,"_17499":99782,"_5":17394,"_23735":99464,"_2383":99783},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2856":58993,"_25078":58858,"_17499":99785,"_5":17394,"_23735":99464,"_2383":99786},[],"Para que el flujo JITP funcione correctamente:",{"_2856":58994,"_25078":58858,"_17499":99788,"_5":17394,"_23735":99464,"_2383":99789},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2856":58995,"_25078":58858,"_17499":99791,"_5":17394,"_23735":99464,"_2383":99792},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2856":58996,"_25078":58858,"_17499":99794,"_5":17394,"_23735":99464,"_2383":99795},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2856":58997,"_25078":58858,"_17499":99797,"_5":17394,"_23735":99464,"_2383":99798},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2856":58998,"_25078":58858,"_17499":99800,"_5":17394,"_23735":99468,"_2383":99801},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2856":58999,"_25078":58858,"_17499":99803,"_5":17394,"_23735":99468,"_2383":99804},[],"Estado en Lamassu",{"_2856":59000,"_25078":58858,"_17499":99806,"_5":17394,"_23735":99468,"_2383":99807},[],"Razón de revocación",{"_2856":59001,"_25078":58858,"_17499":99809,"_5":17394,"_23735":99468,"_2383":99810},[],"Estado en AWS IoT Core",{"_2856":59002,"_25078":58858,"_17499":99812,"_5":17394,"_23735":99468,"_2383":44943},[],{"_2856":59003,"_25078":58858,"_17499":99814,"_5":17394,"_23735":99468,"_2383":99815},[],"Ninguna",{"_2856":59004,"_25078":58858,"_17499":99817,"_5":17394,"_23735":99468,"_2383":44949},[],{"_2856":59005,"_25078":58858,"_17499":99819,"_5":17394,"_23735":99468,"_2383":44952},[],{"_2856":59006,"_25078":58858,"_17499":99821,"_5":17394,"_23735":99468,"_2383":44955},[],{"_2856":59007,"_25078":58858,"_17499":99823,"_5":17394,"_23735":99468,"_2383":44958},[],{"_2856":59008,"_25078":58858,"_17499":99825,"_5":17394,"_23735":99468,"_2383":44952},[],{"_2856":59009,"_25078":58858,"_17499":99827,"_5":17394,"_23735":99468,"_2383":99828},[],"Cualquier otra razón",{"_2856":59010,"_25078":58858,"_17499":99830,"_5":17394,"_23735":99468,"_2383":44966},[],{"_2856":59011,"_25078":58858,"_17499":99832,"_5":17394,"_23735":99468,"_2383":99833},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2856":59012,"_25078":58858,"_17499":99835,"_5":17394,"_23735":99472,"_2383":99836},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2856":59013,"_25078":58858,"_17499":99838,"_5":17394,"_23735":99472,"_2383":99839},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2856":59014,"_25078":58858,"_17499":99841,"_5":17394,"_23735":99472,"_2383":99842},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2856":59015,"_25078":58858,"_17499":99844,"_5":17394,"_23735":99476,"_2383":99845},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2856":59016,"_25078":58858,"_17499":99847,"_5":17394,"_23735":99476,"_2383":99848},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2856":59017,"_25078":58858,"_17499":99850,"_5":17394,"_23735":99480,"_2383":99851},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2856":59018,"_25078":58858,"_17499":99853,"_5":17394,"_23735":99480,"_2383":99854},[],"Existen dos tipos de acciones:",{"_2856":59019,"_25078":58858,"_17499":99856,"_5":17394,"_23735":99480,"_2383":99857},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2856":59020,"_25078":58858,"_17499":99859,"_5":17394,"_23735":99480,"_2383":99860},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2856":59021,"_25078":58858,"_17499":99862,"_5":17394,"_23735":99480,"_2383":99863},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2856":59022,"_25078":58858,"_17499":99865,"_5":17394,"_23735":99484,"_2383":99866},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2856":59023,"_25078":58858,"_17499":99868,"_5":17394,"_23735":99484,"_2383":99869},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2856":59024,"_25078":58858,"_17499":99871,"_5":17394,"_23735":99484,"_2383":99872},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2856":59025,"_25078":58858,"_17499":99874,"_5":17394,"_23735":99488,"_2383":99875},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2856":59026,"_25078":58858,"_17499":99877,"_5":17394,"_23735":99488,"_2383":99878},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2856":59027,"_25078":58858,"_17499":99880,"_5":17394,"_23735":99488,"_2383":99881},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2856":59028,"_25078":58858,"_17499":99883,"_5":17394,"_23735":99488,"_2383":99884},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2856":59029,"_25078":58858,"_17499":99886,"_5":17394,"_23735":99488,"_2383":99887},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2856":59030,"_25078":58858,"_17499":99889,"_5":17394,"_23735":99488,"_2383":99890},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2856":59031,"_25078":58858,"_17499":99892,"_5":17394,"_23735":99488,"_2383":99893},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2856":59032,"_25078":58858,"_17499":99895,"_5":17394,"_23735":99488,"_2383":99896},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2856":59033,"_25078":58858,"_17499":99898,"_5":17394,"_23735":99488,"_2383":99899},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2856":59034,"_25078":58858,"_17499":99901,"_5":17394,"_23735":99488,"_2383":99902},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2856":59035,"_25078":58858,"_17499":99904,"_5":17394,"_23735":99488,"_2383":99905},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2856":59036,"_25078":58858,"_17499":99907,"_5":17394,"_23735":99488,"_2383":99908},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2856":59037,"_25078":58858,"_17499":99910,"_5":17394,"_23735":99488,"_2383":99911},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2856":59038,"_25078":58858,"_17499":99913,"_5":17394,"_23735":99488,"_2383":99914},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2856":59039,"_25078":58858,"_17499":99916,"_5":17394,"_23735":99488,"_2383":99917},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2856":59040,"_25078":58858,"_17499":99919,"_5":17394,"_23735":99488,"_2383":99920},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2856":59041,"_25078":58858,"_17499":99922,"_5":17394,"_23735":99488,"_2383":99923},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2856":59042,"_25078":58858,"_17499":99925,"_5":17394,"_23735":99488,"_2383":99926},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2856":59043,"_25078":58858,"_17499":99928,"_5":17394,"_23735":99488,"_2383":99929},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":59044,"_25078":58858,"_17499":99931,"_5":17394,"_23735":99488,"_2383":99932},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2856":59045,"_25078":58858,"_17499":99934,"_5":17394,"_23735":99488,"_2383":99935},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2856":59046,"_25078":59046,"_5":12261,"_2383":43067,"_25413":99937,"_17499":99938,"_23735":59046},[40749,97046,43067],[],{"_2856":59047,"_25078":59046,"_17499":99940,"_5":17394,"_23735":59046,"_2383":99941},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2856":59048,"_25078":59046,"_5":25410,"_17499":99943,"_23735":99944,"_2383":99945},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2856":59049,"_25078":59046,"_5":25410,"_17499":99947,"_23735":99948,"_2383":98018},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2856":59050,"_25078":59046,"_5":25410,"_17499":99950,"_23735":99951,"_2383":98193},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2856":59051,"_25078":59046,"_5":25410,"_17499":99953,"_23735":99954,"_2383":99407},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/overview#integraciones",{"_2856":59052,"_25078":59046,"_5":25410,"_17499":99956,"_23735":99957,"_2383":99958},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2856":59053,"_25078":59046,"_17499":99960,"_5":17394,"_23735":59046,"_2383":99961},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2856":59054,"_25078":59046,"_17499":99963,"_5":17394,"_23735":99944,"_2383":99964},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2856":59055,"_25078":59046,"_17499":99966,"_5":17394,"_23735":99944,"_2383":99967},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2856":59056,"_25078":59046,"_17499":99969,"_5":17394,"_23735":99948,"_2383":99970},[],"Recurso",{"_2856":59057,"_25078":59046,"_17499":99972,"_5":17394,"_23735":99948,"_2383":99973},[],"Qué representa",{"_2856":59058,"_25078":59046,"_17499":99975,"_5":17394,"_23735":99948,"_2383":99976},[],"**Dispositivo**",{"_2856":59059,"_25078":59046,"_17499":99978,"_5":17394,"_23735":99948,"_2383":99979},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2856":59060,"_25078":59046,"_17499":99981,"_5":17394,"_23735":99948,"_2383":99982},[],"**Identidad**",{"_2856":59061,"_25078":59046,"_17499":99984,"_5":17394,"_23735":99948,"_2383":99985},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2856":59062,"_25078":59046,"_17499":99987,"_5":17394,"_23735":99948,"_2383":45124},[],{"_2856":59063,"_25078":59046,"_17499":99989,"_5":17394,"_23735":99948,"_2383":99990},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2856":59064,"_25078":59046,"_17499":99992,"_5":17394,"_23735":99948,"_2383":99993},[],"**Flota**",{"_2856":59065,"_25078":59046,"_17499":99995,"_5":17394,"_23735":99948,"_2383":99996},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2856":59066,"_25078":59046,"_17499":99998,"_5":17394,"_23735":99948,"_2383":99999},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2856":59067,"_25078":59046,"_17499":100001,"_5":17394,"_23735":99948,"_2383":100002},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2856":59068,"_25078":59046,"_17499":100004,"_5":17394,"_23735":99951,"_2383":100005},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2856":59069,"_25078":59046,"_17499":100007,"_5":17394,"_23735":99951,"_2383":100008},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2856":59070,"_25078":59046,"_17499":100010,"_5":17394,"_23735":99951,"_2383":100011},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2856":59071,"_25078":59046,"_17499":100013,"_5":17394,"_23735":99951,"_2383":100014},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2856":59072,"_25078":59046,"_17499":100016,"_5":17394,"_23735":99951,"_2383":100017},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2856":59073,"_25078":59046,"_17499":100019,"_5":17394,"_23735":99951,"_2383":100020},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2856":59074,"_25078":59046,"_17499":100022,"_5":17394,"_23735":99951,"_2383":100023},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":59075,"_25078":59046,"_17499":100025,"_5":17394,"_23735":99951,"_2383":100026},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2856":59076,"_25078":59046,"_17499":100028,"_5":17394,"_23735":99954,"_2383":100029},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2856":59077,"_25078":59046,"_17499":100031,"_5":17394,"_23735":99954,"_2383":100032},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2856":59078,"_25078":59046,"_17499":100034,"_5":17394,"_23735":99957,"_2383":100035},[],"Participante",{"_2856":59079,"_25078":59046,"_17499":100037,"_5":17394,"_23735":99957,"_2383":100038},[],"Responsabilidad",{"_2856":59080,"_25078":59046,"_17499":100040,"_5":17394,"_23735":99957,"_2383":100041},[],"Administrador PKI",{"_2856":59081,"_25078":59046,"_17499":100043,"_5":17394,"_23735":99957,"_2383":100044},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2856":59082,"_25078":59046,"_17499":100046,"_5":17394,"_23735":99957,"_2383":100047},[],"Administrador del aprovisionamiento",{"_2856":59083,"_25078":59046,"_17499":100049,"_5":17394,"_23735":99957,"_2383":100050},[],"DMS, admisión, autenticación por operación e inventario.",{"_2856":59084,"_25078":59046,"_17499":100052,"_5":17394,"_23735":99957,"_2383":100053},[],"Integrador del dispositivo",{"_2856":59085,"_25078":59046,"_17499":100055,"_5":17394,"_23735":99957,"_2383":100056},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2856":59086,"_25078":59046,"_17499":100058,"_5":17394,"_23735":99957,"_2383":100059},[],"Integrador del consumidor",{"_2856":59087,"_25078":59046,"_17499":100061,"_5":17394,"_23735":99957,"_2383":100062},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2856":59088,"_25078":59046,"_17499":100064,"_5":17394,"_23735":99957,"_2383":100065},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2856":59089,"_25078":59089,"_5":12261,"_2383":100067,"_25413":100068,"_17499":100070,"_23735":59089},"Enrola y conecta tu primer dispositivo",[40749,97046,43067,100069],"Primeros pasos",[],{"_2856":59090,"_25078":59089,"_17499":100072,"_5":17394,"_23735":59089,"_2383":100073},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2856":59091,"_25078":59089,"_5":25410,"_17499":100075,"_23735":100076,"_2383":95747},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2856":59092,"_25078":59089,"_5":25410,"_17499":100078,"_23735":100079,"_2383":100080},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2856":59093,"_25078":59089,"_5":25410,"_17499":100082,"_23735":100083,"_2383":100084},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2856":59094,"_25078":59089,"_5":25410,"_17499":100086,"_23735":100087,"_2383":100088},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2856":59095,"_25078":59089,"_5":25410,"_17499":100090,"_23735":100091,"_2383":100092},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2856":59096,"_25078":59089,"_5":25410,"_17499":100094,"_23735":100095,"_2383":100096},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2856":59097,"_25078":59089,"_5":25410,"_17499":100098,"_23735":100099,"_2383":100100},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2856":59098,"_25078":59089,"_5":25410,"_17499":100102,"_23735":100103,"_2383":100104},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2856":59099,"_25078":59089,"_17499":100106,"_5":17394,"_23735":59089,"_2383":100107},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2856":59100,"_25078":59089,"_17499":100109,"_5":17394,"_23735":100076,"_2383":100110},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2856":59101,"_25078":59089,"_17499":100112,"_5":17394,"_23735":100076,"_2383":100113},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2856":59102,"_25078":59089,"_17499":100115,"_5":17394,"_23735":100076,"_2383":100116},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2856":59103,"_25078":59089,"_17499":100118,"_5":17394,"_23735":100076,"_2383":100119},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2856":59104,"_25078":59089,"_17499":100121,"_5":17394,"_23735":100076,"_2383":100122},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2856":59105,"_25078":59089,"_17499":100124,"_5":17394,"_23735":100079,"_2383":100125},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2856":59106,"_25078":59089,"_17499":100127,"_5":17394,"_23735":100079,"_2383":100128},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2856":59107,"_25078":59089,"_17499":100130,"_5":17394,"_23735":100083,"_2383":100131},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2856":59108,"_25078":59089,"_17499":100133,"_5":17394,"_23735":100083,"_2383":100134},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2856":59109,"_25078":59089,"_17499":100136,"_5":17394,"_23735":100083,"_2383":100137},[],"Ajuste",{"_2856":59110,"_25078":59089,"_17499":100139,"_5":17394,"_23735":100083,"_2383":100140},[],"Valor de evaluación",{"_2856":59111,"_25078":59089,"_17499":100142,"_5":17394,"_23735":100083,"_2383":45280},[],{"_2856":59112,"_25078":59089,"_17499":100144,"_5":17394,"_23735":100083,"_2383":100145},[],"Raíz emisora de `device-root.pem`.",{"_2856":59113,"_25078":59089,"_17499":100147,"_5":17394,"_23735":100083,"_2383":98321},[],{"_2856":59114,"_25078":59089,"_17499":100149,"_5":17394,"_23735":100083,"_2383":100150},[],"Perfil final de 1 hora que acabas de preparar.",{"_2856":59115,"_25078":59089,"_17499":100152,"_5":17394,"_23735":100083,"_2383":45291},[],{"_2856":59116,"_25078":59089,"_17499":100154,"_5":17394,"_23735":100083,"_2383":45294},[],{"_2856":59117,"_25078":59089,"_17499":100156,"_5":17394,"_23735":100083,"_2383":45297},[],{"_2856":59118,"_25078":59089,"_17499":100158,"_5":17394,"_23735":100083,"_2383":100159},[],"Habilitado.",{"_2856":59119,"_25078":59089,"_17499":100161,"_5":17394,"_23735":100083,"_2383":45303},[],{"_2856":59120,"_25078":59089,"_17499":100163,"_5":17394,"_23735":100083,"_2383":100164},[],"Deshabilitado; el ID debe ser nuevo.",{"_2856":59121,"_25078":59089,"_17499":100166,"_5":17394,"_23735":100083,"_2383":100167},[],"Autenticación inicial",{"_2856":59122,"_25078":59089,"_17499":100169,"_5":17394,"_23735":100083,"_2383":100170},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2856":59123,"_25078":59089,"_17499":100172,"_5":17394,"_23735":100083,"_2383":100173},[],"Autenticación de renovación",{"_2856":59124,"_25078":59089,"_17499":100175,"_5":17394,"_23735":100083,"_2383":100176},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2856":59125,"_25078":59089,"_17499":100178,"_5":17394,"_23735":100083,"_2383":45321},[],{"_2856":59126,"_25078":59089,"_17499":100180,"_5":17394,"_23735":100083,"_2383":100181},[],"No se necesitan para esta emisión directa; la CA de enrolamiento se incluye siempre / deshabilitado.",{"_2856":59127,"_25078":59089,"_17499":100183,"_5":17394,"_23735":100083,"_2383":45327},[],{"_2856":59128,"_25078":59089,"_17499":100185,"_5":17394,"_23735":100083,"_2383":100186},[],"1 hora.",{"_2856":59129,"_25078":59089,"_17499":100188,"_5":17394,"_23735":100083,"_2383":45333},[],{"_2856":59130,"_25078":59089,"_17499":100190,"_5":17394,"_23735":100083,"_2383":100191},[],"30 minutos / 10 minutos.",{"_2856":59131,"_25078":59089,"_17499":100193,"_5":17394,"_23735":100083,"_2383":45339},[],{"_2856":59132,"_25078":59089,"_17499":100195,"_5":17394,"_23735":100083,"_2383":100196},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2856":59133,"_25078":59089,"_17499":100198,"_5":17394,"_23735":100083,"_2383":43386},[],{"_2856":59134,"_25078":59089,"_17499":100200,"_5":17394,"_23735":100083,"_2383":100201},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2856":59135,"_25078":59089,"_17499":100203,"_5":17394,"_23735":100083,"_2383":45350},[],{"_2856":59136,"_25078":59089,"_17499":100205,"_5":17394,"_23735":100083,"_2383":100206},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2856":59137,"_25078":59089,"_17499":100208,"_5":17394,"_23735":100083,"_2383":100209},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2856":59138,"_25078":59089,"_17499":100211,"_5":17394,"_23735":100087,"_2383":100212},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2856":59139,"_25078":59089,"_17499":100214,"_5":17394,"_23735":100087,"_2383":100215},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2856":59140,"_25078":59089,"_17499":100217,"_5":17394,"_23735":100091,"_2383":100218},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2856":59141,"_25078":59089,"_17499":100220,"_5":17394,"_23735":100091,"_2383":100221},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2856":59142,"_25078":59089,"_17499":100223,"_5":17394,"_23735":100091,"_2383":100224},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2856":59143,"_25078":59089,"_17499":100226,"_5":17394,"_23735":100095,"_2383":100227},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2856":59144,"_25078":59089,"_17499":100229,"_5":17394,"_23735":100095,"_2383":100230},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2856":59145,"_25078":59089,"_17499":100232,"_5":17394,"_23735":100099,"_2383":100233},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2856":59146,"_25078":59089,"_17499":100235,"_5":17394,"_23735":100099,"_2383":100236},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2856":59147,"_25078":59089,"_17499":100238,"_5":17394,"_23735":100099,"_2383":100239},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2856":59148,"_25078":59089,"_17499":100241,"_5":17394,"_23735":100099,"_2383":100242},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2856":59149,"_25078":59089,"_17499":100244,"_5":17394,"_23735":100099,"_2383":100245},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2856":59150,"_25078":59089,"_17499":100247,"_5":17394,"_23735":100103,"_2383":100248},[],"Comprobación",{"_2856":59151,"_25078":59089,"_17499":100250,"_5":17394,"_23735":100103,"_2383":100251},[],"Resultado esperado",{"_2856":59152,"_25078":59089,"_17499":100253,"_5":17394,"_23735":100103,"_2383":100254},[],"Registro",{"_2856":59153,"_25078":59089,"_17499":100256,"_5":17394,"_23735":100103,"_2383":100257},[],"ID creado automáticamente y DMS correcto.",{"_2856":59154,"_25078":59089,"_17499":100259,"_5":17394,"_23735":100103,"_2383":100260},[],"Certificado",{"_2856":59155,"_25078":59089,"_17499":100262,"_5":17394,"_23735":100103,"_2383":100263},[],"CN, perfil, serie y clave verificados.",{"_2856":59156,"_25078":59089,"_17499":100265,"_5":17394,"_23735":100103,"_2383":100266},[],"Inventario",{"_2856":59157,"_25078":59089,"_17499":100268,"_5":17394,"_23735":100103,"_2383":100269},[],"Serie recibida visible como identidad actual y en el historial.",{"_2856":59158,"_25078":59089,"_17499":100271,"_5":17394,"_23735":100103,"_2383":100272},[],"Consumidor",{"_2856":59159,"_25078":59089,"_17499":100274,"_5":17394,"_23735":100103,"_2383":100275},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2856":59160,"_25078":59089,"_17499":100277,"_5":17394,"_23735":100103,"_2383":100278},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2856":59161,"_25078":59089,"_17499":100280,"_5":17394,"_23735":100103,"_2383":100281},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2856":59162,"_25078":59162,"_5":12261,"_2383":98035,"_25413":100283,"_17499":100284,"_23735":59162},[40749,97046,43067,100069],[],{"_2856":59163,"_25078":59162,"_17499":100286,"_5":17394,"_23735":59162,"_2383":100287},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2856":59164,"_25078":59162,"_5":25410,"_17499":100289,"_23735":100290,"_2383":95747},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2856":59165,"_25078":59162,"_5":25410,"_17499":100292,"_23735":100293,"_2383":100294},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2856":59166,"_25078":59162,"_5":25410,"_17499":100296,"_23735":100297,"_2383":100298},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2856":59167,"_25078":59162,"_5":25410,"_17499":100300,"_23735":100301,"_2383":100302},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2856":59168,"_25078":59162,"_5":25410,"_17499":100304,"_23735":100305,"_2383":100306},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2856":59169,"_25078":59162,"_5":25410,"_17499":100308,"_23735":100309,"_2383":100310},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2856":59170,"_25078":59162,"_5":25410,"_17499":100312,"_23735":100313,"_2383":100251},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2856":59171,"_25078":59162,"_5":25410,"_17499":100315,"_23735":100316,"_2383":100317},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2856":59172,"_25078":59162,"_5":25410,"_17499":100319,"_23735":100320,"_2383":100321},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2856":59173,"_25078":59162,"_17499":100323,"_5":17394,"_23735":59162,"_2383":100324},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2856":59174,"_25078":59162,"_17499":100326,"_5":17394,"_23735":59162,"_2383":100327},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2856":59175,"_25078":59162,"_17499":100329,"_5":17394,"_23735":100290,"_2383":100330},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2856":59176,"_25078":59162,"_17499":100332,"_5":17394,"_23735":100290,"_2383":100333},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2856":59177,"_25078":59162,"_17499":100335,"_5":17394,"_23735":100290,"_2383":100336},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2856":59178,"_25078":59162,"_17499":100338,"_5":17394,"_23735":100290,"_2383":100339},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2856":59179,"_25078":59162,"_17499":100341,"_5":17394,"_23735":100293,"_2383":100342},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2856":59180,"_25078":59162,"_17499":100344,"_5":17394,"_23735":100293,"_2383":100345},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2856":59181,"_25078":59162,"_17499":100347,"_5":17394,"_23735":100293,"_2383":100348},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2856":59182,"_25078":59162,"_17499":100350,"_5":17394,"_23735":100293,"_2383":100351},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2856":59183,"_25078":59162,"_17499":100353,"_5":17394,"_23735":100293,"_2383":100354},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_2856":59184,"_25078":59162,"_17499":100356,"_5":17394,"_23735":100293,"_2383":100357},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2856":59185,"_25078":59162,"_17499":100359,"_5":17394,"_23735":100293,"_2383":100360},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2856":59186,"_25078":59162,"_17499":100362,"_5":17394,"_23735":100293,"_2383":100363},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2856":59187,"_25078":59162,"_17499":100365,"_5":17394,"_23735":100297,"_2383":100366},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2856":59188,"_25078":59162,"_17499":100368,"_5":17394,"_23735":100297,"_2383":45516},[],{"_2856":59189,"_25078":59162,"_17499":100370,"_5":17394,"_23735":100297,"_2383":100371},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2856":59190,"_25078":59162,"_17499":100373,"_5":17394,"_23735":100297,"_2383":100374},[],"**Icon** y **Tags**: clasificación opcional.",{"_2856":59191,"_25078":59162,"_17499":100376,"_5":17394,"_23735":100297,"_2383":100377},[],"Confirma el registro.",{"_2856":59192,"_25078":59162,"_17499":100379,"_5":17394,"_23735":100301,"_2383":100380},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2856":59193,"_25078":59162,"_17499":100382,"_5":17394,"_23735":100301,"_2383":100383},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2856":59194,"_25078":59162,"_17499":100385,"_5":17394,"_23735":100305,"_2383":100386},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2856":59195,"_25078":59162,"_17499":100388,"_5":17394,"_23735":100305,"_2383":100389},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2856":59196,"_25078":59162,"_17499":100391,"_5":17394,"_23735":100309,"_2383":100392},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2856":59197,"_25078":59162,"_17499":100394,"_5":17394,"_23735":100309,"_2383":100395},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2856":59198,"_25078":59162,"_17499":100397,"_5":17394,"_23735":100313,"_2383":100248},[],{"_2856":59199,"_25078":59162,"_17499":100399,"_5":17394,"_23735":100313,"_2383":100400},[],"Resultado",{"_2856":59200,"_25078":59162,"_17499":100402,"_5":17394,"_23735":100313,"_2383":100403},[],"Dispositivo",{"_2856":59201,"_25078":59162,"_17499":100405,"_5":17394,"_23735":100313,"_2383":100406},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2856":59202,"_25078":59162,"_17499":100408,"_5":17394,"_23735":100313,"_2383":100409},[],"Identidad actual",{"_2856":59203,"_25078":59162,"_17499":100411,"_5":17394,"_23735":100313,"_2383":100412},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2856":59204,"_25078":59162,"_17499":100414,"_5":17394,"_23735":100313,"_2383":100415},[],"Historial",{"_2856":59205,"_25078":59162,"_17499":100417,"_5":17394,"_23735":100313,"_2383":100418},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2856":59206,"_25078":59162,"_17499":100420,"_5":17394,"_23735":100313,"_2383":100421},[],"Clave y certificado",{"_2856":59207,"_25078":59162,"_17499":100423,"_5":17394,"_23735":100313,"_2383":100424},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2856":59208,"_25078":59162,"_17499":100426,"_5":17394,"_23735":100316,"_2383":100427},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2856":59209,"_25078":59162,"_17499":100429,"_5":17394,"_23735":100316,"_2383":100430},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2856":59210,"_25078":59162,"_17499":100432,"_5":17394,"_23735":100316,"_2383":100433},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2856":59211,"_25078":59162,"_17499":100435,"_5":17394,"_23735":100316,"_2383":100436},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2856":59212,"_25078":59162,"_17499":100438,"_5":17394,"_23735":100320,"_2383":100439},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2856":59213,"_25078":59162,"_17499":100441,"_5":17394,"_23735":100320,"_2383":100442},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2856":59214,"_25078":59162,"_17499":100444,"_5":17394,"_23735":100320,"_2383":100445},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2856":59215,"_25078":59215,"_5":12261,"_2383":100447,"_25413":100448,"_17499":100449,"_23735":59215},"Plataforma Lamassu IoT",[40749,97046],[],{"_2856":59216,"_25078":59215,"_17499":100451,"_5":17394,"_23735":59215,"_2383":100452},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2856":59217,"_25078":59215,"_5":25410,"_17499":100454,"_23735":100455,"_2383":99945},[],"/docs/pr-preview/pr-40/es/platform/overview#empieza-aquí",{"_2856":59218,"_25078":59215,"_5":25410,"_17499":100457,"_23735":100458,"_2383":100459},[],"/docs/pr-preview/pr-40/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2856":59219,"_25078":59215,"_5":25410,"_17499":100461,"_23735":100462,"_2383":100463},[],"/docs/pr-preview/pr-40/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2856":59220,"_25078":59215,"_5":25410,"_17499":100465,"_23735":100466,"_2383":100467},[],"/docs/pr-preview/pr-40/es/platform/overview#capacidades-principales","Capacidades principales",{"_2856":59221,"_25078":59215,"_5":25410,"_17499":100469,"_23735":100470,"_2383":100471},[],"/docs/pr-preview/pr-40/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2856":59222,"_25078":59215,"_5":25410,"_17499":100473,"_23735":100474,"_2383":100475},[],"/docs/pr-preview/pr-40/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2856":59223,"_25078":59215,"_5":25410,"_17499":100477,"_23735":100478,"_2383":100479},[],"/docs/pr-preview/pr-40/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2856":59224,"_25078":59215,"_5":25410,"_17499":100481,"_23735":100482,"_2383":100483},[],"/docs/pr-preview/pr-40/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2856":59225,"_25078":59215,"_5":25410,"_17499":100485,"_23735":100486,"_2383":100487},[],"/docs/pr-preview/pr-40/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2856":59226,"_25078":59215,"_5":25410,"_17499":100489,"_23735":100490,"_2383":100491},[],"/docs/pr-preview/pr-40/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2856":59227,"_25078":59215,"_5":25410,"_17499":100493,"_23735":100494,"_2383":100495},[],"/docs/pr-preview/pr-40/es/platform/overview#referencia-operativa","Referencia operativa",{"_2856":59228,"_25078":59215,"_17499":100497,"_5":17394,"_23735":59215,"_2383":100498},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2856":59229,"_25078":59215,"_17499":100500,"_5":17394,"_23735":100455,"_2383":100501},[],"Elige el resultado que necesitas obtener:",{"_2856":59230,"_25078":59215,"_17499":100503,"_5":17394,"_23735":100455,"_2383":100504},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2856":59231,"_25078":59215,"_17499":100506,"_5":17394,"_23735":100455,"_2383":100507},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2856":59232,"_25078":59215,"_17499":100509,"_5":17394,"_23735":100455,"_2383":100510},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2856":59233,"_25078":59215,"_17499":100512,"_5":17394,"_23735":100458,"_2383":100513},[],"Bloque",{"_2856":59234,"_25078":59215,"_17499":100515,"_5":17394,"_23735":100458,"_2383":100516},[],"Qué gestionas",{"_2856":59235,"_25078":59215,"_17499":100518,"_5":17394,"_23735":100458,"_2383":100519},[],"Punto de entrada",{"_2856":59236,"_25078":59215,"_17499":100521,"_5":17394,"_23735":100458,"_2383":45670},[],{"_2856":59237,"_25078":59215,"_17499":100523,"_5":17394,"_23735":100458,"_2383":100524},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2856":59238,"_25078":59215,"_17499":100526,"_5":17394,"_23735":100458,"_2383":100527},[],"Visión general de PKI",{"_2856":59239,"_25078":59215,"_17499":100529,"_5":17394,"_23735":100458,"_2383":45679},[],{"_2856":59240,"_25078":59215,"_17499":100531,"_5":17394,"_23735":100458,"_2383":100532},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2856":59241,"_25078":59215,"_17499":100534,"_5":17394,"_23735":100458,"_2383":100535},[],"Visión general de IoT Fleets",{"_2856":59242,"_25078":59215,"_17499":100537,"_5":17394,"_23735":100458,"_2383":100538},[],"**Administración**",{"_2856":59243,"_25078":59215,"_17499":100540,"_5":17394,"_23735":100458,"_2383":100541},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2856":59244,"_25078":59215,"_17499":100543,"_5":17394,"_23735":100458,"_2383":97044},[],{"_2856":59245,"_25078":59215,"_17499":100545,"_5":17394,"_23735":100458,"_2383":100546},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2856":59246,"_25078":59215,"_17499":100548,"_5":17394,"_23735":100462,"_2383":100549},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2856":59247,"_25078":59215,"_17499":100551,"_5":17394,"_23735":100462,"_2383":100552},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2856":59248,"_25078":59215,"_17499":100554,"_5":17394,"_23735":100462,"_2383":100555},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2856":59249,"_25078":59215,"_17499":100557,"_5":17394,"_23735":100462,"_2383":100558},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2856":59250,"_25078":59215,"_17499":100560,"_5":17394,"_23735":100462,"_2383":100561},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2856":59251,"_25078":59215,"_17499":100563,"_5":17394,"_23735":100462,"_2383":100564},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2856":59252,"_25078":59215,"_17499":100566,"_5":17394,"_23735":100470,"_2383":100567},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2856":59253,"_25078":59215,"_17499":100569,"_5":17394,"_23735":100474,"_2383":100570},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2856":59254,"_25078":59215,"_17499":100572,"_5":17394,"_23735":100478,"_2383":100573},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2856":59255,"_25078":59215,"_17499":100575,"_5":17394,"_23735":100482,"_2383":100576},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2856":59256,"_25078":59215,"_17499":100578,"_5":17394,"_23735":100486,"_2383":100579},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2856":59257,"_25078":59215,"_17499":100581,"_5":17394,"_23735":100490,"_2383":100582},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2856":59258,"_25078":59215,"_17499":100584,"_5":17394,"_23735":100494,"_2383":100038},[],{"_2856":59259,"_25078":59215,"_17499":100586,"_5":17394,"_23735":100494,"_2383":100587},[],"Qué prepara o comprueba",{"_2856":59260,"_25078":59215,"_17499":100589,"_5":17394,"_23735":100494,"_2383":100041},[],{"_2856":59261,"_25078":59215,"_17499":100591,"_5":17394,"_23735":100494,"_2383":100592},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2856":59262,"_25078":59215,"_17499":100594,"_5":17394,"_23735":100494,"_2383":100595},[],"Administrador de la flota",{"_2856":59263,"_25078":59215,"_17499":100597,"_5":17394,"_23735":100494,"_2383":100598},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2856":59264,"_25078":59215,"_17499":100600,"_5":17394,"_23735":100494,"_2383":100053},[],{"_2856":59265,"_25078":59215,"_17499":100602,"_5":17394,"_23735":100494,"_2383":100603},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2856":59266,"_25078":59215,"_17499":100605,"_5":17394,"_23735":100494,"_2383":100059},[],{"_2856":59267,"_25078":59215,"_17499":100607,"_5":17394,"_23735":100494,"_2383":100608},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2856":59268,"_25078":59215,"_17499":100610,"_5":17394,"_23735":100494,"_2383":100611},[],"Operador de infraestructura",{"_2856":59269,"_25078":59215,"_17499":100613,"_5":17394,"_23735":100494,"_2383":100614},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2856":59270,"_25078":59215,"_17499":100616,"_5":17394,"_23735":100494,"_2383":100617},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2856":59271,"_25078":59271,"_5":12261,"_2383":100619,"_25413":100620,"_17499":100622,"_23735":59271},"Jerarquía y rotación de CAs",[40749,97046,45771,100621],"Claves, autoridades y certificados",[],{"_2856":59272,"_25078":59271,"_17499":100624,"_5":17394,"_23735":59271,"_2383":100625},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2856":59273,"_25078":59271,"_5":25410,"_17499":100627,"_23735":100628,"_2383":100629},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2856":59274,"_25078":59271,"_5":25410,"_17499":100631,"_23735":100632,"_2383":100633},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2856":59275,"_25078":59271,"_5":25410,"_17499":100635,"_23735":100636,"_2383":100637},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2856":59276,"_25078":59271,"_5":25410,"_17499":100639,"_23735":100640,"_2383":100641},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2856":59277,"_25078":59271,"_5":25410,"_17499":100643,"_23735":100644,"_2383":100645},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2856":59278,"_25078":59271,"_5":25410,"_17499":100647,"_23735":100648,"_2383":100649},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2856":59279,"_25078":59271,"_5":25410,"_17499":100651,"_23735":100652,"_2383":100653},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2856":59280,"_25078":59271,"_5":25410,"_17499":100655,"_23735":100656,"_2383":100657},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2856":59281,"_25078":59271,"_5":25410,"_17499":100659,"_23735":100660,"_2383":100661},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2856":59282,"_25078":59271,"_5":25410,"_17499":100663,"_23735":100664,"_2383":100665},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2856":59283,"_25078":59271,"_5":25410,"_17499":100667,"_23735":100668,"_2383":100669},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2856":59284,"_25078":59271,"_5":25410,"_17499":100671,"_23735":100672,"_2383":100673},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2856":59285,"_25078":59271,"_17499":100675,"_5":17394,"_23735":59271,"_2383":100676},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2856":59286,"_25078":59271,"_17499":100678,"_5":17394,"_23735":59271,"_2383":100679},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2856":59287,"_25078":59271,"_17499":100681,"_5":17394,"_23735":100628,"_2383":100682},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2856":59288,"_25078":59271,"_17499":100684,"_5":17394,"_23735":100628,"_2383":100685},[],"entorno, como producción y preproducción;",{"_2856":59289,"_25078":59271,"_17499":100687,"_5":17394,"_23735":100628,"_2383":100688},[],"propietario o equipo operador;",{"_2856":59290,"_25078":59271,"_17499":100690,"_5":17394,"_23735":100628,"_2383":100691},[],"familia de dispositivos o proceso de fabricación;",{"_2856":59291,"_25078":59271,"_17499":100693,"_5":17394,"_23735":100628,"_2383":100694},[],"región o requisito regulatorio;",{"_2856":59292,"_25078":59271,"_17499":100696,"_5":17394,"_23735":100628,"_2383":100697},[],"motor criptográfico o política de clave;",{"_2856":59293,"_25078":59271,"_17499":100699,"_5":17394,"_23735":100628,"_2383":100700},[],"ventana de mantenimiento y ritmo de renovación.",{"_2856":59294,"_25078":59271,"_17499":100702,"_5":17394,"_23735":100628,"_2383":100703},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2856":59295,"_25078":59271,"_17499":100705,"_5":17394,"_23735":100628,"_2383":100706},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2856":59296,"_25078":59271,"_17499":100708,"_5":17394,"_23735":100632,"_2383":100709},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2856":59297,"_25078":59271,"_17499":100711,"_5":17394,"_23735":100632,"_2383":100712},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2856":59298,"_25078":59271,"_17499":100714,"_5":17394,"_23735":100632,"_2383":100715},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2856":59299,"_25078":59271,"_17499":100717,"_5":17394,"_23735":100636,"_2383":100718},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2856":59300,"_25078":59271,"_17499":100720,"_5":17394,"_23735":100636,"_2383":100721},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2856":59301,"_25078":59271,"_17499":100723,"_5":17394,"_23735":100636,"_2383":100724},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2856":59302,"_25078":59271,"_17499":100726,"_5":17394,"_23735":100636,"_2383":100727},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2856":59303,"_25078":59271,"_17499":100729,"_5":17394,"_23735":100644,"_2383":100730},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2856":59304,"_25078":59271,"_17499":100732,"_5":17394,"_23735":100648,"_2383":100733},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2856":59305,"_25078":59271,"_17499":100735,"_5":17394,"_23735":100652,"_2383":100736},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2856":59306,"_25078":59271,"_17499":100738,"_5":17394,"_23735":100656,"_2383":100739},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras los certificados antiguos deban seguir aceptándose en el re-enrolamiento, añade la CA de enrolamiento anterior como CA de validación de re-enrolamiento: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna otra lista, así que sin esa entrada sus certificados ya no podrán renovarse.",{"_2856":59307,"_25078":59271,"_17499":100741,"_5":17394,"_23735":100660,"_2383":100742},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2856":59308,"_25078":59271,"_17499":100744,"_5":17394,"_23735":100664,"_2383":100745},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_2856":59309,"_25078":59271,"_17499":100747,"_5":17394,"_23735":100668,"_2383":100748},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2856":59310,"_25078":59271,"_17499":100750,"_5":17394,"_23735":100668,"_2383":100751},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2856":59311,"_25078":59271,"_17499":100753,"_5":17394,"_23735":100668,"_2383":100754},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2856":59312,"_25078":59271,"_17499":100756,"_5":17394,"_23735":100668,"_2383":100757},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2856":59313,"_25078":59271,"_17499":100759,"_5":17394,"_23735":100672,"_2383":100760},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2856":59314,"_25078":59271,"_17499":100762,"_5":17394,"_23735":100672,"_2383":100763},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2856":59315,"_25078":59271,"_17499":100765,"_5":17394,"_23735":100672,"_2383":100766},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2856":59316,"_25078":59271,"_17499":100768,"_5":17394,"_23735":100672,"_2383":100769},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2856":59317,"_25078":59271,"_17499":100771,"_5":17394,"_23735":100672,"_2383":100772},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2856":59318,"_25078":59271,"_17499":100774,"_5":17394,"_23735":100672,"_2383":100775},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2856":59319,"_25078":59271,"_17499":100777,"_5":17394,"_23735":100672,"_2383":100778},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2856":59320,"_25078":59320,"_5":12261,"_2383":100780,"_25413":100781,"_17499":100782,"_23735":59320},"Autoridades de certificación",[40749,97046,45771,100621],[],{"_2856":59321,"_25078":59320,"_17499":100784,"_5":17394,"_23735":59320,"_2383":100785},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2856":59322,"_25078":59320,"_5":25410,"_17499":100787,"_23735":100788,"_2383":100789},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2856":59323,"_25078":59320,"_5":25410,"_17499":100791,"_23735":100792,"_2383":100793},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2856":59324,"_25078":59320,"_5":25410,"_17499":100795,"_23735":100796,"_2383":95747},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2856":59325,"_25078":59320,"_5":25410,"_17499":100798,"_23735":100799,"_2383":100800},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2856":59326,"_25078":59320,"_5":25410,"_17499":100802,"_23735":100803,"_2383":100804},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2856":59327,"_25078":59320,"_5":25410,"_17499":100806,"_23735":100807,"_2383":100808},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2856":59328,"_25078":59320,"_5":25410,"_17499":100810,"_23735":100811,"_2383":100812},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2856":59329,"_25078":59320,"_5":25410,"_17499":100814,"_23735":100815,"_2383":100816},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2856":59330,"_25078":59320,"_5":25410,"_17499":100818,"_23735":100819,"_2383":100820},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2856":59331,"_25078":59320,"_5":25410,"_17499":100822,"_23735":100823,"_2383":100824},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2856":59332,"_25078":59320,"_5":25410,"_17499":100826,"_23735":100827,"_2383":100828},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2856":59333,"_25078":59320,"_5":25410,"_17499":100830,"_23735":100831,"_2383":100832},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2856":59334,"_25078":59320,"_5":25410,"_17499":100834,"_23735":100835,"_2383":100836},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2856":59335,"_25078":59320,"_5":25410,"_17499":100838,"_23735":100839,"_2383":100840},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2856":59336,"_25078":59320,"_5":25410,"_17499":100842,"_23735":100843,"_2383":100844},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2856":59337,"_25078":59320,"_5":25410,"_17499":100846,"_23735":100847,"_2383":100848},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2856":59338,"_25078":59320,"_5":25410,"_17499":100850,"_23735":100851,"_2383":100852},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2856":59339,"_25078":59320,"_5":25410,"_17499":100854,"_23735":100855,"_2383":100856},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2856":59340,"_25078":59320,"_5":25410,"_17499":100858,"_23735":100859,"_2383":100860},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2856":59341,"_25078":59320,"_5":25410,"_17499":100862,"_23735":100863,"_2383":100864},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2856":59342,"_25078":59320,"_5":25410,"_17499":100866,"_23735":100867,"_2383":100868},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2856":59343,"_25078":59320,"_5":25410,"_17499":100870,"_23735":100871,"_2383":100872},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2856":59344,"_25078":59320,"_17499":100874,"_5":17394,"_23735":59320,"_2383":100875},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2856":59345,"_25078":59320,"_17499":100877,"_5":17394,"_23735":59320,"_2383":100878},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2856":59346,"_25078":59320,"_17499":100880,"_5":17394,"_23735":59320,"_2383":100881},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2856":59347,"_25078":59320,"_17499":100883,"_5":17394,"_23735":100788,"_2383":100884},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2856":59348,"_25078":59320,"_17499":100886,"_5":17394,"_23735":100788,"_2383":100887},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2856":59349,"_25078":59320,"_17499":100889,"_5":17394,"_23735":100788,"_2383":100890},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2856":59350,"_25078":59320,"_17499":100892,"_5":17394,"_23735":100788,"_2383":100893},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2856":59351,"_25078":59320,"_17499":100895,"_5":17394,"_23735":100788,"_2383":100896},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2856":59352,"_25078":59320,"_17499":100898,"_5":17394,"_23735":100796,"_2383":100899},[],"Decide si la CA será raíz o intermedia.",{"_2856":59353,"_25078":59320,"_17499":100901,"_5":17394,"_23735":100796,"_2383":100902},[],"Elige el motor que custodiará la clave.",{"_2856":59354,"_25078":59320,"_17499":100904,"_5":17394,"_23735":100796,"_2383":100905},[],"Define una validez superior a la de los certificados que emitirá.",{"_2856":59355,"_25078":59320,"_17499":100907,"_5":17394,"_23735":100796,"_2383":100908},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2856":59356,"_25078":59320,"_17499":100910,"_5":17394,"_23735":100799,"_2383":100911},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2856":59357,"_25078":59320,"_17499":100913,"_5":17394,"_23735":100803,"_2383":100914},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2856":59358,"_25078":59320,"_17499":100916,"_5":17394,"_23735":100803,"_2383":100917},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2856":59359,"_25078":59320,"_17499":100919,"_5":17394,"_23735":100807,"_2383":100920},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2856":59360,"_25078":59320,"_17499":100922,"_5":17394,"_23735":100811,"_2383":100923},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2856":59361,"_25078":59320,"_17499":100925,"_5":17394,"_23735":100811,"_2383":100926},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2856":59362,"_25078":59320,"_17499":100928,"_5":17394,"_23735":100811,"_2383":100929},[],"`ST`: estado o provincia.",{"_2856":59363,"_25078":59320,"_17499":100931,"_5":17394,"_23735":100811,"_2383":100932},[],"`L`: localidad.",{"_2856":59364,"_25078":59320,"_17499":100934,"_5":17394,"_23735":100811,"_2383":100935},[],"`O`: organización.",{"_2856":59365,"_25078":59320,"_17499":100937,"_5":17394,"_23735":100811,"_2383":100938},[],"`OU`: unidad organizativa.",{"_2856":59366,"_25078":59320,"_17499":100940,"_5":17394,"_23735":100811,"_2383":100941},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2856":59367,"_25078":59320,"_17499":100943,"_5":17394,"_23735":100815,"_2383":100944},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2856":59368,"_25078":59320,"_17499":100946,"_5":17394,"_23735":100815,"_2383":100947},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2856":59369,"_25078":59320,"_17499":100949,"_5":17394,"_23735":100819,"_2383":100950},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2856":59370,"_25078":59320,"_17499":100952,"_5":17394,"_23735":100819,"_2383":100953},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2856":59371,"_25078":59320,"_17499":100955,"_5":17394,"_23735":100823,"_2383":100956},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2856":59372,"_25078":59320,"_17499":100958,"_5":17394,"_23735":100823,"_2383":100959},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2856":59373,"_25078":59320,"_17499":100961,"_5":17394,"_23735":100827,"_2383":100962},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2856":59374,"_25078":59320,"_17499":100964,"_5":17394,"_23735":100831,"_2383":100965},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2856":59375,"_25078":59320,"_17499":100967,"_5":17394,"_23735":100835,"_2383":100968},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2856":59376,"_25078":59320,"_17499":100970,"_5":17394,"_23735":100839,"_2383":100971},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2856":59377,"_25078":59320,"_17499":100973,"_5":17394,"_23735":100843,"_2383":100974},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2856":59378,"_25078":59320,"_17499":100976,"_5":17394,"_23735":100843,"_2383":100977},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2856":59379,"_25078":59320,"_17499":100979,"_5":17394,"_23735":100847,"_2383":100980},[],"Abre una CA desde el inventario para consultar:",{"_2856":59380,"_25078":59320,"_17499":100982,"_5":17394,"_23735":100847,"_2383":100983},[],"Estado y periodo de validez.",{"_2856":59381,"_25078":59320,"_17499":100985,"_5":17394,"_23735":100847,"_2383":100986},[],"Certificado y cadena en formato PEM.",{"_2856":59382,"_25078":59320,"_17499":100988,"_5":17394,"_23735":100847,"_2383":100989},[],"Número de certificados activos, expirados y revocados.",{"_2856":59383,"_25078":59320,"_17499":100991,"_5":17394,"_23735":100847,"_2383":100992},[],"Certificados emitidos en **Issued Certificates**.",{"_2856":59384,"_25078":59320,"_17499":100994,"_5":17394,"_23735":100847,"_2383":100995},[],"CRL vinculada a la autoridad.",{"_2856":59385,"_25078":59320,"_17499":100997,"_5":17394,"_23735":100847,"_2383":100998},[],"Metadatos y motor criptográfico asociado.",{"_2856":59386,"_25078":59320,"_17499":101000,"_5":17394,"_23735":100847,"_2383":101001},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2856":59387,"_25078":59320,"_17499":101003,"_5":17394,"_23735":100851,"_2383":101004},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2856":59388,"_25078":59320,"_17499":101006,"_5":17394,"_23735":100851,"_2383":101007},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2856":59389,"_25078":59320,"_17499":101009,"_5":17394,"_23735":100851,"_2383":101010},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2856":59390,"_25078":59320,"_17499":101012,"_5":17394,"_23735":100851,"_2383":101013},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2856":59391,"_25078":59320,"_17499":101015,"_5":17394,"_23735":100855,"_2383":101016},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2856":59392,"_25078":59320,"_17499":101018,"_5":17394,"_23735":100859,"_2383":101019},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2856":59393,"_25078":59320,"_17499":101021,"_5":17394,"_23735":100863,"_2383":101022},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2856":59394,"_25078":59320,"_17499":101024,"_5":17394,"_23735":100867,"_2383":101025},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2856":59395,"_25078":59320,"_17499":101027,"_5":17394,"_23735":100871,"_2383":101028},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2856":59396,"_25078":59320,"_17499":101030,"_5":17394,"_23735":100871,"_2383":101031},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2856":59397,"_25078":59397,"_5":12261,"_2383":101033,"_25413":101034,"_17499":101035,"_23735":59397},"Perfiles de certificado",[40749,97046,45771,100621],[],{"_2856":59398,"_25078":59397,"_17499":101037,"_5":17394,"_23735":59397,"_2383":101038},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2856":59399,"_25078":59397,"_5":25410,"_17499":101040,"_23735":101041,"_2383":101042},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2856":59400,"_25078":59397,"_5":25410,"_17499":101044,"_23735":101045,"_2383":101046},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#validez","Validez",{"_2856":59401,"_25078":59397,"_5":25410,"_17499":101048,"_23735":101049,"_2383":101050},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2856":59402,"_25078":59397,"_5":25410,"_17499":101052,"_23735":101053,"_2383":101054},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2856":59403,"_25078":59397,"_5":25410,"_17499":101056,"_23735":101057,"_2383":101058},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2856":59404,"_25078":59397,"_5":25410,"_17499":101060,"_23735":101061,"_2383":101062},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2856":59405,"_25078":59397,"_5":25410,"_17499":101064,"_23735":101065,"_2383":101066},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2856":59406,"_25078":59397,"_5":25410,"_17499":101068,"_23735":101069,"_2383":101070},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2856":59407,"_25078":59397,"_5":25410,"_17499":101072,"_23735":101073,"_2383":101074},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2856":59408,"_25078":59397,"_5":25410,"_17499":101076,"_23735":101077,"_2383":101078},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2856":59409,"_25078":59397,"_5":25410,"_17499":101080,"_23735":101081,"_2383":101082},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2856":59410,"_25078":59397,"_5":25410,"_17499":101084,"_23735":101085,"_2383":101086},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2856":59411,"_25078":59397,"_5":25410,"_17499":101088,"_23735":101089,"_2383":101090},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2856":59412,"_25078":59397,"_5":25410,"_17499":101092,"_23735":101093,"_2383":101094},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2856":59413,"_25078":59397,"_5":25410,"_17499":101096,"_23735":101097,"_2383":101098},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2856":59414,"_25078":59397,"_5":25410,"_17499":101100,"_23735":101101,"_2383":101102},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2856":59415,"_25078":59397,"_17499":101104,"_5":17394,"_23735":59397,"_2383":101105},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2856":59416,"_25078":59397,"_17499":101107,"_5":17394,"_23735":59397,"_2383":101108},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2856":59417,"_25078":59397,"_17499":101110,"_5":17394,"_23735":101045,"_2383":101111},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2856":59418,"_25078":59397,"_17499":101113,"_5":17394,"_23735":101045,"_2383":101114},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2856":59419,"_25078":59397,"_17499":101116,"_5":17394,"_23735":101049,"_2383":101117},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2856":59420,"_25078":59397,"_17499":101119,"_5":17394,"_23735":101053,"_2383":101120},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2856":59421,"_25078":59397,"_17499":101122,"_5":17394,"_23735":101053,"_2383":101123},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2856":59422,"_25078":59397,"_17499":101125,"_5":17394,"_23735":101053,"_2383":101126},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2856":59423,"_25078":59397,"_17499":101128,"_5":17394,"_23735":101057,"_2383":101129},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2856":59424,"_25078":59397,"_17499":101131,"_5":17394,"_23735":101061,"_2383":101132},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2856":59425,"_25078":59397,"_17499":101134,"_5":17394,"_23735":101061,"_2383":101135},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2856":59426,"_25078":59397,"_17499":101137,"_5":17394,"_23735":101065,"_2383":101138},[],"La aplicación criptográfica puede:",{"_2856":59427,"_25078":59397,"_17499":101140,"_5":17394,"_23735":101065,"_2383":101141},[],"permitir o bloquear claves RSA;",{"_2856":59428,"_25078":59397,"_17499":101143,"_5":17394,"_23735":101065,"_2383":101144},[],"limitar los tamaños RSA admitidos;",{"_2856":59429,"_25078":59397,"_17499":101146,"_5":17394,"_23735":101065,"_2383":101147},[],"permitir o bloquear claves ECDSA;",{"_2856":59430,"_25078":59397,"_17499":101149,"_5":17394,"_23735":101065,"_2383":101150},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2856":59431,"_25078":59397,"_17499":101152,"_5":17394,"_23735":101065,"_2383":101153},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2856":59432,"_25078":59397,"_17499":101155,"_5":17394,"_23735":101069,"_2383":101156},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2856":59433,"_25078":59397,"_17499":101158,"_5":17394,"_23735":101069,"_2383":96837},[],{"_2856":59434,"_25078":59397,"_17499":101160,"_5":17394,"_23735":101069,"_2383":101161},[],"Primera opción",{"_2856":59435,"_25078":59397,"_17499":101163,"_5":17394,"_23735":101069,"_2383":101164},[],"Segunda opción",{"_2856":59436,"_25078":59397,"_17499":101166,"_5":17394,"_23735":101069,"_2383":101167},[],"Si no hay ninguna",{"_2856":59437,"_25078":59397,"_17499":101169,"_5":17394,"_23735":101069,"_2383":101170},[],"Firma directa con una CA",{"_2856":59438,"_25078":59397,"_17499":101172,"_5":17394,"_23735":101069,"_2383":101173},[],"`issuance_profile` incluido en la solicitud",{"_2856":59439,"_25078":59397,"_17499":101175,"_5":17394,"_23735":101069,"_2383":101176},[],"`issuance_profile_id` de la solicitud",{"_2856":59440,"_25078":59397,"_17499":101178,"_5":17394,"_23735":101069,"_2383":101179},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2856":59441,"_25078":59397,"_17499":101181,"_5":17394,"_23735":101069,"_2383":101182},[],"Emisión mediante DMS",{"_2856":59442,"_25078":59397,"_17499":101184,"_5":17394,"_23735":101069,"_2383":46336},[],{"_2856":59443,"_25078":59397,"_17499":101186,"_5":17394,"_23735":101069,"_2383":101187},[],"`settings.issuance_profile` incluido en el DMS",{"_2856":59444,"_25078":59397,"_17499":101189,"_5":17394,"_23735":101069,"_2383":101190},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2856":59445,"_25078":59397,"_17499":101192,"_5":17394,"_23735":101069,"_2383":101193},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2856":59446,"_25078":59397,"_17499":101195,"_5":17394,"_23735":101069,"_2383":101196},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2856":59447,"_25078":59397,"_17499":101198,"_5":17394,"_23735":101077,"_2383":101199},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2856":59448,"_25078":59397,"_17499":101201,"_5":17394,"_23735":101081,"_2383":101202},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2856":59449,"_25078":59397,"_17499":101204,"_5":17394,"_23735":101085,"_2383":101205},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2856":59450,"_25078":59397,"_17499":101207,"_5":17394,"_23735":101089,"_2383":101208},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2856":59451,"_25078":59397,"_17499":101210,"_5":17394,"_23735":101093,"_2383":101211},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2856":59452,"_25078":59397,"_17499":101213,"_5":17394,"_23735":101093,"_2383":101214},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2856":59453,"_25078":59397,"_17499":101216,"_5":17394,"_23735":101097,"_2383":101217},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2856":59454,"_25078":59397,"_17499":101219,"_5":17394,"_23735":101097,"_2383":101220},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2856":59455,"_25078":59397,"_17499":101222,"_5":17394,"_23735":101097,"_2383":101223},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2856":59456,"_25078":59397,"_17499":101225,"_5":17394,"_23735":101097,"_2383":101226},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2856":59457,"_25078":59397,"_17499":101228,"_5":17394,"_23735":101101,"_2383":101229},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2856":59458,"_25078":59397,"_17499":101231,"_5":17394,"_23735":101101,"_2383":101232},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2856":59459,"_25078":59459,"_5":12261,"_2383":101234,"_25413":101235,"_17499":101237,"_23735":59459},"Validación de certificados",[40749,97046,45771,101236],"Validación",[],{"_2856":59460,"_25078":59459,"_17499":101239,"_5":17394,"_23735":59459,"_2383":101240},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2856":59461,"_25078":59459,"_5":25410,"_17499":101242,"_23735":101243,"_2383":101244},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2856":59462,"_25078":59459,"_5":25410,"_17499":101246,"_23735":101247,"_2383":101248},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2856":59463,"_25078":59459,"_5":25410,"_17499":101250,"_23735":101251,"_2383":101252},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2856":59464,"_25078":59459,"_17499":101254,"_5":17394,"_23735":59459,"_2383":101255},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2856":59465,"_25078":59459,"_17499":101257,"_5":17394,"_23735":101243,"_2383":101258},[],"Verifica estos criterios juntos:",{"_2856":59466,"_25078":59459,"_17499":101260,"_5":17394,"_23735":101243,"_2383":100248},[],{"_2856":59467,"_25078":59459,"_17499":101262,"_5":17394,"_23735":101243,"_2383":101263},[],"Resultado necesario",{"_2856":59468,"_25078":59459,"_17499":101265,"_5":17394,"_23735":101243,"_2383":101266},[],"Cadena y firma",{"_2856":59469,"_25078":59459,"_17499":101268,"_5":17394,"_23735":101243,"_2383":101269},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2856":59470,"_25078":59459,"_17499":101271,"_5":17394,"_23735":101243,"_2383":101272},[],"Fechas",{"_2856":59471,"_25078":59459,"_17499":101274,"_5":17394,"_23735":101243,"_2383":101275},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2856":59472,"_25078":59459,"_17499":101277,"_5":17394,"_23735":101243,"_2383":96750},[],{"_2856":59473,"_25078":59459,"_17499":101279,"_5":17394,"_23735":101243,"_2383":101280},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2856":59474,"_25078":59459,"_17499":101282,"_5":17394,"_23735":101243,"_2383":101283},[],"Uso",{"_2856":59475,"_25078":59459,"_17499":101285,"_5":17394,"_23735":101243,"_2383":101286},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2856":59476,"_25078":59459,"_17499":101288,"_5":17394,"_23735":101243,"_2383":101289},[],"Revocación",{"_2856":59477,"_25078":59459,"_17499":101291,"_5":17394,"_23735":101243,"_2383":101292},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2856":59478,"_25078":59459,"_17499":101294,"_5":17394,"_23735":101243,"_2383":101295},[],"Autorización",{"_2856":59479,"_25078":59459,"_17499":101297,"_5":17394,"_23735":101243,"_2383":101298},[],"La aplicación permite la acción a esa identidad.",{"_2856":59480,"_25078":59459,"_17499":101300,"_5":17394,"_23735":101243,"_2383":101301},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2856":59481,"_25078":59459,"_17499":101303,"_5":17394,"_23735":101247,"_2383":101304},[],"Mecanismo",{"_2856":59482,"_25078":59459,"_17499":101306,"_5":17394,"_23735":101247,"_2383":101307},[],"Cuándo utilizarlo",{"_2856":59483,"_25078":59459,"_17499":101309,"_5":17394,"_23735":101247,"_2383":101310},[],"Qué debes mantener",{"_2856":59484,"_25078":59459,"_17499":101312,"_5":17394,"_23735":101247,"_2383":46464},[],{"_2856":59485,"_25078":59459,"_17499":101314,"_5":17394,"_23735":101247,"_2383":101315},[],"Consulta del estado de un certificado concreto.",{"_2856":59486,"_25078":59459,"_17499":101317,"_5":17394,"_23735":101247,"_2383":101318},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2856":59487,"_25078":59459,"_17499":101320,"_5":17394,"_23735":101247,"_2383":46473},[],{"_2856":59488,"_25078":59459,"_17499":101322,"_5":17394,"_23735":101247,"_2383":101323},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2856":59489,"_25078":59459,"_17499":101325,"_5":17394,"_23735":101247,"_2383":101326},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2856":59490,"_25078":59459,"_17499":101328,"_5":17394,"_23735":101247,"_2383":101329},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2856":59491,"_25078":59459,"_17499":101331,"_5":17394,"_23735":101247,"_2383":101332},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2856":59492,"_25078":59459,"_17499":101334,"_5":17394,"_23735":101251,"_2383":101335},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2856":59493,"_25078":59459,"_17499":101337,"_5":17394,"_23735":101251,"_2383":101338},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2856":59494,"_25078":59459,"_17499":101340,"_5":17394,"_23735":101251,"_2383":101341},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2856":59495,"_25078":59459,"_17499":101343,"_5":17394,"_23735":101251,"_2383":101344},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2856":59496,"_25078":59459,"_17499":101346,"_5":17394,"_23735":101251,"_2383":101347},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2856":59497,"_25078":59459,"_17499":101349,"_5":17394,"_23735":101251,"_2383":101350},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2856":59498,"_25078":59459,"_17499":101352,"_5":17394,"_23735":101251,"_2383":101353},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2856":59499,"_25078":59459,"_17499":101355,"_5":17394,"_23735":101251,"_2383":101356},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":59500,"_25078":59459,"_17499":101358,"_5":17394,"_23735":101251,"_2383":101359},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2856":59501,"_25078":59501,"_5":12261,"_2383":101361,"_25413":101362,"_17499":101363,"_23735":59501},"Certificados",[40749,97046,45771,100621],[],{"_2856":59502,"_25078":59501,"_17499":101365,"_5":17394,"_23735":59501,"_2383":101366},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2856":59503,"_25078":59501,"_5":25410,"_17499":101368,"_23735":101369,"_2383":101370},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2856":59504,"_25078":59501,"_5":25410,"_17499":101372,"_23735":101373,"_2383":101374},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2856":59505,"_25078":59501,"_5":25410,"_17499":101376,"_23735":101377,"_2383":101378},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2856":59506,"_25078":59501,"_5":25410,"_17499":101380,"_23735":101381,"_2383":101382},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2856":59507,"_25078":59501,"_5":25410,"_17499":101384,"_23735":101385,"_2383":101386},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2856":59508,"_25078":59501,"_5":25410,"_17499":101388,"_23735":101389,"_2383":101390},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2856":59509,"_25078":59501,"_5":25410,"_17499":101392,"_23735":101393,"_2383":101394},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2856":59510,"_25078":59501,"_5":25410,"_17499":101396,"_23735":101397,"_2383":101398},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2856":59511,"_25078":59501,"_5":25410,"_17499":101400,"_23735":101401,"_2383":101402},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#continúa","Continúa",{"_2856":59512,"_25078":59501,"_17499":101404,"_5":17394,"_23735":59501,"_2383":101405},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2856":59513,"_25078":59501,"_17499":101407,"_5":17394,"_23735":101369,"_2383":101408},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2856":59514,"_25078":59501,"_17499":101410,"_5":17394,"_23735":101369,"_2383":101411},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2856":59515,"_25078":59501,"_17499":101413,"_5":17394,"_23735":101373,"_2383":101414},[],"Descarga el PEM e inspecciónalo:",{"_2856":59516,"_25078":59501,"_17499":101416,"_5":17394,"_23735":101373,"_2383":101417},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2856":59517,"_25078":59501,"_17499":101419,"_5":17394,"_23735":101377,"_2383":101420},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2856":59518,"_25078":59501,"_17499":101422,"_5":17394,"_23735":101377,"_2383":101423},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2856":59519,"_25078":59501,"_17499":101425,"_5":17394,"_23735":101377,"_2383":101426},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2856":59520,"_25078":59501,"_17499":101428,"_5":17394,"_23735":101377,"_2383":101429},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2856":59521,"_25078":59501,"_17499":101431,"_5":17394,"_23735":101377,"_2383":101432},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2856":59522,"_25078":59501,"_17499":101434,"_5":17394,"_23735":101377,"_2383":101435},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2856":59523,"_25078":59501,"_17499":101437,"_5":17394,"_23735":101377,"_2383":101438},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2856":59524,"_25078":59501,"_17499":101440,"_5":17394,"_23735":101381,"_2383":101441},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2856":59525,"_25078":59501,"_17499":101443,"_5":17394,"_23735":101385,"_2383":101444},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2856":59526,"_25078":59501,"_17499":101446,"_5":17394,"_23735":101389,"_2383":101447},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2856":59527,"_25078":59501,"_17499":101449,"_5":17394,"_23735":101393,"_2383":101450},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2856":59528,"_25078":59501,"_17499":101452,"_5":17394,"_23735":101393,"_2383":101453},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2856":59529,"_25078":59501,"_17499":101455,"_5":17394,"_23735":101393,"_2383":101456},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2856":59530,"_25078":59501,"_17499":101458,"_5":17394,"_23735":101397,"_2383":101459},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2856":59531,"_25078":59501,"_17499":101461,"_5":17394,"_23735":101397,"_2383":101462},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2856":59532,"_25078":59501,"_17499":101464,"_5":17394,"_23735":101397,"_2383":101465},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2856":59533,"_25078":59501,"_17499":101467,"_5":17394,"_23735":101401,"_2383":101468},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":59534,"_25078":59501,"_17499":101470,"_5":17394,"_23735":101401,"_2383":101471},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2856":59535,"_25078":59535,"_5":12261,"_2383":101473,"_25413":101474,"_17499":101476,"_23735":59535},"Ciclo de vida de un certificado",[40749,97046,45771,101475],"Conceptos",[],{"_2856":59536,"_25078":59535,"_17499":101478,"_5":17394,"_23735":59535,"_2383":101479},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2856":59537,"_25078":59535,"_5":25410,"_17499":101481,"_23735":101482,"_2383":101483},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2856":59538,"_25078":59535,"_5":25410,"_17499":101485,"_23735":101486,"_2383":101487},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2856":59539,"_25078":59535,"_5":25410,"_17499":101489,"_23735":101490,"_2383":101491},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2856":59540,"_25078":59535,"_5":25410,"_17499":101493,"_23735":101494,"_2383":101495},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2856":59541,"_25078":59535,"_5":25410,"_17499":101497,"_23735":101498,"_2383":101499},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2856":59542,"_25078":59535,"_5":25410,"_17499":101501,"_23735":101502,"_2383":101503},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2856":59543,"_25078":59535,"_5":25410,"_17499":101505,"_23735":101506,"_2383":101507},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2856":59544,"_25078":59535,"_5":25410,"_17499":101509,"_23735":101510,"_2383":101511},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2856":59545,"_25078":59535,"_5":25410,"_17499":101513,"_23735":101514,"_2383":101515},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2856":59546,"_25078":59535,"_5":25410,"_17499":101517,"_23735":101518,"_2383":101519},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2856":59547,"_25078":59535,"_17499":101521,"_5":17394,"_23735":59535,"_2383":101522},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2856":59548,"_25078":59535,"_17499":101524,"_5":17394,"_23735":101486,"_2383":101525},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2856":59549,"_25078":59535,"_17499":101527,"_5":17394,"_23735":101490,"_2383":101528},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2856":59550,"_25078":59535,"_17499":101530,"_5":17394,"_23735":101494,"_2383":101531},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2856":59551,"_25078":59535,"_17499":101533,"_5":17394,"_23735":101498,"_2383":101534},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2856":59552,"_25078":59535,"_17499":101536,"_5":17394,"_23735":101502,"_2383":101537},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2856":59553,"_25078":59535,"_17499":101539,"_5":17394,"_23735":101506,"_2383":101540},[],"Lamassu persiste cuatro estados X.509:",{"_2856":59554,"_25078":59535,"_17499":101542,"_5":17394,"_23735":101506,"_2383":101543},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2856":59555,"_25078":59535,"_17499":101545,"_5":17394,"_23735":101506,"_2383":101546},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2856":59556,"_25078":59535,"_17499":101548,"_5":17394,"_23735":101506,"_2383":101549},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2856":59557,"_25078":59535,"_17499":101551,"_5":17394,"_23735":101506,"_2383":101552},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2856":59558,"_25078":59535,"_17499":101554,"_5":17394,"_23735":101506,"_2383":101555},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2856":59559,"_25078":59535,"_17499":101557,"_5":17394,"_23735":101510,"_2383":101558},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2856":59560,"_25078":59535,"_17499":101560,"_5":17394,"_23735":101510,"_2383":101561},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2856":59561,"_25078":59535,"_17499":101563,"_5":17394,"_23735":101510,"_2383":101564},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2856":59562,"_25078":59535,"_17499":101566,"_5":17394,"_23735":101514,"_2383":101567},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2856":59563,"_25078":59535,"_17499":101569,"_5":17394,"_23735":101514,"_2383":101570},[],"Antes de confirmar:",{"_2856":59564,"_25078":59535,"_17499":101572,"_5":17394,"_23735":101514,"_2383":101573},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2856":59565,"_25078":59535,"_17499":101575,"_5":17394,"_23735":101514,"_2383":101576},[],"Distribuye la nueva cadena de confianza.",{"_2856":59566,"_25078":59535,"_17499":101578,"_5":17394,"_23735":101514,"_2383":101579},[],"Reemite las identidades necesarias.",{"_2856":59567,"_25078":59535,"_17499":101581,"_5":17394,"_23735":101514,"_2383":101582},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2856":59568,"_25078":59535,"_17499":101584,"_5":17394,"_23735":101514,"_2383":101585},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2856":59569,"_25078":59535,"_17499":101587,"_5":17394,"_23735":101514,"_2383":101588},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2856":59570,"_25078":59535,"_17499":101590,"_5":17394,"_23735":101518,"_2383":101591},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2856":59571,"_25078":59535,"_17499":101593,"_5":17394,"_23735":101518,"_2383":101594},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2856":59572,"_25078":59535,"_17499":101596,"_5":17394,"_23735":101518,"_2383":101597},[],"Cambios de estado y razones de revocación.",{"_2856":59573,"_25078":59535,"_17499":101599,"_5":17394,"_23735":101518,"_2383":101600},[],"Publicación y vigencia de OCSP y CRLs.",{"_2856":59574,"_25078":59535,"_17499":101602,"_5":17394,"_23735":101518,"_2383":101603},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2856":59575,"_25078":59535,"_17499":101605,"_5":17394,"_23735":101518,"_2383":101606},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2856":59576,"_25078":59576,"_5":12261,"_2383":101608,"_25413":101609,"_17499":101610,"_23735":59576},"Modelo de confianza",[40749,97046,45771,101475],[],{"_2856":59577,"_25078":59576,"_17499":101612,"_5":17394,"_23735":59576,"_2383":101613},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2856":59578,"_25078":59576,"_5":25410,"_17499":101615,"_23735":101616,"_2383":101617},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2856":59579,"_25078":59576,"_5":25410,"_17499":101619,"_23735":101620,"_2383":101621},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2856":59580,"_25078":59576,"_5":25410,"_17499":101623,"_23735":101624,"_2383":101625},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2856":59581,"_25078":59576,"_5":25410,"_17499":101627,"_23735":101628,"_2383":101629},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2856":59582,"_25078":59576,"_5":25410,"_17499":101631,"_23735":101632,"_2383":101633},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2856":59583,"_25078":59576,"_5":25410,"_17499":101635,"_23735":101636,"_2383":101637},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2856":59584,"_25078":59576,"_5":25410,"_17499":101639,"_23735":101640,"_2383":101641},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2856":59585,"_25078":59576,"_5":25410,"_17499":101643,"_23735":101644,"_2383":101645},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2856":59586,"_25078":59576,"_5":25410,"_17499":101647,"_23735":101648,"_2383":101649},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2856":59587,"_25078":59576,"_5":25410,"_17499":101651,"_23735":101652,"_2383":101653},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2856":59588,"_25078":59576,"_17499":101655,"_5":17394,"_23735":59576,"_2383":101656},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2856":59589,"_25078":59576,"_17499":101658,"_5":17394,"_23735":101620,"_2383":101659},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2856":59590,"_25078":59576,"_17499":101661,"_5":17394,"_23735":101624,"_2383":101662},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2856":59591,"_25078":59576,"_17499":101664,"_5":17394,"_23735":101628,"_2383":101665},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2856":59592,"_25078":59576,"_17499":101667,"_5":17394,"_23735":101632,"_2383":101668},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2856":59593,"_25078":59576,"_17499":101670,"_5":17394,"_23735":101636,"_2383":101671},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2856":59594,"_25078":59576,"_17499":101673,"_5":17394,"_23735":101636,"_2383":101674},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2856":59595,"_25078":59576,"_17499":101676,"_5":17394,"_23735":101636,"_2383":101677},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2856":59596,"_25078":59576,"_17499":101679,"_5":17394,"_23735":101636,"_2383":101680},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2856":59597,"_25078":59576,"_17499":101682,"_5":17394,"_23735":101636,"_2383":101683},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2856":59598,"_25078":59576,"_17499":101685,"_5":17394,"_23735":101636,"_2383":101686},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2856":59599,"_25078":59576,"_17499":101688,"_5":17394,"_23735":101640,"_2383":101689},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2856":59600,"_25078":59576,"_17499":101691,"_5":17394,"_23735":101640,"_2383":101692},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2856":59601,"_25078":59576,"_17499":101694,"_5":17394,"_23735":101640,"_2383":101695},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y también se aceptan las CAs de validación de re-enrolamiento; estas son opcionales.",{"_2856":59602,"_25078":59576,"_17499":101697,"_5":17394,"_23735":101640,"_2383":101698},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2856":59603,"_25078":59576,"_17499":101700,"_5":17394,"_23735":101640,"_2383":101701},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2856":59604,"_25078":59576,"_17499":101703,"_5":17394,"_23735":101644,"_2383":101704},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2856":59605,"_25078":59576,"_17499":101706,"_5":17394,"_23735":101644,"_2383":101707},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2856":59606,"_25078":59576,"_17499":101709,"_5":17394,"_23735":101644,"_2383":101710},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2856":59607,"_25078":59576,"_17499":101712,"_5":17394,"_23735":101644,"_2383":101713},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2856":59608,"_25078":59576,"_17499":101715,"_5":17394,"_23735":101644,"_2383":101716},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2856":59609,"_25078":59576,"_17499":101718,"_5":17394,"_23735":101644,"_2383":101719},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2856":59610,"_25078":59576,"_17499":101721,"_5":17394,"_23735":101644,"_2383":101722},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2856":59611,"_25078":59576,"_17499":101724,"_5":17394,"_23735":101648,"_2383":101725},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2856":59612,"_25078":59576,"_17499":101727,"_5":17394,"_23735":101652,"_2383":101728},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2856":59613,"_25078":59576,"_17499":101730,"_5":17394,"_23735":101652,"_2383":101731},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2856":59614,"_25078":59576,"_17499":101733,"_5":17394,"_23735":101652,"_2383":101734},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2856":59615,"_25078":59576,"_17499":101736,"_5":17394,"_23735":101652,"_2383":101737},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2856":59616,"_25078":59576,"_17499":101739,"_5":17394,"_23735":101652,"_2383":101740},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2856":59617,"_25078":59576,"_17499":101742,"_5":17394,"_23735":101652,"_2383":101743},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2856":59618,"_25078":59576,"_17499":101745,"_5":17394,"_23735":101652,"_2383":101746},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2856":59619,"_25078":59619,"_5":12261,"_2383":101748,"_25413":101749,"_17499":101750,"_23735":59619},"Listas de revocación (CRL)",[40749,97046,45771,101236],[],{"_2856":59620,"_25078":59619,"_17499":101752,"_5":17394,"_23735":59619,"_2383":101753},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2856":59621,"_25078":59619,"_5":25410,"_17499":101755,"_23735":101756,"_2383":101757},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2856":59622,"_25078":59619,"_5":25410,"_17499":101759,"_23735":101760,"_2383":101761},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2856":59623,"_25078":59619,"_5":25410,"_17499":101763,"_23735":101764,"_2383":101765},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2856":59624,"_25078":59619,"_5":25410,"_17499":101767,"_23735":101768,"_2383":101769},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2856":59625,"_25078":59619,"_5":25410,"_17499":101771,"_23735":101772,"_2383":101773},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2856":59626,"_25078":59619,"_5":25410,"_17499":101775,"_23735":101776,"_2383":101777},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2856":59627,"_25078":59619,"_5":25410,"_17499":101779,"_23735":101780,"_2383":101781},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#referencias","Referencias",{"_2856":59628,"_25078":59619,"_17499":101783,"_5":17394,"_23735":59619,"_2383":101784},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2856":59629,"_25078":59619,"_17499":101786,"_5":17394,"_23735":101756,"_2383":101787},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2856":59630,"_25078":59619,"_17499":101789,"_5":17394,"_23735":101756,"_2383":101790},[],"Campo de `crl_options`",{"_2856":59631,"_25078":59619,"_17499":101792,"_5":17394,"_23735":101756,"_2383":98539},[],{"_2856":59632,"_25078":59619,"_17499":101794,"_5":17394,"_23735":101756,"_2383":101795},[],"Valor inicial del backend",{"_2856":59633,"_25078":59619,"_17499":101797,"_5":17394,"_23735":101756,"_2383":46951},[],{"_2856":59634,"_25078":59619,"_17499":101799,"_5":17394,"_23735":101756,"_2383":101800},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2856":59635,"_25078":59619,"_17499":101802,"_5":17394,"_23735":101756,"_2383":101803},[],"7 días.",{"_2856":59636,"_25078":59619,"_17499":101805,"_5":17394,"_23735":101756,"_2383":46960},[],{"_2856":59637,"_25078":59619,"_17499":101807,"_5":17394,"_23735":101756,"_2383":101808},[],"Plazo desde la publicación que activa la renovación programada.",{"_2856":59638,"_25078":59619,"_17499":101810,"_5":17394,"_23735":101756,"_2383":101811},[],"6 días y 23 horas.",{"_2856":59639,"_25078":59619,"_17499":101813,"_5":17394,"_23735":101756,"_2383":46969},[],{"_2856":59640,"_25078":59619,"_17499":101815,"_5":17394,"_23735":101756,"_2383":101816},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2856":59641,"_25078":59619,"_17499":101818,"_5":17394,"_23735":101756,"_2383":46975},[],{"_2856":59642,"_25078":59619,"_17499":101820,"_5":17394,"_23735":101756,"_2383":46978},[],{"_2856":59643,"_25078":59619,"_17499":101822,"_5":17394,"_23735":101756,"_2383":101823},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2856":59644,"_25078":59619,"_17499":101825,"_5":17394,"_23735":101756,"_2383":101826},[],"SKI de la CA.",{"_2856":59645,"_25078":59619,"_17499":101828,"_5":17394,"_23735":101756,"_2383":101829},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2856":59646,"_25078":59619,"_17499":101831,"_5":17394,"_23735":101756,"_2383":101832},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2856":59647,"_25078":59619,"_17499":101834,"_5":17394,"_23735":101760,"_2383":101835},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2856":59648,"_25078":59619,"_17499":101837,"_5":17394,"_23735":101760,"_2383":101838},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2856":59649,"_25078":59619,"_17499":101840,"_5":17394,"_23735":101760,"_2383":101841},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2856":59650,"_25078":59619,"_17499":101843,"_5":17394,"_23735":101764,"_2383":101844},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2856":59651,"_25078":59619,"_17499":101846,"_5":17394,"_23735":101764,"_2383":101847},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2856":59652,"_25078":59619,"_17499":101849,"_5":17394,"_23735":101768,"_2383":101850},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2856":59653,"_25078":59619,"_17499":101852,"_5":17394,"_23735":101768,"_2383":101853},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2856":59654,"_25078":59619,"_17499":101855,"_5":17394,"_23735":101768,"_2383":101856},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2856":59655,"_25078":59619,"_17499":101858,"_5":17394,"_23735":101768,"_2383":101859},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2856":59656,"_25078":59619,"_17499":101861,"_5":17394,"_23735":101768,"_2383":101862},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2856":59657,"_25078":59619,"_17499":101864,"_5":17394,"_23735":101772,"_2383":101865},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2856":59658,"_25078":59619,"_17499":101867,"_5":17394,"_23735":101772,"_2383":98728},[],{"_2856":59659,"_25078":59619,"_17499":101869,"_5":17394,"_23735":101772,"_2383":101870},[],"Path relativo",{"_2856":59660,"_25078":59619,"_17499":101872,"_5":17394,"_23735":101772,"_2383":96837},[],{"_2856":59661,"_25078":59619,"_17499":101874,"_5":17394,"_23735":101772,"_2383":47033},[],{"_2856":59662,"_25078":59619,"_17499":101876,"_5":17394,"_23735":101772,"_2383":47036},[],{"_2856":59663,"_25078":59619,"_17499":101878,"_5":17394,"_23735":101772,"_2383":101879},[],"Consultar `crl_options` y `latest_crl`.",{"_2856":59664,"_25078":59619,"_17499":101881,"_5":17394,"_23735":101772,"_2383":47042},[],{"_2856":59665,"_25078":59619,"_17499":101883,"_5":17394,"_23735":101772,"_2383":47036},[],{"_2856":59666,"_25078":59619,"_17499":101885,"_5":17394,"_23735":101772,"_2383":101886},[],"Sustituir la configuración de CRL.",{"_2856":59667,"_25078":59619,"_17499":101888,"_5":17394,"_23735":101772,"_2383":101889},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2856":59668,"_25078":59619,"_17499":101891,"_5":17394,"_23735":101772,"_2383":101892},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2856":59669,"_25078":59619,"_17499":101894,"_5":17394,"_23735":101776,"_2383":101895},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2856":59670,"_25078":59619,"_17499":101897,"_5":17394,"_23735":101780,"_2383":101898},[],"RFC 5280: perfil X.509 y CRL.",{"_2856":59671,"_25078":59619,"_17499":101900,"_5":17394,"_23735":101780,"_2383":47062},[],{"_2856":59672,"_25078":59619,"_17499":101902,"_5":17394,"_23735":101780,"_2383":47065},[],{"_2856":59673,"_25078":59619,"_17499":101904,"_5":17394,"_23735":101780,"_2383":101905},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":59674,"_25078":59619,"_17499":101907,"_5":17394,"_23735":101780,"_2383":101908},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2856":59675,"_25078":59675,"_5":12261,"_2383":101910,"_25413":101911,"_17499":101912,"_23735":59675},"Claves y motores criptográficos",[40749,97046,45771,100621],[],{"_2856":59676,"_25078":59675,"_17499":101914,"_5":17394,"_23735":59675,"_2383":101915},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2856":59677,"_25078":59675,"_5":25410,"_17499":101917,"_23735":101918,"_2383":101919},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2856":59678,"_25078":59675,"_5":25410,"_17499":101921,"_23735":101922,"_2383":101923},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2856":59679,"_25078":59675,"_5":25410,"_17499":101925,"_23735":101926,"_2383":47090},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#file-system",{"_2856":59680,"_25078":59675,"_5":25410,"_17499":101928,"_23735":101929,"_2383":47094},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#hashicorp-vault",{"_2856":59681,"_25078":59675,"_5":25410,"_17499":101931,"_23735":101932,"_2383":47098},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#aws-secrets-manager",{"_2856":59682,"_25078":59675,"_5":25410,"_17499":101934,"_23735":101935,"_2383":47102},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#aws-kms",{"_2856":59683,"_25078":59675,"_5":25410,"_17499":101937,"_23735":101938,"_2383":47106},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#pkcs11",{"_2856":59684,"_25078":59675,"_5":25410,"_17499":101940,"_23735":101941,"_2383":47110},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#azure-key-vault",{"_2856":59685,"_25078":59675,"_5":25410,"_17499":101943,"_23735":101944,"_2383":101945},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2856":59686,"_25078":59675,"_5":25410,"_17499":101947,"_23735":101948,"_2383":101949},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2856":59687,"_25078":59675,"_5":25410,"_17499":101951,"_23735":101952,"_2383":101953},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2856":59688,"_25078":59675,"_5":25410,"_17499":101955,"_23735":101956,"_2383":101957},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2856":59689,"_25078":59675,"_5":25410,"_17499":101959,"_23735":101960,"_2383":101961},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2856":59690,"_25078":59675,"_5":25410,"_17499":101963,"_23735":101964,"_2383":101965},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2856":59691,"_25078":59675,"_5":25410,"_17499":101967,"_23735":101968,"_2383":101969},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2856":59692,"_25078":59675,"_5":25410,"_17499":101971,"_23735":101972,"_2383":47142},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#sign",{"_2856":59693,"_25078":59675,"_5":25410,"_17499":101974,"_23735":101975,"_2383":47146},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#verify",{"_2856":59694,"_25078":59675,"_5":25410,"_17499":101977,"_23735":101978,"_2383":101979},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2856":59695,"_25078":59675,"_5":25410,"_17499":101981,"_23735":101982,"_2383":101983},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2856":59696,"_25078":59675,"_5":25410,"_17499":101985,"_23735":101986,"_2383":101987},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2856":59697,"_25078":59675,"_17499":101989,"_5":17394,"_23735":59675,"_2383":101990},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2856":59698,"_25078":59675,"_17499":101992,"_5":17394,"_23735":59675,"_2383":101993},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2856":59699,"_25078":59675,"_17499":101995,"_5":17394,"_23735":101918,"_2383":101996},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2856":59700,"_25078":59675,"_17499":101998,"_5":17394,"_23735":101918,"_2383":101999},[],"En la práctica, permite:",{"_2856":59701,"_25078":59675,"_17499":102001,"_5":17394,"_23735":101918,"_2383":102002},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2856":59702,"_25078":59675,"_17499":102004,"_5":17394,"_23735":101918,"_2383":102005},[],"Importar claves creadas externamente.",{"_2856":59703,"_25078":59675,"_17499":102007,"_5":17394,"_23735":101918,"_2383":102008},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2856":59704,"_25078":59675,"_17499":102010,"_5":17394,"_23735":101918,"_2383":102011},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2856":59705,"_25078":59675,"_17499":102013,"_5":17394,"_23735":101922,"_2383":102014},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2856":59706,"_25078":59675,"_17499":102016,"_5":17394,"_23735":101922,"_2383":102017},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2856":59707,"_25078":59675,"_17499":102019,"_5":17394,"_23735":101922,"_2383":102020},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2856":59708,"_25078":59675,"_17499":102022,"_5":17394,"_23735":101926,"_2383":102023},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2856":59709,"_25078":59675,"_17499":102025,"_5":17394,"_23735":101929,"_2383":102026},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2856":59710,"_25078":59675,"_17499":102028,"_5":17394,"_23735":101932,"_2383":102029},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2856":59711,"_25078":59675,"_17499":102031,"_5":17394,"_23735":101935,"_2383":102032},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2856":59712,"_25078":59675,"_17499":102034,"_5":17394,"_23735":101938,"_2383":102035},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2856":59713,"_25078":59675,"_17499":102037,"_5":17394,"_23735":101941,"_2383":102038},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2856":59714,"_25078":59675,"_17499":102040,"_5":17394,"_23735":101941,"_2383":102041},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2856":59715,"_25078":59675,"_17499":102043,"_5":17394,"_23735":101941,"_2383":102044},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2856":59716,"_25078":59675,"_17499":102046,"_5":17394,"_23735":101941,"_2383":102047},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2856":59717,"_25078":59675,"_17499":102049,"_5":17394,"_23735":101944,"_2383":102050},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2856":59718,"_25078":59675,"_17499":102052,"_5":17394,"_23735":101944,"_2383":102053},[],"La tabla incluye los siguientes campos:",{"_2856":59719,"_25078":59675,"_17499":102055,"_5":17394,"_23735":101944,"_2383":102056},[],"**Name**: nombre descriptivo de la clave.",{"_2856":59720,"_25078":59675,"_17499":102058,"_5":17394,"_23735":101944,"_2383":102059},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2856":59721,"_25078":59675,"_17499":102061,"_5":17394,"_23735":101944,"_2383":102062},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2856":59722,"_25078":59675,"_17499":102064,"_5":17394,"_23735":101944,"_2383":102065},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2856":59723,"_25078":59675,"_17499":102067,"_5":17394,"_23735":101944,"_2383":102068},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2856":59724,"_25078":59675,"_17499":102070,"_5":17394,"_23735":101944,"_2383":102071},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2856":59725,"_25078":59675,"_17499":102073,"_5":17394,"_23735":101944,"_2383":102074},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2856":59726,"_25078":59675,"_17499":102076,"_5":17394,"_23735":101944,"_2383":102077},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2856":59727,"_25078":59675,"_17499":102079,"_5":17394,"_23735":101944,"_2383":102080},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2856":59728,"_25078":59675,"_17499":102082,"_5":17394,"_23735":101944,"_2383":102083},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2856":59729,"_25078":59675,"_17499":102085,"_5":17394,"_23735":101944,"_2383":102086},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2856":59730,"_25078":59675,"_17499":102088,"_5":17394,"_23735":101944,"_2383":102089},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2856":59731,"_25078":59675,"_17499":102091,"_5":17394,"_23735":101944,"_2383":102092},[],"**Delete Key** para eliminar la clave del sistema.",{"_2856":59732,"_25078":59675,"_17499":102094,"_5":17394,"_23735":101948,"_2383":102095},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2856":59733,"_25078":59675,"_17499":102097,"_5":17394,"_23735":101952,"_2383":102098},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2856":59734,"_25078":59675,"_17499":102100,"_5":17394,"_23735":101952,"_2383":102101},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2856":59735,"_25078":59675,"_17499":102103,"_5":17394,"_23735":101952,"_2383":102104},[],"**Key Name**: nombre único y descriptivo.",{"_2856":59736,"_25078":59675,"_17499":102106,"_5":17394,"_23735":101952,"_2383":102107},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2856":59737,"_25078":59675,"_17499":102109,"_5":17394,"_23735":101952,"_2383":102110},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2856":59738,"_25078":59675,"_17499":102112,"_5":17394,"_23735":101952,"_2383":102113},[],"**Tags**: metadatos para clasificar la clave.",{"_2856":59739,"_25078":59675,"_17499":102115,"_5":17394,"_23735":101952,"_2383":102116},[],"**Metadata**: información adicional para usos avanzados.",{"_2856":59740,"_25078":59675,"_17499":102118,"_5":17394,"_23735":101956,"_2383":102119},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2856":59741,"_25078":59675,"_17499":102121,"_5":17394,"_23735":101956,"_2383":102122},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2856":59742,"_25078":59675,"_17499":102124,"_5":17394,"_23735":101956,"_2383":102125},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2856":59743,"_25078":59675,"_17499":102127,"_5":17394,"_23735":101956,"_2383":102128},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2856":59744,"_25078":59675,"_17499":102130,"_5":17394,"_23735":101956,"_2383":102131},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2856":59745,"_25078":59675,"_17499":102133,"_5":17394,"_23735":101956,"_2383":102134},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2856":59746,"_25078":59675,"_17499":102136,"_5":17394,"_23735":101956,"_2383":102137},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2856":59747,"_25078":59675,"_17499":102139,"_5":17394,"_23735":101956,"_2383":102140},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2856":59748,"_25078":59675,"_17499":102142,"_5":17394,"_23735":101956,"_2383":102143},[],"**Metadata**: información adicional opcional.",{"_2856":59749,"_25078":59675,"_17499":102145,"_5":17394,"_23735":101956,"_2383":102146},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2856":59750,"_25078":59675,"_17499":102148,"_5":17394,"_23735":101956,"_2383":102149},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2856":59751,"_25078":59675,"_17499":102151,"_5":17394,"_23735":101960,"_2383":102152},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2856":59752,"_25078":59675,"_17499":102154,"_5":17394,"_23735":101964,"_2383":102155},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2856":59753,"_25078":59675,"_17499":102157,"_5":17394,"_23735":101964,"_2383":102158},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2856":59754,"_25078":59675,"_17499":102160,"_5":17394,"_23735":101964,"_2383":102161},[],"**Key Name**: nombre descriptivo.",{"_2856":59755,"_25078":59675,"_17499":102163,"_5":17394,"_23735":101964,"_2383":102164},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2856":59756,"_25078":59675,"_17499":102166,"_5":17394,"_23735":101964,"_2383":102167},[],"**Tags**: etiquetas asociadas.",{"_2856":59757,"_25078":59675,"_17499":102169,"_5":17394,"_23735":101964,"_2383":102170},[],"**Aliases**: nombres alternativos.",{"_2856":59758,"_25078":59675,"_17499":102172,"_5":17394,"_23735":101964,"_2383":102173},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2856":59759,"_25078":59675,"_17499":102175,"_5":17394,"_23735":101964,"_2383":102176},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2856":59760,"_25078":59675,"_17499":102178,"_5":17394,"_23735":101964,"_2383":102179},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2856":59761,"_25078":59675,"_17499":102181,"_5":17394,"_23735":101964,"_2383":102182},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2856":59762,"_25078":59675,"_17499":102184,"_5":17394,"_23735":101968,"_2383":102185},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2856":59763,"_25078":59675,"_17499":102187,"_5":17394,"_23735":101968,"_2383":102188},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2856":59764,"_25078":59675,"_17499":102190,"_5":17394,"_23735":101968,"_2383":102191},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2856":59765,"_25078":59675,"_17499":102193,"_5":17394,"_23735":101972,"_2383":102194},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2856":59766,"_25078":59675,"_17499":102196,"_5":17394,"_23735":101972,"_2383":102197},[],"Campos principales:",{"_2856":59767,"_25078":59675,"_17499":102199,"_5":17394,"_23735":101972,"_2383":102200},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2856":59768,"_25078":59675,"_17499":102202,"_5":17394,"_23735":101972,"_2383":102203},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2856":59769,"_25078":59675,"_17499":102205,"_5":17394,"_23735":101972,"_2383":102206},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2856":59770,"_25078":59675,"_17499":102208,"_5":17394,"_23735":101972,"_2383":102209},[],"**Message**: contenido que se va a firmar.",{"_2856":59771,"_25078":59675,"_17499":102211,"_5":17394,"_23735":101972,"_2383":102212},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2856":59772,"_25078":59675,"_17499":102214,"_5":17394,"_23735":101975,"_2383":102215},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2856":59773,"_25078":59675,"_17499":102217,"_5":17394,"_23735":101975,"_2383":102197},[],{"_2856":59774,"_25078":59675,"_17499":102219,"_5":17394,"_23735":101975,"_2383":102220},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2856":59775,"_25078":59675,"_17499":102222,"_5":17394,"_23735":101975,"_2383":102223},[],"**Message Type**: `Raw` o `Digest`.",{"_2856":59776,"_25078":59675,"_17499":102225,"_5":17394,"_23735":101975,"_2383":102226},[],"**Payload Encoding**: codificación del mensaje.",{"_2856":59777,"_25078":59675,"_17499":102228,"_5":17394,"_23735":101975,"_2383":102229},[],"**Message**: mensaje original o hash.",{"_2856":59778,"_25078":59675,"_17499":102231,"_5":17394,"_23735":101975,"_2383":102232},[],"**Signature**: firma que se desea comprobar.",{"_2856":59779,"_25078":59675,"_17499":102234,"_5":17394,"_23735":101975,"_2383":102235},[],"**Result**: indicador del resultado de la validación.",{"_2856":59780,"_25078":59675,"_17499":102237,"_5":17394,"_23735":101978,"_2383":102238},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2856":59781,"_25078":59675,"_17499":102240,"_5":17394,"_23735":101978,"_2383":102241},[],"Este flujo es útil para:",{"_2856":59782,"_25078":59675,"_17499":102243,"_5":17394,"_23735":101978,"_2383":102244},[],"Solicitar certificados a una CA externa.",{"_2856":59783,"_25078":59675,"_17499":102246,"_5":17394,"_23735":101978,"_2383":102247},[],"Renovar una identidad manteniendo la misma clave.",{"_2856":59784,"_25078":59675,"_17499":102249,"_5":17394,"_23735":101978,"_2383":102250},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2856":59785,"_25078":59675,"_17499":102252,"_5":17394,"_23735":101978,"_2383":102253},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2856":59786,"_25078":59675,"_17499":102255,"_5":17394,"_23735":101978,"_2383":102256},[],"**Organization (O)**: organización o empresa.",{"_2856":59787,"_25078":59675,"_17499":102258,"_5":17394,"_23735":101978,"_2383":102259},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2856":59788,"_25078":59675,"_17499":102261,"_5":17394,"_23735":101978,"_2383":102262},[],"**Country (C)**: código de país de dos letras.",{"_2856":59789,"_25078":59675,"_17499":102264,"_5":17394,"_23735":101978,"_2383":102265},[],"**State / Province (ST)**: estado o provincia.",{"_2856":59790,"_25078":59675,"_17499":102267,"_5":17394,"_23735":101978,"_2383":102268},[],"**Locality (L)**: ciudad o localidad.",{"_2856":59791,"_25078":59675,"_17499":102270,"_5":17394,"_23735":101978,"_2383":102271},[],"**Email Address**: correo de contacto.",{"_2856":59792,"_25078":59675,"_17499":102273,"_5":17394,"_23735":101978,"_2383":102274},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2856":59793,"_25078":59675,"_17499":102276,"_5":17394,"_23735":101978,"_2383":102277},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2856":59794,"_25078":59675,"_17499":102279,"_5":17394,"_23735":101982,"_2383":102280},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2856":59795,"_25078":59675,"_17499":102282,"_5":17394,"_23735":101982,"_2383":47454},[],{"_2856":59796,"_25078":59675,"_17499":102284,"_5":17394,"_23735":101986,"_2383":102285},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2856":59797,"_25078":59797,"_5":12261,"_2383":102287,"_25413":102288,"_17499":102289,"_23735":59797},"Validación online con OCSP",[40749,97046,45771,101236],[],{"_2856":59798,"_25078":59797,"_17499":102291,"_5":17394,"_23735":59797,"_2383":102292},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2856":59799,"_25078":59797,"_5":25410,"_17499":102294,"_23735":102295,"_2383":102296},[],"/docs/pr-preview/pr-40/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2856":59800,"_25078":59797,"_5":25410,"_17499":102298,"_23735":102299,"_2383":102300},[],"/docs/pr-preview/pr-40/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2856":59801,"_25078":59797,"_5":25410,"_17499":102302,"_23735":102303,"_2383":102304},[],"/docs/pr-preview/pr-40/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2856":59802,"_25078":59797,"_5":25410,"_17499":102306,"_23735":102307,"_2383":102308},[],"/docs/pr-preview/pr-40/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2856":59803,"_25078":59797,"_5":25410,"_17499":102310,"_23735":102311,"_2383":102312},[],"/docs/pr-preview/pr-40/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2856":59804,"_25078":59797,"_5":25410,"_17499":102314,"_23735":102315,"_2383":101781},[],"/docs/pr-preview/pr-40/es/platform/pki/ocsp#referencias",{"_2856":59805,"_25078":59797,"_17499":102317,"_5":17394,"_23735":59797,"_2383":102318},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2856":59806,"_25078":59797,"_17499":102320,"_5":17394,"_23735":102295,"_2383":102321},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2856":59807,"_25078":59797,"_17499":102323,"_5":17394,"_23735":102295,"_2383":102324},[],"Estado del registro",{"_2856":59808,"_25078":59797,"_17499":102326,"_5":17394,"_23735":102295,"_2383":102327},[],"Respuesta firmada",{"_2856":59809,"_25078":59797,"_17499":102329,"_5":17394,"_23735":102295,"_2383":44949},[],{"_2856":59810,"_25078":59797,"_17499":102331,"_5":17394,"_23735":102295,"_2383":47504},[],{"_2856":59811,"_25078":59797,"_17499":102333,"_5":17394,"_23735":102295,"_2383":44966},[],{"_2856":59812,"_25078":59797,"_17499":102335,"_5":17394,"_23735":102295,"_2383":102336},[],"`Revoked`, con razón y fecha de revocación.",{"_2856":59813,"_25078":59797,"_17499":102338,"_5":17394,"_23735":102295,"_2383":102339},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2856":59814,"_25078":59797,"_17499":102341,"_5":17394,"_23735":102295,"_2383":102342},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2856":59815,"_25078":59797,"_17499":102344,"_5":17394,"_23735":102295,"_2383":102345},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2856":59816,"_25078":59797,"_17499":102347,"_5":17394,"_23735":102295,"_2383":102348},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2856":59817,"_25078":59797,"_17499":102350,"_5":17394,"_23735":102295,"_2383":102351},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2856":59818,"_25078":59797,"_17499":102353,"_5":17394,"_23735":102299,"_2383":102354},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2856":59819,"_25078":59797,"_17499":102356,"_5":17394,"_23735":102299,"_2383":102357},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2856":59820,"_25078":59797,"_17499":102359,"_5":17394,"_23735":102303,"_2383":102360},[],"El servicio acepta:",{"_2856":59821,"_25078":59797,"_17499":102362,"_5":17394,"_23735":102303,"_2383":98728},[],{"_2856":59822,"_25078":59797,"_17499":102364,"_5":17394,"_23735":102303,"_2383":102365},[],"Ruta del servicio VA",{"_2856":59823,"_25078":59797,"_17499":102367,"_5":17394,"_23735":102303,"_2383":102368},[],"Formato",{"_2856":59824,"_25078":59797,"_17499":102370,"_5":17394,"_23735":102303,"_2383":47544},[],{"_2856":59825,"_25078":59797,"_17499":102372,"_5":17394,"_23735":102303,"_2383":47547},[],{"_2856":59826,"_25078":59797,"_17499":102374,"_5":17394,"_23735":102303,"_2383":102375},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2856":59827,"_25078":59797,"_17499":102377,"_5":17394,"_23735":102303,"_2383":47033},[],{"_2856":59828,"_25078":59797,"_17499":102379,"_5":17394,"_23735":102303,"_2383":47555},[],{"_2856":59829,"_25078":59797,"_17499":102381,"_5":17394,"_23735":102303,"_2383":102382},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2856":59830,"_25078":59797,"_17499":102384,"_5":17394,"_23735":102303,"_2383":102385},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2856":59831,"_25078":59797,"_17499":102387,"_5":17394,"_23735":102307,"_2383":102388},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2856":59832,"_25078":59797,"_17499":102390,"_5":17394,"_23735":102307,"_2383":102391},[],"Genera la solicitud:",{"_2856":59833,"_25078":59797,"_17499":102393,"_5":17394,"_23735":102307,"_2383":102394},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2856":59834,"_25078":59797,"_17499":102396,"_5":17394,"_23735":102307,"_2383":102397},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2856":59835,"_25078":59797,"_17499":102399,"_5":17394,"_23735":102307,"_2383":102400},[],"Verifica el DER recibido:",{"_2856":59836,"_25078":59797,"_17499":102402,"_5":17394,"_23735":102307,"_2383":102403},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2856":59837,"_25078":59797,"_17499":102405,"_5":17394,"_23735":102311,"_2383":102406},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2856":59838,"_25078":59797,"_17499":102408,"_5":17394,"_23735":102311,"_2383":102409},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2856":59839,"_25078":59797,"_17499":102411,"_5":17394,"_23735":102315,"_2383":47588},[],{"_2856":59840,"_25078":59797,"_17499":102413,"_5":17394,"_23735":102315,"_2383":47591},[],{"_2856":59841,"_25078":59797,"_17499":102415,"_5":17394,"_23735":102315,"_2383":102416},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2856":59842,"_25078":59797,"_17499":102418,"_5":17394,"_23735":102315,"_2383":101908},[],{"_2856":59843,"_25078":59843,"_5":12261,"_2383":45771,"_25413":102420,"_17499":102421,"_23735":59843},[40749,97046,45771],[],{"_2856":59844,"_25078":59843,"_17499":102423,"_5":17394,"_23735":59843,"_2383":102424},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2856":59845,"_25078":59843,"_5":25410,"_17499":102426,"_23735":102427,"_2383":99945},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#empieza-aquí",{"_2856":59846,"_25078":59843,"_5":25410,"_17499":102429,"_23735":102430,"_2383":102431},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2856":59847,"_25078":59843,"_5":25410,"_17499":102433,"_23735":102434,"_2383":100467},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#capacidades-principales",{"_2856":59848,"_25078":59843,"_5":25410,"_17499":102436,"_23735":102437,"_2383":100471},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2856":59849,"_25078":59843,"_5":25410,"_17499":102439,"_23735":102440,"_2383":100475},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2856":59850,"_25078":59843,"_5":25410,"_17499":102442,"_23735":102443,"_2383":100479},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#emite-y-controla-certificados",{"_2856":59851,"_25078":59843,"_5":25410,"_17499":102445,"_23735":102446,"_2383":100487},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#publica-el-estado-de-validación",{"_2856":59852,"_25078":59843,"_5":25410,"_17499":102448,"_23735":102449,"_2383":102450},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2856":59853,"_25078":59843,"_5":25410,"_17499":102452,"_23735":102453,"_2383":101402},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#continúa",{"_2856":59854,"_25078":59843,"_17499":102455,"_5":17394,"_23735":59843,"_2383":102456},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2856":59855,"_25078":59843,"_17499":102458,"_5":17394,"_23735":102427,"_2383":102459},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2856":59856,"_25078":59843,"_17499":102461,"_5":17394,"_23735":102427,"_2383":102462},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2856":59857,"_25078":59843,"_17499":102464,"_5":17394,"_23735":102430,"_2383":102465},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2856":59858,"_25078":59843,"_17499":102467,"_5":17394,"_23735":102430,"_2383":102468},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2856":59859,"_25078":59843,"_17499":102470,"_5":17394,"_23735":102430,"_2383":102471},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2856":59860,"_25078":59843,"_17499":102473,"_5":17394,"_23735":102430,"_2383":102474},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2856":59861,"_25078":59843,"_17499":102476,"_5":17394,"_23735":102430,"_2383":102477},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2856":59862,"_25078":59843,"_17499":102479,"_5":17394,"_23735":102437,"_2383":102480},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2856":59863,"_25078":59843,"_17499":102482,"_5":17394,"_23735":102440,"_2383":102483},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2856":59864,"_25078":59843,"_17499":102485,"_5":17394,"_23735":102443,"_2383":102486},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2856":59865,"_25078":59843,"_17499":102488,"_5":17394,"_23735":102446,"_2383":102489},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2856":59866,"_25078":59843,"_17499":102491,"_5":17394,"_23735":102449,"_2383":102492},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2856":59867,"_25078":59843,"_17499":102494,"_5":17394,"_23735":102449,"_2383":102495},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2856":59868,"_25078":59843,"_17499":102497,"_5":17394,"_23735":102449,"_2383":102498},[],"su clave pública corresponda a la clave privada del cliente;",{"_2856":59869,"_25078":59843,"_17499":102500,"_5":17394,"_23735":102449,"_2383":102501},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2856":59870,"_25078":59843,"_17499":102503,"_5":17394,"_23735":102449,"_2383":102504},[],"sus fechas y usos permitan la operación;",{"_2856":59871,"_25078":59843,"_17499":102506,"_5":17394,"_23735":102449,"_2383":102507},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2856":59872,"_25078":59843,"_17499":102509,"_5":17394,"_23735":102449,"_2383":102510},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2856":59873,"_25078":59843,"_17499":102512,"_5":17394,"_23735":102453,"_2383":102513},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2856":59874,"_25078":59843,"_17499":102515,"_5":17394,"_23735":102453,"_2383":102516},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2856":59875,"_25078":59843,"_17499":102518,"_5":17394,"_23735":102453,"_2383":102519},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2856":59876,"_25078":59876,"_5":12261,"_2383":102521,"_25413":102522,"_17499":102523,"_23735":59876},"Crea tu primera CA",[40749,97046,45771,100069],[],{"_2856":59877,"_25078":59876,"_17499":102525,"_5":17394,"_23735":59876,"_2383":102526},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2856":59878,"_25078":59876,"_5":25410,"_17499":102528,"_23735":102529,"_2383":95747},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2856":59879,"_25078":59876,"_5":25410,"_17499":102531,"_23735":102532,"_2383":102533},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2856":59880,"_25078":59876,"_5":25410,"_17499":102535,"_23735":102536,"_2383":102537},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2856":59881,"_25078":59876,"_5":25410,"_17499":102539,"_23735":102540,"_2383":102541},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2856":59882,"_25078":59876,"_5":25410,"_17499":102543,"_23735":102544,"_2383":102545},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2856":59883,"_25078":59876,"_5":25410,"_17499":102547,"_23735":102548,"_2383":102549},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2856":59884,"_25078":59876,"_5":25410,"_17499":102551,"_23735":102552,"_2383":102553},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2856":59885,"_25078":59876,"_5":25410,"_17499":102555,"_23735":102556,"_2383":100317},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2856":59886,"_25078":59876,"_5":25410,"_17499":102558,"_23735":102559,"_2383":95771},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2856":59887,"_25078":59876,"_17499":102561,"_5":17394,"_23735":59876,"_2383":102562},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2856":59888,"_25078":59876,"_17499":102564,"_5":17394,"_23735":102529,"_2383":102565},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2856":59889,"_25078":59876,"_17499":102567,"_5":17394,"_23735":102529,"_2383":102568},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2856":59890,"_25078":59876,"_17499":102570,"_5":17394,"_23735":102529,"_2383":102571},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2856":59891,"_25078":59876,"_17499":102573,"_5":17394,"_23735":102529,"_2383":102574},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2856":59892,"_25078":59876,"_17499":102576,"_5":17394,"_23735":102532,"_2383":102577},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2856":59893,"_25078":59876,"_17499":102579,"_5":17394,"_23735":102532,"_2383":102580},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2856":59894,"_25078":59876,"_17499":102582,"_5":17394,"_23735":102536,"_2383":102583},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2856":59895,"_25078":59876,"_17499":102585,"_5":17394,"_23735":102536,"_2383":102586},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2856":59896,"_25078":59876,"_17499":102588,"_5":17394,"_23735":102540,"_2383":102589},[],"Selecciona **Root CA** y completa:",{"_2856":59897,"_25078":59876,"_17499":102591,"_5":17394,"_23735":102540,"_2383":47770},[],{"_2856":59898,"_25078":59876,"_17499":102593,"_5":17394,"_23735":102540,"_2383":102594},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2856":59899,"_25078":59876,"_17499":102596,"_5":17394,"_23735":102540,"_2383":102597},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2856":59900,"_25078":59876,"_17499":102599,"_5":17394,"_23735":102540,"_2383":102600},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2856":59901,"_25078":59876,"_17499":102602,"_5":17394,"_23735":102540,"_2383":102603},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2856":59902,"_25078":59876,"_17499":102605,"_5":17394,"_23735":102544,"_2383":102606},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2856":59903,"_25078":59876,"_17499":102608,"_5":17394,"_23735":102548,"_2383":102609},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2856":59904,"_25078":59876,"_17499":102611,"_5":17394,"_23735":102548,"_2383":102612},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2856":59905,"_25078":59876,"_17499":102614,"_5":17394,"_23735":102552,"_2383":102615},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2856":59906,"_25078":59876,"_17499":102617,"_5":17394,"_23735":102552,"_2383":102618},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2856":59907,"_25078":59876,"_17499":102620,"_5":17394,"_23735":102552,"_2383":102621},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2856":59908,"_25078":59876,"_17499":102623,"_5":17394,"_23735":102556,"_2383":102624},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2856":59909,"_25078":59876,"_17499":102626,"_5":17394,"_23735":102556,"_2383":102627},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2856":59910,"_25078":59876,"_17499":102629,"_5":17394,"_23735":102556,"_2383":102630},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2856":59911,"_25078":59876,"_17499":102632,"_5":17394,"_23735":102556,"_2383":102633},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2856":59912,"_25078":59876,"_17499":102635,"_5":17394,"_23735":102559,"_2383":102636},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2856":59913,"_25078":59913,"_5":12261,"_2383":102638,"_25413":102639,"_17499":102640,"_23735":59913},"Emite y verifica un certificado",[40749,97046,45771,100069],[],{"_2856":59914,"_25078":59913,"_17499":102642,"_5":17394,"_23735":59913,"_2383":102643},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2856":59915,"_25078":59913,"_5":25410,"_17499":102645,"_23735":102646,"_2383":95747},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2856":59916,"_25078":59913,"_5":25410,"_17499":102648,"_23735":102649,"_2383":102650},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2856":59917,"_25078":59913,"_5":25410,"_17499":102652,"_23735":102653,"_2383":102654},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2856":59918,"_25078":59913,"_5":25410,"_17499":102656,"_23735":102657,"_2383":102658},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2856":59919,"_25078":59913,"_5":25410,"_17499":102660,"_23735":102661,"_2383":102662},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2856":59920,"_25078":59913,"_5":25410,"_17499":102664,"_23735":102665,"_2383":102666},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2856":59921,"_25078":59913,"_5":25410,"_17499":102668,"_23735":102669,"_2383":102549},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2856":59922,"_25078":59913,"_5":25410,"_17499":102671,"_23735":102672,"_2383":102673},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2856":59923,"_25078":59913,"_5":25410,"_17499":102675,"_23735":102676,"_2383":102677},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2856":59924,"_25078":59913,"_5":25410,"_17499":102679,"_23735":102680,"_2383":102681},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2856":59925,"_25078":59913,"_5":25410,"_17499":102683,"_23735":102684,"_2383":100317},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2856":59926,"_25078":59913,"_5":25410,"_17499":102686,"_23735":102687,"_2383":95771},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2856":59927,"_25078":59913,"_17499":102689,"_5":17394,"_23735":59913,"_2383":102690},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2856":59928,"_25078":59913,"_17499":102692,"_5":17394,"_23735":102646,"_2383":102693},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2856":59929,"_25078":59913,"_17499":102695,"_5":17394,"_23735":102646,"_2383":102696},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2856":59930,"_25078":59913,"_17499":102698,"_5":17394,"_23735":102646,"_2383":102699},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2856":59931,"_25078":59913,"_17499":102701,"_5":17394,"_23735":102646,"_2383":102702},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2856":59932,"_25078":59913,"_17499":102704,"_5":17394,"_23735":102646,"_2383":102705},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2856":59933,"_25078":59913,"_17499":102707,"_5":17394,"_23735":102649,"_2383":102708},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2856":59934,"_25078":59913,"_17499":102710,"_5":17394,"_23735":102653,"_2383":102711},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2856":59935,"_25078":59913,"_17499":102713,"_5":17394,"_23735":102653,"_2383":102714},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2856":59936,"_25078":59913,"_17499":102716,"_5":17394,"_23735":102657,"_2383":102717},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2856":59937,"_25078":59913,"_17499":102719,"_5":17394,"_23735":102657,"_2383":102720},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2856":59938,"_25078":59913,"_17499":102722,"_5":17394,"_23735":102661,"_2383":102723},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2856":59939,"_25078":59913,"_17499":102725,"_5":17394,"_23735":102661,"_2383":102726},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2856":59940,"_25078":59913,"_17499":102728,"_5":17394,"_23735":102665,"_2383":102729},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2856":59941,"_25078":59913,"_17499":102731,"_5":17394,"_23735":102669,"_2383":102732},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2856":59942,"_25078":59913,"_17499":102734,"_5":17394,"_23735":102672,"_2383":102735},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2856":59943,"_25078":59913,"_17499":102737,"_5":17394,"_23735":102676,"_2383":102738},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2856":59944,"_25078":59913,"_17499":102740,"_5":17394,"_23735":102676,"_2383":102741},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2856":59945,"_25078":59913,"_17499":102743,"_5":17394,"_23735":102676,"_2383":102744},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2856":59946,"_25078":59913,"_17499":102746,"_5":17394,"_23735":102680,"_2383":102747},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2856":59947,"_25078":59913,"_17499":102749,"_5":17394,"_23735":102680,"_2383":102750},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2856":59948,"_25078":59913,"_17499":102752,"_5":17394,"_23735":102680,"_2383":102753},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2856":59949,"_25078":59913,"_17499":102755,"_5":17394,"_23735":102684,"_2383":100400},[],{"_2856":59950,"_25078":59913,"_17499":102757,"_5":17394,"_23735":102684,"_2383":99177},[],{"_2856":59951,"_25078":59913,"_17499":102759,"_5":17394,"_23735":102684,"_2383":102760},[],"La CA rechaza la emisión",{"_2856":59952,"_25078":59913,"_17499":102762,"_5":17394,"_23735":102684,"_2383":102763},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2856":59953,"_25078":59913,"_17499":102765,"_5":17394,"_23735":102684,"_2383":102766},[],"Sujeto o usos diferentes",{"_2856":59954,"_25078":59913,"_17499":102768,"_5":17394,"_23735":102684,"_2383":102769},[],"Perfil aplicado y valores solicitados.",{"_2856":59955,"_25078":59913,"_17499":102771,"_5":17394,"_23735":102684,"_2383":102772},[],"No se encuentra el emisor",{"_2856":59956,"_25078":59913,"_17499":102774,"_5":17394,"_23735":102684,"_2383":102775},[],"CA descargada y cadena intermedia necesaria.",{"_2856":59957,"_25078":59913,"_17499":102777,"_5":17394,"_23735":102684,"_2383":102778},[],"Falla la vigencia",{"_2856":59958,"_25078":59913,"_17499":102780,"_5":17394,"_23735":102684,"_2383":102781},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2856":59959,"_25078":59913,"_17499":102783,"_5":17394,"_23735":102684,"_2383":102784},[],"Los resúmenes de clave difieren",{"_2856":59960,"_25078":59913,"_17499":102786,"_5":17394,"_23735":102684,"_2383":102787},[],"Archivos de certificado y clave de la misma emisión.",{"_2856":59961,"_25078":59913,"_17499":102789,"_5":17394,"_23735":102684,"_2383":102790},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2856":59962,"_25078":59913,"_17499":102792,"_5":17394,"_23735":102687,"_2383":102793},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2856":59963,"_25078":59913,"_17499":102795,"_5":17394,"_23735":102687,"_2383":102796},[],"Gestionar certificados para inspección, estado y revocación.",{"_2856":59964,"_25078":59913,"_17499":102798,"_5":17394,"_23735":102687,"_2383":102799},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2856":59965,"_25078":59913,"_17499":102801,"_5":17394,"_23735":102687,"_2383":102802},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2856":59966,"_25078":59913,"_17499":102804,"_5":17394,"_23735":102687,"_2383":102805},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2856":59967,"_25078":59967,"_5":12261,"_2383":102807,"_25413":102808,"_17499":102809,"_23735":59967},"Primeros pasos de PKI",[40749,97046,45771,100069],[],{"_2856":59968,"_25078":59967,"_17499":102811,"_5":17394,"_23735":59967,"_2383":102812},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2856":59969,"_25078":59967,"_5":25410,"_17499":102814,"_23735":102815,"_2383":95747},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2856":59970,"_25078":59967,"_5":25410,"_17499":102817,"_23735":102818,"_2383":102819},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2856":59971,"_25078":59967,"_5":25410,"_17499":102821,"_23735":102822,"_2383":100251},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2856":59972,"_25078":59967,"_5":25410,"_17499":102824,"_23735":102825,"_2383":102826},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2856":59973,"_25078":59967,"_17499":102828,"_5":17394,"_23735":59967,"_2383":102829},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2856":59974,"_25078":59967,"_17499":102831,"_5":17394,"_23735":102815,"_2383":102832},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2856":59975,"_25078":59967,"_17499":102834,"_5":17394,"_23735":102815,"_2383":102835},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2856":59976,"_25078":59967,"_17499":102837,"_5":17394,"_23735":102815,"_2383":102838},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2856":59977,"_25078":59967,"_17499":102840,"_5":17394,"_23735":102815,"_2383":102841},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2856":59978,"_25078":59967,"_17499":102843,"_5":17394,"_23735":102815,"_2383":102844},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2856":59979,"_25078":59967,"_17499":102846,"_5":17394,"_23735":102818,"_2383":102847},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2856":59980,"_25078":59967,"_17499":102849,"_5":17394,"_23735":102818,"_2383":102850},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2856":59981,"_25078":59967,"_17499":102852,"_5":17394,"_23735":102818,"_2383":102853},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2856":59982,"_25078":59967,"_17499":102855,"_5":17394,"_23735":102818,"_2383":102856},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2856":59983,"_25078":59967,"_17499":102858,"_5":17394,"_23735":102822,"_2383":102859},[],"Archivo o recurso",{"_2856":59984,"_25078":59967,"_17499":102861,"_5":17394,"_23735":102822,"_2383":100248},[],{"_2856":59985,"_25078":59967,"_17499":102863,"_5":17394,"_23735":102822,"_2383":102864},[],"CA raíz activa y `ca.pem`",{"_2856":59986,"_25078":59967,"_17499":102866,"_5":17394,"_23735":102822,"_2383":102867},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2856":59987,"_25078":59967,"_17499":102869,"_5":17394,"_23735":102822,"_2383":102870},[],"Certificado final y `device.crt`",{"_2856":59988,"_25078":59967,"_17499":102872,"_5":17394,"_23735":102822,"_2383":102873},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2856":59989,"_25078":59967,"_17499":102875,"_5":17394,"_23735":102822,"_2383":102876},[],"Clave privada `device.key`",{"_2856":59990,"_25078":59967,"_17499":102878,"_5":17394,"_23735":102822,"_2383":102879},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2856":59991,"_25078":59967,"_17499":102881,"_5":17394,"_23735":102822,"_2383":102882},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2856":59992,"_25078":59967,"_17499":102884,"_5":17394,"_23735":102825,"_2383":102885},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2856":59993,"_25078":59967,"_17499":102887,"_5":17394,"_23735":102825,"_2383":102888},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2856":59994,"_25078":59967,"_17499":102890,"_5":17394,"_23735":102825,"_2383":102891},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2856":59995,"_25078":59995,"_5":12261,"_2383":102893,"_25413":102894,"_17499":102896,"_23735":59995},"Resolución de problemas PKI",[40749,97046,45771,102895],"Resolución de problemas",[],{"_2856":59996,"_25078":59995,"_17499":102898,"_5":17394,"_23735":59995,"_2383":102899},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2856":59997,"_25078":59995,"_5":25410,"_17499":102901,"_23735":102902,"_2383":102903},[],"/docs/pr-preview/pr-40/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2856":59998,"_25078":59995,"_5":25410,"_17499":102905,"_23735":102906,"_2383":102907},[],"/docs/pr-preview/pr-40/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2856":59999,"_25078":59995,"_5":25410,"_17499":102909,"_23735":102910,"_2383":102911},[],"/docs/pr-preview/pr-40/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2856":60000,"_25078":59995,"_17499":102913,"_5":17394,"_23735":59995,"_2383":102914},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2856":60001,"_25078":59995,"_17499":102916,"_5":17394,"_23735":59995,"_2383":102917},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2856":60002,"_25078":59995,"_17499":102919,"_5":17394,"_23735":102902,"_2383":100248},[],{"_2856":60003,"_25078":59995,"_17499":102921,"_5":17394,"_23735":102902,"_2383":99177},[],{"_2856":60004,"_25078":59995,"_17499":102923,"_5":17394,"_23735":102902,"_2383":95771},[],{"_2856":60005,"_25078":59995,"_17499":102925,"_5":17394,"_23735":102902,"_2383":48106},[],{"_2856":60006,"_25078":59995,"_17499":102927,"_5":17394,"_23735":102902,"_2383":102928},[],"Existe, está activa y sus fechas son utilizables.",{"_2856":60007,"_25078":59995,"_17499":102930,"_5":17394,"_23735":102902,"_2383":102931},[],"Autoridades.",{"_2856":60008,"_25078":59995,"_17499":102933,"_5":17394,"_23735":102902,"_2383":102934},[],"Clave",{"_2856":60009,"_25078":59995,"_17499":102936,"_5":17394,"_23735":102902,"_2383":102937},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2856":60010,"_25078":59995,"_17499":102939,"_5":17394,"_23735":102902,"_2383":102940},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2856":60011,"_25078":59995,"_17499":102942,"_5":17394,"_23735":102902,"_2383":48124},[],{"_2856":60012,"_25078":59995,"_17499":102944,"_5":17394,"_23735":102902,"_2383":102945},[],"PEM correcto y firma verificable.",{"_2856":60013,"_25078":59995,"_17499":102947,"_5":17394,"_23735":102902,"_2383":48130},[],{"_2856":60014,"_25078":59995,"_17499":102949,"_5":17394,"_23735":102902,"_2383":102950},[],"Perfil",{"_2856":60015,"_25078":59995,"_17499":102952,"_5":17394,"_23735":102902,"_2383":102953},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2856":60016,"_25078":59995,"_17499":102955,"_5":17394,"_23735":102902,"_2383":102956},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2856":60017,"_25078":59995,"_17499":102958,"_5":17394,"_23735":102902,"_2383":100400},[],{"_2856":60018,"_25078":59995,"_17499":102960,"_5":17394,"_23735":102902,"_2383":102961},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2856":60019,"_25078":59995,"_17499":102963,"_5":17394,"_23735":102902,"_2383":102964},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2856":60020,"_25078":59995,"_17499":102966,"_5":17394,"_23735":102902,"_2383":102967},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2856":60021,"_25078":59995,"_17499":102969,"_5":17394,"_23735":102902,"_2383":102970},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2856":60022,"_25078":59995,"_17499":102972,"_5":17394,"_23735":102906,"_2383":102973},[],"Revisa cada frontera por separado:",{"_2856":60023,"_25078":59995,"_17499":102975,"_5":17394,"_23735":102906,"_2383":102976},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2856":60024,"_25078":59995,"_17499":102978,"_5":17394,"_23735":102906,"_2383":102979},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2856":60025,"_25078":59995,"_17499":102981,"_5":17394,"_23735":102906,"_2383":102982},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2856":60026,"_25078":59995,"_17499":102984,"_5":17394,"_23735":102906,"_2383":102985},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2856":60027,"_25078":59995,"_17499":102987,"_5":17394,"_23735":102906,"_2383":102988},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2856":60028,"_25078":59995,"_17499":102990,"_5":17394,"_23735":102906,"_2383":102991},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2856":60029,"_25078":59995,"_17499":102993,"_5":17394,"_23735":102910,"_2383":102994},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2856":60030,"_25078":59995,"_17499":102996,"_5":17394,"_23735":102910,"_2383":102997},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48184":102999,"_48186":103000,"_48188":103001,"_48190":103002,"_15199":2405,"_57661":2405},"spanish",[2383,25078,5,23735],{"_2383":20884,"_25078":20884,"_5":20884,"_23735":20884},{"_2383":103003,"_25078":105369,"_5":107735,"_23735":110101},{"_3827":103004,"_48194":103005,"_5":20884},{"_12006":7064,"_12349":4983,"_12356":1685