28029,"_19203":105854,"_26191":105855,"_2648":105856},[],"/docs/pr-preview/pr-40/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3150":63803,"_27690":63794,"_19203":105858,"_5":13195,"_26191":63794,"_2648":105859},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3150":63804,"_27690":63794,"_19203":105861,"_5":13195,"_26191":105831,"_2648":105862},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3150":63805,"_27690":63794,"_19203":105864,"_5":13195,"_26191":105831,"_2648":105865},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3150":63806,"_27690":63794,"_19203":105867,"_5":13195,"_26191":105831,"_2648":105868},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3150":63807,"_27690":63794,"_19203":105870,"_5":13195,"_26191":105835,"_2648":105871},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3150":63808,"_27690":63794,"_19203":105873,"_5":13195,"_26191":105835,"_2648":105874},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3150":63809,"_27690":63794,"_19203":105876,"_5":13195,"_26191":105835,"_2648":105877},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3150":63810,"_27690":63794,"_19203":105879,"_5":13195,"_26191":105839,"_2648":105880},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3150":63811,"_27690":63794,"_19203":105882,"_5":13195,"_26191":105843,"_2648":105883},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3150":63812,"_27690":63794,"_19203":105885,"_5":13195,"_26191":105847,"_2648":105886},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3150":63813,"_27690":63794,"_19203":105888,"_5":13195,"_26191":105851,"_2648":105889},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3150":63814,"_27690":63794,"_19203":105891,"_5":13195,"_26191":105855,"_2648":105892},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3150":63815,"_27690":63815,"_5":13521,"_2648":105894,"_28032":105895,"_19203":105896,"_26191":63815},"Despliega Lamassu",[45000,105823],[],{"_3150":63816,"_27690":63815,"_19203":105898,"_5":13195,"_26191":63815,"_2648":105899},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3150":63817,"_27690":63815,"_5":28029,"_19203":105901,"_26191":105902,"_2648":105903},[],"/docs/pr-preview/pr-40/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3150":63818,"_27690":63815,"_5":28029,"_19203":105905,"_26191":105906,"_2648":105907},[],"/docs/pr-preview/pr-40/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3150":63819,"_27690":63815,"_5":28029,"_19203":105909,"_26191":105910,"_2648":105911},[],"/docs/pr-preview/pr-40/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3150":63820,"_27690":63815,"_19203":105913,"_5":13195,"_26191":63815,"_2648":105914},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3150":63821,"_27690":63815,"_19203":105916,"_5":13195,"_26191":105902,"_2648":105917},[],"Modelo",{"_3150":63822,"_27690":63815,"_19203":105919,"_5":13195,"_26191":105902,"_2648":105920},[],"Recomendado para",{"_3150":63823,"_27690":63815,"_19203":105922,"_5":13195,"_26191":105902,"_2648":105923},[],"Quién opera la infraestructura",{"_3150":63824,"_27690":63815,"_19203":105925,"_5":13195,"_26191":105902,"_2648":105926},[],"Punto de partida",{"_3150":63825,"_27690":63815,"_19203":105928,"_5":13195,"_26191":105902,"_2648":45107},[],{"_3150":63826,"_27690":63815,"_19203":105930,"_5":13195,"_26191":105902,"_2648":105931},[],"Producción, entornos regulados y despliegues personalizados",{"_3150":63827,"_27690":63815,"_19203":105933,"_5":13195,"_26191":105902,"_2648":105934},[],"Tu equipo",{"_3150":63828,"_27690":63815,"_19203":105936,"_5":13195,"_26191":105902,"_2648":105937},[],"Helm o Fastlane",{"_3150":63829,"_27690":63815,"_19203":105939,"_5":13195,"_26191":105902,"_2648":45119},[],{"_3150":63830,"_27690":63815,"_19203":105941,"_5":13195,"_26191":105902,"_2648":105942},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3150":63831,"_27690":63815,"_19203":105944,"_5":13195,"_26191":105902,"_2648":105934},[],{"_3150":63832,"_27690":63815,"_19203":105946,"_5":13195,"_26191":105902,"_2648":105947},[],"Imagen preconfigurada en EC2",{"_3150":63833,"_27690":63815,"_19203":105949,"_5":13195,"_26191":105902,"_2648":45130},[],{"_3150":63834,"_27690":63815,"_19203":105951,"_5":13195,"_26191":105902,"_2648":105952},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3150":63835,"_27690":63815,"_19203":105954,"_5":13195,"_26191":105902,"_2648":45136},[],{"_3150":63836,"_27690":63815,"_19203":105956,"_5":13195,"_26191":105902,"_2648":105957},[],"Suscripción gestionada",{"_3150":63837,"_27690":63815,"_19203":105959,"_5":13195,"_26191":105902,"_2648":105960},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3150":63838,"_27690":63815,"_19203":105962,"_5":13195,"_26191":105902,"_2648":105963},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3150":63839,"_27690":63815,"_19203":105965,"_5":13195,"_26191":105902,"_2648":105966},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3150":63840,"_27690":63815,"_19203":105968,"_5":13195,"_26191":105906,"_2648":105969},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3150":63841,"_27690":63815,"_19203":105971,"_5":13195,"_26191":105910,"_2648":105972},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3150":63842,"_27690":63842,"_5":13521,"_2648":105974,"_28032":105975,"_19203":105976,"_26191":63842},"Utiliza Lamassu como SaaS",[45000,105823,105824],[],{"_3150":63843,"_27690":63842,"_19203":105978,"_5":13195,"_26191":63842,"_2648":105979},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3150":63844,"_27690":63842,"_5":28029,"_19203":105981,"_26191":105982,"_2648":105983},[],"/docs/pr-preview/pr-40/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3150":63845,"_27690":63842,"_5":28029,"_19203":105985,"_26191":105986,"_2648":105987},[],"/docs/pr-preview/pr-40/es/deployment/saas#planes","Planes",{"_3150":63846,"_27690":63842,"_5":28029,"_19203":105989,"_26191":105990,"_2648":105991},[],"/docs/pr-preview/pr-40/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3150":63847,"_27690":63842,"_19203":105993,"_5":13195,"_26191":63842,"_2648":105994},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3150":63848,"_27690":63842,"_19203":105996,"_5":13195,"_26191":105982,"_2648":105997},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3150":63849,"_27690":63842,"_19203":105999,"_5":13195,"_26191":105982,"_2648":106000},[],"Copias de seguridad automáticas.",{"_3150":63850,"_27690":63842,"_19203":106002,"_5":13195,"_26191":105982,"_2648":106003},[],"Actualizaciones de versión.",{"_3150":63851,"_27690":63842,"_19203":106005,"_5":13195,"_26191":105982,"_2648":106006},[],"Soporte técnico y SLA según el plan contratado.",{"_3150":63852,"_27690":63842,"_19203":106008,"_5":13195,"_26191":105986,"_2648":45191},[],{"_3150":63853,"_27690":63842,"_19203":106010,"_5":13195,"_26191":105986,"_2648":106011},[],"Dispositivos",{"_3150":63854,"_27690":63842,"_19203":106013,"_5":13195,"_26191":105986,"_2648":106014},[],"Soporte",{"_3150":63855,"_27690":63842,"_19203":106016,"_5":13195,"_26191":105986,"_2648":45200},[],{"_3150":63856,"_27690":63842,"_19203":106018,"_5":13195,"_26191":105986,"_2648":45203},[],{"_3150":63857,"_27690":63842,"_19203":106020,"_5":13195,"_26191":105986,"_2648":106021},[],"Hasta 1.000",{"_3150":63858,"_27690":63842,"_19203":106023,"_5":13195,"_26191":105986,"_2648":45209},[],{"_3150":63859,"_27690":63842,"_19203":106025,"_5":13195,"_26191":105986,"_2648":106026},[],"99,5 %",{"_3150":63860,"_27690":63842,"_19203":106028,"_5":13195,"_26191":105986,"_2648":45215},[],{"_3150":63861,"_27690":63842,"_19203":106030,"_5":13195,"_26191":105986,"_2648":106031},[],"Hasta 10.000",{"_3150":63862,"_27690":63842,"_19203":106033,"_5":13195,"_26191":105986,"_2648":106034},[],"Email y chat",{"_3150":63863,"_27690":63842,"_19203":106036,"_5":13195,"_26191":105986,"_2648":106037},[],"99,9 %",{"_3150":63864,"_27690":63842,"_19203":106039,"_5":13195,"_26191":105986,"_2648":45227},[],{"_3150":63865,"_27690":63842,"_19203":106041,"_5":13195,"_26191":105986,"_2648":106042},[],"Ilimitados",{"_3150":63866,"_27690":63842,"_19203":106044,"_5":13195,"_26191":105986,"_2648":106045},[],"Dedicado",{"_3150":63867,"_27690":63842,"_19203":106047,"_5":13195,"_26191":105986,"_2648":106048},[],"99,99 %",{"_3150":63868,"_27690":63842,"_19203":106050,"_5":13195,"_26191":105990,"_2648":106051},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3150":63869,"_27690":63842,"_19203":106053,"_5":13195,"_26191":105990,"_2648":106054},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3150":63870,"_27690":63870,"_5":13521,"_2648":45244,"_28032":106056,"_19203":106058,"_26191":63870},[45000,105823,106057],"Kubernetes autogestionado",[],{"_3150":63871,"_27690":63870,"_19203":106060,"_5":13195,"_26191":63870,"_2648":106061},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3150":63872,"_27690":63870,"_5":28029,"_19203":106063,"_26191":106064,"_2648":106065},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3150":63873,"_27690":63870,"_5":28029,"_19203":106067,"_26191":106068,"_2648":106069},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3150":63874,"_27690":63870,"_5":28029,"_19203":106071,"_26191":106072,"_2648":106073},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3150":63875,"_27690":63870,"_5":28029,"_19203":106075,"_26191":106076,"_2648":106077},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3150":63876,"_27690":63870,"_5":28029,"_19203":106079,"_26191":106080,"_2648":106081},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3150":63877,"_27690":63870,"_5":28029,"_19203":106083,"_26191":106084,"_2648":106085},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3150":63878,"_27690":63870,"_5":28029,"_19203":106087,"_26191":106088,"_2648":106089},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3150":63879,"_27690":63870,"_5":28029,"_19203":106091,"_26191":106092,"_2648":106093},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3150":63880,"_27690":63870,"_5":28029,"_19203":106095,"_26191":106096,"_2648":106097},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3150":63881,"_27690":63870,"_5":28029,"_19203":106099,"_26191":106100,"_2648":106101},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3150":63882,"_27690":63870,"_5":28029,"_19203":106103,"_26191":106104,"_2648":106105},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3150":63883,"_27690":63870,"_19203":106107,"_5":13195,"_26191":106064,"_2648":106108},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3150":63884,"_27690":63870,"_19203":106110,"_5":13195,"_26191":106064,"_2648":106111},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3150":63885,"_27690":63870,"_19203":106113,"_5":13195,"_26191":106068,"_2648":106114},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3150":63886,"_27690":63870,"_19203":106116,"_5":13195,"_26191":106068,"_2648":106117},[],"Fastlane instala o configura",{"_3150":63887,"_27690":63870,"_19203":106119,"_5":13195,"_26191":106068,"_2648":106120},[],"Tú sigues proporcionando",{"_3150":63888,"_27690":63870,"_19203":106122,"_5":13195,"_26191":106068,"_2648":106123},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3150":63889,"_27690":63870,"_19203":106125,"_5":13195,"_26191":106068,"_2648":106126},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3150":63890,"_27690":63870,"_19203":106128,"_5":13195,"_26191":106068,"_2648":106129},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3150":63891,"_27690":63870,"_19203":106131,"_5":13195,"_26191":106068,"_2648":106132},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3150":63892,"_27690":63870,"_19203":106134,"_5":13195,"_26191":106068,"_2648":106135},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3150":63893,"_27690":63870,"_19203":106137,"_5":13195,"_26191":106068,"_2648":106138},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3150":63894,"_27690":63870,"_19203":106140,"_5":13195,"_26191":106068,"_2648":106141},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3150":63895,"_27690":63870,"_19203":106143,"_5":13195,"_26191":106068,"_2648":106144},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3150":63896,"_27690":63870,"_19203":106146,"_5":13195,"_26191":106068,"_2648":106147},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3150":63897,"_27690":63870,"_19203":106149,"_5":13195,"_26191":106072,"_2648":106150},[],"Necesitas:",{"_3150":63898,"_27690":63870,"_19203":106152,"_5":13195,"_26191":106072,"_2648":106153},[],"un clúster Kubernetes existente",{"_3150":63899,"_27690":63870,"_19203":106155,"_5":13195,"_26191":106072,"_2648":106156},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3150":63900,"_27690":63870,"_19203":106158,"_5":13195,"_26191":106072,"_2648":45346},[],{"_3150":63901,"_27690":63870,"_19203":106160,"_5":13195,"_26191":106072,"_2648":21745},[],{"_3150":63902,"_27690":63870,"_19203":106162,"_5":13195,"_26191":106072,"_2648":106163},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3150":63903,"_27690":63870,"_19203":106165,"_5":13195,"_26191":106072,"_2648":106166},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3150":63904,"_27690":63870,"_19203":106168,"_5":13195,"_26191":106072,"_2648":106169},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3150":63905,"_27690":63870,"_19203":106171,"_5":13195,"_26191":106072,"_2648":106172},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3150":63906,"_27690":63870,"_19203":106174,"_5":13195,"_26191":106072,"_2648":106175},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3150":63907,"_27690":63870,"_19203":106177,"_5":13195,"_26191":106076,"_2648":106178},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3150":63908,"_27690":63870,"_19203":106180,"_5":13195,"_26191":106076,"_2648":106181},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3150":63909,"_27690":63870,"_19203":106183,"_5":13195,"_26191":106080,"_2648":106184},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3150":63910,"_27690":63870,"_19203":106186,"_5":13195,"_26191":106080,"_2648":106187},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3150":63911,"_27690":63870,"_19203":106189,"_5":13195,"_26191":106080,"_2648":106190},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3150":63912,"_27690":63870,"_19203":106192,"_5":13195,"_26191":106080,"_2648":106193},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3150":63913,"_27690":63870,"_19203":106195,"_5":13195,"_26191":106084,"_2648":106196},[],"Opción",{"_3150":63914,"_27690":63870,"_19203":106198,"_5":13195,"_26191":106084,"_2648":106199},[],"Valor predeterminado",{"_3150":63915,"_27690":63870,"_19203":106201,"_5":13195,"_26191":106084,"_2648":106202},[],"Propósito",{"_3150":63916,"_27690":63870,"_19203":106204,"_5":13195,"_26191":106084,"_2648":45393},[],{"_3150":63917,"_27690":63870,"_19203":106206,"_5":13195,"_26191":106084,"_2648":45396},[],{"_3150":63918,"_27690":63870,"_19203":106208,"_5":13195,"_26191":106084,"_2648":106209},[],"Muestra la ayuda",{"_3150":63919,"_27690":63870,"_19203":106211,"_5":13195,"_26191":106084,"_2648":45402},[],{"_3150":63920,"_27690":63870,"_19203":106213,"_5":13195,"_26191":106084,"_2648":106214},[],"contexto actual",{"_3150":63921,"_27690":63870,"_19203":106216,"_5":13195,"_26191":106084,"_2648":106217},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3150":63922,"_27690":63870,"_19203":106219,"_5":13195,"_26191":106084,"_2648":45411},[],{"_3150":63923,"_27690":63870,"_19203":106221,"_5":13195,"_26191":106084,"_2648":5899},[],{"_3150":63924,"_27690":63870,"_19203":106223,"_5":13195,"_26191":106084,"_2648":106224},[],"Omite prompts y genera credenciales para las dependencias",{"_3150":63925,"_27690":63870,"_19203":106226,"_5":13195,"_26191":106084,"_2648":45419},[],{"_3150":63926,"_27690":63870,"_19203":106228,"_5":13195,"_26191":106084,"_2648":45422},[],{"_3150":63927,"_27690":63870,"_19203":106230,"_5":13195,"_26191":106084,"_2648":106231},[],"Namespace de la instalación",{"_3150":63928,"_27690":63870,"_19203":106233,"_5":13195,"_26191":106084,"_2648":45428},[],{"_3150":63929,"_27690":63870,"_19203":106235,"_5":13195,"_26191":106084,"_2648":45431},[],{"_3150":63930,"_27690":63870,"_19203":106237,"_5":13195,"_26191":106084,"_2648":106238},[],"Dominio usado por la UI, OIDC y el certificado",{"_3150":63931,"_27690":63870,"_19203":106240,"_5":13195,"_26191":106084,"_2648":45437},[],{"_3150":63932,"_27690":63870,"_19203":106242,"_5":13195,"_26191":106084,"_2648":13804},[],{"_3150":63933,"_27690":63870,"_19203":106244,"_5":13195,"_26191":106084,"_2648":106245},[],"Versión del chart de Lamassu",{"_3150":63934,"_27690":63870,"_19203":106247,"_5":13195,"_26191":106084,"_2648":45445},[],{"_3150":63935,"_27690":63870,"_19203":106249,"_5":13195,"_26191":106084,"_2648":45448},[],{"_3150":63936,"_27690":63870,"_19203":106251,"_5":13195,"_26191":106084,"_2648":106252},[],"Puerto del listener HTTPS",{"_3150":63937,"_27690":63870,"_19203":106254,"_5":13195,"_26191":106084,"_2648":45454},[],{"_3150":63938,"_27690":63870,"_19203":106256,"_5":13195,"_26191":106084,"_2648":45457},[],{"_3150":63939,"_27690":63870,"_19203":106258,"_5":13195,"_26191":106084,"_2648":106259},[],"Puerto del listener HTTP",{"_3150":63940,"_27690":63870,"_19203":106261,"_5":13195,"_26191":106084,"_2648":45463},[],{"_3150":63941,"_27690":63870,"_19203":106263,"_5":13195,"_26191":106084,"_2648":45396},[],{"_3150":63942,"_27690":63870,"_19203":106265,"_5":13195,"_26191":106084,"_2648":106266},[],"Certificado PEM para TLS downstream",{"_3150":63943,"_27690":63870,"_19203":106268,"_5":13195,"_26191":106084,"_2648":45471},[],{"_3150":63944,"_27690":63870,"_19203":106270,"_5":13195,"_26191":106084,"_2648":45396},[],{"_3150":63945,"_27690":63870,"_19203":106272,"_5":13195,"_26191":106084,"_2648":106273},[],"Clave privada PEM para TLS downstream",{"_3150":63946,"_27690":63870,"_19203":106275,"_5":13195,"_26191":106084,"_2648":45479},[],{"_3150":63947,"_27690":63870,"_19203":106277,"_5":13195,"_26191":106084,"_2648":106278},[],"chart del repositorio",{"_3150":63948,"_27690":63870,"_19203":106280,"_5":13195,"_26191":106084,"_2648":106281},[],"Usa un chart local de Lamassu sin empaquetar",{"_3150":63949,"_27690":63870,"_19203":106283,"_5":13195,"_26191":106084,"_2648":45488},[],{"_3150":63950,"_27690":63870,"_19203":106285,"_5":13195,"_26191":106084,"_2648":106286},[],"detección automática",{"_3150":63951,"_27690":63870,"_19203":106288,"_5":13195,"_26191":106084,"_2648":106289},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3150":63952,"_27690":63870,"_19203":106291,"_5":13195,"_26191":106084,"_2648":45496},[],{"_3150":63953,"_27690":63870,"_19203":106293,"_5":13195,"_26191":106084,"_2648":5899},[],{"_3150":63954,"_27690":63870,"_19203":106295,"_5":13195,"_26191":106084,"_2648":106296},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3150":63955,"_27690":63870,"_19203":106298,"_5":13195,"_26191":106084,"_2648":45504},[],{"_3150":63956,"_27690":63870,"_19203":106300,"_5":13195,"_26191":106084,"_2648":5899},[],{"_3150":63957,"_27690":63870,"_19203":106302,"_5":13195,"_26191":106084,"_2648":106303},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3150":63958,"_27690":63870,"_19203":106305,"_5":13195,"_26191":106084,"_2648":45512},[],{"_3150":63959,"_27690":63870,"_19203":106307,"_5":13195,"_26191":106084,"_2648":5899},[],{"_3150":63960,"_27690":63870,"_19203":106309,"_5":13195,"_26191":106084,"_2648":106310},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3150":63961,"_27690":63870,"_19203":106312,"_5":13195,"_26191":106084,"_2648":45520},[],{"_3150":63962,"_27690":63870,"_19203":106314,"_5":13195,"_26191":106084,"_2648":5899},[],{"_3150":63963,"_27690":63870,"_19203":106316,"_5":13195,"_26191":106084,"_2648":106317},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3150":63964,"_27690":63870,"_19203":106319,"_5":13195,"_26191":106084,"_2648":45528},[],{"_3150":63965,"_27690":63870,"_19203":106321,"_5":13195,"_26191":106084,"_2648":45531},[],{"_3150":63966,"_27690":63870,"_19203":106323,"_5":13195,"_26191":106084,"_2648":106324},[],"Usa otro chart local de SoftHSM",{"_3150":63967,"_27690":63870,"_19203":106326,"_5":13195,"_26191":106084,"_2648":106327},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3150":63968,"_27690":63870,"_19203":106329,"_5":13195,"_26191":106088,"_2648":106330},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3150":63969,"_27690":63870,"_19203":106332,"_5":13195,"_26191":106088,"_2648":106333},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3150":63970,"_27690":63870,"_19203":106335,"_5":13195,"_26191":106088,"_2648":106336},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3150":63971,"_27690":63870,"_19203":106338,"_5":13195,"_26191":106088,"_2648":106339},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3150":63972,"_27690":63870,"_19203":106341,"_5":13195,"_26191":106088,"_2648":106342},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3150":63973,"_27690":63870,"_19203":106344,"_5":13195,"_26191":106088,"_2648":106345},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3150":63974,"_27690":63870,"_19203":106347,"_5":13195,"_26191":106092,"_2648":45558},[],{"_3150":63975,"_27690":63870,"_19203":106349,"_5":13195,"_26191":106092,"_2648":106350},[],"valida las herramientas locales y el clúster seleccionado",{"_3150":63976,"_27690":63870,"_19203":106352,"_5":13195,"_26191":106092,"_2648":106353},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3150":63977,"_27690":63870,"_19203":106355,"_5":13195,"_26191":106092,"_2648":106356},[],"crea el namespace",{"_3150":63978,"_27690":63870,"_19203":106358,"_5":13195,"_26191":106092,"_2648":106359},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3150":63979,"_27690":63870,"_19203":106361,"_5":13195,"_26191":106092,"_2648":106362},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3150":63980,"_27690":63870,"_19203":106364,"_5":13195,"_26191":106092,"_2648":106365},[],"instala RabbitMQ",{"_3150":63981,"_27690":63870,"_19203":106367,"_5":13195,"_26191":106092,"_2648":106368},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3150":63982,"_27690":63870,"_19203":106370,"_5":13195,"_26191":106092,"_2648":106371},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3150":63983,"_27690":63870,"_19203":106373,"_5":13195,"_26191":106092,"_2648":106374},[],"carga datos de ejemplo opcionalmente",{"_3150":63984,"_27690":63870,"_19203":106376,"_5":13195,"_26191":106092,"_2648":106377},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3150":63985,"_27690":63870,"_19203":106379,"_5":13195,"_26191":106096,"_2648":106380},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3150":63986,"_27690":63870,"_19203":106382,"_5":13195,"_26191":106096,"_2648":106383},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3150":63987,"_27690":63870,"_19203":106385,"_5":13195,"_26191":106100,"_2648":106386},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3150":63988,"_27690":63870,"_19203":106388,"_5":13195,"_26191":106100,"_2648":106389},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3150":63989,"_27690":63870,"_19203":106391,"_5":13195,"_26191":106100,"_2648":106392},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3150":63990,"_27690":63870,"_19203":106394,"_5":13195,"_26191":106104,"_2648":106395},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3150":63991,"_27690":63991,"_5":13521,"_2648":106397,"_28032":106398,"_19203":106399,"_26191":63991},"Instala con Helm",[45000,105823,106057],[],{"_3150":63992,"_27690":63991,"_19203":106401,"_5":13195,"_26191":63991,"_2648":106402},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3150":63993,"_27690":63991,"_5":28029,"_19203":106404,"_26191":106405,"_2648":106406},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3150":63994,"_27690":63991,"_5":28029,"_19203":106408,"_26191":106409,"_2648":106073},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3150":63995,"_27690":63991,"_5":28029,"_19203":106411,"_26191":106412,"_2648":106413},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3150":63996,"_27690":63991,"_5":28029,"_19203":106415,"_26191":106416,"_2648":106417},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3150":63997,"_27690":63991,"_5":28029,"_19203":106419,"_26191":106420,"_2648":106421},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3150":63998,"_27690":63991,"_5":28029,"_19203":106423,"_26191":106424,"_2648":106425},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3150":63999,"_27690":63991,"_5":28029,"_19203":106427,"_26191":106428,"_2648":106429},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3150":64000,"_27690":63991,"_5":28029,"_19203":106431,"_26191":106432,"_2648":106433},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3150":64001,"_27690":63991,"_5":28029,"_19203":106435,"_26191":106436,"_2648":106437},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3150":64002,"_27690":63991,"_19203":106439,"_5":13195,"_26191":106405,"_2648":106440},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3150":64003,"_27690":63991,"_19203":106442,"_5":13195,"_26191":106409,"_2648":106443},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3150":64004,"_27690":63991,"_19203":106445,"_5":13195,"_26191":106409,"_2648":106446},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3150":64005,"_27690":63991,"_19203":106448,"_5":13195,"_26191":106409,"_2648":106449},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3150":64006,"_27690":63991,"_19203":106451,"_5":13195,"_26191":106409,"_2648":106452},[],"un broker RabbitMQ accesible y sus credenciales",{"_3150":64007,"_27690":63991,"_19203":106454,"_5":13195,"_26191":106409,"_2648":106455},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3150":64008,"_27690":63991,"_19203":106457,"_5":13195,"_26191":106409,"_2648":106458},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3150":64009,"_27690":63991,"_19203":106460,"_5":13195,"_26191":106409,"_2648":106461},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3150":64010,"_27690":63991,"_19203":106463,"_5":13195,"_26191":106409,"_2648":106464},[],"una StorageClass y un diseño de tráfico externo",{"_3150":64011,"_27690":63991,"_19203":106466,"_5":13195,"_26191":106409,"_2648":106467},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3150":64012,"_27690":63991,"_19203":106469,"_5":13195,"_26191":106409,"_2648":106470},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3150":64013,"_27690":63991,"_19203":106472,"_5":13195,"_26191":106409,"_2648":106473},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3150":64014,"_27690":63991,"_19203":106475,"_5":13195,"_26191":106412,"_2648":106476},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3150":64015,"_27690":63991,"_19203":106478,"_5":13195,"_26191":106412,"_2648":106479},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3150":64016,"_27690":63991,"_19203":106481,"_5":13195,"_26191":106412,"_2648":106482},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_3150":64017,"_27690":63991,"_19203":106484,"_5":13195,"_26191":106416,"_2648":106485},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3150":64018,"_27690":63991,"_19203":106487,"_5":13195,"_26191":106416,"_2648":106488},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3150":64019,"_27690":63991,"_19203":106490,"_5":13195,"_26191":106416,"_2648":106491},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3150":64020,"_27690":63991,"_19203":106493,"_5":13195,"_26191":106420,"_2648":106494},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_3150":64021,"_27690":63991,"_19203":106496,"_5":13195,"_26191":106424,"_2648":106497},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3150":64022,"_27690":63991,"_19203":106499,"_5":13195,"_26191":106424,"_2648":106500},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3150":64023,"_27690":63991,"_19203":106502,"_5":13195,"_26191":106424,"_2648":106503},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3150":64024,"_27690":63991,"_19203":106505,"_5":13195,"_26191":106424,"_2648":106506},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3150":64025,"_27690":63991,"_19203":106508,"_5":13195,"_26191":106428,"_2648":106509},[],"Para instalar un checkout local:",{"_3150":64026,"_27690":63991,"_19203":106511,"_5":13195,"_26191":106432,"_2648":106512},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3150":64027,"_27690":63991,"_19203":106514,"_5":13195,"_26191":106432,"_2648":106515},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3150":64028,"_27690":63991,"_19203":106517,"_5":13195,"_26191":106436,"_2648":106518},[],"Antes de pasar a producción, revisa:",{"_3150":64029,"_27690":63991,"_19203":106520,"_5":13195,"_26191":106436,"_2648":106521},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3150":64030,"_27690":63991,"_19203":106523,"_5":13195,"_26191":106436,"_2648":106524},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3150":64031,"_27690":63991,"_19203":106526,"_5":13195,"_26191":106436,"_2648":106527},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3150":64032,"_27690":63991,"_19203":106529,"_5":13195,"_26191":106436,"_2648":106530},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3150":64033,"_27690":63991,"_19203":106532,"_5":13195,"_26191":106436,"_2648":106533},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3150":64034,"_27690":63991,"_19203":106535,"_5":13195,"_26191":106436,"_2648":106536},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3150":64035,"_27690":63991,"_19203":106538,"_5":13195,"_26191":106436,"_2648":106539},[],"SMTP, observabilidad y entrega de alertas",{"_3150":64036,"_27690":63991,"_19203":106541,"_5":13195,"_26191":106436,"_2648":106542},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3150":64037,"_27690":63991,"_19203":106544,"_5":13195,"_26191":106436,"_2648":106545},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3150":64038,"_27690":64038,"_5":13521,"_2648":106547,"_28032":106548,"_19203":106549,"_26191":64038},"Expón el Gateway",[45000,105823,106057],[],{"_3150":64039,"_27690":64038,"_19203":106551,"_5":13195,"_26191":64038,"_2648":106552},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3150":64040,"_27690":64038,"_5":28029,"_19203":106554,"_26191":106555,"_2648":106556},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3150":64041,"_27690":64038,"_5":28029,"_19203":106558,"_26191":106559,"_2648":106560},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3150":64042,"_27690":64038,"_5":28029,"_19203":106562,"_26191":106563,"_2648":106564},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3150":64043,"_27690":64038,"_5":28029,"_19203":106566,"_26191":106567,"_2648":45779},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#k3s",{"_3150":64044,"_27690":64038,"_5":28029,"_19203":106569,"_26191":106570,"_2648":106571},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3150":64045,"_27690":64038,"_5":28029,"_19203":106573,"_26191":106574,"_2648":106575},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3150":64046,"_27690":64038,"_5":28029,"_19203":106577,"_26191":106578,"_2648":106579},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3150":64047,"_27690":64038,"_5":28029,"_19203":106581,"_26191":106582,"_2648":106583},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3150":64048,"_27690":64038,"_5":28029,"_19203":106585,"_26191":106586,"_2648":106587},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3150":64049,"_27690":64038,"_19203":106589,"_5":13195,"_26191":106555,"_2648":106590},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3150":64050,"_27690":64038,"_19203":106592,"_5":13195,"_26191":106555,"_2648":106593},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3150":64051,"_27690":64038,"_19203":106595,"_5":13195,"_26191":106559,"_2648":106596},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3150":64052,"_27690":64038,"_19203":106598,"_5":13195,"_26191":106559,"_2648":106599},[],"Defínelo únicamente cuando:",{"_3150":64053,"_27690":64038,"_19203":106601,"_5":13195,"_26191":106559,"_2648":106602},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3150":64054,"_27690":64038,"_19203":106604,"_5":13195,"_26191":106559,"_2648":106605},[],"esa dirección está asignada a este Gateway",{"_3150":64055,"_27690":64038,"_19203":106607,"_5":13195,"_26191":106559,"_2648":106608},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3150":64056,"_27690":64038,"_19203":106610,"_5":13195,"_26191":106559,"_2648":106611},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3150":64057,"_27690":64038,"_19203":106613,"_5":13195,"_26191":106559,"_2648":106614},[],"No confundas estos valores:",{"_3150":64058,"_27690":64038,"_19203":106616,"_5":13195,"_26191":106559,"_2648":106617},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3150":64059,"_27690":64038,"_19203":106619,"_5":13195,"_26191":106559,"_2648":106620},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3150":64060,"_27690":64038,"_19203":106622,"_5":13195,"_26191":106559,"_2648":106623},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3150":64061,"_27690":64038,"_19203":106625,"_5":13195,"_26191":106563,"_2648":106626},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3150":64062,"_27690":64038,"_19203":106628,"_5":13195,"_26191":106563,"_2648":106629},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3150":64063,"_27690":64038,"_19203":106631,"_5":13195,"_26191":106567,"_2648":106632},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3150":64064,"_27690":64038,"_19203":106634,"_5":13195,"_26191":106567,"_2648":106635},[],"Para el diseño recomendado:",{"_3150":64065,"_27690":64038,"_19203":106637,"_5":13195,"_26191":106567,"_2648":106638},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3150":64066,"_27690":64038,"_19203":106640,"_5":13195,"_26191":106567,"_2648":106641},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3150":64067,"_27690":64038,"_19203":106643,"_5":13195,"_26191":106567,"_2648":106644},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3150":64068,"_27690":64038,"_19203":106646,"_5":13195,"_26191":106567,"_2648":106647},[],"Apunta DNS a la dirección accesible de la VM.",{"_3150":64069,"_27690":64038,"_19203":106649,"_5":13195,"_26191":106567,"_2648":106650},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3150":64070,"_27690":64038,"_19203":106652,"_5":13195,"_26191":106570,"_2648":106653},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3150":64071,"_27690":64038,"_19203":106655,"_5":13195,"_26191":106574,"_2648":106656},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3150":64072,"_27690":64038,"_19203":106658,"_5":13195,"_26191":106574,"_2648":106659},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3150":64073,"_27690":64038,"_19203":106661,"_5":13195,"_26191":106578,"_2648":106662},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3150":64074,"_27690":64038,"_19203":106664,"_5":13195,"_26191":106578,"_2648":106665},[],"Requisito",{"_3150":64075,"_27690":64038,"_19203":106667,"_5":13195,"_26191":106578,"_2648":106668},[],"Diseño recomendado",{"_3150":64076,"_27690":64038,"_19203":106670,"_5":13195,"_26191":106578,"_2648":106671},[],"Consecuencia",{"_3150":64077,"_27690":64038,"_19203":106673,"_5":13195,"_26191":106578,"_2648":106674},[],"Varias URL o servicios de Lamassu",{"_3150":64078,"_27690":64038,"_19203":106676,"_5":13195,"_26191":106578,"_2648":106677},[],"Un Gateway con varias rutas",{"_3150":64079,"_27690":64038,"_19203":106679,"_5":13195,"_26191":106578,"_2648":106680},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3150":64080,"_27690":64038,"_19203":106682,"_5":13195,"_26191":106578,"_2648":106683},[],"Gateways independientes e IP externas distintas",{"_3150":64081,"_27690":64038,"_19203":106685,"_5":13195,"_26191":106578,"_2648":106686},[],"Una VIP por Gateway",{"_3150":64082,"_27690":64038,"_19203":106688,"_5":13195,"_26191":106578,"_2648":106689},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3150":64083,"_27690":64038,"_19203":106691,"_5":13195,"_26191":106578,"_2648":106692},[],"Gateways independientes, un nodo y una IP",{"_3150":64084,"_27690":64038,"_19203":106694,"_5":13195,"_26191":106578,"_2648":106695},[],"Puertos externos diferentes",{"_3150":64085,"_27690":64038,"_19203":106697,"_5":13195,"_26191":106578,"_2648":106698},[],"Los clientes deben indicar puertos no estándar",{"_3150":64086,"_27690":64038,"_19203":106700,"_5":13195,"_26191":106578,"_2648":106701},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3150":64087,"_27690":64038,"_19203":106703,"_5":13195,"_26191":106578,"_2648":106704},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3150":64088,"_27690":64038,"_19203":106706,"_5":13195,"_26191":106578,"_2648":106707},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3150":64089,"_27690":64038,"_19203":106709,"_5":13195,"_26191":106578,"_2648":106710},[],"Recursos Gateway separados pero proxy compartido",{"_3150":64090,"_27690":64038,"_19203":106712,"_5":13195,"_26191":106578,"_2648":106713},[],"Modo merged Gateway de Envoy",{"_3150":64091,"_27690":64038,"_19203":106715,"_5":13195,"_26191":106578,"_2648":106716},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3150":64092,"_27690":64038,"_19203":106718,"_5":13195,"_26191":106578,"_2648":106719},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3150":64093,"_27690":64038,"_19203":106721,"_5":13195,"_26191":106578,"_2648":106722},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3150":64094,"_27690":64038,"_19203":106724,"_5":13195,"_26191":106578,"_2648":106725},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3150":64095,"_27690":64038,"_19203":106727,"_5":13195,"_26191":106578,"_2648":106728},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3150":64096,"_27690":64038,"_19203":106730,"_5":13195,"_26191":106582,"_2648":106731},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3150":64097,"_27690":64038,"_19203":106733,"_5":13195,"_26191":106582,"_2648":106734},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3150":64098,"_27690":64038,"_19203":106736,"_5":13195,"_26191":106582,"_2648":106737},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3150":64099,"_27690":64038,"_19203":106739,"_5":13195,"_26191":106582,"_2648":106740},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3150":64100,"_27690":64038,"_19203":106742,"_5":13195,"_26191":106582,"_2648":106743},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3150":64101,"_27690":64038,"_19203":106745,"_5":13195,"_26191":106586,"_2648":106746},[],"Comprueba, en orden:",{"_3150":64102,"_27690":64038,"_19203":106748,"_5":13195,"_26191":106586,"_2648":106749},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3150":64103,"_27690":64038,"_19203":106751,"_5":13195,"_26191":106586,"_2648":106752},[],"Su estado contiene la dirección esperada.",{"_3150":64104,"_27690":64038,"_19203":106754,"_5":13195,"_26191":106586,"_2648":106755},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3150":64105,"_27690":64038,"_19203":106757,"_5":13195,"_26191":106586,"_2648":106758},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3150":64106,"_27690":64038,"_19203":106760,"_5":13195,"_26191":106586,"_2648":106761},[],"DNS resuelve al endpoint accesible externamente.",{"_3150":64107,"_27690":64038,"_19203":106763,"_5":13195,"_26191":106586,"_2648":106764},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3150":64108,"_27690":64038,"_19203":106766,"_5":13195,"_26191":106586,"_2648":106767},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3150":64109,"_27690":64109,"_5":13521,"_2648":45107,"_28032":106769,"_19203":106770,"_26191":64109},[45000,105823,106057],[],{"_3150":64110,"_27690":64109,"_19203":106772,"_5":13195,"_26191":64109,"_2648":106773},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3150":64111,"_27690":64109,"_5":28029,"_19203":106775,"_26191":106776,"_2648":106777},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3150":64112,"_27690":64109,"_5":28029,"_19203":106779,"_26191":106780,"_2648":106781},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3150":64113,"_27690":64109,"_5":28029,"_19203":106783,"_26191":106784,"_2648":106785},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3150":64114,"_27690":64109,"_5":28029,"_19203":106787,"_26191":106788,"_2648":106789},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3150":64115,"_27690":64109,"_5":28029,"_19203":106791,"_26191":106792,"_2648":106793},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3150":64116,"_27690":64109,"_5":28029,"_19203":106795,"_26191":106796,"_2648":106797},[],"/docs/pr-preview/pr-40/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3150":64117,"_27690":64109,"_19203":106799,"_5":13195,"_26191":106776,"_2648":106800},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3150":64118,"_27690":64109,"_19203":106802,"_5":13195,"_26191":106780,"_2648":106803},[],"Flujo",{"_3150":64119,"_27690":64109,"_19203":106805,"_5":13195,"_26191":106780,"_2648":106806},[],"Úsalo para",{"_3150":64120,"_27690":64109,"_19203":106808,"_5":13195,"_26191":106780,"_2648":106809},[],"Qué instala",{"_3150":64121,"_27690":64109,"_19203":106811,"_5":13195,"_26191":106780,"_2648":46024},[],{"_3150":64122,"_27690":64109,"_19203":106813,"_5":13195,"_26191":106780,"_2648":106814},[],"Producción y entornos controlados",{"_3150":64123,"_27690":64109,"_19203":106816,"_5":13195,"_26191":106780,"_2648":106817},[],"Servicios de Lamassu y recursos de Gateway API",{"_3150":64124,"_27690":64109,"_19203":106819,"_5":13195,"_26191":106780,"_2648":45244},[],{"_3150":64125,"_27690":64109,"_19203":106821,"_5":13195,"_26191":106780,"_2648":106822},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3150":64126,"_27690":64109,"_19203":106824,"_5":13195,"_26191":106780,"_2648":106825},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3150":64127,"_27690":64109,"_19203":106827,"_5":13195,"_26191":106784,"_2648":106828},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3150":64128,"_27690":64109,"_19203":106830,"_5":13195,"_26191":106784,"_2648":106831},[],"Área",{"_3150":64129,"_27690":64109,"_19203":106833,"_5":13195,"_26191":106784,"_2648":106834},[],"El chart de Lamassu proporciona",{"_3150":64130,"_27690":64109,"_19203":106836,"_5":13195,"_26191":106784,"_2648":106837},[],"Tú proporcionas",{"_3150":64131,"_27690":64109,"_19203":106839,"_5":13195,"_26191":106784,"_2648":106840},[],"Aplicaciones Lamassu",{"_3150":64132,"_27690":64109,"_19203":106842,"_5":13195,"_26191":106784,"_2648":106843},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3150":64133,"_27690":64109,"_19203":106845,"_5":13195,"_26191":106784,"_2648":106846},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3150":64134,"_27690":64109,"_19203":106848,"_5":13195,"_26191":106784,"_2648":106849},[],"Datos PostgreSQL",{"_3150":64135,"_27690":64109,"_19203":106851,"_5":13195,"_26191":106784,"_2648":106852},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3150":64136,"_27690":64109,"_19203":106854,"_5":13195,"_26191":106784,"_2648":106855},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3150":64137,"_27690":64109,"_19203":106857,"_5":13195,"_26191":106784,"_2648":106858},[],"Mensajería",{"_3150":64138,"_27690":64109,"_19203":106860,"_5":13195,"_26191":106784,"_2648":106861},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3150":64139,"_27690":64109,"_19203":106863,"_5":13195,"_26191":106784,"_2648":106864},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3150":64140,"_27690":64109,"_19203":106866,"_5":13195,"_26191":106784,"_2648":106867},[],"Identidad",{"_3150":64141,"_27690":64109,"_19203":106869,"_5":13195,"_26191":106784,"_2648":106870},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3150":64142,"_27690":64109,"_19203":106872,"_5":13195,"_26191":106784,"_2648":106873},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3150":64143,"_27690":64109,"_19203":106875,"_5":13195,"_26191":106784,"_2648":106876},[],"Enrutamiento externo",{"_3150":64144,"_27690":64109,"_19203":106878,"_5":13195,"_26191":106784,"_2648":106879},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3150":64145,"_27690":64109,"_19203":106881,"_5":13195,"_26191":106784,"_2648":106882},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3150":64146,"_27690":64109,"_19203":106884,"_5":13195,"_26191":106784,"_2648":46098},[],{"_3150":64147,"_27690":64109,"_19203":106886,"_5":13195,"_26191":106784,"_2648":106887},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_3150":64148,"_27690":64109,"_19203":106889,"_5":13195,"_26191":106784,"_2648":106890},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3150":64149,"_27690":64109,"_19203":106892,"_5":13195,"_26191":106784,"_2648":106893},[],"Datos persistentes de la aplicación",{"_3150":64150,"_27690":64109,"_19203":106895,"_5":13195,"_26191":106784,"_2648":106896},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3150":64151,"_27690":64109,"_19203":106898,"_5":13195,"_26191":106784,"_2648":106899},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3150":64152,"_27690":64109,"_19203":106901,"_5":13195,"_26191":106784,"_2648":106902},[],"Integraciones opcionales",{"_3150":64153,"_27690":64109,"_19203":106904,"_5":13195,"_26191":106784,"_2648":106905},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3150":64154,"_27690":64109,"_19203":106907,"_5":13195,"_26191":106784,"_2648":106908},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3150":64155,"_27690":64109,"_19203":106910,"_5":13195,"_26191":106784,"_2648":106911},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3150":64156,"_27690":64109,"_19203":106913,"_5":13195,"_26191":106784,"_2648":106914},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3150":64157,"_27690":64109,"_19203":106916,"_5":13195,"_26191":106788,"_2648":106917},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3150":64158,"_27690":64109,"_19203":106919,"_5":13195,"_26191":106788,"_2648":106920},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3150":64159,"_27690":64109,"_19203":106922,"_5":13195,"_26191":106792,"_2648":106923},[],"Kubernetes 1.24 o posterior",{"_3150":64160,"_27690":64109,"_19203":106925,"_5":13195,"_26191":106792,"_2648":106926},[],"Helm 3.2 o posterior",{"_3150":64161,"_27690":64109,"_19203":106928,"_5":13195,"_26191":106792,"_2648":106929},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3150":64162,"_27690":64109,"_19203":106931,"_5":13195,"_26191":106792,"_2648":106932},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_3150":64163,"_27690":64109,"_19203":106934,"_5":13195,"_26191":106792,"_2648":106935},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3150":64164,"_27690":64109,"_19203":106937,"_5":13195,"_26191":106792,"_2648":106938},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3150":64165,"_27690":64109,"_19203":106940,"_5":13195,"_26191":106792,"_2648":106941},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3150":64166,"_27690":64109,"_19203":106943,"_5":13195,"_26191":106796,"_2648":106944},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3150":64167,"_27690":64109,"_19203":106946,"_5":13195,"_26191":106796,"_2648":106947},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3150":64168,"_27690":64109,"_19203":106949,"_5":13195,"_26191":106796,"_2648":106950},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3150":64169,"_27690":64109,"_19203":106952,"_5":13195,"_26191":106796,"_2648":106953},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3150":64170,"_27690":64170,"_5":13521,"_2648":106955,"_28032":106956,"_19203":106958,"_26191":64170},"Resolución de problemas de despliegue",[45000,105823,106957],"Operación",[],{"_3150":64171,"_27690":64170,"_19203":106960,"_5":13195,"_26191":64170,"_2648":106961},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3150":64172,"_27690":64170,"_5":28029,"_19203":106963,"_26191":106964,"_2648":106965},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3150":64173,"_27690":64170,"_5":28029,"_19203":106967,"_26191":106968,"_2648":106969},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3150":64174,"_27690":64170,"_5":28029,"_19203":106971,"_26191":106972,"_2648":106973},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3150":64175,"_27690":64170,"_5":28029,"_19203":106975,"_26191":106976,"_2648":106977},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3150":64176,"_27690":64170,"_5":28029,"_19203":106979,"_26191":106980,"_2648":106981},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3150":64177,"_27690":64170,"_5":28029,"_19203":106983,"_26191":106984,"_2648":106985},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3150":64178,"_27690":64170,"_5":28029,"_19203":106987,"_26191":106988,"_2648":106989},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3150":64179,"_27690":64170,"_5":28029,"_19203":106991,"_26191":106992,"_2648":106993},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3150":64180,"_27690":64170,"_5":28029,"_19203":106995,"_26191":106996,"_2648":106997},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3150":64181,"_27690":64170,"_5":28029,"_19203":106999,"_26191":107000,"_2648":107001},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3150":64182,"_27690":64170,"_5":28029,"_19203":107003,"_26191":107004,"_2648":107005},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3150":64183,"_27690":64170,"_5":28029,"_19203":107007,"_26191":107008,"_2648":107009},[],"/docs/pr-preview/pr-40/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3150":64184,"_27690":64170,"_19203":107011,"_5":13195,"_26191":64170,"_2648":107012},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3150":64185,"_27690":64170,"_19203":107014,"_5":13195,"_26191":106968,"_2648":107015},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3150":64186,"_27690":64170,"_19203":107017,"_5":13195,"_26191":106972,"_2648":107018},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3150":64187,"_27690":64170,"_19203":107020,"_5":13195,"_26191":106976,"_2648":107021},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3150":64188,"_27690":64170,"_19203":107023,"_5":13195,"_26191":106980,"_2648":107024},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3150":64189,"_27690":64170,"_19203":107026,"_5":13195,"_26191":106984,"_2648":107027},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3150":64190,"_27690":64170,"_19203":107029,"_5":13195,"_26191":106988,"_2648":107030},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3150":64191,"_27690":64170,"_19203":107032,"_5":13195,"_26191":106988,"_2648":107033},[],"Ejecuta también la prueba de conectividad del chart:",{"_3150":64192,"_27690":64170,"_19203":107035,"_5":13195,"_26191":106988,"_2648":107036},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3150":64193,"_27690":64170,"_19203":107038,"_5":13195,"_26191":106988,"_2648":107039},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3150":64194,"_27690":64170,"_19203":107041,"_5":13195,"_26191":106992,"_2648":107042},[],"Si recibes un 401:",{"_3150":64195,"_27690":64170,"_19203":107044,"_5":13195,"_26191":106992,"_2648":107045},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3150":64196,"_27690":64170,"_19203":107047,"_5":13195,"_26191":106992,"_2648":107048},[],"verifica emisor, audiencia y expiración del token;",{"_3150":64197,"_27690":64170,"_19203":107050,"_5":13195,"_26191":106992,"_2648":107051},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3150":64198,"_27690":64170,"_19203":107053,"_5":13195,"_26191":106992,"_2648":107054},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3150":64199,"_27690":64170,"_19203":107056,"_5":13195,"_26191":106992,"_2648":107057},[],"Si el login termina pero las APIs devuelven 403:",{"_3150":64200,"_27690":64170,"_19203":107059,"_5":13195,"_26191":106992,"_2648":107060},[],"inspecciona los claims reales del token;",{"_3150":64201,"_27690":64170,"_19203":107062,"_5":13195,"_26191":106992,"_2648":107063},[],"confirma que coinciden con un principal activo;",{"_3150":64202,"_27690":64170,"_19203":107065,"_5":13195,"_26191":106992,"_2648":107066},[],"revisa las políticas concedidas al principal;",{"_3150":64203,"_27690":64170,"_19203":107068,"_5":13195,"_26191":106992,"_2648":107069},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3150":64204,"_27690":64170,"_19203":107071,"_5":13195,"_26191":106992,"_2648":107072},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3150":64205,"_27690":64170,"_19203":107074,"_5":13195,"_26191":106996,"_2648":107075},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3150":64206,"_27690":64170,"_19203":107077,"_5":13195,"_26191":106996,"_2648":107078},[],"Localiza el pod y Service de authz.",{"_3150":64207,"_27690":64170,"_19203":107080,"_5":13195,"_26191":106996,"_2648":107081},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3150":64208,"_27690":64170,"_19203":107083,"_5":13195,"_26191":106996,"_2648":107084},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3150":64209,"_27690":64170,"_19203":107086,"_5":13195,"_26191":106996,"_2648":107087},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3150":64210,"_27690":64170,"_19203":107089,"_5":13195,"_26191":106996,"_2648":107090},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3150":64211,"_27690":64170,"_19203":107092,"_5":13195,"_26191":107000,"_2648":107093},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3150":64212,"_27690":64170,"_19203":107095,"_5":13195,"_26191":107000,"_2648":107096},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3150":64213,"_27690":64170,"_19203":107098,"_5":13195,"_26191":107000,"_2648":107099},[],"volumen persistente sin enlazar;",{"_3150":64214,"_27690":64170,"_19203":107101,"_5":13195,"_26191":107000,"_2648":107102},[],"imagen inaccesible o política de pull incorrecta;",{"_3150":64215,"_27690":64170,"_19203":107104,"_5":13195,"_26191":107000,"_2648":107105},[],"configuración inválida del motor criptográfico;",{"_3150":64216,"_27690":64170,"_19203":107107,"_5":13195,"_26191":107000,"_2648":107108},[],"límites de CPU o memoria demasiado bajos;",{"_3150":64217,"_27690":64170,"_19203":107110,"_5":13195,"_26191":107000,"_2648":107111},[],"migración previa incompleta.",{"_3150":64218,"_27690":64170,"_19203":107113,"_5":13195,"_26191":107000,"_2648":107114},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3150":64219,"_27690":64170,"_19203":107116,"_5":13195,"_26191":107000,"_2648":107117},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3150":64220,"_27690":64170,"_19203":107119,"_5":13195,"_26191":107004,"_2648":107120},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3150":64221,"_27690":64170,"_19203":107122,"_5":13195,"_26191":107004,"_2648":107123},[],"verifica que esté habilitado en el servicio emisor;",{"_3150":64222,"_27690":64170,"_19203":107125,"_5":13195,"_26191":107004,"_2648":107126},[],"comprueba conectividad y credenciales AMQP;",{"_3150":64223,"_27690":64170,"_19203":107128,"_5":13195,"_26191":107004,"_2648":107129},[],"revisa exchange, routing key, colas y consumidores;",{"_3150":64224,"_27690":64170,"_19203":107131,"_5":13195,"_26191":107004,"_2648":107132},[],"inspecciona dead-letter queues;",{"_3150":64225,"_27690":64170,"_19203":107134,"_5":13195,"_26191":107004,"_2648":107135},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3150":64226,"_27690":64170,"_19203":107137,"_5":13195,"_26191":107004,"_2648":107138},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3150":64227,"_27690":64170,"_19203":107140,"_5":13195,"_26191":107008,"_2648":107141},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3150":64228,"_27690":64170,"_19203":107143,"_5":13195,"_26191":107008,"_2648":107144},[],"Antes de cerrar una incidencia, guarda:",{"_3150":64229,"_27690":64170,"_19203":107146,"_5":13195,"_26191":107008,"_2648":107147},[],"causa confirmada;",{"_3150":64230,"_27690":64170,"_19203":107149,"_5":13195,"_26191":107008,"_2648":107150},[],"alcance temporal y recursos afectados;",{"_3150":64231,"_27690":64170,"_19203":107152,"_5":13195,"_26191":107008,"_2648":107153},[],"comandos o consultas utilizados;",{"_3150":64232,"_27690":64170,"_19203":107155,"_5":13195,"_26191":107008,"_2648":107156},[],"cambio aplicado y forma de revertirlo;",{"_3150":64233,"_27690":64170,"_19203":107158,"_5":13195,"_26191":107008,"_2648":107159},[],"validación desde un consumidor;",{"_3150":64234,"_27690":64170,"_19203":107161,"_5":13195,"_26191":107008,"_2648":107162},[],"acción preventiva y propietario.",{"_3150":64235,"_27690":64235,"_5":13521,"_2648":107164,"_28032":107165,"_19203":107168,"_26191":64235},"Control de acceso",[45000,107166,107167],"Plataforma","Administración",[],{"_3150":64236,"_27690":64235,"_19203":107170,"_5":13195,"_26191":64235,"_2648":107171},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3150":64237,"_27690":64235,"_5":28029,"_19203":107173,"_26191":107174,"_2648":107175},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3150":64238,"_27690":64235,"_5":28029,"_19203":107177,"_26191":107178,"_2648":107179},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3150":64239,"_27690":64235,"_5":28029,"_19203":107181,"_26191":107182,"_2648":107183},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3150":64240,"_27690":64235,"_5":28029,"_19203":107185,"_26191":107186,"_2648":107187},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3150":64241,"_27690":64235,"_5":28029,"_19203":107189,"_26191":107190,"_2648":107191},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3150":64242,"_27690":64235,"_5":28029,"_19203":107193,"_26191":107194,"_2648":107195},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3150":64243,"_27690":64235,"_5":28029,"_19203":107197,"_26191":107198,"_2648":107199},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3150":64244,"_27690":64235,"_5":28029,"_19203":107201,"_26191":107202,"_2648":107203},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3150":64245,"_27690":64235,"_5":28029,"_19203":107205,"_26191":107206,"_2648":107207},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3150":64246,"_27690":64235,"_5":28029,"_19203":107209,"_26191":107210,"_2648":107211},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3150":64247,"_27690":64235,"_5":28029,"_19203":107213,"_26191":107214,"_2648":107215},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3150":64248,"_27690":64235,"_5":28029,"_19203":107217,"_26191":107218,"_2648":107219},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3150":64249,"_27690":64235,"_5":28029,"_19203":107221,"_26191":107222,"_2648":107223},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3150":64250,"_27690":64235,"_5":28029,"_19203":107225,"_26191":107226,"_2648":107227},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3150":64251,"_27690":64235,"_5":28029,"_19203":107229,"_26191":107230,"_2648":107231},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3150":64252,"_27690":64235,"_5":28029,"_19203":107233,"_26191":107234,"_2648":106425},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3150":64253,"_27690":64235,"_5":28029,"_19203":107236,"_26191":107237,"_2648":107238},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3150":64254,"_27690":64235,"_5":28029,"_19203":107240,"_26191":107241,"_2648":107242},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3150":64255,"_27690":64235,"_5":28029,"_19203":107244,"_26191":107245,"_2648":107246},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3150":64256,"_27690":64235,"_5":28029,"_19203":107248,"_26191":107249,"_2648":107250},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3150":64257,"_27690":64235,"_5":28029,"_19203":107252,"_26191":107253,"_2648":107254},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3150":64258,"_27690":64235,"_5":28029,"_19203":107256,"_26191":107257,"_2648":107258},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3150":64259,"_27690":64235,"_5":28029,"_19203":107260,"_26191":107261,"_2648":107262},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3150":64260,"_27690":64235,"_5":28029,"_19203":107264,"_26191":107265,"_2648":107266},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3150":64261,"_27690":64235,"_5":28029,"_19203":107268,"_26191":107269,"_2648":107270},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3150":64262,"_27690":64235,"_5":28029,"_19203":107272,"_26191":107273,"_2648":107274},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3150":64263,"_27690":64235,"_5":28029,"_19203":107276,"_26191":107277,"_2648":107278},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3150":64264,"_27690":64235,"_5":28029,"_19203":107280,"_26191":107281,"_2648":107282},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3150":64265,"_27690":64235,"_5":28029,"_19203":107284,"_26191":107285,"_2648":107286},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3150":64266,"_27690":64235,"_5":28029,"_19203":107288,"_26191":107289,"_2648":107290},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3150":64267,"_27690":64235,"_5":28029,"_19203":107292,"_26191":107293,"_2648":107294},[],"/docs/pr-preview/pr-40/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3150":64268,"_27690":64235,"_19203":107296,"_5":13195,"_26191":64235,"_2648":107297},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3150":64269,"_27690":64235,"_19203":107299,"_5":13195,"_26191":64235,"_2648":107300},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3150":64270,"_27690":64235,"_19203":107302,"_5":13195,"_26191":64235,"_2648":107303},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3150":64271,"_27690":64235,"_19203":107305,"_5":13195,"_26191":107174,"_2648":107306},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3150":64272,"_27690":64235,"_19203":107308,"_5":13195,"_26191":107174,"_2648":107309},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3150":64273,"_27690":64235,"_19203":107311,"_5":13195,"_26191":107174,"_2648":107312},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3150":64274,"_27690":64235,"_19203":107314,"_5":13195,"_26191":107174,"_2648":107315},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3150":64275,"_27690":64235,"_19203":107317,"_5":13195,"_26191":107174,"_2648":107318},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3150":64276,"_27690":64235,"_19203":107320,"_5":13195,"_26191":107174,"_2648":107321},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3150":64277,"_27690":64235,"_19203":107323,"_5":13195,"_26191":107178,"_2648":107324},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3150":64278,"_27690":64235,"_19203":107326,"_5":13195,"_26191":107178,"_2648":107327},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3150":64279,"_27690":64235,"_19203":107329,"_5":13195,"_26191":107182,"_2648":107330},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3150":64280,"_27690":64235,"_19203":107332,"_5":13195,"_26191":107182,"_2648":107333},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3150":64281,"_27690":64235,"_19203":107335,"_5":13195,"_26191":107182,"_2648":107336},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3150":64282,"_27690":64235,"_19203":107338,"_5":13195,"_26191":107182,"_2648":107339},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3150":64283,"_27690":64235,"_19203":107341,"_5":13195,"_26191":107182,"_2648":107342},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3150":64284,"_27690":64235,"_19203":107344,"_5":13195,"_26191":107182,"_2648":107345},[],"Carga por separado las políticas concedidas a cada principal.",{"_3150":64285,"_27690":64235,"_19203":107347,"_5":13195,"_26191":107182,"_2648":107348},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3150":64286,"_27690":64235,"_19203":107350,"_5":13195,"_26191":107182,"_2648":107351},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3150":64287,"_27690":64235,"_19203":107353,"_5":13195,"_26191":107182,"_2648":107354},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3150":64288,"_27690":64235,"_19203":107356,"_5":13195,"_26191":107182,"_2648":107357},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3150":64289,"_27690":64235,"_19203":107359,"_5":13195,"_26191":107182,"_2648":107360},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3150":64290,"_27690":64235,"_19203":107362,"_5":13195,"_26191":107182,"_2648":107363},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3150":64291,"_27690":64235,"_19203":107365,"_5":13195,"_26191":107186,"_2648":107366},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3150":64292,"_27690":64235,"_19203":107368,"_5":13195,"_26191":107186,"_2648":107369},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3150":64293,"_27690":64235,"_19203":107371,"_5":13195,"_26191":107186,"_2648":107372},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3150":64294,"_27690":64235,"_19203":107374,"_5":13195,"_26191":107186,"_2648":107375},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3150":64295,"_27690":64235,"_19203":107377,"_5":13195,"_26191":107186,"_2648":107378},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3150":64296,"_27690":64235,"_19203":107380,"_5":13195,"_26191":107186,"_2648":107381},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3150":64297,"_27690":64235,"_19203":107383,"_5":13195,"_26191":107186,"_2648":107384},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3150":64298,"_27690":64235,"_19203":107386,"_5":13195,"_26191":107186,"_2648":107387},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3150":64299,"_27690":64235,"_19203":107389,"_5":13195,"_26191":107190,"_2648":107390},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3150":64300,"_27690":64235,"_19203":107392,"_5":13195,"_26191":107190,"_2648":107393},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3150":64301,"_27690":64235,"_19203":107395,"_5":13195,"_26191":107190,"_2648":107396},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3150":64302,"_27690":64235,"_19203":107398,"_5":13195,"_26191":107190,"_2648":107399},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3150":64303,"_27690":64235,"_19203":107401,"_5":13195,"_26191":107190,"_2648":107402},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3150":64304,"_27690":64235,"_19203":107404,"_5":13195,"_26191":107190,"_2648":107405},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3150":64305,"_27690":64235,"_19203":107407,"_5":13195,"_26191":107190,"_2648":107408},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3150":64306,"_27690":64235,"_19203":107410,"_5":13195,"_26191":107190,"_2648":107411},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3150":64307,"_27690":64235,"_19203":107413,"_5":13195,"_26191":107190,"_2648":107414},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3150":64308,"_27690":64235,"_19203":107416,"_5":13195,"_26191":107190,"_2648":107417},[],"Las acciones se dividen en dos grupos:",{"_3150":64309,"_27690":64235,"_19203":107419,"_5":13195,"_26191":107190,"_2648":107420},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3150":64310,"_27690":64235,"_19203":107422,"_5":13195,"_26191":107190,"_2648":107423},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3150":64311,"_27690":64235,"_19203":107425,"_5":13195,"_26191":107190,"_2648":107426},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3150":64312,"_27690":64235,"_19203":107428,"_5":13195,"_26191":107194,"_2648":107429},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3150":64313,"_27690":64235,"_19203":107431,"_5":13195,"_26191":107194,"_2648":107432},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3150":64314,"_27690":64235,"_19203":107434,"_5":13195,"_26191":107194,"_2648":107435},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3150":64315,"_27690":64235,"_19203":107437,"_5":13195,"_26191":107198,"_2648":107438},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3150":64316,"_27690":64235,"_19203":107440,"_5":13195,"_26191":107198,"_2648":107441},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3150":64317,"_27690":64235,"_19203":107443,"_5":13195,"_26191":107198,"_2648":107444},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3150":64318,"_27690":64235,"_19203":107446,"_5":13195,"_26191":107198,"_2648":107447},[],"Los operadores implementados son:",{"_3150":64319,"_27690":64235,"_19203":107449,"_5":13195,"_26191":107198,"_2648":107450},[],"`equals`, para igualdad exacta;",{"_3150":64320,"_27690":64235,"_19203":107452,"_5":13195,"_26191":107198,"_2648":107453},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3150":64321,"_27690":64235,"_19203":107455,"_5":13195,"_26191":107198,"_2648":107456},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3150":64322,"_27690":64235,"_19203":107458,"_5":13195,"_26191":107198,"_2648":107459},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3150":64323,"_27690":64235,"_19203":107461,"_5":13195,"_26191":107202,"_2648":107462},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3150":64324,"_27690":64235,"_19203":107464,"_5":13195,"_26191":107202,"_2648":107465},[],"Los modos disponibles son:",{"_3150":64325,"_27690":64235,"_19203":107467,"_5":13195,"_26191":107202,"_2648":107468},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3150":64326,"_27690":64235,"_19203":107470,"_5":13195,"_26191":107202,"_2648":107471},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3150":64327,"_27690":64235,"_19203":107473,"_5":13195,"_26191":107202,"_2648":107474},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3150":64328,"_27690":64235,"_19203":107476,"_5":13195,"_26191":107202,"_2648":107477},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3150":64329,"_27690":64235,"_19203":107479,"_5":13195,"_26191":107202,"_2648":107480},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3150":64330,"_27690":64235,"_19203":107482,"_5":13195,"_26191":107202,"_2648":107483},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3150":64331,"_27690":64235,"_19203":107485,"_5":13195,"_26191":107206,"_2648":107486},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3150":64332,"_27690":64235,"_19203":107488,"_5":13195,"_26191":107206,"_2648":107489},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3150":64333,"_27690":64235,"_19203":107491,"_5":13195,"_26191":107206,"_2648":107492},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3150":64334,"_27690":64235,"_19203":107494,"_5":13195,"_26191":107206,"_2648":107495},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3150":64335,"_27690":64235,"_19203":107497,"_5":13195,"_26191":107214,"_2648":107498},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3150":64336,"_27690":64235,"_19203":107500,"_5":13195,"_26191":107214,"_2648":107501},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3150":64337,"_27690":64235,"_19203":107503,"_5":13195,"_26191":107218,"_2648":107504},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3150":64338,"_27690":64235,"_19203":107506,"_5":13195,"_26191":107218,"_2648":107507},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3150":64339,"_27690":64235,"_19203":107509,"_5":13195,"_26191":107222,"_2648":107510},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3150":64340,"_27690":64235,"_19203":107512,"_5":13195,"_26191":107222,"_2648":107513},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3150":64341,"_27690":64235,"_19203":107515,"_5":13195,"_26191":107222,"_2648":107516},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3150":64342,"_27690":64235,"_19203":107518,"_5":13195,"_26191":107226,"_2648":107519},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3150":64343,"_27690":64235,"_19203":107521,"_5":13195,"_26191":107226,"_2648":107522},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3150":64344,"_27690":64235,"_19203":107524,"_5":13195,"_26191":107226,"_2648":107525},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3150":64345,"_27690":64235,"_19203":107527,"_5":13195,"_26191":107226,"_2648":107528},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3150":64346,"_27690":64235,"_19203":107530,"_5":13195,"_26191":107226,"_2648":107531},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3150":64347,"_27690":64235,"_19203":107533,"_5":13195,"_26191":107226,"_2648":107534},[],"Ten en cuenta que:",{"_3150":64348,"_27690":64235,"_19203":107536,"_5":13195,"_26191":107226,"_2648":107537},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3150":64349,"_27690":64235,"_19203":107539,"_5":13195,"_26191":107226,"_2648":107540},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3150":64350,"_27690":64235,"_19203":107542,"_5":13195,"_26191":107226,"_2648":107543},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3150":64351,"_27690":64235,"_19203":107545,"_5":13195,"_26191":107230,"_2648":107546},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3150":64352,"_27690":64235,"_19203":107548,"_5":13195,"_26191":107230,"_2648":107549},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3150":64353,"_27690":64235,"_19203":107551,"_5":13195,"_26191":107230,"_2648":107552},[],"acceso completo y de solo lectura a KMS;",{"_3150":64354,"_27690":64235,"_19203":107554,"_5":13195,"_26191":107230,"_2648":107555},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3150":64355,"_27690":64235,"_19203":107557,"_5":13195,"_26191":107230,"_2648":107558},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3150":64356,"_27690":64235,"_19203":107560,"_5":13195,"_26191":107230,"_2648":107561},[],"acceso a la interfaz;",{"_3150":64357,"_27690":64235,"_19203":107563,"_5":13195,"_26191":107230,"_2648":107564},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3150":64358,"_27690":64235,"_19203":107566,"_5":13195,"_26191":107230,"_2648":107567},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3150":64359,"_27690":64235,"_19203":107569,"_5":13195,"_26191":107230,"_2648":107570},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3150":64360,"_27690":64235,"_19203":107572,"_5":13195,"_26191":107234,"_2648":107573},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3150":64361,"_27690":64235,"_19203":107575,"_5":13195,"_26191":107234,"_2648":107576},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3150":64362,"_27690":64235,"_19203":107578,"_5":13195,"_26191":107234,"_2648":107579},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3150":64363,"_27690":64235,"_19203":107581,"_5":13195,"_26191":107237,"_2648":107582},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3150":64364,"_27690":64235,"_19203":107584,"_5":13195,"_26191":107241,"_2648":107585},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3150":64365,"_27690":64235,"_19203":107587,"_5":13195,"_26191":107241,"_2648":107588},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3150":64366,"_27690":64235,"_19203":107590,"_5":13195,"_26191":107245,"_2648":107591},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3150":64367,"_27690":64235,"_19203":107593,"_5":13195,"_26191":107249,"_2648":107594},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3150":64368,"_27690":64235,"_19203":107596,"_5":13195,"_26191":107253,"_2648":107597},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3150":64369,"_27690":64235,"_19203":107599,"_5":13195,"_26191":107257,"_2648":107600},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3150":64370,"_27690":64235,"_19203":107602,"_5":13195,"_26191":107257,"_2648":107603},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3150":64371,"_27690":64235,"_19203":107605,"_5":13195,"_26191":107261,"_2648":107606},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3150":64372,"_27690":64235,"_19203":107608,"_5":13195,"_26191":107261,"_2648":107609},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3150":64373,"_27690":64235,"_19203":107611,"_5":13195,"_26191":107261,"_2648":107612},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3150":64374,"_27690":64235,"_19203":107614,"_5":13195,"_26191":107261,"_2648":107615},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3150":64375,"_27690":64235,"_19203":107617,"_5":13195,"_26191":107261,"_2648":107618},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3150":64376,"_27690":64235,"_19203":107620,"_5":13195,"_26191":107261,"_2648":107621},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3150":64377,"_27690":64235,"_19203":107623,"_5":13195,"_26191":107261,"_2648":107624},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3150":64378,"_27690":64235,"_19203":107626,"_5":13195,"_26191":107261,"_2648":107627},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3150":64379,"_27690":64235,"_19203":107629,"_5":13195,"_26191":107265,"_2648":107630},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3150":64380,"_27690":64235,"_19203":107632,"_5":13195,"_26191":107265,"_2648":107633},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3150":64381,"_27690":64235,"_19203":107635,"_5":13195,"_26191":107265,"_2648":107636},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3150":64382,"_27690":64235,"_19203":107638,"_5":13195,"_26191":107269,"_2648":107639},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3150":64383,"_27690":64235,"_19203":107641,"_5":13195,"_26191":107269,"_2648":107642},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3150":64384,"_27690":64235,"_19203":107644,"_5":13195,"_26191":107269,"_2648":107645},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3150":64385,"_27690":64235,"_19203":107647,"_5":13195,"_26191":107269,"_2648":107648},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3150":64386,"_27690":64235,"_19203":107650,"_5":13195,"_26191":107269,"_2648":107651},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3150":64387,"_27690":64235,"_19203":107653,"_5":13195,"_26191":107269,"_2648":107654},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3150":64388,"_27690":64235,"_19203":107656,"_5":13195,"_26191":107269,"_2648":107657},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3150":64389,"_27690":64235,"_19203":107659,"_5":13195,"_26191":107269,"_2648":107660},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3150":64390,"_27690":64235,"_19203":107662,"_5":13195,"_26191":107277,"_2648":107663},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3150":64391,"_27690":64235,"_19203":107665,"_5":13195,"_26191":107281,"_2648":107666},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3150":64392,"_27690":64235,"_19203":107668,"_5":13195,"_26191":107281,"_2648":107669},[],"que exista un principal activo del tipo correcto;",{"_3150":64393,"_27690":64235,"_19203":107671,"_5":13195,"_26191":107281,"_2648":107672},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3150":64394,"_27690":64235,"_19203":107674,"_5":13195,"_26191":107281,"_2648":107675},[],"que todas las condiciones del principal se cumplan;",{"_3150":64395,"_27690":64235,"_19203":107677,"_5":13195,"_26191":107281,"_2648":107678},[],"que el principal tenga concedida la política esperada;",{"_3150":64396,"_27690":64235,"_19203":107680,"_5":13195,"_26191":107281,"_2648":107681},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3150":64397,"_27690":64235,"_19203":107683,"_5":13195,"_26191":107281,"_2648":107684},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3150":64398,"_27690":64235,"_19203":107686,"_5":13195,"_26191":107281,"_2648":107687},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3150":64399,"_27690":64235,"_19203":107689,"_5":13195,"_26191":107285,"_2648":107690},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3150":64400,"_27690":64235,"_19203":107692,"_5":13195,"_26191":107289,"_2648":107693},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3150":64401,"_27690":64235,"_19203":107695,"_5":13195,"_26191":107293,"_2648":107696},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3150":64402,"_27690":64235,"_19203":107698,"_5":13195,"_26191":107293,"_2648":107699},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3150":64403,"_27690":64403,"_5":13521,"_2648":107701,"_28032":107702,"_19203":107703,"_26191":64403},"Alertas y suscripciones",[45000,107166,107167],[],{"_3150":64404,"_27690":64403,"_19203":107705,"_5":13195,"_26191":64403,"_2648":107706},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3150":64405,"_27690":64403,"_5":28029,"_19203":107708,"_26191":107709,"_2648":107710},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3150":64406,"_27690":64403,"_5":28029,"_19203":107712,"_26191":107713,"_2648":107714},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3150":64407,"_27690":64403,"_5":28029,"_19203":107716,"_26191":107717,"_2648":107718},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3150":64408,"_27690":64403,"_5":28029,"_19203":107720,"_26191":107721,"_2648":107722},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3150":64409,"_27690":64403,"_5":28029,"_19203":107724,"_26191":107725,"_2648":107726},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3150":64410,"_27690":64403,"_5":28029,"_19203":107728,"_26191":107729,"_2648":107730},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3150":64411,"_27690":64403,"_5":28029,"_19203":107732,"_26191":107733,"_2648":107734},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3150":64412,"_27690":64403,"_5":28029,"_19203":107736,"_26191":107737,"_2648":107738},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3150":64413,"_27690":64403,"_5":28029,"_19203":107740,"_26191":107741,"_2648":107742},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3150":64414,"_27690":64403,"_5":28029,"_19203":107744,"_26191":107745,"_2648":107746},[],"/docs/pr-preview/pr-40/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3150":64415,"_27690":64403,"_19203":107748,"_5":13195,"_26191":64403,"_2648":107749},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3150":64416,"_27690":64403,"_19203":107751,"_5":13195,"_26191":107709,"_2648":107752},[],"Un servicio publica un evento de dominio.",{"_3150":64417,"_27690":64403,"_19203":107754,"_5":13195,"_26191":107709,"_2648":107755},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3150":64418,"_27690":64403,"_19203":107757,"_5":13195,"_26191":107709,"_2648":107758},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3150":64419,"_27690":64403,"_19203":107760,"_5":13195,"_26191":107709,"_2648":107761},[],"Lamassu entrega el evento al canal configurado.",{"_3150":64420,"_27690":64403,"_19203":107763,"_5":13195,"_26191":107709,"_2648":107764},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3150":64421,"_27690":64403,"_19203":107766,"_5":13195,"_26191":107713,"_2648":107767},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3150":64422,"_27690":64403,"_19203":107769,"_5":13195,"_26191":107713,"_2648":107770},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3150":64423,"_27690":64403,"_19203":107772,"_5":13195,"_26191":107713,"_2648":107773},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3150":64424,"_27690":64403,"_19203":107775,"_5":13195,"_26191":107713,"_2648":107776},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3150":64425,"_27690":64403,"_19203":107778,"_5":13195,"_26191":107713,"_2648":107779},[],"`apikey_options` necesita `header` y `key`.",{"_3150":64426,"_27690":64403,"_19203":107781,"_5":13195,"_26191":107713,"_2648":107782},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3150":64427,"_27690":64403,"_19203":107784,"_5":13195,"_26191":107713,"_2648":107785},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3150":64428,"_27690":64403,"_19203":107787,"_5":13195,"_26191":107713,"_2648":107788},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3150":64429,"_27690":64403,"_19203":107790,"_5":13195,"_26191":107721,"_2648":107791},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3150":64430,"_27690":64403,"_19203":107793,"_5":13195,"_26191":107725,"_2648":107794},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3150":64431,"_27690":64403,"_19203":107796,"_5":13195,"_26191":107729,"_2648":107797},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3150":64432,"_27690":64403,"_19203":107799,"_5":13195,"_26191":107729,"_2648":107800},[],"**None** notifica todas las instancias del evento.",{"_3150":64433,"_27690":64403,"_19203":107802,"_5":13195,"_26191":107729,"_2648":107803},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3150":64434,"_27690":64403,"_19203":107805,"_5":13195,"_26191":107729,"_2648":107806},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3150":64435,"_27690":64403,"_19203":107808,"_5":13195,"_26191":107729,"_2648":107809},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3150":64436,"_27690":64403,"_19203":107811,"_5":13195,"_26191":107729,"_2648":107812},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3150":64437,"_27690":64403,"_19203":107814,"_5":13195,"_26191":107733,"_2648":107815},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3150":64438,"_27690":64403,"_19203":107817,"_5":13195,"_26191":107737,"_2648":107818},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3150":64439,"_27690":64403,"_19203":107820,"_5":13195,"_26191":107737,"_2648":107821},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3150":64440,"_27690":64403,"_19203":107823,"_5":13195,"_26191":107737,"_2648":107824},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3150":64441,"_27690":64403,"_19203":107826,"_5":13195,"_26191":107737,"_2648":107827},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3150":64442,"_27690":64403,"_19203":107829,"_5":13195,"_26191":107737,"_2648":107830},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3150":64443,"_27690":64403,"_19203":107832,"_5":13195,"_26191":107737,"_2648":107833},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3150":64444,"_27690":64403,"_19203":107835,"_5":13195,"_26191":107737,"_2648":107836},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3150":64445,"_27690":64403,"_19203":107838,"_5":13195,"_26191":107737,"_2648":107839},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3150":64446,"_27690":64403,"_19203":107841,"_5":13195,"_26191":107741,"_2648":107842},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3150":64447,"_27690":64403,"_19203":107844,"_5":13195,"_26191":107745,"_2648":107845},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3150":64448,"_27690":64403,"_19203":107847,"_5":13195,"_26191":107745,"_2648":107848},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3150":64449,"_27690":64403,"_19203":107850,"_5":13195,"_26191":107745,"_2648":107851},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3150":64450,"_27690":64403,"_19203":107853,"_5":13195,"_26191":107745,"_2648":107854},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3150":64451,"_27690":64403,"_19203":107856,"_5":13195,"_26191":107745,"_2648":107857},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3150":64452,"_27690":64403,"_19203":107859,"_5":13195,"_26191":107745,"_2648":107860},[],"**Validación:** `va.role.crl.create`.",{"_3150":64453,"_27690":64403,"_19203":107862,"_5":13195,"_26191":107745,"_2648":107863},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3150":64454,"_27690":64403,"_19203":107865,"_5":13195,"_26191":107745,"_2648":107866},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3150":64455,"_27690":64455,"_5":13521,"_2648":107868,"_28032":107869,"_19203":107870,"_26191":64455},"Registros de auditoría",[45000,107166,107167],[],{"_3150":64456,"_27690":64455,"_19203":107872,"_5":13195,"_26191":64455,"_2648":107873},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3150":64457,"_27690":64455,"_5":28029,"_19203":107875,"_26191":107876,"_2648":107877},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3150":64458,"_27690":64455,"_5":28029,"_19203":107879,"_26191":107880,"_2648":107881},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3150":64459,"_27690":64455,"_5":28029,"_19203":107883,"_26191":107884,"_2648":107885},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3150":64460,"_27690":64455,"_5":28029,"_19203":107887,"_26191":107888,"_2648":107889},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3150":64461,"_27690":64455,"_5":28029,"_19203":107891,"_26191":107892,"_2648":107893},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3150":64462,"_27690":64455,"_5":28029,"_19203":107895,"_26191":107896,"_2648":107897},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3150":64463,"_27690":64455,"_5":28029,"_19203":107899,"_26191":107900,"_2648":107901},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3150":64464,"_27690":64455,"_5":28029,"_19203":107903,"_26191":107904,"_2648":107905},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3150":64465,"_27690":64455,"_5":28029,"_19203":107907,"_26191":107908,"_2648":107909},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3150":64466,"_27690":64455,"_5":28029,"_19203":107911,"_26191":107912,"_2648":107913},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3150":64467,"_27690":64455,"_5":28029,"_19203":107915,"_26191":107916,"_2648":107917},[],"/docs/pr-preview/pr-40/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3150":64468,"_27690":64455,"_19203":107919,"_5":13195,"_26191":64455,"_2648":107920},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3150":64469,"_27690":64455,"_19203":107922,"_5":13195,"_26191":107876,"_2648":107923},[],"El cuerpo de auditoría incluye:",{"_3150":64470,"_27690":64455,"_19203":107925,"_5":13195,"_26191":107876,"_2648":107926},[],"input: datos recibidos por la operación;",{"_3150":64471,"_27690":64455,"_19203":107928,"_5":13195,"_26191":107876,"_2648":107929},[],"has\\_error: indica si el servicio devolvió un error;",{"_3150":64472,"_27690":64455,"_19203":107931,"_5":13195,"_26191":107876,"_2648":107932},[],"output: resultado producido o mensaje de error;",{"_3150":64473,"_27690":64455,"_19203":107934,"_5":13195,"_26191":107876,"_2648":107935},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3150":64474,"_27690":64455,"_19203":107937,"_5":13195,"_26191":107876,"_2648":107938},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3150":64475,"_27690":64455,"_19203":107940,"_5":13195,"_26191":107876,"_2648":107941},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3150":64476,"_27690":64455,"_19203":107943,"_5":13195,"_26191":107880,"_2648":107944},[],"El backend aplica auditoría a mutaciones de:",{"_3150":64477,"_27690":64455,"_19203":107946,"_5":13195,"_26191":107880,"_2648":107947},[],"autoridades, certificados y perfiles de emisión;",{"_3150":64478,"_27690":64455,"_19203":107949,"_5":13195,"_26191":107880,"_2648":107950},[],"claves y motores KMS;",{"_3150":64479,"_27690":64455,"_19203":107952,"_5":13195,"_26191":107880,"_2648":107953},[],"dispositivos e identidades;",{"_3150":64480,"_27690":64455,"_19203":107955,"_5":13195,"_26191":107880,"_2648":107956},[],"DMS y operaciones de enrolamiento;",{"_3150":64481,"_27690":64455,"_19203":107958,"_5":13195,"_26191":107880,"_2648":107959},[],"funciones de validación y CRL;",{"_3150":64482,"_27690":64455,"_19203":107961,"_5":13195,"_26191":107880,"_2648":107962},[],"principales, políticas y concesiones de autorización.",{"_3150":64483,"_27690":64455,"_19203":107964,"_5":13195,"_26191":107880,"_2648":107965},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3150":64484,"_27690":64455,"_19203":107967,"_5":13195,"_26191":107884,"_2648":107968},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3150":64485,"_27690":64455,"_19203":107970,"_5":13195,"_26191":107884,"_2648":107971},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3150":64486,"_27690":64455,"_19203":107973,"_5":13195,"_26191":107884,"_2648":107974},[],"Diseña el consumidor para:",{"_3150":64487,"_27690":64455,"_19203":107976,"_5":13195,"_26191":107884,"_2648":107977},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3150":64488,"_27690":64455,"_19203":107979,"_5":13195,"_26191":107884,"_2648":107980},[],"conservar el CloudEvent completo sin modificar;",{"_3150":64489,"_27690":64455,"_19203":107982,"_5":13195,"_26191":107884,"_2648":107983},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3150":64490,"_27690":64455,"_19203":107985,"_5":13195,"_26191":107884,"_2648":107986},[],"cifrar en tránsito y en reposo;",{"_3150":64491,"_27690":64455,"_19203":107988,"_5":13195,"_26191":107884,"_2648":107989},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3150":64492,"_27690":64455,"_19203":107991,"_5":13195,"_26191":107884,"_2648":107992},[],"aplicar una política explícita de retención y legal hold;",{"_3150":64493,"_27690":64455,"_19203":107994,"_5":13195,"_26191":107884,"_2648":107995},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3150":64494,"_27690":64455,"_19203":107997,"_5":13195,"_26191":107888,"_2648":107998},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3150":64495,"_27690":64455,"_19203":108000,"_5":13195,"_26191":107888,"_2648":108001},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3150":64496,"_27690":64455,"_19203":108003,"_5":13195,"_26191":107896,"_2648":108004},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3150":64497,"_27690":64455,"_19203":108006,"_5":13195,"_26191":107900,"_2648":108007},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3150":64498,"_27690":64455,"_19203":108009,"_5":13195,"_26191":107904,"_2648":108010},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3150":64499,"_27690":64455,"_19203":108012,"_5":13195,"_26191":107908,"_2648":108013},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3150":64500,"_27690":64455,"_19203":108015,"_5":13195,"_26191":107912,"_2648":108016},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3150":64501,"_27690":64455,"_19203":108018,"_5":13195,"_26191":107916,"_2648":108019},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3150":64502,"_27690":64455,"_19203":108021,"_5":13195,"_26191":107916,"_2648":108022},[],"aparece un evento de auditoría correcto;",{"_3150":64503,"_27690":64455,"_19203":108024,"_5":13195,"_26191":107916,"_2648":108025},[],"el principal coincide con la identidad utilizada;",{"_3150":64504,"_27690":64455,"_19203":108027,"_5":13195,"_26191":107916,"_2648":108028},[],"el consumidor lo persiste una sola vez;",{"_3150":64505,"_27690":64455,"_19203":108030,"_5":13195,"_26191":107916,"_2648":108031},[],"puede recuperarse por recurso, actor y periodo;",{"_3150":64506,"_27690":64455,"_19203":108033,"_5":13195,"_26191":107916,"_2648":108034},[],"una interrupción del consumidor produce una alerta.",{"_3150":64507,"_27690":64455,"_19203":108036,"_5":13195,"_26191":107916,"_2648":108037},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3150":64508,"_27690":64508,"_5":13521,"_2648":108039,"_28032":108040,"_19203":108041,"_26191":64508},"Arquitectura de la plataforma",[45000,107166],[],{"_3150":64509,"_27690":64508,"_19203":108043,"_5":13195,"_26191":64508,"_2648":108044},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3150":64510,"_27690":64508,"_5":28029,"_19203":108046,"_26191":108047,"_2648":108048},[],"/docs/pr-preview/pr-40/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3150":64511,"_27690":64508,"_5":28029,"_19203":108050,"_26191":108051,"_2648":108052},[],"/docs/pr-preview/pr-40/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3150":64512,"_27690":64508,"_5":28029,"_19203":108054,"_26191":108055,"_2648":108056},[],"/docs/pr-preview/pr-40/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3150":64513,"_27690":64508,"_5":28029,"_19203":108058,"_26191":108059,"_2648":108060},[],"/docs/pr-preview/pr-40/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3150":64514,"_27690":64508,"_5":28029,"_19203":108062,"_26191":108063,"_2648":108064},[],"/docs/pr-preview/pr-40/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3150":64515,"_27690":64508,"_19203":108066,"_5":13195,"_26191":64508,"_2648":108067},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3150":64516,"_27690":64508,"_19203":108069,"_5":13195,"_26191":64508,"_2648":108070},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3150":64517,"_27690":64508,"_19203":108072,"_5":13195,"_26191":108047,"_2648":108073},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3150":64518,"_27690":64508,"_19203":108075,"_5":13195,"_26191":108051,"_2648":108076},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3150":64519,"_27690":64508,"_19203":108078,"_5":13195,"_26191":108055,"_2648":108079},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3150":64520,"_27690":64508,"_19203":108081,"_5":13195,"_26191":108059,"_2648":108082},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3150":64521,"_27690":64508,"_19203":108084,"_5":13195,"_26191":108063,"_2648":108085},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3150":64522,"_27690":64522,"_5":13521,"_2648":108087,"_28032":108088,"_19203":108089,"_26191":64522},"Cómo funciona Lamassu",[45000,107166],[],{"_3150":64523,"_27690":64522,"_19203":108091,"_5":13195,"_26191":64522,"_2648":108092},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3150":64524,"_27690":64522,"_5":28029,"_19203":108094,"_26191":108095,"_2648":108096},[],"/docs/pr-preview/pr-40/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3150":64525,"_27690":64522,"_5":28029,"_19203":108098,"_26191":108099,"_2648":108100},[],"/docs/pr-preview/pr-40/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3150":64526,"_27690":64522,"_19203":108102,"_5":13195,"_26191":64522,"_2648":108103},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3150":64527,"_27690":64522,"_19203":108105,"_5":13195,"_26191":108095,"_2648":108106},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3150":64528,"_27690":64522,"_19203":108108,"_5":13195,"_26191":108095,"_2648":108109},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3150":64529,"_27690":64522,"_19203":108111,"_5":13195,"_26191":108095,"_2648":108112},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3150":64530,"_27690":64522,"_19203":108114,"_5":13195,"_26191":108095,"_2648":108115},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3150":64531,"_27690":64522,"_19203":108117,"_5":13195,"_26191":108095,"_2648":108118},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3150":64532,"_27690":64522,"_19203":108120,"_5":13195,"_26191":108099,"_2648":108121},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3150":64533,"_27690":64522,"_19203":108123,"_5":13195,"_26191":108099,"_2648":108124},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3150":64534,"_27690":64522,"_19203":108126,"_5":13195,"_26191":108099,"_2648":108127},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3150":64535,"_27690":64522,"_19203":108129,"_5":13195,"_26191":108099,"_2648":108130},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3150":64536,"_27690":64522,"_19203":108132,"_5":13195,"_26191":108099,"_2648":108133},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3150":64537,"_27690":64522,"_19203":108135,"_5":13195,"_26191":108099,"_2648":108136},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3150":64538,"_27690":64522,"_19203":108138,"_5":13195,"_26191":108099,"_2648":108139},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3150":64539,"_27690":64539,"_5":13521,"_2648":108141,"_28032":108142,"_19203":108143,"_26191":64539},"Dispositivos e identidades",[45000,107166,47357,108141],[],{"_3150":64540,"_27690":64539,"_19203":108145,"_5":13195,"_26191":64539,"_2648":108146},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3150":64541,"_27690":64539,"_5":28029,"_19203":108148,"_26191":108149,"_2648":108150},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3150":64542,"_27690":64539,"_5":28029,"_19203":108152,"_26191":108153,"_2648":108154},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3150":64543,"_27690":64539,"_5":28029,"_19203":108156,"_26191":108157,"_2648":108158},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3150":64544,"_27690":64539,"_5":28029,"_19203":108160,"_26191":108161,"_2648":108162},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3150":64545,"_27690":64539,"_5":28029,"_19203":108164,"_26191":108165,"_2648":108166},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3150":64546,"_27690":64539,"_5":28029,"_19203":108168,"_26191":108169,"_2648":108170},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3150":64547,"_27690":64539,"_5":28029,"_19203":108172,"_26191":108173,"_2648":108174},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3150":64548,"_27690":64539,"_5":28029,"_19203":108176,"_26191":108177,"_2648":108178},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3150":64549,"_27690":64539,"_5":28029,"_19203":108180,"_26191":108181,"_2648":108182},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3150":64550,"_27690":64539,"_5":28029,"_19203":108184,"_26191":108185,"_2648":108186},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3150":64551,"_27690":64539,"_5":28029,"_19203":108188,"_26191":108189,"_2648":108190},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3150":64552,"_27690":64539,"_19203":108192,"_5":13195,"_26191":64539,"_2648":108193},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3150":64553,"_27690":64539,"_19203":108195,"_5":13195,"_26191":64539,"_2648":108196},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3150":64554,"_27690":64539,"_19203":108198,"_5":13195,"_26191":108149,"_2648":108199},[],"Vista operativa",{"_3150":64555,"_27690":64539,"_19203":108201,"_5":13195,"_26191":108149,"_2648":108202},[],"Interpretación",{"_3150":64556,"_27690":64539,"_19203":108204,"_5":13195,"_26191":108149,"_2648":47420},[],{"_3150":64557,"_27690":64539,"_19203":108206,"_5":13195,"_26191":108149,"_2648":108207},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3150":64558,"_27690":64539,"_19203":108209,"_5":13195,"_26191":108149,"_2648":47426},[],{"_3150":64559,"_27690":64539,"_19203":108211,"_5":13195,"_26191":108149,"_2648":108212},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3150":64560,"_27690":64539,"_19203":108214,"_5":13195,"_26191":108149,"_2648":47432},[],{"_3150":64561,"_27690":64539,"_19203":108216,"_5":13195,"_26191":108149,"_2648":108217},[],"La identidad está en la ventana operativa de renovación.",{"_3150":64562,"_27690":64539,"_19203":108219,"_5":13195,"_26191":108149,"_2648":47438},[],{"_3150":64563,"_27690":64539,"_19203":108221,"_5":13195,"_26191":108149,"_2648":108222},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3150":64564,"_27690":64539,"_19203":108224,"_5":13195,"_26191":108149,"_2648":47444},[],{"_3150":64565,"_27690":64539,"_19203":108226,"_5":13195,"_26191":108149,"_2648":108227},[],"La identidad ha vencido.",{"_3150":64566,"_27690":64539,"_19203":108229,"_5":13195,"_26191":108149,"_2648":47450},[],{"_3150":64567,"_27690":64539,"_19203":108231,"_5":13195,"_26191":108149,"_2648":108232},[],"La identidad está marcada como revocada.",{"_3150":64568,"_27690":64539,"_19203":108234,"_5":13195,"_26191":108149,"_2648":47456},[],{"_3150":64569,"_27690":64539,"_19203":108236,"_5":13195,"_26191":108149,"_2648":108237},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3150":64570,"_27690":64539,"_19203":108239,"_5":13195,"_26191":108149,"_2648":108240},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3150":64571,"_27690":64539,"_19203":108242,"_5":13195,"_26191":108153,"_2648":108243},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3150":64572,"_27690":64539,"_19203":108245,"_5":13195,"_26191":108153,"_2648":108246},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3150":64573,"_27690":64539,"_19203":108248,"_5":13195,"_26191":108153,"_2648":108249},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3150":64574,"_27690":64539,"_19203":108251,"_5":13195,"_26191":108153,"_2648":108252},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3150":64575,"_27690":64539,"_19203":108254,"_5":13195,"_26191":108157,"_2648":108255},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3150":64576,"_27690":64539,"_19203":108257,"_5":13195,"_26191":108161,"_2648":108258},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3150":64577,"_27690":64539,"_19203":108260,"_5":13195,"_26191":108165,"_2648":108261},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3150":64578,"_27690":64539,"_19203":108263,"_5":13195,"_26191":108169,"_2648":108264},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3150":64579,"_27690":64539,"_19203":108266,"_5":13195,"_26191":108173,"_2648":108267},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3150":64580,"_27690":64539,"_19203":108269,"_5":13195,"_26191":108173,"_2648":108270},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3150":64581,"_27690":64539,"_19203":108272,"_5":13195,"_26191":108177,"_2648":108273},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3150":64582,"_27690":64539,"_19203":108275,"_5":13195,"_26191":108177,"_2648":108276},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3150":64583,"_27690":64539,"_19203":108278,"_5":13195,"_26191":108177,"_2648":108279},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3150":64584,"_27690":64539,"_19203":108281,"_5":13195,"_26191":108177,"_2648":108282},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3150":64585,"_27690":64539,"_19203":108284,"_5":13195,"_26191":108177,"_2648":108285},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3150":64586,"_27690":64539,"_19203":108287,"_5":13195,"_26191":108177,"_2648":108288},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3150":64587,"_27690":64539,"_19203":108290,"_5":13195,"_26191":108181,"_2648":108291},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3150":64588,"_27690":64539,"_19203":108293,"_5":13195,"_26191":108181,"_2648":108294},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3150":64589,"_27690":64539,"_19203":108296,"_5":13195,"_26191":108185,"_2648":108297},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3150":64590,"_27690":64539,"_19203":108299,"_5":13195,"_26191":108185,"_2648":108300},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3150":64591,"_27690":64539,"_19203":108302,"_5":13195,"_26191":108185,"_2648":108303},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3150":64592,"_27690":64539,"_19203":108305,"_5":13195,"_26191":108185,"_2648":108306},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3150":64593,"_27690":64539,"_19203":108308,"_5":13195,"_26191":108189,"_2648":108309},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3150":64594,"_27690":64539,"_19203":108311,"_5":13195,"_26191":108189,"_2648":108312},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3150":64595,"_27690":64595,"_5":13521,"_2648":108314,"_28032":108315,"_19203":108317,"_26191":64595},"Identidad inicial y autenticación",[45000,107166,47357,108141,108316],"Enrolamiento con PKI",[],{"_3150":64596,"_27690":64595,"_19203":108319,"_5":13195,"_26191":64595,"_2648":108320},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3150":64597,"_27690":64595,"_5":28029,"_19203":108322,"_26191":108323,"_2648":108324},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3150":64598,"_27690":64595,"_5":28029,"_19203":108326,"_26191":108327,"_2648":108328},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3150":64599,"_27690":64595,"_5":28029,"_19203":108330,"_26191":108331,"_2648":108332},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3150":64600,"_27690":64595,"_5":28029,"_19203":108334,"_26191":108335,"_2648":108336},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3150":64601,"_27690":64595,"_5":28029,"_19203":108338,"_26191":108339,"_2648":108340},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3150":64602,"_27690":64595,"_19203":108342,"_5":13195,"_26191":64595,"_2648":108343},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3150":64603,"_27690":64595,"_19203":108345,"_5":13195,"_26191":108323,"_2648":108346},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3150":64604,"_27690":64595,"_19203":108348,"_5":13195,"_26191":108323,"_2648":108349},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3150":64605,"_27690":64595,"_19203":108351,"_5":13195,"_26191":108327,"_2648":108352},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3150":64606,"_27690":64595,"_19203":108354,"_5":13195,"_26191":108327,"_2648":108355},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3150":64607,"_27690":64595,"_19203":108357,"_5":13195,"_26191":108327,"_2648":108358},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3150":64608,"_27690":64595,"_19203":108360,"_5":13195,"_26191":108331,"_2648":108361},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3150":64609,"_27690":64595,"_19203":108363,"_5":13195,"_26191":108331,"_2648":108364},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3150":64610,"_27690":64595,"_19203":108366,"_5":13195,"_26191":108335,"_2648":108367},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3150":64611,"_27690":64595,"_19203":108369,"_5":13195,"_26191":108335,"_2648":108370},[],"Ejemplo de cuerpo:",{"_3150":64612,"_27690":64595,"_19203":108372,"_5":13195,"_26191":108335,"_2648":108373},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3150":64613,"_27690":64595,"_19203":108375,"_5":13195,"_26191":108335,"_2648":108376},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3150":64614,"_27690":64595,"_19203":108378,"_5":13195,"_26191":108335,"_2648":108379},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3150":64615,"_27690":64595,"_19203":108381,"_5":13195,"_26191":108335,"_2648":108382},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3150":64616,"_27690":64595,"_19203":108384,"_5":13195,"_26191":108339,"_2648":108385},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3150":64617,"_27690":64595,"_19203":108387,"_5":13195,"_26191":108339,"_2648":108388},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3150":64618,"_27690":64618,"_5":13521,"_2648":108390,"_28032":108391,"_19203":108392,"_26191":64618},"Configura y opera el DMS",[45000,107166,47357,108141,108316],[],{"_3150":64619,"_27690":64618,"_19203":108394,"_5":13195,"_26191":64618,"_2648":108395},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3150":64620,"_27690":64618,"_5":28029,"_19203":108397,"_26191":108398,"_2648":105832},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3150":64621,"_27690":64618,"_5":28029,"_19203":108400,"_26191":108401,"_2648":108402},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3150":64622,"_27690":64618,"_5":28029,"_19203":108404,"_26191":108405,"_2648":108406},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3150":64623,"_27690":64618,"_5":28029,"_19203":108408,"_26191":108409,"_2648":108410},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3150":64624,"_27690":64618,"_5":28029,"_19203":108412,"_26191":108413,"_2648":108414},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3150":64625,"_27690":64618,"_5":28029,"_19203":108416,"_26191":108417,"_2648":108418},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3150":64626,"_27690":64618,"_5":28029,"_19203":108420,"_26191":108421,"_2648":108422},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3150":64627,"_27690":64618,"_5":28029,"_19203":108424,"_26191":108425,"_2648":108426},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3150":64628,"_27690":64618,"_5":28029,"_19203":108428,"_26191":108429,"_2648":47652},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3150":64629,"_27690":64618,"_5":28029,"_19203":108431,"_26191":108432,"_2648":47656},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3150":64630,"_27690":64618,"_5":28029,"_19203":108434,"_26191":108435,"_2648":108436},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3150":64631,"_27690":64618,"_5":28029,"_19203":108438,"_26191":108439,"_2648":108440},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3150":64632,"_27690":64618,"_5":28029,"_19203":108442,"_26191":108443,"_2648":108444},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3150":64633,"_27690":64618,"_5":28029,"_19203":108446,"_26191":108447,"_2648":108448},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3150":64634,"_27690":64618,"_5":28029,"_19203":108450,"_26191":108451,"_2648":47676},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3150":64635,"_27690":64618,"_5":28029,"_19203":108453,"_26191":108454,"_2648":108455},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3150":64636,"_27690":64618,"_5":28029,"_19203":108457,"_26191":108458,"_2648":108459},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3150":64637,"_27690":64618,"_5":28029,"_19203":108461,"_26191":108462,"_2648":108463},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3150":64638,"_27690":64618,"_19203":108465,"_5":13195,"_26191":64618,"_2648":108466},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3150":64639,"_27690":64618,"_19203":108468,"_5":13195,"_26191":108398,"_2648":108469},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3150":64640,"_27690":64618,"_19203":108471,"_5":13195,"_26191":108398,"_2648":108472},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3150":64641,"_27690":64618,"_19203":108474,"_5":13195,"_26191":108405,"_2648":108475},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3150":64642,"_27690":64618,"_19203":108477,"_5":13195,"_26191":108409,"_2648":108478},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3150":64643,"_27690":64618,"_19203":108480,"_5":13195,"_26191":108413,"_2648":108481},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3150":64644,"_27690":64618,"_19203":108483,"_5":13195,"_26191":108417,"_2648":108484},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3150":64645,"_27690":64618,"_19203":108486,"_5":13195,"_26191":108421,"_2648":108487},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3150":64646,"_27690":64618,"_19203":108489,"_5":13195,"_26191":108429,"_2648":108490},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3150":64647,"_27690":64618,"_19203":108492,"_5":13195,"_26191":108429,"_2648":108493},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3150":64648,"_27690":64618,"_19203":108495,"_5":13195,"_26191":108432,"_2648":108496},[],"Campo de `settings.enrollment_settings`",{"_3150":64649,"_27690":64618,"_19203":108498,"_5":13195,"_26191":108432,"_2648":108499},[],"Decisión",{"_3150":64650,"_27690":64618,"_19203":108501,"_5":13195,"_26191":108432,"_2648":47727},[],{"_3150":64651,"_27690":64618,"_19203":108503,"_5":13195,"_26191":108432,"_2648":108504},[],"`EST_RFC7030` para estas operaciones.",{"_3150":64652,"_27690":64618,"_19203":108506,"_5":13195,"_26191":108432,"_2648":47733},[],{"_3150":64653,"_27690":64618,"_19203":108508,"_5":13195,"_26191":108432,"_2648":108509},[],"ID de la CA que firmará.",{"_3150":64654,"_27690":64618,"_19203":108511,"_5":13195,"_26191":108432,"_2648":47739},[],{"_3150":64655,"_27690":64618,"_19203":108513,"_5":13195,"_26191":108432,"_2648":108514},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3150":64656,"_27690":64618,"_19203":108516,"_5":13195,"_26191":108432,"_2648":47745},[],{"_3150":64657,"_27690":64618,"_19203":108518,"_5":13195,"_26191":108432,"_2648":108519},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3150":64658,"_27690":64618,"_19203":108521,"_5":13195,"_26191":108432,"_2648":47751},[],{"_3150":64659,"_27690":64618,"_19203":108523,"_5":13195,"_26191":108432,"_2648":108524},[],"Uno de los cuatro modos de autenticación.",{"_3150":64660,"_27690":64618,"_19203":108526,"_5":13195,"_26191":108432,"_2648":108527},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3150":64661,"_27690":64618,"_19203":108529,"_5":13195,"_26191":108435,"_2648":108530},[],"Los bloques son independientes:",{"_3150":64662,"_27690":64618,"_19203":108532,"_5":13195,"_26191":108435,"_2648":108533},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3150":64663,"_27690":64618,"_19203":108535,"_5":13195,"_26191":108435,"_2648":108536},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3150":64664,"_27690":64618,"_19203":108538,"_5":13195,"_26191":108435,"_2648":47769},[],{"_3150":64665,"_27690":64618,"_19203":108540,"_5":13195,"_26191":108435,"_2648":108541},[],"Control aplicado en la operación configurada",{"_3150":64666,"_27690":64618,"_19203":108543,"_5":13195,"_26191":108435,"_2648":47775},[],{"_3150":64667,"_27690":64618,"_19203":108545,"_5":13195,"_26191":108435,"_2648":108546},[],"Validación del certificado presentado.",{"_3150":64668,"_27690":64618,"_19203":108548,"_5":13195,"_26191":108435,"_2648":47781},[],{"_3150":64669,"_27690":64618,"_19203":108550,"_5":13195,"_26191":108435,"_2648":108551},[],"Autorización del webhook configurado.",{"_3150":64670,"_27690":64618,"_19203":108553,"_5":13195,"_26191":108435,"_2648":47787},[],{"_3150":64671,"_27690":64618,"_19203":108555,"_5":13195,"_26191":108435,"_2648":108556},[],"Validación del certificado y, después, aprobación del webhook.",{"_3150":64672,"_27690":64618,"_19203":108558,"_5":13195,"_26191":108435,"_2648":47793},[],{"_3150":64673,"_27690":64618,"_19203":108560,"_5":13195,"_26191":108435,"_2648":108561},[],"Sin autenticación del solicitante por el DMS.",{"_3150":64674,"_27690":64618,"_19203":108563,"_5":13195,"_26191":108435,"_2648":108564},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3150":64675,"_27690":64618,"_19203":108566,"_5":13195,"_26191":108435,"_2648":108567},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3150":64676,"_27690":64618,"_19203":108569,"_5":13195,"_26191":108435,"_2648":108570},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3150":64677,"_27690":64618,"_19203":108572,"_5":13195,"_26191":108435,"_2648":108573},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3150":64678,"_27690":64618,"_19203":108575,"_5":13195,"_26191":108439,"_2648":108576},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3150":64679,"_27690":64618,"_19203":108578,"_5":13195,"_26191":108439,"_2648":108579},[],"Campo de `external_webhook_settings`",{"_3150":64680,"_27690":64618,"_19203":108581,"_5":13195,"_26191":108439,"_2648":108499},[],{"_3150":64681,"_27690":64618,"_19203":108583,"_5":13195,"_26191":108439,"_2648":47819},[],{"_3150":64682,"_27690":64618,"_19203":108585,"_5":13195,"_26191":108439,"_2648":108586},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3150":64683,"_27690":64618,"_19203":108588,"_5":13195,"_26191":108439,"_2648":47825},[],{"_3150":64684,"_27690":64618,"_19203":108590,"_5":13195,"_26191":108439,"_2648":108591},[],"`POST` o `PUT`; `POST` por defecto.",{"_3150":64685,"_27690":64618,"_19203":108593,"_5":13195,"_26191":108439,"_2648":47831},[],{"_3150":64686,"_27690":64618,"_19203":108595,"_5":13195,"_26191":108439,"_2648":108596},[],"Etiqueta usada en los logs del servicio.",{"_3150":64687,"_27690":64618,"_19203":108598,"_5":13195,"_26191":108439,"_2648":47837},[],{"_3150":64688,"_27690":64618,"_19203":108600,"_5":13195,"_26191":108439,"_2648":108601},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3150":64689,"_27690":64618,"_19203":108603,"_5":13195,"_26191":108439,"_2648":47843},[],{"_3150":64690,"_27690":64618,"_19203":108605,"_5":13195,"_26191":108439,"_2648":108606},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3150":64691,"_27690":64618,"_19203":108608,"_5":13195,"_26191":108439,"_2648":47849},[],{"_3150":64692,"_27690":64618,"_19203":108610,"_5":13195,"_26191":108439,"_2648":108611},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3150":64693,"_27690":64618,"_19203":108613,"_5":13195,"_26191":108439,"_2648":47855},[],{"_3150":64694,"_27690":64618,"_19203":108615,"_5":13195,"_26191":108439,"_2648":108616},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3150":64695,"_27690":64618,"_19203":108618,"_5":13195,"_26191":108439,"_2648":47861},[],{"_3150":64696,"_27690":64618,"_19203":108620,"_5":13195,"_26191":108439,"_2648":108621},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3150":64697,"_27690":64618,"_19203":108623,"_5":13195,"_26191":108439,"_2648":47867},[],{"_3150":64698,"_27690":64618,"_19203":108625,"_5":13195,"_26191":108439,"_2648":108626},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3150":64699,"_27690":64618,"_19203":108628,"_5":13195,"_26191":108439,"_2648":108629},[],"Reglas de esa configuración:",{"_3150":64700,"_27690":64618,"_19203":108631,"_5":13195,"_26191":108439,"_2648":108632},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3150":64701,"_27690":64618,"_19203":108634,"_5":13195,"_26191":108439,"_2648":108635},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3150":64702,"_27690":64618,"_19203":108637,"_5":13195,"_26191":108439,"_2648":108638},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3150":64703,"_27690":64618,"_19203":108640,"_5":13195,"_26191":108439,"_2648":108641},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3150":64704,"_27690":64618,"_19203":108643,"_5":13195,"_26191":108439,"_2648":108644},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3150":64705,"_27690":64618,"_19203":108646,"_5":13195,"_26191":108439,"_2648":108647},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3150":64706,"_27690":64618,"_19203":108649,"_5":13195,"_26191":108439,"_2648":108650},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_3150":64707,"_27690":64618,"_19203":108652,"_5":13195,"_26191":108439,"_2648":108653},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3150":64708,"_27690":64618,"_19203":108655,"_5":13195,"_26191":108439,"_2648":108656},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3150":64709,"_27690":64618,"_19203":108658,"_5":13195,"_26191":108443,"_2648":108659},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3150":64710,"_27690":64618,"_19203":108661,"_5":13195,"_26191":108447,"_2648":108662},[],"Campo de `settings.reenrollment_settings`",{"_3150":64711,"_27690":64618,"_19203":108664,"_5":13195,"_26191":108447,"_2648":108665},[],"Función",{"_3150":64712,"_27690":64618,"_19203":108667,"_5":13195,"_26191":108447,"_2648":47911},[],{"_3150":64713,"_27690":64618,"_19203":108669,"_5":13195,"_26191":108447,"_2648":108670},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3150":64714,"_27690":64618,"_19203":108672,"_5":13195,"_26191":108447,"_2648":47917},[],{"_3150":64715,"_27690":64618,"_19203":108674,"_5":13195,"_26191":108447,"_2648":108675},[],"Umbral operativo preventivo de monitorización.",{"_3150":64716,"_27690":64618,"_19203":108677,"_5":13195,"_26191":108447,"_2648":47923},[],{"_3150":64717,"_27690":64618,"_19203":108679,"_5":13195,"_26191":108447,"_2648":108680},[],"Umbral operativo crítico de monitorización.",{"_3150":64718,"_27690":64618,"_19203":108682,"_5":13195,"_26191":108447,"_2648":47929},[],{"_3150":64719,"_27690":64618,"_19203":108684,"_5":13195,"_26191":108447,"_2648":108685},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3150":64720,"_27690":64618,"_19203":108687,"_5":13195,"_26191":108447,"_2648":47935},[],{"_3150":64721,"_27690":64618,"_19203":108689,"_5":13195,"_26191":108447,"_2648":108690},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3150":64722,"_27690":64618,"_19203":108692,"_5":13195,"_26191":108447,"_2648":47941},[],{"_3150":64723,"_27690":64618,"_19203":108694,"_5":13195,"_26191":108447,"_2648":108695},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3150":64724,"_27690":64618,"_19203":108697,"_5":13195,"_26191":108447,"_2648":108698},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3150":64725,"_27690":64618,"_19203":108700,"_5":13195,"_26191":108451,"_2648":108701},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3150":64726,"_27690":64618,"_19203":108703,"_5":13195,"_26191":108454,"_2648":106196},[],{"_3150":64727,"_27690":64618,"_19203":108705,"_5":13195,"_26191":108454,"_2648":108706},[],"Qué publica",{"_3150":64728,"_27690":64618,"_19203":108708,"_5":13195,"_26191":108454,"_2648":47958},[],{"_3150":64729,"_27690":64618,"_19203":108710,"_5":13195,"_26191":108454,"_2648":108711},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3150":64730,"_27690":64618,"_19203":108713,"_5":13195,"_26191":108454,"_2648":47964},[],{"_3150":64731,"_27690":64618,"_19203":108715,"_5":13195,"_26191":108454,"_2648":108716},[],"Certificado de la CA emisora seleccionada.",{"_3150":64732,"_27690":64618,"_19203":108718,"_5":13195,"_26191":108454,"_2648":47970},[],{"_3150":64733,"_27690":64618,"_19203":108720,"_5":13195,"_26191":108454,"_2648":108721},[],"Certificados de las CAs elegidas explícitamente.",{"_3150":64734,"_27690":64618,"_19203":108723,"_5":13195,"_26191":108454,"_2648":108724},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3150":64735,"_27690":64618,"_19203":108726,"_5":13195,"_26191":108458,"_2648":108727},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_3150":64736,"_27690":64618,"_19203":108729,"_5":13195,"_26191":108458,"_2648":108730},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3150":64737,"_27690":64618,"_19203":108732,"_5":13195,"_26191":108458,"_2648":108733},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3150":64738,"_27690":64618,"_19203":108735,"_5":13195,"_26191":108462,"_2648":108736},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3150":64739,"_27690":64739,"_5":13521,"_2648":108738,"_28032":108739,"_19203":108740,"_26191":64739},"Integra el cliente EST",[45000,107166,47357,108141,108316],[],{"_3150":64740,"_27690":64739,"_19203":108742,"_5":13195,"_26191":64739,"_2648":108743},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3150":64741,"_27690":64739,"_5":28029,"_19203":108745,"_26191":108746,"_2648":105832},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3150":64742,"_27690":64739,"_5":28029,"_19203":108748,"_26191":108749,"_2648":108750},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3150":64743,"_27690":64739,"_5":28029,"_19203":108752,"_26191":108753,"_2648":108754},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3150":64744,"_27690":64739,"_5":28029,"_19203":108756,"_26191":108757,"_2648":108758},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3150":64745,"_27690":64739,"_5":28029,"_19203":108760,"_26191":108761,"_2648":108762},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3150":64746,"_27690":64739,"_5":28029,"_19203":108764,"_26191":108765,"_2648":108766},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3150":64747,"_27690":64739,"_19203":108768,"_5":13195,"_26191":64739,"_2648":108769},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3150":64748,"_27690":64739,"_19203":108771,"_5":13195,"_26191":108746,"_2648":108772},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3150":64749,"_27690":64739,"_19203":108774,"_5":13195,"_26191":108746,"_2648":108775},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3150":64750,"_27690":64739,"_19203":108777,"_5":13195,"_26191":108746,"_2648":108778},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3150":64751,"_27690":64739,"_19203":108780,"_5":13195,"_26191":108749,"_2648":108781},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3150":64752,"_27690":64739,"_19203":108783,"_5":13195,"_26191":108749,"_2648":108784},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3150":64753,"_27690":64739,"_19203":108786,"_5":13195,"_26191":108753,"_2648":108787},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3150":64754,"_27690":64739,"_19203":108789,"_5":13195,"_26191":108753,"_2648":108790},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3150":64755,"_27690":64739,"_19203":108792,"_5":13195,"_26191":108757,"_2648":108793},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3150":64756,"_27690":64739,"_19203":108795,"_5":13195,"_26191":108757,"_2648":108796},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3150":64757,"_27690":64739,"_19203":108798,"_5":13195,"_26191":108761,"_2648":108799},[],"Para el caso de una raíz que emite directamente:",{"_3150":64758,"_27690":64739,"_19203":108801,"_5":13195,"_26191":108761,"_2648":108802},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3150":64759,"_27690":64739,"_19203":108804,"_5":13195,"_26191":108761,"_2648":108805},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3150":64760,"_27690":64739,"_19203":108807,"_5":13195,"_26191":108765,"_2648":108808},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3150":64761,"_27690":64761,"_5":13521,"_2648":108810,"_28032":108811,"_19203":108812,"_26191":64761},"Referencia EST",[45000,107166,47357,108141,108316],[],{"_3150":64762,"_27690":64761,"_19203":108814,"_5":13195,"_26191":64761,"_2648":108815},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3150":64763,"_27690":64761,"_5":28029,"_19203":108817,"_26191":108818,"_2648":108819},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3150":64764,"_27690":64761,"_5":28029,"_19203":108821,"_26191":108822,"_2648":20869},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3150":64765,"_27690":64761,"_5":28029,"_19203":108824,"_26191":108825,"_2648":23934},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3150":64766,"_27690":64761,"_5":28029,"_19203":108827,"_26191":108828,"_2648":23941},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3150":64767,"_27690":64761,"_5":28029,"_19203":108830,"_26191":108831,"_2648":23286},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3150":64768,"_27690":64761,"_5":28029,"_19203":108833,"_26191":108834,"_2648":108835},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3150":64769,"_27690":64761,"_5":28029,"_19203":108837,"_26191":108838,"_2648":108839},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3150":64770,"_27690":64761,"_5":28029,"_19203":108841,"_26191":108842,"_2648":108843},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3150":64771,"_27690":64761,"_19203":108845,"_5":13195,"_26191":64761,"_2648":108846},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3150":64772,"_27690":64761,"_19203":108848,"_5":13195,"_26191":108818,"_2648":108849},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3150":64773,"_27690":64761,"_19203":108851,"_5":13195,"_26191":108818,"_2648":106957},[],{"_3150":64774,"_27690":64761,"_19203":108853,"_5":13195,"_26191":108818,"_2648":108854},[],"Método",{"_3150":64775,"_27690":64761,"_19203":108856,"_5":13195,"_26191":108818,"_2648":108857},[],"Autenticación y condición",{"_3150":64776,"_27690":64761,"_19203":108859,"_5":13195,"_26191":108818,"_2648":48113},[],{"_3150":64777,"_27690":64761,"_19203":108861,"_5":13195,"_26191":108818,"_2648":48116},[],{"_3150":64778,"_27690":64761,"_19203":108863,"_5":13195,"_26191":108818,"_2648":108864},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3150":64779,"_27690":64761,"_19203":108866,"_5":13195,"_26191":108818,"_2648":48122},[],{"_3150":64780,"_27690":64761,"_19203":108868,"_5":13195,"_26191":108818,"_2648":48125},[],{"_3150":64781,"_27690":64761,"_19203":108870,"_5":13195,"_26191":108818,"_2648":108871},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3150":64782,"_27690":64761,"_19203":108873,"_5":13195,"_26191":108818,"_2648":48131},[],{"_3150":64783,"_27690":64761,"_19203":108875,"_5":13195,"_26191":108818,"_2648":48125},[],{"_3150":64784,"_27690":64761,"_19203":108877,"_5":13195,"_26191":108818,"_2648":108878},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3150":64785,"_27690":64761,"_19203":108880,"_5":13195,"_26191":108818,"_2648":48139},[],{"_3150":64786,"_27690":64761,"_19203":108882,"_5":13195,"_26191":108818,"_2648":48125},[],{"_3150":64787,"_27690":64761,"_19203":108884,"_5":13195,"_26191":108818,"_2648":108885},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3150":64788,"_27690":64761,"_19203":108887,"_5":13195,"_26191":108818,"_2648":108888},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3150":64789,"_27690":64761,"_19203":108890,"_5":13195,"_26191":108822,"_2648":108891},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3150":64790,"_27690":64761,"_19203":108893,"_5":13195,"_26191":108822,"_2648":108894},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3150":64791,"_27690":64761,"_19203":108896,"_5":13195,"_26191":108825,"_2648":108897},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3150":64792,"_27690":64761,"_19203":108899,"_5":13195,"_26191":108825,"_2648":108900},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3150":64793,"_27690":64761,"_19203":108902,"_5":13195,"_26191":108828,"_2648":108903},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3150":64794,"_27690":64761,"_19203":108905,"_5":13195,"_26191":108828,"_2648":108906},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3150":64795,"_27690":64761,"_19203":108908,"_5":13195,"_26191":108831,"_2648":108909},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3150":64796,"_27690":64761,"_19203":108911,"_5":13195,"_26191":108831,"_2648":108912},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3150":64797,"_27690":64761,"_19203":108914,"_5":13195,"_26191":108834,"_2648":108915},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3150":64798,"_27690":64761,"_19203":108917,"_5":13195,"_26191":108834,"_2648":108918},[],"Parte",{"_3150":64799,"_27690":64761,"_19203":108920,"_5":13195,"_26191":108834,"_2648":108921},[],"Contenido tras decodificar su Base64",{"_3150":64800,"_27690":64761,"_19203":108923,"_5":13195,"_26191":108834,"_2648":48183},[],{"_3150":64801,"_27690":64761,"_19203":108925,"_5":13195,"_26191":108834,"_2648":108926},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3150":64802,"_27690":64761,"_19203":108928,"_5":13195,"_26191":108834,"_2648":48189},[],{"_3150":64803,"_27690":64761,"_19203":108930,"_5":13195,"_26191":108834,"_2648":108931},[],"PKCS#7 DER con el certificado emitido.",{"_3150":64804,"_27690":64761,"_19203":108933,"_5":13195,"_26191":108834,"_2648":108934},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3150":64805,"_27690":64761,"_19203":108936,"_5":13195,"_26191":108838,"_2648":108937},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3150":64806,"_27690":64761,"_19203":108939,"_5":13195,"_26191":108838,"_2648":108940},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3150":64807,"_27690":64761,"_19203":108942,"_5":13195,"_26191":108838,"_2648":108943},[],"Convierte y comprueba el resultado:",{"_3150":64808,"_27690":64761,"_19203":108945,"_5":13195,"_26191":108838,"_2648":108946},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3150":64809,"_27690":64761,"_19203":108948,"_5":13195,"_26191":108842,"_2648":108949},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3150":64810,"_27690":64761,"_19203":108951,"_5":13195,"_26191":108842,"_2648":108952},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3150":64811,"_27690":64811,"_5":13521,"_2648":108316,"_28032":108954,"_19203":108955,"_26191":64811},[45000,107166,47357,108141,108316],[],{"_3150":64812,"_27690":64811,"_19203":108957,"_5":13195,"_26191":64811,"_2648":108958},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3150":64813,"_27690":64811,"_5":28029,"_19203":108960,"_26191":108961,"_2648":108962},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3150":64814,"_27690":64811,"_5":28029,"_19203":108964,"_26191":108965,"_2648":108966},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3150":64815,"_27690":64811,"_5":28029,"_19203":108968,"_26191":108969,"_2648":108970},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3150":64816,"_27690":64811,"_5":28029,"_19203":108972,"_26191":108973,"_2648":108974},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3150":64817,"_27690":64811,"_19203":108976,"_5":13195,"_26191":64811,"_2648":108977},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3150":64818,"_27690":64811,"_19203":108979,"_5":13195,"_26191":108961,"_2648":108980},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3150":64819,"_27690":64811,"_19203":108982,"_5":13195,"_26191":108961,"_2648":108983},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3150":64820,"_27690":64811,"_19203":108985,"_5":13195,"_26191":108961,"_2648":108986},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3150":64821,"_27690":64811,"_19203":108988,"_5":13195,"_26191":108961,"_2648":108989},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3150":64822,"_27690":64811,"_19203":108991,"_5":13195,"_26191":108961,"_2648":108992},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3150":64823,"_27690":64811,"_19203":108994,"_5":13195,"_26191":108961,"_2648":108995},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3150":64824,"_27690":64811,"_19203":108997,"_5":13195,"_26191":108965,"_2648":108998},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3150":64825,"_27690":64811,"_19203":109000,"_5":13195,"_26191":108965,"_2648":109001},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":64826,"_27690":64811,"_19203":109003,"_5":13195,"_26191":108965,"_2648":109004},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3150":64827,"_27690":64811,"_19203":109006,"_5":13195,"_26191":108965,"_2648":109007},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3150":64828,"_27690":64811,"_19203":109009,"_5":13195,"_26191":108969,"_2648":109010},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3150":64829,"_27690":64811,"_19203":109012,"_5":13195,"_26191":108969,"_2648":109013},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3150":64830,"_27690":64811,"_19203":109015,"_5":13195,"_26191":108969,"_2648":109016},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3150":64831,"_27690":64811,"_19203":109018,"_5":13195,"_26191":108969,"_2648":109019},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3150":64832,"_27690":64811,"_19203":109021,"_5":13195,"_26191":108973,"_2648":109022},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3150":64833,"_27690":64811,"_19203":109024,"_5":13195,"_26191":108973,"_2648":109025},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3150":64834,"_27690":64834,"_5":13521,"_2648":109027,"_28032":109028,"_19203":109029,"_26191":64834},"Estrategias de aprovisionamiento",[45000,107166,47357,108141,108316],[],{"_3150":64835,"_27690":64834,"_19203":109031,"_5":13195,"_26191":64834,"_2648":109032},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3150":64836,"_27690":64834,"_5":28029,"_19203":109034,"_26191":109035,"_2648":109036},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3150":64837,"_27690":64834,"_5":28029,"_19203":109038,"_26191":109039,"_2648":109040},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3150":64838,"_27690":64834,"_5":28029,"_19203":109042,"_26191":109043,"_2648":109044},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3150":64839,"_27690":64834,"_5":28029,"_19203":109046,"_26191":109047,"_2648":109048},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3150":64840,"_27690":64834,"_5":28029,"_19203":109050,"_26191":109051,"_2648":109052},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3150":64841,"_27690":64834,"_19203":109054,"_5":13195,"_26191":64834,"_2648":109055},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3150":64842,"_27690":64834,"_19203":109057,"_5":13195,"_26191":109035,"_2648":109058},[],"Recorrido",{"_3150":64843,"_27690":64834,"_19203":109060,"_5":13195,"_26191":109035,"_2648":109061},[],"Cuándo existe el dispositivo",{"_3150":64844,"_27690":64834,"_19203":109063,"_5":13195,"_26191":109035,"_2648":109064},[],"Qué compruebas",{"_3150":64845,"_27690":64834,"_19203":109066,"_5":13195,"_26191":109035,"_2648":109067},[],"Asignación manual",{"_3150":64846,"_27690":64834,"_19203":109069,"_5":13195,"_26191":109035,"_2648":109070},[],"El operador lo crea antes de asociar un certificado.",{"_3150":64847,"_27690":64834,"_19203":109072,"_5":13195,"_26191":109035,"_2648":109073},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3150":64848,"_27690":64834,"_19203":109075,"_5":13195,"_26191":109035,"_2648":109076},[],"EST con `JITP`",{"_3150":64849,"_27690":64834,"_19203":109078,"_5":13195,"_26191":109035,"_2648":109079},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3150":64850,"_27690":64834,"_19203":109081,"_5":13195,"_26191":109035,"_2648":109082},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3150":64851,"_27690":64834,"_19203":109084,"_5":13195,"_26191":109035,"_2648":109085},[],"EST con `PRE_REGISTRATION`",{"_3150":64852,"_27690":64834,"_19203":109087,"_5":13195,"_26191":109035,"_2648":109088},[],"Debe existir antes de `/simpleenroll`.",{"_3150":64853,"_27690":64834,"_19203":109090,"_5":13195,"_26191":109035,"_2648":109091},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3150":64854,"_27690":64834,"_19203":109093,"_5":13195,"_26191":109035,"_2648":109094},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3150":64855,"_27690":64834,"_19203":109096,"_5":13195,"_26191":109035,"_2648":109097},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3150":64856,"_27690":64834,"_19203":109099,"_5":13195,"_26191":109039,"_2648":109100},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3150":64857,"_27690":64834,"_19203":109102,"_5":13195,"_26191":109039,"_2648":109103},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3150":64858,"_27690":64834,"_19203":109105,"_5":13195,"_26191":109039,"_2648":109106},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3150":64859,"_27690":64834,"_19203":109108,"_5":13195,"_26191":109043,"_2648":109109},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3150":64860,"_27690":64834,"_19203":109111,"_5":13195,"_26191":109043,"_2648":109112},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3150":64861,"_27690":64834,"_19203":109114,"_5":13195,"_26191":109043,"_2648":109115},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3150":64862,"_27690":64834,"_19203":109117,"_5":13195,"_26191":109043,"_2648":109118},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3150":64863,"_27690":64834,"_19203":109120,"_5":13195,"_26191":109043,"_2648":109121},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3150":64864,"_27690":64834,"_19203":109123,"_5":13195,"_26191":109043,"_2648":109124},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3150":64865,"_27690":64834,"_19203":109126,"_5":13195,"_26191":109047,"_2648":106196},[],{"_3150":64866,"_27690":64834,"_19203":109128,"_5":13195,"_26191":109047,"_2648":109129},[],"Material que atraviesa EST",{"_3150":64867,"_27690":64834,"_19203":109131,"_5":13195,"_26191":109047,"_2648":109132},[],"Clave generada por el dispositivo",{"_3150":64868,"_27690":64834,"_19203":109134,"_5":13195,"_26191":109047,"_2648":109135},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3150":64869,"_27690":64834,"_19203":109137,"_5":13195,"_26191":109047,"_2648":109138},[],"Clave ya disponible en el dispositivo",{"_3150":64870,"_27690":64834,"_19203":109140,"_5":13195,"_26191":109047,"_2648":109141},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3150":64871,"_27690":64834,"_19203":109143,"_5":13195,"_26191":109047,"_2648":47676},[],{"_3150":64872,"_27690":64834,"_19203":109145,"_5":13195,"_26191":109047,"_2648":109146},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3150":64873,"_27690":64834,"_19203":109148,"_5":13195,"_26191":109047,"_2648":109149},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3150":64874,"_27690":64834,"_19203":109151,"_5":13195,"_26191":109051,"_2648":109152},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3150":64875,"_27690":64875,"_5":13521,"_2648":109154,"_28032":109155,"_19203":109156,"_26191":64875},"Renovación y recuperación",[45000,107166,47357,108141,108316],[],{"_3150":64876,"_27690":64875,"_19203":109158,"_5":13195,"_26191":64875,"_2648":109159},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3150":64877,"_27690":64875,"_5":28029,"_19203":109161,"_26191":109162,"_2648":109163},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3150":64878,"_27690":64875,"_5":28029,"_19203":109165,"_26191":109166,"_2648":109167},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3150":64879,"_27690":64875,"_5":28029,"_19203":109169,"_26191":109170,"_2648":109171},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3150":64880,"_27690":64875,"_5":28029,"_19203":109173,"_26191":109174,"_2648":109175},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3150":64881,"_27690":64875,"_5":28029,"_19203":109177,"_26191":109178,"_2648":109179},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3150":64882,"_27690":64875,"_19203":109181,"_5":13195,"_26191":64875,"_2648":109182},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3150":64883,"_27690":64875,"_19203":109184,"_5":13195,"_26191":109162,"_2648":109185},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3150":64884,"_27690":64875,"_19203":109187,"_5":13195,"_26191":109162,"_2648":109188},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3150":64885,"_27690":64875,"_19203":109190,"_5":13195,"_26191":109162,"_2648":109191},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3150":64886,"_27690":64875,"_19203":109193,"_5":13195,"_26191":109162,"_2648":109194},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3150":64887,"_27690":64875,"_19203":109196,"_5":13195,"_26191":109166,"_2648":109197},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3150":64888,"_27690":64875,"_19203":109199,"_5":13195,"_26191":109166,"_2648":109200},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3150":64889,"_27690":64875,"_19203":109202,"_5":13195,"_26191":109170,"_2648":109203},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3150":64890,"_27690":64875,"_19203":109205,"_5":13195,"_26191":109170,"_2648":109206},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3150":64891,"_27690":64875,"_19203":109208,"_5":13195,"_26191":109170,"_2648":109209},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3150":64892,"_27690":64875,"_19203":109211,"_5":13195,"_26191":109174,"_2648":109212},[],"Situación",{"_3150":64893,"_27690":64875,"_19203":109214,"_5":13195,"_26191":109174,"_2648":109215},[],"Procedimiento",{"_3150":64894,"_27690":64875,"_19203":109217,"_5":13195,"_26191":109174,"_2648":109218},[],"Certificado vigente, fuera de ventana",{"_3150":64895,"_27690":64875,"_19203":109220,"_5":13195,"_26191":109174,"_2648":109221},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3150":64896,"_27690":64875,"_19203":109223,"_5":13195,"_26191":109174,"_2648":109224},[],"Certificado vencido, clave disponible",{"_3150":64897,"_27690":64875,"_19203":109226,"_5":13195,"_26191":109174,"_2648":109227},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3150":64898,"_27690":64875,"_19203":109229,"_5":13195,"_26191":109174,"_2648":109230},[],"Renovación por webhook o `NO_AUTH`",{"_3150":64899,"_27690":64875,"_19203":109232,"_5":13195,"_26191":109174,"_2648":109233},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3150":64900,"_27690":64875,"_19203":109235,"_5":13195,"_26191":109174,"_2648":109236},[],"Clave perdida o inaccesible",{"_3150":64901,"_27690":64875,"_19203":109238,"_5":13195,"_26191":109174,"_2648":109239},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3150":64902,"_27690":64875,"_19203":109241,"_5":13195,"_26191":109174,"_2648":109242},[],"Identidad actual revocada",{"_3150":64903,"_27690":64875,"_19203":109244,"_5":13195,"_26191":109174,"_2648":109245},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3150":64904,"_27690":64875,"_19203":109247,"_5":13195,"_26191":109174,"_2648":109248},[],"Dispositivo sin identidad",{"_3150":64905,"_27690":64875,"_19203":109250,"_5":13195,"_26191":109174,"_2648":109251},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3150":64906,"_27690":64875,"_19203":109253,"_5":13195,"_26191":109174,"_2648":109254},[],"Dispositivo retirado",{"_3150":64907,"_27690":64875,"_19203":109256,"_5":13195,"_26191":109174,"_2648":109257},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3150":64908,"_27690":64875,"_19203":109259,"_5":13195,"_26191":109174,"_2648":109260},[],"Timeout, HTTP 500 o fallo de instalación",{"_3150":64909,"_27690":64875,"_19203":109262,"_5":13195,"_26191":109174,"_2648":109263},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3150":64910,"_27690":64875,"_19203":109265,"_5":13195,"_26191":109178,"_2648":109266},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3150":64911,"_27690":64875,"_19203":109268,"_5":13195,"_26191":109178,"_2648":109269},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3150":64912,"_27690":64912,"_5":13521,"_2648":109271,"_28032":109272,"_19203":109273,"_26191":64912},"Diagnóstico de enrolamiento",[45000,107166,47357,108141,108316],[],{"_3150":64913,"_27690":64912,"_19203":109275,"_5":13195,"_26191":64912,"_2648":109276},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3150":64914,"_27690":64912,"_5":28029,"_19203":109278,"_26191":109279,"_2648":109280},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3150":64915,"_27690":64912,"_5":28029,"_19203":109282,"_26191":109283,"_2648":109284},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3150":64916,"_27690":64912,"_5":28029,"_19203":109286,"_26191":109287,"_2648":108843},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3150":64917,"_27690":64912,"_5":28029,"_19203":109289,"_26191":109290,"_2648":109291},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3150":64918,"_27690":64912,"_19203":109293,"_5":13195,"_26191":64912,"_2648":109294},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3150":64919,"_27690":64912,"_19203":109296,"_5":13195,"_26191":109283,"_2648":109297},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3150":64920,"_27690":64912,"_19203":109299,"_5":13195,"_26191":109283,"_2648":109300},[],"Síntoma o mensaje",{"_3150":64921,"_27690":64912,"_19203":109302,"_5":13195,"_26191":109283,"_2648":109303},[],"Qué revisar",{"_3150":64922,"_27690":64912,"_19203":109305,"_5":13195,"_26191":109283,"_2648":109306},[],"curl rechaza TLS, nombre o emisor",{"_3150":64923,"_27690":64912,"_19203":109308,"_5":13195,"_26191":109283,"_2648":109309},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3150":64924,"_27690":64912,"_19203":109311,"_5":13195,"_26191":109283,"_2648":109312},[],"404 o APS ausente",{"_3150":64925,"_27690":64912,"_19203":109314,"_5":13195,"_26191":109283,"_2648":109315},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3150":64926,"_27690":64912,"_19203":109317,"_5":13195,"_26191":109283,"_2648":109318},[],"400, error de CSR o formato",{"_3150":64927,"_27690":64912,"_19203":109320,"_5":13195,"_26191":109283,"_2648":109321},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3150":64928,"_27690":64912,"_19203":109323,"_5":13195,"_26191":109283,"_2648":109324},[],"Credencial ausente o certificado no válido",{"_3150":64929,"_27690":64912,"_19203":109326,"_5":13195,"_26191":109283,"_2648":109327},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3150":64930,"_27690":64912,"_19203":109329,"_5":13195,"_26191":109283,"_2648":109330},[],"Webhook deniega, expira o responde sin autorización",{"_3150":64931,"_27690":64912,"_19203":109332,"_5":13195,"_26191":109283,"_2648":109333},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3150":64932,"_27690":64912,"_19203":109335,"_5":13195,"_26191":109283,"_2648":48596},[],{"_3150":64933,"_27690":64912,"_19203":109337,"_5":13195,"_26191":109283,"_2648":109338},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3150":64934,"_27690":64912,"_19203":109340,"_5":13195,"_26191":109283,"_2648":48602},[],{"_3150":64935,"_27690":64912,"_19203":109342,"_5":13195,"_26191":109283,"_2648":109343},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3150":64936,"_27690":64912,"_19203":109345,"_5":13195,"_26191":109283,"_2648":48608},[],{"_3150":64937,"_27690":64912,"_19203":109347,"_5":13195,"_26191":109283,"_2648":109348},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3150":64938,"_27690":64912,"_19203":109350,"_5":13195,"_26191":109283,"_2648":48614},[],{"_3150":64939,"_27690":64912,"_19203":109352,"_5":13195,"_26191":109283,"_2648":109353},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3150":64940,"_27690":64912,"_19203":109355,"_5":13195,"_26191":109283,"_2648":48620},[],{"_3150":64941,"_27690":64912,"_19203":109357,"_5":13195,"_26191":109283,"_2648":109358},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3150":64942,"_27690":64912,"_19203":109360,"_5":13195,"_26191":109283,"_2648":109361},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3150":64943,"_27690":64912,"_19203":109363,"_5":13195,"_26191":109283,"_2648":109364},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3150":64944,"_27690":64912,"_19203":109366,"_5":13195,"_26191":109283,"_2648":109367},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3150":64945,"_27690":64912,"_19203":109369,"_5":13195,"_26191":109283,"_2648":109370},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3150":64946,"_27690":64912,"_19203":109372,"_5":13195,"_26191":109283,"_2648":48638},[],{"_3150":64947,"_27690":64912,"_19203":109374,"_5":13195,"_26191":109283,"_2648":109375},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3150":64948,"_27690":64912,"_19203":109377,"_5":13195,"_26191":109283,"_2648":48644},[],{"_3150":64949,"_27690":64912,"_19203":109379,"_5":13195,"_26191":109283,"_2648":109380},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3150":64950,"_27690":64912,"_19203":109382,"_5":13195,"_26191":109283,"_2648":109383},[],"DMS propietario distinto",{"_3150":64951,"_27690":64912,"_19203":109385,"_5":13195,"_26191":109283,"_2648":109386},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3150":64952,"_27690":64912,"_19203":109388,"_5":13195,"_26191":109283,"_2648":48656},[],{"_3150":64953,"_27690":64912,"_19203":109390,"_5":13195,"_26191":109283,"_2648":109391},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3150":64954,"_27690":64912,"_19203":109393,"_5":13195,"_26191":109283,"_2648":48662},[],{"_3150":64955,"_27690":64912,"_19203":109395,"_5":13195,"_26191":109283,"_2648":109396},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3150":64956,"_27690":64912,"_19203":109398,"_5":13195,"_26191":109283,"_2648":109399},[],"Certificado actual revocado",{"_3150":64957,"_27690":64912,"_19203":109401,"_5":13195,"_26191":109283,"_2648":109402},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3150":64958,"_27690":64912,"_19203":109404,"_5":13195,"_26191":109283,"_2648":109405},[],"Error de CA, perfil o firma",{"_3150":64959,"_27690":64912,"_19203":109407,"_5":13195,"_26191":109283,"_2648":109408},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3150":64960,"_27690":64912,"_19203":109410,"_5":13195,"_26191":109283,"_2648":109411},[],"HTTP 200 sin conexión del dispositivo",{"_3150":64961,"_27690":64912,"_19203":109413,"_5":13195,"_26191":109283,"_2648":109414},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3150":64962,"_27690":64912,"_19203":109416,"_5":13195,"_26191":109283,"_2648":109417},[],"Timeout o error después de emitir",{"_3150":64963,"_27690":64912,"_19203":109419,"_5":13195,"_26191":109283,"_2648":109420},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3150":64964,"_27690":64912,"_19203":109422,"_5":13195,"_26191":109287,"_2648":109423},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3150":64965,"_27690":64912,"_19203":109425,"_5":13195,"_26191":109287,"_2648":109426},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3150":64966,"_27690":64912,"_19203":109428,"_5":13195,"_26191":109290,"_2648":109429},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3150":64967,"_27690":64912,"_19203":109431,"_5":13195,"_26191":109290,"_2648":109432},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3150":64968,"_27690":64912,"_19203":109434,"_5":13195,"_26191":109290,"_2648":109435},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3150":64969,"_27690":64912,"_19203":109437,"_5":13195,"_26191":109290,"_2648":109438},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3150":64970,"_27690":64912,"_19203":109440,"_5":13195,"_26191":109290,"_2648":109441},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3150":64971,"_27690":64912,"_19203":109443,"_5":13195,"_26191":109290,"_2648":109444},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3150":64972,"_27690":64912,"_19203":109446,"_5":13195,"_26191":109290,"_2648":109447},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3150":64973,"_27690":64973,"_5":13521,"_2648":109449,"_28032":109450,"_19203":109451,"_26191":64973},"Distribución y actualización de confianza",[45000,107166,47357,108141,108316],[],{"_3150":64974,"_27690":64973,"_19203":109453,"_5":13195,"_26191":64973,"_2648":109454},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3150":64975,"_27690":64973,"_5":28029,"_19203":109456,"_26191":109457,"_2648":109458},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3150":64976,"_27690":64973,"_5":28029,"_19203":109460,"_26191":109461,"_2648":109462},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3150":64977,"_27690":64973,"_5":28029,"_19203":109464,"_26191":109465,"_2648":109466},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3150":64978,"_27690":64973,"_5":28029,"_19203":109468,"_26191":109469,"_2648":109470},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3150":64979,"_27690":64973,"_5":28029,"_19203":109472,"_26191":109473,"_2648":109474},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3150":64980,"_27690":64973,"_19203":109476,"_5":13195,"_26191":64973,"_2648":109477},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3150":64981,"_27690":64973,"_19203":109479,"_5":13195,"_26191":109457,"_2648":109480},[],"Relación",{"_3150":64982,"_27690":64973,"_19203":109482,"_5":13195,"_26191":109457,"_2648":109483},[],"Material que prepara el responsable",{"_3150":64983,"_27690":64973,"_19203":109485,"_5":13195,"_26191":109457,"_2648":109486},[],"Dispositivo → servidor EST",{"_3150":64984,"_27690":64973,"_19203":109488,"_5":13195,"_26191":109457,"_2648":109489},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3150":64985,"_27690":64973,"_19203":109491,"_5":13195,"_26191":109457,"_2648":109492},[],"DMS → solicitante",{"_3150":64986,"_27690":64973,"_19203":109494,"_5":13195,"_26191":109457,"_2648":109495},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3150":64987,"_27690":64973,"_19203":109497,"_5":13195,"_26191":109457,"_2648":109498},[],"Consumidor → dispositivo",{"_3150":64988,"_27690":64973,"_19203":109500,"_5":13195,"_26191":109457,"_2648":109501},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3150":64989,"_27690":64973,"_19203":109503,"_5":13195,"_26191":109457,"_2648":109504},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3150":64990,"_27690":64973,"_19203":109506,"_5":13195,"_26191":109461,"_2648":109507},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3150":64991,"_27690":64973,"_19203":109509,"_5":13195,"_26191":109461,"_2648":109510},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3150":64992,"_27690":64973,"_19203":109512,"_5":13195,"_26191":109465,"_2648":109513},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3150":64993,"_27690":64973,"_19203":109515,"_5":13195,"_26191":109465,"_2648":109516},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3150":64994,"_27690":64973,"_19203":109518,"_5":13195,"_26191":109465,"_2648":109519},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3150":64995,"_27690":64973,"_19203":109521,"_5":13195,"_26191":109465,"_2648":109522},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3150":64996,"_27690":64973,"_19203":109524,"_5":13195,"_26191":109465,"_2648":109525},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3150":64997,"_27690":64973,"_19203":109527,"_5":13195,"_26191":109465,"_2648":109528},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3150":64998,"_27690":64973,"_19203":109530,"_5":13195,"_26191":109469,"_2648":109531},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3150":64999,"_27690":64973,"_19203":109533,"_5":13195,"_26191":109469,"_2648":109534},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3150":65000,"_27690":64973,"_19203":109536,"_5":13195,"_26191":109469,"_2648":109537},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3150":65001,"_27690":64973,"_19203":109539,"_5":13195,"_26191":109473,"_2648":109540},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3150":65002,"_27690":65002,"_5":13521,"_2648":48811,"_28032":109542,"_19203":109544,"_26191":65002},[45000,107166,47357,108141,109543],"Integraciones",[],{"_3150":65003,"_27690":65002,"_19203":109546,"_5":13195,"_26191":65002,"_2648":109547},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3150":65004,"_27690":65002,"_5":28029,"_19203":109549,"_26191":109550,"_2648":109551},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3150":65005,"_27690":65002,"_5":28029,"_19203":109553,"_26191":109554,"_2648":109555},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3150":65006,"_27690":65002,"_5":28029,"_19203":109557,"_26191":109558,"_2648":109559},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3150":65007,"_27690":65002,"_5":28029,"_19203":109561,"_26191":109562,"_2648":109563},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3150":65008,"_27690":65002,"_5":28029,"_19203":109565,"_26191":109566,"_2648":109567},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3150":65009,"_27690":65002,"_5":28029,"_19203":109569,"_26191":109570,"_2648":109571},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3150":65010,"_27690":65002,"_5":28029,"_19203":109573,"_26191":109574,"_2648":48845},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3150":65011,"_27690":65002,"_5":28029,"_19203":109576,"_26191":109577,"_2648":48849},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3150":65012,"_27690":65002,"_5":28029,"_19203":109579,"_26191":109580,"_2648":109581},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3150":65013,"_27690":65002,"_5":28029,"_19203":109583,"_26191":109584,"_2648":109585},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3150":65014,"_27690":65002,"_5":28029,"_19203":109587,"_26191":109588,"_2648":109589},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3150":65015,"_27690":65002,"_5":28029,"_19203":109591,"_26191":109592,"_2648":109593},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3150":65016,"_27690":65002,"_5":28029,"_19203":109595,"_26191":109596,"_2648":109597},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3150":65017,"_27690":65002,"_5":28029,"_19203":109599,"_26191":109600,"_2648":109601},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3150":65018,"_27690":65002,"_5":28029,"_19203":109603,"_26191":109604,"_2648":109605},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3150":65019,"_27690":65002,"_5":28029,"_19203":109607,"_26191":109608,"_2648":109609},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3150":65020,"_27690":65002,"_5":28029,"_19203":109611,"_26191":109612,"_2648":109613},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3150":65021,"_27690":65002,"_5":28029,"_19203":109615,"_26191":109616,"_2648":109617},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3150":65022,"_27690":65002,"_5":28029,"_19203":109619,"_26191":109620,"_2648":109621},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3150":65023,"_27690":65002,"_5":28029,"_19203":109623,"_26191":109624,"_2648":109625},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3150":65024,"_27690":65002,"_19203":109627,"_5":13195,"_26191":65002,"_2648":109628},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3150":65025,"_27690":65002,"_19203":109630,"_5":13195,"_26191":65002,"_2648":109631},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3150":65026,"_27690":65002,"_19203":109633,"_5":13195,"_26191":65002,"_2648":109634},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3150":65027,"_27690":65002,"_19203":109636,"_5":13195,"_26191":109550,"_2648":109637},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3150":65028,"_27690":65002,"_19203":109639,"_5":13195,"_26191":109550,"_2648":109640},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3150":65029,"_27690":65002,"_19203":109642,"_5":13195,"_26191":109550,"_2648":109643},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3150":65030,"_27690":65002,"_19203":109645,"_5":13195,"_26191":109550,"_2648":109646},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3150":65031,"_27690":65002,"_19203":109648,"_5":13195,"_26191":109554,"_2648":109649},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3150":65032,"_27690":65002,"_19203":109651,"_5":13195,"_26191":109558,"_2648":109652},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3150":65033,"_27690":65002,"_19203":109654,"_5":13195,"_26191":109558,"_2648":109655},[],"Acción IAM",{"_3150":65034,"_27690":65002,"_19203":109657,"_5":13195,"_26191":109558,"_2648":106202},[],{"_3150":65035,"_27690":65002,"_19203":109659,"_5":13195,"_26191":109558,"_2648":48932},[],{"_3150":65036,"_27690":65002,"_19203":109661,"_5":13195,"_26191":109558,"_2648":109662},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3150":65037,"_27690":65002,"_19203":109664,"_5":13195,"_26191":109558,"_2648":48938},[],{"_3150":65038,"_27690":65002,"_19203":109666,"_5":13195,"_26191":109558,"_2648":109667},[],"Registrar la CA en AWS IoT",{"_3150":65039,"_27690":65002,"_19203":109669,"_5":13195,"_26191":109558,"_2648":48944},[],{"_3150":65040,"_27690":65002,"_19203":109671,"_5":13195,"_26191":109558,"_2648":109672},[],"Consultar el estado del registro de la CA",{"_3150":65041,"_27690":65002,"_19203":109674,"_5":13195,"_26191":109558,"_2648":48950},[],{"_3150":65042,"_27690":65002,"_19203":109676,"_5":13195,"_26191":109558,"_2648":109677},[],"Crear o actualizar Things en IoT Core",{"_3150":65043,"_27690":65002,"_19203":109679,"_5":13195,"_26191":109558,"_2648":48956},[],{"_3150":65044,"_27690":65002,"_19203":109681,"_5":13195,"_26191":109558,"_2648":109682},[],"Aprovisionar Things mediante plantilla",{"_3150":65045,"_27690":65002,"_19203":109684,"_5":13195,"_26191":109558,"_2648":48962},[],{"_3150":65046,"_27690":65002,"_19203":109686,"_5":13195,"_26191":109558,"_2648":109687},[],"Registrar certificados de dispositivo",{"_3150":65047,"_27690":65002,"_19203":109689,"_5":13195,"_26191":109558,"_2648":48968},[],{"_3150":65048,"_27690":65002,"_19203":109691,"_5":13195,"_26191":109558,"_2648":109692},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3150":65049,"_27690":65002,"_19203":109694,"_5":13195,"_26191":109558,"_2648":48974},[],{"_3150":65050,"_27690":65002,"_19203":109696,"_5":13195,"_26191":109558,"_2648":109697},[],"Crear y adjuntar políticas IoT",{"_3150":65051,"_27690":65002,"_19203":109699,"_5":13195,"_26191":109558,"_2648":48980},[],{"_3150":65052,"_27690":65002,"_19203":109701,"_5":13195,"_26191":109558,"_2648":109702},[],"Gestionar grupos de Things",{"_3150":65053,"_27690":65002,"_19203":109704,"_5":13195,"_26191":109558,"_2648":48986},[],{"_3150":65054,"_27690":65002,"_19203":109706,"_5":13195,"_26191":109558,"_2648":109707},[],"Crear plantillas JITP",{"_3150":65055,"_27690":65002,"_19203":109709,"_5":13195,"_26191":109558,"_2648":48992},[],{"_3150":65056,"_27690":65002,"_19203":109711,"_5":13195,"_26191":109558,"_2648":109712},[],"Leer y escribir el Device Shadow",{"_3150":65057,"_27690":65002,"_19203":109714,"_5":13195,"_26191":109558,"_2648":109715},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3150":65058,"_27690":65002,"_19203":109717,"_5":13195,"_26191":109562,"_2648":109718},[],"Parámetro",{"_3150":65059,"_27690":65002,"_19203":109720,"_5":13195,"_26191":109562,"_2648":109721},[],"Tipo",{"_3150":65060,"_27690":65002,"_19203":109723,"_5":13195,"_26191":109562,"_2648":109724},[],"Requerido",{"_3150":65061,"_27690":65002,"_19203":109726,"_5":13195,"_26191":109562,"_2648":109727},[],"Descripción",{"_3150":65062,"_27690":65002,"_19203":109729,"_5":13195,"_26191":109562,"_2648":49013},[],{"_3150":65063,"_27690":65002,"_19203":109731,"_5":13195,"_26191":109562,"_2648":22963},[],{"_3150":65064,"_27690":65002,"_19203":109733,"_5":13195,"_26191":109562,"_2648":109734},[],"Sí",{"_3150":65065,"_27690":65002,"_19203":109736,"_5":13195,"_26191":109562,"_2648":109737},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3150":65066,"_27690":65002,"_19203":109739,"_5":13195,"_26191":109562,"_2648":49024},[],{"_3150":65067,"_27690":65002,"_19203":109741,"_5":13195,"_26191":109562,"_2648":22963},[],{"_3150":65068,"_27690":65002,"_19203":109743,"_5":13195,"_26191":109562,"_2648":109734},[],{"_3150":65069,"_27690":65002,"_19203":109745,"_5":13195,"_26191":109562,"_2648":109746},[],"Región AWS donde opera el conector.",{"_3150":65070,"_27690":65002,"_19203":109748,"_5":13195,"_26191":109562,"_2648":49034},[],{"_3150":65071,"_27690":65002,"_19203":109750,"_5":13195,"_26191":109562,"_2648":22963},[],{"_3150":65072,"_27690":65002,"_19203":109752,"_5":13195,"_26191":109562,"_2648":109734},[],{"_3150":65073,"_27690":65002,"_19203":109754,"_5":13195,"_26191":109562,"_2648":109755},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3150":65074,"_27690":65002,"_19203":109757,"_5":13195,"_26191":109562,"_2648":49044},[],{"_3150":65075,"_27690":65002,"_19203":109759,"_5":13195,"_26191":109562,"_2648":22963},[],{"_3150":65076,"_27690":65002,"_19203":109761,"_5":13195,"_26191":109562,"_2648":109762},[],"Solo con `auth_method=static`",{"_3150":65077,"_27690":65002,"_19203":109764,"_5":13195,"_26191":109562,"_2648":109765},[],"Clave de acceso AWS.",{"_3150":65078,"_27690":65002,"_19203":109767,"_5":13195,"_26191":109562,"_2648":49055},[],{"_3150":65079,"_27690":65002,"_19203":109769,"_5":13195,"_26191":109562,"_2648":22963},[],{"_3150":65080,"_27690":65002,"_19203":109771,"_5":13195,"_26191":109562,"_2648":109762},[],{"_3150":65081,"_27690":65002,"_19203":109773,"_5":13195,"_26191":109562,"_2648":109774},[],"Clave secreta AWS.",{"_3150":65082,"_27690":65002,"_19203":109776,"_5":13195,"_26191":109562,"_2648":49065},[],{"_3150":65083,"_27690":65002,"_19203":109778,"_5":13195,"_26191":109562,"_2648":22963},[],{"_3150":65084,"_27690":65002,"_19203":109780,"_5":13195,"_26191":109562,"_2648":49070},[],{"_3150":65085,"_27690":65002,"_19203":109782,"_5":13195,"_26191":109562,"_2648":109783},[],"Token de sesión (con `auth_method=static`).",{"_3150":65086,"_27690":65002,"_19203":109785,"_5":13195,"_26191":109562,"_2648":49076},[],{"_3150":65087,"_27690":65002,"_19203":109787,"_5":13195,"_26191":109562,"_2648":22963},[],{"_3150":65088,"_27690":65002,"_19203":109789,"_5":13195,"_26191":109562,"_2648":109790},[],"Solo con `auth_method=role`",{"_3150":65089,"_27690":65002,"_19203":109792,"_5":13195,"_26191":109562,"_2648":109793},[],"ARN del rol a asumir.",{"_3150":65090,"_27690":65002,"_19203":109795,"_5":13195,"_26191":109562,"_2648":49087},[],{"_3150":65091,"_27690":65002,"_19203":109797,"_5":13195,"_26191":109562,"_2648":22963},[],{"_3150":65092,"_27690":65002,"_19203":109799,"_5":13195,"_26191":109562,"_2648":49070},[],{"_3150":65093,"_27690":65002,"_19203":109801,"_5":13195,"_26191":109562,"_2648":109802},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3150":65094,"_27690":65002,"_19203":109804,"_5":13195,"_26191":109562,"_2648":49097},[],{"_3150":65095,"_27690":65002,"_19203":109806,"_5":13195,"_26191":109562,"_2648":16192},[],{"_3150":65096,"_27690":65002,"_19203":109808,"_5":13195,"_26191":109562,"_2648":109734},[],{"_3150":65097,"_27690":65002,"_19203":109810,"_5":13195,"_26191":109562,"_2648":109811},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3150":65098,"_27690":65002,"_19203":109813,"_5":13195,"_26191":109562,"_2648":49107},[],{"_3150":65099,"_27690":65002,"_19203":109815,"_5":13195,"_26191":109562,"_2648":22963},[],{"_3150":65100,"_27690":65002,"_19203":109817,"_5":13195,"_26191":109562,"_2648":109734},[],{"_3150":65101,"_27690":65002,"_19203":109819,"_5":13195,"_26191":109562,"_2648":109820},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3150":65102,"_27690":65002,"_19203":109822,"_5":13195,"_26191":109562,"_2648":49117},[],{"_3150":65103,"_27690":65002,"_19203":109824,"_5":13195,"_26191":109562,"_2648":22963},[],{"_3150":65104,"_27690":65002,"_19203":109826,"_5":13195,"_26191":109562,"_2648":109734},[],{"_3150":65105,"_27690":65002,"_19203":109828,"_5":13195,"_26191":109562,"_2648":109829},[],"URL HTTP del Device Manager de Lamassu.",{"_3150":65106,"_27690":65002,"_19203":109831,"_5":13195,"_26191":109562,"_2648":49127},[],{"_3150":65107,"_27690":65002,"_19203":109833,"_5":13195,"_26191":109562,"_2648":22963},[],{"_3150":65108,"_27690":65002,"_19203":109835,"_5":13195,"_26191":109562,"_2648":109734},[],{"_3150":65109,"_27690":65002,"_19203":109837,"_5":13195,"_26191":109562,"_2648":109838},[],"URL HTTP del servicio de CA de Lamassu.",{"_3150":65110,"_27690":65002,"_19203":109840,"_5":13195,"_26191":109566,"_2648":109841},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3150":65111,"_27690":65002,"_19203":109843,"_5":13195,"_26191":109570,"_2648":109844},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3150":65112,"_27690":65002,"_19203":109846,"_5":13195,"_26191":109570,"_2648":109847},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3150":65113,"_27690":65002,"_19203":109849,"_5":13195,"_26191":109574,"_2648":109850},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3150":65114,"_27690":65002,"_19203":109852,"_5":13195,"_26191":109574,"_2648":109853},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3150":65115,"_27690":65002,"_19203":109855,"_5":13195,"_26191":109574,"_2648":109856},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3150":65116,"_27690":65002,"_19203":109858,"_5":13195,"_26191":109574,"_2648":109859},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3150":65117,"_27690":65002,"_19203":109861,"_5":13195,"_26191":109574,"_2648":109862},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3150":65118,"_27690":65002,"_19203":109864,"_5":13195,"_26191":109574,"_2648":109865},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3150":65119,"_27690":65002,"_19203":109867,"_5":13195,"_26191":109577,"_2648":109868},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3150":65120,"_27690":65002,"_19203":109870,"_5":13195,"_26191":109580,"_2648":109871},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3150":65121,"_27690":65002,"_19203":109873,"_5":13195,"_26191":109580,"_2648":109874},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3150":65122,"_27690":65002,"_19203":109876,"_5":13195,"_26191":109584,"_2648":109877},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3150":65123,"_27690":65002,"_19203":109879,"_5":13195,"_26191":109588,"_2648":109880},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3150":65124,"_27690":65002,"_19203":109882,"_5":13195,"_26191":109588,"_2648":109883},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3150":65125,"_27690":65002,"_19203":109885,"_5":13195,"_26191":109588,"_2648":109886},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3150":65126,"_27690":65002,"_19203":109888,"_5":13195,"_26191":109588,"_2648":109889},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3150":65127,"_27690":65002,"_19203":109891,"_5":13195,"_26191":109588,"_2648":109892},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3150":65128,"_27690":65002,"_19203":109894,"_5":13195,"_26191":109588,"_2648":109895},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3150":65129,"_27690":65002,"_19203":109897,"_5":13195,"_26191":109592,"_2648":109898},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3150":65130,"_27690":65002,"_19203":109900,"_5":13195,"_26191":109592,"_2648":109901},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3150":65131,"_27690":65002,"_19203":109903,"_5":13195,"_26191":109592,"_2648":109904},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3150":65132,"_27690":65002,"_19203":109906,"_5":13195,"_26191":109596,"_2648":109907},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3150":65133,"_27690":65002,"_19203":109909,"_5":13195,"_26191":109596,"_2648":109910},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3150":65134,"_27690":65002,"_19203":109912,"_5":13195,"_26191":109596,"_2648":109913},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3150":65135,"_27690":65002,"_19203":109915,"_5":13195,"_26191":109600,"_2648":109916},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3150":65136,"_27690":65002,"_19203":109918,"_5":13195,"_26191":109600,"_2648":109919},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3150":65137,"_27690":65002,"_19203":109921,"_5":13195,"_26191":109600,"_2648":109922},[],"Para que el flujo JITP funcione correctamente:",{"_3150":65138,"_27690":65002,"_19203":109924,"_5":13195,"_26191":109600,"_2648":109925},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3150":65139,"_27690":65002,"_19203":109927,"_5":13195,"_26191":109600,"_2648":109928},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3150":65140,"_27690":65002,"_19203":109930,"_5":13195,"_26191":109600,"_2648":109931},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3150":65141,"_27690":65002,"_19203":109933,"_5":13195,"_26191":109600,"_2648":109934},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3150":65142,"_27690":65002,"_19203":109936,"_5":13195,"_26191":109604,"_2648":109937},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3150":65143,"_27690":65002,"_19203":109939,"_5":13195,"_26191":109604,"_2648":109940},[],"Estado en Lamassu",{"_3150":65144,"_27690":65002,"_19203":109942,"_5":13195,"_26191":109604,"_2648":109943},[],"Razón de revocación",{"_3150":65145,"_27690":65002,"_19203":109945,"_5":13195,"_26191":109604,"_2648":109946},[],"Estado en AWS IoT Core",{"_3150":65146,"_27690":65002,"_19203":109948,"_5":13195,"_26191":109604,"_2648":49248},[],{"_3150":65147,"_27690":65002,"_19203":109950,"_5":13195,"_26191":109604,"_2648":109951},[],"Ninguna",{"_3150":65148,"_27690":65002,"_19203":109953,"_5":13195,"_26191":109604,"_2648":49254},[],{"_3150":65149,"_27690":65002,"_19203":109955,"_5":13195,"_26191":109604,"_2648":49257},[],{"_3150":65150,"_27690":65002,"_19203":109957,"_5":13195,"_26191":109604,"_2648":49260},[],{"_3150":65151,"_27690":65002,"_19203":109959,"_5":13195,"_26191":109604,"_2648":49263},[],{"_3150":65152,"_27690":65002,"_19203":109961,"_5":13195,"_26191":109604,"_2648":49257},[],{"_3150":65153,"_27690":65002,"_19203":109963,"_5":13195,"_26191":109604,"_2648":109964},[],"Cualquier otra razón",{"_3150":65154,"_27690":65002,"_19203":109966,"_5":13195,"_26191":109604,"_2648":49271},[],{"_3150":65155,"_27690":65002,"_19203":109968,"_5":13195,"_26191":109604,"_2648":109969},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3150":65156,"_27690":65002,"_19203":109971,"_5":13195,"_26191":109608,"_2648":109972},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3150":65157,"_27690":65002,"_19203":109974,"_5":13195,"_26191":109608,"_2648":109975},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3150":65158,"_27690":65002,"_19203":109977,"_5":13195,"_26191":109608,"_2648":109978},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3150":65159,"_27690":65002,"_19203":109980,"_5":13195,"_26191":109612,"_2648":109981},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3150":65160,"_27690":65002,"_19203":109983,"_5":13195,"_26191":109612,"_2648":109984},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3150":65161,"_27690":65002,"_19203":109986,"_5":13195,"_26191":109616,"_2648":109987},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3150":65162,"_27690":65002,"_19203":109989,"_5":13195,"_26191":109616,"_2648":109990},[],"Existen dos tipos de acciones:",{"_3150":65163,"_27690":65002,"_19203":109992,"_5":13195,"_26191":109616,"_2648":109993},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3150":65164,"_27690":65002,"_19203":109995,"_5":13195,"_26191":109616,"_2648":109996},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3150":65165,"_27690":65002,"_19203":109998,"_5":13195,"_26191":109616,"_2648":109999},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3150":65166,"_27690":65002,"_19203":110001,"_5":13195,"_26191":109620,"_2648":110002},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3150":65167,"_27690":65002,"_19203":110004,"_5":13195,"_26191":109620,"_2648":110005},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3150":65168,"_27690":65002,"_19203":110007,"_5":13195,"_26191":109620,"_2648":110008},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3150":65169,"_27690":65002,"_19203":110010,"_5":13195,"_26191":109624,"_2648":110011},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3150":65170,"_27690":65002,"_19203":110013,"_5":13195,"_26191":109624,"_2648":110014},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3150":65171,"_27690":65002,"_19203":110016,"_5":13195,"_26191":109624,"_2648":110017},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3150":65172,"_27690":65002,"_19203":110019,"_5":13195,"_26191":109624,"_2648":110020},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3150":65173,"_27690":65002,"_19203":110022,"_5":13195,"_26191":109624,"_2648":110023},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3150":65174,"_27690":65002,"_19203":110025,"_5":13195,"_26191":109624,"_2648":110026},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3150":65175,"_27690":65002,"_19203":110028,"_5":13195,"_26191":109624,"_2648":110029},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3150":65176,"_27690":65002,"_19203":110031,"_5":13195,"_26191":109624,"_2648":110032},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3150":65177,"_27690":65002,"_19203":110034,"_5":13195,"_26191":109624,"_2648":110035},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3150":65178,"_27690":65002,"_19203":110037,"_5":13195,"_26191":109624,"_2648":110038},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3150":65179,"_27690":65002,"_19203":110040,"_5":13195,"_26191":109624,"_2648":110041},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3150":65180,"_27690":65002,"_19203":110043,"_5":13195,"_26191":109624,"_2648":110044},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3150":65181,"_27690":65002,"_19203":110046,"_5":13195,"_26191":109624,"_2648":110047},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3150":65182,"_27690":65002,"_19203":110049,"_5":13195,"_26191":109624,"_2648":110050},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3150":65183,"_27690":65002,"_19203":110052,"_5":13195,"_26191":109624,"_2648":110053},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3150":65184,"_27690":65002,"_19203":110055,"_5":13195,"_26191":109624,"_2648":110056},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3150":65185,"_27690":65002,"_19203":110058,"_5":13195,"_26191":109624,"_2648":110059},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3150":65186,"_27690":65002,"_19203":110061,"_5":13195,"_26191":109624,"_2648":110062},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3150":65187,"_27690":65002,"_19203":110064,"_5":13195,"_26191":109624,"_2648":110065},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":65188,"_27690":65002,"_19203":110067,"_5":13195,"_26191":109624,"_2648":110068},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3150":65189,"_27690":65002,"_19203":110070,"_5":13195,"_26191":109624,"_2648":110071},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3150":65190,"_27690":65190,"_5":13521,"_2648":47357,"_28032":110073,"_19203":110074,"_26191":65190},[45000,107166,47357],[],{"_3150":65191,"_27690":65190,"_19203":110076,"_5":13195,"_26191":65190,"_2648":110077},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3150":65192,"_27690":65190,"_5":28029,"_19203":110079,"_26191":110080,"_2648":110081},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3150":65193,"_27690":65190,"_5":28029,"_19203":110083,"_26191":110084,"_2648":108141},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3150":65194,"_27690":65190,"_5":28029,"_19203":110086,"_26191":110087,"_2648":108316},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3150":65195,"_27690":65190,"_5":28029,"_19203":110089,"_26191":110090,"_2648":109543},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/overview#integraciones",{"_3150":65196,"_27690":65190,"_5":28029,"_19203":110092,"_26191":110093,"_2648":110094},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3150":65197,"_27690":65190,"_19203":110096,"_5":13195,"_26191":65190,"_2648":110097},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3150":65198,"_27690":65190,"_19203":110099,"_5":13195,"_26191":110080,"_2648":110100},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3150":65199,"_27690":65190,"_19203":110102,"_5":13195,"_26191":110080,"_2648":110103},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3150":65200,"_27690":65190,"_19203":110105,"_5":13195,"_26191":110084,"_2648":110106},[],"Recurso",{"_3150":65201,"_27690":65190,"_19203":110108,"_5":13195,"_26191":110084,"_2648":110109},[],"Qué representa",{"_3150":65202,"_27690":65190,"_19203":110111,"_5":13195,"_26191":110084,"_2648":110112},[],"**Dispositivo**",{"_3150":65203,"_27690":65190,"_19203":110114,"_5":13195,"_26191":110084,"_2648":110115},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3150":65204,"_27690":65190,"_19203":110117,"_5":13195,"_26191":110084,"_2648":110118},[],"**Identidad**",{"_3150":65205,"_27690":65190,"_19203":110120,"_5":13195,"_26191":110084,"_2648":110121},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3150":65206,"_27690":65190,"_19203":110123,"_5":13195,"_26191":110084,"_2648":49429},[],{"_3150":65207,"_27690":65190,"_19203":110125,"_5":13195,"_26191":110084,"_2648":110126},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3150":65208,"_27690":65190,"_19203":110128,"_5":13195,"_26191":110084,"_2648":110129},[],"**Flota**",{"_3150":65209,"_27690":65190,"_19203":110131,"_5":13195,"_26191":110084,"_2648":110132},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3150":65210,"_27690":65190,"_19203":110134,"_5":13195,"_26191":110084,"_2648":110135},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3150":65211,"_27690":65190,"_19203":110137,"_5":13195,"_26191":110084,"_2648":110138},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3150":65212,"_27690":65190,"_19203":110140,"_5":13195,"_26191":110087,"_2648":110141},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3150":65213,"_27690":65190,"_19203":110143,"_5":13195,"_26191":110087,"_2648":110144},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3150":65214,"_27690":65190,"_19203":110146,"_5":13195,"_26191":110087,"_2648":110147},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3150":65215,"_27690":65190,"_19203":110149,"_5":13195,"_26191":110087,"_2648":110150},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3150":65216,"_27690":65190,"_19203":110152,"_5":13195,"_26191":110087,"_2648":110153},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3150":65217,"_27690":65190,"_19203":110155,"_5":13195,"_26191":110087,"_2648":110156},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3150":65218,"_27690":65190,"_19203":110158,"_5":13195,"_26191":110087,"_2648":110159},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":65219,"_27690":65190,"_19203":110161,"_5":13195,"_26191":110087,"_2648":110162},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3150":65220,"_27690":65190,"_19203":110164,"_5":13195,"_26191":110090,"_2648":110165},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3150":65221,"_27690":65190,"_19203":110167,"_5":13195,"_26191":110090,"_2648":110168},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3150":65222,"_27690":65190,"_19203":110170,"_5":13195,"_26191":110093,"_2648":110171},[],"Participante",{"_3150":65223,"_27690":65190,"_19203":110173,"_5":13195,"_26191":110093,"_2648":110174},[],"Responsabilidad",{"_3150":65224,"_27690":65190,"_19203":110176,"_5":13195,"_26191":110093,"_2648":110177},[],"Administrador PKI",{"_3150":65225,"_27690":65190,"_19203":110179,"_5":13195,"_26191":110093,"_2648":110180},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3150":65226,"_27690":65190,"_19203":110182,"_5":13195,"_26191":110093,"_2648":110183},[],"Administrador del aprovisionamiento",{"_3150":65227,"_27690":65190,"_19203":110185,"_5":13195,"_26191":110093,"_2648":110186},[],"DMS, admisión, autenticación por operación e inventario.",{"_3150":65228,"_27690":65190,"_19203":110188,"_5":13195,"_26191":110093,"_2648":110189},[],"Integrador del dispositivo",{"_3150":65229,"_27690":65190,"_19203":110191,"_5":13195,"_26191":110093,"_2648":110192},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3150":65230,"_27690":65190,"_19203":110194,"_5":13195,"_26191":110093,"_2648":110195},[],"Integrador del consumidor",{"_3150":65231,"_27690":65190,"_19203":110197,"_5":13195,"_26191":110093,"_2648":110198},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3150":65232,"_27690":65190,"_19203":110200,"_5":13195,"_26191":110093,"_2648":110201},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3150":65233,"_27690":65233,"_5":13521,"_2648":110203,"_28032":110204,"_19203":110206,"_26191":65233},"Enrola y conecta tu primer dispositivo",[45000,107166,47357,110205],"Primeros pasos",[],{"_3150":65234,"_27690":65233,"_19203":110208,"_5":13195,"_26191":65233,"_2648":110209},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3150":65235,"_27690":65233,"_5":28029,"_19203":110211,"_26191":110212,"_2648":105832},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3150":65236,"_27690":65233,"_5":28029,"_19203":110214,"_26191":110215,"_2648":110216},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3150":65237,"_27690":65233,"_5":28029,"_19203":110218,"_26191":110219,"_2648":110220},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3150":65238,"_27690":65233,"_5":28029,"_19203":110222,"_26191":110223,"_2648":110224},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3150":65239,"_27690":65233,"_5":28029,"_19203":110226,"_26191":110227,"_2648":110228},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3150":65240,"_27690":65233,"_5":28029,"_19203":110230,"_26191":110231,"_2648":110232},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3150":65241,"_27690":65233,"_5":28029,"_19203":110234,"_26191":110235,"_2648":110236},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3150":65242,"_27690":65233,"_5":28029,"_19203":110238,"_26191":110239,"_2648":110240},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3150":65243,"_27690":65233,"_19203":110242,"_5":13195,"_26191":65233,"_2648":110243},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3150":65244,"_27690":65233,"_19203":110245,"_5":13195,"_26191":110212,"_2648":110246},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3150":65245,"_27690":65233,"_19203":110248,"_5":13195,"_26191":110212,"_2648":110249},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3150":65246,"_27690":65233,"_19203":110251,"_5":13195,"_26191":110212,"_2648":110252},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3150":65247,"_27690":65233,"_19203":110254,"_5":13195,"_26191":110212,"_2648":110255},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3150":65248,"_27690":65233,"_19203":110257,"_5":13195,"_26191":110212,"_2648":110258},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3150":65249,"_27690":65233,"_19203":110260,"_5":13195,"_26191":110215,"_2648":110261},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3150":65250,"_27690":65233,"_19203":110263,"_5":13195,"_26191":110215,"_2648":110264},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3150":65251,"_27690":65233,"_19203":110266,"_5":13195,"_26191":110219,"_2648":110267},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3150":65252,"_27690":65233,"_19203":110269,"_5":13195,"_26191":110219,"_2648":110270},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3150":65253,"_27690":65233,"_19203":110272,"_5":13195,"_26191":110219,"_2648":110273},[],"Ajuste",{"_3150":65254,"_27690":65233,"_19203":110275,"_5":13195,"_26191":110219,"_2648":110276},[],"Valor de evaluación",{"_3150":65255,"_27690":65233,"_19203":110278,"_5":13195,"_26191":110219,"_2648":49585},[],{"_3150":65256,"_27690":65233,"_19203":110280,"_5":13195,"_26191":110219,"_2648":110281},[],"Raíz emisora de `device-root.pem`.",{"_3150":65257,"_27690":65233,"_19203":110283,"_5":13195,"_26191":110219,"_2648":108444},[],{"_3150":65258,"_27690":65233,"_19203":110285,"_5":13195,"_26191":110219,"_2648":110286},[],"Perfil final de 1 hora que acabas de preparar.",{"_3150":65259,"_27690":65233,"_19203":110288,"_5":13195,"_26191":110219,"_2648":49596},[],{"_3150":65260,"_27690":65233,"_19203":110290,"_5":13195,"_26191":110219,"_2648":49599},[],{"_3150":65261,"_27690":65233,"_19203":110292,"_5":13195,"_26191":110219,"_2648":49602},[],{"_3150":65262,"_27690":65233,"_19203":110294,"_5":13195,"_26191":110219,"_2648":110295},[],"Habilitado.",{"_3150":65263,"_27690":65233,"_19203":110297,"_5":13195,"_26191":110219,"_2648":49608},[],{"_3150":65264,"_27690":65233,"_19203":110299,"_5":13195,"_26191":110219,"_2648":110300},[],"Deshabilitado; el ID debe ser nuevo.",{"_3150":65265,"_27690":65233,"_19203":110302,"_5":13195,"_26191":110219,"_2648":110303},[],"Autenticación inicial",{"_3150":65266,"_27690":65233,"_19203":110305,"_5":13195,"_26191":110219,"_2648":110306},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3150":65267,"_27690":65233,"_19203":110308,"_5":13195,"_26191":110219,"_2648":110309},[],"Autenticación de renovación",{"_3150":65268,"_27690":65233,"_19203":110311,"_5":13195,"_26191":110219,"_2648":110312},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3150":65269,"_27690":65233,"_19203":110314,"_5":13195,"_26191":110219,"_2648":49626},[],{"_3150":65270,"_27690":65233,"_19203":110316,"_5":13195,"_26191":110219,"_2648":110317},[],"No se necesitan para esta emisión directa; la CA de enrolamiento se incluye siempre / deshabilitado.",{"_3150":65271,"_27690":65233,"_19203":110319,"_5":13195,"_26191":110219,"_2648":49632},[],{"_3150":65272,"_27690":65233,"_19203":110321,"_5":13195,"_26191":110219,"_2648":110322},[],"1 hora.",{"_3150":65273,"_27690":65233,"_19203":110324,"_5":13195,"_26191":110219,"_2648":49638},[],{"_3150":65274,"_27690":65233,"_19203":110326,"_5":13195,"_26191":110219,"_2648":110327},[],"30 minutos / 10 minutos.",{"_3150":65275,"_27690":65233,"_19203":110329,"_5":13195,"_26191":110219,"_2648":49644},[],{"_3150":65276,"_27690":65233,"_19203":110331,"_5":13195,"_26191":110219,"_2648":110332},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3150":65277,"_27690":65233,"_19203":110334,"_5":13195,"_26191":110219,"_2648":47676},[],{"_3150":65278,"_27690":65233,"_19203":110336,"_5":13195,"_26191":110219,"_2648":110337},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3150":65279,"_27690":65233,"_19203":110339,"_5":13195,"_26191":110219,"_2648":49655},[],{"_3150":65280,"_27690":65233,"_19203":110341,"_5":13195,"_26191":110219,"_2648":110342},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3150":65281,"_27690":65233,"_19203":110344,"_5":13195,"_26191":110219,"_2648":110345},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_3150":65282,"_27690":65233,"_19203":110347,"_5":13195,"_26191":110223,"_2648":110348},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3150":65283,"_27690":65233,"_19203":110350,"_5":13195,"_26191":110223,"_2648":110351},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3150":65284,"_27690":65233,"_19203":110353,"_5":13195,"_26191":110227,"_2648":110354},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3150":65285,"_27690":65233,"_19203":110356,"_5":13195,"_26191":110227,"_2648":110357},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3150":65286,"_27690":65233,"_19203":110359,"_5":13195,"_26191":110227,"_2648":110360},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3150":65287,"_27690":65233,"_19203":110362,"_5":13195,"_26191":110231,"_2648":110363},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3150":65288,"_27690":65233,"_19203":110365,"_5":13195,"_26191":110231,"_2648":110366},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3150":65289,"_27690":65233,"_19203":110368,"_5":13195,"_26191":110235,"_2648":110369},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3150":65290,"_27690":65233,"_19203":110371,"_5":13195,"_26191":110235,"_2648":110372},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3150":65291,"_27690":65233,"_19203":110374,"_5":13195,"_26191":110235,"_2648":110375},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3150":65292,"_27690":65233,"_19203":110377,"_5":13195,"_26191":110235,"_2648":110378},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3150":65293,"_27690":65233,"_19203":110380,"_5":13195,"_26191":110235,"_2648":110381},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3150":65294,"_27690":65233,"_19203":110383,"_5":13195,"_26191":110239,"_2648":110384},[],"Comprobación",{"_3150":65295,"_27690":65233,"_19203":110386,"_5":13195,"_26191":110239,"_2648":110387},[],"Resultado esperado",{"_3150":65296,"_27690":65233,"_19203":110389,"_5":13195,"_26191":110239,"_2648":110390},[],"Registro",{"_3150":65297,"_27690":65233,"_19203":110392,"_5":13195,"_26191":110239,"_2648":110393},[],"ID creado automáticamente y DMS correcto.",{"_3150":65298,"_27690":65233,"_19203":110395,"_5":13195,"_26191":110239,"_2648":110396},[],"Certificado",{"_3150":65299,"_27690":65233,"_19203":110398,"_5":13195,"_26191":110239,"_2648":110399},[],"CN, perfil, serie y clave verificados.",{"_3150":65300,"_27690":65233,"_19203":110401,"_5":13195,"_26191":110239,"_2648":110402},[],"Inventario",{"_3150":65301,"_27690":65233,"_19203":110404,"_5":13195,"_26191":110239,"_2648":110405},[],"Serie recibida visible como identidad actual y en el historial.",{"_3150":65302,"_27690":65233,"_19203":110407,"_5":13195,"_26191":110239,"_2648":110408},[],"Consumidor",{"_3150":65303,"_27690":65233,"_19203":110410,"_5":13195,"_26191":110239,"_2648":110411},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3150":65304,"_27690":65233,"_19203":110413,"_5":13195,"_26191":110239,"_2648":110414},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3150":65305,"_27690":65233,"_19203":110416,"_5":13195,"_26191":110239,"_2648":110417},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3150":65306,"_27690":65306,"_5":13521,"_2648":108158,"_28032":110419,"_19203":110420,"_26191":65306},[45000,107166,47357,110205],[],{"_3150":65307,"_27690":65306,"_19203":110422,"_5":13195,"_26191":65306,"_2648":110423},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3150":65308,"_27690":65306,"_5":28029,"_19203":110425,"_26191":110426,"_2648":105832},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3150":65309,"_27690":65306,"_5":28029,"_19203":110428,"_26191":110429,"_2648":110430},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3150":65310,"_27690":65306,"_5":28029,"_19203":110432,"_26191":110433,"_2648":110434},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3150":65311,"_27690":65306,"_5":28029,"_19203":110436,"_26191":110437,"_2648":110438},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3150":65312,"_27690":65306,"_5":28029,"_19203":110440,"_26191":110441,"_2648":110442},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3150":65313,"_27690":65306,"_5":28029,"_19203":110444,"_26191":110445,"_2648":110446},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3150":65314,"_27690":65306,"_5":28029,"_19203":110448,"_26191":110449,"_2648":110387},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3150":65315,"_27690":65306,"_5":28029,"_19203":110451,"_26191":110452,"_2648":110453},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3150":65316,"_27690":65306,"_5":28029,"_19203":110455,"_26191":110456,"_2648":110457},[],"/docs/pr-preview/pr-40/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3150":65317,"_27690":65306,"_19203":110459,"_5":13195,"_26191":65306,"_2648":110460},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3150":65318,"_27690":65306,"_19203":110462,"_5":13195,"_26191":65306,"_2648":110463},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3150":65319,"_27690":65306,"_19203":110465,"_5":13195,"_26191":110426,"_2648":110466},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3150":65320,"_27690":65306,"_19203":110468,"_5":13195,"_26191":110426,"_2648":110469},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3150":65321,"_27690":65306,"_19203":110471,"_5":13195,"_26191":110426,"_2648":110472},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3150":65322,"_27690":65306,"_19203":110474,"_5":13195,"_26191":110426,"_2648":110475},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3150":65323,"_27690":65306,"_19203":110477,"_5":13195,"_26191":110429,"_2648":110478},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3150":65324,"_27690":65306,"_19203":110480,"_5":13195,"_26191":110429,"_2648":110481},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3150":65325,"_27690":65306,"_19203":110483,"_5":13195,"_26191":110429,"_2648":110484},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3150":65326,"_27690":65306,"_19203":110486,"_5":13195,"_26191":110429,"_2648":110487},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3150":65327,"_27690":65306,"_19203":110489,"_5":13195,"_26191":110429,"_2648":110490},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3150":65328,"_27690":65306,"_19203":110492,"_5":13195,"_26191":110429,"_2648":110493},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3150":65329,"_27690":65306,"_19203":110495,"_5":13195,"_26191":110429,"_2648":110496},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3150":65330,"_27690":65306,"_19203":110498,"_5":13195,"_26191":110429,"_2648":110499},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3150":65331,"_27690":65306,"_19203":110501,"_5":13195,"_26191":110433,"_2648":110502},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3150":65332,"_27690":65306,"_19203":110504,"_5":13195,"_26191":110433,"_2648":49821},[],{"_3150":65333,"_27690":65306,"_19203":110506,"_5":13195,"_26191":110433,"_2648":110507},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3150":65334,"_27690":65306,"_19203":110509,"_5":13195,"_26191":110433,"_2648":110510},[],"**Icon** y **Tags**: clasificación opcional.",{"_3150":65335,"_27690":65306,"_19203":110512,"_5":13195,"_26191":110433,"_2648":110513},[],"Confirma el registro.",{"_3150":65336,"_27690":65306,"_19203":110515,"_5":13195,"_26191":110437,"_2648":110516},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3150":65337,"_27690":65306,"_19203":110518,"_5":13195,"_26191":110437,"_2648":110519},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3150":65338,"_27690":65306,"_19203":110521,"_5":13195,"_26191":110441,"_2648":110522},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3150":65339,"_27690":65306,"_19203":110524,"_5":13195,"_26191":110441,"_2648":110525},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3150":65340,"_27690":65306,"_19203":110527,"_5":13195,"_26191":110445,"_2648":110528},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3150":65341,"_27690":65306,"_19203":110530,"_5":13195,"_26191":110445,"_2648":110531},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3150":65342,"_27690":65306,"_19203":110533,"_5":13195,"_26191":110449,"_2648":110384},[],{"_3150":65343,"_27690":65306,"_19203":110535,"_5":13195,"_26191":110449,"_2648":110536},[],"Resultado",{"_3150":65344,"_27690":65306,"_19203":110538,"_5":13195,"_26191":110449,"_2648":110539},[],"Dispositivo",{"_3150":65345,"_27690":65306,"_19203":110541,"_5":13195,"_26191":110449,"_2648":110542},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3150":65346,"_27690":65306,"_19203":110544,"_5":13195,"_26191":110449,"_2648":110545},[],"Identidad actual",{"_3150":65347,"_27690":65306,"_19203":110547,"_5":13195,"_26191":110449,"_2648":110548},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3150":65348,"_27690":65306,"_19203":110550,"_5":13195,"_26191":110449,"_2648":110551},[],"Historial",{"_3150":65349,"_27690":65306,"_19203":110553,"_5":13195,"_26191":110449,"_2648":110554},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3150":65350,"_27690":65306,"_19203":110556,"_5":13195,"_26191":110449,"_2648":110557},[],"Clave y certificado",{"_3150":65351,"_27690":65306,"_19203":110559,"_5":13195,"_26191":110449,"_2648":110560},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3150":65352,"_27690":65306,"_19203":110562,"_5":13195,"_26191":110452,"_2648":110563},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3150":65353,"_27690":65306,"_19203":110565,"_5":13195,"_26191":110452,"_2648":110566},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3150":65354,"_27690":65306,"_19203":110568,"_5":13195,"_26191":110452,"_2648":110569},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3150":65355,"_27690":65306,"_19203":110571,"_5":13195,"_26191":110452,"_2648":110572},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3150":65356,"_27690":65306,"_19203":110574,"_5":13195,"_26191":110456,"_2648":110575},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3150":65357,"_27690":65306,"_19203":110577,"_5":13195,"_26191":110456,"_2648":110578},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3150":65358,"_27690":65306,"_19203":110580,"_5":13195,"_26191":110456,"_2648":110581},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3150":65359,"_27690":65359,"_5":13521,"_2648":110583,"_28032":110584,"_19203":110585,"_26191":65359},"Plataforma Lamassu IoT",[45000,107166],[],{"_3150":65360,"_27690":65359,"_19203":110587,"_5":13195,"_26191":65359,"_2648":110588},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3150":65361,"_27690":65359,"_5":28029,"_19203":110590,"_26191":110591,"_2648":110081},[],"/docs/pr-preview/pr-40/es/platform/overview#empieza-aquí",{"_3150":65362,"_27690":65359,"_5":28029,"_19203":110593,"_26191":110594,"_2648":110595},[],"/docs/pr-preview/pr-40/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3150":65363,"_27690":65359,"_5":28029,"_19203":110597,"_26191":110598,"_2648":110599},[],"/docs/pr-preview/pr-40/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3150":65364,"_27690":65359,"_5":28029,"_19203":110601,"_26191":110602,"_2648":110603},[],"/docs/pr-preview/pr-40/es/platform/overview#capacidades-principales","Capacidades principales",{"_3150":65365,"_27690":65359,"_5":28029,"_19203":110605,"_26191":110606,"_2648":110607},[],"/docs/pr-preview/pr-40/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3150":65366,"_27690":65359,"_5":28029,"_19203":110609,"_26191":110610,"_2648":110611},[],"/docs/pr-preview/pr-40/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3150":65367,"_27690":65359,"_5":28029,"_19203":110613,"_26191":110614,"_2648":110615},[],"/docs/pr-preview/pr-40/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3150":65368,"_27690":65359,"_5":28029,"_19203":110617,"_26191":110618,"_2648":110619},[],"/docs/pr-preview/pr-40/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3150":65369,"_27690":65359,"_5":28029,"_19203":110621,"_26191":110622,"_2648":110623},[],"/docs/pr-preview/pr-40/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3150":65370,"_27690":65359,"_5":28029,"_19203":110625,"_26191":110626,"_2648":110627},[],"/docs/pr-preview/pr-40/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3150":65371,"_27690":65359,"_5":28029,"_19203":110629,"_26191":110630,"_2648":110631},[],"/docs/pr-preview/pr-40/es/platform/overview#referencia-operativa","Referencia operativa",{"_3150":65372,"_27690":65359,"_19203":110633,"_5":13195,"_26191":65359,"_2648":110634},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3150":65373,"_27690":65359,"_19203":110636,"_5":13195,"_26191":110591,"_2648":110637},[],"Elige el resultado que necesitas obtener:",{"_3150":65374,"_27690":65359,"_19203":110639,"_5":13195,"_26191":110591,"_2648":110640},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3150":65375,"_27690":65359,"_19203":110642,"_5":13195,"_26191":110591,"_2648":110643},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3150":65376,"_27690":65359,"_19203":110645,"_5":13195,"_26191":110591,"_2648":110646},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3150":65377,"_27690":65359,"_19203":110648,"_5":13195,"_26191":110594,"_2648":110649},[],"Bloque",{"_3150":65378,"_27690":65359,"_19203":110651,"_5":13195,"_26191":110594,"_2648":110652},[],"Qué gestionas",{"_3150":65379,"_27690":65359,"_19203":110654,"_5":13195,"_26191":110594,"_2648":110655},[],"Punto de entrada",{"_3150":65380,"_27690":65359,"_19203":110657,"_5":13195,"_26191":110594,"_2648":49975},[],{"_3150":65381,"_27690":65359,"_19203":110659,"_5":13195,"_26191":110594,"_2648":110660},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3150":65382,"_27690":65359,"_19203":110662,"_5":13195,"_26191":110594,"_2648":110663},[],"Visión general de PKI",{"_3150":65383,"_27690":65359,"_19203":110665,"_5":13195,"_26191":110594,"_2648":49984},[],{"_3150":65384,"_27690":65359,"_19203":110667,"_5":13195,"_26191":110594,"_2648":110668},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3150":65385,"_27690":65359,"_19203":110670,"_5":13195,"_26191":110594,"_2648":110671},[],"Visión general de IoT Fleets",{"_3150":65386,"_27690":65359,"_19203":110673,"_5":13195,"_26191":110594,"_2648":110674},[],"**Administración**",{"_3150":65387,"_27690":65359,"_19203":110676,"_5":13195,"_26191":110594,"_2648":110677},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3150":65388,"_27690":65359,"_19203":110679,"_5":13195,"_26191":110594,"_2648":107164},[],{"_3150":65389,"_27690":65359,"_19203":110681,"_5":13195,"_26191":110594,"_2648":110682},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3150":65390,"_27690":65359,"_19203":110684,"_5":13195,"_26191":110598,"_2648":110685},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3150":65391,"_27690":65359,"_19203":110687,"_5":13195,"_26191":110598,"_2648":110688},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3150":65392,"_27690":65359,"_19203":110690,"_5":13195,"_26191":110598,"_2648":110691},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3150":65393,"_27690":65359,"_19203":110693,"_5":13195,"_26191":110598,"_2648":110694},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3150":65394,"_27690":65359,"_19203":110696,"_5":13195,"_26191":110598,"_2648":110697},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3150":65395,"_27690":65359,"_19203":110699,"_5":13195,"_26191":110598,"_2648":110700},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3150":65396,"_27690":65359,"_19203":110702,"_5":13195,"_26191":110606,"_2648":110703},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3150":65397,"_27690":65359,"_19203":110705,"_5":13195,"_26191":110610,"_2648":110706},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3150":65398,"_27690":65359,"_19203":110708,"_5":13195,"_26191":110614,"_2648":110709},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3150":65399,"_27690":65359,"_19203":110711,"_5":13195,"_26191":110618,"_2648":110712},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3150":65400,"_27690":65359,"_19203":110714,"_5":13195,"_26191":110622,"_2648":110715},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3150":65401,"_27690":65359,"_19203":110717,"_5":13195,"_26191":110626,"_2648":110718},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3150":65402,"_27690":65359,"_19203":110720,"_5":13195,"_26191":110630,"_2648":110174},[],{"_3150":65403,"_27690":65359,"_19203":110722,"_5":13195,"_26191":110630,"_2648":110723},[],"Qué prepara o comprueba",{"_3150":65404,"_27690":65359,"_19203":110725,"_5":13195,"_26191":110630,"_2648":110177},[],{"_3150":65405,"_27690":65359,"_19203":110727,"_5":13195,"_26191":110630,"_2648":110728},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3150":65406,"_27690":65359,"_19203":110730,"_5":13195,"_26191":110630,"_2648":110731},[],"Administrador de la flota",{"_3150":65407,"_27690":65359,"_19203":110733,"_5":13195,"_26191":110630,"_2648":110734},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3150":65408,"_27690":65359,"_19203":110736,"_5":13195,"_26191":110630,"_2648":110189},[],{"_3150":65409,"_27690":65359,"_19203":110738,"_5":13195,"_26191":110630,"_2648":110739},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3150":65410,"_27690":65359,"_19203":110741,"_5":13195,"_26191":110630,"_2648":110195},[],{"_3150":65411,"_27690":65359,"_19203":110743,"_5":13195,"_26191":110630,"_2648":110744},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3150":65412,"_27690":65359,"_19203":110746,"_5":13195,"_26191":110630,"_2648":110747},[],"Operador de infraestructura",{"_3150":65413,"_27690":65359,"_19203":110749,"_5":13195,"_26191":110630,"_2648":110750},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3150":65414,"_27690":65359,"_19203":110752,"_5":13195,"_26191":110630,"_2648":110753},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3150":65415,"_27690":65415,"_5":13521,"_2648":110755,"_28032":110756,"_19203":110758,"_26191":65415},"Jerarquía y rotación de CAs",[45000,107166,50076,110757],"Claves, autoridades y certificados",[],{"_3150":65416,"_27690":65415,"_19203":110760,"_5":13195,"_26191":65415,"_2648":110761},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3150":65417,"_27690":65415,"_5":28029,"_19203":110763,"_26191":110764,"_2648":110765},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3150":65418,"_27690":65415,"_5":28029,"_19203":110767,"_26191":110768,"_2648":110769},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3150":65419,"_27690":65415,"_5":28029,"_19203":110771,"_26191":110772,"_2648":110773},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3150":65420,"_27690":65415,"_5":28029,"_19203":110775,"_26191":110776,"_2648":110777},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3150":65421,"_27690":65415,"_5":28029,"_19203":110779,"_26191":110780,"_2648":110781},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3150":65422,"_27690":65415,"_5":28029,"_19203":110783,"_26191":110784,"_2648":110785},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3150":65423,"_27690":65415,"_5":28029,"_19203":110787,"_26191":110788,"_2648":110789},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3150":65424,"_27690":65415,"_5":28029,"_19203":110791,"_26191":110792,"_2648":110793},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3150":65425,"_27690":65415,"_5":28029,"_19203":110795,"_26191":110796,"_2648":110797},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3150":65426,"_27690":65415,"_5":28029,"_19203":110799,"_26191":110800,"_2648":110801},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3150":65427,"_27690":65415,"_5":28029,"_19203":110803,"_26191":110804,"_2648":110805},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3150":65428,"_27690":65415,"_5":28029,"_19203":110807,"_26191":110808,"_2648":110809},[],"/docs/pr-preview/pr-40/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3150":65429,"_27690":65415,"_19203":110811,"_5":13195,"_26191":65415,"_2648":110812},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3150":65430,"_27690":65415,"_19203":110814,"_5":13195,"_26191":65415,"_2648":110815},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3150":65431,"_27690":65415,"_19203":110817,"_5":13195,"_26191":110764,"_2648":110818},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3150":65432,"_27690":65415,"_19203":110820,"_5":13195,"_26191":110764,"_2648":110821},[],"entorno, como producción y preproducción;",{"_3150":65433,"_27690":65415,"_19203":110823,"_5":13195,"_26191":110764,"_2648":110824},[],"propietario o equipo operador;",{"_3150":65434,"_27690":65415,"_19203":110826,"_5":13195,"_26191":110764,"_2648":110827},[],"familia de dispositivos o proceso de fabricación;",{"_3150":65435,"_27690":65415,"_19203":110829,"_5":13195,"_26191":110764,"_2648":110830},[],"región o requisito regulatorio;",{"_3150":65436,"_27690":65415,"_19203":110832,"_5":13195,"_26191":110764,"_2648":110833},[],"motor criptográfico o política de clave;",{"_3150":65437,"_27690":65415,"_19203":110835,"_5":13195,"_26191":110764,"_2648":110836},[],"ventana de mantenimiento y ritmo de renovación.",{"_3150":65438,"_27690":65415,"_19203":110838,"_5":13195,"_26191":110764,"_2648":110839},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3150":65439,"_27690":65415,"_19203":110841,"_5":13195,"_26191":110764,"_2648":110842},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3150":65440,"_27690":65415,"_19203":110844,"_5":13195,"_26191":110768,"_2648":110845},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3150":65441,"_27690":65415,"_19203":110847,"_5":13195,"_26191":110768,"_2648":110848},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3150":65442,"_27690":65415,"_19203":110850,"_5":13195,"_26191":110768,"_2648":110851},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3150":65443,"_27690":65415,"_19203":110853,"_5":13195,"_26191":110772,"_2648":110854},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3150":65444,"_27690":65415,"_19203":110856,"_5":13195,"_26191":110772,"_2648":110857},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3150":65445,"_27690":65415,"_19203":110859,"_5":13195,"_26191":110772,"_2648":110860},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3150":65446,"_27690":65415,"_19203":110862,"_5":13195,"_26191":110772,"_2648":110863},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3150":65447,"_27690":65415,"_19203":110865,"_5":13195,"_26191":110780,"_2648":110866},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3150":65448,"_27690":65415,"_19203":110868,"_5":13195,"_26191":110784,"_2648":110869},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3150":65449,"_27690":65415,"_19203":110871,"_5":13195,"_26191":110788,"_2648":110872},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3150":65450,"_27690":65415,"_19203":110874,"_5":13195,"_26191":110792,"_2648":110875},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna otra lista, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3150":65451,"_27690":65415,"_19203":110877,"_5":13195,"_26191":110796,"_2648":110878},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3150":65452,"_27690":65415,"_19203":110880,"_5":13195,"_26191":110800,"_2648":110881},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3150":65453,"_27690":65415,"_19203":110883,"_5":13195,"_26191":110804,"_2648":110884},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3150":65454,"_27690":65415,"_19203":110886,"_5":13195,"_26191":110804,"_2648":110887},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3150":65455,"_27690":65415,"_19203":110889,"_5":13195,"_26191":110804,"_2648":110890},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3150":65456,"_27690":65415,"_19203":110892,"_5":13195,"_26191":110804,"_2648":110893},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3150":65457,"_27690":65415,"_19203":110895,"_5":13195,"_26191":110808,"_2648":110896},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3150":65458,"_27690":65415,"_19203":110898,"_5":13195,"_26191":110808,"_2648":110899},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3150":65459,"_27690":65415,"_19203":110901,"_5":13195,"_26191":110808,"_2648":110902},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3150":65460,"_27690":65415,"_19203":110904,"_5":13195,"_26191":110808,"_2648":110905},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3150":65461,"_27690":65415,"_19203":110907,"_5":13195,"_26191":110808,"_2648":110908},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3150":65462,"_27690":65415,"_19203":110910,"_5":13195,"_26191":110808,"_2648":110911},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3150":65463,"_27690":65415,"_19203":110913,"_5":13195,"_26191":110808,"_2648":110914},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3150":65464,"_27690":65464,"_5":13521,"_2648":110916,"_28032":110917,"_19203":110918,"_26191":65464},"Autoridades de certificación",[45000,107166,50076,110757],[],{"_3150":65465,"_27690":65464,"_19203":110920,"_5":13195,"_26191":65464,"_2648":110921},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3150":65466,"_27690":65464,"_5":28029,"_19203":110923,"_26191":110924,"_2648":110925},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3150":65467,"_27690":65464,"_5":28029,"_19203":110927,"_26191":110928,"_2648":110929},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3150":65468,"_27690":65464,"_5":28029,"_19203":110931,"_26191":110932,"_2648":105832},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3150":65469,"_27690":65464,"_5":28029,"_19203":110934,"_26191":110935,"_2648":110936},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3150":65470,"_27690":65464,"_5":28029,"_19203":110938,"_26191":110939,"_2648":110940},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3150":65471,"_27690":65464,"_5":28029,"_19203":110942,"_26191":110943,"_2648":110944},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3150":65472,"_27690":65464,"_5":28029,"_19203":110946,"_26191":110947,"_2648":110948},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3150":65473,"_27690":65464,"_5":28029,"_19203":110950,"_26191":110951,"_2648":110952},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3150":65474,"_27690":65464,"_5":28029,"_19203":110954,"_26191":110955,"_2648":110956},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3150":65475,"_27690":65464,"_5":28029,"_19203":110958,"_26191":110959,"_2648":110960},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3150":65476,"_27690":65464,"_5":28029,"_19203":110962,"_26191":110963,"_2648":110964},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3150":65477,"_27690":65464,"_5":28029,"_19203":110966,"_26191":110967,"_2648":110968},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3150":65478,"_27690":65464,"_5":28029,"_19203":110970,"_26191":110971,"_2648":110972},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3150":65479,"_27690":65464,"_5":28029,"_19203":110974,"_26191":110975,"_2648":110976},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3150":65480,"_27690":65464,"_5":28029,"_19203":110978,"_26191":110979,"_2648":110980},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3150":65481,"_27690":65464,"_5":28029,"_19203":110982,"_26191":110983,"_2648":110984},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3150":65482,"_27690":65464,"_5":28029,"_19203":110986,"_26191":110987,"_2648":110988},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3150":65483,"_27690":65464,"_5":28029,"_19203":110990,"_26191":110991,"_2648":110992},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3150":65484,"_27690":65464,"_5":28029,"_19203":110994,"_26191":110995,"_2648":110996},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3150":65485,"_27690":65464,"_5":28029,"_19203":110998,"_26191":110999,"_2648":111000},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3150":65486,"_27690":65464,"_5":28029,"_19203":111002,"_26191":111003,"_2648":111004},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3150":65487,"_27690":65464,"_5":28029,"_19203":111006,"_26191":111007,"_2648":111008},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3150":65488,"_27690":65464,"_19203":111010,"_5":13195,"_26191":65464,"_2648":111011},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3150":65489,"_27690":65464,"_19203":111013,"_5":13195,"_26191":65464,"_2648":111014},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3150":65490,"_27690":65464,"_19203":111016,"_5":13195,"_26191":65464,"_2648":111017},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3150":65491,"_27690":65464,"_19203":111019,"_5":13195,"_26191":110924,"_2648":111020},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3150":65492,"_27690":65464,"_19203":111022,"_5":13195,"_26191":110924,"_2648":111023},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3150":65493,"_27690":65464,"_19203":111025,"_5":13195,"_26191":110924,"_2648":111026},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3150":65494,"_27690":65464,"_19203":111028,"_5":13195,"_26191":110924,"_2648":111029},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3150":65495,"_27690":65464,"_19203":111031,"_5":13195,"_26191":110924,"_2648":111032},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3150":65496,"_27690":65464,"_19203":111034,"_5":13195,"_26191":110932,"_2648":111035},[],"Decide si la CA será raíz o intermedia.",{"_3150":65497,"_27690":65464,"_19203":111037,"_5":13195,"_26191":110932,"_2648":111038},[],"Elige el motor que custodiará la clave.",{"_3150":65498,"_27690":65464,"_19203":111040,"_5":13195,"_26191":110932,"_2648":111041},[],"Define una validez superior a la de los certificados que emitirá.",{"_3150":65499,"_27690":65464,"_19203":111043,"_5":13195,"_26191":110932,"_2648":111044},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3150":65500,"_27690":65464,"_19203":111046,"_5":13195,"_26191":110935,"_2648":111047},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3150":65501,"_27690":65464,"_19203":111049,"_5":13195,"_26191":110939,"_2648":111050},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3150":65502,"_27690":65464,"_19203":111052,"_5":13195,"_26191":110939,"_2648":111053},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3150":65503,"_27690":65464,"_19203":111055,"_5":13195,"_26191":110943,"_2648":111056},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3150":65504,"_27690":65464,"_19203":111058,"_5":13195,"_26191":110947,"_2648":111059},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3150":65505,"_27690":65464,"_19203":111061,"_5":13195,"_26191":110947,"_2648":111062},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3150":65506,"_27690":65464,"_19203":111064,"_5":13195,"_26191":110947,"_2648":111065},[],"`ST`: estado o provincia.",{"_3150":65507,"_27690":65464,"_19203":111067,"_5":13195,"_26191":110947,"_2648":111068},[],"`L`: localidad.",{"_3150":65508,"_27690":65464,"_19203":111070,"_5":13195,"_26191":110947,"_2648":111071},[],"`O`: organización.",{"_3150":65509,"_27690":65464,"_19203":111073,"_5":13195,"_26191":110947,"_2648":111074},[],"`OU`: unidad organizativa.",{"_3150":65510,"_27690":65464,"_19203":111076,"_5":13195,"_26191":110947,"_2648":111077},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3150":65511,"_27690":65464,"_19203":111079,"_5":13195,"_26191":110951,"_2648":111080},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3150":65512,"_27690":65464,"_19203":111082,"_5":13195,"_26191":110951,"_2648":111083},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3150":65513,"_27690":65464,"_19203":111085,"_5":13195,"_26191":110955,"_2648":111086},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3150":65514,"_27690":65464,"_19203":111088,"_5":13195,"_26191":110955,"_2648":111089},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3150":65515,"_27690":65464,"_19203":111091,"_5":13195,"_26191":110959,"_2648":111092},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3150":65516,"_27690":65464,"_19203":111094,"_5":13195,"_26191":110959,"_2648":111095},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3150":65517,"_27690":65464,"_19203":111097,"_5":13195,"_26191":110963,"_2648":111098},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3150":65518,"_27690":65464,"_19203":111100,"_5":13195,"_26191":110967,"_2648":111101},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3150":65519,"_27690":65464,"_19203":111103,"_5":13195,"_26191":110971,"_2648":111104},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3150":65520,"_27690":65464,"_19203":111106,"_5":13195,"_26191":110975,"_2648":111107},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3150":65521,"_27690":65464,"_19203":111109,"_5":13195,"_26191":110979,"_2648":111110},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3150":65522,"_27690":65464,"_19203":111112,"_5":13195,"_26191":110979,"_2648":111113},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3150":65523,"_27690":65464,"_19203":111115,"_5":13195,"_26191":110983,"_2648":111116},[],"Abre una CA desde el inventario para consultar:",{"_3150":65524,"_27690":65464,"_19203":111118,"_5":13195,"_26191":110983,"_2648":111119},[],"Estado y periodo de validez.",{"_3150":65525,"_27690":65464,"_19203":111121,"_5":13195,"_26191":110983,"_2648":111122},[],"Certificado y cadena en formato PEM.",{"_3150":65526,"_27690":65464,"_19203":111124,"_5":13195,"_26191":110983,"_2648":111125},[],"Número de certificados activos, expirados y revocados.",{"_3150":65527,"_27690":65464,"_19203":111127,"_5":13195,"_26191":110983,"_2648":111128},[],"Certificados emitidos en **Issued Certificates**.",{"_3150":65528,"_27690":65464,"_19203":111130,"_5":13195,"_26191":110983,"_2648":111131},[],"CRL vinculada a la autoridad.",{"_3150":65529,"_27690":65464,"_19203":111133,"_5":13195,"_26191":110983,"_2648":111134},[],"Metadatos y motor criptográfico asociado.",{"_3150":65530,"_27690":65464,"_19203":111136,"_5":13195,"_26191":110983,"_2648":111137},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3150":65531,"_27690":65464,"_19203":111139,"_5":13195,"_26191":110987,"_2648":111140},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3150":65532,"_27690":65464,"_19203":111142,"_5":13195,"_26191":110987,"_2648":111143},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3150":65533,"_27690":65464,"_19203":111145,"_5":13195,"_26191":110987,"_2648":111146},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3150":65534,"_27690":65464,"_19203":111148,"_5":13195,"_26191":110987,"_2648":111149},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3150":65535,"_27690":65464,"_19203":111151,"_5":13195,"_26191":110991,"_2648":111152},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3150":65536,"_27690":65464,"_19203":111154,"_5":13195,"_26191":110995,"_2648":111155},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3150":65537,"_27690":65464,"_19203":111157,"_5":13195,"_26191":110999,"_2648":111158},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3150":65538,"_27690":65464,"_19203":111160,"_5":13195,"_26191":111003,"_2648":111161},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3150":65539,"_27690":65464,"_19203":111163,"_5":13195,"_26191":111007,"_2648":111164},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3150":65540,"_27690":65464,"_19203":111166,"_5":13195,"_26191":111007,"_2648":111167},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3150":65541,"_27690":65541,"_5":13521,"_2648":111169,"_28032":111170,"_19203":111171,"_26191":65541},"Perfiles de certificado",[45000,107166,50076,110757],[],{"_3150":65542,"_27690":65541,"_19203":111173,"_5":13195,"_26191":65541,"_2648":111174},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3150":65543,"_27690":65541,"_5":28029,"_19203":111176,"_26191":111177,"_2648":111178},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3150":65544,"_27690":65541,"_5":28029,"_19203":111180,"_26191":111181,"_2648":111182},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#validez","Validez",{"_3150":65545,"_27690":65541,"_5":28029,"_19203":111184,"_26191":111185,"_2648":111186},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3150":65546,"_27690":65541,"_5":28029,"_19203":111188,"_26191":111189,"_2648":111190},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3150":65547,"_27690":65541,"_5":28029,"_19203":111192,"_26191":111193,"_2648":111194},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3150":65548,"_27690":65541,"_5":28029,"_19203":111196,"_26191":111197,"_2648":111198},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3150":65549,"_27690":65541,"_5":28029,"_19203":111200,"_26191":111201,"_2648":111202},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3150":65550,"_27690":65541,"_5":28029,"_19203":111204,"_26191":111205,"_2648":111206},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3150":65551,"_27690":65541,"_5":28029,"_19203":111208,"_26191":111209,"_2648":111210},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3150":65552,"_27690":65541,"_5":28029,"_19203":111212,"_26191":111213,"_2648":111214},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3150":65553,"_27690":65541,"_5":28029,"_19203":111216,"_26191":111217,"_2648":111218},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3150":65554,"_27690":65541,"_5":28029,"_19203":111220,"_26191":111221,"_2648":111222},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3150":65555,"_27690":65541,"_5":28029,"_19203":111224,"_26191":111225,"_2648":111226},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3150":65556,"_27690":65541,"_5":28029,"_19203":111228,"_26191":111229,"_2648":111230},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3150":65557,"_27690":65541,"_5":28029,"_19203":111232,"_26191":111233,"_2648":111234},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3150":65558,"_27690":65541,"_5":28029,"_19203":111236,"_26191":111237,"_2648":111238},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3150":65559,"_27690":65541,"_19203":111240,"_5":13195,"_26191":65541,"_2648":111241},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3150":65560,"_27690":65541,"_19203":111243,"_5":13195,"_26191":65541,"_2648":111244},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3150":65561,"_27690":65541,"_19203":111246,"_5":13195,"_26191":111181,"_2648":111247},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3150":65562,"_27690":65541,"_19203":111249,"_5":13195,"_26191":111181,"_2648":111250},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3150":65563,"_27690":65541,"_19203":111252,"_5":13195,"_26191":111185,"_2648":111253},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3150":65564,"_27690":65541,"_19203":111255,"_5":13195,"_26191":111189,"_2648":111256},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3150":65565,"_27690":65541,"_19203":111258,"_5":13195,"_26191":111189,"_2648":111259},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3150":65566,"_27690":65541,"_19203":111261,"_5":13195,"_26191":111189,"_2648":111262},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3150":65567,"_27690":65541,"_19203":111264,"_5":13195,"_26191":111193,"_2648":111265},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3150":65568,"_27690":65541,"_19203":111267,"_5":13195,"_26191":111197,"_2648":111268},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3150":65569,"_27690":65541,"_19203":111270,"_5":13195,"_26191":111197,"_2648":111271},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3150":65570,"_27690":65541,"_19203":111273,"_5":13195,"_26191":111201,"_2648":111274},[],"La aplicación criptográfica puede:",{"_3150":65571,"_27690":65541,"_19203":111276,"_5":13195,"_26191":111201,"_2648":111277},[],"permitir o bloquear claves RSA;",{"_3150":65572,"_27690":65541,"_19203":111279,"_5":13195,"_26191":111201,"_2648":111280},[],"limitar los tamaños RSA admitidos;",{"_3150":65573,"_27690":65541,"_19203":111282,"_5":13195,"_26191":111201,"_2648":111283},[],"permitir o bloquear claves ECDSA;",{"_3150":65574,"_27690":65541,"_19203":111285,"_5":13195,"_26191":111201,"_2648":111286},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3150":65575,"_27690":65541,"_19203":111288,"_5":13195,"_26191":111201,"_2648":111289},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3150":65576,"_27690":65541,"_19203":111291,"_5":13195,"_26191":111205,"_2648":111292},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3150":65577,"_27690":65541,"_19203":111294,"_5":13195,"_26191":111205,"_2648":106957},[],{"_3150":65578,"_27690":65541,"_19203":111296,"_5":13195,"_26191":111205,"_2648":111297},[],"Primera opción",{"_3150":65579,"_27690":65541,"_19203":111299,"_5":13195,"_26191":111205,"_2648":111300},[],"Segunda opción",{"_3150":65580,"_27690":65541,"_19203":111302,"_5":13195,"_26191":111205,"_2648":111303},[],"Si no hay ninguna",{"_3150":65581,"_27690":65541,"_19203":111305,"_5":13195,"_26191":111205,"_2648":111306},[],"Firma directa con una CA",{"_3150":65582,"_27690":65541,"_19203":111308,"_5":13195,"_26191":111205,"_2648":111309},[],"`issuance_profile` incluido en la solicitud",{"_3150":65583,"_27690":65541,"_19203":111311,"_5":13195,"_26191":111205,"_2648":111312},[],"`issuance_profile_id` de la solicitud",{"_3150":65584,"_27690":65541,"_19203":111314,"_5":13195,"_26191":111205,"_2648":111315},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3150":65585,"_27690":65541,"_19203":111317,"_5":13195,"_26191":111205,"_2648":111318},[],"Emisión mediante DMS",{"_3150":65586,"_27690":65541,"_19203":111320,"_5":13195,"_26191":111205,"_2648":50641},[],{"_3150":65587,"_27690":65541,"_19203":111322,"_5":13195,"_26191":111205,"_2648":111323},[],"`settings.issuance_profile` incluido en el DMS",{"_3150":65588,"_27690":65541,"_19203":111325,"_5":13195,"_26191":111205,"_2648":111326},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3150":65589,"_27690":65541,"_19203":111328,"_5":13195,"_26191":111205,"_2648":111329},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3150":65590,"_27690":65541,"_19203":111331,"_5":13195,"_26191":111205,"_2648":111332},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3150":65591,"_27690":65541,"_19203":111334,"_5":13195,"_26191":111213,"_2648":111335},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3150":65592,"_27690":65541,"_19203":111337,"_5":13195,"_26191":111217,"_2648":111338},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3150":65593,"_27690":65541,"_19203":111340,"_5":13195,"_26191":111221,"_2648":111341},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3150":65594,"_27690":65541,"_19203":111343,"_5":13195,"_26191":111225,"_2648":111344},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3150":65595,"_27690":65541,"_19203":111346,"_5":13195,"_26191":111229,"_2648":111347},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3150":65596,"_27690":65541,"_19203":111349,"_5":13195,"_26191":111229,"_2648":111350},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3150":65597,"_27690":65541,"_19203":111352,"_5":13195,"_26191":111233,"_2648":111353},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3150":65598,"_27690":65541,"_19203":111355,"_5":13195,"_26191":111233,"_2648":111356},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3150":65599,"_27690":65541,"_19203":111358,"_5":13195,"_26191":111233,"_2648":111359},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3150":65600,"_27690":65541,"_19203":111361,"_5":13195,"_26191":111233,"_2648":111362},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3150":65601,"_27690":65541,"_19203":111364,"_5":13195,"_26191":111237,"_2648":111365},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3150":65602,"_27690":65541,"_19203":111367,"_5":13195,"_26191":111237,"_2648":111368},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3150":65603,"_27690":65603,"_5":13521,"_2648":111370,"_28032":111371,"_19203":111373,"_26191":65603},"Validación de certificados",[45000,107166,50076,111372],"Validación",[],{"_3150":65604,"_27690":65603,"_19203":111375,"_5":13195,"_26191":65603,"_2648":111376},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3150":65605,"_27690":65603,"_5":28029,"_19203":111378,"_26191":111379,"_2648":111380},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3150":65606,"_27690":65603,"_5":28029,"_19203":111382,"_26191":111383,"_2648":111384},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3150":65607,"_27690":65603,"_5":28029,"_19203":111386,"_26191":111387,"_2648":111388},[],"/docs/pr-preview/pr-40/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3150":65608,"_27690":65603,"_19203":111390,"_5":13195,"_26191":65603,"_2648":111391},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3150":65609,"_27690":65603,"_19203":111393,"_5":13195,"_26191":111379,"_2648":111394},[],"Verifica estos criterios juntos:",{"_3150":65610,"_27690":65603,"_19203":111396,"_5":13195,"_26191":111379,"_2648":110384},[],{"_3150":65611,"_27690":65603,"_19203":111398,"_5":13195,"_26191":111379,"_2648":111399},[],"Resultado necesario",{"_3150":65612,"_27690":65603,"_19203":111401,"_5":13195,"_26191":111379,"_2648":111402},[],"Cadena y firma",{"_3150":65613,"_27690":65603,"_19203":111404,"_5":13195,"_26191":111379,"_2648":111405},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3150":65614,"_27690":65603,"_19203":111407,"_5":13195,"_26191":111379,"_2648":111408},[],"Fechas",{"_3150":65615,"_27690":65603,"_19203":111410,"_5":13195,"_26191":111379,"_2648":111411},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3150":65616,"_27690":65603,"_19203":111413,"_5":13195,"_26191":111379,"_2648":106867},[],{"_3150":65617,"_27690":65603,"_19203":111415,"_5":13195,"_26191":111379,"_2648":111416},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3150":65618,"_27690":65603,"_19203":111418,"_5":13195,"_26191":111379,"_2648":111419},[],"Uso",{"_3150":65619,"_27690":65603,"_19203":111421,"_5":13195,"_26191":111379,"_2648":111422},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3150":65620,"_27690":65603,"_19203":111424,"_5":13195,"_26191":111379,"_2648":111425},[],"Revocación",{"_3150":65621,"_27690":65603,"_19203":111427,"_5":13195,"_26191":111379,"_2648":111428},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3150":65622,"_27690":65603,"_19203":111430,"_5":13195,"_26191":111379,"_2648":111431},[],"Autorización",{"_3150":65623,"_27690":65603,"_19203":111433,"_5":13195,"_26191":111379,"_2648":111434},[],"La aplicación permite la acción a esa identidad.",{"_3150":65624,"_27690":65603,"_19203":111436,"_5":13195,"_26191":111379,"_2648":111437},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3150":65625,"_27690":65603,"_19203":111439,"_5":13195,"_26191":111383,"_2648":111440},[],"Mecanismo",{"_3150":65626,"_27690":65603,"_19203":111442,"_5":13195,"_26191":111383,"_2648":111443},[],"Cuándo utilizarlo",{"_3150":65627,"_27690":65603,"_19203":111445,"_5":13195,"_26191":111383,"_2648":111446},[],"Qué debes mantener",{"_3150":65628,"_27690":65603,"_19203":111448,"_5":13195,"_26191":111383,"_2648":50769},[],{"_3150":65629,"_27690":65603,"_19203":111450,"_5":13195,"_26191":111383,"_2648":111451},[],"Consulta del estado de un certificado concreto.",{"_3150":65630,"_27690":65603,"_19203":111453,"_5":13195,"_26191":111383,"_2648":111454},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3150":65631,"_27690":65603,"_19203":111456,"_5":13195,"_26191":111383,"_2648":50778},[],{"_3150":65632,"_27690":65603,"_19203":111458,"_5":13195,"_26191":111383,"_2648":111459},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3150":65633,"_27690":65603,"_19203":111461,"_5":13195,"_26191":111383,"_2648":111462},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3150":65634,"_27690":65603,"_19203":111464,"_5":13195,"_26191":111383,"_2648":111465},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3150":65635,"_27690":65603,"_19203":111467,"_5":13195,"_26191":111383,"_2648":111468},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3150":65636,"_27690":65603,"_19203":111470,"_5":13195,"_26191":111387,"_2648":111471},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3150":65637,"_27690":65603,"_19203":111473,"_5":13195,"_26191":111387,"_2648":111474},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3150":65638,"_27690":65603,"_19203":111476,"_5":13195,"_26191":111387,"_2648":111477},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3150":65639,"_27690":65603,"_19203":111479,"_5":13195,"_26191":111387,"_2648":111480},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3150":65640,"_27690":65603,"_19203":111482,"_5":13195,"_26191":111387,"_2648":111483},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3150":65641,"_27690":65603,"_19203":111485,"_5":13195,"_26191":111387,"_2648":111486},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3150":65642,"_27690":65603,"_19203":111488,"_5":13195,"_26191":111387,"_2648":111489},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3150":65643,"_27690":65603,"_19203":111491,"_5":13195,"_26191":111387,"_2648":111492},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":65644,"_27690":65603,"_19203":111494,"_5":13195,"_26191":111387,"_2648":111495},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3150":65645,"_27690":65645,"_5":13521,"_2648":111497,"_28032":111498,"_19203":111499,"_26191":65645},"Certificados",[45000,107166,50076,110757],[],{"_3150":65646,"_27690":65645,"_19203":111501,"_5":13195,"_26191":65645,"_2648":111502},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3150":65647,"_27690":65645,"_5":28029,"_19203":111504,"_26191":111505,"_2648":111506},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3150":65648,"_27690":65645,"_5":28029,"_19203":111508,"_26191":111509,"_2648":111510},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3150":65649,"_27690":65645,"_5":28029,"_19203":111512,"_26191":111513,"_2648":111514},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3150":65650,"_27690":65645,"_5":28029,"_19203":111516,"_26191":111517,"_2648":111518},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3150":65651,"_27690":65645,"_5":28029,"_19203":111520,"_26191":111521,"_2648":111522},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3150":65652,"_27690":65645,"_5":28029,"_19203":111524,"_26191":111525,"_2648":111526},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3150":65653,"_27690":65645,"_5":28029,"_19203":111528,"_26191":111529,"_2648":111530},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3150":65654,"_27690":65645,"_5":28029,"_19203":111532,"_26191":111533,"_2648":111534},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3150":65655,"_27690":65645,"_5":28029,"_19203":111536,"_26191":111537,"_2648":111538},[],"/docs/pr-preview/pr-40/es/platform/pki/certificates#continúa","Continúa",{"_3150":65656,"_27690":65645,"_19203":111540,"_5":13195,"_26191":65645,"_2648":111541},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3150":65657,"_27690":65645,"_19203":111543,"_5":13195,"_26191":111505,"_2648":111544},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3150":65658,"_27690":65645,"_19203":111546,"_5":13195,"_26191":111505,"_2648":111547},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3150":65659,"_27690":65645,"_19203":111549,"_5":13195,"_26191":111509,"_2648":111550},[],"Descarga el PEM e inspecciónalo:",{"_3150":65660,"_27690":65645,"_19203":111552,"_5":13195,"_26191":111509,"_2648":111553},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3150":65661,"_27690":65645,"_19203":111555,"_5":13195,"_26191":111513,"_2648":111556},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3150":65662,"_27690":65645,"_19203":111558,"_5":13195,"_26191":111513,"_2648":111559},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3150":65663,"_27690":65645,"_19203":111561,"_5":13195,"_26191":111513,"_2648":111562},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3150":65664,"_27690":65645,"_19203":111564,"_5":13195,"_26191":111513,"_2648":111565},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3150":65665,"_27690":65645,"_19203":111567,"_5":13195,"_26191":111513,"_2648":111568},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3150":65666,"_27690":65645,"_19203":111570,"_5":13195,"_26191":111513,"_2648":111571},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3150":65667,"_27690":65645,"_19203":111573,"_5":13195,"_26191":111513,"_2648":111574},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3150":65668,"_27690":65645,"_19203":111576,"_5":13195,"_26191":111517,"_2648":111577},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3150":65669,"_27690":65645,"_19203":111579,"_5":13195,"_26191":111521,"_2648":111580},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3150":65670,"_27690":65645,"_19203":111582,"_5":13195,"_26191":111525,"_2648":111583},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3150":65671,"_27690":65645,"_19203":111585,"_5":13195,"_26191":111529,"_2648":111586},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3150":65672,"_27690":65645,"_19203":111588,"_5":13195,"_26191":111529,"_2648":111589},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3150":65673,"_27690":65645,"_19203":111591,"_5":13195,"_26191":111529,"_2648":111592},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3150":65674,"_27690":65645,"_19203":111594,"_5":13195,"_26191":111533,"_2648":111595},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3150":65675,"_27690":65645,"_19203":111597,"_5":13195,"_26191":111533,"_2648":111598},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3150":65676,"_27690":65645,"_19203":111600,"_5":13195,"_26191":111533,"_2648":111601},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3150":65677,"_27690":65645,"_19203":111603,"_5":13195,"_26191":111537,"_2648":111604},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":65678,"_27690":65645,"_19203":111606,"_5":13195,"_26191":111537,"_2648":111607},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3150":65679,"_27690":65679,"_5":13521,"_2648":111609,"_28032":111610,"_19203":111612,"_26191":65679},"Ciclo de vida de un certificado",[45000,107166,50076,111611],"Conceptos",[],{"_3150":65680,"_27690":65679,"_19203":111614,"_5":13195,"_26191":65679,"_2648":111615},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3150":65681,"_27690":65679,"_5":28029,"_19203":111617,"_26191":111618,"_2648":111619},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3150":65682,"_27690":65679,"_5":28029,"_19203":111621,"_26191":111622,"_2648":111623},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3150":65683,"_27690":65679,"_5":28029,"_19203":111625,"_26191":111626,"_2648":111627},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3150":65684,"_27690":65679,"_5":28029,"_19203":111629,"_26191":111630,"_2648":111631},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3150":65685,"_27690":65679,"_5":28029,"_19203":111633,"_26191":111634,"_2648":111635},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3150":65686,"_27690":65679,"_5":28029,"_19203":111637,"_26191":111638,"_2648":111639},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3150":65687,"_27690":65679,"_5":28029,"_19203":111641,"_26191":111642,"_2648":111643},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3150":65688,"_27690":65679,"_5":28029,"_19203":111645,"_26191":111646,"_2648":111647},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3150":65689,"_27690":65679,"_5":28029,"_19203":111649,"_26191":111650,"_2648":111651},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3150":65690,"_27690":65679,"_5":28029,"_19203":111653,"_26191":111654,"_2648":111655},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3150":65691,"_27690":65679,"_19203":111657,"_5":13195,"_26191":65679,"_2648":111658},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3150":65692,"_27690":65679,"_19203":111660,"_5":13195,"_26191":111622,"_2648":111661},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3150":65693,"_27690":65679,"_19203":111663,"_5":13195,"_26191":111626,"_2648":111664},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3150":65694,"_27690":65679,"_19203":111666,"_5":13195,"_26191":111630,"_2648":111667},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3150":65695,"_27690":65679,"_19203":111669,"_5":13195,"_26191":111634,"_2648":111670},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3150":65696,"_27690":65679,"_19203":111672,"_5":13195,"_26191":111638,"_2648":111673},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3150":65697,"_27690":65679,"_19203":111675,"_5":13195,"_26191":111642,"_2648":111676},[],"Lamassu persiste cuatro estados X.509:",{"_3150":65698,"_27690":65679,"_19203":111678,"_5":13195,"_26191":111642,"_2648":111679},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3150":65699,"_27690":65679,"_19203":111681,"_5":13195,"_26191":111642,"_2648":111682},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3150":65700,"_27690":65679,"_19203":111684,"_5":13195,"_26191":111642,"_2648":111685},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3150":65701,"_27690":65679,"_19203":111687,"_5":13195,"_26191":111642,"_2648":111688},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3150":65702,"_27690":65679,"_19203":111690,"_5":13195,"_26191":111642,"_2648":111691},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3150":65703,"_27690":65679,"_19203":111693,"_5":13195,"_26191":111646,"_2648":111694},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3150":65704,"_27690":65679,"_19203":111696,"_5":13195,"_26191":111646,"_2648":111697},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3150":65705,"_27690":65679,"_19203":111699,"_5":13195,"_26191":111646,"_2648":111700},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3150":65706,"_27690":65679,"_19203":111702,"_5":13195,"_26191":111650,"_2648":111703},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3150":65707,"_27690":65679,"_19203":111705,"_5":13195,"_26191":111650,"_2648":111706},[],"Antes de confirmar:",{"_3150":65708,"_27690":65679,"_19203":111708,"_5":13195,"_26191":111650,"_2648":111709},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3150":65709,"_27690":65679,"_19203":111711,"_5":13195,"_26191":111650,"_2648":111712},[],"Distribuye la nueva cadena de confianza.",{"_3150":65710,"_27690":65679,"_19203":111714,"_5":13195,"_26191":111650,"_2648":111715},[],"Reemite las identidades necesarias.",{"_3150":65711,"_27690":65679,"_19203":111717,"_5":13195,"_26191":111650,"_2648":111718},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3150":65712,"_27690":65679,"_19203":111720,"_5":13195,"_26191":111650,"_2648":111721},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3150":65713,"_27690":65679,"_19203":111723,"_5":13195,"_26191":111650,"_2648":111724},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3150":65714,"_27690":65679,"_19203":111726,"_5":13195,"_26191":111654,"_2648":111727},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3150":65715,"_27690":65679,"_19203":111729,"_5":13195,"_26191":111654,"_2648":111730},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3150":65716,"_27690":65679,"_19203":111732,"_5":13195,"_26191":111654,"_2648":111733},[],"Cambios de estado y razones de revocación.",{"_3150":65717,"_27690":65679,"_19203":111735,"_5":13195,"_26191":111654,"_2648":111736},[],"Publicación y vigencia de OCSP y CRLs.",{"_3150":65718,"_27690":65679,"_19203":111738,"_5":13195,"_26191":111654,"_2648":111739},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3150":65719,"_27690":65679,"_19203":111741,"_5":13195,"_26191":111654,"_2648":111742},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3150":65720,"_27690":65720,"_5":13521,"_2648":111744,"_28032":111745,"_19203":111746,"_26191":65720},"Modelo de confianza",[45000,107166,50076,111611],[],{"_3150":65721,"_27690":65720,"_19203":111748,"_5":13195,"_26191":65720,"_2648":111749},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3150":65722,"_27690":65720,"_5":28029,"_19203":111751,"_26191":111752,"_2648":111753},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3150":65723,"_27690":65720,"_5":28029,"_19203":111755,"_26191":111756,"_2648":111757},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3150":65724,"_27690":65720,"_5":28029,"_19203":111759,"_26191":111760,"_2648":111761},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3150":65725,"_27690":65720,"_5":28029,"_19203":111763,"_26191":111764,"_2648":111765},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3150":65726,"_27690":65720,"_5":28029,"_19203":111767,"_26191":111768,"_2648":111769},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3150":65727,"_27690":65720,"_5":28029,"_19203":111771,"_26191":111772,"_2648":111773},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3150":65728,"_27690":65720,"_5":28029,"_19203":111775,"_26191":111776,"_2648":111777},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3150":65729,"_27690":65720,"_5":28029,"_19203":111779,"_26191":111780,"_2648":111781},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3150":65730,"_27690":65720,"_5":28029,"_19203":111783,"_26191":111784,"_2648":111785},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3150":65731,"_27690":65720,"_5":28029,"_19203":111787,"_26191":111788,"_2648":111789},[],"/docs/pr-preview/pr-40/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3150":65732,"_27690":65720,"_19203":111791,"_5":13195,"_26191":65720,"_2648":111792},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3150":65733,"_27690":65720,"_19203":111794,"_5":13195,"_26191":111756,"_2648":111795},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3150":65734,"_27690":65720,"_19203":111797,"_5":13195,"_26191":111760,"_2648":111798},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3150":65735,"_27690":65720,"_19203":111800,"_5":13195,"_26191":111764,"_2648":111801},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3150":65736,"_27690":65720,"_19203":111803,"_5":13195,"_26191":111768,"_2648":111804},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3150":65737,"_27690":65720,"_19203":111806,"_5":13195,"_26191":111772,"_2648":111807},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3150":65738,"_27690":65720,"_19203":111809,"_5":13195,"_26191":111772,"_2648":111810},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3150":65739,"_27690":65720,"_19203":111812,"_5":13195,"_26191":111772,"_2648":111813},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3150":65740,"_27690":65720,"_19203":111815,"_5":13195,"_26191":111772,"_2648":111816},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3150":65741,"_27690":65720,"_19203":111818,"_5":13195,"_26191":111772,"_2648":111819},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3150":65742,"_27690":65720,"_19203":111821,"_5":13195,"_26191":111772,"_2648":111822},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3150":65743,"_27690":65720,"_19203":111824,"_5":13195,"_26191":111776,"_2648":111825},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3150":65744,"_27690":65720,"_19203":111827,"_5":13195,"_26191":111776,"_2648":111828},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3150":65745,"_27690":65720,"_19203":111830,"_5":13195,"_26191":111776,"_2648":111831},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3150":65746,"_27690":65720,"_19203":111833,"_5":13195,"_26191":111776,"_2648":111834},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3150":65747,"_27690":65720,"_19203":111836,"_5":13195,"_26191":111776,"_2648":111837},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3150":65748,"_27690":65720,"_19203":111839,"_5":13195,"_26191":111780,"_2648":111840},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3150":65749,"_27690":65720,"_19203":111842,"_5":13195,"_26191":111780,"_2648":111843},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3150":65750,"_27690":65720,"_19203":111845,"_5":13195,"_26191":111780,"_2648":111846},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3150":65751,"_27690":65720,"_19203":111848,"_5":13195,"_26191":111780,"_2648":111849},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3150":65752,"_27690":65720,"_19203":111851,"_5":13195,"_26191":111780,"_2648":111852},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3150":65753,"_27690":65720,"_19203":111854,"_5":13195,"_26191":111780,"_2648":111855},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3150":65754,"_27690":65720,"_19203":111857,"_5":13195,"_26191":111780,"_2648":111858},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3150":65755,"_27690":65720,"_19203":111860,"_5":13195,"_26191":111784,"_2648":111861},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3150":65756,"_27690":65720,"_19203":111863,"_5":13195,"_26191":111788,"_2648":111864},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3150":65757,"_27690":65720,"_19203":111866,"_5":13195,"_26191":111788,"_2648":111867},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3150":65758,"_27690":65720,"_19203":111869,"_5":13195,"_26191":111788,"_2648":111870},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3150":65759,"_27690":65720,"_19203":111872,"_5":13195,"_26191":111788,"_2648":111873},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3150":65760,"_27690":65720,"_19203":111875,"_5":13195,"_26191":111788,"_2648":111876},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3150":65761,"_27690":65720,"_19203":111878,"_5":13195,"_26191":111788,"_2648":111879},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3150":65762,"_27690":65720,"_19203":111881,"_5":13195,"_26191":111788,"_2648":111882},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3150":65763,"_27690":65763,"_5":13521,"_2648":111884,"_28032":111885,"_19203":111886,"_26191":65763},"Listas de revocación (CRL)",[45000,107166,50076,111372],[],{"_3150":65764,"_27690":65763,"_19203":111888,"_5":13195,"_26191":65763,"_2648":111889},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3150":65765,"_27690":65763,"_5":28029,"_19203":111891,"_26191":111892,"_2648":111893},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3150":65766,"_27690":65763,"_5":28029,"_19203":111895,"_26191":111896,"_2648":111897},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3150":65767,"_27690":65763,"_5":28029,"_19203":111899,"_26191":111900,"_2648":111901},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3150":65768,"_27690":65763,"_5":28029,"_19203":111903,"_26191":111904,"_2648":111905},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3150":65769,"_27690":65763,"_5":28029,"_19203":111907,"_26191":111908,"_2648":111909},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3150":65770,"_27690":65763,"_5":28029,"_19203":111911,"_26191":111912,"_2648":111913},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3150":65771,"_27690":65763,"_5":28029,"_19203":111915,"_26191":111916,"_2648":111917},[],"/docs/pr-preview/pr-40/es/platform/pki/crl#referencias","Referencias",{"_3150":65772,"_27690":65763,"_19203":111919,"_5":13195,"_26191":65763,"_2648":111920},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3150":65773,"_27690":65763,"_19203":111922,"_5":13195,"_26191":111892,"_2648":111923},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3150":65774,"_27690":65763,"_19203":111925,"_5":13195,"_26191":111892,"_2648":111926},[],"Campo de `crl_options`",{"_3150":65775,"_27690":65763,"_19203":111928,"_5":13195,"_26191":111892,"_2648":108665},[],{"_3150":65776,"_27690":65763,"_19203":111930,"_5":13195,"_26191":111892,"_2648":111931},[],"Valor inicial del backend",{"_3150":65777,"_27690":65763,"_19203":111933,"_5":13195,"_26191":111892,"_2648":51256},[],{"_3150":65778,"_27690":65763,"_19203":111935,"_5":13195,"_26191":111892,"_2648":111936},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3150":65779,"_27690":65763,"_19203":111938,"_5":13195,"_26191":111892,"_2648":111939},[],"7 días.",{"_3150":65780,"_27690":65763,"_19203":111941,"_5":13195,"_26191":111892,"_2648":51265},[],{"_3150":65781,"_27690":65763,"_19203":111943,"_5":13195,"_26191":111892,"_2648":111944},[],"Plazo desde la publicación que activa la renovación programada.",{"_3150":65782,"_27690":65763,"_19203":111946,"_5":13195,"_26191":111892,"_2648":111947},[],"6 días y 23 horas.",{"_3150":65783,"_27690":65763,"_19203":111949,"_5":13195,"_26191":111892,"_2648":51274},[],{"_3150":65784,"_27690":65763,"_19203":111951,"_5":13195,"_26191":111892,"_2648":111952},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3150":65785,"_27690":65763,"_19203":111954,"_5":13195,"_26191":111892,"_2648":51280},[],{"_3150":65786,"_27690":65763,"_19203":111956,"_5":13195,"_26191":111892,"_2648":51283},[],{"_3150":65787,"_27690":65763,"_19203":111958,"_5":13195,"_26191":111892,"_2648":111959},[],"Campo de configuración inicializado con el SKI de la CA.",{"_3150":65788,"_27690":65763,"_19203":111961,"_5":13195,"_26191":111892,"_2648":111962},[],"SKI de la CA.",{"_3150":65789,"_27690":65763,"_19203":111964,"_5":13195,"_26191":111892,"_2648":111965},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_3150":65790,"_27690":65763,"_19203":111967,"_5":13195,"_26191":111892,"_2648":111968},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3150":65791,"_27690":65763,"_19203":111970,"_5":13195,"_26191":111896,"_2648":111971},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3150":65792,"_27690":65763,"_19203":111973,"_5":13195,"_26191":111896,"_2648":111974},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3150":65793,"_27690":65763,"_19203":111976,"_5":13195,"_26191":111896,"_2648":111977},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3150":65794,"_27690":65763,"_19203":111979,"_5":13195,"_26191":111900,"_2648":111980},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3150":65795,"_27690":65763,"_19203":111982,"_5":13195,"_26191":111900,"_2648":111983},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3150":65796,"_27690":65763,"_19203":111985,"_5":13195,"_26191":111904,"_2648":111986},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3150":65797,"_27690":65763,"_19203":111988,"_5":13195,"_26191":111904,"_2648":111989},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3150":65798,"_27690":65763,"_19203":111991,"_5":13195,"_26191":111904,"_2648":111992},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3150":65799,"_27690":65763,"_19203":111994,"_5":13195,"_26191":111904,"_2648":111995},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3150":65800,"_27690":65763,"_19203":111997,"_5":13195,"_26191":111904,"_2648":111998},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3150":65801,"_27690":65763,"_19203":112000,"_5":13195,"_26191":111908,"_2648":112001},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3150":65802,"_27690":65763,"_19203":112003,"_5":13195,"_26191":111908,"_2648":108854},[],{"_3150":65803,"_27690":65763,"_19203":112005,"_5":13195,"_26191":111908,"_2648":112006},[],"Path relativo",{"_3150":65804,"_27690":65763,"_19203":112008,"_5":13195,"_26191":111908,"_2648":106957},[],{"_3150":65805,"_27690":65763,"_19203":112010,"_5":13195,"_26191":111908,"_2648":51338},[],{"_3150":65806,"_27690":65763,"_19203":112012,"_5":13195,"_26191":111908,"_2648":51341},[],{"_3150":65807,"_27690":65763,"_19203":112014,"_5":13195,"_26191":111908,"_2648":112015},[],"Consultar `crl_options` y `latest_crl`.",{"_3150":65808,"_27690":65763,"_19203":112017,"_5":13195,"_26191":111908,"_2648":51347},[],{"_3150":65809,"_27690":65763,"_19203":112019,"_5":13195,"_26191":111908,"_2648":51341},[],{"_3150":65810,"_27690":65763,"_19203":112021,"_5":13195,"_26191":111908,"_2648":112022},[],"Sustituir la configuración de CRL.",{"_3150":65811,"_27690":65763,"_19203":112024,"_5":13195,"_26191":111908,"_2648":112025},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3150":65812,"_27690":65763,"_19203":112027,"_5":13195,"_26191":111908,"_2648":112028},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3150":65813,"_27690":65763,"_19203":112030,"_5":13195,"_26191":111912,"_2648":112031},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3150":65814,"_27690":65763,"_19203":112033,"_5":13195,"_26191":111916,"_2648":112034},[],"RFC 5280: perfil X.509 y CRL.",{"_3150":65815,"_27690":65763,"_19203":112036,"_5":13195,"_26191":111916,"_2648":51367},[],{"_3150":65816,"_27690":65763,"_19203":112038,"_5":13195,"_26191":111916,"_2648":51370},[],{"_3150":65817,"_27690":65763,"_19203":112040,"_5":13195,"_26191":111916,"_2648":112041},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":65818,"_27690":65763,"_19203":112043,"_5":13195,"_26191":111916,"_2648":112044},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3150":65819,"_27690":65819,"_5":13521,"_2648":112046,"_28032":112047,"_19203":112048,"_26191":65819},"Claves y motores criptográficos",[45000,107166,50076,110757],[],{"_3150":65820,"_27690":65819,"_19203":112050,"_5":13195,"_26191":65819,"_2648":112051},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3150":65821,"_27690":65819,"_5":28029,"_19203":112053,"_26191":112054,"_2648":112055},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3150":65822,"_27690":65819,"_5":28029,"_19203":112057,"_26191":112058,"_2648":112059},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3150":65823,"_27690":65819,"_5":28029,"_19203":112061,"_26191":112062,"_2648":51395},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#file-system",{"_3150":65824,"_27690":65819,"_5":28029,"_19203":112064,"_26191":112065,"_2648":51399},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#hashicorp-vault",{"_3150":65825,"_27690":65819,"_5":28029,"_19203":112067,"_26191":112068,"_2648":51403},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#aws-secrets-manager",{"_3150":65826,"_27690":65819,"_5":28029,"_19203":112070,"_26191":112071,"_2648":51407},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#aws-kms",{"_3150":65827,"_27690":65819,"_5":28029,"_19203":112073,"_26191":112074,"_2648":51411},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#pkcs11",{"_3150":65828,"_27690":65819,"_5":28029,"_19203":112076,"_26191":112077,"_2648":51415},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#azure-key-vault",{"_3150":65829,"_27690":65819,"_5":28029,"_19203":112079,"_26191":112080,"_2648":112081},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3150":65830,"_27690":65819,"_5":28029,"_19203":112083,"_26191":112084,"_2648":112085},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3150":65831,"_27690":65819,"_5":28029,"_19203":112087,"_26191":112088,"_2648":112089},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3150":65832,"_27690":65819,"_5":28029,"_19203":112091,"_26191":112092,"_2648":112093},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3150":65833,"_27690":65819,"_5":28029,"_19203":112095,"_26191":112096,"_2648":112097},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3150":65834,"_27690":65819,"_5":28029,"_19203":112099,"_26191":112100,"_2648":112101},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3150":65835,"_27690":65819,"_5":28029,"_19203":112103,"_26191":112104,"_2648":112105},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3150":65836,"_27690":65819,"_5":28029,"_19203":112107,"_26191":112108,"_2648":51447},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#sign",{"_3150":65837,"_27690":65819,"_5":28029,"_19203":112110,"_26191":112111,"_2648":51451},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#verify",{"_3150":65838,"_27690":65819,"_5":28029,"_19203":112113,"_26191":112114,"_2648":112115},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3150":65839,"_27690":65819,"_5":28029,"_19203":112117,"_26191":112118,"_2648":112119},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3150":65840,"_27690":65819,"_5":28029,"_19203":112121,"_26191":112122,"_2648":112123},[],"/docs/pr-preview/pr-40/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3150":65841,"_27690":65819,"_19203":112125,"_5":13195,"_26191":65819,"_2648":112126},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3150":65842,"_27690":65819,"_19203":112128,"_5":13195,"_26191":65819,"_2648":112129},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3150":65843,"_27690":65819,"_19203":112131,"_5":13195,"_26191":112054,"_2648":112132},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3150":65844,"_27690":65819,"_19203":112134,"_5":13195,"_26191":112054,"_2648":112135},[],"En la práctica, permite:",{"_3150":65845,"_27690":65819,"_19203":112137,"_5":13195,"_26191":112054,"_2648":112138},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3150":65846,"_27690":65819,"_19203":112140,"_5":13195,"_26191":112054,"_2648":112141},[],"Importar claves creadas externamente.",{"_3150":65847,"_27690":65819,"_19203":112143,"_5":13195,"_26191":112054,"_2648":112144},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3150":65848,"_27690":65819,"_19203":112146,"_5":13195,"_26191":112054,"_2648":112147},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3150":65849,"_27690":65819,"_19203":112149,"_5":13195,"_26191":112058,"_2648":112150},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3150":65850,"_27690":65819,"_19203":112152,"_5":13195,"_26191":112058,"_2648":112153},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3150":65851,"_27690":65819,"_19203":112155,"_5":13195,"_26191":112058,"_2648":112156},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3150":65852,"_27690":65819,"_19203":112158,"_5":13195,"_26191":112062,"_2648":112159},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3150":65853,"_27690":65819,"_19203":112161,"_5":13195,"_26191":112065,"_2648":112162},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3150":65854,"_27690":65819,"_19203":112164,"_5":13195,"_26191":112068,"_2648":112165},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3150":65855,"_27690":65819,"_19203":112167,"_5":13195,"_26191":112071,"_2648":112168},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3150":65856,"_27690":65819,"_19203":112170,"_5":13195,"_26191":112074,"_2648":112171},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3150":65857,"_27690":65819,"_19203":112173,"_5":13195,"_26191":112077,"_2648":112174},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3150":65858,"_27690":65819,"_19203":112176,"_5":13195,"_26191":112077,"_2648":112177},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3150":65859,"_27690":65819,"_19203":112179,"_5":13195,"_26191":112077,"_2648":112180},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3150":65860,"_27690":65819,"_19203":112182,"_5":13195,"_26191":112077,"_2648":112183},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3150":65861,"_27690":65819,"_19203":112185,"_5":13195,"_26191":112080,"_2648":112186},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3150":65862,"_27690":65819,"_19203":112188,"_5":13195,"_26191":112080,"_2648":112189},[],"La tabla incluye los siguientes campos:",{"_3150":65863,"_27690":65819,"_19203":112191,"_5":13195,"_26191":112080,"_2648":112192},[],"**Name**: nombre descriptivo de la clave.",{"_3150":65864,"_27690":65819,"_19203":112194,"_5":13195,"_26191":112080,"_2648":112195},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3150":65865,"_27690":65819,"_19203":112197,"_5":13195,"_26191":112080,"_2648":112198},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3150":65866,"_27690":65819,"_19203":112200,"_5":13195,"_26191":112080,"_2648":112201},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3150":65867,"_27690":65819,"_19203":112203,"_5":13195,"_26191":112080,"_2648":112204},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3150":65868,"_27690":65819,"_19203":112206,"_5":13195,"_26191":112080,"_2648":112207},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3150":65869,"_27690":65819,"_19203":112209,"_5":13195,"_26191":112080,"_2648":112210},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3150":65870,"_27690":65819,"_19203":112212,"_5":13195,"_26191":112080,"_2648":112213},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3150":65871,"_27690":65819,"_19203":112215,"_5":13195,"_26191":112080,"_2648":112216},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3150":65872,"_27690":65819,"_19203":112218,"_5":13195,"_26191":112080,"_2648":112219},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3150":65873,"_27690":65819,"_19203":112221,"_5":13195,"_26191":112080,"_2648":112222},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3150":65874,"_27690":65819,"_19203":112224,"_5":13195,"_26191":112080,"_2648":112225},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3150":65875,"_27690":65819,"_19203":112227,"_5":13195,"_26191":112080,"_2648":112228},[],"**Delete Key** para eliminar la clave del sistema.",{"_3150":65876,"_27690":65819,"_19203":112230,"_5":13195,"_26191":112084,"_2648":112231},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3150":65877,"_27690":65819,"_19203":112233,"_5":13195,"_26191":112088,"_2648":112234},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3150":65878,"_27690":65819,"_19203":112236,"_5":13195,"_26191":112088,"_2648":112237},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3150":65879,"_27690":65819,"_19203":112239,"_5":13195,"_26191":112088,"_2648":112240},[],"**Key Name**: nombre único y descriptivo.",{"_3150":65880,"_27690":65819,"_19203":112242,"_5":13195,"_26191":112088,"_2648":112243},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3150":65881,"_27690":65819,"_19203":112245,"_5":13195,"_26191":112088,"_2648":112246},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3150":65882,"_27690":65819,"_19203":112248,"_5":13195,"_26191":112088,"_2648":112249},[],"**Tags**: metadatos para clasificar la clave.",{"_3150":65883,"_27690":65819,"_19203":112251,"_5":13195,"_26191":112088,"_2648":112252},[],"**Metadata**: información adicional para usos avanzados.",{"_3150":65884,"_27690":65819,"_19203":112254,"_5":13195,"_26191":112092,"_2648":112255},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3150":65885,"_27690":65819,"_19203":112257,"_5":13195,"_26191":112092,"_2648":112258},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3150":65886,"_27690":65819,"_19203":112260,"_5":13195,"_26191":112092,"_2648":112261},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3150":65887,"_27690":65819,"_19203":112263,"_5":13195,"_26191":112092,"_2648":112264},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3150":65888,"_27690":65819,"_19203":112266,"_5":13195,"_26191":112092,"_2648":112267},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3150":65889,"_27690":65819,"_19203":112269,"_5":13195,"_26191":112092,"_2648":112270},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3150":65890,"_27690":65819,"_19203":112272,"_5":13195,"_26191":112092,"_2648":112273},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3150":65891,"_27690":65819,"_19203":112275,"_5":13195,"_26191":112092,"_2648":112276},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3150":65892,"_27690":65819,"_19203":112278,"_5":13195,"_26191":112092,"_2648":112279},[],"**Metadata**: información adicional opcional.",{"_3150":65893,"_27690":65819,"_19203":112281,"_5":13195,"_26191":112092,"_2648":112282},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3150":65894,"_27690":65819,"_19203":112284,"_5":13195,"_26191":112092,"_2648":112285},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3150":65895,"_27690":65819,"_19203":112287,"_5":13195,"_26191":112096,"_2648":112288},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3150":65896,"_27690":65819,"_19203":112290,"_5":13195,"_26191":112100,"_2648":112291},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3150":65897,"_27690":65819,"_19203":112293,"_5":13195,"_26191":112100,"_2648":112294},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3150":65898,"_27690":65819,"_19203":112296,"_5":13195,"_26191":112100,"_2648":112297},[],"**Key Name**: nombre descriptivo.",{"_3150":65899,"_27690":65819,"_19203":112299,"_5":13195,"_26191":112100,"_2648":112300},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3150":65900,"_27690":65819,"_19203":112302,"_5":13195,"_26191":112100,"_2648":112303},[],"**Tags**: etiquetas asociadas.",{"_3150":65901,"_27690":65819,"_19203":112305,"_5":13195,"_26191":112100,"_2648":112306},[],"**Aliases**: nombres alternativos.",{"_3150":65902,"_27690":65819,"_19203":112308,"_5":13195,"_26191":112100,"_2648":112309},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3150":65903,"_27690":65819,"_19203":112311,"_5":13195,"_26191":112100,"_2648":112312},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3150":65904,"_27690":65819,"_19203":112314,"_5":13195,"_26191":112100,"_2648":112315},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3150":65905,"_27690":65819,"_19203":112317,"_5":13195,"_26191":112100,"_2648":112318},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3150":65906,"_27690":65819,"_19203":112320,"_5":13195,"_26191":112104,"_2648":112321},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3150":65907,"_27690":65819,"_19203":112323,"_5":13195,"_26191":112104,"_2648":112324},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3150":65908,"_27690":65819,"_19203":112326,"_5":13195,"_26191":112104,"_2648":112327},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3150":65909,"_27690":65819,"_19203":112329,"_5":13195,"_26191":112108,"_2648":112330},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3150":65910,"_27690":65819,"_19203":112332,"_5":13195,"_26191":112108,"_2648":112333},[],"Campos principales:",{"_3150":65911,"_27690":65819,"_19203":112335,"_5":13195,"_26191":112108,"_2648":112336},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3150":65912,"_27690":65819,"_19203":112338,"_5":13195,"_26191":112108,"_2648":112339},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3150":65913,"_27690":65819,"_19203":112341,"_5":13195,"_26191":112108,"_2648":112342},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3150":65914,"_27690":65819,"_19203":112344,"_5":13195,"_26191":112108,"_2648":112345},[],"**Message**: contenido que se va a firmar.",{"_3150":65915,"_27690":65819,"_19203":112347,"_5":13195,"_26191":112108,"_2648":112348},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3150":65916,"_27690":65819,"_19203":112350,"_5":13195,"_26191":112111,"_2648":112351},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3150":65917,"_27690":65819,"_19203":112353,"_5":13195,"_26191":112111,"_2648":112333},[],{"_3150":65918,"_27690":65819,"_19203":112355,"_5":13195,"_26191":112111,"_2648":112356},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3150":65919,"_27690":65819,"_19203":112358,"_5":13195,"_26191":112111,"_2648":112359},[],"**Message Type**: `Raw` o `Digest`.",{"_3150":65920,"_27690":65819,"_19203":112361,"_5":13195,"_26191":112111,"_2648":112362},[],"**Payload Encoding**: codificación del mensaje.",{"_3150":65921,"_27690":65819,"_19203":112364,"_5":13195,"_26191":112111,"_2648":112365},[],"**Message**: mensaje original o hash.",{"_3150":65922,"_27690":65819,"_19203":112367,"_5":13195,"_26191":112111,"_2648":112368},[],"**Signature**: firma que se desea comprobar.",{"_3150":65923,"_27690":65819,"_19203":112370,"_5":13195,"_26191":112111,"_2648":112371},[],"**Result**: indicador del resultado de la validación.",{"_3150":65924,"_27690":65819,"_19203":112373,"_5":13195,"_26191":112114,"_2648":112374},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3150":65925,"_27690":65819,"_19203":112376,"_5":13195,"_26191":112114,"_2648":112377},[],"Este flujo es útil para:",{"_3150":65926,"_27690":65819,"_19203":112379,"_5":13195,"_26191":112114,"_2648":112380},[],"Solicitar certificados a una CA externa.",{"_3150":65927,"_27690":65819,"_19203":112382,"_5":13195,"_26191":112114,"_2648":112383},[],"Renovar una identidad manteniendo la misma clave.",{"_3150":65928,"_27690":65819,"_19203":112385,"_5":13195,"_26191":112114,"_2648":112386},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3150":65929,"_27690":65819,"_19203":112388,"_5":13195,"_26191":112114,"_2648":112389},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3150":65930,"_27690":65819,"_19203":112391,"_5":13195,"_26191":112114,"_2648":112392},[],"**Organization (O)**: organización o empresa.",{"_3150":65931,"_27690":65819,"_19203":112394,"_5":13195,"_26191":112114,"_2648":112395},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3150":65932,"_27690":65819,"_19203":112397,"_5":13195,"_26191":112114,"_2648":112398},[],"**Country (C)**: código de país de dos letras.",{"_3150":65933,"_27690":65819,"_19203":112400,"_5":13195,"_26191":112114,"_2648":112401},[],"**State / Province (ST)**: estado o provincia.",{"_3150":65934,"_27690":65819,"_19203":112403,"_5":13195,"_26191":112114,"_2648":112404},[],"**Locality (L)**: ciudad o localidad.",{"_3150":65935,"_27690":65819,"_19203":112406,"_5":13195,"_26191":112114,"_2648":112407},[],"**Email Address**: correo de contacto.",{"_3150":65936,"_27690":65819,"_19203":112409,"_5":13195,"_26191":112114,"_2648":112410},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3150":65937,"_27690":65819,"_19203":112412,"_5":13195,"_26191":112114,"_2648":112413},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3150":65938,"_27690":65819,"_19203":112415,"_5":13195,"_26191":112118,"_2648":112416},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3150":65939,"_27690":65819,"_19203":112418,"_5":13195,"_26191":112118,"_2648":51759},[],{"_3150":65940,"_27690":65819,"_19203":112420,"_5":13195,"_26191":112122,"_2648":112421},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3150":65941,"_27690":65941,"_5":13521,"_2648":112423,"_28032":112424,"_19203":112425,"_26191":65941},"Validación online con OCSP",[45000,107166,50076,111372],[],{"_3150":65942,"_27690":65941,"_19203":112427,"_5":13195,"_26191":65941,"_2648":112428},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3150":65943,"_27690":65941,"_5":28029,"_19203":112430,"_26191":112431,"_2648":112432},[],"/docs/pr-preview/pr-40/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3150":65944,"_27690":65941,"_5":28029,"_19203":112434,"_26191":112435,"_2648":112436},[],"/docs/pr-preview/pr-40/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3150":65945,"_27690":65941,"_5":28029,"_19203":112438,"_26191":112439,"_2648":112440},[],"/docs/pr-preview/pr-40/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3150":65946,"_27690":65941,"_5":28029,"_19203":112442,"_26191":112443,"_2648":112444},[],"/docs/pr-preview/pr-40/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3150":65947,"_27690":65941,"_5":28029,"_19203":112446,"_26191":112447,"_2648":112448},[],"/docs/pr-preview/pr-40/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3150":65948,"_27690":65941,"_5":28029,"_19203":112450,"_26191":112451,"_2648":111917},[],"/docs/pr-preview/pr-40/es/platform/pki/ocsp#referencias",{"_3150":65949,"_27690":65941,"_19203":112453,"_5":13195,"_26191":65941,"_2648":112454},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3150":65950,"_27690":65941,"_19203":112456,"_5":13195,"_26191":112431,"_2648":112457},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3150":65951,"_27690":65941,"_19203":112459,"_5":13195,"_26191":112431,"_2648":112460},[],"Estado del registro",{"_3150":65952,"_27690":65941,"_19203":112462,"_5":13195,"_26191":112431,"_2648":112463},[],"Respuesta firmada",{"_3150":65953,"_27690":65941,"_19203":112465,"_5":13195,"_26191":112431,"_2648":49254},[],{"_3150":65954,"_27690":65941,"_19203":112467,"_5":13195,"_26191":112431,"_2648":51809},[],{"_3150":65955,"_27690":65941,"_19203":112469,"_5":13195,"_26191":112431,"_2648":49271},[],{"_3150":65956,"_27690":65941,"_19203":112471,"_5":13195,"_26191":112431,"_2648":112472},[],"`Revoked`, con razón y fecha de revocación.",{"_3150":65957,"_27690":65941,"_19203":112474,"_5":13195,"_26191":112431,"_2648":112475},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3150":65958,"_27690":65941,"_19203":112477,"_5":13195,"_26191":112431,"_2648":112478},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3150":65959,"_27690":65941,"_19203":112480,"_5":13195,"_26191":112431,"_2648":112481},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3150":65960,"_27690":65941,"_19203":112483,"_5":13195,"_26191":112431,"_2648":112484},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3150":65961,"_27690":65941,"_19203":112486,"_5":13195,"_26191":112431,"_2648":112487},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3150":65962,"_27690":65941,"_19203":112489,"_5":13195,"_26191":112435,"_2648":112490},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3150":65963,"_27690":65941,"_19203":112492,"_5":13195,"_26191":112435,"_2648":112493},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3150":65964,"_27690":65941,"_19203":112495,"_5":13195,"_26191":112439,"_2648":112496},[],"El servicio acepta:",{"_3150":65965,"_27690":65941,"_19203":112498,"_5":13195,"_26191":112439,"_2648":108854},[],{"_3150":65966,"_27690":65941,"_19203":112500,"_5":13195,"_26191":112439,"_2648":112501},[],"Ruta del servicio VA",{"_3150":65967,"_27690":65941,"_19203":112503,"_5":13195,"_26191":112439,"_2648":112504},[],"Formato",{"_3150":65968,"_27690":65941,"_19203":112506,"_5":13195,"_26191":112439,"_2648":51849},[],{"_3150":65969,"_27690":65941,"_19203":112508,"_5":13195,"_26191":112439,"_2648":51852},[],{"_3150":65970,"_27690":65941,"_19203":112510,"_5":13195,"_26191":112439,"_2648":112511},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3150":65971,"_27690":65941,"_19203":112513,"_5":13195,"_26191":112439,"_2648":51338},[],{"_3150":65972,"_27690":65941,"_19203":112515,"_5":13195,"_26191":112439,"_2648":51860},[],{"_3150":65973,"_27690":65941,"_19203":112517,"_5":13195,"_26191":112439,"_2648":112518},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3150":65974,"_27690":65941,"_19203":112520,"_5":13195,"_26191":112439,"_2648":112521},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3150":65975,"_27690":65941,"_19203":112523,"_5":13195,"_26191":112443,"_2648":112524},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3150":65976,"_27690":65941,"_19203":112526,"_5":13195,"_26191":112443,"_2648":112527},[],"Genera la solicitud:",{"_3150":65977,"_27690":65941,"_19203":112529,"_5":13195,"_26191":112443,"_2648":112530},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3150":65978,"_27690":65941,"_19203":112532,"_5":13195,"_26191":112443,"_2648":112533},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3150":65979,"_27690":65941,"_19203":112535,"_5":13195,"_26191":112443,"_2648":112536},[],"Verifica el DER recibido:",{"_3150":65980,"_27690":65941,"_19203":112538,"_5":13195,"_26191":112443,"_2648":112539},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3150":65981,"_27690":65941,"_19203":112541,"_5":13195,"_26191":112447,"_2648":112542},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3150":65982,"_27690":65941,"_19203":112544,"_5":13195,"_26191":112447,"_2648":112545},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3150":65983,"_27690":65941,"_19203":112547,"_5":13195,"_26191":112451,"_2648":51893},[],{"_3150":65984,"_27690":65941,"_19203":112549,"_5":13195,"_26191":112451,"_2648":51896},[],{"_3150":65985,"_27690":65941,"_19203":112551,"_5":13195,"_26191":112451,"_2648":112552},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3150":65986,"_27690":65941,"_19203":112554,"_5":13195,"_26191":112451,"_2648":112044},[],{"_3150":65987,"_27690":65987,"_5":13521,"_2648":50076,"_28032":112556,"_19203":112557,"_26191":65987},[45000,107166,50076],[],{"_3150":65988,"_27690":65987,"_19203":112559,"_5":13195,"_26191":65987,"_2648":112560},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3150":65989,"_27690":65987,"_5":28029,"_19203":112562,"_26191":112563,"_2648":110081},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#empieza-aquí",{"_3150":65990,"_27690":65987,"_5":28029,"_19203":112565,"_26191":112566,"_2648":112567},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3150":65991,"_27690":65987,"_5":28029,"_19203":112569,"_26191":112570,"_2648":110603},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#capacidades-principales",{"_3150":65992,"_27690":65987,"_5":28029,"_19203":112572,"_26191":112573,"_2648":110607},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3150":65993,"_27690":65987,"_5":28029,"_19203":112575,"_26191":112576,"_2648":110611},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3150":65994,"_27690":65987,"_5":28029,"_19203":112578,"_26191":112579,"_2648":110615},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#emite-y-controla-certificados",{"_3150":65995,"_27690":65987,"_5":28029,"_19203":112581,"_26191":112582,"_2648":110623},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#publica-el-estado-de-validación",{"_3150":65996,"_27690":65987,"_5":28029,"_19203":112584,"_26191":112585,"_2648":112586},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3150":65997,"_27690":65987,"_5":28029,"_19203":112588,"_26191":112589,"_2648":111538},[],"/docs/pr-preview/pr-40/es/platform/pki/overview#continúa",{"_3150":65998,"_27690":65987,"_19203":112591,"_5":13195,"_26191":65987,"_2648":112592},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3150":65999,"_27690":65987,"_19203":112594,"_5":13195,"_26191":112563,"_2648":112595},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3150":66000,"_27690":65987,"_19203":112597,"_5":13195,"_26191":112563,"_2648":112598},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3150":66001,"_27690":65987,"_19203":112600,"_5":13195,"_26191":112566,"_2648":112601},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3150":66002,"_27690":65987,"_19203":112603,"_5":13195,"_26191":112566,"_2648":112604},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3150":66003,"_27690":65987,"_19203":112606,"_5":13195,"_26191":112566,"_2648":112607},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3150":66004,"_27690":65987,"_19203":112609,"_5":13195,"_26191":112566,"_2648":112610},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3150":66005,"_27690":65987,"_19203":112612,"_5":13195,"_26191":112566,"_2648":112613},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3150":66006,"_27690":65987,"_19203":112615,"_5":13195,"_26191":112573,"_2648":112616},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3150":66007,"_27690":65987,"_19203":112618,"_5":13195,"_26191":112576,"_2648":112619},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3150":66008,"_27690":65987,"_19203":112621,"_5":13195,"_26191":112579,"_2648":112622},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3150":66009,"_27690":65987,"_19203":112624,"_5":13195,"_26191":112582,"_2648":112625},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3150":66010,"_27690":65987,"_19203":112627,"_5":13195,"_26191":112585,"_2648":112628},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3150":66011,"_27690":65987,"_19203":112630,"_5":13195,"_26191":112585,"_2648":112631},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3150":66012,"_27690":65987,"_19203":112633,"_5":13195,"_26191":112585,"_2648":112634},[],"su clave pública corresponda a la clave privada del cliente;",{"_3150":66013,"_27690":65987,"_19203":112636,"_5":13195,"_26191":112585,"_2648":112637},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3150":66014,"_27690":65987,"_19203":112639,"_5":13195,"_26191":112585,"_2648":112640},[],"sus fechas y usos permitan la operación;",{"_3150":66015,"_27690":65987,"_19203":112642,"_5":13195,"_26191":112585,"_2648":112643},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3150":66016,"_27690":65987,"_19203":112645,"_5":13195,"_26191":112585,"_2648":112646},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3150":66017,"_27690":65987,"_19203":112648,"_5":13195,"_26191":112589,"_2648":112649},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3150":66018,"_27690":65987,"_19203":112651,"_5":13195,"_26191":112589,"_2648":112652},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3150":66019,"_27690":65987,"_19203":112654,"_5":13195,"_26191":112589,"_2648":112655},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3150":66020,"_27690":66020,"_5":13521,"_2648":112657,"_28032":112658,"_19203":112659,"_26191":66020},"Crea tu primera CA",[45000,107166,50076,110205],[],{"_3150":66021,"_27690":66020,"_19203":112661,"_5":13195,"_26191":66020,"_2648":112662},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3150":66022,"_27690":66020,"_5":28029,"_19203":112664,"_26191":112665,"_2648":105832},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3150":66023,"_27690":66020,"_5":28029,"_19203":112667,"_26191":112668,"_2648":112669},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3150":66024,"_27690":66020,"_5":28029,"_19203":112671,"_26191":112672,"_2648":112673},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3150":66025,"_27690":66020,"_5":28029,"_19203":112675,"_26191":112676,"_2648":112677},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3150":66026,"_27690":66020,"_5":28029,"_19203":112679,"_26191":112680,"_2648":112681},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3150":66027,"_27690":66020,"_5":28029,"_19203":112683,"_26191":112684,"_2648":112685},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3150":66028,"_27690":66020,"_5":28029,"_19203":112687,"_26191":112688,"_2648":112689},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3150":66029,"_27690":66020,"_5":28029,"_19203":112691,"_26191":112692,"_2648":110453},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3150":66030,"_27690":66020,"_5":28029,"_19203":112694,"_26191":112695,"_2648":105856},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3150":66031,"_27690":66020,"_19203":112697,"_5":13195,"_26191":66020,"_2648":112698},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3150":66032,"_27690":66020,"_19203":112700,"_5":13195,"_26191":112665,"_2648":112701},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3150":66033,"_27690":66020,"_19203":112703,"_5":13195,"_26191":112665,"_2648":112704},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3150":66034,"_27690":66020,"_19203":112706,"_5":13195,"_26191":112665,"_2648":112707},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3150":66035,"_27690":66020,"_19203":112709,"_5":13195,"_26191":112665,"_2648":112710},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3150":66036,"_27690":66020,"_19203":112712,"_5":13195,"_26191":112668,"_2648":112713},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3150":66037,"_27690":66020,"_19203":112715,"_5":13195,"_26191":112668,"_2648":112716},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3150":66038,"_27690":66020,"_19203":112718,"_5":13195,"_26191":112672,"_2648":112719},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3150":66039,"_27690":66020,"_19203":112721,"_5":13195,"_26191":112672,"_2648":112722},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3150":66040,"_27690":66020,"_19203":112724,"_5":13195,"_26191":112676,"_2648":112725},[],"Selecciona **Root CA** y completa:",{"_3150":66041,"_27690":66020,"_19203":112727,"_5":13195,"_26191":112676,"_2648":52075},[],{"_3150":66042,"_27690":66020,"_19203":112729,"_5":13195,"_26191":112676,"_2648":112730},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3150":66043,"_27690":66020,"_19203":112732,"_5":13195,"_26191":112676,"_2648":112733},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3150":66044,"_27690":66020,"_19203":112735,"_5":13195,"_26191":112676,"_2648":112736},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3150":66045,"_27690":66020,"_19203":112738,"_5":13195,"_26191":112676,"_2648":112739},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3150":66046,"_27690":66020,"_19203":112741,"_5":13195,"_26191":112680,"_2648":112742},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3150":66047,"_27690":66020,"_19203":112744,"_5":13195,"_26191":112684,"_2648":112745},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3150":66048,"_27690":66020,"_19203":112747,"_5":13195,"_26191":112684,"_2648":112748},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3150":66049,"_27690":66020,"_19203":112750,"_5":13195,"_26191":112688,"_2648":112751},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3150":66050,"_27690":66020,"_19203":112753,"_5":13195,"_26191":112688,"_2648":112754},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3150":66051,"_27690":66020,"_19203":112756,"_5":13195,"_26191":112688,"_2648":112757},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3150":66052,"_27690":66020,"_19203":112759,"_5":13195,"_26191":112692,"_2648":112760},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3150":66053,"_27690":66020,"_19203":112762,"_5":13195,"_26191":112692,"_2648":112763},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3150":66054,"_27690":66020,"_19203":112765,"_5":13195,"_26191":112692,"_2648":112766},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3150":66055,"_27690":66020,"_19203":112768,"_5":13195,"_26191":112692,"_2648":112769},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3150":66056,"_27690":66020,"_19203":112771,"_5":13195,"_26191":112695,"_2648":112772},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3150":66057,"_27690":66057,"_5":13521,"_2648":112774,"_28032":112775,"_19203":112776,"_26191":66057},"Emite y verifica un certificado",[45000,107166,50076,110205],[],{"_3150":66058,"_27690":66057,"_19203":112778,"_5":13195,"_26191":66057,"_2648":112779},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3150":66059,"_27690":66057,"_5":28029,"_19203":112781,"_26191":112782,"_2648":105832},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3150":66060,"_27690":66057,"_5":28029,"_19203":112784,"_26191":112785,"_2648":112786},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3150":66061,"_27690":66057,"_5":28029,"_19203":112788,"_26191":112789,"_2648":112790},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3150":66062,"_27690":66057,"_5":28029,"_19203":112792,"_26191":112793,"_2648":112794},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3150":66063,"_27690":66057,"_5":28029,"_19203":112796,"_26191":112797,"_2648":112798},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3150":66064,"_27690":66057,"_5":28029,"_19203":112800,"_26191":112801,"_2648":112802},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3150":66065,"_27690":66057,"_5":28029,"_19203":112804,"_26191":112805,"_2648":112685},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3150":66066,"_27690":66057,"_5":28029,"_19203":112807,"_26191":112808,"_2648":112809},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3150":66067,"_27690":66057,"_5":28029,"_19203":112811,"_26191":112812,"_2648":112813},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3150":66068,"_27690":66057,"_5":28029,"_19203":112815,"_26191":112816,"_2648":112817},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3150":66069,"_27690":66057,"_5":28029,"_19203":112819,"_26191":112820,"_2648":110453},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3150":66070,"_27690":66057,"_5":28029,"_19203":112822,"_26191":112823,"_2648":105856},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3150":66071,"_27690":66057,"_19203":112825,"_5":13195,"_26191":66057,"_2648":112826},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3150":66072,"_27690":66057,"_19203":112828,"_5":13195,"_26191":112782,"_2648":112829},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3150":66073,"_27690":66057,"_19203":112831,"_5":13195,"_26191":112782,"_2648":112832},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3150":66074,"_27690":66057,"_19203":112834,"_5":13195,"_26191":112782,"_2648":112835},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3150":66075,"_27690":66057,"_19203":112837,"_5":13195,"_26191":112782,"_2648":112838},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3150":66076,"_27690":66057,"_19203":112840,"_5":13195,"_26191":112782,"_2648":112841},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3150":66077,"_27690":66057,"_19203":112843,"_5":13195,"_26191":112785,"_2648":112844},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3150":66078,"_27690":66057,"_19203":112846,"_5":13195,"_26191":112789,"_2648":112847},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3150":66079,"_27690":66057,"_19203":112849,"_5":13195,"_26191":112789,"_2648":112850},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3150":66080,"_27690":66057,"_19203":112852,"_5":13195,"_26191":112793,"_2648":112853},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3150":66081,"_27690":66057,"_19203":112855,"_5":13195,"_26191":112793,"_2648":112856},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3150":66082,"_27690":66057,"_19203":112858,"_5":13195,"_26191":112797,"_2648":112859},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3150":66083,"_27690":66057,"_19203":112861,"_5":13195,"_26191":112797,"_2648":112862},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3150":66084,"_27690":66057,"_19203":112864,"_5":13195,"_26191":112801,"_2648":112865},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3150":66085,"_27690":66057,"_19203":112867,"_5":13195,"_26191":112805,"_2648":112868},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3150":66086,"_27690":66057,"_19203":112870,"_5":13195,"_26191":112808,"_2648":112871},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3150":66087,"_27690":66057,"_19203":112873,"_5":13195,"_26191":112812,"_2648":112874},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3150":66088,"_27690":66057,"_19203":112876,"_5":13195,"_26191":112812,"_2648":112877},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3150":66089,"_27690":66057,"_19203":112879,"_5":13195,"_26191":112812,"_2648":112880},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3150":66090,"_27690":66057,"_19203":112882,"_5":13195,"_26191":112816,"_2648":112883},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3150":66091,"_27690":66057,"_19203":112885,"_5":13195,"_26191":112816,"_2648":112886},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3150":66092,"_27690":66057,"_19203":112888,"_5":13195,"_26191":112816,"_2648":112889},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3150":66093,"_27690":66057,"_19203":112891,"_5":13195,"_26191":112820,"_2648":110536},[],{"_3150":66094,"_27690":66057,"_19203":112893,"_5":13195,"_26191":112820,"_2648":109303},[],{"_3150":66095,"_27690":66057,"_19203":112895,"_5":13195,"_26191":112820,"_2648":112896},[],"La CA rechaza la emisión",{"_3150":66096,"_27690":66057,"_19203":112898,"_5":13195,"_26191":112820,"_2648":112899},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3150":66097,"_27690":66057,"_19203":112901,"_5":13195,"_26191":112820,"_2648":112902},[],"Sujeto o usos diferentes",{"_3150":66098,"_27690":66057,"_19203":112904,"_5":13195,"_26191":112820,"_2648":112905},[],"Perfil aplicado y valores solicitados.",{"_3150":66099,"_27690":66057,"_19203":112907,"_5":13195,"_26191":112820,"_2648":112908},[],"No se encuentra el emisor",{"_3150":66100,"_27690":66057,"_19203":112910,"_5":13195,"_26191":112820,"_2648":112911},[],"CA descargada y cadena intermedia necesaria.",{"_3150":66101,"_27690":66057,"_19203":112913,"_5":13195,"_26191":112820,"_2648":112914},[],"Falla la vigencia",{"_3150":66102,"_27690":66057,"_19203":112916,"_5":13195,"_26191":112820,"_2648":112917},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3150":66103,"_27690":66057,"_19203":112919,"_5":13195,"_26191":112820,"_2648":112920},[],"Los resúmenes de clave difieren",{"_3150":66104,"_27690":66057,"_19203":112922,"_5":13195,"_26191":112820,"_2648":112923},[],"Archivos de certificado y clave de la misma emisión.",{"_3150":66105,"_27690":66057,"_19203":112925,"_5":13195,"_26191":112820,"_2648":112926},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3150":66106,"_27690":66057,"_19203":112928,"_5":13195,"_26191":112823,"_2648":112929},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3150":66107,"_27690":66057,"_19203":112931,"_5":13195,"_26191":112823,"_2648":112932},[],"Gestionar certificados para inspección, estado y revocación.",{"_3150":66108,"_27690":66057,"_19203":112934,"_5":13195,"_26191":112823,"_2648":112935},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3150":66109,"_27690":66057,"_19203":112937,"_5":13195,"_26191":112823,"_2648":112938},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3150":66110,"_27690":66057,"_19203":112940,"_5":13195,"_26191":112823,"_2648":112941},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3150":66111,"_27690":66111,"_5":13521,"_2648":112943,"_28032":112944,"_19203":112945,"_26191":66111},"Primeros pasos de PKI",[45000,107166,50076,110205],[],{"_3150":66112,"_27690":66111,"_19203":112947,"_5":13195,"_26191":66111,"_2648":112948},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3150":66113,"_27690":66111,"_5":28029,"_19203":112950,"_26191":112951,"_2648":105832},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3150":66114,"_27690":66111,"_5":28029,"_19203":112953,"_26191":112954,"_2648":112955},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3150":66115,"_27690":66111,"_5":28029,"_19203":112957,"_26191":112958,"_2648":110387},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3150":66116,"_27690":66111,"_5":28029,"_19203":112960,"_26191":112961,"_2648":112962},[],"/docs/pr-preview/pr-40/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3150":66117,"_27690":66111,"_19203":112964,"_5":13195,"_26191":66111,"_2648":112965},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3150":66118,"_27690":66111,"_19203":112967,"_5":13195,"_26191":112951,"_2648":112968},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3150":66119,"_27690":66111,"_19203":112970,"_5":13195,"_26191":112951,"_2648":112971},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3150":66120,"_27690":66111,"_19203":112973,"_5":13195,"_26191":112951,"_2648":112974},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3150":66121,"_27690":66111,"_19203":112976,"_5":13195,"_26191":112951,"_2648":112977},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3150":66122,"_27690":66111,"_19203":112979,"_5":13195,"_26191":112951,"_2648":112980},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3150":66123,"_27690":66111,"_19203":112982,"_5":13195,"_26191":112954,"_2648":112983},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3150":66124,"_27690":66111,"_19203":112985,"_5":13195,"_26191":112954,"_2648":112986},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3150":66125,"_27690":66111,"_19203":112988,"_5":13195,"_26191":112954,"_2648":112989},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3150":66126,"_27690":66111,"_19203":112991,"_5":13195,"_26191":112954,"_2648":112992},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3150":66127,"_27690":66111,"_19203":112994,"_5":13195,"_26191":112958,"_2648":112995},[],"Archivo o recurso",{"_3150":66128,"_27690":66111,"_19203":112997,"_5":13195,"_26191":112958,"_2648":110384},[],{"_3150":66129,"_27690":66111,"_19203":112999,"_5":13195,"_26191":112958,"_2648":113000},[],"CA raíz activa y `ca.pem`",{"_3150":66130,"_27690":66111,"_19203":113002,"_5":13195,"_26191":112958,"_2648":113003},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3150":66131,"_27690":66111,"_19203":113005,"_5":13195,"_26191":112958,"_2648":113006},[],"Certificado final y `device.crt`",{"_3150":66132,"_27690":66111,"_19203":113008,"_5":13195,"_26191":112958,"_2648":113009},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3150":66133,"_27690":66111,"_19203":113011,"_5":13195,"_26191":112958,"_2648":113012},[],"Clave privada `device.key`",{"_3150":66134,"_27690":66111,"_19203":113014,"_5":13195,"_26191":112958,"_2648":113015},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3150":66135,"_27690":66111,"_19203":113017,"_5":13195,"_26191":112958,"_2648":113018},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3150":66136,"_27690":66111,"_19203":113020,"_5":13195,"_26191":112961,"_2648":113021},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3150":66137,"_27690":66111,"_19203":113023,"_5":13195,"_26191":112961,"_2648":113024},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3150":66138,"_27690":66111,"_19203":113026,"_5":13195,"_26191":112961,"_2648":113027},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3150":66139,"_27690":66139,"_5":13521,"_2648":113029,"_28032":113030,"_19203":113032,"_26191":66139},"Resolución de problemas PKI",[45000,107166,50076,113031],"Resolución de problemas",[],{"_3150":66140,"_27690":66139,"_19203":113034,"_5":13195,"_26191":66139,"_2648":113035},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3150":66141,"_27690":66139,"_5":28029,"_19203":113037,"_26191":113038,"_2648":113039},[],"/docs/pr-preview/pr-40/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3150":66142,"_27690":66139,"_5":28029,"_19203":113041,"_26191":113042,"_2648":113043},[],"/docs/pr-preview/pr-40/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3150":66143,"_27690":66139,"_5":28029,"_19203":113045,"_26191":113046,"_2648":113047},[],"/docs/pr-preview/pr-40/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3150":66144,"_27690":66139,"_19203":113049,"_5":13195,"_26191":66139,"_2648":113050},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3150":66145,"_27690":66139,"_19203":113052,"_5":13195,"_26191":66139,"_2648":113053},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3150":66146,"_27690":66139,"_19203":113055,"_5":13195,"_26191":113038,"_2648":110384},[],{"_3150":66147,"_27690":66139,"_19203":113057,"_5":13195,"_26191":113038,"_2648":109303},[],{"_3150":66148,"_27690":66139,"_19203":113059,"_5":13195,"_26191":113038,"_2648":105856},[],{"_3150":66149,"_27690":66139,"_19203":113061,"_5":13195,"_26191":113038,"_2648":52411},[],{"_3150":66150,"_27690":66139,"_19203":113063,"_5":13195,"_26191":113038,"_2648":113064},[],"Existe, está activa y sus fechas son utilizables.",{"_3150":66151,"_27690":66139,"_19203":113066,"_5":13195,"_26191":113038,"_2648":113067},[],"Autoridades.",{"_3150":66152,"_27690":66139,"_19203":113069,"_5":13195,"_26191":113038,"_2648":113070},[],"Clave",{"_3150":66153,"_27690":66139,"_19203":113072,"_5":13195,"_26191":113038,"_2648":113073},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3150":66154,"_27690":66139,"_19203":113075,"_5":13195,"_26191":113038,"_2648":113076},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3150":66155,"_27690":66139,"_19203":113078,"_5":13195,"_26191":113038,"_2648":52429},[],{"_3150":66156,"_27690":66139,"_19203":113080,"_5":13195,"_26191":113038,"_2648":113081},[],"PEM correcto y firma verificable.",{"_3150":66157,"_27690":66139,"_19203":113083,"_5":13195,"_26191":113038,"_2648":52435},[],{"_3150":66158,"_27690":66139,"_19203":113085,"_5":13195,"_26191":113038,"_2648":113086},[],"Perfil",{"_3150":66159,"_27690":66139,"_19203":113088,"_5":13195,"_26191":113038,"_2648":113089},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3150":66160,"_27690":66139,"_19203":113091,"_5":13195,"_26191":113038,"_2648":113092},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3150":66161,"_27690":66139,"_19203":113094,"_5":13195,"_26191":113038,"_2648":110536},[],{"_3150":66162,"_27690":66139,"_19203":113096,"_5":13195,"_26191":113038,"_2648":113097},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3150":66163,"_27690":66139,"_19203":113099,"_5":13195,"_26191":113038,"_2648":113100},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3150":66164,"_27690":66139,"_19203":113102,"_5":13195,"_26191":113038,"_2648":113103},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3150":66165,"_27690":66139,"_19203":113105,"_5":13195,"_26191":113038,"_2648":113106},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3150":66166,"_27690":66139,"_19203":113108,"_5":13195,"_26191":113042,"_2648":113109},[],"Revisa cada frontera por separado:",{"_3150":66167,"_27690":66139,"_19203":113111,"_5":13195,"_26191":113042,"_2648":113112},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3150":66168,"_27690":66139,"_19203":113114,"_5":13195,"_26191":113042,"_2648":113115},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3150":66169,"_27690":66139,"_19203":113117,"_5":13195,"_26191":113042,"_2648":113118},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3150":66170,"_27690":66139,"_19203":113120,"_5":13195,"_26191":113042,"_2648":113121},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3150":66171,"_27690":66139,"_19203":113123,"_5":13195,"_26191":113042,"_2648":113124},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3150":66172,"_27690":66139,"_19203":113126,"_5":13195,"_26191":113042,"_2648":113127},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3150":66173,"_27690":66139,"_19203":113129,"_5":13195,"_26191":113046,"_2648":113130},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3150":66174,"_27690":66139,"_19203":113132,"_5":13195,"_26191":113046,"_2648":113133},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3150":66175,"_27690":66175,"_5":13521,"_2648":113135,"_28032":113136,"_19203":113138,"_26191":66175},"3.8.0 a 4.0.0",[45000,113137],"Actualizaciones",[],{"_3150":66176,"_27690":66175,"_19203":113140,"_5":13195,"_26191":66175,"_2648":113141},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3150":66177,"_27690":66175,"_5":28029,"_19203":113143,"_26191":113144,"_2648":113145},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3150":66178,"_27690":66175,"_5":28029,"_19203":113147,"_26191":113148,"_2648":113149},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3150":66179,"_27690":66175,"_5":28029,"_19203":113151,"_26191":113152,"_2648":113153},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3150":66180,"_27690":66175,"_5":28029,"_19203":113155,"_26191":113156,"_2648":113157},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3150":66181,"_27690":66175,"_5":28029,"_19203":113159,"_26191":113160,"_2648":113161},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3150":66182,"_27690":66175,"_5":28029,"_19203":113163,"_26191":113164,"_2648":113165},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3150":66183,"_27690":66175,"_5":28029,"_19203":113167,"_26191":113168,"_2648":52521},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3150":66184,"_27690":66175,"_5":28029,"_19203":113170,"_26191":113171,"_2648":113172},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3150":66185,"_27690":66175,"_5":28029,"_19203":113174,"_26191":113175,"_2648":113176},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3150":66186,"_27690":66175,"_5":28029,"_19203":113178,"_26191":113179,"_2648":113180},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3150":66187,"_27690":66175,"_5":28029,"_19203":113182,"_26191":113183,"_2648":113184},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3150":66188,"_27690":66175,"_5":28029,"_19203":113186,"_26191":113187,"_2648":113188},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3150":66189,"_27690":66175,"_5":28029,"_19203":113190,"_26191":113191,"_2648":113192},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3150":66190,"_27690":66175,"_5":28029,"_19203":113194,"_26191":113195,"_2648":113196},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3150":66191,"_27690":66175,"_5":28029,"_19203":113198,"_26191":113199,"_2648":113200},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3150":66192,"_27690":66175,"_5":28029,"_19203":113202,"_26191":113203,"_2648":113204},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3150":66193,"_27690":66175,"_5":28029,"_19203":113206,"_26191":113207,"_2648":113208},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3150":66194,"_27690":66175,"_5":28029,"_19203":113210,"_26191":113211,"_2648":113212},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3150":66195,"_27690":66175,"_5":28029,"_19203":113214,"_26191":113215,"_2648":113216},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3150":66196,"_27690":66175,"_5":28029,"_19203":113218,"_26191":113219,"_2648":113220},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3150":66197,"_27690":66175,"_5":28029,"_19203":113222,"_26191":113223,"_2648":113224},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3150":66198,"_27690":66175,"_5":28029,"_19203":113226,"_26191":113227,"_2648":113228},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3150":66199,"_27690":66175,"_5":28029,"_19203":113230,"_26191":113231,"_2648":113232},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3150":66200,"_27690":66175,"_5":28029,"_19203":113234,"_26191":113235,"_2648":113236},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3150":66201,"_27690":66175,"_5":28029,"_19203":113238,"_26191":113239,"_2648":113240},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3150":66202,"_27690":66175,"_5":28029,"_19203":113242,"_26191":113243,"_2648":113244},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3150":66203,"_27690":66175,"_5":28029,"_19203":113246,"_26191":113247,"_2648":113248},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3150":66204,"_27690":66175,"_5":28029,"_19203":113250,"_26191":113251,"_2648":113252},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3150":66205,"_27690":66175,"_5":28029,"_19203":113254,"_26191":113255,"_2648":113256},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3150":66206,"_27690":66175,"_5":28029,"_19203":113258,"_26191":113259,"_2648":113260},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3150":66207,"_27690":66175,"_5":28029,"_19203":113262,"_26191":113263,"_2648":113264},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3150":66208,"_27690":66175,"_5":28029,"_19203":113266,"_26191":113267,"_2648":113268},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3150":66209,"_27690":66175,"_5":28029,"_19203":113270,"_26191":113271,"_2648":113272},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3150":66210,"_27690":66175,"_5":28029,"_19203":113274,"_26191":113275,"_2648":109625},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3150":66211,"_27690":66175,"_5":28029,"_19203":113277,"_26191":113278,"_2648":113279},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3150":66212,"_27690":66175,"_5":28029,"_19203":113281,"_26191":113282,"_2648":113283},[],"/docs/pr-preview/pr-40/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3150":66213,"_27690":66175,"_19203":113285,"_5":13195,"_26191":66175,"_2648":113286},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3150":66214,"_27690":66175,"_19203":113288,"_5":13195,"_26191":66175,"_2648":113289},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3150":66215,"_27690":66175,"_19203":113291,"_5":13195,"_26191":66175,"_2648":113292},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3150":66216,"_27690":66175,"_19203":113294,"_5":13195,"_26191":66175,"_2648":113295},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3150":66217,"_27690":66175,"_19203":113297,"_5":13195,"_26191":66175,"_2648":113298},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3150":66218,"_27690":66175,"_19203":113300,"_5":13195,"_26191":66175,"_2648":113301},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3150":66219,"_27690":66175,"_19203":113303,"_5":13195,"_26191":66175,"_2648":113304},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3150":66220,"_27690":66175,"_19203":113306,"_5":13195,"_26191":113148,"_2648":113307},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3150":66221,"_27690":66175,"_19203":113309,"_5":13195,"_26191":113148,"_2648":113310},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3150":66222,"_27690":66175,"_19203":113312,"_5":13195,"_26191":113152,"_2648":113313},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3150":66223,"_27690":66175,"_19203":113315,"_5":13195,"_26191":113152,"_2648":113316},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3150":66224,"_27690":66175,"_19203":113318,"_5":13195,"_26191":113156,"_2648":113319},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3150":66225,"_27690":66175,"_19203":113321,"_5":13195,"_26191":113160,"_2648":113322},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3150":66226,"_27690":66175,"_19203":113324,"_5":13195,"_26191":113160,"_2648":113325},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3150":66227,"_27690":66175,"_19203":113327,"_5":13195,"_26191":113160,"_2648":113328},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3150":66228,"_27690":66175,"_19203":113330,"_5":13195,"_26191":113160,"_2648":113331},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3150":66229,"_27690":66175,"_19203":113333,"_5":13195,"_26191":113160,"_2648":113334},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3150":66230,"_27690":66175,"_19203":113336,"_5":13195,"_26191":113164,"_2648":113337},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3150":66231,"_27690":66175,"_19203":113339,"_5":13195,"_26191":113164,"_2648":113340},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3150":66232,"_27690":66175,"_19203":113342,"_5":13195,"_26191":113164,"_2648":113343},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3150":66233,"_27690":66175,"_19203":113345,"_5":13195,"_26191":113164,"_2648":113346},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3150":66234,"_27690":66175,"_19203":113348,"_5":13195,"_26191":113164,"_2648":113349},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3150":66235,"_27690":66175,"_19203":113351,"_5":13195,"_26191":113168,"_2648":113352},[],"Cambio",{"_3150":66236,"_27690":66175,"_19203":113354,"_5":13195,"_26191":113168,"_2648":113355},[],"A quién afecta",{"_3150":66237,"_27690":66175,"_19203":113357,"_5":13195,"_26191":113168,"_2648":113358},[],"Gravedad",{"_3150":66238,"_27690":66175,"_19203":113360,"_5":13195,"_26191":113168,"_2648":113361},[],"Acción",{"_3150":66239,"_27690":66175,"_19203":113363,"_5":13195,"_26191":113168,"_2648":113176},[],{"_3150":66240,"_27690":66175,"_19203":113365,"_5":13195,"_26191":113168,"_2648":113366},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3150":66241,"_27690":66175,"_19203":113368,"_5":13195,"_26191":113168,"_2648":113369},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3150":66242,"_27690":66175,"_19203":113371,"_5":13195,"_26191":113168,"_2648":113372},[],"Copiar los datos a los volúmenes nuevos",{"_3150":66243,"_27690":66175,"_19203":113374,"_5":13195,"_26191":113168,"_2648":113180},[],{"_3150":66244,"_27690":66175,"_19203":113376,"_5":13195,"_26191":113168,"_2648":113377},[],"Todas las releases de Helm",{"_3150":66245,"_27690":66175,"_19203":113379,"_5":13195,"_26191":113168,"_2648":113380},[],"Alta: `helm upgrade` falla",{"_3150":66246,"_27690":66175,"_19203":113382,"_5":13195,"_26191":113168,"_2648":113383},[],"Eliminar o renombrar las claves heredadas",{"_3150":66247,"_27690":66175,"_19203":113385,"_5":13195,"_26191":113168,"_2648":113184},[],{"_3150":66248,"_27690":66175,"_19203":113387,"_5":13195,"_26191":113168,"_2648":113388},[],"Todos los despliegues",{"_3150":66249,"_27690":66175,"_19203":113390,"_5":13195,"_26191":113168,"_2648":113391},[],"Alta: sin principal de bootstrap no hay administrador",{"_3150":66250,"_27690":66175,"_19203":113393,"_5":13195,"_26191":113168,"_2648":113394},[],"Configurar `services.authz`",{"_3150":66251,"_27690":66175,"_19203":113396,"_5":13195,"_26191":113168,"_2648":113188},[],{"_3150":66252,"_27690":66175,"_19203":113398,"_5":13195,"_26191":113168,"_2648":113377},[],{"_3150":66253,"_27690":66175,"_19203":113400,"_5":13195,"_26191":113168,"_2648":113401},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3150":66254,"_27690":66175,"_19203":113403,"_5":13195,"_26191":113168,"_2648":113404},[],"Mover JWKS y roles a `services.authz`",{"_3150":66255,"_27690":66175,"_19203":113406,"_5":13195,"_26191":113168,"_2648":113208},[],{"_3150":66256,"_27690":66175,"_19203":113408,"_5":13195,"_26191":113168,"_2648":113409},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3150":66257,"_27690":66175,"_19203":113411,"_5":13195,"_26191":113168,"_2648":113412},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3150":66258,"_27690":66175,"_19203":113414,"_5":13195,"_26191":113168,"_2648":113415},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3150":66259,"_27690":66175,"_19203":113417,"_5":13195,"_26191":113168,"_2648":113212},[],{"_3150":66260,"_27690":66175,"_19203":113419,"_5":13195,"_26191":113168,"_2648":113420},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3150":66261,"_27690":66175,"_19203":113422,"_5":13195,"_26191":113168,"_2648":113423},[],"Alta: el backend ya no arranca con ellos",{"_3150":66262,"_27690":66175,"_19203":113425,"_5":13195,"_26191":113168,"_2648":113426},[],"Pasar a PostgreSQL antes de actualizar",{"_3150":66263,"_27690":66175,"_19203":113428,"_5":13195,"_26191":113168,"_2648":113429},[],"Webhooks con referencias a archivos",{"_3150":66264,"_27690":66175,"_19203":113431,"_5":13195,"_26191":113168,"_2648":113432},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3150":66265,"_27690":66175,"_19203":113434,"_5":13195,"_26191":113168,"_2648":113435},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3150":66266,"_27690":66175,"_19203":113437,"_5":13195,"_26191":113168,"_2648":113438},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3150":66267,"_27690":66175,"_19203":113440,"_5":13195,"_26191":113168,"_2648":113192},[],{"_3150":66268,"_27690":66175,"_19203":113442,"_5":13195,"_26191":113168,"_2648":113443},[],"Releases con identidades por servicio o material de claves montado",{"_3150":66269,"_27690":66175,"_19203":113445,"_5":13195,"_26191":113168,"_2648":113446},[],"Media: los servicios no pueden leer sus archivos",{"_3150":66270,"_27690":66175,"_19203":113448,"_5":13195,"_26191":113168,"_2648":113449},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3150":66271,"_27690":66175,"_19203":113451,"_5":13195,"_26191":113168,"_2648":113196},[],{"_3150":66272,"_27690":66175,"_19203":113453,"_5":13195,"_26191":113168,"_2648":113454},[],"Releases que definen `amqp.tls`",{"_3150":66273,"_27690":66175,"_19203":113456,"_5":13195,"_26191":113168,"_2648":113457},[],"Media: los clientes se conectan al puerto equivocado",{"_3150":66274,"_27690":66175,"_19203":113459,"_5":13195,"_26191":113168,"_2648":113460},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3150":66275,"_27690":66175,"_19203":113462,"_5":13195,"_26191":113168,"_2648":113216},[],{"_3150":66276,"_27690":66175,"_19203":113464,"_5":13195,"_26191":113168,"_2648":113465},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3150":66277,"_27690":66175,"_19203":113467,"_5":13195,"_26191":113168,"_2648":113468},[],"Media: las claves de CA quedan sin gestionar",{"_3150":66278,"_27690":66175,"_19203":113470,"_5":13195,"_26191":113168,"_2648":113471},[],"Ejecutar la migración de CA a KMS",{"_3150":66279,"_27690":66175,"_19203":113473,"_5":13195,"_26191":113168,"_2648":113474},[],"Verificación del certificado del receptor",{"_3150":66280,"_27690":66175,"_19203":113476,"_5":13195,"_26191":113168,"_2648":113477},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3150":66281,"_27690":66175,"_19203":113479,"_5":13195,"_26191":113168,"_2648":113480},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3150":66282,"_27690":66175,"_19203":113482,"_5":13195,"_26191":113168,"_2648":113483},[],"Poner `insecure_skip_verify` a `false`",{"_3150":66283,"_27690":66175,"_19203":113485,"_5":13195,"_26191":113168,"_2648":113228},[],{"_3150":66284,"_27690":66175,"_19203":113487,"_5":13195,"_26191":113168,"_2648":113488},[],"Scripts y consolas que editan DMS por API",{"_3150":66285,"_27690":66175,"_19203":113490,"_5":13195,"_26191":113168,"_2648":113491},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3150":66286,"_27690":66175,"_19203":113493,"_5":13195,"_26191":113168,"_2648":113494},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3150":66287,"_27690":66175,"_19203":113496,"_5":13195,"_26191":113168,"_2648":113244},[],{"_3150":66288,"_27690":66175,"_19203":113498,"_5":13195,"_26191":113168,"_2648":113499},[],"Consumidores que leen el campo `events` del dispositivo",{"_3150":66289,"_27690":66175,"_19203":113501,"_5":13195,"_26191":113168,"_2648":113502},[],"Media: el campo desaparece",{"_3150":66290,"_27690":66175,"_19203":113504,"_5":13195,"_26191":113168,"_2648":113505},[],"Usar los nuevos endpoints de eventos",{"_3150":66291,"_27690":66175,"_19203":113507,"_5":13195,"_26191":113168,"_2648":113200},[],{"_3150":66292,"_27690":66175,"_19203":113509,"_5":13195,"_26191":113168,"_2648":113510},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3150":66293,"_27690":66175,"_19203":113512,"_5":13195,"_26191":113168,"_2648":113513},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3150":66294,"_27690":66175,"_19203":113515,"_5":13195,"_26191":113168,"_2648":113516},[],"Actualizar el archivo de values",{"_3150":66295,"_27690":66175,"_19203":113518,"_5":13195,"_26191":113168,"_2648":113236},[],{"_3150":66296,"_27690":66175,"_19203":113520,"_5":13195,"_26191":113168,"_2648":113521},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3150":66297,"_27690":66175,"_19203":113523,"_5":13195,"_26191":113168,"_2648":113524},[],"Baja: prevalece el ID de la URL",{"_3150":66298,"_27690":66175,"_19203":113526,"_5":13195,"_26191":113168,"_2648":113527},[],"Enviar el ID en la URL",{"_3150":66299,"_27690":66175,"_19203":113529,"_5":13195,"_26191":113168,"_2648":113240},[],{"_3150":66300,"_27690":66175,"_19203":113531,"_5":13195,"_26191":113168,"_2648":113532},[],"Consumidores que comparan el `type` del certificado",{"_3150":66301,"_27690":66175,"_19203":113534,"_5":13195,"_26191":113168,"_2648":113535},[],"Baja: dos valores cambian de nombre",{"_3150":66302,"_27690":66175,"_19203":113537,"_5":13195,"_26191":113168,"_2648":113538},[],"Adaptar los consumidores",{"_3150":66303,"_27690":66175,"_19203":113540,"_5":13195,"_26191":113168,"_2648":113232},[],{"_3150":66304,"_27690":66175,"_19203":113542,"_5":13195,"_26191":113168,"_2648":113543},[],"Cualquier DMS",{"_3150":66305,"_27690":66175,"_19203":113545,"_5":13195,"_26191":113168,"_2648":113546},[],"Baja: solo informativo",{"_3150":66306,"_27690":66175,"_19203":113548,"_5":13195,"_26191":113168,"_2648":113549},[],"Revisar ambos bloques antes de editar",{"_3150":66307,"_27690":66175,"_19203":113551,"_5":13195,"_26191":113175,"_2648":113552},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3150":66308,"_27690":66175,"_19203":113554,"_5":13195,"_26191":113175,"_2648":113555},[],"El paso 4 de la guía de migración copia los datos.",{"_3150":66309,"_27690":66175,"_19203":113557,"_5":13195,"_26191":113179,"_2648":113558},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3150":66310,"_27690":66175,"_19203":113560,"_5":13195,"_26191":113183,"_2648":113561},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3150":66311,"_27690":66175,"_19203":113563,"_5":13195,"_26191":113187,"_2648":113564},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3150":66312,"_27690":66175,"_19203":113566,"_5":13195,"_26191":113191,"_2648":113567},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3150":66313,"_27690":66175,"_19203":113569,"_5":13195,"_26191":113191,"_2648":113570},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3150":66314,"_27690":66175,"_19203":113572,"_5":13195,"_26191":113195,"_2648":113573},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3150":66315,"_27690":66175,"_19203":113575,"_5":13195,"_26191":113199,"_2648":113576},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3150":66316,"_27690":66175,"_19203":113578,"_5":13195,"_26191":113199,"_2648":113579},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3150":66317,"_27690":66175,"_19203":113581,"_5":13195,"_26191":113199,"_2648":113582},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3150":66318,"_27690":66175,"_19203":113584,"_5":13195,"_26191":113199,"_2648":113585},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3150":66319,"_27690":66175,"_19203":113587,"_5":13195,"_26191":113199,"_2648":113588},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3150":66320,"_27690":66175,"_19203":113590,"_5":13195,"_26191":113199,"_2648":113591},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3150":66321,"_27690":66175,"_19203":113593,"_5":13195,"_26191":113207,"_2648":113594},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3150":66322,"_27690":66175,"_19203":113596,"_5":13195,"_26191":113207,"_2648":113597},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3150":66323,"_27690":66175,"_19203":113599,"_5":13195,"_26191":113207,"_2648":113600},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3150":66324,"_27690":66175,"_19203":113602,"_5":13195,"_26191":113207,"_2648":113603},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3150":66325,"_27690":66175,"_19203":113605,"_5":13195,"_26191":113207,"_2648":113606},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3150":66326,"_27690":66175,"_19203":113608,"_5":13195,"_26191":113211,"_2648":113609},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3150":66327,"_27690":66175,"_19203":113611,"_5":13195,"_26191":113215,"_2648":113612},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3150":66328,"_27690":66175,"_19203":113614,"_5":13195,"_26191":113215,"_2648":113615},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3150":66329,"_27690":66175,"_19203":113617,"_5":13195,"_26191":113215,"_2648":113618},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3150":66330,"_27690":66175,"_19203":113620,"_5":13195,"_26191":113215,"_2648":113621},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3150":66331,"_27690":66175,"_19203":113623,"_5":13195,"_26191":113215,"_2648":113624},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3150":66332,"_27690":66175,"_19203":113626,"_5":13195,"_26191":113215,"_2648":113627},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3150":66333,"_27690":66175,"_19203":113629,"_5":13195,"_26191":113223,"_2648":113630},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3150":66334,"_27690":66175,"_19203":113632,"_5":13195,"_26191":113223,"_2648":113633},[],"Campo en 3.8.0",{"_3150":66335,"_27690":66175,"_19203":113635,"_5":13195,"_26191":113223,"_2648":113636},[],"Campo en 4.0.0",{"_3150":66336,"_27690":66175,"_19203":113638,"_5":13195,"_26191":113223,"_2648":52992},[],{"_3150":66337,"_27690":66175,"_19203":113640,"_5":13195,"_26191":113223,"_2648":113641},[],"`insecure_skip_verify` (con el valor negado)",{"_3150":66338,"_27690":66175,"_19203":113643,"_5":13195,"_26191":113223,"_2648":52998},[],{"_3150":66339,"_27690":66175,"_19203":113645,"_5":13195,"_26191":113223,"_2648":53001},[],{"_3150":66340,"_27690":66175,"_19203":113647,"_5":13195,"_26191":113223,"_2648":53004},[],{"_3150":66341,"_27690":66175,"_19203":113649,"_5":13195,"_26191":113223,"_2648":53007},[],{"_3150":66342,"_27690":66175,"_19203":113651,"_5":13195,"_26191":113223,"_2648":53010},[],{"_3150":66343,"_27690":66175,"_19203":113653,"_5":13195,"_26191":113223,"_2648":53013},[],{"_3150":66344,"_27690":66175,"_19203":113655,"_5":13195,"_26191":113223,"_2648":113656},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3150":66345,"_27690":66175,"_19203":113658,"_5":13195,"_26191":113223,"_2648":113659},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3150":66346,"_27690":66175,"_19203":113661,"_5":13195,"_26191":113223,"_2648":113662},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3150":66347,"_27690":66175,"_19203":113664,"_5":13195,"_26191":113227,"_2648":113665},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3150":66348,"_27690":66175,"_19203":113667,"_5":13195,"_26191":113227,"_2648":113668},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3150":66349,"_27690":66175,"_19203":113670,"_5":13195,"_26191":113227,"_2648":113671},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3150":66350,"_27690":66175,"_19203":113673,"_5":13195,"_26191":113231,"_2648":113674},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. Si la versión de la consola no expone los ajustes independientes, edítalos mediante la API DMS.",{"_3150":66351,"_27690":66175,"_19203":113676,"_5":13195,"_26191":113235,"_2648":113677},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3150":66352,"_27690":66175,"_19203":113679,"_5":13195,"_26191":113239,"_2648":113680},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3150":66353,"_27690":66175,"_19203":113682,"_5":13195,"_26191":113243,"_2648":113683},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3150":66354,"_27690":66175,"_19203":113685,"_5":13195,"_26191":113243,"_2648":113686},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3150":66355,"_27690":66175,"_19203":113688,"_5":13195,"_26191":113243,"_2648":113689},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3150":66356,"_27690":66175,"_19203":113691,"_5":13195,"_26191":113243,"_2648":113692},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3150":66357,"_27690":66175,"_19203":113694,"_5":13195,"_26191":113247,"_2648":113695},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3150":66358,"_27690":66175,"_19203":113697,"_5":13195,"_26191":113251,"_2648":113698},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3150":66359,"_27690":66175,"_19203":113700,"_5":13195,"_26191":113251,"_2648":113701},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3150":66360,"_27690":66175,"_19203":113703,"_5":13195,"_26191":113251,"_2648":113704},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3150":66361,"_27690":66175,"_19203":113706,"_5":13195,"_26191":113251,"_2648":113707},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3150":66362,"_27690":66175,"_19203":113709,"_5":13195,"_26191":113251,"_2648":113710},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3150":66363,"_27690":66175,"_19203":113712,"_5":13195,"_26191":113255,"_2648":113713},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3150":66364,"_27690":66175,"_19203":113715,"_5":13195,"_26191":113255,"_2648":113716},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3150":66365,"_27690":66175,"_19203":113718,"_5":13195,"_26191":113255,"_2648":113719},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3150":66366,"_27690":66175,"_19203":113721,"_5":13195,"_26191":113255,"_2648":113722},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3150":66367,"_27690":66175,"_19203":113724,"_5":13195,"_26191":113255,"_2648":113725},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3150":66368,"_27690":66175,"_19203":113727,"_5":13195,"_26191":113255,"_2648":113728},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3150":66369,"_27690":66175,"_19203":113730,"_5":13195,"_26191":113255,"_2648":113731},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3150":66370,"_27690":66175,"_19203":113733,"_5":13195,"_26191":113255,"_2648":113734},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3150":66371,"_27690":66175,"_19203":113736,"_5":13195,"_26191":113255,"_2648":113737},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3150":66372,"_27690":66175,"_19203":113739,"_5":13195,"_26191":113255,"_2648":113740},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3150":66373,"_27690":66175,"_19203":113742,"_5":13195,"_26191":113255,"_2648":113743},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3150":66374,"_27690":66175,"_19203":113745,"_5":13195,"_26191":113255,"_2648":113746},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3150":66375,"_27690":66175,"_19203":113748,"_5":13195,"_26191":113259,"_2648":113749},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3150":66376,"_27690":66175,"_19203":113751,"_5":13195,"_26191":113259,"_2648":113752},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3150":66377,"_27690":66175,"_19203":113754,"_5":13195,"_26191":113263,"_2648":113755},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3150":66378,"_27690":66175,"_19203":113757,"_5":13195,"_26191":113263,"_2648":113758},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3150":66379,"_27690":66175,"_19203":113760,"_5":13195,"_26191":113263,"_2648":113761},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3150":66380,"_27690":66175,"_19203":113763,"_5":13195,"_26191":113263,"_2648":113764},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3150":66381,"_27690":66175,"_19203":113766,"_5":13195,"_26191":113263,"_2648":113767},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3150":66382,"_27690":66175,"_19203":113769,"_5":13195,"_26191":113263,"_2648":113770},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3150":66383,"_27690":66175,"_19203":113772,"_5":13195,"_26191":113263,"_2648":113773},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3150":66384,"_27690":66175,"_19203":113775,"_5":13195,"_26191":113263,"_2648":113776},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3150":66385,"_27690":66175,"_19203":113778,"_5":13195,"_26191":113263,"_2648":113779},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3150":66386,"_27690":66175,"_19203":113781,"_5":13195,"_26191":113263,"_2648":113782},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3150":66387,"_27690":66175,"_19203":113784,"_5":13195,"_26191":113263,"_2648":113785},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3150":66388,"_27690":66175,"_19203":113787,"_5":13195,"_26191":113267,"_2648":113788},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3150":66389,"_27690":66175,"_19203":113790,"_5":13195,"_26191":113267,"_2648":113791},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3150":66390,"_27690":66175,"_19203":113793,"_5":13195,"_26191":113271,"_2648":113794},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3150":66391,"_27690":66175,"_19203":113796,"_5":13195,"_26191":113271,"_2648":113797},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3150":66392,"_27690":66175,"_19203":113799,"_5":13195,"_26191":113271,"_2648":113800},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3150":66393,"_27690":66175,"_19203":113802,"_5":13195,"_26191":113271,"_2648":113803},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3150":66394,"_27690":66175,"_19203":113805,"_5":13195,"_26191":113271,"_2648":113806},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3150":66395,"_27690":66175,"_19203":113808,"_5":13195,"_26191":113275,"_2648":113809},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3150":66396,"_27690":66175,"_19203":113811,"_5":13195,"_26191":113275,"_2648":113812},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3150":66397,"_27690":66175,"_19203":113814,"_5":13195,"_26191":113275,"_2648":113815},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3150":66398,"_27690":66175,"_19203":113817,"_5":13195,"_26191":113275,"_2648":113818},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3150":66399,"_27690":66175,"_19203":113820,"_5":13195,"_26191":113275,"_2648":113821},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3150":66400,"_27690":66175,"_19203":113823,"_5":13195,"_26191":113275,"_2648":113824},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3150":66401,"_27690":66175,"_19203":113826,"_5":13195,"_26191":113275,"_2648":113827},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3150":66402,"_27690":66175,"_19203":113829,"_5":13195,"_26191":113278,"_2648":113830},[],"Tras la actualización, comprueba en este orden:",{"_3150":66403,"_27690":66175,"_19203":113832,"_5":13195,"_26191":113278,"_2648":113833},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3150":66404,"_27690":66175,"_19203":113835,"_5":13195,"_26191":113278,"_2648":113836},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3150":66405,"_27690":66175,"_19203":113838,"_5":13195,"_26191":113278,"_2648":113839},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3150":66406,"_27690":66175,"_19203":113841,"_5":13195,"_26191":113278,"_2648":113842},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3150":66407,"_27690":66175,"_19203":113844,"_5":13195,"_26191":113278,"_2648":113845},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3150":66408,"_27690":66175,"_19203":113847,"_5":13195,"_26191":113278,"_2648":113848},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3150":66409,"_27690":66175,"_19203":113850,"_5":13195,"_26191":113278,"_2648":113851},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3150":66410,"_27690":66175,"_19203":113853,"_5":13195,"_26191":113278,"_2648":113854},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3150":66411,"_27690":66175,"_19203":113856,"_5":13195,"_26191":113278,"_2648":113857},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3150":66412,"_27690":66175,"_19203":113859,"_5":13195,"_26191":113278,"_2648":113860},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3150":66413,"_27690":66175,"_19203":113862,"_5":13195,"_26191":113278,"_2648":113863},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3150":66414,"_27690":66175,"_19203":113865,"_5":13195,"_26191":113278,"_2648":113866},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3150":66415,"_27690":66175,"_19203":113868,"_5":13195,"_26191":113278,"_2648":113869},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3150":66416,"_27690":66175,"_19203":113871,"_5":13195,"_26191":113278,"_2648":113872},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3150":66417,"_27690":66175,"_19203":113874,"_5":13195,"_26191":113282,"_2648":113875},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3150":66418,"_27690":66175,"_19203":113877,"_5":13195,"_26191":113282,"_2648":113878},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3150":66419,"_27690":66175,"_19203":113880,"_5":13195,"_26191":113282,"_2648":113881},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3150":66420,"_27690":66175,"_19203":113883,"_5":13195,"_26191":113282,"_2648":113884},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3150":66421,"_27690":66175,"_19203":113886,"_5":13195,"_26191":113282,"_2648":113887},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_53250":113889,"_53252":113890,"_53254":113891,"_53256":113892,"_16740":2670,"_63787":2670},"spanish",[2648,27690,5,26191],{"_2648":22963,"_27690":22963,"_5":22963,"_26191":22963},{"_2648":113893,"_27690":116524,"_5":119155,"_26191":121786},{"_4215":113894,"_53260":113895,"_5":22963},{"_13250":4119,"_13620":6296,"_13627":5383,"_11891":9326,"_13634":9920,"_18228":6855,"_13271":4594,"_13278":5278,"_26743":6953,"_27134":6901,"_27155":5285,"_26761":5628,"_31796":14242,"_27166":3092,"_27195":2697,"_31803":6749,"_31806":3803,"_31809":5954,"_31812":4169,"_27543":4303,"_31817":17234,"_31819":3856,"_27573":2969,"_27533":14438,"_31823":14481,"_31826":6292,"_31828":4330,"_27184":5281,"_27538":7585,"_27597":5505,"_31833":5562,"_31835":23119,"_31837":6385,"_31839":5934,"_31841":3195,"_31843":3680,"_31845":11818,"_31847":7064,"_31849":14650,"_26813":6343,"_31852":2982,"_31854":6905,"_26807":3078,"_31857":14457,"_31859":6826,"_31861":6459,"_31864":5851,"_26853":4405,"_31868":6965,"_26734":22392,"_31871":3349,"_26766":4199,"_31874":6954,"_31876":6311,"_31879":3381,"_27563":9323,"_31882":5376,"_31884":8292,"_31887":5435,"_31889":6864,"_31891":2738,"_31893":7851,"_31895":4536,"_18231":5051,"_31898":14439,"_31900":9560,"_26787":6386,"_27178":3194,