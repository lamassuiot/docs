145,"_33562":48148,"_33564":48151,"_33566":48154,"_33568":48157,"_33570":48160,"_33572":48163,"_33574":48166,"_33576":48169,"_33578":48172,"_33580":48175,"_33582":48178},{"_2856":15,"_25078":15,"_5":12261,"_2383":40747,"_25413":40748,"_17499":40752,"_23735":15},"Deploy from AWS Marketplace",[40749,40750,40751],"Docs","Deployment","Other models",[],{"_2856":16,"_25078":15,"_17499":40754,"_5":17394,"_23735":15,"_2383":40755},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2856":17,"_25078":15,"_5":25410,"_17499":40757,"_23735":40758,"_2383":40759},[],"/docs/pr-preview/pr-40/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2856":18,"_25078":15,"_5":25410,"_17499":40761,"_23735":40762,"_2383":40763},[],"/docs/pr-preview/pr-40/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2856":19,"_25078":15,"_5":25410,"_17499":40765,"_23735":40766,"_2383":40767},[],"/docs/pr-preview/pr-40/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2856":20,"_25078":15,"_5":25410,"_17499":40769,"_23735":40770,"_2383":40771},[],"/docs/pr-preview/pr-40/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2856":21,"_25078":15,"_5":25410,"_17499":40773,"_23735":40774,"_2383":40775},[],"/docs/pr-preview/pr-40/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2856":22,"_25078":15,"_5":25410,"_17499":40777,"_23735":40778,"_2383":40779},[],"/docs/pr-preview/pr-40/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2856":23,"_25078":15,"_5":25410,"_17499":40781,"_23735":40782,"_2383":40783},[],"/docs/pr-preview/pr-40/deployment/aws-marketplace#next-step","Next step",{"_2856":24,"_25078":15,"_17499":40785,"_5":17394,"_23735":15,"_2383":40786},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2856":25,"_25078":15,"_17499":40788,"_5":17394,"_23735":40758,"_2383":40789},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2856":26,"_25078":15,"_17499":40791,"_5":17394,"_23735":40758,"_2383":40792},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2856":27,"_25078":15,"_17499":40794,"_5":17394,"_23735":40758,"_2383":40795},[],"A security group allowing the necessary endpoints.",{"_2856":28,"_25078":15,"_17499":40797,"_5":17394,"_23735":40762,"_2383":40798},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2856":29,"_25078":15,"_17499":40800,"_5":17394,"_23735":40762,"_2383":40801},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2856":30,"_25078":15,"_17499":40803,"_5":17394,"_23735":40762,"_2383":40804},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2856":31,"_25078":15,"_17499":40806,"_5":17394,"_23735":40766,"_2383":40807},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2856":32,"_25078":15,"_17499":40809,"_5":17394,"_23735":40770,"_2383":40810},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2856":33,"_25078":15,"_17499":40812,"_5":17394,"_23735":40774,"_2383":40813},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2856":34,"_25078":15,"_17499":40815,"_5":17394,"_23735":40778,"_2383":40816},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2856":35,"_25078":15,"_17499":40818,"_5":17394,"_23735":40782,"_2383":40819},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2856":36,"_25078":36,"_5":12261,"_2383":40821,"_25413":40822,"_17499":40823,"_23735":36},"Deploy Lamassu",[40749,40750],[],{"_2856":37,"_25078":36,"_17499":40825,"_5":17394,"_23735":36,"_2383":40826},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2856":38,"_25078":36,"_5":25410,"_17499":40828,"_23735":40829,"_2383":40830},[],"/docs/pr-preview/pr-40/deployment/overview#choose-a-model","Choose a model",{"_2856":39,"_25078":36,"_5":25410,"_17499":40832,"_23735":40833,"_2383":40834},[],"/docs/pr-preview/pr-40/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2856":40,"_25078":36,"_5":25410,"_17499":40836,"_23735":40837,"_2383":40838},[],"/docs/pr-preview/pr-40/deployment/overview#after-deployment","After deployment",{"_2856":41,"_25078":36,"_17499":40840,"_5":17394,"_23735":36,"_2383":40841},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2856":42,"_25078":36,"_17499":40843,"_5":17394,"_23735":40829,"_2383":40844},[],"Model",{"_2856":43,"_25078":36,"_17499":40846,"_5":17394,"_23735":40829,"_2383":40847},[],"Recommended for",{"_2856":44,"_25078":36,"_17499":40849,"_5":17394,"_23735":40829,"_2383":40850},[],"Who operates the infrastructure",{"_2856":45,"_25078":36,"_17499":40852,"_5":17394,"_23735":40829,"_2383":40853},[],"Starting point",{"_2856":46,"_25078":36,"_17499":40855,"_5":17394,"_23735":40829,"_2383":40856},[],"Kubernetes self-managed",{"_2856":47,"_25078":36,"_17499":40858,"_5":17394,"_23735":40829,"_2383":40859},[],"Production, regulated environments and custom deployments",{"_2856":48,"_25078":36,"_17499":40861,"_5":17394,"_23735":40829,"_2383":40862},[],"Your team",{"_2856":49,"_25078":36,"_17499":40864,"_5":17394,"_23735":40829,"_2383":40865},[],"Helm or Fastlane",{"_2856":50,"_25078":36,"_17499":40867,"_5":17394,"_23735":40829,"_2383":40868},[],"AWS Marketplace",{"_2856":51,"_25078":36,"_17499":40870,"_5":17394,"_23735":40829,"_2383":40871},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2856":52,"_25078":36,"_17499":40873,"_5":17394,"_23735":40829,"_2383":40862},[],{"_2856":53,"_25078":36,"_17499":40875,"_5":17394,"_23735":40829,"_2383":40876},[],"Preconfigured image on EC2",{"_2856":54,"_25078":36,"_17499":40878,"_5":17394,"_23735":40829,"_2383":40879},[],"SaaS",{"_2856":55,"_25078":36,"_17499":40881,"_5":17394,"_23735":40829,"_2383":40882},[],"Teams that want to use the platform without operating it",{"_2856":56,"_25078":36,"_17499":40884,"_5":17394,"_23735":40829,"_2383":40885},[],"Lamassu",{"_2856":57,"_25078":36,"_17499":40887,"_5":17394,"_23735":40829,"_2383":40888},[],"Managed subscription",{"_2856":58,"_25078":36,"_17499":40890,"_5":17394,"_23735":40829,"_2383":40891},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2856":59,"_25078":36,"_17499":40893,"_5":17394,"_23735":40829,"_2383":40894},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2856":60,"_25078":36,"_17499":40896,"_5":17394,"_23735":40829,"_2383":40897},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2856":61,"_25078":36,"_17499":40899,"_5":17394,"_23735":40833,"_2383":40900},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2856":62,"_25078":36,"_17499":40902,"_5":17394,"_23735":40837,"_2383":40903},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2856":63,"_25078":63,"_5":12261,"_2383":40905,"_25413":40906,"_17499":40907,"_23735":63},"Use Lamassu as SaaS",[40749,40750,40751],[],{"_2856":64,"_25078":63,"_17499":40909,"_5":17394,"_23735":63,"_2383":40910},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2856":65,"_25078":63,"_5":25410,"_17499":40912,"_23735":40913,"_2383":40914},[],"/docs/pr-preview/pr-40/deployment/saas#what-the-service-manages","What the service manages",{"_2856":66,"_25078":63,"_5":25410,"_17499":40916,"_23735":40917,"_2383":40918},[],"/docs/pr-preview/pr-40/deployment/saas#plans","Plans",{"_2856":67,"_25078":63,"_5":25410,"_17499":40920,"_23735":40921,"_2383":40922},[],"/docs/pr-preview/pr-40/deployment/saas#request-access","Request access",{"_2856":68,"_25078":63,"_17499":40924,"_5":17394,"_23735":63,"_2383":40925},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2856":69,"_25078":63,"_17499":40927,"_5":17394,"_23735":40913,"_2383":40928},[],"Platform availability and maintenance.",{"_2856":70,"_25078":63,"_17499":40930,"_5":17394,"_23735":40913,"_2383":40931},[],"Automatic backups.",{"_2856":71,"_25078":63,"_17499":40933,"_5":17394,"_23735":40913,"_2383":40934},[],"Version upgrades.",{"_2856":72,"_25078":63,"_17499":40936,"_5":17394,"_23735":40913,"_2383":40937},[],"Technical support and SLA according to your plan.",{"_2856":73,"_25078":63,"_17499":40939,"_5":17394,"_23735":40917,"_2383":40940},[],"Plan",{"_2856":74,"_25078":63,"_17499":40942,"_5":17394,"_23735":40917,"_2383":40943},[],"Devices",{"_2856":75,"_25078":63,"_17499":40945,"_5":17394,"_23735":40917,"_2383":40946},[],"Support",{"_2856":76,"_25078":63,"_17499":40948,"_5":17394,"_23735":40917,"_2383":40949},[],"SLA",{"_2856":77,"_25078":63,"_17499":40951,"_5":17394,"_23735":40917,"_2383":40952},[],"Starter",{"_2856":78,"_25078":63,"_17499":40954,"_5":17394,"_23735":40917,"_2383":40955},[],"Up to 1,000",{"_2856":79,"_25078":63,"_17499":40957,"_5":17394,"_23735":40917,"_2383":40958},[],"Email",{"_2856":80,"_25078":63,"_17499":40960,"_5":17394,"_23735":40917,"_2383":40961},[],"99.5 %",{"_2856":81,"_25078":63,"_17499":40963,"_5":17394,"_23735":40917,"_2383":40964},[],"Professional",{"_2856":82,"_25078":63,"_17499":40966,"_5":17394,"_23735":40917,"_2383":40967},[],"Up to 10,000",{"_2856":83,"_25078":63,"_17499":40969,"_5":17394,"_23735":40917,"_2383":40970},[],"Email and chat",{"_2856":84,"_25078":63,"_17499":40972,"_5":17394,"_23735":40917,"_2383":40973},[],"99.9 %",{"_2856":85,"_25078":63,"_17499":40975,"_5":17394,"_23735":40917,"_2383":40976},[],"Enterprise",{"_2856":86,"_25078":63,"_17499":40978,"_5":17394,"_23735":40917,"_2383":40979},[],"Unlimited",{"_2856":87,"_25078":63,"_17499":40981,"_5":17394,"_23735":40917,"_2383":40982},[],"Dedicated",{"_2856":88,"_25078":63,"_17499":40984,"_5":17394,"_23735":40917,"_2383":40985},[],"99.99 %",{"_2856":89,"_25078":63,"_17499":40987,"_5":17394,"_23735":40921,"_2383":40988},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2856":90,"_25078":63,"_17499":40990,"_5":17394,"_23735":40921,"_2383":40991},[],"When you receive your instance's credentials, continue with Get started.",{"_2856":91,"_25078":91,"_5":12261,"_2383":40993,"_25413":40994,"_17499":40995,"_23735":91},"Fastlane",[40749,40750,40856],[],{"_2856":92,"_25078":91,"_17499":40997,"_5":17394,"_23735":91,"_2383":40998},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2856":93,"_25078":91,"_5":25410,"_17499":41000,"_23735":41001,"_2383":41002},[],"/docs/pr-preview/pr-40/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2856":94,"_25078":91,"_5":25410,"_17499":41004,"_23735":41005,"_2383":41006},[],"/docs/pr-preview/pr-40/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2856":95,"_25078":91,"_5":25410,"_17499":41008,"_23735":41009,"_2383":40759},[],"/docs/pr-preview/pr-40/deployment/self-hosted/fastlane#before-you-begin",{"_2856":96,"_25078":91,"_5":25410,"_17499":41011,"_23735":41012,"_2383":41013},[],"/docs/pr-preview/pr-40/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2856":97,"_25078":91,"_5":25410,"_17499":41015,"_23735":41016,"_2383":41017},[],"/docs/pr-preview/pr-40/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2856":98,"_25078":91,"_5":25410,"_17499":41019,"_23735":41020,"_2383":41021},[],"/docs/pr-preview/pr-40/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2856":99,"_25078":91,"_5":25410,"_17499":41023,"_23735":41024,"_2383":41025},[],"/docs/pr-preview/pr-40/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2856":100,"_25078":91,"_5":25410,"_17499":41027,"_23735":41028,"_2383":41029},[],"/docs/pr-preview/pr-40/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2856":101,"_25078":91,"_5":25410,"_17499":41031,"_23735":41032,"_2383":41033},[],"/docs/pr-preview/pr-40/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2856":102,"_25078":91,"_5":25410,"_17499":41035,"_23735":41036,"_2383":41037},[],"/docs/pr-preview/pr-40/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2856":103,"_25078":91,"_17499":41039,"_5":17394,"_23735":41001,"_2383":41040},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2856":104,"_25078":91,"_17499":41042,"_5":17394,"_23735":41001,"_2383":41043},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2856":105,"_25078":91,"_17499":41045,"_5":17394,"_23735":41005,"_2383":41046},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2856":106,"_25078":91,"_17499":41048,"_5":17394,"_23735":41005,"_2383":41049},[],"Fastlane installs or configures",{"_2856":107,"_25078":91,"_17499":41051,"_5":17394,"_23735":41005,"_2383":41052},[],"You still provide",{"_2856":108,"_25078":91,"_17499":41054,"_5":17394,"_23735":41005,"_2383":41055},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2856":109,"_25078":91,"_17499":41057,"_5":17394,"_23735":41005,"_2383":41058},[],"The Kubernetes cluster, nodes and persistent storage",{"_2856":110,"_25078":91,"_17499":41060,"_5":17394,"_23735":41005,"_2383":41061},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2856":111,"_25078":91,"_17499":41063,"_5":17394,"_23735":41005,"_2383":41064},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2856":112,"_25078":91,"_17499":41066,"_5":17394,"_23735":41005,"_2383":41067},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2856":113,"_25078":91,"_17499":41069,"_5":17394,"_23735":41005,"_2383":41070},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2856":114,"_25078":91,"_17499":41072,"_5":17394,"_23735":41005,"_2383":41073},[],"Optional observability and lab HSM components",{"_2856":115,"_25078":91,"_17499":41075,"_5":17394,"_23735":41005,"_2383":41076},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2856":116,"_25078":91,"_17499":41078,"_5":17394,"_23735":41005,"_2383":41079},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2856":117,"_25078":91,"_17499":41081,"_5":17394,"_23735":41009,"_2383":41082},[],"You need:",{"_2856":118,"_25078":91,"_17499":41084,"_5":17394,"_23735":41009,"_2383":41085},[],"an existing Kubernetes cluster",{"_2856":119,"_25078":91,"_17499":41087,"_5":17394,"_23735":41009,"_2383":41088},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2856":120,"_25078":91,"_17499":41090,"_5":17394,"_23735":41009,"_2383":41091},[],"`yq`",{"_2856":121,"_25078":91,"_17499":41093,"_5":17394,"_23735":41009,"_2383":19804},[],{"_2856":122,"_25078":91,"_17499":41095,"_5":17394,"_23735":41009,"_2383":41096},[],"`jq` only when using `--sample-data`",{"_2856":123,"_25078":91,"_17499":41098,"_5":17394,"_23735":41009,"_2383":41099},[],"free external ports 80 and 443 on a single-node K3s host",{"_2856":124,"_25078":91,"_17499":41101,"_5":17394,"_23735":41009,"_2383":41102},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2856":125,"_25078":91,"_17499":41104,"_5":17394,"_23735":41009,"_2383":41105},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2856":126,"_25078":91,"_17499":41107,"_5":17394,"_23735":41012,"_2383":41108},[],"Run the script from a clone of the Helm repository:",{"_2856":127,"_25078":91,"_17499":41110,"_5":17394,"_23735":41012,"_2383":41111},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2856":128,"_25078":91,"_17499":41113,"_5":17394,"_23735":41016,"_2383":41114},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2856":129,"_25078":91,"_17499":41116,"_5":17394,"_23735":41016,"_2383":41117},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2856":130,"_25078":91,"_17499":41119,"_5":17394,"_23735":41016,"_2383":41120},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2856":131,"_25078":91,"_17499":41122,"_5":17394,"_23735":41016,"_2383":41123},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2856":132,"_25078":91,"_17499":41125,"_5":17394,"_23735":41020,"_2383":41126},[],"Option",{"_2856":133,"_25078":91,"_17499":41128,"_5":17394,"_23735":41020,"_2383":41129},[],"Default",{"_2856":134,"_25078":91,"_17499":41131,"_5":17394,"_23735":41020,"_2383":41132},[],"Purpose",{"_2856":135,"_25078":91,"_17499":41134,"_5":17394,"_23735":41020,"_2383":41135},[],"`-h`, `--help`",{"_2856":136,"_25078":91,"_17499":41137,"_5":17394,"_23735":41020,"_2383":41138},[],"—",{"_2856":137,"_25078":91,"_17499":41140,"_5":17394,"_23735":41020,"_2383":41141},[],"Show help",{"_2856":138,"_25078":91,"_17499":41143,"_5":17394,"_23735":41020,"_2383":41144},[],"`-c`, `--context`",{"_2856":139,"_25078":91,"_17499":41146,"_5":17394,"_23735":41020,"_2383":41147},[],"current context",{"_2856":140,"_25078":91,"_17499":41149,"_5":17394,"_23735":41020,"_2383":41150},[],"Select the kubeconfig context for kubectl and Helm",{"_2856":141,"_25078":91,"_17499":41152,"_5":17394,"_23735":41020,"_2383":41153},[],"`-n`, `--non-interactive`",{"_2856":142,"_25078":91,"_17499":41155,"_5":17394,"_23735":41020,"_2383":5346},[],{"_2856":143,"_25078":91,"_17499":41157,"_5":17394,"_23735":41020,"_2383":41158},[],"Skip prompts and generate dependency credentials",{"_2856":144,"_25078":91,"_17499":41160,"_5":17394,"_23735":41020,"_2383":41161},[],"`-ns`, `--namespace`",{"_2856":145,"_25078":91,"_17499":41163,"_5":17394,"_23735":41020,"_2383":41164},[],"`lamassu-dev`",{"_2856":146,"_25078":91,"_17499":41166,"_5":17394,"_23735":41020,"_2383":41167},[],"Namespace for the installation",{"_2856":147,"_25078":91,"_17499":41169,"_5":17394,"_23735":41020,"_2383":41170},[],"`-d`, `--domain`",{"_2856":148,"_25078":91,"_17499":41172,"_5":17394,"_23735":41020,"_2383":41173},[],"`dev.lamassu.io`",{"_2856":149,"_25078":91,"_17499":41175,"_5":17394,"_23735":41020,"_2383":41176},[],"Domain used by the UI, OIDC and certificate",{"_2856":150,"_25078":91,"_17499":41178,"_5":17394,"_23735":41020,"_2383":41179},[],"`-v`, `--version`",{"_2856":151,"_25078":91,"_17499":41181,"_5":17394,"_23735":41020,"_2383":12494},[],{"_2856":152,"_25078":91,"_17499":41183,"_5":17394,"_23735":41020,"_2383":41184},[],"Lamassu chart version",{"_2856":153,"_25078":91,"_17499":41186,"_5":17394,"_23735":41020,"_2383":41187},[],"`--https-port`",{"_2856":154,"_25078":91,"_17499":41189,"_5":17394,"_23735":41020,"_2383":41190},[],"`443`",{"_2856":155,"_25078":91,"_17499":41192,"_5":17394,"_23735":41020,"_2383":41193},[],"Gateway HTTPS listener port",{"_2856":156,"_25078":91,"_17499":41195,"_5":17394,"_23735":41020,"_2383":41196},[],"`--http-port`",{"_2856":157,"_25078":91,"_17499":41198,"_5":17394,"_23735":41020,"_2383":41199},[],"`80`",{"_2856":158,"_25078":91,"_17499":41201,"_5":17394,"_23735":41020,"_2383":41202},[],"Gateway HTTP listener port",{"_2856":159,"_25078":91,"_17499":41204,"_5":17394,"_23735":41020,"_2383":41205},[],"`--tls-crt`",{"_2856":160,"_25078":91,"_17499":41207,"_5":17394,"_23735":41020,"_2383":41138},[],{"_2856":161,"_25078":91,"_17499":41209,"_5":17394,"_23735":41020,"_2383":41210},[],"PEM certificate for downstream TLS",{"_2856":162,"_25078":91,"_17499":41212,"_5":17394,"_23735":41020,"_2383":41213},[],"`--tls-key`",{"_2856":163,"_25078":91,"_17499":41215,"_5":17394,"_23735":41020,"_2383":41138},[],{"_2856":164,"_25078":91,"_17499":41217,"_5":17394,"_23735":41020,"_2383":41218},[],"PEM private key for downstream TLS",{"_2856":165,"_25078":91,"_17499":41220,"_5":17394,"_23735":41020,"_2383":41221},[],"`-l`, `--local-chart-path`",{"_2856":166,"_25078":91,"_17499":41223,"_5":17394,"_23735":41020,"_2383":41224},[],"repository chart",{"_2856":167,"_25078":91,"_17499":41226,"_5":17394,"_23735":41020,"_2383":41227},[],"Use an unpacked local Lamassu chart",{"_2856":168,"_25078":91,"_17499":41229,"_5":17394,"_23735":41020,"_2383":41230},[],"`-ip`, `--gateway-ip`",{"_2856":169,"_25078":91,"_17499":41232,"_5":17394,"_23735":41020,"_2383":7244},[],{"_2856":170,"_25078":91,"_17499":41234,"_5":17394,"_23735":41020,"_2383":41235},[],"Override the address written to `gateway.addresses`",{"_2856":171,"_25078":91,"_17499":41237,"_5":17394,"_23735":41020,"_2383":41238},[],"`--otel`",{"_2856":172,"_25078":91,"_17499":41240,"_5":17394,"_23735":41020,"_2383":5346},[],{"_2856":173,"_25078":91,"_17499":41242,"_5":17394,"_23735":41020,"_2383":41243},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2856":174,"_25078":91,"_17499":41245,"_5":17394,"_23735":41020,"_2383":41246},[],"`--sample-data`",{"_2856":175,"_25078":91,"_17499":41248,"_5":17394,"_23735":41020,"_2383":5346},[],{"_2856":176,"_25078":91,"_17499":41250,"_5":17394,"_23735":41020,"_2383":41251},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2856":177,"_25078":91,"_17499":41253,"_5":17394,"_23735":41020,"_2383":41254},[],"`--with-hsm`",{"_2856":178,"_25078":91,"_17499":41256,"_5":17394,"_23735":41020,"_2383":5346},[],{"_2856":179,"_25078":91,"_17499":41258,"_5":17394,"_23735":41020,"_2383":41259},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2856":180,"_25078":91,"_17499":41261,"_5":17394,"_23735":41020,"_2383":41262},[],"`--softhsm-chart-path`",{"_2856":181,"_25078":91,"_17499":41264,"_5":17394,"_23735":41020,"_2383":41265},[],"`./charts/softhsm`",{"_2856":182,"_25078":91,"_17499":41267,"_5":17394,"_23735":41020,"_2383":41268},[],"Use a different local SoftHSM chart",{"_2856":183,"_25078":91,"_17499":41270,"_5":17394,"_23735":41020,"_2383":41271},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2856":184,"_25078":91,"_17499":41273,"_5":17394,"_23735":41024,"_2383":41274},[],"Fastlane:",{"_2856":185,"_25078":91,"_17499":41276,"_5":17394,"_23735":41024,"_2383":41277},[],"validates local tools and the selected cluster",{"_2856":186,"_25078":91,"_17499":41279,"_5":17394,"_23735":41024,"_2383":41280},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2856":187,"_25078":91,"_17499":41282,"_5":17394,"_23735":41024,"_2383":41283},[],"creates the namespace",{"_2856":188,"_25078":91,"_17499":41285,"_5":17394,"_23735":41024,"_2383":41286},[],"installs PostgreSQL and creates the required databases",{"_2856":189,"_25078":91,"_17499":41288,"_5":17394,"_23735":41024,"_2383":41289},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2856":190,"_25078":91,"_17499":41291,"_5":17394,"_23735":41024,"_2383":41292},[],"installs RabbitMQ",{"_2856":191,"_25078":91,"_17499":41294,"_5":17394,"_23735":41024,"_2383":41295},[],"optionally installs observability and lab HSM components",{"_2856":192,"_25078":91,"_17499":41297,"_5":17394,"_23735":41024,"_2383":41298},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2856":193,"_25078":91,"_17499":41300,"_5":17394,"_23735":41024,"_2383":41301},[],"optionally loads sample data",{"_2856":194,"_25078":91,"_17499":41303,"_5":17394,"_23735":41024,"_2383":41304},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2856":195,"_25078":91,"_17499":41306,"_5":17394,"_23735":41028,"_2383":41307},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2856":196,"_25078":91,"_17499":41309,"_5":17394,"_23735":41028,"_2383":41310},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2856":197,"_25078":91,"_17499":41312,"_5":17394,"_23735":41032,"_2383":41313},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2856":198,"_25078":91,"_17499":41315,"_5":17394,"_23735":41032,"_2383":41316},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2856":199,"_25078":91,"_17499":41318,"_5":17394,"_23735":41032,"_2383":41319},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2856":200,"_25078":91,"_17499":41321,"_5":17394,"_23735":41036,"_2383":41322},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2856":201,"_25078":201,"_5":12261,"_2383":41324,"_25413":41325,"_17499":41326,"_23735":201},"Install with Helm",[40749,40750,40856],[],{"_2856":202,"_25078":201,"_17499":41328,"_5":17394,"_23735":201,"_2383":41329},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2856":203,"_25078":201,"_5":25410,"_17499":41331,"_23735":41332,"_2383":41333},[],"/docs/pr-preview/pr-40/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2856":204,"_25078":201,"_5":25410,"_17499":41335,"_23735":41336,"_2383":40759},[],"/docs/pr-preview/pr-40/deployment/self-hosted/helm#before-you-begin",{"_2856":205,"_25078":201,"_5":25410,"_17499":41338,"_23735":41339,"_2383":41340},[],"/docs/pr-preview/pr-40/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2856":206,"_25078":201,"_5":25410,"_17499":41342,"_23735":41343,"_2383":41344},[],"/docs/pr-preview/pr-40/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2856":207,"_25078":201,"_5":25410,"_17499":41346,"_23735":41347,"_2383":41348},[],"/docs/pr-preview/pr-40/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2856":208,"_25078":201,"_5":25410,"_17499":41350,"_23735":41351,"_2383":41352},[],"/docs/pr-preview/pr-40/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2856":209,"_25078":201,"_5":25410,"_17499":41354,"_23735":41355,"_2383":41356},[],"/docs/pr-preview/pr-40/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2856":210,"_25078":201,"_5":25410,"_17499":41358,"_23735":41359,"_2383":41360},[],"/docs/pr-preview/pr-40/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2856":211,"_25078":201,"_5":25410,"_17499":41362,"_23735":41363,"_2383":41364},[],"/docs/pr-preview/pr-40/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2856":212,"_25078":201,"_17499":41366,"_5":17394,"_23735":41332,"_2383":41367},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2856":213,"_25078":201,"_17499":41369,"_5":17394,"_23735":41336,"_2383":41370},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2856":214,"_25078":201,"_17499":41372,"_5":17394,"_23735":41336,"_2383":41373},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2856":215,"_25078":201,"_17499":41375,"_5":17394,"_23735":41336,"_2383":41376},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2856":216,"_25078":201,"_17499":41378,"_5":17394,"_23735":41336,"_2383":41379},[],"a reachable RabbitMQ broker and credentials",{"_2856":217,"_25078":201,"_17499":41381,"_5":17394,"_23735":41336,"_2383":41382},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2856":218,"_25078":201,"_17499":41384,"_5":17394,"_23735":41336,"_2383":41385},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2856":219,"_25078":201,"_17499":41387,"_5":17394,"_23735":41336,"_2383":41388},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2856":220,"_25078":201,"_17499":41390,"_5":17394,"_23735":41336,"_2383":41391},[],"a StorageClass and an external traffic design",{"_2856":221,"_25078":201,"_17499":41393,"_5":17394,"_23735":41336,"_2383":41394},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2856":222,"_25078":201,"_17499":41396,"_5":17394,"_23735":41336,"_2383":41397},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2856":223,"_25078":201,"_17499":41399,"_5":17394,"_23735":41336,"_2383":41400},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2856":224,"_25078":201,"_17499":41402,"_5":17394,"_23735":41339,"_2383":41403},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2856":225,"_25078":201,"_17499":41405,"_5":17394,"_23735":41339,"_2383":41406},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2856":226,"_25078":201,"_17499":41408,"_5":17394,"_23735":41339,"_2383":41409},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2856":227,"_25078":201,"_17499":41411,"_5":17394,"_23735":41343,"_2383":41412},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2856":228,"_25078":201,"_17499":41414,"_5":17394,"_23735":41343,"_2383":41415},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2856":229,"_25078":201,"_17499":41417,"_5":17394,"_23735":41343,"_2383":41418},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2856":230,"_25078":201,"_17499":41420,"_5":17394,"_23735":41347,"_2383":41421},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2856":231,"_25078":201,"_17499":41423,"_5":17394,"_23735":41351,"_2383":41424},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2856":232,"_25078":201,"_17499":41426,"_5":17394,"_23735":41351,"_2383":41427},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2856":233,"_25078":201,"_17499":41429,"_5":17394,"_23735":41351,"_2383":41430},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2856":234,"_25078":201,"_17499":41432,"_5":17394,"_23735":41351,"_2383":41433},[],"See Access control for the principal and policy model.",{"_2856":235,"_25078":201,"_17499":41435,"_5":17394,"_23735":41355,"_2383":41436},[],"To install a local checkout instead:",{"_2856":236,"_25078":201,"_17499":41438,"_5":17394,"_23735":41359,"_2383":41439},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2856":237,"_25078":201,"_17499":41441,"_5":17394,"_23735":41359,"_2383":41442},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2856":238,"_25078":201,"_17499":41444,"_5":17394,"_23735":41363,"_2383":41445},[],"Before going live, review:",{"_2856":239,"_25078":201,"_17499":41447,"_5":17394,"_23735":41363,"_2383":41448},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2856":240,"_25078":201,"_17499":41450,"_5":17394,"_23735":41363,"_2383":41451},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2856":241,"_25078":201,"_17499":41453,"_5":17394,"_23735":41363,"_2383":41454},[],"shared VA storage before increasing VA replicas",{"_2856":242,"_25078":201,"_17499":41456,"_5":17394,"_23735":41363,"_2383":41457},[],"managed OIDC roles and removal of evaluation credentials",{"_2856":243,"_25078":201,"_17499":41459,"_5":17394,"_23735":41363,"_2383":41460},[],"a trusted TLS issuer or externally managed certificate",{"_2856":244,"_25078":201,"_17499":41462,"_5":17394,"_23735":41363,"_2383":41463},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2856":245,"_25078":201,"_17499":41465,"_5":17394,"_23735":41363,"_2383":41466},[],"SMTP, observability and alert delivery",{"_2856":246,"_25078":201,"_17499":41468,"_5":17394,"_23735":41363,"_2383":41469},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2856":247,"_25078":201,"_17499":41471,"_5":17394,"_23735":41363,"_2383":41472},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2856":248,"_25078":248,"_5":12261,"_2383":41474,"_25413":41475,"_17499":41476,"_23735":248},"Expose the Gateway",[40749,40750,40856],[],{"_2856":249,"_25078":248,"_17499":41478,"_5":17394,"_23735":248,"_2383":41479},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2856":250,"_25078":248,"_5":25410,"_17499":41481,"_23735":41482,"_2383":41483},[],"/docs/pr-preview/pr-40/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2856":251,"_25078":248,"_5":25410,"_17499":41485,"_23735":41486,"_2383":41487},[],"/docs/pr-preview/pr-40/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2856":252,"_25078":248,"_5":25410,"_17499":41489,"_23735":41490,"_2383":41491},[],"/docs/pr-preview/pr-40/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2856":253,"_25078":248,"_5":25410,"_17499":41493,"_23735":41494,"_2383":41495},[],"/docs/pr-preview/pr-40/deployment/self-hosted/networking#k3s","K3s",{"_2856":254,"_25078":248,"_5":25410,"_17499":41497,"_23735":41498,"_2383":41499},[],"/docs/pr-preview/pr-40/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2856":255,"_25078":248,"_5":25410,"_17499":41501,"_23735":41502,"_2383":41503},[],"/docs/pr-preview/pr-40/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2856":256,"_25078":248,"_5":25410,"_17499":41505,"_23735":41506,"_2383":41507},[],"/docs/pr-preview/pr-40/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2856":257,"_25078":248,"_5":25410,"_17499":41509,"_23735":41510,"_2383":41511},[],"/docs/pr-preview/pr-40/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2856":258,"_25078":248,"_5":25410,"_17499":41513,"_23735":41514,"_2383":41515},[],"/docs/pr-preview/pr-40/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2856":259,"_25078":248,"_17499":41517,"_5":17394,"_23735":41482,"_2383":41518},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2856":260,"_25078":248,"_17499":41520,"_5":17394,"_23735":41482,"_2383":41521},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2856":261,"_25078":248,"_17499":41523,"_5":17394,"_23735":41486,"_2383":41524},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2856":262,"_25078":248,"_17499":41526,"_5":17394,"_23735":41486,"_2383":41527},[],"Set it only when:",{"_2856":263,"_25078":248,"_17499":41529,"_5":17394,"_23735":41486,"_2383":41530},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2856":264,"_25078":248,"_17499":41532,"_5":17394,"_23735":41486,"_2383":41533},[],"that address is allocated to this Gateway",{"_2856":265,"_25078":248,"_17499":41535,"_5":17394,"_23735":41486,"_2383":41536},[],"the surrounding network already routes traffic for it to the cluster",{"_2856":266,"_25078":248,"_17499":41538,"_5":17394,"_23735":41486,"_2383":41539},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2856":267,"_25078":248,"_17499":41541,"_5":17394,"_23735":41486,"_2383":41542},[],"Keep these two settings separate:",{"_2856":268,"_25078":248,"_17499":41544,"_5":17394,"_23735":41486,"_2383":41545},[],"`gateway.addresses` requests an address for the Gateway.",{"_2856":269,"_25078":248,"_17499":41547,"_5":17394,"_23735":41486,"_2383":41548},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2856":270,"_25078":248,"_17499":41550,"_5":17394,"_23735":41486,"_2383":41551},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2856":271,"_25078":248,"_17499":41553,"_5":17394,"_23735":41490,"_2383":41554},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2856":272,"_25078":248,"_17499":41556,"_5":17394,"_23735":41490,"_2383":41557},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2856":273,"_25078":248,"_17499":41559,"_5":17394,"_23735":41494,"_2383":41560},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2856":274,"_25078":248,"_17499":41562,"_5":17394,"_23735":41494,"_2383":41563},[],"For the recommended design:",{"_2856":275,"_25078":248,"_17499":41565,"_5":17394,"_23735":41494,"_2383":41566},[],"Use only one externally exposed Lamassu Gateway.",{"_2856":276,"_25078":248,"_17499":41568,"_5":17394,"_23735":41494,"_2383":41569},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2856":277,"_25078":248,"_17499":41571,"_5":17394,"_23735":41494,"_2383":41572},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2856":278,"_25078":248,"_17499":41574,"_5":17394,"_23735":41494,"_2383":41575},[],"Point DNS at the VM's reachable address.",{"_2856":279,"_25078":248,"_17499":41577,"_5":17394,"_23735":41494,"_2383":41578},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2856":280,"_25078":248,"_17499":41580,"_5":17394,"_23735":41498,"_2383":41581},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2856":281,"_25078":248,"_17499":41583,"_5":17394,"_23735":41502,"_2383":41584},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2856":282,"_25078":248,"_17499":41586,"_5":17394,"_23735":41502,"_2383":41587},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2856":283,"_25078":248,"_17499":41589,"_5":17394,"_23735":41506,"_2383":41590},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2856":284,"_25078":248,"_17499":41592,"_5":17394,"_23735":41506,"_2383":41593},[],"Requirement",{"_2856":285,"_25078":248,"_17499":41595,"_5":17394,"_23735":41506,"_2383":41596},[],"Recommended design",{"_2856":286,"_25078":248,"_17499":41598,"_5":17394,"_23735":41506,"_2383":41599},[],"Consequence",{"_2856":287,"_25078":248,"_17499":41601,"_5":17394,"_23735":41506,"_2383":41602},[],"Several Lamassu URLs or services",{"_2856":288,"_25078":248,"_17499":41604,"_5":17394,"_23735":41506,"_2383":41605},[],"One Gateway with multiple routes",{"_2856":289,"_25078":248,"_17499":41607,"_5":17394,"_23735":41506,"_2383":41608},[],"One IP and one proxy fleet; this is the chart default",{"_2856":290,"_25078":248,"_17499":41610,"_5":17394,"_23735":41506,"_2383":41611},[],"Independent Gateways and separate external IPs",{"_2856":291,"_25078":248,"_17499":41613,"_5":17394,"_23735":41506,"_2383":41614},[],"One VIP per Gateway",{"_2856":292,"_25078":248,"_17499":41616,"_5":17394,"_23735":41506,"_2383":41617},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2856":293,"_25078":248,"_17499":41619,"_5":17394,"_23735":41506,"_2383":41620},[],"Independent Gateways on one node and one IP",{"_2856":294,"_25078":248,"_17499":41622,"_5":17394,"_23735":41506,"_2383":41623},[],"Use different external ports",{"_2856":295,"_25078":248,"_17499":41625,"_5":17394,"_23735":41506,"_2383":41626},[],"Clients must include non-standard ports",{"_2856":296,"_25078":248,"_17499":41628,"_5":17394,"_23735":41506,"_2383":41629},[],"Separate TLS/mTLS termination behind one IP",{"_2856":297,"_25078":248,"_17499":41631,"_5":17394,"_23735":41506,"_2383":41632},[],"Front-door SNI routing to internal Gateways",{"_2856":298,"_25078":248,"_17499":41634,"_5":17394,"_23735":41506,"_2383":41635},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2856":299,"_25078":248,"_17499":41637,"_5":17394,"_23735":41506,"_2383":41638},[],"Separate Gateway resources but shared proxy infrastructure",{"_2856":300,"_25078":248,"_17499":41640,"_5":17394,"_23735":41506,"_2383":41641},[],"Envoy merged-Gateway mode",{"_2856":301,"_25078":248,"_17499":41643,"_5":17394,"_23735":41506,"_2383":41644},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2856":302,"_25078":248,"_17499":41646,"_5":17394,"_23735":41506,"_2383":41647},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2856":303,"_25078":248,"_17499":41649,"_5":17394,"_23735":41506,"_2383":41650},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2856":304,"_25078":248,"_17499":41652,"_5":17394,"_23735":41506,"_2383":41653},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2856":305,"_25078":248,"_17499":41655,"_5":17394,"_23735":41506,"_2383":41656},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2856":306,"_25078":248,"_17499":41658,"_5":17394,"_23735":41510,"_2383":41659},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2856":307,"_25078":248,"_17499":41661,"_5":17394,"_23735":41510,"_2383":41662},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2856":308,"_25078":248,"_17499":41664,"_5":17394,"_23735":41510,"_2383":41665},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2856":309,"_25078":248,"_17499":41667,"_5":17394,"_23735":41510,"_2383":41668},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2856":310,"_25078":248,"_17499":41670,"_5":17394,"_23735":41510,"_2383":41671},[],"If none of those are possible, use different external ports or change the external network design.",{"_2856":311,"_25078":248,"_17499":41673,"_5":17394,"_23735":41514,"_2383":41674},[],"Check, in order:",{"_2856":312,"_25078":248,"_17499":41676,"_5":17394,"_23735":41514,"_2383":41677},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2856":313,"_25078":248,"_17499":41679,"_5":17394,"_23735":41514,"_2383":41680},[],"Its status contains the expected address.",{"_2856":314,"_25078":248,"_17499":41682,"_5":17394,"_23735":41514,"_2383":41683},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2856":315,"_25078":248,"_17499":41685,"_5":17394,"_23735":41514,"_2383":41686},[],"Port 443 reaches that address from the client network.",{"_2856":316,"_25078":248,"_17499":41688,"_5":17394,"_23735":41514,"_2383":41689},[],"DNS resolves to the externally reachable endpoint.",{"_2856":317,"_25078":248,"_17499":41691,"_5":17394,"_23735":41514,"_2383":41692},[],"The certificate contains the DNS name or IP used by the client.",{"_2856":318,"_25078":248,"_17499":41694,"_5":17394,"_23735":41514,"_2383":41695},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2856":319,"_25078":319,"_5":12261,"_2383":40856,"_25413":41697,"_17499":41698,"_23735":319},[40749,40750,40856],[],{"_2856":320,"_25078":319,"_17499":41700,"_5":17394,"_23735":319,"_2383":41701},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2856":321,"_25078":319,"_5":25410,"_17499":41703,"_23735":41704,"_2383":41705},[],"/docs/pr-preview/pr-40/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2856":322,"_25078":319,"_5":25410,"_17499":41707,"_23735":41708,"_2383":41709},[],"/docs/pr-preview/pr-40/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2856":323,"_25078":319,"_5":25410,"_17499":41711,"_23735":41712,"_2383":41713},[],"/docs/pr-preview/pr-40/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2856":324,"_25078":319,"_5":25410,"_17499":41715,"_23735":41716,"_2383":41717},[],"/docs/pr-preview/pr-40/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2856":325,"_25078":319,"_5":25410,"_17499":41719,"_23735":41720,"_2383":41721},[],"/docs/pr-preview/pr-40/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2856":326,"_25078":319,"_5":25410,"_17499":41723,"_23735":41724,"_2383":41725},[],"/docs/pr-preview/pr-40/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2856":327,"_25078":319,"_17499":41727,"_5":17394,"_23735":41704,"_2383":41728},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2856":328,"_25078":319,"_17499":41730,"_5":17394,"_23735":41708,"_2383":41731},[],"Workflow",{"_2856":329,"_25078":319,"_17499":41733,"_5":17394,"_23735":41708,"_2383":41734},[],"Use it for",{"_2856":330,"_25078":319,"_17499":41736,"_5":17394,"_23735":41708,"_2383":41737},[],"What it installs",{"_2856":331,"_25078":319,"_17499":41739,"_5":17394,"_23735":41708,"_2383":41740},[],"Helm",{"_2856":332,"_25078":319,"_17499":41742,"_5":17394,"_23735":41708,"_2383":41743},[],"Production and controlled environments",{"_2856":333,"_25078":319,"_17499":41745,"_5":17394,"_23735":41708,"_2383":41746},[],"Lamassu services and Gateway API resources",{"_2856":334,"_25078":319,"_17499":41748,"_5":17394,"_23735":41708,"_2383":40993},[],{"_2856":335,"_25078":319,"_17499":41750,"_5":17394,"_23735":41708,"_2383":41751},[],"Evaluation, demos, CI and small lab clusters",{"_2856":336,"_25078":319,"_17499":41753,"_5":17394,"_23735":41708,"_2383":41754},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2856":337,"_25078":319,"_17499":41756,"_5":17394,"_23735":41712,"_2383":41757},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2856":338,"_25078":319,"_17499":41759,"_5":17394,"_23735":41712,"_2383":41760},[],"Area",{"_2856":339,"_25078":319,"_17499":41762,"_5":17394,"_23735":41712,"_2383":41763},[],"The Lamassu chart provides",{"_2856":340,"_25078":319,"_17499":41765,"_5":17394,"_23735":41712,"_2383":41766},[],"You provide",{"_2856":341,"_25078":319,"_17499":41768,"_5":17394,"_23735":41712,"_2383":41769},[],"Lamassu applications",{"_2856":342,"_25078":319,"_17499":41771,"_5":17394,"_23735":41712,"_2383":41772},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2856":343,"_25078":319,"_17499":41774,"_5":17394,"_23735":41712,"_2383":41775},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2856":344,"_25078":319,"_17499":41777,"_5":17394,"_23735":41712,"_2383":41778},[],"PostgreSQL data",{"_2856":345,"_25078":319,"_17499":41780,"_5":17394,"_23735":41712,"_2383":41781},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2856":346,"_25078":319,"_17499":41783,"_5":17394,"_23735":41712,"_2383":41784},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2856":347,"_25078":319,"_17499":41786,"_5":17394,"_23735":41712,"_2383":41787},[],"Messaging",{"_2856":348,"_25078":319,"_17499":41789,"_5":17394,"_23735":41712,"_2383":41790},[],"RabbitMQ connection configuration for the Lamassu services",{"_2856":349,"_25078":319,"_17499":41792,"_5":17394,"_23735":41712,"_2383":41793},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2856":350,"_25078":319,"_17499":41795,"_5":17394,"_23735":41712,"_2383":41796},[],"Identity",{"_2856":351,"_25078":319,"_17499":41798,"_5":17394,"_23735":41712,"_2383":41799},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2856":352,"_25078":319,"_17499":41801,"_5":17394,"_23735":41712,"_2383":41802},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2856":353,"_25078":319,"_17499":41804,"_5":17394,"_23735":41712,"_2383":41805},[],"External routing",{"_2856":354,"_25078":319,"_17499":41807,"_5":17394,"_23735":41712,"_2383":41808},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2856":355,"_25078":319,"_17499":41810,"_5":17394,"_23735":41712,"_2383":41811},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2856":356,"_25078":319,"_17499":41813,"_5":17394,"_23735":41712,"_2383":41814},[],"TLS",{"_2856":357,"_25078":319,"_17499":41816,"_5":17394,"_23735":41712,"_2383":41817},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2856":358,"_25078":319,"_17499":41819,"_5":17394,"_23735":41712,"_2383":41820},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2856":359,"_25078":319,"_17499":41822,"_5":17394,"_23735":41712,"_2383":41823},[],"Persistent application data",{"_2856":360,"_25078":319,"_17499":41825,"_5":17394,"_23735":41712,"_2383":41826},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2856":361,"_25078":319,"_17499":41828,"_5":17394,"_23735":41712,"_2383":41829},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2856":362,"_25078":319,"_17499":41831,"_5":17394,"_23735":41712,"_2383":41832},[],"Optional integrations",{"_2856":363,"_25078":319,"_17499":41834,"_5":17394,"_23735":41712,"_2383":41835},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2856":364,"_25078":319,"_17499":41837,"_5":17394,"_23735":41712,"_2383":41838},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2856":365,"_25078":319,"_17499":41840,"_5":17394,"_23735":41712,"_2383":41841},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2856":366,"_25078":319,"_17499":41843,"_5":17394,"_23735":41712,"_2383":41844},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2856":367,"_25078":319,"_17499":41846,"_5":17394,"_23735":41716,"_2383":41847},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2856":368,"_25078":319,"_17499":41849,"_5":17394,"_23735":41716,"_2383":41850},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2856":369,"_25078":319,"_17499":41852,"_5":17394,"_23735":41720,"_2383":41853},[],"Kubernetes 1.24 or newer",{"_2856":370,"_25078":319,"_17499":41855,"_5":17394,"_23735":41720,"_2383":41856},[],"Helm 3.2 or newer",{"_2856":371,"_25078":319,"_17499":41858,"_5":17394,"_23735":41720,"_2383":41859},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2856":372,"_25078":319,"_17499":41861,"_5":17394,"_23735":41720,"_2383":41862},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2856":373,"_25078":319,"_17499":41864,"_5":17394,"_23735":41720,"_2383":41865},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2856":374,"_25078":319,"_17499":41867,"_5":17394,"_23735":41720,"_2383":41868},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2856":375,"_25078":319,"_17499":41870,"_5":17394,"_23735":41720,"_2383":41871},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2856":376,"_25078":319,"_17499":41873,"_5":17394,"_23735":41724,"_2383":41874},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2856":377,"_25078":319,"_17499":41876,"_5":17394,"_23735":41724,"_2383":41877},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2856":378,"_25078":319,"_17499":41879,"_5":17394,"_23735":41724,"_2383":41880},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2856":379,"_25078":379,"_5":12261,"_2383":41882,"_25413":41883,"_17499":41885,"_23735":379},"Deployment troubleshooting",[40749,40750,41884],"Operations",[],{"_2856":380,"_25078":379,"_17499":41887,"_5":17394,"_23735":379,"_2383":41888},[],"Diagnose access, service health and infrastructure dependencies.",{"_2856":381,"_25078":379,"_5":25410,"_17499":41890,"_23735":41891,"_2383":41892},[],"/docs/pr-preview/pr-40/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2856":382,"_25078":379,"_5":25410,"_17499":41894,"_23735":41895,"_2383":41896},[],"/docs/pr-preview/pr-40/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2856":383,"_25078":379,"_5":25410,"_17499":41898,"_23735":41899,"_2383":41900},[],"/docs/pr-preview/pr-40/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2856":384,"_25078":379,"_5":25410,"_17499":41902,"_23735":41903,"_2383":41904},[],"/docs/pr-preview/pr-40/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2856":385,"_25078":379,"_5":25410,"_17499":41906,"_23735":41907,"_2383":41908},[],"/docs/pr-preview/pr-40/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2856":386,"_25078":379,"_5":25410,"_17499":41910,"_23735":41911,"_2383":41912},[],"/docs/pr-preview/pr-40/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2856":387,"_25078":379,"_5":25410,"_17499":41914,"_23735":41915,"_2383":41916},[],"/docs/pr-preview/pr-40/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2856":388,"_25078":379,"_5":25410,"_17499":41918,"_23735":41919,"_2383":41920},[],"/docs/pr-preview/pr-40/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2856":389,"_25078":379,"_5":25410,"_17499":41922,"_23735":41923,"_2383":41924},[],"/docs/pr-preview/pr-40/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2856":390,"_25078":379,"_5":25410,"_17499":41926,"_23735":41927,"_2383":41928},[],"/docs/pr-preview/pr-40/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2856":391,"_25078":379,"_5":25410,"_17499":41930,"_23735":41931,"_2383":41932},[],"/docs/pr-preview/pr-40/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2856":392,"_25078":379,"_5":25410,"_17499":41934,"_23735":41935,"_2383":41936},[],"/docs/pr-preview/pr-40/deployment/troubleshooting#observability","Observability",{"_2856":393,"_25078":379,"_17499":41938,"_5":17394,"_23735":379,"_2383":41939},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2856":394,"_25078":379,"_17499":41941,"_5":17394,"_23735":41895,"_2383":41942},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2856":395,"_25078":379,"_17499":41944,"_5":17394,"_23735":41899,"_2383":41945},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2856":396,"_25078":379,"_17499":41947,"_5":17394,"_23735":41903,"_2383":41948},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2856":397,"_25078":379,"_17499":41950,"_5":17394,"_23735":41907,"_2383":41951},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2856":398,"_25078":379,"_17499":41953,"_5":17394,"_23735":41911,"_2383":41954},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2856":399,"_25078":379,"_17499":41956,"_5":17394,"_23735":41915,"_2383":41957},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2856":400,"_25078":379,"_17499":41959,"_5":17394,"_23735":41915,"_2383":41960},[],"Also run the chart's connectivity test:",{"_2856":401,"_25078":379,"_17499":41962,"_5":17394,"_23735":41915,"_2383":41963},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2856":402,"_25078":379,"_17499":41965,"_5":17394,"_23735":41915,"_2383":41966},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2856":403,"_25078":379,"_17499":41968,"_5":17394,"_23735":41919,"_2383":41969},[],"If you receive a 401:",{"_2856":404,"_25078":379,"_17499":41971,"_5":17394,"_23735":41919,"_2383":41972},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2856":405,"_25078":379,"_17499":41974,"_5":17394,"_23735":41919,"_2383":41975},[],"verify issuer, audience and expiration of the token;",{"_2856":406,"_25078":379,"_17499":41977,"_5":17394,"_23735":41919,"_2383":41978},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2856":407,"_25078":379,"_17499":41980,"_5":17394,"_23735":41919,"_2383":41981},[],"check that the provider's public and internal routes point to the same realm.",{"_2856":408,"_25078":379,"_17499":41983,"_5":17394,"_23735":41919,"_2383":41984},[],"If login succeeds but the APIs return 403:",{"_2856":409,"_25078":379,"_17499":41986,"_5":17394,"_23735":41919,"_2383":41987},[],"inspect the token's real claims;",{"_2856":410,"_25078":379,"_17499":41989,"_5":17394,"_23735":41919,"_2383":41990},[],"confirm they match an active principal;",{"_2856":411,"_25078":379,"_17499":41992,"_5":17394,"_23735":41919,"_2383":41993},[],"review the policies granted to that principal;",{"_2856":412,"_25078":379,"_17499":41995,"_5":17394,"_23735":41919,"_2383":41996},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2856":413,"_25078":379,"_17499":41998,"_5":17394,"_23735":41919,"_2383":41999},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2856":414,"_25078":379,"_17499":42001,"_5":17394,"_23735":41923,"_2383":42002},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2856":415,"_25078":379,"_17499":42004,"_5":17394,"_23735":41923,"_2383":42005},[],"Locate the authz pod and Service.",{"_2856":416,"_25078":379,"_17499":42007,"_5":17394,"_23735":41923,"_2383":42008},[],"Check /health, logs and its database connection.",{"_2856":417,"_25078":379,"_17499":42010,"_5":17394,"_23735":41923,"_2383":42011},[],"Verify the DNS and port configured in externalAuthorization.",{"_2856":418,"_25078":379,"_17499":42013,"_5":17394,"_23735":41923,"_2383":42014},[],"Check the check route is /v1/ext\\_authz/check.",{"_2856":419,"_25078":379,"_17499":42016,"_5":17394,"_23735":41923,"_2383":42017},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2856":420,"_25078":379,"_17499":42019,"_5":17394,"_23735":41927,"_2383":42020},[],"Review kubectl describe pod first. Common causes are:",{"_2856":421,"_25078":379,"_17499":42022,"_5":17394,"_23735":41927,"_2383":42023},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2856":422,"_25078":379,"_17499":42025,"_5":17394,"_23735":41927,"_2383":42026},[],"unbound persistent volume;",{"_2856":423,"_25078":379,"_17499":42028,"_5":17394,"_23735":41927,"_2383":42029},[],"inaccessible image or incorrect pull policy;",{"_2856":424,"_25078":379,"_17499":42031,"_5":17394,"_23735":41927,"_2383":42032},[],"invalid cryptographic engine configuration;",{"_2856":425,"_25078":379,"_17499":42034,"_5":17394,"_23735":41927,"_2383":42035},[],"CPU or memory limits set too low;",{"_2856":426,"_25078":379,"_17499":42037,"_5":17394,"_23735":41927,"_2383":42038},[],"an incomplete prior migration.",{"_2856":427,"_25078":379,"_17499":42040,"_5":17394,"_23735":41927,"_2383":42041},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2856":428,"_25078":379,"_17499":42043,"_5":17394,"_23735":41927,"_2383":42044},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2856":429,"_25078":379,"_17499":42046,"_5":17394,"_23735":41931,"_2383":42047},[],"Domain and audit events depend on the bus publisher:",{"_2856":430,"_25078":379,"_17499":42049,"_5":17394,"_23735":41931,"_2383":42050},[],"verify it is enabled in the emitting service;",{"_2856":431,"_25078":379,"_17499":42052,"_5":17394,"_23735":41931,"_2383":42053},[],"check AMQP connectivity and credentials;",{"_2856":432,"_25078":379,"_17499":42055,"_5":17394,"_23735":41931,"_2383":42056},[],"review exchange, routing key, queues and consumers;",{"_2856":433,"_25078":379,"_17499":42058,"_5":17394,"_23735":41931,"_2383":42059},[],"inspect dead-letter queues;",{"_2856":434,"_25078":379,"_17499":42061,"_5":17394,"_23735":41931,"_2383":42062},[],"alert on orphan durable queues and backlog growth.",{"_2856":435,"_25078":379,"_17499":42064,"_5":17394,"_23735":41931,"_2383":42065},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2856":436,"_25078":379,"_17499":42067,"_5":17394,"_23735":41935,"_2383":42068},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2856":437,"_25078":379,"_17499":42070,"_5":17394,"_23735":41935,"_2383":42071},[],"Before closing an incident, record:",{"_2856":438,"_25078":379,"_17499":42073,"_5":17394,"_23735":41935,"_2383":42074},[],"the confirmed cause;",{"_2856":439,"_25078":379,"_17499":42076,"_5":17394,"_23735":41935,"_2383":42077},[],"the time scope and affected resources;",{"_2856":440,"_25078":379,"_17499":42079,"_5":17394,"_23735":41935,"_2383":42080},[],"the commands or queries used;",{"_2856":441,"_25078":379,"_17499":42082,"_5":17394,"_23735":41935,"_2383":42083},[],"the applied change and how to revert it;",{"_2856":442,"_25078":379,"_17499":42085,"_5":17394,"_23735":41935,"_2383":42086},[],"validation from a consumer;",{"_2856":443,"_25078":379,"_17499":42088,"_5":17394,"_23735":41935,"_2383":42089},[],"the preventive action and its owner.",{"_2856":444,"_25078":444,"_5":12261,"_2383":42091,"_25413":42092,"_17499":42095,"_23735":444},"Access control",[40749,42093,42094],"Platform","Administration",[],{"_2856":445,"_25078":444,"_17499":42097,"_5":17394,"_23735":444,"_2383":42098},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2856":446,"_25078":444,"_5":25410,"_17499":42100,"_23735":42101,"_2383":42102},[],"/docs/pr-preview/pr-40/platform/administration/access-control#essential-concepts","Essential concepts",{"_2856":447,"_25078":444,"_5":25410,"_17499":42104,"_23735":42105,"_2383":42106},[],"/docs/pr-preview/pr-40/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2856":448,"_25078":444,"_5":25410,"_17499":42108,"_23735":42109,"_2383":42110},[],"/docs/pr-preview/pr-40/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2856":449,"_25078":444,"_5":25410,"_17499":42112,"_23735":42113,"_2383":42114},[],"/docs/pr-preview/pr-40/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2856":450,"_25078":444,"_5":25410,"_17499":42116,"_23735":42117,"_2383":42118},[],"/docs/pr-preview/pr-40/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2856":451,"_25078":444,"_5":25410,"_17499":42120,"_23735":42121,"_2383":42122},[],"/docs/pr-preview/pr-40/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2856":452,"_25078":444,"_5":25410,"_17499":42124,"_23735":42125,"_2383":42126},[],"/docs/pr-preview/pr-40/platform/administration/access-control#oidc-principals","OIDC principals",{"_2856":453,"_25078":444,"_5":25410,"_17499":42128,"_23735":42129,"_2383":42130},[],"/docs/pr-preview/pr-40/platform/administration/access-control#x509-principals","X.509 principals",{"_2856":454,"_25078":444,"_5":25410,"_17499":42132,"_23735":42133,"_2383":42134},[],"/docs/pr-preview/pr-40/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2856":455,"_25078":444,"_5":25410,"_17499":42136,"_23735":42137,"_2383":42138},[],"/docs/pr-preview/pr-40/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2856":456,"_25078":444,"_5":25410,"_17499":42140,"_23735":42141,"_2383":42142},[],"/docs/pr-preview/pr-40/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2856":457,"_25078":444,"_5":25410,"_17499":42144,"_23735":42145,"_2383":42146},[],"/docs/pr-preview/pr-40/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2856":458,"_25078":444,"_5":25410,"_17499":42148,"_23735":42149,"_2383":42150},[],"/docs/pr-preview/pr-40/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2856":459,"_25078":444,"_5":25410,"_17499":42152,"_23735":42153,"_2383":42154},[],"/docs/pr-preview/pr-40/platform/administration/access-control#http-rules","HTTP rules",{"_2856":460,"_25078":444,"_5":25410,"_17499":42156,"_23735":42157,"_2383":42158},[],"/docs/pr-preview/pr-40/platform/administration/access-control#included-policies","Included policies",{"_2856":461,"_25078":444,"_5":25410,"_17499":42160,"_23735":42161,"_2383":41352},[],"/docs/pr-preview/pr-40/platform/administration/access-control#provision-the-first-administrator",{"_2856":462,"_25078":444,"_5":25410,"_17499":42163,"_23735":42164,"_2383":42165},[],"/docs/pr-preview/pr-40/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2856":463,"_25078":444,"_5":25410,"_17499":42167,"_23735":42168,"_2383":42169},[],"/docs/pr-preview/pr-40/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2856":464,"_25078":444,"_5":25410,"_17499":42171,"_23735":42172,"_2383":42173},[],"/docs/pr-preview/pr-40/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2856":465,"_25078":444,"_5":25410,"_17499":42175,"_23735":42176,"_2383":42177},[],"/docs/pr-preview/pr-40/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2856":466,"_25078":444,"_5":25410,"_17499":42179,"_23735":42180,"_2383":42181},[],"/docs/pr-preview/pr-40/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2856":467,"_25078":444,"_5":25410,"_17499":42183,"_23735":42184,"_2383":42185},[],"/docs/pr-preview/pr-40/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2856":468,"_25078":444,"_5":25410,"_17499":42187,"_23735":42188,"_2383":42189},[],"/docs/pr-preview/pr-40/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2856":469,"_25078":444,"_5":25410,"_17499":42191,"_23735":42192,"_2383":42193},[],"/docs/pr-preview/pr-40/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2856":470,"_25078":444,"_5":25410,"_17499":42195,"_23735":42196,"_2383":42197},[],"/docs/pr-preview/pr-40/platform/administration/access-control#operational-checklist","Operational checklist",{"_2856":471,"_25078":444,"_5":25410,"_17499":42199,"_23735":42200,"_2383":42201},[],"/docs/pr-preview/pr-40/platform/administration/access-control#diagnostics","Diagnostics",{"_2856":472,"_25078":444,"_5":25410,"_17499":42203,"_23735":42204,"_2383":42205},[],"/docs/pr-preview/pr-40/platform/administration/access-control#the-response-is-401","The response is 401",{"_2856":473,"_25078":444,"_5":25410,"_17499":42207,"_23735":42208,"_2383":42209},[],"/docs/pr-preview/pr-40/platform/administration/access-control#the-response-is-403","The response is 403",{"_2856":474,"_25078":444,"_5":25410,"_17499":42211,"_23735":42212,"_2383":42213},[],"/docs/pr-preview/pr-40/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2856":475,"_25078":444,"_5":25410,"_17499":42215,"_23735":42216,"_2383":42217},[],"/docs/pr-preview/pr-40/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2856":476,"_25078":444,"_5":25410,"_17499":42219,"_23735":42220,"_2383":42221},[],"/docs/pr-preview/pr-40/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2856":477,"_25078":444,"_17499":42223,"_5":17394,"_23735":444,"_2383":42224},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2856":478,"_25078":444,"_17499":42226,"_5":17394,"_23735":444,"_2383":42227},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2856":479,"_25078":444,"_17499":42229,"_5":17394,"_23735":444,"_2383":42230},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2856":480,"_25078":444,"_17499":42232,"_5":17394,"_23735":42101,"_2383":42233},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2856":481,"_25078":444,"_17499":42235,"_5":17394,"_23735":42101,"_2383":42236},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2856":482,"_25078":444,"_17499":42238,"_5":17394,"_23735":42101,"_2383":42239},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2856":483,"_25078":444,"_17499":42241,"_5":17394,"_23735":42101,"_2383":42242},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2856":484,"_25078":444,"_17499":42244,"_5":17394,"_23735":42101,"_2383":42245},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2856":485,"_25078":444,"_17499":42247,"_5":17394,"_23735":42101,"_2383":42248},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2856":486,"_25078":444,"_17499":42250,"_5":17394,"_23735":42105,"_2383":42251},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2856":487,"_25078":444,"_17499":42253,"_5":17394,"_23735":42105,"_2383":42254},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2856":488,"_25078":444,"_17499":42256,"_5":17394,"_23735":42109,"_2383":42257},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2856":489,"_25078":444,"_17499":42259,"_5":17394,"_23735":42109,"_2383":42260},[],"The decision is made **before forwarding the request to the service**:",{"_2856":490,"_25078":444,"_17499":42262,"_5":17394,"_23735":42109,"_2383":42263},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2856":491,"_25078":444,"_17499":42265,"_5":17394,"_23735":42109,"_2383":42266},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2856":492,"_25078":444,"_17499":42268,"_5":17394,"_23735":42109,"_2383":42269},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2856":493,"_25078":444,"_17499":42271,"_5":17394,"_23735":42109,"_2383":42272},[],"It separately loads the policies granted to each principal.",{"_2856":494,"_25078":444,"_17499":42274,"_5":17394,"_23735":42109,"_2383":42275},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2856":495,"_25078":444,"_17499":42277,"_5":17394,"_23735":42109,"_2383":42278},[],"`authz` looks for an HTTP rule granting that action.",{"_2856":496,"_25078":444,"_17499":42280,"_5":17394,"_23735":42109,"_2383":42281},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2856":497,"_25078":444,"_17499":42283,"_5":17394,"_23735":42109,"_2383":42284},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2856":498,"_25078":444,"_17499":42286,"_5":17394,"_23735":42109,"_2383":42287},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2856":499,"_25078":444,"_17499":42289,"_5":17394,"_23735":42109,"_2383":42290},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2856":500,"_25078":444,"_17499":42292,"_5":17394,"_23735":42113,"_2383":42293},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2856":501,"_25078":444,"_17499":42295,"_5":17394,"_23735":42113,"_2383":42296},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2856":502,"_25078":444,"_17499":42298,"_5":17394,"_23735":42113,"_2383":42299},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2856":503,"_25078":444,"_17499":42301,"_5":17394,"_23735":42113,"_2383":42302},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2856":504,"_25078":444,"_17499":42304,"_5":17394,"_23735":42113,"_2383":42305},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2856":505,"_25078":444,"_17499":42307,"_5":17394,"_23735":42113,"_2383":42308},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2856":506,"_25078":444,"_17499":42310,"_5":17394,"_23735":42113,"_2383":42311},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2856":507,"_25078":444,"_17499":42313,"_5":17394,"_23735":42113,"_2383":42314},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2856":508,"_25078":444,"_17499":42316,"_5":17394,"_23735":42117,"_2383":42317},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2856":509,"_25078":444,"_17499":42319,"_5":17394,"_23735":42117,"_2383":42320},[],"The decision is made with the domain operation context:",{"_2856":510,"_25078":444,"_17499":42322,"_5":17394,"_23735":42117,"_2383":42323},[],"The middleware extracts the credential and resolves the matching principals.",{"_2856":511,"_25078":444,"_17499":42325,"_5":17394,"_23735":42117,"_2383":42326},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2856":512,"_25078":444,"_17499":42328,"_5":17394,"_23735":42117,"_2383":42329},[],"`authz` gathers the entity rules of the granted policies.",{"_2856":513,"_25078":444,"_17499":42331,"_5":17394,"_23735":42117,"_2383":42332},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2856":514,"_25078":444,"_17499":42334,"_5":17394,"_23735":42117,"_2383":42335},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2856":515,"_25078":444,"_17499":42337,"_5":17394,"_23735":42117,"_2383":42338},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2856":516,"_25078":444,"_17499":42340,"_5":17394,"_23735":42117,"_2383":42341},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2856":517,"_25078":444,"_17499":42343,"_5":17394,"_23735":42117,"_2383":42344},[],"Actions fall into two groups:",{"_2856":518,"_25078":444,"_17499":42346,"_5":17394,"_23735":42117,"_2383":42347},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2856":519,"_25078":444,"_17499":42349,"_5":17394,"_23735":42117,"_2383":42350},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2856":520,"_25078":444,"_17499":42352,"_5":17394,"_23735":42117,"_2383":42353},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2856":521,"_25078":444,"_17499":42355,"_5":17394,"_23735":42121,"_2383":42356},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2856":522,"_25078":444,"_17499":42358,"_5":17394,"_23735":42121,"_2383":42359},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2856":523,"_25078":444,"_17499":42361,"_5":17394,"_23735":42121,"_2383":42362},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2856":524,"_25078":444,"_17499":42364,"_5":17394,"_23735":42125,"_2383":42365},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2856":525,"_25078":444,"_17499":42367,"_5":17394,"_23735":42125,"_2383":42368},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2856":526,"_25078":444,"_17499":42370,"_5":17394,"_23735":42125,"_2383":42371},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2856":527,"_25078":444,"_17499":42373,"_5":17394,"_23735":42125,"_2383":42374},[],"The implemented operators are:",{"_2856":528,"_25078":444,"_17499":42376,"_5":17394,"_23735":42125,"_2383":42377},[],"`equals`, for exact equality;",{"_2856":529,"_25078":444,"_17499":42379,"_5":17394,"_23735":42125,"_2383":42380},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2856":530,"_25078":444,"_17499":42382,"_5":17394,"_23735":42125,"_2383":42383},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2856":531,"_25078":444,"_17499":42385,"_5":17394,"_23735":42125,"_2383":42386},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2856":532,"_25078":444,"_17499":42388,"_5":17394,"_23735":42129,"_2383":42389},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2856":533,"_25078":444,"_17499":42391,"_5":17394,"_23735":42129,"_2383":42392},[],"The available modes are:",{"_2856":534,"_25078":444,"_17499":42394,"_5":17394,"_23735":42129,"_2383":42395},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2856":535,"_25078":444,"_17499":42397,"_5":17394,"_23735":42129,"_2383":42398},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2856":536,"_25078":444,"_17499":42400,"_5":17394,"_23735":42129,"_2383":42401},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2856":537,"_25078":444,"_17499":42403,"_5":17394,"_23735":42129,"_2383":42404},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2856":538,"_25078":444,"_17499":42406,"_5":17394,"_23735":42129,"_2383":42407},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2856":539,"_25078":444,"_17499":42409,"_5":17394,"_23735":42129,"_2383":42410},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2856":540,"_25078":444,"_17499":42412,"_5":17394,"_23735":42133,"_2383":42413},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2856":541,"_25078":444,"_17499":42415,"_5":17394,"_23735":42133,"_2383":42416},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2856":542,"_25078":444,"_17499":42418,"_5":17394,"_23735":42133,"_2383":42419},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2856":543,"_25078":444,"_17499":42421,"_5":17394,"_23735":42133,"_2383":42422},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2856":544,"_25078":444,"_17499":42424,"_5":17394,"_23735":42141,"_2383":42425},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2856":545,"_25078":444,"_17499":42427,"_5":17394,"_23735":42141,"_2383":42428},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2856":546,"_25078":444,"_17499":42430,"_5":17394,"_23735":42145,"_2383":42431},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2856":547,"_25078":444,"_17499":42433,"_5":17394,"_23735":42145,"_2383":42434},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2856":548,"_25078":444,"_17499":42436,"_5":17394,"_23735":42149,"_2383":42437},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2856":549,"_25078":444,"_17499":42439,"_5":17394,"_23735":42149,"_2383":42440},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2856":550,"_25078":444,"_17499":42442,"_5":17394,"_23735":42149,"_2383":42443},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2856":551,"_25078":444,"_17499":42445,"_5":17394,"_23735":42153,"_2383":42446},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2856":552,"_25078":444,"_17499":42448,"_5":17394,"_23735":42153,"_2383":42449},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2856":553,"_25078":444,"_17499":42451,"_5":17394,"_23735":42153,"_2383":42452},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2856":554,"_25078":444,"_17499":42454,"_5":17394,"_23735":42153,"_2383":42455},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2856":555,"_25078":444,"_17499":42457,"_5":17394,"_23735":42153,"_2383":42458},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2856":556,"_25078":444,"_17499":42460,"_5":17394,"_23735":42153,"_2383":42461},[],"Note that:",{"_2856":557,"_25078":444,"_17499":42463,"_5":17394,"_23735":42153,"_2383":42464},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2856":558,"_25078":444,"_17499":42466,"_5":17394,"_23735":42153,"_2383":42467},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2856":559,"_25078":444,"_17499":42469,"_5":17394,"_23735":42153,"_2383":42470},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2856":560,"_25078":444,"_17499":42472,"_5":17394,"_23735":42157,"_2383":42473},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2856":561,"_25078":444,"_17499":42475,"_5":17394,"_23735":42157,"_2383":42476},[],"full and read-only access to certificates and authorities;",{"_2856":562,"_25078":444,"_17499":42478,"_5":17394,"_23735":42157,"_2383":42479},[],"full and read-only access to the KMS;",{"_2856":563,"_25078":444,"_17499":42481,"_5":17394,"_23735":42157,"_2383":42482},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2856":564,"_25078":444,"_17499":42484,"_5":17394,"_23735":42157,"_2383":42485},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2856":565,"_25078":444,"_17499":42487,"_5":17394,"_23735":42157,"_2383":42488},[],"console access;",{"_2856":566,"_25078":444,"_17499":42490,"_5":17394,"_23735":42157,"_2383":42491},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2856":567,"_25078":444,"_17499":42493,"_5":17394,"_23735":42157,"_2383":42494},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2856":568,"_25078":444,"_17499":42496,"_5":17394,"_23735":42157,"_2383":42497},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2856":569,"_25078":444,"_17499":42499,"_5":17394,"_23735":42161,"_2383":42500},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2856":570,"_25078":444,"_17499":42502,"_5":17394,"_23735":42161,"_2383":42503},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2856":571,"_25078":444,"_17499":42505,"_5":17394,"_23735":42161,"_2383":42506},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2856":572,"_25078":444,"_17499":42508,"_5":17394,"_23735":42164,"_2383":42509},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2856":573,"_25078":444,"_17499":42511,"_5":17394,"_23735":42168,"_2383":42512},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2856":574,"_25078":444,"_17499":42514,"_5":17394,"_23735":42172,"_2383":42515},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2856":575,"_25078":444,"_17499":42517,"_5":17394,"_23735":42176,"_2383":42518},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2856":576,"_25078":444,"_17499":42520,"_5":17394,"_23735":42180,"_2383":42521},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2856":577,"_25078":444,"_17499":42523,"_5":17394,"_23735":42184,"_2383":42524},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2856":578,"_25078":444,"_17499":42526,"_5":17394,"_23735":42184,"_2383":42527},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2856":579,"_25078":444,"_17499":42529,"_5":17394,"_23735":42188,"_2383":42530},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2856":580,"_25078":444,"_17499":42532,"_5":17394,"_23735":42188,"_2383":42533},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2856":581,"_25078":444,"_17499":42535,"_5":17394,"_23735":42188,"_2383":42536},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2856":582,"_25078":444,"_17499":42538,"_5":17394,"_23735":42188,"_2383":42539},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2856":583,"_25078":444,"_17499":42541,"_5":17394,"_23735":42188,"_2383":42542},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2856":584,"_25078":444,"_17499":42544,"_5":17394,"_23735":42188,"_2383":42545},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2856":585,"_25078":444,"_17499":42547,"_5":17394,"_23735":42188,"_2383":42548},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2856":586,"_25078":444,"_17499":42550,"_5":17394,"_23735":42188,"_2383":42551},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2856":587,"_25078":444,"_17499":42553,"_5":17394,"_23735":42192,"_2383":42554},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2856":588,"_25078":444,"_17499":42556,"_5":17394,"_23735":42192,"_2383":42557},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2856":589,"_25078":444,"_17499":42559,"_5":17394,"_23735":42192,"_2383":42560},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2856":590,"_25078":444,"_17499":42562,"_5":17394,"_23735":42196,"_2383":42563},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2856":591,"_25078":444,"_17499":42565,"_5":17394,"_23735":42196,"_2383":42566},[],"Use groups or stable roles for people and independent identities for automations.",{"_2856":592,"_25078":444,"_17499":42568,"_5":17394,"_23735":42196,"_2383":42569},[],"Keep at least two recovery administrators and test their access periodically.",{"_2856":593,"_25078":444,"_17499":42571,"_5":17394,"_23735":42196,"_2383":42572},[],"Review active principals, their matches and their grants after IdP changes.",{"_2856":594,"_25078":444,"_17499":42574,"_5":17394,"_23735":42196,"_2383":42575},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2856":595,"_25078":444,"_17499":42577,"_5":17394,"_23735":42196,"_2383":42578},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2856":596,"_25078":444,"_17499":42580,"_5":17394,"_23735":42196,"_2383":42581},[],"Always test one allowed and one denied operation for each role.",{"_2856":597,"_25078":444,"_17499":42583,"_5":17394,"_23735":42196,"_2383":42584},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2856":598,"_25078":444,"_17499":42586,"_5":17394,"_23735":42204,"_2383":42587},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2856":599,"_25078":444,"_17499":42589,"_5":17394,"_23735":42208,"_2383":42590},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2856":600,"_25078":444,"_17499":42592,"_5":17394,"_23735":42208,"_2383":42593},[],"that an active principal of the correct type exists;",{"_2856":601,"_25078":444,"_17499":42595,"_5":17394,"_23735":42208,"_2383":42596},[],"that the claim paths and values match the real token exactly;",{"_2856":602,"_25078":444,"_17499":42598,"_5":17394,"_23735":42208,"_2383":42599},[],"that all of the principal's conditions hold;",{"_2856":603,"_25078":444,"_17499":42601,"_5":17394,"_23735":42208,"_2383":42602},[],"that the principal has the expected policy granted;",{"_2856":604,"_25078":444,"_17499":42604,"_5":17394,"_23735":42208,"_2383":42605},[],"that the policy includes the action and the requested resource type or route;",{"_2856":605,"_25078":444,"_17499":42607,"_5":17394,"_23735":42208,"_2383":42608},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2856":606,"_25078":444,"_17499":42610,"_5":17394,"_23735":42208,"_2383":42611},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2856":607,"_25078":444,"_17499":42613,"_5":17394,"_23735":42212,"_2383":42614},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2856":608,"_25078":444,"_17499":42616,"_5":17394,"_23735":42216,"_2383":42617},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2856":609,"_25078":444,"_17499":42619,"_5":17394,"_23735":42220,"_2383":42620},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2856":610,"_25078":444,"_17499":42622,"_5":17394,"_23735":42220,"_2383":42623},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2856":611,"_25078":611,"_5":12261,"_2383":42625,"_25413":42626,"_17499":42627,"_23735":611},"Alerts and subscriptions",[40749,42093,42094],[],{"_2856":612,"_25078":611,"_17499":42629,"_5":17394,"_23735":611,"_2383":42630},[],"Send PKI events to people and external systems.",{"_2856":613,"_25078":611,"_5":25410,"_17499":42632,"_23735":42633,"_2383":42634},[],"/docs/pr-preview/pr-40/platform/administration/alerts#how-it-works","How it works",{"_2856":614,"_25078":611,"_5":25410,"_17499":42636,"_23735":42637,"_2383":42638},[],"/docs/pr-preview/pr-40/platform/administration/alerts#available-channels","Available channels",{"_2856":615,"_25078":611,"_5":25410,"_17499":42640,"_23735":42641,"_2383":42642},[],"/docs/pr-preview/pr-40/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2856":616,"_25078":611,"_5":25410,"_17499":42644,"_23735":42645,"_2383":42646},[],"/docs/pr-preview/pr-40/platform/administration/alerts#choose-the-event","Choose the event",{"_2856":617,"_25078":611,"_5":25410,"_17499":42648,"_23735":42649,"_2383":42650},[],"/docs/pr-preview/pr-40/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2856":618,"_25078":611,"_5":25410,"_17499":42652,"_23735":42653,"_2383":42654},[],"/docs/pr-preview/pr-40/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2856":619,"_25078":611,"_5":25410,"_17499":42656,"_23735":42657,"_2383":42658},[],"/docs/pr-preview/pr-40/platform/administration/alerts#review-and-activate","Review and activate",{"_2856":620,"_25078":611,"_5":25410,"_17499":42660,"_23735":42661,"_2383":42662},[],"/docs/pr-preview/pr-40/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2856":621,"_25078":611,"_5":25410,"_17499":42664,"_23735":42665,"_2383":42666},[],"/docs/pr-preview/pr-40/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2856":622,"_25078":611,"_5":25410,"_17499":42668,"_23735":42669,"_2383":42670},[],"/docs/pr-preview/pr-40/platform/administration/alerts#event-families","Event families",{"_2856":623,"_25078":611,"_17499":42672,"_5":17394,"_23735":611,"_2383":42673},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2856":624,"_25078":611,"_17499":42675,"_5":17394,"_23735":42633,"_2383":42676},[],"A service publishes a domain event.",{"_2856":625,"_25078":611,"_17499":42678,"_5":17394,"_23735":42633,"_2383":42679},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2856":626,"_25078":611,"_17499":42681,"_5":17394,"_23735":42633,"_2383":42682},[],"Each subscription's filter decides whether it should be notified.",{"_2856":627,"_25078":611,"_17499":42684,"_5":17394,"_23735":42633,"_2383":42685},[],"Lamassu delivers the event to the configured channel.",{"_2856":628,"_25078":611,"_17499":42687,"_5":17394,"_23735":42633,"_2383":42688},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2856":629,"_25078":611,"_17499":42690,"_5":17394,"_23735":42637,"_2383":42691},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2856":630,"_25078":611,"_17499":42693,"_5":17394,"_23735":42637,"_2383":42694},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2856":631,"_25078":611,"_17499":42696,"_5":17394,"_23735":42637,"_2383":42697},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2856":632,"_25078":611,"_17499":42699,"_5":17394,"_23735":42637,"_2383":42700},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2856":633,"_25078":611,"_17499":42702,"_5":17394,"_23735":42637,"_2383":42703},[],"`apikey_options` requires `header` and `key`.",{"_2856":634,"_25078":611,"_17499":42705,"_5":17394,"_23735":42637,"_2383":42706},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2856":635,"_25078":611,"_17499":42708,"_5":17394,"_23735":42637,"_2383":42709},[],"`mtls_options` requires the inline PEM `cert_content` and `key_content`; values that reference files on the server are rejected.",{"_2856":636,"_25078":611,"_17499":42711,"_5":17394,"_23735":42637,"_2383":42712},[],"The alerts API reference documents the full `http_client` schema.",{"_2856":637,"_25078":611,"_17499":42714,"_5":17394,"_23735":42645,"_2383":42715},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2856":638,"_25078":611,"_17499":42717,"_5":17394,"_23735":42649,"_2383":42718},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2856":639,"_25078":611,"_17499":42720,"_5":17394,"_23735":42653,"_2383":42721},[],"Add a filter if you don't want to receive every instance of the event.",{"_2856":640,"_25078":611,"_17499":42723,"_5":17394,"_23735":42653,"_2383":42724},[],"**None** notifies all instances of the event.",{"_2856":641,"_25078":611,"_17499":42726,"_5":17394,"_23735":42653,"_2383":42727},[],"**JSON Path** evaluates one or more specific fields.",{"_2856":642,"_25078":611,"_17499":42729,"_5":17394,"_23735":42653,"_2383":42730},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2856":643,"_25078":611,"_17499":42732,"_5":17394,"_23735":42653,"_2383":42733},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2856":644,"_25078":611,"_17499":42735,"_5":17394,"_23735":42653,"_2383":42736},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2856":645,"_25078":611,"_17499":42738,"_5":17394,"_23735":42657,"_2383":42739},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2856":646,"_25078":611,"_17499":42741,"_5":17394,"_23735":42661,"_2383":42742},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2856":647,"_25078":611,"_17499":42744,"_5":17394,"_23735":42661,"_2383":42745},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2856":648,"_25078":611,"_17499":42747,"_5":17394,"_23735":42661,"_2383":42748},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2856":649,"_25078":611,"_17499":42750,"_5":17394,"_23735":42661,"_2383":42751},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2856":650,"_25078":611,"_17499":42753,"_5":17394,"_23735":42661,"_2383":42754},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2856":651,"_25078":611,"_17499":42756,"_5":17394,"_23735":42661,"_2383":42757},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2856":652,"_25078":611,"_17499":42759,"_5":17394,"_23735":42661,"_2383":42760},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2856":653,"_25078":611,"_17499":42762,"_5":17394,"_23735":42661,"_2383":42763},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2856":654,"_25078":611,"_17499":42765,"_5":17394,"_23735":42665,"_2383":42766},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2856":655,"_25078":611,"_17499":42768,"_5":17394,"_23735":42669,"_2383":42769},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2856":656,"_25078":611,"_17499":42771,"_5":17394,"_23735":42669,"_2383":42772},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2856":657,"_25078":611,"_17499":42774,"_5":17394,"_23735":42669,"_2383":42775},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2856":658,"_25078":611,"_17499":42777,"_5":17394,"_23735":42669,"_2383":42778},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2856":659,"_25078":611,"_17499":42780,"_5":17394,"_23735":42669,"_2383":42781},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2856":660,"_25078":611,"_17499":42783,"_5":17394,"_23735":42669,"_2383":42784},[],"**Validation:** `va.role.crl.create`.",{"_2856":661,"_25078":611,"_17499":42786,"_5":17394,"_23735":42669,"_2383":42787},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2856":662,"_25078":611,"_17499":42789,"_5":17394,"_23735":42669,"_2383":42790},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2856":663,"_25078":663,"_5":12261,"_2383":42792,"_25413":42793,"_17499":42794,"_23735":663},"Audit logs",[40749,42093,42094],[],{"_2856":664,"_25078":663,"_17499":42796,"_5":17394,"_23735":663,"_2383":42797},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2856":665,"_25078":663,"_5":25410,"_17499":42799,"_23735":42800,"_2383":42801},[],"/docs/pr-preview/pr-40/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2856":666,"_25078":663,"_5":25410,"_17499":42803,"_23735":42804,"_2383":42805},[],"/docs/pr-preview/pr-40/platform/administration/audit-logs#coverage","Coverage",{"_2856":667,"_25078":663,"_5":25410,"_17499":42807,"_23735":42808,"_2383":42809},[],"/docs/pr-preview/pr-40/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2856":668,"_25078":663,"_5":25410,"_17499":42811,"_23735":42812,"_2383":42813},[],"/docs/pr-preview/pr-40/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2856":669,"_25078":663,"_5":25410,"_17499":42815,"_23735":42816,"_2383":42817},[],"/docs/pr-preview/pr-40/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2856":670,"_25078":663,"_5":25410,"_17499":42819,"_23735":42820,"_2383":42821},[],"/docs/pr-preview/pr-40/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2856":671,"_25078":663,"_5":25410,"_17499":42823,"_23735":42824,"_2383":42825},[],"/docs/pr-preview/pr-40/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2856":672,"_25078":663,"_5":25410,"_17499":42827,"_23735":42828,"_2383":42829},[],"/docs/pr-preview/pr-40/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2856":673,"_25078":663,"_5":25410,"_17499":42831,"_23735":42832,"_2383":42833},[],"/docs/pr-preview/pr-40/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2856":674,"_25078":663,"_5":25410,"_17499":42835,"_23735":42836,"_2383":42837},[],"/docs/pr-preview/pr-40/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2856":675,"_25078":663,"_5":25410,"_17499":42839,"_23735":42840,"_2383":42841},[],"/docs/pr-preview/pr-40/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2856":676,"_25078":663,"_17499":42843,"_5":17394,"_23735":663,"_2383":42844},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2856":677,"_25078":663,"_17499":42846,"_5":17394,"_23735":42800,"_2383":42847},[],"The audit body includes:",{"_2856":678,"_25078":663,"_17499":42849,"_5":17394,"_23735":42800,"_2383":42850},[],"input: data received by the operation;",{"_2856":679,"_25078":663,"_17499":42852,"_5":17394,"_23735":42800,"_2383":42853},[],"has\\_error: whether the service returned an error;",{"_2856":680,"_25078":663,"_17499":42855,"_5":17394,"_23735":42800,"_2383":42856},[],"output: produced result or error message;",{"_2856":681,"_25078":663,"_17499":42858,"_5":17394,"_23735":42800,"_2383":42859},[],"principals: identifiers of the principals that matched the request.",{"_2856":682,"_25078":663,"_17499":42861,"_5":17394,"_23735":42800,"_2383":42862},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2856":683,"_25078":663,"_17499":42864,"_5":17394,"_23735":42800,"_2383":42865},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2856":684,"_25078":663,"_17499":42867,"_5":17394,"_23735":42804,"_2383":42868},[],"The backend applies auditing to mutations of:",{"_2856":685,"_25078":663,"_17499":42870,"_5":17394,"_23735":42804,"_2383":42871},[],"authorities, certificates and issuance profiles;",{"_2856":686,"_25078":663,"_17499":42873,"_5":17394,"_23735":42804,"_2383":42874},[],"keys and KMS engines;",{"_2856":687,"_25078":663,"_17499":42876,"_5":17394,"_23735":42804,"_2383":42877},[],"devices and identities;",{"_2856":688,"_25078":663,"_17499":42879,"_5":17394,"_23735":42804,"_2383":42880},[],"DMSs and enrollment operations;",{"_2856":689,"_25078":663,"_17499":42882,"_5":17394,"_23735":42804,"_2383":42883},[],"validation functions and CRL;",{"_2856":690,"_25078":663,"_17499":42885,"_5":17394,"_23735":42804,"_2383":42886},[],"principals, policies and authorization grants.",{"_2856":691,"_25078":663,"_17499":42888,"_5":17394,"_23735":42804,"_2383":42889},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2856":692,"_25078":663,"_17499":42891,"_5":17394,"_23735":42808,"_2383":42892},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2856":693,"_25078":663,"_17499":42894,"_5":17394,"_23735":42808,"_2383":42895},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2856":694,"_25078":663,"_17499":42897,"_5":17394,"_23735":42808,"_2383":42898},[],"Design the consumer to:",{"_2856":695,"_25078":663,"_17499":42900,"_5":17394,"_23735":42808,"_2383":42901},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2856":696,"_25078":663,"_17499":42903,"_5":17394,"_23735":42808,"_2383":42904},[],"keep the complete CloudEvent unmodified;",{"_2856":697,"_25078":663,"_17499":42906,"_5":17394,"_23735":42808,"_2383":42907},[],"record the ingestion time and detect duplicates by ID;",{"_2856":698,"_25078":663,"_17499":42909,"_5":17394,"_23735":42808,"_2383":42910},[],"encrypt in transit and at rest;",{"_2856":699,"_25078":663,"_17499":42912,"_5":17394,"_23735":42808,"_2383":42913},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2856":700,"_25078":663,"_17499":42915,"_5":17394,"_23735":42808,"_2383":42916},[],"apply an explicit retention and legal hold policy;",{"_2856":701,"_25078":663,"_17499":42918,"_5":17394,"_23735":42808,"_2383":42919},[],"alert if it stops consuming or the pending queue grows.",{"_2856":702,"_25078":663,"_17499":42921,"_5":17394,"_23735":42812,"_2383":42922},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2856":703,"_25078":663,"_17499":42924,"_5":17394,"_23735":42812,"_2383":42925},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2856":704,"_25078":663,"_17499":42927,"_5":17394,"_23735":42820,"_2383":42928},[],"Start from the reported time and normalize every source to UTC.",{"_2856":705,"_25078":663,"_17499":42930,"_5":17394,"_23735":42824,"_2383":42931},[],"Filter by event type, service source and resource identifier.",{"_2856":706,"_25078":663,"_17499":42933,"_5":17394,"_23735":42828,"_2383":42934},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2856":707,"_25078":663,"_17499":42936,"_5":17394,"_23735":42832,"_2383":42937},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2856":708,"_25078":663,"_17499":42939,"_5":17394,"_23735":42836,"_2383":42940},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2856":709,"_25078":663,"_17499":42942,"_5":17394,"_23735":42840,"_2383":42943},[],"Generate a controlled mutation in a test environment and check that:",{"_2856":710,"_25078":663,"_17499":42945,"_5":17394,"_23735":42840,"_2383":42946},[],"a successful audit event appears;",{"_2856":711,"_25078":663,"_17499":42948,"_5":17394,"_23735":42840,"_2383":42949},[],"the principal matches the identity used;",{"_2856":712,"_25078":663,"_17499":42951,"_5":17394,"_23735":42840,"_2383":42952},[],"the consumer persists it exactly once;",{"_2856":713,"_25078":663,"_17499":42954,"_5":17394,"_23735":42840,"_2383":42955},[],"it can be retrieved by resource, actor and period;",{"_2856":714,"_25078":663,"_17499":42957,"_5":17394,"_23735":42840,"_2383":42958},[],"a consumer outage raises an alert.",{"_2856":715,"_25078":663,"_17499":42960,"_5":17394,"_23735":42840,"_2383":42961},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2856":716,"_25078":716,"_5":12261,"_2383":42963,"_25413":42964,"_17499":42965,"_23735":716},"Platform architecture",[40749,42093],[],{"_2856":717,"_25078":716,"_17499":42967,"_5":17394,"_23735":716,"_2383":42968},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2856":718,"_25078":716,"_5":25410,"_17499":42970,"_23735":42971,"_2383":42972},[],"/docs/pr-preview/pr-40/platform/concepts/architecture#control-plane","Control plane",{"_2856":719,"_25078":716,"_5":25410,"_17499":42974,"_23735":42975,"_2383":42976},[],"/docs/pr-preview/pr-40/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2856":720,"_25078":716,"_5":25410,"_17499":42978,"_23735":42979,"_2383":42980},[],"/docs/pr-preview/pr-40/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2856":721,"_25078":716,"_5":25410,"_17499":42982,"_23735":42983,"_2383":42984},[],"/docs/pr-preview/pr-40/platform/concepts/architecture#status-and-validation","Status and validation",{"_2856":722,"_25078":716,"_5":25410,"_17499":42986,"_23735":42987,"_2383":42988},[],"/docs/pr-preview/pr-40/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2856":723,"_25078":716,"_17499":42990,"_5":17394,"_23735":716,"_2383":42991},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2856":724,"_25078":716,"_17499":42993,"_5":17394,"_23735":716,"_2383":42994},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2856":725,"_25078":716,"_17499":42996,"_5":17394,"_23735":42971,"_2383":42997},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2856":726,"_25078":716,"_17499":42999,"_5":17394,"_23735":42975,"_2383":43000},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2856":727,"_25078":716,"_17499":43002,"_5":17394,"_23735":42979,"_2383":43003},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2856":728,"_25078":716,"_17499":43005,"_5":17394,"_23735":42983,"_2383":43006},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2856":729,"_25078":716,"_17499":43008,"_5":17394,"_23735":42987,"_2383":43009},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2856":730,"_25078":730,"_5":12261,"_2383":43011,"_25413":43012,"_17499":43013,"_23735":730},"How Lamassu works",[40749,42093],[],{"_2856":731,"_25078":730,"_17499":43015,"_5":17394,"_23735":730,"_2383":43016},[],"The mental model of trust, keys, certificates and devices.",{"_2856":732,"_25078":730,"_5":25410,"_17499":43018,"_23735":43019,"_2383":43020},[],"/docs/pr-preview/pr-40/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2856":733,"_25078":730,"_5":25410,"_17499":43022,"_23735":43023,"_2383":43024},[],"/docs/pr-preview/pr-40/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2856":734,"_25078":730,"_17499":43026,"_5":17394,"_23735":730,"_2383":43027},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2856":735,"_25078":730,"_17499":43029,"_5":17394,"_23735":43019,"_2383":43030},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2856":736,"_25078":730,"_17499":43032,"_5":17394,"_23735":43019,"_2383":43033},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2856":737,"_25078":730,"_17499":43035,"_5":17394,"_23735":43019,"_2383":43036},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2856":738,"_25078":730,"_17499":43038,"_5":17394,"_23735":43019,"_2383":43039},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2856":739,"_25078":730,"_17499":43041,"_5":17394,"_23735":43019,"_2383":43042},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2856":740,"_25078":730,"_17499":43044,"_5":17394,"_23735":43023,"_2383":43045},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2856":741,"_25078":730,"_17499":43047,"_5":17394,"_23735":43023,"_2383":43048},[],"A DMS relates that CA to an enrollment policy.",{"_2856":742,"_25078":730,"_17499":43050,"_5":17394,"_23735":43023,"_2383":43051},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2856":743,"_25078":730,"_17499":43053,"_5":17394,"_23735":43023,"_2383":43054},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2856":744,"_25078":730,"_17499":43056,"_5":17394,"_23735":43023,"_2383":43057},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2856":745,"_25078":730,"_17499":43059,"_5":17394,"_23735":43023,"_2383":43060},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2856":746,"_25078":730,"_17499":43062,"_5":17394,"_23735":43023,"_2383":43063},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2856":747,"_25078":747,"_5":12261,"_2383":43065,"_25413":43066,"_17499":43068,"_23735":747},"Devices and identities",[40749,42093,43067,43065],"IoT Fleets",[],{"_2856":748,"_25078":747,"_17499":43070,"_5":17394,"_23735":747,"_2383":43071},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2856":749,"_25078":747,"_5":25410,"_17499":43073,"_23735":43074,"_2383":43075},[],"/docs/pr-preview/pr-40/platform/iot-fleets/device-management#device-states","Device states",{"_2856":750,"_25078":747,"_5":25410,"_17499":43077,"_23735":43078,"_2383":43079},[],"/docs/pr-preview/pr-40/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2856":751,"_25078":747,"_5":25410,"_17499":43081,"_23735":43082,"_2383":43083},[],"/docs/pr-preview/pr-40/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2856":752,"_25078":747,"_5":25410,"_17499":43085,"_23735":43086,"_2383":43087},[],"/docs/pr-preview/pr-40/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2856":753,"_25078":747,"_5":25410,"_17499":43089,"_23735":43090,"_2383":43091},[],"/docs/pr-preview/pr-40/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2856":754,"_25078":747,"_5":25410,"_17499":43093,"_23735":43094,"_2383":43095},[],"/docs/pr-preview/pr-40/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2856":755,"_25078":747,"_5":25410,"_17499":43097,"_23735":43098,"_2383":43099},[],"/docs/pr-preview/pr-40/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2856":756,"_25078":747,"_5":25410,"_17499":43101,"_23735":43102,"_2383":43103},[],"/docs/pr-preview/pr-40/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2856":757,"_25078":747,"_5":25410,"_17499":43105,"_23735":43106,"_2383":43107},[],"/docs/pr-preview/pr-40/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2856":758,"_25078":747,"_5":25410,"_17499":43109,"_23735":43110,"_2383":43111},[],"/docs/pr-preview/pr-40/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2856":759,"_25078":747,"_5":25410,"_17499":43113,"_23735":43114,"_2383":43115},[],"/docs/pr-preview/pr-40/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2856":760,"_25078":747,"_17499":43117,"_5":17394,"_23735":747,"_2383":43118},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2856":761,"_25078":747,"_17499":43120,"_5":17394,"_23735":747,"_2383":43121},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2856":762,"_25078":747,"_17499":43123,"_5":17394,"_23735":43074,"_2383":43124},[],"Operational view",{"_2856":763,"_25078":747,"_17499":43126,"_5":17394,"_23735":43074,"_2383":43127},[],"Meaning",{"_2856":764,"_25078":747,"_17499":43129,"_5":17394,"_23735":43074,"_2383":43130},[],"**No Identity**",{"_2856":765,"_25078":747,"_17499":43132,"_5":17394,"_23735":43074,"_2383":43133},[],"A record exists without an associated identity.",{"_2856":766,"_25078":747,"_17499":43135,"_5":17394,"_23735":43074,"_2383":43136},[],"**Active**",{"_2856":767,"_25078":747,"_17499":43138,"_5":17394,"_23735":43074,"_2383":43139},[],"The slot is active; also check certificate dates, status and usages.",{"_2856":768,"_25078":747,"_17499":43141,"_5":17394,"_23735":43074,"_2383":43142},[],"**Renewal Pending**",{"_2856":769,"_25078":747,"_17499":43144,"_5":17394,"_23735":43074,"_2383":43145},[],"The identity is in the operational renewal window.",{"_2856":770,"_25078":747,"_17499":43147,"_5":17394,"_23735":43074,"_2383":43148},[],"**Expiring Soon**",{"_2856":771,"_25078":747,"_17499":43150,"_5":17394,"_23735":43074,"_2383":43151},[],"Expiration is approaching according to configured thresholds.",{"_2856":772,"_25078":747,"_17499":43153,"_5":17394,"_23735":43074,"_2383":43154},[],"**Expired**",{"_2856":773,"_25078":747,"_17499":43156,"_5":17394,"_23735":43074,"_2383":43157},[],"The identity has expired.",{"_2856":774,"_25078":747,"_17499":43159,"_5":17394,"_23735":43074,"_2383":43160},[],"**Revoked**",{"_2856":775,"_25078":747,"_17499":43162,"_5":17394,"_23735":43074,"_2383":43163},[],"The identity is marked revoked.",{"_2856":776,"_25078":747,"_17499":43165,"_5":17394,"_23735":43074,"_2383":43166},[],"**Decommissioned**",{"_2856":777,"_25078":747,"_17499":43168,"_5":17394,"_23735":43074,"_2383":43169},[],"The record is retired and ordinary updates do not restore operation.",{"_2856":778,"_25078":747,"_17499":43171,"_5":17394,"_23735":43074,"_2383":43172},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2856":779,"_25078":747,"_17499":43174,"_5":17394,"_23735":43078,"_2383":43175},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2856":780,"_25078":747,"_17499":43177,"_5":17394,"_23735":43078,"_2383":43178},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2856":781,"_25078":747,"_17499":43180,"_5":17394,"_23735":43078,"_2383":43181},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2856":782,"_25078":747,"_17499":43183,"_5":17394,"_23735":43078,"_2383":43184},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2856":783,"_25078":747,"_17499":43186,"_5":17394,"_23735":43082,"_2383":43187},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2856":784,"_25078":747,"_17499":43189,"_5":17394,"_23735":43086,"_2383":43190},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2856":785,"_25078":747,"_17499":43192,"_5":17394,"_23735":43090,"_2383":43193},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2856":786,"_25078":747,"_17499":43195,"_5":17394,"_23735":43094,"_2383":43196},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2856":787,"_25078":747,"_17499":43198,"_5":17394,"_23735":43098,"_2383":43199},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2856":788,"_25078":747,"_17499":43201,"_5":17394,"_23735":43098,"_2383":43202},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2856":789,"_25078":747,"_17499":43204,"_5":17394,"_23735":43102,"_2383":43205},[],"From **No Identity**, use **Assign Identity**:",{"_2856":790,"_25078":747,"_17499":43207,"_5":17394,"_23735":43102,"_2383":43208},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2856":791,"_25078":747,"_17499":43210,"_5":17394,"_23735":43102,"_2383":43211},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2856":792,"_25078":747,"_17499":43213,"_5":17394,"_23735":43102,"_2383":43214},[],"Confirm and read the serial, active version and history again.",{"_2856":793,"_25078":747,"_17499":43216,"_5":17394,"_23735":43102,"_2383":43217},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2856":794,"_25078":747,"_17499":43219,"_5":17394,"_23735":43102,"_2383":43220},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2856":795,"_25078":747,"_17499":43222,"_5":17394,"_23735":43106,"_2383":43223},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2856":796,"_25078":747,"_17499":43225,"_5":17394,"_23735":43106,"_2383":43226},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2856":797,"_25078":747,"_17499":43228,"_5":17394,"_23735":43110,"_2383":43229},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2856":798,"_25078":747,"_17499":43231,"_5":17394,"_23735":43110,"_2383":43232},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2856":799,"_25078":747,"_17499":43234,"_5":17394,"_23735":43110,"_2383":43235},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2856":800,"_25078":747,"_17499":43237,"_5":17394,"_23735":43110,"_2383":43238},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2856":801,"_25078":747,"_17499":43240,"_5":17394,"_23735":43114,"_2383":43241},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2856":802,"_25078":747,"_17499":43243,"_5":17394,"_23735":43114,"_2383":43244},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2856":803,"_25078":803,"_5":12261,"_2383":43246,"_25413":43247,"_17499":43249,"_23735":803},"Bootstrap identity and authentication",[40749,42093,43067,43065,43248],"Enrollment with PKI",[],{"_2856":804,"_25078":803,"_17499":43251,"_5":17394,"_23735":803,"_2383":43252},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2856":805,"_25078":803,"_5":25410,"_17499":43254,"_23735":43255,"_2383":43256},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2856":806,"_25078":803,"_5":25410,"_17499":43258,"_23735":43259,"_2383":43260},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2856":807,"_25078":803,"_5":25410,"_17499":43262,"_23735":43263,"_2383":43264},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2856":808,"_25078":803,"_5":25410,"_17499":43266,"_23735":43267,"_2383":43268},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2856":809,"_25078":803,"_5":25410,"_17499":43270,"_23735":43271,"_2383":43272},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2856":810,"_25078":803,"_17499":43274,"_5":17394,"_23735":803,"_2383":43275},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2856":811,"_25078":803,"_17499":43277,"_5":17394,"_23735":43255,"_2383":43278},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2856":812,"_25078":803,"_17499":43280,"_5":17394,"_23735":43255,"_2383":43281},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2856":813,"_25078":803,"_17499":43283,"_5":17394,"_23735":43259,"_2383":43284},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2856":814,"_25078":803,"_17499":43286,"_5":17394,"_23735":43259,"_2383":43287},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2856":815,"_25078":803,"_17499":43289,"_5":17394,"_23735":43259,"_2383":43290},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2856":816,"_25078":803,"_17499":43292,"_5":17394,"_23735":43263,"_2383":43293},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2856":817,"_25078":803,"_17499":43295,"_5":17394,"_23735":43263,"_2383":43296},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2856":818,"_25078":803,"_17499":43298,"_5":17394,"_23735":43267,"_2383":43299},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2856":819,"_25078":803,"_17499":43301,"_5":17394,"_23735":43267,"_2383":43302},[],"Example body:",{"_2856":820,"_25078":803,"_17499":43304,"_5":17394,"_23735":43267,"_2383":43305},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2856":821,"_25078":803,"_17499":43307,"_5":17394,"_23735":43267,"_2383":43308},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2856":822,"_25078":803,"_17499":43310,"_5":17394,"_23735":43267,"_2383":43311},[],"Continuation requires a successful HTTP response and JSON:",{"_2856":823,"_25078":803,"_17499":43313,"_5":17394,"_23735":43267,"_2383":43314},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2856":824,"_25078":803,"_17499":43316,"_5":17394,"_23735":43271,"_2383":43317},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2856":825,"_25078":803,"_17499":43319,"_5":17394,"_23735":43271,"_2383":43320},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2856":826,"_25078":826,"_5":12261,"_2383":43322,"_25413":43323,"_17499":43324,"_23735":826},"Configure and operate the DMS",[40749,42093,43067,43065,43248],[],{"_2856":827,"_25078":826,"_17499":43326,"_5":17394,"_23735":826,"_2383":43327},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2856":828,"_25078":826,"_5":25410,"_17499":43329,"_23735":43330,"_2383":40759},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2856":829,"_25078":826,"_5":25410,"_17499":43332,"_23735":43333,"_2383":43334},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2856":830,"_25078":826,"_5":25410,"_17499":43336,"_23735":43337,"_2383":43338},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2856":831,"_25078":826,"_5":25410,"_17499":43340,"_23735":43341,"_2383":43342},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2856":832,"_25078":826,"_5":25410,"_17499":43344,"_23735":43345,"_2383":43346},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2856":833,"_25078":826,"_5":25410,"_17499":43348,"_23735":43349,"_2383":43350},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2856":834,"_25078":826,"_5":25410,"_17499":43352,"_23735":43353,"_2383":43354},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2856":835,"_25078":826,"_5":25410,"_17499":43356,"_23735":43357,"_2383":43358},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2856":836,"_25078":826,"_5":25410,"_17499":43360,"_23735":43361,"_2383":43362},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2856":837,"_25078":826,"_5":25410,"_17499":43364,"_23735":43365,"_2383":43366},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2856":838,"_25078":826,"_5":25410,"_17499":43368,"_23735":43369,"_2383":43370},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2856":839,"_25078":826,"_5":25410,"_17499":43372,"_23735":43373,"_2383":43374},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2856":840,"_25078":826,"_5":25410,"_17499":43376,"_23735":43377,"_2383":43378},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2856":841,"_25078":826,"_5":25410,"_17499":43380,"_23735":43381,"_2383":43382},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2856":842,"_25078":826,"_5":25410,"_17499":43384,"_23735":43385,"_2383":43386},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2856":843,"_25078":826,"_5":25410,"_17499":43388,"_23735":43389,"_2383":43390},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2856":844,"_25078":826,"_5":25410,"_17499":43392,"_23735":43393,"_2383":43394},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2856":845,"_25078":826,"_5":25410,"_17499":43396,"_23735":43397,"_2383":43398},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2856":846,"_25078":826,"_17499":43400,"_5":17394,"_23735":826,"_2383":43401},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2856":847,"_25078":826,"_17499":43403,"_5":17394,"_23735":43330,"_2383":43404},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2856":848,"_25078":826,"_17499":43406,"_5":17394,"_23735":43330,"_2383":43407},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2856":849,"_25078":826,"_17499":43409,"_5":17394,"_23735":43337,"_2383":43410},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2856":850,"_25078":826,"_17499":43412,"_5":17394,"_23735":43341,"_2383":43413},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2856":851,"_25078":826,"_17499":43415,"_5":17394,"_23735":43345,"_2383":43416},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2856":852,"_25078":826,"_17499":43418,"_5":17394,"_23735":43349,"_2383":43419},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2856":853,"_25078":826,"_17499":43421,"_5":17394,"_23735":43353,"_2383":43422},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2856":854,"_25078":826,"_17499":43424,"_5":17394,"_23735":43361,"_2383":43425},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2856":855,"_25078":826,"_17499":43427,"_5":17394,"_23735":43361,"_2383":43428},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2856":856,"_25078":826,"_17499":43430,"_5":17394,"_23735":43365,"_2383":43431},[],"`settings.enrollment_settings` field",{"_2856":857,"_25078":826,"_17499":43433,"_5":17394,"_23735":43365,"_2383":43434},[],"Decision",{"_2856":858,"_25078":826,"_17499":43436,"_5":17394,"_23735":43365,"_2383":43437},[],"`protocol`",{"_2856":859,"_25078":826,"_17499":43439,"_5":17394,"_23735":43365,"_2383":43440},[],"`EST_RFC7030` for these operations.",{"_2856":860,"_25078":826,"_17499":43442,"_5":17394,"_23735":43365,"_2383":43443},[],"`enrollment_ca`",{"_2856":861,"_25078":826,"_17499":43445,"_5":17394,"_23735":43365,"_2383":43446},[],"ID of the signing CA.",{"_2856":862,"_25078":826,"_17499":43448,"_5":17394,"_23735":43365,"_2383":43449},[],"`verify_csr_signature`",{"_2856":863,"_25078":826,"_17499":43451,"_5":17394,"_23735":43365,"_2383":43452},[],"Keep `true` to verify CSR key possession.",{"_2856":864,"_25078":826,"_17499":43454,"_5":17394,"_23735":43365,"_2383":43455},[],"`enable_replaceable_enrollment`",{"_2856":865,"_25078":826,"_17499":43457,"_5":17394,"_23735":43365,"_2383":43458},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2856":866,"_25078":826,"_17499":43460,"_5":17394,"_23735":43365,"_2383":43461},[],"`est_rfc7030_settings.auth_mode`",{"_2856":867,"_25078":826,"_17499":43463,"_5":17394,"_23735":43365,"_2383":43464},[],"One of the four authentication modes.",{"_2856":868,"_25078":826,"_17499":43466,"_5":17394,"_23735":43365,"_2383":43467},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2856":869,"_25078":826,"_17499":43469,"_5":17394,"_23735":43369,"_2383":43470},[],"The blocks are independent:",{"_2856":870,"_25078":826,"_17499":43472,"_5":17394,"_23735":43369,"_2383":43473},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2856":871,"_25078":826,"_17499":43475,"_5":17394,"_23735":43369,"_2383":43476},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2856":872,"_25078":826,"_17499":43478,"_5":17394,"_23735":43369,"_2383":43479},[],"`auth_mode`",{"_2856":873,"_25078":826,"_17499":43481,"_5":17394,"_23735":43369,"_2383":43482},[],"Control applied in the configured operation",{"_2856":874,"_25078":826,"_17499":43484,"_5":17394,"_23735":43369,"_2383":43485},[],"`CLIENT_CERTIFICATE`",{"_2856":875,"_25078":826,"_17499":43487,"_5":17394,"_23735":43369,"_2383":43488},[],"Presented certificate validation.",{"_2856":876,"_25078":826,"_17499":43490,"_5":17394,"_23735":43369,"_2383":43491},[],"`EXTERNAL_WEBHOOK`",{"_2856":877,"_25078":826,"_17499":43493,"_5":17394,"_23735":43369,"_2383":43494},[],"Configured webhook authorization.",{"_2856":878,"_25078":826,"_17499":43496,"_5":17394,"_23735":43369,"_2383":43497},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2856":879,"_25078":826,"_17499":43499,"_5":17394,"_23735":43369,"_2383":43500},[],"Certificate validation followed by webhook approval.",{"_2856":880,"_25078":826,"_17499":43502,"_5":17394,"_23735":43369,"_2383":43503},[],"`NO_AUTH`",{"_2856":881,"_25078":826,"_17499":43505,"_5":17394,"_23735":43369,"_2383":43506},[],"No DMS requester authentication.",{"_2856":882,"_25078":826,"_17499":43508,"_5":17394,"_23735":43369,"_2383":43509},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2856":883,"_25078":826,"_17499":43511,"_5":17394,"_23735":43369,"_2383":43512},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2856":884,"_25078":826,"_17499":43514,"_5":17394,"_23735":43369,"_2383":43515},[],"For certificate re-enrollment, the validator uses the enrollment CA, the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, and `enable_expired_renewal`. That list is optional because the enrollment CA is always trusted for re-enrollment; the re-enrollment validator does not read the initial block's `validation_cas`.",{"_2856":885,"_25078":826,"_17499":43517,"_5":17394,"_23735":43369,"_2383":43518},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2856":886,"_25078":826,"_17499":43520,"_5":17394,"_23735":43373,"_2383":43521},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2856":887,"_25078":826,"_17499":43523,"_5":17394,"_23735":43373,"_2383":43524},[],"`external_webhook_settings` field",{"_2856":888,"_25078":826,"_17499":43526,"_5":17394,"_23735":43373,"_2383":43434},[],{"_2856":889,"_25078":826,"_17499":43528,"_5":17394,"_23735":43373,"_2383":43529},[],"`url`",{"_2856":890,"_25078":826,"_17499":43531,"_5":17394,"_23735":43373,"_2383":43532},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2856":891,"_25078":826,"_17499":43534,"_5":17394,"_23735":43373,"_2383":43535},[],"`method`",{"_2856":892,"_25078":826,"_17499":43537,"_5":17394,"_23735":43373,"_2383":43538},[],"`POST` or `PUT`; `POST` by default.",{"_2856":893,"_25078":826,"_17499":43540,"_5":17394,"_23735":43373,"_2383":43541},[],"`name`",{"_2856":894,"_25078":826,"_17499":43543,"_5":17394,"_23735":43373,"_2383":43544},[],"Label used in service logs.",{"_2856":895,"_25078":826,"_17499":43546,"_5":17394,"_23735":43373,"_2383":43547},[],"`config.auth_mode`",{"_2856":896,"_25078":826,"_17499":43549,"_5":17394,"_23735":43373,"_2383":43550},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2856":897,"_25078":826,"_17499":43552,"_5":17394,"_23735":43373,"_2383":43553},[],"`config.apikey_options`",{"_2856":898,"_25078":826,"_17499":43555,"_5":17394,"_23735":43373,"_2383":43556},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2856":899,"_25078":826,"_17499":43558,"_5":17394,"_23735":43373,"_2383":43559},[],"`config.jwt_options`",{"_2856":900,"_25078":826,"_17499":43561,"_5":17394,"_23735":43373,"_2383":43562},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2856":901,"_25078":826,"_17499":43564,"_5":17394,"_23735":43373,"_2383":43565},[],"`config.mtls_options`",{"_2856":902,"_25078":826,"_17499":43567,"_5":17394,"_23735":43373,"_2383":43568},[],"Required for `mtls`: `cert_content` and `key_content` as inline PEM.",{"_2856":903,"_25078":826,"_17499":43570,"_5":17394,"_23735":43373,"_2383":43571},[],"`config.insecure_skip_verify`",{"_2856":904,"_25078":826,"_17499":43573,"_5":17394,"_23735":43373,"_2383":43574},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2856":905,"_25078":826,"_17499":43576,"_5":17394,"_23735":43373,"_2383":43577},[],"`config.call_timeout`",{"_2856":906,"_25078":826,"_17499":43579,"_5":17394,"_23735":43373,"_2383":43580},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2856":907,"_25078":826,"_17499":43582,"_5":17394,"_23735":43373,"_2383":43583},[],"Rules for that configuration:",{"_2856":908,"_25078":826,"_17499":43585,"_5":17394,"_23735":43373,"_2383":43586},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so supply the PEM as `mtls_options.cert_content` and `key_content`.",{"_2856":909,"_25078":826,"_17499":43588,"_5":17394,"_23735":43373,"_2383":43589},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2856":910,"_25078":826,"_17499":43591,"_5":17394,"_23735":43373,"_2383":43592},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2856":911,"_25078":826,"_17499":43594,"_5":17394,"_23735":43373,"_2383":43595},[],"The API ignores the legacy fields `validate_server_cert`, `apikey`, `oidc` and `mtls`. A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` that still carries only the legacy option fields (`apikey`, `oidc`, `mtls`) fails validation with 400; only legacy `noauth` bodies are accepted, and their credentials are dropped.",{"_2856":912,"_25078":826,"_17499":43597,"_5":17394,"_23735":43373,"_2383":43598},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2856":913,"_25078":826,"_17499":43600,"_5":17394,"_23735":43373,"_2383":43601},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2856":914,"_25078":826,"_17499":43603,"_5":17394,"_23735":43373,"_2383":43604},[],"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API.",{"_2856":915,"_25078":826,"_17499":43606,"_5":17394,"_23735":43373,"_2383":43607},[],"Migration `20261021120000` rewrites every stored webhook config into this layout: `validate_server_cert` becomes the negated `insecure_skip_verify` (a config where `validate_server_cert` was false keeps skipping verification), `oidc` becomes `jwt_options`, `apikey` becomes `apikey_options` and `mtls` becomes `mtls_options`. When both the legacy certificate and key are PEM, they move into `mtls_options.cert_content` and `key_content` and need no action. Otherwise, including a mixed config (PEM certificate, file-path key), both values become `mtls_options.cert_file` and `key_file`. Delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are re-entered as PEM content, or the leftover file fields are removed if the webhook does not use mTLS. If your version's console does not expose those fields, edit the DMS through the DMS API.",{"_2856":916,"_25078":826,"_17499":43609,"_5":17394,"_23735":43377,"_2383":43610},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2856":917,"_25078":826,"_17499":43612,"_5":17394,"_23735":43381,"_2383":43613},[],"`settings.reenrollment_settings` field",{"_2856":918,"_25078":826,"_17499":43615,"_5":17394,"_23735":43381,"_2383":41132},[],{"_2856":919,"_25078":826,"_17499":43617,"_5":17394,"_23735":43381,"_2383":43618},[],"`reenrollment_delta`",{"_2856":920,"_25078":826,"_17499":43620,"_5":17394,"_23735":43381,"_2383":43621},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2856":921,"_25078":826,"_17499":43623,"_5":17394,"_23735":43381,"_2383":43624},[],"`preventive_delta`",{"_2856":922,"_25078":826,"_17499":43626,"_5":17394,"_23735":43381,"_2383":43627},[],"Preventive operational monitoring threshold.",{"_2856":923,"_25078":826,"_17499":43629,"_5":17394,"_23735":43381,"_2383":43630},[],"`critical_delta`",{"_2856":924,"_25078":826,"_17499":43632,"_5":17394,"_23735":43381,"_2383":43633},[],"Critical operational monitoring threshold.",{"_2856":925,"_25078":826,"_17499":43635,"_5":17394,"_23735":43381,"_2383":43636},[],"`enable_expired_renewal`",{"_2856":926,"_25078":826,"_17499":43638,"_5":17394,"_23735":43381,"_2383":43639},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2856":927,"_25078":826,"_17499":43641,"_5":17394,"_23735":43381,"_2383":43642},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_2856":928,"_25078":826,"_17499":43644,"_5":17394,"_23735":43381,"_2383":43645},[],"Re-enrollment validation CAs; optional, because the enrollment CA is always trusted.",{"_2856":929,"_25078":826,"_17499":43647,"_5":17394,"_23735":43381,"_2383":43648},[],"`revoke_on_reenrollment`",{"_2856":930,"_25078":826,"_17499":43650,"_5":17394,"_23735":43381,"_2383":43651},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2856":931,"_25078":826,"_17499":43653,"_5":17394,"_23735":43381,"_2383":43654},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2856":932,"_25078":826,"_17499":43656,"_5":17394,"_23735":43385,"_2383":43657},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2856":933,"_25078":826,"_17499":43659,"_5":17394,"_23735":43389,"_2383":41126},[],{"_2856":934,"_25078":826,"_17499":43661,"_5":17394,"_23735":43389,"_2383":43662},[],"Published material",{"_2856":935,"_25078":826,"_17499":43664,"_5":17394,"_23735":43389,"_2383":43665},[],"**Include Lamassu System CA**",{"_2856":936,"_25078":826,"_17499":43667,"_5":17394,"_23735":43389,"_2383":43668},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2856":937,"_25078":826,"_17499":43670,"_5":17394,"_23735":43389,"_2383":43671},[],"**Include Enrollment CA**",{"_2856":938,"_25078":826,"_17499":43673,"_5":17394,"_23735":43389,"_2383":43674},[],"Selected issuing CA certificate.",{"_2856":939,"_25078":826,"_17499":43676,"_5":17394,"_23735":43389,"_2383":43677},[],"**Managed CAs**",{"_2856":940,"_25078":826,"_17499":43679,"_5":17394,"_23735":43389,"_2383":43680},[],"Explicitly selected CA certificates.",{"_2856":941,"_25078":826,"_17499":43682,"_5":17394,"_23735":43389,"_2383":43683},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2856":942,"_25078":826,"_17499":43685,"_5":17394,"_23735":43393,"_2383":43686},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2856":943,"_25078":826,"_17499":43688,"_5":17394,"_23735":43393,"_2383":43689},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2856":944,"_25078":826,"_17499":43691,"_5":17394,"_23735":43393,"_2383":43692},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2856":945,"_25078":826,"_17499":43694,"_5":17394,"_23735":43397,"_2383":43695},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2856":946,"_25078":946,"_5":12261,"_2383":43697,"_25413":43698,"_17499":43699,"_23735":946},"Integrate the EST client",[40749,42093,43067,43065,43248],[],{"_2856":947,"_25078":946,"_17499":43701,"_5":17394,"_23735":946,"_2383":43702},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2856":948,"_25078":946,"_5":25410,"_17499":43704,"_23735":43705,"_2383":40759},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2856":949,"_25078":946,"_5":25410,"_17499":43707,"_23735":43708,"_2383":43709},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2856":950,"_25078":946,"_5":25410,"_17499":43711,"_23735":43712,"_2383":43713},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2856":951,"_25078":946,"_5":25410,"_17499":43715,"_23735":43716,"_2383":43717},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2856":952,"_25078":946,"_5":25410,"_17499":43719,"_23735":43720,"_2383":43721},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2856":953,"_25078":946,"_5":25410,"_17499":43723,"_23735":43724,"_2383":43725},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2856":954,"_25078":946,"_17499":43727,"_5":17394,"_23735":946,"_2383":43728},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2856":955,"_25078":946,"_17499":43730,"_5":17394,"_23735":43705,"_2383":43731},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2856":956,"_25078":946,"_17499":43733,"_5":17394,"_23735":43705,"_2383":43734},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2856":957,"_25078":946,"_17499":43736,"_5":17394,"_23735":43705,"_2383":43737},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2856":958,"_25078":946,"_17499":43739,"_5":17394,"_23735":43708,"_2383":43740},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2856":959,"_25078":946,"_17499":43742,"_5":17394,"_23735":43708,"_2383":43743},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2856":960,"_25078":946,"_17499":43745,"_5":17394,"_23735":43712,"_2383":43746},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2856":961,"_25078":946,"_17499":43748,"_5":17394,"_23735":43712,"_2383":43749},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2856":962,"_25078":946,"_17499":43751,"_5":17394,"_23735":43716,"_2383":43752},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2856":963,"_25078":946,"_17499":43754,"_5":17394,"_23735":43716,"_2383":43755},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2856":964,"_25078":946,"_17499":43757,"_5":17394,"_23735":43720,"_2383":43758},[],"For a root that issues directly:",{"_2856":965,"_25078":946,"_17499":43760,"_5":17394,"_23735":43720,"_2383":43761},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2856":966,"_25078":946,"_17499":43763,"_5":17394,"_23735":43720,"_2383":43764},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2856":967,"_25078":946,"_17499":43766,"_5":17394,"_23735":43724,"_2383":43767},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2856":968,"_25078":968,"_5":12261,"_2383":43769,"_25413":43770,"_17499":43771,"_23735":968},"EST reference",[40749,42093,43067,43065,43248],[],{"_2856":969,"_25078":968,"_17499":43773,"_5":17394,"_23735":968,"_2383":43774},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2856":970,"_25078":968,"_5":25410,"_17499":43776,"_23735":43777,"_2383":43778},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2856":971,"_25078":968,"_5":25410,"_17499":43780,"_23735":43781,"_2383":19003},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2856":972,"_25078":968,"_5":25410,"_17499":43783,"_23735":43784,"_2383":21768},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2856":973,"_25078":968,"_5":25410,"_17499":43786,"_23735":43787,"_2383":21775},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2856":974,"_25078":968,"_5":25410,"_17499":43789,"_23735":43790,"_2383":21145},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2856":975,"_25078":968,"_5":25410,"_17499":43792,"_23735":43793,"_2383":43794},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2856":976,"_25078":968,"_5":25410,"_17499":43796,"_23735":43797,"_2383":43798},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2856":977,"_25078":968,"_5":25410,"_17499":43800,"_23735":43801,"_2383":43802},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2856":978,"_25078":968,"_17499":43804,"_5":17394,"_23735":968,"_2383":43805},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2856":979,"_25078":968,"_17499":43807,"_5":17394,"_23735":43777,"_2383":43808},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2856":980,"_25078":968,"_17499":43810,"_5":17394,"_23735":43777,"_2383":43811},[],"Operation",{"_2856":981,"_25078":968,"_17499":43813,"_5":17394,"_23735":43777,"_2383":43814},[],"Method",{"_2856":982,"_25078":968,"_17499":43816,"_5":17394,"_23735":43777,"_2383":43817},[],"Authentication and condition",{"_2856":983,"_25078":968,"_17499":43819,"_5":17394,"_23735":43777,"_2383":43820},[],"`/cacerts`",{"_2856":984,"_25078":968,"_17499":43822,"_5":17394,"_23735":43777,"_2383":43823},[],"GET",{"_2856":985,"_25078":968,"_17499":43825,"_5":17394,"_23735":43777,"_2383":43826},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2856":986,"_25078":968,"_17499":43828,"_5":17394,"_23735":43777,"_2383":43829},[],"`/simpleenroll`",{"_2856":987,"_25078":968,"_17499":43831,"_5":17394,"_23735":43777,"_2383":43832},[],"POST",{"_2856":988,"_25078":968,"_17499":43834,"_5":17394,"_23735":43777,"_2383":43835},[],"Initial authentication and DMS registration/replacement policy.",{"_2856":989,"_25078":968,"_17499":43837,"_5":17394,"_23735":43777,"_2383":43838},[],"`/simplereenroll`",{"_2856":990,"_25078":968,"_17499":43840,"_5":17394,"_23735":43777,"_2383":43832},[],{"_2856":991,"_25078":968,"_17499":43842,"_5":17394,"_23735":43777,"_2383":43843},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2856":992,"_25078":968,"_17499":43845,"_5":17394,"_23735":43777,"_2383":43846},[],"`/serverkeygen`",{"_2856":993,"_25078":968,"_17499":43848,"_5":17394,"_23735":43777,"_2383":43832},[],{"_2856":994,"_25078":968,"_17499":43850,"_5":17394,"_23735":43777,"_2383":43851},[],"Initial authentication and admission; server generation enabled.",{"_2856":995,"_25078":968,"_17499":43853,"_5":17394,"_23735":43777,"_2383":43854},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2856":996,"_25078":968,"_17499":43856,"_5":17394,"_23735":43781,"_2383":43857},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2856":997,"_25078":968,"_17499":43859,"_5":17394,"_23735":43781,"_2383":43860},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2856":998,"_25078":968,"_17499":43862,"_5":17394,"_23735":43784,"_2383":43863},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2856":999,"_25078":968,"_17499":43865,"_5":17394,"_23735":43784,"_2383":43866},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2856":1000,"_25078":968,"_17499":43868,"_5":17394,"_23735":43787,"_2383":43869},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2856":1001,"_25078":968,"_17499":43871,"_5":17394,"_23735":43787,"_2383":43872},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as re-enrollment validation CAs. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2856":1002,"_25078":968,"_17499":43874,"_5":17394,"_23735":43790,"_2383":43875},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2856":1003,"_25078":968,"_17499":43877,"_5":17394,"_23735":43790,"_2383":43878},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2856":1004,"_25078":968,"_17499":43880,"_5":17394,"_23735":43793,"_2383":43881},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2856":1005,"_25078":968,"_17499":43883,"_5":17394,"_23735":43793,"_2383":43884},[],"Part",{"_2856":1006,"_25078":968,"_17499":43886,"_5":17394,"_23735":43793,"_2383":43887},[],"Content after decoding its Base64",{"_2856":1007,"_25078":968,"_17499":43889,"_5":17394,"_23735":43793,"_2383":43890},[],"`application/pkcs8`",{"_2856":1008,"_25078":968,"_17499":43892,"_5":17394,"_23735":43793,"_2383":43893},[],"Unencrypted DER PKCS#8 private key.",{"_2856":1009,"_25078":968,"_17499":43895,"_5":17394,"_23735":43793,"_2383":43896},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2856":1010,"_25078":968,"_17499":43898,"_5":17394,"_23735":43793,"_2383":43899},[],"DER PKCS#7 containing the issued certificate.",{"_2856":1011,"_25078":968,"_17499":43901,"_5":17394,"_23735":43793,"_2383":43902},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2856":1012,"_25078":968,"_17499":43904,"_5":17394,"_23735":43797,"_2383":43905},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2856":1013,"_25078":968,"_17499":43907,"_5":17394,"_23735":43797,"_2383":43908},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2856":1014,"_25078":968,"_17499":43910,"_5":17394,"_23735":43797,"_2383":43911},[],"Convert and check the result:",{"_2856":1015,"_25078":968,"_17499":43913,"_5":17394,"_23735":43797,"_2383":43914},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2856":1016,"_25078":968,"_17499":43916,"_5":17394,"_23735":43801,"_2383":43917},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2856":1017,"_25078":968,"_17499":43919,"_5":17394,"_23735":43801,"_2383":43920},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2856":1018,"_25078":1018,"_5":12261,"_2383":43248,"_25413":43922,"_17499":43923,"_23735":1018},[40749,42093,43067,43065,43248],[],{"_2856":1019,"_25078":1018,"_17499":43925,"_5":17394,"_23735":1018,"_2383":43926},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2856":1020,"_25078":1018,"_5":25410,"_17499":43928,"_23735":43929,"_2383":43930},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2856":1021,"_25078":1018,"_5":25410,"_17499":43932,"_23735":43933,"_2383":43934},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2856":1022,"_25078":1018,"_5":25410,"_17499":43936,"_23735":43937,"_2383":43938},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2856":1023,"_25078":1018,"_5":25410,"_17499":43940,"_23735":43941,"_2383":43942},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2856":1024,"_25078":1018,"_17499":43944,"_5":17394,"_23735":1018,"_2383":43945},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2856":1025,"_25078":1018,"_17499":43947,"_5":17394,"_23735":43929,"_2383":43948},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2856":1026,"_25078":1018,"_17499":43950,"_5":17394,"_23735":43929,"_2383":43951},[],"The integrator installs initial EST server trust and an admission credential.",{"_2856":1027,"_25078":1018,"_17499":43953,"_5":17394,"_23735":43929,"_2383":43954},[],"The client requests an identity for its `Device ID` through EST.",{"_2856":1028,"_25078":1018,"_17499":43956,"_5":17394,"_23735":43929,"_2383":43957},[],"Certificate, device binding and key/certificate installation are checked.",{"_2856":1029,"_25078":1018,"_17499":43959,"_5":17394,"_23735":43929,"_2383":43960},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2856":1030,"_25078":1018,"_17499":43962,"_5":17394,"_23735":43929,"_2383":43963},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2856":1031,"_25078":1018,"_17499":43965,"_5":17394,"_23735":43933,"_2383":43966},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2856":1032,"_25078":1018,"_17499":43968,"_5":17394,"_23735":43933,"_2383":43969},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":1033,"_25078":1018,"_17499":43971,"_5":17394,"_23735":43933,"_2383":43972},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2856":1034,"_25078":1018,"_17499":43974,"_5":17394,"_23735":43933,"_2383":43975},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2856":1035,"_25078":1018,"_17499":43977,"_5":17394,"_23735":43937,"_2383":43978},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2856":1036,"_25078":1018,"_17499":43980,"_5":17394,"_23735":43937,"_2383":43981},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2856":1037,"_25078":1018,"_17499":43983,"_5":17394,"_23735":43937,"_2383":43984},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2856":1038,"_25078":1018,"_17499":43986,"_5":17394,"_23735":43937,"_2383":43987},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2856":1039,"_25078":1018,"_17499":43989,"_5":17394,"_23735":43941,"_2383":43990},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2856":1040,"_25078":1018,"_17499":43992,"_5":17394,"_23735":43941,"_2383":43993},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2856":1041,"_25078":1041,"_5":12261,"_2383":43995,"_25413":43996,"_17499":43997,"_23735":1041},"Provisioning strategies",[40749,42093,43067,43065,43248],[],{"_2856":1042,"_25078":1041,"_17499":43999,"_5":17394,"_23735":1041,"_2383":44000},[],"Choose device registration, identity authorization and key generation.",{"_2856":1043,"_25078":1041,"_5":25410,"_17499":44002,"_23735":44003,"_2383":44004},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2856":1044,"_25078":1041,"_5":25410,"_17499":44006,"_23735":44007,"_2383":44008},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2856":1045,"_25078":1041,"_5":25410,"_17499":44010,"_23735":44011,"_2383":44012},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2856":1046,"_25078":1041,"_5":25410,"_17499":44014,"_23735":44015,"_2383":44016},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2856":1047,"_25078":1041,"_5":25410,"_17499":44018,"_23735":44019,"_2383":44020},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2856":1048,"_25078":1041,"_17499":44022,"_5":17394,"_23735":1041,"_2383":44023},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2856":1049,"_25078":1041,"_17499":44025,"_5":17394,"_23735":44003,"_2383":44026},[],"Path",{"_2856":1050,"_25078":1041,"_17499":44028,"_5":17394,"_23735":44003,"_2383":44029},[],"When the device exists",{"_2856":1051,"_25078":1041,"_17499":44031,"_5":17394,"_23735":44003,"_2383":44032},[],"What to check",{"_2856":1052,"_25078":1041,"_17499":44034,"_5":17394,"_23735":44003,"_2383":44035},[],"Manual assignment",{"_2856":1053,"_25078":1041,"_17499":44037,"_5":17394,"_23735":44003,"_2383":44038},[],"An operator creates it before associating a certificate.",{"_2856":1054,"_25078":1041,"_17499":44040,"_5":17394,"_23735":44003,"_2383":44041},[],"ID, owning DMS, certificate CN and bound serial.",{"_2856":1055,"_25078":1041,"_17499":44043,"_5":17394,"_23735":44003,"_2383":44044},[],"EST with `JITP`",{"_2856":1056,"_25078":1041,"_17499":44046,"_5":17394,"_23735":44003,"_2383":44047},[],"Created for an unknown CN during `/simpleenroll`.",{"_2856":1057,"_25078":1041,"_17499":44049,"_5":17394,"_23735":44003,"_2383":44050},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2856":1058,"_25078":1041,"_17499":44052,"_5":17394,"_23735":44003,"_2383":44053},[],"EST with `PRE_REGISTRATION`",{"_2856":1059,"_25078":1041,"_17499":44055,"_5":17394,"_23735":44003,"_2383":44056},[],"Must exist before `/simpleenroll`.",{"_2856":1060,"_25078":1041,"_17499":44058,"_5":17394,"_23735":44003,"_2383":44059},[],"Approved record, same DMS and replacement conditions for your version.",{"_2856":1061,"_25078":1041,"_17499":44061,"_5":17394,"_23735":44003,"_2383":44062},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2856":1062,"_25078":1041,"_17499":44064,"_5":17394,"_23735":44003,"_2383":44065},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2856":1063,"_25078":1041,"_17499":44067,"_5":17394,"_23735":44007,"_2383":44068},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2856":1064,"_25078":1041,"_17499":44070,"_5":17394,"_23735":44007,"_2383":44071},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2856":1065,"_25078":1041,"_17499":44073,"_5":17394,"_23735":44007,"_2383":44074},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2856":1066,"_25078":1041,"_17499":44076,"_5":17394,"_23735":44011,"_2383":44077},[],"Decide initial enrollment and re-enrollment separately:",{"_2856":1067,"_25078":1041,"_17499":44079,"_5":17394,"_23735":44011,"_2383":44080},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2856":1068,"_25078":1041,"_17499":44082,"_5":17394,"_23735":44011,"_2383":44083},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2856":1069,"_25078":1041,"_17499":44085,"_5":17394,"_23735":44011,"_2383":44086},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2856":1070,"_25078":1041,"_17499":44088,"_5":17394,"_23735":44011,"_2383":44089},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2856":1071,"_25078":1041,"_17499":44091,"_5":17394,"_23735":44011,"_2383":44092},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2856":1072,"_25078":1041,"_17499":44094,"_5":17394,"_23735":44015,"_2383":41126},[],{"_2856":1073,"_25078":1041,"_17499":44096,"_5":17394,"_23735":44015,"_2383":44097},[],"Material crossing EST",{"_2856":1074,"_25078":1041,"_17499":44099,"_5":17394,"_23735":44015,"_2383":44100},[],"Device-generated key",{"_2856":1075,"_25078":1041,"_17499":44102,"_5":17394,"_23735":44015,"_2383":44103},[],"Public CSR and certificate; the key stays on the client.",{"_2856":1076,"_25078":1041,"_17499":44105,"_5":17394,"_23735":44015,"_2383":44106},[],"Existing device key",{"_2856":1077,"_25078":1041,"_17499":44108,"_5":17394,"_23735":44015,"_2383":44109},[],"CSR signed with that key and a new certificate.",{"_2856":1078,"_25078":1041,"_17499":44111,"_5":17394,"_23735":44015,"_2383":43386},[],{"_2856":1079,"_25078":1041,"_17499":44113,"_5":17394,"_23735":44015,"_2383":44114},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2856":1080,"_25078":1041,"_17499":44116,"_5":17394,"_23735":44015,"_2383":44117},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2856":1081,"_25078":1041,"_17499":44119,"_5":17394,"_23735":44019,"_2383":44120},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2856":1082,"_25078":1082,"_5":12261,"_2383":44122,"_25413":44123,"_17499":44124,"_23735":1082},"Renewal and recovery",[40749,42093,43067,43065,43248],[],{"_2856":1083,"_25078":1082,"_17499":44126,"_5":17394,"_23735":1082,"_2383":44127},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2856":1084,"_25078":1082,"_5":25410,"_17499":44129,"_23735":44130,"_2383":44131},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2856":1085,"_25078":1082,"_5":25410,"_17499":44133,"_23735":44134,"_2383":44135},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2856":1086,"_25078":1082,"_5":25410,"_17499":44137,"_23735":44138,"_2383":44139},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2856":1087,"_25078":1082,"_5":25410,"_17499":44141,"_23735":44142,"_2383":44143},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2856":1088,"_25078":1082,"_5":25410,"_17499":44145,"_23735":44146,"_2383":44147},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2856":1089,"_25078":1082,"_17499":44149,"_5":17394,"_23735":1082,"_2383":44150},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2856":1090,"_25078":1082,"_17499":44152,"_5":17394,"_23735":44130,"_2383":44153},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2856":1091,"_25078":1082,"_17499":44155,"_5":17394,"_23735":44130,"_2383":44156},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2856":1092,"_25078":1082,"_17499":44158,"_5":17394,"_23735":44130,"_2383":44159},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2856":1093,"_25078":1082,"_17499":44161,"_5":17394,"_23735":44130,"_2383":44162},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2856":1094,"_25078":1082,"_17499":44164,"_5":17394,"_23735":44134,"_2383":44165},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2856":1095,"_25078":1082,"_17499":44167,"_5":17394,"_23735":44134,"_2383":44168},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2856":1096,"_25078":1082,"_17499":44170,"_5":17394,"_23735":44138,"_2383":44171},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2856":1097,"_25078":1082,"_17499":44173,"_5":17394,"_23735":44138,"_2383":44174},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2856":1098,"_25078":1082,"_17499":44176,"_5":17394,"_23735":44138,"_2383":44177},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2856":1099,"_25078":1082,"_17499":44179,"_5":17394,"_23735":44142,"_2383":44180},[],"Situation",{"_2856":1100,"_25078":1082,"_17499":44182,"_5":17394,"_23735":44142,"_2383":44183},[],"Procedure",{"_2856":1101,"_25078":1082,"_17499":44185,"_5":17394,"_23735":44142,"_2383":44186},[],"Valid certificate, outside the window",{"_2856":1102,"_25078":1082,"_17499":44188,"_5":17394,"_23735":44142,"_2383":44189},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2856":1103,"_25078":1082,"_17499":44191,"_5":17394,"_23735":44142,"_2383":44192},[],"Expired certificate, key available",{"_2856":1104,"_25078":1082,"_17499":44194,"_5":17394,"_23735":44142,"_2383":44195},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2856":1105,"_25078":1082,"_17499":44197,"_5":17394,"_23735":44142,"_2383":44198},[],"Renewal through webhook or `NO_AUTH`",{"_2856":1106,"_25078":1082,"_17499":44200,"_5":17394,"_23735":44142,"_2383":44201},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2856":1107,"_25078":1082,"_17499":44203,"_5":17394,"_23735":44142,"_2383":44204},[],"Lost or inaccessible key",{"_2856":1108,"_25078":1082,"_17499":44206,"_5":17394,"_23735":44142,"_2383":44207},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2856":1109,"_25078":1082,"_17499":44209,"_5":17394,"_23735":44142,"_2383":44210},[],"Current identity revoked",{"_2856":1110,"_25078":1082,"_17499":44212,"_5":17394,"_23735":44142,"_2383":44213},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2856":1111,"_25078":1082,"_17499":44215,"_5":17394,"_23735":44142,"_2383":44216},[],"Device without an identity",{"_2856":1112,"_25078":1082,"_17499":44218,"_5":17394,"_23735":44142,"_2383":44219},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2856":1113,"_25078":1082,"_17499":44221,"_5":17394,"_23735":44142,"_2383":44222},[],"Retired device",{"_2856":1114,"_25078":1082,"_17499":44224,"_5":17394,"_23735":44142,"_2383":44225},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2856":1115,"_25078":1082,"_17499":44227,"_5":17394,"_23735":44142,"_2383":44228},[],"Timeout, HTTP 500 or installation failure",{"_2856":1116,"_25078":1082,"_17499":44230,"_5":17394,"_23735":44142,"_2383":44231},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2856":1117,"_25078":1082,"_17499":44233,"_5":17394,"_23735":44146,"_2383":44234},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2856":1118,"_25078":1082,"_17499":44236,"_5":17394,"_23735":44146,"_2383":44237},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2856":1119,"_25078":1119,"_5":12261,"_2383":44239,"_25413":44240,"_17499":44241,"_23735":1119},"Enrollment troubleshooting",[40749,42093,43067,43065,43248],[],{"_2856":1120,"_25078":1119,"_17499":44243,"_5":17394,"_23735":1119,"_2383":44244},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2856":1121,"_25078":1119,"_5":25410,"_17499":44246,"_23735":44247,"_2383":44248},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2856":1122,"_25078":1119,"_5":25410,"_17499":44250,"_23735":44251,"_2383":44252},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2856":1123,"_25078":1119,"_5":25410,"_17499":44254,"_23735":44255,"_2383":43802},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2856":1124,"_25078":1119,"_5":25410,"_17499":44257,"_23735":44258,"_2383":44259},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2856":1125,"_25078":1119,"_17499":44261,"_5":17394,"_23735":1119,"_2383":44262},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2856":1126,"_25078":1119,"_17499":44264,"_5":17394,"_23735":44251,"_2383":44265},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2856":1127,"_25078":1119,"_17499":44267,"_5":17394,"_23735":44251,"_2383":44268},[],"Symptom or message",{"_2856":1128,"_25078":1119,"_17499":44270,"_5":17394,"_23735":44251,"_2383":44032},[],{"_2856":1129,"_25078":1119,"_17499":44272,"_5":17394,"_23735":44251,"_2383":44273},[],"curl rejects TLS, name or issuer",{"_2856":1130,"_25078":1119,"_17499":44275,"_5":17394,"_23735":44251,"_2383":44276},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2856":1131,"_25078":1119,"_17499":44278,"_5":17394,"_23735":44251,"_2383":44279},[],"404 or missing APS",{"_2856":1132,"_25078":1119,"_17499":44281,"_5":17394,"_23735":44251,"_2383":44282},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2856":1133,"_25078":1119,"_17499":44284,"_5":17394,"_23735":44251,"_2383":44285},[],"400, CSR or format error",{"_2856":1134,"_25078":1119,"_17499":44287,"_5":17394,"_23735":44251,"_2383":44288},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2856":1135,"_25078":1119,"_17499":44290,"_5":17394,"_23735":44251,"_2383":44291},[],"Missing credential or invalid certificate",{"_2856":1136,"_25078":1119,"_17499":44293,"_5":17394,"_23735":44251,"_2383":44294},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2856":1137,"_25078":1119,"_17499":44296,"_5":17394,"_23735":44251,"_2383":44297},[],"Webhook denies, times out or responds without authorization",{"_2856":1138,"_25078":1119,"_17499":44299,"_5":17394,"_23735":44251,"_2383":44300},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2856":1139,"_25078":1119,"_17499":44302,"_5":17394,"_23735":44251,"_2383":44303},[],"`unexpected status code: <n>: redirects are not followed`",{"_2856":1140,"_25078":1119,"_17499":44305,"_5":17394,"_23735":44251,"_2383":44306},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2856":1141,"_25078":1119,"_17499":44308,"_5":17394,"_23735":44251,"_2383":44309},[],"`webhook response exceeds 1048576 bytes`",{"_2856":1142,"_25078":1119,"_17499":44311,"_5":17394,"_23735":44251,"_2383":44312},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2856":1143,"_25078":1119,"_17499":44314,"_5":17394,"_23735":44251,"_2383":44315},[],"`webhook config must not reference files`",{"_2856":1144,"_25078":1119,"_17499":44317,"_5":17394,"_23735":44251,"_2383":44318},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the PEM as `cert_content` and `key_content`; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the upgrade note in DMS.",{"_2856":1145,"_25078":1119,"_17499":44320,"_5":17394,"_23735":44251,"_2383":44321},[],"400 `struct validation error` creating or updating a DMS",{"_2856":1146,"_25078":1119,"_17499":44323,"_5":17394,"_23735":44251,"_2383":44324},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2856":1147,"_25078":1119,"_17499":44326,"_5":17394,"_23735":44251,"_2383":44327},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2856":1148,"_25078":1119,"_17499":44329,"_5":17394,"_23735":44251,"_2383":44330},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2856":1149,"_25078":1119,"_17499":44332,"_5":17394,"_23735":44251,"_2383":44333},[],"`device not preregistered`",{"_2856":1150,"_25078":1119,"_17499":44335,"_5":17394,"_23735":44251,"_2383":44336},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2856":1151,"_25078":1119,"_17499":44338,"_5":17394,"_23735":44251,"_2383":44339},[],"`forbiddenNewEnrollment`",{"_2856":1152,"_25078":1119,"_17499":44341,"_5":17394,"_23735":44251,"_2383":44342},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2856":1153,"_25078":1119,"_17499":44344,"_5":17394,"_23735":44251,"_2383":44345},[],"Different owning DMS",{"_2856":1154,"_25078":1119,"_17499":44347,"_5":17394,"_23735":44251,"_2383":44348},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2856":1155,"_25078":1119,"_17499":44350,"_5":17394,"_23735":44251,"_2383":44351},[],"`invalid RawSubject bytes`",{"_2856":1156,"_25078":1119,"_17499":44353,"_5":17394,"_23735":44251,"_2383":44354},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2856":1157,"_25078":1119,"_17499":44356,"_5":17394,"_23735":44251,"_2383":44357},[],"`invalid reenroll window`",{"_2856":1158,"_25078":1119,"_17499":44359,"_5":17394,"_23735":44251,"_2383":44360},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2856":1159,"_25078":1119,"_17499":44362,"_5":17394,"_23735":44251,"_2383":44363},[],"Current certificate revoked",{"_2856":1160,"_25078":1119,"_17499":44365,"_5":17394,"_23735":44251,"_2383":44366},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2856":1161,"_25078":1119,"_17499":44368,"_5":17394,"_23735":44251,"_2383":44369},[],"CA, profile or signing error",{"_2856":1162,"_25078":1119,"_17499":44371,"_5":17394,"_23735":44251,"_2383":44372},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2856":1163,"_25078":1119,"_17499":44374,"_5":17394,"_23735":44251,"_2383":44375},[],"HTTP 200 without a device connection",{"_2856":1164,"_25078":1119,"_17499":44377,"_5":17394,"_23735":44251,"_2383":44378},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2856":1165,"_25078":1119,"_17499":44380,"_5":17394,"_23735":44251,"_2383":44381},[],"Timeout or error after issuance",{"_2856":1166,"_25078":1119,"_17499":44383,"_5":17394,"_23735":44251,"_2383":44384},[],"New certificates, current slot and previous identity's state before retrying.",{"_2856":1167,"_25078":1119,"_17499":44386,"_5":17394,"_23735":44255,"_2383":44387},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA.",{"_2856":1168,"_25078":1119,"_17499":44389,"_5":17394,"_23735":44255,"_2383":44390},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2856":1169,"_25078":1119,"_17499":44392,"_5":17394,"_23735":44258,"_2383":44393},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2856":1170,"_25078":1119,"_17499":44395,"_5":17394,"_23735":44258,"_2383":44396},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2856":1171,"_25078":1119,"_17499":44398,"_5":17394,"_23735":44258,"_2383":44399},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2856":1172,"_25078":1119,"_17499":44401,"_5":17394,"_23735":44258,"_2383":44402},[],"Make one request, save headers/body and query the device and certificates.",{"_2856":1173,"_25078":1119,"_17499":44404,"_5":17394,"_23735":44258,"_2383":44405},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2856":1174,"_25078":1119,"_17499":44407,"_5":17394,"_23735":44258,"_2383":44408},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2856":1175,"_25078":1119,"_17499":44410,"_5":17394,"_23735":44258,"_2383":44411},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2856":1176,"_25078":1176,"_5":12261,"_2383":44413,"_25413":44414,"_17499":44415,"_23735":1176},"Trust distribution and updates",[40749,42093,43067,43065,43248],[],{"_2856":1177,"_25078":1176,"_17499":44417,"_5":17394,"_23735":1176,"_2383":44418},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2856":1178,"_25078":1176,"_5":25410,"_17499":44420,"_23735":44421,"_2383":44422},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2856":1179,"_25078":1176,"_5":25410,"_17499":44424,"_23735":44425,"_2383":44426},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2856":1180,"_25078":1176,"_5":25410,"_17499":44428,"_23735":44429,"_2383":44430},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2856":1181,"_25078":1176,"_5":25410,"_17499":44432,"_23735":44433,"_2383":44434},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2856":1182,"_25078":1176,"_5":25410,"_17499":44436,"_23735":44437,"_2383":44438},[],"/docs/pr-preview/pr-40/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2856":1183,"_25078":1176,"_17499":44440,"_5":17394,"_23735":1176,"_2383":44441},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2856":1184,"_25078":1176,"_17499":44443,"_5":17394,"_23735":44421,"_2383":44444},[],"Relationship",{"_2856":1185,"_25078":1176,"_17499":44446,"_5":17394,"_23735":44421,"_2383":44447},[],"Material prepared by its owner",{"_2856":1186,"_25078":1176,"_17499":44449,"_5":17394,"_23735":44421,"_2383":44450},[],"Device → EST server",{"_2856":1187,"_25078":1176,"_17499":44452,"_5":17394,"_23735":44421,"_2383":44453},[],"Previously verified server root, chain or pin and TLS name.",{"_2856":1188,"_25078":1176,"_17499":44455,"_5":17394,"_23735":44421,"_2383":44456},[],"DMS → requester",{"_2856":1189,"_25078":1176,"_17499":44458,"_5":17394,"_23735":44421,"_2383":44459},[],"CAs and rules authorizing initial or renewal credentials.",{"_2856":1190,"_25078":1176,"_17499":44461,"_5":17394,"_23735":44421,"_2383":44462},[],"Consumer → device",{"_2856":1191,"_25078":1176,"_17499":44464,"_5":17394,"_23735":44421,"_2383":44465},[],"Operational identity roots, intermediates, validation and permissions.",{"_2856":1192,"_25078":1176,"_17499":44467,"_5":17394,"_23735":44421,"_2383":44468},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2856":1193,"_25078":1176,"_17499":44470,"_5":17394,"_23735":44425,"_2383":44471},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2856":1194,"_25078":1176,"_17499":44473,"_5":17394,"_23735":44425,"_2383":44474},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2856":1195,"_25078":1176,"_17499":44476,"_5":17394,"_23735":44429,"_2383":44477},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2856":1196,"_25078":1176,"_17499":44479,"_5":17394,"_23735":44429,"_2383":44480},[],"Select policy-approved roots as anchors.",{"_2856":1197,"_25078":1176,"_17499":44482,"_5":17394,"_23735":44429,"_2383":44483},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2856":1198,"_25078":1176,"_17499":44485,"_5":17394,"_23735":44429,"_2383":44486},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2856":1199,"_25078":1176,"_17499":44488,"_5":17394,"_23735":44429,"_2383":44489},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2856":1200,"_25078":1176,"_17499":44491,"_5":17394,"_23735":44429,"_2383":44492},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2856":1201,"_25078":1176,"_17499":44494,"_5":17394,"_23735":44433,"_2383":44495},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2856":1202,"_25078":1176,"_17499":44497,"_5":17394,"_23735":44433,"_2383":44498},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; that list is optional because the enrollment CA always validates re-enrollment credentials. The validator accepts the received leaf when it chains to the enrollment CA or to one of those CAs; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2856":1203,"_25078":1176,"_17499":44500,"_5":17394,"_23735":44433,"_2383":44501},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2856":1204,"_25078":1176,"_17499":44503,"_5":17394,"_23735":44437,"_2383":44504},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2856":1205,"_25078":1205,"_5":12261,"_2383":44506,"_25413":44507,"_17499":44509,"_23735":1205},"AWS IoT Core",[40749,42093,43067,43065,44508],"Integrations",[],{"_2856":1206,"_25078":1205,"_17499":44511,"_5":17394,"_23735":1205,"_2383":44512},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2856":1207,"_25078":1205,"_5":25410,"_17499":44514,"_23735":44515,"_2383":44516},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2856":1208,"_25078":1205,"_5":25410,"_17499":44518,"_23735":44519,"_2383":44520},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2856":1209,"_25078":1205,"_5":25410,"_17499":44522,"_23735":44523,"_2383":44524},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2856":1210,"_25078":1205,"_5":25410,"_17499":44526,"_23735":44527,"_2383":44528},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2856":1211,"_25078":1205,"_5":25410,"_17499":44530,"_23735":44531,"_2383":44532},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2856":1212,"_25078":1205,"_5":25410,"_17499":44534,"_23735":44535,"_2383":44536},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2856":1213,"_25078":1205,"_5":25410,"_17499":44538,"_23735":44539,"_2383":44540},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2856":1214,"_25078":1205,"_5":25410,"_17499":44542,"_23735":44543,"_2383":44544},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2856":1215,"_25078":1205,"_5":25410,"_17499":44546,"_23735":44547,"_2383":44548},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2856":1216,"_25078":1205,"_5":25410,"_17499":44550,"_23735":44551,"_2383":44552},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2856":1217,"_25078":1205,"_5":25410,"_17499":44554,"_23735":44555,"_2383":44556},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2856":1218,"_25078":1205,"_5":25410,"_17499":44558,"_23735":44559,"_2383":44560},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2856":1219,"_25078":1205,"_5":25410,"_17499":44562,"_23735":44563,"_2383":44564},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2856":1220,"_25078":1205,"_5":25410,"_17499":44566,"_23735":44567,"_2383":44568},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2856":1221,"_25078":1205,"_5":25410,"_17499":44570,"_23735":44571,"_2383":44572},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2856":1222,"_25078":1205,"_5":25410,"_17499":44574,"_23735":44575,"_2383":44576},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2856":1223,"_25078":1205,"_5":25410,"_17499":44578,"_23735":44579,"_2383":44580},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2856":1224,"_25078":1205,"_5":25410,"_17499":44582,"_23735":44583,"_2383":44584},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2856":1225,"_25078":1205,"_5":25410,"_17499":44586,"_23735":44587,"_2383":44588},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2856":1226,"_25078":1205,"_5":25410,"_17499":44590,"_23735":44591,"_2383":44592},[],"/docs/pr-preview/pr-40/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2856":1227,"_25078":1205,"_17499":44594,"_5":17394,"_23735":1205,"_2383":44595},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2856":1228,"_25078":1205,"_17499":44597,"_5":17394,"_23735":1205,"_2383":44598},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2856":1229,"_25078":1205,"_17499":44600,"_5":17394,"_23735":1205,"_2383":44601},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2856":1230,"_25078":1205,"_17499":44603,"_5":17394,"_23735":44515,"_2383":44604},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2856":1231,"_25078":1205,"_17499":44606,"_5":17394,"_23735":44515,"_2383":44607},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2856":1232,"_25078":1205,"_17499":44609,"_5":17394,"_23735":44515,"_2383":44610},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2856":1233,"_25078":1205,"_17499":44612,"_5":17394,"_23735":44515,"_2383":44613},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2856":1234,"_25078":1205,"_17499":44615,"_5":17394,"_23735":44519,"_2383":44616},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2856":1235,"_25078":1205,"_17499":44618,"_5":17394,"_23735":44523,"_2383":44619},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2856":1236,"_25078":1205,"_17499":44621,"_5":17394,"_23735":44523,"_2383":44622},[],"IAM action",{"_2856":1237,"_25078":1205,"_17499":44624,"_5":17394,"_23735":44523,"_2383":41132},[],{"_2856":1238,"_25078":1205,"_17499":44626,"_5":17394,"_23735":44523,"_2383":44627},[],"`iot:GetRegistrationCode`",{"_2856":1239,"_25078":1205,"_17499":44629,"_5":17394,"_23735":44523,"_2383":44630},[],"Obtain the verification code for CA registration in the Primary Account",{"_2856":1240,"_25078":1205,"_17499":44632,"_5":17394,"_23735":44523,"_2383":44633},[],"`iot:RegisterCACertificate`",{"_2856":1241,"_25078":1205,"_17499":44635,"_5":17394,"_23735":44523,"_2383":44636},[],"Register the CA in AWS IoT",{"_2856":1242,"_25078":1205,"_17499":44638,"_5":17394,"_23735":44523,"_2383":44639},[],"`iot:DescribeCACertificate`",{"_2856":1243,"_25078":1205,"_17499":44641,"_5":17394,"_23735":44523,"_2383":44642},[],"Check the CA registration status",{"_2856":1244,"_25078":1205,"_17499":44644,"_5":17394,"_23735":44523,"_2383":44645},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2856":1245,"_25078":1205,"_17499":44647,"_5":17394,"_23735":44523,"_2383":44648},[],"Create or update Things in IoT Core",{"_2856":1246,"_25078":1205,"_17499":44650,"_5":17394,"_23735":44523,"_2383":44651},[],"`iot:RegisterThing`",{"_2856":1247,"_25078":1205,"_17499":44653,"_5":17394,"_23735":44523,"_2383":44654},[],"Provision Things through a template",{"_2856":1248,"_25078":1205,"_17499":44656,"_5":17394,"_23735":44523,"_2383":44657},[],"`iot:RegisterCertificate`",{"_2856":1249,"_25078":1205,"_17499":44659,"_5":17394,"_23735":44523,"_2383":44660},[],"Register device certificates",{"_2856":1250,"_25078":1205,"_17499":44662,"_5":17394,"_23735":44523,"_2383":44663},[],"`iot:UpdateCertificate`",{"_2856":1251,"_25078":1205,"_17499":44665,"_5":17394,"_23735":44523,"_2383":44666},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2856":1252,"_25078":1205,"_17499":44668,"_5":17394,"_23735":44523,"_2383":44669},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2856":1253,"_25078":1205,"_17499":44671,"_5":17394,"_23735":44523,"_2383":44672},[],"Create and attach IoT policies",{"_2856":1254,"_25078":1205,"_17499":44674,"_5":17394,"_23735":44523,"_2383":44675},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2856":1255,"_25078":1205,"_17499":44677,"_5":17394,"_23735":44523,"_2383":44678},[],"Manage Thing groups",{"_2856":1256,"_25078":1205,"_17499":44680,"_5":17394,"_23735":44523,"_2383":44681},[],"`iot:CreateProvisioningTemplate`",{"_2856":1257,"_25078":1205,"_17499":44683,"_5":17394,"_23735":44523,"_2383":44684},[],"Create JITP templates",{"_2856":1258,"_25078":1205,"_17499":44686,"_5":17394,"_23735":44523,"_2383":44687},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2856":1259,"_25078":1205,"_17499":44689,"_5":17394,"_23735":44523,"_2383":44690},[],"Read and write the Device Shadow",{"_2856":1260,"_25078":1205,"_17499":44692,"_5":17394,"_23735":44523,"_2383":44693},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2856":1261,"_25078":1205,"_17499":44695,"_5":17394,"_23735":44527,"_2383":44696},[],"Parameter",{"_2856":1262,"_25078":1205,"_17499":44698,"_5":17394,"_23735":44527,"_2383":44699},[],"Type",{"_2856":1263,"_25078":1205,"_17499":44701,"_5":17394,"_23735":44527,"_2383":44702},[],"Required",{"_2856":1264,"_25078":1205,"_17499":44704,"_5":17394,"_23735":44527,"_2383":44705},[],"Description",{"_2856":1265,"_25078":1205,"_17499":44707,"_5":17394,"_23735":44527,"_2383":44708},[],"`connector_id`",{"_2856":1266,"_25078":1205,"_17499":44710,"_5":17394,"_23735":44527,"_2383":20884},[],{"_2856":1267,"_25078":1205,"_17499":44712,"_5":17394,"_23735":44527,"_2383":44713},[],"Yes",{"_2856":1268,"_25078":1205,"_17499":44715,"_5":17394,"_23735":44527,"_2383":44716},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2856":1269,"_25078":1205,"_17499":44718,"_5":17394,"_23735":44527,"_2383":44719},[],"`aws_config.region`",{"_2856":1270,"_25078":1205,"_17499":44721,"_5":17394,"_23735":44527,"_2383":20884},[],{"_2856":1271,"_25078":1205,"_17499":44723,"_5":17394,"_23735":44527,"_2383":44713},[],{"_2856":1272,"_25078":1205,"_17499":44725,"_5":17394,"_23735":44527,"_2383":44726},[],"AWS region where the connector operates.",{"_2856":1273,"_25078":1205,"_17499":44728,"_5":17394,"_23735":44527,"_2383":44729},[],"`aws_config.auth_method`",{"_2856":1274,"_25078":1205,"_17499":44731,"_5":17394,"_23735":44527,"_2383":20884},[],{"_2856":1275,"_25078":1205,"_17499":44733,"_5":17394,"_23735":44527,"_2383":44713},[],{"_2856":1276,"_25078":1205,"_17499":44735,"_5":17394,"_23735":44527,"_2383":44736},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2856":1277,"_25078":1205,"_17499":44738,"_5":17394,"_23735":44527,"_2383":44739},[],"`aws_config.access_key_id`",{"_2856":1278,"_25078":1205,"_17499":44741,"_5":17394,"_23735":44527,"_2383":20884},[],{"_2856":1279,"_25078":1205,"_17499":44743,"_5":17394,"_23735":44527,"_2383":44744},[],"Only with `auth_method=static`",{"_2856":1280,"_25078":1205,"_17499":44746,"_5":17394,"_23735":44527,"_2383":44747},[],"AWS access key.",{"_2856":1281,"_25078":1205,"_17499":44749,"_5":17394,"_23735":44527,"_2383":44750},[],"`aws_config.secret_access_key`",{"_2856":1282,"_25078":1205,"_17499":44752,"_5":17394,"_23735":44527,"_2383":20884},[],{"_2856":1283,"_25078":1205,"_17499":44754,"_5":17394,"_23735":44527,"_2383":44744},[],{"_2856":1284,"_25078":1205,"_17499":44756,"_5":17394,"_23735":44527,"_2383":44757},[],"AWS secret key.",{"_2856":1285,"_25078":1205,"_17499":44759,"_5":17394,"_23735":44527,"_2383":44760},[],"`aws_config.session_token`",{"_2856":1286,"_25078":1205,"_17499":44762,"_5":17394,"_23735":44527,"_2383":20884},[],{"_2856":1287,"_25078":1205,"_17499":44764,"_5":17394,"_23735":44527,"_2383":44765},[],"No",{"_2856":1288,"_25078":1205,"_17499":44767,"_5":17394,"_23735":44527,"_2383":44768},[],"Session token (with `auth_method=static`).",{"_2856":1289,"_25078":1205,"_17499":44770,"_5":17394,"_23735":44527,"_2383":44771},[],"`aws_config.role_arn`",{"_2856":1290,"_25078":1205,"_17499":44773,"_5":17394,"_23735":44527,"_2383":20884},[],{"_2856":1291,"_25078":1205,"_17499":44775,"_5":17394,"_23735":44527,"_2383":44776},[],"Only with `auth_method=role`",{"_2856":1292,"_25078":1205,"_17499":44778,"_5":17394,"_23735":44527,"_2383":44779},[],"ARN of the role to assume.",{"_2856":1293,"_25078":1205,"_17499":44781,"_5":17394,"_23735":44527,"_2383":44782},[],"`aws_config.endpoint_url`",{"_2856":1294,"_25078":1205,"_17499":44784,"_5":17394,"_23735":44527,"_2383":20884},[],{"_2856":1295,"_25078":1205,"_17499":44786,"_5":17394,"_23735":44527,"_2383":44765},[],{"_2856":1296,"_25078":1205,"_17499":44788,"_5":17394,"_23735":44527,"_2383":44789},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2856":1297,"_25078":1205,"_17499":44791,"_5":17394,"_23735":44527,"_2383":44792},[],"`subscriber_event_bus`",{"_2856":1298,"_25078":1205,"_17499":44794,"_5":17394,"_23735":44527,"_2383":14682},[],{"_2856":1299,"_25078":1205,"_17499":44796,"_5":17394,"_23735":44527,"_2383":44713},[],{"_2856":1300,"_25078":1205,"_17499":44798,"_5":17394,"_23735":44527,"_2383":44799},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2856":1301,"_25078":1205,"_17499":44801,"_5":17394,"_23735":44527,"_2383":44802},[],"`dms_manager_client`",{"_2856":1302,"_25078":1205,"_17499":44804,"_5":17394,"_23735":44527,"_2383":20884},[],{"_2856":1303,"_25078":1205,"_17499":44806,"_5":17394,"_23735":44527,"_2383":44713},[],{"_2856":1304,"_25078":1205,"_17499":44808,"_5":17394,"_23735":44527,"_2383":44809},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2856":1305,"_25078":1205,"_17499":44811,"_5":17394,"_23735":44527,"_2383":44812},[],"`device_manager_client`",{"_2856":1306,"_25078":1205,"_17499":44814,"_5":17394,"_23735":44527,"_2383":20884},[],{"_2856":1307,"_25078":1205,"_17499":44816,"_5":17394,"_23735":44527,"_2383":44713},[],{"_2856":1308,"_25078":1205,"_17499":44818,"_5":17394,"_23735":44527,"_2383":44819},[],"HTTP URL of Lamassu's Device Manager.",{"_2856":1309,"_25078":1205,"_17499":44821,"_5":17394,"_23735":44527,"_2383":44822},[],"`ca_client`",{"_2856":1310,"_25078":1205,"_17499":44824,"_5":17394,"_23735":44527,"_2383":20884},[],{"_2856":1311,"_25078":1205,"_17499":44826,"_5":17394,"_23735":44527,"_2383":44713},[],{"_2856":1312,"_25078":1205,"_17499":44828,"_5":17394,"_23735":44527,"_2383":44829},[],"HTTP URL of Lamassu's CA service.",{"_2856":1313,"_25078":1205,"_17499":44831,"_5":17394,"_23735":44531,"_2383":44832},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2856":1314,"_25078":1205,"_17499":44834,"_5":17394,"_23735":44535,"_2383":44835},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2856":1315,"_25078":1205,"_17499":44837,"_5":17394,"_23735":44535,"_2383":44838},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2856":1316,"_25078":1205,"_17499":44840,"_5":17394,"_23735":44539,"_2383":44841},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2856":1317,"_25078":1205,"_17499":44843,"_5":17394,"_23735":44539,"_2383":44844},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2856":1318,"_25078":1205,"_17499":44846,"_5":17394,"_23735":44539,"_2383":44847},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2856":1319,"_25078":1205,"_17499":44849,"_5":17394,"_23735":44539,"_2383":44850},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2856":1320,"_25078":1205,"_17499":44852,"_5":17394,"_23735":44539,"_2383":44853},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2856":1321,"_25078":1205,"_17499":44855,"_5":17394,"_23735":44539,"_2383":44856},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2856":1322,"_25078":1205,"_17499":44858,"_5":17394,"_23735":44543,"_2383":44859},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2856":1323,"_25078":1205,"_17499":44861,"_5":17394,"_23735":44547,"_2383":44862},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2856":1324,"_25078":1205,"_17499":44864,"_5":17394,"_23735":44547,"_2383":44865},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2856":1325,"_25078":1205,"_17499":44867,"_5":17394,"_23735":44551,"_2383":44868},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2856":1326,"_25078":1205,"_17499":44870,"_5":17394,"_23735":44555,"_2383":44871},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2856":1327,"_25078":1205,"_17499":44873,"_5":17394,"_23735":44555,"_2383":44874},[],"Creates or updates the IoT policies configured in the DMS.",{"_2856":1328,"_25078":1205,"_17499":44876,"_5":17394,"_23735":44555,"_2383":44877},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2856":1329,"_25078":1205,"_17499":44879,"_5":17394,"_23735":44555,"_2383":44880},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2856":1330,"_25078":1205,"_17499":44882,"_5":17394,"_23735":44555,"_2383":44883},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2856":1331,"_25078":1205,"_17499":44885,"_5":17394,"_23735":44555,"_2383":44886},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2856":1332,"_25078":1205,"_17499":44888,"_5":17394,"_23735":44555,"_2383":44889},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2856":1333,"_25078":1205,"_17499":44891,"_5":17394,"_23735":44559,"_2383":44892},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2856":1334,"_25078":1205,"_17499":44894,"_5":17394,"_23735":44559,"_2383":44895},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2856":1335,"_25078":1205,"_17499":44897,"_5":17394,"_23735":44559,"_2383":44898},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2856":1336,"_25078":1205,"_17499":44900,"_5":17394,"_23735":44563,"_2383":44901},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2856":1337,"_25078":1205,"_17499":44903,"_5":17394,"_23735":44563,"_2383":44904},[],"The full flow from the device's perspective is:",{"_2856":1338,"_25078":1205,"_17499":44906,"_5":17394,"_23735":44563,"_2383":44907},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2856":1339,"_25078":1205,"_17499":44909,"_5":17394,"_23735":44567,"_2383":44910},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2856":1340,"_25078":1205,"_17499":44912,"_5":17394,"_23735":44567,"_2383":44913},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2856":1341,"_25078":1205,"_17499":44915,"_5":17394,"_23735":44567,"_2383":44916},[],"For the JITP flow to work correctly:",{"_2856":1342,"_25078":1205,"_17499":44918,"_5":17394,"_23735":44567,"_2383":44919},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2856":1343,"_25078":1205,"_17499":44921,"_5":17394,"_23735":44567,"_2383":44922},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2856":1344,"_25078":1205,"_17499":44924,"_5":17394,"_23735":44567,"_2383":44925},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2856":1345,"_25078":1205,"_17499":44927,"_5":17394,"_23735":44567,"_2383":44928},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2856":1346,"_25078":1205,"_17499":44930,"_5":17394,"_23735":44571,"_2383":44931},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2856":1347,"_25078":1205,"_17499":44933,"_5":17394,"_23735":44571,"_2383":44934},[],"Status in Lamassu",{"_2856":1348,"_25078":1205,"_17499":44936,"_5":17394,"_23735":44571,"_2383":44937},[],"Revocation reason",{"_2856":1349,"_25078":1205,"_17499":44939,"_5":17394,"_23735":44571,"_2383":44940},[],"Status in AWS IoT Core",{"_2856":1350,"_25078":1205,"_17499":44942,"_5":17394,"_23735":44571,"_2383":44943},[],"`Active`",{"_2856":1351,"_25078":1205,"_17499":44945,"_5":17394,"_23735":44571,"_2383":44946},[],"None",{"_2856":1352,"_25078":1205,"_17499":44948,"_5":17394,"_23735":44571,"_2383":44949},[],"`ACTIVE`",{"_2856":1353,"_25078":1205,"_17499":44951,"_5":17394,"_23735":44571,"_2383":44952},[],"`Revoked`",{"_2856":1354,"_25078":1205,"_17499":44954,"_5":17394,"_23735":44571,"_2383":44955},[],"`certificateHold`",{"_2856":1355,"_25078":1205,"_17499":44957,"_5":17394,"_23735":44571,"_2383":44958},[],"`INACTIVE`",{"_2856":1356,"_25078":1205,"_17499":44960,"_5":17394,"_23735":44571,"_2383":44952},[],{"_2856":1357,"_25078":1205,"_17499":44962,"_5":17394,"_23735":44571,"_2383":44963},[],"Any other reason",{"_2856":1358,"_25078":1205,"_17499":44965,"_5":17394,"_23735":44571,"_2383":44966},[],"`REVOKED`",{"_2856":1359,"_25078":1205,"_17499":44968,"_5":17394,"_23735":44571,"_2383":44969},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2856":1360,"_25078":1205,"_17499":44971,"_5":17394,"_23735":44575,"_2383":44972},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2856":1361,"_25078":1205,"_17499":44974,"_5":17394,"_23735":44575,"_2383":44975},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2856":1362,"_25078":1205,"_17499":44977,"_5":17394,"_23735":44575,"_2383":44978},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2856":1363,"_25078":1205,"_17499":44980,"_5":17394,"_23735":44579,"_2383":44981},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2856":1364,"_25078":1205,"_17499":44983,"_5":17394,"_23735":44579,"_2383":44984},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2856":1365,"_25078":1205,"_17499":44986,"_5":17394,"_23735":44583,"_2383":44987},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2856":1366,"_25078":1205,"_17499":44989,"_5":17394,"_23735":44583,"_2383":44990},[],"There are two action types:",{"_2856":1367,"_25078":1205,"_17499":44992,"_5":17394,"_23735":44583,"_2383":44993},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2856":1368,"_25078":1205,"_17499":44995,"_5":17394,"_23735":44583,"_2383":44996},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2856":1369,"_25078":1205,"_17499":44998,"_5":17394,"_23735":44583,"_2383":44999},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2856":1370,"_25078":1205,"_17499":45001,"_5":17394,"_23735":44587,"_2383":45002},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2856":1371,"_25078":1205,"_17499":45004,"_5":17394,"_23735":44587,"_2383":45005},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2856":1372,"_25078":1205,"_17499":45007,"_5":17394,"_23735":44587,"_2383":45008},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2856":1373,"_25078":1205,"_17499":45010,"_5":17394,"_23735":44591,"_2383":45011},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2856":1374,"_25078":1205,"_17499":45013,"_5":17394,"_23735":44591,"_2383":45014},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2856":1375,"_25078":1205,"_17499":45016,"_5":17394,"_23735":44591,"_2383":45017},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2856":1376,"_25078":1205,"_17499":45019,"_5":17394,"_23735":44591,"_2383":45020},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2856":1377,"_25078":1205,"_17499":45022,"_5":17394,"_23735":44591,"_2383":45023},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2856":1378,"_25078":1205,"_17499":45025,"_5":17394,"_23735":44591,"_2383":45026},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2856":1379,"_25078":1205,"_17499":45028,"_5":17394,"_23735":44591,"_2383":45029},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2856":1380,"_25078":1205,"_17499":45031,"_5":17394,"_23735":44591,"_2383":45032},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2856":1381,"_25078":1205,"_17499":45034,"_5":17394,"_23735":44591,"_2383":45035},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2856":1382,"_25078":1205,"_17499":45037,"_5":17394,"_23735":44591,"_2383":45038},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2856":1383,"_25078":1205,"_17499":45040,"_5":17394,"_23735":44591,"_2383":45041},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2856":1384,"_25078":1205,"_17499":45043,"_5":17394,"_23735":44591,"_2383":45044},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2856":1385,"_25078":1205,"_17499":45046,"_5":17394,"_23735":44591,"_2383":45047},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2856":1386,"_25078":1205,"_17499":45049,"_5":17394,"_23735":44591,"_2383":45050},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2856":1387,"_25078":1205,"_17499":45052,"_5":17394,"_23735":44591,"_2383":45053},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2856":1388,"_25078":1205,"_17499":45055,"_5":17394,"_23735":44591,"_2383":45056},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2856":1389,"_25078":1205,"_17499":45058,"_5":17394,"_23735":44591,"_2383":45059},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2856":1390,"_25078":1205,"_17499":45061,"_5":17394,"_23735":44591,"_2383":45062},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2856":1391,"_25078":1205,"_17499":45064,"_5":17394,"_23735":44591,"_2383":45065},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":1392,"_25078":1205,"_17499":45067,"_5":17394,"_23735":44591,"_2383":45068},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2856":1393,"_25078":1205,"_17499":45070,"_5":17394,"_23735":44591,"_2383":45071},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2856":1394,"_25078":1394,"_5":12261,"_2383":43067,"_25413":45073,"_17499":45074,"_23735":1394},[40749,42093,43067],[],{"_2856":1395,"_25078":1394,"_17499":45076,"_5":17394,"_23735":1394,"_2383":45077},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2856":1396,"_25078":1394,"_5":25410,"_17499":45079,"_23735":45080,"_2383":45081},[],"/docs/pr-preview/pr-40/platform/iot-fleets/overview#start-here","Start here",{"_2856":1397,"_25078":1394,"_5":25410,"_17499":45083,"_23735":45084,"_2383":43065},[],"/docs/pr-preview/pr-40/platform/iot-fleets/overview#devices-and-identities",{"_2856":1398,"_25078":1394,"_5":25410,"_17499":45086,"_23735":45087,"_2383":43248},[],"/docs/pr-preview/pr-40/platform/iot-fleets/overview#enrollment-with-pki",{"_2856":1399,"_25078":1394,"_5":25410,"_17499":45089,"_23735":45090,"_2383":44508},[],"/docs/pr-preview/pr-40/platform/iot-fleets/overview#integrations",{"_2856":1400,"_25078":1394,"_5":25410,"_17499":45092,"_23735":45093,"_2383":45094},[],"/docs/pr-preview/pr-40/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2856":1401,"_25078":1394,"_17499":45096,"_5":17394,"_23735":1394,"_2383":45097},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2856":1402,"_25078":1394,"_17499":45099,"_5":17394,"_23735":45080,"_2383":45100},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2856":1403,"_25078":1394,"_17499":45102,"_5":17394,"_23735":45080,"_2383":45103},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2856":1404,"_25078":1394,"_17499":45105,"_5":17394,"_23735":45084,"_2383":45106},[],"Resource",{"_2856":1405,"_25078":1394,"_17499":45108,"_5":17394,"_23735":45084,"_2383":45109},[],"What it represents",{"_2856":1406,"_25078":1394,"_17499":45111,"_5":17394,"_23735":45084,"_2383":45112},[],"**Device**",{"_2856":1407,"_25078":1394,"_17499":45114,"_5":17394,"_23735":45084,"_2383":45115},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2856":1408,"_25078":1394,"_17499":45117,"_5":17394,"_23735":45084,"_2383":45118},[],"**Identity**",{"_2856":1409,"_25078":1394,"_17499":45120,"_5":17394,"_23735":45084,"_2383":45121},[],"The device's association with its certificates: an active version and a history.",{"_2856":1410,"_25078":1394,"_17499":45123,"_5":17394,"_23735":45084,"_2383":45124},[],"**DMS**",{"_2856":1411,"_25078":1394,"_17499":45126,"_5":17394,"_23735":45084,"_2383":45127},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2856":1412,"_25078":1394,"_17499":45129,"_5":17394,"_23735":45084,"_2383":45130},[],"**Fleet**",{"_2856":1413,"_25078":1394,"_17499":45132,"_5":17394,"_23735":45084,"_2383":45133},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2856":1414,"_25078":1394,"_17499":45135,"_5":17394,"_23735":45084,"_2383":45136},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2856":1415,"_25078":1394,"_17499":45138,"_5":17394,"_23735":45084,"_2383":45139},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2856":1416,"_25078":1394,"_17499":45141,"_5":17394,"_23735":45087,"_2383":45142},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2856":1417,"_25078":1394,"_17499":45144,"_5":17394,"_23735":45087,"_2383":45145},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2856":1418,"_25078":1394,"_17499":45147,"_5":17394,"_23735":45087,"_2383":45148},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2856":1419,"_25078":1394,"_17499":45150,"_5":17394,"_23735":45087,"_2383":45151},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2856":1420,"_25078":1394,"_17499":45153,"_5":17394,"_23735":45087,"_2383":45154},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2856":1421,"_25078":1394,"_17499":45156,"_5":17394,"_23735":45087,"_2383":45157},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2856":1422,"_25078":1394,"_17499":45159,"_5":17394,"_23735":45087,"_2383":45160},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2856":1423,"_25078":1394,"_17499":45162,"_5":17394,"_23735":45087,"_2383":45163},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2856":1424,"_25078":1394,"_17499":45165,"_5":17394,"_23735":45090,"_2383":45166},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2856":1425,"_25078":1394,"_17499":45168,"_5":17394,"_23735":45090,"_2383":45169},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2856":1426,"_25078":1394,"_17499":45171,"_5":17394,"_23735":45093,"_2383":45172},[],"Participant",{"_2856":1427,"_25078":1394,"_17499":45174,"_5":17394,"_23735":45093,"_2383":45175},[],"Responsibility",{"_2856":1428,"_25078":1394,"_17499":45177,"_5":17394,"_23735":45093,"_2383":45178},[],"PKI administrator",{"_2856":1429,"_25078":1394,"_17499":45180,"_5":17394,"_23735":45093,"_2383":45181},[],"CA, issuance profile, chain and revocation publication.",{"_2856":1430,"_25078":1394,"_17499":45183,"_5":17394,"_23735":45093,"_2383":45184},[],"Provisioning administrator",{"_2856":1431,"_25078":1394,"_17499":45186,"_5":17394,"_23735":45093,"_2383":45187},[],"DMS, admission, authentication per operation and inventory.",{"_2856":1432,"_25078":1394,"_17499":45189,"_5":17394,"_23735":45093,"_2383":45190},[],"Device integrator",{"_2856":1433,"_25078":1394,"_17499":45192,"_5":17394,"_23735":45093,"_2383":45193},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2856":1434,"_25078":1394,"_17499":45195,"_5":17394,"_23735":45093,"_2383":45196},[],"Consumer integrator",{"_2856":1435,"_25078":1394,"_17499":45198,"_5":17394,"_23735":45093,"_2383":45199},[],"Trusted issuers, validation and device permissions in the destination.",{"_2856":1436,"_25078":1394,"_17499":45201,"_5":17394,"_23735":45093,"_2383":45202},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2856":1437,"_25078":1437,"_5":12261,"_2383":45204,"_25413":45205,"_17499":45207,"_23735":1437},"Enroll and connect your first device",[40749,42093,43067,45206],"Getting started",[],{"_2856":1438,"_25078":1437,"_17499":45209,"_5":17394,"_23735":1437,"_2383":45210},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2856":1439,"_25078":1437,"_5":25410,"_17499":45212,"_23735":45213,"_2383":40759},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2856":1440,"_25078":1437,"_5":25410,"_17499":45215,"_23735":45216,"_2383":45217},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2856":1441,"_25078":1437,"_5":25410,"_17499":45219,"_23735":45220,"_2383":45221},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2856":1442,"_25078":1437,"_5":25410,"_17499":45223,"_23735":45224,"_2383":45225},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2856":1443,"_25078":1437,"_5":25410,"_17499":45227,"_23735":45228,"_2383":45229},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2856":1444,"_25078":1437,"_5":25410,"_17499":45231,"_23735":45232,"_2383":45233},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2856":1445,"_25078":1437,"_5":25410,"_17499":45235,"_23735":45236,"_2383":45237},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2856":1446,"_25078":1437,"_5":25410,"_17499":45239,"_23735":45240,"_2383":45241},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2856":1447,"_25078":1437,"_17499":45243,"_5":17394,"_23735":1437,"_2383":45244},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2856":1448,"_25078":1437,"_17499":45246,"_5":17394,"_23735":45213,"_2383":45247},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2856":1449,"_25078":1437,"_17499":45249,"_5":17394,"_23735":45213,"_2383":45250},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2856":1450,"_25078":1437,"_17499":45252,"_5":17394,"_23735":45213,"_2383":45253},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2856":1451,"_25078":1437,"_17499":45255,"_5":17394,"_23735":45213,"_2383":45256},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2856":1452,"_25078":1437,"_17499":45258,"_5":17394,"_23735":45213,"_2383":45259},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2856":1453,"_25078":1437,"_17499":45261,"_5":17394,"_23735":45216,"_2383":45262},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2856":1454,"_25078":1437,"_17499":45264,"_5":17394,"_23735":45216,"_2383":45265},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2856":1455,"_25078":1437,"_17499":45267,"_5":17394,"_23735":45220,"_2383":45268},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2856":1456,"_25078":1437,"_17499":45270,"_5":17394,"_23735":45220,"_2383":45271},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2856":1457,"_25078":1437,"_17499":45273,"_5":17394,"_23735":45220,"_2383":45274},[],"Setting",{"_2856":1458,"_25078":1437,"_17499":45276,"_5":17394,"_23735":45220,"_2383":45277},[],"Evaluation value",{"_2856":1459,"_25078":1437,"_17499":45279,"_5":17394,"_23735":45220,"_2383":45280},[],"Enrollment CA",{"_2856":1460,"_25078":1437,"_17499":45282,"_5":17394,"_23735":45220,"_2383":45283},[],"Issuing root from `device-root.pem`.",{"_2856":1461,"_25078":1437,"_17499":45285,"_5":17394,"_23735":45220,"_2383":43378},[],{"_2856":1462,"_25078":1437,"_17499":45287,"_5":17394,"_23735":45220,"_2383":45288},[],"The 1-hour leaf profile you just prepared.",{"_2856":1463,"_25078":1437,"_17499":45290,"_5":17394,"_23735":45220,"_2383":45291},[],"Protocol / Registration Mode",{"_2856":1464,"_25078":1437,"_17499":45293,"_5":17394,"_23735":45220,"_2383":45294},[],"`EST_RFC7030` / `JITP`.",{"_2856":1465,"_25078":1437,"_17499":45296,"_5":17394,"_23735":45220,"_2383":45297},[],"Verify CSR Signature",{"_2856":1466,"_25078":1437,"_17499":45299,"_5":17394,"_23735":45220,"_2383":45300},[],"Enabled.",{"_2856":1467,"_25078":1437,"_17499":45302,"_5":17394,"_23735":45220,"_2383":45303},[],"Enable Replaceable Enrollment",{"_2856":1468,"_25078":1437,"_17499":45305,"_5":17394,"_23735":45220,"_2383":45306},[],"Disabled; the ID must be new.",{"_2856":1469,"_25078":1437,"_17499":45308,"_5":17394,"_23735":45220,"_2383":45309},[],"Initial authentication",{"_2856":1470,"_25078":1437,"_17499":45311,"_5":17394,"_23735":45220,"_2383":45312},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2856":1471,"_25078":1437,"_17499":45314,"_5":17394,"_23735":45220,"_2383":45315},[],"Renewal authentication",{"_2856":1472,"_25078":1437,"_17499":45317,"_5":17394,"_23735":45220,"_2383":45318},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2856":1473,"_25078":1437,"_17499":45320,"_5":17394,"_23735":45220,"_2383":45321},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_2856":1474,"_25078":1437,"_17499":45323,"_5":17394,"_23735":45220,"_2383":45324},[],"Not needed for this direct issuance; the Enrollment CA is always included / disabled.",{"_2856":1475,"_25078":1437,"_17499":45326,"_5":17394,"_23735":45220,"_2383":45327},[],"Re-enrollment Delta",{"_2856":1476,"_25078":1437,"_17499":45329,"_5":17394,"_23735":45220,"_2383":45330},[],"1 hour.",{"_2856":1477,"_25078":1437,"_17499":45332,"_5":17394,"_23735":45220,"_2383":45333},[],"Preventive / Critical Delta",{"_2856":1478,"_25078":1437,"_17499":45335,"_5":17394,"_23735":45220,"_2383":45336},[],"30 minutes / 10 minutes.",{"_2856":1479,"_25078":1437,"_17499":45338,"_5":17394,"_23735":45220,"_2383":45339},[],"Revoke on Re-enrollment",{"_2856":1480,"_25078":1437,"_17499":45341,"_5":17394,"_23735":45220,"_2383":45342},[],"Disabled to test the successor before retiring the previous identity.",{"_2856":1481,"_25078":1437,"_17499":45344,"_5":17394,"_23735":45220,"_2383":43386},[],{"_2856":1482,"_25078":1437,"_17499":45346,"_5":17394,"_23735":45220,"_2383":45347},[],"Disabled; the operational key is generated in the client.",{"_2856":1483,"_25078":1437,"_17499":45349,"_5":17394,"_23735":45220,"_2383":45350},[],"CA Distribution",{"_2856":1484,"_25078":1437,"_17499":45352,"_5":17394,"_23735":45220,"_2383":45353},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2856":1485,"_25078":1437,"_17499":45355,"_5":17394,"_23735":45220,"_2383":45356},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2856":1486,"_25078":1437,"_17499":45358,"_5":17394,"_23735":45224,"_2383":45359},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2856":1487,"_25078":1437,"_17499":45361,"_5":17394,"_23735":45224,"_2383":45362},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2856":1488,"_25078":1437,"_17499":45364,"_5":17394,"_23735":45228,"_2383":45365},[],"Generate a new key and CSR with the selected identifier:",{"_2856":1489,"_25078":1437,"_17499":45367,"_5":17394,"_23735":45228,"_2383":45368},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2856":1490,"_25078":1437,"_17499":45370,"_5":17394,"_23735":45228,"_2383":45371},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2856":1491,"_25078":1437,"_17499":45373,"_5":17394,"_23735":45232,"_2383":45374},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2856":1492,"_25078":1437,"_17499":45376,"_5":17394,"_23735":45232,"_2383":45377},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2856":1493,"_25078":1437,"_17499":45379,"_5":17394,"_23735":45236,"_2383":45380},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2856":1494,"_25078":1437,"_17499":45382,"_5":17394,"_23735":45236,"_2383":45383},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2856":1495,"_25078":1437,"_17499":45385,"_5":17394,"_23735":45236,"_2383":45386},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2856":1496,"_25078":1437,"_17499":45388,"_5":17394,"_23735":45236,"_2383":45389},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2856":1497,"_25078":1437,"_17499":45391,"_5":17394,"_23735":45236,"_2383":45392},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2856":1498,"_25078":1437,"_17499":45394,"_5":17394,"_23735":45240,"_2383":45395},[],"Check",{"_2856":1499,"_25078":1437,"_17499":45397,"_5":17394,"_23735":45240,"_2383":45398},[],"Expected result",{"_2856":1500,"_25078":1437,"_17499":45400,"_5":17394,"_23735":45240,"_2383":45401},[],"Registration",{"_2856":1501,"_25078":1437,"_17499":45403,"_5":17394,"_23735":45240,"_2383":45404},[],"ID created automatically and correct DMS.",{"_2856":1502,"_25078":1437,"_17499":45406,"_5":17394,"_23735":45240,"_2383":45407},[],"Certificate",{"_2856":1503,"_25078":1437,"_17499":45409,"_5":17394,"_23735":45240,"_2383":45410},[],"CN, profile, serial and key verified.",{"_2856":1504,"_25078":1437,"_17499":45412,"_5":17394,"_23735":45240,"_2383":45413},[],"Inventory",{"_2856":1505,"_25078":1437,"_17499":45415,"_5":17394,"_23735":45240,"_2383":45416},[],"Received serial visible as the current identity and in history.",{"_2856":1506,"_25078":1437,"_17499":45418,"_5":17394,"_23735":45240,"_2383":45419},[],"Consumer",{"_2856":1507,"_25078":1437,"_17499":45421,"_5":17394,"_23735":45240,"_2383":45422},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2856":1508,"_25078":1437,"_17499":45424,"_5":17394,"_23735":45240,"_2383":45425},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2856":1509,"_25078":1437,"_17499":45427,"_5":17394,"_23735":45240,"_2383":45428},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2856":1510,"_25078":1510,"_5":12261,"_2383":43083,"_25413":45430,"_17499":45431,"_23735":1510},[40749,42093,43067,45206],[],{"_2856":1511,"_25078":1510,"_17499":45433,"_5":17394,"_23735":1510,"_2383":45434},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2856":1512,"_25078":1510,"_5":25410,"_17499":45436,"_23735":45437,"_2383":40759},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2856":1513,"_25078":1510,"_5":25410,"_17499":45439,"_23735":45440,"_2383":45441},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2856":1514,"_25078":1510,"_5":25410,"_17499":45443,"_23735":45444,"_2383":45445},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2856":1515,"_25078":1510,"_5":25410,"_17499":45447,"_23735":45448,"_2383":45449},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2856":1516,"_25078":1510,"_5":25410,"_17499":45451,"_23735":45452,"_2383":45453},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2856":1517,"_25078":1510,"_5":25410,"_17499":45455,"_23735":45456,"_2383":45457},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2856":1518,"_25078":1510,"_5":25410,"_17499":45459,"_23735":45460,"_2383":45398},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2856":1519,"_25078":1510,"_5":25410,"_17499":45462,"_23735":45463,"_2383":45464},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2856":1520,"_25078":1510,"_5":25410,"_17499":45466,"_23735":45467,"_2383":45468},[],"/docs/pr-preview/pr-40/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2856":1521,"_25078":1510,"_17499":45470,"_5":17394,"_23735":1510,"_2383":45471},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2856":1522,"_25078":1510,"_17499":45473,"_5":17394,"_23735":1510,"_2383":45474},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2856":1523,"_25078":1510,"_17499":45476,"_5":17394,"_23735":45437,"_2383":45477},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2856":1524,"_25078":1510,"_17499":45479,"_5":17394,"_23735":45437,"_2383":45480},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2856":1525,"_25078":1510,"_17499":45482,"_5":17394,"_23735":45437,"_2383":45483},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2856":1526,"_25078":1510,"_17499":45485,"_5":17394,"_23735":45437,"_2383":45486},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2856":1527,"_25078":1510,"_17499":45488,"_5":17394,"_23735":45440,"_2383":45489},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2856":1528,"_25078":1510,"_17499":45491,"_5":17394,"_23735":45440,"_2383":45492},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2856":1529,"_25078":1510,"_17499":45494,"_5":17394,"_23735":45440,"_2383":45495},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2856":1530,"_25078":1510,"_17499":45497,"_5":17394,"_23735":45440,"_2383":45498},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2856":1531,"_25078":1510,"_17499":45500,"_5":17394,"_23735":45440,"_2383":45501},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_2856":1532,"_25078":1510,"_17499":45503,"_5":17394,"_23735":45440,"_2383":45504},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2856":1533,"_25078":1510,"_17499":45506,"_5":17394,"_23735":45440,"_2383":45507},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2856":1534,"_25078":1510,"_17499":45509,"_5":17394,"_23735":45440,"_2383":45510},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2856":1535,"_25078":1510,"_17499":45512,"_5":17394,"_23735":45444,"_2383":45513},[],"Open **Managed Devices** and the registration action. Complete:",{"_2856":1536,"_25078":1510,"_17499":45515,"_5":17394,"_23735":45444,"_2383":45516},[],"**Device ID**: `device-001`.",{"_2856":1537,"_25078":1510,"_17499":45518,"_5":17394,"_23735":45444,"_2383":45519},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2856":1538,"_25078":1510,"_17499":45521,"_5":17394,"_23735":45444,"_2383":45522},[],"**Icon** and **Tags**: optional classification.",{"_2856":1539,"_25078":1510,"_17499":45524,"_5":17394,"_23735":45444,"_2383":45525},[],"Confirm registration.",{"_2856":1540,"_25078":1510,"_17499":45527,"_5":17394,"_23735":45448,"_2383":45528},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2856":1541,"_25078":1510,"_17499":45530,"_5":17394,"_23735":45448,"_2383":45531},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2856":1542,"_25078":1510,"_17499":45533,"_5":17394,"_23735":45452,"_2383":45534},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2856":1543,"_25078":1510,"_17499":45536,"_5":17394,"_23735":45452,"_2383":45537},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2856":1544,"_25078":1510,"_17499":45539,"_5":17394,"_23735":45456,"_2383":45540},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2856":1545,"_25078":1510,"_17499":45542,"_5":17394,"_23735":45456,"_2383":45543},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2856":1546,"_25078":1510,"_17499":45545,"_5":17394,"_23735":45460,"_2383":45395},[],{"_2856":1547,"_25078":1510,"_17499":45547,"_5":17394,"_23735":45460,"_2383":45548},[],"Result",{"_2856":1548,"_25078":1510,"_17499":45550,"_5":17394,"_23735":45460,"_2383":45551},[],"Device",{"_2856":1549,"_25078":1510,"_17499":45553,"_5":17394,"_23735":45460,"_2383":45554},[],"`device-001` appears in inventory with the expected DMS.",{"_2856":1550,"_25078":1510,"_17499":45556,"_5":17394,"_23735":45460,"_2383":45557},[],"Current identity",{"_2856":1551,"_25078":1510,"_17499":45559,"_5":17394,"_23735":45460,"_2383":45560},[],"The associated certificate matches the one you verified in PKI.",{"_2856":1552,"_25078":1510,"_17499":45562,"_5":17394,"_23735":45460,"_2383":45563},[],"History",{"_2856":1553,"_25078":1510,"_17499":45565,"_5":17394,"_23735":45460,"_2383":45566},[],"The associated issuance appears with its serial number and dates.",{"_2856":1554,"_25078":1510,"_17499":45568,"_5":17394,"_23735":45460,"_2383":45569},[],"Key and certificate",{"_2856":1555,"_25078":1510,"_17499":45571,"_5":17394,"_23735":45460,"_2383":45572},[],"You have the verified pair ready to install on the device.",{"_2856":1556,"_25078":1510,"_17499":45574,"_5":17394,"_23735":45463,"_2383":45575},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2856":1557,"_25078":1510,"_17499":45577,"_5":17394,"_23735":45463,"_2383":45578},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2856":1558,"_25078":1510,"_17499":45580,"_5":17394,"_23735":45463,"_2383":45581},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2856":1559,"_25078":1510,"_17499":45583,"_5":17394,"_23735":45463,"_2383":45584},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2856":1560,"_25078":1510,"_17499":45586,"_5":17394,"_23735":45467,"_2383":45587},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2856":1561,"_25078":1510,"_17499":45589,"_5":17394,"_23735":45467,"_2383":45590},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2856":1562,"_25078":1510,"_17499":45592,"_5":17394,"_23735":45467,"_2383":45593},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2856":1563,"_25078":1563,"_5":12261,"_2383":45595,"_25413":45596,"_17499":45597,"_23735":1563},"Lamassu IoT Platform",[40749,42093],[],{"_2856":1564,"_25078":1563,"_17499":45599,"_5":17394,"_23735":1563,"_2383":45600},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2856":1565,"_25078":1563,"_5":25410,"_17499":45602,"_23735":45603,"_2383":45081},[],"/docs/pr-preview/pr-40/platform/overview#start-here",{"_2856":1566,"_25078":1563,"_5":25410,"_17499":45605,"_23735":45606,"_2383":45607},[],"/docs/pr-preview/pr-40/platform/overview#choose-your-path","Choose your path",{"_2856":1567,"_25078":1563,"_5":25410,"_17499":45609,"_23735":45610,"_2383":45611},[],"/docs/pr-preview/pr-40/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2856":1568,"_25078":1563,"_5":25410,"_17499":45613,"_23735":45614,"_2383":45615},[],"/docs/pr-preview/pr-40/platform/overview#core-capabilities","Core capabilities",{"_2856":1569,"_25078":1563,"_5":25410,"_17499":45617,"_23735":45618,"_2383":45619},[],"/docs/pr-preview/pr-40/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2856":1570,"_25078":1563,"_5":25410,"_17499":45621,"_23735":45622,"_2383":45623},[],"/docs/pr-preview/pr-40/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2856":1571,"_25078":1563,"_5":25410,"_17499":45625,"_23735":45626,"_2383":45627},[],"/docs/pr-preview/pr-40/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2856":1572,"_25078":1563,"_5":25410,"_17499":45629,"_23735":45630,"_2383":45631},[],"/docs/pr-preview/pr-40/platform/overview#automate-device-identities","Automate device identities",{"_2856":1573,"_25078":1563,"_5":25410,"_17499":45633,"_23735":45634,"_2383":45635},[],"/docs/pr-preview/pr-40/platform/overview#publish-validation-status","Publish validation status",{"_2856":1574,"_25078":1563,"_5":25410,"_17499":45637,"_23735":45638,"_2383":45639},[],"/docs/pr-preview/pr-40/platform/overview#react-to-events","React to events",{"_2856":1575,"_25078":1563,"_5":25410,"_17499":45641,"_23735":45642,"_2383":45643},[],"/docs/pr-preview/pr-40/platform/overview#operational-reference","Operational reference",{"_2856":1576,"_25078":1563,"_17499":45645,"_5":17394,"_23735":1563,"_2383":45646},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2856":1577,"_25078":1563,"_17499":45648,"_5":17394,"_23735":45603,"_2383":45649},[],"Choose the result you need:",{"_2856":1578,"_25078":1563,"_17499":45651,"_5":17394,"_23735":45603,"_2383":45652},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2856":1579,"_25078":1563,"_17499":45654,"_5":17394,"_23735":45603,"_2383":45655},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2856":1580,"_25078":1563,"_17499":45657,"_5":17394,"_23735":45603,"_2383":45658},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2856":1581,"_25078":1563,"_17499":45660,"_5":17394,"_23735":45606,"_2383":45661},[],"Section",{"_2856":1582,"_25078":1563,"_17499":45663,"_5":17394,"_23735":45606,"_2383":45664},[],"What you manage",{"_2856":1583,"_25078":1563,"_17499":45666,"_5":17394,"_23735":45606,"_2383":45667},[],"Entry point",{"_2856":1584,"_25078":1563,"_17499":45669,"_5":17394,"_23735":45606,"_2383":45670},[],"**PKI**",{"_2856":1585,"_25078":1563,"_17499":45672,"_5":17394,"_23735":45606,"_2383":45673},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2856":1586,"_25078":1563,"_17499":45675,"_5":17394,"_23735":45606,"_2383":45676},[],"PKI overview",{"_2856":1587,"_25078":1563,"_17499":45678,"_5":17394,"_23735":45606,"_2383":45679},[],"**IoT Fleets**",{"_2856":1588,"_25078":1563,"_17499":45681,"_5":17394,"_23735":45606,"_2383":45682},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2856":1589,"_25078":1563,"_17499":45684,"_5":17394,"_23735":45606,"_2383":45685},[],"IoT Fleets overview",{"_2856":1590,"_25078":1563,"_17499":45687,"_5":17394,"_23735":45606,"_2383":45688},[],"**Administration**",{"_2856":1591,"_25078":1563,"_17499":45690,"_5":17394,"_23735":45606,"_2383":45691},[],"Operator permissions, audit and event subscriptions.",{"_2856":1592,"_25078":1563,"_17499":45693,"_5":17394,"_23735":45606,"_2383":42091},[],{"_2856":1593,"_25078":1563,"_17499":45695,"_5":17394,"_23735":45606,"_2383":45696},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2856":1594,"_25078":1563,"_17499":45698,"_5":17394,"_23735":45610,"_2383":45699},[],"An identity's journey connects four responsibilities:",{"_2856":1595,"_25078":1563,"_17499":45701,"_5":17394,"_23735":45610,"_2383":45702},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2856":1596,"_25078":1563,"_17499":45704,"_5":17394,"_23735":45610,"_2383":45705},[],"The provisioning administrator configures the DMS and initial trust.",{"_2856":1597,"_25078":1563,"_17499":45707,"_5":17394,"_23735":45610,"_2383":45708},[],"The device client requests a certificate and installs it with the matching key.",{"_2856":1598,"_25078":1563,"_17499":45710,"_5":17394,"_23735":45610,"_2383":45711},[],"The consumer validates the identity and applies its access permissions.",{"_2856":1599,"_25078":1563,"_17499":45713,"_5":17394,"_23735":45610,"_2383":45714},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2856":1600,"_25078":1563,"_17499":45716,"_5":17394,"_23735":45618,"_2383":45717},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2856":1601,"_25078":1563,"_17499":45719,"_5":17394,"_23735":45622,"_2383":45720},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2856":1602,"_25078":1563,"_17499":45722,"_5":17394,"_23735":45626,"_2383":45723},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2856":1603,"_25078":1563,"_17499":45725,"_5":17394,"_23735":45630,"_2383":45726},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2856":1604,"_25078":1563,"_17499":45728,"_5":17394,"_23735":45634,"_2383":45729},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2856":1605,"_25078":1563,"_17499":45731,"_5":17394,"_23735":45638,"_2383":45732},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2856":1606,"_25078":1563,"_17499":45734,"_5":17394,"_23735":45642,"_2383":45175},[],{"_2856":1607,"_25078":1563,"_17499":45736,"_5":17394,"_23735":45642,"_2383":45737},[],"What it prepares or checks",{"_2856":1608,"_25078":1563,"_17499":45739,"_5":17394,"_23735":45642,"_2383":45178},[],{"_2856":1609,"_25078":1563,"_17499":45741,"_5":17394,"_23735":45642,"_2383":45742},[],"Key custody, CA hierarchy, profiles and validation.",{"_2856":1610,"_25078":1563,"_17499":45744,"_5":17394,"_23735":45642,"_2383":45745},[],"Fleet administrator",{"_2856":1611,"_25078":1563,"_17499":45747,"_5":17394,"_23735":45642,"_2383":45748},[],"DMS, device admission, renewal policy and inventory.",{"_2856":1612,"_25078":1563,"_17499":45750,"_5":17394,"_23735":45642,"_2383":45190},[],{"_2856":1613,"_25078":1563,"_17499":45752,"_5":17394,"_23735":45642,"_2383":45753},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2856":1614,"_25078":1563,"_17499":45755,"_5":17394,"_23735":45642,"_2383":45196},[],{"_2856":1615,"_25078":1563,"_17499":45757,"_5":17394,"_23735":45642,"_2383":45758},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2856":1616,"_25078":1563,"_17499":45760,"_5":17394,"_23735":45642,"_2383":45761},[],"Infrastructure operator",{"_2856":1617,"_25078":1563,"_17499":45763,"_5":17394,"_23735":45642,"_2383":45764},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2856":1618,"_25078":1563,"_17499":45766,"_5":17394,"_23735":45642,"_2383":45767},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2856":1619,"_25078":1619,"_5":12261,"_2383":45769,"_25413":45770,"_17499":45773,"_23735":1619},"CA hierarchy and rotation",[40749,42093,45771,45772],"PKI","Keys, authorities and certificates",[],{"_2856":1620,"_25078":1619,"_17499":45775,"_5":17394,"_23735":1619,"_2383":45776},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2856":1621,"_25078":1619,"_5":25410,"_17499":45778,"_23735":45779,"_2383":45780},[],"/docs/pr-preview/pr-40/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2856":1622,"_25078":1619,"_5":25410,"_17499":45782,"_23735":45783,"_2383":45784},[],"/docs/pr-preview/pr-40/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2856":1623,"_25078":1619,"_5":25410,"_17499":45786,"_23735":45787,"_2383":45788},[],"/docs/pr-preview/pr-40/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2856":1624,"_25078":1619,"_5":25410,"_17499":45790,"_23735":45791,"_2383":45792},[],"/docs/pr-preview/pr-40/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2856":1625,"_25078":1619,"_5":25410,"_17499":45794,"_23735":45795,"_2383":45796},[],"/docs/pr-preview/pr-40/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2856":1626,"_25078":1619,"_5":25410,"_17499":45798,"_23735":45799,"_2383":45800},[],"/docs/pr-preview/pr-40/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2856":1627,"_25078":1619,"_5":25410,"_17499":45802,"_23735":45803,"_2383":45804},[],"/docs/pr-preview/pr-40/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2856":1628,"_25078":1619,"_5":25410,"_17499":45806,"_23735":45807,"_2383":45808},[],"/docs/pr-preview/pr-40/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2856":1629,"_25078":1619,"_5":25410,"_17499":45810,"_23735":45811,"_2383":45812},[],"/docs/pr-preview/pr-40/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2856":1630,"_25078":1619,"_5":25410,"_17499":45814,"_23735":45815,"_2383":45816},[],"/docs/pr-preview/pr-40/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2856":1631,"_25078":1619,"_5":25410,"_17499":45818,"_23735":45819,"_2383":45820},[],"/docs/pr-preview/pr-40/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2856":1632,"_25078":1619,"_5":25410,"_17499":45822,"_23735":45823,"_2383":45824},[],"/docs/pr-preview/pr-40/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2856":1633,"_25078":1619,"_17499":45826,"_5":17394,"_23735":1619,"_2383":45827},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2856":1634,"_25078":1619,"_17499":45829,"_5":17394,"_23735":1619,"_2383":45830},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2856":1635,"_25078":1619,"_17499":45832,"_5":17394,"_23735":45779,"_2383":45833},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2856":1636,"_25078":1619,"_17499":45835,"_5":17394,"_23735":45779,"_2383":45836},[],"environment, such as production and preproduction;",{"_2856":1637,"_25078":1619,"_17499":45838,"_5":17394,"_23735":45779,"_2383":45839},[],"owner or operating team;",{"_2856":1638,"_25078":1619,"_17499":45841,"_5":17394,"_23735":45779,"_2383":45842},[],"device family or manufacturing process;",{"_2856":1639,"_25078":1619,"_17499":45844,"_5":17394,"_23735":45779,"_2383":45845},[],"region or regulatory requirement;",{"_2856":1640,"_25078":1619,"_17499":45847,"_5":17394,"_23735":45779,"_2383":45848},[],"cryptographic engine or key policy;",{"_2856":1641,"_25078":1619,"_17499":45850,"_5":17394,"_23735":45779,"_2383":45851},[],"maintenance window and renewal cadence.",{"_2856":1642,"_25078":1619,"_17499":45853,"_5":17394,"_23735":45779,"_2383":45854},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2856":1643,"_25078":1619,"_17499":45856,"_5":17394,"_23735":45779,"_2383":45857},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2856":1644,"_25078":1619,"_17499":45859,"_5":17394,"_23735":45783,"_2383":45860},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2856":1645,"_25078":1619,"_17499":45862,"_5":17394,"_23735":45783,"_2383":45863},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2856":1646,"_25078":1619,"_17499":45865,"_5":17394,"_23735":45783,"_2383":45866},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2856":1647,"_25078":1619,"_17499":45868,"_5":17394,"_23735":45787,"_2383":45869},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2856":1648,"_25078":1619,"_17499":45871,"_5":17394,"_23735":45787,"_2383":45872},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2856":1649,"_25078":1619,"_17499":45874,"_5":17394,"_23735":45787,"_2383":45875},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2856":1650,"_25078":1619,"_17499":45877,"_5":17394,"_23735":45787,"_2383":45878},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2856":1651,"_25078":1619,"_17499":45880,"_5":17394,"_23735":45795,"_2383":45881},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2856":1652,"_25078":1619,"_17499":45883,"_5":17394,"_23735":45799,"_2383":45884},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2856":1653,"_25078":1619,"_17499":45886,"_5":17394,"_23735":45803,"_2383":45887},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2856":1654,"_25078":1619,"_17499":45889,"_5":17394,"_23735":45807,"_2383":45890},[],"Update the enrollment CA and profile of the DMSs. While old certificates still need re-enrollment acceptance, add the previous enrollment CA as a re-enrollment validation CA: the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no other list, so without that entry its certificates can no longer renew.",{"_2856":1655,"_25078":1619,"_17499":45892,"_5":17394,"_23735":45811,"_2383":45893},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2856":1656,"_25078":1619,"_17499":45895,"_5":17394,"_23735":45815,"_2383":45896},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_2856":1657,"_25078":1619,"_17499":45898,"_5":17394,"_23735":45819,"_2383":45899},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2856":1658,"_25078":1619,"_17499":45901,"_5":17394,"_23735":45819,"_2383":45902},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2856":1659,"_25078":1619,"_17499":45904,"_5":17394,"_23735":45819,"_2383":45905},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2856":1660,"_25078":1619,"_17499":45907,"_5":17394,"_23735":45819,"_2383":45908},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2856":1661,"_25078":1619,"_17499":45910,"_5":17394,"_23735":45823,"_2383":45911},[],"The new chain ends in an anchor installed by the consumer.",{"_2856":1662,"_25078":1619,"_17499":45913,"_5":17394,"_23735":45823,"_2383":45914},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2856":1663,"_25078":1619,"_17499":45916,"_5":17394,"_23735":45823,"_2383":45917},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2856":1664,"_25078":1619,"_17499":45919,"_5":17394,"_23735":45823,"_2383":45920},[],"Re-enrollment accepts the old identity during the planned period.",{"_2856":1665,"_25078":1619,"_17499":45922,"_5":17394,"_23735":45823,"_2383":45923},[],"OCSP and CRL respond for the authorities that remain active.",{"_2856":1666,"_25078":1619,"_17499":45925,"_5":17394,"_23735":45823,"_2383":45926},[],"No DMS is left accidentally issuing from the old CA.",{"_2856":1667,"_25078":1619,"_17499":45928,"_5":17394,"_23735":45823,"_2383":45929},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2856":1668,"_25078":1668,"_5":12261,"_2383":45931,"_25413":45932,"_17499":45933,"_23735":1668},"Certification authorities",[40749,42093,45771,45772],[],{"_2856":1669,"_25078":1668,"_17499":45935,"_5":17394,"_23735":1668,"_2383":45936},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2856":1670,"_25078":1668,"_5":25410,"_17499":45938,"_23735":45939,"_2383":45940},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2856":1671,"_25078":1668,"_5":25410,"_17499":45942,"_23735":45943,"_2383":45944},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2856":1672,"_25078":1668,"_5":25410,"_17499":45946,"_23735":45947,"_2383":40759},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#before-you-begin",{"_2856":1673,"_25078":1668,"_5":25410,"_17499":45949,"_23735":45950,"_2383":45951},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2856":1674,"_25078":1668,"_5":25410,"_17499":45953,"_23735":45954,"_2383":45955},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2856":1675,"_25078":1668,"_5":25410,"_17499":45957,"_23735":45958,"_2383":45959},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2856":1676,"_25078":1668,"_5":25410,"_17499":45961,"_23735":45962,"_2383":45963},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2856":1677,"_25078":1668,"_5":25410,"_17499":45965,"_23735":45966,"_2383":45967},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2856":1678,"_25078":1668,"_5":25410,"_17499":45969,"_23735":45970,"_2383":45971},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2856":1679,"_25078":1668,"_5":25410,"_17499":45973,"_23735":45974,"_2383":45975},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2856":1680,"_25078":1668,"_5":25410,"_17499":45977,"_23735":45978,"_2383":45979},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2856":1681,"_25078":1668,"_5":25410,"_17499":45981,"_23735":45982,"_2383":45983},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2856":1682,"_25078":1668,"_5":25410,"_17499":45985,"_23735":45986,"_2383":45987},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2856":1683,"_25078":1668,"_5":25410,"_17499":45989,"_23735":45990,"_2383":45991},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2856":1684,"_25078":1668,"_5":25410,"_17499":45993,"_23735":45994,"_2383":45995},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2856":1685,"_25078":1668,"_5":25410,"_17499":45997,"_23735":45998,"_2383":45999},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2856":1686,"_25078":1668,"_5":25410,"_17499":46001,"_23735":46002,"_2383":46003},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2856":1687,"_25078":1668,"_5":25410,"_17499":46005,"_23735":46006,"_2383":46007},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2856":1688,"_25078":1668,"_5":25410,"_17499":46009,"_23735":46010,"_2383":46011},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2856":1689,"_25078":1668,"_5":25410,"_17499":46013,"_23735":46014,"_2383":46015},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2856":1690,"_25078":1668,"_5":25410,"_17499":46017,"_23735":46018,"_2383":46019},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2856":1691,"_25078":1668,"_5":25410,"_17499":46021,"_23735":46022,"_2383":46023},[],"/docs/pr-preview/pr-40/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2856":1692,"_25078":1668,"_17499":46025,"_5":17394,"_23735":1668,"_2383":46026},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2856":1693,"_25078":1668,"_17499":46028,"_5":17394,"_23735":1668,"_2383":46029},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2856":1694,"_25078":1668,"_17499":46031,"_5":17394,"_23735":1668,"_2383":46032},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2856":1695,"_25078":1668,"_17499":46034,"_5":17394,"_23735":45939,"_2383":46035},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2856":1696,"_25078":1668,"_17499":46037,"_5":17394,"_23735":45939,"_2383":46038},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2856":1697,"_25078":1668,"_17499":46040,"_5":17394,"_23735":45939,"_2383":46041},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2856":1698,"_25078":1668,"_17499":46043,"_5":17394,"_23735":45939,"_2383":46044},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2856":1699,"_25078":1668,"_17499":46046,"_5":17394,"_23735":45939,"_2383":46047},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2856":1700,"_25078":1668,"_17499":46049,"_5":17394,"_23735":45947,"_2383":46050},[],"Decide whether the CA will be a root or an intermediate.",{"_2856":1701,"_25078":1668,"_17499":46052,"_5":17394,"_23735":45947,"_2383":46053},[],"Choose the engine that will keep the key.",{"_2856":1702,"_25078":1668,"_17499":46055,"_5":17394,"_23735":45947,"_2383":46056},[],"Define a validity longer than that of the certificates it will issue.",{"_2856":1703,"_25078":1668,"_17499":46058,"_5":17394,"_23735":45947,"_2383":46059},[],"For an intermediate CA, make sure the parent CA is active.",{"_2856":1704,"_25078":1668,"_17499":46061,"_5":17394,"_23735":45950,"_2383":46062},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2856":1705,"_25078":1668,"_17499":46064,"_5":17394,"_23735":45954,"_2383":46065},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2856":1706,"_25078":1668,"_17499":46067,"_5":17394,"_23735":45954,"_2383":46068},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2856":1707,"_25078":1668,"_17499":46070,"_5":17394,"_23735":45958,"_2383":46071},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2856":1708,"_25078":1668,"_17499":46073,"_5":17394,"_23735":45962,"_2383":46074},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2856":1709,"_25078":1668,"_17499":46076,"_5":17394,"_23735":45962,"_2383":46077},[],"`C`: two-letter ISO 3166-1 country code.",{"_2856":1710,"_25078":1668,"_17499":46079,"_5":17394,"_23735":45962,"_2383":46080},[],"`ST`: state or province.",{"_2856":1711,"_25078":1668,"_17499":46082,"_5":17394,"_23735":45962,"_2383":46083},[],"`L`: locality.",{"_2856":1712,"_25078":1668,"_17499":46085,"_5":17394,"_23735":45962,"_2383":46086},[],"`O`: organization.",{"_2856":1713,"_25078":1668,"_17499":46088,"_5":17394,"_23735":45962,"_2383":46089},[],"`OU`: organizational unit.",{"_2856":1714,"_25078":1668,"_17499":46091,"_5":17394,"_23735":45962,"_2383":46092},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2856":1715,"_25078":1668,"_17499":46094,"_5":17394,"_23735":45966,"_2383":46095},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2856":1716,"_25078":1668,"_17499":46097,"_5":17394,"_23735":45966,"_2383":46098},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2856":1717,"_25078":1668,"_17499":46100,"_5":17394,"_23735":45970,"_2383":46101},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2856":1718,"_25078":1668,"_17499":46103,"_5":17394,"_23735":45970,"_2383":46104},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2856":1719,"_25078":1668,"_17499":46106,"_5":17394,"_23735":45974,"_2383":46107},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2856":1720,"_25078":1668,"_17499":46109,"_5":17394,"_23735":45974,"_2383":46110},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2856":1721,"_25078":1668,"_17499":46112,"_5":17394,"_23735":45978,"_2383":46113},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2856":1722,"_25078":1668,"_17499":46115,"_5":17394,"_23735":45982,"_2383":46116},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2856":1723,"_25078":1668,"_17499":46118,"_5":17394,"_23735":45986,"_2383":46119},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2856":1724,"_25078":1668,"_17499":46121,"_5":17394,"_23735":45990,"_2383":46122},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2856":1725,"_25078":1668,"_17499":46124,"_5":17394,"_23735":45994,"_2383":46125},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2856":1726,"_25078":1668,"_17499":46127,"_5":17394,"_23735":45994,"_2383":46128},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2856":1727,"_25078":1668,"_17499":46130,"_5":17394,"_23735":45998,"_2383":46131},[],"Open a CA from the inventory to review:",{"_2856":1728,"_25078":1668,"_17499":46133,"_5":17394,"_23735":45998,"_2383":46134},[],"Status and validity period.",{"_2856":1729,"_25078":1668,"_17499":46136,"_5":17394,"_23735":45998,"_2383":46137},[],"Certificate and chain in PEM format.",{"_2856":1730,"_25078":1668,"_17499":46139,"_5":17394,"_23735":45998,"_2383":46140},[],"Number of active, expired and revoked certificates.",{"_2856":1731,"_25078":1668,"_17499":46142,"_5":17394,"_23735":45998,"_2383":46143},[],"Certificates issued in **Issued Certificates**.",{"_2856":1732,"_25078":1668,"_17499":46145,"_5":17394,"_23735":45998,"_2383":46146},[],"The CRL linked to the authority.",{"_2856":1733,"_25078":1668,"_17499":46148,"_5":17394,"_23735":45998,"_2383":46149},[],"Metadata and the associated cryptographic engine.",{"_2856":1734,"_25078":1668,"_17499":46151,"_5":17394,"_23735":45998,"_2383":46152},[],"You can filter the inventory by name, status and CA type.",{"_2856":1735,"_25078":1668,"_17499":46154,"_5":17394,"_23735":46002,"_2383":46155},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2856":1736,"_25078":1668,"_17499":46157,"_5":17394,"_23735":46002,"_2383":46158},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2856":1737,"_25078":1668,"_17499":46160,"_5":17394,"_23735":46002,"_2383":46161},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2856":1738,"_25078":1668,"_17499":46163,"_5":17394,"_23735":46002,"_2383":46164},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2856":1739,"_25078":1668,"_17499":46166,"_5":17394,"_23735":46006,"_2383":46167},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2856":1740,"_25078":1668,"_17499":46169,"_5":17394,"_23735":46010,"_2383":46170},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2856":1741,"_25078":1668,"_17499":46172,"_5":17394,"_23735":46014,"_2383":46173},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2856":1742,"_25078":1668,"_17499":46175,"_5":17394,"_23735":46018,"_2383":46176},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2856":1743,"_25078":1668,"_17499":46178,"_5":17394,"_23735":46022,"_2383":46179},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2856":1744,"_25078":1668,"_17499":46181,"_5":17394,"_23735":46022,"_2383":46182},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2856":1745,"_25078":1745,"_5":12261,"_2383":46184,"_25413":46185,"_17499":46186,"_23735":1745},"Certificate profiles",[40749,42093,45771,45772],[],{"_2856":1746,"_25078":1745,"_17499":46188,"_5":17394,"_23735":1745,"_2383":46189},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2856":1747,"_25078":1745,"_5":25410,"_17499":46191,"_23735":46192,"_2383":46193},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2856":1748,"_25078":1745,"_5":25410,"_17499":46195,"_23735":46196,"_2383":46197},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#validity","Validity",{"_2856":1749,"_25078":1745,"_5":25410,"_17499":46199,"_23735":46200,"_2383":46201},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2856":1750,"_25078":1745,"_5":25410,"_17499":46203,"_23735":46204,"_2383":46205},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2856":1751,"_25078":1745,"_5":25410,"_17499":46207,"_23735":46208,"_2383":46209},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#subject","Subject",{"_2856":1752,"_25078":1745,"_5":25410,"_17499":46211,"_23735":46212,"_2383":46213},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2856":1753,"_25078":1745,"_5":25410,"_17499":46215,"_23735":46216,"_2383":46217},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2856":1754,"_25078":1745,"_5":25410,"_17499":46219,"_23735":46220,"_2383":46221},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2856":1755,"_25078":1745,"_5":25410,"_17499":46223,"_23735":46224,"_2383":46225},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2856":1756,"_25078":1745,"_5":25410,"_17499":46227,"_23735":46228,"_2383":46229},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2856":1757,"_25078":1745,"_5":25410,"_17499":46231,"_23735":46232,"_2383":46233},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2856":1758,"_25078":1745,"_5":25410,"_17499":46235,"_23735":46236,"_2383":46237},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2856":1759,"_25078":1745,"_5":25410,"_17499":46239,"_23735":46240,"_2383":46241},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2856":1760,"_25078":1745,"_5":25410,"_17499":46243,"_23735":46244,"_2383":46245},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2856":1761,"_25078":1745,"_5":25410,"_17499":46247,"_23735":46248,"_2383":46249},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#design-examples","Design examples",{"_2856":1762,"_25078":1745,"_5":25410,"_17499":46251,"_23735":46252,"_2383":46253},[],"/docs/pr-preview/pr-40/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2856":1763,"_25078":1745,"_17499":46255,"_5":17394,"_23735":1745,"_2383":46256},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2856":1764,"_25078":1745,"_17499":46258,"_5":17394,"_23735":1745,"_2383":46259},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2856":1765,"_25078":1745,"_17499":46261,"_5":17394,"_23735":46196,"_2383":46262},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2856":1766,"_25078":1745,"_17499":46264,"_5":17394,"_23735":46196,"_2383":46265},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2856":1767,"_25078":1745,"_17499":46267,"_5":17394,"_23735":46200,"_2383":46268},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2856":1768,"_25078":1745,"_17499":46270,"_5":17394,"_23735":46204,"_2383":46271},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2856":1769,"_25078":1745,"_17499":46273,"_5":17394,"_23735":46204,"_2383":46274},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2856":1770,"_25078":1745,"_17499":46276,"_5":17394,"_23735":46204,"_2383":46277},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2856":1771,"_25078":1745,"_17499":46279,"_5":17394,"_23735":46208,"_2383":46280},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2856":1772,"_25078":1745,"_17499":46282,"_5":17394,"_23735":46212,"_2383":46283},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2856":1773,"_25078":1745,"_17499":46285,"_5":17394,"_23735":46212,"_2383":46286},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2856":1774,"_25078":1745,"_17499":46288,"_5":17394,"_23735":46216,"_2383":46289},[],"The cryptographic enforcement can:",{"_2856":1775,"_25078":1745,"_17499":46291,"_5":17394,"_23735":46216,"_2383":46292},[],"allow or block RSA keys;",{"_2856":1776,"_25078":1745,"_17499":46294,"_5":17394,"_23735":46216,"_2383":46295},[],"limit the supported RSA sizes;",{"_2856":1777,"_25078":1745,"_17499":46297,"_5":17394,"_23735":46216,"_2383":46298},[],"allow or block ECDSA keys;",{"_2856":1778,"_25078":1745,"_17499":46300,"_5":17394,"_23735":46216,"_2383":46301},[],"limit the supported ECDSA sizes or curves.",{"_2856":1779,"_25078":1745,"_17499":46303,"_5":17394,"_23735":46216,"_2383":46304},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2856":1780,"_25078":1745,"_17499":46306,"_5":17394,"_23735":46220,"_2383":46307},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2856":1781,"_25078":1745,"_17499":46309,"_5":17394,"_23735":46220,"_2383":43811},[],{"_2856":1782,"_25078":1745,"_17499":46311,"_5":17394,"_23735":46220,"_2383":46312},[],"First choice",{"_2856":1783,"_25078":1745,"_17499":46314,"_5":17394,"_23735":46220,"_2383":46315},[],"Second choice",{"_2856":1784,"_25078":1745,"_17499":46317,"_5":17394,"_23735":46220,"_2383":46318},[],"If neither is supplied",{"_2856":1785,"_25078":1745,"_17499":46320,"_5":17394,"_23735":46220,"_2383":46321},[],"Direct signing with a CA",{"_2856":1786,"_25078":1745,"_17499":46323,"_5":17394,"_23735":46220,"_2383":46324},[],"`issuance_profile` embedded in the request",{"_2856":1787,"_25078":1745,"_17499":46326,"_5":17394,"_23735":46220,"_2383":46327},[],"Request `issuance_profile_id`",{"_2856":1788,"_25078":1745,"_17499":46329,"_5":17394,"_23735":46220,"_2383":46330},[],"CA default profile (`profile_id`).",{"_2856":1789,"_25078":1745,"_17499":46332,"_5":17394,"_23735":46220,"_2383":46333},[],"Issuance through a DMS",{"_2856":1790,"_25078":1745,"_17499":46335,"_5":17394,"_23735":46220,"_2383":46336},[],"`settings.issuance_profile_id`",{"_2856":1791,"_25078":1745,"_17499":46338,"_5":17394,"_23735":46220,"_2383":46339},[],"`settings.issuance_profile` embedded in the DMS",{"_2856":1792,"_25078":1745,"_17499":46341,"_5":17394,"_23735":46220,"_2383":46342},[],"Enrollment CA default profile.",{"_2856":1793,"_25078":1745,"_17499":46344,"_5":17394,"_23735":46220,"_2383":46345},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2856":1794,"_25078":1745,"_17499":46347,"_5":17394,"_23735":46220,"_2383":46348},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2856":1795,"_25078":1745,"_17499":46350,"_5":17394,"_23735":46228,"_2383":46351},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2856":1796,"_25078":1745,"_17499":46353,"_5":17394,"_23735":46232,"_2383":46354},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2856":1797,"_25078":1745,"_17499":46356,"_5":17394,"_23735":46236,"_2383":46357},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2856":1798,"_25078":1745,"_17499":46359,"_5":17394,"_23735":46240,"_2383":46360},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2856":1799,"_25078":1745,"_17499":46362,"_5":17394,"_23735":46244,"_2383":46363},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2856":1800,"_25078":1745,"_17499":46365,"_5":17394,"_23735":46244,"_2383":46366},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2856":1801,"_25078":1745,"_17499":46368,"_5":17394,"_23735":46248,"_2383":46369},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2856":1802,"_25078":1745,"_17499":46371,"_5":17394,"_23735":46248,"_2383":46372},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2856":1803,"_25078":1745,"_17499":46374,"_5":17394,"_23735":46248,"_2383":46375},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2856":1804,"_25078":1745,"_17499":46377,"_5":17394,"_23735":46248,"_2383":46378},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2856":1805,"_25078":1745,"_17499":46380,"_5":17394,"_23735":46252,"_2383":46381},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2856":1806,"_25078":1745,"_17499":46383,"_5":17394,"_23735":46252,"_2383":46384},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2856":1807,"_25078":1807,"_5":12261,"_2383":46386,"_25413":46387,"_17499":46389,"_23735":1807},"Certificate validation",[40749,42093,45771,46388],"Validation",[],{"_2856":1808,"_25078":1807,"_17499":46391,"_5":17394,"_23735":1807,"_2383":46392},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2856":1809,"_25078":1807,"_5":25410,"_17499":46394,"_23735":46395,"_2383":46396},[],"/docs/pr-preview/pr-40/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2856":1810,"_25078":1807,"_5":25410,"_17499":46398,"_23735":46399,"_2383":46400},[],"/docs/pr-preview/pr-40/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2856":1811,"_25078":1807,"_5":25410,"_17499":46402,"_23735":46403,"_2383":46404},[],"/docs/pr-preview/pr-40/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2856":1812,"_25078":1807,"_17499":46406,"_5":17394,"_23735":1807,"_2383":46407},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2856":1813,"_25078":1807,"_17499":46409,"_5":17394,"_23735":46395,"_2383":46410},[],"Verify these criteria together:",{"_2856":1814,"_25078":1807,"_17499":46412,"_5":17394,"_23735":46395,"_2383":45395},[],{"_2856":1815,"_25078":1807,"_17499":46414,"_5":17394,"_23735":46395,"_2383":46415},[],"Required result",{"_2856":1816,"_25078":1807,"_17499":46417,"_5":17394,"_23735":46395,"_2383":46418},[],"Chain and signature",{"_2856":1817,"_25078":1807,"_17499":46420,"_5":17394,"_23735":46395,"_2383":46421},[],"Valid chain to a root deliberately installed in the consumer.",{"_2856":1818,"_25078":1807,"_17499":46423,"_5":17394,"_23735":46395,"_2383":46424},[],"Dates",{"_2856":1819,"_25078":1807,"_17499":46426,"_5":17394,"_23735":46395,"_2383":46427},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2856":1820,"_25078":1807,"_17499":46429,"_5":17394,"_23735":46395,"_2383":41796},[],{"_2856":1821,"_25078":1807,"_17499":46431,"_5":17394,"_23735":46395,"_2383":46432},[],"Name, SAN or identifier matches the expected peer.",{"_2856":1822,"_25078":1807,"_17499":46434,"_5":17394,"_23735":46395,"_2383":41132},[],{"_2856":1823,"_25078":1807,"_17499":46436,"_5":17394,"_23735":46395,"_2383":46437},[],"KU, EKU and constraints permit the specific operation.",{"_2856":1824,"_25078":1807,"_17499":46439,"_5":17394,"_23735":46395,"_2383":46440},[],"Revocation",{"_2856":1825,"_25078":1807,"_17499":46442,"_5":17394,"_23735":46395,"_2383":46443},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2856":1826,"_25078":1807,"_17499":46445,"_5":17394,"_23735":46395,"_2383":46446},[],"Authorization",{"_2856":1827,"_25078":1807,"_17499":46448,"_5":17394,"_23735":46395,"_2383":46449},[],"The application permits that identity to perform the action.",{"_2856":1828,"_25078":1807,"_17499":46451,"_5":17394,"_23735":46395,"_2383":46452},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2856":1829,"_25078":1807,"_17499":46454,"_5":17394,"_23735":46399,"_2383":46455},[],"Mechanism",{"_2856":1830,"_25078":1807,"_17499":46457,"_5":17394,"_23735":46399,"_2383":46458},[],"When to use it",{"_2856":1831,"_25078":1807,"_17499":46460,"_5":17394,"_23735":46399,"_2383":46461},[],"What you must maintain",{"_2856":1832,"_25078":1807,"_17499":46463,"_5":17394,"_23735":46399,"_2383":46464},[],"OCSP",{"_2856":1833,"_25078":1807,"_17499":46466,"_5":17394,"_23735":46399,"_2383":46467},[],"Status query for a specific certificate.",{"_2856":1834,"_25078":1807,"_17499":46469,"_5":17394,"_23735":46399,"_2383":46470},[],"Responder access, signature verification and cache/freshness policy.",{"_2856":1835,"_25078":1807,"_17499":46472,"_5":17394,"_23735":46399,"_2383":46473},[],"CRL",{"_2856":1836,"_25078":1807,"_17499":46475,"_5":17394,"_23735":46399,"_2383":46476},[],"Local checks for many certificates or offline operation.",{"_2856":1837,"_25078":1807,"_17499":46478,"_5":17394,"_23735":46399,"_2383":46479},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2856":1838,"_25078":1807,"_17499":46481,"_5":17394,"_23735":46399,"_2383":46482},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2856":1839,"_25078":1807,"_17499":46484,"_5":17394,"_23735":46399,"_2383":46485},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2856":1840,"_25078":1807,"_17499":46487,"_5":17394,"_23735":46403,"_2383":46488},[],"Accept a current, authorized certificate with a known chain.",{"_2856":1841,"_25078":1807,"_17499":46490,"_5":17394,"_23735":46403,"_2383":46491},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2856":1842,"_25078":1807,"_17499":46493,"_5":17394,"_23735":46403,"_2383":46494},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2856":1843,"_25078":1807,"_17499":46496,"_5":17394,"_23735":46403,"_2383":46497},[],"Check that a new connection with that identity is rejected.",{"_2856":1844,"_25078":1807,"_17499":46499,"_5":17394,"_23735":46403,"_2383":46500},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2856":1845,"_25078":1807,"_17499":46502,"_5":17394,"_23735":46403,"_2383":46503},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2856":1846,"_25078":1807,"_17499":46505,"_5":17394,"_23735":46403,"_2383":46506},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2856":1847,"_25078":1807,"_17499":46508,"_5":17394,"_23735":46403,"_2383":46509},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":1848,"_25078":1807,"_17499":46511,"_5":17394,"_23735":46403,"_2383":46512},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2856":1849,"_25078":1849,"_5":12261,"_2383":46514,"_25413":46515,"_17499":46516,"_23735":1849},"Certificates",[40749,42093,45771,45772],[],{"_2856":1850,"_25078":1849,"_17499":46518,"_5":17394,"_23735":1849,"_2383":46519},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2856":1851,"_25078":1849,"_5":25410,"_17499":46521,"_23735":46522,"_2383":46523},[],"/docs/pr-preview/pr-40/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2856":1852,"_25078":1849,"_5":25410,"_17499":46525,"_23735":46526,"_2383":46527},[],"/docs/pr-preview/pr-40/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2856":1853,"_25078":1849,"_5":25410,"_17499":46529,"_23735":46530,"_2383":46531},[],"/docs/pr-preview/pr-40/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2856":1854,"_25078":1849,"_5":25410,"_17499":46533,"_23735":46534,"_2383":46535},[],"/docs/pr-preview/pr-40/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2856":1855,"_25078":1849,"_5":25410,"_17499":46537,"_23735":46538,"_2383":46539},[],"/docs/pr-preview/pr-40/platform/pki/certificates#open-the-action","Open the action",{"_2856":1856,"_25078":1849,"_5":25410,"_17499":46541,"_23735":46542,"_2383":46543},[],"/docs/pr-preview/pr-40/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2856":1857,"_25078":1849,"_5":25410,"_17499":46545,"_23735":46546,"_2383":46547},[],"/docs/pr-preview/pr-40/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2856":1858,"_25078":1849,"_5":25410,"_17499":46549,"_23735":46550,"_2383":46551},[],"/docs/pr-preview/pr-40/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2856":1859,"_25078":1849,"_5":25410,"_17499":46553,"_23735":46554,"_2383":46555},[],"/docs/pr-preview/pr-40/platform/pki/certificates#continue","Continue",{"_2856":1860,"_25078":1849,"_17499":46557,"_5":17394,"_23735":1849,"_2383":46558},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2856":1861,"_25078":1849,"_17499":46560,"_5":17394,"_23735":46522,"_2383":46561},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2856":1862,"_25078":1849,"_17499":46563,"_5":17394,"_23735":46522,"_2383":46564},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2856":1863,"_25078":1849,"_17499":46566,"_5":17394,"_23735":46526,"_2383":46567},[],"Download the PEM and inspect it:",{"_2856":1864,"_25078":1849,"_17499":46569,"_5":17394,"_23735":46526,"_2383":46570},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2856":1865,"_25078":1849,"_17499":46572,"_5":17394,"_23735":46530,"_2383":46573},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2856":1866,"_25078":1849,"_17499":46575,"_5":17394,"_23735":46530,"_2383":46576},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2856":1867,"_25078":1849,"_17499":46578,"_5":17394,"_23735":46530,"_2383":46579},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2856":1868,"_25078":1849,"_17499":46581,"_5":17394,"_23735":46530,"_2383":46582},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2856":1869,"_25078":1849,"_17499":46584,"_5":17394,"_23735":46530,"_2383":46585},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2856":1870,"_25078":1849,"_17499":46587,"_5":17394,"_23735":46530,"_2383":46588},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2856":1871,"_25078":1849,"_17499":46590,"_5":17394,"_23735":46530,"_2383":46591},[],"For browser key generation, follow Issue your first certificate.",{"_2856":1872,"_25078":1849,"_17499":46593,"_5":17394,"_23735":46534,"_2383":46594},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2856":1873,"_25078":1849,"_17499":46596,"_5":17394,"_23735":46538,"_2383":46597},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2856":1874,"_25078":1849,"_17499":46599,"_5":17394,"_23735":46542,"_2383":46600},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2856":1875,"_25078":1849,"_17499":46602,"_5":17394,"_23735":46546,"_2383":46603},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2856":1876,"_25078":1849,"_17499":46605,"_5":17394,"_23735":46546,"_2383":46606},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2856":1877,"_25078":1849,"_17499":46608,"_5":17394,"_23735":46546,"_2383":46609},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2856":1878,"_25078":1849,"_17499":46611,"_5":17394,"_23735":46550,"_2383":46612},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2856":1879,"_25078":1849,"_17499":46614,"_5":17394,"_23735":46550,"_2383":46615},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2856":1880,"_25078":1849,"_17499":46617,"_5":17394,"_23735":46550,"_2383":46618},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2856":1881,"_25078":1849,"_17499":46620,"_5":17394,"_23735":46554,"_2383":46621},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":1882,"_25078":1849,"_17499":46623,"_5":17394,"_23735":46554,"_2383":46624},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2856":1883,"_25078":1883,"_5":12261,"_2383":46626,"_25413":46627,"_17499":46629,"_23735":1883},"Certificate lifecycle",[40749,42093,45771,46628],"Concepts",[],{"_2856":1884,"_25078":1883,"_17499":46631,"_5":17394,"_23735":1883,"_2383":46632},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2856":1885,"_25078":1883,"_5":25410,"_17499":46634,"_23735":46635,"_2383":46636},[],"/docs/pr-preview/pr-40/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2856":1886,"_25078":1883,"_5":25410,"_17499":46638,"_23735":46639,"_2383":46640},[],"/docs/pr-preview/pr-40/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2856":1887,"_25078":1883,"_5":25410,"_17499":46642,"_23735":46643,"_2383":46644},[],"/docs/pr-preview/pr-40/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2856":1888,"_25078":1883,"_5":25410,"_17499":46646,"_23735":46647,"_2383":46648},[],"/docs/pr-preview/pr-40/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2856":1889,"_25078":1883,"_5":25410,"_17499":46650,"_23735":46651,"_2383":46652},[],"/docs/pr-preview/pr-40/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2856":1890,"_25078":1883,"_5":25410,"_17499":46654,"_23735":46655,"_2383":46656},[],"/docs/pr-preview/pr-40/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2856":1891,"_25078":1883,"_5":25410,"_17499":46658,"_23735":46659,"_2383":46660},[],"/docs/pr-preview/pr-40/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2856":1892,"_25078":1883,"_5":25410,"_17499":46662,"_23735":46663,"_2383":46664},[],"/docs/pr-preview/pr-40/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2856":1893,"_25078":1883,"_5":25410,"_17499":46666,"_23735":46667,"_2383":46668},[],"/docs/pr-preview/pr-40/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2856":1894,"_25078":1883,"_5":25410,"_17499":46670,"_23735":46671,"_2383":46672},[],"/docs/pr-preview/pr-40/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2856":1895,"_25078":1883,"_17499":46674,"_5":17394,"_23735":1883,"_2383":46675},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2856":1896,"_25078":1883,"_17499":46677,"_5":17394,"_23735":46639,"_2383":46678},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2856":1897,"_25078":1883,"_17499":46680,"_5":17394,"_23735":46643,"_2383":46681},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2856":1898,"_25078":1883,"_17499":46683,"_5":17394,"_23735":46647,"_2383":46684},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2856":1899,"_25078":1883,"_17499":46686,"_5":17394,"_23735":46651,"_2383":46687},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2856":1900,"_25078":1883,"_17499":46689,"_5":17394,"_23735":46655,"_2383":46690},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2856":1901,"_25078":1883,"_17499":46692,"_5":17394,"_23735":46659,"_2383":46693},[],"Lamassu persists four X.509 states:",{"_2856":1902,"_25078":1883,"_17499":46695,"_5":17394,"_23735":46659,"_2383":46696},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2856":1903,"_25078":1883,"_17499":46698,"_5":17394,"_23735":46659,"_2383":46699},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2856":1904,"_25078":1883,"_17499":46701,"_5":17394,"_23735":46659,"_2383":46702},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2856":1905,"_25078":1883,"_17499":46704,"_5":17394,"_23735":46659,"_2383":46705},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2856":1906,"_25078":1883,"_17499":46707,"_5":17394,"_23735":46659,"_2383":46708},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2856":1907,"_25078":1883,"_17499":46710,"_5":17394,"_23735":46663,"_2383":46711},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2856":1908,"_25078":1883,"_17499":46713,"_5":17394,"_23735":46663,"_2383":46714},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2856":1909,"_25078":1883,"_17499":46716,"_5":17394,"_23735":46663,"_2383":46717},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2856":1910,"_25078":1883,"_17499":46719,"_5":17394,"_23735":46667,"_2383":46720},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2856":1911,"_25078":1883,"_17499":46722,"_5":17394,"_23735":46667,"_2383":46723},[],"Before confirming:",{"_2856":1912,"_25078":1883,"_17499":46725,"_5":17394,"_23735":46667,"_2383":46726},[],"Identify DMSs, devices and services that trust that chain.",{"_2856":1913,"_25078":1883,"_17499":46728,"_5":17394,"_23735":46667,"_2383":46729},[],"Distribute the new chain of trust.",{"_2856":1914,"_25078":1883,"_17499":46731,"_5":17394,"_23735":46667,"_2383":46732},[],"Reissue the necessary identities.",{"_2856":1915,"_25078":1883,"_17499":46734,"_5":17394,"_23735":46667,"_2383":46735},[],"Check OCSP and CRL from a real consumer.",{"_2856":1916,"_25078":1883,"_17499":46737,"_5":17394,"_23735":46667,"_2383":46738},[],"Revoke the old CA once no legitimate traffic remains.",{"_2856":1917,"_25078":1883,"_17499":46740,"_5":17394,"_23735":46667,"_2383":46741},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2856":1918,"_25078":1883,"_17499":46743,"_5":17394,"_23735":46671,"_2383":46744},[],"Certificates entering the preventive or critical renewal window.",{"_2856":1919,"_25078":1883,"_17499":46746,"_5":17394,"_23735":46671,"_2383":46747},[],"Repeated enrollment or re-enrollment failures.",{"_2856":1920,"_25078":1883,"_17499":46749,"_5":17394,"_23735":46671,"_2383":46750},[],"Status changes and revocation reasons.",{"_2856":1921,"_25078":1883,"_17499":46752,"_5":17394,"_23735":46671,"_2383":46753},[],"OCSP and CRL publication and validity.",{"_2856":1922,"_25078":1883,"_17499":46755,"_5":17394,"_23735":46671,"_2383":46756},[],"Dependencies still presenting a replaced certificate.",{"_2856":1923,"_25078":1883,"_17499":46758,"_5":17394,"_23735":46671,"_2383":46759},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2856":1924,"_25078":1924,"_5":12261,"_2383":46761,"_25413":46762,"_17499":46763,"_23735":1924},"Trust model",[40749,42093,45771,46628],[],{"_2856":1925,"_25078":1924,"_17499":46765,"_5":17394,"_23735":1924,"_2383":46766},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2856":1926,"_25078":1924,"_5":25410,"_17499":46768,"_23735":46769,"_2383":46770},[],"/docs/pr-preview/pr-40/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2856":1927,"_25078":1924,"_5":25410,"_17499":46772,"_23735":46773,"_2383":46774},[],"/docs/pr-preview/pr-40/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2856":1928,"_25078":1924,"_5":25410,"_17499":46776,"_23735":46777,"_2383":46778},[],"/docs/pr-preview/pr-40/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2856":1929,"_25078":1924,"_5":25410,"_17499":46780,"_23735":46781,"_2383":46782},[],"/docs/pr-preview/pr-40/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2856":1930,"_25078":1924,"_5":25410,"_17499":46784,"_23735":46785,"_2383":46786},[],"/docs/pr-preview/pr-40/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2856":1931,"_25078":1924,"_5":25410,"_17499":46788,"_23735":46789,"_2383":46790},[],"/docs/pr-preview/pr-40/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2856":1932,"_25078":1924,"_5":25410,"_17499":46792,"_23735":46793,"_2383":46794},[],"/docs/pr-preview/pr-40/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2856":1933,"_25078":1924,"_5":25410,"_17499":46796,"_23735":46797,"_2383":46798},[],"/docs/pr-preview/pr-40/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2856":1934,"_25078":1924,"_5":25410,"_17499":46800,"_23735":46801,"_2383":46802},[],"/docs/pr-preview/pr-40/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2856":1935,"_25078":1924,"_5":25410,"_17499":46804,"_23735":46805,"_2383":46806},[],"/docs/pr-preview/pr-40/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2856":1936,"_25078":1924,"_17499":46808,"_5":17394,"_23735":1924,"_2383":46809},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2856":1937,"_25078":1924,"_17499":46811,"_5":17394,"_23735":46773,"_2383":46812},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2856":1938,"_25078":1924,"_17499":46814,"_5":17394,"_23735":46777,"_2383":46815},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2856":1939,"_25078":1924,"_17499":46817,"_5":17394,"_23735":46781,"_2383":46818},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2856":1940,"_25078":1924,"_17499":46820,"_5":17394,"_23735":46785,"_2383":46821},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2856":1941,"_25078":1924,"_17499":46823,"_5":17394,"_23735":46789,"_2383":46824},[],"The device proves it can enroll according to the DMS policy.",{"_2856":1942,"_25078":1924,"_17499":46826,"_5":17394,"_23735":46789,"_2383":46827},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2856":1943,"_25078":1924,"_17499":46829,"_5":17394,"_23735":46789,"_2383":46830},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2856":1944,"_25078":1924,"_17499":46832,"_5":17394,"_23735":46789,"_2383":46833},[],"The device installs the certificate and the chain it needs.",{"_2856":1945,"_25078":1924,"_17499":46835,"_5":17394,"_23735":46789,"_2383":46836},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2856":1946,"_25078":1924,"_17499":46838,"_5":17394,"_23735":46789,"_2383":46839},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2856":1947,"_25078":1924,"_17499":46841,"_5":17394,"_23735":46793,"_2383":46842},[],"A DMS relates three sets that are worth designing separately:",{"_2856":1948,"_25078":1924,"_17499":46844,"_5":17394,"_23735":46793,"_2383":46845},[],"**Enrollment CA:** signs the new identities.",{"_2856":1949,"_25078":1924,"_17499":46847,"_5":17394,"_23735":46793,"_2383":46848},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and the re-enrollment validation CAs are also accepted; those are optional.",{"_2856":1950,"_25078":1924,"_17499":46850,"_5":17394,"_23735":46793,"_2383":46851},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2856":1951,"_25078":1924,"_17499":46853,"_5":17394,"_23735":46793,"_2383":46854},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2856":1952,"_25078":1924,"_17499":46856,"_5":17394,"_23735":46797,"_2383":46857},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2856":1953,"_25078":1924,"_17499":46859,"_5":17394,"_23735":46797,"_2383":46860},[],"that the current date is between `Not Before` and `Not After`;",{"_2856":1954,"_25078":1924,"_17499":46862,"_5":17394,"_23735":46797,"_2383":46863},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2856":1955,"_25078":1924,"_17499":46865,"_5":17394,"_23735":46797,"_2383":46866},[],"that names, SANs and subject match the expected identity;",{"_2856":1956,"_25078":1924,"_17499":46868,"_5":17394,"_23735":46797,"_2383":46869},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2856":1957,"_25078":1924,"_17499":46871,"_5":17394,"_23735":46797,"_2383":46872},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2856":1958,"_25078":1924,"_17499":46874,"_5":17394,"_23735":46797,"_2383":46875},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2856":1959,"_25078":1924,"_17499":46877,"_5":17394,"_23735":46801,"_2383":46878},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2856":1960,"_25078":1924,"_17499":46880,"_5":17394,"_23735":46805,"_2383":46881},[],"Keep the root out of daily operations, or with very restricted access.",{"_2856":1961,"_25078":1924,"_17499":46883,"_5":17394,"_23735":46805,"_2383":46884},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2856":1962,"_25078":1924,"_17499":46886,"_5":17394,"_23735":46805,"_2383":46887},[],"Assign explicit profiles to every use case.",{"_2856":1963,"_25078":1924,"_17499":46889,"_5":17394,"_23735":46805,"_2383":46890},[],"Distribute the new trust before starting a rotation.",{"_2856":1964,"_25078":1924,"_17499":46892,"_5":17394,"_23735":46805,"_2383":46893},[],"Keep enough overlap to renew a disconnected fleet.",{"_2856":1965,"_25078":1924,"_17499":46895,"_5":17394,"_23735":46805,"_2383":46896},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2856":1966,"_25078":1924,"_17499":46898,"_5":17394,"_23735":46805,"_2383":46899},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2856":1967,"_25078":1967,"_5":12261,"_2383":46901,"_25413":46902,"_17499":46903,"_23735":1967},"Revocation lists (CRL)",[40749,42093,45771,46388],[],{"_2856":1968,"_25078":1967,"_17499":46905,"_5":17394,"_23735":1967,"_2383":46906},[],"Generate and distribute signed lists to validate certificates offline.",{"_2856":1969,"_25078":1967,"_5":25410,"_17499":46908,"_23735":46909,"_2383":46910},[],"/docs/pr-preview/pr-40/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2856":1970,"_25078":1967,"_5":25410,"_17499":46912,"_23735":46913,"_2383":46914},[],"/docs/pr-preview/pr-40/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2856":1971,"_25078":1967,"_5":25410,"_17499":46916,"_23735":46917,"_2383":46918},[],"/docs/pr-preview/pr-40/platform/pki/crl#crl-contents","CRL contents",{"_2856":1972,"_25078":1967,"_5":25410,"_17499":46920,"_23735":46921,"_2383":46922},[],"/docs/pr-preview/pr-40/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2856":1973,"_25078":1967,"_5":25410,"_17499":46924,"_23735":46925,"_2383":46926},[],"/docs/pr-preview/pr-40/platform/pki/crl#va-role-management-api","VA role management API",{"_2856":1974,"_25078":1967,"_5":25410,"_17499":46928,"_23735":46929,"_2383":46930},[],"/docs/pr-preview/pr-40/platform/pki/crl#from-the-interface","From the interface",{"_2856":1975,"_25078":1967,"_5":25410,"_17499":46932,"_23735":46933,"_2383":46934},[],"/docs/pr-preview/pr-40/platform/pki/crl#references","References",{"_2856":1976,"_25078":1967,"_17499":46936,"_5":17394,"_23735":1967,"_2383":46937},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2856":1977,"_25078":1967,"_17499":46939,"_5":17394,"_23735":46909,"_2383":46940},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2856":1978,"_25078":1967,"_17499":46942,"_5":17394,"_23735":46909,"_2383":46943},[],"`crl_options` field",{"_2856":1979,"_25078":1967,"_17499":46945,"_5":17394,"_23735":46909,"_2383":41132},[],{"_2856":1980,"_25078":1967,"_17499":46947,"_5":17394,"_23735":46909,"_2383":46948},[],"Backend initial value",{"_2856":1981,"_25078":1967,"_17499":46950,"_5":17394,"_23735":46909,"_2383":46951},[],"`validity`",{"_2856":1982,"_25078":1967,"_17499":46953,"_5":17394,"_23735":46909,"_2383":46954},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2856":1983,"_25078":1967,"_17499":46956,"_5":17394,"_23735":46909,"_2383":46957},[],"7 days.",{"_2856":1984,"_25078":1967,"_17499":46959,"_5":17394,"_23735":46909,"_2383":46960},[],"`refresh_interval`",{"_2856":1985,"_25078":1967,"_17499":46962,"_5":17394,"_23735":46909,"_2383":46963},[],"Time since publication that triggers scheduled renewal.",{"_2856":1986,"_25078":1967,"_17499":46965,"_5":17394,"_23735":46909,"_2383":46966},[],"6 days and 23 hours.",{"_2856":1987,"_25078":1967,"_17499":46968,"_5":17394,"_23735":46909,"_2383":46969},[],"`regenerate_on_revoke`",{"_2856":1988,"_25078":1967,"_17499":46971,"_5":17394,"_23735":46909,"_2383":46972},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2856":1989,"_25078":1967,"_17499":46974,"_5":17394,"_23735":46909,"_2383":46975},[],"`true`.",{"_2856":1990,"_25078":1967,"_17499":46977,"_5":17394,"_23735":46909,"_2383":46978},[],"`subject_key_id_signer`",{"_2856":1991,"_25078":1967,"_17499":46980,"_5":17394,"_23735":46909,"_2383":46981},[],"Configuration field initialized with the CA’s SKI.",{"_2856":1992,"_25078":1967,"_17499":46983,"_5":17394,"_23735":46909,"_2383":46984},[],"CA SKI.",{"_2856":1993,"_25078":1967,"_17499":46986,"_5":17394,"_23735":46909,"_2383":46987},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2856":1994,"_25078":1967,"_17499":46989,"_5":17394,"_23735":46909,"_2383":46990},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2856":1995,"_25078":1967,"_17499":46992,"_5":17394,"_23735":46913,"_2383":46993},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2856":1996,"_25078":1967,"_17499":46995,"_5":17394,"_23735":46913,"_2383":46996},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2856":1997,"_25078":1967,"_17499":46998,"_5":17394,"_23735":46913,"_2383":46999},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2856":1998,"_25078":1967,"_17499":47001,"_5":17394,"_23735":46917,"_2383":47002},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2856":1999,"_25078":1967,"_17499":47004,"_5":17394,"_23735":46917,"_2383":47005},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2856":2000,"_25078":1967,"_17499":47007,"_5":17394,"_23735":46921,"_2383":47008},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2856":2001,"_25078":1967,"_17499":47010,"_5":17394,"_23735":46921,"_2383":47011},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2856":2002,"_25078":1967,"_17499":47013,"_5":17394,"_23735":46921,"_2383":47014},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2856":2003,"_25078":1967,"_17499":47016,"_5":17394,"_23735":46921,"_2383":47017},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2856":2004,"_25078":1967,"_17499":47019,"_5":17394,"_23735":46921,"_2383":47020},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2856":2005,"_25078":1967,"_17499":47022,"_5":17394,"_23735":46925,"_2383":47023},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2856":2006,"_25078":1967,"_17499":47025,"_5":17394,"_23735":46925,"_2383":43814},[],{"_2856":2007,"_25078":1967,"_17499":47027,"_5":17394,"_23735":46925,"_2383":47028},[],"Relative path",{"_2856":2008,"_25078":1967,"_17499":47030,"_5":17394,"_23735":46925,"_2383":43811},[],{"_2856":2009,"_25078":1967,"_17499":47032,"_5":17394,"_23735":46925,"_2383":47033},[],"`GET`",{"_2856":2010,"_25078":1967,"_17499":47035,"_5":17394,"_23735":46925,"_2383":47036},[],"`/v1/roles/{ca-ski}`",{"_2856":2011,"_25078":1967,"_17499":47038,"_5":17394,"_23735":46925,"_2383":47039},[],"Read `crl_options` and `latest_crl`.",{"_2856":2012,"_25078":1967,"_17499":47041,"_5":17394,"_23735":46925,"_2383":47042},[],"`PUT`",{"_2856":2013,"_25078":1967,"_17499":47044,"_5":17394,"_23735":46925,"_2383":47036},[],{"_2856":2014,"_25078":1967,"_17499":47046,"_5":17394,"_23735":46925,"_2383":47047},[],"Replace CRL configuration.",{"_2856":2015,"_25078":1967,"_17499":47049,"_5":17394,"_23735":46925,"_2383":47050},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2856":2016,"_25078":1967,"_17499":47052,"_5":17394,"_23735":46925,"_2383":47053},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2856":2017,"_25078":1967,"_17499":47055,"_5":17394,"_23735":46929,"_2383":47056},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2856":2018,"_25078":1967,"_17499":47058,"_5":17394,"_23735":46933,"_2383":47059},[],"RFC 5280: X.509 and CRL profile.",{"_2856":2019,"_25078":1967,"_17499":47061,"_5":17394,"_23735":46933,"_2383":47062},[],"OpenSSL: openssl-crl.",{"_2856":2020,"_25078":1967,"_17499":47064,"_5":17394,"_23735":46933,"_2383":47065},[],"OpenSSL: openssl-verify.",{"_2856":2021,"_25078":1967,"_17499":47067,"_5":17394,"_23735":46933,"_2383":47068},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2856":2022,"_25078":1967,"_17499":47070,"_5":17394,"_23735":46933,"_2383":47071},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2856":2023,"_25078":2023,"_5":12261,"_2383":47073,"_25413":47074,"_17499":47075,"_23735":2023},"Keys and cryptographic engines",[40749,42093,45771,45772],[],{"_2856":2024,"_25078":2023,"_17499":47077,"_5":17394,"_23735":2023,"_2383":47078},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2856":2025,"_25078":2023,"_5":25410,"_17499":47080,"_23735":47081,"_2383":47082},[],"/docs/pr-preview/pr-40/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2856":2026,"_25078":2023,"_5":25410,"_17499":47084,"_23735":47085,"_2383":47086},[],"/docs/pr-preview/pr-40/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2856":2027,"_25078":2023,"_5":25410,"_17499":47088,"_23735":47089,"_2383":47090},[],"/docs/pr-preview/pr-40/platform/pki/key-management#file-system","File System",{"_2856":2028,"_25078":2023,"_5":25410,"_17499":47092,"_23735":47093,"_2383":47094},[],"/docs/pr-preview/pr-40/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2856":2029,"_25078":2023,"_5":25410,"_17499":47096,"_23735":47097,"_2383":47098},[],"/docs/pr-preview/pr-40/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2856":2030,"_25078":2023,"_5":25410,"_17499":47100,"_23735":47101,"_2383":47102},[],"/docs/pr-preview/pr-40/platform/pki/key-management#aws-kms","AWS KMS",{"_2856":2031,"_25078":2023,"_5":25410,"_17499":47104,"_23735":47105,"_2383":47106},[],"/docs/pr-preview/pr-40/platform/pki/key-management#pkcs11","PKCS#11",{"_2856":2032,"_25078":2023,"_5":25410,"_17499":47108,"_23735":47109,"_2383":47110},[],"/docs/pr-preview/pr-40/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2856":2033,"_25078":2023,"_5":25410,"_17499":47112,"_23735":47113,"_2383":47114},[],"/docs/pr-preview/pr-40/platform/pki/key-management#key-inventory","Key inventory",{"_2856":2034,"_25078":2023,"_5":25410,"_17499":47116,"_23735":47117,"_2383":47118},[],"/docs/pr-preview/pr-40/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2856":2035,"_25078":2023,"_5":25410,"_17499":47120,"_23735":47121,"_2383":47122},[],"/docs/pr-preview/pr-40/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2856":2036,"_25078":2023,"_5":25410,"_17499":47124,"_23735":47125,"_2383":47126},[],"/docs/pr-preview/pr-40/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2856":2037,"_25078":2023,"_5":25410,"_17499":47128,"_23735":47129,"_2383":47130},[],"/docs/pr-preview/pr-40/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2856":2038,"_25078":2023,"_5":25410,"_17499":47132,"_23735":47133,"_2383":47134},[],"/docs/pr-preview/pr-40/platform/pki/key-management#view-details","View details",{"_2856":2039,"_25078":2023,"_5":25410,"_17499":47136,"_23735":47137,"_2383":47138},[],"/docs/pr-preview/pr-40/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2856":2040,"_25078":2023,"_5":25410,"_17499":47140,"_23735":47141,"_2383":47142},[],"/docs/pr-preview/pr-40/platform/pki/key-management#sign","Sign",{"_2856":2041,"_25078":2023,"_5":25410,"_17499":47144,"_23735":47145,"_2383":47146},[],"/docs/pr-preview/pr-40/platform/pki/key-management#verify","Verify",{"_2856":2042,"_25078":2023,"_5":25410,"_17499":47148,"_23735":47149,"_2383":47150},[],"/docs/pr-preview/pr-40/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2856":2043,"_25078":2023,"_5":25410,"_17499":47152,"_23735":47153,"_2383":47154},[],"/docs/pr-preview/pr-40/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2856":2044,"_25078":2023,"_5":25410,"_17499":47156,"_23735":47157,"_2383":47158},[],"/docs/pr-preview/pr-40/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2856":2045,"_25078":2023,"_17499":47160,"_5":17394,"_23735":2023,"_2383":47161},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2856":2046,"_25078":2023,"_17499":47163,"_5":17394,"_23735":2023,"_2383":47164},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2856":2047,"_25078":2023,"_17499":47166,"_5":17394,"_23735":47081,"_2383":47167},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2856":2048,"_25078":2023,"_17499":47169,"_5":17394,"_23735":47081,"_2383":47170},[],"In practice, it lets you:",{"_2856":2049,"_25078":2023,"_17499":47172,"_5":17394,"_23735":47081,"_2383":47173},[],"Generate new key pairs from Lamassu IoT.",{"_2856":2050,"_25078":2023,"_17499":47175,"_5":17394,"_23735":47081,"_2383":47176},[],"Import keys created externally.",{"_2856":2051,"_25078":2023,"_17499":47178,"_5":17394,"_23735":47081,"_2383":47179},[],"Delegate custody and cryptographic operations to external engines.",{"_2856":2052,"_25078":2023,"_17499":47181,"_5":17394,"_23735":47081,"_2383":47182},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2856":2053,"_25078":2023,"_17499":47184,"_5":17394,"_23735":47085,"_2383":47185},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2856":2054,"_25078":2023,"_17499":47187,"_5":17394,"_23735":47085,"_2383":47188},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2856":2055,"_25078":2023,"_17499":47190,"_5":17394,"_23735":47085,"_2383":47191},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2856":2056,"_25078":2023,"_17499":47193,"_5":17394,"_23735":47089,"_2383":47194},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2856":2057,"_25078":2023,"_17499":47196,"_5":17394,"_23735":47093,"_2383":47197},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2856":2058,"_25078":2023,"_17499":47199,"_5":17394,"_23735":47097,"_2383":47200},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2856":2059,"_25078":2023,"_17499":47202,"_5":17394,"_23735":47101,"_2383":47203},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2856":2060,"_25078":2023,"_17499":47205,"_5":17394,"_23735":47105,"_2383":47206},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2856":2061,"_25078":2023,"_17499":47208,"_5":17394,"_23735":47109,"_2383":47209},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2856":2062,"_25078":2023,"_17499":47211,"_5":17394,"_23735":47109,"_2383":47212},[],"Lamassu shows the enabled engines in the console.",{"_2856":2063,"_25078":2023,"_17499":47214,"_5":17394,"_23735":47109,"_2383":47215},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2856":2064,"_25078":2023,"_17499":47217,"_5":17394,"_23735":47109,"_2383":47218},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2856":2065,"_25078":2023,"_17499":47220,"_5":17394,"_23735":47113,"_2383":47221},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2856":2066,"_25078":2023,"_17499":47223,"_5":17394,"_23735":47113,"_2383":47224},[],"The table includes the following fields:",{"_2856":2067,"_25078":2023,"_17499":47226,"_5":17394,"_23735":47113,"_2383":47227},[],"**Name**: descriptive name of the key.",{"_2856":2068,"_25078":2023,"_17499":47229,"_5":17394,"_23735":47113,"_2383":47230},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2856":2069,"_25078":2023,"_17499":47232,"_5":17394,"_23735":47113,"_2383":47233},[],"**Strength**: visual indicator of cryptographic strength.",{"_2856":2070,"_25078":2023,"_17499":47235,"_5":17394,"_23735":47113,"_2383":47236},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2856":2071,"_25078":2023,"_17499":47238,"_5":17394,"_23735":47113,"_2383":47239},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2856":2072,"_25078":2023,"_17499":47241,"_5":17394,"_23735":47113,"_2383":47242},[],"**Aliases**: alternative names associated with the key.",{"_2856":2073,"_25078":2023,"_17499":47244,"_5":17394,"_23735":47113,"_2383":47245},[],"**Tags**: labels for classification and search.",{"_2856":2074,"_25078":2023,"_17499":47247,"_5":17394,"_23735":47113,"_2383":47248},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2856":2075,"_25078":2023,"_17499":47250,"_5":17394,"_23735":47113,"_2383":47251},[],"From this view you also reach the most common actions:",{"_2856":2076,"_25078":2023,"_17499":47253,"_5":17394,"_23735":47113,"_2383":47254},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2856":2077,"_25078":2023,"_17499":47256,"_5":17394,"_23735":47113,"_2383":47257},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2856":2078,"_25078":2023,"_17499":47259,"_5":17394,"_23735":47113,"_2383":47260},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2856":2079,"_25078":2023,"_17499":47262,"_5":17394,"_23735":47113,"_2383":47263},[],"**Delete Key** to remove the key from the system.",{"_2856":2080,"_25078":2023,"_17499":47265,"_5":17394,"_23735":47117,"_2383":47266},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2856":2081,"_25078":2023,"_17499":47268,"_5":17394,"_23735":47121,"_2383":47269},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2856":2082,"_25078":2023,"_17499":47271,"_5":17394,"_23735":47121,"_2383":47272},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2856":2083,"_25078":2023,"_17499":47274,"_5":17394,"_23735":47121,"_2383":47275},[],"**Key Name**: unique and descriptive name.",{"_2856":2084,"_25078":2023,"_17499":47277,"_5":17394,"_23735":47121,"_2383":47278},[],"**Crypto Engine**: engine that will keep the key.",{"_2856":2085,"_25078":2023,"_17499":47280,"_5":17394,"_23735":47121,"_2383":47281},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2856":2086,"_25078":2023,"_17499":47283,"_5":17394,"_23735":47121,"_2383":47284},[],"**Tags**: metadata to classify the key.",{"_2856":2087,"_25078":2023,"_17499":47286,"_5":17394,"_23735":47121,"_2383":47287},[],"**Metadata**: additional information for advanced uses.",{"_2856":2088,"_25078":2023,"_17499":47289,"_5":17394,"_23735":47125,"_2383":47290},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2856":2089,"_25078":2023,"_17499":47292,"_5":17394,"_23735":47125,"_2383":47293},[],"When you have an exportable private key and the destination engine supports import.",{"_2856":2090,"_25078":2023,"_17499":47295,"_5":17394,"_23735":47125,"_2383":47296},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2856":2091,"_25078":2023,"_17499":47298,"_5":17394,"_23735":47125,"_2383":47299},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2856":2092,"_25078":2023,"_17499":47301,"_5":17394,"_23735":47125,"_2383":47302},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2856":2093,"_25078":2023,"_17499":47304,"_5":17394,"_23735":47125,"_2383":47305},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2856":2094,"_25078":2023,"_17499":47307,"_5":17394,"_23735":47125,"_2383":47308},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2856":2095,"_25078":2023,"_17499":47310,"_5":17394,"_23735":47125,"_2383":47311},[],"**Tags**: labels for organization and search.",{"_2856":2096,"_25078":2023,"_17499":47313,"_5":17394,"_23735":47125,"_2383":47314},[],"**Metadata**: additional optional information.",{"_2856":2097,"_25078":2023,"_17499":47316,"_5":17394,"_23735":47125,"_2383":47317},[],"**Private Key (PEM)**: private key in PEM format.",{"_2856":2098,"_25078":2023,"_17499":47319,"_5":17394,"_23735":47125,"_2383":47320},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2856":2099,"_25078":2023,"_17499":47322,"_5":17394,"_23735":47129,"_2383":47323},[],"Each registered key has a detail view and several operational actions.",{"_2856":2100,"_25078":2023,"_17499":47325,"_5":17394,"_23735":47133,"_2383":47326},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2856":2101,"_25078":2023,"_17499":47328,"_5":17394,"_23735":47133,"_2383":47329},[],"The **Overview** tab shows, among others, these fields:",{"_2856":2102,"_25078":2023,"_17499":47331,"_5":17394,"_23735":47133,"_2383":47332},[],"**Key Name**: descriptive name.",{"_2856":2103,"_25078":2023,"_17499":47334,"_5":17394,"_23735":47133,"_2383":47335},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2856":2104,"_25078":2023,"_17499":47337,"_5":17394,"_23735":47133,"_2383":47338},[],"**Tags**: associated labels.",{"_2856":2105,"_25078":2023,"_17499":47340,"_5":17394,"_23735":47133,"_2383":47341},[],"**Aliases**: alternative names.",{"_2856":2106,"_25078":2023,"_17499":47343,"_5":17394,"_23735":47133,"_2383":47344},[],"**Crypto Engine**: engine where the key resides.",{"_2856":2107,"_25078":2023,"_17499":47346,"_5":17394,"_23735":47133,"_2383":47347},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2856":2108,"_25078":2023,"_17499":47349,"_5":17394,"_23735":47133,"_2383":47350},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2856":2109,"_25078":2023,"_17499":47352,"_5":17394,"_23735":47133,"_2383":47353},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2856":2110,"_25078":2023,"_17499":47355,"_5":17394,"_23735":47137,"_2383":47356},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2856":2111,"_25078":2023,"_17499":47358,"_5":17394,"_23735":47137,"_2383":47359},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2856":2112,"_25078":2023,"_17499":47361,"_5":17394,"_23735":47137,"_2383":47362},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2856":2113,"_25078":2023,"_17499":47364,"_5":17394,"_23735":47141,"_2383":47365},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2856":2114,"_25078":2023,"_17499":47367,"_5":17394,"_23735":47141,"_2383":47368},[],"Main fields:",{"_2856":2115,"_25078":2023,"_17499":47370,"_5":17394,"_23735":47141,"_2383":47371},[],"**Algorithm**: signing algorithm available for the key type.",{"_2856":2116,"_25078":2023,"_17499":47373,"_5":17394,"_23735":47141,"_2383":47374},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2856":2117,"_25078":2023,"_17499":47376,"_5":17394,"_23735":47141,"_2383":47377},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2856":2118,"_25078":2023,"_17499":47379,"_5":17394,"_23735":47141,"_2383":47380},[],"**Message**: content to sign.",{"_2856":2119,"_25078":2023,"_17499":47382,"_5":17394,"_23735":47141,"_2383":47383},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2856":2120,"_25078":2023,"_17499":47385,"_5":17394,"_23735":47145,"_2383":47386},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2856":2121,"_25078":2023,"_17499":47388,"_5":17394,"_23735":47145,"_2383":47368},[],{"_2856":2122,"_25078":2023,"_17499":47390,"_5":17394,"_23735":47145,"_2383":47391},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2856":2123,"_25078":2023,"_17499":47393,"_5":17394,"_23735":47145,"_2383":47394},[],"**Message Type**: `Raw` or `Digest`.",{"_2856":2124,"_25078":2023,"_17499":47396,"_5":17394,"_23735":47145,"_2383":47397},[],"**Payload Encoding**: encoding of the message.",{"_2856":2125,"_25078":2023,"_17499":47399,"_5":17394,"_23735":47145,"_2383":47400},[],"**Message**: original message or hash.",{"_2856":2126,"_25078":2023,"_17499":47402,"_5":17394,"_23735":47145,"_2383":47403},[],"**Signature**: signature to check.",{"_2856":2127,"_25078":2023,"_17499":47405,"_5":17394,"_23735":47145,"_2383":47406},[],"**Result**: indicator of the validation result.",{"_2856":2128,"_25078":2023,"_17499":47408,"_5":17394,"_23735":47149,"_2383":47409},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2856":2129,"_25078":2023,"_17499":47411,"_5":17394,"_23735":47149,"_2383":47412},[],"This flow is useful for:",{"_2856":2130,"_25078":2023,"_17499":47414,"_5":17394,"_23735":47149,"_2383":47415},[],"Requesting certificates from an external CA.",{"_2856":2131,"_25078":2023,"_17499":47417,"_5":17394,"_23735":47149,"_2383":47418},[],"Renewing an identity while keeping the same key.",{"_2856":2132,"_25078":2023,"_17499":47420,"_5":17394,"_23735":47149,"_2383":47421},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2856":2133,"_25078":2023,"_17499":47423,"_5":17394,"_23735":47149,"_2383":47424},[],"**Common Name (CN)**: main name of the identity.",{"_2856":2134,"_25078":2023,"_17499":47426,"_5":17394,"_23735":47149,"_2383":47427},[],"**Organization (O)**: organization or company.",{"_2856":2135,"_25078":2023,"_17499":47429,"_5":17394,"_23735":47149,"_2383":47430},[],"**Organizational Unit (OU)**: department or unit.",{"_2856":2136,"_25078":2023,"_17499":47432,"_5":17394,"_23735":47149,"_2383":47433},[],"**Country (C)**: two-letter country code.",{"_2856":2137,"_25078":2023,"_17499":47435,"_5":17394,"_23735":47149,"_2383":47436},[],"**State / Province (ST)**: state or province.",{"_2856":2138,"_25078":2023,"_17499":47438,"_5":17394,"_23735":47149,"_2383":47439},[],"**Locality (L)**: city or locality.",{"_2856":2139,"_25078":2023,"_17499":47441,"_5":17394,"_23735":47149,"_2383":47442},[],"**Email Address**: contact email.",{"_2856":2140,"_25078":2023,"_17499":47444,"_5":17394,"_23735":47149,"_2383":47445},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2856":2141,"_25078":2023,"_17499":47447,"_5":17394,"_23735":47149,"_2383":47448},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2856":2142,"_25078":2023,"_17499":47450,"_5":17394,"_23735":47153,"_2383":47451},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2856":2143,"_25078":2023,"_17499":47453,"_5":17394,"_23735":47153,"_2383":47454},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2856":2144,"_25078":2023,"_17499":47456,"_5":17394,"_23735":47157,"_2383":47457},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2856":2145,"_25078":2145,"_5":12261,"_2383":47459,"_25413":47460,"_17499":47461,"_23735":2145},"Online validation with OCSP",[40749,42093,45771,46388],[],{"_2856":2146,"_25078":2145,"_17499":47463,"_5":17394,"_23735":2145,"_2383":47464},[],"Query signed status and verify the responder’s response.",{"_2856":2147,"_25078":2145,"_5":25410,"_17499":47466,"_23735":47467,"_2383":47468},[],"/docs/pr-preview/pr-40/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2856":2148,"_25078":2145,"_5":25410,"_17499":47470,"_23735":47471,"_2383":47472},[],"/docs/pr-preview/pr-40/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2856":2149,"_25078":2145,"_5":25410,"_17499":47474,"_23735":47475,"_2383":47476},[],"/docs/pr-preview/pr-40/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2856":2150,"_25078":2145,"_5":25410,"_17499":47478,"_23735":47479,"_2383":47480},[],"/docs/pr-preview/pr-40/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2856":2151,"_25078":2145,"_5":25410,"_17499":47482,"_23735":47483,"_2383":47484},[],"/docs/pr-preview/pr-40/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2856":2152,"_25078":2145,"_5":25410,"_17499":47486,"_23735":47487,"_2383":46934},[],"/docs/pr-preview/pr-40/platform/pki/ocsp#references",{"_2856":2153,"_25078":2145,"_17499":47489,"_5":17394,"_23735":2145,"_2383":47490},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2856":2154,"_25078":2145,"_17499":47492,"_5":17394,"_23735":47467,"_2383":47493},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2856":2155,"_25078":2145,"_17499":47495,"_5":17394,"_23735":47467,"_2383":47496},[],"Record status",{"_2856":2156,"_25078":2145,"_17499":47498,"_5":17394,"_23735":47467,"_2383":47499},[],"Signed response",{"_2856":2157,"_25078":2145,"_17499":47501,"_5":17394,"_23735":47467,"_2383":44949},[],{"_2856":2158,"_25078":2145,"_17499":47503,"_5":17394,"_23735":47467,"_2383":47504},[],"`Good`.",{"_2856":2159,"_25078":2145,"_17499":47506,"_5":17394,"_23735":47467,"_2383":44966},[],{"_2856":2160,"_25078":2145,"_17499":47508,"_5":17394,"_23735":47467,"_2383":47509},[],"`Revoked`, with revocation reason and timestamp.",{"_2856":2161,"_25078":2145,"_17499":47511,"_5":17394,"_23735":47467,"_2383":47512},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2856":2162,"_25078":2145,"_17499":47514,"_5":17394,"_23735":47467,"_2383":47515},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2856":2163,"_25078":2145,"_17499":47517,"_5":17394,"_23735":47467,"_2383":47518},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2856":2164,"_25078":2145,"_17499":47520,"_5":17394,"_23735":47467,"_2383":47521},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2856":2165,"_25078":2145,"_17499":47523,"_5":17394,"_23735":47467,"_2383":47524},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2856":2166,"_25078":2145,"_17499":47526,"_5":17394,"_23735":47471,"_2383":47527},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2856":2167,"_25078":2145,"_17499":47529,"_5":17394,"_23735":47471,"_2383":47530},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2856":2168,"_25078":2145,"_17499":47532,"_5":17394,"_23735":47475,"_2383":47533},[],"The service accepts:",{"_2856":2169,"_25078":2145,"_17499":47535,"_5":17394,"_23735":47475,"_2383":43814},[],{"_2856":2170,"_25078":2145,"_17499":47537,"_5":17394,"_23735":47475,"_2383":47538},[],"VA service path",{"_2856":2171,"_25078":2145,"_17499":47540,"_5":17394,"_23735":47475,"_2383":47541},[],"Format",{"_2856":2172,"_25078":2145,"_17499":47543,"_5":17394,"_23735":47475,"_2383":47544},[],"`POST`",{"_2856":2173,"_25078":2145,"_17499":47546,"_5":17394,"_23735":47475,"_2383":47547},[],"`/ocsp`",{"_2856":2174,"_25078":2145,"_17499":47549,"_5":17394,"_23735":47475,"_2383":47550},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2856":2175,"_25078":2145,"_17499":47552,"_5":17394,"_23735":47475,"_2383":47033},[],{"_2856":2176,"_25078":2145,"_17499":47554,"_5":17394,"_23735":47475,"_2383":47555},[],"`/ocsp/{ocsp_request}`",{"_2856":2177,"_25078":2145,"_17499":47557,"_5":17394,"_23735":47475,"_2383":47558},[],"DER request encoded using padded URL Base64.",{"_2856":2178,"_25078":2145,"_17499":47560,"_5":17394,"_23735":47475,"_2383":47561},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2856":2179,"_25078":2145,"_17499":47563,"_5":17394,"_23735":47479,"_2383":47564},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2856":2180,"_25078":2145,"_17499":47566,"_5":17394,"_23735":47479,"_2383":47567},[],"Generate the request:",{"_2856":2181,"_25078":2145,"_17499":47569,"_5":17394,"_23735":47479,"_2383":47570},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2856":2182,"_25078":2145,"_17499":47572,"_5":17394,"_23735":47479,"_2383":47573},[],"Replace the example URL with the inspected endpoint:",{"_2856":2183,"_25078":2145,"_17499":47575,"_5":17394,"_23735":47479,"_2383":47576},[],"Verify the returned DER:",{"_2856":2184,"_25078":2145,"_17499":47578,"_5":17394,"_23735":47479,"_2383":47579},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2856":2185,"_25078":2145,"_17499":47581,"_5":17394,"_23735":47483,"_2383":47582},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2856":2186,"_25078":2145,"_17499":47584,"_5":17394,"_23735":47483,"_2383":47585},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2856":2187,"_25078":2145,"_17499":47587,"_5":17394,"_23735":47487,"_2383":47588},[],"RFC 6960: OCSP.",{"_2856":2188,"_25078":2145,"_17499":47590,"_5":17394,"_23735":47487,"_2383":47591},[],"OpenSSL: openssl-ocsp.",{"_2856":2189,"_25078":2145,"_17499":47593,"_5":17394,"_23735":47487,"_2383":47594},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2856":2190,"_25078":2145,"_17499":47596,"_5":17394,"_23735":47487,"_2383":47071},[],{"_2856":2191,"_25078":2191,"_5":12261,"_2383":45771,"_25413":47598,"_17499":47599,"_23735":2191},[40749,42093,45771],[],{"_2856":2192,"_25078":2191,"_17499":47601,"_5":17394,"_23735":2191,"_2383":47602},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2856":2193,"_25078":2191,"_5":25410,"_17499":47604,"_23735":47605,"_2383":45081},[],"/docs/pr-preview/pr-40/platform/pki/overview#start-here",{"_2856":2194,"_25078":2191,"_5":25410,"_17499":47607,"_23735":47608,"_2383":47609},[],"/docs/pr-preview/pr-40/platform/pki/overview#what-you-need","What you need",{"_2856":2195,"_25078":2191,"_5":25410,"_17499":47611,"_23735":47612,"_2383":45615},[],"/docs/pr-preview/pr-40/platform/pki/overview#core-capabilities",{"_2856":2196,"_25078":2191,"_5":25410,"_17499":47614,"_23735":47615,"_2383":45619},[],"/docs/pr-preview/pr-40/platform/pki/overview#build-your-trust-hierarchy",{"_2856":2197,"_25078":2191,"_5":25410,"_17499":47617,"_23735":47618,"_2383":45623},[],"/docs/pr-preview/pr-40/platform/pki/overview#protect-cryptographic-keys",{"_2856":2198,"_25078":2191,"_5":25410,"_17499":47620,"_23735":47621,"_2383":45627},[],"/docs/pr-preview/pr-40/platform/pki/overview#issue-and-control-certificates",{"_2856":2199,"_25078":2191,"_5":25410,"_17499":47623,"_23735":47624,"_2383":45635},[],"/docs/pr-preview/pr-40/platform/pki/overview#publish-validation-status",{"_2856":2200,"_25078":2191,"_5":25410,"_17499":47626,"_23735":47627,"_2383":47628},[],"/docs/pr-preview/pr-40/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2856":2201,"_25078":2191,"_5":25410,"_17499":47630,"_23735":47631,"_2383":46555},[],"/docs/pr-preview/pr-40/platform/pki/overview#continue",{"_2856":2202,"_25078":2191,"_17499":47633,"_5":17394,"_23735":2191,"_2383":47634},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2856":2203,"_25078":2191,"_17499":47636,"_5":17394,"_23735":47605,"_2383":47637},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2856":2204,"_25078":2191,"_17499":47639,"_5":17394,"_23735":47605,"_2383":47640},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2856":2205,"_25078":2191,"_17499":47642,"_5":17394,"_23735":47608,"_2383":47643},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2856":2206,"_25078":2191,"_17499":47645,"_5":17394,"_23735":47608,"_2383":47646},[],"An available cryptographic engine to keep the authority's key.",{"_2856":2207,"_25078":2191,"_17499":47648,"_5":17394,"_23735":47608,"_2383":47649},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2856":2208,"_25078":2191,"_17499":47651,"_5":17394,"_23735":47608,"_2383":47652},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2856":2209,"_25078":2191,"_17499":47654,"_5":17394,"_23735":47608,"_2383":47655},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2856":2210,"_25078":2191,"_17499":47657,"_5":17394,"_23735":47615,"_2383":47658},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2856":2211,"_25078":2191,"_17499":47660,"_5":17394,"_23735":47618,"_2383":47661},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2856":2212,"_25078":2191,"_17499":47663,"_5":17394,"_23735":47621,"_2383":47664},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2856":2213,"_25078":2191,"_17499":47666,"_5":17394,"_23735":47624,"_2383":47667},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2856":2214,"_25078":2191,"_17499":47669,"_5":17394,"_23735":47627,"_2383":47670},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2856":2215,"_25078":2191,"_17499":47672,"_5":17394,"_23735":47627,"_2383":47673},[],"its subject and extensions identify the expected client;",{"_2856":2216,"_25078":2191,"_17499":47675,"_5":17394,"_23735":47627,"_2383":47676},[],"its public key matches the client's private key;",{"_2856":2217,"_25078":2191,"_17499":47678,"_5":17394,"_23735":47627,"_2383":47679},[],"its chain reaches a root trusted by the consumer;",{"_2856":2218,"_25078":2191,"_17499":47681,"_5":17394,"_23735":47627,"_2383":47682},[],"its dates and usages allow the operation;",{"_2856":2219,"_25078":2191,"_17499":47684,"_5":17394,"_23735":47627,"_2383":47685},[],"the consumer applies revocation checks and authorization.",{"_2856":2220,"_25078":2191,"_17499":47687,"_5":17394,"_23735":47627,"_2383":47688},[],"The issuance path includes the first independent checks.",{"_2856":2221,"_25078":2191,"_17499":47690,"_5":17394,"_23735":47631,"_2383":47691},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2856":2222,"_25078":2191,"_17499":47693,"_5":17394,"_23735":47631,"_2383":47694},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2856":2223,"_25078":2191,"_17499":47696,"_5":17394,"_23735":47631,"_2383":47697},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2856":2224,"_25078":2224,"_5":12261,"_2383":47699,"_25413":47700,"_17499":47701,"_23735":2224},"Create your first CA",[40749,42093,45771,45206],[],{"_2856":2225,"_25078":2224,"_17499":47703,"_5":17394,"_23735":2224,"_2383":47704},[],"Create an evaluation root and check its certificate before issuing.",{"_2856":2226,"_25078":2224,"_5":25410,"_17499":47706,"_23735":47707,"_2383":40759},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2856":2227,"_25078":2224,"_5":25410,"_17499":47709,"_23735":47710,"_2383":47711},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2856":2228,"_25078":2224,"_5":25410,"_17499":47713,"_23735":47714,"_2383":47715},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2856":2229,"_25078":2224,"_5":25410,"_17499":47717,"_23735":47718,"_2383":47719},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2856":2230,"_25078":2224,"_5":25410,"_17499":47721,"_23735":47722,"_2383":47723},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2856":2231,"_25078":2224,"_5":25410,"_17499":47725,"_23735":47726,"_2383":47727},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2856":2232,"_25078":2224,"_5":25410,"_17499":47729,"_23735":47730,"_2383":47731},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2856":2233,"_25078":2224,"_5":25410,"_17499":47733,"_23735":47734,"_2383":45464},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2856":2234,"_25078":2224,"_5":25410,"_17499":47736,"_23735":47737,"_2383":40783},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2856":2235,"_25078":2224,"_17499":47739,"_5":17394,"_23735":2224,"_2383":47740},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2856":2236,"_25078":2224,"_17499":47742,"_5":17394,"_23735":47707,"_2383":47743},[],"Console access and permission to create keys and authorities.",{"_2856":2237,"_25078":2224,"_17499":47745,"_5":17394,"_23735":47707,"_2383":47746},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2856":2238,"_25078":2224,"_17499":47748,"_5":17394,"_23735":47707,"_2383":47749},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2856":2239,"_25078":2224,"_17499":47751,"_5":17394,"_23735":47707,"_2383":47752},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2856":2240,"_25078":2224,"_17499":47754,"_5":17394,"_23735":47710,"_2383":47755},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2856":2241,"_25078":2224,"_17499":47757,"_5":17394,"_23735":47710,"_2383":47758},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2856":2242,"_25078":2224,"_17499":47760,"_5":17394,"_23735":47714,"_2383":47761},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2856":2243,"_25078":2224,"_17499":47763,"_5":17394,"_23735":47714,"_2383":47764},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2856":2244,"_25078":2224,"_17499":47766,"_5":17394,"_23735":47718,"_2383":47767},[],"Select **Root CA** and complete:",{"_2856":2245,"_25078":2224,"_17499":47769,"_5":17394,"_23735":47718,"_2383":47770},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2856":2246,"_25078":2224,"_17499":47772,"_5":17394,"_23735":47718,"_2383":47773},[],"**Subject**: organization and country details for your evaluation.",{"_2856":2247,"_25078":2224,"_17499":47775,"_5":17394,"_23735":47718,"_2383":47776},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2856":2248,"_25078":2224,"_17499":47778,"_5":17394,"_23735":47718,"_2383":47779},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2856":2249,"_25078":2224,"_17499":47781,"_5":17394,"_23735":47718,"_2383":47782},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2856":2250,"_25078":2224,"_17499":47784,"_5":17394,"_23735":47722,"_2383":47785},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2856":2251,"_25078":2224,"_17499":47787,"_5":17394,"_23735":47726,"_2383":47788},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2856":2252,"_25078":2224,"_17499":47790,"_5":17394,"_23735":47726,"_2383":47791},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2856":2253,"_25078":2224,"_17499":47793,"_5":17394,"_23735":47730,"_2383":47794},[],"Run from the directory where you saved `ca.pem`:",{"_2856":2254,"_25078":2224,"_17499":47796,"_5":17394,"_23735":47730,"_2383":47797},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2856":2255,"_25078":2224,"_17499":47799,"_5":17394,"_23735":47730,"_2383":47800},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2856":2256,"_25078":2224,"_17499":47802,"_5":17394,"_23735":47734,"_2383":47803},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2856":2257,"_25078":2224,"_17499":47805,"_5":17394,"_23735":47734,"_2383":47806},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2856":2258,"_25078":2224,"_17499":47808,"_5":17394,"_23735":47734,"_2383":47809},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2856":2259,"_25078":2224,"_17499":47811,"_5":17394,"_23735":47734,"_2383":47812},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2856":2260,"_25078":2224,"_17499":47814,"_5":17394,"_23735":47737,"_2383":47815},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2856":2261,"_25078":2261,"_5":12261,"_2383":47817,"_25413":47818,"_17499":47819,"_23735":2261},"Issue and verify a certificate",[40749,42093,45771,45206],[],{"_2856":2262,"_25078":2261,"_17499":47821,"_5":17394,"_23735":2261,"_2383":47822},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2856":2263,"_25078":2261,"_5":25410,"_17499":47824,"_23735":47825,"_2383":40759},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2856":2264,"_25078":2261,"_5":25410,"_17499":47827,"_23735":47828,"_2383":47829},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2856":2265,"_25078":2261,"_5":25410,"_17499":47831,"_23735":47832,"_2383":47833},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2856":2266,"_25078":2261,"_5":25410,"_17499":47835,"_23735":47836,"_2383":47837},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2856":2267,"_25078":2261,"_5":25410,"_17499":47839,"_23735":47840,"_2383":47841},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2856":2268,"_25078":2261,"_5":25410,"_17499":47843,"_23735":47844,"_2383":47845},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2856":2269,"_25078":2261,"_5":25410,"_17499":47847,"_23735":47848,"_2383":47727},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2856":2270,"_25078":2261,"_5":25410,"_17499":47850,"_23735":47851,"_2383":47852},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2856":2271,"_25078":2261,"_5":25410,"_17499":47854,"_23735":47855,"_2383":47856},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2856":2272,"_25078":2261,"_5":25410,"_17499":47858,"_23735":47859,"_2383":47860},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2856":2273,"_25078":2261,"_5":25410,"_17499":47862,"_23735":47863,"_2383":45464},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2856":2274,"_25078":2261,"_5":25410,"_17499":47865,"_23735":47866,"_2383":40783},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/issue-certificate#next-step",{"_2856":2275,"_25078":2261,"_17499":47868,"_5":17394,"_23735":2261,"_2383":47869},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2856":2276,"_25078":2261,"_17499":47871,"_5":17394,"_23735":47825,"_2383":47872},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2856":2277,"_25078":2261,"_17499":47874,"_5":17394,"_23735":47825,"_2383":47875},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2856":2278,"_25078":2261,"_17499":47877,"_5":17394,"_23735":47825,"_2383":47878},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2856":2279,"_25078":2261,"_17499":47880,"_5":17394,"_23735":47825,"_2383":47881},[],"A client identifier: here we use `device-001`.",{"_2856":2280,"_25078":2261,"_17499":47883,"_5":17394,"_23735":47825,"_2383":47884},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2856":2281,"_25078":2261,"_17499":47886,"_5":17394,"_23735":47828,"_2383":47887},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2856":2282,"_25078":2261,"_17499":47889,"_5":17394,"_23735":47832,"_2383":47890},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2856":2283,"_25078":2261,"_17499":47892,"_5":17394,"_23735":47832,"_2383":47893},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2856":2284,"_25078":2261,"_17499":47895,"_5":17394,"_23735":47836,"_2383":47896},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2856":2285,"_25078":2261,"_17499":47898,"_5":17394,"_23735":47836,"_2383":47899},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2856":2286,"_25078":2261,"_17499":47901,"_5":17394,"_23735":47840,"_2383":47902},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2856":2287,"_25078":2261,"_17499":47904,"_5":17394,"_23735":47840,"_2383":47905},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2856":2288,"_25078":2261,"_17499":47907,"_5":17394,"_23735":47844,"_2383":47908},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2856":2289,"_25078":2261,"_17499":47910,"_5":17394,"_23735":47848,"_2383":47911},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2856":2290,"_25078":2261,"_17499":47913,"_5":17394,"_23735":47851,"_2383":47914},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2856":2291,"_25078":2261,"_17499":47916,"_5":17394,"_23735":47855,"_2383":47917},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2856":2292,"_25078":2261,"_17499":47919,"_5":17394,"_23735":47855,"_2383":47920},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2856":2293,"_25078":2261,"_17499":47922,"_5":17394,"_23735":47855,"_2383":47923},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2856":2294,"_25078":2261,"_17499":47925,"_5":17394,"_23735":47859,"_2383":47926},[],"In Bash, compare the two public-key digests:",{"_2856":2295,"_25078":2261,"_17499":47928,"_5":17394,"_23735":47859,"_2383":47929},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2856":2296,"_25078":2261,"_17499":47931,"_5":17394,"_23735":47859,"_2383":47932},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2856":2297,"_25078":2261,"_17499":47934,"_5":17394,"_23735":47863,"_2383":45548},[],{"_2856":2298,"_25078":2261,"_17499":47936,"_5":17394,"_23735":47863,"_2383":47937},[],"What to review",{"_2856":2299,"_25078":2261,"_17499":47939,"_5":17394,"_23735":47863,"_2383":47940},[],"The CA rejects issuance",{"_2856":2300,"_25078":2261,"_17499":47942,"_5":17394,"_23735":47863,"_2383":47943},[],"Permissions, CA state and key, algorithm and profile.",{"_2856":2301,"_25078":2261,"_17499":47945,"_5":17394,"_23735":47863,"_2383":47946},[],"Different subject or usages",{"_2856":2302,"_25078":2261,"_17499":47948,"_5":17394,"_23735":47863,"_2383":47949},[],"Applied profile and requested values.",{"_2856":2303,"_25078":2261,"_17499":47951,"_5":17394,"_23735":47863,"_2383":47952},[],"Issuer cannot be found",{"_2856":2304,"_25078":2261,"_17499":47954,"_5":17394,"_23735":47863,"_2383":47955},[],"Downloaded CA and required intermediate chain.",{"_2856":2305,"_25078":2261,"_17499":47957,"_5":17394,"_23735":47863,"_2383":47958},[],"Validity fails",{"_2856":2306,"_25078":2261,"_17499":47960,"_5":17394,"_23735":47863,"_2383":47961},[],"Certificate and CA dates, and the computer's clock.",{"_2856":2307,"_25078":2261,"_17499":47963,"_5":17394,"_23735":47863,"_2383":47964},[],"Public-key digests differ",{"_2856":2308,"_25078":2261,"_17499":47966,"_5":17394,"_23735":47863,"_2383":47967},[],"Certificate and key files from the same issuance.",{"_2856":2309,"_25078":2261,"_17499":47969,"_5":17394,"_23735":47863,"_2383":47970},[],"See PKI diagnostics to narrow an issuance failure.",{"_2856":2310,"_25078":2261,"_17499":47972,"_5":17394,"_23735":47866,"_2383":47973},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2856":2311,"_25078":2261,"_17499":47975,"_5":17394,"_23735":47866,"_2383":47976},[],"Manage certificates for inspection, status and revocation.",{"_2856":2312,"_25078":2261,"_17499":47978,"_5":17394,"_23735":47866,"_2383":47979},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2856":2313,"_25078":2261,"_17499":47981,"_5":17394,"_23735":47866,"_2383":47982},[],"Prepare EST for the device to request its next identities.",{"_2856":2314,"_25078":2261,"_17499":47984,"_5":17394,"_23735":47866,"_2383":47985},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2856":2315,"_25078":2315,"_5":12261,"_2383":47987,"_25413":47988,"_17499":47989,"_23735":2315},"PKI getting started",[40749,42093,45771,45206],[],{"_2856":2316,"_25078":2315,"_17499":47991,"_5":17394,"_23735":2315,"_2383":47992},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2856":2317,"_25078":2315,"_5":25410,"_17499":47994,"_23735":47995,"_2383":40759},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/overview#before-you-begin",{"_2856":2318,"_25078":2315,"_5":25410,"_17499":47997,"_23735":47998,"_2383":47999},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2856":2319,"_25078":2315,"_5":25410,"_17499":48001,"_23735":48002,"_2383":45398},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/overview#expected-result",{"_2856":2320,"_25078":2315,"_5":25410,"_17499":48004,"_23735":48005,"_2383":48006},[],"/docs/pr-preview/pr-40/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2856":2321,"_25078":2315,"_17499":48008,"_5":17394,"_23735":2315,"_2383":48009},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2856":2322,"_25078":2315,"_17499":48011,"_5":17394,"_23735":47995,"_2383":48012},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2856":2323,"_25078":2315,"_17499":48014,"_5":17394,"_23735":47995,"_2383":48015},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2856":2324,"_25078":2315,"_17499":48017,"_5":17394,"_23735":47995,"_2383":48018},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2856":2325,"_25078":2315,"_17499":48020,"_5":17394,"_23735":47995,"_2383":48021},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2856":2326,"_25078":2315,"_17499":48023,"_5":17394,"_23735":47995,"_2383":48024},[],"A working directory with restricted access for the downloaded key.",{"_2856":2327,"_25078":2315,"_17499":48026,"_5":17394,"_23735":47998,"_2383":48027},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2856":2328,"_25078":2315,"_17499":48029,"_5":17394,"_23735":47998,"_2383":48030},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2856":2329,"_25078":2315,"_17499":48032,"_5":17394,"_23735":47998,"_2383":48033},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2856":2330,"_25078":2315,"_17499":48035,"_5":17394,"_23735":47998,"_2383":48036},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2856":2331,"_25078":2315,"_17499":48038,"_5":17394,"_23735":48002,"_2383":48039},[],"File or resource",{"_2856":2332,"_25078":2315,"_17499":48041,"_5":17394,"_23735":48002,"_2383":45395},[],{"_2856":2333,"_25078":2315,"_17499":48043,"_5":17394,"_23735":48002,"_2383":48044},[],"Active root CA and `ca.pem`",{"_2856":2334,"_25078":2315,"_17499":48046,"_5":17394,"_23735":48002,"_2383":48047},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2856":2335,"_25078":2315,"_17499":48049,"_5":17394,"_23735":48002,"_2383":48050},[],"End-entity certificate and `device.crt`",{"_2856":2336,"_25078":2315,"_17499":48052,"_5":17394,"_23735":48002,"_2383":48053},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2856":2337,"_25078":2315,"_17499":48055,"_5":17394,"_23735":48002,"_2383":48056},[],"Private key `device.key`",{"_2856":2338,"_25078":2315,"_17499":48058,"_5":17394,"_23735":48002,"_2383":48059},[],"Its public key matches the one included in `device.crt`.",{"_2856":2339,"_25078":2315,"_17499":48061,"_5":17394,"_23735":48002,"_2383":48062},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2856":2340,"_25078":2315,"_17499":48064,"_5":17394,"_23735":48005,"_2383":48065},[],"To operate certificates, continue with Certificates and Validation.",{"_2856":2341,"_25078":2315,"_17499":48067,"_5":17394,"_23735":48005,"_2383":48068},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2856":2342,"_25078":2315,"_17499":48070,"_5":17394,"_23735":48005,"_2383":48071},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2856":2343,"_25078":2343,"_5":12261,"_2383":48073,"_25413":48074,"_17499":48075,"_23735":2343},"PKI troubleshooting",[40749,42093,45771,44592],[],{"_2856":2344,"_25078":2343,"_17499":48077,"_5":17394,"_23735":2343,"_2383":48078},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2856":2345,"_25078":2343,"_5":25410,"_17499":48080,"_23735":48081,"_2383":48082},[],"/docs/pr-preview/pr-40/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2856":2346,"_25078":2343,"_5":25410,"_17499":48084,"_23735":48085,"_2383":48086},[],"/docs/pr-preview/pr-40/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2856":2347,"_25078":2343,"_5":25410,"_17499":48088,"_23735":48089,"_2383":48090},[],"/docs/pr-preview/pr-40/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2856":2348,"_25078":2343,"_17499":48092,"_5":17394,"_23735":2343,"_2383":48093},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2856":2349,"_25078":2343,"_17499":48095,"_5":17394,"_23735":2343,"_2383":48096},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2856":2350,"_25078":2343,"_17499":48098,"_5":17394,"_23735":48081,"_2383":45395},[],{"_2856":2351,"_25078":2343,"_17499":48100,"_5":17394,"_23735":48081,"_2383":48101},[],"What to inspect",{"_2856":2352,"_25078":2343,"_17499":48103,"_5":17394,"_23735":48081,"_2383":40783},[],{"_2856":2353,"_25078":2343,"_17499":48105,"_5":17394,"_23735":48081,"_2383":48106},[],"CA",{"_2856":2354,"_25078":2343,"_17499":48108,"_5":17394,"_23735":48081,"_2383":48109},[],"Exists, is active and has usable dates.",{"_2856":2355,"_25078":2343,"_17499":48111,"_5":17394,"_23735":48081,"_2383":48112},[],"Authorities.",{"_2856":2356,"_25078":2343,"_17499":48114,"_5":17394,"_23735":48081,"_2383":48115},[],"Key",{"_2856":2357,"_25078":2343,"_17499":48117,"_5":17394,"_23735":48081,"_2383":48118},[],"The record has a usable private key and the engine can sign.",{"_2856":2358,"_25078":2343,"_17499":48120,"_5":17394,"_23735":48081,"_2383":48121},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2856":2359,"_25078":2343,"_17499":48123,"_5":17394,"_23735":48081,"_2383":48124},[],"CSR",{"_2856":2360,"_25078":2343,"_17499":48126,"_5":17394,"_23735":48081,"_2383":48127},[],"Correct PEM and verifiable signature.",{"_2856":2361,"_25078":2343,"_17499":48129,"_5":17394,"_23735":48081,"_2383":48130},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2856":2362,"_25078":2343,"_17499":48132,"_5":17394,"_23735":48081,"_2383":48133},[],"Profile",{"_2856":2363,"_25078":2343,"_17499":48135,"_5":17394,"_23735":48081,"_2383":48136},[],"Selected source, existing ID, allowed algorithm and size.",{"_2856":2364,"_25078":2343,"_17499":48138,"_5":17394,"_23735":48081,"_2383":48139},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2856":2365,"_25078":2343,"_17499":48141,"_5":17394,"_23735":48081,"_2383":45548},[],{"_2856":2366,"_25078":2343,"_17499":48143,"_5":17394,"_23735":48081,"_2383":48144},[],"Appropriate subject, SAN, usages and dates.",{"_2856":2367,"_25078":2343,"_17499":48146,"_5":17394,"_23735":48081,"_2383":48147},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2856":2368,"_25078":2343,"_17499":48149,"_5":17394,"_23735":48081,"_2383":48150},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2856":2369,"_25078":2343,"_17499":48152,"_5":17394,"_23735":48081,"_2383":48153},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2856":2370,"_25078":2343,"_17499":48155,"_5":17394,"_23735":48085,"_2383":48156},[],"Check each boundary independently:",{"_2856":2371,"_25078":2343,"_17499":48158,"_5":17394,"_23735":48085,"_2383":48159},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2856":2372,"_25078":2343,"_17499":48161,"_5":17394,"_23735":48085,"_2383":48162},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2856":2373,"_25078":2343,"_17499":48164,"_5":17394,"_23735":48085,"_2383":48165},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2856":2374,"_25078":2343,"_17499":48167,"_5":17394,"_23735":48085,"_2383":48168},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2856":2375,"_25078":2343,"_17499":48170,"_5":17394,"_23735":48085,"_2383":48171},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2856":2376,"_25078":2343,"_17499":48173,"_5":17394,"_23735":48085,"_2383":48174},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2856":2377,"_25078":2343,"_17499":48176,"_5":17394,"_23735":48089,"_2383":48177},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Valida