atform/pki/quickstarts/overview-6","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#before-you-begin","content":"A Lamassu instance accessible from your browser. To prepare one, see Deployment."},"2314":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview-7","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#before-you-begin","content":"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked."},"2315":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview-8","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#before-you-begin","content":"An available cryptographic engine for the CA key; check the keys and engines inventory."},"2316":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview-9","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#before-you-begin","content":"OpenSSL 3.x on the computer where you will verify the files."},"2317":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview-10","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#before-you-begin","content":"A working directory with restricted access for the downloaded key."},"2318":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview-11","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#recommended-path","content":"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />"},"2319":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview-12","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#recommended-path","content":"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />"},"2320":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview-13","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#recommended-path","content":"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect."},"2321":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview-14","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#recommended-path","content":"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy."},"2322":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview-15","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#expected-result","content":"File or resource"},"2323":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview-16","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#expected-result","content":"Check"},"2324":{"id":"/do