s":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-configuration","content":"Enrollment configuration"},"826":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-9","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"Enrollment Device Registration"},"827":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-10","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Enrollment Settings"},"828":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-11","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Authentication per operation"},"829":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-12","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"External webhook settings"},"830":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-13","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#issuance-profile","content":"Issuance profile"},"831":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-14","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Re-enrollment configuration"},"832":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-15","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#serverkeygen","content":"ServerKeyGen"},"833":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-16","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Trust distribution"},"834":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-17","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"Operate the DMS inventory"},"835":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-18","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#integrate-the-devices","content":"Integrate the devices"},"836":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-19","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","content":"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator."},"837":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-20","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#before-you-begin","content":"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement."},"838":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-21","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#before-you-begin","content":"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication."},"839":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-22","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#identify-the-fleet","content":"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS."},"840":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-23","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","content":"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity."},"841":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-24","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#configure-est","content":"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key."},"842":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-25","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#distribute-trust","content":"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation."},"843":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-26","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#verify-the-endpoints","content":"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance."},"844":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-27","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration."},"845":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-28","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode."},"846":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-29","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`settings.enrollment_settings` field"},"847":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-30","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Decision"},"848":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-31","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`protocol`"},"849":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-32","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`EST_RFC7030` for these operations."},"850":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-33","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enrollment_ca`"},"851":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-34","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"ID of the signing CA."},"852":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-35","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`verify_csr_signature`"},"853":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-36","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Keep `true` to verify CSR key possession."},"854":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-37","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enable_replaceable_enrollment`"},"855":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-38","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic."},"856":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-39","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`est_rfc7030_settings.auth_mode`"},"857":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-40","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"One of the four authentication modes."},"858":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-41","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes."},"859":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-42","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"The blocks are independent:"},"860":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-43","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`."},"861":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-44","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`."},"862":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-45","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`auth_mode`"},"863":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-46","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Control applied in the configured operation"},"864":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-47","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`CLIENT_CERTIFICATE`"},"865":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-48","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Presented certificate validation."},"866":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-49","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`EXTERNAL_WEBHOOK`"},"867":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-50","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Configured webhook authorization."},"868":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-51","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"869":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-52","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Certificate validation followed by webhook approval."},"870":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-53","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`NO_AUTH`"},"871":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-54","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"No DMS requester authentication."},"872":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-55","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails."},"873":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-56","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path."},"874":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-57","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For certificate re-enrollment, the validator uses the enrollment CA, then `additional_validation_cas`, and `enable_expired_renewal`. Do not assume copying initial `validation_cas` changes those issuers."},"875":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-58","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID."},"876":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-59","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:"},"877":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-60","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`external_webhook_settings` field"},"878":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-61","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Decision"},"879":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-62","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`url`"},"880":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-63","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed."},"881":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-64","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`method`"},"882":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-65","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`POST` or `PUT`; `POST` by default."},"883":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-66","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`name`"},"884":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-67","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Label used in service logs."},"885":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-68","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.auth_mode`"},"886":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-69","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`."},"887":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-70","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.apikey_options`"},"888":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-71","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `apikey`: `header` and `key`. Reserved header names are rejected."},"889":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-72","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.jwt_options`"},"890":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-73","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`."},"891":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-74","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.mtls_options`"},"892":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-75","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `mtls`: `cert_content` and `key_content` as inline PEM."},"893":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-76","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.insecure_skip_verify`"},"894":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-77","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here."},"895":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-78","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.call_timeout`"},"896":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-79","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Maximum duration of the authorization call (for example `10s`); 10 seconds by default."},"897":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-80","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Rules for that configuration:"},"898":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-81","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so supply the PEM as `mtls_options.cert_content` and `key_content`."},"899":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-82","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected."},"900":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-83","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`."},"901":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-84","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The API ignores the legacy fields `validate_server_cert`, `apikey`, `oidc` and `mtls`. A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` that still carries only the legacy option fields (`apikey`, `oidc`, `mtls`) fails validation with 400; only legacy `noauth` bodies are accepted, and their credentials are dropped."},"902":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-85","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The authorization response must be JSON of at most 1 MiB; a larger body fails the call."},"903":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-86","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises."},"904":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-87","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API."},"905":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-88","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Migration `20261021120000` rewrites every stored webhook config into this layout: `validate_server_cert` becomes the negated `insecure_skip_verify` (a config where `validate_server_cert` was false keeps skipping verification), `oidc` becomes `jwt_options`, `apikey` becomes `apikey_options` and `mtls` becomes `mtls_options`. When both the legacy certificate and key are PEM, they move into `mtls_options.cert_content` and `key_content` and need no action. Otherwise, including a mixed config (PEM certificate, file-path key), both values become `mtls_options.cert_file` and `key_file`. Delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are re-entered as PEM content, or the leftover file fields are removed if the webhook does not use mTLS. If your version's console does not expose those fields, edit the DMS through the DMS API."},"906":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-89","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#issuance-profile","content":"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust."},"907":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-90","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`settings.reenrollment_settings` field"},"908":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-91","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Purpose"},"909":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-92","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`reenrollment_delta`"},"910":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-93","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Opens the window at the active certificate’s `NotAfter` minus this delta."},"911":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-94","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`preventive_delta`"},"912":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-95","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Preventive operational monitoring threshold."},"913":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-96","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`critical_delta`"},"914":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-97","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Critical operational monitoring threshold."},"915":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-98","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`enable_expired_renewal`"},"916":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-99","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself."},"917":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-100","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`additional_validation_cas`"},"918":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-101","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Additional mTLS credential issuers during migration."},"919":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-102","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`revoke_on_reenrollment`"},"920":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-103","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor."},"921":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-104","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures."},"922":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-105","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#serverkeygen","content":"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference."},"923":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-106","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Option"},"924":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-107","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Published material"},"925":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-108","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Include Lamassu System CA**"},"926":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-109","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Available downstream TLS certificate; it can be a leaf, not an issuing CA."},"927":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-110","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Include Enrollment CA**"},"928":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-111","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Selected issuing CA certificate."},"929":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-112","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Managed CAs**"},"930":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-113","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Explicitly selected CA certificates."},"931":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-114","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#trust-distribution","content":"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust."},"932":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-115","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields."},"933":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-116","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs."},"934":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-117","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement."},"935":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms-118","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#integrate-the-devices","content":"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures."},"936":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","type":"page","content":"Integrate the EST client","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client"},"937":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-0","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","content":"Prepare trust, send a CSR and check the identity you receive."},"938":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-1","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Before you begin"},"939":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-2","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"Download and inspect cacerts"},"940":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-3","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"Prepare the CSR"},"941":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-4","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"Request the identity"},"942":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-5","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Check and install the result"},"943":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-6","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#next-steps","content":"Next steps"},"944":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-7","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","content":"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device."},"945":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-8","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools."},"946":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-9","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity."},"947":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-10","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name."},"948":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-11","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file."},"949":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-12","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works."},"950":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-13","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject."},"951":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-14","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles."},"952":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-15","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:"},"953":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-16","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance."},"954":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-17","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"For a root that issues directly:"},"955":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-18","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation."},"956":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-19","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete."},"957":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client-20","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#next-steps","content":"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures."},"958":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","type":"page","content":"EST reference","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference"},"959":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-0","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","content":"Look up Lamassu routes, formats, authentication and multipart responses."},"960":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-1","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Endpoint reference"},"961":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-2","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#cacerts","content":"cacerts"},"962":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-3","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"simpleenroll"},"963":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-4","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"simplereenroll"},"964":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-5","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"serverkeygen"},"965":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-6","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#response-format","content":"Response format"},"966":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-7","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Request and extraction"},"967":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-8","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"Compatibility notes"},"968":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-9","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","content":"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy."},"969":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-10","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route."},"970":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-11","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Operation"},"971":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-12","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Method"},"972":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-13","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Authentication and condition"},"973":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-14","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/cacerts`"},"974":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-15","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"GET"},"975":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-16","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply."},"976":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-17","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/simpleenroll`"},"977":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-18","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"978":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-19","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Initial authentication and DMS registration/replacement policy."},"979":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-20","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/simplereenroll`"},"980":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-21","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"981":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-22","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Renewal authentication, existing identity, subject, revocation and window."},"982":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-23","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/serverkeygen`"},"983":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-24","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"984":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-25","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Initial authentication and admission; server generation enabled."},"985":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-26","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract."},"986":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-27","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#cacerts","content":"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor."},"987":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-28","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#cacerts","content":"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots."},"988":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-29","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy."},"989":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-30","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR."},"990":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-31","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate."},"991":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-32","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"The enrollment CA or an additional CA validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery."},"992":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-33","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM."},"993":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-34","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement."},"994":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-35","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#response-format","content":"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:"},"995":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-36","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#response-format","content":"Part"},"996":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-37","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#response-format","content":"Content after decoding its Base64"},"997":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-38","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#response-format","content":"`application/pkcs8`"},"998":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-39","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#response-format","content":"Unencrypted DER PKCS#8 private key."},"999":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-40","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#response-format","content":"`application/pkcs7-mime; smime-type=certs-only`"},"1000":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-41","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#response-format","content":"DER PKCS#7 containing the issued certificate."},"1001":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-42","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#response-format","content":"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers."},"1002":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-43","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key."},"1003":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-44","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:"},"1004":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-45","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Convert and check the result:"},"1005":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-46","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser."},"1006":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-47","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting."},"1007":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference-48","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client."},"1008":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","type":"page","content":"Enrollment with PKI","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview"},"1009":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-0","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","content":"Choose admission policy and connect DMS, initial trust and the EST client."},"1010":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-1","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#the-journey","content":"The journey"},"1011":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-2","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"For the administrator"},"1012":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-3","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"For the integrator"},"1013":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-4","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#contract-version","content":"Contract version"},"1014":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-5","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","content":"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer."},"1015":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-6","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#the-journey","content":"The administrator prepares the CA, issuance profile and DMS."},"1016":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-7","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#the-journey","content":"The integrator installs initial EST server trust and an admission credential."},"1017":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-8","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#the-journey","content":"The client requests an identity for its `Device ID` through EST."},"1018":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-9","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#the-journey","content":"Certificate, device binding and key/certificate installation are checked."},"1019":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-10","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#the-journey","content":"The consumer validates and authorizes the identity; the client schedules renewal and recovery."},"1020":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-11","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#the-journey","content":"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test."},"1021":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-12","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />"},"1022":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-13","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1023":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-14","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />"},"1024":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-15","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />"},"1025":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-16","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />"},"1026":{"id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview-17","page_id":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"Ren