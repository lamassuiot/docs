41/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios."},"1818":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-21","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Mecanismo"},"1819":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-22","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Cuándo utilizarlo"},"1820":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-23","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Qué debes mantener"},"1821":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-24","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"OCSP"},"1822":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-25","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Consulta del estado de un certificado concreto."},"1823":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-26","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Acceso al respondedor, verificación de la firma y política de caché/vigencia."},"1824":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-27","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"CRL"},"1825":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-28","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Consulta local de muchos certificados o funcionamiento offline."},"1826":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-29","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas."},"1827":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-30","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla."},"1828":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-31","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación."},"1829":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-32","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Acepta un certificado vigente, autorizado y con cadena conocida."},"1830":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-33","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Rechaza otro con raíz desconocida o uso incompatible."},"1831":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-34","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL."},"1832":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-35","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Comprueba que una conexión nueva con esa identidad se rechaza."},"1833":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-36","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política."},"1834":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-37","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente."},"1835":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-38","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena."},"1836":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-39","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />"},"1837":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-40","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />"},"1838":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","type":"page","content":"Certificados","breadcrumbs":["Docs","Plataforma","PKI","Claves, autoridades y certificados"],"tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificates"},"1839":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-0","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates","content":"Consulta, descarga y revoca los certificados emitidos por Lamassu."},"1840":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-1","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#busca-un-certificado","content":"Busca un certificado"},"1841":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-2","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#descarga-el-certificado","content":"Descarga el certificado"},"1842":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-3","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Emite desde una CSR existente"},"1843":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-4","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#revoca-un-certificado","content":"Revoca un certificado"},"1844":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-5","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#abre-la-acción","content":"Abre la acción"},"1845":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-6","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#elige-una-razón","content":"Elige una razón"},"1846":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-7","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#confirma-y-verifica","content":"Confirma y verifica"},"1847":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-8","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#reactiva-una-suspensión","content":"Reactiva una suspensión"},"1848":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-9","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#continúa","content":"Continúa"},"1849":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-10","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates","content":"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor."},"1850":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-11","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#busca-un-certificado","content":"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos."},"1851":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-12","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#busca-un-certificado","content":"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas."},"1852":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-13","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#descarga-el-certificado","content":"Descarga el PEM e inspecciónalo:"},"1853":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-14","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#descarga-el-certificado","content":"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado."},"1854":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-15","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado."},"1855":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-16","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada."},"1856":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-17","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**."},"1857":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-18","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven."},"1858":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-19","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen."},"1859":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-20","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración."},"1860":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-21","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#emite-desde-una-csr-existente","content":"Para generar la clave en el navegador, sigue Emite tu primer certificado."},"1861":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-22","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#revoca-un-certificado","content":"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria."},"1862":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-23","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#abre-la-acción","content":"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado."},"1863":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-24","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#elige-una-razón","content":"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida."},"1864":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-25","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#confirma-y-verifica","content":"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor."},"1865":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-26","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#confirma-y-verifica","content":"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos."},"1866":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-27","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#confirma-y-verifica","content":"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias."},"1867":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-28","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#reactiva-una-suspensión","content":"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu."},"1868":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-29","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#reactiva-una-suspensión","content":"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia."},"1869":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-30","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#reactiva-una-suspensión","content":"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA."},"1870":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-31","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#continúa","content":"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />"},"1871":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificates-32","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificates#continúa","content":"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />"},"1872":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","type":"page","content":"Ciclo de vida de un certificado","breadcrumbs":["Docs","Plataforma","PKI","Conceptos"],"tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle"},"1873":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-0","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","content":"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu."},"1874":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-1","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","content":"El recorrido completo"},"1875":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-2","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#solicitud","content":"Solicitud"},"1876":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-3","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#emisión","content":"Emisión"},"1877":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-4","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","content":"Uso y supervisión"},"1878":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-5","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","content":"Renovación o re-enrolamiento"},"1879":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-6","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","content":"Revocación o retirada"},"1880":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-7","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"Estados del certificado"},"1881":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-8","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","content":"Renovación y revocación no son equivalentes"},"1882":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-9","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Efecto de revocar una CA"},"1883":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-10","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Qué debes observar"},"1884":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-11","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","content":"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado."},"1885":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-12","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#solicitud","content":"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó."},"1886":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-13","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#emisión","content":"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas."},"1887":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-14","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","content":"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido."},"1888":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-15","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","content":"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST."},"1889":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-16","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","content":"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado."},"1890":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-17","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"Lamassu persiste cuatro estados X.509:"},"1891":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-18","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal."},"1892":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-19","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente."},"1893":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-20","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal."},"1894":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-21","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva."},"1895":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-22","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","content":"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509."},"1896":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-23","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","content":"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad."},"1897":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-24","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","content":"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación."},"1898":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-25","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","content":"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento."},"1899":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-26","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones."},"1900":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-27","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Antes de confirmar:"},"1901":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-28","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Identifica DMS, dispositivos y servicios que confían en esa cadena."},"1902":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-29","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Distribuye la nueva cadena de confianza."},"1903":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-30","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Reemite las identidades necesarias."},"1904":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-31","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Comprueba OCSP y CRL desde un consumidor real."},"1905":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-32","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"Revoca la CA antigua cuando ya no exista tráfico legítimo."},"1906":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-33","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","content":"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos."},"1907":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-34","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Certificados que entran en la ventana preventiva o crítica de renovación."},"1908":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-35","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Errores repetidos de enrolamiento o re-enrolamiento."},"1909":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-36","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Cambios de estado y razones de revocación."},"1910":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-37","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Publicación y vigencia de OCSP y CRLs."},"1911":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-38","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"Dependencias que todavía presentan un certificado sustituido."},"1912":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle-39","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","content":"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría."},"1913":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","type":"page","content":"Modelo de confianza","breadcrumbs":["Docs","Plataforma","PKI","Conceptos"],"tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model"},"1914":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-0","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","content":"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente."},"1915":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-1","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","content":"Las cuatro decisiones de confianza"},"1916":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-2","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#quién-puede-emitir","content":"Quién puede emitir"},"1917":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-3","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#qué-puede-emitirse","content":"Qué puede emitirse"},"1918":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-4","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","content":"Quién puede solicitarlo"},"1919":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-5","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","content":"Quién acepta el resultado"},"1920":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-6","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"Flujo de una identidad"},"1921":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-7","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"CAs de enrolamiento, validación y distribución"},"1922":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-8","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"Validación y revocación"},"1923":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-9","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#límites-de-custodia","content":"Límites de custodia"},"1924":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-10","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Patrón recomendado"},"1925":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-11","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","content":"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente."},"1926":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-12","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#quién-puede-emitir","content":"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión."},"1927":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-13","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#qué-puede-emitirse","content":"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión."},"1928":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-14","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","content":"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva."},"1929":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-15","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","content":"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces."},"1930":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-16","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"El dispositivo demuestra que puede enrolarse según la política del DMS."},"1931":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-17","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento."},"1932":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-18","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada."},"1933":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-19","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"El dispositivo instala el certificado y la cadena que necesita."},"1934":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-20","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación."},"1935":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-21","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","content":"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable."},"1936":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-22","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"Un DMS relaciona tres conjuntos que conviene diseñar por separado:"},"1937":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-23","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"**CA de enrolamiento:** firma las nuevas identidades."},"1938":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-24","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales."},"1939":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-25","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes."},"1940":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-26","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","content":"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento."},"1941":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-27","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:"},"1942":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-28","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"que la fecha actual está entre `Not Before` y `Not After`;"},"1943":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-29","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"que `Key Usage` y `Extended Key Usage` permiten la operación;"},"1944":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-30","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"que nombres, SANs y sujeto coinciden con la identidad esperada;"},"1945":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-31","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"que el certificado no aparece revocado mediante OCSP o una CRL."},"1946":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-32","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios."},"1947":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-33","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#validación-y-revocación","content":"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción."},"1948":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-34","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#límites-de-custodia","content":"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones."},"1949":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-35","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido."},"1950":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-36","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Emite desde CAs intermedias separadas por entorno o dominio de riesgo."},"1951":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-37","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Asigna perfiles explícitos a cada caso de uso."},"1952":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-38","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Distribuye la nueva confianza antes de comenzar una rotación."},"1953":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-39","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Mantén solapamiento suficiente para renovar una flota desconectada."},"1954":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-40","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Valida desde el sistema consumidor, no solo desde la consola de Lamassu."},"1955":{"id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model-41","page_id":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#patrón-recomendado","content":"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo."},"1956":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","type":"page","content":"Listas de revocación (CRL)","breadcrumbs":["Docs","Plataforma","PKI","Validación"],"tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/crl"},"1957":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-0","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl","content":"Genera y distribuye listas firmadas para validar certificados sin conexión."},"1958":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-1","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"Rol VA y configuración por CA"},"1959":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-2","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/crl#regeneración-periódica-y-automática","content":"Regeneración periódica y automática"},"1960":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-3","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/crl#contenido-de-la-crl","content":"Contenido de la CRL"},"1961":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-4","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/crl#endpoint-público-de-descarga","content":"Endpoint público de descarga"},"1962":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-5","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","content":"API de gestión del rol VA"},"1963":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-6","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/crl#desde-la-interfaz","content":"Desde la interfaz"},"1964":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-7","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/crl#referencias","content":"Referencias"},"1965":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-8","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl","content":"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia."},"1966":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-9","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible."},"1967":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-10","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"Campo de `crl_options`"},"1968":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-11","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"Función"},"1969":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-12","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"Valor inicial del backend"},"1970":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-13","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"`validity`"},"1971":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-14","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"Tiempo desde `thisUpdate` hasta `nextUpdate`."},"1972":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-15","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"7 días."},"1973":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-16","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"`refresh_interval`"},"1974":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-17","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"Plazo desde la publicación que activa la renovación programada."},"1975":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-18","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"6 días y 23 horas."},"1976":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-19","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"`regenerate_on_revoke`"},"1977":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-20","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`."},"1978":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-21","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"`true`."},"1979":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-22","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"`subject_key_id_signer`"},"1980":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-23","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"Campo de configuración inicializado con el SKI de la CA."},"1981":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-24","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"SKI de la CA."},"1982":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-25","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo."},"1983":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-26","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","content":"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER."},"1984":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-27","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#regeneración-periódica-y-automática","content":"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio."},"1985":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-28","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#regeneración-periódica-y-automática","content":"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado."},"1986":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-29","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#regeneración-periódica-y-automática","content":"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente."},"1987":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-30","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#contenido-de-la-crl","content":"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido."},"1988":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-31","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#contenido-de-la-crl","content":"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria."},"1989":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-32","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#endpoint-público-de-descarga","content":"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:"},"1990":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-33","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#endpoint-público-de-descarga","content":"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:"},"1991":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-34","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#endpoint-público-de-descarga","content":"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:"},"1992":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-35","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#endpoint-público-de-descarga","content":"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija."},"1993":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-36","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#endpoint-público-de-descarga","content":"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie."},"1994":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-37","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","content":"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL."},"1995":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-38","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","content":"Método"},"1996":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-39","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","content":"Path relativo"},"1997":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-40","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","content":"Operación"},"1998":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-41","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","content":"`GET`"},"1999":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-42","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","content":"`/v1/roles/{ca-ski}`"},"2000":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-43","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","content":"Consultar `crl_options` y `latest_crl`."},"2001":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-44","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","content":"`PUT`"},"2002":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-45","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","content":"`/v1/roles/{ca-ski}`"},"2003":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-46","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","content":"Sustituir la configuración de CRL."},"2004":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-47","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","content":"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos."},"2005":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-48","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","content":"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente."},"2006":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-49","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#desde-la-interfaz","content":"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI."},"2007":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-50","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#referencias","content":"RFC 5280: perfil X.509 y CRL."},"2008":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-51","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#referencias","content":"OpenSSL: openssl-crl."},"2009":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-52","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#referencias","content":"OpenSSL: openssl-verify."},"2010":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-53","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#referencias","content":"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />"},"2011":{"id":"/docs/pr-preview/pr-41/es/platform/pki/crl-54","page_id":"/docs/pr-preview/pr-41/es/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/crl#referencias","content":"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />"},"2012":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","type":"page","content":"Claves y motores criptográficos","breadcrumbs":["Docs","Plataforma","PKI","Claves, autoridades y certificados"],"tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/key-management"},"2013":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-0","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management","content":"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto."},"2014":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-1","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-manag