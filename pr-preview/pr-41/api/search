review/pr-41/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","content":"Define la emisión predeterminada"},"1673":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-15","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#verifica-la-importación","content":"Verifica la importación"},"1674":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-16","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Inspecciona una autoridad"},"1675":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-17","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#emite-certificados","content":"Emite certificados"},"1676":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-18","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#revoca-una-ca","content":"Revoca una CA"},"1677":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-19","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#evalúa-el-impacto","content":"Evalúa el impacto"},"1678":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-20","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#inicia-la-revocación","content":"Inicia la revocación"},"1679":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-21","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#confirma-la-identidad","content":"Confirma la identidad"},"1680":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-22","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#comprueba-la-publicación","content":"Comprueba la publicación"},"1681":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-23","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","content":"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa."},"1682":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-24","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","content":"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado."},"1683":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-25","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","content":"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena."},"1684":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-26","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#elige-un-flujo","content":"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves."},"1685":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-27","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#elige-un-flujo","content":"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma."},"1686":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-28","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#elige-un-flujo","content":"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir."},"1687":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-29","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#elige-un-flujo","content":"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir."},"1688":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-30","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#elige-un-flujo","content":"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo."},"1689":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-31","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#antes-de-empezar","content":"Decide si la CA será raíz o intermedia."},"1690":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-32","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#antes-de-empezar","content":"Elige el motor que custodiará la clave."},"1691":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-33","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#antes-de-empezar","content":"Define una validez superior a la de los certificados que emitirá."},"1692":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-34","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#antes-de-empezar","content":"Para una CA intermedia, asegúrate de que la CA padre esté activa."},"1693":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-35","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#abre-el-asistente","content":"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo."},"1694":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-36","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#configura-la-clave","content":"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor."},"1695":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-37","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#configura-la-clave","content":"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo."},"1696":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-38","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","content":"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora."},"1697":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-39","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#define-la-identidad","content":"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:"},"1698":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-40","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#define-la-identidad","content":"`C`: código de país ISO 3166-1 de dos letras."},"1699":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-41","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#define-la-identidad","content":"`ST`: estado o provincia."},"1700":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-42","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#define-la-identidad","content":"`L`: localidad."},"1701":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-43","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#define-la-identidad","content":"`O`: organización."},"1702":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-44","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#define-la-identidad","content":"`OU`: unidad organizativa."},"1703":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-45","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#define-la-identidad","content":"El identificador interno de la CA se genera automáticamente y no se puede modificar."},"1704":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-46","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#configura-validez-y-usos","content":"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida."},"1705":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-47","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#configura-validez-y-usos","content":"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores."},"1706":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-48","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#crea-y-verifica","content":"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar."},"1707":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-49","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#crea-y-verifica","content":"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades."},"1708":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-50","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","content":"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil."},"1709":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-51","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","content":"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta."},"1710":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-52","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#importa-una-ca-externa","content":"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA."},"1711":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-53","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#selecciona-el-motor","content":"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS."},"1712":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-54","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#carga-el-material","content":"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos."},"1713":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-55","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","content":"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles."},"1714":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-56","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#verifica-la-importación","content":"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar."},"1715":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-57","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#verifica-la-importación","content":"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado."},"1716":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-58","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Abre una CA desde el inventario para consultar:"},"1717":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-59","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Estado y periodo de validez."},"1718":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-60","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Certificado y cadena en formato PEM."},"1719":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-61","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Número de certificados activos, expirados y revocados."},"1720":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-62","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Certificados emitidos en **Issued Certificates**."},"1721":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-63","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"CRL vinculada a la autoridad."},"1722":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-64","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Metadatos y motor criptográfico asociado."},"1723":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-65","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","content":"Puedes filtrar el inventario por nombre, estado y tipo de CA."},"1724":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-66","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#emite-certificados","content":"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados."},"1725":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-67","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#emite-certificados","content":"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar."},"1726":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-68","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#emite-certificados","content":"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada."},"1727":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-69","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#emite-certificados","content":"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación."},"1728":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-70","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#revoca-una-ca","content":"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada."},"1729":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-71","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#evalúa-el-impacto","content":"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario."},"1730":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-72","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#inicia-la-revocación","content":"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`."},"1731":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-73","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#confirma-la-identidad","content":"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**."},"1732":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-74","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#comprueba-la-publicación","content":"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre."},"1733":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities-75","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#comprueba-la-publicación","content":"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita."},"1734":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"page","content":"Perfiles de certificado","breadcrumbs":["Docs","Plataforma","PKI","Claves, autoridades y certificados"],"tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles"},"1735":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-0","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","content":"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas."},"1736":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-1","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#qué-controla-un-perfil","content":"Qué controla un perfil"},"1737":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-2","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#validez","content":"Validez"},"1738":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-3","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","content":"Certificado de CA o certificado final"},"1739":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-4","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","content":"Key Usage y Extended Key Usage"},"1740":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-5","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#sujeto","content":"Sujeto"},"1741":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-6","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#extensiones-de-la-csr","content":"Extensiones de la CSR"},"1742":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-7","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"Restricciones criptográficas"},"1743":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-8","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Precedencia del perfil"},"1744":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-9","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#crea-un-perfil","content":"Crea un perfil"},"1745":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-10","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#define-un-único-propósito","content":"Define un único propósito"},"1746":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-11","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#elige-la-validez","content":"Elige la validez"},"1747":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-12","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","content":"Fija usos y sujeto"},"1748":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-13","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#restringe-las-claves","content":"Restringe las claves"},"1749":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-14","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#asócialo-y-prueba","content":"Asócialo y prueba"},"1750":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-15","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#ejemplos-de-diseño","content":"Ejemplos de diseño"},"1751":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-16","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#cambios-y-eliminación","content":"Cambios y eliminación"},"1752":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-17","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","content":"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta."},"1753":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-18","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","content":"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos."},"1754":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-19","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#validez","content":"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada."},"1755":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-20","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#validez","content":"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable."},"1756":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-21","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","content":"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas."},"1757":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-22","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","content":"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`."},"1758":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-23","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","content":"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil."},"1759":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-24","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","content":"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas."},"1760":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-25","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#sujeto","content":"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado."},"1761":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-26","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#extensiones-de-la-csr","content":"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR."},"1762":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-27","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#extensiones-de-la-csr","content":"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR."},"1763":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-28","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"La aplicación criptográfica puede:"},"1764":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-29","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"permitir o bloquear claves RSA;"},"1765":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-30","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"limitar los tamaños RSA admitidos;"},"1766":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-31","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"permitir o bloquear claves ECDSA;"},"1767":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-32","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"limitar los tamaños o curvas ECDSA admitidos."},"1768":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-33","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#restricciones-criptográficas","content":"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza."},"1769":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-34","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA."},"1770":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-35","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Operación"},"1771":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-36","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Primera opción"},"1772":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-37","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Segunda opción"},"1773":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-38","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Si no hay ninguna"},"1774":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-39","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Firma directa con una CA"},"1775":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-40","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"`issuance_profile` incluido en la solicitud"},"1776":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-41","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"`issuance_profile_id` de la solicitud"},"1777":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-42","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Perfil predeterminado de la CA (`profile_id`)."},"1778":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-43","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Emisión mediante DMS"},"1779":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-44","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"`settings.issuance_profile_id`"},"1780":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-45","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"`settings.issuance_profile` incluido en el DMS"},"1781":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-46","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Perfil predeterminado de la CA de enrolamiento."},"1782":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-47","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR."},"1783":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-48","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","content":"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS."},"1784":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-49","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#define-un-único-propósito","content":"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos."},"1785":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-50","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#elige-la-validez","content":"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA."},"1786":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-51","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","content":"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita."},"1787":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-52","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#restringe-las-claves","content":"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos."},"1788":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-53","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#asócialo-y-prueba","content":"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`."},"1789":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-54","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#asócialo-y-prueba","content":"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto."},"1790":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-55","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#ejemplos-de-diseño","content":"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo."},"1791":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-56","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#ejemplos-de-diseño","content":"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes."},"1792":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-57","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#ejemplos-de-diseño","content":"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes."},"1793":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-58","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#ejemplos-de-diseño","content":"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor."},"1794":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-59","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#cambios-y-eliminación","content":"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa."},"1795":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles-60","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#cambios-y-eliminación","content":"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior."},"1796":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","type":"page","content":"Validación de certificados","breadcrumbs":["Docs","Plataforma","PKI","Validación"],"tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation"},"1797":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-0","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","content":"Comprueba cadena, identidad, usos y revocación desde el consumidor."},"1798":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-1","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Antes de consultar el estado"},"1799":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-2","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#elige-un-mecanismo","content":"Elige un mecanismo"},"1800":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-3","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","content":"Comprueba el comportamiento del consumidor"},"1801":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-4","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","content":"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación."},"1802":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-5","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Verifica estos criterios juntos:"},"1803":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-6","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Comprobación"},"1804":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-7","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Resultado necesario"},"1805":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-8","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Cadena y firma"},"1806":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-9","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Cadena válida hasta una raíz instalada deliberadamente en el consumidor."},"1807":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-10","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Fechas"},"1808":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-11","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena."},"1809":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-12","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Identidad"},"1810":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-13","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","content":"Nombre, SAN o identificador corresponden al interlocutor esperado."},"1811":{"id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation-14","page_id":"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation","tags"