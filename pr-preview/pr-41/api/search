-preview/pr-41/deployment/troubleshooting#i-cannot-sign-in","content":"I cannot sign in"},"378":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-9","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Everything returns 403 or 5xx"},"379":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-10","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/deployment/troubleshooting#a-pod-is-not-ready","content":"A pod is not Ready"},"380":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-11","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/deployment/troubleshooting#events-are-not-arriving","content":"Events are not arriving"},"381":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-12","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/deployment/troubleshooting#observability","content":"Observability"},"382":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-13","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting","content":"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics."},"383":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-14","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#reproduce-a-single-operation","content":"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion."},"384":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-15","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#separate-client-gateway-and-service","content":"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency."},"385":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-16","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#review-kubernetes-status","content":"Locate unready pods, restarts, recent events and the state of the release."},"386":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-17","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#query-the-affected-service","content":"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine."},"387":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-18","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#validate-the-result-from-outside","content":"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses."},"388":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-19","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#minimal-evidence-collection","content":"Replace the placeholders with your real release, namespace and deployment."},"389":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-20","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#minimal-evidence-collection","content":"Also run the chart's connectivity test:"},"390":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-21","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#minimal-evidence-collection","content":"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow."},"391":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-22","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#minimal-evidence-collection","content":"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails."},"392":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-23","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#i-cannot-sign-in","content":"If you receive a 401:"},"393":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-24","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#i-cannot-sign-in","content":"check that the UI's OIDC authority is reachable from the browser;"},"394":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-25","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#i-cannot-sign-in","content":"verify issuer, audience and expiration of the token;"},"395":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-26","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#i-cannot-sign-in","content":"confirm the Gateway can fetch the keys from the JWKS URI;"},"396":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-27","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#i-cannot-sign-in","content":"check that the provider's public and internal routes point to the same realm."},"397":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-28","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#i-cannot-sign-in","content":"If login succeeds but the APIs return 403:"},"398":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-29","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#i-cannot-sign-in","content":"inspect the token's real claims;"},"399":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-30","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#i-cannot-sign-in","content":"confirm they match an active principal;"},"400":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-31","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#i-cannot-sign-in","content":"review the policies granted to that principal;"},"401":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-32","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#i-cannot-sign-in","content":"verify that authz reaches PostgreSQL and its JWKS."},"402":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-33","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#i-cannot-sign-in","content":"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap."},"403":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-34","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#everything-returns-403-or-5xx","content":"External authorization fails closed by default. If authz is unavailable, protected routes are blocked."},"404":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-35","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Locate the authz pod and Service."},"405":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-36","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Check /health, logs and its database connection."},"406":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-37","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Verify the DNS and port configured in externalAuthorization."},"407":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-38","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Check the check route is /v1/ext\\_authz/check."},"408":{"id":"/docs/pr-preview/pr-41/deployment/troubleshooting-39","page_id":"/docs/pr-preview/pr-41/deployment/troubleshooting","tags"