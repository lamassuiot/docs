-41/deployment/self-hosted/overview-40","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"PersistentVolumeClaims required by the default local KMS and VA storage"},"350":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-41","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one"},"351":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-42","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Optional integrations"},"352":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-43","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity"},"353":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-44","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The observability backends, cloud credentials and production HSM or external key service"},"354":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-45","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network."},"355":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-46","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service."},"356":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-47","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#how-the-deployment-fits-together","content":"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway."},"357":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-48","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#how-the-deployment-fits-together","content":"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it."},"358":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-49","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#platform-requirements","content":"Kubernetes 1.24 or newer"},"359":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-50","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#platform-requirements","content":"Helm 3.2 or newer"},"360":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-51","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#platform-requirements","content":"Envoy Gateway 1.8 or newer and a `GatewayClass`"},"361":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-52","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#platform-requirements","content":"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources"},"362":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-53","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#platform-requirements","content":"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration"},"363":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-54","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#platform-requirements","content":"a load-balancer implementation or another deliberate path from clients to the Gateway"},"364":{"id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview-55","page_id":"/docs/pr-preview/pr-41/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/deployment/self-hosted/overview#platform-requirements","content":"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer."},"365":{"id":"/docs/pr-preview/pr-41/deployment/self-ho