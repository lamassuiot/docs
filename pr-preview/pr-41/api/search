dministration/audit-logs#a-reproducible-investigation","content":"A reproducible investigation"},"660":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-6","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#bound-the-interval","content":"Bound the interval"},"661":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-7","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#identify-the-operation","content":"Identify the operation"},"662":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-8","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#attribute-the-principal","content":"Attribute the principal"},"663":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-9","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#compare-intent-and-result","content":"Compare intent and result"},"664":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-10","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#follow-the-effect","content":"Follow the effect"},"665":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-11","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#periodic-verification","content":"Periodic verification"},"666":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-12","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs","content":"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error."},"667":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-13","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#what-an-event-contains","content":"The audit body includes:"},"668":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-14","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#what-an-event-contains","content":"input: data received by the operation;"},"669":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-15","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#what-an-event-contains","content":"has\\_error: whether the service returned an error;"},"670":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-16","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#what-an-event-contains","content":"output: produced result or error message;"},"671":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-17","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#what-an-event-contains","content":"principals: identifiers of the principals that matched the request."},"672":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-18","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#what-an-event-contains","content":"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type."},"673":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-19","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#what-an-event-contains","content":"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes."},"674":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-20","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#coverage","content":"The backend applies auditing to mutations of:"},"675":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-21","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#coverage","content":"authorities, certificates and issuance profiles;"},"676":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-22","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#coverage","content":"keys and KMS engines;"},"677":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-23","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#coverage","content":"devices and identities;"},"678":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-24","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#coverage","content":"DMSs and enrollment operations;"},"679":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-25","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#coverage","content":"validation functions and CRL;"},"680":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-26","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#coverage","content":"principals, policies and authorization grants."},"681":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-27","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#coverage","content":"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation."},"682":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-28","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#publication-and-persistence","content":"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file."},"683":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-29","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#publication-and-persistence","content":"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization."},"684":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-30","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#publication-and-persistence","content":"Design the consumer to:"},"685":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-31","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#publication-and-persistence","content":"subscribe to the audit.# types and also to operation types ending in .error;"},"686":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-32","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#publication-and-persistence","content":"keep the complete CloudEvent unmodified;"},"687":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-33","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#publication-and-persistence","content":"record the ingestion time and detect duplicates by ID;"},"688":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-34","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/administration/audit-logs#publication-and-persistence","content":"encrypt in transit and at rest;"},"689":{"id":"/docs/pr-preview/pr-41/platform/administration/audit-logs-35","page_id":"/docs/pr-preview/pr-41/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/plat