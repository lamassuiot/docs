s/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","content":"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave."},"2307":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-1","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#antes-de-empezar","content":"Antes de empezar"},"2308":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-2","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#ruta-recomendada","content":"Ruta recomendada"},"2309":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-3","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#resultado-esperado","content":"Resultado esperado"},"2310":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-4","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","content":"Continúa según tu objetivo"},"2311":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-5","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","content":"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente."},"2312":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-6","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#antes-de-empezar","content":"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue."},"2313":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-7","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#antes-de-empezar","content":"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada."},"2314":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-8","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#antes-de-empezar","content":"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores."},"2315":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-9","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#antes-de-empezar","content":"OpenSSL 3.x en el equipo desde el que verificarás los archivos."},"2316":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-10","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#antes-de-empezar","content":"Un directorio de trabajo con acceso restringido para custodiar la clave descargada."},"2317":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-11","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#ruta-recomendada","content":"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />"},"2318":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-12","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#ruta-recomendada","content":"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />"},"2319":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-13","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#ruta-recomendada","content":"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar."},"2320":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-14","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#ruta-recomendada","content":"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs."},"2321":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-15","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#resultado-esperado","content":"Archivo o recurso"},"2322":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-16","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#resultado-esperado","content":"Comprobación"},"2323":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-17","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#resultado-esperado","content":"CA raíz activa y `ca.pem`"},"2324":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-18","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#resultado-esperado","content":"Es un certificado de CA, está vigente y su autofirma se comprueba."},"2325":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-19","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#resultado-esperado","content":"Certificado final y `device.crt`"},"2326":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-20","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#resultado-esperado","content":"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`."},"2327":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-21","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#resultado-esperado","content":"Clave privada `device.key`"},"2328":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-22","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#resultado-esperado","content":"Su clave pública coincide con la incluida en `device.crt`."},"2329":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-23","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#resultado-esperado","content":"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación."},"2330":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-24","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","content":"Para operar certificados, continúa con Certificados y Validación."},"2331":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-25","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","content":"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS."},"2332":{"id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview-26","page_id":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","content":"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST."},"2333":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","type":"page","content":"Resolución de problemas PKI","breadcrumbs":["Docs","Plataforma","PKI","Resolución de problemas"],"tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting"},"2334":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-0","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","content":"Diagnostica emisión de certificados, OCSP y CRL."},"2335":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-1","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"La emisión falla"},"2336":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-2","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"OCSP o CRL no reflejan un cambio"},"2337":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-3","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","content":"La cadena se valida pero la conexión falla"},"2338":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-4","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","content":"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico."},"2339":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-5","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","content":"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST."},"2340":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-6","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Comprobación"},"2341":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-7","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Qué revisar"},"2342":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-8","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Siguiente paso"},"2343":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-9","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"CA"},"2344":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-10","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Existe, está activa y sus fechas son utilizables."},"2345":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-11","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Autoridades."},"2346":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-12","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Clave"},"2347":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-13","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"El registro tiene clave privada utilizable y el motor puede firmar."},"2348":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-14","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor."},"2349":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-15","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"CSR"},"2350":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-16","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"PEM correcto y firma verificable."},"2351":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-17","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"`openssl req -in request.csr -noout -verify -text`."},"2352":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-18","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Perfil"},"2353":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-19","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos."},"2354":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-20","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta."},"2355":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-21","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Resultado"},"2356":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-22","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Sujeto, SAN, usos y fechas adecuados."},"2357":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-23","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor."},"2358":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-24","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA."},"2359":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-25","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","content":"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación."},"2360":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-26","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"Revisa cada frontera por separado:"},"2361":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-27","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición."},"2362":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-28","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia."},"2363":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-29","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado."},"2364":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-30","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue."},"2365":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-31","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva."},"2366":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-32","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación."},"2367":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-33","page_id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","content":"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo."},"2368":{"id":"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting-34","page_id":"/docs/pr-preview/pr-41/es/platform/pki/t