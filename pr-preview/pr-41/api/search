-41/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#if-the-result-fails","content":"Downloaded CA and required intermediate chain."},"2296":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate-43","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#if-the-result-fails","content":"Validity fails"},"2297":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate-44","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#if-the-result-fails","content":"Certificate and CA dates, and the computer's clock."},"2298":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate-45","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#if-the-result-fails","content":"Public-key digests differ"},"2299":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate-46","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#if-the-result-fails","content":"Certificate and key files from the same issuance."},"2300":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate-47","page_id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#if-the-result-fails","content":"See PKI diagnostics to narrow an issuance failure."},"2301":{"id":"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate-48","page_id":"/docs/pr-preview/pr-