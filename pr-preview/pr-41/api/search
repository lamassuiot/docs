ontent":"Azure Key Vault"},"2022":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-9","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"Inventario de claves"},"2023":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-10","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#crear-o-importar-claves","content":"Crear o importar claves"},"2024":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-11","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"Generar un nuevo par de claves"},"2025":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-12","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#importar-un-par-existente","content":"Importar un par existente"},"2026":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-13","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#operaciones-sobre-una-clave","content":"Operaciones sobre una clave"},"2027":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-14","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#ver-detalles","content":"Ver detalles"},"2028":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-15","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#firmar-y-verificar","content":"Firmar y verificar"},"2029":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-16","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#sign","content":"Sign"},"2030":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-17","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#verify","content":"Verify"},"2031":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-18","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#generar-un-csr","content":"Generar un CSR"},"2032":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-19","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#firma-local-con-pkcs11","content":"Firma local con PKCS#11"},"2033":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-20","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#antes-de-eliminar-una-clave","content":"Antes de eliminar una clave"},"2034":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-21","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management","content":"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI."},"2035":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-22","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management","content":"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema."},"2036":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-23","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#qué-resuelve-el-kms","content":"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto."},"2037":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-24","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#qué-resuelve-el-kms","content":"En la práctica, permite:"},"2038":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-25","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Generar nuevos pares de claves desde Lamassu IoT."},"2039":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-26","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Importar claves creadas externamente."},"2040":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-27","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Delegar la custodia y las operaciones criptográficas en motores externos."},"2041":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-28","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación."},"2042":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-29","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#motores-criptográficos","content":"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada."},"2043":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-30","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#motores-criptográficos","content":"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios."},"2044":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-31","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#motores-criptográficos","content":"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración."},"2045":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-32","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#file-system","content":"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos."},"2046":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-33","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#hashicorp-vault","content":"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue."},"2047":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-34","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#hashicorp-vault","content":"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue."},"2048":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-35","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#aws-secrets-manager","content":"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM."},"2049":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-36","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#aws-kms","content":"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas."},"2050":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-37","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#pkcs11","content":"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware."},"2051":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-38","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#azure-key-vault","content":"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias."},"2052":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-39","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#azure-key-vault","content":"Lamassu muestra en la consola el listado de motores habilitados."},"2053":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-40","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#azure-key-vault","content":"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar."},"2054":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-41","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#azure-key-vault","content":"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA."},"2055":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-42","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas."},"2056":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-43","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"La tabla incluye los siguientes campos:"},"2057":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-44","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"**Name**: nombre descriptivo de la clave."},"2058":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-45","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256."},"2059":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-46","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"**Strength**: indicador visual de fortaleza criptográfica."},"2060":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-47","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública."},"2061":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-48","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"**Crypto Engine**: motor criptográfico que custodia la clave."},"2062":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-49","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"**Aliases**: nombres alternativos asociados a la clave."},"2063":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-50","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"**Tags**: etiquetas para clasificación y búsqueda."},"2064":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-51","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"**Related Entities**: certificados u otras entidades vinculadas a esa clave."},"2065":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-52","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"Desde esta vista también se accede a las acciones más habituales:"},"2066":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-53","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"**View Details** para consultar metadatos, identificadores y relaciones."},"2067":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-54","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada."},"2068":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-55","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"**Sign / Verify** para probar operaciones criptográficas sobre la clave."},"2069":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-56","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","content":"**Delete Key** para eliminar la clave del sistema."},"2070":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-57","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#crear-o-importar-claves","content":"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación."},"2071":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-58","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados."},"2072":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-59","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:"},"2073":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-60","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Key Name**: nombre único y descriptivo."},"2074":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-61","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Crypto Engine**: motor que custodiará la clave."},"2075":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-62","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Key Type** y **Key Size**: algoritmo y tamaño o curva."},"2076":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-63","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Tags**: metadatos para clasificar la clave."},"2077":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-64","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Metadata**: información adicional para usos avanzados."},"2078":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-65","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#importar-un-par-existente","content":"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción."},"2079":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-66","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-41/es/platform/pki/key-management#importar-un-par-existente","content":"Cuando tienes una clave privada exportable y el motor de destino admite su importación."},"2080":{"id":"/docs/pr-preview/pr-41/es/platform/pki/key-management-67","page_id":"/docs/pr-preview/pr-41/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-pre