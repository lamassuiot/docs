aws-marketplace#before-you-begin","Before you begin",{"_2944":18,"_25897":15,"_5":26239,"_18081":42121,"_24513":42122,"_2467":42123},[],"/docs/pr-preview/pr-41/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2944":19,"_25897":15,"_5":26239,"_18081":42125,"_24513":42126,"_2467":42127},[],"/docs/pr-preview/pr-41/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2944":20,"_25897":15,"_5":26239,"_18081":42129,"_24513":42130,"_2467":42131},[],"/docs/pr-preview/pr-41/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2944":21,"_25897":15,"_5":26239,"_18081":42133,"_24513":42134,"_2467":42135},[],"/docs/pr-preview/pr-41/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2944":22,"_25897":15,"_5":26239,"_18081":42137,"_24513":42138,"_2467":42139},[],"/docs/pr-preview/pr-41/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2944":23,"_25897":15,"_5":26239,"_18081":42141,"_24513":42142,"_2467":42143},[],"/docs/pr-preview/pr-41/deployment/aws-marketplace#next-step","Next step",{"_2944":24,"_25897":15,"_18081":42145,"_5":17976,"_24513":15,"_2467":42146},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2944":25,"_25897":15,"_18081":42148,"_5":17976,"_24513":42118,"_2467":42149},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2944":26,"_25897":15,"_18081":42151,"_5":17976,"_24513":42118,"_2467":42152},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2944":27,"_25897":15,"_18081":42154,"_5":17976,"_24513":42118,"_2467":42155},[],"A security group allowing the necessary endpoints.",{"_2944":28,"_25897":15,"_18081":42157,"_5":17976,"_24513":42122,"_2467":42158},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2944":29,"_25897":15,"_18081":42160,"_5":17976,"_24513":42122,"_2467":42161},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2944":30,"_25897":15,"_18081":42163,"_5":17976,"_24513":42122,"_2467":42164},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2944":31,"_25897":15,"_18081":42166,"_5":17976,"_24513":42126,"_2467":42167},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2944":32,"_25897":15,"_18081":42169,"_5":17976,"_24513":42130,"_2467":42170},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2944":33,"_25897":15,"_18081":42172,"_5":17976,"_24513":42134,"_2467":42173},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2944":34,"_25897":15,"_18081":42175,"_5":17976,"_24513":42138,"_2467":42176},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2944":35,"_25897":15,"_18081":42178,"_5":17976,"_24513":42142,"_2467":42179},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2944":36,"_25897":36,"_5":12672,"_2467":42181,"_26242":42182,"_18081":42183,"_24513":36},"Deploy Lamassu",[42109,42110],[],{"_2944":37,"_25897":36,"_18081":42185,"_5":17976,"_24513":36,"_2467":42186},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2944":38,"_25897":36,"_5":26239,"_18081":42188,"_24513":42189,"_2467":42190},[],"/docs/pr-preview/pr-41/deployment/overview#choose-a-model","Choose a model",{"_2944":39,"_25897":36,"_5":26239,"_18081":42192,"_24513":42193,"_2467":42194},[],"/docs/pr-preview/pr-41/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2944":40,"_25897":36,"_5":26239,"_18081":42196,"_24513":42197,"_2467":42198},[],"/docs/pr-preview/pr-41/deployment/overview#after-deployment","After deployment",{"_2944":41,"_25897":36,"_18081":42200,"_5":17976,"_24513":36,"_2467":42201},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2944":42,"_25897":36,"_18081":42203,"_5":17976,"_24513":42189,"_2467":42204},[],"Model",{"_2944":43,"_25897":36,"_18081":42206,"_5":17976,"_24513":42189,"_2467":42207},[],"Recommended for",{"_2944":44,"_25897":36,"_18081":42209,"_5":17976,"_24513":42189,"_2467":42210},[],"Who operates the infrastructure",{"_2944":45,"_25897":36,"_18081":42212,"_5":17976,"_24513":42189,"_2467":42213},[],"Starting point",{"_2944":46,"_25897":36,"_18081":42215,"_5":17976,"_24513":42189,"_2467":42216},[],"Kubernetes self-managed",{"_2944":47,"_25897":36,"_18081":42218,"_5":17976,"_24513":42189,"_2467":42219},[],"Production, regulated environments and custom deployments",{"_2944":48,"_25897":36,"_18081":42221,"_5":17976,"_24513":42189,"_2467":42222},[],"Your team",{"_2944":49,"_25897":36,"_18081":42224,"_5":17976,"_24513":42189,"_2467":42225},[],"Helm or Fastlane",{"_2944":50,"_25897":36,"_18081":42227,"_5":17976,"_24513":42189,"_2467":42228},[],"AWS Marketplace",{"_2944":51,"_25897":36,"_18081":42230,"_5":17976,"_24513":42189,"_2467":42231},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2944":52,"_25897":36,"_18081":42233,"_5":17976,"_24513":42189,"_2467":42222},[],{"_2944":53,"_25897":36,"_18081":42235,"_5":17976,"_24513":42189,"_2467":42236},[],"Preconfigured image on EC2",{"_2944":54,"_25897":36,"_18081":42238,"_5":17976,"_24513":42189,"_2467":42239},[],"SaaS",{"_2944":55,"_25897":36,"_18081":42241,"_5":17976,"_24513":42189,"_2467":42242},[],"Teams that want to use the platform without operating it",{"_2944":56,"_25897":36,"_18081":42244,"_5":17976,"_24513":42189,"_2467":42245},[],"Lamassu",{"_2944":57,"_25897":36,"_18081":42247,"_5":17976,"_24513":42189,"_2467":42248},[],"Managed subscription",{"_2944":58,"_25897":36,"_18081":42250,"_5":17976,"_24513":42189,"_2467":42251},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2944":59,"_25897":36,"_18081":42253,"_5":17976,"_24513":42189,"_2467":42254},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2944":60,"_25897":36,"_18081":42256,"_5":17976,"_24513":42189,"_2467":42257},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2944":61,"_25897":36,"_18081":42259,"_5":17976,"_24513":42193,"_2467":42260},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2944":62,"_25897":36,"_18081":42262,"_5":17976,"_24513":42197,"_2467":42263},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2944":63,"_25897":63,"_5":12672,"_2467":42265,"_26242":42266,"_18081":42267,"_24513":63},"Use Lamassu as SaaS",[42109,42110,42111],[],{"_2944":64,"_25897":63,"_18081":42269,"_5":17976,"_24513":63,"_2467":42270},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2944":65,"_25897":63,"_5":26239,"_18081":42272,"_24513":42273,"_2467":42274},[],"/docs/pr-preview/pr-41/deployment/saas#what-the-service-manages","What the service manages",{"_2944":66,"_25897":63,"_5":26239,"_18081":42276,"_24513":42277,"_2467":42278},[],"/docs/pr-preview/pr-41/deployment/saas#plans","Plans",{"_2944":67,"_25897":63,"_5":26239,"_18081":42280,"_24513":42281,"_2467":42282},[],"/docs/pr-preview/pr-41/deployment/saas#request-access","Request access",{"_2944":68,"_25897":63,"_18081":42284,"_5":17976,"_24513":63,"_2467":42285},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2944":69,"_25897":63,"_18081":42287,"_5":17976,"_24513":42273,"_2467":42288},[],"Platform availability and maintenance.",{"_2944":70,"_25897":63,"_18081":42290,"_5":17976,"_24513":42273,"_2467":42291},[],"Automatic backups.",{"_2944":71,"_25897":63,"_18081":42293,"_5":17976,"_24513":42273,"_2467":42294},[],"Version upgrades.",{"_2944":72,"_25897":63,"_18081":42296,"_5":17976,"_24513":42273,"_2467":42297},[],"Technical support and SLA according to your plan.",{"_2944":73,"_25897":63,"_18081":42299,"_5":17976,"_24513":42277,"_2467":42300},[],"Plan",{"_2944":74,"_25897":63,"_18081":42302,"_5":17976,"_24513":42277,"_2467":42303},[],"Devices",{"_2944":75,"_25897":63,"_18081":42305,"_5":17976,"_24513":42277,"_2467":42306},[],"Support",{"_2944":76,"_25897":63,"_18081":42308,"_5":17976,"_24513":42277,"_2467":42309},[],"SLA",{"_2944":77,"_25897":63,"_18081":42311,"_5":17976,"_24513":42277,"_2467":42312},[],"Starter",{"_2944":78,"_25897":63,"_18081":42314,"_5":17976,"_24513":42277,"_2467":42315},[],"Up to 1,000",{"_2944":79,"_25897":63,"_18081":42317,"_5":17976,"_24513":42277,"_2467":42318},[],"Email",{"_2944":80,"_25897":63,"_18081":42320,"_5":17976,"_24513":42277,"_2467":42321},[],"99.5 %",{"_2944":81,"_25897":63,"_18081":42323,"_5":17976,"_24513":42277,"_2467":42324},[],"Professional",{"_2944":82,"_25897":63,"_18081":42326,"_5":17976,"_24513":42277,"_2467":42327},[],"Up to 10,000",{"_2944":83,"_25897":63,"_18081":42329,"_5":17976,"_24513":42277,"_2467":42330},[],"Email and chat",{"_2944":84,"_25897":63,"_18081":42332,"_5":17976,"_24513":42277,"_2467":42333},[],"99.9 %",{"_2944":85,"_25897":63,"_18081":42335,"_5":17976,"_24513":42277,"_2467":42336},[],"Enterprise",{"_2944":86,"_25897":63,"_18081":42338,"_5":17976,"_24513":42277,"_2467":42339},[],"Unlimited",{"_2944":87,"_25897":63,"_18081":42341,"_5":17976,"_24513":42277,"_2467":42342},[],"Dedicated",{"_2944":88,"_25897":63,"_18081":42344,"_5":17976,"_24513":42277,"_2467":42345},[],"99.99 %",{"_2944":89,"_25897":63,"_18081":42347,"_5":17976,"_24513":42281,"_2467":42348},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2944":90,"_25897":63,"_18081":42350,"_5":17976,"_24513":42281,"_2467":42351},[],"When you receive your instance's credentials, continue with Get started.",{"_2944":91,"_25897":91,"_5":12672,"_2467":42353,"_26242":42354,"_18081":42355,"_24513":91},"Fastlane",[42109,42110,42216],[],{"_2944":92,"_25897":91,"_18081":42357,"_5":17976,"_24513":91,"_2467":42358},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2944":93,"_25897":91,"_5":26239,"_18081":42360,"_24513":42361,"_2467":42362},[],"/docs/pr-preview/pr-41/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2944":94,"_25897":91,"_5":26239,"_18081":42364,"_24513":42365,"_2467":42366},[],"/docs/pr-preview/pr-41/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2944":95,"_25897":91,"_5":26239,"_18081":42368,"_24513":42369,"_2467":42119},[],"/docs/pr-preview/pr-41/deployment/self-hosted/fastlane#before-you-begin",{"_2944":96,"_25897":91,"_5":26239,"_18081":42371,"_24513":42372,"_2467":42373},[],"/docs/pr-preview/pr-41/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2944":97,"_25897":91,"_5":26239,"_18081":42375,"_24513":42376,"_2467":42377},[],"/docs/pr-preview/pr-41/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2944":98,"_25897":91,"_5":26239,"_18081":42379,"_24513":42380,"_2467":42381},[],"/docs/pr-preview/pr-41/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2944":99,"_25897":91,"_5":26239,"_18081":42383,"_24513":42384,"_2467":42385},[],"/docs/pr-preview/pr-41/deployment/self-hosted/fastlane#development-mode","Development mode",{"_2944":100,"_25897":91,"_5":26239,"_18081":42387,"_24513":42388,"_2467":42389},[],"/docs/pr-preview/pr-41/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2944":101,"_25897":91,"_5":26239,"_18081":42391,"_24513":42392,"_2467":42393},[],"/docs/pr-preview/pr-41/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2944":102,"_25897":91,"_5":26239,"_18081":42395,"_24513":42396,"_2467":42397},[],"/docs/pr-preview/pr-41/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2944":103,"_25897":91,"_5":26239,"_18081":42399,"_24513":42400,"_2467":42401},[],"/docs/pr-preview/pr-41/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2944":104,"_25897":91,"_18081":42403,"_5":17976,"_24513":42361,"_2467":42404},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2944":105,"_25897":91,"_18081":42406,"_5":17976,"_24513":42361,"_2467":42407},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2944":106,"_25897":91,"_18081":42409,"_5":17976,"_24513":42365,"_2467":42410},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2944":107,"_25897":91,"_18081":42412,"_5":17976,"_24513":42365,"_2467":42413},[],"Fastlane installs or configures",{"_2944":108,"_25897":91,"_18081":42415,"_5":17976,"_24513":42365,"_2467":42416},[],"You still provide",{"_2944":109,"_25897":91,"_18081":42418,"_5":17976,"_24513":42365,"_2467":42419},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2944":110,"_25897":91,"_18081":42421,"_5":17976,"_24513":42365,"_2467":42422},[],"The Kubernetes cluster, nodes and persistent storage",{"_2944":111,"_25897":91,"_18081":42424,"_5":17976,"_24513":42365,"_2467":42425},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2944":112,"_25897":91,"_18081":42427,"_5":17976,"_24513":42365,"_2467":42428},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2944":113,"_25897":91,"_18081":42430,"_5":17976,"_24513":42365,"_2467":42431},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2944":114,"_25897":91,"_18081":42433,"_5":17976,"_24513":42365,"_2467":42434},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2944":115,"_25897":91,"_18081":42436,"_5":17976,"_24513":42365,"_2467":42437},[],"Optional observability and lab HSM components",{"_2944":116,"_25897":91,"_18081":42439,"_5":17976,"_24513":42365,"_2467":42440},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2944":117,"_25897":91,"_18081":42442,"_5":17976,"_24513":42365,"_2467":42443},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2944":118,"_25897":91,"_18081":42445,"_5":17976,"_24513":42369,"_2467":42446},[],"You need:",{"_2944":119,"_25897":91,"_18081":42448,"_5":17976,"_24513":42369,"_2467":42449},[],"an existing Kubernetes cluster",{"_2944":120,"_25897":91,"_18081":42451,"_5":17976,"_24513":42369,"_2467":42452},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2944":121,"_25897":91,"_18081":42454,"_5":17976,"_24513":42369,"_2467":42455},[],"`yq`",{"_2944":122,"_25897":91,"_18081":42457,"_5":17976,"_24513":42369,"_2467":20443},[],{"_2944":123,"_25897":91,"_18081":42459,"_5":17976,"_24513":42369,"_2467":42460},[],"`jq` only when using `--sample-data` or `--development`",{"_2944":124,"_25897":91,"_18081":42462,"_5":17976,"_24513":42369,"_2467":42463},[],"free external ports 80 and 443 on a single-node K3s host",{"_2944":125,"_25897":91,"_18081":42465,"_5":17976,"_24513":42369,"_2467":42466},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2944":126,"_25897":91,"_18081":42468,"_5":17976,"_24513":42369,"_2467":42469},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2944":127,"_25897":91,"_18081":42471,"_5":17976,"_24513":42372,"_2467":42472},[],"Run the script from a clone of the Helm repository:",{"_2944":128,"_25897":91,"_18081":42474,"_5":17976,"_24513":42372,"_2467":42475},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2944":129,"_25897":91,"_18081":42477,"_5":17976,"_24513":42376,"_2467":42478},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2944":130,"_25897":91,"_18081":42480,"_5":17976,"_24513":42376,"_2467":42481},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2944":131,"_25897":91,"_18081":42483,"_5":17976,"_24513":42376,"_2467":42484},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2944":132,"_25897":91,"_18081":42486,"_5":17976,"_24513":42376,"_2467":42487},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2944":133,"_25897":91,"_18081":42489,"_5":17976,"_24513":42380,"_2467":42490},[],"Option",{"_2944":134,"_25897":91,"_18081":42492,"_5":17976,"_24513":42380,"_2467":42493},[],"Default",{"_2944":135,"_25897":91,"_18081":42495,"_5":17976,"_24513":42380,"_2467":42496},[],"Purpose",{"_2944":136,"_25897":91,"_18081":42498,"_5":17976,"_24513":42380,"_2467":42499},[],"`-h`, `--help`",{"_2944":137,"_25897":91,"_18081":42501,"_5":17976,"_24513":42380,"_2467":42502},[],"—",{"_2944":138,"_25897":91,"_18081":42504,"_5":17976,"_24513":42380,"_2467":42505},[],"Show help",{"_2944":139,"_25897":91,"_18081":42507,"_5":17976,"_24513":42380,"_2467":42508},[],"`-c`, `--context`",{"_2944":140,"_25897":91,"_18081":42510,"_5":17976,"_24513":42380,"_2467":42511},[],"current context",{"_2944":141,"_25897":91,"_18081":42513,"_5":17976,"_24513":42380,"_2467":42514},[],"Select the kubeconfig context for kubectl and Helm",{"_2944":142,"_25897":91,"_18081":42516,"_5":17976,"_24513":42380,"_2467":42517},[],"`-n`, `--non-interactive`",{"_2944":143,"_25897":91,"_18081":42519,"_5":17976,"_24513":42380,"_2467":5533},[],{"_2944":144,"_25897":91,"_18081":42521,"_5":17976,"_24513":42380,"_2467":42522},[],"Skip prompts and generate dependency credentials",{"_2944":145,"_25897":91,"_18081":42524,"_5":17976,"_24513":42380,"_2467":42525},[],"`-ns`, `--namespace`",{"_2944":146,"_25897":91,"_18081":42527,"_5":17976,"_24513":42380,"_2467":42528},[],"`lamassu-dev`",{"_2944":147,"_25897":91,"_18081":42530,"_5":17976,"_24513":42380,"_2467":42531},[],"Namespace for the installation",{"_2944":148,"_25897":91,"_18081":42533,"_5":17976,"_24513":42380,"_2467":42534},[],"`-d`, `--domain`",{"_2944":149,"_25897":91,"_18081":42536,"_5":17976,"_24513":42380,"_2467":42537},[],"`dev.lamassu.io`",{"_2944":150,"_25897":91,"_18081":42539,"_5":17976,"_24513":42380,"_2467":42540},[],"Domain used by the UI, OIDC and certificate",{"_2944":151,"_25897":91,"_18081":42542,"_5":17976,"_24513":42380,"_2467":42543},[],"`-v`, `--version`",{"_2944":152,"_25897":91,"_18081":42545,"_5":17976,"_24513":42380,"_2467":12909},[],{"_2944":153,"_25897":91,"_18081":42547,"_5":17976,"_24513":42380,"_2467":42548},[],"Lamassu chart version",{"_2944":154,"_25897":91,"_18081":42550,"_5":17976,"_24513":42380,"_2467":42551},[],"`--https-port`",{"_2944":155,"_25897":91,"_18081":42553,"_5":17976,"_24513":42380,"_2467":42554},[],"`443`",{"_2944":156,"_25897":91,"_18081":42556,"_5":17976,"_24513":42380,"_2467":42557},[],"Gateway HTTPS listener port",{"_2944":157,"_25897":91,"_18081":42559,"_5":17976,"_24513":42380,"_2467":42560},[],"`--http-port`",{"_2944":158,"_25897":91,"_18081":42562,"_5":17976,"_24513":42380,"_2467":42563},[],"`80`",{"_2944":159,"_25897":91,"_18081":42565,"_5":17976,"_24513":42380,"_2467":42566},[],"Gateway HTTP listener port",{"_2944":160,"_25897":91,"_18081":42568,"_5":17976,"_24513":42380,"_2467":42569},[],"`--tls-crt`",{"_2944":161,"_25897":91,"_18081":42571,"_5":17976,"_24513":42380,"_2467":42502},[],{"_2944":162,"_25897":91,"_18081":42573,"_5":17976,"_24513":42380,"_2467":42574},[],"PEM certificate for downstream TLS",{"_2944":163,"_25897":91,"_18081":42576,"_5":17976,"_24513":42380,"_2467":42577},[],"`--tls-key`",{"_2944":164,"_25897":91,"_18081":42579,"_5":17976,"_24513":42380,"_2467":42502},[],{"_2944":165,"_25897":91,"_18081":42581,"_5":17976,"_24513":42380,"_2467":42582},[],"PEM private key for downstream TLS",{"_2944":166,"_25897":91,"_18081":42584,"_5":17976,"_24513":42380,"_2467":42585},[],"`-l`, `--local-chart-path`",{"_2944":167,"_25897":91,"_18081":42587,"_5":17976,"_24513":42380,"_2467":42588},[],"repository chart",{"_2944":168,"_25897":91,"_18081":42590,"_5":17976,"_24513":42380,"_2467":42591},[],"Use an unpacked local Lamassu chart",{"_2944":169,"_25897":91,"_18081":42593,"_5":17976,"_24513":42380,"_2467":42594},[],"`-ip`, `--gateway-ip`",{"_2944":170,"_25897":91,"_18081":42596,"_5":17976,"_24513":42380,"_2467":7500},[],{"_2944":171,"_25897":91,"_18081":42598,"_5":17976,"_24513":42380,"_2467":42599},[],"Override the address written to `gateway.addresses`",{"_2944":172,"_25897":91,"_18081":42601,"_5":17976,"_24513":42380,"_2467":42602},[],"`--otel`",{"_2944":173,"_25897":91,"_18081":42604,"_5":17976,"_24513":42380,"_2467":5533},[],{"_2944":174,"_25897":91,"_18081":42606,"_5":17976,"_24513":42380,"_2467":42607},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2944":175,"_25897":91,"_18081":42609,"_5":17976,"_24513":42380,"_2467":42610},[],"`--development`",{"_2944":176,"_25897":91,"_18081":42612,"_5":17976,"_24513":42380,"_2467":5533},[],{"_2944":177,"_25897":91,"_18081":42614,"_5":17976,"_24513":42380,"_2467":42615},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_2944":178,"_25897":91,"_18081":42617,"_5":17976,"_24513":42380,"_2467":42618},[],"`--sample-data`",{"_2944":179,"_25897":91,"_18081":42620,"_5":17976,"_24513":42380,"_2467":5533},[],{"_2944":180,"_25897":91,"_18081":42622,"_5":17976,"_24513":42380,"_2467":42623},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2944":181,"_25897":91,"_18081":42625,"_5":17976,"_24513":42380,"_2467":42626},[],"`--with-hsm`",{"_2944":182,"_25897":91,"_18081":42628,"_5":17976,"_24513":42380,"_2467":5533},[],{"_2944":183,"_25897":91,"_18081":42630,"_5":17976,"_24513":42380,"_2467":42631},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2944":184,"_25897":91,"_18081":42633,"_5":17976,"_24513":42380,"_2467":42634},[],"`--softhsm-chart-path`",{"_2944":185,"_25897":91,"_18081":42636,"_5":17976,"_24513":42380,"_2467":42637},[],"`./charts/softhsm`",{"_2944":186,"_25897":91,"_18081":42639,"_5":17976,"_24513":42380,"_2467":42640},[],"Use a different local SoftHSM chart",{"_2944":187,"_25897":91,"_18081":42642,"_5":17976,"_24513":42380,"_2467":42643},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2944":188,"_25897":91,"_18081":42645,"_5":17976,"_24513":42384,"_2467":42646},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_2944":189,"_25897":91,"_18081":42648,"_5":17976,"_24513":42384,"_2467":42649},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_2944":190,"_25897":91,"_18081":42651,"_5":17976,"_24513":42384,"_2467":42652},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_2944":191,"_25897":91,"_18081":42654,"_5":17976,"_24513":42384,"_2467":42655},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_2944":192,"_25897":91,"_18081":42657,"_5":17976,"_24513":42384,"_2467":42658},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_2944":193,"_25897":91,"_18081":42660,"_5":17976,"_24513":42384,"_2467":42661},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_2944":194,"_25897":91,"_18081":42663,"_5":17976,"_24513":42388,"_2467":42664},[],"Fastlane:",{"_2944":195,"_25897":91,"_18081":42666,"_5":17976,"_24513":42388,"_2467":42667},[],"validates local tools and the selected cluster",{"_2944":196,"_25897":91,"_18081":42669,"_5":17976,"_24513":42388,"_2467":42670},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2944":197,"_25897":91,"_18081":42672,"_5":17976,"_24513":42388,"_2467":42673},[],"creates the namespace",{"_2944":198,"_25897":91,"_18081":42675,"_5":17976,"_24513":42388,"_2467":42676},[],"installs PostgreSQL and creates the required databases",{"_2944":199,"_25897":91,"_18081":42678,"_5":17976,"_24513":42388,"_2467":42679},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2944":200,"_25897":91,"_18081":42681,"_5":17976,"_24513":42388,"_2467":42682},[],"installs RabbitMQ",{"_2944":201,"_25897":91,"_18081":42684,"_5":17976,"_24513":42388,"_2467":42685},[],"optionally installs observability and lab HSM components",{"_2944":202,"_25897":91,"_18081":42687,"_5":17976,"_24513":42388,"_2467":42688},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2944":203,"_25897":91,"_18081":42690,"_5":17976,"_24513":42388,"_2467":42691},[],"optionally loads sample data",{"_2944":204,"_25897":91,"_18081":42693,"_5":17976,"_24513":42388,"_2467":42694},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2944":205,"_25897":91,"_18081":42696,"_5":17976,"_24513":42392,"_2467":42697},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2944":206,"_25897":91,"_18081":42699,"_5":17976,"_24513":42392,"_2467":42700},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2944":207,"_25897":91,"_18081":42702,"_5":17976,"_24513":42396,"_2467":42703},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_2944":208,"_25897":91,"_18081":42705,"_5":17976,"_24513":42396,"_2467":42706},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2944":209,"_25897":91,"_18081":42708,"_5":17976,"_24513":42396,"_2467":42709},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2944":210,"_25897":91,"_18081":42711,"_5":17976,"_24513":42400,"_2467":42712},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2944":211,"_25897":211,"_5":12672,"_2467":42714,"_26242":42715,"_18081":42716,"_24513":211},"Install with Helm",[42109,42110,42216],[],{"_2944":212,"_25897":211,"_18081":42718,"_5":17976,"_24513":211,"_2467":42719},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2944":213,"_25897":211,"_5":26239,"_18081":42721,"_24513":42722,"_2467":42723},[],"/docs/pr-preview/pr-41/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2944":214,"_25897":211,"_5":26239,"_18081":42725,"_24513":42726,"_2467":42119},[],"/docs/pr-preview/pr-41/deployment/self-hosted/helm#before-you-begin",{"_2944":215,"_25897":211,"_5":26239,"_18081":42728,"_24513":42729,"_2467":42730},[],"/docs/pr-preview/pr-41/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2944":216,"_25897":211,"_5":26239,"_18081":42732,"_24513":42733,"_2467":42734},[],"/docs/pr-preview/pr-41/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2944":217,"_25897":211,"_5":26239,"_18081":42736,"_24513":42737,"_2467":42738},[],"/docs/pr-preview/pr-41/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2944":218,"_25897":211,"_5":26239,"_18081":42740,"_24513":42741,"_2467":42742},[],"/docs/pr-preview/pr-41/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2944":219,"_25897":211,"_5":26239,"_18081":42744,"_24513":42745,"_2467":42746},[],"/docs/pr-preview/pr-41/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2944":220,"_25897":211,"_5":26239,"_18081":42748,"_24513":42749,"_2467":42750},[],"/docs/pr-preview/pr-41/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2944":221,"_25897":211,"_5":26239,"_18081":42752,"_24513":42753,"_2467":42754},[],"/docs/pr-preview/pr-41/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2944":222,"_25897":211,"_18081":42756,"_5":17976,"_24513":42722,"_2467":42757},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2944":223,"_25897":211,"_18081":42759,"_5":17976,"_24513":42726,"_2467":42760},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2944":224,"_25897":211,"_18081":42762,"_5":17976,"_24513":42726,"_2467":42763},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2944":225,"_25897":211,"_18081":42765,"_5":17976,"_24513":42726,"_2467":42766},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2944":226,"_25897":211,"_18081":42768,"_5":17976,"_24513":42726,"_2467":42769},[],"a reachable RabbitMQ broker and credentials",{"_2944":227,"_25897":211,"_18081":42771,"_5":17976,"_24513":42726,"_2467":42772},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2944":228,"_25897":211,"_18081":42774,"_5":17976,"_24513":42726,"_2467":42775},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2944":229,"_25897":211,"_18081":42777,"_5":17976,"_24513":42726,"_2467":42778},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2944":230,"_25897":211,"_18081":42780,"_5":17976,"_24513":42726,"_2467":42781},[],"a StorageClass and an external traffic design",{"_2944":231,"_25897":211,"_18081":42783,"_5":17976,"_24513":42726,"_2467":42784},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2944":232,"_25897":211,"_18081":42786,"_5":17976,"_24513":42726,"_2467":42787},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2944":233,"_25897":211,"_18081":42789,"_5":17976,"_24513":42726,"_2467":42790},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2944":234,"_25897":211,"_18081":42792,"_5":17976,"_24513":42729,"_2467":42793},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2944":235,"_25897":211,"_18081":42795,"_5":17976,"_24513":42729,"_2467":42796},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2944":236,"_25897":211,"_18081":42798,"_5":17976,"_24513":42729,"_2467":42799},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2944":237,"_25897":211,"_18081":42801,"_5":17976,"_24513":42733,"_2467":42802},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2944":238,"_25897":211,"_18081":42804,"_5":17976,"_24513":42733,"_2467":42805},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2944":239,"_25897":211,"_18081":42807,"_5":17976,"_24513":42733,"_2467":42808},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2944":240,"_25897":211,"_18081":42810,"_5":17976,"_24513":42737,"_2467":42811},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2944":241,"_25897":211,"_18081":42813,"_5":17976,"_24513":42741,"_2467":42814},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2944":242,"_25897":211,"_18081":42816,"_5":17976,"_24513":42741,"_2467":42817},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2944":243,"_25897":211,"_18081":42819,"_5":17976,"_24513":42741,"_2467":42820},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2944":244,"_25897":211,"_18081":42822,"_5":17976,"_24513":42741,"_2467":42823},[],"See Access control for the principal and policy model.",{"_2944":245,"_25897":211,"_18081":42825,"_5":17976,"_24513":42745,"_2467":42826},[],"To install a local checkout instead:",{"_2944":246,"_25897":211,"_18081":42828,"_5":17976,"_24513":42749,"_2467":42829},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2944":247,"_25897":211,"_18081":42831,"_5":17976,"_24513":42749,"_2467":42832},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2944":248,"_25897":211,"_18081":42834,"_5":17976,"_24513":42753,"_2467":42835},[],"Before going live, review:",{"_2944":249,"_25897":211,"_18081":42837,"_5":17976,"_24513":42753,"_2467":42838},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2944":250,"_25897":211,"_18081":42840,"_5":17976,"_24513":42753,"_2467":42841},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2944":251,"_25897":211,"_18081":42843,"_5":17976,"_24513":42753,"_2467":42844},[],"shared VA storage before increasing VA replicas",{"_2944":252,"_25897":211,"_18081":42846,"_5":17976,"_24513":42753,"_2467":42847},[],"managed OIDC roles and removal of evaluation credentials",{"_2944":253,"_25897":211,"_18081":42849,"_5":17976,"_24513":42753,"_2467":42850},[],"a trusted TLS issuer or externally managed certificate",{"_2944":254,"_25897":211,"_18081":42852,"_5":17976,"_24513":42753,"_2467":42853},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2944":255,"_25897":211,"_18081":42855,"_5":17976,"_24513":42753,"_2467":42856},[],"SMTP, observability and alert delivery",{"_2944":256,"_25897":211,"_18081":42858,"_5":17976,"_24513":42753,"_2467":42859},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2944":257,"_25897":211,"_18081":42861,"_5":17976,"_24513":42753,"_2467":42862},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2944":258,"_25897":258,"_5":12672,"_2467":42864,"_26242":42865,"_18081":42866,"_24513":258},"Expose the Gateway",[42109,42110,42216],[],{"_2944":259,"_25897":258,"_18081":42868,"_5":17976,"_24513":258,"_2467":42869},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2944":260,"_25897":258,"_5":26239,"_18081":42871,"_24513":42872,"_2467":42873},[],"/docs/pr-preview/pr-41/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2944":261,"_25897":258,"_5":26239,"_18081":42875,"_24513":42876,"_2467":42877},[],"/docs/pr-preview/pr-41/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2944":262,"_25897":258,"_5":26239,"_18081":42879,"_24513":42880,"_2467":42881},[],"/docs/pr-preview/pr-41/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2944":263,"_25897":258,"_5":26239,"_18081":42883,"_24513":42884,"_2467":42885},[],"/docs/pr-preview/pr-41/deployment/self-hosted/networking#k3s","K3s",{"_2944":264,"_25897":258,"_5":26239,"_18081":42887,"_24513":42888,"_2467":42889},[],"/docs/pr-preview/pr-41/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2944":265,"_25897":258,"_5":26239,"_18081":42891,"_24513":42892,"_2467":42893},[],"/docs/pr-preview/pr-41/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2944":266,"_25897":258,"_5":26239,"_18081":42895,"_24513":42896,"_2467":42897},[],"/docs/pr-preview/pr-41/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2944":267,"_25897":258,"_5":26239,"_18081":42899,"_24513":42900,"_2467":42901},[],"/docs/pr-preview/pr-41/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2944":268,"_25897":258,"_5":26239,"_18081":42903,"_24513":42904,"_2467":42905},[],"/docs/pr-preview/pr-41/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_2944":269,"_25897":258,"_5":26239,"_18081":42907,"_24513":42908,"_2467":42909},[],"/docs/pr-preview/pr-41/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2944":270,"_25897":258,"_18081":42911,"_5":17976,"_24513":42872,"_2467":42912},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2944":271,"_25897":258,"_18081":42914,"_5":17976,"_24513":42872,"_2467":42915},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2944":272,"_25897":258,"_18081":42917,"_5":17976,"_24513":42876,"_2467":42918},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2944":273,"_25897":258,"_18081":42920,"_5":17976,"_24513":42876,"_2467":42921},[],"Set it only when:",{"_2944":274,"_25897":258,"_18081":42923,"_5":17976,"_24513":42876,"_2467":42924},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2944":275,"_25897":258,"_18081":42926,"_5":17976,"_24513":42876,"_2467":42927},[],"that address is allocated to this Gateway",{"_2944":276,"_25897":258,"_18081":42929,"_5":17976,"_24513":42876,"_2467":42930},[],"the surrounding network already routes traffic for it to the cluster",{"_2944":277,"_25897":258,"_18081":42932,"_5":17976,"_24513":42876,"_2467":42933},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2944":278,"_25897":258,"_18081":42935,"_5":17976,"_24513":42876,"_2467":42936},[],"Keep these two settings separate:",{"_2944":279,"_25897":258,"_18081":42938,"_5":17976,"_24513":42876,"_2467":42939},[],"`gateway.addresses` requests an address for the Gateway.",{"_2944":280,"_25897":258,"_18081":42941,"_5":17976,"_24513":42876,"_2467":42942},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2944":281,"_25897":258,"_18081":42944,"_5":17976,"_24513":42876,"_2467":42945},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2944":282,"_25897":258,"_18081":42947,"_5":17976,"_24513":42880,"_2467":42948},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2944":283,"_25897":258,"_18081":42950,"_5":17976,"_24513":42880,"_2467":42951},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2944":284,"_25897":258,"_18081":42953,"_5":17976,"_24513":42884,"_2467":42954},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2944":285,"_25897":258,"_18081":42956,"_5":17976,"_24513":42884,"_2467":42957},[],"For the recommended design:",{"_2944":286,"_25897":258,"_18081":42959,"_5":17976,"_24513":42884,"_2467":42960},[],"Use only one externally exposed Lamassu Gateway.",{"_2944":287,"_25897":258,"_18081":42962,"_5":17976,"_24513":42884,"_2467":42963},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2944":288,"_25897":258,"_18081":42965,"_5":17976,"_24513":42884,"_2467":42966},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2944":289,"_25897":258,"_18081":42968,"_5":17976,"_24513":42884,"_2467":42969},[],"Point DNS at the VM's reachable address.",{"_2944":290,"_25897":258,"_18081":42971,"_5":17976,"_24513":42884,"_2467":42972},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2944":291,"_25897":258,"_18081":42974,"_5":17976,"_24513":42888,"_2467":42975},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2944":292,"_25897":258,"_18081":42977,"_5":17976,"_24513":42892,"_2467":42978},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2944":293,"_25897":258,"_18081":42980,"_5":17976,"_24513":42892,"_2467":42981},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2944":294,"_25897":258,"_18081":42983,"_5":17976,"_24513":42896,"_2467":42984},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2944":295,"_25897":258,"_18081":42986,"_5":17976,"_24513":42896,"_2467":42987},[],"Requirement",{"_2944":296,"_25897":258,"_18081":42989,"_5":17976,"_24513":42896,"_2467":42990},[],"Recommended design",{"_2944":297,"_25897":258,"_18081":42992,"_5":17976,"_24513":42896,"_2467":42993},[],"Consequence",{"_2944":298,"_25897":258,"_18081":42995,"_5":17976,"_24513":42896,"_2467":42996},[],"Several Lamassu URLs or services",{"_2944":299,"_25897":258,"_18081":42998,"_5":17976,"_24513":42896,"_2467":42999},[],"One Gateway with multiple routes",{"_2944":300,"_25897":258,"_18081":43001,"_5":17976,"_24513":42896,"_2467":43002},[],"One IP and one proxy fleet; this is the chart default",{"_2944":301,"_25897":258,"_18081":43004,"_5":17976,"_24513":42896,"_2467":43005},[],"Independent Gateways and separate external IPs",{"_2944":302,"_25897":258,"_18081":43007,"_5":17976,"_24513":42896,"_2467":43008},[],"One VIP per Gateway",{"_2944":303,"_25897":258,"_18081":43010,"_5":17976,"_24513":42896,"_2467":43011},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2944":304,"_25897":258,"_18081":43013,"_5":17976,"_24513":42896,"_2467":43014},[],"Independent Gateways on one node and one IP",{"_2944":305,"_25897":258,"_18081":43016,"_5":17976,"_24513":42896,"_2467":43017},[],"Use different external ports",{"_2944":306,"_25897":258,"_18081":43019,"_5":17976,"_24513":42896,"_2467":43020},[],"Clients must include non-standard ports",{"_2944":307,"_25897":258,"_18081":43022,"_5":17976,"_24513":42896,"_2467":43023},[],"Separate TLS/mTLS termination behind one IP",{"_2944":308,"_25897":258,"_18081":43025,"_5":17976,"_24513":42896,"_2467":43026},[],"Front-door SNI routing to internal Gateways",{"_2944":309,"_25897":258,"_18081":43028,"_5":17976,"_24513":42896,"_2467":43029},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2944":310,"_25897":258,"_18081":43031,"_5":17976,"_24513":42896,"_2467":43032},[],"Separate Gateway resources but shared proxy infrastructure",{"_2944":311,"_25897":258,"_18081":43034,"_5":17976,"_24513":42896,"_2467":43035},[],"Envoy merged-Gateway mode",{"_2944":312,"_25897":258,"_18081":43037,"_5":17976,"_24513":42896,"_2467":43038},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2944":313,"_25897":258,"_18081":43040,"_5":17976,"_24513":42896,"_2467":43041},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2944":314,"_25897":258,"_18081":43043,"_5":17976,"_24513":42896,"_2467":43044},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2944":315,"_25897":258,"_18081":43046,"_5":17976,"_24513":42896,"_2467":43047},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2944":316,"_25897":258,"_18081":43049,"_5":17976,"_24513":42896,"_2467":43050},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2944":317,"_25897":258,"_18081":43052,"_5":17976,"_24513":42900,"_2467":43053},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2944":318,"_25897":258,"_18081":43055,"_5":17976,"_24513":42900,"_2467":43056},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2944":319,"_25897":258,"_18081":43058,"_5":17976,"_24513":42900,"_2467":43059},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2944":320,"_25897":258,"_18081":43061,"_5":17976,"_24513":42900,"_2467":43062},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2944":321,"_25897":258,"_18081":43064,"_5":17976,"_24513":42900,"_2467":43065},[],"If none of those are possible, use different external ports or change the external network design.",{"_2944":322,"_25897":258,"_18081":43067,"_5":17976,"_24513":42904,"_2467":43068},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_2944":323,"_25897":258,"_18081":43070,"_5":17976,"_24513":42904,"_2467":43071},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_2944":324,"_25897":258,"_18081":43073,"_5":17976,"_24513":42908,"_2467":43074},[],"Check, in order:",{"_2944":325,"_25897":258,"_18081":43076,"_5":17976,"_24513":42908,"_2467":43077},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2944":326,"_25897":258,"_18081":43079,"_5":17976,"_24513":42908,"_2467":43080},[],"Its status contains the expected address.",{"_2944":327,"_25897":258,"_18081":43082,"_5":17976,"_24513":42908,"_2467":43083},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2944":328,"_25897":258,"_18081":43085,"_5":17976,"_24513":42908,"_2467":43086},[],"Port 443 reaches that address from the client network.",{"_2944":329,"_25897":258,"_18081":43088,"_5":17976,"_24513":42908,"_2467":43089},[],"DNS resolves to the externally reachable endpoint.",{"_2944":330,"_25897":258,"_18081":43091,"_5":17976,"_24513":42908,"_2467":43092},[],"The certificate contains the DNS name or IP used by the client.",{"_2944":331,"_25897":258,"_18081":43094,"_5":17976,"_24513":42908,"_2467":43095},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2944":332,"_25897":332,"_5":12672,"_2467":42216,"_26242":43097,"_18081":43098,"_24513":332},[42109,42110,42216],[],{"_2944":333,"_25897":332,"_18081":43100,"_5":17976,"_24513":332,"_2467":43101},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2944":334,"_25897":332,"_5":26239,"_18081":43103,"_24513":43104,"_2467":43105},[],"/docs/pr-preview/pr-41/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2944":335,"_25897":332,"_5":26239,"_18081":43107,"_24513":43108,"_2467":43109},[],"/docs/pr-preview/pr-41/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2944":336,"_25897":332,"_5":26239,"_18081":43111,"_24513":43112,"_2467":43113},[],"/docs/pr-preview/pr-41/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2944":337,"_25897":332,"_5":26239,"_18081":43115,"_24513":43116,"_2467":43117},[],"/docs/pr-preview/pr-41/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2944":338,"_25897":332,"_5":26239,"_18081":43119,"_24513":43120,"_2467":43121},[],"/docs/pr-preview/pr-41/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2944":339,"_25897":332,"_5":26239,"_18081":43123,"_24513":43124,"_2467":43125},[],"/docs/pr-preview/pr-41/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2944":340,"_25897":332,"_18081":43127,"_5":17976,"_24513":43104,"_2467":43128},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2944":341,"_25897":332,"_18081":43130,"_5":17976,"_24513":43108,"_2467":43131},[],"Workflow",{"_2944":342,"_25897":332,"_18081":43133,"_5":17976,"_24513":43108,"_2467":43134},[],"Use it for",{"_2944":343,"_25897":332,"_18081":43136,"_5":17976,"_24513":43108,"_2467":43137},[],"What it installs",{"_2944":344,"_25897":332,"_18081":43139,"_5":17976,"_24513":43108,"_2467":43140},[],"Helm",{"_2944":345,"_25897":332,"_18081":43142,"_5":17976,"_24513":43108,"_2467":43143},[],"Production and controlled environments",{"_2944":346,"_25897":332,"_18081":43145,"_5":17976,"_24513":43108,"_2467":43146},[],"Lamassu services and Gateway API resources",{"_2944":347,"_25897":332,"_18081":43148,"_5":17976,"_24513":43108,"_2467":42353},[],{"_2944":348,"_25897":332,"_18081":43150,"_5":17976,"_24513":43108,"_2467":43151},[],"Evaluation, demos, CI and small lab clusters",{"_2944":349,"_25897":332,"_18081":43153,"_5":17976,"_24513":43108,"_2467":43154},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2944":350,"_25897":332,"_18081":43156,"_5":17976,"_24513":43112,"_2467":43157},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2944":351,"_25897":332,"_18081":43159,"_5":17976,"_24513":43112,"_2467":43160},[],"Area",{"_2944":352,"_25897":332,"_18081":43162,"_5":17976,"_24513":43112,"_2467":43163},[],"The Lamassu chart provides",{"_2944":353,"_25897":332,"_18081":43165,"_5":17976,"_24513":43112,"_2467":43166},[],"You provide",{"_2944":354,"_25897":332,"_18081":43168,"_5":17976,"_24513":43112,"_2467":43169},[],"Lamassu applications",{"_2944":355,"_25897":332,"_18081":43171,"_5":17976,"_24513":43112,"_2467":43172},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2944":356,"_25897":332,"_18081":43174,"_5":17976,"_24513":43112,"_2467":43175},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2944":357,"_25897":332,"_18081":43177,"_5":17976,"_24513":43112,"_2467":43178},[],"PostgreSQL data",{"_2944":358,"_25897":332,"_18081":43180,"_5":17976,"_24513":43112,"_2467":43181},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2944":359,"_25897":332,"_18081":43183,"_5":17976,"_24513":43112,"_2467":43184},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2944":360,"_25897":332,"_18081":43186,"_5":17976,"_24513":43112,"_2467":43187},[],"Messaging",{"_2944":361,"_25897":332,"_18081":43189,"_5":17976,"_24513":43112,"_2467":43190},[],"RabbitMQ connection configuration for the Lamassu services",{"_2944":362,"_25897":332,"_18081":43192,"_5":17976,"_24513":43112,"_2467":43193},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2944":363,"_25897":332,"_18081":43195,"_5":17976,"_24513":43112,"_2467":43196},[],"Identity",{"_2944":364,"_25897":332,"_18081":43198,"_5":17976,"_24513":43112,"_2467":43199},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2944":365,"_25897":332,"_18081":43201,"_5":17976,"_24513":43112,"_2467":43202},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2944":366,"_25897":332,"_18081":43204,"_5":17976,"_24513":43112,"_2467":43205},[],"External routing",{"_2944":367,"_25897":332,"_18081":43207,"_5":17976,"_24513":43112,"_2467":43208},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2944":368,"_25897":332,"_18081":43210,"_5":17976,"_24513":43112,"_2467":43211},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2944":369,"_25897":332,"_18081":43213,"_5":17976,"_24513":43112,"_2467":43214},[],"TLS",{"_2944":370,"_25897":332,"_18081":43216,"_5":17976,"_24513":43112,"_2467":43217},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2944":371,"_25897":332,"_18081":43219,"_5":17976,"_24513":43112,"_2467":43220},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2944":372,"_25897":332,"_18081":43222,"_5":17976,"_24513":43112,"_2467":43223},[],"Persistent application data",{"_2944":373,"_25897":332,"_18081":43225,"_5":17976,"_24513":43112,"_2467":43226},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2944":374,"_25897":332,"_18081":43228,"_5":17976,"_24513":43112,"_2467":43229},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2944":375,"_25897":332,"_18081":43231,"_5":17976,"_24513":43112,"_2467":43232},[],"Optional integrations",{"_2944":376,"_25897":332,"_18081":43234,"_5":17976,"_24513":43112,"_2467":43235},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2944":377,"_25897":332,"_18081":43237,"_5":17976,"_24513":43112,"_2467":43238},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2944":378,"_25897":332,"_18081":43240,"_5":17976,"_24513":43112,"_2467":43241},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2944":379,"_25897":332,"_18081":43243,"_5":17976,"_24513":43112,"_2467":43244},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2944":380,"_25897":332,"_18081":43246,"_5":17976,"_24513":43116,"_2467":43247},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2944":381,"_25897":332,"_18081":43249,"_5":17976,"_24513":43116,"_2467":43250},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2944":382,"_25897":332,"_18081":43252,"_5":17976,"_24513":43120,"_2467":43253},[],"Kubernetes 1.24 or newer",{"_2944":383,"_25897":332,"_18081":43255,"_5":17976,"_24513":43120,"_2467":43256},[],"Helm 3.2 or newer",{"_2944":384,"_25897":332,"_18081":43258,"_5":17976,"_24513":43120,"_2467":43259},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2944":385,"_25897":332,"_18081":43261,"_5":17976,"_24513":43120,"_2467":43262},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2944":386,"_25897":332,"_18081":43264,"_5":17976,"_24513":43120,"_2467":43265},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2944":387,"_25897":332,"_18081":43267,"_5":17976,"_24513":43120,"_2467":43268},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2944":388,"_25897":332,"_18081":43270,"_5":17976,"_24513":43120,"_2467":43271},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_2944":389,"_25897":332,"_18081":43273,"_5":17976,"_24513":43124,"_2467":43274},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2944":390,"_25897":332,"_18081":43276,"_5":17976,"_24513":43124,"_2467":43277},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2944":391,"_25897":332,"_18081":43279,"_5":17976,"_24513":43124,"_2467":43280},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2944":392,"_25897":392,"_5":12672,"_2467":43282,"_26242":43283,"_18081":43285,"_24513":392},"Deployment troubleshooting",[42109,42110,43284],"Operations",[],{"_2944":393,"_25897":392,"_18081":43287,"_5":17976,"_24513":392,"_2467":43288},[],"Diagnose access, service health and infrastructure dependencies.",{"_2944":394,"_25897":392,"_5":26239,"_18081":43290,"_24513":43291,"_2467":43292},[],"/docs/pr-preview/pr-41/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2944":395,"_25897":392,"_5":26239,"_18081":43294,"_24513":43295,"_2467":43296},[],"/docs/pr-preview/pr-41/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2944":396,"_25897":392,"_5":26239,"_18081":43298,"_24513":43299,"_2467":43300},[],"/docs/pr-preview/pr-41/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2944":397,"_25897":392,"_5":26239,"_18081":43302,"_24513":43303,"_2467":43304},[],"/docs/pr-preview/pr-41/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2944":398,"_25897":392,"_5":26239,"_18081":43306,"_24513":43307,"_2467":43308},[],"/docs/pr-preview/pr-41/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2944":399,"_25897":392,"_5":26239,"_18081":43310,"_24513":43311,"_2467":43312},[],"/docs/pr-preview/pr-41/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2944":400,"_25897":392,"_5":26239,"_18081":43314,"_24513":43315,"_2467":43316},[],"/docs/pr-preview/pr-41/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2944":401,"_25897":392,"_5":26239,"_18081":43318,"_24513":43319,"_2467":43320},[],"/docs/pr-preview/pr-41/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2944":402,"_25897":392,"_5":26239,"_18081":43322,"_24513":43323,"_2467":43324},[],"/docs/pr-preview/pr-41/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2944":403,"_25897":392,"_5":26239,"_18081":43326,"_24513":43327,"_2467":43328},[],"/docs/pr-preview/pr-41/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2944":404,"_25897":392,"_5":26239,"_18081":43330,"_24513":43331,"_2467":43332},[],"/docs/pr-preview/pr-41/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2944":405,"_25897":392,"_5":26239,"_18081":43334,"_24513":43335,"_2467":43336},[],"/docs/pr-preview/pr-41/deployment/troubleshooting#observability","Observability",{"_2944":406,"_25897":392,"_18081":43338,"_5":17976,"_24513":392,"_2467":43339},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2944":407,"_25897":392,"_18081":43341,"_5":17976,"_24513":43295,"_2467":43342},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2944":408,"_25897":392,"_18081":43344,"_5":17976,"_24513":43299,"_2467":43345},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2944":409,"_25897":392,"_18081":43347,"_5":17976,"_24513":43303,"_2467":43348},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2944":410,"_25897":392,"_18081":43350,"_5":17976,"_24513":43307,"_2467":43351},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2944":411,"_25897":392,"_18081":43353,"_5":17976,"_24513":43311,"_2467":43354},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2944":412,"_25897":392,"_18081":43356,"_5":17976,"_24513":43315,"_2467":43357},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2944":413,"_25897":392,"_18081":43359,"_5":17976,"_24513":43315,"_2467":43360},[],"Also run the chart's connectivity test:",{"_2944":414,"_25897":392,"_18081":43362,"_5":17976,"_24513":43315,"_2467":43363},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2944":415,"_25897":392,"_18081":43365,"_5":17976,"_24513":43315,"_2467":43366},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2944":416,"_25897":392,"_18081":43368,"_5":17976,"_24513":43319,"_2467":43369},[],"If you receive a 401:",{"_2944":417,"_25897":392,"_18081":43371,"_5":17976,"_24513":43319,"_2467":43372},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2944":418,"_25897":392,"_18081":43374,"_5":17976,"_24513":43319,"_2467":43375},[],"verify issuer, audience and expiration of the token;",{"_2944":419,"_25897":392,"_18081":43377,"_5":17976,"_24513":43319,"_2467":43378},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2944":420,"_25897":392,"_18081":43380,"_5":17976,"_24513":43319,"_2467":43381},[],"check that the provider's public and internal routes point to the same realm.",{"_2944":421,"_25897":392,"_18081":43383,"_5":17976,"_24513":43319,"_2467":43384},[],"If login succeeds but the APIs return 403:",{"_2944":422,"_25897":392,"_18081":43386,"_5":17976,"_24513":43319,"_2467":43387},[],"inspect the token's real claims;",{"_2944":423,"_25897":392,"_18081":43389,"_5":17976,"_24513":43319,"_2467":43390},[],"confirm they match an active principal;",{"_2944":424,"_25897":392,"_18081":43392,"_5":17976,"_24513":43319,"_2467":43393},[],"review the policies granted to that principal;",{"_2944":425,"_25897":392,"_18081":43395,"_5":17976,"_24513":43319,"_2467":43396},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2944":426,"_25897":392,"_18081":43398,"_5":17976,"_24513":43319,"_2467":43399},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2944":427,"_25897":392,"_18081":43401,"_5":17976,"_24513":43323,"_2467":43402},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2944":428,"_25897":392,"_18081":43404,"_5":17976,"_24513":43323,"_2467":43405},[],"Locate the authz pod and Service.",{"_2944":429,"_25897":392,"_18081":43407,"_5":17976,"_24513":43323,"_2467":43408},[],"Check /health, logs and its database connection.",{"_2944":430,"_25897":392,"_18081":43410,"_5":17976,"_24513":43323,"_2467":43411},[],"Verify the DNS and port configured in externalAuthorization.",{"_2944":431,"_25897":392,"_18081":43413,"_5":17976,"_24513":43323,"_2467":43414},[],"Check the check route is /v1/ext\\_authz/check.",{"_2944":432,"_25897":392,"_18081":43416,"_5":17976,"_24513":43323,"_2467":43417},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2944":433,"_25897":392,"_18081":43419,"_5":17976,"_24513":43327,"_2467":43420},[],"Review kubectl describe pod first. Common causes are:",{"_2944":434,"_25897":392,"_18081":43422,"_5":17976,"_24513":43327,"_2467":43423},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2944":435,"_25897":392,"_18081":43425,"_5":17976,"_24513":43327,"_2467":43426},[],"unbound persistent volume;",{"_2944":436,"_25897":392,"_18081":43428,"_5":17976,"_24513":43327,"_2467":43429},[],"inaccessible image or incorrect pull policy;",{"_2944":437,"_25897":392,"_18081":43431,"_5":17976,"_24513":43327,"_2467":43432},[],"invalid cryptographic engine configuration;",{"_2944":438,"_25897":392,"_18081":43434,"_5":17976,"_24513":43327,"_2467":43435},[],"CPU or memory limits set too low;",{"_2944":439,"_25897":392,"_18081":43437,"_5":17976,"_24513":43327,"_2467":43438},[],"an incomplete prior migration.",{"_2944":440,"_25897":392,"_18081":43440,"_5":17976,"_24513":43327,"_2467":43441},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2944":441,"_25897":392,"_18081":43443,"_5":17976,"_24513":43327,"_2467":43444},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2944":442,"_25897":392,"_18081":43446,"_5":17976,"_24513":43327,"_2467":43447},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_2944":443,"_25897":392,"_18081":43449,"_5":17976,"_24513":43331,"_2467":43450},[],"Domain and audit events depend on the bus publisher:",{"_2944":444,"_25897":392,"_18081":43452,"_5":17976,"_24513":43331,"_2467":43453},[],"verify it is enabled in the emitting service;",{"_2944":445,"_25897":392,"_18081":43455,"_5":17976,"_24513":43331,"_2467":43456},[],"check AMQP connectivity and credentials;",{"_2944":446,"_25897":392,"_18081":43458,"_5":17976,"_24513":43331,"_2467":43459},[],"review exchange, routing key, queues and consumers;",{"_2944":447,"_25897":392,"_18081":43461,"_5":17976,"_24513":43331,"_2467":43462},[],"inspect dead-letter queues;",{"_2944":448,"_25897":392,"_18081":43464,"_5":17976,"_24513":43331,"_2467":43465},[],"alert on orphan durable queues and backlog growth.",{"_2944":449,"_25897":392,"_18081":43467,"_5":17976,"_24513":43331,"_2467":43468},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2944":450,"_25897":392,"_18081":43470,"_5":17976,"_24513":43335,"_2467":43471},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2944":451,"_25897":392,"_18081":43473,"_5":17976,"_24513":43335,"_2467":43474},[],"Before closing an incident, record:",{"_2944":452,"_25897":392,"_18081":43476,"_5":17976,"_24513":43335,"_2467":43477},[],"the confirmed cause;",{"_2944":453,"_25897":392,"_18081":43479,"_5":17976,"_24513":43335,"_2467":43480},[],"the time scope and affected resources;",{"_2944":454,"_25897":392,"_18081":43482,"_5":17976,"_24513":43335,"_2467":43483},[],"the commands or queries used;",{"_2944":455,"_25897":392,"_18081":43485,"_5":17976,"_24513":43335,"_2467":43486},[],"the applied change and how to revert it;",{"_2944":456,"_25897":392,"_18081":43488,"_5":17976,"_24513":43335,"_2467":43489},[],"validation from a consumer;",{"_2944":457,"_25897":392,"_18081":43491,"_5":17976,"_24513":43335,"_2467":43492},[],"the preventive action and its owner.",{"_2944":458,"_25897":458,"_5":12672,"_2467":43494,"_26242":43495,"_18081":43498,"_24513":458},"Access control",[42109,43496,43497],"Platform","Administration",[],{"_2944":459,"_25897":458,"_18081":43500,"_5":17976,"_24513":458,"_2467":43501},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2944":460,"_25897":458,"_5":26239,"_18081":43503,"_24513":43504,"_2467":43505},[],"/docs/pr-preview/pr-41/platform/administration/access-control#essential-concepts","Essential concepts",{"_2944":461,"_25897":458,"_5":26239,"_18081":43507,"_24513":43508,"_2467":43509},[],"/docs/pr-preview/pr-41/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2944":462,"_25897":458,"_5":26239,"_18081":43511,"_24513":43512,"_2467":43513},[],"/docs/pr-preview/pr-41/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2944":463,"_25897":458,"_5":26239,"_18081":43515,"_24513":43516,"_2467":43517},[],"/docs/pr-preview/pr-41/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2944":464,"_25897":458,"_5":26239,"_18081":43519,"_24513":43520,"_2467":43521},[],"/docs/pr-preview/pr-41/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2944":465,"_25897":458,"_5":26239,"_18081":43523,"_24513":43524,"_2467":43525},[],"/docs/pr-preview/pr-41/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2944":466,"_25897":458,"_5":26239,"_18081":43527,"_24513":43528,"_2467":43529},[],"/docs/pr-preview/pr-41/platform/administration/access-control#oidc-principals","OIDC principals",{"_2944":467,"_25897":458,"_5":26239,"_18081":43531,"_24513":43532,"_2467":43533},[],"/docs/pr-preview/pr-41/platform/administration/access-control#x509-principals","X.509 principals",{"_2944":468,"_25897":458,"_5":26239,"_18081":43535,"_24513":43536,"_2467":43537},[],"/docs/pr-preview/pr-41/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2944":469,"_25897":458,"_5":26239,"_18081":43539,"_24513":43540,"_2467":43541},[],"/docs/pr-preview/pr-41/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2944":470,"_25897":458,"_5":26239,"_18081":43543,"_24513":43544,"_2467":43545},[],"/docs/pr-preview/pr-41/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2944":471,"_25897":458,"_5":26239,"_18081":43547,"_24513":43548,"_2467":43549},[],"/docs/pr-preview/pr-41/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2944":472,"_25897":458,"_5":26239,"_18081":43551,"_24513":43552,"_2467":43553},[],"/docs/pr-preview/pr-41/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2944":473,"_25897":458,"_5":26239,"_18081":43555,"_24513":43556,"_2467":43557},[],"/docs/pr-preview/pr-41/platform/administration/access-control#http-rules","HTTP rules",{"_2944":474,"_25897":458,"_5":26239,"_18081":43559,"_24513":43560,"_2467":43561},[],"/docs/pr-preview/pr-41/platform/administration/access-control#included-policies","Included policies",{"_2944":475,"_25897":458,"_5":26239,"_18081":43563,"_24513":43564,"_2467":42742},[],"/docs/pr-preview/pr-41/platform/administration/access-control#provision-the-first-administrator",{"_2944":476,"_25897":458,"_5":26239,"_18081":43566,"_24513":43567,"_2467":43568},[],"/docs/pr-preview/pr-41/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2944":477,"_25897":458,"_5":26239,"_18081":43570,"_24513":43571,"_2467":43572},[],"/docs/pr-preview/pr-41/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2944":478,"_25897":458,"_5":26239,"_18081":43574,"_24513":43575,"_2467":43576},[],"/docs/pr-preview/pr-41/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2944":479,"_25897":458,"_5":26239,"_18081":43578,"_24513":43579,"_2467":43580},[],"/docs/pr-preview/pr-41/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2944":480,"_25897":458,"_5":26239,"_18081":43582,"_24513":43583,"_2467":43584},[],"/docs/pr-preview/pr-41/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2944":481,"_25897":458,"_5":26239,"_18081":43586,"_24513":43587,"_2467":43588},[],"/docs/pr-preview/pr-41/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2944":482,"_25897":458,"_5":26239,"_18081":43590,"_24513":43591,"_2467":43592},[],"/docs/pr-preview/pr-41/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2944":483,"_25897":458,"_5":26239,"_18081":43594,"_24513":43595,"_2467":43596},[],"/docs/pr-preview/pr-41/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2944":484,"_25897":458,"_5":26239,"_18081":43598,"_24513":43599,"_2467":43600},[],"/docs/pr-preview/pr-41/platform/administration/access-control#operational-checklist","Operational checklist",{"_2944":485,"_25897":458,"_5":26239,"_18081":43602,"_24513":43603,"_2467":43604},[],"/docs/pr-preview/pr-41/platform/administration/access-control#diagnostics","Diagnostics",{"_2944":486,"_25897":458,"_5":26239,"_18081":43606,"_24513":43607,"_2467":43608},[],"/docs/pr-preview/pr-41/platform/administration/access-control#the-response-is-401","The response is 401",{"_2944":487,"_25897":458,"_5":26239,"_18081":43610,"_24513":43611,"_2467":43612},[],"/docs/pr-preview/pr-41/platform/administration/access-control#the-response-is-403","The response is 403",{"_2944":488,"_25897":458,"_5":26239,"_18081":43614,"_24513":43615,"_2467":43616},[],"/docs/pr-preview/pr-41/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2944":489,"_25897":458,"_5":26239,"_18081":43618,"_24513":43619,"_2467":43620},[],"/docs/pr-preview/pr-41/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2944":490,"_25897":458,"_5":26239,"_18081":43622,"_24513":43623,"_2467":43624},[],"/docs/pr-preview/pr-41/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2944":491,"_25897":458,"_18081":43626,"_5":17976,"_24513":458,"_2467":43627},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2944":492,"_25897":458,"_18081":43629,"_5":17976,"_24513":458,"_2467":43630},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2944":493,"_25897":458,"_18081":43632,"_5":17976,"_24513":458,"_2467":43633},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2944":494,"_25897":458,"_18081":43635,"_5":17976,"_24513":43504,"_2467":43636},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2944":495,"_25897":458,"_18081":43638,"_5":17976,"_24513":43504,"_2467":43639},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2944":496,"_25897":458,"_18081":43641,"_5":17976,"_24513":43504,"_2467":43642},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2944":497,"_25897":458,"_18081":43644,"_5":17976,"_24513":43504,"_2467":43645},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2944":498,"_25897":458,"_18081":43647,"_5":17976,"_24513":43504,"_2467":43648},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2944":499,"_25897":458,"_18081":43650,"_5":17976,"_24513":43504,"_2467":43651},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2944":500,"_25897":458,"_18081":43653,"_5":17976,"_24513":43508,"_2467":43654},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2944":501,"_25897":458,"_18081":43656,"_5":17976,"_24513":43508,"_2467":43657},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2944":502,"_25897":458,"_18081":43659,"_5":17976,"_24513":43512,"_2467":43660},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2944":503,"_25897":458,"_18081":43662,"_5":17976,"_24513":43512,"_2467":43663},[],"The decision is made **before forwarding the request to the service**:",{"_2944":504,"_25897":458,"_18081":43665,"_5":17976,"_24513":43512,"_2467":43666},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2944":505,"_25897":458,"_18081":43668,"_5":17976,"_24513":43512,"_2467":43669},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2944":506,"_25897":458,"_18081":43671,"_5":17976,"_24513":43512,"_2467":43672},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2944":507,"_25897":458,"_18081":43674,"_5":17976,"_24513":43512,"_2467":43675},[],"It separately loads the policies granted to each principal.",{"_2944":508,"_25897":458,"_18081":43677,"_5":17976,"_24513":43512,"_2467":43678},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2944":509,"_25897":458,"_18081":43680,"_5":17976,"_24513":43512,"_2467":43681},[],"`authz` looks for an HTTP rule granting that action.",{"_2944":510,"_25897":458,"_18081":43683,"_5":17976,"_24513":43512,"_2467":43684},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2944":511,"_25897":458,"_18081":43686,"_5":17976,"_24513":43512,"_2467":43687},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2944":512,"_25897":458,"_18081":43689,"_5":17976,"_24513":43512,"_2467":43690},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2944":513,"_25897":458,"_18081":43692,"_5":17976,"_24513":43512,"_2467":43693},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2944":514,"_25897":458,"_18081":43695,"_5":17976,"_24513":43516,"_2467":43696},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2944":515,"_25897":458,"_18081":43698,"_5":17976,"_24513":43516,"_2467":43699},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2944":516,"_25897":458,"_18081":43701,"_5":17976,"_24513":43516,"_2467":43702},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2944":517,"_25897":458,"_18081":43704,"_5":17976,"_24513":43516,"_2467":43705},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2944":518,"_25897":458,"_18081":43707,"_5":17976,"_24513":43516,"_2467":43708},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2944":519,"_25897":458,"_18081":43710,"_5":17976,"_24513":43516,"_2467":43711},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2944":520,"_25897":458,"_18081":43713,"_5":17976,"_24513":43516,"_2467":43714},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2944":521,"_25897":458,"_18081":43716,"_5":17976,"_24513":43516,"_2467":43717},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2944":522,"_25897":458,"_18081":43719,"_5":17976,"_24513":43520,"_2467":43720},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2944":523,"_25897":458,"_18081":43722,"_5":17976,"_24513":43520,"_2467":43723},[],"The decision is made with the domain operation context:",{"_2944":524,"_25897":458,"_18081":43725,"_5":17976,"_24513":43520,"_2467":43726},[],"The middleware extracts the credential and resolves the matching principals.",{"_2944":525,"_25897":458,"_18081":43728,"_5":17976,"_24513":43520,"_2467":43729},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2944":526,"_25897":458,"_18081":43731,"_5":17976,"_24513":43520,"_2467":43732},[],"`authz` gathers the entity rules of the granted policies.",{"_2944":527,"_25897":458,"_18081":43734,"_5":17976,"_24513":43520,"_2467":43735},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2944":528,"_25897":458,"_18081":43737,"_5":17976,"_24513":43520,"_2467":43738},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2944":529,"_25897":458,"_18081":43740,"_5":17976,"_24513":43520,"_2467":43741},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2944":530,"_25897":458,"_18081":43743,"_5":17976,"_24513":43520,"_2467":43744},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2944":531,"_25897":458,"_18081":43746,"_5":17976,"_24513":43520,"_2467":43747},[],"Actions fall into two groups:",{"_2944":532,"_25897":458,"_18081":43749,"_5":17976,"_24513":43520,"_2467":43750},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2944":533,"_25897":458,"_18081":43752,"_5":17976,"_24513":43520,"_2467":43753},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2944":534,"_25897":458,"_18081":43755,"_5":17976,"_24513":43520,"_2467":43756},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2944":535,"_25897":458,"_18081":43758,"_5":17976,"_24513":43524,"_2467":43759},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2944":536,"_25897":458,"_18081":43761,"_5":17976,"_24513":43524,"_2467":43762},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2944":537,"_25897":458,"_18081":43764,"_5":17976,"_24513":43524,"_2467":43765},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2944":538,"_25897":458,"_18081":43767,"_5":17976,"_24513":43528,"_2467":43768},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2944":539,"_25897":458,"_18081":43770,"_5":17976,"_24513":43528,"_2467":43771},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2944":540,"_25897":458,"_18081":43773,"_5":17976,"_24513":43528,"_2467":43774},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2944":541,"_25897":458,"_18081":43776,"_5":17976,"_24513":43528,"_2467":43777},[],"The implemented operators are:",{"_2944":542,"_25897":458,"_18081":43779,"_5":17976,"_24513":43528,"_2467":43780},[],"`equals`, for exact equality;",{"_2944":543,"_25897":458,"_18081":43782,"_5":17976,"_24513":43528,"_2467":43783},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2944":544,"_25897":458,"_18081":43785,"_5":17976,"_24513":43528,"_2467":43786},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2944":545,"_25897":458,"_18081":43788,"_5":17976,"_24513":43528,"_2467":43789},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2944":546,"_25897":458,"_18081":43791,"_5":17976,"_24513":43532,"_2467":43792},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2944":547,"_25897":458,"_18081":43794,"_5":17976,"_24513":43532,"_2467":43795},[],"The available modes are:",{"_2944":548,"_25897":458,"_18081":43797,"_5":17976,"_24513":43532,"_2467":43798},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2944":549,"_25897":458,"_18081":43800,"_5":17976,"_24513":43532,"_2467":43801},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2944":550,"_25897":458,"_18081":43803,"_5":17976,"_24513":43532,"_2467":43804},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2944":551,"_25897":458,"_18081":43806,"_5":17976,"_24513":43532,"_2467":43807},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2944":552,"_25897":458,"_18081":43809,"_5":17976,"_24513":43532,"_2467":43810},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2944":553,"_25897":458,"_18081":43812,"_5":17976,"_24513":43532,"_2467":43813},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2944":554,"_25897":458,"_18081":43815,"_5":17976,"_24513":43536,"_2467":43816},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2944":555,"_25897":458,"_18081":43818,"_5":17976,"_24513":43536,"_2467":43819},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2944":556,"_25897":458,"_18081":43821,"_5":17976,"_24513":43536,"_2467":43822},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2944":557,"_25897":458,"_18081":43824,"_5":17976,"_24513":43536,"_2467":43825},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2944":558,"_25897":458,"_18081":43827,"_5":17976,"_24513":43544,"_2467":43828},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2944":559,"_25897":458,"_18081":43830,"_5":17976,"_24513":43544,"_2467":43831},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2944":560,"_25897":458,"_18081":43833,"_5":17976,"_24513":43548,"_2467":43834},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2944":561,"_25897":458,"_18081":43836,"_5":17976,"_24513":43548,"_2467":43837},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2944":562,"_25897":458,"_18081":43839,"_5":17976,"_24513":43552,"_2467":43840},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2944":563,"_25897":458,"_18081":43842,"_5":17976,"_24513":43552,"_2467":43843},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2944":564,"_25897":458,"_18081":43845,"_5":17976,"_24513":43552,"_2467":43846},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2944":565,"_25897":458,"_18081":43848,"_5":17976,"_24513":43556,"_2467":43849},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2944":566,"_25897":458,"_18081":43851,"_5":17976,"_24513":43556,"_2467":43852},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2944":567,"_25897":458,"_18081":43854,"_5":17976,"_24513":43556,"_2467":43855},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2944":568,"_25897":458,"_18081":43857,"_5":17976,"_24513":43556,"_2467":43858},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2944":569,"_25897":458,"_18081":43860,"_5":17976,"_24513":43556,"_2467":43861},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2944":570,"_25897":458,"_18081":43863,"_5":17976,"_24513":43556,"_2467":43864},[],"Note that:",{"_2944":571,"_25897":458,"_18081":43866,"_5":17976,"_24513":43556,"_2467":43867},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2944":572,"_25897":458,"_18081":43869,"_5":17976,"_24513":43556,"_2467":43870},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2944":573,"_25897":458,"_18081":43872,"_5":17976,"_24513":43556,"_2467":43873},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2944":574,"_25897":458,"_18081":43875,"_5":17976,"_24513":43560,"_2467":43876},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2944":575,"_25897":458,"_18081":43878,"_5":17976,"_24513":43560,"_2467":43879},[],"full and read-only access to certificates and authorities;",{"_2944":576,"_25897":458,"_18081":43881,"_5":17976,"_24513":43560,"_2467":43882},[],"full and read-only access to the KMS;",{"_2944":577,"_25897":458,"_18081":43884,"_5":17976,"_24513":43560,"_2467":43885},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2944":578,"_25897":458,"_18081":43887,"_5":17976,"_24513":43560,"_2467":43888},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2944":579,"_25897":458,"_18081":43890,"_5":17976,"_24513":43560,"_2467":43891},[],"console access;",{"_2944":580,"_25897":458,"_18081":43893,"_5":17976,"_24513":43560,"_2467":43894},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2944":581,"_25897":458,"_18081":43896,"_5":17976,"_24513":43560,"_2467":43897},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2944":582,"_25897":458,"_18081":43899,"_5":17976,"_24513":43560,"_2467":43900},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2944":583,"_25897":458,"_18081":43902,"_5":17976,"_24513":43564,"_2467":43903},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2944":584,"_25897":458,"_18081":43905,"_5":17976,"_24513":43564,"_2467":43906},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2944":585,"_25897":458,"_18081":43908,"_5":17976,"_24513":43564,"_2467":43909},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2944":586,"_25897":458,"_18081":43911,"_5":17976,"_24513":43567,"_2467":43912},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2944":587,"_25897":458,"_18081":43914,"_5":17976,"_24513":43571,"_2467":43915},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2944":588,"_25897":458,"_18081":43917,"_5":17976,"_24513":43575,"_2467":43918},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2944":589,"_25897":458,"_18081":43920,"_5":17976,"_24513":43579,"_2467":43921},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2944":590,"_25897":458,"_18081":43923,"_5":17976,"_24513":43583,"_2467":43924},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2944":591,"_25897":458,"_18081":43926,"_5":17976,"_24513":43587,"_2467":43927},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2944":592,"_25897":458,"_18081":43929,"_5":17976,"_24513":43587,"_2467":43930},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2944":593,"_25897":458,"_18081":43932,"_5":17976,"_24513":43591,"_2467":43933},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2944":594,"_25897":458,"_18081":43935,"_5":17976,"_24513":43591,"_2467":43936},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2944":595,"_25897":458,"_18081":43938,"_5":17976,"_24513":43591,"_2467":43939},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2944":596,"_25897":458,"_18081":43941,"_5":17976,"_24513":43591,"_2467":43942},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2944":597,"_25897":458,"_18081":43944,"_5":17976,"_24513":43591,"_2467":43945},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2944":598,"_25897":458,"_18081":43947,"_5":17976,"_24513":43591,"_2467":43948},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2944":599,"_25897":458,"_18081":43950,"_5":17976,"_24513":43591,"_2467":43951},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2944":600,"_25897":458,"_18081":43953,"_5":17976,"_24513":43591,"_2467":43954},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2944":601,"_25897":458,"_18081":43956,"_5":17976,"_24513":43595,"_2467":43957},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2944":602,"_25897":458,"_18081":43959,"_5":17976,"_24513":43595,"_2467":43960},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2944":603,"_25897":458,"_18081":43962,"_5":17976,"_24513":43595,"_2467":43963},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2944":604,"_25897":458,"_18081":43965,"_5":17976,"_24513":43599,"_2467":43966},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2944":605,"_25897":458,"_18081":43968,"_5":17976,"_24513":43599,"_2467":43969},[],"Use groups or stable roles for people and independent identities for automations.",{"_2944":606,"_25897":458,"_18081":43971,"_5":17976,"_24513":43599,"_2467":43972},[],"Keep at least two recovery administrators and test their access periodically.",{"_2944":607,"_25897":458,"_18081":43974,"_5":17976,"_24513":43599,"_2467":43975},[],"Review active principals, their matches and their grants after IdP changes.",{"_2944":608,"_25897":458,"_18081":43977,"_5":17976,"_24513":43599,"_2467":43978},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2944":609,"_25897":458,"_18081":43980,"_5":17976,"_24513":43599,"_2467":43981},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2944":610,"_25897":458,"_18081":43983,"_5":17976,"_24513":43599,"_2467":43984},[],"Always test one allowed and one denied operation for each role.",{"_2944":611,"_25897":458,"_18081":43986,"_5":17976,"_24513":43599,"_2467":43987},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2944":612,"_25897":458,"_18081":43989,"_5":17976,"_24513":43607,"_2467":43990},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2944":613,"_25897":458,"_18081":43992,"_5":17976,"_24513":43611,"_2467":43993},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2944":614,"_25897":458,"_18081":43995,"_5":17976,"_24513":43611,"_2467":43996},[],"that an active principal of the correct type exists;",{"_2944":615,"_25897":458,"_18081":43998,"_5":17976,"_24513":43611,"_2467":43999},[],"that the claim paths and values match the real token exactly;",{"_2944":616,"_25897":458,"_18081":44001,"_5":17976,"_24513":43611,"_2467":44002},[],"that all of the principal's conditions hold;",{"_2944":617,"_25897":458,"_18081":44004,"_5":17976,"_24513":43611,"_2467":44005},[],"that the principal has the expected policy granted;",{"_2944":618,"_25897":458,"_18081":44007,"_5":17976,"_24513":43611,"_2467":44008},[],"that the policy includes the action and the requested resource type or route;",{"_2944":619,"_25897":458,"_18081":44010,"_5":17976,"_24513":43611,"_2467":44011},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2944":620,"_25897":458,"_18081":44013,"_5":17976,"_24513":43611,"_2467":44014},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2944":621,"_25897":458,"_18081":44016,"_5":17976,"_24513":43615,"_2467":44017},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2944":622,"_25897":458,"_18081":44019,"_5":17976,"_24513":43619,"_2467":44020},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2944":623,"_25897":458,"_18081":44022,"_5":17976,"_24513":43623,"_2467":44023},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2944":624,"_25897":458,"_18081":44025,"_5":17976,"_24513":43623,"_2467":44026},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2944":625,"_25897":625,"_5":12672,"_2467":44028,"_26242":44029,"_18081":44030,"_24513":625},"Alerts and subscriptions",[42109,43496,43497],[],{"_2944":626,"_25897":625,"_18081":44032,"_5":17976,"_24513":625,"_2467":44033},[],"Send PKI events to people and external systems.",{"_2944":627,"_25897":625,"_5":26239,"_18081":44035,"_24513":44036,"_2467":44037},[],"/docs/pr-preview/pr-41/platform/administration/alerts#how-it-works","How it works",{"_2944":628,"_25897":625,"_5":26239,"_18081":44039,"_24513":44040,"_2467":44041},[],"/docs/pr-preview/pr-41/platform/administration/alerts#available-channels","Available channels",{"_2944":629,"_25897":625,"_5":26239,"_18081":44043,"_24513":44044,"_2467":44045},[],"/docs/pr-preview/pr-41/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2944":630,"_25897":625,"_5":26239,"_18081":44047,"_24513":44048,"_2467":44049},[],"/docs/pr-preview/pr-41/platform/administration/alerts#choose-the-event","Choose the event",{"_2944":631,"_25897":625,"_5":26239,"_18081":44051,"_24513":44052,"_2467":44053},[],"/docs/pr-preview/pr-41/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2944":632,"_25897":625,"_5":26239,"_18081":44055,"_24513":44056,"_2467":44057},[],"/docs/pr-preview/pr-41/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2944":633,"_25897":625,"_5":26239,"_18081":44059,"_24513":44060,"_2467":44061},[],"/docs/pr-preview/pr-41/platform/administration/alerts#review-and-activate","Review and activate",{"_2944":634,"_25897":625,"_5":26239,"_18081":44063,"_24513":44064,"_2467":44065},[],"/docs/pr-preview/pr-41/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2944":635,"_25897":625,"_5":26239,"_18081":44067,"_24513":44068,"_2467":44069},[],"/docs/pr-preview/pr-41/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2944":636,"_25897":625,"_5":26239,"_18081":44071,"_24513":44072,"_2467":44073},[],"/docs/pr-preview/pr-41/platform/administration/alerts#event-families","Event families",{"_2944":637,"_25897":625,"_18081":44075,"_5":17976,"_24513":625,"_2467":44076},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2944":638,"_25897":625,"_18081":44078,"_5":17976,"_24513":44036,"_2467":44079},[],"A service publishes a domain event.",{"_2944":639,"_25897":625,"_18081":44081,"_5":17976,"_24513":44036,"_2467":44082},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2944":640,"_25897":625,"_18081":44084,"_5":17976,"_24513":44036,"_2467":44085},[],"Each subscription's filter decides whether it should be notified.",{"_2944":641,"_25897":625,"_18081":44087,"_5":17976,"_24513":44036,"_2467":44088},[],"Lamassu delivers the event to the configured channel.",{"_2944":642,"_25897":625,"_18081":44090,"_5":17976,"_24513":44036,"_2467":44091},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2944":643,"_25897":625,"_18081":44093,"_5":17976,"_24513":44040,"_2467":44094},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2944":644,"_25897":625,"_18081":44096,"_5":17976,"_24513":44040,"_2467":44097},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2944":645,"_25897":625,"_18081":44099,"_5":17976,"_24513":44040,"_2467":44100},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2944":646,"_25897":625,"_18081":44102,"_5":17976,"_24513":44040,"_2467":44103},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2944":647,"_25897":625,"_18081":44105,"_5":17976,"_24513":44040,"_2467":44106},[],"`apikey_options` requires `header` and `key`.",{"_2944":648,"_25897":625,"_18081":44108,"_5":17976,"_24513":44040,"_2467":44109},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2944":649,"_25897":625,"_18081":44111,"_5":17976,"_24513":44040,"_2467":44112},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_2944":650,"_25897":625,"_18081":44114,"_5":17976,"_24513":44040,"_2467":44115},[],"The alerts API reference documents the full `http_client` schema.",{"_2944":651,"_25897":625,"_18081":44117,"_5":17976,"_24513":44048,"_2467":44118},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2944":652,"_25897":625,"_18081":44120,"_5":17976,"_24513":44052,"_2467":44121},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2944":653,"_25897":625,"_18081":44123,"_5":17976,"_24513":44056,"_2467":44124},[],"Add a filter if you don't want to receive every instance of the event.",{"_2944":654,"_25897":625,"_18081":44126,"_5":17976,"_24513":44056,"_2467":44127},[],"**None** notifies all instances of the event.",{"_2944":655,"_25897":625,"_18081":44129,"_5":17976,"_24513":44056,"_2467":44130},[],"**JSON Path** evaluates one or more specific fields.",{"_2944":656,"_25897":625,"_18081":44132,"_5":17976,"_24513":44056,"_2467":44133},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2944":657,"_25897":625,"_18081":44135,"_5":17976,"_24513":44056,"_2467":44136},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2944":658,"_25897":625,"_18081":44138,"_5":17976,"_24513":44056,"_2467":44139},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2944":659,"_25897":625,"_18081":44141,"_5":17976,"_24513":44060,"_2467":44142},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2944":660,"_25897":625,"_18081":44144,"_5":17976,"_24513":44064,"_2467":44145},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2944":661,"_25897":625,"_18081":44147,"_5":17976,"_24513":44064,"_2467":44148},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2944":662,"_25897":625,"_18081":44150,"_5":17976,"_24513":44064,"_2467":44151},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2944":663,"_25897":625,"_18081":44153,"_5":17976,"_24513":44064,"_2467":44154},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2944":664,"_25897":625,"_18081":44156,"_5":17976,"_24513":44064,"_2467":44157},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2944":665,"_25897":625,"_18081":44159,"_5":17976,"_24513":44064,"_2467":44160},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2944":666,"_25897":625,"_18081":44162,"_5":17976,"_24513":44064,"_2467":44163},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2944":667,"_25897":625,"_18081":44165,"_5":17976,"_24513":44064,"_2467":44166},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2944":668,"_25897":625,"_18081":44168,"_5":17976,"_24513":44068,"_2467":44169},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2944":669,"_25897":625,"_18081":44171,"_5":17976,"_24513":44072,"_2467":44172},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2944":670,"_25897":625,"_18081":44174,"_5":17976,"_24513":44072,"_2467":44175},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2944":671,"_25897":625,"_18081":44177,"_5":17976,"_24513":44072,"_2467":44178},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2944":672,"_25897":625,"_18081":44180,"_5":17976,"_24513":44072,"_2467":44181},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2944":673,"_25897":625,"_18081":44183,"_5":17976,"_24513":44072,"_2467":44184},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2944":674,"_25897":625,"_18081":44186,"_5":17976,"_24513":44072,"_2467":44187},[],"**Validation:** `va.role.crl.create`.",{"_2944":675,"_25897":625,"_18081":44189,"_5":17976,"_24513":44072,"_2467":44190},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2944":676,"_25897":625,"_18081":44192,"_5":17976,"_24513":44072,"_2467":44193},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2944":677,"_25897":677,"_5":12672,"_2467":44195,"_26242":44196,"_18081":44197,"_24513":677},"Audit logs",[42109,43496,43497],[],{"_2944":678,"_25897":677,"_18081":44199,"_5":17976,"_24513":677,"_2467":44200},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2944":679,"_25897":677,"_5":26239,"_18081":44202,"_24513":44203,"_2467":44204},[],"/docs/pr-preview/pr-41/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2944":680,"_25897":677,"_5":26239,"_18081":44206,"_24513":44207,"_2467":44208},[],"/docs/pr-preview/pr-41/platform/administration/audit-logs#coverage","Coverage",{"_2944":681,"_25897":677,"_5":26239,"_18081":44210,"_24513":44211,"_2467":44212},[],"/docs/pr-preview/pr-41/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2944":682,"_25897":677,"_5":26239,"_18081":44214,"_24513":44215,"_2467":44216},[],"/docs/pr-preview/pr-41/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2944":683,"_25897":677,"_5":26239,"_18081":44218,"_24513":44219,"_2467":44220},[],"/docs/pr-preview/pr-41/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2944":684,"_25897":677,"_5":26239,"_18081":44222,"_24513":44223,"_2467":44224},[],"/docs/pr-preview/pr-41/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2944":685,"_25897":677,"_5":26239,"_18081":44226,"_24513":44227,"_2467":44228},[],"/docs/pr-preview/pr-41/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2944":686,"_25897":677,"_5":26239,"_18081":44230,"_24513":44231,"_2467":44232},[],"/docs/pr-preview/pr-41/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2944":687,"_25897":677,"_5":26239,"_18081":44234,"_24513":44235,"_2467":44236},[],"/docs/pr-preview/pr-41/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2944":688,"_25897":677,"_5":26239,"_18081":44238,"_24513":44239,"_2467":44240},[],"/docs/pr-preview/pr-41/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2944":689,"_25897":677,"_5":26239,"_18081":44242,"_24513":44243,"_2467":44244},[],"/docs/pr-preview/pr-41/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2944":690,"_25897":677,"_18081":44246,"_5":17976,"_24513":677,"_2467":44247},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2944":691,"_25897":677,"_18081":44249,"_5":17976,"_24513":44203,"_2467":44250},[],"The audit body includes:",{"_2944":692,"_25897":677,"_18081":44252,"_5":17976,"_24513":44203,"_2467":44253},[],"input: data received by the operation;",{"_2944":693,"_25897":677,"_18081":44255,"_5":17976,"_24513":44203,"_2467":44256},[],"has\\_error: whether the service returned an error;",{"_2944":694,"_25897":677,"_18081":44258,"_5":17976,"_24513":44203,"_2467":44259},[],"output: produced result or error message;",{"_2944":695,"_25897":677,"_18081":44261,"_5":17976,"_24513":44203,"_2467":44262},[],"principals: identifiers of the principals that matched the request.",{"_2944":696,"_25897":677,"_18081":44264,"_5":17976,"_24513":44203,"_2467":44265},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2944":697,"_25897":677,"_18081":44267,"_5":17976,"_24513":44203,"_2467":44268},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2944":698,"_25897":677,"_18081":44270,"_5":17976,"_24513":44207,"_2467":44271},[],"The backend applies auditing to mutations of:",{"_2944":699,"_25897":677,"_18081":44273,"_5":17976,"_24513":44207,"_2467":44274},[],"authorities, certificates and issuance profiles;",{"_2944":700,"_25897":677,"_18081":44276,"_5":17976,"_24513":44207,"_2467":44277},[],"keys and KMS engines;",{"_2944":701,"_25897":677,"_18081":44279,"_5":17976,"_24513":44207,"_2467":44280},[],"devices and identities;",{"_2944":702,"_25897":677,"_18081":44282,"_5":17976,"_24513":44207,"_2467":44283},[],"DMSs and enrollment operations;",{"_2944":703,"_25897":677,"_18081":44285,"_5":17976,"_24513":44207,"_2467":44286},[],"validation functions and CRL;",{"_2944":704,"_25897":677,"_18081":44288,"_5":17976,"_24513":44207,"_2467":44289},[],"principals, policies and authorization grants.",{"_2944":705,"_25897":677,"_18081":44291,"_5":17976,"_24513":44207,"_2467":44292},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2944":706,"_25897":677,"_18081":44294,"_5":17976,"_24513":44211,"_2467":44295},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2944":707,"_25897":677,"_18081":44297,"_5":17976,"_24513":44211,"_2467":44298},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2944":708,"_25897":677,"_18081":44300,"_5":17976,"_24513":44211,"_2467":44301},[],"Design the consumer to:",{"_2944":709,"_25897":677,"_18081":44303,"_5":17976,"_24513":44211,"_2467":44304},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2944":710,"_25897":677,"_18081":44306,"_5":17976,"_24513":44211,"_2467":44307},[],"keep the complete CloudEvent unmodified;",{"_2944":711,"_25897":677,"_18081":44309,"_5":17976,"_24513":44211,"_2467":44310},[],"record the ingestion time and detect duplicates by ID;",{"_2944":712,"_25897":677,"_18081":44312,"_5":17976,"_24513":44211,"_2467":44313},[],"encrypt in transit and at rest;",{"_2944":713,"_25897":677,"_18081":44315,"_5":17976,"_24513":44211,"_2467":44316},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2944":714,"_25897":677,"_18081":44318,"_5":17976,"_24513":44211,"_2467":44319},[],"apply an explicit retention and legal hold policy;",{"_2944":715,"_25897":677,"_18081":44321,"_5":17976,"_24513":44211,"_2467":44322},[],"alert if it stops consuming or the pending queue grows.",{"_2944":716,"_25897":677,"_18081":44324,"_5":17976,"_24513":44215,"_2467":44325},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2944":717,"_25897":677,"_18081":44327,"_5":17976,"_24513":44215,"_2467":44328},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2944":718,"_25897":677,"_18081":44330,"_5":17976,"_24513":44223,"_2467":44331},[],"Start from the reported time and normalize every source to UTC.",{"_2944":719,"_25897":677,"_18081":44333,"_5":17976,"_24513":44227,"_2467":44334},[],"Filter by event type, service source and resource identifier.",{"_2944":720,"_25897":677,"_18081":44336,"_5":17976,"_24513":44231,"_2467":44337},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2944":721,"_25897":677,"_18081":44339,"_5":17976,"_24513":44235,"_2467":44340},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2944":722,"_25897":677,"_18081":44342,"_5":17976,"_24513":44239,"_2467":44343},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2944":723,"_25897":677,"_18081":44345,"_5":17976,"_24513":44243,"_2467":44346},[],"Generate a controlled mutation in a test environment and check that:",{"_2944":724,"_25897":677,"_18081":44348,"_5":17976,"_24513":44243,"_2467":44349},[],"a successful audit event appears;",{"_2944":725,"_25897":677,"_18081":44351,"_5":17976,"_24513":44243,"_2467":44352},[],"the principal matches the identity used;",{"_2944":726,"_25897":677,"_18081":44354,"_5":17976,"_24513":44243,"_2467":44355},[],"the consumer persists it exactly once;",{"_2944":727,"_25897":677,"_18081":44357,"_5":17976,"_24513":44243,"_2467":44358},[],"it can be retrieved by resource, actor and period;",{"_2944":728,"_25897":677,"_18081":44360,"_5":17976,"_24513":44243,"_2467":44361},[],"a consumer outage raises an alert.",{"_2944":729,"_25897":677,"_18081":44363,"_5":17976,"_24513":44243,"_2467":44364},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2944":730,"_25897":730,"_5":12672,"_2467":44366,"_26242":44367,"_18081":44368,"_24513":730},"Platform architecture",[42109,43496],[],{"_2944":731,"_25897":730,"_18081":44370,"_5":17976,"_24513":730,"_2467":44371},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2944":732,"_25897":730,"_5":26239,"_18081":44373,"_24513":44374,"_2467":44375},[],"/docs/pr-preview/pr-41/platform/concepts/architecture#control-plane","Control plane",{"_2944":733,"_25897":730,"_5":26239,"_18081":44377,"_24513":44378,"_2467":44379},[],"/docs/pr-preview/pr-41/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2944":734,"_25897":730,"_5":26239,"_18081":44381,"_24513":44382,"_2467":44383},[],"/docs/pr-preview/pr-41/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2944":735,"_25897":730,"_5":26239,"_18081":44385,"_24513":44386,"_2467":44387},[],"/docs/pr-preview/pr-41/platform/concepts/architecture#status-and-validation","Status and validation",{"_2944":736,"_25897":730,"_5":26239,"_18081":44389,"_24513":44390,"_2467":44391},[],"/docs/pr-preview/pr-41/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2944":737,"_25897":730,"_18081":44393,"_5":17976,"_24513":730,"_2467":44394},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2944":738,"_25897":730,"_18081":44396,"_5":17976,"_24513":730,"_2467":44397},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2944":739,"_25897":730,"_18081":44399,"_5":17976,"_24513":44374,"_2467":44400},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2944":740,"_25897":730,"_18081":44402,"_5":17976,"_24513":44378,"_2467":44403},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2944":741,"_25897":730,"_18081":44405,"_5":17976,"_24513":44382,"_2467":44406},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2944":742,"_25897":730,"_18081":44408,"_5":17976,"_24513":44386,"_2467":44409},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2944":743,"_25897":730,"_18081":44411,"_5":17976,"_24513":44390,"_2467":44412},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2944":744,"_25897":744,"_5":12672,"_2467":44414,"_26242":44415,"_18081":44416,"_24513":744},"How Lamassu works",[42109,43496],[],{"_2944":745,"_25897":744,"_18081":44418,"_5":17976,"_24513":744,"_2467":44419},[],"The mental model of trust, keys, certificates and devices.",{"_2944":746,"_25897":744,"_5":26239,"_18081":44421,"_24513":44422,"_2467":44423},[],"/docs/pr-preview/pr-41/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2944":747,"_25897":744,"_5":26239,"_18081":44425,"_24513":44426,"_2467":44427},[],"/docs/pr-preview/pr-41/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2944":748,"_25897":744,"_18081":44429,"_5":17976,"_24513":744,"_2467":44430},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2944":749,"_25897":744,"_18081":44432,"_5":17976,"_24513":44422,"_2467":44433},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2944":750,"_25897":744,"_18081":44435,"_5":17976,"_24513":44422,"_2467":44436},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2944":751,"_25897":744,"_18081":44438,"_5":17976,"_24513":44422,"_2467":44439},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2944":752,"_25897":744,"_18081":44441,"_5":17976,"_24513":44422,"_2467":44442},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2944":753,"_25897":744,"_18081":44444,"_5":17976,"_24513":44422,"_2467":44445},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2944":754,"_25897":744,"_18081":44447,"_5":17976,"_24513":44426,"_2467":44448},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2944":755,"_25897":744,"_18081":44450,"_5":17976,"_24513":44426,"_2467":44451},[],"A DMS relates that CA to an enrollment policy.",{"_2944":756,"_25897":744,"_18081":44453,"_5":17976,"_24513":44426,"_2467":44454},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2944":757,"_25897":744,"_18081":44456,"_5":17976,"_24513":44426,"_2467":44457},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2944":758,"_25897":744,"_18081":44459,"_5":17976,"_24513":44426,"_2467":44460},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2944":759,"_25897":744,"_18081":44462,"_5":17976,"_24513":44426,"_2467":44463},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2944":760,"_25897":744,"_18081":44465,"_5":17976,"_24513":44426,"_2467":44466},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2944":761,"_25897":761,"_5":12672,"_2467":44468,"_26242":44469,"_18081":44471,"_24513":761},"Devices and identities",[42109,43496,44470,44468],"IoT Fleets",[],{"_2944":762,"_25897":761,"_18081":44473,"_5":17976,"_24513":761,"_2467":44474},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2944":763,"_25897":761,"_5":26239,"_18081":44476,"_24513":44477,"_2467":44478},[],"/docs/pr-preview/pr-41/platform/iot-fleets/device-management#device-states","Device states",{"_2944":764,"_25897":761,"_5":26239,"_18081":44480,"_24513":44481,"_2467":44482},[],"/docs/pr-preview/pr-41/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2944":765,"_25897":761,"_5":26239,"_18081":44484,"_24513":44485,"_2467":44486},[],"/docs/pr-preview/pr-41/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2944":766,"_25897":761,"_5":26239,"_18081":44488,"_24513":44489,"_2467":44490},[],"/docs/pr-preview/pr-41/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2944":767,"_25897":761,"_5":26239,"_18081":44492,"_24513":44493,"_2467":44494},[],"/docs/pr-preview/pr-41/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2944":768,"_25897":761,"_5":26239,"_18081":44496,"_24513":44497,"_2467":44498},[],"/docs/pr-preview/pr-41/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2944":769,"_25897":761,"_5":26239,"_18081":44500,"_24513":44501,"_2467":44502},[],"/docs/pr-preview/pr-41/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2944":770,"_25897":761,"_5":26239,"_18081":44504,"_24513":44505,"_2467":44506},[],"/docs/pr-preview/pr-41/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2944":771,"_25897":761,"_5":26239,"_18081":44508,"_24513":44509,"_2467":44510},[],"/docs/pr-preview/pr-41/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2944":772,"_25897":761,"_5":26239,"_18081":44512,"_24513":44513,"_2467":44514},[],"/docs/pr-preview/pr-41/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2944":773,"_25897":761,"_5":26239,"_18081":44516,"_24513":44517,"_2467":44518},[],"/docs/pr-preview/pr-41/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2944":774,"_25897":761,"_18081":44520,"_5":17976,"_24513":761,"_2467":44521},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2944":775,"_25897":761,"_18081":44523,"_5":17976,"_24513":761,"_2467":44524},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2944":776,"_25897":761,"_18081":44526,"_5":17976,"_24513":44477,"_2467":44527},[],"Operational view",{"_2944":777,"_25897":761,"_18081":44529,"_5":17976,"_24513":44477,"_2467":44530},[],"Meaning",{"_2944":778,"_25897":761,"_18081":44532,"_5":17976,"_24513":44477,"_2467":44533},[],"**No Identity**",{"_2944":779,"_25897":761,"_18081":44535,"_5":17976,"_24513":44477,"_2467":44536},[],"A record exists without an associated identity.",{"_2944":780,"_25897":761,"_18081":44538,"_5":17976,"_24513":44477,"_2467":44539},[],"**Active**",{"_2944":781,"_25897":761,"_18081":44541,"_5":17976,"_24513":44477,"_2467":44542},[],"The slot is active; also check certificate dates, status and usages.",{"_2944":782,"_25897":761,"_18081":44544,"_5":17976,"_24513":44477,"_2467":44545},[],"**Renewal Pending**",{"_2944":783,"_25897":761,"_18081":44547,"_5":17976,"_24513":44477,"_2467":44548},[],"The identity is in the operational renewal window.",{"_2944":784,"_25897":761,"_18081":44550,"_5":17976,"_24513":44477,"_2467":44551},[],"**Expiring Soon**",{"_2944":785,"_25897":761,"_18081":44553,"_5":17976,"_24513":44477,"_2467":44554},[],"Expiration is approaching according to configured thresholds.",{"_2944":786,"_25897":761,"_18081":44556,"_5":17976,"_24513":44477,"_2467":44557},[],"**Expired**",{"_2944":787,"_25897":761,"_18081":44559,"_5":17976,"_24513":44477,"_2467":44560},[],"The identity has expired.",{"_2944":788,"_25897":761,"_18081":44562,"_5":17976,"_24513":44477,"_2467":44563},[],"**Revoked**",{"_2944":789,"_25897":761,"_18081":44565,"_5":17976,"_24513":44477,"_2467":44566},[],"The identity is marked revoked.",{"_2944":790,"_25897":761,"_18081":44568,"_5":17976,"_24513":44477,"_2467":44569},[],"**Decommissioned**",{"_2944":791,"_25897":761,"_18081":44571,"_5":17976,"_24513":44477,"_2467":44572},[],"The record is retired and ordinary updates do not restore operation.",{"_2944":792,"_25897":761,"_18081":44574,"_5":17976,"_24513":44477,"_2467":44575},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2944":793,"_25897":761,"_18081":44577,"_5":17976,"_24513":44481,"_2467":44578},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2944":794,"_25897":761,"_18081":44580,"_5":17976,"_24513":44481,"_2467":44581},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2944":795,"_25897":761,"_18081":44583,"_5":17976,"_24513":44481,"_2467":44584},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2944":796,"_25897":761,"_18081":44586,"_5":17976,"_24513":44481,"_2467":44587},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2944":797,"_25897":761,"_18081":44589,"_5":17976,"_24513":44485,"_2467":44590},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2944":798,"_25897":761,"_18081":44592,"_5":17976,"_24513":44489,"_2467":44593},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2944":799,"_25897":761,"_18081":44595,"_5":17976,"_24513":44493,"_2467":44596},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2944":800,"_25897":761,"_18081":44598,"_5":17976,"_24513":44497,"_2467":44599},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2944":801,"_25897":761,"_18081":44601,"_5":17976,"_24513":44501,"_2467":44602},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2944":802,"_25897":761,"_18081":44604,"_5":17976,"_24513":44501,"_2467":44605},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2944":803,"_25897":761,"_18081":44607,"_5":17976,"_24513":44505,"_2467":44608},[],"From **No Identity**, use **Assign Identity**:",{"_2944":804,"_25897":761,"_18081":44610,"_5":17976,"_24513":44505,"_2467":44611},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2944":805,"_25897":761,"_18081":44613,"_5":17976,"_24513":44505,"_2467":44614},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2944":806,"_25897":761,"_18081":44616,"_5":17976,"_24513":44505,"_2467":44617},[],"Confirm and read the serial, active version and history again.",{"_2944":807,"_25897":761,"_18081":44619,"_5":17976,"_24513":44505,"_2467":44620},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2944":808,"_25897":761,"_18081":44622,"_5":17976,"_24513":44505,"_2467":44623},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2944":809,"_25897":761,"_18081":44625,"_5":17976,"_24513":44509,"_2467":44626},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2944":810,"_25897":761,"_18081":44628,"_5":17976,"_24513":44509,"_2467":44629},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2944":811,"_25897":761,"_18081":44631,"_5":17976,"_24513":44513,"_2467":44632},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2944":812,"_25897":761,"_18081":44634,"_5":17976,"_24513":44513,"_2467":44635},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2944":813,"_25897":761,"_18081":44637,"_5":17976,"_24513":44513,"_2467":44638},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2944":814,"_25897":761,"_18081":44640,"_5":17976,"_24513":44513,"_2467":44641},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2944":815,"_25897":761,"_18081":44643,"_5":17976,"_24513":44517,"_2467":44644},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2944":816,"_25897":761,"_18081":44646,"_5":17976,"_24513":44517,"_2467":44647},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2944":817,"_25897":817,"_5":12672,"_2467":44649,"_26242":44650,"_18081":44652,"_24513":817},"Bootstrap identity and authentication",[42109,43496,44470,44468,44651],"Enrollment with PKI",[],{"_2944":818,"_25897":817,"_18081":44654,"_5":17976,"_24513":817,"_2467":44655},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2944":819,"_25897":817,"_5":26239,"_18081":44657,"_24513":44658,"_2467":44659},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2944":820,"_25897":817,"_5":26239,"_18081":44661,"_24513":44662,"_2467":44663},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2944":821,"_25897":817,"_5":26239,"_18081":44665,"_24513":44666,"_2467":44667},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2944":822,"_25897":817,"_5":26239,"_18081":44669,"_24513":44670,"_2467":44671},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2944":823,"_25897":817,"_5":26239,"_18081":44673,"_24513":44674,"_2467":44675},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2944":824,"_25897":817,"_18081":44677,"_5":17976,"_24513":817,"_2467":44678},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2944":825,"_25897":817,"_18081":44680,"_5":17976,"_24513":44658,"_2467":44681},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2944":826,"_25897":817,"_18081":44683,"_5":17976,"_24513":44658,"_2467":44684},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2944":827,"_25897":817,"_18081":44686,"_5":17976,"_24513":44662,"_2467":44687},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2944":828,"_25897":817,"_18081":44689,"_5":17976,"_24513":44662,"_2467":44690},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2944":829,"_25897":817,"_18081":44692,"_5":17976,"_24513":44662,"_2467":44693},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2944":830,"_25897":817,"_18081":44695,"_5":17976,"_24513":44666,"_2467":44696},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2944":831,"_25897":817,"_18081":44698,"_5":17976,"_24513":44666,"_2467":44699},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2944":832,"_25897":817,"_18081":44701,"_5":17976,"_24513":44670,"_2467":44702},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2944":833,"_25897":817,"_18081":44704,"_5":17976,"_24513":44670,"_2467":44705},[],"Example body:",{"_2944":834,"_25897":817,"_18081":44707,"_5":17976,"_24513":44670,"_2467":44708},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2944":835,"_25897":817,"_18081":44710,"_5":17976,"_24513":44670,"_2467":44711},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2944":836,"_25897":817,"_18081":44713,"_5":17976,"_24513":44670,"_2467":44714},[],"Continuation requires a successful HTTP response and JSON:",{"_2944":837,"_25897":817,"_18081":44716,"_5":17976,"_24513":44670,"_2467":44717},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2944":838,"_25897":817,"_18081":44719,"_5":17976,"_24513":44674,"_2467":44720},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2944":839,"_25897":817,"_18081":44722,"_5":17976,"_24513":44674,"_2467":44723},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2944":840,"_25897":840,"_5":12672,"_2467":44725,"_26242":44726,"_18081":44727,"_24513":840},"Configure and operate the DMS",[42109,43496,44470,44468,44651],[],{"_2944":841,"_25897":840,"_18081":44729,"_5":17976,"_24513":840,"_2467":44730},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2944":842,"_25897":840,"_5":26239,"_18081":44732,"_24513":44733,"_2467":42119},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2944":843,"_25897":840,"_5":26239,"_18081":44735,"_24513":44736,"_2467":44737},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2944":844,"_25897":840,"_5":26239,"_18081":44739,"_24513":44740,"_2467":44741},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2944":845,"_25897":840,"_5":26239,"_18081":44743,"_24513":44744,"_2467":44745},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2944":846,"_25897":840,"_5":26239,"_18081":44747,"_24513":44748,"_2467":44749},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2944":847,"_25897":840,"_5":26239,"_18081":44751,"_24513":44752,"_2467":44753},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2944":848,"_25897":840,"_5":26239,"_18081":44755,"_24513":44756,"_2467":44757},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2944":849,"_25897":840,"_5":26239,"_18081":44759,"_24513":44760,"_2467":44761},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2944":850,"_25897":840,"_5":26239,"_18081":44763,"_24513":44764,"_2467":44765},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2944":851,"_25897":840,"_5":26239,"_18081":44767,"_24513":44768,"_2467":44769},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2944":852,"_25897":840,"_5":26239,"_18081":44771,"_24513":44772,"_2467":44773},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2944":853,"_25897":840,"_5":26239,"_18081":44775,"_24513":44776,"_2467":44777},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2944":854,"_25897":840,"_5":26239,"_18081":44779,"_24513":44780,"_2467":44781},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2944":855,"_25897":840,"_5":26239,"_18081":44783,"_24513":44784,"_2467":44785},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2944":856,"_25897":840,"_5":26239,"_18081":44787,"_24513":44788,"_2467":44789},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2944":857,"_25897":840,"_5":26239,"_18081":44791,"_24513":44792,"_2467":44793},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2944":858,"_25897":840,"_5":26239,"_18081":44795,"_24513":44796,"_2467":44797},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2944":859,"_25897":840,"_5":26239,"_18081":44799,"_24513":44800,"_2467":44801},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2944":860,"_25897":840,"_18081":44803,"_5":17976,"_24513":840,"_2467":44804},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2944":861,"_25897":840,"_18081":44806,"_5":17976,"_24513":44733,"_2467":44807},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2944":862,"_25897":840,"_18081":44809,"_5":17976,"_24513":44733,"_2467":44810},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2944":863,"_25897":840,"_18081":44812,"_5":17976,"_24513":44740,"_2467":44813},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2944":864,"_25897":840,"_18081":44815,"_5":17976,"_24513":44744,"_2467":44816},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2944":865,"_25897":840,"_18081":44818,"_5":17976,"_24513":44748,"_2467":44819},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2944":866,"_25897":840,"_18081":44821,"_5":17976,"_24513":44752,"_2467":44822},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2944":867,"_25897":840,"_18081":44824,"_5":17976,"_24513":44756,"_2467":44825},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2944":868,"_25897":840,"_18081":44827,"_5":17976,"_24513":44764,"_2467":44828},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2944":869,"_25897":840,"_18081":44830,"_5":17976,"_24513":44764,"_2467":44831},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2944":870,"_25897":840,"_18081":44833,"_5":17976,"_24513":44768,"_2467":44834},[],"`settings.enrollment_settings` field",{"_2944":871,"_25897":840,"_18081":44836,"_5":17976,"_24513":44768,"_2467":44837},[],"Decision",{"_2944":872,"_25897":840,"_18081":44839,"_5":17976,"_24513":44768,"_2467":44840},[],"`protocol`",{"_2944":873,"_25897":840,"_18081":44842,"_5":17976,"_24513":44768,"_2467":44843},[],"`EST_RFC7030` for these operations.",{"_2944":874,"_25897":840,"_18081":44845,"_5":17976,"_24513":44768,"_2467":44846},[],"`enrollment_ca`",{"_2944":875,"_25897":840,"_18081":44848,"_5":17976,"_24513":44768,"_2467":44849},[],"ID of the signing CA.",{"_2944":876,"_25897":840,"_18081":44851,"_5":17976,"_24513":44768,"_2467":44852},[],"`verify_csr_signature`",{"_2944":877,"_25897":840,"_18081":44854,"_5":17976,"_24513":44768,"_2467":44855},[],"Keep `true` to verify CSR key possession.",{"_2944":878,"_25897":840,"_18081":44857,"_5":17976,"_24513":44768,"_2467":44858},[],"`enable_replaceable_enrollment`",{"_2944":879,"_25897":840,"_18081":44860,"_5":17976,"_24513":44768,"_2467":44861},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2944":880,"_25897":840,"_18081":44863,"_5":17976,"_24513":44768,"_2467":44864},[],"`est_rfc7030_settings.auth_mode`",{"_2944":881,"_25897":840,"_18081":44866,"_5":17976,"_24513":44768,"_2467":44867},[],"One of the four authentication modes.",{"_2944":882,"_25897":840,"_18081":44869,"_5":17976,"_24513":44768,"_2467":44870},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2944":883,"_25897":840,"_18081":44872,"_5":17976,"_24513":44772,"_2467":44873},[],"The blocks are independent:",{"_2944":884,"_25897":840,"_18081":44875,"_5":17976,"_24513":44772,"_2467":44876},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2944":885,"_25897":840,"_18081":44878,"_5":17976,"_24513":44772,"_2467":44879},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2944":886,"_25897":840,"_18081":44881,"_5":17976,"_24513":44772,"_2467":44882},[],"`auth_mode`",{"_2944":887,"_25897":840,"_18081":44884,"_5":17976,"_24513":44772,"_2467":44885},[],"Control applied in the configured operation",{"_2944":888,"_25897":840,"_18081":44887,"_5":17976,"_24513":44772,"_2467":44888},[],"`CLIENT_CERTIFICATE`",{"_2944":889,"_25897":840,"_18081":44890,"_5":17976,"_24513":44772,"_2467":44891},[],"Presented certificate validation.",{"_2944":890,"_25897":840,"_18081":44893,"_5":17976,"_24513":44772,"_2467":44894},[],"`EXTERNAL_WEBHOOK`",{"_2944":891,"_25897":840,"_18081":44896,"_5":17976,"_24513":44772,"_2467":44897},[],"Configured webhook authorization.",{"_2944":892,"_25897":840,"_18081":44899,"_5":17976,"_24513":44772,"_2467":44900},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2944":893,"_25897":840,"_18081":44902,"_5":17976,"_24513":44772,"_2467":44903},[],"Certificate validation followed by webhook approval.",{"_2944":894,"_25897":840,"_18081":44905,"_5":17976,"_24513":44772,"_2467":44906},[],"`NO_AUTH`",{"_2944":895,"_25897":840,"_18081":44908,"_5":17976,"_24513":44772,"_2467":44909},[],"No DMS requester authentication.",{"_2944":896,"_25897":840,"_18081":44911,"_5":17976,"_24513":44772,"_2467":44912},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2944":897,"_25897":840,"_18081":44914,"_5":17976,"_24513":44772,"_2467":44915},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2944":898,"_25897":840,"_18081":44917,"_5":17976,"_24513":44772,"_2467":44918},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_2944":899,"_25897":840,"_18081":44920,"_5":17976,"_24513":44772,"_2467":44921},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2944":900,"_25897":840,"_18081":44923,"_5":17976,"_24513":44776,"_2467":44924},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2944":901,"_25897":840,"_18081":44926,"_5":17976,"_24513":44776,"_2467":44927},[],"`external_webhook_settings` field",{"_2944":902,"_25897":840,"_18081":44929,"_5":17976,"_24513":44776,"_2467":44837},[],{"_2944":903,"_25897":840,"_18081":44931,"_5":17976,"_24513":44776,"_2467":44932},[],"`url`",{"_2944":904,"_25897":840,"_18081":44934,"_5":17976,"_24513":44776,"_2467":44935},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2944":905,"_25897":840,"_18081":44937,"_5":17976,"_24513":44776,"_2467":44938},[],"`method`",{"_2944":906,"_25897":840,"_18081":44940,"_5":17976,"_24513":44776,"_2467":44941},[],"`POST` or `PUT`; `POST` by default.",{"_2944":907,"_25897":840,"_18081":44943,"_5":17976,"_24513":44776,"_2467":44944},[],"`name`",{"_2944":908,"_25897":840,"_18081":44946,"_5":17976,"_24513":44776,"_2467":44947},[],"Label used in service logs.",{"_2944":909,"_25897":840,"_18081":44949,"_5":17976,"_24513":44776,"_2467":44950},[],"`config.auth_mode`",{"_2944":910,"_25897":840,"_18081":44952,"_5":17976,"_24513":44776,"_2467":44953},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2944":911,"_25897":840,"_18081":44955,"_5":17976,"_24513":44776,"_2467":44956},[],"`config.apikey_options`",{"_2944":912,"_25897":840,"_18081":44958,"_5":17976,"_24513":44776,"_2467":44959},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2944":913,"_25897":840,"_18081":44961,"_5":17976,"_24513":44776,"_2467":44962},[],"`config.jwt_options`",{"_2944":914,"_25897":840,"_18081":44964,"_5":17976,"_24513":44776,"_2467":44965},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2944":915,"_25897":840,"_18081":44967,"_5":17976,"_24513":44776,"_2467":44968},[],"`config.mtls_options`",{"_2944":916,"_25897":840,"_18081":44970,"_5":17976,"_24513":44776,"_2467":44971},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_2944":917,"_25897":840,"_18081":44973,"_5":17976,"_24513":44776,"_2467":44974},[],"`config.insecure_skip_verify`",{"_2944":918,"_25897":840,"_18081":44976,"_5":17976,"_24513":44776,"_2467":44977},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2944":919,"_25897":840,"_18081":44979,"_5":17976,"_24513":44776,"_2467":44980},[],"`config.call_timeout`",{"_2944":920,"_25897":840,"_18081":44982,"_5":17976,"_24513":44776,"_2467":44983},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2944":921,"_25897":840,"_18081":44985,"_5":17976,"_24513":44776,"_2467":44986},[],"Rules for that configuration:",{"_2944":922,"_25897":840,"_18081":44988,"_5":17976,"_24513":44776,"_2467":44989},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_2944":923,"_25897":840,"_18081":44991,"_5":17976,"_24513":44776,"_2467":44992},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2944":924,"_25897":840,"_18081":44994,"_5":17976,"_24513":44776,"_2467":44995},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2944":925,"_25897":840,"_18081":44997,"_5":17976,"_24513":44776,"_2467":44998},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_2944":926,"_25897":840,"_18081":45000,"_5":17976,"_24513":44776,"_2467":45001},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2944":927,"_25897":840,"_18081":45003,"_5":17976,"_24513":44776,"_2467":45004},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2944":928,"_25897":840,"_18081":45006,"_5":17976,"_24513":44776,"_2467":45007},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_2944":929,"_25897":840,"_18081":45009,"_5":17976,"_24513":44776,"_2467":45010},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_2944":930,"_25897":840,"_18081":45012,"_5":17976,"_24513":44776,"_2467":45013},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_2944":931,"_25897":840,"_18081":45015,"_5":17976,"_24513":44780,"_2467":45016},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2944":932,"_25897":840,"_18081":45018,"_5":17976,"_24513":44784,"_2467":45019},[],"`settings.reenrollment_settings` field",{"_2944":933,"_25897":840,"_18081":45021,"_5":17976,"_24513":44784,"_2467":42496},[],{"_2944":934,"_25897":840,"_18081":45023,"_5":17976,"_24513":44784,"_2467":45024},[],"`reenrollment_delta`",{"_2944":935,"_25897":840,"_18081":45026,"_5":17976,"_24513":44784,"_2467":45027},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2944":936,"_25897":840,"_18081":45029,"_5":17976,"_24513":44784,"_2467":45030},[],"`preventive_delta`",{"_2944":937,"_25897":840,"_18081":45032,"_5":17976,"_24513":44784,"_2467":45033},[],"Preventive operational monitoring threshold.",{"_2944":938,"_25897":840,"_18081":45035,"_5":17976,"_24513":44784,"_2467":45036},[],"`critical_delta`",{"_2944":939,"_25897":840,"_18081":45038,"_5":17976,"_24513":44784,"_2467":45039},[],"Critical operational monitoring threshold.",{"_2944":940,"_25897":840,"_18081":45041,"_5":17976,"_24513":44784,"_2467":45042},[],"`enable_expired_renewal`",{"_2944":941,"_25897":840,"_18081":45044,"_5":17976,"_24513":44784,"_2467":45045},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2944":942,"_25897":840,"_18081":45047,"_5":17976,"_24513":44784,"_2467":45048},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_2944":943,"_25897":840,"_18081":45050,"_5":17976,"_24513":44784,"_2467":45051},[],"Additional validation CAs for the renewal mTLS credential, tried after the enrollment CA; typically populated during CA rotation while old-CA cohorts renew.",{"_2944":944,"_25897":840,"_18081":45053,"_5":17976,"_24513":44784,"_2467":45054},[],"`revoke_on_reenrollment`",{"_2944":945,"_25897":840,"_18081":45056,"_5":17976,"_24513":44784,"_2467":45057},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2944":946,"_25897":840,"_18081":45059,"_5":17976,"_24513":44784,"_2467":45060},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2944":947,"_25897":840,"_18081":45062,"_5":17976,"_24513":44788,"_2467":45063},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2944":948,"_25897":840,"_18081":45065,"_5":17976,"_24513":44792,"_2467":42490},[],{"_2944":949,"_25897":840,"_18081":45067,"_5":17976,"_24513":44792,"_2467":45068},[],"Published material",{"_2944":950,"_25897":840,"_18081":45070,"_5":17976,"_24513":44792,"_2467":45071},[],"**Include Lamassu System CA**",{"_2944":951,"_25897":840,"_18081":45073,"_5":17976,"_24513":44792,"_2467":45074},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2944":952,"_25897":840,"_18081":45076,"_5":17976,"_24513":44792,"_2467":45077},[],"**Include Enrollment CA**",{"_2944":953,"_25897":840,"_18081":45079,"_5":17976,"_24513":44792,"_2467":45080},[],"Selected issuing CA certificate.",{"_2944":954,"_25897":840,"_18081":45082,"_5":17976,"_24513":44792,"_2467":45083},[],"**Managed CAs**",{"_2944":955,"_25897":840,"_18081":45085,"_5":17976,"_24513":44792,"_2467":45086},[],"Explicitly selected CA certificates.",{"_2944":956,"_25897":840,"_18081":45088,"_5":17976,"_24513":44792,"_2467":45089},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2944":957,"_25897":840,"_18081":45091,"_5":17976,"_24513":44796,"_2467":45092},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2944":958,"_25897":840,"_18081":45094,"_5":17976,"_24513":44796,"_2467":45095},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2944":959,"_25897":840,"_18081":45097,"_5":17976,"_24513":44796,"_2467":45098},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2944":960,"_25897":840,"_18081":45100,"_5":17976,"_24513":44800,"_2467":45101},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2944":961,"_25897":961,"_5":12672,"_2467":45103,"_26242":45104,"_18081":45105,"_24513":961},"Integrate the EST client",[42109,43496,44470,44468,44651],[],{"_2944":962,"_25897":961,"_18081":45107,"_5":17976,"_24513":961,"_2467":45108},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2944":963,"_25897":961,"_5":26239,"_18081":45110,"_24513":45111,"_2467":42119},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2944":964,"_25897":961,"_5":26239,"_18081":45113,"_24513":45114,"_2467":45115},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2944":965,"_25897":961,"_5":26239,"_18081":45117,"_24513":45118,"_2467":45119},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2944":966,"_25897":961,"_5":26239,"_18081":45121,"_24513":45122,"_2467":45123},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2944":967,"_25897":961,"_5":26239,"_18081":45125,"_24513":45126,"_2467":45127},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2944":968,"_25897":961,"_5":26239,"_18081":45129,"_24513":45130,"_2467":45131},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2944":969,"_25897":961,"_18081":45133,"_5":17976,"_24513":961,"_2467":45134},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2944":970,"_25897":961,"_18081":45136,"_5":17976,"_24513":45111,"_2467":45137},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2944":971,"_25897":961,"_18081":45139,"_5":17976,"_24513":45111,"_2467":45140},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2944":972,"_25897":961,"_18081":45142,"_5":17976,"_24513":45111,"_2467":45143},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2944":973,"_25897":961,"_18081":45145,"_5":17976,"_24513":45114,"_2467":45146},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2944":974,"_25897":961,"_18081":45148,"_5":17976,"_24513":45114,"_2467":45149},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2944":975,"_25897":961,"_18081":45151,"_5":17976,"_24513":45118,"_2467":45152},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2944":976,"_25897":961,"_18081":45154,"_5":17976,"_24513":45118,"_2467":45155},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2944":977,"_25897":961,"_18081":45157,"_5":17976,"_24513":45122,"_2467":45158},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2944":978,"_25897":961,"_18081":45160,"_5":17976,"_24513":45122,"_2467":45161},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2944":979,"_25897":961,"_18081":45163,"_5":17976,"_24513":45126,"_2467":45164},[],"For a root that issues directly:",{"_2944":980,"_25897":961,"_18081":45166,"_5":17976,"_24513":45126,"_2467":45167},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2944":981,"_25897":961,"_18081":45169,"_5":17976,"_24513":45126,"_2467":45170},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2944":982,"_25897":961,"_18081":45172,"_5":17976,"_24513":45130,"_2467":45173},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2944":983,"_25897":983,"_5":12672,"_2467":45175,"_26242":45176,"_18081":45177,"_24513":983},"EST reference",[42109,43496,44470,44468,44651],[],{"_2944":984,"_25897":983,"_18081":45179,"_5":17976,"_24513":983,"_2467":45180},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2944":985,"_25897":983,"_5":26239,"_18081":45182,"_24513":45183,"_2467":45184},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2944":986,"_25897":983,"_5":26239,"_18081":45186,"_24513":45187,"_2467":19634},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2944":987,"_25897":983,"_5":26239,"_18081":45189,"_24513":45190,"_2467":22472},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2944":988,"_25897":983,"_5":26239,"_18081":45192,"_24513":45193,"_2467":22479},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2944":989,"_25897":983,"_5":26239,"_18081":45195,"_24513":45196,"_2467":21838},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2944":990,"_25897":983,"_5":26239,"_18081":45198,"_24513":45199,"_2467":45200},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2944":991,"_25897":983,"_5":26239,"_18081":45202,"_24513":45203,"_2467":45204},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2944":992,"_25897":983,"_5":26239,"_18081":45206,"_24513":45207,"_2467":45208},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2944":993,"_25897":983,"_18081":45210,"_5":17976,"_24513":983,"_2467":45211},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2944":994,"_25897":983,"_18081":45213,"_5":17976,"_24513":45183,"_2467":45214},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2944":995,"_25897":983,"_18081":45216,"_5":17976,"_24513":45183,"_2467":45217},[],"Operation",{"_2944":996,"_25897":983,"_18081":45219,"_5":17976,"_24513":45183,"_2467":45220},[],"Method",{"_2944":997,"_25897":983,"_18081":45222,"_5":17976,"_24513":45183,"_2467":45223},[],"Authentication and condition",{"_2944":998,"_25897":983,"_18081":45225,"_5":17976,"_24513":45183,"_2467":45226},[],"`/cacerts`",{"_2944":999,"_25897":983,"_18081":45228,"_5":17976,"_24513":45183,"_2467":45229},[],"GET",{"_2944":1000,"_25897":983,"_18081":45231,"_5":17976,"_24513":45183,"_2467":45232},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2944":1001,"_25897":983,"_18081":45234,"_5":17976,"_24513":45183,"_2467":45235},[],"`/simpleenroll`",{"_2944":1002,"_25897":983,"_18081":45237,"_5":17976,"_24513":45183,"_2467":45238},[],"POST",{"_2944":1003,"_25897":983,"_18081":45240,"_5":17976,"_24513":45183,"_2467":45241},[],"Initial authentication and DMS registration/replacement policy.",{"_2944":1004,"_25897":983,"_18081":45243,"_5":17976,"_24513":45183,"_2467":45244},[],"`/simplereenroll`",{"_2944":1005,"_25897":983,"_18081":45246,"_5":17976,"_24513":45183,"_2467":45238},[],{"_2944":1006,"_25897":983,"_18081":45248,"_5":17976,"_24513":45183,"_2467":45249},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2944":1007,"_25897":983,"_18081":45251,"_5":17976,"_24513":45183,"_2467":45252},[],"`/serverkeygen`",{"_2944":1008,"_25897":983,"_18081":45254,"_5":17976,"_24513":45183,"_2467":45238},[],{"_2944":1009,"_25897":983,"_18081":45256,"_5":17976,"_24513":45183,"_2467":45257},[],"Initial authentication and admission; server generation enabled.",{"_2944":1010,"_25897":983,"_18081":45259,"_5":17976,"_24513":45183,"_2467":45260},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2944":1011,"_25897":983,"_18081":45262,"_5":17976,"_24513":45187,"_2467":45263},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2944":1012,"_25897":983,"_18081":45265,"_5":17976,"_24513":45187,"_2467":45266},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2944":1013,"_25897":983,"_18081":45268,"_5":17976,"_24513":45190,"_2467":45269},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2944":1014,"_25897":983,"_18081":45271,"_5":17976,"_24513":45190,"_2467":45272},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2944":1015,"_25897":983,"_18081":45274,"_5":17976,"_24513":45193,"_2467":45275},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2944":1016,"_25897":983,"_18081":45277,"_5":17976,"_24513":45193,"_2467":45278},[],"The enrollment CA or a validation CA configured in the re-enrollment block validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2944":1017,"_25897":983,"_18081":45280,"_5":17976,"_24513":45196,"_2467":45281},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2944":1018,"_25897":983,"_18081":45283,"_5":17976,"_24513":45196,"_2467":45284},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2944":1019,"_25897":983,"_18081":45286,"_5":17976,"_24513":45199,"_2467":45287},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2944":1020,"_25897":983,"_18081":45289,"_5":17976,"_24513":45199,"_2467":45290},[],"Part",{"_2944":1021,"_25897":983,"_18081":45292,"_5":17976,"_24513":45199,"_2467":45293},[],"Content after decoding its Base64",{"_2944":1022,"_25897":983,"_18081":45295,"_5":17976,"_24513":45199,"_2467":45296},[],"`application/pkcs8`",{"_2944":1023,"_25897":983,"_18081":45298,"_5":17976,"_24513":45199,"_2467":45299},[],"Unencrypted DER PKCS#8 private key.",{"_2944":1024,"_25897":983,"_18081":45301,"_5":17976,"_24513":45199,"_2467":45302},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2944":1025,"_25897":983,"_18081":45304,"_5":17976,"_24513":45199,"_2467":45305},[],"DER PKCS#7 containing the issued certificate.",{"_2944":1026,"_25897":983,"_18081":45307,"_5":17976,"_24513":45199,"_2467":45308},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2944":1027,"_25897":983,"_18081":45310,"_5":17976,"_24513":45203,"_2467":45311},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2944":1028,"_25897":983,"_18081":45313,"_5":17976,"_24513":45203,"_2467":45314},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2944":1029,"_25897":983,"_18081":45316,"_5":17976,"_24513":45203,"_2467":45317},[],"Convert and check the result:",{"_2944":1030,"_25897":983,"_18081":45319,"_5":17976,"_24513":45203,"_2467":45320},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2944":1031,"_25897":983,"_18081":45322,"_5":17976,"_24513":45207,"_2467":45323},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2944":1032,"_25897":983,"_18081":45325,"_5":17976,"_24513":45207,"_2467":45326},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2944":1033,"_25897":1033,"_5":12672,"_2467":44651,"_26242":45328,"_18081":45329,"_24513":1033},[42109,43496,44470,44468,44651],[],{"_2944":1034,"_25897":1033,"_18081":45331,"_5":17976,"_24513":1033,"_2467":45332},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2944":1035,"_25897":1033,"_5":26239,"_18081":45334,"_24513":45335,"_2467":45336},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2944":1036,"_25897":1033,"_5":26239,"_18081":45338,"_24513":45339,"_2467":45340},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2944":1037,"_25897":1033,"_5":26239,"_18081":45342,"_24513":45343,"_2467":45344},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2944":1038,"_25897":1033,"_5":26239,"_18081":45346,"_24513":45347,"_2467":45348},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2944":1039,"_25897":1033,"_18081":45350,"_5":17976,"_24513":1033,"_2467":45351},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2944":1040,"_25897":1033,"_18081":45353,"_5":17976,"_24513":45335,"_2467":45354},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2944":1041,"_25897":1033,"_18081":45356,"_5":17976,"_24513":45335,"_2467":45357},[],"The integrator installs initial EST server trust and an admission credential.",{"_2944":1042,"_25897":1033,"_18081":45359,"_5":17976,"_24513":45335,"_2467":45360},[],"The client requests an identity for its `Device ID` through EST.",{"_2944":1043,"_25897":1033,"_18081":45362,"_5":17976,"_24513":45335,"_2467":45363},[],"Certificate, device binding and key/certificate installation are checked.",{"_2944":1044,"_25897":1033,"_18081":45365,"_5":17976,"_24513":45335,"_2467":45366},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2944":1045,"_25897":1033,"_18081":45368,"_5":17976,"_24513":45335,"_2467":45369},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2944":1046,"_25897":1033,"_18081":45371,"_5":17976,"_24513":45339,"_2467":45372},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2944":1047,"_25897":1033,"_18081":45374,"_5":17976,"_24513":45339,"_2467":45375},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2944":1048,"_25897":1033,"_18081":45377,"_5":17976,"_24513":45339,"_2467":45378},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2944":1049,"_25897":1033,"_18081":45380,"_5":17976,"_24513":45339,"_2467":45381},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2944":1050,"_25897":1033,"_18081":45383,"_5":17976,"_24513":45343,"_2467":45384},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2944":1051,"_25897":1033,"_18081":45386,"_5":17976,"_24513":45343,"_2467":45387},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2944":1052,"_25897":1033,"_18081":45389,"_5":17976,"_24513":45343,"_2467":45390},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2944":1053,"_25897":1033,"_18081":45392,"_5":17976,"_24513":45343,"_2467":45393},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2944":1054,"_25897":1033,"_18081":45395,"_5":17976,"_24513":45347,"_2467":45396},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2944":1055,"_25897":1033,"_18081":45398,"_5":17976,"_24513":45347,"_2467":45399},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2944":1056,"_25897":1056,"_5":12672,"_2467":45401,"_26242":45402,"_18081":45403,"_24513":1056},"Provisioning strategies",[42109,43496,44470,44468,44651],[],{"_2944":1057,"_25897":1056,"_18081":45405,"_5":17976,"_24513":1056,"_2467":45406},[],"Choose device registration, identity authorization and key generation.",{"_2944":1058,"_25897":1056,"_5":26239,"_18081":45408,"_24513":45409,"_2467":45410},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2944":1059,"_25897":1056,"_5":26239,"_18081":45412,"_24513":45413,"_2467":45414},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2944":1060,"_25897":1056,"_5":26239,"_18081":45416,"_24513":45417,"_2467":45418},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2944":1061,"_25897":1056,"_5":26239,"_18081":45420,"_24513":45421,"_2467":45422},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2944":1062,"_25897":1056,"_5":26239,"_18081":45424,"_24513":45425,"_2467":45426},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2944":1063,"_25897":1056,"_18081":45428,"_5":17976,"_24513":1056,"_2467":45429},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2944":1064,"_25897":1056,"_18081":45431,"_5":17976,"_24513":45409,"_2467":45432},[],"Path",{"_2944":1065,"_25897":1056,"_18081":45434,"_5":17976,"_24513":45409,"_2467":45435},[],"When the device exists",{"_2944":1066,"_25897":1056,"_18081":45437,"_5":17976,"_24513":45409,"_2467":45438},[],"What to check",{"_2944":1067,"_25897":1056,"_18081":45440,"_5":17976,"_24513":45409,"_2467":45441},[],"Manual assignment",{"_2944":1068,"_25897":1056,"_18081":45443,"_5":17976,"_24513":45409,"_2467":45444},[],"An operator creates it before associating a certificate.",{"_2944":1069,"_25897":1056,"_18081":45446,"_5":17976,"_24513":45409,"_2467":45447},[],"ID, owning DMS, certificate CN and bound serial.",{"_2944":1070,"_25897":1056,"_18081":45449,"_5":17976,"_24513":45409,"_2467":45450},[],"EST with `JITP`",{"_2944":1071,"_25897":1056,"_18081":45452,"_5":17976,"_24513":45409,"_2467":45453},[],"Created for an unknown CN during `/simpleenroll`.",{"_2944":1072,"_25897":1056,"_18081":45455,"_5":17976,"_24513":45409,"_2467":45456},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2944":1073,"_25897":1056,"_18081":45458,"_5":17976,"_24513":45409,"_2467":45459},[],"EST with `PRE_REGISTRATION`",{"_2944":1074,"_25897":1056,"_18081":45461,"_5":17976,"_24513":45409,"_2467":45462},[],"Must exist before `/simpleenroll`.",{"_2944":1075,"_25897":1056,"_18081":45464,"_5":17976,"_24513":45409,"_2467":45465},[],"Approved record, same DMS and replacement conditions for your version.",{"_2944":1076,"_25897":1056,"_18081":45467,"_5":17976,"_24513":45409,"_2467":45468},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2944":1077,"_25897":1056,"_18081":45470,"_5":17976,"_24513":45409,"_2467":45471},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2944":1078,"_25897":1056,"_18081":45473,"_5":17976,"_24513":45413,"_2467":45474},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2944":1079,"_25897":1056,"_18081":45476,"_5":17976,"_24513":45413,"_2467":45477},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2944":1080,"_25897":1056,"_18081":45479,"_5":17976,"_24513":45413,"_2467":45480},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2944":1081,"_25897":1056,"_18081":45482,"_5":17976,"_24513":45417,"_2467":45483},[],"Decide initial enrollment and re-enrollment separately:",{"_2944":1082,"_25897":1056,"_18081":45485,"_5":17976,"_24513":45417,"_2467":45486},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2944":1083,"_25897":1056,"_18081":45488,"_5":17976,"_24513":45417,"_2467":45489},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2944":1084,"_25897":1056,"_18081":45491,"_5":17976,"_24513":45417,"_2467":45492},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2944":1085,"_25897":1056,"_18081":45494,"_5":17976,"_24513":45417,"_2467":45495},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2944":1086,"_25897":1056,"_18081":45497,"_5":17976,"_24513":45417,"_2467":45498},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2944":1087,"_25897":1056,"_18081":45500,"_5":17976,"_24513":45421,"_2467":42490},[],{"_2944":1088,"_25897":1056,"_18081":45502,"_5":17976,"_24513":45421,"_2467":45503},[],"Material crossing EST",{"_2944":1089,"_25897":1056,"_18081":45505,"_5":17976,"_24513":45421,"_2467":45506},[],"Device-generated key",{"_2944":1090,"_25897":1056,"_18081":45508,"_5":17976,"_24513":45421,"_2467":45509},[],"Public CSR and certificate; the key stays on the client.",{"_2944":1091,"_25897":1056,"_18081":45511,"_5":17976,"_24513":45421,"_2467":45512},[],"Existing device key",{"_2944":1092,"_25897":1056,"_18081":45514,"_5":17976,"_24513":45421,"_2467":45515},[],"CSR signed with that key and a new certificate.",{"_2944":1093,"_25897":1056,"_18081":45517,"_5":17976,"_24513":45421,"_2467":44789},[],{"_2944":1094,"_25897":1056,"_18081":45519,"_5":17976,"_24513":45421,"_2467":45520},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2944":1095,"_25897":1056,"_18081":45522,"_5":17976,"_24513":45421,"_2467":45523},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2944":1096,"_25897":1056,"_18081":45525,"_5":17976,"_24513":45425,"_2467":45526},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2944":1097,"_25897":1097,"_5":12672,"_2467":45528,"_26242":45529,"_18081":45530,"_24513":1097},"Renewal and recovery",[42109,43496,44470,44468,44651],[],{"_2944":1098,"_25897":1097,"_18081":45532,"_5":17976,"_24513":1097,"_2467":45533},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2944":1099,"_25897":1097,"_5":26239,"_18081":45535,"_24513":45536,"_2467":45537},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2944":1100,"_25897":1097,"_5":26239,"_18081":45539,"_24513":45540,"_2467":45541},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2944":1101,"_25897":1097,"_5":26239,"_18081":45543,"_24513":45544,"_2467":45545},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2944":1102,"_25897":1097,"_5":26239,"_18081":45547,"_24513":45548,"_2467":45549},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2944":1103,"_25897":1097,"_5":26239,"_18081":45551,"_24513":45552,"_2467":45553},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2944":1104,"_25897":1097,"_18081":45555,"_5":17976,"_24513":1097,"_2467":45556},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2944":1105,"_25897":1097,"_18081":45558,"_5":17976,"_24513":45536,"_2467":45559},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2944":1106,"_25897":1097,"_18081":45561,"_5":17976,"_24513":45536,"_2467":45562},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2944":1107,"_25897":1097,"_18081":45564,"_5":17976,"_24513":45536,"_2467":45565},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2944":1108,"_25897":1097,"_18081":45567,"_5":17976,"_24513":45536,"_2467":45568},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2944":1109,"_25897":1097,"_18081":45570,"_5":17976,"_24513":45540,"_2467":45571},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2944":1110,"_25897":1097,"_18081":45573,"_5":17976,"_24513":45540,"_2467":45574},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2944":1111,"_25897":1097,"_18081":45576,"_5":17976,"_24513":45544,"_2467":45577},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2944":1112,"_25897":1097,"_18081":45579,"_5":17976,"_24513":45544,"_2467":45580},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2944":1113,"_25897":1097,"_18081":45582,"_5":17976,"_24513":45544,"_2467":45583},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2944":1114,"_25897":1097,"_18081":45585,"_5":17976,"_24513":45548,"_2467":45586},[],"Situation",{"_2944":1115,"_25897":1097,"_18081":45588,"_5":17976,"_24513":45548,"_2467":45589},[],"Procedure",{"_2944":1116,"_25897":1097,"_18081":45591,"_5":17976,"_24513":45548,"_2467":45592},[],"Valid certificate, outside the window",{"_2944":1117,"_25897":1097,"_18081":45594,"_5":17976,"_24513":45548,"_2467":45595},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2944":1118,"_25897":1097,"_18081":45597,"_5":17976,"_24513":45548,"_2467":45598},[],"Expired certificate, key available",{"_2944":1119,"_25897":1097,"_18081":45600,"_5":17976,"_24513":45548,"_2467":45601},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2944":1120,"_25897":1097,"_18081":45603,"_5":17976,"_24513":45548,"_2467":45604},[],"Renewal through webhook or `NO_AUTH`",{"_2944":1121,"_25897":1097,"_18081":45606,"_5":17976,"_24513":45548,"_2467":45607},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2944":1122,"_25897":1097,"_18081":45609,"_5":17976,"_24513":45548,"_2467":45610},[],"Lost or inaccessible key",{"_2944":1123,"_25897":1097,"_18081":45612,"_5":17976,"_24513":45548,"_2467":45613},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2944":1124,"_25897":1097,"_18081":45615,"_5":17976,"_24513":45548,"_2467":45616},[],"Current identity revoked",{"_2944":1125,"_25897":1097,"_18081":45618,"_5":17976,"_24513":45548,"_2467":45619},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2944":1126,"_25897":1097,"_18081":45621,"_5":17976,"_24513":45548,"_2467":45622},[],"Device without an identity",{"_2944":1127,"_25897":1097,"_18081":45624,"_5":17976,"_24513":45548,"_2467":45625},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2944":1128,"_25897":1097,"_18081":45627,"_5":17976,"_24513":45548,"_2467":45628},[],"Retired device",{"_2944":1129,"_25897":1097,"_18081":45630,"_5":17976,"_24513":45548,"_2467":45631},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2944":1130,"_25897":1097,"_18081":45633,"_5":17976,"_24513":45548,"_2467":45634},[],"Timeout, HTTP 500 or installation failure",{"_2944":1131,"_25897":1097,"_18081":45636,"_5":17976,"_24513":45548,"_2467":45637},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2944":1132,"_25897":1097,"_18081":45639,"_5":17976,"_24513":45552,"_2467":45640},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2944":1133,"_25897":1097,"_18081":45642,"_5":17976,"_24513":45552,"_2467":45643},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2944":1134,"_25897":1134,"_5":12672,"_2467":45645,"_26242":45646,"_18081":45647,"_24513":1134},"Enrollment troubleshooting",[42109,43496,44470,44468,44651],[],{"_2944":1135,"_25897":1134,"_18081":45649,"_5":17976,"_24513":1134,"_2467":45650},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2944":1136,"_25897":1134,"_5":26239,"_18081":45652,"_24513":45653,"_2467":45654},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2944":1137,"_25897":1134,"_5":26239,"_18081":45656,"_24513":45657,"_2467":45658},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2944":1138,"_25897":1134,"_5":26239,"_18081":45660,"_24513":45661,"_2467":45208},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2944":1139,"_25897":1134,"_5":26239,"_18081":45663,"_24513":45664,"_2467":45665},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2944":1140,"_25897":1134,"_18081":45667,"_5":17976,"_24513":1134,"_2467":45668},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2944":1141,"_25897":1134,"_18081":45670,"_5":17976,"_24513":45657,"_2467":45671},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2944":1142,"_25897":1134,"_18081":45673,"_5":17976,"_24513":45657,"_2467":45674},[],"Symptom or message",{"_2944":1143,"_25897":1134,"_18081":45676,"_5":17976,"_24513":45657,"_2467":45438},[],{"_2944":1144,"_25897":1134,"_18081":45678,"_5":17976,"_24513":45657,"_2467":45679},[],"curl rejects TLS, name or issuer",{"_2944":1145,"_25897":1134,"_18081":45681,"_5":17976,"_24513":45657,"_2467":45682},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2944":1146,"_25897":1134,"_18081":45684,"_5":17976,"_24513":45657,"_2467":45685},[],"404 or missing APS",{"_2944":1147,"_25897":1134,"_18081":45687,"_5":17976,"_24513":45657,"_2467":45688},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2944":1148,"_25897":1134,"_18081":45690,"_5":17976,"_24513":45657,"_2467":45691},[],"400, CSR or format error",{"_2944":1149,"_25897":1134,"_18081":45693,"_5":17976,"_24513":45657,"_2467":45694},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2944":1150,"_25897":1134,"_18081":45696,"_5":17976,"_24513":45657,"_2467":45697},[],"Missing credential or invalid certificate",{"_2944":1151,"_25897":1134,"_18081":45699,"_5":17976,"_24513":45657,"_2467":45700},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2944":1152,"_25897":1134,"_18081":45702,"_5":17976,"_24513":45657,"_2467":45703},[],"Webhook denies, times out or responds without authorization",{"_2944":1153,"_25897":1134,"_18081":45705,"_5":17976,"_24513":45657,"_2467":45706},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2944":1154,"_25897":1134,"_18081":45708,"_5":17976,"_24513":45657,"_2467":45709},[],"`unexpected status code: <n>: redirects are not followed`",{"_2944":1155,"_25897":1134,"_18081":45711,"_5":17976,"_24513":45657,"_2467":45712},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2944":1156,"_25897":1134,"_18081":45714,"_5":17976,"_24513":45657,"_2467":45715},[],"`webhook response exceeds 1048576 bytes`",{"_2944":1157,"_25897":1134,"_18081":45717,"_5":17976,"_24513":45657,"_2467":45718},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2944":1158,"_25897":1134,"_18081":45720,"_5":17976,"_24513":45657,"_2467":45721},[],"`webhook config must not reference files`",{"_2944":1159,"_25897":1134,"_18081":45723,"_5":17976,"_24513":45657,"_2467":45724},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_2944":1160,"_25897":1134,"_18081":45726,"_5":17976,"_24513":45657,"_2467":45727},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_2944":1161,"_25897":1134,"_18081":45729,"_5":17976,"_24513":45657,"_2467":45730},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_2944":1162,"_25897":1134,"_18081":45732,"_5":17976,"_24513":45657,"_2467":45733},[],"`webhook mTLS certificate and key are invalid: …`",{"_2944":1163,"_25897":1134,"_18081":45735,"_5":17976,"_24513":45657,"_2467":45736},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_2944":1164,"_25897":1134,"_18081":45738,"_5":17976,"_24513":45657,"_2467":45739},[],"400 `struct validation error` creating or updating a DMS",{"_2944":1165,"_25897":1134,"_18081":45741,"_5":17976,"_24513":45657,"_2467":45742},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2944":1166,"_25897":1134,"_18081":45744,"_5":17976,"_24513":45657,"_2467":45745},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2944":1167,"_25897":1134,"_18081":45747,"_5":17976,"_24513":45657,"_2467":45748},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2944":1168,"_25897":1134,"_18081":45750,"_5":17976,"_24513":45657,"_2467":45751},[],"`device not preregistered`",{"_2944":1169,"_25897":1134,"_18081":45753,"_5":17976,"_24513":45657,"_2467":45754},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2944":1170,"_25897":1134,"_18081":45756,"_5":17976,"_24513":45657,"_2467":45757},[],"`forbiddenNewEnrollment`",{"_2944":1171,"_25897":1134,"_18081":45759,"_5":17976,"_24513":45657,"_2467":45760},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2944":1172,"_25897":1134,"_18081":45762,"_5":17976,"_24513":45657,"_2467":45763},[],"Different owning DMS",{"_2944":1173,"_25897":1134,"_18081":45765,"_5":17976,"_24513":45657,"_2467":45766},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2944":1174,"_25897":1134,"_18081":45768,"_5":17976,"_24513":45657,"_2467":45769},[],"`invalid RawSubject bytes`",{"_2944":1175,"_25897":1134,"_18081":45771,"_5":17976,"_24513":45657,"_2467":45772},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2944":1176,"_25897":1134,"_18081":45774,"_5":17976,"_24513":45657,"_2467":45775},[],"`invalid reenroll window`",{"_2944":1177,"_25897":1134,"_18081":45777,"_5":17976,"_24513":45657,"_2467":45778},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2944":1178,"_25897":1134,"_18081":45780,"_5":17976,"_24513":45657,"_2467":45781},[],"Current certificate revoked",{"_2944":1179,"_25897":1134,"_18081":45783,"_5":17976,"_24513":45657,"_2467":45784},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2944":1180,"_25897":1134,"_18081":45786,"_5":17976,"_24513":45657,"_2467":45787},[],"CA, profile or signing error",{"_2944":1181,"_25897":1134,"_18081":45789,"_5":17976,"_24513":45657,"_2467":45790},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2944":1182,"_25897":1134,"_18081":45792,"_5":17976,"_24513":45657,"_2467":45793},[],"HTTP 200 without a device connection",{"_2944":1183,"_25897":1134,"_18081":45795,"_5":17976,"_24513":45657,"_2467":45796},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2944":1184,"_25897":1134,"_18081":45798,"_5":17976,"_24513":45657,"_2467":45799},[],"Timeout or error after issuance",{"_2944":1185,"_25897":1134,"_18081":45801,"_5":17976,"_24513":45657,"_2467":45802},[],"New certificates, current slot and previous identity's state before retrying.",{"_2944":1186,"_25897":1134,"_18081":45804,"_5":17976,"_24513":45661,"_2467":45805},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_2944":1187,"_25897":1134,"_18081":45807,"_5":17976,"_24513":45661,"_2467":45808},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2944":1188,"_25897":1134,"_18081":45810,"_5":17976,"_24513":45664,"_2467":45811},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2944":1189,"_25897":1134,"_18081":45813,"_5":17976,"_24513":45664,"_2467":45814},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2944":1190,"_25897":1134,"_18081":45816,"_5":17976,"_24513":45664,"_2467":45817},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2944":1191,"_25897":1134,"_18081":45819,"_5":17976,"_24513":45664,"_2467":45820},[],"Make one request, save headers/body and query the device and certificates.",{"_2944":1192,"_25897":1134,"_18081":45822,"_5":17976,"_24513":45664,"_2467":45823},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2944":1193,"_25897":1134,"_18081":45825,"_5":17976,"_24513":45664,"_2467":45826},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2944":1194,"_25897":1134,"_18081":45828,"_5":17976,"_24513":45664,"_2467":45829},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2944":1195,"_25897":1195,"_5":12672,"_2467":45831,"_26242":45832,"_18081":45833,"_24513":1195},"Trust distribution and updates",[42109,43496,44470,44468,44651],[],{"_2944":1196,"_25897":1195,"_18081":45835,"_5":17976,"_24513":1195,"_2467":45836},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2944":1197,"_25897":1195,"_5":26239,"_18081":45838,"_24513":45839,"_2467":45840},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2944":1198,"_25897":1195,"_5":26239,"_18081":45842,"_24513":45843,"_2467":45844},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2944":1199,"_25897":1195,"_5":26239,"_18081":45846,"_24513":45847,"_2467":45848},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2944":1200,"_25897":1195,"_5":26239,"_18081":45850,"_24513":45851,"_2467":45852},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2944":1201,"_25897":1195,"_5":26239,"_18081":45854,"_24513":45855,"_2467":45856},[],"/docs/pr-preview/pr-41/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2944":1202,"_25897":1195,"_18081":45858,"_5":17976,"_24513":1195,"_2467":45859},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2944":1203,"_25897":1195,"_18081":45861,"_5":17976,"_24513":45839,"_2467":45862},[],"Relationship",{"_2944":1204,"_25897":1195,"_18081":45864,"_5":17976,"_24513":45839,"_2467":45865},[],"Material prepared by its owner",{"_2944":1205,"_25897":1195,"_18081":45867,"_5":17976,"_24513":45839,"_2467":45868},[],"Device → EST server",{"_2944":1206,"_25897":1195,"_18081":45870,"_5":17976,"_24513":45839,"_2467":45871},[],"Previously verified server root, chain or pin and TLS name.",{"_2944":1207,"_25897":1195,"_18081":45873,"_5":17976,"_24513":45839,"_2467":45874},[],"DMS → requester",{"_2944":1208,"_25897":1195,"_18081":45876,"_5":17976,"_24513":45839,"_2467":45877},[],"CAs and rules authorizing initial or renewal credentials.",{"_2944":1209,"_25897":1195,"_18081":45879,"_5":17976,"_24513":45839,"_2467":45880},[],"Consumer → device",{"_2944":1210,"_25897":1195,"_18081":45882,"_5":17976,"_24513":45839,"_2467":45883},[],"Operational identity roots, intermediates, validation and permissions.",{"_2944":1211,"_25897":1195,"_18081":45885,"_5":17976,"_24513":45839,"_2467":45886},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2944":1212,"_25897":1195,"_18081":45888,"_5":17976,"_24513":45843,"_2467":45889},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2944":1213,"_25897":1195,"_18081":45891,"_5":17976,"_24513":45843,"_2467":45892},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2944":1214,"_25897":1195,"_18081":45894,"_5":17976,"_24513":45847,"_2467":45895},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2944":1215,"_25897":1195,"_18081":45897,"_5":17976,"_24513":45847,"_2467":45898},[],"Select policy-approved roots as anchors.",{"_2944":1216,"_25897":1195,"_18081":45900,"_5":17976,"_24513":45847,"_2467":45901},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2944":1217,"_25897":1195,"_18081":45903,"_5":17976,"_24513":45847,"_2467":45904},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2944":1218,"_25897":1195,"_18081":45906,"_5":17976,"_24513":45847,"_2467":45907},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2944":1219,"_25897":1195,"_18081":45909,"_5":17976,"_24513":45847,"_2467":45910},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2944":1220,"_25897":1195,"_18081":45912,"_5":17976,"_24513":45851,"_2467":45913},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2944":1221,"_25897":1195,"_18081":45915,"_5":17976,"_24513":45851,"_2467":45916},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2944":1222,"_25897":1195,"_18081":45918,"_5":17976,"_24513":45851,"_2467":45919},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2944":1223,"_25897":1195,"_18081":45921,"_5":17976,"_24513":45855,"_2467":45922},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2944":1224,"_25897":1224,"_5":12672,"_2467":45924,"_26242":45925,"_18081":45927,"_24513":1224},"AWS IoT Core",[42109,43496,44470,44468,45926],"Integrations",[],{"_2944":1225,"_25897":1224,"_18081":45929,"_5":17976,"_24513":1224,"_2467":45930},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2944":1226,"_25897":1224,"_5":26239,"_18081":45932,"_24513":45933,"_2467":45934},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2944":1227,"_25897":1224,"_5":26239,"_18081":45936,"_24513":45937,"_2467":45938},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2944":1228,"_25897":1224,"_5":26239,"_18081":45940,"_24513":45941,"_2467":45942},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2944":1229,"_25897":1224,"_5":26239,"_18081":45944,"_24513":45945,"_2467":45946},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2944":1230,"_25897":1224,"_5":26239,"_18081":45948,"_24513":45949,"_2467":45950},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2944":1231,"_25897":1224,"_5":26239,"_18081":45952,"_24513":45953,"_2467":45954},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2944":1232,"_25897":1224,"_5":26239,"_18081":45956,"_24513":45957,"_2467":45958},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2944":1233,"_25897":1224,"_5":26239,"_18081":45960,"_24513":45961,"_2467":45962},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2944":1234,"_25897":1224,"_5":26239,"_18081":45964,"_24513":45965,"_2467":45966},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2944":1235,"_25897":1224,"_5":26239,"_18081":45968,"_24513":45969,"_2467":45970},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2944":1236,"_25897":1224,"_5":26239,"_18081":45972,"_24513":45973,"_2467":45974},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2944":1237,"_25897":1224,"_5":26239,"_18081":45976,"_24513":45977,"_2467":45978},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2944":1238,"_25897":1224,"_5":26239,"_18081":45980,"_24513":45981,"_2467":45982},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2944":1239,"_25897":1224,"_5":26239,"_18081":45984,"_24513":45985,"_2467":45986},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2944":1240,"_25897":1224,"_5":26239,"_18081":45988,"_24513":45989,"_2467":45990},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2944":1241,"_25897":1224,"_5":26239,"_18081":45992,"_24513":45993,"_2467":45994},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2944":1242,"_25897":1224,"_5":26239,"_18081":45996,"_24513":45997,"_2467":45998},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2944":1243,"_25897":1224,"_5":26239,"_18081":46000,"_24513":46001,"_2467":46002},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2944":1244,"_25897":1224,"_5":26239,"_18081":46004,"_24513":46005,"_2467":46006},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2944":1245,"_25897":1224,"_5":26239,"_18081":46008,"_24513":46009,"_2467":46010},[],"/docs/pr-preview/pr-41/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2944":1246,"_25897":1224,"_18081":46012,"_5":17976,"_24513":1224,"_2467":46013},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2944":1247,"_25897":1224,"_18081":46015,"_5":17976,"_24513":1224,"_2467":46016},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2944":1248,"_25897":1224,"_18081":46018,"_5":17976,"_24513":1224,"_2467":46019},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2944":1249,"_25897":1224,"_18081":46021,"_5":17976,"_24513":45933,"_2467":46022},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2944":1250,"_25897":1224,"_18081":46024,"_5":17976,"_24513":45933,"_2467":46025},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2944":1251,"_25897":1224,"_18081":46027,"_5":17976,"_24513":45933,"_2467":46028},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2944":1252,"_25897":1224,"_18081":46030,"_5":17976,"_24513":45933,"_2467":46031},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2944":1253,"_25897":1224,"_18081":46033,"_5":17976,"_24513":45937,"_2467":46034},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2944":1254,"_25897":1224,"_18081":46036,"_5":17976,"_24513":45941,"_2467":46037},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2944":1255,"_25897":1224,"_18081":46039,"_5":17976,"_24513":45941,"_2467":46040},[],"IAM action",{"_2944":1256,"_25897":1224,"_18081":46042,"_5":17976,"_24513":45941,"_2467":42496},[],{"_2944":1257,"_25897":1224,"_18081":46044,"_5":17976,"_24513":45941,"_2467":46045},[],"`iot:GetRegistrationCode`",{"_2944":1258,"_25897":1224,"_18081":46047,"_5":17976,"_24513":45941,"_2467":46048},[],"Obtain the verification code for CA registration in the Primary Account",{"_2944":1259,"_25897":1224,"_18081":46050,"_5":17976,"_24513":45941,"_2467":46051},[],"`iot:RegisterCACertificate`",{"_2944":1260,"_25897":1224,"_18081":46053,"_5":17976,"_24513":45941,"_2467":46054},[],"Register the CA in AWS IoT",{"_2944":1261,"_25897":1224,"_18081":46056,"_5":17976,"_24513":45941,"_2467":46057},[],"`iot:DescribeCACertificate`",{"_2944":1262,"_25897":1224,"_18081":46059,"_5":17976,"_24513":45941,"_2467":46060},[],"Check the CA registration status",{"_2944":1263,"_25897":1224,"_18081":46062,"_5":17976,"_24513":45941,"_2467":46063},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2944":1264,"_25897":1224,"_18081":46065,"_5":17976,"_24513":45941,"_2467":46066},[],"Create or update Things in IoT Core",{"_2944":1265,"_25897":1224,"_18081":46068,"_5":17976,"_24513":45941,"_2467":46069},[],"`iot:RegisterThing`",{"_2944":1266,"_25897":1224,"_18081":46071,"_5":17976,"_24513":45941,"_2467":46072},[],"Provision Things through a template",{"_2944":1267,"_25897":1224,"_18081":46074,"_5":17976,"_24513":45941,"_2467":46075},[],"`iot:RegisterCertificate`",{"_2944":1268,"_25897":1224,"_18081":46077,"_5":17976,"_24513":45941,"_2467":46078},[],"Register device certificates",{"_2944":1269,"_25897":1224,"_18081":46080,"_5":17976,"_24513":45941,"_2467":46081},[],"`iot:UpdateCertificate`",{"_2944":1270,"_25897":1224,"_18081":46083,"_5":17976,"_24513":45941,"_2467":46084},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2944":1271,"_25897":1224,"_18081":46086,"_5":17976,"_24513":45941,"_2467":46087},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2944":1272,"_25897":1224,"_18081":46089,"_5":17976,"_24513":45941,"_2467":46090},[],"Create and attach IoT policies",{"_2944":1273,"_25897":1224,"_18081":46092,"_5":17976,"_24513":45941,"_2467":46093},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2944":1274,"_25897":1224,"_18081":46095,"_5":17976,"_24513":45941,"_2467":46096},[],"Manage Thing groups",{"_2944":1275,"_25897":1224,"_18081":46098,"_5":17976,"_24513":45941,"_2467":46099},[],"`iot:CreateProvisioningTemplate`",{"_2944":1276,"_25897":1224,"_18081":46101,"_5":17976,"_24513":45941,"_2467":46102},[],"Create JITP templates",{"_2944":1277,"_25897":1224,"_18081":46104,"_5":17976,"_24513":45941,"_2467":46105},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2944":1278,"_25897":1224,"_18081":46107,"_5":17976,"_24513":45941,"_2467":46108},[],"Read and write the Device Shadow",{"_2944":1279,"_25897":1224,"_18081":46110,"_5":17976,"_24513":45941,"_2467":46111},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2944":1280,"_25897":1224,"_18081":46113,"_5":17976,"_24513":45945,"_2467":46114},[],"Parameter",{"_2944":1281,"_25897":1224,"_18081":46116,"_5":17976,"_24513":45945,"_2467":46117},[],"Type",{"_2944":1282,"_25897":1224,"_18081":46119,"_5":17976,"_24513":45945,"_2467":46120},[],"Required",{"_2944":1283,"_25897":1224,"_18081":46122,"_5":17976,"_24513":45945,"_2467":46123},[],"Description",{"_2944":1284,"_25897":1224,"_18081":46125,"_5":17976,"_24513":45945,"_2467":46126},[],"`connector_id`",{"_2944":1285,"_25897":1224,"_18081":46128,"_5":17976,"_24513":45945,"_2467":21576},[],{"_2944":1286,"_25897":1224,"_18081":46130,"_5":17976,"_24513":45945,"_2467":46131},[],"Yes",{"_2944":1287,"_25897":1224,"_18081":46133,"_5":17976,"_24513":45945,"_2467":46134},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2944":1288,"_25897":1224,"_18081":46136,"_5":17976,"_24513":45945,"_2467":46137},[],"`aws_config.region`",{"_2944":1289,"_25897":1224,"_18081":46139,"_5":17976,"_24513":45945,"_2467":21576},[],{"_2944":1290,"_25897":1224,"_18081":46141,"_5":17976,"_24513":45945,"_2467":46131},[],{"_2944":1291,"_25897":1224,"_18081":46143,"_5":17976,"_24513":45945,"_2467":46144},[],"AWS region where the connector operates.",{"_2944":1292,"_25897":1224,"_18081":46146,"_5":17976,"_24513":45945,"_2467":46147},[],"`aws_config.auth_method`",{"_2944":1293,"_25897":1224,"_18081":46149,"_5":17976,"_24513":45945,"_2467":21576},[],{"_2944":1294,"_25897":1224,"_18081":46151,"_5":17976,"_24513":45945,"_2467":46131},[],{"_2944":1295,"_25897":1224,"_18081":46153,"_5":17976,"_24513":45945,"_2467":46154},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2944":1296,"_25897":1224,"_18081":46156,"_5":17976,"_24513":45945,"_2467":46157},[],"`aws_config.access_key_id`",{"_2944":1297,"_25897":1224,"_18081":46159,"_5":17976,"_24513":45945,"_2467":21576},[],{"_2944":1298,"_25897":1224,"_18081":46161,"_5":17976,"_24513":45945,"_2467":46162},[],"Only with `auth_method=static`",{"_2944":1299,"_25897":1224,"_18081":46164,"_5":17976,"_24513":45945,"_2467":46165},[],"AWS access key.",{"_2944":1300,"_25897":1224,"_18081":46167,"_5":17976,"_24513":45945,"_2467":46168},[],"`aws_config.secret_access_key`",{"_2944":1301,"_25897":1224,"_18081":46170,"_5":17976,"_24513":45945,"_2467":21576},[],{"_2944":1302,"_25897":1224,"_18081":46172,"_5":17976,"_24513":45945,"_2467":46162},[],{"_2944":1303,"_25897":1224,"_18081":46174,"_5":17976,"_24513":45945,"_2467":46175},[],"AWS secret key.",{"_2944":1304,"_25897":1224,"_18081":46177,"_5":17976,"_24513":45945,"_2467":46178},[],"`aws_config.session_token`",{"_2944":1305,"_25897":1224,"_18081":46180,"_5":17976,"_24513":45945,"_2467":21576},[],{"_2944":1306,"_25897":1224,"_18081":46182,"_5":17976,"_24513":45945,"_2467":46183},[],"No",{"_2944":1307,"_25897":1224,"_18081":46185,"_5":17976,"_24513":45945,"_2467":46186},[],"Session token (with `auth_method=static`).",{"_2944":1308,"_25897":1224,"_18081":46188,"_5":17976,"_24513":45945,"_2467":46189},[],"`aws_config.role_arn`",{"_2944":1309,"_25897":1224,"_18081":46191,"_5":17976,"_24513":45945,"_2467":21576},[],{"_2944":1310,"_25897":1224,"_18081":46193,"_5":17976,"_24513":45945,"_2467":46194},[],"Only with `auth_method=role`",{"_2944":1311,"_25897":1224,"_18081":46196,"_5":17976,"_24513":45945,"_2467":46197},[],"ARN of the role to assume.",{"_2944":1312,"_25897":1224,"_18081":46199,"_5":17976,"_24513":45945,"_2467":46200},[],"`aws_config.endpoint_url`",{"_2944":1313,"_25897":1224,"_18081":46202,"_5":17976,"_24513":45945,"_2467":21576},[],{"_2944":1314,"_25897":1224,"_18081":46204,"_5":17976,"_24513":45945,"_2467":46183},[],{"_2944":1315,"_25897":1224,"_18081":46206,"_5":17976,"_24513":45945,"_2467":46207},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2944":1316,"_25897":1224,"_18081":46209,"_5":17976,"_24513":45945,"_2467":46210},[],"`subscriber_event_bus`",{"_2944":1317,"_25897":1224,"_18081":46212,"_5":17976,"_24513":45945,"_2467":15162},[],{"_2944":1318,"_25897":1224,"_18081":46214,"_5":17976,"_24513":45945,"_2467":46131},[],{"_2944":1319,"_25897":1224,"_18081":46216,"_5":17976,"_24513":45945,"_2467":46217},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2944":1320,"_25897":1224,"_18081":46219,"_5":17976,"_24513":45945,"_2467":46220},[],"`dms_manager_client`",{"_2944":1321,"_25897":1224,"_18081":46222,"_5":17976,"_24513":45945,"_2467":21576},[],{"_2944":1322,"_25897":1224,"_18081":46224,"_5":17976,"_24513":45945,"_2467":46131},[],{"_2944":1323,"_25897":1224,"_18081":46226,"_5":17976,"_24513":45945,"_2467":46227},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2944":1324,"_25897":1224,"_18081":46229,"_5":17976,"_24513":45945,"_2467":46230},[],"`device_manager_client`",{"_2944":1325,"_25897":1224,"_18081":46232,"_5":17976,"_24513":45945,"_2467":21576},[],{"_2944":1326,"_25897":1224,"_18081":46234,"_5":17976,"_24513":45945,"_2467":46131},[],{"_2944":1327,"_25897":1224,"_18081":46236,"_5":17976,"_24513":45945,"_2467":46237},[],"HTTP URL of Lamassu's Device Manager.",{"_2944":1328,"_25897":1224,"_18081":46239,"_5":17976,"_24513":45945,"_2467":46240},[],"`ca_client`",{"_2944":1329,"_25897":1224,"_18081":46242,"_5":17976,"_24513":45945,"_2467":21576},[],{"_2944":1330,"_25897":1224,"_18081":46244,"_5":17976,"_24513":45945,"_2467":46131},[],{"_2944":1331,"_25897":1224,"_18081":46246,"_5":17976,"_24513":45945,"_2467":46247},[],"HTTP URL of Lamassu's CA service.",{"_2944":1332,"_25897":1224,"_18081":46249,"_5":17976,"_24513":45949,"_2467":46250},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2944":1333,"_25897":1224,"_18081":46252,"_5":17976,"_24513":45953,"_2467":46253},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2944":1334,"_25897":1224,"_18081":46255,"_5":17976,"_24513":45953,"_2467":46256},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2944":1335,"_25897":1224,"_18081":46258,"_5":17976,"_24513":45957,"_2467":46259},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2944":1336,"_25897":1224,"_18081":46261,"_5":17976,"_24513":45957,"_2467":46262},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2944":1337,"_25897":1224,"_18081":46264,"_5":17976,"_24513":45957,"_2467":46265},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2944":1338,"_25897":1224,"_18081":46267,"_5":17976,"_24513":45957,"_2467":46268},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2944":1339,"_25897":1224,"_18081":46270,"_5":17976,"_24513":45957,"_2467":46271},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2944":1340,"_25897":1224,"_18081":46273,"_5":17976,"_24513":45957,"_2467":46274},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2944":1341,"_25897":1224,"_18081":46276,"_5":17976,"_24513":45961,"_2467":46277},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2944":1342,"_25897":1224,"_18081":46279,"_5":17976,"_24513":45965,"_2467":46280},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2944":1343,"_25897":1224,"_18081":46282,"_5":17976,"_24513":45965,"_2467":46283},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2944":1344,"_25897":1224,"_18081":46285,"_5":17976,"_24513":45969,"_2467":46286},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2944":1345,"_25897":1224,"_18081":46288,"_5":17976,"_24513":45973,"_2467":46289},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2944":1346,"_25897":1224,"_18081":46291,"_5":17976,"_24513":45973,"_2467":46292},[],"Creates or updates the IoT policies configured in the DMS.",{"_2944":1347,"_25897":1224,"_18081":46294,"_5":17976,"_24513":45973,"_2467":46295},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2944":1348,"_25897":1224,"_18081":46297,"_5":17976,"_24513":45973,"_2467":46298},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2944":1349,"_25897":1224,"_18081":46300,"_5":17976,"_24513":45973,"_2467":46301},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2944":1350,"_25897":1224,"_18081":46303,"_5":17976,"_24513":45973,"_2467":46304},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2944":1351,"_25897":1224,"_18081":46306,"_5":17976,"_24513":45973,"_2467":46307},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2944":1352,"_25897":1224,"_18081":46309,"_5":17976,"_24513":45977,"_2467":46310},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2944":1353,"_25897":1224,"_18081":46312,"_5":17976,"_24513":45977,"_2467":46313},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2944":1354,"_25897":1224,"_18081":46315,"_5":17976,"_24513":45977,"_2467":46316},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2944":1355,"_25897":1224,"_18081":46318,"_5":17976,"_24513":45981,"_2467":46319},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2944":1356,"_25897":1224,"_18081":46321,"_5":17976,"_24513":45981,"_2467":46322},[],"The full flow from the device's perspective is:",{"_2944":1357,"_25897":1224,"_18081":46324,"_5":17976,"_24513":45981,"_2467":46325},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2944":1358,"_25897":1224,"_18081":46327,"_5":17976,"_24513":45985,"_2467":46328},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2944":1359,"_25897":1224,"_18081":46330,"_5":17976,"_24513":45985,"_2467":46331},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2944":1360,"_25897":1224,"_18081":46333,"_5":17976,"_24513":45985,"_2467":46334},[],"For the JITP flow to work correctly:",{"_2944":1361,"_25897":1224,"_18081":46336,"_5":17976,"_24513":45985,"_2467":46337},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2944":1362,"_25897":1224,"_18081":46339,"_5":17976,"_24513":45985,"_2467":46340},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2944":1363,"_25897":1224,"_18081":46342,"_5":17976,"_24513":45985,"_2467":46343},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2944":1364,"_25897":1224,"_18081":46345,"_5":17976,"_24513":45985,"_2467":46346},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2944":1365,"_25897":1224,"_18081":46348,"_5":17976,"_24513":45989,"_2467":46349},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2944":1366,"_25897":1224,"_18081":46351,"_5":17976,"_24513":45989,"_2467":46352},[],"Status in Lamassu",{"_2944":1367,"_25897":1224,"_18081":46354,"_5":17976,"_24513":45989,"_2467":46355},[],"Revocation reason",{"_2944":1368,"_25897":1224,"_18081":46357,"_5":17976,"_24513":45989,"_2467":46358},[],"Status in AWS IoT Core",{"_2944":1369,"_25897":1224,"_18081":46360,"_5":17976,"_24513":45989,"_2467":46361},[],"`Active`",{"_2944":1370,"_25897":1224,"_18081":46363,"_5":17976,"_24513":45989,"_2467":46364},[],"None",{"_2944":1371,"_25897":1224,"_18081":46366,"_5":17976,"_24513":45989,"_2467":46367},[],"`ACTIVE`",{"_2944":1372,"_25897":1224,"_18081":46369,"_5":17976,"_24513":45989,"_2467":46370},[],"`Revoked`",{"_2944":1373,"_25897":1224,"_18081":46372,"_5":17976,"_24513":45989,"_2467":46373},[],"`certificateHold`",{"_2944":1374,"_25897":1224,"_18081":46375,"_5":17976,"_24513":45989,"_2467":46376},[],"`INACTIVE`",{"_2944":1375,"_25897":1224,"_18081":46378,"_5":17976,"_24513":45989,"_2467":46370},[],{"_2944":1376,"_25897":1224,"_18081":46380,"_5":17976,"_24513":45989,"_2467":46381},[],"Any other reason",{"_2944":1377,"_25897":1224,"_18081":46383,"_5":17976,"_24513":45989,"_2467":46384},[],"`REVOKED`",{"_2944":1378,"_25897":1224,"_18081":46386,"_5":17976,"_24513":45989,"_2467":46387},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2944":1379,"_25897":1224,"_18081":46389,"_5":17976,"_24513":45993,"_2467":46390},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2944":1380,"_25897":1224,"_18081":46392,"_5":17976,"_24513":45993,"_2467":46393},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2944":1381,"_25897":1224,"_18081":46395,"_5":17976,"_24513":45993,"_2467":46396},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2944":1382,"_25897":1224,"_18081":46398,"_5":17976,"_24513":45997,"_2467":46399},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2944":1383,"_25897":1224,"_18081":46401,"_5":17976,"_24513":45997,"_2467":46402},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2944":1384,"_25897":1224,"_18081":46404,"_5":17976,"_24513":46001,"_2467":46405},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2944":1385,"_25897":1224,"_18081":46407,"_5":17976,"_24513":46001,"_2467":46408},[],"There are two action types:",{"_2944":1386,"_25897":1224,"_18081":46410,"_5":17976,"_24513":46001,"_2467":46411},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2944":1387,"_25897":1224,"_18081":46413,"_5":17976,"_24513":46001,"_2467":46414},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2944":1388,"_25897":1224,"_18081":46416,"_5":17976,"_24513":46001,"_2467":46417},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2944":1389,"_25897":1224,"_18081":46419,"_5":17976,"_24513":46005,"_2467":46420},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2944":1390,"_25897":1224,"_18081":46422,"_5":17976,"_24513":46005,"_2467":46423},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2944":1391,"_25897":1224,"_18081":46425,"_5":17976,"_24513":46005,"_2467":46426},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2944":1392,"_25897":1224,"_18081":46428,"_5":17976,"_24513":46009,"_2467":46429},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2944":1393,"_25897":1224,"_18081":46431,"_5":17976,"_24513":46009,"_2467":46432},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2944":1394,"_25897":1224,"_18081":46434,"_5":17976,"_24513":46009,"_2467":46435},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2944":1395,"_25897":1224,"_18081":46437,"_5":17976,"_24513":46009,"_2467":46438},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2944":1396,"_25897":1224,"_18081":46440,"_5":17976,"_24513":46009,"_2467":46441},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2944":1397,"_25897":1224,"_18081":46443,"_5":17976,"_24513":46009,"_2467":46444},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2944":1398,"_25897":1224,"_18081":46446,"_5":17976,"_24513":46009,"_2467":46447},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2944":1399,"_25897":1224,"_18081":46449,"_5":17976,"_24513":46009,"_2467":46450},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2944":1400,"_25897":1224,"_18081":46452,"_5":17976,"_24513":46009,"_2467":46453},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2944":1401,"_25897":1224,"_18081":46455,"_5":17976,"_24513":46009,"_2467":46456},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2944":1402,"_25897":1224,"_18081":46458,"_5":17976,"_24513":46009,"_2467":46459},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2944":1403,"_25897":1224,"_18081":46461,"_5":17976,"_24513":46009,"_2467":46462},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2944":1404,"_25897":1224,"_18081":46464,"_5":17976,"_24513":46009,"_2467":46465},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2944":1405,"_25897":1224,"_18081":46467,"_5":17976,"_24513":46009,"_2467":46468},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2944":1406,"_25897":1224,"_18081":46470,"_5":17976,"_24513":46009,"_2467":46471},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2944":1407,"_25897":1224,"_18081":46473,"_5":17976,"_24513":46009,"_2467":46474},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2944":1408,"_25897":1224,"_18081":46476,"_5":17976,"_24513":46009,"_2467":46477},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2944":1409,"_25897":1224,"_18081":46479,"_5":17976,"_24513":46009,"_2467":46480},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2944":1410,"_25897":1224,"_18081":46482,"_5":17976,"_24513":46009,"_2467":46483},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2944":1411,"_25897":1224,"_18081":46485,"_5":17976,"_24513":46009,"_2467":46486},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2944":1412,"_25897":1224,"_18081":46488,"_5":17976,"_24513":46009,"_2467":46489},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2944":1413,"_25897":1413,"_5":12672,"_2467":44470,"_26242":46491,"_18081":46492,"_24513":1413},[42109,43496,44470],[],{"_2944":1414,"_25897":1413,"_18081":46494,"_5":17976,"_24513":1413,"_2467":46495},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2944":1415,"_25897":1413,"_5":26239,"_18081":46497,"_24513":46498,"_2467":46499},[],"/docs/pr-preview/pr-41/platform/iot-fleets/overview#start-here","Start here",{"_2944":1416,"_25897":1413,"_5":26239,"_18081":46501,"_24513":46502,"_2467":44468},[],"/docs/pr-preview/pr-41/platform/iot-fleets/overview#devices-and-identities",{"_2944":1417,"_25897":1413,"_5":26239,"_18081":46504,"_24513":46505,"_2467":44651},[],"/docs/pr-preview/pr-41/platform/iot-fleets/overview#enrollment-with-pki",{"_2944":1418,"_25897":1413,"_5":26239,"_18081":46507,"_24513":46508,"_2467":45926},[],"/docs/pr-preview/pr-41/platform/iot-fleets/overview#integrations",{"_2944":1419,"_25897":1413,"_5":26239,"_18081":46510,"_24513":46511,"_2467":46512},[],"/docs/pr-preview/pr-41/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2944":1420,"_25897":1413,"_18081":46514,"_5":17976,"_24513":1413,"_2467":46515},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2944":1421,"_25897":1413,"_18081":46517,"_5":17976,"_24513":46498,"_2467":46518},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2944":1422,"_25897":1413,"_18081":46520,"_5":17976,"_24513":46498,"_2467":46521},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2944":1423,"_25897":1413,"_18081":46523,"_5":17976,"_24513":46502,"_2467":46524},[],"Resource",{"_2944":1424,"_25897":1413,"_18081":46526,"_5":17976,"_24513":46502,"_2467":46527},[],"What it represents",{"_2944":1425,"_25897":1413,"_18081":46529,"_5":17976,"_24513":46502,"_2467":46530},[],"**Device**",{"_2944":1426,"_25897":1413,"_18081":46532,"_5":17976,"_24513":46502,"_2467":46533},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2944":1427,"_25897":1413,"_18081":46535,"_5":17976,"_24513":46502,"_2467":46536},[],"**Identity**",{"_2944":1428,"_25897":1413,"_18081":46538,"_5":17976,"_24513":46502,"_2467":46539},[],"The device's association with its certificates: an active version and a history.",{"_2944":1429,"_25897":1413,"_18081":46541,"_5":17976,"_24513":46502,"_2467":46542},[],"**DMS**",{"_2944":1430,"_25897":1413,"_18081":46544,"_5":17976,"_24513":46502,"_2467":46545},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2944":1431,"_25897":1413,"_18081":46547,"_5":17976,"_24513":46502,"_2467":46548},[],"**Fleet**",{"_2944":1432,"_25897":1413,"_18081":46550,"_5":17976,"_24513":46502,"_2467":46551},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2944":1433,"_25897":1413,"_18081":46553,"_5":17976,"_24513":46502,"_2467":46554},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2944":1434,"_25897":1413,"_18081":46556,"_5":17976,"_24513":46502,"_2467":46557},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2944":1435,"_25897":1413,"_18081":46559,"_5":17976,"_24513":46505,"_2467":46560},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2944":1436,"_25897":1413,"_18081":46562,"_5":17976,"_24513":46505,"_2467":46563},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2944":1437,"_25897":1413,"_18081":46565,"_5":17976,"_24513":46505,"_2467":46566},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2944":1438,"_25897":1413,"_18081":46568,"_5":17976,"_24513":46505,"_2467":46569},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2944":1439,"_25897":1413,"_18081":46571,"_5":17976,"_24513":46505,"_2467":46572},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2944":1440,"_25897":1413,"_18081":46574,"_5":17976,"_24513":46505,"_2467":46575},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2944":1441,"_25897":1413,"_18081":46577,"_5":17976,"_24513":46505,"_2467":46578},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2944":1442,"_25897":1413,"_18081":46580,"_5":17976,"_24513":46505,"_2467":46581},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2944":1443,"_25897":1413,"_18081":46583,"_5":17976,"_24513":46508,"_2467":46584},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2944":1444,"_25897":1413,"_18081":46586,"_5":17976,"_24513":46508,"_2467":46587},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2944":1445,"_25897":1413,"_18081":46589,"_5":17976,"_24513":46511,"_2467":46590},[],"Participant",{"_2944":1446,"_25897":1413,"_18081":46592,"_5":17976,"_24513":46511,"_2467":46593},[],"Responsibility",{"_2944":1447,"_25897":1413,"_18081":46595,"_5":17976,"_24513":46511,"_2467":46596},[],"PKI administrator",{"_2944":1448,"_25897":1413,"_18081":46598,"_5":17976,"_24513":46511,"_2467":46599},[],"CA, issuance profile, chain and revocation publication.",{"_2944":1449,"_25897":1413,"_18081":46601,"_5":17976,"_24513":46511,"_2467":46602},[],"Provisioning administrator",{"_2944":1450,"_25897":1413,"_18081":46604,"_5":17976,"_24513":46511,"_2467":46605},[],"DMS, admission, authentication per operation and inventory.",{"_2944":1451,"_25897":1413,"_18081":46607,"_5":17976,"_24513":46511,"_2467":46608},[],"Device integrator",{"_2944":1452,"_25897":1413,"_18081":46610,"_5":17976,"_24513":46511,"_2467":46611},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2944":1453,"_25897":1413,"_18081":46613,"_5":17976,"_24513":46511,"_2467":46614},[],"Consumer integrator",{"_2944":1454,"_25897":1413,"_18081":46616,"_5":17976,"_24513":46511,"_2467":46617},[],"Trusted issuers, validation and device permissions in the destination.",{"_2944":1455,"_25897":1413,"_18081":46619,"_5":17976,"_24513":46511,"_2467":46620},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2944":1456,"_25897":1456,"_5":12672,"_2467":46622,"_26242":46623,"_18081":46625,"_24513":1456},"Enroll and connect your first device",[42109,43496,44470,46624],"Getting started",[],{"_2944":1457,"_25897":1456,"_18081":46627,"_5":17976,"_24513":1456,"_2467":46628},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2944":1458,"_25897":1456,"_5":26239,"_18081":46630,"_24513":46631,"_2467":42119},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2944":1459,"_25897":1456,"_5":26239,"_18081":46633,"_24513":46634,"_2467":46635},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2944":1460,"_25897":1456,"_5":26239,"_18081":46637,"_24513":46638,"_2467":46639},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2944":1461,"_25897":1456,"_5":26239,"_18081":46641,"_24513":46642,"_2467":46643},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2944":1462,"_25897":1456,"_5":26239,"_18081":46645,"_24513":46646,"_2467":46647},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2944":1463,"_25897":1456,"_5":26239,"_18081":46649,"_24513":46650,"_2467":46651},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2944":1464,"_25897":1456,"_5":26239,"_18081":46653,"_24513":46654,"_2467":46655},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2944":1465,"_25897":1456,"_5":26239,"_18081":46657,"_24513":46658,"_2467":46659},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2944":1466,"_25897":1456,"_18081":46661,"_5":17976,"_24513":1456,"_2467":46662},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2944":1467,"_25897":1456,"_18081":46664,"_5":17976,"_24513":46631,"_2467":46665},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2944":1468,"_25897":1456,"_18081":46667,"_5":17976,"_24513":46631,"_2467":46668},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2944":1469,"_25897":1456,"_18081":46670,"_5":17976,"_24513":46631,"_2467":46671},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2944":1470,"_25897":1456,"_18081":46673,"_5":17976,"_24513":46631,"_2467":46674},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2944":1471,"_25897":1456,"_18081":46676,"_5":17976,"_24513":46631,"_2467":46677},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2944":1472,"_25897":1456,"_18081":46679,"_5":17976,"_24513":46634,"_2467":46680},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2944":1473,"_25897":1456,"_18081":46682,"_5":17976,"_24513":46634,"_2467":46683},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2944":1474,"_25897":1456,"_18081":46685,"_5":17976,"_24513":46638,"_2467":46686},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2944":1475,"_25897":1456,"_18081":46688,"_5":17976,"_24513":46638,"_2467":46689},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2944":1476,"_25897":1456,"_18081":46691,"_5":17976,"_24513":46638,"_2467":46692},[],"Setting",{"_2944":1477,"_25897":1456,"_18081":46694,"_5":17976,"_24513":46638,"_2467":46695},[],"Evaluation value",{"_2944":1478,"_25897":1456,"_18081":46697,"_5":17976,"_24513":46638,"_2467":46698},[],"Enrollment CA",{"_2944":1479,"_25897":1456,"_18081":46700,"_5":17976,"_24513":46638,"_2467":46701},[],"Issuing root from `device-root.pem`.",{"_2944":1480,"_25897":1456,"_18081":46703,"_5":17976,"_24513":46638,"_2467":44781},[],{"_2944":1481,"_25897":1456,"_18081":46705,"_5":17976,"_24513":46638,"_2467":46706},[],"The 1-hour leaf profile you just prepared.",{"_2944":1482,"_25897":1456,"_18081":46708,"_5":17976,"_24513":46638,"_2467":46709},[],"Protocol / Registration Mode",{"_2944":1483,"_25897":1456,"_18081":46711,"_5":17976,"_24513":46638,"_2467":46712},[],"`EST_RFC7030` / `JITP`.",{"_2944":1484,"_25897":1456,"_18081":46714,"_5":17976,"_24513":46638,"_2467":46715},[],"Verify CSR Signature",{"_2944":1485,"_25897":1456,"_18081":46717,"_5":17976,"_24513":46638,"_2467":46718},[],"Enabled.",{"_2944":1486,"_25897":1456,"_18081":46720,"_5":17976,"_24513":46638,"_2467":46721},[],"Enable Replaceable Enrollment",{"_2944":1487,"_25897":1456,"_18081":46723,"_5":17976,"_24513":46638,"_2467":46724},[],"Disabled; the ID must be new.",{"_2944":1488,"_25897":1456,"_18081":46726,"_5":17976,"_24513":46638,"_2467":46727},[],"Initial authentication",{"_2944":1489,"_25897":1456,"_18081":46729,"_5":17976,"_24513":46638,"_2467":46730},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2944":1490,"_25897":1456,"_18081":46732,"_5":17976,"_24513":46638,"_2467":46733},[],"Renewal authentication",{"_2944":1491,"_25897":1456,"_18081":46735,"_5":17976,"_24513":46638,"_2467":46736},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2944":1492,"_25897":1456,"_18081":46738,"_5":17976,"_24513":46638,"_2467":46739},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_2944":1493,"_25897":1456,"_18081":46741,"_5":17976,"_24513":46638,"_2467":46742},[],"Empty list for this direct issuance / disabled.",{"_2944":1494,"_25897":1456,"_18081":46744,"_5":17976,"_24513":46638,"_2467":46745},[],"Re-enrollment Delta",{"_2944":1495,"_25897":1456,"_18081":46747,"_5":17976,"_24513":46638,"_2467":46748},[],"1 hour.",{"_2944":1496,"_25897":1456,"_18081":46750,"_5":17976,"_24513":46638,"_2467":46751},[],"Preventive / Critical Delta",{"_2944":1497,"_25897":1456,"_18081":46753,"_5":17976,"_24513":46638,"_2467":46754},[],"30 minutes / 10 minutes.",{"_2944":1498,"_25897":1456,"_18081":46756,"_5":17976,"_24513":46638,"_2467":46757},[],"Revoke on Re-enrollment",{"_2944":1499,"_25897":1456,"_18081":46759,"_5":17976,"_24513":46638,"_2467":46760},[],"Disabled to test the successor before retiring the previous identity.",{"_2944":1500,"_25897":1456,"_18081":46762,"_5":17976,"_24513":46638,"_2467":44789},[],{"_2944":1501,"_25897":1456,"_18081":46764,"_5":17976,"_24513":46638,"_2467":46765},[],"Disabled; the operational key is generated in the client.",{"_2944":1502,"_25897":1456,"_18081":46767,"_5":17976,"_24513":46638,"_2467":46768},[],"CA Distribution",{"_2944":1503,"_25897":1456,"_18081":46770,"_5":17976,"_24513":46638,"_2467":46771},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2944":1504,"_25897":1456,"_18081":46773,"_5":17976,"_24513":46638,"_2467":46774},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2944":1505,"_25897":1456,"_18081":46776,"_5":17976,"_24513":46642,"_2467":46777},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2944":1506,"_25897":1456,"_18081":46779,"_5":17976,"_24513":46642,"_2467":46780},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2944":1507,"_25897":1456,"_18081":46782,"_5":17976,"_24513":46646,"_2467":46783},[],"Generate a new key and CSR with the selected identifier:",{"_2944":1508,"_25897":1456,"_18081":46785,"_5":17976,"_24513":46646,"_2467":46786},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2944":1509,"_25897":1456,"_18081":46788,"_5":17976,"_24513":46646,"_2467":46789},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2944":1510,"_25897":1456,"_18081":46791,"_5":17976,"_24513":46650,"_2467":46792},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2944":1511,"_25897":1456,"_18081":46794,"_5":17976,"_24513":46650,"_2467":46795},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2944":1512,"_25897":1456,"_18081":46797,"_5":17976,"_24513":46654,"_2467":46798},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2944":1513,"_25897":1456,"_18081":46800,"_5":17976,"_24513":46654,"_2467":46801},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2944":1514,"_25897":1456,"_18081":46803,"_5":17976,"_24513":46654,"_2467":46804},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2944":1515,"_25897":1456,"_18081":46806,"_5":17976,"_24513":46654,"_2467":46807},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2944":1516,"_25897":1456,"_18081":46809,"_5":17976,"_24513":46654,"_2467":46810},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2944":1517,"_25897":1456,"_18081":46812,"_5":17976,"_24513":46658,"_2467":46813},[],"Check",{"_2944":1518,"_25897":1456,"_18081":46815,"_5":17976,"_24513":46658,"_2467":46816},[],"Expected result",{"_2944":1519,"_25897":1456,"_18081":46818,"_5":17976,"_24513":46658,"_2467":46819},[],"Registration",{"_2944":1520,"_25897":1456,"_18081":46821,"_5":17976,"_24513":46658,"_2467":46822},[],"ID created automatically and correct DMS.",{"_2944":1521,"_25897":1456,"_18081":46824,"_5":17976,"_24513":46658,"_2467":46825},[],"Certificate",{"_2944":1522,"_25897":1456,"_18081":46827,"_5":17976,"_24513":46658,"_2467":46828},[],"CN, profile, serial and key verified.",{"_2944":1523,"_25897":1456,"_18081":46830,"_5":17976,"_24513":46658,"_2467":46831},[],"Inventory",{"_2944":1524,"_25897":1456,"_18081":46833,"_5":17976,"_24513":46658,"_2467":46834},[],"Received serial visible as the current identity and in history.",{"_2944":1525,"_25897":1456,"_18081":46836,"_5":17976,"_24513":46658,"_2467":46837},[],"Consumer",{"_2944":1526,"_25897":1456,"_18081":46839,"_5":17976,"_24513":46658,"_2467":46840},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2944":1527,"_25897":1456,"_18081":46842,"_5":17976,"_24513":46658,"_2467":46843},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2944":1528,"_25897":1456,"_18081":46845,"_5":17976,"_24513":46658,"_2467":46846},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2944":1529,"_25897":1529,"_5":12672,"_2467":44486,"_26242":46848,"_18081":46849,"_24513":1529},[42109,43496,44470,46624],[],{"_2944":1530,"_25897":1529,"_18081":46851,"_5":17976,"_24513":1529,"_2467":46852},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2944":1531,"_25897":1529,"_5":26239,"_18081":46854,"_24513":46855,"_2467":42119},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2944":1532,"_25897":1529,"_5":26239,"_18081":46857,"_24513":46858,"_2467":46859},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2944":1533,"_25897":1529,"_5":26239,"_18081":46861,"_24513":46862,"_2467":46863},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2944":1534,"_25897":1529,"_5":26239,"_18081":46865,"_24513":46866,"_2467":46867},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2944":1535,"_25897":1529,"_5":26239,"_18081":46869,"_24513":46870,"_2467":46871},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2944":1536,"_25897":1529,"_5":26239,"_18081":46873,"_24513":46874,"_2467":46875},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2944":1537,"_25897":1529,"_5":26239,"_18081":46877,"_24513":46878,"_2467":46816},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2944":1538,"_25897":1529,"_5":26239,"_18081":46880,"_24513":46881,"_2467":46882},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2944":1539,"_25897":1529,"_5":26239,"_18081":46884,"_24513":46885,"_2467":46886},[],"/docs/pr-preview/pr-41/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2944":1540,"_25897":1529,"_18081":46888,"_5":17976,"_24513":1529,"_2467":46889},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2944":1541,"_25897":1529,"_18081":46891,"_5":17976,"_24513":1529,"_2467":46892},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2944":1542,"_25897":1529,"_18081":46894,"_5":17976,"_24513":46855,"_2467":46895},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2944":1543,"_25897":1529,"_18081":46897,"_5":17976,"_24513":46855,"_2467":46898},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2944":1544,"_25897":1529,"_18081":46900,"_5":17976,"_24513":46855,"_2467":46901},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2944":1545,"_25897":1529,"_18081":46903,"_5":17976,"_24513":46855,"_2467":46904},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2944":1546,"_25897":1529,"_18081":46906,"_5":17976,"_24513":46858,"_2467":46907},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2944":1547,"_25897":1529,"_18081":46909,"_5":17976,"_24513":46858,"_2467":46910},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2944":1548,"_25897":1529,"_18081":46912,"_5":17976,"_24513":46858,"_2467":46913},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2944":1549,"_25897":1529,"_18081":46915,"_5":17976,"_24513":46858,"_2467":46916},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2944":1550,"_25897":1529,"_18081":46918,"_5":17976,"_24513":46858,"_2467":46919},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2944":1551,"_25897":1529,"_18081":46921,"_5":17976,"_24513":46858,"_2467":46922},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2944":1552,"_25897":1529,"_18081":46924,"_5":17976,"_24513":46858,"_2467":46925},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2944":1553,"_25897":1529,"_18081":46927,"_5":17976,"_24513":46858,"_2467":46928},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2944":1554,"_25897":1529,"_18081":46930,"_5":17976,"_24513":46862,"_2467":46931},[],"Open **Managed Devices** and the registration action. Complete:",{"_2944":1555,"_25897":1529,"_18081":46933,"_5":17976,"_24513":46862,"_2467":46934},[],"**Device ID**: `device-001`.",{"_2944":1556,"_25897":1529,"_18081":46936,"_5":17976,"_24513":46862,"_2467":46937},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2944":1557,"_25897":1529,"_18081":46939,"_5":17976,"_24513":46862,"_2467":46940},[],"**Icon** and **Tags**: optional classification.",{"_2944":1558,"_25897":1529,"_18081":46942,"_5":17976,"_24513":46862,"_2467":46943},[],"Confirm registration.",{"_2944":1559,"_25897":1529,"_18081":46945,"_5":17976,"_24513":46866,"_2467":46946},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2944":1560,"_25897":1529,"_18081":46948,"_5":17976,"_24513":46866,"_2467":46949},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2944":1561,"_25897":1529,"_18081":46951,"_5":17976,"_24513":46870,"_2467":46952},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2944":1562,"_25897":1529,"_18081":46954,"_5":17976,"_24513":46870,"_2467":46955},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2944":1563,"_25897":1529,"_18081":46957,"_5":17976,"_24513":46874,"_2467":46958},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2944":1564,"_25897":1529,"_18081":46960,"_5":17976,"_24513":46874,"_2467":46961},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2944":1565,"_25897":1529,"_18081":46963,"_5":17976,"_24513":46878,"_2467":46813},[],{"_2944":1566,"_25897":1529,"_18081":46965,"_5":17976,"_24513":46878,"_2467":46966},[],"Result",{"_2944":1567,"_25897":1529,"_18081":46968,"_5":17976,"_24513":46878,"_2467":46969},[],"Device",{"_2944":1568,"_25897":1529,"_18081":46971,"_5":17976,"_24513":46878,"_2467":46972},[],"`device-001` appears in inventory with the expected DMS.",{"_2944":1569,"_25897":1529,"_18081":46974,"_5":17976,"_24513":46878,"_2467":46975},[],"Current identity",{"_2944":1570,"_25897":1529,"_18081":46977,"_5":17976,"_24513":46878,"_2467":46978},[],"The associated certificate matches the one you verified in PKI.",{"_2944":1571,"_25897":1529,"_18081":46980,"_5":17976,"_24513":46878,"_2467":46981},[],"History",{"_2944":1572,"_25897":1529,"_18081":46983,"_5":17976,"_24513":46878,"_2467":46984},[],"The associated issuance appears with its serial number and dates.",{"_2944":1573,"_25897":1529,"_18081":46986,"_5":17976,"_24513":46878,"_2467":46987},[],"Key and certificate",{"_2944":1574,"_25897":1529,"_18081":46989,"_5":17976,"_24513":46878,"_2467":46990},[],"You have the verified pair ready to install on the device.",{"_2944":1575,"_25897":1529,"_18081":46992,"_5":17976,"_24513":46881,"_2467":46993},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2944":1576,"_25897":1529,"_18081":46995,"_5":17976,"_24513":46881,"_2467":46996},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2944":1577,"_25897":1529,"_18081":46998,"_5":17976,"_24513":46881,"_2467":46999},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2944":1578,"_25897":1529,"_18081":47001,"_5":17976,"_24513":46881,"_2467":47002},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2944":1579,"_25897":1529,"_18081":47004,"_5":17976,"_24513":46885,"_2467":47005},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2944":1580,"_25897":1529,"_18081":47007,"_5":17976,"_24513":46885,"_2467":47008},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2944":1581,"_25897":1529,"_18081":47010,"_5":17976,"_24513":46885,"_2467":47011},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2944":1582,"_25897":1582,"_5":12672,"_2467":47013,"_26242":47014,"_18081":47015,"_24513":1582},"Lamassu IoT Platform",[42109,43496],[],{"_2944":1583,"_25897":1582,"_18081":47017,"_5":17976,"_24513":1582,"_2467":47018},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2944":1584,"_25897":1582,"_5":26239,"_18081":47020,"_24513":47021,"_2467":46499},[],"/docs/pr-preview/pr-41/platform/overview#start-here",{"_2944":1585,"_25897":1582,"_5":26239,"_18081":47023,"_24513":47024,"_2467":47025},[],"/docs/pr-preview/pr-41/platform/overview#choose-your-path","Choose your path",{"_2944":1586,"_25897":1582,"_5":26239,"_18081":47027,"_24513":47028,"_2467":47029},[],"/docs/pr-preview/pr-41/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2944":1587,"_25897":1582,"_5":26239,"_18081":47031,"_24513":47032,"_2467":47033},[],"/docs/pr-preview/pr-41/platform/overview#core-capabilities","Core capabilities",{"_2944":1588,"_25897":1582,"_5":26239,"_18081":47035,"_24513":47036,"_2467":47037},[],"/docs/pr-preview/pr-41/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2944":1589,"_25897":1582,"_5":26239,"_18081":47039,"_24513":47040,"_2467":47041},[],"/docs/pr-preview/pr-41/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2944":1590,"_25897":1582,"_5":26239,"_18081":47043,"_24513":47044,"_2467":47045},[],"/docs/pr-preview/pr-41/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2944":1591,"_25897":1582,"_5":26239,"_18081":47047,"_24513":47048,"_2467":47049},[],"/docs/pr-preview/pr-41/platform/overview#automate-device-identities","Automate device identities",{"_2944":1592,"_25897":1582,"_5":26239,"_18081":47051,"_24513":47052,"_2467":47053},[],"/docs/pr-preview/pr-41/platform/overview#publish-validation-status","Publish validation status",{"_2944":1593,"_25897":1582,"_5":26239,"_18081":47055,"_24513":47056,"_2467":47057},[],"/docs/pr-preview/pr-41/platform/overview#react-to-events","React to events",{"_2944":1594,"_25897":1582,"_5":26239,"_18081":47059,"_24513":47060,"_2467":47061},[],"/docs/pr-preview/pr-41/platform/overview#operational-reference","Operational reference",{"_2944":1595,"_25897":1582,"_18081":47063,"_5":17976,"_24513":1582,"_2467":47064},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2944":1596,"_25897":1582,"_18081":47066,"_5":17976,"_24513":47021,"_2467":47067},[],"Choose the result you need:",{"_2944":1597,"_25897":1582,"_18081":47069,"_5":17976,"_24513":47021,"_2467":47070},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2944":1598,"_25897":1582,"_18081":47072,"_5":17976,"_24513":47021,"_2467":47073},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2944":1599,"_25897":1582,"_18081":47075,"_5":17976,"_24513":47021,"_2467":47076},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2944":1600,"_25897":1582,"_18081":47078,"_5":17976,"_24513":47024,"_2467":47079},[],"Section",{"_2944":1601,"_25897":1582,"_18081":47081,"_5":17976,"_24513":47024,"_2467":47082},[],"What you manage",{"_2944":1602,"_25897":1582,"_18081":47084,"_5":17976,"_24513":47024,"_2467":47085},[],"Entry point",{"_2944":1603,"_25897":1582,"_18081":47087,"_5":17976,"_24513":47024,"_2467":47088},[],"**PKI**",{"_2944":1604,"_25897":1582,"_18081":47090,"_5":17976,"_24513":47024,"_2467":47091},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2944":1605,"_25897":1582,"_18081":47093,"_5":17976,"_24513":47024,"_2467":47094},[],"PKI overview",{"_2944":1606,"_25897":1582,"_18081":47096,"_5":17976,"_24513":47024,"_2467":47097},[],"**IoT Fleets**",{"_2944":1607,"_25897":1582,"_18081":47099,"_5":17976,"_24513":47024,"_2467":47100},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2944":1608,"_25897":1582,"_18081":47102,"_5":17976,"_24513":47024,"_2467":47103},[],"IoT Fleets overview",{"_2944":1609,"_25897":1582,"_18081":47105,"_5":17976,"_24513":47024,"_2467":47106},[],"**Administration**",{"_2944":1610,"_25897":1582,"_18081":47108,"_5":17976,"_24513":47024,"_2467":47109},[],"Operator permissions, audit and event subscriptions.",{"_2944":1611,"_25897":1582,"_18081":47111,"_5":17976,"_24513":47024,"_2467":43494},[],{"_2944":1612,"_25897":1582,"_18081":47113,"_5":17976,"_24513":47024,"_2467":47114},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2944":1613,"_25897":1582,"_18081":47116,"_5":17976,"_24513":47028,"_2467":47117},[],"An identity's journey connects four responsibilities:",{"_2944":1614,"_25897":1582,"_18081":47119,"_5":17976,"_24513":47028,"_2467":47120},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2944":1615,"_25897":1582,"_18081":47122,"_5":17976,"_24513":47028,"_2467":47123},[],"The provisioning administrator configures the DMS and initial trust.",{"_2944":1616,"_25897":1582,"_18081":47125,"_5":17976,"_24513":47028,"_2467":47126},[],"The device client requests a certificate and installs it with the matching key.",{"_2944":1617,"_25897":1582,"_18081":47128,"_5":17976,"_24513":47028,"_2467":47129},[],"The consumer validates the identity and applies its access permissions.",{"_2944":1618,"_25897":1582,"_18081":47131,"_5":17976,"_24513":47028,"_2467":47132},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2944":1619,"_25897":1582,"_18081":47134,"_5":17976,"_24513":47036,"_2467":47135},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2944":1620,"_25897":1582,"_18081":47137,"_5":17976,"_24513":47040,"_2467":47138},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2944":1621,"_25897":1582,"_18081":47140,"_5":17976,"_24513":47044,"_2467":47141},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2944":1622,"_25897":1582,"_18081":47143,"_5":17976,"_24513":47048,"_2467":47144},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2944":1623,"_25897":1582,"_18081":47146,"_5":17976,"_24513":47052,"_2467":47147},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2944":1624,"_25897":1582,"_18081":47149,"_5":17976,"_24513":47056,"_2467":47150},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2944":1625,"_25897":1582,"_18081":47152,"_5":17976,"_24513":47060,"_2467":46593},[],{"_2944":1626,"_25897":1582,"_18081":47154,"_5":17976,"_24513":47060,"_2467":47155},[],"What it prepares or checks",{"_2944":1627,"_25897":1582,"_18081":47157,"_5":17976,"_24513":47060,"_2467":46596},[],{"_2944":1628,"_25897":1582,"_18081":47159,"_5":17976,"_24513":47060,"_2467":47160},[],"Key custody, CA hierarchy, profiles and validation.",{"_2944":1629,"_25897":1582,"_18081":47162,"_5":17976,"_24513":47060,"_2467":47163},[],"Fleet administrator",{"_2944":1630,"_25897":1582,"_18081":47165,"_5":17976,"_24513":47060,"_2467":47166},[],"DMS, device admission, renewal policy and inventory.",{"_2944":1631,"_25897":1582,"_18081":47168,"_5":17976,"_24513":47060,"_2467":46608},[],{"_2944":1632,"_25897":1582,"_18081":47170,"_5":17976,"_24513":47060,"_2467":47171},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2944":1633,"_25897":1582,"_18081":47173,"_5":17976,"_24513":47060,"_2467":46614},[],{"_2944":1634,"_25897":1582,"_18081":47175,"_5":17976,"_24513":47060,"_2467":47176},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2944":1635,"_25897":1582,"_18081":47178,"_5":17976,"_24513":47060,"_2467":47179},[],"Infrastructure operator",{"_2944":1636,"_25897":1582,"_18081":47181,"_5":17976,"_24513":47060,"_2467":47182},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2944":1637,"_25897":1582,"_18081":47184,"_5":17976,"_24513":47060,"_2467":47185},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2944":1638,"_25897":1638,"_5":12672,"_2467":47187,"_26242":47188,"_18081":47191,"_24513":1638},"CA hierarchy and rotation",[42109,43496,47189,47190],"PKI","Keys, authorities and certificates",[],{"_2944":1639,"_25897":1638,"_18081":47193,"_5":17976,"_24513":1638,"_2467":47194},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2944":1640,"_25897":1638,"_5":26239,"_18081":47196,"_24513":47197,"_2467":47198},[],"/docs/pr-preview/pr-41/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2944":1641,"_25897":1638,"_5":26239,"_18081":47200,"_24513":47201,"_2467":47202},[],"/docs/pr-preview/pr-41/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2944":1642,"_25897":1638,"_5":26239,"_18081":47204,"_24513":47205,"_2467":47206},[],"/docs/pr-preview/pr-41/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2944":1643,"_25897":1638,"_5":26239,"_18081":47208,"_24513":47209,"_2467":47210},[],"/docs/pr-preview/pr-41/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2944":1644,"_25897":1638,"_5":26239,"_18081":47212,"_24513":47213,"_2467":47214},[],"/docs/pr-preview/pr-41/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2944":1645,"_25897":1638,"_5":26239,"_18081":47216,"_24513":47217,"_2467":47218},[],"/docs/pr-preview/pr-41/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2944":1646,"_25897":1638,"_5":26239,"_18081":47220,"_24513":47221,"_2467":47222},[],"/docs/pr-preview/pr-41/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2944":1647,"_25897":1638,"_5":26239,"_18081":47224,"_24513":47225,"_2467":47226},[],"/docs/pr-preview/pr-41/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2944":1648,"_25897":1638,"_5":26239,"_18081":47228,"_24513":47229,"_2467":47230},[],"/docs/pr-preview/pr-41/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2944":1649,"_25897":1638,"_5":26239,"_18081":47232,"_24513":47233,"_2467":47234},[],"/docs/pr-preview/pr-41/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2944":1650,"_25897":1638,"_5":26239,"_18081":47236,"_24513":47237,"_2467":47238},[],"/docs/pr-preview/pr-41/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2944":1651,"_25897":1638,"_5":26239,"_18081":47240,"_24513":47241,"_2467":47242},[],"/docs/pr-preview/pr-41/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2944":1652,"_25897":1638,"_18081":47244,"_5":17976,"_24513":1638,"_2467":47245},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2944":1653,"_25897":1638,"_18081":47247,"_5":17976,"_24513":1638,"_2467":47248},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2944":1654,"_25897":1638,"_18081":47250,"_5":17976,"_24513":47197,"_2467":47251},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2944":1655,"_25897":1638,"_18081":47253,"_5":17976,"_24513":47197,"_2467":47254},[],"environment, such as production and preproduction;",{"_2944":1656,"_25897":1638,"_18081":47256,"_5":17976,"_24513":47197,"_2467":47257},[],"owner or operating team;",{"_2944":1657,"_25897":1638,"_18081":47259,"_5":17976,"_24513":47197,"_2467":47260},[],"device family or manufacturing process;",{"_2944":1658,"_25897":1638,"_18081":47262,"_5":17976,"_24513":47197,"_2467":47263},[],"region or regulatory requirement;",{"_2944":1659,"_25897":1638,"_18081":47265,"_5":17976,"_24513":47197,"_2467":47266},[],"cryptographic engine or key policy;",{"_2944":1660,"_25897":1638,"_18081":47268,"_5":17976,"_24513":47197,"_2467":47269},[],"maintenance window and renewal cadence.",{"_2944":1661,"_25897":1638,"_18081":47271,"_5":17976,"_24513":47197,"_2467":47272},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2944":1662,"_25897":1638,"_18081":47274,"_5":17976,"_24513":47197,"_2467":47275},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2944":1663,"_25897":1638,"_18081":47277,"_5":17976,"_24513":47201,"_2467":47278},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2944":1664,"_25897":1638,"_18081":47280,"_5":17976,"_24513":47201,"_2467":47281},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2944":1665,"_25897":1638,"_18081":47283,"_5":17976,"_24513":47201,"_2467":47284},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2944":1666,"_25897":1638,"_18081":47286,"_5":17976,"_24513":47205,"_2467":47287},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2944":1667,"_25897":1638,"_18081":47289,"_5":17976,"_24513":47205,"_2467":47290},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2944":1668,"_25897":1638,"_18081":47292,"_5":17976,"_24513":47205,"_2467":47293},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2944":1669,"_25897":1638,"_18081":47295,"_5":17976,"_24513":47205,"_2467":47296},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2944":1670,"_25897":1638,"_18081":47298,"_5":17976,"_24513":47213,"_2467":47299},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2944":1671,"_25897":1638,"_18081":47301,"_5":17976,"_24513":47217,"_2467":47302},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2944":1672,"_25897":1638,"_18081":47304,"_5":17976,"_24513":47221,"_2467":47305},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2944":1673,"_25897":1638,"_18081":47307,"_5":17976,"_24513":47225,"_2467":47308},[],"Update the enrollment CA and profile of the DMSs, and add the old CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) while old-CA cohorts still renew. The DMS guide documents the setting.",{"_2944":1674,"_25897":1638,"_18081":47310,"_5":17976,"_24513":47229,"_2467":47311},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2944":1675,"_25897":1638,"_18081":47313,"_5":17976,"_24513":47233,"_2467":47314},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2944":1676,"_25897":1638,"_18081":47316,"_5":17976,"_24513":47237,"_2467":47317},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2944":1677,"_25897":1638,"_18081":47319,"_5":17976,"_24513":47237,"_2467":47320},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2944":1678,"_25897":1638,"_18081":47322,"_5":17976,"_24513":47237,"_2467":47323},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2944":1679,"_25897":1638,"_18081":47325,"_5":17976,"_24513":47237,"_2467":47326},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2944":1680,"_25897":1638,"_18081":47328,"_5":17976,"_24513":47241,"_2467":47329},[],"The new chain ends in an anchor installed by the consumer.",{"_2944":1681,"_25897":1638,"_18081":47331,"_5":17976,"_24513":47241,"_2467":47332},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2944":1682,"_25897":1638,"_18081":47334,"_5":17976,"_24513":47241,"_2467":47335},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2944":1683,"_25897":1638,"_18081":47337,"_5":17976,"_24513":47241,"_2467":47338},[],"Re-enrollment accepts the old identity during the planned period.",{"_2944":1684,"_25897":1638,"_18081":47340,"_5":17976,"_24513":47241,"_2467":47341},[],"OCSP and CRL respond for the authorities that remain active.",{"_2944":1685,"_25897":1638,"_18081":47343,"_5":17976,"_24513":47241,"_2467":47344},[],"No DMS is left accidentally issuing from the old CA.",{"_2944":1686,"_25897":1638,"_18081":47346,"_5":17976,"_24513":47241,"_2467":47347},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2944":1687,"_25897":1687,"_5":12672,"_2467":47349,"_26242":47350,"_18081":47351,"_24513":1687},"Certification authorities",[42109,43496,47189,47190],[],{"_2944":1688,"_25897":1687,"_18081":47353,"_5":17976,"_24513":1687,"_2467":47354},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2944":1689,"_25897":1687,"_5":26239,"_18081":47356,"_24513":47357,"_2467":47358},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2944":1690,"_25897":1687,"_5":26239,"_18081":47360,"_24513":47361,"_2467":47362},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2944":1691,"_25897":1687,"_5":26239,"_18081":47364,"_24513":47365,"_2467":42119},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#before-you-begin",{"_2944":1692,"_25897":1687,"_5":26239,"_18081":47367,"_24513":47368,"_2467":47369},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2944":1693,"_25897":1687,"_5":26239,"_18081":47371,"_24513":47372,"_2467":47373},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2944":1694,"_25897":1687,"_5":26239,"_18081":47375,"_24513":47376,"_2467":47377},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2944":1695,"_25897":1687,"_5":26239,"_18081":47379,"_24513":47380,"_2467":47381},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2944":1696,"_25897":1687,"_5":26239,"_18081":47383,"_24513":47384,"_2467":47385},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2944":1697,"_25897":1687,"_5":26239,"_18081":47387,"_24513":47388,"_2467":47389},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2944":1698,"_25897":1687,"_5":26239,"_18081":47391,"_24513":47392,"_2467":47393},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2944":1699,"_25897":1687,"_5":26239,"_18081":47395,"_24513":47396,"_2467":47397},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2944":1700,"_25897":1687,"_5":26239,"_18081":47399,"_24513":47400,"_2467":47401},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2944":1701,"_25897":1687,"_5":26239,"_18081":47403,"_24513":47404,"_2467":47405},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2944":1702,"_25897":1687,"_5":26239,"_18081":47407,"_24513":47408,"_2467":47409},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2944":1703,"_25897":1687,"_5":26239,"_18081":47411,"_24513":47412,"_2467":47413},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2944":1704,"_25897":1687,"_5":26239,"_18081":47415,"_24513":47416,"_2467":47417},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2944":1705,"_25897":1687,"_5":26239,"_18081":47419,"_24513":47420,"_2467":47421},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2944":1706,"_25897":1687,"_5":26239,"_18081":47423,"_24513":47424,"_2467":47425},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2944":1707,"_25897":1687,"_5":26239,"_18081":47427,"_24513":47428,"_2467":47429},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2944":1708,"_25897":1687,"_5":26239,"_18081":47431,"_24513":47432,"_2467":47433},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2944":1709,"_25897":1687,"_5":26239,"_18081":47435,"_24513":47436,"_2467":47437},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2944":1710,"_25897":1687,"_5":26239,"_18081":47439,"_24513":47440,"_2467":47441},[],"/docs/pr-preview/pr-41/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2944":1711,"_25897":1687,"_18081":47443,"_5":17976,"_24513":1687,"_2467":47444},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2944":1712,"_25897":1687,"_18081":47446,"_5":17976,"_24513":1687,"_2467":47447},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2944":1713,"_25897":1687,"_18081":47449,"_5":17976,"_24513":1687,"_2467":47450},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2944":1714,"_25897":1687,"_18081":47452,"_5":17976,"_24513":47357,"_2467":47453},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2944":1715,"_25897":1687,"_18081":47455,"_5":17976,"_24513":47357,"_2467":47456},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2944":1716,"_25897":1687,"_18081":47458,"_5":17976,"_24513":47357,"_2467":47459},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2944":1717,"_25897":1687,"_18081":47461,"_5":17976,"_24513":47357,"_2467":47462},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2944":1718,"_25897":1687,"_18081":47464,"_5":17976,"_24513":47357,"_2467":47465},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2944":1719,"_25897":1687,"_18081":47467,"_5":17976,"_24513":47365,"_2467":47468},[],"Decide whether the CA will be a root or an intermediate.",{"_2944":1720,"_25897":1687,"_18081":47470,"_5":17976,"_24513":47365,"_2467":47471},[],"Choose the engine that will keep the key.",{"_2944":1721,"_25897":1687,"_18081":47473,"_5":17976,"_24513":47365,"_2467":47474},[],"Define a validity longer than that of the certificates it will issue.",{"_2944":1722,"_25897":1687,"_18081":47476,"_5":17976,"_24513":47365,"_2467":47477},[],"For an intermediate CA, make sure the parent CA is active.",{"_2944":1723,"_25897":1687,"_18081":47479,"_5":17976,"_24513":47368,"_2467":47480},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2944":1724,"_25897":1687,"_18081":47482,"_5":17976,"_24513":47372,"_2467":47483},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2944":1725,"_25897":1687,"_18081":47485,"_5":17976,"_24513":47372,"_2467":47486},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2944":1726,"_25897":1687,"_18081":47488,"_5":17976,"_24513":47376,"_2467":47489},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2944":1727,"_25897":1687,"_18081":47491,"_5":17976,"_24513":47380,"_2467":47492},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2944":1728,"_25897":1687,"_18081":47494,"_5":17976,"_24513":47380,"_2467":47495},[],"`C`: two-letter ISO 3166-1 country code.",{"_2944":1729,"_25897":1687,"_18081":47497,"_5":17976,"_24513":47380,"_2467":47498},[],"`ST`: state or province.",{"_2944":1730,"_25897":1687,"_18081":47500,"_5":17976,"_24513":47380,"_2467":47501},[],"`L`: locality.",{"_2944":1731,"_25897":1687,"_18081":47503,"_5":17976,"_24513":47380,"_2467":47504},[],"`O`: organization.",{"_2944":1732,"_25897":1687,"_18081":47506,"_5":17976,"_24513":47380,"_2467":47507},[],"`OU`: organizational unit.",{"_2944":1733,"_25897":1687,"_18081":47509,"_5":17976,"_24513":47380,"_2467":47510},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2944":1734,"_25897":1687,"_18081":47512,"_5":17976,"_24513":47384,"_2467":47513},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2944":1735,"_25897":1687,"_18081":47515,"_5":17976,"_24513":47384,"_2467":47516},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2944":1736,"_25897":1687,"_18081":47518,"_5":17976,"_24513":47388,"_2467":47519},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2944":1737,"_25897":1687,"_18081":47521,"_5":17976,"_24513":47388,"_2467":47522},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2944":1738,"_25897":1687,"_18081":47524,"_5":17976,"_24513":47392,"_2467":47525},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2944":1739,"_25897":1687,"_18081":47527,"_5":17976,"_24513":47392,"_2467":47528},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2944":1740,"_25897":1687,"_18081":47530,"_5":17976,"_24513":47396,"_2467":47531},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2944":1741,"_25897":1687,"_18081":47533,"_5":17976,"_24513":47400,"_2467":47534},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2944":1742,"_25897":1687,"_18081":47536,"_5":17976,"_24513":47404,"_2467":47537},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2944":1743,"_25897":1687,"_18081":47539,"_5":17976,"_24513":47408,"_2467":47540},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2944":1744,"_25897":1687,"_18081":47542,"_5":17976,"_24513":47412,"_2467":47543},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2944":1745,"_25897":1687,"_18081":47545,"_5":17976,"_24513":47412,"_2467":47546},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2944":1746,"_25897":1687,"_18081":47548,"_5":17976,"_24513":47416,"_2467":47549},[],"Open a CA from the inventory to review:",{"_2944":1747,"_25897":1687,"_18081":47551,"_5":17976,"_24513":47416,"_2467":47552},[],"Status and validity period.",{"_2944":1748,"_25897":1687,"_18081":47554,"_5":17976,"_24513":47416,"_2467":47555},[],"Certificate and chain in PEM format.",{"_2944":1749,"_25897":1687,"_18081":47557,"_5":17976,"_24513":47416,"_2467":47558},[],"Number of active, expired and revoked certificates.",{"_2944":1750,"_25897":1687,"_18081":47560,"_5":17976,"_24513":47416,"_2467":47561},[],"Certificates issued in **Issued Certificates**.",{"_2944":1751,"_25897":1687,"_18081":47563,"_5":17976,"_24513":47416,"_2467":47564},[],"The CRL linked to the authority.",{"_2944":1752,"_25897":1687,"_18081":47566,"_5":17976,"_24513":47416,"_2467":47567},[],"Metadata and the associated cryptographic engine.",{"_2944":1753,"_25897":1687,"_18081":47569,"_5":17976,"_24513":47416,"_2467":47570},[],"You can filter the inventory by name, status and CA type.",{"_2944":1754,"_25897":1687,"_18081":47572,"_5":17976,"_24513":47420,"_2467":47573},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2944":1755,"_25897":1687,"_18081":47575,"_5":17976,"_24513":47420,"_2467":47576},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2944":1756,"_25897":1687,"_18081":47578,"_5":17976,"_24513":47420,"_2467":47579},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2944":1757,"_25897":1687,"_18081":47581,"_5":17976,"_24513":47420,"_2467":47582},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2944":1758,"_25897":1687,"_18081":47584,"_5":17976,"_24513":47424,"_2467":47585},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2944":1759,"_25897":1687,"_18081":47587,"_5":17976,"_24513":47428,"_2467":47588},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2944":1760,"_25897":1687,"_18081":47590,"_5":17976,"_24513":47432,"_2467":47591},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2944":1761,"_25897":1687,"_18081":47593,"_5":17976,"_24513":47436,"_2467":47594},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2944":1762,"_25897":1687,"_18081":47596,"_5":17976,"_24513":47440,"_2467":47597},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2944":1763,"_25897":1687,"_18081":47599,"_5":17976,"_24513":47440,"_2467":47600},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2944":1764,"_25897":1764,"_5":12672,"_2467":47602,"_26242":47603,"_18081":47604,"_24513":1764},"Certificate profiles",[42109,43496,47189,47190],[],{"_2944":1765,"_25897":1764,"_18081":47606,"_5":17976,"_24513":1764,"_2467":47607},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2944":1766,"_25897":1764,"_5":26239,"_18081":47609,"_24513":47610,"_2467":47611},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2944":1767,"_25897":1764,"_5":26239,"_18081":47613,"_24513":47614,"_2467":47615},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#validity","Validity",{"_2944":1768,"_25897":1764,"_5":26239,"_18081":47617,"_24513":47618,"_2467":47619},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2944":1769,"_25897":1764,"_5":26239,"_18081":47621,"_24513":47622,"_2467":47623},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2944":1770,"_25897":1764,"_5":26239,"_18081":47625,"_24513":47626,"_2467":47627},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#subject","Subject",{"_2944":1771,"_25897":1764,"_5":26239,"_18081":47629,"_24513":47630,"_2467":47631},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2944":1772,"_25897":1764,"_5":26239,"_18081":47633,"_24513":47634,"_2467":47635},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2944":1773,"_25897":1764,"_5":26239,"_18081":47637,"_24513":47638,"_2467":47639},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2944":1774,"_25897":1764,"_5":26239,"_18081":47641,"_24513":47642,"_2467":47643},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2944":1775,"_25897":1764,"_5":26239,"_18081":47645,"_24513":47646,"_2467":47647},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2944":1776,"_25897":1764,"_5":26239,"_18081":47649,"_24513":47650,"_2467":47651},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2944":1777,"_25897":1764,"_5":26239,"_18081":47653,"_24513":47654,"_2467":47655},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2944":1778,"_25897":1764,"_5":26239,"_18081":47657,"_24513":47658,"_2467":47659},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2944":1779,"_25897":1764,"_5":26239,"_18081":47661,"_24513":47662,"_2467":47663},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2944":1780,"_25897":1764,"_5":26239,"_18081":47665,"_24513":47666,"_2467":47667},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#design-examples","Design examples",{"_2944":1781,"_25897":1764,"_5":26239,"_18081":47669,"_24513":47670,"_2467":47671},[],"/docs/pr-preview/pr-41/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2944":1782,"_25897":1764,"_18081":47673,"_5":17976,"_24513":1764,"_2467":47674},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2944":1783,"_25897":1764,"_18081":47676,"_5":17976,"_24513":1764,"_2467":47677},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2944":1784,"_25897":1764,"_18081":47679,"_5":17976,"_24513":47614,"_2467":47680},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2944":1785,"_25897":1764,"_18081":47682,"_5":17976,"_24513":47614,"_2467":47683},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2944":1786,"_25897":1764,"_18081":47685,"_5":17976,"_24513":47618,"_2467":47686},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2944":1787,"_25897":1764,"_18081":47688,"_5":17976,"_24513":47622,"_2467":47689},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2944":1788,"_25897":1764,"_18081":47691,"_5":17976,"_24513":47622,"_2467":47692},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2944":1789,"_25897":1764,"_18081":47694,"_5":17976,"_24513":47622,"_2467":47695},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2944":1790,"_25897":1764,"_18081":47697,"_5":17976,"_24513":47626,"_2467":47698},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2944":1791,"_25897":1764,"_18081":47700,"_5":17976,"_24513":47630,"_2467":47701},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2944":1792,"_25897":1764,"_18081":47703,"_5":17976,"_24513":47630,"_2467":47704},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2944":1793,"_25897":1764,"_18081":47706,"_5":17976,"_24513":47634,"_2467":47707},[],"The cryptographic enforcement can:",{"_2944":1794,"_25897":1764,"_18081":47709,"_5":17976,"_24513":47634,"_2467":47710},[],"allow or block RSA keys;",{"_2944":1795,"_25897":1764,"_18081":47712,"_5":17976,"_24513":47634,"_2467":47713},[],"limit the supported RSA sizes;",{"_2944":1796,"_25897":1764,"_18081":47715,"_5":17976,"_24513":47634,"_2467":47716},[],"allow or block ECDSA keys;",{"_2944":1797,"_25897":1764,"_18081":47718,"_5":17976,"_24513":47634,"_2467":47719},[],"limit the supported ECDSA sizes or curves.",{"_2944":1798,"_25897":1764,"_18081":47721,"_5":17976,"_24513":47634,"_2467":47722},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2944":1799,"_25897":1764,"_18081":47724,"_5":17976,"_24513":47638,"_2467":47725},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2944":1800,"_25897":1764,"_18081":47727,"_5":17976,"_24513":47638,"_2467":45217},[],{"_2944":1801,"_25897":1764,"_18081":47729,"_5":17976,"_24513":47638,"_2467":47730},[],"First choice",{"_2944":1802,"_25897":1764,"_18081":47732,"_5":17976,"_24513":47638,"_2467":47733},[],"Second choice",{"_2944":1803,"_25897":1764,"_18081":47735,"_5":17976,"_24513":47638,"_2467":47736},[],"If neither is supplied",{"_2944":1804,"_25897":1764,"_18081":47738,"_5":17976,"_24513":47638,"_2467":47739},[],"Direct signing with a CA",{"_2944":1805,"_25897":1764,"_18081":47741,"_5":17976,"_24513":47638,"_2467":47742},[],"`issuance_profile` embedded in the request",{"_2944":1806,"_25897":1764,"_18081":47744,"_5":17976,"_24513":47638,"_2467":47745},[],"Request `issuance_profile_id`",{"_2944":1807,"_25897":1764,"_18081":47747,"_5":17976,"_24513":47638,"_2467":47748},[],"CA default profile (`profile_id`).",{"_2944":1808,"_25897":1764,"_18081":47750,"_5":17976,"_24513":47638,"_2467":47751},[],"Issuance through a DMS",{"_2944":1809,"_25897":1764,"_18081":47753,"_5":17976,"_24513":47638,"_2467":47754},[],"`settings.issuance_profile_id`",{"_2944":1810,"_25897":1764,"_18081":47756,"_5":17976,"_24513":47638,"_2467":47757},[],"`settings.issuance_profile` embedded in the DMS",{"_2944":1811,"_25897":1764,"_18081":47759,"_5":17976,"_24513":47638,"_2467":47760},[],"Enrollment CA default profile.",{"_2944":1812,"_25897":1764,"_18081":47762,"_5":17976,"_24513":47638,"_2467":47763},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2944":1813,"_25897":1764,"_18081":47765,"_5":17976,"_24513":47638,"_2467":47766},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2944":1814,"_25897":1764,"_18081":47768,"_5":17976,"_24513":47646,"_2467":47769},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2944":1815,"_25897":1764,"_18081":47771,"_5":17976,"_24513":47650,"_2467":47772},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2944":1816,"_25897":1764,"_18081":47774,"_5":17976,"_24513":47654,"_2467":47775},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2944":1817,"_25897":1764,"_18081":47777,"_5":17976,"_24513":47658,"_2467":47778},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2944":1818,"_25897":1764,"_18081":47780,"_5":17976,"_24513":47662,"_2467":47781},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2944":1819,"_25897":1764,"_18081":47783,"_5":17976,"_24513":47662,"_2467":47784},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2944":1820,"_25897":1764,"_18081":47786,"_5":17976,"_24513":47666,"_2467":47787},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2944":1821,"_25897":1764,"_18081":47789,"_5":17976,"_24513":47666,"_2467":47790},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2944":1822,"_25897":1764,"_18081":47792,"_5":17976,"_24513":47666,"_2467":47793},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2944":1823,"_25897":1764,"_18081":47795,"_5":17976,"_24513":47666,"_2467":47796},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2944":1824,"_25897":1764,"_18081":47798,"_5":17976,"_24513":47670,"_2467":47799},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2944":1825,"_25897":1764,"_18081":47801,"_5":17976,"_24513":47670,"_2467":47802},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2944":1826,"_25897":1826,"_5":12672,"_2467":47804,"_26242":47805,"_18081":47807,"_24513":1826},"Certificate validation",[42109,43496,47189,47806],"Validation",[],{"_2944":1827,"_25897":1826,"_18081":47809,"_5":17976,"_24513":1826,"_2467":47810},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2944":1828,"_25897":1826,"_5":26239,"_18081":47812,"_24513":47813,"_2467":47814},[],"/docs/pr-preview/pr-41/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2944":1829,"_25897":1826,"_5":26239,"_18081":47816,"_24513":47817,"_2467":47818},[],"/docs/pr-preview/pr-41/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2944":1830,"_25897":1826,"_5":26239,"_18081":47820,"_24513":47821,"_2467":47822},[],"/docs/pr-preview/pr-41/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2944":1831,"_25897":1826,"_18081":47824,"_5":17976,"_24513":1826,"_2467":47825},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2944":1832,"_25897":1826,"_18081":47827,"_5":17976,"_24513":47813,"_2467":47828},[],"Verify these criteria together:",{"_2944":1833,"_25897":1826,"_18081":47830,"_5":17976,"_24513":47813,"_2467":46813},[],{"_2944":1834,"_25897":1826,"_18081":47832,"_5":17976,"_24513":47813,"_2467":47833},[],"Required result",{"_2944":1835,"_25897":1826,"_18081":47835,"_5":17976,"_24513":47813,"_2467":47836},[],"Chain and signature",{"_2944":1836,"_25897":1826,"_18081":47838,"_5":17976,"_24513":47813,"_2467":47839},[],"Valid chain to a root deliberately installed in the consumer.",{"_2944":1837,"_25897":1826,"_18081":47841,"_5":17976,"_24513":47813,"_2467":47842},[],"Dates",{"_2944":1838,"_25897":1826,"_18081":47844,"_5":17976,"_24513":47813,"_2467":47845},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2944":1839,"_25897":1826,"_18081":47847,"_5":17976,"_24513":47813,"_2467":43196},[],{"_2944":1840,"_25897":1826,"_18081":47849,"_5":17976,"_24513":47813,"_2467":47850},[],"Name, SAN or identifier matches the expected peer.",{"_2944":1841,"_25897":1826,"_18081":47852,"_5":17976,"_24513":47813,"_2467":42496},[],{"_2944":1842,"_25897":1826,"_18081":47854,"_5":17976,"_24513":47813,"_2467":47855},[],"KU, EKU and constraints permit the specific operation.",{"_2944":1843,"_25897":1826,"_18081":47857,"_5":17976,"_24513":47813,"_2467":47858},[],"Revocation",{"_2944":1844,"_25897":1826,"_18081":47860,"_5":17976,"_24513":47813,"_2467":47861},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2944":1845,"_25897":1826,"_18081":47863,"_5":17976,"_24513":47813,"_2467":47864},[],"Authorization",{"_2944":1846,"_25897":1826,"_18081":47866,"_5":17976,"_24513":47813,"_2467":47867},[],"The application permits that identity to perform the action.",{"_2944":1847,"_25897":1826,"_18081":47869,"_5":17976,"_24513":47813,"_2467":47870},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2944":1848,"_25897":1826,"_18081":47872,"_5":17976,"_24513":47817,"_2467":47873},[],"Mechanism",{"_2944":1849,"_25897":1826,"_18081":47875,"_5":17976,"_24513":47817,"_2467":47876},[],"When to use it",{"_2944":1850,"_25897":1826,"_18081":47878,"_5":17976,"_24513":47817,"_2467":47879},[],"What you must maintain",{"_2944":1851,"_25897":1826,"_18081":47881,"_5":17976,"_24513":47817,"_2467":47882},[],"OCSP",{"_2944":1852,"_25897":1826,"_18081":47884,"_5":17976,"_24513":47817,"_2467":47885},[],"Status query for a specific certificate.",{"_2944":1853,"_25897":1826,"_18081":47887,"_5":17976,"_24513":47817,"_2467":47888},[],"Responder access, signature verification and cache/freshness policy.",{"_2944":1854,"_25897":1826,"_18081":47890,"_5":17976,"_24513":47817,"_2467":47891},[],"CRL",{"_2944":1855,"_25897":1826,"_18081":47893,"_5":17976,"_24513":47817,"_2467":47894},[],"Local checks for many certificates or offline operation.",{"_2944":1856,"_25897":1826,"_18081":47896,"_5":17976,"_24513":47817,"_2467":47897},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2944":1857,"_25897":1826,"_18081":47899,"_5":17976,"_24513":47817,"_2467":47900},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2944":1858,"_25897":1826,"_18081":47902,"_5":17976,"_24513":47817,"_2467":47903},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2944":1859,"_25897":1826,"_18081":47905,"_5":17976,"_24513":47821,"_2467":47906},[],"Accept a current, authorized certificate with a known chain.",{"_2944":1860,"_25897":1826,"_18081":47908,"_5":17976,"_24513":47821,"_2467":47909},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2944":1861,"_25897":1826,"_18081":47911,"_5":17976,"_24513":47821,"_2467":47912},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2944":1862,"_25897":1826,"_18081":47914,"_5":17976,"_24513":47821,"_2467":47915},[],"Check that a new connection with that identity is rejected.",{"_2944":1863,"_25897":1826,"_18081":47917,"_5":17976,"_24513":47821,"_2467":47918},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2944":1864,"_25897":1826,"_18081":47920,"_5":17976,"_24513":47821,"_2467":47921},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2944":1865,"_25897":1826,"_18081":47923,"_5":17976,"_24513":47821,"_2467":47924},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2944":1866,"_25897":1826,"_18081":47926,"_5":17976,"_24513":47821,"_2467":47927},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2944":1867,"_25897":1826,"_18081":47929,"_5":17976,"_24513":47821,"_2467":47930},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2944":1868,"_25897":1868,"_5":12672,"_2467":47932,"_26242":47933,"_18081":47934,"_24513":1868},"Certificates",[42109,43496,47189,47190],[],{"_2944":1869,"_25897":1868,"_18081":47936,"_5":17976,"_24513":1868,"_2467":47937},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2944":1870,"_25897":1868,"_5":26239,"_18081":47939,"_24513":47940,"_2467":47941},[],"/docs/pr-preview/pr-41/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2944":1871,"_25897":1868,"_5":26239,"_18081":47943,"_24513":47944,"_2467":47945},[],"/docs/pr-preview/pr-41/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2944":1872,"_25897":1868,"_5":26239,"_18081":47947,"_24513":47948,"_2467":47949},[],"/docs/pr-preview/pr-41/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2944":1873,"_25897":1868,"_5":26239,"_18081":47951,"_24513":47952,"_2467":47953},[],"/docs/pr-preview/pr-41/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2944":1874,"_25897":1868,"_5":26239,"_18081":47955,"_24513":47956,"_2467":47957},[],"/docs/pr-preview/pr-41/platform/pki/certificates#open-the-action","Open the action",{"_2944":1875,"_25897":1868,"_5":26239,"_18081":47959,"_24513":47960,"_2467":47961},[],"/docs/pr-preview/pr-41/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2944":1876,"_25897":1868,"_5":26239,"_18081":47963,"_24513":47964,"_2467":47965},[],"/docs/pr-preview/pr-41/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2944":1877,"_25897":1868,"_5":26239,"_18081":47967,"_24513":47968,"_2467":47969},[],"/docs/pr-preview/pr-41/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2944":1878,"_25897":1868,"_5":26239,"_18081":47971,"_24513":47972,"_2467":47973},[],"/docs/pr-preview/pr-41/platform/pki/certificates#continue","Continue",{"_2944":1879,"_25897":1868,"_18081":47975,"_5":17976,"_24513":1868,"_2467":47976},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2944":1880,"_25897":1868,"_18081":47978,"_5":17976,"_24513":47940,"_2467":47979},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2944":1881,"_25897":1868,"_18081":47981,"_5":17976,"_24513":47940,"_2467":47982},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2944":1882,"_25897":1868,"_18081":47984,"_5":17976,"_24513":47944,"_2467":47985},[],"Download the PEM and inspect it:",{"_2944":1883,"_25897":1868,"_18081":47987,"_5":17976,"_24513":47944,"_2467":47988},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2944":1884,"_25897":1868,"_18081":47990,"_5":17976,"_24513":47948,"_2467":47991},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2944":1885,"_25897":1868,"_18081":47993,"_5":17976,"_24513":47948,"_2467":47994},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2944":1886,"_25897":1868,"_18081":47996,"_5":17976,"_24513":47948,"_2467":47997},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2944":1887,"_25897":1868,"_18081":47999,"_5":17976,"_24513":47948,"_2467":48000},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2944":1888,"_25897":1868,"_18081":48002,"_5":17976,"_24513":47948,"_2467":48003},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2944":1889,"_25897":1868,"_18081":48005,"_5":17976,"_24513":47948,"_2467":48006},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2944":1890,"_25897":1868,"_18081":48008,"_5":17976,"_24513":47948,"_2467":48009},[],"For browser key generation, follow Issue your first certificate.",{"_2944":1891,"_25897":1868,"_18081":48011,"_5":17976,"_24513":47952,"_2467":48012},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2944":1892,"_25897":1868,"_18081":48014,"_5":17976,"_24513":47956,"_2467":48015},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2944":1893,"_25897":1868,"_18081":48017,"_5":17976,"_24513":47960,"_2467":48018},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2944":1894,"_25897":1868,"_18081":48020,"_5":17976,"_24513":47964,"_2467":48021},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2944":1895,"_25897":1868,"_18081":48023,"_5":17976,"_24513":47964,"_2467":48024},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2944":1896,"_25897":1868,"_18081":48026,"_5":17976,"_24513":47964,"_2467":48027},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2944":1897,"_25897":1868,"_18081":48029,"_5":17976,"_24513":47968,"_2467":48030},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2944":1898,"_25897":1868,"_18081":48032,"_5":17976,"_24513":47968,"_2467":48033},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2944":1899,"_25897":1868,"_18081":48035,"_5":17976,"_24513":47968,"_2467":48036},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2944":1900,"_25897":1868,"_18081":48038,"_5":17976,"_24513":47972,"_2467":48039},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2944":1901,"_25897":1868,"_18081":48041,"_5":17976,"_24513":47972,"_2467":48042},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2944":1902,"_25897":1902,"_5":12672,"_2467":48044,"_26242":48045,"_18081":48047,"_24513":1902},"Certificate lifecycle",[42109,43496,47189,48046],"Concepts",[],{"_2944":1903,"_25897":1902,"_18081":48049,"_5":17976,"_24513":1902,"_2467":48050},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2944":1904,"_25897":1902,"_5":26239,"_18081":48052,"_24513":48053,"_2467":48054},[],"/docs/pr-preview/pr-41/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2944":1905,"_25897":1902,"_5":26239,"_18081":48056,"_24513":48057,"_2467":48058},[],"/docs/pr-preview/pr-41/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2944":1906,"_25897":1902,"_5":26239,"_18081":48060,"_24513":48061,"_2467":48062},[],"/docs/pr-preview/pr-41/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2944":1907,"_25897":1902,"_5":26239,"_18081":48064,"_24513":48065,"_2467":48066},[],"/docs/pr-preview/pr-41/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2944":1908,"_25897":1902,"_5":26239,"_18081":48068,"_24513":48069,"_2467":48070},[],"/docs/pr-preview/pr-41/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2944":1909,"_25897":1902,"_5":26239,"_18081":48072,"_24513":48073,"_2467":48074},[],"/docs/pr-preview/pr-41/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2944":1910,"_25897":1902,"_5":26239,"_18081":48076,"_24513":48077,"_2467":48078},[],"/docs/pr-preview/pr-41/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2944":1911,"_25897":1902,"_5":26239,"_18081":48080,"_24513":48081,"_2467":48082},[],"/docs/pr-preview/pr-41/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2944":1912,"_25897":1902,"_5":26239,"_18081":48084,"_24513":48085,"_2467":48086},[],"/docs/pr-preview/pr-41/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2944":1913,"_25897":1902,"_5":26239,"_18081":48088,"_24513":48089,"_2467":48090},[],"/docs/pr-preview/pr-41/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2944":1914,"_25897":1902,"_18081":48092,"_5":17976,"_24513":1902,"_2467":48093},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2944":1915,"_25897":1902,"_18081":48095,"_5":17976,"_24513":48057,"_2467":48096},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2944":1916,"_25897":1902,"_18081":48098,"_5":17976,"_24513":48061,"_2467":48099},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2944":1917,"_25897":1902,"_18081":48101,"_5":17976,"_24513":48065,"_2467":48102},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2944":1918,"_25897":1902,"_18081":48104,"_5":17976,"_24513":48069,"_2467":48105},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2944":1919,"_25897":1902,"_18081":48107,"_5":17976,"_24513":48073,"_2467":48108},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2944":1920,"_25897":1902,"_18081":48110,"_5":17976,"_24513":48077,"_2467":48111},[],"Lamassu persists four X.509 states:",{"_2944":1921,"_25897":1902,"_18081":48113,"_5":17976,"_24513":48077,"_2467":48114},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2944":1922,"_25897":1902,"_18081":48116,"_5":17976,"_24513":48077,"_2467":48117},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2944":1923,"_25897":1902,"_18081":48119,"_5":17976,"_24513":48077,"_2467":48120},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2944":1924,"_25897":1902,"_18081":48122,"_5":17976,"_24513":48077,"_2467":48123},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2944":1925,"_25897":1902,"_18081":48125,"_5":17976,"_24513":48077,"_2467":48126},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2944":1926,"_25897":1902,"_18081":48128,"_5":17976,"_24513":48081,"_2467":48129},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2944":1927,"_25897":1902,"_18081":48131,"_5":17976,"_24513":48081,"_2467":48132},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2944":1928,"_25897":1902,"_18081":48134,"_5":17976,"_24513":48081,"_2467":48135},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2944":1929,"_25897":1902,"_18081":48137,"_5":17976,"_24513":48085,"_2467":48138},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2944":1930,"_25897":1902,"_18081":48140,"_5":17976,"_24513":48085,"_2467":48141},[],"Before confirming:",{"_2944":1931,"_25897":1902,"_18081":48143,"_5":17976,"_24513":48085,"_2467":48144},[],"Identify DMSs, devices and services that trust that chain.",{"_2944":1932,"_25897":1902,"_18081":48146,"_5":17976,"_24513":48085,"_2467":48147},[],"Distribute the new chain of trust.",{"_2944":1933,"_25897":1902,"_18081":48149,"_5":17976,"_24513":48085,"_2467":48150},[],"Reissue the necessary identities.",{"_2944":1934,"_25897":1902,"_18081":48152,"_5":17976,"_24513":48085,"_2467":48153},[],"Check OCSP and CRL from a real consumer.",{"_2944":1935,"_25897":1902,"_18081":48155,"_5":17976,"_24513":48085,"_2467":48156},[],"Revoke the old CA once no legitimate traffic remains.",{"_2944":1936,"_25897":1902,"_18081":48158,"_5":17976,"_24513":48085,"_2467":48159},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2944":1937,"_25897":1902,"_18081":48161,"_5":17976,"_24513":48089,"_2467":48162},[],"Certificates entering the preventive or critical renewal window.",{"_2944":1938,"_25897":1902,"_18081":48164,"_5":17976,"_24513":48089,"_2467":48165},[],"Repeated enrollment or re-enrollment failures.",{"_2944":1939,"_25897":1902,"_18081":48167,"_5":17976,"_24513":48089,"_2467":48168},[],"Status changes and revocation reasons.",{"_2944":1940,"_25897":1902,"_18081":48170,"_5":17976,"_24513":48089,"_2467":48171},[],"OCSP and CRL publication and validity.",{"_2944":1941,"_25897":1902,"_18081":48173,"_5":17976,"_24513":48089,"_2467":48174},[],"Dependencies still presenting a replaced certificate.",{"_2944":1942,"_25897":1902,"_18081":48176,"_5":17976,"_24513":48089,"_2467":48177},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2944":1943,"_25897":1943,"_5":12672,"_2467":48179,"_26242":48180,"_18081":48181,"_24513":1943},"Trust model",[42109,43496,47189,48046],[],{"_2944":1944,"_25897":1943,"_18081":48183,"_5":17976,"_24513":1943,"_2467":48184},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2944":1945,"_25897":1943,"_5":26239,"_18081":48186,"_24513":48187,"_2467":48188},[],"/docs/pr-preview/pr-41/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2944":1946,"_25897":1943,"_5":26239,"_18081":48190,"_24513":48191,"_2467":48192},[],"/docs/pr-preview/pr-41/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2944":1947,"_25897":1943,"_5":26239,"_18081":48194,"_24513":48195,"_2467":48196},[],"/docs/pr-preview/pr-41/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2944":1948,"_25897":1943,"_5":26239,"_18081":48198,"_24513":48199,"_2467":48200},[],"/docs/pr-preview/pr-41/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2944":1949,"_25897":1943,"_5":26239,"_18081":48202,"_24513":48203,"_2467":48204},[],"/docs/pr-preview/pr-41/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2944":1950,"_25897":1943,"_5":26239,"_18081":48206,"_24513":48207,"_2467":48208},[],"/docs/pr-preview/pr-41/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2944":1951,"_25897":1943,"_5":26239,"_18081":48210,"_24513":48211,"_2467":48212},[],"/docs/pr-preview/pr-41/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2944":1952,"_25897":1943,"_5":26239,"_18081":48214,"_24513":48215,"_2467":48216},[],"/docs/pr-preview/pr-41/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2944":1953,"_25897":1943,"_5":26239,"_18081":48218,"_24513":48219,"_2467":48220},[],"/docs/pr-preview/pr-41/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2944":1954,"_25897":1943,"_5":26239,"_18081":48222,"_24513":48223,"_2467":48224},[],"/docs/pr-preview/pr-41/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2944":1955,"_25897":1943,"_18081":48226,"_5":17976,"_24513":1943,"_2467":48227},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2944":1956,"_25897":1943,"_18081":48229,"_5":17976,"_24513":48191,"_2467":48230},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2944":1957,"_25897":1943,"_18081":48232,"_5":17976,"_24513":48195,"_2467":48233},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2944":1958,"_25897":1943,"_18081":48235,"_5":17976,"_24513":48199,"_2467":48236},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2944":1959,"_25897":1943,"_18081":48238,"_5":17976,"_24513":48203,"_2467":48239},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2944":1960,"_25897":1943,"_18081":48241,"_5":17976,"_24513":48207,"_2467":48242},[],"The device proves it can enroll according to the DMS policy.",{"_2944":1961,"_25897":1943,"_18081":48244,"_5":17976,"_24513":48207,"_2467":48245},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2944":1962,"_25897":1943,"_18081":48247,"_5":17976,"_24513":48207,"_2467":48248},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2944":1963,"_25897":1943,"_18081":48250,"_5":17976,"_24513":48207,"_2467":48251},[],"The device installs the certificate and the chain it needs.",{"_2944":1964,"_25897":1943,"_18081":48253,"_5":17976,"_24513":48207,"_2467":48254},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2944":1965,"_25897":1943,"_18081":48256,"_5":17976,"_24513":48207,"_2467":48257},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2944":1966,"_25897":1943,"_18081":48259,"_5":17976,"_24513":48211,"_2467":48260},[],"A DMS relates three sets that are worth designing separately:",{"_2944":1967,"_25897":1943,"_18081":48262,"_5":17976,"_24513":48211,"_2467":48263},[],"**Enrollment CA:** signs the new identities.",{"_2944":1968,"_25897":1943,"_18081":48265,"_5":17976,"_24513":48211,"_2467":48266},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the validation CAs configured in the re-enrollment block.",{"_2944":1969,"_25897":1943,"_18081":48268,"_5":17976,"_24513":48211,"_2467":48269},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2944":1970,"_25897":1943,"_18081":48271,"_5":17976,"_24513":48211,"_2467":48272},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2944":1971,"_25897":1943,"_18081":48274,"_5":17976,"_24513":48215,"_2467":48275},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2944":1972,"_25897":1943,"_18081":48277,"_5":17976,"_24513":48215,"_2467":48278},[],"that the current date is between `Not Before` and `Not After`;",{"_2944":1973,"_25897":1943,"_18081":48280,"_5":17976,"_24513":48215,"_2467":48281},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2944":1974,"_25897":1943,"_18081":48283,"_5":17976,"_24513":48215,"_2467":48284},[],"that names, SANs and subject match the expected identity;",{"_2944":1975,"_25897":1943,"_18081":48286,"_5":17976,"_24513":48215,"_2467":48287},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2944":1976,"_25897":1943,"_18081":48289,"_5":17976,"_24513":48215,"_2467":48290},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2944":1977,"_25897":1943,"_18081":48292,"_5":17976,"_24513":48215,"_2467":48293},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2944":1978,"_25897":1943,"_18081":48295,"_5":17976,"_24513":48219,"_2467":48296},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2944":1979,"_25897":1943,"_18081":48298,"_5":17976,"_24513":48223,"_2467":48299},[],"Keep the root out of daily operations, or with very restricted access.",{"_2944":1980,"_25897":1943,"_18081":48301,"_5":17976,"_24513":48223,"_2467":48302},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2944":1981,"_25897":1943,"_18081":48304,"_5":17976,"_24513":48223,"_2467":48305},[],"Assign explicit profiles to every use case.",{"_2944":1982,"_25897":1943,"_18081":48307,"_5":17976,"_24513":48223,"_2467":48308},[],"Distribute the new trust before starting a rotation.",{"_2944":1983,"_25897":1943,"_18081":48310,"_5":17976,"_24513":48223,"_2467":48311},[],"Keep enough overlap to renew a disconnected fleet.",{"_2944":1984,"_25897":1943,"_18081":48313,"_5":17976,"_24513":48223,"_2467":48314},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2944":1985,"_25897":1943,"_18081":48316,"_5":17976,"_24513":48223,"_2467":48317},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2944":1986,"_25897":1986,"_5":12672,"_2467":48319,"_26242":48320,"_18081":48321,"_24513":1986},"Revocation lists (CRL)",[42109,43496,47189,47806],[],{"_2944":1987,"_25897":1986,"_18081":48323,"_5":17976,"_24513":1986,"_2467":48324},[],"Generate and distribute signed lists to validate certificates offline.",{"_2944":1988,"_25897":1986,"_5":26239,"_18081":48326,"_24513":48327,"_2467":48328},[],"/docs/pr-preview/pr-41/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2944":1989,"_25897":1986,"_5":26239,"_18081":48330,"_24513":48331,"_2467":48332},[],"/docs/pr-preview/pr-41/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2944":1990,"_25897":1986,"_5":26239,"_18081":48334,"_24513":48335,"_2467":48336},[],"/docs/pr-preview/pr-41/platform/pki/crl#crl-contents","CRL contents",{"_2944":1991,"_25897":1986,"_5":26239,"_18081":48338,"_24513":48339,"_2467":48340},[],"/docs/pr-preview/pr-41/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2944":1992,"_25897":1986,"_5":26239,"_18081":48342,"_24513":48343,"_2467":48344},[],"/docs/pr-preview/pr-41/platform/pki/crl#va-role-management-api","VA role management API",{"_2944":1993,"_25897":1986,"_5":26239,"_18081":48346,"_24513":48347,"_2467":48348},[],"/docs/pr-preview/pr-41/platform/pki/crl#from-the-interface","From the interface",{"_2944":1994,"_25897":1986,"_5":26239,"_18081":48350,"_24513":48351,"_2467":48352},[],"/docs/pr-preview/pr-41/platform/pki/crl#references","References",{"_2944":1995,"_25897":1986,"_18081":48354,"_5":17976,"_24513":1986,"_2467":48355},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2944":1996,"_25897":1986,"_18081":48357,"_5":17976,"_24513":48327,"_2467":48358},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2944":1997,"_25897":1986,"_18081":48360,"_5":17976,"_24513":48327,"_2467":48361},[],"`crl_options` field",{"_2944":1998,"_25897":1986,"_18081":48363,"_5":17976,"_24513":48327,"_2467":42496},[],{"_2944":1999,"_25897":1986,"_18081":48365,"_5":17976,"_24513":48327,"_2467":48366},[],"Backend initial value",{"_2944":2000,"_25897":1986,"_18081":48368,"_5":17976,"_24513":48327,"_2467":48369},[],"`validity`",{"_2944":2001,"_25897":1986,"_18081":48371,"_5":17976,"_24513":48327,"_2467":48372},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2944":2002,"_25897":1986,"_18081":48374,"_5":17976,"_24513":48327,"_2467":48375},[],"7 days.",{"_2944":2003,"_25897":1986,"_18081":48377,"_5":17976,"_24513":48327,"_2467":48378},[],"`refresh_interval`",{"_2944":2004,"_25897":1986,"_18081":48380,"_5":17976,"_24513":48327,"_2467":48381},[],"Time since publication that triggers scheduled renewal.",{"_2944":2005,"_25897":1986,"_18081":48383,"_5":17976,"_24513":48327,"_2467":48384},[],"6 days and 23 hours.",{"_2944":2006,"_25897":1986,"_18081":48386,"_5":17976,"_24513":48327,"_2467":48387},[],"`regenerate_on_revoke`",{"_2944":2007,"_25897":1986,"_18081":48389,"_5":17976,"_24513":48327,"_2467":48390},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2944":2008,"_25897":1986,"_18081":48392,"_5":17976,"_24513":48327,"_2467":48393},[],"`true`.",{"_2944":2009,"_25897":1986,"_18081":48395,"_5":17976,"_24513":48327,"_2467":48396},[],"`subject_key_id_signer`",{"_2944":2010,"_25897":1986,"_18081":48398,"_5":17976,"_24513":48327,"_2467":48399},[],"Configuration field initialized with the CA’s SKI.",{"_2944":2011,"_25897":1986,"_18081":48401,"_5":17976,"_24513":48327,"_2467":48402},[],"CA SKI.",{"_2944":2012,"_25897":1986,"_18081":48404,"_5":17976,"_24513":48327,"_2467":48405},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2944":2013,"_25897":1986,"_18081":48407,"_5":17976,"_24513":48327,"_2467":48408},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2944":2014,"_25897":1986,"_18081":48410,"_5":17976,"_24513":48331,"_2467":48411},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2944":2015,"_25897":1986,"_18081":48413,"_5":17976,"_24513":48331,"_2467":48414},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2944":2016,"_25897":1986,"_18081":48416,"_5":17976,"_24513":48331,"_2467":48417},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2944":2017,"_25897":1986,"_18081":48419,"_5":17976,"_24513":48335,"_2467":48420},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2944":2018,"_25897":1986,"_18081":48422,"_5":17976,"_24513":48335,"_2467":48423},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2944":2019,"_25897":1986,"_18081":48425,"_5":17976,"_24513":48339,"_2467":48426},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2944":2020,"_25897":1986,"_18081":48428,"_5":17976,"_24513":48339,"_2467":48429},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2944":2021,"_25897":1986,"_18081":48431,"_5":17976,"_24513":48339,"_2467":48432},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2944":2022,"_25897":1986,"_18081":48434,"_5":17976,"_24513":48339,"_2467":48435},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2944":2023,"_25897":1986,"_18081":48437,"_5":17976,"_24513":48339,"_2467":48438},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2944":2024,"_25897":1986,"_18081":48440,"_5":17976,"_24513":48343,"_2467":48441},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2944":2025,"_25897":1986,"_18081":48443,"_5":17976,"_24513":48343,"_2467":45220},[],{"_2944":2026,"_25897":1986,"_18081":48445,"_5":17976,"_24513":48343,"_2467":48446},[],"Relative path",{"_2944":2027,"_25897":1986,"_18081":48448,"_5":17976,"_24513":48343,"_2467":45217},[],{"_2944":2028,"_25897":1986,"_18081":48450,"_5":17976,"_24513":48343,"_2467":48451},[],"`GET`",{"_2944":2029,"_25897":1986,"_18081":48453,"_5":17976,"_24513":48343,"_2467":48454},[],"`/v1/roles/{ca-ski}`",{"_2944":2030,"_25897":1986,"_18081":48456,"_5":17976,"_24513":48343,"_2467":48457},[],"Read `crl_options` and `latest_crl`.",{"_2944":2031,"_25897":1986,"_18081":48459,"_5":17976,"_24513":48343,"_2467":48460},[],"`PUT`",{"_2944":2032,"_25897":1986,"_18081":48462,"_5":17976,"_24513":48343,"_2467":48454},[],{"_2944":2033,"_25897":1986,"_18081":48464,"_5":17976,"_24513":48343,"_2467":48465},[],"Replace CRL configuration.",{"_2944":2034,"_25897":1986,"_18081":48467,"_5":17976,"_24513":48343,"_2467":48468},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2944":2035,"_25897":1986,"_18081":48470,"_5":17976,"_24513":48343,"_2467":48471},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2944":2036,"_25897":1986,"_18081":48473,"_5":17976,"_24513":48347,"_2467":48474},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2944":2037,"_25897":1986,"_18081":48476,"_5":17976,"_24513":48351,"_2467":48477},[],"RFC 5280: X.509 and CRL profile.",{"_2944":2038,"_25897":1986,"_18081":48479,"_5":17976,"_24513":48351,"_2467":48480},[],"OpenSSL: openssl-crl.",{"_2944":2039,"_25897":1986,"_18081":48482,"_5":17976,"_24513":48351,"_2467":48483},[],"OpenSSL: openssl-verify.",{"_2944":2040,"_25897":1986,"_18081":48485,"_5":17976,"_24513":48351,"_2467":48486},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2944":2041,"_25897":1986,"_18081":48488,"_5":17976,"_24513":48351,"_2467":48489},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2944":2042,"_25897":2042,"_5":12672,"_2467":48491,"_26242":48492,"_18081":48493,"_24513":2042},"Keys and cryptographic engines",[42109,43496,47189,47190],[],{"_2944":2043,"_25897":2042,"_18081":48495,"_5":17976,"_24513":2042,"_2467":48496},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2944":2044,"_25897":2042,"_5":26239,"_18081":48498,"_24513":48499,"_2467":48500},[],"/docs/pr-preview/pr-41/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2944":2045,"_25897":2042,"_5":26239,"_18081":48502,"_24513":48503,"_2467":48504},[],"/docs/pr-preview/pr-41/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2944":2046,"_25897":2042,"_5":26239,"_18081":48506,"_24513":48507,"_2467":48508},[],"/docs/pr-preview/pr-41/platform/pki/key-management#file-system","File System",{"_2944":2047,"_25897":2042,"_5":26239,"_18081":48510,"_24513":48511,"_2467":48512},[],"/docs/pr-preview/pr-41/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2944":2048,"_25897":2042,"_5":26239,"_18081":48514,"_24513":48515,"_2467":48516},[],"/docs/pr-preview/pr-41/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2944":2049,"_25897":2042,"_5":26239,"_18081":48518,"_24513":48519,"_2467":48520},[],"/docs/pr-preview/pr-41/platform/pki/key-management#aws-kms","AWS KMS",{"_2944":2050,"_25897":2042,"_5":26239,"_18081":48522,"_24513":48523,"_2467":48524},[],"/docs/pr-preview/pr-41/platform/pki/key-management#pkcs11","PKCS#11",{"_2944":2051,"_25897":2042,"_5":26239,"_18081":48526,"_24513":48527,"_2467":48528},[],"/docs/pr-preview/pr-41/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2944":2052,"_25897":2042,"_5":26239,"_18081":48530,"_24513":48531,"_2467":48532},[],"/docs/pr-preview/pr-41/platform/pki/key-management#key-inventory","Key inventory",{"_2944":2053,"_25897":2042,"_5":26239,"_18081":48534,"_24513":48535,"_2467":48536},[],"/docs/pr-preview/pr-41/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2944":2054,"_25897":2042,"_5":26239,"_18081":48538,"_24513":48539,"_2467":48540},[],"/docs/pr-preview/pr-41/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2944":2055,"_25897":2042,"_5":26239,"_18081":48542,"_24513":48543,"_2467":48544},[],"/docs/pr-preview/pr-41/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2944":2056,"_25897":2042,"_5":26239,"_18081":48546,"_24513":48547,"_2467":48548},[],"/docs/pr-preview/pr-41/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2944":2057,"_25897":2042,"_5":26239,"_18081":48550,"_24513":48551,"_2467":48552},[],"/docs/pr-preview/pr-41/platform/pki/key-management#view-details","View details",{"_2944":2058,"_25897":2042,"_5":26239,"_18081":48554,"_24513":48555,"_2467":48556},[],"/docs/pr-preview/pr-41/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2944":2059,"_25897":2042,"_5":26239,"_18081":48558,"_24513":48559,"_2467":48560},[],"/docs/pr-preview/pr-41/platform/pki/key-management#sign","Sign",{"_2944":2060,"_25897":2042,"_5":26239,"_18081":48562,"_24513":48563,"_2467":48564},[],"/docs/pr-preview/pr-41/platform/pki/key-management#verify","Verify",{"_2944":2061,"_25897":2042,"_5":26239,"_18081":48566,"_24513":48567,"_2467":48568},[],"/docs/pr-preview/pr-41/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2944":2062,"_25897":2042,"_5":26239,"_18081":48570,"_24513":48571,"_2467":48572},[],"/docs/pr-preview/pr-41/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2944":2063,"_25897":2042,"_5":26239,"_18081":48574,"_24513":48575,"_2467":48576},[],"/docs/pr-preview/pr-41/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2944":2064,"_25897":2042,"_18081":48578,"_5":17976,"_24513":2042,"_2467":48579},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2944":2065,"_25897":2042,"_18081":48581,"_5":17976,"_24513":2042,"_2467":48582},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2944":2066,"_25897":2042,"_18081":48584,"_5":17976,"_24513":48499,"_2467":48585},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2944":2067,"_25897":2042,"_18081":48587,"_5":17976,"_24513":48499,"_2467":48588},[],"In practice, it lets you:",{"_2944":2068,"_25897":2042,"_18081":48590,"_5":17976,"_24513":48499,"_2467":48591},[],"Generate new key pairs from Lamassu IoT.",{"_2944":2069,"_25897":2042,"_18081":48593,"_5":17976,"_24513":48499,"_2467":48594},[],"Import keys created externally.",{"_2944":2070,"_25897":2042,"_18081":48596,"_5":17976,"_24513":48499,"_2467":48597},[],"Delegate custody and cryptographic operations to external engines.",{"_2944":2071,"_25897":2042,"_18081":48599,"_5":17976,"_24513":48499,"_2467":48600},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2944":2072,"_25897":2042,"_18081":48602,"_5":17976,"_24513":48503,"_2467":48603},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2944":2073,"_25897":2042,"_18081":48605,"_5":17976,"_24513":48503,"_2467":48606},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2944":2074,"_25897":2042,"_18081":48608,"_5":17976,"_24513":48503,"_2467":48609},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2944":2075,"_25897":2042,"_18081":48611,"_5":17976,"_24513":48507,"_2467":48612},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2944":2076,"_25897":2042,"_18081":48614,"_5":17976,"_24513":48511,"_2467":48615},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2944":2077,"_25897":2042,"_18081":48617,"_5":17976,"_24513":48511,"_2467":48618},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_2944":2078,"_25897":2042,"_18081":48620,"_5":17976,"_24513":48515,"_2467":48621},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2944":2079,"_25897":2042,"_18081":48623,"_5":17976,"_24513":48519,"_2467":48624},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2944":2080,"_25897":2042,"_18081":48626,"_5":17976,"_24513":48523,"_2467":48627},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2944":2081,"_25897":2042,"_18081":48629,"_5":17976,"_24513":48527,"_2467":48630},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2944":2082,"_25897":2042,"_18081":48632,"_5":17976,"_24513":48527,"_2467":48633},[],"Lamassu shows the enabled engines in the console.",{"_2944":2083,"_25897":2042,"_18081":48635,"_5":17976,"_24513":48527,"_2467":48636},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2944":2084,"_25897":2042,"_18081":48638,"_5":17976,"_24513":48527,"_2467":48639},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2944":2085,"_25897":2042,"_18081":48641,"_5":17976,"_24513":48531,"_2467":48642},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2944":2086,"_25897":2042,"_18081":48644,"_5":17976,"_24513":48531,"_2467":48645},[],"The table includes the following fields:",{"_2944":2087,"_25897":2042,"_18081":48647,"_5":17976,"_24513":48531,"_2467":48648},[],"**Name**: descriptive name of the key.",{"_2944":2088,"_25897":2042,"_18081":48650,"_5":17976,"_24513":48531,"_2467":48651},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2944":2089,"_25897":2042,"_18081":48653,"_5":17976,"_24513":48531,"_2467":48654},[],"**Strength**: visual indicator of cryptographic strength.",{"_2944":2090,"_25897":2042,"_18081":48656,"_5":17976,"_24513":48531,"_2467":48657},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2944":2091,"_25897":2042,"_18081":48659,"_5":17976,"_24513":48531,"_2467":48660},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2944":2092,"_25897":2042,"_18081":48662,"_5":17976,"_24513":48531,"_2467":48663},[],"**Aliases**: alternative names associated with the key.",{"_2944":2093,"_25897":2042,"_18081":48665,"_5":17976,"_24513":48531,"_2467":48666},[],"**Tags**: labels for classification and search.",{"_2944":2094,"_25897":2042,"_18081":48668,"_5":17976,"_24513":48531,"_2467":48669},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2944":2095,"_25897":2042,"_18081":48671,"_5":17976,"_24513":48531,"_2467":48672},[],"From this view you also reach the most common actions:",{"_2944":2096,"_25897":2042,"_18081":48674,"_5":17976,"_24513":48531,"_2467":48675},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2944":2097,"_25897":2042,"_18081":48677,"_5":17976,"_24513":48531,"_2467":48678},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2944":2098,"_25897":2042,"_18081":48680,"_5":17976,"_24513":48531,"_2467":48681},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2944":2099,"_25897":2042,"_18081":48683,"_5":17976,"_24513":48531,"_2467":48684},[],"**Delete Key** to remove the key from the system.",{"_2944":2100,"_25897":2042,"_18081":48686,"_5":17976,"_24513":48535,"_2467":48687},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2944":2101,"_25897":2042,"_18081":48689,"_5":17976,"_24513":48539,"_2467":48690},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2944":2102,"_25897":2042,"_18081":48692,"_5":17976,"_24513":48539,"_2467":48693},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2944":2103,"_25897":2042,"_18081":48695,"_5":17976,"_24513":48539,"_2467":48696},[],"**Key Name**: unique and descriptive name.",{"_2944":2104,"_25897":2042,"_18081":48698,"_5":17976,"_24513":48539,"_2467":48699},[],"**Crypto Engine**: engine that will keep the key.",{"_2944":2105,"_25897":2042,"_18081":48701,"_5":17976,"_24513":48539,"_2467":48702},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2944":2106,"_25897":2042,"_18081":48704,"_5":17976,"_24513":48539,"_2467":48705},[],"**Tags**: metadata to classify the key.",{"_2944":2107,"_25897":2042,"_18081":48707,"_5":17976,"_24513":48539,"_2467":48708},[],"**Metadata**: additional information for advanced uses.",{"_2944":2108,"_25897":2042,"_18081":48710,"_5":17976,"_24513":48543,"_2467":48711},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2944":2109,"_25897":2042,"_18081":48713,"_5":17976,"_24513":48543,"_2467":48714},[],"When you have an exportable private key and the destination engine supports import.",{"_2944":2110,"_25897":2042,"_18081":48716,"_5":17976,"_24513":48543,"_2467":48717},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2944":2111,"_25897":2042,"_18081":48719,"_5":17976,"_24513":48543,"_2467":48720},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2944":2112,"_25897":2042,"_18081":48722,"_5":17976,"_24513":48543,"_2467":48723},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2944":2113,"_25897":2042,"_18081":48725,"_5":17976,"_24513":48543,"_2467":48726},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2944":2114,"_25897":2042,"_18081":48728,"_5":17976,"_24513":48543,"_2467":48729},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2944":2115,"_25897":2042,"_18081":48731,"_5":17976,"_24513":48543,"_2467":48732},[],"**Tags**: labels for organization and search.",{"_2944":2116,"_25897":2042,"_18081":48734,"_5":17976,"_24513":48543,"_2467":48735},[],"**Metadata**: additional optional information.",{"_2944":2117,"_25897":2042,"_18081":48737,"_5":17976,"_24513":48543,"_2467":48738},[],"**Private Key (PEM)**: private key in PEM format.",{"_2944":2118,"_25897":2042,"_18081":48740,"_5":17976,"_24513":48543,"_2467":48741},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2944":2119,"_25897":2042,"_18081":48743,"_5":17976,"_24513":48547,"_2467":48744},[],"Each registered key has a detail view and several operational actions.",{"_2944":2120,"_25897":2042,"_18081":48746,"_5":17976,"_24513":48551,"_2467":48747},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2944":2121,"_25897":2042,"_18081":48749,"_5":17976,"_24513":48551,"_2467":48750},[],"The **Overview** tab shows, among others, these fields:",{"_2944":2122,"_25897":2042,"_18081":48752,"_5":17976,"_24513":48551,"_2467":48753},[],"**Key Name**: descriptive name.",{"_2944":2123,"_25897":2042,"_18081":48755,"_5":17976,"_24513":48551,"_2467":48756},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2944":2124,"_25897":2042,"_18081":48758,"_5":17976,"_24513":48551,"_2467":48759},[],"**Tags**: associated labels.",{"_2944":2125,"_25897":2042,"_18081":48761,"_5":17976,"_24513":48551,"_2467":48762},[],"**Aliases**: alternative names.",{"_2944":2126,"_25897":2042,"_18081":48764,"_5":17976,"_24513":48551,"_2467":48765},[],"**Crypto Engine**: engine where the key resides.",{"_2944":2127,"_25897":2042,"_18081":48767,"_5":17976,"_24513":48551,"_2467":48768},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2944":2128,"_25897":2042,"_18081":48770,"_5":17976,"_24513":48551,"_2467":48771},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2944":2129,"_25897":2042,"_18081":48773,"_5":17976,"_24513":48551,"_2467":48774},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2944":2130,"_25897":2042,"_18081":48776,"_5":17976,"_24513":48555,"_2467":48777},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2944":2131,"_25897":2042,"_18081":48779,"_5":17976,"_24513":48555,"_2467":48780},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2944":2132,"_25897":2042,"_18081":48782,"_5":17976,"_24513":48555,"_2467":48783},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2944":2133,"_25897":2042,"_18081":48785,"_5":17976,"_24513":48559,"_2467":48786},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2944":2134,"_25897":2042,"_18081":48788,"_5":17976,"_24513":48559,"_2467":48789},[],"Main fields:",{"_2944":2135,"_25897":2042,"_18081":48791,"_5":17976,"_24513":48559,"_2467":48792},[],"**Algorithm**: signing algorithm available for the key type.",{"_2944":2136,"_25897":2042,"_18081":48794,"_5":17976,"_24513":48559,"_2467":48795},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2944":2137,"_25897":2042,"_18081":48797,"_5":17976,"_24513":48559,"_2467":48798},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2944":2138,"_25897":2042,"_18081":48800,"_5":17976,"_24513":48559,"_2467":48801},[],"**Message**: content to sign.",{"_2944":2139,"_25897":2042,"_18081":48803,"_5":17976,"_24513":48559,"_2467":48804},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2944":2140,"_25897":2042,"_18081":48806,"_5":17976,"_24513":48563,"_2467":48807},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2944":2141,"_25897":2042,"_18081":48809,"_5":17976,"_24513":48563,"_2467":48789},[],{"_2944":2142,"_25897":2042,"_18081":48811,"_5":17976,"_24513":48563,"_2467":48812},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2944":2143,"_25897":2042,"_18081":48814,"_5":17976,"_24513":48563,"_2467":48815},[],"**Message Type**: `Raw` or `Digest`.",{"_2944":2144,"_25897":2042,"_18081":48817,"_5":17976,"_24513":48563,"_2467":48818},[],"**Payload Encoding**: encoding of the message.",{"_2944":2145,"_25897":2042,"_18081":48820,"_5":17976,"_24513":48563,"_2467":48821},[],"**Message**: original message or hash.",{"_2944":2146,"_25897":2042,"_18081":48823,"_5":17976,"_24513":48563,"_2467":48824},[],"**Signature**: signature to check.",{"_2944":2147,"_25897":2042,"_18081":48826,"_5":17976,"_24513":48563,"_2467":48827},[],"**Result**: indicator of the validation result.",{"_2944":2148,"_25897":2042,"_18081":48829,"_5":17976,"_24513":48567,"_2467":48830},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2944":2149,"_25897":2042,"_18081":48832,"_5":17976,"_24513":48567,"_2467":48833},[],"This flow is useful for:",{"_2944":2150,"_25897":2042,"_18081":48835,"_5":17976,"_24513":48567,"_2467":48836},[],"Requesting certificates from an external CA.",{"_2944":2151,"_25897":2042,"_18081":48838,"_5":17976,"_24513":48567,"_2467":48839},[],"Renewing an identity while keeping the same key.",{"_2944":2152,"_25897":2042,"_18081":48841,"_5":17976,"_24513":48567,"_2467":48842},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2944":2153,"_25897":2042,"_18081":48844,"_5":17976,"_24513":48567,"_2467":48845},[],"**Common Name (CN)**: main name of the identity.",{"_2944":2154,"_25897":2042,"_18081":48847,"_5":17976,"_24513":48567,"_2467":48848},[],"**Organization (O)**: organization or company.",{"_2944":2155,"_25897":2042,"_18081":48850,"_5":17976,"_24513":48567,"_2467":48851},[],"**Organizational Unit (OU)**: department or unit.",{"_2944":2156,"_25897":2042,"_18081":48853,"_5":17976,"_24513":48567,"_2467":48854},[],"**Country (C)**: two-letter country code.",{"_2944":2157,"_25897":2042,"_18081":48856,"_5":17976,"_24513":48567,"_2467":48857},[],"**State / Province (ST)**: state or province.",{"_2944":2158,"_25897":2042,"_18081":48859,"_5":17976,"_24513":48567,"_2467":48860},[],"**Locality (L)**: city or locality.",{"_2944":2159,"_25897":2042,"_18081":48862,"_5":17976,"_24513":48567,"_2467":48863},[],"**Email Address**: contact email.",{"_2944":2160,"_25897":2042,"_18081":48865,"_5":17976,"_24513":48567,"_2467":48866},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2944":2161,"_25897":2042,"_18081":48868,"_5":17976,"_24513":48567,"_2467":48869},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2944":2162,"_25897":2042,"_18081":48871,"_5":17976,"_24513":48571,"_2467":48872},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2944":2163,"_25897":2042,"_18081":48874,"_5":17976,"_24513":48571,"_2467":48875},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2944":2164,"_25897":2042,"_18081":48877,"_5":17976,"_24513":48575,"_2467":48878},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2944":2165,"_25897":2165,"_5":12672,"_2467":48880,"_26242":48881,"_18081":48882,"_24513":2165},"Online validation with OCSP",[42109,43496,47189,47806],[],{"_2944":2166,"_25897":2165,"_18081":48884,"_5":17976,"_24513":2165,"_2467":48885},[],"Query signed status and verify the responder’s response.",{"_2944":2167,"_25897":2165,"_5":26239,"_18081":48887,"_24513":48888,"_2467":48889},[],"/docs/pr-preview/pr-41/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2944":2168,"_25897":2165,"_5":26239,"_18081":48891,"_24513":48892,"_2467":48893},[],"/docs/pr-preview/pr-41/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2944":2169,"_25897":2165,"_5":26239,"_18081":48895,"_24513":48896,"_2467":48897},[],"/docs/pr-preview/pr-41/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2944":2170,"_25897":2165,"_5":26239,"_18081":48899,"_24513":48900,"_2467":48901},[],"/docs/pr-preview/pr-41/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2944":2171,"_25897":2165,"_5":26239,"_18081":48903,"_24513":48904,"_2467":48905},[],"/docs/pr-preview/pr-41/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2944":2172,"_25897":2165,"_5":26239,"_18081":48907,"_24513":48908,"_2467":48352},[],"/docs/pr-preview/pr-41/platform/pki/ocsp#references",{"_2944":2173,"_25897":2165,"_18081":48910,"_5":17976,"_24513":2165,"_2467":48911},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2944":2174,"_25897":2165,"_18081":48913,"_5":17976,"_24513":48888,"_2467":48914},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2944":2175,"_25897":2165,"_18081":48916,"_5":17976,"_24513":48888,"_2467":48917},[],"Record status",{"_2944":2176,"_25897":2165,"_18081":48919,"_5":17976,"_24513":48888,"_2467":48920},[],"Signed response",{"_2944":2177,"_25897":2165,"_18081":48922,"_5":17976,"_24513":48888,"_2467":46367},[],{"_2944":2178,"_25897":2165,"_18081":48924,"_5":17976,"_24513":48888,"_2467":48925},[],"`Good`.",{"_2944":2179,"_25897":2165,"_18081":48927,"_5":17976,"_24513":48888,"_2467":46384},[],{"_2944":2180,"_25897":2165,"_18081":48929,"_5":17976,"_24513":48888,"_2467":48930},[],"`Revoked`, with revocation reason and timestamp.",{"_2944":2181,"_25897":2165,"_18081":48932,"_5":17976,"_24513":48888,"_2467":48933},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2944":2182,"_25897":2165,"_18081":48935,"_5":17976,"_24513":48888,"_2467":48936},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2944":2183,"_25897":2165,"_18081":48938,"_5":17976,"_24513":48888,"_2467":48939},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2944":2184,"_25897":2165,"_18081":48941,"_5":17976,"_24513":48888,"_2467":48942},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2944":2185,"_25897":2165,"_18081":48944,"_5":17976,"_24513":48888,"_2467":48945},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2944":2186,"_25897":2165,"_18081":48947,"_5":17976,"_24513":48892,"_2467":48948},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2944":2187,"_25897":2165,"_18081":48950,"_5":17976,"_24513":48892,"_2467":48951},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2944":2188,"_25897":2165,"_18081":48953,"_5":17976,"_24513":48896,"_2467":48954},[],"The service accepts:",{"_2944":2189,"_25897":2165,"_18081":48956,"_5":17976,"_24513":48896,"_2467":45220},[],{"_2944":2190,"_25897":2165,"_18081":48958,"_5":17976,"_24513":48896,"_2467":48959},[],"VA service path",{"_2944":2191,"_25897":2165,"_18081":48961,"_5":17976,"_24513":48896,"_2467":48962},[],"Format",{"_2944":2192,"_25897":2165,"_18081":48964,"_5":17976,"_24513":48896,"_2467":48965},[],"`POST`",{"_2944":2193,"_25897":2165,"_18081":48967,"_5":17976,"_24513":48896,"_2467":48968},[],"`/ocsp`",{"_2944":2194,"_25897":2165,"_18081":48970,"_5":17976,"_24513":48896,"_2467":48971},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2944":2195,"_25897":2165,"_18081":48973,"_5":17976,"_24513":48896,"_2467":48451},[],{"_2944":2196,"_25897":2165,"_18081":48975,"_5":17976,"_24513":48896,"_2467":48976},[],"`/ocsp/{ocsp_request}`",{"_2944":2197,"_25897":2165,"_18081":48978,"_5":17976,"_24513":48896,"_2467":48979},[],"DER request encoded using padded URL Base64.",{"_2944":2198,"_25897":2165,"_18081":48981,"_5":17976,"_24513":48896,"_2467":48982},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2944":2199,"_25897":2165,"_18081":48984,"_5":17976,"_24513":48900,"_2467":48985},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2944":2200,"_25897":2165,"_18081":48987,"_5":17976,"_24513":48900,"_2467":48988},[],"Generate the request:",{"_2944":2201,"_25897":2165,"_18081":48990,"_5":17976,"_24513":48900,"_2467":48991},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2944":2202,"_25897":2165,"_18081":48993,"_5":17976,"_24513":48900,"_2467":48994},[],"Replace the example URL with the inspected endpoint:",{"_2944":2203,"_25897":2165,"_18081":48996,"_5":17976,"_24513":48900,"_2467":48997},[],"Verify the returned DER:",{"_2944":2204,"_25897":2165,"_18081":48999,"_5":17976,"_24513":48900,"_2467":49000},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2944":2205,"_25897":2165,"_18081":49002,"_5":17976,"_24513":48904,"_2467":49003},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2944":2206,"_25897":2165,"_18081":49005,"_5":17976,"_24513":48904,"_2467":49006},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2944":2207,"_25897":2165,"_18081":49008,"_5":17976,"_24513":48908,"_2467":49009},[],"RFC 6960: OCSP.",{"_2944":2208,"_25897":2165,"_18081":49011,"_5":17976,"_24513":48908,"_2467":49012},[],"OpenSSL: openssl-ocsp.",{"_2944":2209,"_25897":2165,"_18081":49014,"_5":17976,"_24513":48908,"_2467":49015},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2944":2210,"_25897":2165,"_18081":49017,"_5":17976,"_24513":48908,"_2467":48489},[],{"_2944":2211,"_25897":2211,"_5":12672,"_2467":47189,"_26242":49019,"_18081":49020,"_24513":2211},[42109,43496,47189],[],{"_2944":2212,"_25897":2211,"_18081":49022,"_5":17976,"_24513":2211,"_2467":49023},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2944":2213,"_25897":2211,"_5":26239,"_18081":49025,"_24513":49026,"_2467":46499},[],"/docs/pr-preview/pr-41/platform/pki/overview#start-here",{"_2944":2214,"_25897":2211,"_5":26239,"_18081":49028,"_24513":49029,"_2467":49030},[],"/docs/pr-preview/pr-41/platform/pki/overview#what-you-need","What you need",{"_2944":2215,"_25897":2211,"_5":26239,"_18081":49032,"_24513":49033,"_2467":47033},[],"/docs/pr-preview/pr-41/platform/pki/overview#core-capabilities",{"_2944":2216,"_25897":2211,"_5":26239,"_18081":49035,"_24513":49036,"_2467":47037},[],"/docs/pr-preview/pr-41/platform/pki/overview#build-your-trust-hierarchy",{"_2944":2217,"_25897":2211,"_5":26239,"_18081":49038,"_24513":49039,"_2467":47041},[],"/docs/pr-preview/pr-41/platform/pki/overview#protect-cryptographic-keys",{"_2944":2218,"_25897":2211,"_5":26239,"_18081":49041,"_24513":49042,"_2467":47045},[],"/docs/pr-preview/pr-41/platform/pki/overview#issue-and-control-certificates",{"_2944":2219,"_25897":2211,"_5":26239,"_18081":49044,"_24513":49045,"_2467":47053},[],"/docs/pr-preview/pr-41/platform/pki/overview#publish-validation-status",{"_2944":2220,"_25897":2211,"_5":26239,"_18081":49047,"_24513":49048,"_2467":49049},[],"/docs/pr-preview/pr-41/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2944":2221,"_25897":2211,"_5":26239,"_18081":49051,"_24513":49052,"_2467":47973},[],"/docs/pr-preview/pr-41/platform/pki/overview#continue",{"_2944":2222,"_25897":2211,"_18081":49054,"_5":17976,"_24513":2211,"_2467":49055},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2944":2223,"_25897":2211,"_18081":49057,"_5":17976,"_24513":49026,"_2467":49058},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2944":2224,"_25897":2211,"_18081":49060,"_5":17976,"_24513":49026,"_2467":49061},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2944":2225,"_25897":2211,"_18081":49063,"_5":17976,"_24513":49029,"_2467":49064},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2944":2226,"_25897":2211,"_18081":49066,"_5":17976,"_24513":49029,"_2467":49067},[],"An available cryptographic engine to keep the authority's key.",{"_2944":2227,"_25897":2211,"_18081":49069,"_5":17976,"_24513":49029,"_2467":49070},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2944":2228,"_25897":2211,"_18081":49072,"_5":17976,"_24513":49029,"_2467":49073},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2944":2229,"_25897":2211,"_18081":49075,"_5":17976,"_24513":49029,"_2467":49076},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2944":2230,"_25897":2211,"_18081":49078,"_5":17976,"_24513":49036,"_2467":49079},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2944":2231,"_25897":2211,"_18081":49081,"_5":17976,"_24513":49039,"_2467":49082},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2944":2232,"_25897":2211,"_18081":49084,"_5":17976,"_24513":49042,"_2467":49085},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2944":2233,"_25897":2211,"_18081":49087,"_5":17976,"_24513":49045,"_2467":49088},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2944":2234,"_25897":2211,"_18081":49090,"_5":17976,"_24513":49048,"_2467":49091},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2944":2235,"_25897":2211,"_18081":49093,"_5":17976,"_24513":49048,"_2467":49094},[],"its subject and extensions identify the expected client;",{"_2944":2236,"_25897":2211,"_18081":49096,"_5":17976,"_24513":49048,"_2467":49097},[],"its public key matches the client's private key;",{"_2944":2237,"_25897":2211,"_18081":49099,"_5":17976,"_24513":49048,"_2467":49100},[],"its chain reaches a root trusted by the consumer;",{"_2944":2238,"_25897":2211,"_18081":49102,"_5":17976,"_24513":49048,"_2467":49103},[],"its dates and usages allow the operation;",{"_2944":2239,"_25897":2211,"_18081":49105,"_5":17976,"_24513":49048,"_2467":49106},[],"the consumer applies revocation checks and authorization.",{"_2944":2240,"_25897":2211,"_18081":49108,"_5":17976,"_24513":49048,"_2467":49109},[],"The issuance path includes the first independent checks.",{"_2944":2241,"_25897":2211,"_18081":49111,"_5":17976,"_24513":49052,"_2467":49112},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2944":2242,"_25897":2211,"_18081":49114,"_5":17976,"_24513":49052,"_2467":49115},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2944":2243,"_25897":2211,"_18081":49117,"_5":17976,"_24513":49052,"_2467":49118},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2944":2244,"_25897":2244,"_5":12672,"_2467":49120,"_26242":49121,"_18081":49122,"_24513":2244},"Create your first CA",[42109,43496,47189,46624],[],{"_2944":2245,"_25897":2244,"_18081":49124,"_5":17976,"_24513":2244,"_2467":49125},[],"Create an evaluation root and check its certificate before issuing.",{"_2944":2246,"_25897":2244,"_5":26239,"_18081":49127,"_24513":49128,"_2467":42119},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2944":2247,"_25897":2244,"_5":26239,"_18081":49130,"_24513":49131,"_2467":49132},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2944":2248,"_25897":2244,"_5":26239,"_18081":49134,"_24513":49135,"_2467":49136},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2944":2249,"_25897":2244,"_5":26239,"_18081":49138,"_24513":49139,"_2467":49140},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2944":2250,"_25897":2244,"_5":26239,"_18081":49142,"_24513":49143,"_2467":49144},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2944":2251,"_25897":2244,"_5":26239,"_18081":49146,"_24513":49147,"_2467":49148},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2944":2252,"_25897":2244,"_5":26239,"_18081":49150,"_24513":49151,"_2467":49152},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2944":2253,"_25897":2244,"_5":26239,"_18081":49154,"_24513":49155,"_2467":46882},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2944":2254,"_25897":2244,"_5":26239,"_18081":49157,"_24513":49158,"_2467":42143},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2944":2255,"_25897":2244,"_18081":49160,"_5":17976,"_24513":2244,"_2467":49161},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2944":2256,"_25897":2244,"_18081":49163,"_5":17976,"_24513":49128,"_2467":49164},[],"Console access and permission to create keys and authorities.",{"_2944":2257,"_25897":2244,"_18081":49166,"_5":17976,"_24513":49128,"_2467":49167},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2944":2258,"_25897":2244,"_18081":49169,"_5":17976,"_24513":49128,"_2467":49170},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2944":2259,"_25897":2244,"_18081":49172,"_5":17976,"_24513":49128,"_2467":49173},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2944":2260,"_25897":2244,"_18081":49175,"_5":17976,"_24513":49131,"_2467":49176},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2944":2261,"_25897":2244,"_18081":49178,"_5":17976,"_24513":49131,"_2467":49179},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2944":2262,"_25897":2244,"_18081":49181,"_5":17976,"_24513":49135,"_2467":49182},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2944":2263,"_25897":2244,"_18081":49184,"_5":17976,"_24513":49135,"_2467":49185},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2944":2264,"_25897":2244,"_18081":49187,"_5":17976,"_24513":49139,"_2467":49188},[],"Select **Root CA** and complete:",{"_2944":2265,"_25897":2244,"_18081":49190,"_5":17976,"_24513":49139,"_2467":49191},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2944":2266,"_25897":2244,"_18081":49193,"_5":17976,"_24513":49139,"_2467":49194},[],"**Subject**: organization and country details for your evaluation.",{"_2944":2267,"_25897":2244,"_18081":49196,"_5":17976,"_24513":49139,"_2467":49197},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2944":2268,"_25897":2244,"_18081":49199,"_5":17976,"_24513":49139,"_2467":49200},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2944":2269,"_25897":2244,"_18081":49202,"_5":17976,"_24513":49139,"_2467":49203},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2944":2270,"_25897":2244,"_18081":49205,"_5":17976,"_24513":49143,"_2467":49206},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2944":2271,"_25897":2244,"_18081":49208,"_5":17976,"_24513":49147,"_2467":49209},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2944":2272,"_25897":2244,"_18081":49211,"_5":17976,"_24513":49147,"_2467":49212},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2944":2273,"_25897":2244,"_18081":49214,"_5":17976,"_24513":49151,"_2467":49215},[],"Run from the directory where you saved `ca.pem`:",{"_2944":2274,"_25897":2244,"_18081":49217,"_5":17976,"_24513":49151,"_2467":49218},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2944":2275,"_25897":2244,"_18081":49220,"_5":17976,"_24513":49151,"_2467":49221},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2944":2276,"_25897":2244,"_18081":49223,"_5":17976,"_24513":49155,"_2467":49224},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2944":2277,"_25897":2244,"_18081":49226,"_5":17976,"_24513":49155,"_2467":49227},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2944":2278,"_25897":2244,"_18081":49229,"_5":17976,"_24513":49155,"_2467":49230},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2944":2279,"_25897":2244,"_18081":49232,"_5":17976,"_24513":49155,"_2467":49233},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2944":2280,"_25897":2244,"_18081":49235,"_5":17976,"_24513":49158,"_2467":49236},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2944":2281,"_25897":2281,"_5":12672,"_2467":49238,"_26242":49239,"_18081":49240,"_24513":2281},"Issue and verify a certificate",[42109,43496,47189,46624],[],{"_2944":2282,"_25897":2281,"_18081":49242,"_5":17976,"_24513":2281,"_2467":49243},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2944":2283,"_25897":2281,"_5":26239,"_18081":49245,"_24513":49246,"_2467":42119},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2944":2284,"_25897":2281,"_5":26239,"_18081":49248,"_24513":49249,"_2467":49250},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2944":2285,"_25897":2281,"_5":26239,"_18081":49252,"_24513":49253,"_2467":49254},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2944":2286,"_25897":2281,"_5":26239,"_18081":49256,"_24513":49257,"_2467":49258},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2944":2287,"_25897":2281,"_5":26239,"_18081":49260,"_24513":49261,"_2467":49262},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2944":2288,"_25897":2281,"_5":26239,"_18081":49264,"_24513":49265,"_2467":49266},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2944":2289,"_25897":2281,"_5":26239,"_18081":49268,"_24513":49269,"_2467":49148},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2944":2290,"_25897":2281,"_5":26239,"_18081":49271,"_24513":49272,"_2467":49273},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2944":2291,"_25897":2281,"_5":26239,"_18081":49275,"_24513":49276,"_2467":49277},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2944":2292,"_25897":2281,"_5":26239,"_18081":49279,"_24513":49280,"_2467":49281},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2944":2293,"_25897":2281,"_5":26239,"_18081":49283,"_24513":49284,"_2467":46882},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2944":2294,"_25897":2281,"_5":26239,"_18081":49286,"_24513":49287,"_2467":42143},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/issue-certificate#next-step",{"_2944":2295,"_25897":2281,"_18081":49289,"_5":17976,"_24513":2281,"_2467":49290},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2944":2296,"_25897":2281,"_18081":49292,"_5":17976,"_24513":49246,"_2467":49293},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2944":2297,"_25897":2281,"_18081":49295,"_5":17976,"_24513":49246,"_2467":49296},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2944":2298,"_25897":2281,"_18081":49298,"_5":17976,"_24513":49246,"_2467":49299},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2944":2299,"_25897":2281,"_18081":49301,"_5":17976,"_24513":49246,"_2467":49302},[],"A client identifier: here we use `device-001`.",{"_2944":2300,"_25897":2281,"_18081":49304,"_5":17976,"_24513":49246,"_2467":49305},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2944":2301,"_25897":2281,"_18081":49307,"_5":17976,"_24513":49249,"_2467":49308},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2944":2302,"_25897":2281,"_18081":49310,"_5":17976,"_24513":49253,"_2467":49311},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2944":2303,"_25897":2281,"_18081":49313,"_5":17976,"_24513":49253,"_2467":49314},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2944":2304,"_25897":2281,"_18081":49316,"_5":17976,"_24513":49257,"_2467":49317},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2944":2305,"_25897":2281,"_18081":49319,"_5":17976,"_24513":49257,"_2467":49320},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2944":2306,"_25897":2281,"_18081":49322,"_5":17976,"_24513":49261,"_2467":49323},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2944":2307,"_25897":2281,"_18081":49325,"_5":17976,"_24513":49261,"_2467":49326},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2944":2308,"_25897":2281,"_18081":49328,"_5":17976,"_24513":49265,"_2467":49329},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2944":2309,"_25897":2281,"_18081":49331,"_5":17976,"_24513":49269,"_2467":49332},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2944":2310,"_25897":2281,"_18081":49334,"_5":17976,"_24513":49272,"_2467":49335},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2944":2311,"_25897":2281,"_18081":49337,"_5":17976,"_24513":49276,"_2467":49338},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2944":2312,"_25897":2281,"_18081":49340,"_5":17976,"_24513":49276,"_2467":49341},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2944":2313,"_25897":2281,"_18081":49343,"_5":17976,"_24513":49276,"_2467":49344},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2944":2314,"_25897":2281,"_18081":49346,"_5":17976,"_24513":49280,"_2467":49347},[],"In Bash, compare the two public-key digests:",{"_2944":2315,"_25897":2281,"_18081":49349,"_5":17976,"_24513":49280,"_2467":49350},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2944":2316,"_25897":2281,"_18081":49352,"_5":17976,"_24513":49280,"_2467":49353},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2944":2317,"_25897":2281,"_18081":49355,"_5":17976,"_24513":49284,"_2467":46966},[],{"_2944":2318,"_25897":2281,"_18081":49357,"_5":17976,"_24513":49284,"_2467":49358},[],"What to review",{"_2944":2319,"_25897":2281,"_18081":49360,"_5":17976,"_24513":49284,"_2467":49361},[],"The CA rejects issuance",{"_2944":2320,"_25897":2281,"_18081":49363,"_5":17976,"_24513":49284,"_2467":49364},[],"Permissions, CA state and key, algorithm and profile.",{"_2944":2321,"_25897":2281,"_18081":49366,"_5":17976,"_24513":49284,"_2467":49367},[],"Different subject or usages",{"_2944":2322,"_25897":2281,"_18081":49369,"_5":17976,"_24513":49284,"_2467":49370},[],"Applied profile and requested values.",{"_2944":2323,"_25897":2281,"_18081":49372,"_5":17976,"_24513":49284,"_2467":49373},[],"Issuer cannot be found",{"_2944":2324,"_25897":2281,"_18081":49375,"_5":17976,"_24513":49284,"_2467":49376},[],"Downloaded CA and required intermediate chain.",{"_2944":2325,"_25897":2281,"_18081":49378,"_5":17976,"_24513":49284,"_2467":49379},[],"Validity fails",{"_2944":2326,"_25897":2281,"_18081":49381,"_5":17976,"_24513":49284,"_2467":49382},[],"Certificate and CA dates, and the computer's clock.",{"_2944":2327,"_25897":2281,"_18081":49384,"_5":17976,"_24513":49284,"_2467":49385},[],"Public-key digests differ",{"_2944":2328,"_25897":2281,"_18081":49387,"_5":17976,"_24513":49284,"_2467":49388},[],"Certificate and key files from the same issuance.",{"_2944":2329,"_25897":2281,"_18081":49390,"_5":17976,"_24513":49284,"_2467":49391},[],"See PKI diagnostics to narrow an issuance failure.",{"_2944":2330,"_25897":2281,"_18081":49393,"_5":17976,"_24513":49287,"_2467":49394},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2944":2331,"_25897":2281,"_18081":49396,"_5":17976,"_24513":49287,"_2467":49397},[],"Manage certificates for inspection, status and revocation.",{"_2944":2332,"_25897":2281,"_18081":49399,"_5":17976,"_24513":49287,"_2467":49400},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2944":2333,"_25897":2281,"_18081":49402,"_5":17976,"_24513":49287,"_2467":49403},[],"Prepare EST for the device to request its next identities.",{"_2944":2334,"_25897":2281,"_18081":49405,"_5":17976,"_24513":49287,"_2467":49406},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2944":2335,"_25897":2335,"_5":12672,"_2467":49408,"_26242":49409,"_18081":49410,"_24513":2335},"PKI getting started",[42109,43496,47189,46624],[],{"_2944":2336,"_25897":2335,"_18081":49412,"_5":17976,"_24513":2335,"_2467":49413},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2944":2337,"_25897":2335,"_5":26239,"_18081":49415,"_24513":49416,"_2467":42119},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#before-you-begin",{"_2944":2338,"_25897":2335,"_5":26239,"_18081":49418,"_24513":49419,"_2467":49420},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2944":2339,"_25897":2335,"_5":26239,"_18081":49422,"_24513":49423,"_2467":46816},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#expected-result",{"_2944":2340,"_25897":2335,"_5":26239,"_18081":49425,"_24513":49426,"_2467":49427},[],"/docs/pr-preview/pr-41/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2944":2341,"_25897":2335,"_18081":49429,"_5":17976,"_24513":2335,"_2467":49430},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2944":2342,"_25897":2335,"_18081":49432,"_5":17976,"_24513":49416,"_2467":49433},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2944":2343,"_25897":2335,"_18081":49435,"_5":17976,"_24513":49416,"_2467":49436},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2944":2344,"_25897":2335,"_18081":49438,"_5":17976,"_24513":49416,"_2467":49439},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2944":2345,"_25897":2335,"_18081":49441,"_5":17976,"_24513":49416,"_2467":49442},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2944":2346,"_25897":2335,"_18081":49444,"_5":17976,"_24513":49416,"_2467":49445},[],"A working directory with restricted access for the downloaded key.",{"_2944":2347,"_25897":2335,"_18081":49447,"_5":17976,"_24513":49419,"_2467":49448},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2944":2348,"_25897":2335,"_18081":49450,"_5":17976,"_24513":49419,"_2467":49451},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2944":2349,"_25897":2335,"_18081":49453,"_5":17976,"_24513":49419,"_2467":49454},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2944":2350,"_25897":2335,"_18081":49456,"_5":17976,"_24513":49419,"_2467":49457},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2944":2351,"_25897":2335,"_18081":49459,"_5":17976,"_24513":49423,"_2467":49460},[],"File or resource",{"_2944":2352,"_25897":2335,"_18081":49462,"_5":17976,"_24513":49423,"_2467":46813},[],{"_2944":2353,"_25897":2335,"_18081":49464,"_5":17976,"_24513":49423,"_2467":49465},[],"Active root CA and `ca.pem`",{"_2944":2354,"_25897":2335,"_18081":49467,"_5":17976,"_24513":49423,"_2467":49468},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2944":2355,"_25897":2335,"_18081":49470,"_5":17976,"_24513":49423,"_2467":49471},[],"End-entity certificate and `device.crt`",{"_2944":2356,"_25897":2335,"_18081":49473,"_5":17976,"_24513":49423,"_2467":49474},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2944":2357,"_25897":2335,"_18081":49476,"_5":17976,"_24513":49423,"_2467":49477},[],"Private key `device.key`",{"_2944":2358,"_25897":2335,"_18081":49479,"_5":17976,"_24513":49423,"_2467":49480},[],"Its public key matches the one included in `device.crt`.",{"_2944":2359,"_25897":2335,"_18081":49482,"_5":17976,"_24513":49423,"_2467":49483},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2944":2360,"_25897":2335,"_18081":49485,"_5":17976,"_24513":49426,"_2467":49486},[],"To operate certificates, continue with Certificates and Validation.",{"_2944":2361,"_25897":2335,"_18081":49488,"_5":17976,"_24513":49426,"_2467":49489},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2944":2362,"_25897":2335,"_18081":49491,"_5":17976,"_24513":49426,"_2467":49492},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2944":2363,"_25897":2363,"_5":12672,"_2467":49494,"_26242":49495,"_18081":49496,"_24513":2363},"PKI troubleshooting",[42109,43496,47189,46010],[],{"_2944":2364,"_25897":2363,"_18081":49498,"_5":17976,"_24513":2363,"_2467":49499},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2944":2365,"_25897":2363,"_5":26239,"_18081":49501,"_24513":49502,"_2467":49503},[],"/docs/pr-preview/pr-41/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2944":2366,"_25897":2363,"_5":26239,"_18081":49505,"_24513":49506,"_2467":49507},[],"/docs/pr-preview/pr-41/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2944":2367,"_25897":2363,"_5":26239,"_18081":49509,"_24513":49510,"_2467":49511},[],"/docs/pr-preview/pr-41/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2944":2368,"_25897":2363,"_18081":49513,"_5":17976,"_24513":2363,"_2467":49514},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2944":2369,"_25897":2363,"_18081":49516,"_5":17976,"_24513":2363,"_2467":49517},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2944":2370,"_25897":2363,"_18081":49519,"_5":17976,"_24513":49502,"_2467":46813},[],{"_2944":2371,"_25897":2363,"_18081":49521,"_5":17976,"_24513":49502,"_2467":49522},[],"What to inspect",{"_2944":2372,"_25897":2363,"_18081":49524,"_5":17976,"_24513":49502,"_2467":42143},[],{"_2944":2373,"_25897":2363,"_18081":49526,"_5":17976,"_24513":49502,"_2467":49527},[],"CA",{"_2944":2374,"_25897":2363,"_18081":49529,"_5":17976,"_24513":49502,"_2467":49530},[],"Exists, is active and has usable dates.",{"_2944":2375,"_25897":2363,"_18081":49532,"_5":17976,"_24513":49502,"_2467":49533},[],"Authorities.",{"_2944":2376,"_25897":2363,"_18081":49535,"_5":17976,"_24513":49502,"_2467":49536},[],"Key",{"_2944":2377,"_25897":2363,"_18081":49538,"_5":17976,"_24513":49502,"_2467":49539},[],"The record has a usable private key and the engine can sign.",{"_2944":2378,"_25897":2363,"_18081":49541,"_5":17976,"_24513":49502,"_2467":49542},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2944":2379,"_25897":2363,"_18081":49544,"_5":17976,"_24513":49502,"_2467":49545},[],"CSR",{"_2944":2380,"_25897":2363,"_18081":49547,"_5":17976,"_24513":49502,"_2467":49548},[],"Correct PEM and verifiable signature.",{"_2944":2381,"_25897":2363,"_18081":49550,"_5":17976,"_24513":49502,"_2467":49551},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2944":2382,"_25897":2363,"_18081":49553,"_5":17976,"_24513":49502,"_2467":49554},[],"Profile",{"_2944":2383,"_25897":2363,"_18081":49556,"_5":17976,"_24513":49502,"_2467":49557},[],"Selected source, existing ID, allowed algorithm and size.",{"_2944":2384,"_25897":2363,"_18081":49559,"_5":17976,"_24513":49502,"_2467":49560},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2944":2385,"_25897":2363,"_18081":49562,"_5":17976,"_24513":49502,"_2467":46966},[],{"_2944":2386,"_25897":2363,"_18081":49564,"_5":17976,"_24513":49502,"_2467":49565},[],"Appropriate subject, SAN, usages and dates.",{"_2944":2387,"_25897":2363,"_18081":49567,"_5":17976,"_24513":49502,"_2467":49568},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2944":2388,"_25897":2363,"_18081":49570,"_5":17976,"_24513":49502,"_2467":49571},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2944":2389,"_25897":2363,"_18081":49573,"_5":17976,"_24513":49502,"_2467":49574},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2944":2390,"_25897":2363,"_18081":49576,"_5":17976,"_24513":49506,"_2467":49577},[],"Check each boundary independently:",{"_2944":2391,"_25897":2363,"_18081":49579,"_5":17976,"_24513":49506,"_2467":49580},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2944":2392,"_25897":2363,"_18081":49582,"_5":17976,"_24513":49506,"_2467":49583},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2944":2393,"_25897":2363,"_18081":49585,"_5":17976,"_24513":49506,"_2467":49586},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2944":2394,"_25897":2363,"_18081":49588,"_5":17976,"_24513":49506,"_2467":49589},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2944":2395,"_25897":2363,"_18081":49591,"_5":17976,"_24513":49506,"_2467":49592},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2944":2396,"_25897":2363,"_18081":49594,"_5":17976,"_24513":49506,"_2467":49595},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2944":2397,"_25897":2363,"_18081":49597,"_5":17976,"_24513":49510,"_2467":49598},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2944":2398,"_25897":2363,"_18081":49600,"_5":17976,"_24513":49510,"_2467":49601},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_2944":2399,"_25897":2399,"_5":12672,"_2467":49603,"_26242":49604,"_18081":49606,"_24513":2399},"3.8.0 to 4.0.0",[42109,49605],"Upgrades",[],{"_2944":2400,"_25897":2399,"_18081":49608,"_5":17976,"_24513":2399,"_2467":49609},[],"4.0.0 changes that affect DMS configuration, what can break after upgrading from 3.8.0, and how to verify it.",{"_2944":2401,"_25897":2399,"_5":26239,"_18081":49611,"_24513":49612,"_2467":49613},[],"/docs/pr-preview/pr-41/upgrades/3-8-0-to-4-0-0#summary","Summary",{"_2944":2402,"_25897":2399,"_5":26239,"_18081":49615,"_24513":49616,"_2467":49617},[],"/docs/pr-preview/pr-41/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_2944":2403,"_25897":2399,"_5":26239,"_18081":49619,"_24513":49620,"_2467":49621},[],"/docs/pr-preview/pr-41/upgrades/3-8-0-to-4-0-0#webhooks-with-file-references","Webhooks with file references",{"_2944":2404,"_25897":2399,"_5":26239,"_18081":49623,"_24513":49624,"_2467":49625},[],"/docs/pr-preview/pr-41/upgrades/3-8-0-to-4-0-0#receiver-certificate-verification","Receiver certificate verification",{"_2944":2405,"_25897":2399,"_5":26239,"_18081":49627,"_24513":49628,"_2467":49629},[],"/docs/pr-preview/pr-41/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_2944":2406,"_25897":2399,"_5":26239,"_18081":49631,"_24513":49632,"_2467":49633},[],"/docs/pr-preview/pr-41/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_2944":2407,"_25897":2399,"_5":26239,"_18081":49635,"_24513":49636,"_2467":49637},[],"/docs/pr-preview/pr-41/upgrades/3-8-0-to-4-0-0#verification-checklist","Verification checklist",{"_2944":2408,"_25897":2399,"_18081":49639,"_5":17976,"_24513":2399,"_2467":49640},[],"Upgrading from 3.8.0 to 4.0.0 automatically migrates stored DMS configuration. Most of it converts without intervention, but three changes can leave enrollments failing or configs holding unexpected values if they are not reviewed. This page states what changes, what symptoms to expect and what to do in each case. Current behavior of each feature is documented in the DMS pages.",{"_2944":2409,"_25897":2399,"_18081":49642,"_5":17976,"_24513":49612,"_2467":49643},[],"Change",{"_2944":2410,"_25897":2399,"_18081":49645,"_5":17976,"_24513":49612,"_2467":49646},[],"Who is affected",{"_2944":2411,"_25897":2399,"_18081":49648,"_5":17976,"_24513":49612,"_2467":49649},[],"Severity",{"_2944":2412,"_25897":2399,"_18081":49651,"_5":17976,"_24513":49612,"_2467":49652},[],"Action",{"_2944":2413,"_25897":2399,"_18081":49654,"_5":17976,"_24513":49612,"_2467":49621},[],{"_2944":2414,"_25897":2399,"_18081":49656,"_5":17976,"_24513":49612,"_2467":49657},[],"DMSs with a webhook whose mTLS certificate or key were file paths",{"_2944":2415,"_25897":2399,"_18081":49659,"_5":17976,"_24513":49612,"_2467":49660},[],"High: enrollments and re-enrollments calling the webhook fail",{"_2944":2416,"_25897":2399,"_18081":49662,"_5":17976,"_24513":49612,"_2467":49663},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_2944":2417,"_25897":2399,"_18081":49665,"_5":17976,"_24513":49612,"_2467":49625},[],{"_2944":2418,"_25897":2399,"_18081":49667,"_5":17976,"_24513":49612,"_2467":49668},[],"DMSs with a webhook that had `validate_server_cert: false`",{"_2944":2419,"_25897":2399,"_18081":49670,"_5":17976,"_24513":49612,"_2467":49671},[],"Medium: webhook credentials are sent to an unverified receiver",{"_2944":2420,"_25897":2399,"_18081":49673,"_5":17976,"_24513":49612,"_2467":49674},[],"Set `insecure_skip_verify` to `false`",{"_2944":2421,"_25897":2399,"_18081":49676,"_5":17976,"_24513":49612,"_2467":49629},[],{"_2944":2422,"_25897":2399,"_18081":49678,"_5":17976,"_24513":49612,"_2467":49679},[],"Scripts and consoles that edit DMSs through the API",{"_2944":2423,"_25897":2399,"_18081":49681,"_5":17976,"_24513":49612,"_2467":49682},[],"Medium: an edit in the old layout silently empties `validation_cas`",{"_2944":2424,"_25897":2399,"_18081":49684,"_5":17976,"_24513":49612,"_2467":49685},[],"Read the DMS before editing and use the new field",{"_2944":2425,"_25897":2399,"_18081":49687,"_5":17976,"_24513":49612,"_2467":49633},[],{"_2944":2426,"_25897":2399,"_18081":49689,"_5":17976,"_24513":49612,"_2467":49690},[],"Any DMS",{"_2944":2427,"_25897":2399,"_18081":49692,"_5":17976,"_24513":49612,"_2467":49693},[],"Low: informational",{"_2944":2428,"_25897":2399,"_18081":49695,"_5":17976,"_24513":49612,"_2467":49696},[],"Read both blocks before editing",{"_2944":2429,"_25897":2399,"_18081":49698,"_5":17976,"_24513":49612,"_2467":49699},[],"A verification checklist at the end confirms the result.",{"_2944":2430,"_25897":2399,"_18081":49701,"_5":17976,"_24513":49616,"_2467":49702},[],"Stored webhook configs are rewritten to the current layout. Fields are renamed as follows:",{"_2944":2431,"_25897":2399,"_18081":49704,"_5":17976,"_24513":49616,"_2467":49705},[],"Field in 3.8.0",{"_2944":2432,"_25897":2399,"_18081":49707,"_5":17976,"_24513":49616,"_2467":49708},[],"Field in 4.0.0",{"_2944":2433,"_25897":2399,"_18081":49710,"_5":17976,"_24513":49616,"_2467":49711},[],"`validate_server_cert`",{"_2944":2434,"_25897":2399,"_18081":49713,"_5":17976,"_24513":49616,"_2467":49714},[],"`insecure_skip_verify` (value negated)",{"_2944":2435,"_25897":2399,"_18081":49716,"_5":17976,"_24513":49616,"_2467":49717},[],"`oidc`",{"_2944":2436,"_25897":2399,"_18081":49719,"_5":17976,"_24513":49616,"_2467":49720},[],"`jwt_options`",{"_2944":2437,"_25897":2399,"_18081":49722,"_5":17976,"_24513":49616,"_2467":49723},[],"`apikey`",{"_2944":2438,"_25897":2399,"_18081":49725,"_5":17976,"_24513":49616,"_2467":49726},[],"`apikey_options`",{"_2944":2439,"_25897":2399,"_18081":49728,"_5":17976,"_24513":49616,"_2467":49729},[],"`mtls`",{"_2944":2440,"_25897":2399,"_18081":49731,"_5":17976,"_24513":49616,"_2467":49732},[],"`mtls_options`",{"_2944":2441,"_25897":2399,"_18081":49734,"_5":17976,"_24513":49616,"_2467":49735},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. The two cases below do need it.",{"_2944":2442,"_25897":2399,"_18081":49737,"_5":17976,"_24513":49620,"_2467":49738},[],"A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields, and does so on every call, whatever the configured authentication mode. As a result, every enroll and re-enroll that calls that webhook fails until the config is fixed.",{"_2944":2443,"_25897":2399,"_18081":49740,"_5":17976,"_24513":49620,"_2467":49741},[],"There are two ways to fix it, depending on the webhook:",{"_2944":2444,"_25897":2399,"_18081":49743,"_5":17976,"_24513":49620,"_2467":49744},[],"If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM.",{"_2944":2445,"_25897":2399,"_18081":49746,"_5":17976,"_24513":49620,"_2467":49747},[],"If the webhook does not use mTLS, remove the leftover file fields.",{"_2944":2446,"_25897":2399,"_18081":49749,"_5":17976,"_24513":49620,"_2467":49750},[],"Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`).",{"_2944":2447,"_25897":2399,"_18081":49752,"_5":17976,"_24513":49620,"_2467":49753},[],"A variant of the same problem exists: if the stored config holds file paths inside `mtls_options.cert_content` or `mtls_options.key_content`, every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fails validation. Settings are replaced wholesale, so the stored config must be resent with the certificate and key as PEM.",{"_2944":2448,"_25897":2399,"_18081":49755,"_5":17976,"_24513":49624,"_2467":49756},[],"A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`. Receiver certificate verification therefore stays skipped until that field is set to `false`.",{"_2944":2449,"_25897":2399,"_18081":49758,"_5":17976,"_24513":49624,"_2467":49759},[],"It should be corrected on every migrated config. The webhook authorization channel carries the API key or bearer token, so skipping verification exposes those credentials to a network-positioned attacker. Keeping `insecure_skip_verify: true` is only justified when the receiver certificate is deliberately unverifiable.",{"_2944":2450,"_25897":2399,"_18081":49761,"_5":17976,"_24513":49628,"_2467":49762},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`.",{"_2944":2451,"_25897":2399,"_18081":49764,"_5":17976,"_24513":49628,"_2467":49765},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_2944":2452,"_25897":2399,"_18081":49767,"_5":17976,"_24513":49628,"_2467":49768},[],"What does change is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently ignored because unknown JSON fields are dropped, and GET responses no longer include it. Consequently, an update body built from the old layout empties `validation_cas` without returning any error. To avoid it, always read the DMS before sending an edit and reuse the layout the API returns.",{"_2944":2453,"_25897":2399,"_18081":49770,"_5":17976,"_24513":49632,"_2467":49771},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but both blocks should be read before editing a DMS so that one is not modified while believing the other is being edited.",{"_2944":2454,"_25897":2399,"_18081":49773,"_5":17976,"_24513":49632,"_2467":49774},[],"If the console version does not expose independent settings, they can be edited through the DMS API.",{"_2944":2455,"_25897":2399,"_18081":49776,"_5":17976,"_24513":49636,"_2467":49777},[],"After applying the upgrade, check in this order:",{"_2944":2456,"_25897":2399,"_18081":49779,"_5":17976,"_24513":49636,"_2467":49780},[],"**Webhooks without file fields.** List the DMSs that use a webhook for enrollment or re-enrollment and confirm each `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_2944":2457,"_25897":2399,"_18081":49782,"_5":17976,"_24513":49636,"_2467":49783},[],"**Receiver verification.** Confirm `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_2944":2458,"_25897":2399,"_18081":49785,"_5":17976,"_24513":49636,"_2467":49786},[],"**Delivery.** Trigger, or wait for, one enroll or re-enroll through each migrated webhook and confirm the authorization call completes.",{"_2944":2459,"_25897":2399,"_18081":49788,"_5":17976,"_24513":49636,"_2467":49789},[],"**Trust set.** Read `est_rfc7030_settings.client_certificate_settings.validation_cas` and confirm it holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_2944":2460,"_25897":2399,"_18081":49791,"_5":17976,"_24513":49636,"_2467":49792},[],"**API clients.** Update any script or console that uses the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), since they silently drop those values.",{"_2944":2461,"_25897":2399,"_18081":49794,"_5":17976,"_24513":49636,"_2467":46483},[],{"_2944":2462,"_25897":2399,"_18081":49796,"_5":17976,"_24513":49636,"_2467":49797},[],"<Card title=\"DMS API\" href=\"/docs/api-reference/dms-manager\" />","count","sorting",{"_49801":49802,"_49803":49804,"_49805":49806,"_49807":49808,"_15702":2489,"_59614":2489},"language","english","sortableProperties",[2467,25897,5,24513],"sortablePropertiesWithTypes",{"_2467":21576,"_25897":21576,"_5":21576,"_24513":21576},"sorts",{"_2467":49809,"_25897":52261,"_5":54712,"_24513":57163},{"_3944":49810,"_49811":49812,"_5":21576},{"_12412":8953,"_12771":15282,"_12778":2532,"_25093":21582,"_24628":2916,"_17176":16065,"_12433":9643,"_12440":3263,"_25055":4677,"_25416":10643,"_25437":5709,"_25068":6655,"_29809":11729,"_25448":8091,"_29814":4107,"_29817":14629,"_29820":6455,"_29823":5932,"_29826":9819,"_25762":2862,"_29831":6438,"_29833":5054,"_25792":4326,"_25752":2573,"_29837":6286,"_29840":4218,"_29842":8947,"_25466":7315,"_25757":4642,"_25805":5334,"_29847":9088,"_29849":5708,"_29851":3988,"_29853":4383,"_29855":5062,"_29857":3979,"_29859":3098,"_29861":3952,"_29863":3199,"_25106":5081,"_25955":3759,"_29867":2910,"_25100":2542,"_29870":9732,"_29872":13910,"_29874":7568,"_29877":3004,"_25136":2825,"_29881":2874,"_25046":5575,"_29884":6537,"_25073":6476,"_29887":17439,"_29889":2809,"_29892":9644,"_25787":5881,"_29895":3008,"_29897":4292,"_29900":2545,"_29902