962,"_33512":102965,"_33514":102969,"_33516":102972,"_33518":102975,"_33520":102979,"_33522":102983,"_33524":102987,"_33526":102991,"_33528":102995,"_33530":102998,"_33532":103002,"_33534":103006,"_33536":103010,"_33538":103013,"_33540":103016,"_33542":103019,"_33544":103022,"_33546":103025,"_33548":103028,"_33550":103031,"_33552":103034,"_33554":103037,"_33556":103040,"_33558":103043,"_33560":103046,"_33562":103049,"_33564":103052,"_33566":103055,"_33568":103058,"_33570":103061,"_33572":103064,"_33574":103067,"_33576":103070,"_33578":103073,"_33580":103076,"_33582":103079,"_33584":103082,"_33586":103084,"_33588":103086,"_33590":103089,"_33592":103092,"_33594":103095,"_33596":103098,"_33598":103101,"_33600":103104,"_33602":103107,"_33604":103110,"_33606":103113,"_33608":103116,"_33610":103119,"_33612":103122,"_33614":103125,"_33616":103128,"_33618":103131,"_33620":103134,"_33622":103138,"_33624":103141,"_33626":103144,"_33628":103148,"_33630":103151,"_33632":103155,"_33634":103158,"_33636":103161,"_33638":103164,"_33640":103167,"_33642":103170,"_33644":103173,"_33646":103176,"_33648":103179,"_33650":103182,"_33652":103185,"_33654":103188,"_33656":103190,"_33658":103193,"_33660":103196,"_33662":103199,"_33664":103202,"_33666":103205,"_33668":103208,"_33670":103211,"_33672":103214,"_33674":103217,"_33676":103220,"_33678":103225,"_33680":103228,"_33682":103232,"_33684":103236,"_33686":103240,"_33688":103243,"_33690":103246,"_33692":103248,"_33694":103250,"_33696":103252,"_33698":103254,"_33700":103257,"_33702":103260,"_33704":103263,"_33706":103266,"_33708":103269,"_33710":103271,"_33712":103274,"_33714":103276,"_33716":103279,"_33718":103282,"_33720":103285,"_33722":103287,"_33724":103290,"_33726":103293,"_33728":103296,"_33730":103299,"_33732":103302,"_33734":103305,"_33736":103308,"_33738":103311,"_33740":103314,"_33742":103317,"_33744":103320,"_33746":103323},{"_2864":57885,"_25225":57885,"_5":12320,"_2388":96048,"_25561":96049,"_17592":96052,"_23859":57885},"Despliega desde AWS Marketplace",[40930,96050,96051],"Despliegue","Otros modelos",[],{"_2864":57886,"_25225":57885,"_17592":96054,"_5":17487,"_23859":57885,"_2388":96055},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2864":57887,"_25225":57885,"_5":25558,"_17592":96057,"_23859":96058,"_2388":96059},[],"/docs/pr-preview/pr-41/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2864":57888,"_25225":57885,"_5":25558,"_17592":96061,"_23859":96062,"_2388":96063},[],"/docs/pr-preview/pr-41/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2864":57889,"_25225":57885,"_5":25558,"_17592":96065,"_23859":96066,"_2388":96067},[],"/docs/pr-preview/pr-41/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2864":57890,"_25225":57885,"_5":25558,"_17592":96069,"_23859":96070,"_2388":96071},[],"/docs/pr-preview/pr-41/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2864":57891,"_25225":57885,"_5":25558,"_17592":96073,"_23859":96074,"_2388":96075},[],"/docs/pr-preview/pr-41/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2864":57892,"_25225":57885,"_5":25558,"_17592":96077,"_23859":96078,"_2388":96079},[],"/docs/pr-preview/pr-41/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2864":57893,"_25225":57885,"_5":25558,"_17592":96081,"_23859":96082,"_2388":96083},[],"/docs/pr-preview/pr-41/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2864":57894,"_25225":57885,"_17592":96085,"_5":17487,"_23859":57885,"_2388":96086},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2864":57895,"_25225":57885,"_17592":96088,"_5":17487,"_23859":96058,"_2388":96089},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2864":57896,"_25225":57885,"_17592":96091,"_5":17487,"_23859":96058,"_2388":96092},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2864":57897,"_25225":57885,"_17592":96094,"_5":17487,"_23859":96058,"_2388":96095},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2864":57898,"_25225":57885,"_17592":96097,"_5":17487,"_23859":96062,"_2388":96098},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2864":57899,"_25225":57885,"_17592":96100,"_5":17487,"_23859":96062,"_2388":96101},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2864":57900,"_25225":57885,"_17592":96103,"_5":17487,"_23859":96062,"_2388":96104},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2864":57901,"_25225":57885,"_17592":96106,"_5":17487,"_23859":96066,"_2388":96107},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2864":57902,"_25225":57885,"_17592":96109,"_5":17487,"_23859":96070,"_2388":96110},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2864":57903,"_25225":57885,"_17592":96112,"_5":17487,"_23859":96074,"_2388":96113},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2864":57904,"_25225":57885,"_17592":96115,"_5":17487,"_23859":96078,"_2388":96116},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2864":57905,"_25225":57885,"_17592":96118,"_5":17487,"_23859":96082,"_2388":96119},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2864":57906,"_25225":57906,"_5":12320,"_2388":96121,"_25561":96122,"_17592":96123,"_23859":57906},"Despliega Lamassu",[40930,96050],[],{"_2864":57907,"_25225":57906,"_17592":96125,"_5":17487,"_23859":57906,"_2388":96126},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2864":57908,"_25225":57906,"_5":25558,"_17592":96128,"_23859":96129,"_2388":96130},[],"/docs/pr-preview/pr-41/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2864":57909,"_25225":57906,"_5":25558,"_17592":96132,"_23859":96133,"_2388":96134},[],"/docs/pr-preview/pr-41/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2864":57910,"_25225":57906,"_5":25558,"_17592":96136,"_23859":96137,"_2388":96138},[],"/docs/pr-preview/pr-41/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2864":57911,"_25225":57906,"_17592":96140,"_5":17487,"_23859":57906,"_2388":96141},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2864":57912,"_25225":57906,"_17592":96143,"_5":17487,"_23859":96129,"_2388":96144},[],"Modelo",{"_2864":57913,"_25225":57906,"_17592":96146,"_5":17487,"_23859":96129,"_2388":96147},[],"Recomendado para",{"_2864":57914,"_25225":57906,"_17592":96149,"_5":17487,"_23859":96129,"_2388":96150},[],"Quién opera la infraestructura",{"_2864":57915,"_25225":57906,"_17592":96152,"_5":17487,"_23859":96129,"_2388":96153},[],"Punto de partida",{"_2864":57916,"_25225":57906,"_17592":96155,"_5":17487,"_23859":96129,"_2388":41037},[],{"_2864":57917,"_25225":57906,"_17592":96157,"_5":17487,"_23859":96129,"_2388":96158},[],"Producción, entornos regulados y despliegues personalizados",{"_2864":57918,"_25225":57906,"_17592":96160,"_5":17487,"_23859":96129,"_2388":96161},[],"Tu equipo",{"_2864":57919,"_25225":57906,"_17592":96163,"_5":17487,"_23859":96129,"_2388":96164},[],"Helm o Fastlane",{"_2864":57920,"_25225":57906,"_17592":96166,"_5":17487,"_23859":96129,"_2388":41049},[],{"_2864":57921,"_25225":57906,"_17592":96168,"_5":17487,"_23859":96129,"_2388":96169},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2864":57922,"_25225":57906,"_17592":96171,"_5":17487,"_23859":96129,"_2388":96161},[],{"_2864":57923,"_25225":57906,"_17592":96173,"_5":17487,"_23859":96129,"_2388":96174},[],"Imagen preconfigurada en EC2",{"_2864":57924,"_25225":57906,"_17592":96176,"_5":17487,"_23859":96129,"_2388":41060},[],{"_2864":57925,"_25225":57906,"_17592":96178,"_5":17487,"_23859":96129,"_2388":96179},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2864":57926,"_25225":57906,"_17592":96181,"_5":17487,"_23859":96129,"_2388":41066},[],{"_2864":57927,"_25225":57906,"_17592":96183,"_5":17487,"_23859":96129,"_2388":96184},[],"Suscripción gestionada",{"_2864":57928,"_25225":57906,"_17592":96186,"_5":17487,"_23859":96129,"_2388":96187},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2864":57929,"_25225":57906,"_17592":96189,"_5":17487,"_23859":96129,"_2388":96190},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2864":57930,"_25225":57906,"_17592":96192,"_5":17487,"_23859":96129,"_2388":96193},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2864":57931,"_25225":57906,"_17592":96195,"_5":17487,"_23859":96133,"_2388":96196},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2864":57932,"_25225":57906,"_17592":96198,"_5":17487,"_23859":96137,"_2388":96199},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2864":57933,"_25225":57933,"_5":12320,"_2388":96201,"_25561":96202,"_17592":96203,"_23859":57933},"Utiliza Lamassu como SaaS",[40930,96050,96051],[],{"_2864":57934,"_25225":57933,"_17592":96205,"_5":17487,"_23859":57933,"_2388":96206},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2864":57935,"_25225":57933,"_5":25558,"_17592":96208,"_23859":96209,"_2388":96210},[],"/docs/pr-preview/pr-41/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2864":57936,"_25225":57933,"_5":25558,"_17592":96212,"_23859":96213,"_2388":96214},[],"/docs/pr-preview/pr-41/es/deployment/saas#planes","Planes",{"_2864":57937,"_25225":57933,"_5":25558,"_17592":96216,"_23859":96217,"_2388":96218},[],"/docs/pr-preview/pr-41/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2864":57938,"_25225":57933,"_17592":96220,"_5":17487,"_23859":57933,"_2388":96221},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2864":57939,"_25225":57933,"_17592":96223,"_5":17487,"_23859":96209,"_2388":96224},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2864":57940,"_25225":57933,"_17592":96226,"_5":17487,"_23859":96209,"_2388":96227},[],"Copias de seguridad automáticas.",{"_2864":57941,"_25225":57933,"_17592":96229,"_5":17487,"_23859":96209,"_2388":96230},[],"Actualizaciones de versión.",{"_2864":57942,"_25225":57933,"_17592":96232,"_5":17487,"_23859":96209,"_2388":96233},[],"Soporte técnico y SLA según el plan contratado.",{"_2864":57943,"_25225":57933,"_17592":96235,"_5":17487,"_23859":96213,"_2388":41121},[],{"_2864":57944,"_25225":57933,"_17592":96237,"_5":17487,"_23859":96213,"_2388":96238},[],"Dispositivos",{"_2864":57945,"_25225":57933,"_17592":96240,"_5":17487,"_23859":96213,"_2388":96241},[],"Soporte",{"_2864":57946,"_25225":57933,"_17592":96243,"_5":17487,"_23859":96213,"_2388":41130},[],{"_2864":57947,"_25225":57933,"_17592":96245,"_5":17487,"_23859":96213,"_2388":41133},[],{"_2864":57948,"_25225":57933,"_17592":96247,"_5":17487,"_23859":96213,"_2388":96248},[],"Hasta 1.000",{"_2864":57949,"_25225":57933,"_17592":96250,"_5":17487,"_23859":96213,"_2388":41139},[],{"_2864":57950,"_25225":57933,"_17592":96252,"_5":17487,"_23859":96213,"_2388":96253},[],"99,5 %",{"_2864":57951,"_25225":57933,"_17592":96255,"_5":17487,"_23859":96213,"_2388":41145},[],{"_2864":57952,"_25225":57933,"_17592":96257,"_5":17487,"_23859":96213,"_2388":96258},[],"Hasta 10.000",{"_2864":57953,"_25225":57933,"_17592":96260,"_5":17487,"_23859":96213,"_2388":96261},[],"Email y chat",{"_2864":57954,"_25225":57933,"_17592":96263,"_5":17487,"_23859":96213,"_2388":96264},[],"99,9 %",{"_2864":57955,"_25225":57933,"_17592":96266,"_5":17487,"_23859":96213,"_2388":41157},[],{"_2864":57956,"_25225":57933,"_17592":96268,"_5":17487,"_23859":96213,"_2388":96269},[],"Ilimitados",{"_2864":57957,"_25225":57933,"_17592":96271,"_5":17487,"_23859":96213,"_2388":96272},[],"Dedicado",{"_2864":57958,"_25225":57933,"_17592":96274,"_5":17487,"_23859":96213,"_2388":96275},[],"99,99 %",{"_2864":57959,"_25225":57933,"_17592":96277,"_5":17487,"_23859":96217,"_2388":96278},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2864":57960,"_25225":57933,"_17592":96280,"_5":17487,"_23859":96217,"_2388":96281},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2864":57961,"_25225":57961,"_5":12320,"_2388":41174,"_25561":96283,"_17592":96285,"_23859":57961},[40930,96050,96284],"Kubernetes autogestionado",[],{"_2864":57962,"_25225":57961,"_17592":96287,"_5":17487,"_23859":57961,"_2388":96288},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2864":57963,"_25225":57961,"_5":25558,"_17592":96290,"_23859":96291,"_2388":96292},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2864":57964,"_25225":57961,"_5":25558,"_17592":96294,"_23859":96295,"_2388":96296},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2864":57965,"_25225":57961,"_5":25558,"_17592":96298,"_23859":96299,"_2388":96300},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2864":57966,"_25225":57961,"_5":25558,"_17592":96302,"_23859":96303,"_2388":96304},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2864":57967,"_25225":57961,"_5":25558,"_17592":96306,"_23859":96307,"_2388":96308},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2864":57968,"_25225":57961,"_5":25558,"_17592":96310,"_23859":96311,"_2388":96312},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2864":57969,"_25225":57961,"_5":25558,"_17592":96314,"_23859":96315,"_2388":96316},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2864":57970,"_25225":57961,"_5":25558,"_17592":96318,"_23859":96319,"_2388":96320},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2864":57971,"_25225":57961,"_5":25558,"_17592":96322,"_23859":96323,"_2388":96324},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2864":57972,"_25225":57961,"_5":25558,"_17592":96326,"_23859":96327,"_2388":96328},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2864":57973,"_25225":57961,"_17592":96330,"_5":17487,"_23859":96291,"_2388":96331},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2864":57974,"_25225":57961,"_17592":96333,"_5":17487,"_23859":96291,"_2388":96334},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2864":57975,"_25225":57961,"_17592":96336,"_5":17487,"_23859":96295,"_2388":96337},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2864":57976,"_25225":57961,"_17592":96339,"_5":17487,"_23859":96295,"_2388":96340},[],"Fastlane instala o configura",{"_2864":57977,"_25225":57961,"_17592":96342,"_5":17487,"_23859":96295,"_2388":96343},[],"Tú sigues proporcionando",{"_2864":57978,"_25225":57961,"_17592":96345,"_5":17487,"_23859":96295,"_2388":96346},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2864":57979,"_25225":57961,"_17592":96348,"_5":17487,"_23859":96295,"_2388":96349},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2864":57980,"_25225":57961,"_17592":96351,"_5":17487,"_23859":96295,"_2388":96352},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2864":57981,"_25225":57961,"_17592":96354,"_5":17487,"_23859":96295,"_2388":96355},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2864":57982,"_25225":57961,"_17592":96357,"_5":17487,"_23859":96295,"_2388":96358},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2864":57983,"_25225":57961,"_17592":96360,"_5":17487,"_23859":96295,"_2388":96361},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2864":57984,"_25225":57961,"_17592":96363,"_5":17487,"_23859":96295,"_2388":96364},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2864":57985,"_25225":57961,"_17592":96366,"_5":17487,"_23859":96295,"_2388":96367},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2864":57986,"_25225":57961,"_17592":96369,"_5":17487,"_23859":96295,"_2388":96370},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2864":57987,"_25225":57961,"_17592":96372,"_5":17487,"_23859":96299,"_2388":96373},[],"Necesitas:",{"_2864":57988,"_25225":57961,"_17592":96375,"_5":17487,"_23859":96299,"_2388":96376},[],"un clúster Kubernetes existente",{"_2864":57989,"_25225":57961,"_17592":96378,"_5":17487,"_23859":96299,"_2388":96379},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2864":57990,"_25225":57961,"_17592":96381,"_5":17487,"_23859":96299,"_2388":41272},[],{"_2864":57991,"_25225":57961,"_17592":96383,"_5":17487,"_23859":96299,"_2388":19906},[],{"_2864":57992,"_25225":57961,"_17592":96385,"_5":17487,"_23859":96299,"_2388":96386},[],"`jq` solo si usas `--sample-data`",{"_2864":57993,"_25225":57961,"_17592":96388,"_5":17487,"_23859":96299,"_2388":96389},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2864":57994,"_25225":57961,"_17592":96391,"_5":17487,"_23859":96299,"_2388":96392},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2864":57995,"_25225":57961,"_17592":96394,"_5":17487,"_23859":96299,"_2388":96395},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2864":57996,"_25225":57961,"_17592":96397,"_5":17487,"_23859":96303,"_2388":96398},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2864":57997,"_25225":57961,"_17592":96400,"_5":17487,"_23859":96303,"_2388":96401},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2864":57998,"_25225":57961,"_17592":96403,"_5":17487,"_23859":96307,"_2388":96404},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2864":57999,"_25225":57961,"_17592":96406,"_5":17487,"_23859":96307,"_2388":96407},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2864":58000,"_25225":57961,"_17592":96409,"_5":17487,"_23859":96307,"_2388":96410},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2864":58001,"_25225":57961,"_17592":96412,"_5":17487,"_23859":96307,"_2388":96413},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2864":58002,"_25225":57961,"_17592":96415,"_5":17487,"_23859":96311,"_2388":96416},[],"Opción",{"_2864":58003,"_25225":57961,"_17592":96418,"_5":17487,"_23859":96311,"_2388":96419},[],"Valor predeterminado",{"_2864":58004,"_25225":57961,"_17592":96421,"_5":17487,"_23859":96311,"_2388":96422},[],"Propósito",{"_2864":58005,"_25225":57961,"_17592":96424,"_5":17487,"_23859":96311,"_2388":41316},[],{"_2864":58006,"_25225":57961,"_17592":96426,"_5":17487,"_23859":96311,"_2388":41319},[],{"_2864":58007,"_25225":57961,"_17592":96428,"_5":17487,"_23859":96311,"_2388":96429},[],"Muestra la ayuda",{"_2864":58008,"_25225":57961,"_17592":96431,"_5":17487,"_23859":96311,"_2388":41325},[],{"_2864":58009,"_25225":57961,"_17592":96433,"_5":17487,"_23859":96311,"_2388":96434},[],"contexto actual",{"_2864":58010,"_25225":57961,"_17592":96436,"_5":17487,"_23859":96311,"_2388":96437},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2864":58011,"_25225":57961,"_17592":96439,"_5":17487,"_23859":96311,"_2388":41334},[],{"_2864":58012,"_25225":57961,"_17592":96441,"_5":17487,"_23859":96311,"_2388":5376},[],{"_2864":58013,"_25225":57961,"_17592":96443,"_5":17487,"_23859":96311,"_2388":96444},[],"Omite prompts y genera credenciales para las dependencias",{"_2864":58014,"_25225":57961,"_17592":96446,"_5":17487,"_23859":96311,"_2388":41342},[],{"_2864":58015,"_25225":57961,"_17592":96448,"_5":17487,"_23859":96311,"_2388":41345},[],{"_2864":58016,"_25225":57961,"_17592":96450,"_5":17487,"_23859":96311,"_2388":96451},[],"Namespace de la instalación",{"_2864":58017,"_25225":57961,"_17592":96453,"_5":17487,"_23859":96311,"_2388":41351},[],{"_2864":58018,"_25225":57961,"_17592":96455,"_5":17487,"_23859":96311,"_2388":41354},[],{"_2864":58019,"_25225":57961,"_17592":96457,"_5":17487,"_23859":96311,"_2388":96458},[],"Dominio usado por la UI, OIDC y el certificado",{"_2864":58020,"_25225":57961,"_17592":96460,"_5":17487,"_23859":96311,"_2388":41360},[],{"_2864":58021,"_25225":57961,"_17592":96462,"_5":17487,"_23859":96311,"_2388":12546},[],{"_2864":58022,"_25225":57961,"_17592":96464,"_5":17487,"_23859":96311,"_2388":96465},[],"Versión del chart de Lamassu",{"_2864":58023,"_25225":57961,"_17592":96467,"_5":17487,"_23859":96311,"_2388":41368},[],{"_2864":58024,"_25225":57961,"_17592":96469,"_5":17487,"_23859":96311,"_2388":41371},[],{"_2864":58025,"_25225":57961,"_17592":96471,"_5":17487,"_23859":96311,"_2388":96472},[],"Puerto del listener HTTPS",{"_2864":58026,"_25225":57961,"_17592":96474,"_5":17487,"_23859":96311,"_2388":41377},[],{"_2864":58027,"_25225":57961,"_17592":96476,"_5":17487,"_23859":96311,"_2388":41380},[],{"_2864":58028,"_25225":57961,"_17592":96478,"_5":17487,"_23859":96311,"_2388":96479},[],"Puerto del listener HTTP",{"_2864":58029,"_25225":57961,"_17592":96481,"_5":17487,"_23859":96311,"_2388":41386},[],{"_2864":58030,"_25225":57961,"_17592":96483,"_5":17487,"_23859":96311,"_2388":41319},[],{"_2864":58031,"_25225":57961,"_17592":96485,"_5":17487,"_23859":96311,"_2388":96486},[],"Certificado PEM para TLS downstream",{"_2864":58032,"_25225":57961,"_17592":96488,"_5":17487,"_23859":96311,"_2388":41394},[],{"_2864":58033,"_25225":57961,"_17592":96490,"_5":17487,"_23859":96311,"_2388":41319},[],{"_2864":58034,"_25225":57961,"_17592":96492,"_5":17487,"_23859":96311,"_2388":96493},[],"Clave privada PEM para TLS downstream",{"_2864":58035,"_25225":57961,"_17592":96495,"_5":17487,"_23859":96311,"_2388":41402},[],{"_2864":58036,"_25225":57961,"_17592":96497,"_5":17487,"_23859":96311,"_2388":96498},[],"chart del repositorio",{"_2864":58037,"_25225":57961,"_17592":96500,"_5":17487,"_23859":96311,"_2388":96501},[],"Usa un chart local de Lamassu sin empaquetar",{"_2864":58038,"_25225":57961,"_17592":96503,"_5":17487,"_23859":96311,"_2388":41411},[],{"_2864":58039,"_25225":57961,"_17592":96505,"_5":17487,"_23859":96311,"_2388":96506},[],"detección automática",{"_2864":58040,"_25225":57961,"_17592":96508,"_5":17487,"_23859":96311,"_2388":96509},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2864":58041,"_25225":57961,"_17592":96511,"_5":17487,"_23859":96311,"_2388":41419},[],{"_2864":58042,"_25225":57961,"_17592":96513,"_5":17487,"_23859":96311,"_2388":5376},[],{"_2864":58043,"_25225":57961,"_17592":96515,"_5":17487,"_23859":96311,"_2388":96516},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2864":58044,"_25225":57961,"_17592":96518,"_5":17487,"_23859":96311,"_2388":41427},[],{"_2864":58045,"_25225":57961,"_17592":96520,"_5":17487,"_23859":96311,"_2388":5376},[],{"_2864":58046,"_25225":57961,"_17592":96522,"_5":17487,"_23859":96311,"_2388":96523},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2864":58047,"_25225":57961,"_17592":96525,"_5":17487,"_23859":96311,"_2388":41435},[],{"_2864":58048,"_25225":57961,"_17592":96527,"_5":17487,"_23859":96311,"_2388":5376},[],{"_2864":58049,"_25225":57961,"_17592":96529,"_5":17487,"_23859":96311,"_2388":96530},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2864":58050,"_25225":57961,"_17592":96532,"_5":17487,"_23859":96311,"_2388":41443},[],{"_2864":58051,"_25225":57961,"_17592":96534,"_5":17487,"_23859":96311,"_2388":41446},[],{"_2864":58052,"_25225":57961,"_17592":96536,"_5":17487,"_23859":96311,"_2388":96537},[],"Usa otro chart local de SoftHSM",{"_2864":58053,"_25225":57961,"_17592":96539,"_5":17487,"_23859":96311,"_2388":96540},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2864":58054,"_25225":57961,"_17592":96542,"_5":17487,"_23859":96315,"_2388":41455},[],{"_2864":58055,"_25225":57961,"_17592":96544,"_5":17487,"_23859":96315,"_2388":96545},[],"valida las herramientas locales y el clúster seleccionado",{"_2864":58056,"_25225":57961,"_17592":96547,"_5":17487,"_23859":96315,"_2388":96548},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2864":58057,"_25225":57961,"_17592":96550,"_5":17487,"_23859":96315,"_2388":96551},[],"crea el namespace",{"_2864":58058,"_25225":57961,"_17592":96553,"_5":17487,"_23859":96315,"_2388":96554},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2864":58059,"_25225":57961,"_17592":96556,"_5":17487,"_23859":96315,"_2388":96557},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2864":58060,"_25225":57961,"_17592":96559,"_5":17487,"_23859":96315,"_2388":96560},[],"instala RabbitMQ",{"_2864":58061,"_25225":57961,"_17592":96562,"_5":17487,"_23859":96315,"_2388":96563},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2864":58062,"_25225":57961,"_17592":96565,"_5":17487,"_23859":96315,"_2388":96566},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2864":58063,"_25225":57961,"_17592":96568,"_5":17487,"_23859":96315,"_2388":96569},[],"carga datos de ejemplo opcionalmente",{"_2864":58064,"_25225":57961,"_17592":96571,"_5":17487,"_23859":96315,"_2388":96572},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2864":58065,"_25225":57961,"_17592":96574,"_5":17487,"_23859":96319,"_2388":96575},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2864":58066,"_25225":57961,"_17592":96577,"_5":17487,"_23859":96319,"_2388":96578},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2864":58067,"_25225":57961,"_17592":96580,"_5":17487,"_23859":96323,"_2388":96581},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2864":58068,"_25225":57961,"_17592":96583,"_5":17487,"_23859":96323,"_2388":96584},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2864":58069,"_25225":57961,"_17592":96586,"_5":17487,"_23859":96323,"_2388":96587},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2864":58070,"_25225":57961,"_17592":96589,"_5":17487,"_23859":96327,"_2388":96590},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2864":58071,"_25225":58071,"_5":12320,"_2388":96592,"_25561":96593,"_17592":96594,"_23859":58071},"Instala con Helm",[40930,96050,96284],[],{"_2864":58072,"_25225":58071,"_17592":96596,"_5":17487,"_23859":58071,"_2388":96597},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2864":58073,"_25225":58071,"_5":25558,"_17592":96599,"_23859":96600,"_2388":96601},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2864":58074,"_25225":58071,"_5":25558,"_17592":96603,"_23859":96604,"_2388":96300},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2864":58075,"_25225":58071,"_5":25558,"_17592":96606,"_23859":96607,"_2388":96608},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2864":58076,"_25225":58071,"_5":25558,"_17592":96610,"_23859":96611,"_2388":96612},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2864":58077,"_25225":58071,"_5":25558,"_17592":96614,"_23859":96615,"_2388":96616},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2864":58078,"_25225":58071,"_5":25558,"_17592":96618,"_23859":96619,"_2388":96620},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2864":58079,"_25225":58071,"_5":25558,"_17592":96622,"_23859":96623,"_2388":96624},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2864":58080,"_25225":58071,"_5":25558,"_17592":96626,"_23859":96627,"_2388":96628},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2864":58081,"_25225":58071,"_5":25558,"_17592":96630,"_23859":96631,"_2388":96632},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2864":58082,"_25225":58071,"_17592":96634,"_5":17487,"_23859":96600,"_2388":96635},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2864":58083,"_25225":58071,"_17592":96637,"_5":17487,"_23859":96604,"_2388":96638},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2864":58084,"_25225":58071,"_17592":96640,"_5":17487,"_23859":96604,"_2388":96641},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2864":58085,"_25225":58071,"_17592":96643,"_5":17487,"_23859":96604,"_2388":96644},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2864":58086,"_25225":58071,"_17592":96646,"_5":17487,"_23859":96604,"_2388":96647},[],"un broker RabbitMQ accesible y sus credenciales",{"_2864":58087,"_25225":58071,"_17592":96649,"_5":17487,"_23859":96604,"_2388":96650},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2864":58088,"_25225":58071,"_17592":96652,"_5":17487,"_23859":96604,"_2388":96653},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2864":58089,"_25225":58071,"_17592":96655,"_5":17487,"_23859":96604,"_2388":96656},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2864":58090,"_25225":58071,"_17592":96658,"_5":17487,"_23859":96604,"_2388":96659},[],"una StorageClass y un diseño de tráfico externo",{"_2864":58091,"_25225":58071,"_17592":96661,"_5":17487,"_23859":96604,"_2388":96662},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2864":58092,"_25225":58071,"_17592":96664,"_5":17487,"_23859":96604,"_2388":96665},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2864":58093,"_25225":58071,"_17592":96667,"_5":17487,"_23859":96604,"_2388":96668},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2864":58094,"_25225":58071,"_17592":96670,"_5":17487,"_23859":96607,"_2388":96671},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2864":58095,"_25225":58071,"_17592":96673,"_5":17487,"_23859":96607,"_2388":96674},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2864":58096,"_25225":58071,"_17592":96676,"_5":17487,"_23859":96607,"_2388":96677},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2864":58097,"_25225":58071,"_17592":96679,"_5":17487,"_23859":96611,"_2388":96680},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2864":58098,"_25225":58071,"_17592":96682,"_5":17487,"_23859":96611,"_2388":96683},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2864":58099,"_25225":58071,"_17592":96685,"_5":17487,"_23859":96611,"_2388":96686},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2864":58100,"_25225":58071,"_17592":96688,"_5":17487,"_23859":96615,"_2388":96689},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2864":58101,"_25225":58071,"_17592":96691,"_5":17487,"_23859":96619,"_2388":96692},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2864":58102,"_25225":58071,"_17592":96694,"_5":17487,"_23859":96619,"_2388":96695},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2864":58103,"_25225":58071,"_17592":96697,"_5":17487,"_23859":96619,"_2388":96698},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2864":58104,"_25225":58071,"_17592":96700,"_5":17487,"_23859":96619,"_2388":96701},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2864":58105,"_25225":58071,"_17592":96703,"_5":17487,"_23859":96623,"_2388":96704},[],"Para instalar un checkout local:",{"_2864":58106,"_25225":58071,"_17592":96706,"_5":17487,"_23859":96627,"_2388":96707},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2864":58107,"_25225":58071,"_17592":96709,"_5":17487,"_23859":96627,"_2388":96710},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2864":58108,"_25225":58071,"_17592":96712,"_5":17487,"_23859":96631,"_2388":96713},[],"Antes de pasar a producción, revisa:",{"_2864":58109,"_25225":58071,"_17592":96715,"_5":17487,"_23859":96631,"_2388":96716},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2864":58110,"_25225":58071,"_17592":96718,"_5":17487,"_23859":96631,"_2388":96719},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2864":58111,"_25225":58071,"_17592":96721,"_5":17487,"_23859":96631,"_2388":96722},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2864":58112,"_25225":58071,"_17592":96724,"_5":17487,"_23859":96631,"_2388":96725},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2864":58113,"_25225":58071,"_17592":96727,"_5":17487,"_23859":96631,"_2388":96728},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2864":58114,"_25225":58071,"_17592":96730,"_5":17487,"_23859":96631,"_2388":96731},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2864":58115,"_25225":58071,"_17592":96733,"_5":17487,"_23859":96631,"_2388":96734},[],"SMTP, observabilidad y entrega de alertas",{"_2864":58116,"_25225":58071,"_17592":96736,"_5":17487,"_23859":96631,"_2388":96737},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2864":58117,"_25225":58071,"_17592":96739,"_5":17487,"_23859":96631,"_2388":96740},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2864":58118,"_25225":58118,"_5":12320,"_2388":96742,"_25561":96743,"_17592":96744,"_23859":58118},"Expón el Gateway",[40930,96050,96284],[],{"_2864":58119,"_25225":58118,"_17592":96746,"_5":17487,"_23859":58118,"_2388":96747},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2864":58120,"_25225":58118,"_5":25558,"_17592":96749,"_23859":96750,"_2388":96751},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2864":58121,"_25225":58118,"_5":25558,"_17592":96753,"_23859":96754,"_2388":96755},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2864":58122,"_25225":58118,"_5":25558,"_17592":96757,"_23859":96758,"_2388":96759},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2864":58123,"_25225":58118,"_5":25558,"_17592":96761,"_23859":96762,"_2388":41676},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/networking#k3s",{"_2864":58124,"_25225":58118,"_5":25558,"_17592":96764,"_23859":96765,"_2388":96766},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2864":58125,"_25225":58118,"_5":25558,"_17592":96768,"_23859":96769,"_2388":96770},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2864":58126,"_25225":58118,"_5":25558,"_17592":96772,"_23859":96773,"_2388":96774},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2864":58127,"_25225":58118,"_5":25558,"_17592":96776,"_23859":96777,"_2388":96778},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2864":58128,"_25225":58118,"_5":25558,"_17592":96780,"_23859":96781,"_2388":96782},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_2864":58129,"_25225":58118,"_5":25558,"_17592":96784,"_23859":96785,"_2388":96786},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2864":58130,"_25225":58118,"_17592":96788,"_5":17487,"_23859":96750,"_2388":96789},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2864":58131,"_25225":58118,"_17592":96791,"_5":17487,"_23859":96750,"_2388":96792},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2864":58132,"_25225":58118,"_17592":96794,"_5":17487,"_23859":96754,"_2388":96795},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2864":58133,"_25225":58118,"_17592":96797,"_5":17487,"_23859":96754,"_2388":96798},[],"Defínelo únicamente cuando:",{"_2864":58134,"_25225":58118,"_17592":96800,"_5":17487,"_23859":96754,"_2388":96801},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2864":58135,"_25225":58118,"_17592":96803,"_5":17487,"_23859":96754,"_2388":96804},[],"esa dirección está asignada a este Gateway",{"_2864":58136,"_25225":58118,"_17592":96806,"_5":17487,"_23859":96754,"_2388":96807},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2864":58137,"_25225":58118,"_17592":96809,"_5":17487,"_23859":96754,"_2388":96810},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2864":58138,"_25225":58118,"_17592":96812,"_5":17487,"_23859":96754,"_2388":96813},[],"No confundas estos valores:",{"_2864":58139,"_25225":58118,"_17592":96815,"_5":17487,"_23859":96754,"_2388":96816},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2864":58140,"_25225":58118,"_17592":96818,"_5":17487,"_23859":96754,"_2388":96819},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2864":58141,"_25225":58118,"_17592":96821,"_5":17487,"_23859":96754,"_2388":96822},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2864":58142,"_25225":58118,"_17592":96824,"_5":17487,"_23859":96758,"_2388":96825},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2864":58143,"_25225":58118,"_17592":96827,"_5":17487,"_23859":96758,"_2388":96828},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2864":58144,"_25225":58118,"_17592":96830,"_5":17487,"_23859":96762,"_2388":96831},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2864":58145,"_25225":58118,"_17592":96833,"_5":17487,"_23859":96762,"_2388":96834},[],"Para el diseño recomendado:",{"_2864":58146,"_25225":58118,"_17592":96836,"_5":17487,"_23859":96762,"_2388":96837},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2864":58147,"_25225":58118,"_17592":96839,"_5":17487,"_23859":96762,"_2388":96840},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2864":58148,"_25225":58118,"_17592":96842,"_5":17487,"_23859":96762,"_2388":96843},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2864":58149,"_25225":58118,"_17592":96845,"_5":17487,"_23859":96762,"_2388":96846},[],"Apunta DNS a la dirección accesible de la VM.",{"_2864":58150,"_25225":58118,"_17592":96848,"_5":17487,"_23859":96762,"_2388":96849},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2864":58151,"_25225":58118,"_17592":96851,"_5":17487,"_23859":96765,"_2388":96852},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2864":58152,"_25225":58118,"_17592":96854,"_5":17487,"_23859":96769,"_2388":96855},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2864":58153,"_25225":58118,"_17592":96857,"_5":17487,"_23859":96769,"_2388":96858},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2864":58154,"_25225":58118,"_17592":96860,"_5":17487,"_23859":96773,"_2388":96861},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2864":58155,"_25225":58118,"_17592":96863,"_5":17487,"_23859":96773,"_2388":96864},[],"Requisito",{"_2864":58156,"_25225":58118,"_17592":96866,"_5":17487,"_23859":96773,"_2388":96867},[],"Diseño recomendado",{"_2864":58157,"_25225":58118,"_17592":96869,"_5":17487,"_23859":96773,"_2388":96870},[],"Consecuencia",{"_2864":58158,"_25225":58118,"_17592":96872,"_5":17487,"_23859":96773,"_2388":96873},[],"Varias URL o servicios de Lamassu",{"_2864":58159,"_25225":58118,"_17592":96875,"_5":17487,"_23859":96773,"_2388":96876},[],"Un Gateway con varias rutas",{"_2864":58160,"_25225":58118,"_17592":96878,"_5":17487,"_23859":96773,"_2388":96879},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2864":58161,"_25225":58118,"_17592":96881,"_5":17487,"_23859":96773,"_2388":96882},[],"Gateways independientes e IP externas distintas",{"_2864":58162,"_25225":58118,"_17592":96884,"_5":17487,"_23859":96773,"_2388":96885},[],"Una VIP por Gateway",{"_2864":58163,"_25225":58118,"_17592":96887,"_5":17487,"_23859":96773,"_2388":96888},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2864":58164,"_25225":58118,"_17592":96890,"_5":17487,"_23859":96773,"_2388":96891},[],"Gateways independientes, un nodo y una IP",{"_2864":58165,"_25225":58118,"_17592":96893,"_5":17487,"_23859":96773,"_2388":96894},[],"Puertos externos diferentes",{"_2864":58166,"_25225":58118,"_17592":96896,"_5":17487,"_23859":96773,"_2388":96897},[],"Los clientes deben indicar puertos no estándar",{"_2864":58167,"_25225":58118,"_17592":96899,"_5":17487,"_23859":96773,"_2388":96900},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2864":58168,"_25225":58118,"_17592":96902,"_5":17487,"_23859":96773,"_2388":96903},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2864":58169,"_25225":58118,"_17592":96905,"_5":17487,"_23859":96773,"_2388":96906},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2864":58170,"_25225":58118,"_17592":96908,"_5":17487,"_23859":96773,"_2388":96909},[],"Recursos Gateway separados pero proxy compartido",{"_2864":58171,"_25225":58118,"_17592":96911,"_5":17487,"_23859":96773,"_2388":96912},[],"Modo merged Gateway de Envoy",{"_2864":58172,"_25225":58118,"_17592":96914,"_5":17487,"_23859":96773,"_2388":96915},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2864":58173,"_25225":58118,"_17592":96917,"_5":17487,"_23859":96773,"_2388":96918},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2864":58174,"_25225":58118,"_17592":96920,"_5":17487,"_23859":96773,"_2388":96921},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2864":58175,"_25225":58118,"_17592":96923,"_5":17487,"_23859":96773,"_2388":96924},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2864":58176,"_25225":58118,"_17592":96926,"_5":17487,"_23859":96773,"_2388":96927},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2864":58177,"_25225":58118,"_17592":96929,"_5":17487,"_23859":96777,"_2388":96930},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2864":58178,"_25225":58118,"_17592":96932,"_5":17487,"_23859":96777,"_2388":96933},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2864":58179,"_25225":58118,"_17592":96935,"_5":17487,"_23859":96777,"_2388":96936},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2864":58180,"_25225":58118,"_17592":96938,"_5":17487,"_23859":96777,"_2388":96939},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2864":58181,"_25225":58118,"_17592":96941,"_5":17487,"_23859":96777,"_2388":96942},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2864":58182,"_25225":58118,"_17592":96944,"_5":17487,"_23859":96781,"_2388":96945},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_2864":58183,"_25225":58118,"_17592":96947,"_5":17487,"_23859":96781,"_2388":96948},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_2864":58184,"_25225":58118,"_17592":96950,"_5":17487,"_23859":96785,"_2388":96951},[],"Comprueba, en orden:",{"_2864":58185,"_25225":58118,"_17592":96953,"_5":17487,"_23859":96785,"_2388":96954},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2864":58186,"_25225":58118,"_17592":96956,"_5":17487,"_23859":96785,"_2388":96957},[],"Su estado contiene la dirección esperada.",{"_2864":58187,"_25225":58118,"_17592":96959,"_5":17487,"_23859":96785,"_2388":96960},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2864":58188,"_25225":58118,"_17592":96962,"_5":17487,"_23859":96785,"_2388":96963},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2864":58189,"_25225":58118,"_17592":96965,"_5":17487,"_23859":96785,"_2388":96966},[],"DNS resuelve al endpoint accesible externamente.",{"_2864":58190,"_25225":58118,"_17592":96968,"_5":17487,"_23859":96785,"_2388":96969},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2864":58191,"_25225":58118,"_17592":96971,"_5":17487,"_23859":96785,"_2388":96972},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2864":58192,"_25225":58192,"_5":12320,"_2388":41037,"_25561":96974,"_17592":96975,"_23859":58192},[40930,96050,96284],[],{"_2864":58193,"_25225":58192,"_17592":96977,"_5":17487,"_23859":58192,"_2388":96978},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2864":58194,"_25225":58192,"_5":25558,"_17592":96980,"_23859":96981,"_2388":96982},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2864":58195,"_25225":58192,"_5":25558,"_17592":96984,"_23859":96985,"_2388":96986},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2864":58196,"_25225":58192,"_5":25558,"_17592":96988,"_23859":96989,"_2388":96990},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2864":58197,"_25225":58192,"_5":25558,"_17592":96992,"_23859":96993,"_2388":96994},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2864":58198,"_25225":58192,"_5":25558,"_17592":96996,"_23859":96997,"_2388":96998},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2864":58199,"_25225":58192,"_5":25558,"_17592":97000,"_23859":97001,"_2388":97002},[],"/docs/pr-preview/pr-41/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2864":58200,"_25225":58192,"_17592":97004,"_5":17487,"_23859":96981,"_2388":97005},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2864":58201,"_25225":58192,"_17592":97007,"_5":17487,"_23859":96985,"_2388":97008},[],"Flujo",{"_2864":58202,"_25225":58192,"_17592":97010,"_5":17487,"_23859":96985,"_2388":97011},[],"Úsalo para",{"_2864":58203,"_25225":58192,"_17592":97013,"_5":17487,"_23859":96985,"_2388":97014},[],"Qué instala",{"_2864":58204,"_25225":58192,"_17592":97016,"_5":17487,"_23859":96985,"_2388":41931},[],{"_2864":58205,"_25225":58192,"_17592":97018,"_5":17487,"_23859":96985,"_2388":97019},[],"Producción y entornos controlados",{"_2864":58206,"_25225":58192,"_17592":97021,"_5":17487,"_23859":96985,"_2388":97022},[],"Servicios de Lamassu y recursos de Gateway API",{"_2864":58207,"_25225":58192,"_17592":97024,"_5":17487,"_23859":96985,"_2388":41174},[],{"_2864":58208,"_25225":58192,"_17592":97026,"_5":17487,"_23859":96985,"_2388":97027},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2864":58209,"_25225":58192,"_17592":97029,"_5":17487,"_23859":96985,"_2388":97030},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2864":58210,"_25225":58192,"_17592":97032,"_5":17487,"_23859":96989,"_2388":97033},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2864":58211,"_25225":58192,"_17592":97035,"_5":17487,"_23859":96989,"_2388":97036},[],"Área",{"_2864":58212,"_25225":58192,"_17592":97038,"_5":17487,"_23859":96989,"_2388":97039},[],"El chart de Lamassu proporciona",{"_2864":58213,"_25225":58192,"_17592":97041,"_5":17487,"_23859":96989,"_2388":97042},[],"Tú proporcionas",{"_2864":58214,"_25225":58192,"_17592":97044,"_5":17487,"_23859":96989,"_2388":97045},[],"Aplicaciones Lamassu",{"_2864":58215,"_25225":58192,"_17592":97047,"_5":17487,"_23859":96989,"_2388":97048},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2864":58216,"_25225":58192,"_17592":97050,"_5":17487,"_23859":96989,"_2388":97051},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2864":58217,"_25225":58192,"_17592":97053,"_5":17487,"_23859":96989,"_2388":97054},[],"Datos PostgreSQL",{"_2864":58218,"_25225":58192,"_17592":97056,"_5":17487,"_23859":96989,"_2388":97057},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2864":58219,"_25225":58192,"_17592":97059,"_5":17487,"_23859":96989,"_2388":97060},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2864":58220,"_25225":58192,"_17592":97062,"_5":17487,"_23859":96989,"_2388":97063},[],"Mensajería",{"_2864":58221,"_25225":58192,"_17592":97065,"_5":17487,"_23859":96989,"_2388":97066},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2864":58222,"_25225":58192,"_17592":97068,"_5":17487,"_23859":96989,"_2388":97069},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2864":58223,"_25225":58192,"_17592":97071,"_5":17487,"_23859":96989,"_2388":97072},[],"Identidad",{"_2864":58224,"_25225":58192,"_17592":97074,"_5":17487,"_23859":96989,"_2388":97075},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2864":58225,"_25225":58192,"_17592":97077,"_5":17487,"_23859":96989,"_2388":97078},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2864":58226,"_25225":58192,"_17592":97080,"_5":17487,"_23859":96989,"_2388":97081},[],"Enrutamiento externo",{"_2864":58227,"_25225":58192,"_17592":97083,"_5":17487,"_23859":96989,"_2388":97084},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2864":58228,"_25225":58192,"_17592":97086,"_5":17487,"_23859":96989,"_2388":97087},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2864":58229,"_25225":58192,"_17592":97089,"_5":17487,"_23859":96989,"_2388":42005},[],{"_2864":58230,"_25225":58192,"_17592":97091,"_5":17487,"_23859":96989,"_2388":97092},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2864":58231,"_25225":58192,"_17592":97094,"_5":17487,"_23859":96989,"_2388":97095},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2864":58232,"_25225":58192,"_17592":97097,"_5":17487,"_23859":96989,"_2388":97098},[],"Datos persistentes de la aplicación",{"_2864":58233,"_25225":58192,"_17592":97100,"_5":17487,"_23859":96989,"_2388":97101},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2864":58234,"_25225":58192,"_17592":97103,"_5":17487,"_23859":96989,"_2388":97104},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2864":58235,"_25225":58192,"_17592":97106,"_5":17487,"_23859":96989,"_2388":97107},[],"Integraciones opcionales",{"_2864":58236,"_25225":58192,"_17592":97109,"_5":17487,"_23859":96989,"_2388":97110},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2864":58237,"_25225":58192,"_17592":97112,"_5":17487,"_23859":96989,"_2388":97113},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2864":58238,"_25225":58192,"_17592":97115,"_5":17487,"_23859":96989,"_2388":97116},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2864":58239,"_25225":58192,"_17592":97118,"_5":17487,"_23859":96989,"_2388":97119},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2864":58240,"_25225":58192,"_17592":97121,"_5":17487,"_23859":96993,"_2388":97122},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2864":58241,"_25225":58192,"_17592":97124,"_5":17487,"_23859":96993,"_2388":97125},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2864":58242,"_25225":58192,"_17592":97127,"_5":17487,"_23859":96997,"_2388":97128},[],"Kubernetes 1.24 o posterior",{"_2864":58243,"_25225":58192,"_17592":97130,"_5":17487,"_23859":96997,"_2388":97131},[],"Helm 3.2 o posterior",{"_2864":58244,"_25225":58192,"_17592":97133,"_5":17487,"_23859":96997,"_2388":97134},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2864":58245,"_25225":58192,"_17592":97136,"_5":17487,"_23859":96997,"_2388":97137},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2864":58246,"_25225":58192,"_17592":97139,"_5":17487,"_23859":96997,"_2388":97140},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2864":58247,"_25225":58192,"_17592":97142,"_5":17487,"_23859":96997,"_2388":97143},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2864":58248,"_25225":58192,"_17592":97145,"_5":17487,"_23859":96997,"_2388":97146},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2864":58249,"_25225":58192,"_17592":97148,"_5":17487,"_23859":97001,"_2388":97149},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2864":58250,"_25225":58192,"_17592":97151,"_5":17487,"_23859":97001,"_2388":97152},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2864":58251,"_25225":58192,"_17592":97154,"_5":17487,"_23859":97001,"_2388":97155},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2864":58252,"_25225":58252,"_5":12320,"_2388":97157,"_25561":97158,"_17592":97160,"_23859":58252},"Resolución de problemas de despliegue",[40930,96050,97159],"Operación",[],{"_2864":58253,"_25225":58252,"_17592":97162,"_5":17487,"_23859":58252,"_2388":97163},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2864":58254,"_25225":58252,"_5":25558,"_17592":97165,"_23859":97166,"_2388":97167},[],"/docs/pr-preview/pr-41/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2864":58255,"_25225":58252,"_5":25558,"_17592":97169,"_23859":97170,"_2388":97171},[],"/docs/pr-preview/pr-41/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2864":58256,"_25225":58252,"_5":25558,"_17592":97173,"_23859":97174,"_2388":97175},[],"/docs/pr-preview/pr-41/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2864":58257,"_25225":58252,"_5":25558,"_17592":97177,"_23859":97178,"_2388":97179},[],"/docs/pr-preview/pr-41/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2864":58258,"_25225":58252,"_5":25558,"_17592":97181,"_23859":97182,"_2388":97183},[],"/docs/pr-preview/pr-41/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2864":58259,"_25225":58252,"_5":25558,"_17592":97185,"_23859":97186,"_2388":97187},[],"/docs/pr-preview/pr-41/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2864":58260,"_25225":58252,"_5":25558,"_17592":97189,"_23859":97190,"_2388":97191},[],"/docs/pr-preview/pr-41/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2864":58261,"_25225":58252,"_5":25558,"_17592":97193,"_23859":97194,"_2388":97195},[],"/docs/pr-preview/pr-41/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2864":58262,"_25225":58252,"_5":25558,"_17592":97197,"_23859":97198,"_2388":97199},[],"/docs/pr-preview/pr-41/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2864":58263,"_25225":58252,"_5":25558,"_17592":97201,"_23859":97202,"_2388":97203},[],"/docs/pr-preview/pr-41/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2864":58264,"_25225":58252,"_5":25558,"_17592":97205,"_23859":97206,"_2388":97207},[],"/docs/pr-preview/pr-41/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2864":58265,"_25225":58252,"_5":25558,"_17592":97209,"_23859":97210,"_2388":97211},[],"/docs/pr-preview/pr-41/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2864":58266,"_25225":58252,"_17592":97213,"_5":17487,"_23859":58252,"_2388":97214},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2864":58267,"_25225":58252,"_17592":97216,"_5":17487,"_23859":97170,"_2388":97217},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2864":58268,"_25225":58252,"_17592":97219,"_5":17487,"_23859":97174,"_2388":97220},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2864":58269,"_25225":58252,"_17592":97222,"_5":17487,"_23859":97178,"_2388":97223},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2864":58270,"_25225":58252,"_17592":97225,"_5":17487,"_23859":97182,"_2388":97226},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2864":58271,"_25225":58252,"_17592":97228,"_5":17487,"_23859":97186,"_2388":97229},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2864":58272,"_25225":58252,"_17592":97231,"_5":17487,"_23859":97190,"_2388":97232},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2864":58273,"_25225":58252,"_17592":97234,"_5":17487,"_23859":97190,"_2388":97235},[],"Ejecuta también la prueba de conectividad del chart:",{"_2864":58274,"_25225":58252,"_17592":97237,"_5":17487,"_23859":97190,"_2388":97238},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2864":58275,"_25225":58252,"_17592":97240,"_5":17487,"_23859":97190,"_2388":97241},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2864":58276,"_25225":58252,"_17592":97243,"_5":17487,"_23859":97194,"_2388":97244},[],"Si recibes un 401:",{"_2864":58277,"_25225":58252,"_17592":97246,"_5":17487,"_23859":97194,"_2388":97247},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2864":58278,"_25225":58252,"_17592":97249,"_5":17487,"_23859":97194,"_2388":97250},[],"verifica emisor, audiencia y expiración del token;",{"_2864":58279,"_25225":58252,"_17592":97252,"_5":17487,"_23859":97194,"_2388":97253},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2864":58280,"_25225":58252,"_17592":97255,"_5":17487,"_23859":97194,"_2388":97256},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2864":58281,"_25225":58252,"_17592":97258,"_5":17487,"_23859":97194,"_2388":97259},[],"Si el login termina pero las APIs devuelven 403:",{"_2864":58282,"_25225":58252,"_17592":97261,"_5":17487,"_23859":97194,"_2388":97262},[],"inspecciona los claims reales del token;",{"_2864":58283,"_25225":58252,"_17592":97264,"_5":17487,"_23859":97194,"_2388":97265},[],"confirma que coinciden con un principal activo;",{"_2864":58284,"_25225":58252,"_17592":97267,"_5":17487,"_23859":97194,"_2388":97268},[],"revisa las políticas concedidas al principal;",{"_2864":58285,"_25225":58252,"_17592":97270,"_5":17487,"_23859":97194,"_2388":97271},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2864":58286,"_25225":58252,"_17592":97273,"_5":17487,"_23859":97194,"_2388":97274},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2864":58287,"_25225":58252,"_17592":97276,"_5":17487,"_23859":97198,"_2388":97277},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2864":58288,"_25225":58252,"_17592":97279,"_5":17487,"_23859":97198,"_2388":97280},[],"Localiza el pod y Service de authz.",{"_2864":58289,"_25225":58252,"_17592":97282,"_5":17487,"_23859":97198,"_2388":97283},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2864":58290,"_25225":58252,"_17592":97285,"_5":17487,"_23859":97198,"_2388":97286},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2864":58291,"_25225":58252,"_17592":97288,"_5":17487,"_23859":97198,"_2388":97289},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2864":58292,"_25225":58252,"_17592":97291,"_5":17487,"_23859":97198,"_2388":97292},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2864":58293,"_25225":58252,"_17592":97294,"_5":17487,"_23859":97202,"_2388":97295},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2864":58294,"_25225":58252,"_17592":97297,"_5":17487,"_23859":97202,"_2388":97298},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2864":58295,"_25225":58252,"_17592":97300,"_5":17487,"_23859":97202,"_2388":97301},[],"volumen persistente sin enlazar;",{"_2864":58296,"_25225":58252,"_17592":97303,"_5":17487,"_23859":97202,"_2388":97304},[],"imagen inaccesible o política de pull incorrecta;",{"_2864":58297,"_25225":58252,"_17592":97306,"_5":17487,"_23859":97202,"_2388":97307},[],"configuración inválida del motor criptográfico;",{"_2864":58298,"_25225":58252,"_17592":97309,"_5":17487,"_23859":97202,"_2388":97310},[],"límites de CPU o memoria demasiado bajos;",{"_2864":58299,"_25225":58252,"_17592":97312,"_5":17487,"_23859":97202,"_2388":97313},[],"migración previa incompleta.",{"_2864":58300,"_25225":58252,"_17592":97315,"_5":17487,"_23859":97202,"_2388":97316},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2864":58301,"_25225":58252,"_17592":97318,"_5":17487,"_23859":97202,"_2388":97319},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2864":58302,"_25225":58252,"_17592":97321,"_5":17487,"_23859":97202,"_2388":97322},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_2864":58303,"_25225":58252,"_17592":97324,"_5":17487,"_23859":97206,"_2388":97325},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2864":58304,"_25225":58252,"_17592":97327,"_5":17487,"_23859":97206,"_2388":97328},[],"verifica que esté habilitado en el servicio emisor;",{"_2864":58305,"_25225":58252,"_17592":97330,"_5":17487,"_23859":97206,"_2388":97331},[],"comprueba conectividad y credenciales AMQP;",{"_2864":58306,"_25225":58252,"_17592":97333,"_5":17487,"_23859":97206,"_2388":97334},[],"revisa exchange, routing key, colas y consumidores;",{"_2864":58307,"_25225":58252,"_17592":97336,"_5":17487,"_23859":97206,"_2388":97337},[],"inspecciona dead-letter queues;",{"_2864":58308,"_25225":58252,"_17592":97339,"_5":17487,"_23859":97206,"_2388":97340},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2864":58309,"_25225":58252,"_17592":97342,"_5":17487,"_23859":97206,"_2388":97343},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2864":58310,"_25225":58252,"_17592":97345,"_5":17487,"_23859":97210,"_2388":97346},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2864":58311,"_25225":58252,"_17592":97348,"_5":17487,"_23859":97210,"_2388":97349},[],"Antes de cerrar una incidencia, guarda:",{"_2864":58312,"_25225":58252,"_17592":97351,"_5":17487,"_23859":97210,"_2388":97352},[],"causa confirmada;",{"_2864":58313,"_25225":58252,"_17592":97354,"_5":17487,"_23859":97210,"_2388":97355},[],"alcance temporal y recursos afectados;",{"_2864":58314,"_25225":58252,"_17592":97357,"_5":17487,"_23859":97210,"_2388":97358},[],"comandos o consultas utilizados;",{"_2864":58315,"_25225":58252,"_17592":97360,"_5":17487,"_23859":97210,"_2388":97361},[],"cambio aplicado y forma de revertirlo;",{"_2864":58316,"_25225":58252,"_17592":97363,"_5":17487,"_23859":97210,"_2388":97364},[],"validación desde un consumidor;",{"_2864":58317,"_25225":58252,"_17592":97366,"_5":17487,"_23859":97210,"_2388":97367},[],"acción preventiva y propietario.",{"_2864":58318,"_25225":58318,"_5":12320,"_2388":97369,"_25561":97370,"_17592":97373,"_23859":58318},"Control de acceso",[40930,97371,97372],"Plataforma","Administración",[],{"_2864":58319,"_25225":58318,"_17592":97375,"_5":17487,"_23859":58318,"_2388":97376},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2864":58320,"_25225":58318,"_5":25558,"_17592":97378,"_23859":97379,"_2388":97380},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2864":58321,"_25225":58318,"_5":25558,"_17592":97382,"_23859":97383,"_2388":97384},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2864":58322,"_25225":58318,"_5":25558,"_17592":97386,"_23859":97387,"_2388":97388},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2864":58323,"_25225":58318,"_5":25558,"_17592":97390,"_23859":97391,"_2388":97392},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2864":58324,"_25225":58318,"_5":25558,"_17592":97394,"_23859":97395,"_2388":97396},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2864":58325,"_25225":58318,"_5":25558,"_17592":97398,"_23859":97399,"_2388":97400},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2864":58326,"_25225":58318,"_5":25558,"_17592":97402,"_23859":97403,"_2388":97404},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2864":58327,"_25225":58318,"_5":25558,"_17592":97406,"_23859":97407,"_2388":97408},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2864":58328,"_25225":58318,"_5":25558,"_17592":97410,"_23859":97411,"_2388":97412},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2864":58329,"_25225":58318,"_5":25558,"_17592":97414,"_23859":97415,"_2388":97416},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2864":58330,"_25225":58318,"_5":25558,"_17592":97418,"_23859":97419,"_2388":97420},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2864":58331,"_25225":58318,"_5":25558,"_17592":97422,"_23859":97423,"_2388":97424},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2864":58332,"_25225":58318,"_5":25558,"_17592":97426,"_23859":97427,"_2388":97428},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2864":58333,"_25225":58318,"_5":25558,"_17592":97430,"_23859":97431,"_2388":97432},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2864":58334,"_25225":58318,"_5":25558,"_17592":97434,"_23859":97435,"_2388":97436},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2864":58335,"_25225":58318,"_5":25558,"_17592":97438,"_23859":97439,"_2388":96620},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2864":58336,"_25225":58318,"_5":25558,"_17592":97441,"_23859":97442,"_2388":97443},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2864":58337,"_25225":58318,"_5":25558,"_17592":97445,"_23859":97446,"_2388":97447},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2864":58338,"_25225":58318,"_5":25558,"_17592":97449,"_23859":97450,"_2388":97451},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2864":58339,"_25225":58318,"_5":25558,"_17592":97453,"_23859":97454,"_2388":97455},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2864":58340,"_25225":58318,"_5":25558,"_17592":97457,"_23859":97458,"_2388":97459},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2864":58341,"_25225":58318,"_5":25558,"_17592":97461,"_23859":97462,"_2388":97463},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2864":58342,"_25225":58318,"_5":25558,"_17592":97465,"_23859":97466,"_2388":97467},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2864":58343,"_25225":58318,"_5":25558,"_17592":97469,"_23859":97470,"_2388":97471},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2864":58344,"_25225":58318,"_5":25558,"_17592":97473,"_23859":97474,"_2388":97475},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2864":58345,"_25225":58318,"_5":25558,"_17592":97477,"_23859":97478,"_2388":97479},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2864":58346,"_25225":58318,"_5":25558,"_17592":97481,"_23859":97482,"_2388":97483},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2864":58347,"_25225":58318,"_5":25558,"_17592":97485,"_23859":97486,"_2388":97487},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2864":58348,"_25225":58318,"_5":25558,"_17592":97489,"_23859":97490,"_2388":97491},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2864":58349,"_25225":58318,"_5":25558,"_17592":97493,"_23859":97494,"_2388":97495},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2864":58350,"_25225":58318,"_5":25558,"_17592":97497,"_23859":97498,"_2388":97499},[],"/docs/pr-preview/pr-41/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2864":58351,"_25225":58318,"_17592":97501,"_5":17487,"_23859":58318,"_2388":97502},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2864":58352,"_25225":58318,"_17592":97504,"_5":17487,"_23859":58318,"_2388":97505},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2864":58353,"_25225":58318,"_17592":97507,"_5":17487,"_23859":58318,"_2388":97508},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2864":58354,"_25225":58318,"_17592":97510,"_5":17487,"_23859":97379,"_2388":97511},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2864":58355,"_25225":58318,"_17592":97513,"_5":17487,"_23859":97379,"_2388":97514},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2864":58356,"_25225":58318,"_17592":97516,"_5":17487,"_23859":97379,"_2388":97517},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2864":58357,"_25225":58318,"_17592":97519,"_5":17487,"_23859":97379,"_2388":97520},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2864":58358,"_25225":58318,"_17592":97522,"_5":17487,"_23859":97379,"_2388":97523},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2864":58359,"_25225":58318,"_17592":97525,"_5":17487,"_23859":97379,"_2388":97526},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2864":58360,"_25225":58318,"_17592":97528,"_5":17487,"_23859":97383,"_2388":97529},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2864":58361,"_25225":58318,"_17592":97531,"_5":17487,"_23859":97383,"_2388":97532},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2864":58362,"_25225":58318,"_17592":97534,"_5":17487,"_23859":97387,"_2388":97535},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2864":58363,"_25225":58318,"_17592":97537,"_5":17487,"_23859":97387,"_2388":97538},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2864":58364,"_25225":58318,"_17592":97540,"_5":17487,"_23859":97387,"_2388":97541},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2864":58365,"_25225":58318,"_17592":97543,"_5":17487,"_23859":97387,"_2388":97544},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2864":58366,"_25225":58318,"_17592":97546,"_5":17487,"_23859":97387,"_2388":97547},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2864":58367,"_25225":58318,"_17592":97549,"_5":17487,"_23859":97387,"_2388":97550},[],"Carga por separado las políticas concedidas a cada principal.",{"_2864":58368,"_25225":58318,"_17592":97552,"_5":17487,"_23859":97387,"_2388":97553},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2864":58369,"_25225":58318,"_17592":97555,"_5":17487,"_23859":97387,"_2388":97556},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2864":58370,"_25225":58318,"_17592":97558,"_5":17487,"_23859":97387,"_2388":97559},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2864":58371,"_25225":58318,"_17592":97561,"_5":17487,"_23859":97387,"_2388":97562},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2864":58372,"_25225":58318,"_17592":97564,"_5":17487,"_23859":97387,"_2388":97565},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2864":58373,"_25225":58318,"_17592":97567,"_5":17487,"_23859":97387,"_2388":97568},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2864":58374,"_25225":58318,"_17592":97570,"_5":17487,"_23859":97391,"_2388":97571},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2864":58375,"_25225":58318,"_17592":97573,"_5":17487,"_23859":97391,"_2388":97574},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2864":58376,"_25225":58318,"_17592":97576,"_5":17487,"_23859":97391,"_2388":97577},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2864":58377,"_25225":58318,"_17592":97579,"_5":17487,"_23859":97391,"_2388":97580},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2864":58378,"_25225":58318,"_17592":97582,"_5":17487,"_23859":97391,"_2388":97583},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2864":58379,"_25225":58318,"_17592":97585,"_5":17487,"_23859":97391,"_2388":97586},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2864":58380,"_25225":58318,"_17592":97588,"_5":17487,"_23859":97391,"_2388":97589},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2864":58381,"_25225":58318,"_17592":97591,"_5":17487,"_23859":97391,"_2388":97592},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2864":58382,"_25225":58318,"_17592":97594,"_5":17487,"_23859":97395,"_2388":97595},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2864":58383,"_25225":58318,"_17592":97597,"_5":17487,"_23859":97395,"_2388":97598},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2864":58384,"_25225":58318,"_17592":97600,"_5":17487,"_23859":97395,"_2388":97601},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2864":58385,"_25225":58318,"_17592":97603,"_5":17487,"_23859":97395,"_2388":97604},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2864":58386,"_25225":58318,"_17592":97606,"_5":17487,"_23859":97395,"_2388":97607},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2864":58387,"_25225":58318,"_17592":97609,"_5":17487,"_23859":97395,"_2388":97610},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2864":58388,"_25225":58318,"_17592":97612,"_5":17487,"_23859":97395,"_2388":97613},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2864":58389,"_25225":58318,"_17592":97615,"_5":17487,"_23859":97395,"_2388":97616},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2864":58390,"_25225":58318,"_17592":97618,"_5":17487,"_23859":97395,"_2388":97619},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2864":58391,"_25225":58318,"_17592":97621,"_5":17487,"_23859":97395,"_2388":97622},[],"Las acciones se dividen en dos grupos:",{"_2864":58392,"_25225":58318,"_17592":97624,"_5":17487,"_23859":97395,"_2388":97625},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2864":58393,"_25225":58318,"_17592":97627,"_5":17487,"_23859":97395,"_2388":97628},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2864":58394,"_25225":58318,"_17592":97630,"_5":17487,"_23859":97395,"_2388":97631},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2864":58395,"_25225":58318,"_17592":97633,"_5":17487,"_23859":97399,"_2388":97634},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2864":58396,"_25225":58318,"_17592":97636,"_5":17487,"_23859":97399,"_2388":97637},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2864":58397,"_25225":58318,"_17592":97639,"_5":17487,"_23859":97399,"_2388":97640},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2864":58398,"_25225":58318,"_17592":97642,"_5":17487,"_23859":97403,"_2388":97643},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2864":58399,"_25225":58318,"_17592":97645,"_5":17487,"_23859":97403,"_2388":97646},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2864":58400,"_25225":58318,"_17592":97648,"_5":17487,"_23859":97403,"_2388":97649},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2864":58401,"_25225":58318,"_17592":97651,"_5":17487,"_23859":97403,"_2388":97652},[],"Los operadores implementados son:",{"_2864":58402,"_25225":58318,"_17592":97654,"_5":17487,"_23859":97403,"_2388":97655},[],"`equals`, para igualdad exacta;",{"_2864":58403,"_25225":58318,"_17592":97657,"_5":17487,"_23859":97403,"_2388":97658},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2864":58404,"_25225":58318,"_17592":97660,"_5":17487,"_23859":97403,"_2388":97661},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2864":58405,"_25225":58318,"_17592":97663,"_5":17487,"_23859":97403,"_2388":97664},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2864":58406,"_25225":58318,"_17592":97666,"_5":17487,"_23859":97407,"_2388":97667},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2864":58407,"_25225":58318,"_17592":97669,"_5":17487,"_23859":97407,"_2388":97670},[],"Los modos disponibles son:",{"_2864":58408,"_25225":58318,"_17592":97672,"_5":17487,"_23859":97407,"_2388":97673},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2864":58409,"_25225":58318,"_17592":97675,"_5":17487,"_23859":97407,"_2388":97676},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2864":58410,"_25225":58318,"_17592":97678,"_5":17487,"_23859":97407,"_2388":97679},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2864":58411,"_25225":58318,"_17592":97681,"_5":17487,"_23859":97407,"_2388":97682},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2864":58412,"_25225":58318,"_17592":97684,"_5":17487,"_23859":97407,"_2388":97685},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2864":58413,"_25225":58318,"_17592":97687,"_5":17487,"_23859":97407,"_2388":97688},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2864":58414,"_25225":58318,"_17592":97690,"_5":17487,"_23859":97411,"_2388":97691},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2864":58415,"_25225":58318,"_17592":97693,"_5":17487,"_23859":97411,"_2388":97694},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2864":58416,"_25225":58318,"_17592":97696,"_5":17487,"_23859":97411,"_2388":97697},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2864":58417,"_25225":58318,"_17592":97699,"_5":17487,"_23859":97411,"_2388":97700},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2864":58418,"_25225":58318,"_17592":97702,"_5":17487,"_23859":97419,"_2388":97703},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2864":58419,"_25225":58318,"_17592":97705,"_5":17487,"_23859":97419,"_2388":97706},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2864":58420,"_25225":58318,"_17592":97708,"_5":17487,"_23859":97423,"_2388":97709},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2864":58421,"_25225":58318,"_17592":97711,"_5":17487,"_23859":97423,"_2388":97712},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2864":58422,"_25225":58318,"_17592":97714,"_5":17487,"_23859":97427,"_2388":97715},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2864":58423,"_25225":58318,"_17592":97717,"_5":17487,"_23859":97427,"_2388":97718},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2864":58424,"_25225":58318,"_17592":97720,"_5":17487,"_23859":97427,"_2388":97721},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2864":58425,"_25225":58318,"_17592":97723,"_5":17487,"_23859":97431,"_2388":97724},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2864":58426,"_25225":58318,"_17592":97726,"_5":17487,"_23859":97431,"_2388":97727},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2864":58427,"_25225":58318,"_17592":97729,"_5":17487,"_23859":97431,"_2388":97730},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2864":58428,"_25225":58318,"_17592":97732,"_5":17487,"_23859":97431,"_2388":97733},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2864":58429,"_25225":58318,"_17592":97735,"_5":17487,"_23859":97431,"_2388":97736},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2864":58430,"_25225":58318,"_17592":97738,"_5":17487,"_23859":97431,"_2388":97739},[],"Ten en cuenta que:",{"_2864":58431,"_25225":58318,"_17592":97741,"_5":17487,"_23859":97431,"_2388":97742},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2864":58432,"_25225":58318,"_17592":97744,"_5":17487,"_23859":97431,"_2388":97745},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2864":58433,"_25225":58318,"_17592":97747,"_5":17487,"_23859":97431,"_2388":97748},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2864":58434,"_25225":58318,"_17592":97750,"_5":17487,"_23859":97435,"_2388":97751},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2864":58435,"_25225":58318,"_17592":97753,"_5":17487,"_23859":97435,"_2388":97754},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2864":58436,"_25225":58318,"_17592":97756,"_5":17487,"_23859":97435,"_2388":97757},[],"acceso completo y de solo lectura a KMS;",{"_2864":58437,"_25225":58318,"_17592":97759,"_5":17487,"_23859":97435,"_2388":97760},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2864":58438,"_25225":58318,"_17592":97762,"_5":17487,"_23859":97435,"_2388":97763},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2864":58439,"_25225":58318,"_17592":97765,"_5":17487,"_23859":97435,"_2388":97766},[],"acceso a la interfaz;",{"_2864":58440,"_25225":58318,"_17592":97768,"_5":17487,"_23859":97435,"_2388":97769},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2864":58441,"_25225":58318,"_17592":97771,"_5":17487,"_23859":97435,"_2388":97772},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2864":58442,"_25225":58318,"_17592":97774,"_5":17487,"_23859":97435,"_2388":97775},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2864":58443,"_25225":58318,"_17592":97777,"_5":17487,"_23859":97439,"_2388":97778},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2864":58444,"_25225":58318,"_17592":97780,"_5":17487,"_23859":97439,"_2388":97781},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2864":58445,"_25225":58318,"_17592":97783,"_5":17487,"_23859":97439,"_2388":97784},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2864":58446,"_25225":58318,"_17592":97786,"_5":17487,"_23859":97442,"_2388":97787},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2864":58447,"_25225":58318,"_17592":97789,"_5":17487,"_23859":97446,"_2388":97790},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2864":58448,"_25225":58318,"_17592":97792,"_5":17487,"_23859":97450,"_2388":97793},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2864":58449,"_25225":58318,"_17592":97795,"_5":17487,"_23859":97454,"_2388":97796},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2864":58450,"_25225":58318,"_17592":97798,"_5":17487,"_23859":97458,"_2388":97799},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2864":58451,"_25225":58318,"_17592":97801,"_5":17487,"_23859":97462,"_2388":97802},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2864":58452,"_25225":58318,"_17592":97804,"_5":17487,"_23859":97462,"_2388":97805},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2864":58453,"_25225":58318,"_17592":97807,"_5":17487,"_23859":97466,"_2388":97808},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2864":58454,"_25225":58318,"_17592":97810,"_5":17487,"_23859":97466,"_2388":97811},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2864":58455,"_25225":58318,"_17592":97813,"_5":17487,"_23859":97466,"_2388":97814},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2864":58456,"_25225":58318,"_17592":97816,"_5":17487,"_23859":97466,"_2388":97817},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2864":58457,"_25225":58318,"_17592":97819,"_5":17487,"_23859":97466,"_2388":97820},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2864":58458,"_25225":58318,"_17592":97822,"_5":17487,"_23859":97466,"_2388":97823},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2864":58459,"_25225":58318,"_17592":97825,"_5":17487,"_23859":97466,"_2388":97826},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2864":58460,"_25225":58318,"_17592":97828,"_5":17487,"_23859":97466,"_2388":97829},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2864":58461,"_25225":58318,"_17592":97831,"_5":17487,"_23859":97470,"_2388":97832},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2864":58462,"_25225":58318,"_17592":97834,"_5":17487,"_23859":97470,"_2388":97835},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2864":58463,"_25225":58318,"_17592":97837,"_5":17487,"_23859":97470,"_2388":97838},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2864":58464,"_25225":58318,"_17592":97840,"_5":17487,"_23859":97474,"_2388":97841},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2864":58465,"_25225":58318,"_17592":97843,"_5":17487,"_23859":97474,"_2388":97844},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2864":58466,"_25225":58318,"_17592":97846,"_5":17487,"_23859":97474,"_2388":97847},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2864":58467,"_25225":58318,"_17592":97849,"_5":17487,"_23859":97474,"_2388":97850},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2864":58468,"_25225":58318,"_17592":97852,"_5":17487,"_23859":97474,"_2388":97853},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2864":58469,"_25225":58318,"_17592":97855,"_5":17487,"_23859":97474,"_2388":97856},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2864":58470,"_25225":58318,"_17592":97858,"_5":17487,"_23859":97474,"_2388":97859},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2864":58471,"_25225":58318,"_17592":97861,"_5":17487,"_23859":97474,"_2388":97862},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2864":58472,"_25225":58318,"_17592":97864,"_5":17487,"_23859":97482,"_2388":97865},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2864":58473,"_25225":58318,"_17592":97867,"_5":17487,"_23859":97486,"_2388":97868},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2864":58474,"_25225":58318,"_17592":97870,"_5":17487,"_23859":97486,"_2388":97871},[],"que exista un principal activo del tipo correcto;",{"_2864":58475,"_25225":58318,"_17592":97873,"_5":17487,"_23859":97486,"_2388":97874},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2864":58476,"_25225":58318,"_17592":97876,"_5":17487,"_23859":97486,"_2388":97877},[],"que todas las condiciones del principal se cumplan;",{"_2864":58477,"_25225":58318,"_17592":97879,"_5":17487,"_23859":97486,"_2388":97880},[],"que el principal tenga concedida la política esperada;",{"_2864":58478,"_25225":58318,"_17592":97882,"_5":17487,"_23859":97486,"_2388":97883},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2864":58479,"_25225":58318,"_17592":97885,"_5":17487,"_23859":97486,"_2388":97886},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2864":58480,"_25225":58318,"_17592":97888,"_5":17487,"_23859":97486,"_2388":97889},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2864":58481,"_25225":58318,"_17592":97891,"_5":17487,"_23859":97490,"_2388":97892},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2864":58482,"_25225":58318,"_17592":97894,"_5":17487,"_23859":97494,"_2388":97895},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2864":58483,"_25225":58318,"_17592":97897,"_5":17487,"_23859":97498,"_2388":97898},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2864":58484,"_25225":58318,"_17592":97900,"_5":17487,"_23859":97498,"_2388":97901},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2864":58485,"_25225":58485,"_5":12320,"_2388":97903,"_25561":97904,"_17592":97905,"_23859":58485},"Alertas y suscripciones",[40930,97371,97372],[],{"_2864":58486,"_25225":58485,"_17592":97907,"_5":17487,"_23859":58485,"_2388":97908},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2864":58487,"_25225":58485,"_5":25558,"_17592":97910,"_23859":97911,"_2388":97912},[],"/docs/pr-preview/pr-41/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2864":58488,"_25225":58485,"_5":25558,"_17592":97914,"_23859":97915,"_2388":97916},[],"/docs/pr-preview/pr-41/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2864":58489,"_25225":58485,"_5":25558,"_17592":97918,"_23859":97919,"_2388":97920},[],"/docs/pr-preview/pr-41/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2864":58490,"_25225":58485,"_5":25558,"_17592":97922,"_23859":97923,"_2388":97924},[],"/docs/pr-preview/pr-41/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2864":58491,"_25225":58485,"_5":25558,"_17592":97926,"_23859":97927,"_2388":97928},[],"/docs/pr-preview/pr-41/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2864":58492,"_25225":58485,"_5":25558,"_17592":97930,"_23859":97931,"_2388":97932},[],"/docs/pr-preview/pr-41/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2864":58493,"_25225":58485,"_5":25558,"_17592":97934,"_23859":97935,"_2388":97936},[],"/docs/pr-preview/pr-41/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2864":58494,"_25225":58485,"_5":25558,"_17592":97938,"_23859":97939,"_2388":97940},[],"/docs/pr-preview/pr-41/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2864":58495,"_25225":58485,"_5":25558,"_17592":97942,"_23859":97943,"_2388":97944},[],"/docs/pr-preview/pr-41/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2864":58496,"_25225":58485,"_5":25558,"_17592":97946,"_23859":97947,"_2388":97948},[],"/docs/pr-preview/pr-41/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2864":58497,"_25225":58485,"_17592":97950,"_5":17487,"_23859":58485,"_2388":97951},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2864":58498,"_25225":58485,"_17592":97953,"_5":17487,"_23859":97911,"_2388":97954},[],"Un servicio publica un evento de dominio.",{"_2864":58499,"_25225":58485,"_17592":97956,"_5":17487,"_23859":97911,"_2388":97957},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2864":58500,"_25225":58485,"_17592":97959,"_5":17487,"_23859":97911,"_2388":97960},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2864":58501,"_25225":58485,"_17592":97962,"_5":17487,"_23859":97911,"_2388":97963},[],"Lamassu entrega el evento al canal configurado.",{"_2864":58502,"_25225":58485,"_17592":97965,"_5":17487,"_23859":97911,"_2388":97966},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2864":58503,"_25225":58485,"_17592":97968,"_5":17487,"_23859":97915,"_2388":97969},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2864":58504,"_25225":58485,"_17592":97971,"_5":17487,"_23859":97915,"_2388":97972},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2864":58505,"_25225":58485,"_17592":97974,"_5":17487,"_23859":97915,"_2388":97975},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2864":58506,"_25225":58485,"_17592":97977,"_5":17487,"_23859":97915,"_2388":97978},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2864":58507,"_25225":58485,"_17592":97980,"_5":17487,"_23859":97915,"_2388":97981},[],"`apikey_options` necesita `header` y `key`.",{"_2864":58508,"_25225":58485,"_17592":97983,"_5":17487,"_23859":97915,"_2388":97984},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2864":58509,"_25225":58485,"_17592":97986,"_5":17487,"_23859":97915,"_2388":97987},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2864":58510,"_25225":58485,"_17592":97989,"_5":17487,"_23859":97915,"_2388":97990},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2864":58511,"_25225":58485,"_17592":97992,"_5":17487,"_23859":97923,"_2388":97993},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2864":58512,"_25225":58485,"_17592":97995,"_5":17487,"_23859":97927,"_2388":97996},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2864":58513,"_25225":58485,"_17592":97998,"_5":17487,"_23859":97931,"_2388":97999},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2864":58514,"_25225":58485,"_17592":98001,"_5":17487,"_23859":97931,"_2388":98002},[],"**None** notifica todas las instancias del evento.",{"_2864":58515,"_25225":58485,"_17592":98004,"_5":17487,"_23859":97931,"_2388":98005},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2864":58516,"_25225":58485,"_17592":98007,"_5":17487,"_23859":97931,"_2388":98008},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2864":58517,"_25225":58485,"_17592":98010,"_5":17487,"_23859":97931,"_2388":98011},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2864":58518,"_25225":58485,"_17592":98013,"_5":17487,"_23859":97931,"_2388":98014},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2864":58519,"_25225":58485,"_17592":98016,"_5":17487,"_23859":97935,"_2388":98017},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2864":58520,"_25225":58485,"_17592":98019,"_5":17487,"_23859":97939,"_2388":98020},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2864":58521,"_25225":58485,"_17592":98022,"_5":17487,"_23859":97939,"_2388":98023},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2864":58522,"_25225":58485,"_17592":98025,"_5":17487,"_23859":97939,"_2388":98026},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2864":58523,"_25225":58485,"_17592":98028,"_5":17487,"_23859":97939,"_2388":98029},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2864":58524,"_25225":58485,"_17592":98031,"_5":17487,"_23859":97939,"_2388":98032},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2864":58525,"_25225":58485,"_17592":98034,"_5":17487,"_23859":97939,"_2388":98035},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2864":58526,"_25225":58485,"_17592":98037,"_5":17487,"_23859":97939,"_2388":98038},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2864":58527,"_25225":58485,"_17592":98040,"_5":17487,"_23859":97939,"_2388":98041},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2864":58528,"_25225":58485,"_17592":98043,"_5":17487,"_23859":97943,"_2388":98044},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2864":58529,"_25225":58485,"_17592":98046,"_5":17487,"_23859":97947,"_2388":98047},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2864":58530,"_25225":58485,"_17592":98049,"_5":17487,"_23859":97947,"_2388":98050},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2864":58531,"_25225":58485,"_17592":98052,"_5":17487,"_23859":97947,"_2388":98053},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2864":58532,"_25225":58485,"_17592":98055,"_5":17487,"_23859":97947,"_2388":98056},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2864":58533,"_25225":58485,"_17592":98058,"_5":17487,"_23859":97947,"_2388":98059},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2864":58534,"_25225":58485,"_17592":98061,"_5":17487,"_23859":97947,"_2388":98062},[],"**Validación:** `va.role.crl.create`.",{"_2864":58535,"_25225":58485,"_17592":98064,"_5":17487,"_23859":97947,"_2388":98065},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2864":58536,"_25225":58485,"_17592":98067,"_5":17487,"_23859":97947,"_2388":98068},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2864":58537,"_25225":58537,"_5":12320,"_2388":98070,"_25561":98071,"_17592":98072,"_23859":58537},"Registros de auditoría",[40930,97371,97372],[],{"_2864":58538,"_25225":58537,"_17592":98074,"_5":17487,"_23859":58537,"_2388":98075},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2864":58539,"_25225":58537,"_5":25558,"_17592":98077,"_23859":98078,"_2388":98079},[],"/docs/pr-preview/pr-41/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2864":58540,"_25225":58537,"_5":25558,"_17592":98081,"_23859":98082,"_2388":98083},[],"/docs/pr-preview/pr-41/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2864":58541,"_25225":58537,"_5":25558,"_17592":98085,"_23859":98086,"_2388":98087},[],"/docs/pr-preview/pr-41/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2864":58542,"_25225":58537,"_5":25558,"_17592":98089,"_23859":98090,"_2388":98091},[],"/docs/pr-preview/pr-41/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2864":58543,"_25225":58537,"_5":25558,"_17592":98093,"_23859":98094,"_2388":98095},[],"/docs/pr-preview/pr-41/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2864":58544,"_25225":58537,"_5":25558,"_17592":98097,"_23859":98098,"_2388":98099},[],"/docs/pr-preview/pr-41/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2864":58545,"_25225":58537,"_5":25558,"_17592":98101,"_23859":98102,"_2388":98103},[],"/docs/pr-preview/pr-41/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2864":58546,"_25225":58537,"_5":25558,"_17592":98105,"_23859":98106,"_2388":98107},[],"/docs/pr-preview/pr-41/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2864":58547,"_25225":58537,"_5":25558,"_17592":98109,"_23859":98110,"_2388":98111},[],"/docs/pr-preview/pr-41/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2864":58548,"_25225":58537,"_5":25558,"_17592":98113,"_23859":98114,"_2388":98115},[],"/docs/pr-preview/pr-41/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2864":58549,"_25225":58537,"_5":25558,"_17592":98117,"_23859":98118,"_2388":98119},[],"/docs/pr-preview/pr-41/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2864":58550,"_25225":58537,"_17592":98121,"_5":17487,"_23859":58537,"_2388":98122},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2864":58551,"_25225":58537,"_17592":98124,"_5":17487,"_23859":98078,"_2388":98125},[],"El cuerpo de auditoría incluye:",{"_2864":58552,"_25225":58537,"_17592":98127,"_5":17487,"_23859":98078,"_2388":98128},[],"input: datos recibidos por la operación;",{"_2864":58553,"_25225":58537,"_17592":98130,"_5":17487,"_23859":98078,"_2388":98131},[],"has\\_error: indica si el servicio devolvió un error;",{"_2864":58554,"_25225":58537,"_17592":98133,"_5":17487,"_23859":98078,"_2388":98134},[],"output: resultado producido o mensaje de error;",{"_2864":58555,"_25225":58537,"_17592":98136,"_5":17487,"_23859":98078,"_2388":98137},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2864":58556,"_25225":58537,"_17592":98139,"_5":17487,"_23859":98078,"_2388":98140},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2864":58557,"_25225":58537,"_17592":98142,"_5":17487,"_23859":98078,"_2388":98143},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2864":58558,"_25225":58537,"_17592":98145,"_5":17487,"_23859":98082,"_2388":98146},[],"El backend aplica auditoría a mutaciones de:",{"_2864":58559,"_25225":58537,"_17592":98148,"_5":17487,"_23859":98082,"_2388":98149},[],"autoridades, certificados y perfiles de emisión;",{"_2864":58560,"_25225":58537,"_17592":98151,"_5":17487,"_23859":98082,"_2388":98152},[],"claves y motores KMS;",{"_2864":58561,"_25225":58537,"_17592":98154,"_5":17487,"_23859":98082,"_2388":98155},[],"dispositivos e identidades;",{"_2864":58562,"_25225":58537,"_17592":98157,"_5":17487,"_23859":98082,"_2388":98158},[],"DMS y operaciones de enrolamiento;",{"_2864":58563,"_25225":58537,"_17592":98160,"_5":17487,"_23859":98082,"_2388":98161},[],"funciones de validación y CRL;",{"_2864":58564,"_25225":58537,"_17592":98163,"_5":17487,"_23859":98082,"_2388":98164},[],"principales, políticas y concesiones de autorización.",{"_2864":58565,"_25225":58537,"_17592":98166,"_5":17487,"_23859":98082,"_2388":98167},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2864":58566,"_25225":58537,"_17592":98169,"_5":17487,"_23859":98086,"_2388":98170},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2864":58567,"_25225":58537,"_17592":98172,"_5":17487,"_23859":98086,"_2388":98173},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2864":58568,"_25225":58537,"_17592":98175,"_5":17487,"_23859":98086,"_2388":98176},[],"Diseña el consumidor para:",{"_2864":58569,"_25225":58537,"_17592":98178,"_5":17487,"_23859":98086,"_2388":98179},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2864":58570,"_25225":58537,"_17592":98181,"_5":17487,"_23859":98086,"_2388":98182},[],"conservar el CloudEvent completo sin modificar;",{"_2864":58571,"_25225":58537,"_17592":98184,"_5":17487,"_23859":98086,"_2388":98185},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2864":58572,"_25225":58537,"_17592":98187,"_5":17487,"_23859":98086,"_2388":98188},[],"cifrar en tránsito y en reposo;",{"_2864":58573,"_25225":58537,"_17592":98190,"_5":17487,"_23859":98086,"_2388":98191},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2864":58574,"_25225":58537,"_17592":98193,"_5":17487,"_23859":98086,"_2388":98194},[],"aplicar una política explícita de retención y legal hold;",{"_2864":58575,"_25225":58537,"_17592":98196,"_5":17487,"_23859":98086,"_2388":98197},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2864":58576,"_25225":58537,"_17592":98199,"_5":17487,"_23859":98090,"_2388":98200},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2864":58577,"_25225":58537,"_17592":98202,"_5":17487,"_23859":98090,"_2388":98203},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2864":58578,"_25225":58537,"_17592":98205,"_5":17487,"_23859":98098,"_2388":98206},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2864":58579,"_25225":58537,"_17592":98208,"_5":17487,"_23859":98102,"_2388":98209},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2864":58580,"_25225":58537,"_17592":98211,"_5":17487,"_23859":98106,"_2388":98212},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2864":58581,"_25225":58537,"_17592":98214,"_5":17487,"_23859":98110,"_2388":98215},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2864":58582,"_25225":58537,"_17592":98217,"_5":17487,"_23859":98114,"_2388":98218},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2864":58583,"_25225":58537,"_17592":98220,"_5":17487,"_23859":98118,"_2388":98221},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2864":58584,"_25225":58537,"_17592":98223,"_5":17487,"_23859":98118,"_2388":98224},[],"aparece un evento de auditoría correcto;",{"_2864":58585,"_25225":58537,"_17592":98226,"_5":17487,"_23859":98118,"_2388":98227},[],"el principal coincide con la identidad utilizada;",{"_2864":58586,"_25225":58537,"_17592":98229,"_5":17487,"_23859":98118,"_2388":98230},[],"el consumidor lo persiste una sola vez;",{"_2864":58587,"_25225":58537,"_17592":98232,"_5":17487,"_23859":98118,"_2388":98233},[],"puede recuperarse por recurso, actor y periodo;",{"_2864":58588,"_25225":58537,"_17592":98235,"_5":17487,"_23859":98118,"_2388":98236},[],"una interrupción del consumidor produce una alerta.",{"_2864":58589,"_25225":58537,"_17592":98238,"_5":17487,"_23859":98118,"_2388":98239},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2864":58590,"_25225":58590,"_5":12320,"_2388":98241,"_25561":98242,"_17592":98243,"_23859":58590},"Arquitectura de la plataforma",[40930,97371],[],{"_2864":58591,"_25225":58590,"_17592":98245,"_5":17487,"_23859":58590,"_2388":98246},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2864":58592,"_25225":58590,"_5":25558,"_17592":98248,"_23859":98249,"_2388":98250},[],"/docs/pr-preview/pr-41/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2864":58593,"_25225":58590,"_5":25558,"_17592":98252,"_23859":98253,"_2388":98254},[],"/docs/pr-preview/pr-41/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2864":58594,"_25225":58590,"_5":25558,"_17592":98256,"_23859":98257,"_2388":98258},[],"/docs/pr-preview/pr-41/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2864":58595,"_25225":58590,"_5":25558,"_17592":98260,"_23859":98261,"_2388":98262},[],"/docs/pr-preview/pr-41/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2864":58596,"_25225":58590,"_5":25558,"_17592":98264,"_23859":98265,"_2388":98266},[],"/docs/pr-preview/pr-41/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2864":58597,"_25225":58590,"_17592":98268,"_5":17487,"_23859":58590,"_2388":98269},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2864":58598,"_25225":58590,"_17592":98271,"_5":17487,"_23859":58590,"_2388":98272},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2864":58599,"_25225":58590,"_17592":98274,"_5":17487,"_23859":98249,"_2388":98275},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2864":58600,"_25225":58590,"_17592":98277,"_5":17487,"_23859":98253,"_2388":98278},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2864":58601,"_25225":58590,"_17592":98280,"_5":17487,"_23859":98257,"_2388":98281},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2864":58602,"_25225":58590,"_17592":98283,"_5":17487,"_23859":98261,"_2388":98284},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2864":58603,"_25225":58590,"_17592":98286,"_5":17487,"_23859":98265,"_2388":98287},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2864":58604,"_25225":58604,"_5":12320,"_2388":98289,"_25561":98290,"_17592":98291,"_23859":58604},"Cómo funciona Lamassu",[40930,97371],[],{"_2864":58605,"_25225":58604,"_17592":98293,"_5":17487,"_23859":58604,"_2388":98294},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2864":58606,"_25225":58604,"_5":25558,"_17592":98296,"_23859":98297,"_2388":98298},[],"/docs/pr-preview/pr-41/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2864":58607,"_25225":58604,"_5":25558,"_17592":98300,"_23859":98301,"_2388":98302},[],"/docs/pr-preview/pr-41/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2864":58608,"_25225":58604,"_17592":98304,"_5":17487,"_23859":58604,"_2388":98305},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2864":58609,"_25225":58604,"_17592":98307,"_5":17487,"_23859":98297,"_2388":98308},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2864":58610,"_25225":58604,"_17592":98310,"_5":17487,"_23859":98297,"_2388":98311},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2864":58611,"_25225":58604,"_17592":98313,"_5":17487,"_23859":98297,"_2388":98314},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2864":58612,"_25225":58604,"_17592":98316,"_5":17487,"_23859":98297,"_2388":98317},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2864":58613,"_25225":58604,"_17592":98319,"_5":17487,"_23859":98297,"_2388":98320},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2864":58614,"_25225":58604,"_17592":98322,"_5":17487,"_23859":98301,"_2388":98323},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2864":58615,"_25225":58604,"_17592":98325,"_5":17487,"_23859":98301,"_2388":98326},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2864":58616,"_25225":58604,"_17592":98328,"_5":17487,"_23859":98301,"_2388":98329},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2864":58617,"_25225":58604,"_17592":98331,"_5":17487,"_23859":98301,"_2388":98332},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2864":58618,"_25225":58604,"_17592":98334,"_5":17487,"_23859":98301,"_2388":98335},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2864":58619,"_25225":58604,"_17592":98337,"_5":17487,"_23859":98301,"_2388":98338},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2864":58620,"_25225":58604,"_17592":98340,"_5":17487,"_23859":98301,"_2388":98341},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2864":58621,"_25225":58621,"_5":12320,"_2388":98343,"_25561":98344,"_17592":98345,"_23859":58621},"Dispositivos e identidades",[40930,97371,43261,98343],[],{"_2864":58622,"_25225":58621,"_17592":98347,"_5":17487,"_23859":58621,"_2388":98348},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2864":58623,"_25225":58621,"_5":25558,"_17592":98350,"_23859":98351,"_2388":98352},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2864":58624,"_25225":58621,"_5":25558,"_17592":98354,"_23859":98355,"_2388":98356},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2864":58625,"_25225":58621,"_5":25558,"_17592":98358,"_23859":98359,"_2388":98360},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2864":58626,"_25225":58621,"_5":25558,"_17592":98362,"_23859":98363,"_2388":98364},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2864":58627,"_25225":58621,"_5":25558,"_17592":98366,"_23859":98367,"_2388":98368},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2864":58628,"_25225":58621,"_5":25558,"_17592":98370,"_23859":98371,"_2388":98372},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2864":58629,"_25225":58621,"_5":25558,"_17592":98374,"_23859":98375,"_2388":98376},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2864":58630,"_25225":58621,"_5":25558,"_17592":98378,"_23859":98379,"_2388":98380},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2864":58631,"_25225":58621,"_5":25558,"_17592":98382,"_23859":98383,"_2388":98384},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2864":58632,"_25225":58621,"_5":25558,"_17592":98386,"_23859":98387,"_2388":98388},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2864":58633,"_25225":58621,"_5":25558,"_17592":98390,"_23859":98391,"_2388":98392},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2864":58634,"_25225":58621,"_17592":98394,"_5":17487,"_23859":58621,"_2388":98395},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2864":58635,"_25225":58621,"_17592":98397,"_5":17487,"_23859":58621,"_2388":98398},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2864":58636,"_25225":58621,"_17592":98400,"_5":17487,"_23859":98351,"_2388":98401},[],"Vista operativa",{"_2864":58637,"_25225":58621,"_17592":98403,"_5":17487,"_23859":98351,"_2388":98404},[],"Interpretación",{"_2864":58638,"_25225":58621,"_17592":98406,"_5":17487,"_23859":98351,"_2388":43324},[],{"_2864":58639,"_25225":58621,"_17592":98408,"_5":17487,"_23859":98351,"_2388":98409},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2864":58640,"_25225":58621,"_17592":98411,"_5":17487,"_23859":98351,"_2388":43330},[],{"_2864":58641,"_25225":58621,"_17592":98413,"_5":17487,"_23859":98351,"_2388":98414},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2864":58642,"_25225":58621,"_17592":98416,"_5":17487,"_23859":98351,"_2388":43336},[],{"_2864":58643,"_25225":58621,"_17592":98418,"_5":17487,"_23859":98351,"_2388":98419},[],"La identidad está en la ventana operativa de renovación.",{"_2864":58644,"_25225":58621,"_17592":98421,"_5":17487,"_23859":98351,"_2388":43342},[],{"_2864":58645,"_25225":58621,"_17592":98423,"_5":17487,"_23859":98351,"_2388":98424},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2864":58646,"_25225":58621,"_17592":98426,"_5":17487,"_23859":98351,"_2388":43348},[],{"_2864":58647,"_25225":58621,"_17592":98428,"_5":17487,"_23859":98351,"_2388":98429},[],"La identidad ha vencido.",{"_2864":58648,"_25225":58621,"_17592":98431,"_5":17487,"_23859":98351,"_2388":43354},[],{"_2864":58649,"_25225":58621,"_17592":98433,"_5":17487,"_23859":98351,"_2388":98434},[],"La identidad está marcada como revocada.",{"_2864":58650,"_25225":58621,"_17592":98436,"_5":17487,"_23859":98351,"_2388":43360},[],{"_2864":58651,"_25225":58621,"_17592":98438,"_5":17487,"_23859":98351,"_2388":98439},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2864":58652,"_25225":58621,"_17592":98441,"_5":17487,"_23859":98351,"_2388":98442},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2864":58653,"_25225":58621,"_17592":98444,"_5":17487,"_23859":98355,"_2388":98445},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2864":58654,"_25225":58621,"_17592":98447,"_5":17487,"_23859":98355,"_2388":98448},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2864":58655,"_25225":58621,"_17592":98450,"_5":17487,"_23859":98355,"_2388":98451},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2864":58656,"_25225":58621,"_17592":98453,"_5":17487,"_23859":98355,"_2388":98454},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2864":58657,"_25225":58621,"_17592":98456,"_5":17487,"_23859":98359,"_2388":98457},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2864":58658,"_25225":58621,"_17592":98459,"_5":17487,"_23859":98363,"_2388":98460},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2864":58659,"_25225":58621,"_17592":98462,"_5":17487,"_23859":98367,"_2388":98463},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2864":58660,"_25225":58621,"_17592":98465,"_5":17487,"_23859":98371,"_2388":98466},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2864":58661,"_25225":58621,"_17592":98468,"_5":17487,"_23859":98375,"_2388":98469},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2864":58662,"_25225":58621,"_17592":98471,"_5":17487,"_23859":98375,"_2388":98472},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2864":58663,"_25225":58621,"_17592":98474,"_5":17487,"_23859":98379,"_2388":98475},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2864":58664,"_25225":58621,"_17592":98477,"_5":17487,"_23859":98379,"_2388":98478},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2864":58665,"_25225":58621,"_17592":98480,"_5":17487,"_23859":98379,"_2388":98481},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2864":58666,"_25225":58621,"_17592":98483,"_5":17487,"_23859":98379,"_2388":98484},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2864":58667,"_25225":58621,"_17592":98486,"_5":17487,"_23859":98379,"_2388":98487},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2864":58668,"_25225":58621,"_17592":98489,"_5":17487,"_23859":98379,"_2388":98490},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2864":58669,"_25225":58621,"_17592":98492,"_5":17487,"_23859":98383,"_2388":98493},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2864":58670,"_25225":58621,"_17592":98495,"_5":17487,"_23859":98383,"_2388":98496},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2864":58671,"_25225":58621,"_17592":98498,"_5":17487,"_23859":98387,"_2388":98499},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2864":58672,"_25225":58621,"_17592":98501,"_5":17487,"_23859":98387,"_2388":98502},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2864":58673,"_25225":58621,"_17592":98504,"_5":17487,"_23859":98387,"_2388":98505},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2864":58674,"_25225":58621,"_17592":98507,"_5":17487,"_23859":98387,"_2388":98508},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2864":58675,"_25225":58621,"_17592":98510,"_5":17487,"_23859":98391,"_2388":98511},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2864":58676,"_25225":58621,"_17592":98513,"_5":17487,"_23859":98391,"_2388":98514},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2864":58677,"_25225":58677,"_5":12320,"_2388":98516,"_25561":98517,"_17592":98519,"_23859":58677},"Identidad inicial y autenticación",[40930,97371,43261,98343,98518],"Enrolamiento con PKI",[],{"_2864":58678,"_25225":58677,"_17592":98521,"_5":17487,"_23859":58677,"_2388":98522},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2864":58679,"_25225":58677,"_5":25558,"_17592":98524,"_23859":98525,"_2388":98526},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2864":58680,"_25225":58677,"_5":25558,"_17592":98528,"_23859":98529,"_2388":98530},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2864":58681,"_25225":58677,"_5":25558,"_17592":98532,"_23859":98533,"_2388":98534},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2864":58682,"_25225":58677,"_5":25558,"_17592":98536,"_23859":98537,"_2388":98538},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2864":58683,"_25225":58677,"_5":25558,"_17592":98540,"_23859":98541,"_2388":98542},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2864":58684,"_25225":58677,"_17592":98544,"_5":17487,"_23859":58677,"_2388":98545},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2864":58685,"_25225":58677,"_17592":98547,"_5":17487,"_23859":98525,"_2388":98548},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2864":58686,"_25225":58677,"_17592":98550,"_5":17487,"_23859":98525,"_2388":98551},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2864":58687,"_25225":58677,"_17592":98553,"_5":17487,"_23859":98529,"_2388":98554},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2864":58688,"_25225":58677,"_17592":98556,"_5":17487,"_23859":98529,"_2388":98557},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2864":58689,"_25225":58677,"_17592":98559,"_5":17487,"_23859":98529,"_2388":98560},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2864":58690,"_25225":58677,"_17592":98562,"_5":17487,"_23859":98533,"_2388":98563},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2864":58691,"_25225":58677,"_17592":98565,"_5":17487,"_23859":98533,"_2388":98566},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2864":58692,"_25225":58677,"_17592":98568,"_5":17487,"_23859":98537,"_2388":98569},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2864":58693,"_25225":58677,"_17592":98571,"_5":17487,"_23859":98537,"_2388":98572},[],"Ejemplo de cuerpo:",{"_2864":58694,"_25225":58677,"_17592":98574,"_5":17487,"_23859":98537,"_2388":98575},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2864":58695,"_25225":58677,"_17592":98577,"_5":17487,"_23859":98537,"_2388":98578},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2864":58696,"_25225":58677,"_17592":98580,"_5":17487,"_23859":98537,"_2388":98581},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2864":58697,"_25225":58677,"_17592":98583,"_5":17487,"_23859":98537,"_2388":98584},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2864":58698,"_25225":58677,"_17592":98586,"_5":17487,"_23859":98541,"_2388":98587},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2864":58699,"_25225":58677,"_17592":98589,"_5":17487,"_23859":98541,"_2388":98590},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2864":58700,"_25225":58700,"_5":12320,"_2388":98592,"_25561":98593,"_17592":98594,"_23859":58700},"Configura y opera el DMS",[40930,97371,43261,98343,98518],[],{"_2864":58701,"_25225":58700,"_17592":98596,"_5":17487,"_23859":58700,"_2388":98597},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2864":58702,"_25225":58700,"_5":25558,"_17592":98599,"_23859":98600,"_2388":96059},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2864":58703,"_25225":58700,"_5":25558,"_17592":98602,"_23859":98603,"_2388":98604},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2864":58704,"_25225":58700,"_5":25558,"_17592":98606,"_23859":98607,"_2388":98608},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2864":58705,"_25225":58700,"_5":25558,"_17592":98610,"_23859":98611,"_2388":98612},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2864":58706,"_25225":58700,"_5":25558,"_17592":98614,"_23859":98615,"_2388":98616},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2864":58707,"_25225":58700,"_5":25558,"_17592":98618,"_23859":98619,"_2388":98620},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2864":58708,"_25225":58700,"_5":25558,"_17592":98622,"_23859":98623,"_2388":98624},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2864":58709,"_25225":58700,"_5":25558,"_17592":98626,"_23859":98627,"_2388":98628},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2864":58710,"_25225":58700,"_5":25558,"_17592":98630,"_23859":98631,"_2388":43556},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2864":58711,"_25225":58700,"_5":25558,"_17592":98633,"_23859":98634,"_2388":43560},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2864":58712,"_25225":58700,"_5":25558,"_17592":98636,"_23859":98637,"_2388":98638},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2864":58713,"_25225":58700,"_5":25558,"_17592":98640,"_23859":98641,"_2388":98642},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2864":58714,"_25225":58700,"_5":25558,"_17592":98644,"_23859":98645,"_2388":98646},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2864":58715,"_25225":58700,"_5":25558,"_17592":98648,"_23859":98649,"_2388":98650},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2864":58716,"_25225":58700,"_5":25558,"_17592":98652,"_23859":98653,"_2388":43580},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2864":58717,"_25225":58700,"_5":25558,"_17592":98655,"_23859":98656,"_2388":98657},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2864":58718,"_25225":58700,"_5":25558,"_17592":98659,"_23859":98660,"_2388":98661},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2864":58719,"_25225":58700,"_5":25558,"_17592":98663,"_23859":98664,"_2388":98665},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2864":58720,"_25225":58700,"_17592":98667,"_5":17487,"_23859":58700,"_2388":98668},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2864":58721,"_25225":58700,"_17592":98670,"_5":17487,"_23859":98600,"_2388":98671},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2864":58722,"_25225":58700,"_17592":98673,"_5":17487,"_23859":98600,"_2388":98674},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2864":58723,"_25225":58700,"_17592":98676,"_5":17487,"_23859":98607,"_2388":98677},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2864":58724,"_25225":58700,"_17592":98679,"_5":17487,"_23859":98611,"_2388":98680},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2864":58725,"_25225":58700,"_17592":98682,"_5":17487,"_23859":98615,"_2388":98683},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2864":58726,"_25225":58700,"_17592":98685,"_5":17487,"_23859":98619,"_2388":98686},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2864":58727,"_25225":58700,"_17592":98688,"_5":17487,"_23859":98623,"_2388":98689},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2864":58728,"_25225":58700,"_17592":98691,"_5":17487,"_23859":98631,"_2388":98692},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2864":58729,"_25225":58700,"_17592":98694,"_5":17487,"_23859":98631,"_2388":98695},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2864":58730,"_25225":58700,"_17592":98697,"_5":17487,"_23859":98634,"_2388":98698},[],"Campo de `settings.enrollment_settings`",{"_2864":58731,"_25225":58700,"_17592":98700,"_5":17487,"_23859":98634,"_2388":98701},[],"Decisión",{"_2864":58732,"_25225":58700,"_17592":98703,"_5":17487,"_23859":98634,"_2388":43631},[],{"_2864":58733,"_25225":58700,"_17592":98705,"_5":17487,"_23859":98634,"_2388":98706},[],"`EST_RFC7030` para estas operaciones.",{"_2864":58734,"_25225":58700,"_17592":98708,"_5":17487,"_23859":98634,"_2388":43637},[],{"_2864":58735,"_25225":58700,"_17592":98710,"_5":17487,"_23859":98634,"_2388":98711},[],"ID de la CA que firmará.",{"_2864":58736,"_25225":58700,"_17592":98713,"_5":17487,"_23859":98634,"_2388":43643},[],{"_2864":58737,"_25225":58700,"_17592":98715,"_5":17487,"_23859":98634,"_2388":98716},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2864":58738,"_25225":58700,"_17592":98718,"_5":17487,"_23859":98634,"_2388":43649},[],{"_2864":58739,"_25225":58700,"_17592":98720,"_5":17487,"_23859":98634,"_2388":98721},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2864":58740,"_25225":58700,"_17592":98723,"_5":17487,"_23859":98634,"_2388":43655},[],{"_2864":58741,"_25225":58700,"_17592":98725,"_5":17487,"_23859":98634,"_2388":98726},[],"Uno de los cuatro modos de autenticación.",{"_2864":58742,"_25225":58700,"_17592":98728,"_5":17487,"_23859":98634,"_2388":98729},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2864":58743,"_25225":58700,"_17592":98731,"_5":17487,"_23859":98637,"_2388":98732},[],"Los bloques son independientes:",{"_2864":58744,"_25225":58700,"_17592":98734,"_5":17487,"_23859":98637,"_2388":98735},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2864":58745,"_25225":58700,"_17592":98737,"_5":17487,"_23859":98637,"_2388":98738},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2864":58746,"_25225":58700,"_17592":98740,"_5":17487,"_23859":98637,"_2388":43673},[],{"_2864":58747,"_25225":58700,"_17592":98742,"_5":17487,"_23859":98637,"_2388":98743},[],"Control aplicado en la operación configurada",{"_2864":58748,"_25225":58700,"_17592":98745,"_5":17487,"_23859":98637,"_2388":43679},[],{"_2864":58749,"_25225":58700,"_17592":98747,"_5":17487,"_23859":98637,"_2388":98748},[],"Validación del certificado presentado.",{"_2864":58750,"_25225":58700,"_17592":98750,"_5":17487,"_23859":98637,"_2388":43685},[],{"_2864":58751,"_25225":58700,"_17592":98752,"_5":17487,"_23859":98637,"_2388":98753},[],"Autorización del webhook configurado.",{"_2864":58752,"_25225":58700,"_17592":98755,"_5":17487,"_23859":98637,"_2388":43691},[],{"_2864":58753,"_25225":58700,"_17592":98757,"_5":17487,"_23859":98637,"_2388":98758},[],"Validación del certificado y, después, aprobación del webhook.",{"_2864":58754,"_25225":58700,"_17592":98760,"_5":17487,"_23859":98637,"_2388":43697},[],{"_2864":58755,"_25225":58700,"_17592":98762,"_5":17487,"_23859":98637,"_2388":98763},[],"Sin autenticación del solicitante por el DMS.",{"_2864":58756,"_25225":58700,"_17592":98765,"_5":17487,"_23859":98637,"_2388":98766},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2864":58757,"_25225":58700,"_17592":98768,"_5":17487,"_23859":98637,"_2388":98769},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2864":58758,"_25225":58700,"_17592":98771,"_5":17487,"_23859":98637,"_2388":98772},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2864":58759,"_25225":58700,"_17592":98774,"_5":17487,"_23859":98637,"_2388":98775},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2864":58760,"_25225":58700,"_17592":98777,"_5":17487,"_23859":98641,"_2388":98778},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2864":58761,"_25225":58700,"_17592":98780,"_5":17487,"_23859":98641,"_2388":98781},[],"Campo de `external_webhook_settings`",{"_2864":58762,"_25225":58700,"_17592":98783,"_5":17487,"_23859":98641,"_2388":98701},[],{"_2864":58763,"_25225":58700,"_17592":98785,"_5":17487,"_23859":98641,"_2388":43723},[],{"_2864":58764,"_25225":58700,"_17592":98787,"_5":17487,"_23859":98641,"_2388":98788},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2864":58765,"_25225":58700,"_17592":98790,"_5":17487,"_23859":98641,"_2388":43729},[],{"_2864":58766,"_25225":58700,"_17592":98792,"_5":17487,"_23859":98641,"_2388":98793},[],"`POST` o `PUT`; `POST` por defecto.",{"_2864":58767,"_25225":58700,"_17592":98795,"_5":17487,"_23859":98641,"_2388":43735},[],{"_2864":58768,"_25225":58700,"_17592":98797,"_5":17487,"_23859":98641,"_2388":98798},[],"Etiqueta usada en los logs del servicio.",{"_2864":58769,"_25225":58700,"_17592":98800,"_5":17487,"_23859":98641,"_2388":43741},[],{"_2864":58770,"_25225":58700,"_17592":98802,"_5":17487,"_23859":98641,"_2388":98803},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2864":58771,"_25225":58700,"_17592":98805,"_5":17487,"_23859":98641,"_2388":43747},[],{"_2864":58772,"_25225":58700,"_17592":98807,"_5":17487,"_23859":98641,"_2388":98808},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2864":58773,"_25225":58700,"_17592":98810,"_5":17487,"_23859":98641,"_2388":43753},[],{"_2864":58774,"_25225":58700,"_17592":98812,"_5":17487,"_23859":98641,"_2388":98813},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2864":58775,"_25225":58700,"_17592":98815,"_5":17487,"_23859":98641,"_2388":43759},[],{"_2864":58776,"_25225":58700,"_17592":98817,"_5":17487,"_23859":98641,"_2388":98818},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2864":58777,"_25225":58700,"_17592":98820,"_5":17487,"_23859":98641,"_2388":43765},[],{"_2864":58778,"_25225":58700,"_17592":98822,"_5":17487,"_23859":98641,"_2388":98823},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2864":58779,"_25225":58700,"_17592":98825,"_5":17487,"_23859":98641,"_2388":43771},[],{"_2864":58780,"_25225":58700,"_17592":98827,"_5":17487,"_23859":98641,"_2388":98828},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2864":58781,"_25225":58700,"_17592":98830,"_5":17487,"_23859":98641,"_2388":98831},[],"Reglas de esa configuración:",{"_2864":58782,"_25225":58700,"_17592":98833,"_5":17487,"_23859":98641,"_2388":98834},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2864":58783,"_25225":58700,"_17592":98836,"_5":17487,"_23859":98641,"_2388":98837},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2864":58784,"_25225":58700,"_17592":98839,"_5":17487,"_23859":98641,"_2388":98840},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2864":58785,"_25225":58700,"_17592":98842,"_5":17487,"_23859":98641,"_2388":98843},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2864":58786,"_25225":58700,"_17592":98845,"_5":17487,"_23859":98641,"_2388":98846},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2864":58787,"_25225":58700,"_17592":98848,"_5":17487,"_23859":98641,"_2388":98849},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2864":58788,"_25225":58700,"_17592":98851,"_5":17487,"_23859":98641,"_2388":98852},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2864":58789,"_25225":58700,"_17592":98854,"_5":17487,"_23859":98641,"_2388":98855},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2864":58790,"_25225":58700,"_17592":98857,"_5":17487,"_23859":98645,"_2388":98858},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2864":58791,"_25225":58700,"_17592":98860,"_5":17487,"_23859":98649,"_2388":98861},[],"Campo de `settings.reenrollment_settings`",{"_2864":58792,"_25225":58700,"_17592":98863,"_5":17487,"_23859":98649,"_2388":98864},[],"Función",{"_2864":58793,"_25225":58700,"_17592":98866,"_5":17487,"_23859":98649,"_2388":43812},[],{"_2864":58794,"_25225":58700,"_17592":98868,"_5":17487,"_23859":98649,"_2388":98869},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2864":58795,"_25225":58700,"_17592":98871,"_5":17487,"_23859":98649,"_2388":43818},[],{"_2864":58796,"_25225":58700,"_17592":98873,"_5":17487,"_23859":98649,"_2388":98874},[],"Umbral operativo preventivo de monitorización.",{"_2864":58797,"_25225":58700,"_17592":98876,"_5":17487,"_23859":98649,"_2388":43824},[],{"_2864":58798,"_25225":58700,"_17592":98878,"_5":17487,"_23859":98649,"_2388":98879},[],"Umbral operativo crítico de monitorización.",{"_2864":58799,"_25225":58700,"_17592":98881,"_5":17487,"_23859":98649,"_2388":43830},[],{"_2864":58800,"_25225":58700,"_17592":98883,"_5":17487,"_23859":98649,"_2388":98884},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2864":58801,"_25225":58700,"_17592":98886,"_5":17487,"_23859":98649,"_2388":43836},[],{"_2864":58802,"_25225":58700,"_17592":98888,"_5":17487,"_23859":98649,"_2388":98889},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2864":58803,"_25225":58700,"_17592":98891,"_5":17487,"_23859":98649,"_2388":43842},[],{"_2864":58804,"_25225":58700,"_17592":98893,"_5":17487,"_23859":98649,"_2388":98894},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2864":58805,"_25225":58700,"_17592":98896,"_5":17487,"_23859":98649,"_2388":98897},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2864":58806,"_25225":58700,"_17592":98899,"_5":17487,"_23859":98653,"_2388":98900},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2864":58807,"_25225":58700,"_17592":98902,"_5":17487,"_23859":98656,"_2388":96416},[],{"_2864":58808,"_25225":58700,"_17592":98904,"_5":17487,"_23859":98656,"_2388":98905},[],"Qué publica",{"_2864":58809,"_25225":58700,"_17592":98907,"_5":17487,"_23859":98656,"_2388":43859},[],{"_2864":58810,"_25225":58700,"_17592":98909,"_5":17487,"_23859":98656,"_2388":98910},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2864":58811,"_25225":58700,"_17592":98912,"_5":17487,"_23859":98656,"_2388":43865},[],{"_2864":58812,"_25225":58700,"_17592":98914,"_5":17487,"_23859":98656,"_2388":98915},[],"Certificado de la CA emisora seleccionada.",{"_2864":58813,"_25225":58700,"_17592":98917,"_5":17487,"_23859":98656,"_2388":43871},[],{"_2864":58814,"_25225":58700,"_17592":98919,"_5":17487,"_23859":98656,"_2388":98920},[],"Certificados de las CAs elegidas explícitamente.",{"_2864":58815,"_25225":58700,"_17592":98922,"_5":17487,"_23859":98656,"_2388":98923},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2864":58816,"_25225":58700,"_17592":98925,"_5":17487,"_23859":98660,"_2388":98926},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2864":58817,"_25225":58700,"_17592":98928,"_5":17487,"_23859":98660,"_2388":98929},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2864":58818,"_25225":58700,"_17592":98931,"_5":17487,"_23859":98660,"_2388":98932},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2864":58819,"_25225":58700,"_17592":98934,"_5":17487,"_23859":98664,"_2388":98935},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2864":58820,"_25225":58820,"_5":12320,"_2388":98937,"_25561":98938,"_17592":98939,"_23859":58820},"Integra el cliente EST",[40930,97371,43261,98343,98518],[],{"_2864":58821,"_25225":58820,"_17592":98941,"_5":17487,"_23859":58820,"_2388":98942},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2864":58822,"_25225":58820,"_5":25558,"_17592":98944,"_23859":98945,"_2388":96059},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2864":58823,"_25225":58820,"_5":25558,"_17592":98947,"_23859":98948,"_2388":98949},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2864":58824,"_25225":58820,"_5":25558,"_17592":98951,"_23859":98952,"_2388":98953},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2864":58825,"_25225":58820,"_5":25558,"_17592":98955,"_23859":98956,"_2388":98957},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2864":58826,"_25225":58820,"_5":25558,"_17592":98959,"_23859":98960,"_2388":98961},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2864":58827,"_25225":58820,"_5":25558,"_17592":98963,"_23859":98964,"_2388":98965},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2864":58828,"_25225":58820,"_17592":98967,"_5":17487,"_23859":58820,"_2388":98968},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2864":58829,"_25225":58820,"_17592":98970,"_5":17487,"_23859":98945,"_2388":98971},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2864":58830,"_25225":58820,"_17592":98973,"_5":17487,"_23859":98945,"_2388":98974},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2864":58831,"_25225":58820,"_17592":98976,"_5":17487,"_23859":98945,"_2388":98977},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2864":58832,"_25225":58820,"_17592":98979,"_5":17487,"_23859":98948,"_2388":98980},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2864":58833,"_25225":58820,"_17592":98982,"_5":17487,"_23859":98948,"_2388":98983},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2864":58834,"_25225":58820,"_17592":98985,"_5":17487,"_23859":98952,"_2388":98986},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2864":58835,"_25225":58820,"_17592":98988,"_5":17487,"_23859":98952,"_2388":98989},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2864":58836,"_25225":58820,"_17592":98991,"_5":17487,"_23859":98956,"_2388":98992},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2864":58837,"_25225":58820,"_17592":98994,"_5":17487,"_23859":98956,"_2388":98995},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2864":58838,"_25225":58820,"_17592":98997,"_5":17487,"_23859":98960,"_2388":98998},[],"Para el caso de una raíz que emite directamente:",{"_2864":58839,"_25225":58820,"_17592":99000,"_5":17487,"_23859":98960,"_2388":99001},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2864":58840,"_25225":58820,"_17592":99003,"_5":17487,"_23859":98960,"_2388":99004},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2864":58841,"_25225":58820,"_17592":99006,"_5":17487,"_23859":98964,"_2388":99007},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2864":58842,"_25225":58842,"_5":12320,"_2388":99009,"_25561":99010,"_17592":99011,"_23859":58842},"Referencia EST",[40930,97371,43261,98343,98518],[],{"_2864":58843,"_25225":58842,"_17592":99013,"_5":17487,"_23859":58842,"_2388":99014},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2864":58844,"_25225":58842,"_5":25558,"_17592":99016,"_23859":99017,"_2388":99018},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2864":58845,"_25225":58842,"_5":25558,"_17592":99020,"_23859":99021,"_2388":19100},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2864":58846,"_25225":58842,"_5":25558,"_17592":99023,"_23859":99024,"_2388":21886},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2864":58847,"_25225":58842,"_5":25558,"_17592":99026,"_23859":99027,"_2388":21893},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2864":58848,"_25225":58842,"_5":25558,"_17592":99029,"_23859":99030,"_2388":21263},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2864":58849,"_25225":58842,"_5":25558,"_17592":99032,"_23859":99033,"_2388":99034},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2864":58850,"_25225":58842,"_5":25558,"_17592":99036,"_23859":99037,"_2388":99038},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2864":58851,"_25225":58842,"_5":25558,"_17592":99040,"_23859":99041,"_2388":99042},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2864":58852,"_25225":58842,"_17592":99044,"_5":17487,"_23859":58842,"_2388":99045},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2864":58853,"_25225":58842,"_17592":99047,"_5":17487,"_23859":99017,"_2388":99048},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2864":58854,"_25225":58842,"_17592":99050,"_5":17487,"_23859":99017,"_2388":97159},[],{"_2864":58855,"_25225":58842,"_17592":99052,"_5":17487,"_23859":99017,"_2388":99053},[],"Método",{"_2864":58856,"_25225":58842,"_17592":99055,"_5":17487,"_23859":99017,"_2388":99056},[],"Autenticación y condición",{"_2864":58857,"_25225":58842,"_17592":99058,"_5":17487,"_23859":99017,"_2388":44014},[],{"_2864":58858,"_25225":58842,"_17592":99060,"_5":17487,"_23859":99017,"_2388":44017},[],{"_2864":58859,"_25225":58842,"_17592":99062,"_5":17487,"_23859":99017,"_2388":99063},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2864":58860,"_25225":58842,"_17592":99065,"_5":17487,"_23859":99017,"_2388":44023},[],{"_2864":58861,"_25225":58842,"_17592":99067,"_5":17487,"_23859":99017,"_2388":44026},[],{"_2864":58862,"_25225":58842,"_17592":99069,"_5":17487,"_23859":99017,"_2388":99070},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2864":58863,"_25225":58842,"_17592":99072,"_5":17487,"_23859":99017,"_2388":44032},[],{"_2864":58864,"_25225":58842,"_17592":99074,"_5":17487,"_23859":99017,"_2388":44026},[],{"_2864":58865,"_25225":58842,"_17592":99076,"_5":17487,"_23859":99017,"_2388":99077},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2864":58866,"_25225":58842,"_17592":99079,"_5":17487,"_23859":99017,"_2388":44040},[],{"_2864":58867,"_25225":58842,"_17592":99081,"_5":17487,"_23859":99017,"_2388":44026},[],{"_2864":58868,"_25225":58842,"_17592":99083,"_5":17487,"_23859":99017,"_2388":99084},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2864":58869,"_25225":58842,"_17592":99086,"_5":17487,"_23859":99017,"_2388":99087},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2864":58870,"_25225":58842,"_17592":99089,"_5":17487,"_23859":99021,"_2388":99090},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2864":58871,"_25225":58842,"_17592":99092,"_5":17487,"_23859":99021,"_2388":99093},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2864":58872,"_25225":58842,"_17592":99095,"_5":17487,"_23859":99024,"_2388":99096},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2864":58873,"_25225":58842,"_17592":99098,"_5":17487,"_23859":99024,"_2388":99099},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2864":58874,"_25225":58842,"_17592":99101,"_5":17487,"_23859":99027,"_2388":99102},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2864":58875,"_25225":58842,"_17592":99104,"_5":17487,"_23859":99027,"_2388":99105},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2864":58876,"_25225":58842,"_17592":99107,"_5":17487,"_23859":99030,"_2388":99108},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2864":58877,"_25225":58842,"_17592":99110,"_5":17487,"_23859":99030,"_2388":99111},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2864":58878,"_25225":58842,"_17592":99113,"_5":17487,"_23859":99033,"_2388":99114},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2864":58879,"_25225":58842,"_17592":99116,"_5":17487,"_23859":99033,"_2388":99117},[],"Parte",{"_2864":58880,"_25225":58842,"_17592":99119,"_5":17487,"_23859":99033,"_2388":99120},[],"Contenido tras decodificar su Base64",{"_2864":58881,"_25225":58842,"_17592":99122,"_5":17487,"_23859":99033,"_2388":44084},[],{"_2864":58882,"_25225":58842,"_17592":99124,"_5":17487,"_23859":99033,"_2388":99125},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2864":58883,"_25225":58842,"_17592":99127,"_5":17487,"_23859":99033,"_2388":44090},[],{"_2864":58884,"_25225":58842,"_17592":99129,"_5":17487,"_23859":99033,"_2388":99130},[],"PKCS#7 DER con el certificado emitido.",{"_2864":58885,"_25225":58842,"_17592":99132,"_5":17487,"_23859":99033,"_2388":99133},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2864":58886,"_25225":58842,"_17592":99135,"_5":17487,"_23859":99037,"_2388":99136},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2864":58887,"_25225":58842,"_17592":99138,"_5":17487,"_23859":99037,"_2388":99139},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2864":58888,"_25225":58842,"_17592":99141,"_5":17487,"_23859":99037,"_2388":99142},[],"Convierte y comprueba el resultado:",{"_2864":58889,"_25225":58842,"_17592":99144,"_5":17487,"_23859":99037,"_2388":99145},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2864":58890,"_25225":58842,"_17592":99147,"_5":17487,"_23859":99041,"_2388":99148},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2864":58891,"_25225":58842,"_17592":99150,"_5":17487,"_23859":99041,"_2388":99151},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2864":58892,"_25225":58892,"_5":12320,"_2388":98518,"_25561":99153,"_17592":99154,"_23859":58892},[40930,97371,43261,98343,98518],[],{"_2864":58893,"_25225":58892,"_17592":99156,"_5":17487,"_23859":58892,"_2388":99157},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2864":58894,"_25225":58892,"_5":25558,"_17592":99159,"_23859":99160,"_2388":99161},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2864":58895,"_25225":58892,"_5":25558,"_17592":99163,"_23859":99164,"_2388":99165},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2864":58896,"_25225":58892,"_5":25558,"_17592":99167,"_23859":99168,"_2388":99169},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2864":58897,"_25225":58892,"_5":25558,"_17592":99171,"_23859":99172,"_2388":99173},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2864":58898,"_25225":58892,"_17592":99175,"_5":17487,"_23859":58892,"_2388":99176},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2864":58899,"_25225":58892,"_17592":99178,"_5":17487,"_23859":99160,"_2388":99179},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2864":58900,"_25225":58892,"_17592":99181,"_5":17487,"_23859":99160,"_2388":99182},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2864":58901,"_25225":58892,"_17592":99184,"_5":17487,"_23859":99160,"_2388":99185},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2864":58902,"_25225":58892,"_17592":99187,"_5":17487,"_23859":99160,"_2388":99188},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2864":58903,"_25225":58892,"_17592":99190,"_5":17487,"_23859":99160,"_2388":99191},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2864":58904,"_25225":58892,"_17592":99193,"_5":17487,"_23859":99160,"_2388":99194},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2864":58905,"_25225":58892,"_17592":99196,"_5":17487,"_23859":99164,"_2388":99197},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2864":58906,"_25225":58892,"_17592":99199,"_5":17487,"_23859":99164,"_2388":99200},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2864":58907,"_25225":58892,"_17592":99202,"_5":17487,"_23859":99164,"_2388":99203},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2864":58908,"_25225":58892,"_17592":99205,"_5":17487,"_23859":99164,"_2388":99206},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2864":58909,"_25225":58892,"_17592":99208,"_5":17487,"_23859":99168,"_2388":99209},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2864":58910,"_25225":58892,"_17592":99211,"_5":17487,"_23859":99168,"_2388":99212},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2864":58911,"_25225":58892,"_17592":99214,"_5":17487,"_23859":99168,"_2388":99215},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2864":58912,"_25225":58892,"_17592":99217,"_5":17487,"_23859":99168,"_2388":99218},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2864":58913,"_25225":58892,"_17592":99220,"_5":17487,"_23859":99172,"_2388":99221},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2864":58914,"_25225":58892,"_17592":99223,"_5":17487,"_23859":99172,"_2388":99224},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2864":58915,"_25225":58915,"_5":12320,"_2388":99226,"_25561":99227,"_17592":99228,"_23859":58915},"Estrategias de aprovisionamiento",[40930,97371,43261,98343,98518],[],{"_2864":58916,"_25225":58915,"_17592":99230,"_5":17487,"_23859":58915,"_2388":99231},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2864":58917,"_25225":58915,"_5":25558,"_17592":99233,"_23859":99234,"_2388":99235},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2864":58918,"_25225":58915,"_5":25558,"_17592":99237,"_23859":99238,"_2388":99239},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2864":58919,"_25225":58915,"_5":25558,"_17592":99241,"_23859":99242,"_2388":99243},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2864":58920,"_25225":58915,"_5":25558,"_17592":99245,"_23859":99246,"_2388":99247},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2864":58921,"_25225":58915,"_5":25558,"_17592":99249,"_23859":99250,"_2388":99251},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2864":58922,"_25225":58915,"_17592":99253,"_5":17487,"_23859":58915,"_2388":99254},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2864":58923,"_25225":58915,"_17592":99256,"_5":17487,"_23859":99234,"_2388":99257},[],"Recorrido",{"_2864":58924,"_25225":58915,"_17592":99259,"_5":17487,"_23859":99234,"_2388":99260},[],"Cuándo existe el dispositivo",{"_2864":58925,"_25225":58915,"_17592":99262,"_5":17487,"_23859":99234,"_2388":99263},[],"Qué compruebas",{"_2864":58926,"_25225":58915,"_17592":99265,"_5":17487,"_23859":99234,"_2388":99266},[],"Asignación manual",{"_2864":58927,"_25225":58915,"_17592":99268,"_5":17487,"_23859":99234,"_2388":99269},[],"El operador lo crea antes de asociar un certificado.",{"_2864":58928,"_25225":58915,"_17592":99271,"_5":17487,"_23859":99234,"_2388":99272},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2864":58929,"_25225":58915,"_17592":99274,"_5":17487,"_23859":99234,"_2388":99275},[],"EST con `JITP`",{"_2864":58930,"_25225":58915,"_17592":99277,"_5":17487,"_23859":99234,"_2388":99278},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2864":58931,"_25225":58915,"_17592":99280,"_5":17487,"_23859":99234,"_2388":99281},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2864":58932,"_25225":58915,"_17592":99283,"_5":17487,"_23859":99234,"_2388":99284},[],"EST con `PRE_REGISTRATION`",{"_2864":58933,"_25225":58915,"_17592":99286,"_5":17487,"_23859":99234,"_2388":99287},[],"Debe existir antes de `/simpleenroll`.",{"_2864":58934,"_25225":58915,"_17592":99289,"_5":17487,"_23859":99234,"_2388":99290},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2864":58935,"_25225":58915,"_17592":99292,"_5":17487,"_23859":99234,"_2388":99293},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2864":58936,"_25225":58915,"_17592":99295,"_5":17487,"_23859":99234,"_2388":99296},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2864":58937,"_25225":58915,"_17592":99298,"_5":17487,"_23859":99238,"_2388":99299},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2864":58938,"_25225":58915,"_17592":99301,"_5":17487,"_23859":99238,"_2388":99302},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2864":58939,"_25225":58915,"_17592":99304,"_5":17487,"_23859":99238,"_2388":99305},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2864":58940,"_25225":58915,"_17592":99307,"_5":17487,"_23859":99242,"_2388":99308},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2864":58941,"_25225":58915,"_17592":99310,"_5":17487,"_23859":99242,"_2388":99311},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2864":58942,"_25225":58915,"_17592":99313,"_5":17487,"_23859":99242,"_2388":99314},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2864":58943,"_25225":58915,"_17592":99316,"_5":17487,"_23859":99242,"_2388":99317},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2864":58944,"_25225":58915,"_17592":99319,"_5":17487,"_23859":99242,"_2388":99320},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2864":58945,"_25225":58915,"_17592":99322,"_5":17487,"_23859":99242,"_2388":99323},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2864":58946,"_25225":58915,"_17592":99325,"_5":17487,"_23859":99246,"_2388":96416},[],{"_2864":58947,"_25225":58915,"_17592":99327,"_5":17487,"_23859":99246,"_2388":99328},[],"Material que atraviesa EST",{"_2864":58948,"_25225":58915,"_17592":99330,"_5":17487,"_23859":99246,"_2388":99331},[],"Clave generada por el dispositivo",{"_2864":58949,"_25225":58915,"_17592":99333,"_5":17487,"_23859":99246,"_2388":99334},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2864":58950,"_25225":58915,"_17592":99336,"_5":17487,"_23859":99246,"_2388":99337},[],"Clave ya disponible en el dispositivo",{"_2864":58951,"_25225":58915,"_17592":99339,"_5":17487,"_23859":99246,"_2388":99340},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2864":58952,"_25225":58915,"_17592":99342,"_5":17487,"_23859":99246,"_2388":43580},[],{"_2864":58953,"_25225":58915,"_17592":99344,"_5":17487,"_23859":99246,"_2388":99345},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2864":58954,"_25225":58915,"_17592":99347,"_5":17487,"_23859":99246,"_2388":99348},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2864":58955,"_25225":58915,"_17592":99350,"_5":17487,"_23859":99250,"_2388":99351},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2864":58956,"_25225":58956,"_5":12320,"_2388":99353,"_25561":99354,"_17592":99355,"_23859":58956},"Renovación y recuperación",[40930,97371,43261,98343,98518],[],{"_2864":58957,"_25225":58956,"_17592":99357,"_5":17487,"_23859":58956,"_2388":99358},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2864":58958,"_25225":58956,"_5":25558,"_17592":99360,"_23859":99361,"_2388":99362},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2864":58959,"_25225":58956,"_5":25558,"_17592":99364,"_23859":99365,"_2388":99366},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2864":58960,"_25225":58956,"_5":25558,"_17592":99368,"_23859":99369,"_2388":99370},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2864":58961,"_25225":58956,"_5":25558,"_17592":99372,"_23859":99373,"_2388":99374},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2864":58962,"_25225":58956,"_5":25558,"_17592":99376,"_23859":99377,"_2388":99378},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2864":58963,"_25225":58956,"_17592":99380,"_5":17487,"_23859":58956,"_2388":99381},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2864":58964,"_25225":58956,"_17592":99383,"_5":17487,"_23859":99361,"_2388":99384},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2864":58965,"_25225":58956,"_17592":99386,"_5":17487,"_23859":99361,"_2388":99387},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2864":58966,"_25225":58956,"_17592":99389,"_5":17487,"_23859":99361,"_2388":99390},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2864":58967,"_25225":58956,"_17592":99392,"_5":17487,"_23859":99361,"_2388":99393},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2864":58968,"_25225":58956,"_17592":99395,"_5":17487,"_23859":99365,"_2388":99396},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2864":58969,"_25225":58956,"_17592":99398,"_5":17487,"_23859":99365,"_2388":99399},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2864":58970,"_25225":58956,"_17592":99401,"_5":17487,"_23859":99369,"_2388":99402},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2864":58971,"_25225":58956,"_17592":99404,"_5":17487,"_23859":99369,"_2388":99405},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2864":58972,"_25225":58956,"_17592":99407,"_5":17487,"_23859":99369,"_2388":99408},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2864":58973,"_25225":58956,"_17592":99410,"_5":17487,"_23859":99373,"_2388":99411},[],"Situación",{"_2864":58974,"_25225":58956,"_17592":99413,"_5":17487,"_23859":99373,"_2388":99414},[],"Procedimiento",{"_2864":58975,"_25225":58956,"_17592":99416,"_5":17487,"_23859":99373,"_2388":99417},[],"Certificado vigente, fuera de ventana",{"_2864":58976,"_25225":58956,"_17592":99419,"_5":17487,"_23859":99373,"_2388":99420},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2864":58977,"_25225":58956,"_17592":99422,"_5":17487,"_23859":99373,"_2388":99423},[],"Certificado vencido, clave disponible",{"_2864":58978,"_25225":58956,"_17592":99425,"_5":17487,"_23859":99373,"_2388":99426},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2864":58979,"_25225":58956,"_17592":99428,"_5":17487,"_23859":99373,"_2388":99429},[],"Renovación por webhook o `NO_AUTH`",{"_2864":58980,"_25225":58956,"_17592":99431,"_5":17487,"_23859":99373,"_2388":99432},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2864":58981,"_25225":58956,"_17592":99434,"_5":17487,"_23859":99373,"_2388":99435},[],"Clave perdida o inaccesible",{"_2864":58982,"_25225":58956,"_17592":99437,"_5":17487,"_23859":99373,"_2388":99438},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2864":58983,"_25225":58956,"_17592":99440,"_5":17487,"_23859":99373,"_2388":99441},[],"Identidad actual revocada",{"_2864":58984,"_25225":58956,"_17592":99443,"_5":17487,"_23859":99373,"_2388":99444},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2864":58985,"_25225":58956,"_17592":99446,"_5":17487,"_23859":99373,"_2388":99447},[],"Dispositivo sin identidad",{"_2864":58986,"_25225":58956,"_17592":99449,"_5":17487,"_23859":99373,"_2388":99450},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2864":58987,"_25225":58956,"_17592":99452,"_5":17487,"_23859":99373,"_2388":99453},[],"Dispositivo retirado",{"_2864":58988,"_25225":58956,"_17592":99455,"_5":17487,"_23859":99373,"_2388":99456},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2864":58989,"_25225":58956,"_17592":99458,"_5":17487,"_23859":99373,"_2388":99459},[],"Timeout, HTTP 500 o fallo de instalación",{"_2864":58990,"_25225":58956,"_17592":99461,"_5":17487,"_23859":99373,"_2388":99462},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2864":58991,"_25225":58956,"_17592":99464,"_5":17487,"_23859":99377,"_2388":99465},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2864":58992,"_25225":58956,"_17592":99467,"_5":17487,"_23859":99377,"_2388":99468},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2864":58993,"_25225":58993,"_5":12320,"_2388":99470,"_25561":99471,"_17592":99472,"_23859":58993},"Diagnóstico de enrolamiento",[40930,97371,43261,98343,98518],[],{"_2864":58994,"_25225":58993,"_17592":99474,"_5":17487,"_23859":58993,"_2388":99475},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2864":58995,"_25225":58993,"_5":25558,"_17592":99477,"_23859":99478,"_2388":99479},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2864":58996,"_25225":58993,"_5":25558,"_17592":99481,"_23859":99482,"_2388":99483},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2864":58997,"_25225":58993,"_5":25558,"_17592":99485,"_23859":99486,"_2388":99042},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2864":58998,"_25225":58993,"_5":25558,"_17592":99488,"_23859":99489,"_2388":99490},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2864":58999,"_25225":58993,"_17592":99492,"_5":17487,"_23859":58993,"_2388":99493},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2864":59000,"_25225":58993,"_17592":99495,"_5":17487,"_23859":99482,"_2388":99496},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2864":59001,"_25225":58993,"_17592":99498,"_5":17487,"_23859":99482,"_2388":99499},[],"Síntoma o mensaje",{"_2864":59002,"_25225":58993,"_17592":99501,"_5":17487,"_23859":99482,"_2388":99502},[],"Qué revisar",{"_2864":59003,"_25225":58993,"_17592":99504,"_5":17487,"_23859":99482,"_2388":99505},[],"curl rechaza TLS, nombre o emisor",{"_2864":59004,"_25225":58993,"_17592":99507,"_5":17487,"_23859":99482,"_2388":99508},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2864":59005,"_25225":58993,"_17592":99510,"_5":17487,"_23859":99482,"_2388":99511},[],"404 o APS ausente",{"_2864":59006,"_25225":58993,"_17592":99513,"_5":17487,"_23859":99482,"_2388":99514},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2864":59007,"_25225":58993,"_17592":99516,"_5":17487,"_23859":99482,"_2388":99517},[],"400, error de CSR o formato",{"_2864":59008,"_25225":58993,"_17592":99519,"_5":17487,"_23859":99482,"_2388":99520},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2864":59009,"_25225":58993,"_17592":99522,"_5":17487,"_23859":99482,"_2388":99523},[],"Credencial ausente o certificado no válido",{"_2864":59010,"_25225":58993,"_17592":99525,"_5":17487,"_23859":99482,"_2388":99526},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2864":59011,"_25225":58993,"_17592":99528,"_5":17487,"_23859":99482,"_2388":99529},[],"Webhook deniega, expira o responde sin autorización",{"_2864":59012,"_25225":58993,"_17592":99531,"_5":17487,"_23859":99482,"_2388":99532},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2864":59013,"_25225":58993,"_17592":99534,"_5":17487,"_23859":99482,"_2388":44497},[],{"_2864":59014,"_25225":58993,"_17592":99536,"_5":17487,"_23859":99482,"_2388":99537},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2864":59015,"_25225":58993,"_17592":99539,"_5":17487,"_23859":99482,"_2388":44503},[],{"_2864":59016,"_25225":58993,"_17592":99541,"_5":17487,"_23859":99482,"_2388":99542},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2864":59017,"_25225":58993,"_17592":99544,"_5":17487,"_23859":99482,"_2388":44509},[],{"_2864":59018,"_25225":58993,"_17592":99546,"_5":17487,"_23859":99482,"_2388":99547},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2864":59019,"_25225":58993,"_17592":99549,"_5":17487,"_23859":99482,"_2388":99550},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2864":59020,"_25225":58993,"_17592":99552,"_5":17487,"_23859":99482,"_2388":99553},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2864":59021,"_25225":58993,"_17592":99555,"_5":17487,"_23859":99482,"_2388":99556},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2864":59022,"_25225":58993,"_17592":99558,"_5":17487,"_23859":99482,"_2388":99559},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2864":59023,"_25225":58993,"_17592":99561,"_5":17487,"_23859":99482,"_2388":44527},[],{"_2864":59024,"_25225":58993,"_17592":99563,"_5":17487,"_23859":99482,"_2388":99564},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2864":59025,"_25225":58993,"_17592":99566,"_5":17487,"_23859":99482,"_2388":44533},[],{"_2864":59026,"_25225":58993,"_17592":99568,"_5":17487,"_23859":99482,"_2388":99569},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2864":59027,"_25225":58993,"_17592":99571,"_5":17487,"_23859":99482,"_2388":99572},[],"DMS propietario distinto",{"_2864":59028,"_25225":58993,"_17592":99574,"_5":17487,"_23859":99482,"_2388":99575},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2864":59029,"_25225":58993,"_17592":99577,"_5":17487,"_23859":99482,"_2388":44545},[],{"_2864":59030,"_25225":58993,"_17592":99579,"_5":17487,"_23859":99482,"_2388":99580},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2864":59031,"_25225":58993,"_17592":99582,"_5":17487,"_23859":99482,"_2388":44551},[],{"_2864":59032,"_25225":58993,"_17592":99584,"_5":17487,"_23859":99482,"_2388":99585},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2864":59033,"_25225":58993,"_17592":99587,"_5":17487,"_23859":99482,"_2388":99588},[],"Certificado actual revocado",{"_2864":59034,"_25225":58993,"_17592":99590,"_5":17487,"_23859":99482,"_2388":99591},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2864":59035,"_25225":58993,"_17592":99593,"_5":17487,"_23859":99482,"_2388":99594},[],"Error de CA, perfil o firma",{"_2864":59036,"_25225":58993,"_17592":99596,"_5":17487,"_23859":99482,"_2388":99597},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2864":59037,"_25225":58993,"_17592":99599,"_5":17487,"_23859":99482,"_2388":99600},[],"HTTP 200 sin conexión del dispositivo",{"_2864":59038,"_25225":58993,"_17592":99602,"_5":17487,"_23859":99482,"_2388":99603},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2864":59039,"_25225":58993,"_17592":99605,"_5":17487,"_23859":99482,"_2388":99606},[],"Timeout o error después de emitir",{"_2864":59040,"_25225":58993,"_17592":99608,"_5":17487,"_23859":99482,"_2388":99609},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2864":59041,"_25225":58993,"_17592":99611,"_5":17487,"_23859":99486,"_2388":99612},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2864":59042,"_25225":58993,"_17592":99614,"_5":17487,"_23859":99486,"_2388":99615},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2864":59043,"_25225":58993,"_17592":99617,"_5":17487,"_23859":99489,"_2388":99618},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2864":59044,"_25225":58993,"_17592":99620,"_5":17487,"_23859":99489,"_2388":99621},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2864":59045,"_25225":58993,"_17592":99623,"_5":17487,"_23859":99489,"_2388":99624},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2864":59046,"_25225":58993,"_17592":99626,"_5":17487,"_23859":99489,"_2388":99627},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2864":59047,"_25225":58993,"_17592":99629,"_5":17487,"_23859":99489,"_2388":99630},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2864":59048,"_25225":58993,"_17592":99632,"_5":17487,"_23859":99489,"_2388":99633},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2864":59049,"_25225":58993,"_17592":99635,"_5":17487,"_23859":99489,"_2388":99636},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2864":59050,"_25225":59050,"_5":12320,"_2388":99638,"_25561":99639,"_17592":99640,"_23859":59050},"Distribución y actualización de confianza",[40930,97371,43261,98343,98518],[],{"_2864":59051,"_25225":59050,"_17592":99642,"_5":17487,"_23859":59050,"_2388":99643},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2864":59052,"_25225":59050,"_5":25558,"_17592":99645,"_23859":99646,"_2388":99647},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2864":59053,"_25225":59050,"_5":25558,"_17592":99649,"_23859":99650,"_2388":99651},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2864":59054,"_25225":59050,"_5":25558,"_17592":99653,"_23859":99654,"_2388":99655},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2864":59055,"_25225":59050,"_5":25558,"_17592":99657,"_23859":99658,"_2388":99659},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2864":59056,"_25225":59050,"_5":25558,"_17592":99661,"_23859":99662,"_2388":99663},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2864":59057,"_25225":59050,"_17592":99665,"_5":17487,"_23859":59050,"_2388":99666},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2864":59058,"_25225":59050,"_17592":99668,"_5":17487,"_23859":99646,"_2388":99669},[],"Relación",{"_2864":59059,"_25225":59050,"_17592":99671,"_5":17487,"_23859":99646,"_2388":99672},[],"Material que prepara el responsable",{"_2864":59060,"_25225":59050,"_17592":99674,"_5":17487,"_23859":99646,"_2388":99675},[],"Dispositivo → servidor EST",{"_2864":59061,"_25225":59050,"_17592":99677,"_5":17487,"_23859":99646,"_2388":99678},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2864":59062,"_25225":59050,"_17592":99680,"_5":17487,"_23859":99646,"_2388":99681},[],"DMS → solicitante",{"_2864":59063,"_25225":59050,"_17592":99683,"_5":17487,"_23859":99646,"_2388":99684},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2864":59064,"_25225":59050,"_17592":99686,"_5":17487,"_23859":99646,"_2388":99687},[],"Consumidor → dispositivo",{"_2864":59065,"_25225":59050,"_17592":99689,"_5":17487,"_23859":99646,"_2388":99690},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2864":59066,"_25225":59050,"_17592":99692,"_5":17487,"_23859":99646,"_2388":99693},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2864":59067,"_25225":59050,"_17592":99695,"_5":17487,"_23859":99650,"_2388":99696},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2864":59068,"_25225":59050,"_17592":99698,"_5":17487,"_23859":99650,"_2388":99699},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2864":59069,"_25225":59050,"_17592":99701,"_5":17487,"_23859":99654,"_2388":99702},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2864":59070,"_25225":59050,"_17592":99704,"_5":17487,"_23859":99654,"_2388":99705},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2864":59071,"_25225":59050,"_17592":99707,"_5":17487,"_23859":99654,"_2388":99708},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2864":59072,"_25225":59050,"_17592":99710,"_5":17487,"_23859":99654,"_2388":99711},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2864":59073,"_25225":59050,"_17592":99713,"_5":17487,"_23859":99654,"_2388":99714},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2864":59074,"_25225":59050,"_17592":99716,"_5":17487,"_23859":99654,"_2388":99717},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2864":59075,"_25225":59050,"_17592":99719,"_5":17487,"_23859":99658,"_2388":99720},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2864":59076,"_25225":59050,"_17592":99722,"_5":17487,"_23859":99658,"_2388":99723},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2864":59077,"_25225":59050,"_17592":99725,"_5":17487,"_23859":99658,"_2388":99726},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2864":59078,"_25225":59050,"_17592":99728,"_5":17487,"_23859":99662,"_2388":99729},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2864":59079,"_25225":59079,"_5":12320,"_2388":44700,"_25561":99731,"_17592":99733,"_23859":59079},[40930,97371,43261,98343,99732],"Integraciones",[],{"_2864":59080,"_25225":59079,"_17592":99735,"_5":17487,"_23859":59079,"_2388":99736},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2864":59081,"_25225":59079,"_5":25558,"_17592":99738,"_23859":99739,"_2388":99740},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2864":59082,"_25225":59079,"_5":25558,"_17592":99742,"_23859":99743,"_2388":99744},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2864":59083,"_25225":59079,"_5":25558,"_17592":99746,"_23859":99747,"_2388":99748},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2864":59084,"_25225":59079,"_5":25558,"_17592":99750,"_23859":99751,"_2388":99752},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2864":59085,"_25225":59079,"_5":25558,"_17592":99754,"_23859":99755,"_2388":99756},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2864":59086,"_25225":59079,"_5":25558,"_17592":99758,"_23859":99759,"_2388":99760},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2864":59087,"_25225":59079,"_5":25558,"_17592":99762,"_23859":99763,"_2388":44734},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2864":59088,"_25225":59079,"_5":25558,"_17592":99765,"_23859":99766,"_2388":44738},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2864":59089,"_25225":59079,"_5":25558,"_17592":99768,"_23859":99769,"_2388":99770},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2864":59090,"_25225":59079,"_5":25558,"_17592":99772,"_23859":99773,"_2388":99774},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2864":59091,"_25225":59079,"_5":25558,"_17592":99776,"_23859":99777,"_2388":99778},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2864":59092,"_25225":59079,"_5":25558,"_17592":99780,"_23859":99781,"_2388":99782},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2864":59093,"_25225":59079,"_5":25558,"_17592":99784,"_23859":99785,"_2388":99786},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2864":59094,"_25225":59079,"_5":25558,"_17592":99788,"_23859":99789,"_2388":99790},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2864":59095,"_25225":59079,"_5":25558,"_17592":99792,"_23859":99793,"_2388":99794},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2864":59096,"_25225":59079,"_5":25558,"_17592":99796,"_23859":99797,"_2388":99798},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2864":59097,"_25225":59079,"_5":25558,"_17592":99800,"_23859":99801,"_2388":99802},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2864":59098,"_25225":59079,"_5":25558,"_17592":99804,"_23859":99805,"_2388":99806},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2864":59099,"_25225":59079,"_5":25558,"_17592":99808,"_23859":99809,"_2388":99810},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2864":59100,"_25225":59079,"_5":25558,"_17592":99812,"_23859":99813,"_2388":99814},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2864":59101,"_25225":59079,"_17592":99816,"_5":17487,"_23859":59079,"_2388":99817},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2864":59102,"_25225":59079,"_17592":99819,"_5":17487,"_23859":59079,"_2388":99820},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2864":59103,"_25225":59079,"_17592":99822,"_5":17487,"_23859":59079,"_2388":99823},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2864":59104,"_25225":59079,"_17592":99825,"_5":17487,"_23859":99739,"_2388":99826},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2864":59105,"_25225":59079,"_17592":99828,"_5":17487,"_23859":99739,"_2388":99829},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2864":59106,"_25225":59079,"_17592":99831,"_5":17487,"_23859":99739,"_2388":99832},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2864":59107,"_25225":59079,"_17592":99834,"_5":17487,"_23859":99739,"_2388":99835},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2864":59108,"_25225":59079,"_17592":99837,"_5":17487,"_23859":99743,"_2388":99838},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2864":59109,"_25225":59079,"_17592":99840,"_5":17487,"_23859":99747,"_2388":99841},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2864":59110,"_25225":59079,"_17592":99843,"_5":17487,"_23859":99747,"_2388":99844},[],"Acción IAM",{"_2864":59111,"_25225":59079,"_17592":99846,"_5":17487,"_23859":99747,"_2388":96422},[],{"_2864":59112,"_25225":59079,"_17592":99848,"_5":17487,"_23859":99747,"_2388":44821},[],{"_2864":59113,"_25225":59079,"_17592":99850,"_5":17487,"_23859":99747,"_2388":99851},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2864":59114,"_25225":59079,"_17592":99853,"_5":17487,"_23859":99747,"_2388":44827},[],{"_2864":59115,"_25225":59079,"_17592":99855,"_5":17487,"_23859":99747,"_2388":99856},[],"Registrar la CA en AWS IoT",{"_2864":59116,"_25225":59079,"_17592":99858,"_5":17487,"_23859":99747,"_2388":44833},[],{"_2864":59117,"_25225":59079,"_17592":99860,"_5":17487,"_23859":99747,"_2388":99861},[],"Consultar el estado del registro de la CA",{"_2864":59118,"_25225":59079,"_17592":99863,"_5":17487,"_23859":99747,"_2388":44839},[],{"_2864":59119,"_25225":59079,"_17592":99865,"_5":17487,"_23859":99747,"_2388":99866},[],"Crear o actualizar Things en IoT Core",{"_2864":59120,"_25225":59079,"_17592":99868,"_5":17487,"_23859":99747,"_2388":44845},[],{"_2864":59121,"_25225":59079,"_17592":99870,"_5":17487,"_23859":99747,"_2388":99871},[],"Aprovisionar Things mediante plantilla",{"_2864":59122,"_25225":59079,"_17592":99873,"_5":17487,"_23859":99747,"_2388":44851},[],{"_2864":59123,"_25225":59079,"_17592":99875,"_5":17487,"_23859":99747,"_2388":99876},[],"Registrar certificados de dispositivo",{"_2864":59124,"_25225":59079,"_17592":99878,"_5":17487,"_23859":99747,"_2388":44857},[],{"_2864":59125,"_25225":59079,"_17592":99880,"_5":17487,"_23859":99747,"_2388":99881},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2864":59126,"_25225":59079,"_17592":99883,"_5":17487,"_23859":99747,"_2388":44863},[],{"_2864":59127,"_25225":59079,"_17592":99885,"_5":17487,"_23859":99747,"_2388":99886},[],"Crear y adjuntar políticas IoT",{"_2864":59128,"_25225":59079,"_17592":99888,"_5":17487,"_23859":99747,"_2388":44869},[],{"_2864":59129,"_25225":59079,"_17592":99890,"_5":17487,"_23859":99747,"_2388":99891},[],"Gestionar grupos de Things",{"_2864":59130,"_25225":59079,"_17592":99893,"_5":17487,"_23859":99747,"_2388":44875},[],{"_2864":59131,"_25225":59079,"_17592":99895,"_5":17487,"_23859":99747,"_2388":99896},[],"Crear plantillas JITP",{"_2864":59132,"_25225":59079,"_17592":99898,"_5":17487,"_23859":99747,"_2388":44881},[],{"_2864":59133,"_25225":59079,"_17592":99900,"_5":17487,"_23859":99747,"_2388":99901},[],"Leer y escribir el Device Shadow",{"_2864":59134,"_25225":59079,"_17592":99903,"_5":17487,"_23859":99747,"_2388":99904},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2864":59135,"_25225":59079,"_17592":99906,"_5":17487,"_23859":99751,"_2388":99907},[],"Parámetro",{"_2864":59136,"_25225":59079,"_17592":99909,"_5":17487,"_23859":99751,"_2388":99910},[],"Tipo",{"_2864":59137,"_25225":59079,"_17592":99912,"_5":17487,"_23859":99751,"_2388":99913},[],"Requerido",{"_2864":59138,"_25225":59079,"_17592":99915,"_5":17487,"_23859":99751,"_2388":99916},[],"Descripción",{"_2864":59139,"_25225":59079,"_17592":99918,"_5":17487,"_23859":99751,"_2388":44902},[],{"_2864":59140,"_25225":59079,"_17592":99920,"_5":17487,"_23859":99751,"_2388":21001},[],{"_2864":59141,"_25225":59079,"_17592":99922,"_5":17487,"_23859":99751,"_2388":99923},[],"Sí",{"_2864":59142,"_25225":59079,"_17592":99925,"_5":17487,"_23859":99751,"_2388":99926},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2864":59143,"_25225":59079,"_17592":99928,"_5":17487,"_23859":99751,"_2388":44913},[],{"_2864":59144,"_25225":59079,"_17592":99930,"_5":17487,"_23859":99751,"_2388":21001},[],{"_2864":59145,"_25225":59079,"_17592":99932,"_5":17487,"_23859":99751,"_2388":99923},[],{"_2864":59146,"_25225":59079,"_17592":99934,"_5":17487,"_23859":99751,"_2388":99935},[],"Región AWS donde opera el conector.",{"_2864":59147,"_25225":59079,"_17592":99937,"_5":17487,"_23859":99751,"_2388":44923},[],{"_2864":59148,"_25225":59079,"_17592":99939,"_5":17487,"_23859":99751,"_2388":21001},[],{"_2864":59149,"_25225":59079,"_17592":99941,"_5":17487,"_23859":99751,"_2388":99923},[],{"_2864":59150,"_25225":59079,"_17592":99943,"_5":17487,"_23859":99751,"_2388":99944},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2864":59151,"_25225":59079,"_17592":99946,"_5":17487,"_23859":99751,"_2388":44933},[],{"_2864":59152,"_25225":59079,"_17592":99948,"_5":17487,"_23859":99751,"_2388":21001},[],{"_2864":59153,"_25225":59079,"_17592":99950,"_5":17487,"_23859":99751,"_2388":99951},[],"Solo con `auth_method=static`",{"_2864":59154,"_25225":59079,"_17592":99953,"_5":17487,"_23859":99751,"_2388":99954},[],"Clave de acceso AWS.",{"_2864":59155,"_25225":59079,"_17592":99956,"_5":17487,"_23859":99751,"_2388":44944},[],{"_2864":59156,"_25225":59079,"_17592":99958,"_5":17487,"_23859":99751,"_2388":21001},[],{"_2864":59157,"_25225":59079,"_17592":99960,"_5":17487,"_23859":99751,"_2388":99951},[],{"_2864":59158,"_25225":59079,"_17592":99962,"_5":17487,"_23859":99751,"_2388":99963},[],"Clave secreta AWS.",{"_2864":59159,"_25225":59079,"_17592":99965,"_5":17487,"_23859":99751,"_2388":44954},[],{"_2864":59160,"_25225":59079,"_17592":99967,"_5":17487,"_23859":99751,"_2388":21001},[],{"_2864":59161,"_25225":59079,"_17592":99969,"_5":17487,"_23859":99751,"_2388":44959},[],{"_2864":59162,"_25225":59079,"_17592":99971,"_5":17487,"_23859":99751,"_2388":99972},[],"Token de sesión (con `auth_method=static`).",{"_2864":59163,"_25225":59079,"_17592":99974,"_5":17487,"_23859":99751,"_2388":44965},[],{"_2864":59164,"_25225":59079,"_17592":99976,"_5":17487,"_23859":99751,"_2388":21001},[],{"_2864":59165,"_25225":59079,"_17592":99978,"_5":17487,"_23859":99751,"_2388":99979},[],"Solo con `auth_method=role`",{"_2864":59166,"_25225":59079,"_17592":99981,"_5":17487,"_23859":99751,"_2388":99982},[],"ARN del rol a asumir.",{"_2864":59167,"_25225":59079,"_17592":99984,"_5":17487,"_23859":99751,"_2388":44976},[],{"_2864":59168,"_25225":59079,"_17592":99986,"_5":17487,"_23859":99751,"_2388":21001},[],{"_2864":59169,"_25225":59079,"_17592":99988,"_5":17487,"_23859":99751,"_2388":44959},[],{"_2864":59170,"_25225":59079,"_17592":99990,"_5":17487,"_23859":99751,"_2388":99991},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2864":59171,"_25225":59079,"_17592":99993,"_5":17487,"_23859":99751,"_2388":44986},[],{"_2864":59172,"_25225":59079,"_17592":99995,"_5":17487,"_23859":99751,"_2388":14770},[],{"_2864":59173,"_25225":59079,"_17592":99997,"_5":17487,"_23859":99751,"_2388":99923},[],{"_2864":59174,"_25225":59079,"_17592":99999,"_5":17487,"_23859":99751,"_2388":100000},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2864":59175,"_25225":59079,"_17592":100002,"_5":17487,"_23859":99751,"_2388":44996},[],{"_2864":59176,"_25225":59079,"_17592":100004,"_5":17487,"_23859":99751,"_2388":21001},[],{"_2864":59177,"_25225":59079,"_17592":100006,"_5":17487,"_23859":99751,"_2388":99923},[],{"_2864":59178,"_25225":59079,"_17592":100008,"_5":17487,"_23859":99751,"_2388":100009},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2864":59179,"_25225":59079,"_17592":100011,"_5":17487,"_23859":99751,"_2388":45006},[],{"_2864":59180,"_25225":59079,"_17592":100013,"_5":17487,"_23859":99751,"_2388":21001},[],{"_2864":59181,"_25225":59079,"_17592":100015,"_5":17487,"_23859":99751,"_2388":99923},[],{"_2864":59182,"_25225":59079,"_17592":100017,"_5":17487,"_23859":99751,"_2388":100018},[],"URL HTTP del Device Manager de Lamassu.",{"_2864":59183,"_25225":59079,"_17592":100020,"_5":17487,"_23859":99751,"_2388":45016},[],{"_2864":59184,"_25225":59079,"_17592":100022,"_5":17487,"_23859":99751,"_2388":21001},[],{"_2864":59185,"_25225":59079,"_17592":100024,"_5":17487,"_23859":99751,"_2388":99923},[],{"_2864":59186,"_25225":59079,"_17592":100026,"_5":17487,"_23859":99751,"_2388":100027},[],"URL HTTP del servicio de CA de Lamassu.",{"_2864":59187,"_25225":59079,"_17592":100029,"_5":17487,"_23859":99755,"_2388":100030},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2864":59188,"_25225":59079,"_17592":100032,"_5":17487,"_23859":99759,"_2388":100033},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2864":59189,"_25225":59079,"_17592":100035,"_5":17487,"_23859":99759,"_2388":100036},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2864":59190,"_25225":59079,"_17592":100038,"_5":17487,"_23859":99763,"_2388":100039},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2864":59191,"_25225":59079,"_17592":100041,"_5":17487,"_23859":99763,"_2388":100042},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2864":59192,"_25225":59079,"_17592":100044,"_5":17487,"_23859":99763,"_2388":100045},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2864":59193,"_25225":59079,"_17592":100047,"_5":17487,"_23859":99763,"_2388":100048},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2864":59194,"_25225":59079,"_17592":100050,"_5":17487,"_23859":99763,"_2388":100051},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2864":59195,"_25225":59079,"_17592":100053,"_5":17487,"_23859":99763,"_2388":100054},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2864":59196,"_25225":59079,"_17592":100056,"_5":17487,"_23859":99766,"_2388":100057},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2864":59197,"_25225":59079,"_17592":100059,"_5":17487,"_23859":99769,"_2388":100060},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2864":59198,"_25225":59079,"_17592":100062,"_5":17487,"_23859":99769,"_2388":100063},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2864":59199,"_25225":59079,"_17592":100065,"_5":17487,"_23859":99773,"_2388":100066},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2864":59200,"_25225":59079,"_17592":100068,"_5":17487,"_23859":99777,"_2388":100069},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2864":59201,"_25225":59079,"_17592":100071,"_5":17487,"_23859":99777,"_2388":100072},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2864":59202,"_25225":59079,"_17592":100074,"_5":17487,"_23859":99777,"_2388":100075},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2864":59203,"_25225":59079,"_17592":100077,"_5":17487,"_23859":99777,"_2388":100078},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2864":59204,"_25225":59079,"_17592":100080,"_5":17487,"_23859":99777,"_2388":100081},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2864":59205,"_25225":59079,"_17592":100083,"_5":17487,"_23859":99777,"_2388":100084},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2864":59206,"_25225":59079,"_17592":100086,"_5":17487,"_23859":99781,"_2388":100087},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2864":59207,"_25225":59079,"_17592":100089,"_5":17487,"_23859":99781,"_2388":100090},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2864":59208,"_25225":59079,"_17592":100092,"_5":17487,"_23859":99781,"_2388":100093},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2864":59209,"_25225":59079,"_17592":100095,"_5":17487,"_23859":99785,"_2388":100096},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2864":59210,"_25225":59079,"_17592":100098,"_5":17487,"_23859":99785,"_2388":100099},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2864":59211,"_25225":59079,"_17592":100101,"_5":17487,"_23859":99785,"_2388":100102},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2864":59212,"_25225":59079,"_17592":100104,"_5":17487,"_23859":99789,"_2388":100105},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2864":59213,"_25225":59079,"_17592":100107,"_5":17487,"_23859":99789,"_2388":100108},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2864":59214,"_25225":59079,"_17592":100110,"_5":17487,"_23859":99789,"_2388":100111},[],"Para que el flujo JITP funcione correctamente:",{"_2864":59215,"_25225":59079,"_17592":100113,"_5":17487,"_23859":99789,"_2388":100114},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2864":59216,"_25225":59079,"_17592":100116,"_5":17487,"_23859":99789,"_2388":100117},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2864":59217,"_25225":59079,"_17592":100119,"_5":17487,"_23859":99789,"_2388":100120},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2864":59218,"_25225":59079,"_17592":100122,"_5":17487,"_23859":99789,"_2388":100123},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2864":59219,"_25225":59079,"_17592":100125,"_5":17487,"_23859":99793,"_2388":100126},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2864":59220,"_25225":59079,"_17592":100128,"_5":17487,"_23859":99793,"_2388":100129},[],"Estado en Lamassu",{"_2864":59221,"_25225":59079,"_17592":100131,"_5":17487,"_23859":99793,"_2388":100132},[],"Razón de revocación",{"_2864":59222,"_25225":59079,"_17592":100134,"_5":17487,"_23859":99793,"_2388":100135},[],"Estado en AWS IoT Core",{"_2864":59223,"_25225":59079,"_17592":100137,"_5":17487,"_23859":99793,"_2388":45137},[],{"_2864":59224,"_25225":59079,"_17592":100139,"_5":17487,"_23859":99793,"_2388":100140},[],"Ninguna",{"_2864":59225,"_25225":59079,"_17592":100142,"_5":17487,"_23859":99793,"_2388":45143},[],{"_2864":59226,"_25225":59079,"_17592":100144,"_5":17487,"_23859":99793,"_2388":45146},[],{"_2864":59227,"_25225":59079,"_17592":100146,"_5":17487,"_23859":99793,"_2388":45149},[],{"_2864":59228,"_25225":59079,"_17592":100148,"_5":17487,"_23859":99793,"_2388":45152},[],{"_2864":59229,"_25225":59079,"_17592":100150,"_5":17487,"_23859":99793,"_2388":45146},[],{"_2864":59230,"_25225":59079,"_17592":100152,"_5":17487,"_23859":99793,"_2388":100153},[],"Cualquier otra razón",{"_2864":59231,"_25225":59079,"_17592":100155,"_5":17487,"_23859":99793,"_2388":45160},[],{"_2864":59232,"_25225":59079,"_17592":100157,"_5":17487,"_23859":99793,"_2388":100158},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2864":59233,"_25225":59079,"_17592":100160,"_5":17487,"_23859":99797,"_2388":100161},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2864":59234,"_25225":59079,"_17592":100163,"_5":17487,"_23859":99797,"_2388":100164},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2864":59235,"_25225":59079,"_17592":100166,"_5":17487,"_23859":99797,"_2388":100167},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2864":59236,"_25225":59079,"_17592":100169,"_5":17487,"_23859":99801,"_2388":100170},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2864":59237,"_25225":59079,"_17592":100172,"_5":17487,"_23859":99801,"_2388":100173},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2864":59238,"_25225":59079,"_17592":100175,"_5":17487,"_23859":99805,"_2388":100176},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2864":59239,"_25225":59079,"_17592":100178,"_5":17487,"_23859":99805,"_2388":100179},[],"Existen dos tipos de acciones:",{"_2864":59240,"_25225":59079,"_17592":100181,"_5":17487,"_23859":99805,"_2388":100182},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2864":59241,"_25225":59079,"_17592":100184,"_5":17487,"_23859":99805,"_2388":100185},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2864":59242,"_25225":59079,"_17592":100187,"_5":17487,"_23859":99805,"_2388":100188},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2864":59243,"_25225":59079,"_17592":100190,"_5":17487,"_23859":99809,"_2388":100191},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2864":59244,"_25225":59079,"_17592":100193,"_5":17487,"_23859":99809,"_2388":100194},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2864":59245,"_25225":59079,"_17592":100196,"_5":17487,"_23859":99809,"_2388":100197},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2864":59246,"_25225":59079,"_17592":100199,"_5":17487,"_23859":99813,"_2388":100200},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2864":59247,"_25225":59079,"_17592":100202,"_5":17487,"_23859":99813,"_2388":100203},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2864":59248,"_25225":59079,"_17592":100205,"_5":17487,"_23859":99813,"_2388":100206},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2864":59249,"_25225":59079,"_17592":100208,"_5":17487,"_23859":99813,"_2388":100209},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2864":59250,"_25225":59079,"_17592":100211,"_5":17487,"_23859":99813,"_2388":100212},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2864":59251,"_25225":59079,"_17592":100214,"_5":17487,"_23859":99813,"_2388":100215},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2864":59252,"_25225":59079,"_17592":100217,"_5":17487,"_23859":99813,"_2388":100218},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2864":59253,"_25225":59079,"_17592":100220,"_5":17487,"_23859":99813,"_2388":100221},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2864":59254,"_25225":59079,"_17592":100223,"_5":17487,"_23859":99813,"_2388":100224},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2864":59255,"_25225":59079,"_17592":100226,"_5":17487,"_23859":99813,"_2388":100227},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2864":59256,"_25225":59079,"_17592":100229,"_5":17487,"_23859":99813,"_2388":100230},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2864":59257,"_25225":59079,"_17592":100232,"_5":17487,"_23859":99813,"_2388":100233},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2864":59258,"_25225":59079,"_17592":100235,"_5":17487,"_23859":99813,"_2388":100236},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2864":59259,"_25225":59079,"_17592":100238,"_5":17487,"_23859":99813,"_2388":100239},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2864":59260,"_25225":59079,"_17592":100241,"_5":17487,"_23859":99813,"_2388":100242},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2864":59261,"_25225":59079,"_17592":100244,"_5":17487,"_23859":99813,"_2388":100245},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2864":59262,"_25225":59079,"_17592":100247,"_5":17487,"_23859":99813,"_2388":100248},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2864":59263,"_25225":59079,"_17592":100250,"_5":17487,"_23859":99813,"_2388":100251},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2864":59264,"_25225":59079,"_17592":100253,"_5":17487,"_23859":99813,"_2388":100254},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2864":59265,"_25225":59079,"_17592":100256,"_5":17487,"_23859":99813,"_2388":100257},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2864":59266,"_25225":59079,"_17592":100259,"_5":17487,"_23859":99813,"_2388":100260},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2864":59267,"_25225":59267,"_5":12320,"_2388":43261,"_25561":100262,"_17592":100263,"_23859":59267},[40930,97371,43261],[],{"_2864":59268,"_25225":59267,"_17592":100265,"_5":17487,"_23859":59267,"_2388":100266},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2864":59269,"_25225":59267,"_5":25558,"_17592":100268,"_23859":100269,"_2388":100270},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2864":59270,"_25225":59267,"_5":25558,"_17592":100272,"_23859":100273,"_2388":98343},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2864":59271,"_25225":59267,"_5":25558,"_17592":100275,"_23859":100276,"_2388":98518},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2864":59272,"_25225":59267,"_5":25558,"_17592":100278,"_23859":100279,"_2388":99732},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/overview#integraciones",{"_2864":59273,"_25225":59267,"_5":25558,"_17592":100281,"_23859":100282,"_2388":100283},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2864":59274,"_25225":59267,"_17592":100285,"_5":17487,"_23859":59267,"_2388":100286},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2864":59275,"_25225":59267,"_17592":100288,"_5":17487,"_23859":100269,"_2388":100289},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2864":59276,"_25225":59267,"_17592":100291,"_5":17487,"_23859":100269,"_2388":100292},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2864":59277,"_25225":59267,"_17592":100294,"_5":17487,"_23859":100273,"_2388":100295},[],"Recurso",{"_2864":59278,"_25225":59267,"_17592":100297,"_5":17487,"_23859":100273,"_2388":100298},[],"Qué representa",{"_2864":59279,"_25225":59267,"_17592":100300,"_5":17487,"_23859":100273,"_2388":100301},[],"**Dispositivo**",{"_2864":59280,"_25225":59267,"_17592":100303,"_5":17487,"_23859":100273,"_2388":100304},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2864":59281,"_25225":59267,"_17592":100306,"_5":17487,"_23859":100273,"_2388":100307},[],"**Identidad**",{"_2864":59282,"_25225":59267,"_17592":100309,"_5":17487,"_23859":100273,"_2388":100310},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2864":59283,"_25225":59267,"_17592":100312,"_5":17487,"_23859":100273,"_2388":45318},[],{"_2864":59284,"_25225":59267,"_17592":100314,"_5":17487,"_23859":100273,"_2388":100315},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2864":59285,"_25225":59267,"_17592":100317,"_5":17487,"_23859":100273,"_2388":100318},[],"**Flota**",{"_2864":59286,"_25225":59267,"_17592":100320,"_5":17487,"_23859":100273,"_2388":100321},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2864":59287,"_25225":59267,"_17592":100323,"_5":17487,"_23859":100273,"_2388":100324},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2864":59288,"_25225":59267,"_17592":100326,"_5":17487,"_23859":100273,"_2388":100327},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2864":59289,"_25225":59267,"_17592":100329,"_5":17487,"_23859":100276,"_2388":100330},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2864":59290,"_25225":59267,"_17592":100332,"_5":17487,"_23859":100276,"_2388":100333},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2864":59291,"_25225":59267,"_17592":100335,"_5":17487,"_23859":100276,"_2388":100336},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2864":59292,"_25225":59267,"_17592":100338,"_5":17487,"_23859":100276,"_2388":100339},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2864":59293,"_25225":59267,"_17592":100341,"_5":17487,"_23859":100276,"_2388":100342},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2864":59294,"_25225":59267,"_17592":100344,"_5":17487,"_23859":100276,"_2388":100345},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2864":59295,"_25225":59267,"_17592":100347,"_5":17487,"_23859":100276,"_2388":100348},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2864":59296,"_25225":59267,"_17592":100350,"_5":17487,"_23859":100276,"_2388":100351},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2864":59297,"_25225":59267,"_17592":100353,"_5":17487,"_23859":100279,"_2388":100354},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2864":59298,"_25225":59267,"_17592":100356,"_5":17487,"_23859":100279,"_2388":100357},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2864":59299,"_25225":59267,"_17592":100359,"_5":17487,"_23859":100282,"_2388":100360},[],"Participante",{"_2864":59300,"_25225":59267,"_17592":100362,"_5":17487,"_23859":100282,"_2388":100363},[],"Responsabilidad",{"_2864":59301,"_25225":59267,"_17592":100365,"_5":17487,"_23859":100282,"_2388":100366},[],"Administrador PKI",{"_2864":59302,"_25225":59267,"_17592":100368,"_5":17487,"_23859":100282,"_2388":100369},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2864":59303,"_25225":59267,"_17592":100371,"_5":17487,"_23859":100282,"_2388":100372},[],"Administrador del aprovisionamiento",{"_2864":59304,"_25225":59267,"_17592":100374,"_5":17487,"_23859":100282,"_2388":100375},[],"DMS, admisión, autenticación por operación e inventario.",{"_2864":59305,"_25225":59267,"_17592":100377,"_5":17487,"_23859":100282,"_2388":100378},[],"Integrador del dispositivo",{"_2864":59306,"_25225":59267,"_17592":100380,"_5":17487,"_23859":100282,"_2388":100381},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2864":59307,"_25225":59267,"_17592":100383,"_5":17487,"_23859":100282,"_2388":100384},[],"Integrador del consumidor",{"_2864":59308,"_25225":59267,"_17592":100386,"_5":17487,"_23859":100282,"_2388":100387},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2864":59309,"_25225":59267,"_17592":100389,"_5":17487,"_23859":100282,"_2388":100390},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2864":59310,"_25225":59310,"_5":12320,"_2388":100392,"_25561":100393,"_17592":100395,"_23859":59310},"Enrola y conecta tu primer dispositivo",[40930,97371,43261,100394],"Primeros pasos",[],{"_2864":59311,"_25225":59310,"_17592":100397,"_5":17487,"_23859":59310,"_2388":100398},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2864":59312,"_25225":59310,"_5":25558,"_17592":100400,"_23859":100401,"_2388":96059},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2864":59313,"_25225":59310,"_5":25558,"_17592":100403,"_23859":100404,"_2388":100405},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2864":59314,"_25225":59310,"_5":25558,"_17592":100407,"_23859":100408,"_2388":100409},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2864":59315,"_25225":59310,"_5":25558,"_17592":100411,"_23859":100412,"_2388":100413},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2864":59316,"_25225":59310,"_5":25558,"_17592":100415,"_23859":100416,"_2388":100417},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2864":59317,"_25225":59310,"_5":25558,"_17592":100419,"_23859":100420,"_2388":100421},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2864":59318,"_25225":59310,"_5":25558,"_17592":100423,"_23859":100424,"_2388":100425},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2864":59319,"_25225":59310,"_5":25558,"_17592":100427,"_23859":100428,"_2388":100429},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2864":59320,"_25225":59310,"_17592":100431,"_5":17487,"_23859":59310,"_2388":100432},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2864":59321,"_25225":59310,"_17592":100434,"_5":17487,"_23859":100401,"_2388":100435},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2864":59322,"_25225":59310,"_17592":100437,"_5":17487,"_23859":100401,"_2388":100438},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2864":59323,"_25225":59310,"_17592":100440,"_5":17487,"_23859":100401,"_2388":100441},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2864":59324,"_25225":59310,"_17592":100443,"_5":17487,"_23859":100401,"_2388":100444},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2864":59325,"_25225":59310,"_17592":100446,"_5":17487,"_23859":100401,"_2388":100447},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2864":59326,"_25225":59310,"_17592":100449,"_5":17487,"_23859":100404,"_2388":100450},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2864":59327,"_25225":59310,"_17592":100452,"_5":17487,"_23859":100404,"_2388":100453},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2864":59328,"_25225":59310,"_17592":100455,"_5":17487,"_23859":100408,"_2388":100456},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2864":59329,"_25225":59310,"_17592":100458,"_5":17487,"_23859":100408,"_2388":100459},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2864":59330,"_25225":59310,"_17592":100461,"_5":17487,"_23859":100408,"_2388":100462},[],"Ajuste",{"_2864":59331,"_25225":59310,"_17592":100464,"_5":17487,"_23859":100408,"_2388":100465},[],"Valor de evaluación",{"_2864":59332,"_25225":59310,"_17592":100467,"_5":17487,"_23859":100408,"_2388":45474},[],{"_2864":59333,"_25225":59310,"_17592":100469,"_5":17487,"_23859":100408,"_2388":100470},[],"Raíz emisora de `device-root.pem`.",{"_2864":59334,"_25225":59310,"_17592":100472,"_5":17487,"_23859":100408,"_2388":98646},[],{"_2864":59335,"_25225":59310,"_17592":100474,"_5":17487,"_23859":100408,"_2388":100475},[],"Perfil final de 1 hora que acabas de preparar.",{"_2864":59336,"_25225":59310,"_17592":100477,"_5":17487,"_23859":100408,"_2388":45485},[],{"_2864":59337,"_25225":59310,"_17592":100479,"_5":17487,"_23859":100408,"_2388":45488},[],{"_2864":59338,"_25225":59310,"_17592":100481,"_5":17487,"_23859":100408,"_2388":45491},[],{"_2864":59339,"_25225":59310,"_17592":100483,"_5":17487,"_23859":100408,"_2388":100484},[],"Habilitado.",{"_2864":59340,"_25225":59310,"_17592":100486,"_5":17487,"_23859":100408,"_2388":45497},[],{"_2864":59341,"_25225":59310,"_17592":100488,"_5":17487,"_23859":100408,"_2388":100489},[],"Deshabilitado; el ID debe ser nuevo.",{"_2864":59342,"_25225":59310,"_17592":100491,"_5":17487,"_23859":100408,"_2388":100492},[],"Autenticación inicial",{"_2864":59343,"_25225":59310,"_17592":100494,"_5":17487,"_23859":100408,"_2388":100495},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2864":59344,"_25225":59310,"_17592":100497,"_5":17487,"_23859":100408,"_2388":100498},[],"Autenticación de renovación",{"_2864":59345,"_25225":59310,"_17592":100500,"_5":17487,"_23859":100408,"_2388":100501},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2864":59346,"_25225":59310,"_17592":100503,"_5":17487,"_23859":100408,"_2388":45515},[],{"_2864":59347,"_25225":59310,"_17592":100505,"_5":17487,"_23859":100408,"_2388":100506},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2864":59348,"_25225":59310,"_17592":100508,"_5":17487,"_23859":100408,"_2388":45521},[],{"_2864":59349,"_25225":59310,"_17592":100510,"_5":17487,"_23859":100408,"_2388":100511},[],"1 hora.",{"_2864":59350,"_25225":59310,"_17592":100513,"_5":17487,"_23859":100408,"_2388":45527},[],{"_2864":59351,"_25225":59310,"_17592":100515,"_5":17487,"_23859":100408,"_2388":100516},[],"30 minutos / 10 minutos.",{"_2864":59352,"_25225":59310,"_17592":100518,"_5":17487,"_23859":100408,"_2388":45533},[],{"_2864":59353,"_25225":59310,"_17592":100520,"_5":17487,"_23859":100408,"_2388":100521},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2864":59354,"_25225":59310,"_17592":100523,"_5":17487,"_23859":100408,"_2388":43580},[],{"_2864":59355,"_25225":59310,"_17592":100525,"_5":17487,"_23859":100408,"_2388":100526},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2864":59356,"_25225":59310,"_17592":100528,"_5":17487,"_23859":100408,"_2388":45544},[],{"_2864":59357,"_25225":59310,"_17592":100530,"_5":17487,"_23859":100408,"_2388":100531},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2864":59358,"_25225":59310,"_17592":100533,"_5":17487,"_23859":100408,"_2388":100534},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2864":59359,"_25225":59310,"_17592":100536,"_5":17487,"_23859":100412,"_2388":100537},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2864":59360,"_25225":59310,"_17592":100539,"_5":17487,"_23859":100412,"_2388":100540},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2864":59361,"_25225":59310,"_17592":100542,"_5":17487,"_23859":100416,"_2388":100543},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2864":59362,"_25225":59310,"_17592":100545,"_5":17487,"_23859":100416,"_2388":100546},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2864":59363,"_25225":59310,"_17592":100548,"_5":17487,"_23859":100416,"_2388":100549},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2864":59364,"_25225":59310,"_17592":100551,"_5":17487,"_23859":100420,"_2388":100552},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2864":59365,"_25225":59310,"_17592":100554,"_5":17487,"_23859":100420,"_2388":100555},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2864":59366,"_25225":59310,"_17592":100557,"_5":17487,"_23859":100424,"_2388":100558},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2864":59367,"_25225":59310,"_17592":100560,"_5":17487,"_23859":100424,"_2388":100561},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2864":59368,"_25225":59310,"_17592":100563,"_5":17487,"_23859":100424,"_2388":100564},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2864":59369,"_25225":59310,"_17592":100566,"_5":17487,"_23859":100424,"_2388":100567},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2864":59370,"_25225":59310,"_17592":100569,"_5":17487,"_23859":100424,"_2388":100570},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2864":59371,"_25225":59310,"_17592":100572,"_5":17487,"_23859":100428,"_2388":100573},[],"Comprobación",{"_2864":59372,"_25225":59310,"_17592":100575,"_5":17487,"_23859":100428,"_2388":100576},[],"Resultado esperado",{"_2864":59373,"_25225":59310,"_17592":100578,"_5":17487,"_23859":100428,"_2388":100579},[],"Registro",{"_2864":59374,"_25225":59310,"_17592":100581,"_5":17487,"_23859":100428,"_2388":100582},[],"ID creado automáticamente y DMS correcto.",{"_2864":59375,"_25225":59310,"_17592":100584,"_5":17487,"_23859":100428,"_2388":100585},[],"Certificado",{"_2864":59376,"_25225":59310,"_17592":100587,"_5":17487,"_23859":100428,"_2388":100588},[],"CN, perfil, serie y clave verificados.",{"_2864":59377,"_25225":59310,"_17592":100590,"_5":17487,"_23859":100428,"_2388":100591},[],"Inventario",{"_2864":59378,"_25225":59310,"_17592":100593,"_5":17487,"_23859":100428,"_2388":100594},[],"Serie recibida visible como identidad actual y en el historial.",{"_2864":59379,"_25225":59310,"_17592":100596,"_5":17487,"_23859":100428,"_2388":100597},[],"Consumidor",{"_2864":59380,"_25225":59310,"_17592":100599,"_5":17487,"_23859":100428,"_2388":100600},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2864":59381,"_25225":59310,"_17592":100602,"_5":17487,"_23859":100428,"_2388":100603},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2864":59382,"_25225":59310,"_17592":100605,"_5":17487,"_23859":100428,"_2388":100606},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2864":59383,"_25225":59383,"_5":12320,"_2388":98360,"_25561":100608,"_17592":100609,"_23859":59383},[40930,97371,43261,100394],[],{"_2864":59384,"_25225":59383,"_17592":100611,"_5":17487,"_23859":59383,"_2388":100612},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2864":59385,"_25225":59383,"_5":25558,"_17592":100614,"_23859":100615,"_2388":96059},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2864":59386,"_25225":59383,"_5":25558,"_17592":100617,"_23859":100618,"_2388":100619},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2864":59387,"_25225":59383,"_5":25558,"_17592":100621,"_23859":100622,"_2388":100623},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2864":59388,"_25225":59383,"_5":25558,"_17592":100625,"_23859":100626,"_2388":100627},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2864":59389,"_25225":59383,"_5":25558,"_17592":100629,"_23859":100630,"_2388":100631},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2864":59390,"_25225":59383,"_5":25558,"_17592":100633,"_23859":100634,"_2388":100635},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2864":59391,"_25225":59383,"_5":25558,"_17592":100637,"_23859":100638,"_2388":100576},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2864":59392,"_25225":59383,"_5":25558,"_17592":100640,"_23859":100641,"_2388":100642},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2864":59393,"_25225":59383,"_5":25558,"_17592":100644,"_23859":100645,"_2388":100646},[],"/docs/pr-preview/pr-41/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2864":59394,"_25225":59383,"_17592":100648,"_5":17487,"_23859":59383,"_2388":100649},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2864":59395,"_25225":59383,"_17592":100651,"_5":17487,"_23859":59383,"_2388":100652},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2864":59396,"_25225":59383,"_17592":100654,"_5":17487,"_23859":100615,"_2388":100655},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2864":59397,"_25225":59383,"_17592":100657,"_5":17487,"_23859":100615,"_2388":100658},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2864":59398,"_25225":59383,"_17592":100660,"_5":17487,"_23859":100615,"_2388":100661},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2864":59399,"_25225":59383,"_17592":100663,"_5":17487,"_23859":100615,"_2388":100664},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2864":59400,"_25225":59383,"_17592":100666,"_5":17487,"_23859":100618,"_2388":100667},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2864":59401,"_25225":59383,"_17592":100669,"_5":17487,"_23859":100618,"_2388":100670},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2864":59402,"_25225":59383,"_17592":100672,"_5":17487,"_23859":100618,"_2388":100673},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2864":59403,"_25225":59383,"_17592":100675,"_5":17487,"_23859":100618,"_2388":100676},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2864":59404,"_25225":59383,"_17592":100678,"_5":17487,"_23859":100618,"_2388":100679},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2864":59405,"_25225":59383,"_17592":100681,"_5":17487,"_23859":100618,"_2388":100682},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2864":59406,"_25225":59383,"_17592":100684,"_5":17487,"_23859":100618,"_2388":100685},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2864":59407,"_25225":59383,"_17592":100687,"_5":17487,"_23859":100618,"_2388":100688},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2864":59408,"_25225":59383,"_17592":100690,"_5":17487,"_23859":100622,"_2388":100691},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2864":59409,"_25225":59383,"_17592":100693,"_5":17487,"_23859":100622,"_2388":45710},[],{"_2864":59410,"_25225":59383,"_17592":100695,"_5":17487,"_23859":100622,"_2388":100696},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2864":59411,"_25225":59383,"_17592":100698,"_5":17487,"_23859":100622,"_2388":100699},[],"**Icon** y **Tags**: clasificación opcional.",{"_2864":59412,"_25225":59383,"_17592":100701,"_5":17487,"_23859":100622,"_2388":100702},[],"Confirma el registro.",{"_2864":59413,"_25225":59383,"_17592":100704,"_5":17487,"_23859":100626,"_2388":100705},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2864":59414,"_25225":59383,"_17592":100707,"_5":17487,"_23859":100626,"_2388":100708},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2864":59415,"_25225":59383,"_17592":100710,"_5":17487,"_23859":100630,"_2388":100711},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2864":59416,"_25225":59383,"_17592":100713,"_5":17487,"_23859":100630,"_2388":100714},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2864":59417,"_25225":59383,"_17592":100716,"_5":17487,"_23859":100634,"_2388":100717},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2864":59418,"_25225":59383,"_17592":100719,"_5":17487,"_23859":100634,"_2388":100720},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2864":59419,"_25225":59383,"_17592":100722,"_5":17487,"_23859":100638,"_2388":100573},[],{"_2864":59420,"_25225":59383,"_17592":100724,"_5":17487,"_23859":100638,"_2388":100725},[],"Resultado",{"_2864":59421,"_25225":59383,"_17592":100727,"_5":17487,"_23859":100638,"_2388":100728},[],"Dispositivo",{"_2864":59422,"_25225":59383,"_17592":100730,"_5":17487,"_23859":100638,"_2388":100731},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2864":59423,"_25225":59383,"_17592":100733,"_5":17487,"_23859":100638,"_2388":100734},[],"Identidad actual",{"_2864":59424,"_25225":59383,"_17592":100736,"_5":17487,"_23859":100638,"_2388":100737},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2864":59425,"_25225":59383,"_17592":100739,"_5":17487,"_23859":100638,"_2388":100740},[],"Historial",{"_2864":59426,"_25225":59383,"_17592":100742,"_5":17487,"_23859":100638,"_2388":100743},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2864":59427,"_25225":59383,"_17592":100745,"_5":17487,"_23859":100638,"_2388":100746},[],"Clave y certificado",{"_2864":59428,"_25225":59383,"_17592":100748,"_5":17487,"_23859":100638,"_2388":100749},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2864":59429,"_25225":59383,"_17592":100751,"_5":17487,"_23859":100641,"_2388":100752},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2864":59430,"_25225":59383,"_17592":100754,"_5":17487,"_23859":100641,"_2388":100755},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2864":59431,"_25225":59383,"_17592":100757,"_5":17487,"_23859":100641,"_2388":100758},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2864":59432,"_25225":59383,"_17592":100760,"_5":17487,"_23859":100641,"_2388":100761},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2864":59433,"_25225":59383,"_17592":100763,"_5":17487,"_23859":100645,"_2388":100764},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2864":59434,"_25225":59383,"_17592":100766,"_5":17487,"_23859":100645,"_2388":100767},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2864":59435,"_25225":59383,"_17592":100769,"_5":17487,"_23859":100645,"_2388":100770},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2864":59436,"_25225":59436,"_5":12320,"_2388":100772,"_25561":100773,"_17592":100774,"_23859":59436},"Plataforma Lamassu IoT",[40930,97371],[],{"_2864":59437,"_25225":59436,"_17592":100776,"_5":17487,"_23859":59436,"_2388":100777},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2864":59438,"_25225":59436,"_5":25558,"_17592":100779,"_23859":100780,"_2388":100270},[],"/docs/pr-preview/pr-41/es/platform/overview#empieza-aquí",{"_2864":59439,"_25225":59436,"_5":25558,"_17592":100782,"_23859":100783,"_2388":100784},[],"/docs/pr-preview/pr-41/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2864":59440,"_25225":59436,"_5":25558,"_17592":100786,"_23859":100787,"_2388":100788},[],"/docs/pr-preview/pr-41/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2864":59441,"_25225":59436,"_5":25558,"_17592":100790,"_23859":100791,"_2388":100792},[],"/docs/pr-preview/pr-41/es/platform/overview#capacidades-principales","Capacidades principales",{"_2864":59442,"_25225":59436,"_5":25558,"_17592":100794,"_23859":100795,"_2388":100796},[],"/docs/pr-preview/pr-41/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2864":59443,"_25225":59436,"_5":25558,"_17592":100798,"_23859":100799,"_2388":100800},[],"/docs/pr-preview/pr-41/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2864":59444,"_25225":59436,"_5":25558,"_17592":100802,"_23859":100803,"_2388":100804},[],"/docs/pr-preview/pr-41/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2864":59445,"_25225":59436,"_5":25558,"_17592":100806,"_23859":100807,"_2388":100808},[],"/docs/pr-preview/pr-41/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2864":59446,"_25225":59436,"_5":25558,"_17592":100810,"_23859":100811,"_2388":100812},[],"/docs/pr-preview/pr-41/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2864":59447,"_25225":59436,"_5":25558,"_17592":100814,"_23859":100815,"_2388":100816},[],"/docs/pr-preview/pr-41/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2864":59448,"_25225":59436,"_5":25558,"_17592":100818,"_23859":100819,"_2388":100820},[],"/docs/pr-preview/pr-41/es/platform/overview#referencia-operativa","Referencia operativa",{"_2864":59449,"_25225":59436,"_17592":100822,"_5":17487,"_23859":59436,"_2388":100823},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2864":59450,"_25225":59436,"_17592":100825,"_5":17487,"_23859":100780,"_2388":100826},[],"Elige el resultado que necesitas obtener:",{"_2864":59451,"_25225":59436,"_17592":100828,"_5":17487,"_23859":100780,"_2388":100829},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2864":59452,"_25225":59436,"_17592":100831,"_5":17487,"_23859":100780,"_2388":100832},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2864":59453,"_25225":59436,"_17592":100834,"_5":17487,"_23859":100780,"_2388":100835},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2864":59454,"_25225":59436,"_17592":100837,"_5":17487,"_23859":100783,"_2388":100838},[],"Bloque",{"_2864":59455,"_25225":59436,"_17592":100840,"_5":17487,"_23859":100783,"_2388":100841},[],"Qué gestionas",{"_2864":59456,"_25225":59436,"_17592":100843,"_5":17487,"_23859":100783,"_2388":100844},[],"Punto de entrada",{"_2864":59457,"_25225":59436,"_17592":100846,"_5":17487,"_23859":100783,"_2388":45864},[],{"_2864":59458,"_25225":59436,"_17592":100848,"_5":17487,"_23859":100783,"_2388":100849},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2864":59459,"_25225":59436,"_17592":100851,"_5":17487,"_23859":100783,"_2388":100852},[],"Visión general de PKI",{"_2864":59460,"_25225":59436,"_17592":100854,"_5":17487,"_23859":100783,"_2388":45873},[],{"_2864":59461,"_25225":59436,"_17592":100856,"_5":17487,"_23859":100783,"_2388":100857},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2864":59462,"_25225":59436,"_17592":100859,"_5":17487,"_23859":100783,"_2388":100860},[],"Visión general de IoT Fleets",{"_2864":59463,"_25225":59436,"_17592":100862,"_5":17487,"_23859":100783,"_2388":100863},[],"**Administración**",{"_2864":59464,"_25225":59436,"_17592":100865,"_5":17487,"_23859":100783,"_2388":100866},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2864":59465,"_25225":59436,"_17592":100868,"_5":17487,"_23859":100783,"_2388":97369},[],{"_2864":59466,"_25225":59436,"_17592":100870,"_5":17487,"_23859":100783,"_2388":100871},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2864":59467,"_25225":59436,"_17592":100873,"_5":17487,"_23859":100787,"_2388":100874},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2864":59468,"_25225":59436,"_17592":100876,"_5":17487,"_23859":100787,"_2388":100877},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2864":59469,"_25225":59436,"_17592":100879,"_5":17487,"_23859":100787,"_2388":100880},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2864":59470,"_25225":59436,"_17592":100882,"_5":17487,"_23859":100787,"_2388":100883},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2864":59471,"_25225":59436,"_17592":100885,"_5":17487,"_23859":100787,"_2388":100886},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2864":59472,"_25225":59436,"_17592":100888,"_5":17487,"_23859":100787,"_2388":100889},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2864":59473,"_25225":59436,"_17592":100891,"_5":17487,"_23859":100795,"_2388":100892},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2864":59474,"_25225":59436,"_17592":100894,"_5":17487,"_23859":100799,"_2388":100895},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2864":59475,"_25225":59436,"_17592":100897,"_5":17487,"_23859":100803,"_2388":100898},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2864":59476,"_25225":59436,"_17592":100900,"_5":17487,"_23859":100807,"_2388":100901},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2864":59477,"_25225":59436,"_17592":100903,"_5":17487,"_23859":100811,"_2388":100904},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2864":59478,"_25225":59436,"_17592":100906,"_5":17487,"_23859":100815,"_2388":100907},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2864":59479,"_25225":59436,"_17592":100909,"_5":17487,"_23859":100819,"_2388":100363},[],{"_2864":59480,"_25225":59436,"_17592":100911,"_5":17487,"_23859":100819,"_2388":100912},[],"Qué prepara o comprueba",{"_2864":59481,"_25225":59436,"_17592":100914,"_5":17487,"_23859":100819,"_2388":100366},[],{"_2864":59482,"_25225":59436,"_17592":100916,"_5":17487,"_23859":100819,"_2388":100917},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2864":59483,"_25225":59436,"_17592":100919,"_5":17487,"_23859":100819,"_2388":100920},[],"Administrador de la flota",{"_2864":59484,"_25225":59436,"_17592":100922,"_5":17487,"_23859":100819,"_2388":100923},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2864":59485,"_25225":59436,"_17592":100925,"_5":17487,"_23859":100819,"_2388":100378},[],{"_2864":59486,"_25225":59436,"_17592":100927,"_5":17487,"_23859":100819,"_2388":100928},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2864":59487,"_25225":59436,"_17592":100930,"_5":17487,"_23859":100819,"_2388":100384},[],{"_2864":59488,"_25225":59436,"_17592":100932,"_5":17487,"_23859":100819,"_2388":100933},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2864":59489,"_25225":59436,"_17592":100935,"_5":17487,"_23859":100819,"_2388":100936},[],"Operador de infraestructura",{"_2864":59490,"_25225":59436,"_17592":100938,"_5":17487,"_23859":100819,"_2388":100939},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2864":59491,"_25225":59436,"_17592":100941,"_5":17487,"_23859":100819,"_2388":100942},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2864":59492,"_25225":59492,"_5":12320,"_2388":100944,"_25561":100945,"_17592":100947,"_23859":59492},"Jerarquía y rotación de CAs",[40930,97371,45965,100946],"Claves, autoridades y certificados",[],{"_2864":59493,"_25225":59492,"_17592":100949,"_5":17487,"_23859":59492,"_2388":100950},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2864":59494,"_25225":59492,"_5":25558,"_17592":100952,"_23859":100953,"_2388":100954},[],"/docs/pr-preview/pr-41/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2864":59495,"_25225":59492,"_5":25558,"_17592":100956,"_23859":100957,"_2388":100958},[],"/docs/pr-preview/pr-41/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2864":59496,"_25225":59492,"_5":25558,"_17592":100960,"_23859":100961,"_2388":100962},[],"/docs/pr-preview/pr-41/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2864":59497,"_25225":59492,"_5":25558,"_17592":100964,"_23859":100965,"_2388":100966},[],"/docs/pr-preview/pr-41/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2864":59498,"_25225":59492,"_5":25558,"_17592":100968,"_23859":100969,"_2388":100970},[],"/docs/pr-preview/pr-41/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2864":59499,"_25225":59492,"_5":25558,"_17592":100972,"_23859":100973,"_2388":100974},[],"/docs/pr-preview/pr-41/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2864":59500,"_25225":59492,"_5":25558,"_17592":100976,"_23859":100977,"_2388":100978},[],"/docs/pr-preview/pr-41/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2864":59501,"_25225":59492,"_5":25558,"_17592":100980,"_23859":100981,"_2388":100982},[],"/docs/pr-preview/pr-41/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2864":59502,"_25225":59492,"_5":25558,"_17592":100984,"_23859":100985,"_2388":100986},[],"/docs/pr-preview/pr-41/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2864":59503,"_25225":59492,"_5":25558,"_17592":100988,"_23859":100989,"_2388":100990},[],"/docs/pr-preview/pr-41/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2864":59504,"_25225":59492,"_5":25558,"_17592":100992,"_23859":100993,"_2388":100994},[],"/docs/pr-preview/pr-41/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2864":59505,"_25225":59492,"_5":25558,"_17592":100996,"_23859":100997,"_2388":100998},[],"/docs/pr-preview/pr-41/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2864":59506,"_25225":59492,"_17592":101000,"_5":17487,"_23859":59492,"_2388":101001},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2864":59507,"_25225":59492,"_17592":101003,"_5":17487,"_23859":59492,"_2388":101004},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2864":59508,"_25225":59492,"_17592":101006,"_5":17487,"_23859":100953,"_2388":101007},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2864":59509,"_25225":59492,"_17592":101009,"_5":17487,"_23859":100953,"_2388":101010},[],"entorno, como producción y preproducción;",{"_2864":59510,"_25225":59492,"_17592":101012,"_5":17487,"_23859":100953,"_2388":101013},[],"propietario o equipo operador;",{"_2864":59511,"_25225":59492,"_17592":101015,"_5":17487,"_23859":100953,"_2388":101016},[],"familia de dispositivos o proceso de fabricación;",{"_2864":59512,"_25225":59492,"_17592":101018,"_5":17487,"_23859":100953,"_2388":101019},[],"región o requisito regulatorio;",{"_2864":59513,"_25225":59492,"_17592":101021,"_5":17487,"_23859":100953,"_2388":101022},[],"motor criptográfico o política de clave;",{"_2864":59514,"_25225":59492,"_17592":101024,"_5":17487,"_23859":100953,"_2388":101025},[],"ventana de mantenimiento y ritmo de renovación.",{"_2864":59515,"_25225":59492,"_17592":101027,"_5":17487,"_23859":100953,"_2388":101028},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2864":59516,"_25225":59492,"_17592":101030,"_5":17487,"_23859":100953,"_2388":101031},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2864":59517,"_25225":59492,"_17592":101033,"_5":17487,"_23859":100957,"_2388":101034},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2864":59518,"_25225":59492,"_17592":101036,"_5":17487,"_23859":100957,"_2388":101037},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2864":59519,"_25225":59492,"_17592":101039,"_5":17487,"_23859":100957,"_2388":101040},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2864":59520,"_25225":59492,"_17592":101042,"_5":17487,"_23859":100961,"_2388":101043},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2864":59521,"_25225":59492,"_17592":101045,"_5":17487,"_23859":100961,"_2388":101046},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2864":59522,"_25225":59492,"_17592":101048,"_5":17487,"_23859":100961,"_2388":101049},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2864":59523,"_25225":59492,"_17592":101051,"_5":17487,"_23859":100961,"_2388":101052},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2864":59524,"_25225":59492,"_17592":101054,"_5":17487,"_23859":100969,"_2388":101055},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2864":59525,"_25225":59492,"_17592":101057,"_5":17487,"_23859":100973,"_2388":101058},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2864":59526,"_25225":59492,"_17592":101060,"_5":17487,"_23859":100977,"_2388":101061},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2864":59527,"_25225":59492,"_17592":101063,"_5":17487,"_23859":100981,"_2388":101064},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2864":59528,"_25225":59492,"_17592":101066,"_5":17487,"_23859":100985,"_2388":101067},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2864":59529,"_25225":59492,"_17592":101069,"_5":17487,"_23859":100989,"_2388":101070},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2864":59530,"_25225":59492,"_17592":101072,"_5":17487,"_23859":100993,"_2388":101073},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2864":59531,"_25225":59492,"_17592":101075,"_5":17487,"_23859":100993,"_2388":101076},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2864":59532,"_25225":59492,"_17592":101078,"_5":17487,"_23859":100993,"_2388":101079},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2864":59533,"_25225":59492,"_17592":101081,"_5":17487,"_23859":100993,"_2388":101082},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2864":59534,"_25225":59492,"_17592":101084,"_5":17487,"_23859":100997,"_2388":101085},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2864":59535,"_25225":59492,"_17592":101087,"_5":17487,"_23859":100997,"_2388":101088},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2864":59536,"_25225":59492,"_17592":101090,"_5":17487,"_23859":100997,"_2388":101091},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2864":59537,"_25225":59492,"_17592":101093,"_5":17487,"_23859":100997,"_2388":101094},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2864":59538,"_25225":59492,"_17592":101096,"_5":17487,"_23859":100997,"_2388":101097},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2864":59539,"_25225":59492,"_17592":101099,"_5":17487,"_23859":100997,"_2388":101100},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2864":59540,"_25225":59492,"_17592":101102,"_5":17487,"_23859":100997,"_2388":101103},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2864":59541,"_25225":59541,"_5":12320,"_2388":101105,"_25561":101106,"_17592":101107,"_23859":59541},"Autoridades de certificación",[40930,97371,45965,100946],[],{"_2864":59542,"_25225":59541,"_17592":101109,"_5":17487,"_23859":59541,"_2388":101110},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2864":59543,"_25225":59541,"_5":25558,"_17592":101112,"_23859":101113,"_2388":101114},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2864":59544,"_25225":59541,"_5":25558,"_17592":101116,"_23859":101117,"_2388":101118},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2864":59545,"_25225":59541,"_5":25558,"_17592":101120,"_23859":101121,"_2388":96059},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2864":59546,"_25225":59541,"_5":25558,"_17592":101123,"_23859":101124,"_2388":101125},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2864":59547,"_25225":59541,"_5":25558,"_17592":101127,"_23859":101128,"_2388":101129},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2864":59548,"_25225":59541,"_5":25558,"_17592":101131,"_23859":101132,"_2388":101133},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2864":59549,"_25225":59541,"_5":25558,"_17592":101135,"_23859":101136,"_2388":101137},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2864":59550,"_25225":59541,"_5":25558,"_17592":101139,"_23859":101140,"_2388":101141},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2864":59551,"_25225":59541,"_5":25558,"_17592":101143,"_23859":101144,"_2388":101145},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2864":59552,"_25225":59541,"_5":25558,"_17592":101147,"_23859":101148,"_2388":101149},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2864":59553,"_25225":59541,"_5":25558,"_17592":101151,"_23859":101152,"_2388":101153},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2864":59554,"_25225":59541,"_5":25558,"_17592":101155,"_23859":101156,"_2388":101157},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2864":59555,"_25225":59541,"_5":25558,"_17592":101159,"_23859":101160,"_2388":101161},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2864":59556,"_25225":59541,"_5":25558,"_17592":101163,"_23859":101164,"_2388":101165},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2864":59557,"_25225":59541,"_5":25558,"_17592":101167,"_23859":101168,"_2388":101169},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2864":59558,"_25225":59541,"_5":25558,"_17592":101171,"_23859":101172,"_2388":101173},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2864":59559,"_25225":59541,"_5":25558,"_17592":101175,"_23859":101176,"_2388":101177},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2864":59560,"_25225":59541,"_5":25558,"_17592":101179,"_23859":101180,"_2388":101181},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2864":59561,"_25225":59541,"_5":25558,"_17592":101183,"_23859":101184,"_2388":101185},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2864":59562,"_25225":59541,"_5":25558,"_17592":101187,"_23859":101188,"_2388":101189},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2864":59563,"_25225":59541,"_5":25558,"_17592":101191,"_23859":101192,"_2388":101193},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2864":59564,"_25225":59541,"_5":25558,"_17592":101195,"_23859":101196,"_2388":101197},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2864":59565,"_25225":59541,"_17592":101199,"_5":17487,"_23859":59541,"_2388":101200},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2864":59566,"_25225":59541,"_17592":101202,"_5":17487,"_23859":59541,"_2388":101203},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2864":59567,"_25225":59541,"_17592":101205,"_5":17487,"_23859":59541,"_2388":101206},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2864":59568,"_25225":59541,"_17592":101208,"_5":17487,"_23859":101113,"_2388":101209},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2864":59569,"_25225":59541,"_17592":101211,"_5":17487,"_23859":101113,"_2388":101212},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2864":59570,"_25225":59541,"_17592":101214,"_5":17487,"_23859":101113,"_2388":101215},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2864":59571,"_25225":59541,"_17592":101217,"_5":17487,"_23859":101113,"_2388":101218},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2864":59572,"_25225":59541,"_17592":101220,"_5":17487,"_23859":101113,"_2388":101221},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2864":59573,"_25225":59541,"_17592":101223,"_5":17487,"_23859":101121,"_2388":101224},[],"Decide si la CA será raíz o intermedia.",{"_2864":59574,"_25225":59541,"_17592":101226,"_5":17487,"_23859":101121,"_2388":101227},[],"Elige el motor que custodiará la clave.",{"_2864":59575,"_25225":59541,"_17592":101229,"_5":17487,"_23859":101121,"_2388":101230},[],"Define una validez superior a la de los certificados que emitirá.",{"_2864":59576,"_25225":59541,"_17592":101232,"_5":17487,"_23859":101121,"_2388":101233},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2864":59577,"_25225":59541,"_17592":101235,"_5":17487,"_23859":101124,"_2388":101236},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2864":59578,"_25225":59541,"_17592":101238,"_5":17487,"_23859":101128,"_2388":101239},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2864":59579,"_25225":59541,"_17592":101241,"_5":17487,"_23859":101128,"_2388":101242},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2864":59580,"_25225":59541,"_17592":101244,"_5":17487,"_23859":101132,"_2388":101245},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2864":59581,"_25225":59541,"_17592":101247,"_5":17487,"_23859":101136,"_2388":101248},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2864":59582,"_25225":59541,"_17592":101250,"_5":17487,"_23859":101136,"_2388":101251},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2864":59583,"_25225":59541,"_17592":101253,"_5":17487,"_23859":101136,"_2388":101254},[],"`ST`: estado o provincia.",{"_2864":59584,"_25225":59541,"_17592":101256,"_5":17487,"_23859":101136,"_2388":101257},[],"`L`: localidad.",{"_2864":59585,"_25225":59541,"_17592":101259,"_5":17487,"_23859":101136,"_2388":101260},[],"`O`: organización.",{"_2864":59586,"_25225":59541,"_17592":101262,"_5":17487,"_23859":101136,"_2388":101263},[],"`OU`: unidad organizativa.",{"_2864":59587,"_25225":59541,"_17592":101265,"_5":17487,"_23859":101136,"_2388":101266},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2864":59588,"_25225":59541,"_17592":101268,"_5":17487,"_23859":101140,"_2388":101269},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2864":59589,"_25225":59541,"_17592":101271,"_5":17487,"_23859":101140,"_2388":101272},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2864":59590,"_25225":59541,"_17592":101274,"_5":17487,"_23859":101144,"_2388":101275},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2864":59591,"_25225":59541,"_17592":101277,"_5":17487,"_23859":101144,"_2388":101278},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2864":59592,"_25225":59541,"_17592":101280,"_5":17487,"_23859":101148,"_2388":101281},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2864":59593,"_25225":59541,"_17592":101283,"_5":17487,"_23859":101148,"_2388":101284},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2864":59594,"_25225":59541,"_17592":101286,"_5":17487,"_23859":101152,"_2388":101287},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2864":59595,"_25225":59541,"_17592":101289,"_5":17487,"_23859":101156,"_2388":101290},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2864":59596,"_25225":59541,"_17592":101292,"_5":17487,"_23859":101160,"_2388":101293},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2864":59597,"_25225":59541,"_17592":101295,"_5":17487,"_23859":101164,"_2388":101296},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2864":59598,"_25225":59541,"_17592":101298,"_5":17487,"_23859":101168,"_2388":101299},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2864":59599,"_25225":59541,"_17592":101301,"_5":17487,"_23859":101168,"_2388":101302},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2864":59600,"_25225":59541,"_17592":101304,"_5":17487,"_23859":101172,"_2388":101305},[],"Abre una CA desde el inventario para consultar:",{"_2864":59601,"_25225":59541,"_17592":101307,"_5":17487,"_23859":101172,"_2388":101308},[],"Estado y periodo de validez.",{"_2864":59602,"_25225":59541,"_17592":101310,"_5":17487,"_23859":101172,"_2388":101311},[],"Certificado y cadena en formato PEM.",{"_2864":59603,"_25225":59541,"_17592":101313,"_5":17487,"_23859":101172,"_2388":101314},[],"Número de certificados activos, expirados y revocados.",{"_2864":59604,"_25225":59541,"_17592":101316,"_5":17487,"_23859":101172,"_2388":101317},[],"Certificados emitidos en **Issued Certificates**.",{"_2864":59605,"_25225":59541,"_17592":101319,"_5":17487,"_23859":101172,"_2388":101320},[],"CRL vinculada a la autoridad.",{"_2864":59606,"_25225":59541,"_17592":101322,"_5":17487,"_23859":101172,"_2388":101323},[],"Metadatos y motor criptográfico asociado.",{"_2864":59607,"_25225":59541,"_17592":101325,"_5":17487,"_23859":101172,"_2388":101326},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2864":59608,"_25225":59541,"_17592":101328,"_5":17487,"_23859":101176,"_2388":101329},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2864":59609,"_25225":59541,"_17592":101331,"_5":17487,"_23859":101176,"_2388":101332},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2864":59610,"_25225":59541,"_17592":101334,"_5":17487,"_23859":101176,"_2388":101335},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2864":59611,"_25225":59541,"_17592":101337,"_5":17487,"_23859":101176,"_2388":101338},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2864":59612,"_25225":59541,"_17592":101340,"_5":17487,"_23859":101180,"_2388":101341},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2864":59613,"_25225":59541,"_17592":101343,"_5":17487,"_23859":101184,"_2388":101344},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2864":59614,"_25225":59541,"_17592":101346,"_5":17487,"_23859":101188,"_2388":101347},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2864":59615,"_25225":59541,"_17592":101349,"_5":17487,"_23859":101192,"_2388":101350},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2864":59616,"_25225":59541,"_17592":101352,"_5":17487,"_23859":101196,"_2388":101353},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2864":59617,"_25225":59541,"_17592":101355,"_5":17487,"_23859":101196,"_2388":101356},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2864":59618,"_25225":59618,"_5":12320,"_2388":101358,"_25561":101359,"_17592":101360,"_23859":59618},"Perfiles de certificado",[40930,97371,45965,100946],[],{"_2864":59619,"_25225":59618,"_17592":101362,"_5":17487,"_23859":59618,"_2388":101363},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2864":59620,"_25225":59618,"_5":25558,"_17592":101365,"_23859":101366,"_2388":101367},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2864":59621,"_25225":59618,"_5":25558,"_17592":101369,"_23859":101370,"_2388":101371},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#validez","Validez",{"_2864":59622,"_25225":59618,"_5":25558,"_17592":101373,"_23859":101374,"_2388":101375},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2864":59623,"_25225":59618,"_5":25558,"_17592":101377,"_23859":101378,"_2388":101379},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2864":59624,"_25225":59618,"_5":25558,"_17592":101381,"_23859":101382,"_2388":101383},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2864":59625,"_25225":59618,"_5":25558,"_17592":101385,"_23859":101386,"_2388":101387},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2864":59626,"_25225":59618,"_5":25558,"_17592":101389,"_23859":101390,"_2388":101391},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2864":59627,"_25225":59618,"_5":25558,"_17592":101393,"_23859":101394,"_2388":101395},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2864":59628,"_25225":59618,"_5":25558,"_17592":101397,"_23859":101398,"_2388":101399},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2864":59629,"_25225":59618,"_5":25558,"_17592":101401,"_23859":101402,"_2388":101403},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2864":59630,"_25225":59618,"_5":25558,"_17592":101405,"_23859":101406,"_2388":101407},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2864":59631,"_25225":59618,"_5":25558,"_17592":101409,"_23859":101410,"_2388":101411},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2864":59632,"_25225":59618,"_5":25558,"_17592":101413,"_23859":101414,"_2388":101415},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2864":59633,"_25225":59618,"_5":25558,"_17592":101417,"_23859":101418,"_2388":101419},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2864":59634,"_25225":59618,"_5":25558,"_17592":101421,"_23859":101422,"_2388":101423},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2864":59635,"_25225":59618,"_5":25558,"_17592":101425,"_23859":101426,"_2388":101427},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2864":59636,"_25225":59618,"_17592":101429,"_5":17487,"_23859":59618,"_2388":101430},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2864":59637,"_25225":59618,"_17592":101432,"_5":17487,"_23859":59618,"_2388":101433},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2864":59638,"_25225":59618,"_17592":101435,"_5":17487,"_23859":101370,"_2388":101436},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2864":59639,"_25225":59618,"_17592":101438,"_5":17487,"_23859":101370,"_2388":101439},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2864":59640,"_25225":59618,"_17592":101441,"_5":17487,"_23859":101374,"_2388":101442},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2864":59641,"_25225":59618,"_17592":101444,"_5":17487,"_23859":101378,"_2388":101445},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2864":59642,"_25225":59618,"_17592":101447,"_5":17487,"_23859":101378,"_2388":101448},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2864":59643,"_25225":59618,"_17592":101450,"_5":17487,"_23859":101378,"_2388":101451},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2864":59644,"_25225":59618,"_17592":101453,"_5":17487,"_23859":101382,"_2388":101454},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2864":59645,"_25225":59618,"_17592":101456,"_5":17487,"_23859":101386,"_2388":101457},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2864":59646,"_25225":59618,"_17592":101459,"_5":17487,"_23859":101386,"_2388":101460},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2864":59647,"_25225":59618,"_17592":101462,"_5":17487,"_23859":101390,"_2388":101463},[],"La aplicación criptográfica puede:",{"_2864":59648,"_25225":59618,"_17592":101465,"_5":17487,"_23859":101390,"_2388":101466},[],"permitir o bloquear claves RSA;",{"_2864":59649,"_25225":59618,"_17592":101468,"_5":17487,"_23859":101390,"_2388":101469},[],"limitar los tamaños RSA admitidos;",{"_2864":59650,"_25225":59618,"_17592":101471,"_5":17487,"_23859":101390,"_2388":101472},[],"permitir o bloquear claves ECDSA;",{"_2864":59651,"_25225":59618,"_17592":101474,"_5":17487,"_23859":101390,"_2388":101475},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2864":59652,"_25225":59618,"_17592":101477,"_5":17487,"_23859":101390,"_2388":101478},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2864":59653,"_25225":59618,"_17592":101480,"_5":17487,"_23859":101394,"_2388":101481},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2864":59654,"_25225":59618,"_17592":101483,"_5":17487,"_23859":101394,"_2388":97159},[],{"_2864":59655,"_25225":59618,"_17592":101485,"_5":17487,"_23859":101394,"_2388":101486},[],"Primera opción",{"_2864":59656,"_25225":59618,"_17592":101488,"_5":17487,"_23859":101394,"_2388":101489},[],"Segunda opción",{"_2864":59657,"_25225":59618,"_17592":101491,"_5":17487,"_23859":101394,"_2388":101492},[],"Si no hay ninguna",{"_2864":59658,"_25225":59618,"_17592":101494,"_5":17487,"_23859":101394,"_2388":101495},[],"Firma directa con una CA",{"_2864":59659,"_25225":59618,"_17592":101497,"_5":17487,"_23859":101394,"_2388":101498},[],"`issuance_profile` incluido en la solicitud",{"_2864":59660,"_25225":59618,"_17592":101500,"_5":17487,"_23859":101394,"_2388":101501},[],"`issuance_profile_id` de la solicitud",{"_2864":59661,"_25225":59618,"_17592":101503,"_5":17487,"_23859":101394,"_2388":101504},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2864":59662,"_25225":59618,"_17592":101506,"_5":17487,"_23859":101394,"_2388":101507},[],"Emisión mediante DMS",{"_2864":59663,"_25225":59618,"_17592":101509,"_5":17487,"_23859":101394,"_2388":46530},[],{"_2864":59664,"_25225":59618,"_17592":101511,"_5":17487,"_23859":101394,"_2388":101512},[],"`settings.issuance_profile` incluido en el DMS",{"_2864":59665,"_25225":59618,"_17592":101514,"_5":17487,"_23859":101394,"_2388":101515},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2864":59666,"_25225":59618,"_17592":101517,"_5":17487,"_23859":101394,"_2388":101518},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2864":59667,"_25225":59618,"_17592":101520,"_5":17487,"_23859":101394,"_2388":101521},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2864":59668,"_25225":59618,"_17592":101523,"_5":17487,"_23859":101402,"_2388":101524},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2864":59669,"_25225":59618,"_17592":101526,"_5":17487,"_23859":101406,"_2388":101527},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2864":59670,"_25225":59618,"_17592":101529,"_5":17487,"_23859":101410,"_2388":101530},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2864":59671,"_25225":59618,"_17592":101532,"_5":17487,"_23859":101414,"_2388":101533},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2864":59672,"_25225":59618,"_17592":101535,"_5":17487,"_23859":101418,"_2388":101536},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2864":59673,"_25225":59618,"_17592":101538,"_5":17487,"_23859":101418,"_2388":101539},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2864":59674,"_25225":59618,"_17592":101541,"_5":17487,"_23859":101422,"_2388":101542},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2864":59675,"_25225":59618,"_17592":101544,"_5":17487,"_23859":101422,"_2388":101545},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2864":59676,"_25225":59618,"_17592":101547,"_5":17487,"_23859":101422,"_2388":101548},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2864":59677,"_25225":59618,"_17592":101550,"_5":17487,"_23859":101422,"_2388":101551},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2864":59678,"_25225":59618,"_17592":101553,"_5":17487,"_23859":101426,"_2388":101554},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2864":59679,"_25225":59618,"_17592":101556,"_5":17487,"_23859":101426,"_2388":101557},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2864":59680,"_25225":59680,"_5":12320,"_2388":101559,"_25561":101560,"_17592":101562,"_23859":59680},"Validación de certificados",[40930,97371,45965,101561],"Validación",[],{"_2864":59681,"_25225":59680,"_17592":101564,"_5":17487,"_23859":59680,"_2388":101565},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2864":59682,"_25225":59680,"_5":25558,"_17592":101567,"_23859":101568,"_2388":101569},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2864":59683,"_25225":59680,"_5":25558,"_17592":101571,"_23859":101572,"_2388":101573},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2864":59684,"_25225":59680,"_5":25558,"_17592":101575,"_23859":101576,"_2388":101577},[],"/docs/pr-preview/pr-41/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2864":59685,"_25225":59680,"_17592":101579,"_5":17487,"_23859":59680,"_2388":101580},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2864":59686,"_25225":59680,"_17592":101582,"_5":17487,"_23859":101568,"_2388":101583},[],"Verifica estos criterios juntos:",{"_2864":59687,"_25225":59680,"_17592":101585,"_5":17487,"_23859":101568,"_2388":100573},[],{"_2864":59688,"_25225":59680,"_17592":101587,"_5":17487,"_23859":101568,"_2388":101588},[],"Resultado necesario",{"_2864":59689,"_25225":59680,"_17592":101590,"_5":17487,"_23859":101568,"_2388":101591},[],"Cadena y firma",{"_2864":59690,"_25225":59680,"_17592":101593,"_5":17487,"_23859":101568,"_2388":101594},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2864":59691,"_25225":59680,"_17592":101596,"_5":17487,"_23859":101568,"_2388":101597},[],"Fechas",{"_2864":59692,"_25225":59680,"_17592":101599,"_5":17487,"_23859":101568,"_2388":101600},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2864":59693,"_25225":59680,"_17592":101602,"_5":17487,"_23859":101568,"_2388":97072},[],{"_2864":59694,"_25225":59680,"_17592":101604,"_5":17487,"_23859":101568,"_2388":101605},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2864":59695,"_25225":59680,"_17592":101607,"_5":17487,"_23859":101568,"_2388":101608},[],"Uso",{"_2864":59696,"_25225":59680,"_17592":101610,"_5":17487,"_23859":101568,"_2388":101611},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2864":59697,"_25225":59680,"_17592":101613,"_5":17487,"_23859":101568,"_2388":101614},[],"Revocación",{"_2864":59698,"_25225":59680,"_17592":101616,"_5":17487,"_23859":101568,"_2388":101617},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2864":59699,"_25225":59680,"_17592":101619,"_5":17487,"_23859":101568,"_2388":101620},[],"Autorización",{"_2864":59700,"_25225":59680,"_17592":101622,"_5":17487,"_23859":101568,"_2388":101623},[],"La aplicación permite la acción a esa identidad.",{"_2864":59701,"_25225":59680,"_17592":101625,"_5":17487,"_23859":101568,"_2388":101626},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2864":59702,"_25225":59680,"_17592":101628,"_5":17487,"_23859":101572,"_2388":101629},[],"Mecanismo",{"_2864":59703,"_25225":59680,"_17592":101631,"_5":17487,"_23859":101572,"_2388":101632},[],"Cuándo utilizarlo",{"_2864":59704,"_25225":59680,"_17592":101634,"_5":17487,"_23859":101572,"_2388":101635},[],"Qué debes mantener",{"_2864":59705,"_25225":59680,"_17592":101637,"_5":17487,"_23859":101572,"_2388":46658},[],{"_2864":59706,"_25225":59680,"_17592":101639,"_5":17487,"_23859":101572,"_2388":101640},[],"Consulta del estado de un certificado concreto.",{"_2864":59707,"_25225":59680,"_17592":101642,"_5":17487,"_23859":101572,"_2388":101643},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2864":59708,"_25225":59680,"_17592":101645,"_5":17487,"_23859":101572,"_2388":46667},[],{"_2864":59709,"_25225":59680,"_17592":101647,"_5":17487,"_23859":101572,"_2388":101648},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2864":59710,"_25225":59680,"_17592":101650,"_5":17487,"_23859":101572,"_2388":101651},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2864":59711,"_25225":59680,"_17592":101653,"_5":17487,"_23859":101572,"_2388":101654},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2864":59712,"_25225":59680,"_17592":101656,"_5":17487,"_23859":101572,"_2388":101657},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2864":59713,"_25225":59680,"_17592":101659,"_5":17487,"_23859":101576,"_2388":101660},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2864":59714,"_25225":59680,"_17592":101662,"_5":17487,"_23859":101576,"_2388":101663},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2864":59715,"_25225":59680,"_17592":101665,"_5":17487,"_23859":101576,"_2388":101666},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2864":59716,"_25225":59680,"_17592":101668,"_5":17487,"_23859":101576,"_2388":101669},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2864":59717,"_25225":59680,"_17592":101671,"_5":17487,"_23859":101576,"_2388":101672},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2864":59718,"_25225":59680,"_17592":101674,"_5":17487,"_23859":101576,"_2388":101675},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2864":59719,"_25225":59680,"_17592":101677,"_5":17487,"_23859":101576,"_2388":101678},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2864":59720,"_25225":59680,"_17592":101680,"_5":17487,"_23859":101576,"_2388":101681},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2864":59721,"_25225":59680,"_17592":101683,"_5":17487,"_23859":101576,"_2388":101684},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2864":59722,"_25225":59722,"_5":12320,"_2388":101686,"_25561":101687,"_17592":101688,"_23859":59722},"Certificados",[40930,97371,45965,100946],[],{"_2864":59723,"_25225":59722,"_17592":101690,"_5":17487,"_23859":59722,"_2388":101691},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2864":59724,"_25225":59722,"_5":25558,"_17592":101693,"_23859":101694,"_2388":101695},[],"/docs/pr-preview/pr-41/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2864":59725,"_25225":59722,"_5":25558,"_17592":101697,"_23859":101698,"_2388":101699},[],"/docs/pr-preview/pr-41/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2864":59726,"_25225":59722,"_5":25558,"_17592":101701,"_23859":101702,"_2388":101703},[],"/docs/pr-preview/pr-41/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2864":59727,"_25225":59722,"_5":25558,"_17592":101705,"_23859":101706,"_2388":101707},[],"/docs/pr-preview/pr-41/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2864":59728,"_25225":59722,"_5":25558,"_17592":101709,"_23859":101710,"_2388":101711},[],"/docs/pr-preview/pr-41/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2864":59729,"_25225":59722,"_5":25558,"_17592":101713,"_23859":101714,"_2388":101715},[],"/docs/pr-preview/pr-41/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2864":59730,"_25225":59722,"_5":25558,"_17592":101717,"_23859":101718,"_2388":101719},[],"/docs/pr-preview/pr-41/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2864":59731,"_25225":59722,"_5":25558,"_17592":101721,"_23859":101722,"_2388":101723},[],"/docs/pr-preview/pr-41/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2864":59732,"_25225":59722,"_5":25558,"_17592":101725,"_23859":101726,"_2388":101727},[],"/docs/pr-preview/pr-41/es/platform/pki/certificates#continúa","Continúa",{"_2864":59733,"_25225":59722,"_17592":101729,"_5":17487,"_23859":59722,"_2388":101730},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2864":59734,"_25225":59722,"_17592":101732,"_5":17487,"_23859":101694,"_2388":101733},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2864":59735,"_25225":59722,"_17592":101735,"_5":17487,"_23859":101694,"_2388":101736},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2864":59736,"_25225":59722,"_17592":101738,"_5":17487,"_23859":101698,"_2388":101739},[],"Descarga el PEM e inspecciónalo:",{"_2864":59737,"_25225":59722,"_17592":101741,"_5":17487,"_23859":101698,"_2388":101742},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2864":59738,"_25225":59722,"_17592":101744,"_5":17487,"_23859":101702,"_2388":101745},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2864":59739,"_25225":59722,"_17592":101747,"_5":17487,"_23859":101702,"_2388":101748},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2864":59740,"_25225":59722,"_17592":101750,"_5":17487,"_23859":101702,"_2388":101751},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2864":59741,"_25225":59722,"_17592":101753,"_5":17487,"_23859":101702,"_2388":101754},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2864":59742,"_25225":59722,"_17592":101756,"_5":17487,"_23859":101702,"_2388":101757},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2864":59743,"_25225":59722,"_17592":101759,"_5":17487,"_23859":101702,"_2388":101760},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2864":59744,"_25225":59722,"_17592":101762,"_5":17487,"_23859":101702,"_2388":101763},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2864":59745,"_25225":59722,"_17592":101765,"_5":17487,"_23859":101706,"_2388":101766},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2864":59746,"_25225":59722,"_17592":101768,"_5":17487,"_23859":101710,"_2388":101769},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2864":59747,"_25225":59722,"_17592":101771,"_5":17487,"_23859":101714,"_2388":101772},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2864":59748,"_25225":59722,"_17592":101774,"_5":17487,"_23859":101718,"_2388":101775},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2864":59749,"_25225":59722,"_17592":101777,"_5":17487,"_23859":101718,"_2388":101778},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2864":59750,"_25225":59722,"_17592":101780,"_5":17487,"_23859":101718,"_2388":101781},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2864":59751,"_25225":59722,"_17592":101783,"_5":17487,"_23859":101722,"_2388":101784},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2864":59752,"_25225":59722,"_17592":101786,"_5":17487,"_23859":101722,"_2388":101787},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2864":59753,"_25225":59722,"_17592":101789,"_5":17487,"_23859":101722,"_2388":101790},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2864":59754,"_25225":59722,"_17592":101792,"_5":17487,"_23859":101726,"_2388":101793},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2864":59755,"_25225":59722,"_17592":101795,"_5":17487,"_23859":101726,"_2388":101796},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2864":59756,"_25225":59756,"_5":12320,"_2388":101798,"_25561":101799,"_17592":101801,"_23859":59756},"Ciclo de vida de un certificado",[40930,97371,45965,101800],"Conceptos",[],{"_2864":59757,"_25225":59756,"_17592":101803,"_5":17487,"_23859":59756,"_2388":101804},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2864":59758,"_25225":59756,"_5":25558,"_17592":101806,"_23859":101807,"_2388":101808},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2864":59759,"_25225":59756,"_5":25558,"_17592":101810,"_23859":101811,"_2388":101812},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2864":59760,"_25225":59756,"_5":25558,"_17592":101814,"_23859":101815,"_2388":101816},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2864":59761,"_25225":59756,"_5":25558,"_17592":101818,"_23859":101819,"_2388":101820},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2864":59762,"_25225":59756,"_5":25558,"_17592":101822,"_23859":101823,"_2388":101824},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2864":59763,"_25225":59756,"_5":25558,"_17592":101826,"_23859":101827,"_2388":101828},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2864":59764,"_25225":59756,"_5":25558,"_17592":101830,"_23859":101831,"_2388":101832},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2864":59765,"_25225":59756,"_5":25558,"_17592":101834,"_23859":101835,"_2388":101836},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2864":59766,"_25225":59756,"_5":25558,"_17592":101838,"_23859":101839,"_2388":101840},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2864":59767,"_25225":59756,"_5":25558,"_17592":101842,"_23859":101843,"_2388":101844},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2864":59768,"_25225":59756,"_17592":101846,"_5":17487,"_23859":59756,"_2388":101847},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2864":59769,"_25225":59756,"_17592":101849,"_5":17487,"_23859":101811,"_2388":101850},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2864":59770,"_25225":59756,"_17592":101852,"_5":17487,"_23859":101815,"_2388":101853},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2864":59771,"_25225":59756,"_17592":101855,"_5":17487,"_23859":101819,"_2388":101856},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2864":59772,"_25225":59756,"_17592":101858,"_5":17487,"_23859":101823,"_2388":101859},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2864":59773,"_25225":59756,"_17592":101861,"_5":17487,"_23859":101827,"_2388":101862},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2864":59774,"_25225":59756,"_17592":101864,"_5":17487,"_23859":101831,"_2388":101865},[],"Lamassu persiste cuatro estados X.509:",{"_2864":59775,"_25225":59756,"_17592":101867,"_5":17487,"_23859":101831,"_2388":101868},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2864":59776,"_25225":59756,"_17592":101870,"_5":17487,"_23859":101831,"_2388":101871},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2864":59777,"_25225":59756,"_17592":101873,"_5":17487,"_23859":101831,"_2388":101874},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2864":59778,"_25225":59756,"_17592":101876,"_5":17487,"_23859":101831,"_2388":101877},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2864":59779,"_25225":59756,"_17592":101879,"_5":17487,"_23859":101831,"_2388":101880},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2864":59780,"_25225":59756,"_17592":101882,"_5":17487,"_23859":101835,"_2388":101883},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2864":59781,"_25225":59756,"_17592":101885,"_5":17487,"_23859":101835,"_2388":101886},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2864":59782,"_25225":59756,"_17592":101888,"_5":17487,"_23859":101835,"_2388":101889},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2864":59783,"_25225":59756,"_17592":101891,"_5":17487,"_23859":101839,"_2388":101892},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2864":59784,"_25225":59756,"_17592":101894,"_5":17487,"_23859":101839,"_2388":101895},[],"Antes de confirmar:",{"_2864":59785,"_25225":59756,"_17592":101897,"_5":17487,"_23859":101839,"_2388":101898},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2864":59786,"_25225":59756,"_17592":101900,"_5":17487,"_23859":101839,"_2388":101901},[],"Distribuye la nueva cadena de confianza.",{"_2864":59787,"_25225":59756,"_17592":101903,"_5":17487,"_23859":101839,"_2388":101904},[],"Reemite las identidades necesarias.",{"_2864":59788,"_25225":59756,"_17592":101906,"_5":17487,"_23859":101839,"_2388":101907},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2864":59789,"_25225":59756,"_17592":101909,"_5":17487,"_23859":101839,"_2388":101910},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2864":59790,"_25225":59756,"_17592":101912,"_5":17487,"_23859":101839,"_2388":101913},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2864":59791,"_25225":59756,"_17592":101915,"_5":17487,"_23859":101843,"_2388":101916},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2864":59792,"_25225":59756,"_17592":101918,"_5":17487,"_23859":101843,"_2388":101919},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2864":59793,"_25225":59756,"_17592":101921,"_5":17487,"_23859":101843,"_2388":101922},[],"Cambios de estado y razones de revocación.",{"_2864":59794,"_25225":59756,"_17592":101924,"_5":17487,"_23859":101843,"_2388":101925},[],"Publicación y vigencia de OCSP y CRLs.",{"_2864":59795,"_25225":59756,"_17592":101927,"_5":17487,"_23859":101843,"_2388":101928},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2864":59796,"_25225":59756,"_17592":101930,"_5":17487,"_23859":101843,"_2388":101931},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2864":59797,"_25225":59797,"_5":12320,"_2388":101933,"_25561":101934,"_17592":101935,"_23859":59797},"Modelo de confianza",[40930,97371,45965,101800],[],{"_2864":59798,"_25225":59797,"_17592":101937,"_5":17487,"_23859":59797,"_2388":101938},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2864":59799,"_25225":59797,"_5":25558,"_17592":101940,"_23859":101941,"_2388":101942},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2864":59800,"_25225":59797,"_5":25558,"_17592":101944,"_23859":101945,"_2388":101946},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2864":59801,"_25225":59797,"_5":25558,"_17592":101948,"_23859":101949,"_2388":101950},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2864":59802,"_25225":59797,"_5":25558,"_17592":101952,"_23859":101953,"_2388":101954},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2864":59803,"_25225":59797,"_5":25558,"_17592":101956,"_23859":101957,"_2388":101958},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2864":59804,"_25225":59797,"_5":25558,"_17592":101960,"_23859":101961,"_2388":101962},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2864":59805,"_25225":59797,"_5":25558,"_17592":101964,"_23859":101965,"_2388":101966},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2864":59806,"_25225":59797,"_5":25558,"_17592":101968,"_23859":101969,"_2388":101970},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2864":59807,"_25225":59797,"_5":25558,"_17592":101972,"_23859":101973,"_2388":101974},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2864":59808,"_25225":59797,"_5":25558,"_17592":101976,"_23859":101977,"_2388":101978},[],"/docs/pr-preview/pr-41/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2864":59809,"_25225":59797,"_17592":101980,"_5":17487,"_23859":59797,"_2388":101981},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2864":59810,"_25225":59797,"_17592":101983,"_5":17487,"_23859":101945,"_2388":101984},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2864":59811,"_25225":59797,"_17592":101986,"_5":17487,"_23859":101949,"_2388":101987},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2864":59812,"_25225":59797,"_17592":101989,"_5":17487,"_23859":101953,"_2388":101990},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2864":59813,"_25225":59797,"_17592":101992,"_5":17487,"_23859":101957,"_2388":101993},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2864":59814,"_25225":59797,"_17592":101995,"_5":17487,"_23859":101961,"_2388":101996},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2864":59815,"_25225":59797,"_17592":101998,"_5":17487,"_23859":101961,"_2388":101999},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2864":59816,"_25225":59797,"_17592":102001,"_5":17487,"_23859":101961,"_2388":102002},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2864":59817,"_25225":59797,"_17592":102004,"_5":17487,"_23859":101961,"_2388":102005},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2864":59818,"_25225":59797,"_17592":102007,"_5":17487,"_23859":101961,"_2388":102008},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2864":59819,"_25225":59797,"_17592":102010,"_5":17487,"_23859":101961,"_2388":102011},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2864":59820,"_25225":59797,"_17592":102013,"_5":17487,"_23859":101965,"_2388":102014},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2864":59821,"_25225":59797,"_17592":102016,"_5":17487,"_23859":101965,"_2388":102017},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2864":59822,"_25225":59797,"_17592":102019,"_5":17487,"_23859":101965,"_2388":102020},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2864":59823,"_25225":59797,"_17592":102022,"_5":17487,"_23859":101965,"_2388":102023},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2864":59824,"_25225":59797,"_17592":102025,"_5":17487,"_23859":101965,"_2388":102026},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2864":59825,"_25225":59797,"_17592":102028,"_5":17487,"_23859":101969,"_2388":102029},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2864":59826,"_25225":59797,"_17592":102031,"_5":17487,"_23859":101969,"_2388":102032},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2864":59827,"_25225":59797,"_17592":102034,"_5":17487,"_23859":101969,"_2388":102035},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2864":59828,"_25225":59797,"_17592":102037,"_5":17487,"_23859":101969,"_2388":102038},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2864":59829,"_25225":59797,"_17592":102040,"_5":17487,"_23859":101969,"_2388":102041},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2864":59830,"_25225":59797,"_17592":102043,"_5":17487,"_23859":101969,"_2388":102044},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2864":59831,"_25225":59797,"_17592":102046,"_5":17487,"_23859":101969,"_2388":102047},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2864":59832,"_25225":59797,"_17592":102049,"_5":17487,"_23859":101973,"_2388":102050},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2864":59833,"_25225":59797,"_17592":102052,"_5":17487,"_23859":101977,"_2388":102053},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2864":59834,"_25225":59797,"_17592":102055,"_5":17487,"_23859":101977,"_2388":102056},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2864":59835,"_25225":59797,"_17592":102058,"_5":17487,"_23859":101977,"_2388":102059},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2864":59836,"_25225":59797,"_17592":102061,"_5":17487,"_23859":101977,"_2388":102062},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2864":59837,"_25225":59797,"_17592":102064,"_5":17487,"_23859":101977,"_2388":102065},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2864":59838,"_25225":59797,"_17592":102067,"_5":17487,"_23859":101977,"_2388":102068},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2864":59839,"_25225":59797,"_17592":102070,"_5":17487,"_23859":101977,"_2388":102071},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2864":59840,"_25225":59840,"_5":12320,"_2388":102073,"_25561":102074,"_17592":102075,"_23859":59840},"Listas de revocación (CRL)",[40930,97371,45965,101561],[],{"_2864":59841,"_25225":59840,"_17592":102077,"_5":17487,"_23859":59840,"_2388":102078},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2864":59842,"_25225":59840,"_5":25558,"_17592":102080,"_23859":102081,"_2388":102082},[],"/docs/pr-preview/pr-41/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2864":59843,"_25225":59840,"_5":25558,"_17592":102084,"_23859":102085,"_2388":102086},[],"/docs/pr-preview/pr-41/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2864":59844,"_25225":59840,"_5":25558,"_17592":102088,"_23859":102089,"_2388":102090},[],"/docs/pr-preview/pr-41/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2864":59845,"_25225":59840,"_5":25558,"_17592":102092,"_23859":102093,"_2388":102094},[],"/docs/pr-preview/pr-41/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2864":59846,"_25225":59840,"_5":25558,"_17592":102096,"_23859":102097,"_2388":102098},[],"/docs/pr-preview/pr-41/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2864":59847,"_25225":59840,"_5":25558,"_17592":102100,"_23859":102101,"_2388":102102},[],"/docs/pr-preview/pr-41/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2864":59848,"_25225":59840,"_5":25558,"_17592":102104,"_23859":102105,"_2388":102106},[],"/docs/pr-preview/pr-41/es/platform/pki/crl#referencias","Referencias",{"_2864":59849,"_25225":59840,"_17592":102108,"_5":17487,"_23859":59840,"_2388":102109},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2864":59850,"_25225":59840,"_17592":102111,"_5":17487,"_23859":102081,"_2388":102112},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2864":59851,"_25225":59840,"_17592":102114,"_5":17487,"_23859":102081,"_2388":102115},[],"Campo de `crl_options`",{"_2864":59852,"_25225":59840,"_17592":102117,"_5":17487,"_23859":102081,"_2388":98864},[],{"_2864":59853,"_25225":59840,"_17592":102119,"_5":17487,"_23859":102081,"_2388":102120},[],"Valor inicial del backend",{"_2864":59854,"_25225":59840,"_17592":102122,"_5":17487,"_23859":102081,"_2388":47145},[],{"_2864":59855,"_25225":59840,"_17592":102124,"_5":17487,"_23859":102081,"_2388":102125},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2864":59856,"_25225":59840,"_17592":102127,"_5":17487,"_23859":102081,"_2388":102128},[],"7 días.",{"_2864":59857,"_25225":59840,"_17592":102130,"_5":17487,"_23859":102081,"_2388":47154},[],{"_2864":59858,"_25225":59840,"_17592":102132,"_5":17487,"_23859":102081,"_2388":102133},[],"Plazo desde la publicación que activa la renovación programada.",{"_2864":59859,"_25225":59840,"_17592":102135,"_5":17487,"_23859":102081,"_2388":102136},[],"6 días y 23 horas.",{"_2864":59860,"_25225":59840,"_17592":102138,"_5":17487,"_23859":102081,"_2388":47163},[],{"_2864":59861,"_25225":59840,"_17592":102140,"_5":17487,"_23859":102081,"_2388":102141},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2864":59862,"_25225":59840,"_17592":102143,"_5":17487,"_23859":102081,"_2388":47169},[],{"_2864":59863,"_25225":59840,"_17592":102145,"_5":17487,"_23859":102081,"_2388":47172},[],{"_2864":59864,"_25225":59840,"_17592":102147,"_5":17487,"_23859":102081,"_2388":102148},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2864":59865,"_25225":59840,"_17592":102150,"_5":17487,"_23859":102081,"_2388":102151},[],"SKI de la CA.",{"_2864":59866,"_25225":59840,"_17592":102153,"_5":17487,"_23859":102081,"_2388":102154},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2864":59867,"_25225":59840,"_17592":102156,"_5":17487,"_23859":102081,"_2388":102157},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2864":59868,"_25225":59840,"_17592":102159,"_5":17487,"_23859":102085,"_2388":102160},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2864":59869,"_25225":59840,"_17592":102162,"_5":17487,"_23859":102085,"_2388":102163},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2864":59870,"_25225":59840,"_17592":102165,"_5":17487,"_23859":102085,"_2388":102166},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2864":59871,"_25225":59840,"_17592":102168,"_5":17487,"_23859":102089,"_2388":102169},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2864":59872,"_25225":59840,"_17592":102171,"_5":17487,"_23859":102089,"_2388":102172},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2864":59873,"_25225":59840,"_17592":102174,"_5":17487,"_23859":102093,"_2388":102175},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2864":59874,"_25225":59840,"_17592":102177,"_5":17487,"_23859":102093,"_2388":102178},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2864":59875,"_25225":59840,"_17592":102180,"_5":17487,"_23859":102093,"_2388":102181},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2864":59876,"_25225":59840,"_17592":102183,"_5":17487,"_23859":102093,"_2388":102184},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2864":59877,"_25225":59840,"_17592":102186,"_5":17487,"_23859":102093,"_2388":102187},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2864":59878,"_25225":59840,"_17592":102189,"_5":17487,"_23859":102097,"_2388":102190},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2864":59879,"_25225":59840,"_17592":102192,"_5":17487,"_23859":102097,"_2388":99053},[],{"_2864":59880,"_25225":59840,"_17592":102194,"_5":17487,"_23859":102097,"_2388":102195},[],"Path relativo",{"_2864":59881,"_25225":59840,"_17592":102197,"_5":17487,"_23859":102097,"_2388":97159},[],{"_2864":59882,"_25225":59840,"_17592":102199,"_5":17487,"_23859":102097,"_2388":47227},[],{"_2864":59883,"_25225":59840,"_17592":102201,"_5":17487,"_23859":102097,"_2388":47230},[],{"_2864":59884,"_25225":59840,"_17592":102203,"_5":17487,"_23859":102097,"_2388":102204},[],"Consultar `crl_options` y `latest_crl`.",{"_2864":59885,"_25225":59840,"_17592":102206,"_5":17487,"_23859":102097,"_2388":47236},[],{"_2864":59886,"_25225":59840,"_17592":102208,"_5":17487,"_23859":102097,"_2388":47230},[],{"_2864":59887,"_25225":59840,"_17592":102210,"_5":17487,"_23859":102097,"_2388":102211},[],"Sustituir la configuración de CRL.",{"_2864":59888,"_25225":59840,"_17592":102213,"_5":17487,"_23859":102097,"_2388":102214},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2864":59889,"_25225":59840,"_17592":102216,"_5":17487,"_23859":102097,"_2388":102217},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2864":59890,"_25225":59840,"_17592":102219,"_5":17487,"_23859":102101,"_2388":102220},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2864":59891,"_25225":59840,"_17592":102222,"_5":17487,"_23859":102105,"_2388":102223},[],"RFC 5280: perfil X.509 y CRL.",{"_2864":59892,"_25225":59840,"_17592":102225,"_5":17487,"_23859":102105,"_2388":47256},[],{"_2864":59893,"_25225":59840,"_17592":102227,"_5":17487,"_23859":102105,"_2388":47259},[],{"_2864":59894,"_25225":59840,"_17592":102229,"_5":17487,"_23859":102105,"_2388":102230},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2864":59895,"_25225":59840,"_17592":102232,"_5":17487,"_23859":102105,"_2388":102233},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2864":59896,"_25225":59896,"_5":12320,"_2388":102235,"_25561":102236,"_17592":102237,"_23859":59896},"Claves y motores criptográficos",[40930,97371,45965,100946],[],{"_2864":59897,"_25225":59896,"_17592":102239,"_5":17487,"_23859":59896,"_2388":102240},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2864":59898,"_25225":59896,"_5":25558,"_17592":102242,"_23859":102243,"_2388":102244},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2864":59899,"_25225":59896,"_5":25558,"_17592":102246,"_23859":102247,"_2388":102248},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2864":59900,"_25225":59896,"_5":25558,"_17592":102250,"_23859":102251,"_2388":47284},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#file-system",{"_2864":59901,"_25225":59896,"_5":25558,"_17592":102253,"_23859":102254,"_2388":47288},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#hashicorp-vault",{"_2864":59902,"_25225":59896,"_5":25558,"_17592":102256,"_23859":102257,"_2388":47292},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#aws-secrets-manager",{"_2864":59903,"_25225":59896,"_5":25558,"_17592":102259,"_23859":102260,"_2388":47296},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#aws-kms",{"_2864":59904,"_25225":59896,"_5":25558,"_17592":102262,"_23859":102263,"_2388":47300},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#pkcs11",{"_2864":59905,"_25225":59896,"_5":25558,"_17592":102265,"_23859":102266,"_2388":47304},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#azure-key-vault",{"_2864":59906,"_25225":59896,"_5":25558,"_17592":102268,"_23859":102269,"_2388":102270},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2864":59907,"_25225":59896,"_5":25558,"_17592":102272,"_23859":102273,"_2388":102274},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2864":59908,"_25225":59896,"_5":25558,"_17592":102276,"_23859":102277,"_2388":102278},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2864":59909,"_25225":59896,"_5":25558,"_17592":102280,"_23859":102281,"_2388":102282},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2864":59910,"_25225":59896,"_5":25558,"_17592":102284,"_23859":102285,"_2388":102286},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2864":59911,"_25225":59896,"_5":25558,"_17592":102288,"_23859":102289,"_2388":102290},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2864":59912,"_25225":59896,"_5":25558,"_17592":102292,"_23859":102293,"_2388":102294},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2864":59913,"_25225":59896,"_5":25558,"_17592":102296,"_23859":102297,"_2388":47336},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#sign",{"_2864":59914,"_25225":59896,"_5":25558,"_17592":102299,"_23859":102300,"_2388":47340},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#verify",{"_2864":59915,"_25225":59896,"_5":25558,"_17592":102302,"_23859":102303,"_2388":102304},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2864":59916,"_25225":59896,"_5":25558,"_17592":102306,"_23859":102307,"_2388":102308},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2864":59917,"_25225":59896,"_5":25558,"_17592":102310,"_23859":102311,"_2388":102312},[],"/docs/pr-preview/pr-41/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2864":59918,"_25225":59896,"_17592":102314,"_5":17487,"_23859":59896,"_2388":102315},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2864":59919,"_25225":59896,"_17592":102317,"_5":17487,"_23859":59896,"_2388":102318},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2864":59920,"_25225":59896,"_17592":102320,"_5":17487,"_23859":102243,"_2388":102321},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2864":59921,"_25225":59896,"_17592":102323,"_5":17487,"_23859":102243,"_2388":102324},[],"En la práctica, permite:",{"_2864":59922,"_25225":59896,"_17592":102326,"_5":17487,"_23859":102243,"_2388":102327},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2864":59923,"_25225":59896,"_17592":102329,"_5":17487,"_23859":102243,"_2388":102330},[],"Importar claves creadas externamente.",{"_2864":59924,"_25225":59896,"_17592":102332,"_5":17487,"_23859":102243,"_2388":102333},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2864":59925,"_25225":59896,"_17592":102335,"_5":17487,"_23859":102243,"_2388":102336},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2864":59926,"_25225":59896,"_17592":102338,"_5":17487,"_23859":102247,"_2388":102339},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2864":59927,"_25225":59896,"_17592":102341,"_5":17487,"_23859":102247,"_2388":102342},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2864":59928,"_25225":59896,"_17592":102344,"_5":17487,"_23859":102247,"_2388":102345},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2864":59929,"_25225":59896,"_17592":102347,"_5":17487,"_23859":102251,"_2388":102348},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2864":59930,"_25225":59896,"_17592":102350,"_5":17487,"_23859":102254,"_2388":102351},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2864":59931,"_25225":59896,"_17592":102353,"_5":17487,"_23859":102254,"_2388":102354},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_2864":59932,"_25225":59896,"_17592":102356,"_5":17487,"_23859":102257,"_2388":102357},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2864":59933,"_25225":59896,"_17592":102359,"_5":17487,"_23859":102260,"_2388":102360},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2864":59934,"_25225":59896,"_17592":102362,"_5":17487,"_23859":102263,"_2388":102363},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2864":59935,"_25225":59896,"_17592":102365,"_5":17487,"_23859":102266,"_2388":102366},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2864":59936,"_25225":59896,"_17592":102368,"_5":17487,"_23859":102266,"_2388":102369},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2864":59937,"_25225":59896,"_17592":102371,"_5":17487,"_23859":102266,"_2388":102372},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2864":59938,"_25225":59896,"_17592":102374,"_5":17487,"_23859":102266,"_2388":102375},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2864":59939,"_25225":59896,"_17592":102377,"_5":17487,"_23859":102269,"_2388":102378},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2864":59940,"_25225":59896,"_17592":102380,"_5":17487,"_23859":102269,"_2388":102381},[],"La tabla incluye los siguientes campos:",{"_2864":59941,"_25225":59896,"_17592":102383,"_5":17487,"_23859":102269,"_2388":102384},[],"**Name**: nombre descriptivo de la clave.",{"_2864":59942,"_25225":59896,"_17592":102386,"_5":17487,"_23859":102269,"_2388":102387},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2864":59943,"_25225":59896,"_17592":102389,"_5":17487,"_23859":102269,"_2388":102390},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2864":59944,"_25225":59896,"_17592":102392,"_5":17487,"_23859":102269,"_2388":102393},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2864":59945,"_25225":59896,"_17592":102395,"_5":17487,"_23859":102269,"_2388":102396},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2864":59946,"_25225":59896,"_17592":102398,"_5":17487,"_23859":102269,"_2388":102399},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2864":59947,"_25225":59896,"_17592":102401,"_5":17487,"_23859":102269,"_2388":102402},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2864":59948,"_25225":59896,"_17592":102404,"_5":17487,"_23859":102269,"_2388":102405},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2864":59949,"_25225":59896,"_17592":102407,"_5":17487,"_23859":102269,"_2388":102408},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2864":59950,"_25225":59896,"_17592":102410,"_5":17487,"_23859":102269,"_2388":102411},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2864":59951,"_25225":59896,"_17592":102413,"_5":17487,"_23859":102269,"_2388":102414},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2864":59952,"_25225":59896,"_17592":102416,"_5":17487,"_23859":102269,"_2388":102417},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2864":59953,"_25225":59896,"_17592":102419,"_5":17487,"_23859":102269,"_2388":102420},[],"**Delete Key** para eliminar la clave del sistema.",{"_2864":59954,"_25225":59896,"_17592":102422,"_5":17487,"_23859":102273,"_2388":102423},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2864":59955,"_25225":59896,"_17592":102425,"_5":17487,"_23859":102277,"_2388":102426},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2864":59956,"_25225":59896,"_17592":102428,"_5":17487,"_23859":102277,"_2388":102429},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2864":59957,"_25225":59896,"_17592":102431,"_5":17487,"_23859":102277,"_2388":102432},[],"**Key Name**: nombre único y descriptivo.",{"_2864":59958,"_25225":59896,"_17592":102434,"_5":17487,"_23859":102277,"_2388":102435},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2864":59959,"_25225":59896,"_17592":102437,"_5":17487,"_23859":102277,"_2388":102438},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2864":59960,"_25225":59896,"_17592":102440,"_5":17487,"_23859":102277,"_2388":102441},[],"**Tags**: metadatos para clasificar la clave.",{"_2864":59961,"_25225":59896,"_17592":102443,"_5":17487,"_23859":102277,"_2388":102444},[],"**Metadata**: información adicional para usos avanzados.",{"_2864":59962,"_25225":59896,"_17592":102446,"_5":17487,"_23859":102281,"_2388":102447},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2864":59963,"_25225":59896,"_17592":102449,"_5":17487,"_23859":102281,"_2388":102450},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2864":59964,"_25225":59896,"_17592":102452,"_5":17487,"_23859":102281,"_2388":102453},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2864":59965,"_25225":59896,"_17592":102455,"_5":17487,"_23859":102281,"_2388":102456},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2864":59966,"_25225":59896,"_17592":102458,"_5":17487,"_23859":102281,"_2388":102459},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2864":59967,"_25225":59896,"_17592":102461,"_5":17487,"_23859":102281,"_2388":102462},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2864":59968,"_25225":59896,"_17592":102464,"_5":17487,"_23859":102281,"_2388":102465},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2864":59969,"_25225":59896,"_17592":102467,"_5":17487,"_23859":102281,"_2388":102468},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2864":59970,"_25225":59896,"_17592":102470,"_5":17487,"_23859":102281,"_2388":102471},[],"**Metadata**: información adicional opcional.",{"_2864":59971,"_25225":59896,"_17592":102473,"_5":17487,"_23859":102281,"_2388":102474},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2864":59972,"_25225":59896,"_17592":102476,"_5":17487,"_23859":102281,"_2388":102477},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2864":59973,"_25225":59896,"_17592":102479,"_5":17487,"_23859":102285,"_2388":102480},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2864":59974,"_25225":59896,"_17592":102482,"_5":17487,"_23859":102289,"_2388":102483},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2864":59975,"_25225":59896,"_17592":102485,"_5":17487,"_23859":102289,"_2388":102486},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2864":59976,"_25225":59896,"_17592":102488,"_5":17487,"_23859":102289,"_2388":102489},[],"**Key Name**: nombre descriptivo.",{"_2864":59977,"_25225":59896,"_17592":102491,"_5":17487,"_23859":102289,"_2388":102492},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2864":59978,"_25225":59896,"_17592":102494,"_5":17487,"_23859":102289,"_2388":102495},[],"**Tags**: etiquetas asociadas.",{"_2864":59979,"_25225":59896,"_17592":102497,"_5":17487,"_23859":102289,"_2388":102498},[],"**Aliases**: nombres alternativos.",{"_2864":59980,"_25225":59896,"_17592":102500,"_5":17487,"_23859":102289,"_2388":102501},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2864":59981,"_25225":59896,"_17592":102503,"_5":17487,"_23859":102289,"_2388":102504},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2864":59982,"_25225":59896,"_17592":102506,"_5":17487,"_23859":102289,"_2388":102507},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2864":59983,"_25225":59896,"_17592":102509,"_5":17487,"_23859":102289,"_2388":102510},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2864":59984,"_25225":59896,"_17592":102512,"_5":17487,"_23859":102293,"_2388":102513},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2864":59985,"_25225":59896,"_17592":102515,"_5":17487,"_23859":102293,"_2388":102516},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2864":59986,"_25225":59896,"_17592":102518,"_5":17487,"_23859":102293,"_2388":102519},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2864":59987,"_25225":59896,"_17592":102521,"_5":17487,"_23859":102297,"_2388":102522},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2864":59988,"_25225":59896,"_17592":102524,"_5":17487,"_23859":102297,"_2388":102525},[],"Campos principales:",{"_2864":59989,"_25225":59896,"_17592":102527,"_5":17487,"_23859":102297,"_2388":102528},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2864":59990,"_25225":59896,"_17592":102530,"_5":17487,"_23859":102297,"_2388":102531},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2864":59991,"_25225":59896,"_17592":102533,"_5":17487,"_23859":102297,"_2388":102534},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2864":59992,"_25225":59896,"_17592":102536,"_5":17487,"_23859":102297,"_2388":102537},[],"**Message**: contenido que se va a firmar.",{"_2864":59993,"_25225":59896,"_17592":102539,"_5":17487,"_23859":102297,"_2388":102540},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2864":59994,"_25225":59896,"_17592":102542,"_5":17487,"_23859":102300,"_2388":102543},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2864":59995,"_25225":59896,"_17592":102545,"_5":17487,"_23859":102300,"_2388":102525},[],{"_2864":59996,"_25225":59896,"_17592":102547,"_5":17487,"_23859":102300,"_2388":102548},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2864":59997,"_25225":59896,"_17592":102550,"_5":17487,"_23859":102300,"_2388":102551},[],"**Message Type**: `Raw` o `Digest`.",{"_2864":59998,"_25225":59896,"_17592":102553,"_5":17487,"_23859":102300,"_2388":102554},[],"**Payload Encoding**: codificación del mensaje.",{"_2864":59999,"_25225":59896,"_17592":102556,"_5":17487,"_23859":102300,"_2388":102557},[],"**Message**: mensaje original o hash.",{"_2864":60000,"_25225":59896,"_17592":102559,"_5":17487,"_23859":102300,"_2388":102560},[],"**Signature**: firma que se desea comprobar.",{"_2864":60001,"_25225":59896,"_17592":102562,"_5":17487,"_23859":102300,"_2388":102563},[],"**Result**: indicador del resultado de la validación.",{"_2864":60002,"_25225":59896,"_17592":102565,"_5":17487,"_23859":102303,"_2388":102566},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2864":60003,"_25225":59896,"_17592":102568,"_5":17487,"_23859":102303,"_2388":102569},[],"Este flujo es útil para:",{"_2864":60004,"_25225":59896,"_17592":102571,"_5":17487,"_23859":102303,"_2388":102572},[],"Solicitar certificados a una CA externa.",{"_2864":60005,"_25225":59896,"_17592":102574,"_5":17487,"_23859":102303,"_2388":102575},[],"Renovar una identidad manteniendo la misma clave.",{"_2864":60006,"_25225":59896,"_17592":102577,"_5":17487,"_23859":102303,"_2388":102578},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2864":60007,"_25225":59896,"_17592":102580,"_5":17487,"_23859":102303,"_2388":102581},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2864":60008,"_25225":59896,"_17592":102583,"_5":17487,"_23859":102303,"_2388":102584},[],"**Organization (O)**: organización o empresa.",{"_2864":60009,"_25225":59896,"_17592":102586,"_5":17487,"_23859":102303,"_2388":102587},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2864":60010,"_25225":59896,"_17592":102589,"_5":17487,"_23859":102303,"_2388":102590},[],"**Country (C)**: código de país de dos letras.",{"_2864":60011,"_25225":59896,"_17592":102592,"_5":17487,"_23859":102303,"_2388":102593},[],"**State / Province (ST)**: estado o provincia.",{"_2864":60012,"_25225":59896,"_17592":102595,"_5":17487,"_23859":102303,"_2388":102596},[],"**Locality (L)**: ciudad o localidad.",{"_2864":60013,"_25225":59896,"_17592":102598,"_5":17487,"_23859":102303,"_2388":102599},[],"**Email Address**: correo de contacto.",{"_2864":60014,"_25225":59896,"_17592":102601,"_5":17487,"_23859":102303,"_2388":102602},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2864":60015,"_25225":59896,"_17592":102604,"_5":17487,"_23859":102303,"_2388":102605},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2864":60016,"_25225":59896,"_17592":102607,"_5":17487,"_23859":102307,"_2388":102608},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2864":60017,"_25225":59896,"_17592":102610,"_5":17487,"_23859":102307,"_2388":47651},[],{"_2864":60018,"_25225":59896,"_17592":102612,"_5":17487,"_23859":102311,"_2388":102613},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2864":60019,"_25225":60019,"_5":12320,"_2388":102615,"_25561":102616,"_17592":102617,"_23859":60019},"Validación online con OCSP",[40930,97371,45965,101561],[],{"_2864":60020,"_25225":60019,"_17592":102619,"_5":17487,"_23859":60019,"_2388":102620},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2864":60021,"_25225":60019,"_5":25558,"_17592":102622,"_23859":102623,"_2388":102624},[],"/docs/pr-preview/pr-41/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2864":60022,"_25225":60019,"_5":25558,"_17592":102626,"_23859":102627,"_2388":102628},[],"/docs/pr-preview/pr-41/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2864":60023,"_25225":60019,"_5":25558,"_17592":102630,"_23859":102631,"_2388":102632},[],"/docs/pr-preview/pr-41/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2864":60024,"_25225":60019,"_5":25558,"_17592":102634,"_23859":102635,"_2388":102636},[],"/docs/pr-preview/pr-41/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2864":60025,"_25225":60019,"_5":25558,"_17592":102638,"_23859":102639,"_2388":102640},[],"/docs/pr-preview/pr-41/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2864":60026,"_25225":60019,"_5":25558,"_17592":102642,"_23859":102643,"_2388":102106},[],"/docs/pr-preview/pr-41/es/platform/pki/ocsp#referencias",{"_2864":60027,"_25225":60019,"_17592":102645,"_5":17487,"_23859":60019,"_2388":102646},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2864":60028,"_25225":60019,"_17592":102648,"_5":17487,"_23859":102623,"_2388":102649},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2864":60029,"_25225":60019,"_17592":102651,"_5":17487,"_23859":102623,"_2388":102652},[],"Estado del registro",{"_2864":60030,"_25225":60019,"_17592":102654,"_5":17487,"_23859":102623,"_2388":102655},[],"Respuesta firmada",{"_2864":60031,"_25225":60019,"_17592":102657,"_5":17487,"_23859":102623,"_2388":45143},[],{"_2864":60032,"_25225":60019,"_17592":102659,"_5":17487,"_23859":102623,"_2388":47701},[],{"_2864":60033,"_25225":60019,"_17592":102661,"_5":17487,"_23859":102623,"_2388":45160},[],{"_2864":60034,"_25225":60019,"_17592":102663,"_5":17487,"_23859":102623,"_2388":102664},[],"`Revoked`, con razón y fecha de revocación.",{"_2864":60035,"_25225":60019,"_17592":102666,"_5":17487,"_23859":102623,"_2388":102667},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2864":60036,"_25225":60019,"_17592":102669,"_5":17487,"_23859":102623,"_2388":102670},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2864":60037,"_25225":60019,"_17592":102672,"_5":17487,"_23859":102623,"_2388":102673},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2864":60038,"_25225":60019,"_17592":102675,"_5":17487,"_23859":102623,"_2388":102676},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2864":60039,"_25225":60019,"_17592":102678,"_5":17487,"_23859":102623,"_2388":102679},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2864":60040,"_25225":60019,"_17592":102681,"_5":17487,"_23859":102627,"_2388":102682},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2864":60041,"_25225":60019,"_17592":102684,"_5":17487,"_23859":102627,"_2388":102685},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2864":60042,"_25225":60019,"_17592":102687,"_5":17487,"_23859":102631,"_2388":102688},[],"El servicio acepta:",{"_2864":60043,"_25225":60019,"_17592":102690,"_5":17487,"_23859":102631,"_2388":99053},[],{"_2864":60044,"_25225":60019,"_17592":102692,"_5":17487,"_23859":102631,"_2388":102693},[],"Ruta del servicio VA",{"_2864":60045,"_25225":60019,"_17592":102695,"_5":17487,"_23859":102631,"_2388":102696},[],"Formato",{"_2864":60046,"_25225":60019,"_17592":102698,"_5":17487,"_23859":102631,"_2388":47741},[],{"_2864":60047,"_25225":60019,"_17592":102700,"_5":17487,"_23859":102631,"_2388":47744},[],{"_2864":60048,"_25225":60019,"_17592":102702,"_5":17487,"_23859":102631,"_2388":102703},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2864":60049,"_25225":60019,"_17592":102705,"_5":17487,"_23859":102631,"_2388":47227},[],{"_2864":60050,"_25225":60019,"_17592":102707,"_5":17487,"_23859":102631,"_2388":47752},[],{"_2864":60051,"_25225":60019,"_17592":102709,"_5":17487,"_23859":102631,"_2388":102710},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2864":60052,"_25225":60019,"_17592":102712,"_5":17487,"_23859":102631,"_2388":102713},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2864":60053,"_25225":60019,"_17592":102715,"_5":17487,"_23859":102635,"_2388":102716},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2864":60054,"_25225":60019,"_17592":102718,"_5":17487,"_23859":102635,"_2388":102719},[],"Genera la solicitud:",{"_2864":60055,"_25225":60019,"_17592":102721,"_5":17487,"_23859":102635,"_2388":102722},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2864":60056,"_25225":60019,"_17592":102724,"_5":17487,"_23859":102635,"_2388":102725},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2864":60057,"_25225":60019,"_17592":102727,"_5":17487,"_23859":102635,"_2388":102728},[],"Verifica el DER recibido:",{"_2864":60058,"_25225":60019,"_17592":102730,"_5":17487,"_23859":102635,"_2388":102731},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2864":60059,"_25225":60019,"_17592":102733,"_5":17487,"_23859":102639,"_2388":102734},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2864":60060,"_25225":60019,"_17592":102736,"_5":17487,"_23859":102639,"_2388":102737},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2864":60061,"_25225":60019,"_17592":102739,"_5":17487,"_23859":102643,"_2388":47785},[],{"_2864":60062,"_25225":60019,"_17592":102741,"_5":17487,"_23859":102643,"_2388":47788},[],{"_2864":60063,"_25225":60019,"_17592":102743,"_5":17487,"_23859":102643,"_2388":102744},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2864":60064,"_25225":60019,"_17592":102746,"_5":17487,"_23859":102643,"_2388":102233},[],{"_2864":60065,"_25225":60065,"_5":12320,"_2388":45965,"_25561":102748,"_17592":102749,"_23859":60065},[40930,97371,45965],[],{"_2864":60066,"_25225":60065,"_17592":102751,"_5":17487,"_23859":60065,"_2388":102752},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2864":60067,"_25225":60065,"_5":25558,"_17592":102754,"_23859":102755,"_2388":100270},[],"/docs/pr-preview/pr-41/es/platform/pki/overview#empieza-aquí",{"_2864":60068,"_25225":60065,"_5":25558,"_17592":102757,"_23859":102758,"_2388":102759},[],"/docs/pr-preview/pr-41/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2864":60069,"_25225":60065,"_5":25558,"_17592":102761,"_23859":102762,"_2388":100792},[],"/docs/pr-preview/pr-41/es/platform/pki/overview#capacidades-principales",{"_2864":60070,"_25225":60065,"_5":25558,"_17592":102764,"_23859":102765,"_2388":100796},[],"/docs/pr-preview/pr-41/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2864":60071,"_25225":60065,"_5":25558,"_17592":102767,"_23859":102768,"_2388":100800},[],"/docs/pr-preview/pr-41/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2864":60072,"_25225":60065,"_5":25558,"_17592":102770,"_23859":102771,"_2388":100804},[],"/docs/pr-preview/pr-41/es/platform/pki/overview#emite-y-controla-certificados",{"_2864":60073,"_25225":60065,"_5":25558,"_17592":102773,"_23859":102774,"_2388":100812},[],"/docs/pr-preview/pr-41/es/platform/pki/overview#publica-el-estado-de-validación",{"_2864":60074,"_25225":60065,"_5":25558,"_17592":102776,"_23859":102777,"_2388":102778},[],"/docs/pr-preview/pr-41/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2864":60075,"_25225":60065,"_5":25558,"_17592":102780,"_23859":102781,"_2388":101727},[],"/docs/pr-preview/pr-41/es/platform/pki/overview#continúa",{"_2864":60076,"_25225":60065,"_17592":102783,"_5":17487,"_23859":60065,"_2388":102784},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2864":60077,"_25225":60065,"_17592":102786,"_5":17487,"_23859":102755,"_2388":102787},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2864":60078,"_25225":60065,"_17592":102789,"_5":17487,"_23859":102755,"_2388":102790},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2864":60079,"_25225":60065,"_17592":102792,"_5":17487,"_23859":102758,"_2388":102793},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2864":60080,"_25225":60065,"_17592":102795,"_5":17487,"_23859":102758,"_2388":102796},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2864":60081,"_25225":60065,"_17592":102798,"_5":17487,"_23859":102758,"_2388":102799},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2864":60082,"_25225":60065,"_17592":102801,"_5":17487,"_23859":102758,"_2388":102802},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2864":60083,"_25225":60065,"_17592":102804,"_5":17487,"_23859":102758,"_2388":102805},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2864":60084,"_25225":60065,"_17592":102807,"_5":17487,"_23859":102765,"_2388":102808},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2864":60085,"_25225":60065,"_17592":102810,"_5":17487,"_23859":102768,"_2388":102811},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2864":60086,"_25225":60065,"_17592":102813,"_5":17487,"_23859":102771,"_2388":102814},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2864":60087,"_25225":60065,"_17592":102816,"_5":17487,"_23859":102774,"_2388":102817},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2864":60088,"_25225":60065,"_17592":102819,"_5":17487,"_23859":102777,"_2388":102820},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2864":60089,"_25225":60065,"_17592":102822,"_5":17487,"_23859":102777,"_2388":102823},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2864":60090,"_25225":60065,"_17592":102825,"_5":17487,"_23859":102777,"_2388":102826},[],"su clave pública corresponda a la clave privada del cliente;",{"_2864":60091,"_25225":60065,"_17592":102828,"_5":17487,"_23859":102777,"_2388":102829},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2864":60092,"_25225":60065,"_17592":102831,"_5":17487,"_23859":102777,"_2388":102832},[],"sus fechas y usos permitan la operación;",{"_2864":60093,"_25225":60065,"_17592":102834,"_5":17487,"_23859":102777,"_2388":102835},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2864":60094,"_25225":60065,"_17592":102837,"_5":17487,"_23859":102777,"_2388":102838},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2864":60095,"_25225":60065,"_17592":102840,"_5":17487,"_23859":102781,"_2388":102841},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2864":60096,"_25225":60065,"_17592":102843,"_5":17487,"_23859":102781,"_2388":102844},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2864":60097,"_25225":60065,"_17592":102846,"_5":17487,"_23859":102781,"_2388":102847},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2864":60098,"_25225":60098,"_5":12320,"_2388":102849,"_25561":102850,"_17592":102851,"_23859":60098},"Crea tu primera CA",[40930,97371,45965,100394],[],{"_2864":60099,"_25225":60098,"_17592":102853,"_5":17487,"_23859":60098,"_2388":102854},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2864":60100,"_25225":60098,"_5":25558,"_17592":102856,"_23859":102857,"_2388":96059},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2864":60101,"_25225":60098,"_5":25558,"_17592":102859,"_23859":102860,"_2388":102861},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2864":60102,"_25225":60098,"_5":25558,"_17592":102863,"_23859":102864,"_2388":102865},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2864":60103,"_25225":60098,"_5":25558,"_17592":102867,"_23859":102868,"_2388":102869},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2864":60104,"_25225":60098,"_5":25558,"_17592":102871,"_23859":102872,"_2388":102873},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2864":60105,"_25225":60098,"_5":25558,"_17592":102875,"_23859":102876,"_2388":102877},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2864":60106,"_25225":60098,"_5":25558,"_17592":102879,"_23859":102880,"_2388":102881},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2864":60107,"_25225":60098,"_5":25558,"_17592":102883,"_23859":102884,"_2388":100642},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2864":60108,"_25225":60098,"_5":25558,"_17592":102886,"_23859":102887,"_2388":96083},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2864":60109,"_25225":60098,"_17592":102889,"_5":17487,"_23859":60098,"_2388":102890},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2864":60110,"_25225":60098,"_17592":102892,"_5":17487,"_23859":102857,"_2388":102893},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2864":60111,"_25225":60098,"_17592":102895,"_5":17487,"_23859":102857,"_2388":102896},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2864":60112,"_25225":60098,"_17592":102898,"_5":17487,"_23859":102857,"_2388":102899},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2864":60113,"_25225":60098,"_17592":102901,"_5":17487,"_23859":102857,"_2388":102902},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2864":60114,"_25225":60098,"_17592":102904,"_5":17487,"_23859":102860,"_2388":102905},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2864":60115,"_25225":60098,"_17592":102907,"_5":17487,"_23859":102860,"_2388":102908},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2864":60116,"_25225":60098,"_17592":102910,"_5":17487,"_23859":102864,"_2388":102911},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2864":60117,"_25225":60098,"_17592":102913,"_5":17487,"_23859":102864,"_2388":102914},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2864":60118,"_25225":60098,"_17592":102916,"_5":17487,"_23859":102868,"_2388":102917},[],"Selecciona **Root CA** y completa:",{"_2864":60119,"_25225":60098,"_17592":102919,"_5":17487,"_23859":102868,"_2388":47967},[],{"_2864":60120,"_25225":60098,"_17592":102921,"_5":17487,"_23859":102868,"_2388":102922},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2864":60121,"_25225":60098,"_17592":102924,"_5":17487,"_23859":102868,"_2388":102925},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2864":60122,"_25225":60098,"_17592":102927,"_5":17487,"_23859":102868,"_2388":102928},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2864":60123,"_25225":60098,"_17592":102930,"_5":17487,"_23859":102868,"_2388":102931},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2864":60124,"_25225":60098,"_17592":102933,"_5":17487,"_23859":102872,"_2388":102934},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2864":60125,"_25225":60098,"_17592":102936,"_5":17487,"_23859":102876,"_2388":102937},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2864":60126,"_25225":60098,"_17592":102939,"_5":17487,"_23859":102876,"_2388":102940},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2864":60127,"_25225":60098,"_17592":102942,"_5":17487,"_23859":102880,"_2388":102943},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2864":60128,"_25225":60098,"_17592":102945,"_5":17487,"_23859":102880,"_2388":102946},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2864":60129,"_25225":60098,"_17592":102948,"_5":17487,"_23859":102880,"_2388":102949},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2864":60130,"_25225":60098,"_17592":102951,"_5":17487,"_23859":102884,"_2388":102952},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2864":60131,"_25225":60098,"_17592":102954,"_5":17487,"_23859":102884,"_2388":102955},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2864":60132,"_25225":60098,"_17592":102957,"_5":17487,"_23859":102884,"_2388":102958},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2864":60133,"_25225":60098,"_17592":102960,"_5":17487,"_23859":102884,"_2388":102961},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2864":60134,"_25225":60098,"_17592":102963,"_5":17487,"_23859":102887,"_2388":102964},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2864":60135,"_25225":60135,"_5":12320,"_2388":102966,"_25561":102967,"_17592":102968,"_23859":60135},"Emite y verifica un certificado",[40930,97371,45965,100394],[],{"_2864":60136,"_25225":60135,"_17592":102970,"_5":17487,"_23859":60135,"_2388":102971},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2864":60137,"_25225":60135,"_5":25558,"_17592":102973,"_23859":102974,"_2388":96059},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2864":60138,"_25225":60135,"_5":25558,"_17592":102976,"_23859":102977,"_2388":102978},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2864":60139,"_25225":60135,"_5":25558,"_17592":102980,"_23859":102981,"_2388":102982},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2864":60140,"_25225":60135,"_5":25558,"_17592":102984,"_23859":102985,"_2388":102986},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2864":60141,"_25225":60135,"_5":25558,"_17592":102988,"_23859":102989,"_2388":102990},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2864":60142,"_25225":60135,"_5":25558,"_17592":102992,"_23859":102993,"_2388":102994},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2864":60143,"_25225":60135,"_5":25558,"_17592":102996,"_23859":102997,"_2388":102877},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2864":60144,"_25225":60135,"_5":25558,"_17592":102999,"_23859":103000,"_2388":103001},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2864":60145,"_25225":60135,"_5":25558,"_17592":103003,"_23859":103004,"_2388":103005},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2864":60146,"_25225":60135,"_5":25558,"_17592":103007,"_23859":103008,"_2388":103009},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2864":60147,"_25225":60135,"_5":25558,"_17592":103011,"_23859":103012,"_2388":100642},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2864":60148,"_25225":60135,"_5":25558,"_17592":103014,"_23859":103015,"_2388":96083},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2864":60149,"_25225":60135,"_17592":103017,"_5":17487,"_23859":60135,"_2388":103018},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2864":60150,"_25225":60135,"_17592":103020,"_5":17487,"_23859":102974,"_2388":103021},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2864":60151,"_25225":60135,"_17592":103023,"_5":17487,"_23859":102974,"_2388":103024},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2864":60152,"_25225":60135,"_17592":103026,"_5":17487,"_23859":102974,"_2388":103027},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2864":60153,"_25225":60135,"_17592":103029,"_5":17487,"_23859":102974,"_2388":103030},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2864":60154,"_25225":60135,"_17592":103032,"_5":17487,"_23859":102974,"_2388":103033},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2864":60155,"_25225":60135,"_17592":103035,"_5":17487,"_23859":102977,"_2388":103036},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2864":60156,"_25225":60135,"_17592":103038,"_5":17487,"_23859":102981,"_2388":103039},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2864":60157,"_25225":60135,"_17592":103041,"_5":17487,"_23859":102981,"_2388":103042},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2864":60158,"_25225":60135,"_17592":103044,"_5":17487,"_23859":102985,"_2388":103045},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2864":60159,"_25225":60135,"_17592":103047,"_5":17487,"_23859":102985,"_2388":103048},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2864":60160,"_25225":60135,"_17592":103050,"_5":17487,"_23859":102989,"_2388":103051},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2864":60161,"_25225":60135,"_17592":103053,"_5":17487,"_23859":102989,"_2388":103054},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2864":60162,"_25225":60135,"_17592":103056,"_5":17487,"_23859":102993,"_2388":103057},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2864":60163,"_25225":60135,"_17592":103059,"_5":17487,"_23859":102997,"_2388":103060},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2864":60164,"_25225":60135,"_17592":103062,"_5":17487,"_23859":103000,"_2388":103063},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2864":60165,"_25225":60135,"_17592":103065,"_5":17487,"_23859":103004,"_2388":103066},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2864":60166,"_25225":60135,"_17592":103068,"_5":17487,"_23859":103004,"_2388":103069},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2864":60167,"_25225":60135,"_17592":103071,"_5":17487,"_23859":103004,"_2388":103072},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2864":60168,"_25225":60135,"_17592":103074,"_5":17487,"_23859":103008,"_2388":103075},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2864":60169,"_25225":60135,"_17592":103077,"_5":17487,"_23859":103008,"_2388":103078},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2864":60170,"_25225":60135,"_17592":103080,"_5":17487,"_23859":103008,"_2388":103081},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2864":60171,"_25225":60135,"_17592":103083,"_5":17487,"_23859":103012,"_2388":100725},[],{"_2864":60172,"_25225":60135,"_17592":103085,"_5":17487,"_23859":103012,"_2388":99502},[],{"_2864":60173,"_25225":60135,"_17592":103087,"_5":17487,"_23859":103012,"_2388":103088},[],"La CA rechaza la emisión",{"_2864":60174,"_25225":60135,"_17592":103090,"_5":17487,"_23859":103012,"_2388":103091},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2864":60175,"_25225":60135,"_17592":103093,"_5":17487,"_23859":103012,"_2388":103094},[],"Sujeto o usos diferentes",{"_2864":60176,"_25225":60135,"_17592":103096,"_5":17487,"_23859":103012,"_2388":103097},[],"Perfil aplicado y valores solicitados.",{"_2864":60177,"_25225":60135,"_17592":103099,"_5":17487,"_23859":103012,"_2388":103100},[],"No se encuentra el emisor",{"_2864":60178,"_25225":60135,"_17592":103102,"_5":17487,"_23859":103012,"_2388":103103},[],"CA descargada y cadena intermedia necesaria.",{"_2864":60179,"_25225":60135,"_17592":103105,"_5":17487,"_23859":103012,"_2388":103106},[],"Falla la vigencia",{"_2864":60180,"_25225":60135,"_17592":103108,"_5":17487,"_23859":103012,"_2388":103109},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2864":60181,"_25225":60135,"_17592":103111,"_5":17487,"_23859":103012,"_2388":103112},[],"Los resúmenes de clave difieren",{"_2864":60182,"_25225":60135,"_17592":103114,"_5":17487,"_23859":103012,"_2388":103115},[],"Archivos de certificado y clave de la misma emisión.",{"_2864":60183,"_25225":60135,"_17592":103117,"_5":17487,"_23859":103012,"_2388":103118},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2864":60184,"_25225":60135,"_17592":103120,"_5":17487,"_23859":103015,"_2388":103121},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2864":60185,"_25225":60135,"_17592":103123,"_5":17487,"_23859":103015,"_2388":103124},[],"Gestionar certificados para inspección, estado y revocación.",{"_2864":60186,"_25225":60135,"_17592":103126,"_5":17487,"_23859":103015,"_2388":103127},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2864":60187,"_25225":60135,"_17592":103129,"_5":17487,"_23859":103015,"_2388":103130},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2864":60188,"_25225":60135,"_17592":103132,"_5":17487,"_23859":103015,"_2388":103133},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2864":60189,"_25225":60189,"_5":12320,"_2388":103135,"_25561":103136,"_17592":103137,"_23859":60189},"Primeros pasos de PKI",[40930,97371,45965,100394],[],{"_2864":60190,"_25225":60189,"_17592":103139,"_5":17487,"_23859":60189,"_2388":103140},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2864":60191,"_25225":60189,"_5":25558,"_17592":103142,"_23859":103143,"_2388":96059},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2864":60192,"_25225":60189,"_5":25558,"_17592":103145,"_23859":103146,"_2388":103147},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2864":60193,"_25225":60189,"_5":25558,"_17592":103149,"_23859":103150,"_2388":100576},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2864":60194,"_25225":60189,"_5":25558,"_17592":103152,"_23859":103153,"_2388":103154},[],"/docs/pr-preview/pr-41/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2864":60195,"_25225":60189,"_17592":103156,"_5":17487,"_23859":60189,"_2388":103157},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2864":60196,"_25225":60189,"_17592":103159,"_5":17487,"_23859":103143,"_2388":103160},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2864":60197,"_25225":60189,"_17592":103162,"_5":17487,"_23859":103143,"_2388":103163},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2864":60198,"_25225":60189,"_17592":103165,"_5":17487,"_23859":103143,"_2388":103166},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2864":60199,"_25225":60189,"_17592":103168,"_5":17487,"_23859":103143,"_2388":103169},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2864":60200,"_25225":60189,"_17592":103171,"_5":17487,"_23859":103143,"_2388":103172},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2864":60201,"_25225":60189,"_17592":103174,"_5":17487,"_23859":103146,"_2388":103175},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2864":60202,"_25225":60189,"_17592":103177,"_5":17487,"_23859":103146,"_2388":103178},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2864":60203,"_25225":60189,"_17592":103180,"_5":17487,"_23859":103146,"_2388":103181},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2864":60204,"_25225":60189,"_17592":103183,"_5":17487,"_23859":103146,"_2388":103184},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2864":60205,"_25225":60189,"_17592":103186,"_5":17487,"_23859":103150,"_2388":103187},[],"Archivo o recurso",{"_2864":60206,"_25225":60189,"_17592":103189,"_5":17487,"_23859":103150,"_2388":100573},[],{"_2864":60207,"_25225":60189,"_17592":103191,"_5":17487,"_23859":103150,"_2388":103192},[],"CA raíz activa y `ca.pem`",{"_2864":60208,"_25225":60189,"_17592":103194,"_5":17487,"_23859":103150,"_2388":103195},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2864":60209,"_25225":60189,"_17592":103197,"_5":17487,"_23859":103150,"_2388":103198},[],"Certificado final y `device.crt`",{"_2864":60210,"_25225":60189,"_17592":103200,"_5":17487,"_23859":103150,"_2388":103201},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2864":60211,"_25225":60189,"_17592":103203,"_5":17487,"_23859":103150,"_2388":103204},[],"Clave privada `device.key`",{"_2864":60212,"_25225":60189,"_17592":103206,"_5":17487,"_23859":103150,"_2388":103207},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2864":60213,"_25225":60189,"_17592":103209,"_5":17487,"_23859":103150,"_2388":103210},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2864":60214,"_25225":60189,"_17592":103212,"_5":17487,"_23859":103153,"_2388":103213},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2864":60215,"_25225":60189,"_17592":103215,"_5":17487,"_23859":103153,"_2388":103216},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2864":60216,"_25225":60189,"_17592":103218,"_5":17487,"_23859":103153,"_2388":103219},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2864":60217,"_25225":60217,"_5":12320,"_2388":103221,"_25561":103222,"_17592":103224,"_23859":60217},"Resolución de problemas PKI",[40930,97371,45965,103223],"Resolución de problemas",[],{"_2864":60218,"_25225":60217,"_17592":103226,"_5":17487,"_23859":60217,"_2388":103227},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2864":60219,"_25225":60217,"_5":25558,"_17592":103229,"_23859":103230,"_2388":103231},[],"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2864":60220,"_25225":60217,"_5":25558,"_17592":103233,"_23859":103234,"_2388":103235},[],"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2864":60221,"_25225":60217,"_5":25558,"_17592":103237,"_23859":103238,"_2388":103239},[],"/docs/pr-preview/pr-41/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2864":60222,"_25225":60217,"_17592":103241,"_5":17487,"_23859":60217,"_2388":103242},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2864":60223,"_25225":60217,"_17592":103244,"_5":17487,"_23859":60217,"_2388":103245},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2864":60224,"_25225":60217,"_17592":103247,"_5":17487,"_23859":103230,"_2388":100573},[],{"_2864":60225,"_25225":60217,"_17592":103249,"_5":17487,"_23859":103230,"_2388":99502},[],{"_2864":60226,"_25225":60217,"_17592":103251,"_5":17487,"_23859":103230,"_2388":96083},[],{"_2864":60227,"_25225":60217,"_17592":103253,"_5":17487,"_23859":103230,"_2388":48303},[],{"_2864":60228,"_25225":60217,"_17592":103255,"_5":17487,"_23859":103230,"_2388":103256},[],"Existe, está activa y sus fechas son utilizables.",{"_2864":60229,"_25225":60217,"_17592":103258,"_5":17487,"_23859":103230,"_2388":103259},[],"Autoridades.",{"_2864":60230,"_25225":60217,"_17592":103261,"_5":17487,"_23859":103230,"_2388":103262},[],"Clave",{"_2864":60231,"_25225":60217,"_17592":103264,"_5":17487,"_23859":103230,"_2388":103265},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2864":60232,"_25225":60217,"_17592":103267,"_5":17487,"_23859":103230,"_2388":103268},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2864":60233,"_25225":60217,"_17592":103270,"_5":17487,"_23859":103230,"_2388":48321},[],{"_2864":60234,"_25225":60217,"_17592":103272,"_5":17487,"_23859":103230,"_2388":103273},[],"PEM correcto y firma verificable.",{"_2864":60235,"_25225":60217,"_17592":103275,"_5":17487,"_23859":103230,"_2388":48327},[],{"_2864":60236,"_25225":60217,"_17592":103277,"_5":17487,"_23859":103230,"_2388":103278},[],"Perfil",{"_2864":60237,"_25225":60217,"_17592":103280,"_5":17487,"_23859":103230,"_2388":103281},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2864":60238,"_25225":60217,"_17592":103283,"_5":17487,"_23859":103230,"_2388":103284},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2864":60239,"_25225":60217,"_17592":103286,"_5":17487,"_23859":103230,"_2388":100725},[],{"_2864":60240,"_25225":60217,"_17592":103288,"_5":17487,"_23859":103230,"_2388":103289},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2864":60241,"_25225":60217,"_17592":103291,"_5":17487,"_23859":103230,"_2388":103292},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2864":60242,"_25225":60217,"_17592":103294,"_5":17487,"_23859":103230,"_2388":103295},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2864":60243,"_25225":60217,"_17592":103297,"_5":17487,"_23859":103230,"_2388":103298},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2864":60244,"_25225":60217,"_17592":103300,"_5":17487,"_23859":103234,"_2388":103301},[],"Revisa cada frontera por separado:",{"_2864":60245,"_25225":60217,"_17592":103303,"_5":17487,"_23859":103234,"_2388":103304},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2864":60246,"_25225":60217,"_17592":103306,"_5":17487,"_23859":103234,"_2388":103307},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2864":60247,"_25225":60217,"_17592":103309,"_5":17487,"_23859":103234,"_2388":103310},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2864":60248,"_25225":60217,"_17592":103312,"_5":17487,"_23859":103234,"_2388":103313},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2864":60249,"_25225":60217,"_17592":103315,"_5":17487,"_23859":103234,"_2388":103316},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2864":60250,"_25225":60217,"_17592":103318,"_5":17487,"_23859":103234,"_2388":103319},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2864":60251,"_25225":60217,"_17592":103321,"_5":17487,"_23859":103238,"_2388":103322},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2864":60252,"_25225":60217,"_17592":103324,"_5":17487,"_23859":103238,"_2388":103325},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48381":103327,"_48383":103328,"_48385":103329,"_48387":103330,"_15282":2410,"_57878":2410},"spanish",[2388,25225,5,23859],{"_2388":21001,"_25225":21001,"_5":21001,"_23859":21001},{"_2388":103331,"_25225":105702,"_5":108073,"_23859":110444},{"_3835":103332,"_48391":103333,"_5":21001},{"_12065":3903,"_12408":4218,"_12415":11786,"_24432":3945,"_23972":6223,"_16705":5712,"_12086":19188,"_12093":2834,"_24394":4951,"_24744":10439,"_24765":3108,"_24407":6187,"_29029":9233,"_24776":6926,"_29034":5167,"_29037":2549,"_29040":6058,"_29043":6181,"_29046":6241,"_25077":3814,"_29051":9760,"_29053":3799,"_25125":6266,"_25067":10149,"_29057":13155,"_25093":5321,"_29061":4795,"_24794":2468,"_25072":4943,"_25138":2778,"_29066":3274,"_29068":6276,"_29070":6311,"_29072":9232,"_29074":2701,"_29076":4777,"_29078":9811,"_29080":17987,"_29082":9523,"_24445":3840,"_25283":6272,"_29086":18103,"_24439":2585,"_29089":3889,"_29091":4879,"_29093":14516,"_29096":5104,"_24475":3723,"_29100":9236,"_24385":299