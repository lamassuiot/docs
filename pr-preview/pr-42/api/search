/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#qué-contiene-un-evento","content":"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados."},"685":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-20","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#cobertura","content":"El backend aplica auditoría a mutaciones de:"},"686":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-21","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#cobertura","content":"autoridades, certificados y perfiles de emisión;"},"687":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-22","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#cobertura","content":"claves y motores KMS;"},"688":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-23","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#cobertura","content":"dispositivos e identidades;"},"689":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-24","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#cobertura","content":"DMS y operaciones de enrolamiento;"},"690":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-25","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#cobertura","content":"funciones de validación y CRL;"},"691":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-26","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#cobertura","content":"principales, políticas y concesiones de autorización."},"692":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-27","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#cobertura","content":"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación."},"693":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-28","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","content":"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo."},"694":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-29","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","content":"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización."},"695":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-30","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","content":"Diseña el consumidor para:"},"696":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-31","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","content":"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;"},"697":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-32","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","content":"conservar el CloudEvent completo sin modificar;"},"698":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-33","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","content":"registrar el momento de ingestión y detectar duplicados por ID;"},"699":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-34","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","content":"cifrar en tránsito y en reposo;"},"700":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-35","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","content":"limitar lectura y borrado a un rol separado del operador de PKI;"},"701":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-36","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","content":"aplicar una política explícita de retención y legal hold;"},"702":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-37","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","content":"alertar si deja de consumir o aumenta la cola pendiente."},"703":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-38","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#datos-sensibles","content":"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa."},"704":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-39","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#datos-sensibles","content":"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución."},"705":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-40","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#acota-el-intervalo","content":"Parte de la hora reportada y normaliza todas las fuentes a UTC."},"706":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-41","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#identifica-la-operación","content":"Filtra por tipo de evento, fuente de servicio e identificador del recurso."},"707":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-42","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#atribuye-el-principal","content":"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento."},"708":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-43","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#compara-intención-y-resultado","content":"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado."},"709":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-44","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#sigue-el-efecto","content":"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada."},"710":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-45","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#verificación-periódica","content":"Genera una mutación controlada en un entorno de prueba y comprueba que:"},"711":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-46","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#verificación-periódica","content":"aparece un evento de auditoría correcto;"},"712":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-47","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#verificación-periódica","content":"el principal coincide con la identidad utilizada;"},"713":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-48","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#verificación-periódica","content":"el consumidor lo persiste una sola vez;"},"714":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-49","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#verificación-periódica","content":"puede recuperarse por recurso, actor y periodo;"},"715":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-50","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#verificación-periódica","content":"una interrupción del consumidor produce una alerta."},"716":{"id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs-51","page_id":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#verificación-periódica","content":"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema."},"717":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","type":"page","content":"Arquitectura de la plataforma","breadcrumbs":["Docs","Plataforma"],"tags":[],"url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture"},"718":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture-0","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","content":"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos."},"719":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture-1","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture#plano-de-control","content":"Plano de control"},"720":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture-2","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","content":"Custodia y operaciones criptográficas"},"721":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture-3","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture#emisión-y-enrolamiento","content":"Emisión y enrolamiento"},"722":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture-4","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture#estado-y-validación","content":"Estado y validación"},"723":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture-5","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture#dependencias-de-la-plataforma","content":"Dependencias de la plataforma"},"724":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture-6","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","content":"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga."},"725":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture-7","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","content":"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas."},"726":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture-8","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture#plano-de-control","content":"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma."},"727":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture-9","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","content":"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación."},"728":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture-10","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture#emisión-y-enrolamiento","content":"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad."},"729":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture-11","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture#estado-y-validación","content":"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado."},"730":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture-12","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/architecture#dependencias-de-la-plataforma","content":"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes."},"731":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","type":"page","content":"Cómo funciona Lamassu","breadcrumbs":["Docs","Plataforma"],"tags":[],"url":"/docs/pr-preview/pr-42/es/platform/concepts/overview"},"732":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-0","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview","content":"El modelo mental de confianza, claves, certificados y dispositivos."},"733":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-1","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#el-modelo-en-cinco-piezas","content":"El modelo en cinco piezas"},"734":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-2","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#del-alta-a-la-operación","content":"Del alta a la operación"},"735":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-3","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview","content":"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado."},"736":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-4","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#el-modelo-en-cinco-piezas","content":"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios."},"737":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-5","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#el-modelo-en-cinco-piezas","content":"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza."},"738":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-6","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#el-modelo-en-cinco-piezas","content":"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota."},"739":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-7","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#el-modelo-en-cinco-piezas","content":"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad."},"740":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-8","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#el-modelo-en-cinco-piezas","content":"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL."},"741":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-9","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#del-alta-a-la-operación","content":"Un administrador configura un motor criptográfico y crea o importa una CA."},"742":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-10","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#del-alta-a-la-operación","content":"Un DMS relaciona esa CA con una política de enrolamiento."},"743":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-11","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#del-alta-a-la-operación","content":"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad."},"744":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-12","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#del-alta-a-la-operación","content":"Lamassu conserva el inventario, el historial y el estado de la identidad."},"745":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-13","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#del-alta-a-la-operación","content":"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia."},"746":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-14","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#del-alta-a-la-operación","content":"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />"},"747":{"id":"/docs/pr-preview/pr-42/es/platform/concepts/overview-15","page_id":"/docs/pr-preview/pr-42/es/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/concepts/overview#del-alta-a-la-operación","content":"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />"},"748":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","type":"page","content":"Dispositivos e identidades","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades"],"tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management"},"749":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-0","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","content":"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial."},"750":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-1","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"Estados del dispositivo"},"751":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-2","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","content":"Inspecciona un dispositivo"},"752":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-3","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","content":"Registra un dispositivo manualmente"},"753":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-4","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#crea-el-dispositivo","content":"Crea el dispositivo"},"754":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-5","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#define-su-pertenencia","content":"Define su pertenencia"},"755":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-6","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","content":"Clasifica el dispositivo"},"756":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-7","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#verifica-el-alta","content":"Verifica el alta"},"757":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-8","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Asigna una identidad manualmente"},"758":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-9","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","content":"Revoca la identidad actual"},"759":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-10","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#retira-un-dispositivo","content":"Retira un dispositivo"},"760":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-11","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","content":"Automatiza el enrolamiento"},"761":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-12","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","content":"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota»."},"762":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-13","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","content":"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo."},"763":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-14","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"Vista operativa"},"764":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-15","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"Interpretación"},"765":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-16","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**No Identity**"},"766":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-17","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"Hay registro, pero todavía no hay identidad asociada."},"767":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-18","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**Active**"},"768":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-19","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"El slot está activo; comprueba además las fechas, estado y usos del certificado."},"769":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-20","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**Renewal Pending**"},"770":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-21","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"La identidad está en la ventana operativa de renovación."},"771":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-22","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**Expiring Soon**"},"772":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-23","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"Se aproxima al vencimiento según los umbrales configurados."},"773":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-24","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**Expired**"},"774":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-25","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"La identidad ha vencido."},"775":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-26","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**Revoked**"},"776":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-27","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"La identidad está marcada como revocada."},"777":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-28","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"**Decommissioned**"},"778":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-29","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"El registro está retirado y no vuelve al estado operativo mediante una actualización normal."},"779":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-30","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","content":"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor."},"780":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-31","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","content":"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual."},"781":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-32","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","content":"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores."},"782":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-33","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","content":"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados."},"783":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-34","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","content":"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto."},"784":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-35","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","content":"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente."},"785":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-36","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#crea-el-dispositivo","content":"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota."},"786":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-37","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#define-su-pertenencia","content":"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS."},"787":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-38","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","content":"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario."},"788":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-39","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#verifica-el-alta","content":"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación."},"789":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-40","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#verifica-el-alta","content":"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento."},"790":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-41","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Desde **No Identity**, utiliza **Assign Identity**:"},"791":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-42","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`."},"792":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-43","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil."},"793":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-44","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Confirma y vuelve a consultar serie, versión activa e historial."},"794":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-45","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso."},"795":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-46","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","content":"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla."},"796":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-47","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","content":"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados."},"797":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-48","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","content":"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado."},"798":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-49","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#retira-un-dispositivo","content":"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor."},"799":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-50","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#retira-un-dispositivo","content":"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie."},"800":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-51","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#retira-un-dispositivo","content":"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente."},"801":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-52","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#retira-un-dispositivo","content":"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo."},"802":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-53","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","content":"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />"},"803":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management-54","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","content":"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />"},"804":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","type":"page","content":"Identidad inicial y autenticación","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity"},"805":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-0","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","content":"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll."},"806":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-1","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","content":"Confianza inicial del servidor"},"807":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-2","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","content":"Credencial bootstrap"},"808":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-3","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","content":"Modos por operación"},"809":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-4","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"Contrato del webhook"},"810":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-5","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","content":"Revocación y comprobaciones"},"811":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-6","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","content":"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto."},"812":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-7","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","content":"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`."},"813":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-8","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","content":"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas."},"814":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-9","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","content":"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio."},"815":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-10","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","content":"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto."},"816":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-11","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","content":"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada."},"817":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-12","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","content":"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca."},"818":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-13","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","content":"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS."},"819":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-14","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS."},"820":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-15","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"Ejemplo de cuerpo:"},"821":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-16","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada."},"822":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-17","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor."},"823":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-18","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"La continuación requiere respuesta HTTP satisfactoria y JSON:"},"824":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-19","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","content":"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook."},"825":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-20","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","content":"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes."},"826":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity-21","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","content":"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST."},"827":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","type":"page","content":"Configura y opera el DMS","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms"},"828":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms-0","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","content":"Define registro, autenticación por operación, emisión, renovación y confianza distribuida."},"829":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms-1","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#antes-de-empezar","content":"Antes de empezar"},"830":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms-2","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configura-un-dms","content":"Configura un DMS"},"831":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms-3","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","content":"Identifica la flota"},"832":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms-4","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","content":"Selecciona la CA de enrolamiento"},"833":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms-5","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configura-est","content":"Configura EST"},"834":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms-6","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","content":"Distribuye la confianza"},"835":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms-7","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","content":"Verifica los endpoints"},"836":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms-8","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","content":"Configuración de enrollment"},"837":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms-9","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"Enrollment Device Registration"},"838":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms-10","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Enrollment Settings"},"839":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms-11","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Autenticación por operación"},"840":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms-12","page_id":"/