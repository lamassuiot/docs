ets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"`subscriber_event_bus`"},"1299":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-92","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"objeto"},"1300":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-93","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"1301":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-94","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS)."},"1302":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-95","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"`dms_manager_client`"},"1303":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-96","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"string"},"1304":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-97","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"1305":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-98","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"URL HTTP del servicio DMS Manager de Lamassu."},"1306":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-99","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"`device_manager_client`"},"1307":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-100","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"string"},"1308":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-101","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"1309":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-102","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"URL HTTP del Device Manager de Lamassu."},"1310":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-103","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"`ca_client`"},"1311":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-104","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"string"},"1312":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-105","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"Sí"},"1313":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-106","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","content":"URL HTTP del servicio de CA de Lamassu."},"1314":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-107","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","content":"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA."},"1315":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-108","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","content":"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API."},"1316":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-109","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","content":"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya."},"1317":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-110","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:"},"1318":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-111","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS."},"1319":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-112","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS."},"1320":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-113","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`."},"1321":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-114","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente."},"1322":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-115","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`."},"1323":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-116","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","content":"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente."},"1324":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-117","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","content":"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS."},"1325":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-118","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","content":"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota."},"1326":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-119","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","content":"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado."},"1327":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-120","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","content":"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:"},"1328":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-121","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","content":"Crea o actualiza las políticas IoT configuradas en el DMS."},"1329":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-122","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","content":"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente."},"1330":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-123","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","content":"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse."},"1331":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-124","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","content":"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager."},"1332":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-125","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","content":"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core."},"1333":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-126","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","content":"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa."},"1334":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-127","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","content":"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`."},"1335":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-128","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","content":"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP."},"1336":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-129","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","content":"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional."},"1337":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-130","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","content":"El flujo completo desde el punto de vista del dispositivo es el siguiente:"},"1338":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-131","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","content":"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado."},"1339":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-132","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez."},"1340":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-133","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión."},"1341":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-134","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"Para que el flujo JITP funcione correctamente:"},"1342":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-135","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP)."},"1343":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-136","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS."},"1344":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-137","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core."},"1345":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-138","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","content":"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección."},"1346":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-139","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:"},"1347":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-140","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Estado en Lamassu"},"1348":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-141","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Razón de revocación"},"1349":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-142","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Estado en AWS IoT Core"},"1350":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-143","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`Active`"},"1351":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-144","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Ninguna"},"1352":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-145","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`ACTIVE`"},"1353":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-146","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`Revoked`"},"1354":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-147","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`certificateHold`"},"1355":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-148","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`INACTIVE`"},"1356":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-149","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`Revoked`"},"1357":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-150","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Cualquier otra razón"},"1358":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-151","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"`REVOKED`"},"1359":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-152","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","content":"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`."},"1360":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-153","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","content":"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento."},"1361":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-154","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","content":"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`."},"1362":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-155","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","content":"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector."},"1363":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-156","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","content":"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`."},"1364":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-157","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","content":"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing)."},"1365":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-158","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia."},"1366":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-159","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"Existen dos tipos de acciones:"},"1367":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-160","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire."},"1368":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-161","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza."},"1369":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-162","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","content":"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia."},"1370":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-163","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","content":"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:"},"1371":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-164","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","content":"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN."},"1372":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-165","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","content":"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector)."},"1373":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-166","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`."},"1374":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-167","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto."},"1375":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-168","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA."},"1376":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-169","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación."},"1377":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-170","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado."},"1378":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-171","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento."},"1379":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-172","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación."},"1380":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-173","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión."},"1381":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-174","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core."},"1382":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-175","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core."},"1383":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-176","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu."},"1384":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-177","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT."},"1385":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-178","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera."},"1386":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-179","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo."},"1387":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-180","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas."},"1388":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-181","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Síntoma:** El Device Shadow no se actualiza cuando debería."},"1389":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-182","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado."},"1390":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-183","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`."},"1391":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-184","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1392":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-185","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />"},"1393":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core-186","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","content":"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />"},"1394":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","type":"page","content":"IoT Fleets","breadcrumbs":["Docs","Plataforma","IoT Fleets"],"tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview"},"1395":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-0","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","content":"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores."},"1396":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-1","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#empieza-aquí","content":"Empieza aquí"},"1397":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-2","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"Dispositivos e identidades"},"1398":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-3","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"Enrolamiento con PKI"},"1399":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-4","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#integraciones","content":"Integraciones"},"1400":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-5","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Quién prepara cada parte"},"1401":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-6","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","content":"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta."},"1402":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-7","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#empieza-aquí","content":"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado."},"1403":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-8","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#empieza-aquí","content":"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo."},"1404":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-9","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"Recurso"},"1405":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-10","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"Qué representa"},"1406":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-11","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"**Dispositivo**"},"1407":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-12","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"Una entrada de inventario con identificador, DMS propietario y clasificación."},"1408":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-13","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"**Identidad**"},"1409":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-14","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"La asociación del dispositivo con sus certificados: una versión activa y un historial."},"1410":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-15","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"**DMS**"},"1411":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-16","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza."},"1412":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-17","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"**Flota**"},"1413":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-18","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos."},"1414":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-19","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos."},"1415":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-20","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades","content":"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual."},"1416":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-21","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:"},"1417":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-22","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI."},"1418":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-23","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye."},"1419":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-24","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave."},"1420":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-25","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo."},"1421":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-26","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS."},"1422":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-27","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1423":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-28","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#enrolamiento-con-pki","content":"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />"},"1424":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-29","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#integraciones","content":"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo."},"1425":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-30","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#integraciones","content":"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados."},"1426":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-31","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Participante"},"1427":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-32","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Responsabilidad"},"1428":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-33","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Administrador PKI"},"1429":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-34","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"CA, perfil de emisión, cadena y publicación de revocación."},"1430":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-35","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Administrador del aprovisionamiento"},"1431":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-36","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"DMS, admisión, autenticación por operación e inventario."},"1432":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-37","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Integrador del dispositivo"},"1433":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-38","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Credencial inicial, clave, cliente EST, confianza e instalación de certificados."},"1434":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-39","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Integrador del consumidor"},"1435":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-40","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Emisores confiables, validación y permisos del dispositivo en el destino."},"1436":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-41","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue."},"1437":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"page","content":"Enrola y conecta tu primer dispositivo","breadcrumbs":["Docs","Plataforma","IoT Fleets","Primeros pasos"],"tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device"},"1438":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-0","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","content":"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS."},"1439":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-1","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"Antes de empezar"},"1440":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-2","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","content":"Prepara la credencial inicial"},"1441":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-3","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Configura el DMS de evaluación"},"1442":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-4","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","content":"Prepara el cliente y comprueba cacerts"},"1443":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-5","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"Enrola el dispositivo"},"1444":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-6","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","content":"Verifica la identidad obtenida"},"1445":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-7","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"Demuestra una conexión mTLS"},"1446":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-8","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Resultado y continuidad"},"1447":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-9","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","content":"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo."},"1448":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-10","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados."},"1449":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-11","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido."},"1450":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-12","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`."},"1451":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-13","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola."},"1452":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-14","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue."},"1453":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-15","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","content":"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena."},"1454":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-16","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","content":"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población."},"1455":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-17","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles."},"1456":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-18","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Crea el DMS `Acme EST Evaluation` con esta configuración:"},"1457":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-19","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Ajuste"},"1458":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-20","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstar