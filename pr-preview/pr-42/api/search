kstarts/create-certificate-authority#if-the-result-fails","content":"If creation fails, check permissions, engine availability and the selected algorithm."},"2295":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority-32","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails","content":"If OpenSSL cannot read the file, copy the complete PEM block again."},"2296":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority-33","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails","content":"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct."},"2297":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority-34","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails","content":"PKI diagnostics covers issuance checks and cryptographic dependencies."},"2298":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority-35","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#next-step","content":"Continue with Issue and verify a certificate, using this authority and `ca.pem`."},"2299":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate","type":"page","content":"Issue and verify a c