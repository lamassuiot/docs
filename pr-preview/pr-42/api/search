61":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-6","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","content":"External reverse proxy, NAT or VPN"},"262":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-7","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"What if you need three Gateways?"},"263":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-8","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#decision-guide","content":"Decision guide"},"264":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-9","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#verify-the-traffic-path","content":"Verify the traffic path"},"265":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-10","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#expose-the-lamassu-gateway","content":"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it."},"266":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-11","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#expose-the-lamassu-gateway","content":"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT."},"267":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-12","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status."},"268":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-13","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"Set it only when:"},"269":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-14","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"your cloud or bare-metal load balancer supports requesting a specific address"},"270":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-15","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"that address is allocated to this Gateway"},"271":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-16","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"the surrounding network already routes traffic for it to the cluster"},"272":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-17","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable."},"273":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-18","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"Keep these two settings separate:"},"274":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-19","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"`gateway.addresses` requests an address for the Gateway."},"275":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-20","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate."},"276":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-21","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`."},"277":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-22","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#recommended-single-node-design","content":"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:"},"278":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-23","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#recommended-single-node-design","content":"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes."},"279":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-24","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#k3s","content":"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports."},"280":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-25","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#k3s","content":"For the recommended design:"},"281":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-26","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#k3s","content":"Use only one externally exposed Lamassu Gateway."},"282":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-27","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#k3s","content":"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path."},"283":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-28","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#k3s","content":"Allow those ports through the VM firewall and any upstream security group."},"284":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-29","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#k3s","content":"Point DNS at the VM's reachable address."},"285":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-30","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#k3s","content":"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation."},"286":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-31","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","content":"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded."},"287":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-32","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","content":"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:"},"288":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-33","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","content":"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind."},"289":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-34","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"First decide whether you need three independent data planes or only three hostnames."},"290":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-35","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Requirement"},"291":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-36","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Recommended design"},"292":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-37","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Consequence"},"293":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-38","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Several Lamassu URLs or services"},"294":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-39","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"One Gateway with multiple routes"},"295":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-40","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"One IP and one proxy fleet; this is the chart default"},"296":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-41","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Independent Gateways and separate external IPs"},"297":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-42","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"One VIP per Gateway"},"298":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-43","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"All Gateways can use 80/443; requires a load balancer with an address pool"},"299":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-44","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Independent Gateways on one node and one IP"},"300":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-45","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Use different external ports"},"301":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-46","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Clients must include non-standard ports"},"302":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-47","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Separate TLS/mTLS termination behind one IP"},"303":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-48","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Front-door SNI routing to internal Gateways"},"304":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-49","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS"},"305":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-50","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Separate Gateway resources but shared proxy infrastructure"},"306":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-51","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Envoy merged-Gateway mode"},"307":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-52","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Logical separation only; listeners must have unique port, protocol and hostname tuples"},"308":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-53","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports."},"309":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-54","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design."},"310":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-55","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:"},"311":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-56","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","content":"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart."},"312":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-57","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#decision-guide","content":"If one Gateway can own TLS and routing, use the chart default."},"313":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-58","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#decision-guide","content":"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway."},"314":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-59","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#decision-guide","content":"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique."},"315":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-60","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#decision-guide","content":"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer."},"316":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-61","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#decision-guide","content":"If none of those are possible, use different external ports or change the external network design."},"317":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-62","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#verify-the-traffic-path","content":"Check, in order:"},"318":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-63","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#verify-the-traffic-path","content":"`Gateway` has `Accepted=True` and `Programmed=True`."},"319":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-64","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#verify-the-traffic-path","content":"Its status contains the expected address."},"320":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-65","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#verify-the-traffic-path","content":"The generated `LoadBalancer` Service has a usable external address."},"321":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-66","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#verify-the-traffic-path","content":"Port 443 reaches that address from the client network."},"322":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-67","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#verify-the-traffic-path","content":"DNS resolves to the externally reachable endpoint."},"323":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-68","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#verify-the-traffic-path","content":"The certificate contains the DNS name or IP used by the client."},"324":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking-69","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/networking#verify-the-traffic-path","content":"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model."},"325":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/overview","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/overview","type":"page","content":"Kubernetes self-managed","breadcrumbs":["Docs","Deployment","Kubernetes self-managed"],"tags":[],"url":"/docs/pr-preview/pr-42/deployment/self-hosted/overview"},"326":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/overview-0","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/overview","content":"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster."},"327":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/overview-1","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/deployment/self-hosted/overview#self-managed-kubernetes-deployment","content":"Self-managed Kubernetes deployment"},"328":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/overview-2","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/deployment/self-hosted/overview#choose-an-installation-workflow","content":"Choose an installation workflow"},"329":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/overview-3","page_id"