uickstarts/overview-5","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","content":"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key."},"2324":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-6","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#before-you-begin","content":"A Lamassu instance accessible from your browser. To prepare one, see Deployment."},"2325":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-7","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#before-you-begin","content":"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked."},"2326":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-8","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#before-you-begin","content":"An available cryptographic engine for the CA key; check the keys and engines inventory."},"2327":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-9","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#before-you-begin","content":"OpenSSL 3.x on the computer where you will verify the files."},"2328":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-10","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#before-you-begin","content":"A working directory with restricted access for the downloaded key."},"2329":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-11","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#recommended-path","content":"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />"},"2330":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-12","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#recommended-path","content":"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />"},"2331":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-13","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#recommended-path","content":"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect."},"2332":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-14","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#recommended-path","content":"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy."},"2333":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-15","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#expected-result","content":"File or resource"},"2334":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-16","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#expected-result","content":"Check"},"2335":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-17","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#expected-result","content":"Active root CA and `ca.pem`"},"2336":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-18","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#expected-result","content":"It is a CA certificate, is currently valid and its self-signature verifies."},"2337":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-19","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#expected-result","content":"End-entity certificate and `device.crt`"},"2338":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-20","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#expected-result","content":"It identifies `device-001`, supports client authentication and verifies against `ca.pem`."},"2339":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-21","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#expected-result","content":"Private key `device.key`"},"2340":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-22","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#expected-result","content":"Its public key matches the one included in `device.crt`."},"2341":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-23","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#expected-result","content":"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration."},"2342":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-24","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To operate certificates, continue with Certificates and Validation."},"2343":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-25","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation."},"2344":{"id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview-26","page_id":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"For the device to request its certificate, prepare the DMS and EST client."},"2345":{"id":"/docs/pr-preview/pr-42/platform/pki/troubleshooting","page_id":"/docs/pr-preview/pr-42/platform/pki/troubleshooting","type":"page","content":"PKI troubleshooting","breadcrumbs":["Docs","Platform","