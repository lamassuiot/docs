preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Initial authentication"},"1471":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-32","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates."},"1472":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-33","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Renewal authentication"},"1473":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-34","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block."},"1474":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-35","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Additional Validation CAs / Enable Expired Renewal"},"1475":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-36","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Empty list for this direct issuance / disabled."},"1476":{"id":"/docs/pr-p