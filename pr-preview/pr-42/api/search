42/platform/administration/audit-logs-15","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#what-an-event-contains","content":"has\\_error: whether the service returned an error;"},"682":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-16","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#what-an-event-contains","content":"output: produced result or error message;"},"683":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-17","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#what-an-event-contains","content":"principals: identifiers of the principals that matched the request."},"684":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-18","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#what-an-event-contains","content":"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type."},"685":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-19","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#what-an-event-contains","content":"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes."},"686":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-20","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#coverage","content":"The backend applies auditing to mutations of:"},"687":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-21","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#coverage","content":"authorities, certificates and issuance profiles;"},"688":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-22","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#coverage","content":"keys and KMS engines;"},"689":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-23","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#coverage","content":"devices and identities;"},"690":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-24","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#coverage","content":"DMSs and enrollment operations;"},"691":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-25","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#coverage","content":"validation functions and CRL;"},"692":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-26","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#coverage","content":"principals, policies and authorization grants."},"693":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-27","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#coverage","content":"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation."},"694":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-28","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#publication-and-persistence","content":"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file."},"695":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-29","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#publication-and-persistence","content":"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization."},"696":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-30","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#publication-and-persistence","content":"Design the consumer to:"},"697":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-31","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#publication-and-persistence","content":"subscribe to the audit.# types and also to operation types ending in .error;"},"698":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-32","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#publication-and-persistence","content":"keep the complete CloudEvent unmodified;"},"699":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-33","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#publication-and-persistence","content":"record the ingestion time and detect duplicates by ID;"},"700":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-34","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#publication-and-persistence","content":"encrypt in transit and at rest;"},"701":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-35","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#publication-and-persistence","content":"restrict reading and deletion to a role separate from the PKI operator;"},"702":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-36","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#publication-and-persistence","content":"apply an explicit retention and legal hold policy;"},"703":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-37","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#publication-and-persistence","content":"alert if it stops consuming or the pending queue grows."},"704":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-38","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#sensitive-data","content":"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform."},"705":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-39","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#sensitive-data","content":"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution."},"706":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-40","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#bound-the-interval","content":"Start from the reported time and normalize every source to UTC."},"707":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-41","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#identify-the-operation","content":"Filter by event type, service source and resource identifier."},"708":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-42","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#attribute-the-principal","content":"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment."},"709":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-43","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#compare-intent-and-result","content":"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed."},"710":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-44","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#follow-the-effect","content":"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations."},"711":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-45","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#periodic-verification","content":"Generate a controlled mutation in a test environment and check that:"},"712":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-46","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#periodic-verification","content":"a successful audit event appears;"},"713":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-47","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#periodic-verification","content":"the principal matches the identity used;"},"714":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-48","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#periodic-verification","content":"the consumer persists it exactly once;"},"715":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-49","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#periodic-verification","content":"it can be retrieved by resource, actor and period;"},"716":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-50","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#periodic-verification","content":"a consumer outage raises an alert."},"717":{"id":"/docs/pr-preview/pr-42/platform/administration/audit-logs-51","page_id":"/docs/pr-preview/pr-42/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/administration/audit-logs#periodic-verification","content":"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved."},"718":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","type":"page","content":"Platform architecture","breadcrumbs":["Docs","Platform"],"tags":[],"url":"/docs/pr-preview/pr-42/platform/concepts/architecture"},"719":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture-0","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/architecture","content":"Lamassu components and how control, keys, issuance and devices relate."},"720":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture-1","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/concepts/architecture#control-plane","content":"Control plane"},"721":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture-2","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/concepts/architecture#key-custody-and-cryptographic-operations","content":"Key custody and cryptographic operations"},"722":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture-3","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/concepts/architecture#issuance-and-enrollment","content":"Issuance and enrollment"},"723":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture-4","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/concepts/architecture#status-and-validation","content":"Status and validation"},"724":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture-5","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/concepts/architecture#platform-dependencies","content":"Platform dependencies"},"725":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture-6","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/architecture","content":"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load."},"726":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture-7","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/architecture","content":"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies."},"727":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture-8","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/architecture#control-plane","content":"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform."},"728":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture-9","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/architecture#key-custody-and-cryptographic-operations","content":"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation."},"729":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture-10","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/architecture#issuance-and-enrollment","content":"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity."},"730":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture-11","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/architecture#status-and-validation","content":"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate."},"731":{"id":"/docs/pr-preview/pr-42/platform/concepts/architecture-12","page_id":"/docs/pr-preview/pr-42/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/architecture#platform-dependencies","content":"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes."},"732":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","type":"page","content":"How Lamassu works","breadcrumbs":["Docs","Platform"],"tags":[],"url":"/docs/pr-preview/pr-42/platform/concepts/overview"},"733":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-0","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview","content":"The mental model of trust, keys, certificates and devices."},"734":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-1","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/concepts/overview#the-model-in-five-pieces","content":"The model in five pieces"},"735":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-2","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/concepts/overview#from-onboarding-to-operation","content":"From onboarding to operation"},"736":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-3","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview","content":"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle."},"737":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-4","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview#the-model-in-five-pieces","content":"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services."},"738":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-5","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview#the-model-in-five-pieces","content":"**Certification Authority (CA).** Signs certificates and establishes the chain of trust."},"739":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-6","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview#the-model-in-five-pieces","content":"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed."},"740":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-7","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview#the-model-in-five-pieces","content":"**Device.** Keeps its private key and presents the certificate to prove its identity."},"741":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-8","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview#the-model-in-five-pieces","content":"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL."},"742":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-9","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview#from-onboarding-to-operation","content":"An administrator configures a cryptographic engine and creates or imports a CA."},"743":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-10","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview#from-onboarding-to-operation","content":"A DMS relates that CA to an enrollment policy."},"744":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-11","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview#from-onboarding-to-operation","content":"The device generates a key and requests a certificate through EST, or an operator assigns it an identity."},"745":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-12","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview#from-onboarding-to-operation","content":"Lamassu keeps the inventory, history and status of the identity."},"746":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-13","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview#from-onboarding-to-operation","content":"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid."},"747":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-14","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview#from-onboarding-to-operation","content":"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />"},"748":{"id":"/docs/pr-preview/pr-42/platform/concepts/overview-15","page_id":"/docs/pr-preview/pr-42/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/concepts/overview#from-onboarding-to-operation","content":"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />"},"749":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","type":"page","content":"Devices and identities","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities"],"tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management"},"750":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-0","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","content":"Register, inspect and retire devices while checking their current identity and history."},"751":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-1","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"Device states"},"752":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-2","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#inspect-a-device","content":"Inspect a device"},"753":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-3","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#register-a-device-manually","content":"Register a device manually"},"754":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-4","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#create-the-device","content":"Create the device"},"755":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-5","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#define-its-membership","content":"Define its membership"},"756":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-6","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#classify-the-device","content":"Classify the device"},"757":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-7","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#verify-the-registration","content":"Verify the registration"},"758":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-8","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Assign an identity manually"},"759":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-9","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#revoke-the-current-identity","content":"Revoke the current identity"},"760":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-10","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#decommission-a-device","content":"Decommission a device"},"761":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-11","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#automate-enrollment","content":"Automate enrollment"},"762":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-12","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","content":"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create."},"763":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-13","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","content":"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device."},"764":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-14","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"Operational view"},"765":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-15","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"Meaning"},"766":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-16","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"**No Identity**"},"767":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-17","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"A record exists without an associated identity."},"768":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-18","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"**Active**"},"769":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-19","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"The slot is active; also check certificate dates, status and usages."},"770":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-20","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"**Renewal Pending**"},"771":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-21","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"The identity is in the operational renewal window."},"772":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-22","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"**Expiring Soon**"},"773":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-23","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"Expiration is approaching according to configured thresholds."},"774":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-24","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"**Expired**"},"775":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-25","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"The identity has expired."},"776":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-26","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"**Revoked**"},"777":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-27","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"The identity is marked revoked."},"778":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-28","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"**Decommissioned**"},"779":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-29","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"The record is retired and ordinary updates do not restore operation."},"780":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-30","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","content":"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance."},"781":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-31","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#inspect-a-device","content":"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial."},"782":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-32","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#inspect-a-device","content":"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version."},"783":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-33","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#inspect-a-device","content":"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates."},"784":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-34","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#inspect-a-device","content":"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment."},"785":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-35","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#register-a-device-manually","content":"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS."},"786":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-36","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#create-the-device","content":"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet."},"787":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-37","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#define-its-membership","content":"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS."},"788":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-38","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#classify-the-device","content":"Add model, environment or location tags and an icon according to your inventory."},"789":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-39","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#verify-the-registration","content":"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment."},"790":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-40","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#verify-the-registration","content":"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies."},"791":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-41","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#assign-an-identity-manually","content":"From **No Identity**, use **Assign Identity**:"},"792":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-42","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`."},"793":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-43","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#assign-an-identity-manually","content":"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first."},"794":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-44","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Confirm and read the serial, active version and history again."},"795":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-45","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Install the key/certificate pair and required intermediates on the device and test usage."},"796":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-46","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it."},"797":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-47","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#revoke-the-current-identity","content":"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide."},"798":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-48","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#revoke-the-current-identity","content":"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes."},"799":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-49","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#decommission-a-device","content":"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer."},"800":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-50","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#decommission-a-device","content":"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial."},"801":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-51","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#decommission-a-device","content":"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control."},"802":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-52","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#decommission-a-device","content":"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change."},"803":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-53","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#automate-enrollment","content":"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />"},"804":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management-54","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#automate-enrollment","content":"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />"},"805":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","type":"page","content":"Bootstrap identity and authentication","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity"},"806":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-0","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","content":"Prepare server trust and admission proofs for enroll and reenroll."},"807":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-1","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","content":"Initial server trust"},"808":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-2","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"Bootstrap credential"},"809":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-3","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","content":"Modes per operation"},"810":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-4","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"Webhook contract"},"811":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-5","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","content":"Revocation and checks"},"812":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-6","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","content":"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID."},"813":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-7","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","content":"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`."},"814":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-8","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","content":"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies."},"815":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-9","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service."},"816":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-10","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device."},"817":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-11","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity."},"818":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-12","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","content":"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears."},"819":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-13","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","content":"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication."},"820":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-14","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide."},"821":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-15","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"Example body:"},"822":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-16","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy."},"823":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-17","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client."},"824":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-18","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"Continuation requires a successful HTTP response and JSON:"},"825":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-19","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification."},"826":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-20","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","content":"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source."},"827":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity-21","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","content":"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client."},"828":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"page","content":"Configure and operate the DMS","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms"},"829":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-0","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","content":"Define registration, authentication per operation, issuance, renewal and distributed trust."},"830":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-1","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#before-you-begin","content":"Before you begin"},"831":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-2","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#configure-a-dms","content":"Configure a DMS"},"832":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-3","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#identify-the-fleet","content":"Identify the fleet"},"833":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-4","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","content":"Select the enrollment CA"},"834":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-5","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#configure-est","content":"Configure EST"},"835":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-6","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#distribute-trust","content":"Distribute trust"},"836":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-7","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#verify-the-endpoints","content":"Verify the endpoints"},"837":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-8","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-configuration","content":"Enrollment configuration"},"838":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-9","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"Enrollment Device Registration"},"839":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-10","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Enrollment Settings"},"840":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-11","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Authentication per operation"},"841":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-12","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"External webhook settings"},"842":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-13","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#issuance-profile","content":"Issuance profile"},"843":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-14","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Re-enrollment configuration"},"844":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-15","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#serverkeygen","content":"ServerKeyGen"},"845":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-16","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Trust distribution"},"846":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-17","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"Operate the DMS inventory"},"847":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-18","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#integrate-the-devices","content":"Integrate the devices"},"848":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-19","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","content":"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator."},"849":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-20","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#before-you-begin","content":"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement."},"850":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-21","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#before-you-begin","content":"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication."},"851":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-22","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#identify-the-fleet","content":"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS."},"852":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-23","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","content":"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity."},"853":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-24","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#configure-est","content":"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key."},"854":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-25","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#distribute-trust","content":"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation."},"855":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-26","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#verify-the-endpoints","content":"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance."},"856":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-27","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration."},"857":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-28","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode."},"858":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-29","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`settings.enrollment_settings` field"},"859":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-30","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Decision"},"860":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-31","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`protocol`"},"861":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-32","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`EST_RFC7030` for these operations."},"862":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-33","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enrollment_ca`"},"863":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-34","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"ID of the signing CA."},"864":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-35","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`verify_csr_signature`"},"865":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-36","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Keep `true` to verify CSR key possession."},"866":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-37","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enable_replaceable_enrollment`"},"867":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-38","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic."},"868":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-39","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`est_rfc7030_settings.auth_mode`"},"869":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-40","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"One of the four authentication modes."},"870":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-41","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes."},"871":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-42","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"The blocks are independent:"},"872":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-43","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`."},"873":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-44","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`."},"874":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-45","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`auth_mode`"},"875":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-46","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Control applied in the configured operation"},"876":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-47","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`CLIENT_CERTIFICATE`"},"877":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-48","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Presented certificate validation."},"878":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-49","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`EXTERNAL_WEBHOOK`"},"879":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-50","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Configured webhook authorization."},"880":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-51","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"881":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-52","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Certificate validation followed by webhook approval."},"882":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-53","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`NO_AUTH`"},"883":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-54","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"No DMS requester authentication."},"884":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-55","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails."},"885":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-56","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path."},"886":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-57","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For certificate re-enrollment, the validator uses the enrollment CA, then `additional_validation_cas`, and `enable_expired_renewal`. Do not assume copying initial `validation_cas` changes those issuers."},"887":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-58","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID."},"888":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-59","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:"},"889":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-60","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`external_webhook_settings` field"},"890":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-61","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Decision"},"891":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-62","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`url`"},"892":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-63","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed."},"893":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-64","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`method`"},"894":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-65","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`POST` or `PUT`; `POST` by default."},"895":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-66","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`name`"},"896":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-67","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Label used in service logs."},"897":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-68","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.auth_mode`"},"898":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-69","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`."},"899":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-70","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.apikey_options`"},"900":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-71","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `apikey`: `header` and `key`. Reserved header names are rejected."},"901":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-72","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.jwt_options`"},"902":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-73","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`."},"903":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-74","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.mtls_options`"},"904":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-75","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `mtls`: `cert_content` and `key_content` as inline PEM."},"905":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-76","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.insecure_skip_verify`"},"906":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-77","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here."},"907":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-78","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.call_timeout`"},"908":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-79","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Maximum duration of the authorization call (for example `10s`); 10 seconds by default."},"909":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-80","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Rules for that configuration:"},"910":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-81","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so supply the PEM as `mtls_options.cert_content` and `key_content`."},"911":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-82","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected."},"912":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-83","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`."},"913":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-84","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The API ignores the legacy fields `validate_server_cert`, `apikey`, `oidc` and `mtls`. A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` that still carries only the legacy option fields (`apikey`, `oidc`, `mtls`) fails validation with 400; only legacy `noauth` bodies are accepted, and their credentials are dropped."},"914":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-85","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The authorization response must be JSON of at most 1 MiB; a larger body fails the call."},"915":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-86","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises."},"916":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-87","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API."},"917":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-88","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Migration `20261021120000` rewrites every stored webhook config into this layout: `validate_server_cert` becomes the negated `insecure_skip_verify` (a config where `validate_server_cert` was false keeps skipping verification), `oidc` becomes `jwt_options`, `apikey` becomes `apikey_options` and `mtls` becomes `mtls_options`. When both the legacy certificate and key are PEM, they move into `mtls_options.cert_content` and `key_content` and need no action. Otherwise, including a mixed config (PEM certificate, file-path key), both values become `mtls_options.cert_file` and `key_file`. Delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are re-entered as PEM content, or the leftover file fields are removed if the webhook does not use mTLS. If your version's console does not expose those fields, edit the DMS through the DMS API."},"918":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-89","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#issuance-profile","content":"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust."},"919":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-90","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`settings.reenrollment_settings` field"},"920":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-91","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Purpose"},"921":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-92","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`reenrollment_delta`"},"922":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-93","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Opens the window at the active certificate’s `NotAfter` minus this delta."},"923":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-94","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`preventive_delta`"},"924":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-95","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Preventive operational monitoring threshold."},"925":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-96","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`critical_delta`"},"926":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-97","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Critical operational monitoring threshold."},"927":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-98","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`enable_expired_renewal`"},"928":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-99","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself."},"929":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-100","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`additional_validation_cas`"},"930":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-101","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Additional mTLS credential issuers during migration."},"931":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-102","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`revoke_on_reenrollment`"},"932":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-103","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor."},"933":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-104","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures."},"934":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-105","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#serverkeygen","content":"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference."},"935":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-106","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Option"},"936":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-107","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Published material"},"937":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-108","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Include Lamassu System CA**"},"938":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-109","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Available downstream TLS certificate; it can be a leaf, not an issuing CA."},"939":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-110","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Include Enrollment CA**"},"940":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-111","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Selected issuing CA certificate."},"941":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-112","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Managed CAs**"},"942":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-113","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Explicitly selected CA certificates."},"943":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-114","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#trust-distribution","content":"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust."},"944":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-115","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields."},"945":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-116","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs."},"946":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-117","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement."},"947":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms-118","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#integrate-the-devices","content":"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures."},"948":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","type":"page","content":"Integrate the EST client","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client"},"949":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-0","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","content":"Prepare trust, send a CSR and check the identity you receive."},"950":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-1","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Before you begin"},"951":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-2","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"Download and inspect cacerts"},"952":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-3","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"Prepare the CSR"},"953":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-4","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"Request the identity"},"954":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-5","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Check and install the result"},"955":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-6","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#next-steps","content":"Next steps"},"956":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-7","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","content":"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device."},"957":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-8","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools."},"958":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-9","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity."},"959":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-10","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name."},"960":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-11","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file."},"961":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-12","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works."},"962":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-13","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject."},"963":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-14","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles."},"964":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-15","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:"},"965":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-16","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance."},"966":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-17","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"For a root that issues directly:"},"967":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-18","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation."},"968":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-19","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete."},"969":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client-20","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#next-steps","content":"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures."},"970":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","type":"page","content":"EST reference","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference"},"971":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-0","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","content":"Look up Lamassu routes, formats, authentication and multipart responses."},"972":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-1","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Endpoint reference"},"973":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-2","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#cacerts","content":"cacerts"},"974":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-3","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"simpleenroll"},"975":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-4","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"simplereenroll"},"976":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-5","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"serverkeygen"},"977":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-6","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#response-format","content":"Response format"},"978":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-7","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Request and extraction"},"979":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-8","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"Compatibility notes"},"980":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-9","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","content":"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy."},"981":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-10","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route."},"982":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-11","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Operation"},"983":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-12","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Method"},"984":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-13","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Authentication and condition"},"985":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-14","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/cacerts`"},"986":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-15","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"GET"},"987":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-16","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply."},"988":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-17","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/simpleenroll`"},"989":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-18","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"990":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-19","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Initial authentication and DMS registration/replacement policy."},"991":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-20","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/simplereenroll`"},"992":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-21","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"993":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-22","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Renewal authentication, existing identity, subject, revocation and window."},"994":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-23","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/serverkeygen`"},"995":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-24","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"996":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-25","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Initial authentication and admission; server generation enabled."},"997":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-26","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract."},"998":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-27","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#cacerts","content":"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor."},"999":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-28","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#cacerts","content":"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots."},"1000":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-29","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy."},"1001":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-30","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR."},"1002":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-31","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate."},"1003":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-32","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"The enrollment CA or an additional CA validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery."},"1004":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-33","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM."},"1005":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-34","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement."},"1006":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-35","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#response-format","content":"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:"},"1007":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-36","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#response-format","content":"Part"},"1008":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-37","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#response-format","content":"Content after decoding its Base64"},"1009":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-38","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#response-format","content":"`application/pkcs8`"},"1010":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-39","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#response-format","content":"Unencrypted DER PKCS#8 private key."},"1011":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-40","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#response-format","content":"`application/pkcs7-mime; smime-type=certs-only`"},"1012":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-41","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#response-format","content":"DER PKCS#7 containing the issued certificate."},"1013":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-42","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#response-format","content":"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers."},"1014":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-43","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key."},"1015":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-44","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:"},"1016":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-45","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Convert and check the result:"},"1017":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-46","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser."},"1018":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-47","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting."},"1019":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference-48","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client."},"1020":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","type":"page","content":"Enrollment with PKI","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview"},"1021":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-0","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","content":"Choose admission policy and connect DMS, initial trust and the EST client."},"1022":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-1","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#the-journey","content":"The journey"},"1023":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-2","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"For the administrator"},"1024":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-3","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"For the integrator"},"1025":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-4","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#contract-version","content":"Contract version"},"1026":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-5","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","content":"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer."},"1027":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-6","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#the-journey","content":"The administrator prepares the CA, issuance profile and DMS."},"1028":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-7","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#the-journey","content":"The integrator installs initial EST server trust and an admission credential."},"1029":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-8","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#the-journey","content":"The client requests an identity for its `Device ID` through EST."},"1030":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-9","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#the-journey","content":"Certificate, device binding and key/certificate installation are checked."},"1031":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-10","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#the-journey","content":"The consumer validates and authorizes the identity; the client schedules renewal and recovery."},"1032":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-11","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#the-journey","content":"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test."},"1033":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-12","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />"},"1034":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-13","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1035":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-14","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />"},"1036":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-15","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />"},"1037":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-16","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />"},"1038":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-17","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />"},"1039":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-18","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />"},"1040":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-19","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />"},"1041":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-20","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#contract-version","content":"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan."},"1042":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview-21","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#contract-version","content":"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations."},"1043":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","type":"page","content":"Provisioning strategies","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies"},"1044":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-0","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","content":"Choose device registration, identity authorization and key generation."},"1045":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-1","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Choose registration"},"1046":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-2","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"Preregistration and replacement"},"1047":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-3","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"Choose authentication"},"1048":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-4","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Choose custody"},"1049":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-5","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","content":"Check the decision"},"1050":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-6","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","content":"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself."},"1051":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-7","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Path"},"1052":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-8","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"When the device exists"},"1053":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-9","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"What to check"},"1054":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-10","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Manual assignment"},"1055":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-11","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"An operator creates it before associating a certificate."},"1056":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-12","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"ID, owning DMS, certificate CN and bound serial."},"1057":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-13","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"EST with `JITP`"},"1058":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-14","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Created for an unknown CN during `/simpleenroll`."},"1059":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-15","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Authorized credential, unused ID, profile, resulting registration and identity."},"1060":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-16","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"EST with `PRE_REGISTRATION`"},"1061":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-17","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Must exist before `/simpleenroll`."},"1062":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-18","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Approved record, same DMS and replacement conditions for your version."},"1063":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-19","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions."},"1064":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-20","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration."},"1065":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-21","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path."},"1066":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-22","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state."},"1067":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-23","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying."},"1068":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-24","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"Decide initial enrollment and re-enrollment separately:"},"1069":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-25","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**Client certificate:** useful when each device has an initial credential whose key it controls."},"1070":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-26","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID."},"1071":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-27","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**Certificate and webhook:** requires both controls in the configured operation."},"1072":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-28","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS."},"1073":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-29","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication."},"1074":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-30","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Option"},"1075":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-31","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Material crossing EST"},"1076":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-32","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Device-generated key"},"1077":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-33","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Public CSR and certificate; the key stays on the client."},"1078":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-34","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Existing device key"},"1079":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-35","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"CSR signed with that key and a new certificate."},"1080":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-36","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"ServerKeyGen"},"1081":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-37","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Private PKCS#8 key and certificate in a TLS-protected multipart response."},"1082":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-38","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material."},"1083":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies-39","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","content":"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate."},"1084":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","type":"page","content":"Renewal and recovery","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery"},"1085":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-0","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","content":"Renew without losing the identity and recover devices according to their actual state."},"1086":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-1","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Prepare renewal"},"1087":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-2","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","content":"Request the successor certificate"},"1088":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-3","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"Install and check the new pair"},"1089":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-4","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Recover according to state"},"1090":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-5","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","content":"Continuous operation"},"1091":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-6","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","content":"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps."},"1092":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-7","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key."},"1093":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-8","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted."},"1094":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-9","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window."},"1095":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-10","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one."},"1096":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-11","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","content":"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes."},"1097":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-12","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","content":"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results."},"1098":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-13","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key."},"1099":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-14","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption."},"1100":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-15","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation."},"1101":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-16","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Situation"},"1102":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-17","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Procedure"},"1103":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-18","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Valid certificate, outside the window"},"1104":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-19","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Schedule the request within the window. Do not use `simpleenroll` to bypass it."},"1105":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-20","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Expired certificate, key available"},"1106":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-21","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply."},"1107":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-22","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Renewal through webhook or `NO_AUTH`"},"1108":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-23","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition."},"1109":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-24","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Lost or inaccessible key"},"1110":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-25","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity."},"1111":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-26","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Current identity revoked"},"1112":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-27","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it."},"1113":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-28","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Device without an identity"},"1114":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-29","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning."},"1115":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-30","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Retired device"},"1116":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-31","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent."},"1117":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-32","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Timeout, HTTP 500 or installation failure"},"1118":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-33","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked."},"1119":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-34","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","content":"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed."},"1120":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery-35","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","content":"Continue with Trust distribution, Devices and identities and Troubleshooting."},"1121":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","type":"page","content":"Enrollment troubleshooting","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting"},"1122":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-0","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","content":"Locate transport, authentication, registration, issuance and installation failures."},"1123":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-1","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","content":"Diagnostics and compatibility"},"1124":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-2","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Error codes and diagnostics"},"1125":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-3","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes","content":"Compatibility notes"},"1126":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-4","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"EST enrollment fails"},"1127":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-5","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","content":"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report."},"1128":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-6","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result."},"1129":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-7","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Symptom or message"},"1130":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-8","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"What to check"},"1131":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-9","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"curl rejects TLS, name or issuer"},"1132":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-10","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification."},"1133":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-11","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"404 or missing APS"},"1134":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-12","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name."},"1135":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-13","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"400, CSR or format error"},"1136":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-14","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding."},"1137":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-15","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Missing credential or invalid certificate"},"1138":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-16","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA."},"1139":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-17","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Webhook denies, times out or responds without authorization"},"1140":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-18","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`."},"1141":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-19","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`unexpected status code: <n>: redirects are not followed`"},"1142":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-20","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed."},"1143":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-21","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`webhook response exceeds 1048576 bytes`"},"1144":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-22","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook."},"1145":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-23","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`webhook config must not reference files`"},"1146":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-24","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the PEM as `cert_content` and `key_content`; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the upgrade note in DMS."},"1147":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-25","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"400 `struct validation error` creating or updating a DMS"},"1148":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-26","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS."},"1149":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-27","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"HTTP 500 with an `err` body on enroll or reenroll"},"1150":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-28","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there."},"1151":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-29","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`device not preregistered`"},"1152":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-30","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"PRE\\_REGISTRATION requires an existing inventory entry."},"1153":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-31","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`forbiddenNewEnrollment`"},"1154":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-32","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag."},"1155":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-33","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Different owning DMS"},"1156":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-34","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"CN/ID, global inventory and owning DMS; do not reuse an ID from another context."},"1157":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-35","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`invalid RawSubject bytes`"},"1158":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-36","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"CSR subject versus the current certificate. Preserve its attributes as well as its CN."},"1159":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-37","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`invalid reenroll window`"},"1160":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-38","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window."},"1161":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-39","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Current certificate revoked"},"1162":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-40","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Renewal rejected; prepare authorized recovery according to the cause."},"1163":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-41","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"CA, profile or signing error"},"1164":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-42","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance."},"1165":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-43","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"HTTP 200 without a device connection"},"1166":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-44","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history."},"1167":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-45","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Timeout or error after issuance"},"1168":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-46","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"New certificates, current slot and previous identity's state before retrying."},"1169":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-47","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes","content":"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA."},"1170":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-48","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes","content":"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference."},"1171":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-49","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"Check HTTPS with the approved root and query cacerts for the correct APS."},"1172":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-50","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window."},"1173":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-51","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"Verify the CSR locally and relate its CN to the inventory."},"1174":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-52","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"Make one request, save headers/body and query the device and certificates."},"1175":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-53","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"If you receive an identity, check the key, subject, use and connection with the consumer."},"1176":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-54","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either."},"1177":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting-55","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities."},"1178":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","type":"page","content":"Trust distribution and updates","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution"},"1179":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-0","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","content":"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates."},"1180":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-1","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Three trust relationships"},"1181":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-2","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","content":"What cacerts returns"},"1182":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-3","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Install the required material"},"1183":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-4","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","content":"Migrate trust"},"1184":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-5","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#check-the-update","content":"Check the update"},"1185":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-6","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","content":"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors."},"1186":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-7","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Relationship"},"1187":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-8","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Material prepared by its owner"},"1188":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-9","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Device → EST server"},"1189":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-10","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Previously verified server root, chain or pin and TLS name."},"1190":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-11","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"DMS → requester"},"1191":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-12","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"CAs and rules authorizing initial or renewal credentials."},"1192":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-13","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Consumer → device"},"1193":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-14","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Operational identity roots, intermediates, validation and permissions."},"1194":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-15","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model."},"1195":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-16","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","content":"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration."},"1196":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-17","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","content":"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client."},"1197":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-18","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Keep initial EST server trust separate from identity consumer trust."},"1198":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-19","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Select policy-approved roots as anchors."},"1199":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-20","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Retain intermediates for chain building or presentation; do not automatically turn them into roots."},"1200":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-21","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent."},"1201":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-22","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Verify chain, dates, names, usages and revocation from the consumer."},"1202":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-23","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose."},"1203":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-24","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","content":"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains."},"1204":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-25","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","content":"In the DMS, separate distributed CAs from `additional_validation_cas`, used for re-enrollment credentials. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured."},"1205":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-26","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","content":"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation."},"1206":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution-27","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#check-the-update","content":"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device."},"1207":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core","type":"page","content":"AWS IoT Core","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Integrations"],"tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core"},"1208":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core-0","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core","content":"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven."},"1209":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core-1","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","content":"Connector architecture"},"1210":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core-2","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#prerequisites","content":"Prerequisites"},"1211":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core-3","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","content":"Required IAM permissions"},"1212":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core-4","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Configuration parameters"},"1213":{"id":"/docs/pr-pr