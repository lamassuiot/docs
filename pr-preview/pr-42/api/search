cs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Low to medium: validation errors or changed defaults"},"2536":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-118","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Update the values file"},"2537":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-119","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"DMS update API"},"2538":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-120","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Clients that send the DMS ID in the update body"},"2539":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-121","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Low: the ID in the URL wins"},"2540":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-122","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Send the ID in the URL"},"2541":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-123","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Certificate type values"},"2542":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-124","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Consumers that match on certificate `type`"},"2543":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-125","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Low: two values are renamed"},"2544":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-126","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Adapt consumers"},"2545":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-127","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Independent re-enrollment authentication"},"2546":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-128","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Any DMS"},"2547":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-129","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Low: informational"},"2548":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-130","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Read both blocks before editing"},"2549":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-131","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","content":"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk."},"2550":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-132","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","content":"Step 4 of the migration guide copies the data."},"2551":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-133","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#strict-values-validation","content":"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change."},"2552":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-134","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","content":"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI."},"2553":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-135","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","content":"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged."},"2554":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-136","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#non-root-containers","content":"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`."},"2555":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-137","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#non-root-containers","content":"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity."},"2556":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-138","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#amqp-over-tls","content":"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate."},"2557":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-139","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","content":"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest."},"2558":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-140","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","content":"`services.connectors` is a map keyed by connector ID instead of a list."},"2559":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-141","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","content":"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image."},"2560":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-142","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","content":"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks."},"2561":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-143","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","content":"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it."},"2562":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-144","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","content":"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`."},"2563":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-145","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","content":"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm)."},"2564":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-146","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","content":"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:"},"2565":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-147","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","content":"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear."},"2566":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-148","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","content":"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first."},"2567":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-149","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","content":"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected."},"2568":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-150","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","content":"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading."},"2569":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-151","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","content":"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:"},"2570":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-152","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","content":"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key)."},"2571":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-153","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","content":"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times."},"2572":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-154","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","content":"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records."},"2573":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-155","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","content":"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning."},"2574":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-156","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","content":"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand."},"2575":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-157","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"Stored webhook configs are rewritten to the current layout and their fields renamed:"},"2576":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-158","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"Field in 3.8.0"},"2577":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-159","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"Field in 4.0.0"},"2578":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-160","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"`validate_server_cert`"},"2579":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-161","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"`insecure_skip_verify` (value negated)"},"2580":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-162","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"`oidc`"},"2581":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-163","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"`jwt_options`"},"2582":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-164","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"`apikey`"},"2583":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-165","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"`apikey_options`"},"2584":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-166","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"`mtls`"},"2585":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-167","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"`mtls_options`"},"2586":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-168","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it."},"2587":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-169","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM."},"2588":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-170","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","content":"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable."},"2589":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-171","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","content":"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:"},"2590":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-172","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","content":"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list."},"2591":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-173","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","content":"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns."},"2592":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-174","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","content":"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. If the console version does not expose independent settings, edit them through the DMS API."},"2593":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-175","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-update-api","content":"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it."},"2594":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-176","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#certificate-type-values","content":"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values."},"2595":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-177","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#device-events","content":"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:"},"2596":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-178","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#device-events","content":"`GET /v1/devices/:id/events` returns a device's events."},"2597":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-179","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#device-events","content":"`POST /v1/devices/:id/events` creates an event."},"2598":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-180","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#device-events","content":"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker."},"2599":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-181","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#helm-migration-guide","content":"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm."},"2600":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-182","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-1-prepare","content":"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`."},"2601":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-183","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-1-prepare","content":"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first."},"2602":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-184","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-1-prepare","content":"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation."},"2603":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-185","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-1-prepare","content":"Record the names of your local-storage PVCs:"},"2604":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-186","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-1-prepare","content":"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later."},"2605":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-187","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","content":"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:"},"2606":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-188","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","content":"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else."},"2607":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-189","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","content":"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values."},"2608":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-190","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","content":"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them."},"2609":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-191","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","content":"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:"},"2610":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-192","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","content":"**Rename `toolbox` to `connectivityTest`:**"},"2611":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-193","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","content":"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`."},"2612":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-194","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","content":"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:"},"2613":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-195","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","content":"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext."},"2614":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-196","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","content":"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:"},"2615":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-197","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","content":"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one."},"2616":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-198","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","content":"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown."},"2617":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-199","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","content":"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run."},"2618":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-200","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","content":"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again."},"2619":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-201","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","content":"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`."},"2620":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-202","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","content":"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:"},"2621":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-203","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","content":"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow."},"2622":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-204","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","content":"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:"},"2623":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-205","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","content":"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:"},"2624":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-206","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","content":"**Inspect before writing** so you do not clobber data the new pods may already have written:"},"2625":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-207","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","content":"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store."},"2626":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-208","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","content":"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:"},"2627":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-209","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","content":"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares."},"2628":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-210","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","content":"**Remove the helper and restore the recorded replica counts:**"},"2629":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-211","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","content":"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`."},"2630":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-212","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","content":"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone."},"2631":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-213","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","content":"Then go through the validation checklist. Keep the old PVCs until it passes."},"2632":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-214","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#deployments-without-helm","content":"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand."},"2633":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-215","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#deployments-without-helm","content":"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:"},"2634":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-216","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#deployments-without-helm","content":"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:"},"2635":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-217","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#deployments-without-helm","content":"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository."},"2636":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-218","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#deployments-without-helm","content":"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples."},"2637":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-219","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#troubleshooting","content":"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist."},"2638":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-220","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#troubleshooting","content":"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong."},"2639":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-221","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#troubleshooting","content":"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait."},"2640":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-222","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#troubleshooting","content":"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know."},"2641":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-223","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#troubleshooting","content":"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade."},"2642":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-224","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#troubleshooting","content":"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run."},"2643":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-225","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#troubleshooting","content":"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed."},"2644":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-226","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"After the upgrade, check in this order:"},"2645":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-227","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations."},"2646":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-228","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors."},"2647":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-229","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied."},"2648":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-230","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued."},"2649":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-231","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS."},"2650":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-232","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response."},"2651":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-233","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions."},"2652":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-234","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place."},"2653":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-235","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them."},"2654":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-236","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`."},"2655":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-237","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified."},"2656":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-238","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call."},"2657":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-239","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps."},"2658":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-240","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","content":"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values."},"2659":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-241","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","content":"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:"},"2660":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-242","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","content":"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified."},"2661":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-243","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","content":"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />"},"2662":{"id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0-244","page_id":"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text",