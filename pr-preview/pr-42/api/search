/pr-42/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/key-management#verify","content":"**Result**: indicator of the validation result."},"2166":{"id":"/docs/pr-preview/pr-42/platform/pki/key-management-104","page_id":"/docs/pr-preview/pr-42/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/key-management#generate-a-csr","content":"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine."},"2167":{"id":"/docs/pr-preview/pr-42/platform/pki/key-management-105","page_id":"/docs/pr-preview/pr-42/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/key-management#generate-a-csr","content":"This flow is useful for:"},"2168":{"id":"/docs/pr-preview/pr-42/platform/pki/key-management-106","page_id":"/docs/pr-preview/pr-42/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/key-management#generate-a-csr","content":"Requesting certificates from an external CA."},"2169":{"id":"/docs/pr-preview/pr-42/platform/pki/key-management-107","page_id":"/docs/pr-preview/pr-42/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/key-management#generate-a-csr","content":"Renewing an identity while keeping the same key."},"2170":{"id":"/docs/pr-preview/pr-42/platform/pki/key-management-108","page_id":"/docs/pr-preview/pr-42/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/key-management#generate-a-csr","content":"When you open the form, it asks for the subject data and the main certificate attributes:"},"2171":{"id":"/docs/pr-preview/pr-42/platform/pki/key-management-109","page_id":"/docs/pr-preview/pr-42/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/pki/key-management#generate-a-csr",