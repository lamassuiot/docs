stro tiene clave privada utilizable y el motor puede firmar."},"2358":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-14","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","content":"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor."},"2359":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-15","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","content":"CSR"},"2360":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-16","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","content":"PEM correcto y firma verificable."},"2361":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-17","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","content":"`openssl req -in request.csr -noout -verify -text`."},"2362":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-18","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","content":"Perfil"},"2363":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-19","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","content":"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos."},"2364":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-20","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","content":"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta."},"2365":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-21","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","content":"Resultado"},"2366":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-22","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","content":"Sujeto, SAN, usos y fechas adecuados."},"2367":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-23","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","content":"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor."},"2368":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-24","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","content":"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA."},"2369":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-25","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","content":"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación."},"2370":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-26","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"Revisa cada frontera por separado:"},"2371":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-27","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición."},"2372":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-28","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia."},"2373":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-29","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado."},"2374":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-30","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue."},"2375":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-31","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva."},"2376":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-32","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación."},"2377":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-33","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","content":"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo."},"2378":{"id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting-34","page_id":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","content":"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora."}},"count":2378},"sorting":{"language":"spanish","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":878,"2":937,"3":452,"4":1951,"5":397,"6":685,"7":1540,"8":1518,"9":2113,"10":1467,"11":1755,"12":2293,"13":2232,"14":49,"15":23,"16":129,"17":400,"18":2031,"19":682,"20":1357,"21":750,"22":879,"23":1081,"24":1100,"25":6,"26":882,"27":1846,"28":1611,"29":1902,"30":1889,"31":1854,"32":1412,"33":1817,"34":2201,"35":1326,"36":512,"37":1241,"38":2202,"39":1348,"40":2016,"41":1182,"42":1501,"43":2177,"44":358,"45":338,"46":359,"47":2304,"48":818,"49":2320,"50":740,"51":1870,"52":1767,"53":2131,"54":1514,"55":903,"56":764,"57":417,"58":2152,"59":1766,"60":908,"61":2151,"62":2128,"63":2153,"64":1321,"65":1103,"66":383,"67":1818,"68":1322,"69":1104,"70":384,"71":1170,"72":1346,"73":840,"74":385,"75":743,"76":823,"77":1259,"78":483,"79":877,"80":1857,"81":446,"82":1360,"83":2025,"84":1676,"85":1859,"86":622,"87":802,"88":2358,"89":1263,"90":1717,"91":1261,"92":1265,"93":2205,"94":1388,"95":966,"96":1178,"97":567,"98":2230,"99":675,"100":621,"101":1968,"102":1268,"103":1632,"104":2221,"105":282,"106":333,"107":564,"108":280,"109":1585,"110":1262,"111":1267,"112":934,"113":781,"114":1776,"115":1156,"116":1072,"117":732,"118":1673,"119":2338,"120":1822,"121":182,"122":0,"123":1623,"124":180,"125":746,"126":2032,"127":185,"128":1253,"129":1672,"130":186,"131":284,"132":1624,"133":181,"134":244,"135":926,"136":187,"137":1538,"138":2367,"139":173,"140":197,"141":1851,"142":172,"143":198,"144":1850,"145":177,"146":1,"147":574,"148":178,"149":2,"150":594,"151":184,"152":584,"153":2308,"154":183,"155":883,"156":2130,"157":174,"158":1254,"159":138