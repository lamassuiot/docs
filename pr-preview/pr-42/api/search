atform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","content":"Check"},"1500":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-61","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","content":"Expected result"},"1501":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-62","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","content":"Registration"},"1502":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-63","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","content":"ID created automatically and correct DMS."},"1503":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-64","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","content":"Certificate"},"1504":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-65","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","content":"CN, profile, serial and key verified."},"1505":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-66","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tag