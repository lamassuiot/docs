42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Credencial inicial, clave, cliente EST, confianza e instalación de certificados."},"1435":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-39","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Integrador del consumidor"},"1436":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-40","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Emisores confiables, validación y permisos del dispositivo en el destino."},"1437":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview-41","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","content":"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue."},"1438":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"page","content":"Enrola y conecta tu primer dispositivo","breadcrumbs":["Docs","Plataforma","IoT Fleets","Primeros pasos"],"tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device"},"1439":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-0","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","content":"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS."},"1440":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-1","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"Antes de empezar"},"1441":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-2","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","content":"Prepara la credencial inicial"},"1442":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-3","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Configura el DMS de evaluación"},"1443":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-4","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","content":"Prepara el cliente y comprueba cacerts"},"1444":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-5","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","content":"Enrola el dispositivo"},"1445":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-6","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","content":"Verifica la identidad obtenida"},"1446":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-7","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","content":"Demuestra una conexión mTLS"},"1447":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-8","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","content":"Resultado y continuidad"},"1448":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-9","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","content":"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo."},"1449":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-10","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados."},"1450":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-11","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido."},"1451":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-12","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`."},"1452":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-13","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola."},"1453":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-14","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar","content":"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue."},"1454":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-15","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","content":"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena."},"1455":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-16","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","content":"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población."},"1456":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-17","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles."},"1457":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-18","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Crea el DMS `Acme EST Evaluation` con esta configuración:"},"1458":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-19","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Ajuste"},"1459":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-20","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Valor de evaluación"},"1460":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-21","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Enrollment CA"},"1461":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-22","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Raíz emisora de `device-root.pem`."},"1462":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-23","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Perfil de emisión"},"1463":{"id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device-24","page_id":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","content":"Perfil final de 1 hora que acaba