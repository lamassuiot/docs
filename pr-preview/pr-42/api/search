-device-27","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Verify CSR Signature"},"1493":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-28","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Enabled."},"1494":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-29","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Enable Replaceable Enrollment"},"1495":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-30","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Disabled; the ID must be new."},"1496":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-31","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Initial authentication"},"1497":{"id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device-32","page_id":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates