/self-hosted/fastlane#tls-behavior","content":"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system."},"183":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane-105","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#credentials-and-generated-files","content":"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use."},"184":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane-106","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#credentials-and-generated-files","content":"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it."},"185":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane-107","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#credentials-and-generated-files","content":"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production."},"186":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane-108","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#verify-the-installation","content":"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway."},"187":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm","type":"page","content":"Install with Helm","breadcrumbs":["Docs","Deployment","Kubernetes self-managed"],"tags":[],"url":"/docs/pr-preview/pr-42/deployment/self-hosted/helm"},"188":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm-0","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-42/deployment/self-hosted/helm","content":"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment."},"189":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm-1","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/deployment/self-hosted/helm#install-lamassu-with-helm","content":"Install Lamassu with Helm"},"190":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm-2","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/deployment/self-hosted/helm#before-you-begin","content":"Before you begin"},"191":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm-3","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","content":"1\\. Install the Gateway prerequisites"},"192":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm-4","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/deployment/self-hosted/helm#2-create-a-values-file","content":"2\\. Create a values file"},"193":{"id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm-5","page_id":"/docs/pr-preview/pr-42/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-42/deployment/self-hosted/helm#tls-with-an-existing-