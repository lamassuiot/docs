:103484,"_33673":103488,"_33675":103492,"_33677":103496,"_33679":103499,"_33681":103502,"_33683":103505,"_33685":103508,"_33687":103511,"_33689":103514,"_33691":103517,"_33693":103520,"_33695":103523,"_33697":103526,"_33699":103529,"_33701":103532,"_33703":103535,"_33705":103538,"_33707":103541,"_33709":103544,"_33711":103547,"_33713":103550,"_33715":103553,"_33717":103556,"_33719":103559,"_33721":103562,"_33723":103565,"_33725":103568,"_33727":103570,"_33729":103572,"_33731":103575,"_33733":103578,"_33735":103581,"_33737":103584,"_33739":103587,"_33741":103590,"_33743":103593,"_33745":103596,"_33747":103599,"_33749":103602,"_33751":103605,"_33753":103608,"_33755":103611,"_33757":103614,"_33759":103617,"_33761":103620,"_33763":103624,"_33765":103627,"_33767":103630,"_33769":103634,"_33771":103637,"_33773":103641,"_33775":103644,"_33777":103647,"_33779":103650,"_33781":103653,"_33783":103656,"_33785":103659,"_33787":103662,"_33789":103665,"_33791":103668,"_33793":103671,"_33795":103674,"_33797":103676,"_33799":103679,"_33801":103682,"_33803":103685,"_33805":103688,"_33807":103691,"_33809":103694,"_33811":103697,"_33813":103700,"_33815":103703,"_33817":103706,"_33819":103711,"_33821":103714,"_33823":103718,"_33825":103722,"_33827":103726,"_33829":103729,"_33831":103732,"_33833":103734,"_33835":103736,"_33837":103738,"_33839":103740,"_33841":103743,"_33843":103746,"_33845":103749,"_33847":103752,"_33849":103755,"_33851":103757,"_33853":103760,"_33855":103762,"_33857":103765,"_33859":103768,"_33861":103771,"_33863":103773,"_33865":103776,"_33867":103779,"_33869":103782,"_33871":103785,"_33873":103788,"_33875":103791,"_33877":103794,"_33879":103797,"_33881":103800,"_33883":103803,"_33885":103806,"_33887":103809},{"_2872":58136,"_25347":58136,"_5":12438,"_2399":96501,"_25683":96502,"_17690":96505,"_23966":58136},"Despliega desde AWS Marketplace",[41104,96503,96504],"Despliegue","Otros modelos",[],{"_2872":58137,"_25347":58136,"_17690":96507,"_5":17585,"_23966":58136,"_2399":96508},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2872":58138,"_25347":58136,"_5":25680,"_17690":96510,"_23966":96511,"_2399":96512},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2872":58139,"_25347":58136,"_5":25680,"_17690":96514,"_23966":96515,"_2399":96516},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2872":58140,"_25347":58136,"_5":25680,"_17690":96518,"_23966":96519,"_2399":96520},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2872":58141,"_25347":58136,"_5":25680,"_17690":96522,"_23966":96523,"_2399":96524},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2872":58142,"_25347":58136,"_5":25680,"_17690":96526,"_23966":96527,"_2399":96528},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2872":58143,"_25347":58136,"_5":25680,"_17690":96530,"_23966":96531,"_2399":96532},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2872":58144,"_25347":58136,"_5":25680,"_17690":96534,"_23966":96535,"_2399":96536},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2872":58145,"_25347":58136,"_17690":96538,"_5":17585,"_23966":58136,"_2399":96539},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2872":58146,"_25347":58136,"_17690":96541,"_5":17585,"_23966":96511,"_2399":96542},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2872":58147,"_25347":58136,"_17690":96544,"_5":17585,"_23966":96511,"_2399":96545},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2872":58148,"_25347":58136,"_17690":96547,"_5":17585,"_23966":96511,"_2399":96548},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2872":58149,"_25347":58136,"_17690":96550,"_5":17585,"_23966":96515,"_2399":96551},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2872":58150,"_25347":58136,"_17690":96553,"_5":17585,"_23966":96515,"_2399":96554},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2872":58151,"_25347":58136,"_17690":96556,"_5":17585,"_23966":96515,"_2399":96557},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2872":58152,"_25347":58136,"_17690":96559,"_5":17585,"_23966":96519,"_2399":96560},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2872":58153,"_25347":58136,"_17690":96562,"_5":17585,"_23966":96523,"_2399":96563},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2872":58154,"_25347":58136,"_17690":96565,"_5":17585,"_23966":96527,"_2399":96566},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2872":58155,"_25347":58136,"_17690":96568,"_5":17585,"_23966":96531,"_2399":96569},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2872":58156,"_25347":58136,"_17690":96571,"_5":17585,"_23966":96535,"_2399":96572},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2872":58157,"_25347":58157,"_5":12438,"_2399":96574,"_25683":96575,"_17690":96576,"_23966":58157},"Despliega Lamassu",[41104,96503],[],{"_2872":58158,"_25347":58157,"_17690":96578,"_5":17585,"_23966":58157,"_2399":96579},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2872":58159,"_25347":58157,"_5":25680,"_17690":96581,"_23966":96582,"_2399":96583},[],"/docs/pr-preview/pr-42/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2872":58160,"_25347":58157,"_5":25680,"_17690":96585,"_23966":96586,"_2399":96587},[],"/docs/pr-preview/pr-42/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2872":58161,"_25347":58157,"_5":25680,"_17690":96589,"_23966":96590,"_2399":96591},[],"/docs/pr-preview/pr-42/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2872":58162,"_25347":58157,"_17690":96593,"_5":17585,"_23966":58157,"_2399":96594},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2872":58163,"_25347":58157,"_17690":96596,"_5":17585,"_23966":96582,"_2399":96597},[],"Modelo",{"_2872":58164,"_25347":58157,"_17690":96599,"_5":17585,"_23966":96582,"_2399":96600},[],"Recomendado para",{"_2872":58165,"_25347":58157,"_17690":96602,"_5":17585,"_23966":96582,"_2399":96603},[],"Quién opera la infraestructura",{"_2872":58166,"_25347":58157,"_17690":96605,"_5":17585,"_23966":96582,"_2399":96606},[],"Punto de partida",{"_2872":58167,"_25347":58157,"_17690":96608,"_5":17585,"_23966":96582,"_2399":41211},[],{"_2872":58168,"_25347":58157,"_17690":96610,"_5":17585,"_23966":96582,"_2399":96611},[],"Producción, entornos regulados y despliegues personalizados",{"_2872":58169,"_25347":58157,"_17690":96613,"_5":17585,"_23966":96582,"_2399":96614},[],"Tu equipo",{"_2872":58170,"_25347":58157,"_17690":96616,"_5":17585,"_23966":96582,"_2399":96617},[],"Helm o Fastlane",{"_2872":58171,"_25347":58157,"_17690":96619,"_5":17585,"_23966":96582,"_2399":41223},[],{"_2872":58172,"_25347":58157,"_17690":96621,"_5":17585,"_23966":96582,"_2399":96622},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2872":58173,"_25347":58157,"_17690":96624,"_5":17585,"_23966":96582,"_2399":96614},[],{"_2872":58174,"_25347":58157,"_17690":96626,"_5":17585,"_23966":96582,"_2399":96627},[],"Imagen preconfigurada en EC2",{"_2872":58175,"_25347":58157,"_17690":96629,"_5":17585,"_23966":96582,"_2399":41234},[],{"_2872":58176,"_25347":58157,"_17690":96631,"_5":17585,"_23966":96582,"_2399":96632},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2872":58177,"_25347":58157,"_17690":96634,"_5":17585,"_23966":96582,"_2399":41240},[],{"_2872":58178,"_25347":58157,"_17690":96636,"_5":17585,"_23966":96582,"_2399":96637},[],"Suscripción gestionada",{"_2872":58179,"_25347":58157,"_17690":96639,"_5":17585,"_23966":96582,"_2399":96640},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2872":58180,"_25347":58157,"_17690":96642,"_5":17585,"_23966":96582,"_2399":96643},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2872":58181,"_25347":58157,"_17690":96645,"_5":17585,"_23966":96582,"_2399":96646},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2872":58182,"_25347":58157,"_17690":96648,"_5":17585,"_23966":96586,"_2399":96649},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2872":58183,"_25347":58157,"_17690":96651,"_5":17585,"_23966":96590,"_2399":96652},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2872":58184,"_25347":58184,"_5":12438,"_2399":96654,"_25683":96655,"_17690":96656,"_23966":58184},"Utiliza Lamassu como SaaS",[41104,96503,96504],[],{"_2872":58185,"_25347":58184,"_17690":96658,"_5":17585,"_23966":58184,"_2399":96659},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2872":58186,"_25347":58184,"_5":25680,"_17690":96661,"_23966":96662,"_2399":96663},[],"/docs/pr-preview/pr-42/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2872":58187,"_25347":58184,"_5":25680,"_17690":96665,"_23966":96666,"_2399":96667},[],"/docs/pr-preview/pr-42/es/deployment/saas#planes","Planes",{"_2872":58188,"_25347":58184,"_5":25680,"_17690":96669,"_23966":96670,"_2399":96671},[],"/docs/pr-preview/pr-42/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2872":58189,"_25347":58184,"_17690":96673,"_5":17585,"_23966":58184,"_2399":96674},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2872":58190,"_25347":58184,"_17690":96676,"_5":17585,"_23966":96662,"_2399":96677},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2872":58191,"_25347":58184,"_17690":96679,"_5":17585,"_23966":96662,"_2399":96680},[],"Copias de seguridad automáticas.",{"_2872":58192,"_25347":58184,"_17690":96682,"_5":17585,"_23966":96662,"_2399":96683},[],"Actualizaciones de versión.",{"_2872":58193,"_25347":58184,"_17690":96685,"_5":17585,"_23966":96662,"_2399":96686},[],"Soporte técnico y SLA según el plan contratado.",{"_2872":58194,"_25347":58184,"_17690":96688,"_5":17585,"_23966":96666,"_2399":41295},[],{"_2872":58195,"_25347":58184,"_17690":96690,"_5":17585,"_23966":96666,"_2399":96691},[],"Dispositivos",{"_2872":58196,"_25347":58184,"_17690":96693,"_5":17585,"_23966":96666,"_2399":96694},[],"Soporte",{"_2872":58197,"_25347":58184,"_17690":96696,"_5":17585,"_23966":96666,"_2399":41304},[],{"_2872":58198,"_25347":58184,"_17690":96698,"_5":17585,"_23966":96666,"_2399":41307},[],{"_2872":58199,"_25347":58184,"_17690":96700,"_5":17585,"_23966":96666,"_2399":96701},[],"Hasta 1.000",{"_2872":58200,"_25347":58184,"_17690":96703,"_5":17585,"_23966":96666,"_2399":41313},[],{"_2872":58201,"_25347":58184,"_17690":96705,"_5":17585,"_23966":96666,"_2399":96706},[],"99,5 %",{"_2872":58202,"_25347":58184,"_17690":96708,"_5":17585,"_23966":96666,"_2399":41319},[],{"_2872":58203,"_25347":58184,"_17690":96710,"_5":17585,"_23966":96666,"_2399":96711},[],"Hasta 10.000",{"_2872":58204,"_25347":58184,"_17690":96713,"_5":17585,"_23966":96666,"_2399":96714},[],"Email y chat",{"_2872":58205,"_25347":58184,"_17690":96716,"_5":17585,"_23966":96666,"_2399":96717},[],"99,9 %",{"_2872":58206,"_25347":58184,"_17690":96719,"_5":17585,"_23966":96666,"_2399":41331},[],{"_2872":58207,"_25347":58184,"_17690":96721,"_5":17585,"_23966":96666,"_2399":96722},[],"Ilimitados",{"_2872":58208,"_25347":58184,"_17690":96724,"_5":17585,"_23966":96666,"_2399":96725},[],"Dedicado",{"_2872":58209,"_25347":58184,"_17690":96727,"_5":17585,"_23966":96666,"_2399":96728},[],"99,99 %",{"_2872":58210,"_25347":58184,"_17690":96730,"_5":17585,"_23966":96670,"_2399":96731},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2872":58211,"_25347":58184,"_17690":96733,"_5":17585,"_23966":96670,"_2399":96734},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2872":58212,"_25347":58212,"_5":12438,"_2399":41348,"_25683":96736,"_17690":96738,"_23966":58212},[41104,96503,96737],"Kubernetes autogestionado",[],{"_2872":58213,"_25347":58212,"_17690":96740,"_5":17585,"_23966":58212,"_2399":96741},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2872":58214,"_25347":58212,"_5":25680,"_17690":96743,"_23966":96744,"_2399":96745},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2872":58215,"_25347":58212,"_5":25680,"_17690":96747,"_23966":96748,"_2399":96749},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2872":58216,"_25347":58212,"_5":25680,"_17690":96751,"_23966":96752,"_2399":96753},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2872":58217,"_25347":58212,"_5":25680,"_17690":96755,"_23966":96756,"_2399":96757},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2872":58218,"_25347":58212,"_5":25680,"_17690":96759,"_23966":96760,"_2399":96761},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2872":58219,"_25347":58212,"_5":25680,"_17690":96763,"_23966":96764,"_2399":96765},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2872":58220,"_25347":58212,"_5":25680,"_17690":96767,"_23966":96768,"_2399":96769},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2872":58221,"_25347":58212,"_5":25680,"_17690":96771,"_23966":96772,"_2399":96773},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2872":58222,"_25347":58212,"_5":25680,"_17690":96775,"_23966":96776,"_2399":96777},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2872":58223,"_25347":58212,"_5":25680,"_17690":96779,"_23966":96780,"_2399":96781},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2872":58224,"_25347":58212,"_17690":96783,"_5":17585,"_23966":96744,"_2399":96784},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2872":58225,"_25347":58212,"_17690":96786,"_5":17585,"_23966":96744,"_2399":96787},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2872":58226,"_25347":58212,"_17690":96789,"_5":17585,"_23966":96748,"_2399":96790},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2872":58227,"_25347":58212,"_17690":96792,"_5":17585,"_23966":96748,"_2399":96793},[],"Fastlane instala o configura",{"_2872":58228,"_25347":58212,"_17690":96795,"_5":17585,"_23966":96748,"_2399":96796},[],"Tú sigues proporcionando",{"_2872":58229,"_25347":58212,"_17690":96798,"_5":17585,"_23966":96748,"_2399":96799},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2872":58230,"_25347":58212,"_17690":96801,"_5":17585,"_23966":96748,"_2399":96802},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2872":58231,"_25347":58212,"_17690":96804,"_5":17585,"_23966":96748,"_2399":96805},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2872":58232,"_25347":58212,"_17690":96807,"_5":17585,"_23966":96748,"_2399":96808},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2872":58233,"_25347":58212,"_17690":96810,"_5":17585,"_23966":96748,"_2399":96811},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2872":58234,"_25347":58212,"_17690":96813,"_5":17585,"_23966":96748,"_2399":96814},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2872":58235,"_25347":58212,"_17690":96816,"_5":17585,"_23966":96748,"_2399":96817},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2872":58236,"_25347":58212,"_17690":96819,"_5":17585,"_23966":96748,"_2399":96820},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2872":58237,"_25347":58212,"_17690":96822,"_5":17585,"_23966":96748,"_2399":96823},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2872":58238,"_25347":58212,"_17690":96825,"_5":17585,"_23966":96752,"_2399":96826},[],"Necesitas:",{"_2872":58239,"_25347":58212,"_17690":96828,"_5":17585,"_23966":96752,"_2399":96829},[],"un clúster Kubernetes existente",{"_2872":58240,"_25347":58212,"_17690":96831,"_5":17585,"_23966":96752,"_2399":96832},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2872":58241,"_25347":58212,"_17690":96834,"_5":17585,"_23966":96752,"_2399":41446},[],{"_2872":58242,"_25347":58212,"_17690":96836,"_5":17585,"_23966":96752,"_2399":20004},[],{"_2872":58243,"_25347":58212,"_17690":96838,"_5":17585,"_23966":96752,"_2399":96839},[],"`jq` solo si usas `--sample-data`",{"_2872":58244,"_25347":58212,"_17690":96841,"_5":17585,"_23966":96752,"_2399":96842},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2872":58245,"_25347":58212,"_17690":96844,"_5":17585,"_23966":96752,"_2399":96845},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2872":58246,"_25347":58212,"_17690":96847,"_5":17585,"_23966":96752,"_2399":96848},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2872":58247,"_25347":58212,"_17690":96850,"_5":17585,"_23966":96756,"_2399":96851},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2872":58248,"_25347":58212,"_17690":96853,"_5":17585,"_23966":96756,"_2399":96854},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2872":58249,"_25347":58212,"_17690":96856,"_5":17585,"_23966":96760,"_2399":96857},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2872":58250,"_25347":58212,"_17690":96859,"_5":17585,"_23966":96760,"_2399":96860},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2872":58251,"_25347":58212,"_17690":96862,"_5":17585,"_23966":96760,"_2399":96863},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2872":58252,"_25347":58212,"_17690":96865,"_5":17585,"_23966":96760,"_2399":96866},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2872":58253,"_25347":58212,"_17690":96868,"_5":17585,"_23966":96764,"_2399":96869},[],"Opción",{"_2872":58254,"_25347":58212,"_17690":96871,"_5":17585,"_23966":96764,"_2399":96872},[],"Valor predeterminado",{"_2872":58255,"_25347":58212,"_17690":96874,"_5":17585,"_23966":96764,"_2399":96875},[],"Propósito",{"_2872":58256,"_25347":58212,"_17690":96877,"_5":17585,"_23966":96764,"_2399":41490},[],{"_2872":58257,"_25347":58212,"_17690":96879,"_5":17585,"_23966":96764,"_2399":41493},[],{"_2872":58258,"_25347":58212,"_17690":96881,"_5":17585,"_23966":96764,"_2399":96882},[],"Muestra la ayuda",{"_2872":58259,"_25347":58212,"_17690":96884,"_5":17585,"_23966":96764,"_2399":41499},[],{"_2872":58260,"_25347":58212,"_17690":96886,"_5":17585,"_23966":96764,"_2399":96887},[],"contexto actual",{"_2872":58261,"_25347":58212,"_17690":96889,"_5":17585,"_23966":96764,"_2399":96890},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2872":58262,"_25347":58212,"_17690":96892,"_5":17585,"_23966":96764,"_2399":41508},[],{"_2872":58263,"_25347":58212,"_17690":96894,"_5":17585,"_23966":96764,"_2399":5392},[],{"_2872":58264,"_25347":58212,"_17690":96896,"_5":17585,"_23966":96764,"_2399":96897},[],"Omite prompts y genera credenciales para las dependencias",{"_2872":58265,"_25347":58212,"_17690":96899,"_5":17585,"_23966":96764,"_2399":41516},[],{"_2872":58266,"_25347":58212,"_17690":96901,"_5":17585,"_23966":96764,"_2399":41519},[],{"_2872":58267,"_25347":58212,"_17690":96903,"_5":17585,"_23966":96764,"_2399":96904},[],"Namespace de la instalación",{"_2872":58268,"_25347":58212,"_17690":96906,"_5":17585,"_23966":96764,"_2399":41525},[],{"_2872":58269,"_25347":58212,"_17690":96908,"_5":17585,"_23966":96764,"_2399":41528},[],{"_2872":58270,"_25347":58212,"_17690":96910,"_5":17585,"_23966":96764,"_2399":96911},[],"Dominio usado por la UI, OIDC y el certificado",{"_2872":58271,"_25347":58212,"_17690":96913,"_5":17585,"_23966":96764,"_2399":41534},[],{"_2872":58272,"_25347":58212,"_17690":96915,"_5":17585,"_23966":96764,"_2399":12664},[],{"_2872":58273,"_25347":58212,"_17690":96917,"_5":17585,"_23966":96764,"_2399":96918},[],"Versión del chart de Lamassu",{"_2872":58274,"_25347":58212,"_17690":96920,"_5":17585,"_23966":96764,"_2399":41542},[],{"_2872":58275,"_25347":58212,"_17690":96922,"_5":17585,"_23966":96764,"_2399":41545},[],{"_2872":58276,"_25347":58212,"_17690":96924,"_5":17585,"_23966":96764,"_2399":96925},[],"Puerto del listener HTTPS",{"_2872":58277,"_25347":58212,"_17690":96927,"_5":17585,"_23966":96764,"_2399":41551},[],{"_2872":58278,"_25347":58212,"_17690":96929,"_5":17585,"_23966":96764,"_2399":41554},[],{"_2872":58279,"_25347":58212,"_17690":96931,"_5":17585,"_23966":96764,"_2399":96932},[],"Puerto del listener HTTP",{"_2872":58280,"_25347":58212,"_17690":96934,"_5":17585,"_23966":96764,"_2399":41560},[],{"_2872":58281,"_25347":58212,"_17690":96936,"_5":17585,"_23966":96764,"_2399":41493},[],{"_2872":58282,"_25347":58212,"_17690":96938,"_5":17585,"_23966":96764,"_2399":96939},[],"Certificado PEM para TLS downstream",{"_2872":58283,"_25347":58212,"_17690":96941,"_5":17585,"_23966":96764,"_2399":41568},[],{"_2872":58284,"_25347":58212,"_17690":96943,"_5":17585,"_23966":96764,"_2399":41493},[],{"_2872":58285,"_25347":58212,"_17690":96945,"_5":17585,"_23966":96764,"_2399":96946},[],"Clave privada PEM para TLS downstream",{"_2872":58286,"_25347":58212,"_17690":96948,"_5":17585,"_23966":96764,"_2399":41576},[],{"_2872":58287,"_25347":58212,"_17690":96950,"_5":17585,"_23966":96764,"_2399":96951},[],"chart del repositorio",{"_2872":58288,"_25347":58212,"_17690":96953,"_5":17585,"_23966":96764,"_2399":96954},[],"Usa un chart local de Lamassu sin empaquetar",{"_2872":58289,"_25347":58212,"_17690":96956,"_5":17585,"_23966":96764,"_2399":41585},[],{"_2872":58290,"_25347":58212,"_17690":96958,"_5":17585,"_23966":96764,"_2399":96959},[],"detección automática",{"_2872":58291,"_25347":58212,"_17690":96961,"_5":17585,"_23966":96764,"_2399":96962},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2872":58292,"_25347":58212,"_17690":96964,"_5":17585,"_23966":96764,"_2399":41593},[],{"_2872":58293,"_25347":58212,"_17690":96966,"_5":17585,"_23966":96764,"_2399":5392},[],{"_2872":58294,"_25347":58212,"_17690":96968,"_5":17585,"_23966":96764,"_2399":96969},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2872":58295,"_25347":58212,"_17690":96971,"_5":17585,"_23966":96764,"_2399":41601},[],{"_2872":58296,"_25347":58212,"_17690":96973,"_5":17585,"_23966":96764,"_2399":5392},[],{"_2872":58297,"_25347":58212,"_17690":96975,"_5":17585,"_23966":96764,"_2399":96976},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2872":58298,"_25347":58212,"_17690":96978,"_5":17585,"_23966":96764,"_2399":41609},[],{"_2872":58299,"_25347":58212,"_17690":96980,"_5":17585,"_23966":96764,"_2399":5392},[],{"_2872":58300,"_25347":58212,"_17690":96982,"_5":17585,"_23966":96764,"_2399":96983},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2872":58301,"_25347":58212,"_17690":96985,"_5":17585,"_23966":96764,"_2399":41617},[],{"_2872":58302,"_25347":58212,"_17690":96987,"_5":17585,"_23966":96764,"_2399":41620},[],{"_2872":58303,"_25347":58212,"_17690":96989,"_5":17585,"_23966":96764,"_2399":96990},[],"Usa otro chart local de SoftHSM",{"_2872":58304,"_25347":58212,"_17690":96992,"_5":17585,"_23966":96764,"_2399":96993},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2872":58305,"_25347":58212,"_17690":96995,"_5":17585,"_23966":96768,"_2399":41629},[],{"_2872":58306,"_25347":58212,"_17690":96997,"_5":17585,"_23966":96768,"_2399":96998},[],"valida las herramientas locales y el clúster seleccionado",{"_2872":58307,"_25347":58212,"_17690":97000,"_5":17585,"_23966":96768,"_2399":97001},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2872":58308,"_25347":58212,"_17690":97003,"_5":17585,"_23966":96768,"_2399":97004},[],"crea el namespace",{"_2872":58309,"_25347":58212,"_17690":97006,"_5":17585,"_23966":96768,"_2399":97007},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2872":58310,"_25347":58212,"_17690":97009,"_5":17585,"_23966":96768,"_2399":97010},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2872":58311,"_25347":58212,"_17690":97012,"_5":17585,"_23966":96768,"_2399":97013},[],"instala RabbitMQ",{"_2872":58312,"_25347":58212,"_17690":97015,"_5":17585,"_23966":96768,"_2399":97016},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2872":58313,"_25347":58212,"_17690":97018,"_5":17585,"_23966":96768,"_2399":97019},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2872":58314,"_25347":58212,"_17690":97021,"_5":17585,"_23966":96768,"_2399":97022},[],"carga datos de ejemplo opcionalmente",{"_2872":58315,"_25347":58212,"_17690":97024,"_5":17585,"_23966":96768,"_2399":97025},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2872":58316,"_25347":58212,"_17690":97027,"_5":17585,"_23966":96772,"_2399":97028},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2872":58317,"_25347":58212,"_17690":97030,"_5":17585,"_23966":96772,"_2399":97031},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2872":58318,"_25347":58212,"_17690":97033,"_5":17585,"_23966":96776,"_2399":97034},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2872":58319,"_25347":58212,"_17690":97036,"_5":17585,"_23966":96776,"_2399":97037},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2872":58320,"_25347":58212,"_17690":97039,"_5":17585,"_23966":96776,"_2399":97040},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2872":58321,"_25347":58212,"_17690":97042,"_5":17585,"_23966":96780,"_2399":97043},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2872":58322,"_25347":58322,"_5":12438,"_2399":97045,"_25683":97046,"_17690":97047,"_23966":58322},"Instala con Helm",[41104,96503,96737],[],{"_2872":58323,"_25347":58322,"_17690":97049,"_5":17585,"_23966":58322,"_2399":97050},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2872":58324,"_25347":58322,"_5":25680,"_17690":97052,"_23966":97053,"_2399":97054},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2872":58325,"_25347":58322,"_5":25680,"_17690":97056,"_23966":97057,"_2399":96753},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2872":58326,"_25347":58322,"_5":25680,"_17690":97059,"_23966":97060,"_2399":97061},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2872":58327,"_25347":58322,"_5":25680,"_17690":97063,"_23966":97064,"_2399":97065},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2872":58328,"_25347":58322,"_5":25680,"_17690":97067,"_23966":97068,"_2399":97069},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2872":58329,"_25347":58322,"_5":25680,"_17690":97071,"_23966":97072,"_2399":97073},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_2872":58330,"_25347":58322,"_5":25680,"_17690":97075,"_23966":97076,"_2399":97077},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2872":58331,"_25347":58322,"_5":25680,"_17690":97079,"_23966":97080,"_2399":97081},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2872":58332,"_25347":58322,"_5":25680,"_17690":97083,"_23966":97084,"_2399":97085},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2872":58333,"_25347":58322,"_5":25680,"_17690":97087,"_23966":97088,"_2399":97089},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2872":58334,"_25347":58322,"_17690":97091,"_5":17585,"_23966":97053,"_2399":97092},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2872":58335,"_25347":58322,"_17690":97094,"_5":17585,"_23966":97057,"_2399":97095},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2872":58336,"_25347":58322,"_17690":97097,"_5":17585,"_23966":97057,"_2399":97098},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2872":58337,"_25347":58322,"_17690":97100,"_5":17585,"_23966":97057,"_2399":97101},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2872":58338,"_25347":58322,"_17690":97103,"_5":17585,"_23966":97057,"_2399":97104},[],"un broker RabbitMQ accesible y sus credenciales",{"_2872":58339,"_25347":58322,"_17690":97106,"_5":17585,"_23966":97057,"_2399":97107},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2872":58340,"_25347":58322,"_17690":97109,"_5":17585,"_23966":97057,"_2399":97110},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2872":58341,"_25347":58322,"_17690":97112,"_5":17585,"_23966":97057,"_2399":97113},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2872":58342,"_25347":58322,"_17690":97115,"_5":17585,"_23966":97057,"_2399":97116},[],"una StorageClass y un diseño de tráfico externo",{"_2872":58343,"_25347":58322,"_17690":97118,"_5":17585,"_23966":97057,"_2399":97119},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2872":58344,"_25347":58322,"_17690":97121,"_5":17585,"_23966":97057,"_2399":97122},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2872":58345,"_25347":58322,"_17690":97124,"_5":17585,"_23966":97057,"_2399":97125},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2872":58346,"_25347":58322,"_17690":97127,"_5":17585,"_23966":97060,"_2399":97128},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2872":58347,"_25347":58322,"_17690":97130,"_5":17585,"_23966":97060,"_2399":97131},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2872":58348,"_25347":58322,"_17690":97133,"_5":17585,"_23966":97060,"_2399":97134},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2872":58349,"_25347":58322,"_17690":97136,"_5":17585,"_23966":97064,"_2399":97137},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2872":58350,"_25347":58322,"_17690":97139,"_5":17585,"_23966":97064,"_2399":97140},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2872":58351,"_25347":58322,"_17690":97142,"_5":17585,"_23966":97064,"_2399":97143},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2872":58352,"_25347":58322,"_17690":97145,"_5":17585,"_23966":97064,"_2399":97146},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_2872":58353,"_25347":58322,"_17690":97148,"_5":17585,"_23966":97068,"_2399":97149},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2872":58354,"_25347":58322,"_17690":97151,"_5":17585,"_23966":97072,"_2399":97152},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del event bus. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_2872":58355,"_25347":58322,"_17690":97154,"_5":17585,"_23966":97072,"_2399":97155},[],"Sin un Secret de CA configurado, los clientes del event bus usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_2872":58356,"_25347":58322,"_17690":97157,"_5":17585,"_23966":97072,"_2399":97158},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_2872":58357,"_25347":58322,"_17690":97160,"_5":17585,"_23966":97072,"_2399":97161},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_2872":58358,"_25347":58322,"_17690":97163,"_5":17585,"_23966":97072,"_2399":97164},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_2872":58359,"_25347":58322,"_17690":97166,"_5":17585,"_23966":97072,"_2399":97167},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_2872":58360,"_25347":58322,"_17690":97169,"_5":17585,"_23966":97072,"_2399":97170},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del event bus usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro.",{"_2872":58361,"_25347":58322,"_17690":97172,"_5":17585,"_23966":97076,"_2399":97173},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2872":58362,"_25347":58322,"_17690":97175,"_5":17585,"_23966":97076,"_2399":97176},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2872":58363,"_25347":58322,"_17690":97178,"_5":17585,"_23966":97076,"_2399":97179},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2872":58364,"_25347":58322,"_17690":97181,"_5":17585,"_23966":97076,"_2399":97182},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2872":58365,"_25347":58322,"_17690":97184,"_5":17585,"_23966":97080,"_2399":97185},[],"Para instalar un checkout local:",{"_2872":58366,"_25347":58322,"_17690":97187,"_5":17585,"_23966":97084,"_2399":97188},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2872":58367,"_25347":58322,"_17690":97190,"_5":17585,"_23966":97084,"_2399":97191},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2872":58368,"_25347":58322,"_17690":97193,"_5":17585,"_23966":97088,"_2399":97194},[],"Antes de pasar a producción, revisa:",{"_2872":58369,"_25347":58322,"_17690":97196,"_5":17585,"_23966":97088,"_2399":97197},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2872":58370,"_25347":58322,"_17690":97199,"_5":17585,"_23966":97088,"_2399":97200},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2872":58371,"_25347":58322,"_17690":97202,"_5":17585,"_23966":97088,"_2399":97203},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2872":58372,"_25347":58322,"_17690":97205,"_5":17585,"_23966":97088,"_2399":97206},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2872":58373,"_25347":58322,"_17690":97208,"_5":17585,"_23966":97088,"_2399":97209},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2872":58374,"_25347":58322,"_17690":97211,"_5":17585,"_23966":97088,"_2399":97212},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2872":58375,"_25347":58322,"_17690":97214,"_5":17585,"_23966":97088,"_2399":97215},[],"SMTP, observabilidad y entrega de alertas",{"_2872":58376,"_25347":58322,"_17690":97217,"_5":17585,"_23966":97088,"_2399":97218},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2872":58377,"_25347":58322,"_17690":97220,"_5":17585,"_23966":97088,"_2399":97221},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2872":58378,"_25347":58378,"_5":12438,"_2399":97223,"_25683":97224,"_17690":97225,"_23966":58378},"Expón el Gateway",[41104,96503,96737],[],{"_2872":58379,"_25347":58378,"_17690":97227,"_5":17585,"_23966":58378,"_2399":97228},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2872":58380,"_25347":58378,"_5":25680,"_17690":97230,"_23966":97231,"_2399":97232},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2872":58381,"_25347":58378,"_5":25680,"_17690":97234,"_23966":97235,"_2399":97236},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2872":58382,"_25347":58378,"_5":25680,"_17690":97238,"_23966":97239,"_2399":97240},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2872":58383,"_25347":58378,"_5":25680,"_17690":97242,"_23966":97243,"_2399":41878},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#k3s",{"_2872":58384,"_25347":58378,"_5":25680,"_17690":97245,"_23966":97246,"_2399":97247},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2872":58385,"_25347":58378,"_5":25680,"_17690":97249,"_23966":97250,"_2399":97251},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2872":58386,"_25347":58378,"_5":25680,"_17690":97253,"_23966":97254,"_2399":97255},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2872":58387,"_25347":58378,"_5":25680,"_17690":97257,"_23966":97258,"_2399":97259},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2872":58388,"_25347":58378,"_5":25680,"_17690":97261,"_23966":97262,"_2399":97263},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2872":58389,"_25347":58378,"_17690":97265,"_5":17585,"_23966":97231,"_2399":97266},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2872":58390,"_25347":58378,"_17690":97268,"_5":17585,"_23966":97231,"_2399":97269},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2872":58391,"_25347":58378,"_17690":97271,"_5":17585,"_23966":97235,"_2399":97272},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2872":58392,"_25347":58378,"_17690":97274,"_5":17585,"_23966":97235,"_2399":97275},[],"Defínelo únicamente cuando:",{"_2872":58393,"_25347":58378,"_17690":97277,"_5":17585,"_23966":97235,"_2399":97278},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2872":58394,"_25347":58378,"_17690":97280,"_5":17585,"_23966":97235,"_2399":97281},[],"esa dirección está asignada a este Gateway",{"_2872":58395,"_25347":58378,"_17690":97283,"_5":17585,"_23966":97235,"_2399":97284},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2872":58396,"_25347":58378,"_17690":97286,"_5":17585,"_23966":97235,"_2399":97287},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2872":58397,"_25347":58378,"_17690":97289,"_5":17585,"_23966":97235,"_2399":97290},[],"No confundas estos valores:",{"_2872":58398,"_25347":58378,"_17690":97292,"_5":17585,"_23966":97235,"_2399":97293},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2872":58399,"_25347":58378,"_17690":97295,"_5":17585,"_23966":97235,"_2399":97296},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2872":58400,"_25347":58378,"_17690":97298,"_5":17585,"_23966":97235,"_2399":97299},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2872":58401,"_25347":58378,"_17690":97301,"_5":17585,"_23966":97239,"_2399":97302},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2872":58402,"_25347":58378,"_17690":97304,"_5":17585,"_23966":97239,"_2399":97305},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2872":58403,"_25347":58378,"_17690":97307,"_5":17585,"_23966":97243,"_2399":97308},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2872":58404,"_25347":58378,"_17690":97310,"_5":17585,"_23966":97243,"_2399":97311},[],"Para el diseño recomendado:",{"_2872":58405,"_25347":58378,"_17690":97313,"_5":17585,"_23966":97243,"_2399":97314},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2872":58406,"_25347":58378,"_17690":97316,"_5":17585,"_23966":97243,"_2399":97317},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2872":58407,"_25347":58378,"_17690":97319,"_5":17585,"_23966":97243,"_2399":97320},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2872":58408,"_25347":58378,"_17690":97322,"_5":17585,"_23966":97243,"_2399":97323},[],"Apunta DNS a la dirección accesible de la VM.",{"_2872":58409,"_25347":58378,"_17690":97325,"_5":17585,"_23966":97243,"_2399":97326},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2872":58410,"_25347":58378,"_17690":97328,"_5":17585,"_23966":97246,"_2399":97329},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2872":58411,"_25347":58378,"_17690":97331,"_5":17585,"_23966":97250,"_2399":97332},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2872":58412,"_25347":58378,"_17690":97334,"_5":17585,"_23966":97250,"_2399":97335},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2872":58413,"_25347":58378,"_17690":97337,"_5":17585,"_23966":97254,"_2399":97338},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2872":58414,"_25347":58378,"_17690":97340,"_5":17585,"_23966":97254,"_2399":97341},[],"Requisito",{"_2872":58415,"_25347":58378,"_17690":97343,"_5":17585,"_23966":97254,"_2399":97344},[],"Diseño recomendado",{"_2872":58416,"_25347":58378,"_17690":97346,"_5":17585,"_23966":97254,"_2399":97347},[],"Consecuencia",{"_2872":58417,"_25347":58378,"_17690":97349,"_5":17585,"_23966":97254,"_2399":97350},[],"Varias URL o servicios de Lamassu",{"_2872":58418,"_25347":58378,"_17690":97352,"_5":17585,"_23966":97254,"_2399":97353},[],"Un Gateway con varias rutas",{"_2872":58419,"_25347":58378,"_17690":97355,"_5":17585,"_23966":97254,"_2399":97356},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2872":58420,"_25347":58378,"_17690":97358,"_5":17585,"_23966":97254,"_2399":97359},[],"Gateways independientes e IP externas distintas",{"_2872":58421,"_25347":58378,"_17690":97361,"_5":17585,"_23966":97254,"_2399":97362},[],"Una VIP por Gateway",{"_2872":58422,"_25347":58378,"_17690":97364,"_5":17585,"_23966":97254,"_2399":97365},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2872":58423,"_25347":58378,"_17690":97367,"_5":17585,"_23966":97254,"_2399":97368},[],"Gateways independientes, un nodo y una IP",{"_2872":58424,"_25347":58378,"_17690":97370,"_5":17585,"_23966":97254,"_2399":97371},[],"Puertos externos diferentes",{"_2872":58425,"_25347":58378,"_17690":97373,"_5":17585,"_23966":97254,"_2399":97374},[],"Los clientes deben indicar puertos no estándar",{"_2872":58426,"_25347":58378,"_17690":97376,"_5":17585,"_23966":97254,"_2399":97377},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2872":58427,"_25347":58378,"_17690":97379,"_5":17585,"_23966":97254,"_2399":97380},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2872":58428,"_25347":58378,"_17690":97382,"_5":17585,"_23966":97254,"_2399":97383},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2872":58429,"_25347":58378,"_17690":97385,"_5":17585,"_23966":97254,"_2399":97386},[],"Recursos Gateway separados pero proxy compartido",{"_2872":58430,"_25347":58378,"_17690":97388,"_5":17585,"_23966":97254,"_2399":97389},[],"Modo merged Gateway de Envoy",{"_2872":58431,"_25347":58378,"_17690":97391,"_5":17585,"_23966":97254,"_2399":97392},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2872":58432,"_25347":58378,"_17690":97394,"_5":17585,"_23966":97254,"_2399":97395},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2872":58433,"_25347":58378,"_17690":97397,"_5":17585,"_23966":97254,"_2399":97398},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2872":58434,"_25347":58378,"_17690":97400,"_5":17585,"_23966":97254,"_2399":97401},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2872":58435,"_25347":58378,"_17690":97403,"_5":17585,"_23966":97254,"_2399":97404},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2872":58436,"_25347":58378,"_17690":97406,"_5":17585,"_23966":97258,"_2399":97407},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2872":58437,"_25347":58378,"_17690":97409,"_5":17585,"_23966":97258,"_2399":97410},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2872":58438,"_25347":58378,"_17690":97412,"_5":17585,"_23966":97258,"_2399":97413},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2872":58439,"_25347":58378,"_17690":97415,"_5":17585,"_23966":97258,"_2399":97416},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2872":58440,"_25347":58378,"_17690":97418,"_5":17585,"_23966":97258,"_2399":97419},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2872":58441,"_25347":58378,"_17690":97421,"_5":17585,"_23966":97262,"_2399":97422},[],"Comprueba, en orden:",{"_2872":58442,"_25347":58378,"_17690":97424,"_5":17585,"_23966":97262,"_2399":97425},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2872":58443,"_25347":58378,"_17690":97427,"_5":17585,"_23966":97262,"_2399":97428},[],"Su estado contiene la dirección esperada.",{"_2872":58444,"_25347":58378,"_17690":97430,"_5":17585,"_23966":97262,"_2399":97431},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2872":58445,"_25347":58378,"_17690":97433,"_5":17585,"_23966":97262,"_2399":97434},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2872":58446,"_25347":58378,"_17690":97436,"_5":17585,"_23966":97262,"_2399":97437},[],"DNS resuelve al endpoint accesible externamente.",{"_2872":58447,"_25347":58378,"_17690":97439,"_5":17585,"_23966":97262,"_2399":97440},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2872":58448,"_25347":58378,"_17690":97442,"_5":17585,"_23966":97262,"_2399":97443},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2872":58449,"_25347":58449,"_5":12438,"_2399":41211,"_25683":97445,"_17690":97446,"_23966":58449},[41104,96503,96737],[],{"_2872":58450,"_25347":58449,"_17690":97448,"_5":17585,"_23966":58449,"_2399":97449},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2872":58451,"_25347":58449,"_5":25680,"_17690":97451,"_23966":97452,"_2399":97453},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2872":58452,"_25347":58449,"_5":25680,"_17690":97455,"_23966":97456,"_2399":97457},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2872":58453,"_25347":58449,"_5":25680,"_17690":97459,"_23966":97460,"_2399":97461},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2872":58454,"_25347":58449,"_5":25680,"_17690":97463,"_23966":97464,"_2399":97465},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2872":58455,"_25347":58449,"_5":25680,"_17690":97467,"_23966":97468,"_2399":97469},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2872":58456,"_25347":58449,"_5":25680,"_17690":97471,"_23966":97472,"_2399":97473},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2872":58457,"_25347":58449,"_17690":97475,"_5":17585,"_23966":97452,"_2399":97476},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2872":58458,"_25347":58449,"_17690":97478,"_5":17585,"_23966":97456,"_2399":97479},[],"Flujo",{"_2872":58459,"_25347":58449,"_17690":97481,"_5":17585,"_23966":97456,"_2399":97482},[],"Úsalo para",{"_2872":58460,"_25347":58449,"_17690":97484,"_5":17585,"_23966":97456,"_2399":97485},[],"Qué instala",{"_2872":58461,"_25347":58449,"_17690":97487,"_5":17585,"_23966":97456,"_2399":42123},[],{"_2872":58462,"_25347":58449,"_17690":97489,"_5":17585,"_23966":97456,"_2399":97490},[],"Producción y entornos controlados",{"_2872":58463,"_25347":58449,"_17690":97492,"_5":17585,"_23966":97456,"_2399":97493},[],"Servicios de Lamassu y recursos de Gateway API",{"_2872":58464,"_25347":58449,"_17690":97495,"_5":17585,"_23966":97456,"_2399":41348},[],{"_2872":58465,"_25347":58449,"_17690":97497,"_5":17585,"_23966":97456,"_2399":97498},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2872":58466,"_25347":58449,"_17690":97500,"_5":17585,"_23966":97456,"_2399":97501},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2872":58467,"_25347":58449,"_17690":97503,"_5":17585,"_23966":97460,"_2399":97504},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2872":58468,"_25347":58449,"_17690":97506,"_5":17585,"_23966":97460,"_2399":97507},[],"Área",{"_2872":58469,"_25347":58449,"_17690":97509,"_5":17585,"_23966":97460,"_2399":97510},[],"El chart de Lamassu proporciona",{"_2872":58470,"_25347":58449,"_17690":97512,"_5":17585,"_23966":97460,"_2399":97513},[],"Tú proporcionas",{"_2872":58471,"_25347":58449,"_17690":97515,"_5":17585,"_23966":97460,"_2399":97516},[],"Aplicaciones Lamassu",{"_2872":58472,"_25347":58449,"_17690":97518,"_5":17585,"_23966":97460,"_2399":97519},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2872":58473,"_25347":58449,"_17690":97521,"_5":17585,"_23966":97460,"_2399":97522},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2872":58474,"_25347":58449,"_17690":97524,"_5":17585,"_23966":97460,"_2399":97525},[],"Datos PostgreSQL",{"_2872":58475,"_25347":58449,"_17690":97527,"_5":17585,"_23966":97460,"_2399":97528},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2872":58476,"_25347":58449,"_17690":97530,"_5":17585,"_23966":97460,"_2399":97531},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2872":58477,"_25347":58449,"_17690":97533,"_5":17585,"_23966":97460,"_2399":97534},[],"Mensajería",{"_2872":58478,"_25347":58449,"_17690":97536,"_5":17585,"_23966":97460,"_2399":97537},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS con una CA privada y un certificado de cliente opcional, definidos mediante valores del chart",{"_2872":58479,"_25347":58449,"_17690":97539,"_5":17585,"_23966":97460,"_2399":97540},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2872":58480,"_25347":58449,"_17690":97542,"_5":17585,"_23966":97460,"_2399":97543},[],"Identidad",{"_2872":58481,"_25347":58449,"_17690":97545,"_5":17585,"_23966":97460,"_2399":97546},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2872":58482,"_25347":58449,"_17690":97548,"_5":17585,"_23966":97460,"_2399":97549},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2872":58483,"_25347":58449,"_17690":97551,"_5":17585,"_23966":97460,"_2399":97552},[],"Enrutamiento externo",{"_2872":58484,"_25347":58449,"_17690":97554,"_5":17585,"_23966":97460,"_2399":97555},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2872":58485,"_25347":58449,"_17690":97557,"_5":17585,"_23966":97460,"_2399":97558},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2872":58486,"_25347":58449,"_17690":97560,"_5":17585,"_23966":97460,"_2399":42197},[],{"_2872":58487,"_25347":58449,"_17690":97562,"_5":17585,"_23966":97460,"_2399":97563},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2872":58488,"_25347":58449,"_17690":97565,"_5":17585,"_23966":97460,"_2399":97566},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2872":58489,"_25347":58449,"_17690":97568,"_5":17585,"_23966":97460,"_2399":97569},[],"Datos persistentes de la aplicación",{"_2872":58490,"_25347":58449,"_17690":97571,"_5":17585,"_23966":97460,"_2399":97572},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2872":58491,"_25347":58449,"_17690":97574,"_5":17585,"_23966":97460,"_2399":97575},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2872":58492,"_25347":58449,"_17690":97577,"_5":17585,"_23966":97460,"_2399":97578},[],"Integraciones opcionales",{"_2872":58493,"_25347":58449,"_17690":97580,"_5":17585,"_23966":97460,"_2399":97581},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2872":58494,"_25347":58449,"_17690":97583,"_5":17585,"_23966":97460,"_2399":97584},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2872":58495,"_25347":58449,"_17690":97586,"_5":17585,"_23966":97460,"_2399":97587},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2872":58496,"_25347":58449,"_17690":97589,"_5":17585,"_23966":97460,"_2399":97590},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2872":58497,"_25347":58449,"_17690":97592,"_5":17585,"_23966":97464,"_2399":97593},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2872":58498,"_25347":58449,"_17690":97595,"_5":17585,"_23966":97464,"_2399":97596},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2872":58499,"_25347":58449,"_17690":97598,"_5":17585,"_23966":97468,"_2399":97599},[],"Kubernetes 1.24 o posterior",{"_2872":58500,"_25347":58449,"_17690":97601,"_5":17585,"_23966":97468,"_2399":97602},[],"Helm 3.2 o posterior",{"_2872":58501,"_25347":58449,"_17690":97604,"_5":17585,"_23966":97468,"_2399":97605},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2872":58502,"_25347":58449,"_17690":97607,"_5":17585,"_23966":97468,"_2399":97608},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2872":58503,"_25347":58449,"_17690":97610,"_5":17585,"_23966":97468,"_2399":97611},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2872":58504,"_25347":58449,"_17690":97613,"_5":17585,"_23966":97468,"_2399":97614},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2872":58505,"_25347":58449,"_17690":97616,"_5":17585,"_23966":97468,"_2399":97617},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2872":58506,"_25347":58449,"_17690":97619,"_5":17585,"_23966":97472,"_2399":97620},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2872":58507,"_25347":58449,"_17690":97622,"_5":17585,"_23966":97472,"_2399":97623},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2872":58508,"_25347":58449,"_17690":97625,"_5":17585,"_23966":97472,"_2399":97626},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2872":58509,"_25347":58509,"_5":12438,"_2399":97628,"_25683":97629,"_17690":97631,"_23966":58509},"Resolución de problemas de despliegue",[41104,96503,97630],"Operación",[],{"_2872":58510,"_25347":58509,"_17690":97633,"_5":17585,"_23966":58509,"_2399":97634},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2872":58511,"_25347":58509,"_5":25680,"_17690":97636,"_23966":97637,"_2399":97638},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2872":58512,"_25347":58509,"_5":25680,"_17690":97640,"_23966":97641,"_2399":97642},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2872":58513,"_25347":58509,"_5":25680,"_17690":97644,"_23966":97645,"_2399":97646},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2872":58514,"_25347":58509,"_5":25680,"_17690":97648,"_23966":97649,"_2399":97650},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2872":58515,"_25347":58509,"_5":25680,"_17690":97652,"_23966":97653,"_2399":97654},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2872":58516,"_25347":58509,"_5":25680,"_17690":97656,"_23966":97657,"_2399":97658},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2872":58517,"_25347":58509,"_5":25680,"_17690":97660,"_23966":97661,"_2399":97662},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2872":58518,"_25347":58509,"_5":25680,"_17690":97664,"_23966":97665,"_2399":97666},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2872":58519,"_25347":58509,"_5":25680,"_17690":97668,"_23966":97669,"_2399":97670},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2872":58520,"_25347":58509,"_5":25680,"_17690":97672,"_23966":97673,"_2399":97674},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2872":58521,"_25347":58509,"_5":25680,"_17690":97676,"_23966":97677,"_2399":97678},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2872":58522,"_25347":58509,"_5":25680,"_17690":97680,"_23966":97681,"_2399":97682},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2872":58523,"_25347":58509,"_17690":97684,"_5":17585,"_23966":58509,"_2399":97685},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2872":58524,"_25347":58509,"_17690":97687,"_5":17585,"_23966":97641,"_2399":97688},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2872":58525,"_25347":58509,"_17690":97690,"_5":17585,"_23966":97645,"_2399":97691},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2872":58526,"_25347":58509,"_17690":97693,"_5":17585,"_23966":97649,"_2399":97694},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2872":58527,"_25347":58509,"_17690":97696,"_5":17585,"_23966":97653,"_2399":97697},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2872":58528,"_25347":58509,"_17690":97699,"_5":17585,"_23966":97657,"_2399":97700},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2872":58529,"_25347":58509,"_17690":97702,"_5":17585,"_23966":97661,"_2399":97703},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2872":58530,"_25347":58509,"_17690":97705,"_5":17585,"_23966":97661,"_2399":97706},[],"Ejecuta también la prueba de conectividad del chart:",{"_2872":58531,"_25347":58509,"_17690":97708,"_5":17585,"_23966":97661,"_2399":97709},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2872":58532,"_25347":58509,"_17690":97711,"_5":17585,"_23966":97661,"_2399":97712},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2872":58533,"_25347":58509,"_17690":97714,"_5":17585,"_23966":97665,"_2399":97715},[],"Si recibes un 401:",{"_2872":58534,"_25347":58509,"_17690":97717,"_5":17585,"_23966":97665,"_2399":97718},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2872":58535,"_25347":58509,"_17690":97720,"_5":17585,"_23966":97665,"_2399":97721},[],"verifica emisor, audiencia y expiración del token;",{"_2872":58536,"_25347":58509,"_17690":97723,"_5":17585,"_23966":97665,"_2399":97724},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2872":58537,"_25347":58509,"_17690":97726,"_5":17585,"_23966":97665,"_2399":97727},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2872":58538,"_25347":58509,"_17690":97729,"_5":17585,"_23966":97665,"_2399":97730},[],"Si el login termina pero las APIs devuelven 403:",{"_2872":58539,"_25347":58509,"_17690":97732,"_5":17585,"_23966":97665,"_2399":97733},[],"inspecciona los claims reales del token;",{"_2872":58540,"_25347":58509,"_17690":97735,"_5":17585,"_23966":97665,"_2399":97736},[],"confirma que coinciden con un principal activo;",{"_2872":58541,"_25347":58509,"_17690":97738,"_5":17585,"_23966":97665,"_2399":97739},[],"revisa las políticas concedidas al principal;",{"_2872":58542,"_25347":58509,"_17690":97741,"_5":17585,"_23966":97665,"_2399":97742},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2872":58543,"_25347":58509,"_17690":97744,"_5":17585,"_23966":97665,"_2399":97745},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2872":58544,"_25347":58509,"_17690":97747,"_5":17585,"_23966":97669,"_2399":97748},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2872":58545,"_25347":58509,"_17690":97750,"_5":17585,"_23966":97669,"_2399":97751},[],"Localiza el pod y Service de authz.",{"_2872":58546,"_25347":58509,"_17690":97753,"_5":17585,"_23966":97669,"_2399":97754},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2872":58547,"_25347":58509,"_17690":97756,"_5":17585,"_23966":97669,"_2399":97757},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2872":58548,"_25347":58509,"_17690":97759,"_5":17585,"_23966":97669,"_2399":97760},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2872":58549,"_25347":58509,"_17690":97762,"_5":17585,"_23966":97669,"_2399":97763},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2872":58550,"_25347":58509,"_17690":97765,"_5":17585,"_23966":97673,"_2399":97766},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2872":58551,"_25347":58509,"_17690":97768,"_5":17585,"_23966":97673,"_2399":97769},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2872":58552,"_25347":58509,"_17690":97771,"_5":17585,"_23966":97673,"_2399":97772},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_2872":58553,"_25347":58509,"_17690":97774,"_5":17585,"_23966":97673,"_2399":97775},[],"volumen persistente sin enlazar;",{"_2872":58554,"_25347":58509,"_17690":97777,"_5":17585,"_23966":97673,"_2399":97778},[],"imagen inaccesible o política de pull incorrecta;",{"_2872":58555,"_25347":58509,"_17690":97780,"_5":17585,"_23966":97673,"_2399":97781},[],"configuración inválida del motor criptográfico;",{"_2872":58556,"_25347":58509,"_17690":97783,"_5":17585,"_23966":97673,"_2399":97784},[],"límites de CPU o memoria demasiado bajos;",{"_2872":58557,"_25347":58509,"_17690":97786,"_5":17585,"_23966":97673,"_2399":97787},[],"migración previa incompleta.",{"_2872":58558,"_25347":58509,"_17690":97789,"_5":17585,"_23966":97673,"_2399":97790},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2872":58559,"_25347":58509,"_17690":97792,"_5":17585,"_23966":97673,"_2399":97793},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2872":58560,"_25347":58509,"_17690":97795,"_5":17585,"_23966":97677,"_2399":97796},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2872":58561,"_25347":58509,"_17690":97798,"_5":17585,"_23966":97677,"_2399":97799},[],"verifica que esté habilitado en el servicio emisor;",{"_2872":58562,"_25347":58509,"_17690":97801,"_5":17585,"_23966":97677,"_2399":97802},[],"comprueba conectividad y credenciales AMQP;",{"_2872":58563,"_25347":58509,"_17690":97804,"_5":17585,"_23966":97677,"_2399":97805},[],"revisa exchange, routing key, colas y consumidores;",{"_2872":58564,"_25347":58509,"_17690":97807,"_5":17585,"_23966":97677,"_2399":97808},[],"inspecciona dead-letter queues;",{"_2872":58565,"_25347":58509,"_17690":97810,"_5":17585,"_23966":97677,"_2399":97811},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2872":58566,"_25347":58509,"_17690":97813,"_5":17585,"_23966":97677,"_2399":97814},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_2872":58567,"_25347":58509,"_17690":97816,"_5":17585,"_23966":97677,"_2399":97817},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_2872":58568,"_25347":58509,"_17690":97819,"_5":17585,"_23966":97677,"_2399":97820},[],"confirma que el Secret de la CA exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey`;",{"_2872":58569,"_25347":58509,"_17690":97822,"_5":17585,"_23966":97677,"_2399":97823},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_2872":58570,"_25347":58509,"_17690":97825,"_5":17585,"_23966":97677,"_2399":97826},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_2872":58571,"_25347":58509,"_17690":97828,"_5":17585,"_23966":97677,"_2399":97829},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_2872":58572,"_25347":58509,"_17690":97831,"_5":17585,"_23966":97677,"_2399":97832},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2872":58573,"_25347":58509,"_17690":97834,"_5":17585,"_23966":97681,"_2399":97835},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2872":58574,"_25347":58509,"_17690":97837,"_5":17585,"_23966":97681,"_2399":97838},[],"Antes de cerrar una incidencia, guarda:",{"_2872":58575,"_25347":58509,"_17690":97840,"_5":17585,"_23966":97681,"_2399":97841},[],"causa confirmada;",{"_2872":58576,"_25347":58509,"_17690":97843,"_5":17585,"_23966":97681,"_2399":97844},[],"alcance temporal y recursos afectados;",{"_2872":58577,"_25347":58509,"_17690":97846,"_5":17585,"_23966":97681,"_2399":97847},[],"comandos o consultas utilizados;",{"_2872":58578,"_25347":58509,"_17690":97849,"_5":17585,"_23966":97681,"_2399":97850},[],"cambio aplicado y forma de revertirlo;",{"_2872":58579,"_25347":58509,"_17690":97852,"_5":17585,"_23966":97681,"_2399":97853},[],"validación desde un consumidor;",{"_2872":58580,"_25347":58509,"_17690":97855,"_5":17585,"_23966":97681,"_2399":97856},[],"acción preventiva y propietario.",{"_2872":58581,"_25347":58581,"_5":12438,"_2399":97858,"_25683":97859,"_17690":97862,"_23966":58581},"Control de acceso",[41104,97860,97861],"Plataforma","Administración",[],{"_2872":58582,"_25347":58581,"_17690":97864,"_5":17585,"_23966":58581,"_2399":97865},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2872":58583,"_25347":58581,"_5":25680,"_17690":97867,"_23966":97868,"_2399":97869},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2872":58584,"_25347":58581,"_5":25680,"_17690":97871,"_23966":97872,"_2399":97873},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2872":58585,"_25347":58581,"_5":25680,"_17690":97875,"_23966":97876,"_2399":97877},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2872":58586,"_25347":58581,"_5":25680,"_17690":97879,"_23966":97880,"_2399":97881},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2872":58587,"_25347":58581,"_5":25680,"_17690":97883,"_23966":97884,"_2399":97885},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2872":58588,"_25347":58581,"_5":25680,"_17690":97887,"_23966":97888,"_2399":97889},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2872":58589,"_25347":58581,"_5":25680,"_17690":97891,"_23966":97892,"_2399":97893},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2872":58590,"_25347":58581,"_5":25680,"_17690":97895,"_23966":97896,"_2399":97897},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2872":58591,"_25347":58581,"_5":25680,"_17690":97899,"_23966":97900,"_2399":97901},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2872":58592,"_25347":58581,"_5":25680,"_17690":97903,"_23966":97904,"_2399":97905},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2872":58593,"_25347":58581,"_5":25680,"_17690":97907,"_23966":97908,"_2399":97909},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2872":58594,"_25347":58581,"_5":25680,"_17690":97911,"_23966":97912,"_2399":97913},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2872":58595,"_25347":58581,"_5":25680,"_17690":97915,"_23966":97916,"_2399":97917},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2872":58596,"_25347":58581,"_5":25680,"_17690":97919,"_23966":97920,"_2399":97921},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2872":58597,"_25347":58581,"_5":25680,"_17690":97923,"_23966":97924,"_2399":97925},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2872":58598,"_25347":58581,"_5":25680,"_17690":97927,"_23966":97928,"_2399":97077},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2872":58599,"_25347":58581,"_5":25680,"_17690":97930,"_23966":97931,"_2399":97932},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2872":58600,"_25347":58581,"_5":25680,"_17690":97934,"_23966":97935,"_2399":97936},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2872":58601,"_25347":58581,"_5":25680,"_17690":97938,"_23966":97939,"_2399":97940},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2872":58602,"_25347":58581,"_5":25680,"_17690":97942,"_23966":97943,"_2399":97944},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2872":58603,"_25347":58581,"_5":25680,"_17690":97946,"_23966":97947,"_2399":97948},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2872":58604,"_25347":58581,"_5":25680,"_17690":97950,"_23966":97951,"_2399":97952},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2872":58605,"_25347":58581,"_5":25680,"_17690":97954,"_23966":97955,"_2399":97956},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2872":58606,"_25347":58581,"_5":25680,"_17690":97958,"_23966":97959,"_2399":97960},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2872":58607,"_25347":58581,"_5":25680,"_17690":97962,"_23966":97963,"_2399":97964},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2872":58608,"_25347":58581,"_5":25680,"_17690":97966,"_23966":97967,"_2399":97968},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2872":58609,"_25347":58581,"_5":25680,"_17690":97970,"_23966":97971,"_2399":97972},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2872":58610,"_25347":58581,"_5":25680,"_17690":97974,"_23966":97975,"_2399":97976},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2872":58611,"_25347":58581,"_5":25680,"_17690":97978,"_23966":97979,"_2399":97980},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2872":58612,"_25347":58581,"_5":25680,"_17690":97982,"_23966":97983,"_2399":97984},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2872":58613,"_25347":58581,"_5":25680,"_17690":97986,"_23966":97987,"_2399":97988},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2872":58614,"_25347":58581,"_17690":97990,"_5":17585,"_23966":58581,"_2399":97991},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2872":58615,"_25347":58581,"_17690":97993,"_5":17585,"_23966":58581,"_2399":97994},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2872":58616,"_25347":58581,"_17690":97996,"_5":17585,"_23966":58581,"_2399":97997},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2872":58617,"_25347":58581,"_17690":97999,"_5":17585,"_23966":97868,"_2399":98000},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2872":58618,"_25347":58581,"_17690":98002,"_5":17585,"_23966":97868,"_2399":98003},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2872":58619,"_25347":58581,"_17690":98005,"_5":17585,"_23966":97868,"_2399":98006},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2872":58620,"_25347":58581,"_17690":98008,"_5":17585,"_23966":97868,"_2399":98009},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2872":58621,"_25347":58581,"_17690":98011,"_5":17585,"_23966":97868,"_2399":98012},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2872":58622,"_25347":58581,"_17690":98014,"_5":17585,"_23966":97868,"_2399":98015},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2872":58623,"_25347":58581,"_17690":98017,"_5":17585,"_23966":97872,"_2399":98018},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2872":58624,"_25347":58581,"_17690":98020,"_5":17585,"_23966":97872,"_2399":98021},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2872":58625,"_25347":58581,"_17690":98023,"_5":17585,"_23966":97876,"_2399":98024},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2872":58626,"_25347":58581,"_17690":98026,"_5":17585,"_23966":97876,"_2399":98027},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2872":58627,"_25347":58581,"_17690":98029,"_5":17585,"_23966":97876,"_2399":98030},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2872":58628,"_25347":58581,"_17690":98032,"_5":17585,"_23966":97876,"_2399":98033},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2872":58629,"_25347":58581,"_17690":98035,"_5":17585,"_23966":97876,"_2399":98036},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2872":58630,"_25347":58581,"_17690":98038,"_5":17585,"_23966":97876,"_2399":98039},[],"Carga por separado las políticas concedidas a cada principal.",{"_2872":58631,"_25347":58581,"_17690":98041,"_5":17585,"_23966":97876,"_2399":98042},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2872":58632,"_25347":58581,"_17690":98044,"_5":17585,"_23966":97876,"_2399":98045},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2872":58633,"_25347":58581,"_17690":98047,"_5":17585,"_23966":97876,"_2399":98048},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2872":58634,"_25347":58581,"_17690":98050,"_5":17585,"_23966":97876,"_2399":98051},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2872":58635,"_25347":58581,"_17690":98053,"_5":17585,"_23966":97876,"_2399":98054},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2872":58636,"_25347":58581,"_17690":98056,"_5":17585,"_23966":97876,"_2399":98057},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2872":58637,"_25347":58581,"_17690":98059,"_5":17585,"_23966":97880,"_2399":98060},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2872":58638,"_25347":58581,"_17690":98062,"_5":17585,"_23966":97880,"_2399":98063},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2872":58639,"_25347":58581,"_17690":98065,"_5":17585,"_23966":97880,"_2399":98066},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2872":58640,"_25347":58581,"_17690":98068,"_5":17585,"_23966":97880,"_2399":98069},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2872":58641,"_25347":58581,"_17690":98071,"_5":17585,"_23966":97880,"_2399":98072},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2872":58642,"_25347":58581,"_17690":98074,"_5":17585,"_23966":97880,"_2399":98075},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2872":58643,"_25347":58581,"_17690":98077,"_5":17585,"_23966":97880,"_2399":98078},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2872":58644,"_25347":58581,"_17690":98080,"_5":17585,"_23966":97880,"_2399":98081},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2872":58645,"_25347":58581,"_17690":98083,"_5":17585,"_23966":97884,"_2399":98084},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2872":58646,"_25347":58581,"_17690":98086,"_5":17585,"_23966":97884,"_2399":98087},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2872":58647,"_25347":58581,"_17690":98089,"_5":17585,"_23966":97884,"_2399":98090},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2872":58648,"_25347":58581,"_17690":98092,"_5":17585,"_23966":97884,"_2399":98093},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2872":58649,"_25347":58581,"_17690":98095,"_5":17585,"_23966":97884,"_2399":98096},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2872":58650,"_25347":58581,"_17690":98098,"_5":17585,"_23966":97884,"_2399":98099},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2872":58651,"_25347":58581,"_17690":98101,"_5":17585,"_23966":97884,"_2399":98102},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2872":58652,"_25347":58581,"_17690":98104,"_5":17585,"_23966":97884,"_2399":98105},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2872":58653,"_25347":58581,"_17690":98107,"_5":17585,"_23966":97884,"_2399":98108},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2872":58654,"_25347":58581,"_17690":98110,"_5":17585,"_23966":97884,"_2399":98111},[],"Las acciones se dividen en dos grupos:",{"_2872":58655,"_25347":58581,"_17690":98113,"_5":17585,"_23966":97884,"_2399":98114},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2872":58656,"_25347":58581,"_17690":98116,"_5":17585,"_23966":97884,"_2399":98117},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2872":58657,"_25347":58581,"_17690":98119,"_5":17585,"_23966":97884,"_2399":98120},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2872":58658,"_25347":58581,"_17690":98122,"_5":17585,"_23966":97888,"_2399":98123},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2872":58659,"_25347":58581,"_17690":98125,"_5":17585,"_23966":97888,"_2399":98126},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2872":58660,"_25347":58581,"_17690":98128,"_5":17585,"_23966":97888,"_2399":98129},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2872":58661,"_25347":58581,"_17690":98131,"_5":17585,"_23966":97892,"_2399":98132},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2872":58662,"_25347":58581,"_17690":98134,"_5":17585,"_23966":97892,"_2399":98135},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2872":58663,"_25347":58581,"_17690":98137,"_5":17585,"_23966":97892,"_2399":98138},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2872":58664,"_25347":58581,"_17690":98140,"_5":17585,"_23966":97892,"_2399":98141},[],"Los operadores implementados son:",{"_2872":58665,"_25347":58581,"_17690":98143,"_5":17585,"_23966":97892,"_2399":98144},[],"`equals`, para igualdad exacta;",{"_2872":58666,"_25347":58581,"_17690":98146,"_5":17585,"_23966":97892,"_2399":98147},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2872":58667,"_25347":58581,"_17690":98149,"_5":17585,"_23966":97892,"_2399":98150},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2872":58668,"_25347":58581,"_17690":98152,"_5":17585,"_23966":97892,"_2399":98153},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2872":58669,"_25347":58581,"_17690":98155,"_5":17585,"_23966":97896,"_2399":98156},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2872":58670,"_25347":58581,"_17690":98158,"_5":17585,"_23966":97896,"_2399":98159},[],"Los modos disponibles son:",{"_2872":58671,"_25347":58581,"_17690":98161,"_5":17585,"_23966":97896,"_2399":98162},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2872":58672,"_25347":58581,"_17690":98164,"_5":17585,"_23966":97896,"_2399":98165},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2872":58673,"_25347":58581,"_17690":98167,"_5":17585,"_23966":97896,"_2399":98168},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2872":58674,"_25347":58581,"_17690":98170,"_5":17585,"_23966":97896,"_2399":98171},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2872":58675,"_25347":58581,"_17690":98173,"_5":17585,"_23966":97896,"_2399":98174},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2872":58676,"_25347":58581,"_17690":98176,"_5":17585,"_23966":97896,"_2399":98177},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2872":58677,"_25347":58581,"_17690":98179,"_5":17585,"_23966":97900,"_2399":98180},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2872":58678,"_25347":58581,"_17690":98182,"_5":17585,"_23966":97900,"_2399":98183},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2872":58679,"_25347":58581,"_17690":98185,"_5":17585,"_23966":97900,"_2399":98186},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2872":58680,"_25347":58581,"_17690":98188,"_5":17585,"_23966":97900,"_2399":98189},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2872":58681,"_25347":58581,"_17690":98191,"_5":17585,"_23966":97908,"_2399":98192},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2872":58682,"_25347":58581,"_17690":98194,"_5":17585,"_23966":97908,"_2399":98195},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2872":58683,"_25347":58581,"_17690":98197,"_5":17585,"_23966":97912,"_2399":98198},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2872":58684,"_25347":58581,"_17690":98200,"_5":17585,"_23966":97912,"_2399":98201},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2872":58685,"_25347":58581,"_17690":98203,"_5":17585,"_23966":97916,"_2399":98204},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2872":58686,"_25347":58581,"_17690":98206,"_5":17585,"_23966":97916,"_2399":98207},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2872":58687,"_25347":58581,"_17690":98209,"_5":17585,"_23966":97916,"_2399":98210},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2872":58688,"_25347":58581,"_17690":98212,"_5":17585,"_23966":97920,"_2399":98213},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2872":58689,"_25347":58581,"_17690":98215,"_5":17585,"_23966":97920,"_2399":98216},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2872":58690,"_25347":58581,"_17690":98218,"_5":17585,"_23966":97920,"_2399":98219},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2872":58691,"_25347":58581,"_17690":98221,"_5":17585,"_23966":97920,"_2399":98222},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2872":58692,"_25347":58581,"_17690":98224,"_5":17585,"_23966":97920,"_2399":98225},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2872":58693,"_25347":58581,"_17690":98227,"_5":17585,"_23966":97920,"_2399":98228},[],"Ten en cuenta que:",{"_2872":58694,"_25347":58581,"_17690":98230,"_5":17585,"_23966":97920,"_2399":98231},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2872":58695,"_25347":58581,"_17690":98233,"_5":17585,"_23966":97920,"_2399":98234},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2872":58696,"_25347":58581,"_17690":98236,"_5":17585,"_23966":97920,"_2399":98237},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2872":58697,"_25347":58581,"_17690":98239,"_5":17585,"_23966":97924,"_2399":98240},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2872":58698,"_25347":58581,"_17690":98242,"_5":17585,"_23966":97924,"_2399":98243},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2872":58699,"_25347":58581,"_17690":98245,"_5":17585,"_23966":97924,"_2399":98246},[],"acceso completo y de solo lectura a KMS;",{"_2872":58700,"_25347":58581,"_17690":98248,"_5":17585,"_23966":97924,"_2399":98249},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2872":58701,"_25347":58581,"_17690":98251,"_5":17585,"_23966":97924,"_2399":98252},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2872":58702,"_25347":58581,"_17690":98254,"_5":17585,"_23966":97924,"_2399":98255},[],"acceso a la interfaz;",{"_2872":58703,"_25347":58581,"_17690":98257,"_5":17585,"_23966":97924,"_2399":98258},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2872":58704,"_25347":58581,"_17690":98260,"_5":17585,"_23966":97924,"_2399":98261},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2872":58705,"_25347":58581,"_17690":98263,"_5":17585,"_23966":97924,"_2399":98264},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2872":58706,"_25347":58581,"_17690":98266,"_5":17585,"_23966":97928,"_2399":98267},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2872":58707,"_25347":58581,"_17690":98269,"_5":17585,"_23966":97928,"_2399":98270},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2872":58708,"_25347":58581,"_17690":98272,"_5":17585,"_23966":97928,"_2399":98273},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2872":58709,"_25347":58581,"_17690":98275,"_5":17585,"_23966":97931,"_2399":98276},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2872":58710,"_25347":58581,"_17690":98278,"_5":17585,"_23966":97935,"_2399":98279},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2872":58711,"_25347":58581,"_17690":98281,"_5":17585,"_23966":97939,"_2399":98282},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2872":58712,"_25347":58581,"_17690":98284,"_5":17585,"_23966":97943,"_2399":98285},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2872":58713,"_25347":58581,"_17690":98287,"_5":17585,"_23966":97947,"_2399":98288},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2872":58714,"_25347":58581,"_17690":98290,"_5":17585,"_23966":97951,"_2399":98291},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2872":58715,"_25347":58581,"_17690":98293,"_5":17585,"_23966":97951,"_2399":98294},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2872":58716,"_25347":58581,"_17690":98296,"_5":17585,"_23966":97955,"_2399":98297},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2872":58717,"_25347":58581,"_17690":98299,"_5":17585,"_23966":97955,"_2399":98300},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2872":58718,"_25347":58581,"_17690":98302,"_5":17585,"_23966":97955,"_2399":98303},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2872":58719,"_25347":58581,"_17690":98305,"_5":17585,"_23966":97955,"_2399":98306},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2872":58720,"_25347":58581,"_17690":98308,"_5":17585,"_23966":97955,"_2399":98309},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2872":58721,"_25347":58581,"_17690":98311,"_5":17585,"_23966":97955,"_2399":98312},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2872":58722,"_25347":58581,"_17690":98314,"_5":17585,"_23966":97955,"_2399":98315},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2872":58723,"_25347":58581,"_17690":98317,"_5":17585,"_23966":97955,"_2399":98318},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2872":58724,"_25347":58581,"_17690":98320,"_5":17585,"_23966":97959,"_2399":98321},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2872":58725,"_25347":58581,"_17690":98323,"_5":17585,"_23966":97959,"_2399":98324},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2872":58726,"_25347":58581,"_17690":98326,"_5":17585,"_23966":97959,"_2399":98327},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2872":58727,"_25347":58581,"_17690":98329,"_5":17585,"_23966":97963,"_2399":98330},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2872":58728,"_25347":58581,"_17690":98332,"_5":17585,"_23966":97963,"_2399":98333},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2872":58729,"_25347":58581,"_17690":98335,"_5":17585,"_23966":97963,"_2399":98336},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2872":58730,"_25347":58581,"_17690":98338,"_5":17585,"_23966":97963,"_2399":98339},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2872":58731,"_25347":58581,"_17690":98341,"_5":17585,"_23966":97963,"_2399":98342},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2872":58732,"_25347":58581,"_17690":98344,"_5":17585,"_23966":97963,"_2399":98345},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2872":58733,"_25347":58581,"_17690":98347,"_5":17585,"_23966":97963,"_2399":98348},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2872":58734,"_25347":58581,"_17690":98350,"_5":17585,"_23966":97963,"_2399":98351},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2872":58735,"_25347":58581,"_17690":98353,"_5":17585,"_23966":97971,"_2399":98354},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2872":58736,"_25347":58581,"_17690":98356,"_5":17585,"_23966":97975,"_2399":98357},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2872":58737,"_25347":58581,"_17690":98359,"_5":17585,"_23966":97975,"_2399":98360},[],"que exista un principal activo del tipo correcto;",{"_2872":58738,"_25347":58581,"_17690":98362,"_5":17585,"_23966":97975,"_2399":98363},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2872":58739,"_25347":58581,"_17690":98365,"_5":17585,"_23966":97975,"_2399":98366},[],"que todas las condiciones del principal se cumplan;",{"_2872":58740,"_25347":58581,"_17690":98368,"_5":17585,"_23966":97975,"_2399":98369},[],"que el principal tenga concedida la política esperada;",{"_2872":58741,"_25347":58581,"_17690":98371,"_5":17585,"_23966":97975,"_2399":98372},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2872":58742,"_25347":58581,"_17690":98374,"_5":17585,"_23966":97975,"_2399":98375},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2872":58743,"_25347":58581,"_17690":98377,"_5":17585,"_23966":97975,"_2399":98378},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2872":58744,"_25347":58581,"_17690":98380,"_5":17585,"_23966":97979,"_2399":98381},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2872":58745,"_25347":58581,"_17690":98383,"_5":17585,"_23966":97983,"_2399":98384},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2872":58746,"_25347":58581,"_17690":98386,"_5":17585,"_23966":97987,"_2399":98387},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2872":58747,"_25347":58581,"_17690":98389,"_5":17585,"_23966":97987,"_2399":98390},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2872":58748,"_25347":58748,"_5":12438,"_2399":98392,"_25683":98393,"_17690":98394,"_23966":58748},"Alertas y suscripciones",[41104,97860,97861],[],{"_2872":58749,"_25347":58748,"_17690":98396,"_5":17585,"_23966":58748,"_2399":98397},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2872":58750,"_25347":58748,"_5":25680,"_17690":98399,"_23966":98400,"_2399":98401},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2872":58751,"_25347":58748,"_5":25680,"_17690":98403,"_23966":98404,"_2399":98405},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2872":58752,"_25347":58748,"_5":25680,"_17690":98407,"_23966":98408,"_2399":98409},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2872":58753,"_25347":58748,"_5":25680,"_17690":98411,"_23966":98412,"_2399":98413},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2872":58754,"_25347":58748,"_5":25680,"_17690":98415,"_23966":98416,"_2399":98417},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2872":58755,"_25347":58748,"_5":25680,"_17690":98419,"_23966":98420,"_2399":98421},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2872":58756,"_25347":58748,"_5":25680,"_17690":98423,"_23966":98424,"_2399":98425},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2872":58757,"_25347":58748,"_5":25680,"_17690":98427,"_23966":98428,"_2399":98429},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2872":58758,"_25347":58748,"_5":25680,"_17690":98431,"_23966":98432,"_2399":98433},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2872":58759,"_25347":58748,"_5":25680,"_17690":98435,"_23966":98436,"_2399":98437},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2872":58760,"_25347":58748,"_17690":98439,"_5":17585,"_23966":58748,"_2399":98440},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2872":58761,"_25347":58748,"_17690":98442,"_5":17585,"_23966":98400,"_2399":98443},[],"Un servicio publica un evento de dominio.",{"_2872":58762,"_25347":58748,"_17690":98445,"_5":17585,"_23966":98400,"_2399":98446},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2872":58763,"_25347":58748,"_17690":98448,"_5":17585,"_23966":98400,"_2399":98449},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2872":58764,"_25347":58748,"_17690":98451,"_5":17585,"_23966":98400,"_2399":98452},[],"Lamassu entrega el evento al canal configurado.",{"_2872":58765,"_25347":58748,"_17690":98454,"_5":17585,"_23966":98400,"_2399":98455},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2872":58766,"_25347":58748,"_17690":98457,"_5":17585,"_23966":98404,"_2399":98458},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2872":58767,"_25347":58748,"_17690":98460,"_5":17585,"_23966":98404,"_2399":98461},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2872":58768,"_25347":58748,"_17690":98463,"_5":17585,"_23966":98404,"_2399":98464},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2872":58769,"_25347":58748,"_17690":98466,"_5":17585,"_23966":98404,"_2399":98467},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2872":58770,"_25347":58748,"_17690":98469,"_5":17585,"_23966":98404,"_2399":98470},[],"`apikey_options` necesita `header` y `key`.",{"_2872":58771,"_25347":58748,"_17690":98472,"_5":17585,"_23966":98404,"_2399":98473},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2872":58772,"_25347":58748,"_17690":98475,"_5":17585,"_23966":98404,"_2399":98476},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2872":58773,"_25347":58748,"_17690":98478,"_5":17585,"_23966":98404,"_2399":98479},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2872":58774,"_25347":58748,"_17690":98481,"_5":17585,"_23966":98412,"_2399":98482},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2872":58775,"_25347":58748,"_17690":98484,"_5":17585,"_23966":98416,"_2399":98485},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2872":58776,"_25347":58748,"_17690":98487,"_5":17585,"_23966":98420,"_2399":98488},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2872":58777,"_25347":58748,"_17690":98490,"_5":17585,"_23966":98420,"_2399":98491},[],"**None** notifica todas las instancias del evento.",{"_2872":58778,"_25347":58748,"_17690":98493,"_5":17585,"_23966":98420,"_2399":98494},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2872":58779,"_25347":58748,"_17690":98496,"_5":17585,"_23966":98420,"_2399":98497},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2872":58780,"_25347":58748,"_17690":98499,"_5":17585,"_23966":98420,"_2399":98500},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2872":58781,"_25347":58748,"_17690":98502,"_5":17585,"_23966":98420,"_2399":98503},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2872":58782,"_25347":58748,"_17690":98505,"_5":17585,"_23966":98424,"_2399":98506},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2872":58783,"_25347":58748,"_17690":98508,"_5":17585,"_23966":98428,"_2399":98509},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2872":58784,"_25347":58748,"_17690":98511,"_5":17585,"_23966":98428,"_2399":98512},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2872":58785,"_25347":58748,"_17690":98514,"_5":17585,"_23966":98428,"_2399":98515},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2872":58786,"_25347":58748,"_17690":98517,"_5":17585,"_23966":98428,"_2399":98518},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2872":58787,"_25347":58748,"_17690":98520,"_5":17585,"_23966":98428,"_2399":98521},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2872":58788,"_25347":58748,"_17690":98523,"_5":17585,"_23966":98428,"_2399":98524},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2872":58789,"_25347":58748,"_17690":98526,"_5":17585,"_23966":98428,"_2399":98527},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2872":58790,"_25347":58748,"_17690":98529,"_5":17585,"_23966":98428,"_2399":98530},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2872":58791,"_25347":58748,"_17690":98532,"_5":17585,"_23966":98432,"_2399":98533},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2872":58792,"_25347":58748,"_17690":98535,"_5":17585,"_23966":98436,"_2399":98536},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2872":58793,"_25347":58748,"_17690":98538,"_5":17585,"_23966":98436,"_2399":98539},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2872":58794,"_25347":58748,"_17690":98541,"_5":17585,"_23966":98436,"_2399":98542},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2872":58795,"_25347":58748,"_17690":98544,"_5":17585,"_23966":98436,"_2399":98545},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2872":58796,"_25347":58748,"_17690":98547,"_5":17585,"_23966":98436,"_2399":98548},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2872":58797,"_25347":58748,"_17690":98550,"_5":17585,"_23966":98436,"_2399":98551},[],"**Validación:** `va.role.crl.create`.",{"_2872":58798,"_25347":58748,"_17690":98553,"_5":17585,"_23966":98436,"_2399":98554},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2872":58799,"_25347":58748,"_17690":98556,"_5":17585,"_23966":98436,"_2399":98557},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2872":58800,"_25347":58800,"_5":12438,"_2399":98559,"_25683":98560,"_17690":98561,"_23966":58800},"Registros de auditoría",[41104,97860,97861],[],{"_2872":58801,"_25347":58800,"_17690":98563,"_5":17585,"_23966":58800,"_2399":98564},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2872":58802,"_25347":58800,"_5":25680,"_17690":98566,"_23966":98567,"_2399":98568},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2872":58803,"_25347":58800,"_5":25680,"_17690":98570,"_23966":98571,"_2399":98572},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2872":58804,"_25347":58800,"_5":25680,"_17690":98574,"_23966":98575,"_2399":98576},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2872":58805,"_25347":58800,"_5":25680,"_17690":98578,"_23966":98579,"_2399":98580},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2872":58806,"_25347":58800,"_5":25680,"_17690":98582,"_23966":98583,"_2399":98584},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2872":58807,"_25347":58800,"_5":25680,"_17690":98586,"_23966":98587,"_2399":98588},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2872":58808,"_25347":58800,"_5":25680,"_17690":98590,"_23966":98591,"_2399":98592},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2872":58809,"_25347":58800,"_5":25680,"_17690":98594,"_23966":98595,"_2399":98596},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2872":58810,"_25347":58800,"_5":25680,"_17690":98598,"_23966":98599,"_2399":98600},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2872":58811,"_25347":58800,"_5":25680,"_17690":98602,"_23966":98603,"_2399":98604},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2872":58812,"_25347":58800,"_5":25680,"_17690":98606,"_23966":98607,"_2399":98608},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2872":58813,"_25347":58800,"_17690":98610,"_5":17585,"_23966":58800,"_2399":98611},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2872":58814,"_25347":58800,"_17690":98613,"_5":17585,"_23966":98567,"_2399":98614},[],"El cuerpo de auditoría incluye:",{"_2872":58815,"_25347":58800,"_17690":98616,"_5":17585,"_23966":98567,"_2399":98617},[],"input: datos recibidos por la operación;",{"_2872":58816,"_25347":58800,"_17690":98619,"_5":17585,"_23966":98567,"_2399":98620},[],"has\\_error: indica si el servicio devolvió un error;",{"_2872":58817,"_25347":58800,"_17690":98622,"_5":17585,"_23966":98567,"_2399":98623},[],"output: resultado producido o mensaje de error;",{"_2872":58818,"_25347":58800,"_17690":98625,"_5":17585,"_23966":98567,"_2399":98626},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2872":58819,"_25347":58800,"_17690":98628,"_5":17585,"_23966":98567,"_2399":98629},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2872":58820,"_25347":58800,"_17690":98631,"_5":17585,"_23966":98567,"_2399":98632},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2872":58821,"_25347":58800,"_17690":98634,"_5":17585,"_23966":98571,"_2399":98635},[],"El backend aplica auditoría a mutaciones de:",{"_2872":58822,"_25347":58800,"_17690":98637,"_5":17585,"_23966":98571,"_2399":98638},[],"autoridades, certificados y perfiles de emisión;",{"_2872":58823,"_25347":58800,"_17690":98640,"_5":17585,"_23966":98571,"_2399":98641},[],"claves y motores KMS;",{"_2872":58824,"_25347":58800,"_17690":98643,"_5":17585,"_23966":98571,"_2399":98644},[],"dispositivos e identidades;",{"_2872":58825,"_25347":58800,"_17690":98646,"_5":17585,"_23966":98571,"_2399":98647},[],"DMS y operaciones de enrolamiento;",{"_2872":58826,"_25347":58800,"_17690":98649,"_5":17585,"_23966":98571,"_2399":98650},[],"funciones de validación y CRL;",{"_2872":58827,"_25347":58800,"_17690":98652,"_5":17585,"_23966":98571,"_2399":98653},[],"principales, políticas y concesiones de autorización.",{"_2872":58828,"_25347":58800,"_17690":98655,"_5":17585,"_23966":98571,"_2399":98656},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2872":58829,"_25347":58800,"_17690":98658,"_5":17585,"_23966":98575,"_2399":98659},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2872":58830,"_25347":58800,"_17690":98661,"_5":17585,"_23966":98575,"_2399":98662},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2872":58831,"_25347":58800,"_17690":98664,"_5":17585,"_23966":98575,"_2399":98665},[],"Diseña el consumidor para:",{"_2872":58832,"_25347":58800,"_17690":98667,"_5":17585,"_23966":98575,"_2399":98668},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2872":58833,"_25347":58800,"_17690":98670,"_5":17585,"_23966":98575,"_2399":98671},[],"conservar el CloudEvent completo sin modificar;",{"_2872":58834,"_25347":58800,"_17690":98673,"_5":17585,"_23966":98575,"_2399":98674},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2872":58835,"_25347":58800,"_17690":98676,"_5":17585,"_23966":98575,"_2399":98677},[],"cifrar en tránsito y en reposo;",{"_2872":58836,"_25347":58800,"_17690":98679,"_5":17585,"_23966":98575,"_2399":98680},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2872":58837,"_25347":58800,"_17690":98682,"_5":17585,"_23966":98575,"_2399":98683},[],"aplicar una política explícita de retención y legal hold;",{"_2872":58838,"_25347":58800,"_17690":98685,"_5":17585,"_23966":98575,"_2399":98686},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2872":58839,"_25347":58800,"_17690":98688,"_5":17585,"_23966":98579,"_2399":98689},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2872":58840,"_25347":58800,"_17690":98691,"_5":17585,"_23966":98579,"_2399":98692},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2872":58841,"_25347":58800,"_17690":98694,"_5":17585,"_23966":98587,"_2399":98695},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2872":58842,"_25347":58800,"_17690":98697,"_5":17585,"_23966":98591,"_2399":98698},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2872":58843,"_25347":58800,"_17690":98700,"_5":17585,"_23966":98595,"_2399":98701},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2872":58844,"_25347":58800,"_17690":98703,"_5":17585,"_23966":98599,"_2399":98704},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2872":58845,"_25347":58800,"_17690":98706,"_5":17585,"_23966":98603,"_2399":98707},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2872":58846,"_25347":58800,"_17690":98709,"_5":17585,"_23966":98607,"_2399":98710},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2872":58847,"_25347":58800,"_17690":98712,"_5":17585,"_23966":98607,"_2399":98713},[],"aparece un evento de auditoría correcto;",{"_2872":58848,"_25347":58800,"_17690":98715,"_5":17585,"_23966":98607,"_2399":98716},[],"el principal coincide con la identidad utilizada;",{"_2872":58849,"_25347":58800,"_17690":98718,"_5":17585,"_23966":98607,"_2399":98719},[],"el consumidor lo persiste una sola vez;",{"_2872":58850,"_25347":58800,"_17690":98721,"_5":17585,"_23966":98607,"_2399":98722},[],"puede recuperarse por recurso, actor y periodo;",{"_2872":58851,"_25347":58800,"_17690":98724,"_5":17585,"_23966":98607,"_2399":98725},[],"una interrupción del consumidor produce una alerta.",{"_2872":58852,"_25347":58800,"_17690":98727,"_5":17585,"_23966":98607,"_2399":98728},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2872":58853,"_25347":58853,"_5":12438,"_2399":98730,"_25683":98731,"_17690":98732,"_23966":58853},"Arquitectura de la plataforma",[41104,97860],[],{"_2872":58854,"_25347":58853,"_17690":98734,"_5":17585,"_23966":58853,"_2399":98735},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2872":58855,"_25347":58853,"_5":25680,"_17690":98737,"_23966":98738,"_2399":98739},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2872":58856,"_25347":58853,"_5":25680,"_17690":98741,"_23966":98742,"_2399":98743},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2872":58857,"_25347":58853,"_5":25680,"_17690":98745,"_23966":98746,"_2399":98747},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2872":58858,"_25347":58853,"_5":25680,"_17690":98749,"_23966":98750,"_2399":98751},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2872":58859,"_25347":58853,"_5":25680,"_17690":98753,"_23966":98754,"_2399":98755},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2872":58860,"_25347":58853,"_17690":98757,"_5":17585,"_23966":58853,"_2399":98758},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2872":58861,"_25347":58853,"_17690":98760,"_5":17585,"_23966":58853,"_2399":98761},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2872":58862,"_25347":58853,"_17690":98763,"_5":17585,"_23966":98738,"_2399":98764},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2872":58863,"_25347":58853,"_17690":98766,"_5":17585,"_23966":98742,"_2399":98767},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2872":58864,"_25347":58853,"_17690":98769,"_5":17585,"_23966":98746,"_2399":98770},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2872":58865,"_25347":58853,"_17690":98772,"_5":17585,"_23966":98750,"_2399":98773},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2872":58866,"_25347":58853,"_17690":98775,"_5":17585,"_23966":98754,"_2399":98776},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2872":58867,"_25347":58867,"_5":12438,"_2399":98778,"_25683":98779,"_17690":98780,"_23966":58867},"Cómo funciona Lamassu",[41104,97860],[],{"_2872":58868,"_25347":58867,"_17690":98782,"_5":17585,"_23966":58867,"_2399":98783},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2872":58869,"_25347":58867,"_5":25680,"_17690":98785,"_23966":98786,"_2399":98787},[],"/docs/pr-preview/pr-42/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2872":58870,"_25347":58867,"_5":25680,"_17690":98789,"_23966":98790,"_2399":98791},[],"/docs/pr-preview/pr-42/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2872":58871,"_25347":58867,"_17690":98793,"_5":17585,"_23966":58867,"_2399":98794},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2872":58872,"_25347":58867,"_17690":98796,"_5":17585,"_23966":98786,"_2399":98797},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2872":58873,"_25347":58867,"_17690":98799,"_5":17585,"_23966":98786,"_2399":98800},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2872":58874,"_25347":58867,"_17690":98802,"_5":17585,"_23966":98786,"_2399":98803},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2872":58875,"_25347":58867,"_17690":98805,"_5":17585,"_23966":98786,"_2399":98806},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2872":58876,"_25347":58867,"_17690":98808,"_5":17585,"_23966":98786,"_2399":98809},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2872":58877,"_25347":58867,"_17690":98811,"_5":17585,"_23966":98790,"_2399":98812},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2872":58878,"_25347":58867,"_17690":98814,"_5":17585,"_23966":98790,"_2399":98815},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2872":58879,"_25347":58867,"_17690":98817,"_5":17585,"_23966":98790,"_2399":98818},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2872":58880,"_25347":58867,"_17690":98820,"_5":17585,"_23966":98790,"_2399":98821},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2872":58881,"_25347":58867,"_17690":98823,"_5":17585,"_23966":98790,"_2399":98824},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2872":58882,"_25347":58867,"_17690":98826,"_5":17585,"_23966":98790,"_2399":98827},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2872":58883,"_25347":58867,"_17690":98829,"_5":17585,"_23966":98790,"_2399":98830},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2872":58884,"_25347":58884,"_5":12438,"_2399":98832,"_25683":98833,"_17690":98834,"_23966":58884},"Dispositivos e identidades",[41104,97860,43471,98832],[],{"_2872":58885,"_25347":58884,"_17690":98836,"_5":17585,"_23966":58884,"_2399":98837},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2872":58886,"_25347":58884,"_5":25680,"_17690":98839,"_23966":98840,"_2399":98841},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2872":58887,"_25347":58884,"_5":25680,"_17690":98843,"_23966":98844,"_2399":98845},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2872":58888,"_25347":58884,"_5":25680,"_17690":98847,"_23966":98848,"_2399":98849},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2872":58889,"_25347":58884,"_5":25680,"_17690":98851,"_23966":98852,"_2399":98853},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2872":58890,"_25347":58884,"_5":25680,"_17690":98855,"_23966":98856,"_2399":98857},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2872":58891,"_25347":58884,"_5":25680,"_17690":98859,"_23966":98860,"_2399":98861},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2872":58892,"_25347":58884,"_5":25680,"_17690":98863,"_23966":98864,"_2399":98865},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2872":58893,"_25347":58884,"_5":25680,"_17690":98867,"_23966":98868,"_2399":98869},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2872":58894,"_25347":58884,"_5":25680,"_17690":98871,"_23966":98872,"_2399":98873},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2872":58895,"_25347":58884,"_5":25680,"_17690":98875,"_23966":98876,"_2399":98877},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2872":58896,"_25347":58884,"_5":25680,"_17690":98879,"_23966":98880,"_2399":98881},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2872":58897,"_25347":58884,"_17690":98883,"_5":17585,"_23966":58884,"_2399":98884},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2872":58898,"_25347":58884,"_17690":98886,"_5":17585,"_23966":58884,"_2399":98887},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2872":58899,"_25347":58884,"_17690":98889,"_5":17585,"_23966":98840,"_2399":98890},[],"Vista operativa",{"_2872":58900,"_25347":58884,"_17690":98892,"_5":17585,"_23966":98840,"_2399":98893},[],"Interpretación",{"_2872":58901,"_25347":58884,"_17690":98895,"_5":17585,"_23966":98840,"_2399":43534},[],{"_2872":58902,"_25347":58884,"_17690":98897,"_5":17585,"_23966":98840,"_2399":98898},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2872":58903,"_25347":58884,"_17690":98900,"_5":17585,"_23966":98840,"_2399":43540},[],{"_2872":58904,"_25347":58884,"_17690":98902,"_5":17585,"_23966":98840,"_2399":98903},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2872":58905,"_25347":58884,"_17690":98905,"_5":17585,"_23966":98840,"_2399":43546},[],{"_2872":58906,"_25347":58884,"_17690":98907,"_5":17585,"_23966":98840,"_2399":98908},[],"La identidad está en la ventana operativa de renovación.",{"_2872":58907,"_25347":58884,"_17690":98910,"_5":17585,"_23966":98840,"_2399":43552},[],{"_2872":58908,"_25347":58884,"_17690":98912,"_5":17585,"_23966":98840,"_2399":98913},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2872":58909,"_25347":58884,"_17690":98915,"_5":17585,"_23966":98840,"_2399":43558},[],{"_2872":58910,"_25347":58884,"_17690":98917,"_5":17585,"_23966":98840,"_2399":98918},[],"La identidad ha vencido.",{"_2872":58911,"_25347":58884,"_17690":98920,"_5":17585,"_23966":98840,"_2399":43564},[],{"_2872":58912,"_25347":58884,"_17690":98922,"_5":17585,"_23966":98840,"_2399":98923},[],"La identidad está marcada como revocada.",{"_2872":58913,"_25347":58884,"_17690":98925,"_5":17585,"_23966":98840,"_2399":43570},[],{"_2872":58914,"_25347":58884,"_17690":98927,"_5":17585,"_23966":98840,"_2399":98928},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2872":58915,"_25347":58884,"_17690":98930,"_5":17585,"_23966":98840,"_2399":98931},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2872":58916,"_25347":58884,"_17690":98933,"_5":17585,"_23966":98844,"_2399":98934},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2872":58917,"_25347":58884,"_17690":98936,"_5":17585,"_23966":98844,"_2399":98937},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2872":58918,"_25347":58884,"_17690":98939,"_5":17585,"_23966":98844,"_2399":98940},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2872":58919,"_25347":58884,"_17690":98942,"_5":17585,"_23966":98844,"_2399":98943},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2872":58920,"_25347":58884,"_17690":98945,"_5":17585,"_23966":98848,"_2399":98946},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2872":58921,"_25347":58884,"_17690":98948,"_5":17585,"_23966":98852,"_2399":98949},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2872":58922,"_25347":58884,"_17690":98951,"_5":17585,"_23966":98856,"_2399":98952},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2872":58923,"_25347":58884,"_17690":98954,"_5":17585,"_23966":98860,"_2399":98955},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2872":58924,"_25347":58884,"_17690":98957,"_5":17585,"_23966":98864,"_2399":98958},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2872":58925,"_25347":58884,"_17690":98960,"_5":17585,"_23966":98864,"_2399":98961},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2872":58926,"_25347":58884,"_17690":98963,"_5":17585,"_23966":98868,"_2399":98964},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2872":58927,"_25347":58884,"_17690":98966,"_5":17585,"_23966":98868,"_2399":98967},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2872":58928,"_25347":58884,"_17690":98969,"_5":17585,"_23966":98868,"_2399":98970},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2872":58929,"_25347":58884,"_17690":98972,"_5":17585,"_23966":98868,"_2399":98973},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2872":58930,"_25347":58884,"_17690":98975,"_5":17585,"_23966":98868,"_2399":98976},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2872":58931,"_25347":58884,"_17690":98978,"_5":17585,"_23966":98868,"_2399":98979},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2872":58932,"_25347":58884,"_17690":98981,"_5":17585,"_23966":98872,"_2399":98982},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2872":58933,"_25347":58884,"_17690":98984,"_5":17585,"_23966":98872,"_2399":98985},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2872":58934,"_25347":58884,"_17690":98987,"_5":17585,"_23966":98876,"_2399":98988},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2872":58935,"_25347":58884,"_17690":98990,"_5":17585,"_23966":98876,"_2399":98991},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2872":58936,"_25347":58884,"_17690":98993,"_5":17585,"_23966":98876,"_2399":98994},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2872":58937,"_25347":58884,"_17690":98996,"_5":17585,"_23966":98876,"_2399":98997},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2872":58938,"_25347":58884,"_17690":98999,"_5":17585,"_23966":98880,"_2399":99000},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2872":58939,"_25347":58884,"_17690":99002,"_5":17585,"_23966":98880,"_2399":99003},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2872":58940,"_25347":58940,"_5":12438,"_2399":99005,"_25683":99006,"_17690":99008,"_23966":58940},"Identidad inicial y autenticación",[41104,97860,43471,98832,99007],"Enrolamiento con PKI",[],{"_2872":58941,"_25347":58940,"_17690":99010,"_5":17585,"_23966":58940,"_2399":99011},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2872":58942,"_25347":58940,"_5":25680,"_17690":99013,"_23966":99014,"_2399":99015},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2872":58943,"_25347":58940,"_5":25680,"_17690":99017,"_23966":99018,"_2399":99019},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2872":58944,"_25347":58940,"_5":25680,"_17690":99021,"_23966":99022,"_2399":99023},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2872":58945,"_25347":58940,"_5":25680,"_17690":99025,"_23966":99026,"_2399":99027},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2872":58946,"_25347":58940,"_5":25680,"_17690":99029,"_23966":99030,"_2399":99031},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2872":58947,"_25347":58940,"_17690":99033,"_5":17585,"_23966":58940,"_2399":99034},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2872":58948,"_25347":58940,"_17690":99036,"_5":17585,"_23966":99014,"_2399":99037},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2872":58949,"_25347":58940,"_17690":99039,"_5":17585,"_23966":99014,"_2399":99040},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2872":58950,"_25347":58940,"_17690":99042,"_5":17585,"_23966":99018,"_2399":99043},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2872":58951,"_25347":58940,"_17690":99045,"_5":17585,"_23966":99018,"_2399":99046},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2872":58952,"_25347":58940,"_17690":99048,"_5":17585,"_23966":99018,"_2399":99049},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2872":58953,"_25347":58940,"_17690":99051,"_5":17585,"_23966":99022,"_2399":99052},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2872":58954,"_25347":58940,"_17690":99054,"_5":17585,"_23966":99022,"_2399":99055},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2872":58955,"_25347":58940,"_17690":99057,"_5":17585,"_23966":99026,"_2399":99058},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2872":58956,"_25347":58940,"_17690":99060,"_5":17585,"_23966":99026,"_2399":99061},[],"Ejemplo de cuerpo:",{"_2872":58957,"_25347":58940,"_17690":99063,"_5":17585,"_23966":99026,"_2399":99064},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2872":58958,"_25347":58940,"_17690":99066,"_5":17585,"_23966":99026,"_2399":99067},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2872":58959,"_25347":58940,"_17690":99069,"_5":17585,"_23966":99026,"_2399":99070},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2872":58960,"_25347":58940,"_17690":99072,"_5":17585,"_23966":99026,"_2399":99073},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2872":58961,"_25347":58940,"_17690":99075,"_5":17585,"_23966":99030,"_2399":99076},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2872":58962,"_25347":58940,"_17690":99078,"_5":17585,"_23966":99030,"_2399":99079},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2872":58963,"_25347":58963,"_5":12438,"_2399":99081,"_25683":99082,"_17690":99083,"_23966":58963},"Configura y opera el DMS",[41104,97860,43471,98832,99007],[],{"_2872":58964,"_25347":58963,"_17690":99085,"_5":17585,"_23966":58963,"_2399":99086},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2872":58965,"_25347":58963,"_5":25680,"_17690":99088,"_23966":99089,"_2399":96512},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2872":58966,"_25347":58963,"_5":25680,"_17690":99091,"_23966":99092,"_2399":99093},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2872":58967,"_25347":58963,"_5":25680,"_17690":99095,"_23966":99096,"_2399":99097},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2872":58968,"_25347":58963,"_5":25680,"_17690":99099,"_23966":99100,"_2399":99101},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2872":58969,"_25347":58963,"_5":25680,"_17690":99103,"_23966":99104,"_2399":99105},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2872":58970,"_25347":58963,"_5":25680,"_17690":99107,"_23966":99108,"_2399":99109},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2872":58971,"_25347":58963,"_5":25680,"_17690":99111,"_23966":99112,"_2399":99113},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2872":58972,"_25347":58963,"_5":25680,"_17690":99115,"_23966":99116,"_2399":99117},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2872":58973,"_25347":58963,"_5":25680,"_17690":99119,"_23966":99120,"_2399":43766},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2872":58974,"_25347":58963,"_5":25680,"_17690":99122,"_23966":99123,"_2399":43770},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2872":58975,"_25347":58963,"_5":25680,"_17690":99125,"_23966":99126,"_2399":99127},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2872":58976,"_25347":58963,"_5":25680,"_17690":99129,"_23966":99130,"_2399":99131},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2872":58977,"_25347":58963,"_5":25680,"_17690":99133,"_23966":99134,"_2399":99135},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2872":58978,"_25347":58963,"_5":25680,"_17690":99137,"_23966":99138,"_2399":99139},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2872":58979,"_25347":58963,"_5":25680,"_17690":99141,"_23966":99142,"_2399":43790},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2872":58980,"_25347":58963,"_5":25680,"_17690":99144,"_23966":99145,"_2399":99146},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2872":58981,"_25347":58963,"_5":25680,"_17690":99148,"_23966":99149,"_2399":99150},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2872":58982,"_25347":58963,"_5":25680,"_17690":99152,"_23966":99153,"_2399":99154},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2872":58983,"_25347":58963,"_17690":99156,"_5":17585,"_23966":58963,"_2399":99157},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2872":58984,"_25347":58963,"_17690":99159,"_5":17585,"_23966":99089,"_2399":99160},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2872":58985,"_25347":58963,"_17690":99162,"_5":17585,"_23966":99089,"_2399":99163},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2872":58986,"_25347":58963,"_17690":99165,"_5":17585,"_23966":99096,"_2399":99166},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2872":58987,"_25347":58963,"_17690":99168,"_5":17585,"_23966":99100,"_2399":99169},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2872":58988,"_25347":58963,"_17690":99171,"_5":17585,"_23966":99104,"_2399":99172},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2872":58989,"_25347":58963,"_17690":99174,"_5":17585,"_23966":99108,"_2399":99175},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2872":58990,"_25347":58963,"_17690":99177,"_5":17585,"_23966":99112,"_2399":99178},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2872":58991,"_25347":58963,"_17690":99180,"_5":17585,"_23966":99120,"_2399":99181},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2872":58992,"_25347":58963,"_17690":99183,"_5":17585,"_23966":99120,"_2399":99184},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2872":58993,"_25347":58963,"_17690":99186,"_5":17585,"_23966":99123,"_2399":99187},[],"Campo de `settings.enrollment_settings`",{"_2872":58994,"_25347":58963,"_17690":99189,"_5":17585,"_23966":99123,"_2399":99190},[],"Decisión",{"_2872":58995,"_25347":58963,"_17690":99192,"_5":17585,"_23966":99123,"_2399":43841},[],{"_2872":58996,"_25347":58963,"_17690":99194,"_5":17585,"_23966":99123,"_2399":99195},[],"`EST_RFC7030` para estas operaciones.",{"_2872":58997,"_25347":58963,"_17690":99197,"_5":17585,"_23966":99123,"_2399":43847},[],{"_2872":58998,"_25347":58963,"_17690":99199,"_5":17585,"_23966":99123,"_2399":99200},[],"ID de la CA que firmará.",{"_2872":58999,"_25347":58963,"_17690":99202,"_5":17585,"_23966":99123,"_2399":43853},[],{"_2872":59000,"_25347":58963,"_17690":99204,"_5":17585,"_23966":99123,"_2399":99205},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2872":59001,"_25347":58963,"_17690":99207,"_5":17585,"_23966":99123,"_2399":43859},[],{"_2872":59002,"_25347":58963,"_17690":99209,"_5":17585,"_23966":99123,"_2399":99210},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2872":59003,"_25347":58963,"_17690":99212,"_5":17585,"_23966":99123,"_2399":43865},[],{"_2872":59004,"_25347":58963,"_17690":99214,"_5":17585,"_23966":99123,"_2399":99215},[],"Uno de los cuatro modos de autenticación.",{"_2872":59005,"_25347":58963,"_17690":99217,"_5":17585,"_23966":99123,"_2399":99218},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2872":59006,"_25347":58963,"_17690":99220,"_5":17585,"_23966":99126,"_2399":99221},[],"Los bloques son independientes:",{"_2872":59007,"_25347":58963,"_17690":99223,"_5":17585,"_23966":99126,"_2399":99224},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2872":59008,"_25347":58963,"_17690":99226,"_5":17585,"_23966":99126,"_2399":99227},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2872":59009,"_25347":58963,"_17690":99229,"_5":17585,"_23966":99126,"_2399":43883},[],{"_2872":59010,"_25347":58963,"_17690":99231,"_5":17585,"_23966":99126,"_2399":99232},[],"Control aplicado en la operación configurada",{"_2872":59011,"_25347":58963,"_17690":99234,"_5":17585,"_23966":99126,"_2399":43889},[],{"_2872":59012,"_25347":58963,"_17690":99236,"_5":17585,"_23966":99126,"_2399":99237},[],"Validación del certificado presentado.",{"_2872":59013,"_25347":58963,"_17690":99239,"_5":17585,"_23966":99126,"_2399":43895},[],{"_2872":59014,"_25347":58963,"_17690":99241,"_5":17585,"_23966":99126,"_2399":99242},[],"Autorización del webhook configurado.",{"_2872":59015,"_25347":58963,"_17690":99244,"_5":17585,"_23966":99126,"_2399":43901},[],{"_2872":59016,"_25347":58963,"_17690":99246,"_5":17585,"_23966":99126,"_2399":99247},[],"Validación del certificado y, después, aprobación del webhook.",{"_2872":59017,"_25347":58963,"_17690":99249,"_5":17585,"_23966":99126,"_2399":43907},[],{"_2872":59018,"_25347":58963,"_17690":99251,"_5":17585,"_23966":99126,"_2399":99252},[],"Sin autenticación del solicitante por el DMS.",{"_2872":59019,"_25347":58963,"_17690":99254,"_5":17585,"_23966":99126,"_2399":99255},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2872":59020,"_25347":58963,"_17690":99257,"_5":17585,"_23966":99126,"_2399":99258},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2872":59021,"_25347":58963,"_17690":99260,"_5":17585,"_23966":99126,"_2399":99261},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2872":59022,"_25347":58963,"_17690":99263,"_5":17585,"_23966":99126,"_2399":99264},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2872":59023,"_25347":58963,"_17690":99266,"_5":17585,"_23966":99130,"_2399":99267},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2872":59024,"_25347":58963,"_17690":99269,"_5":17585,"_23966":99130,"_2399":99270},[],"Campo de `external_webhook_settings`",{"_2872":59025,"_25347":58963,"_17690":99272,"_5":17585,"_23966":99130,"_2399":99190},[],{"_2872":59026,"_25347":58963,"_17690":99274,"_5":17585,"_23966":99130,"_2399":43933},[],{"_2872":59027,"_25347":58963,"_17690":99276,"_5":17585,"_23966":99130,"_2399":99277},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2872":59028,"_25347":58963,"_17690":99279,"_5":17585,"_23966":99130,"_2399":43939},[],{"_2872":59029,"_25347":58963,"_17690":99281,"_5":17585,"_23966":99130,"_2399":99282},[],"`POST` o `PUT`; `POST` por defecto.",{"_2872":59030,"_25347":58963,"_17690":99284,"_5":17585,"_23966":99130,"_2399":43945},[],{"_2872":59031,"_25347":58963,"_17690":99286,"_5":17585,"_23966":99130,"_2399":99287},[],"Etiqueta usada en los logs del servicio.",{"_2872":59032,"_25347":58963,"_17690":99289,"_5":17585,"_23966":99130,"_2399":43951},[],{"_2872":59033,"_25347":58963,"_17690":99291,"_5":17585,"_23966":99130,"_2399":99292},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2872":59034,"_25347":58963,"_17690":99294,"_5":17585,"_23966":99130,"_2399":43957},[],{"_2872":59035,"_25347":58963,"_17690":99296,"_5":17585,"_23966":99130,"_2399":99297},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2872":59036,"_25347":58963,"_17690":99299,"_5":17585,"_23966":99130,"_2399":43963},[],{"_2872":59037,"_25347":58963,"_17690":99301,"_5":17585,"_23966":99130,"_2399":99302},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2872":59038,"_25347":58963,"_17690":99304,"_5":17585,"_23966":99130,"_2399":43969},[],{"_2872":59039,"_25347":58963,"_17690":99306,"_5":17585,"_23966":99130,"_2399":99307},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2872":59040,"_25347":58963,"_17690":99309,"_5":17585,"_23966":99130,"_2399":43975},[],{"_2872":59041,"_25347":58963,"_17690":99311,"_5":17585,"_23966":99130,"_2399":99312},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2872":59042,"_25347":58963,"_17690":99314,"_5":17585,"_23966":99130,"_2399":43981},[],{"_2872":59043,"_25347":58963,"_17690":99316,"_5":17585,"_23966":99130,"_2399":99317},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2872":59044,"_25347":58963,"_17690":99319,"_5":17585,"_23966":99130,"_2399":99320},[],"Reglas de esa configuración:",{"_2872":59045,"_25347":58963,"_17690":99322,"_5":17585,"_23966":99130,"_2399":99323},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2872":59046,"_25347":58963,"_17690":99325,"_5":17585,"_23966":99130,"_2399":99326},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2872":59047,"_25347":58963,"_17690":99328,"_5":17585,"_23966":99130,"_2399":99329},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2872":59048,"_25347":58963,"_17690":99331,"_5":17585,"_23966":99130,"_2399":99332},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2872":59049,"_25347":58963,"_17690":99334,"_5":17585,"_23966":99130,"_2399":99335},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2872":59050,"_25347":58963,"_17690":99337,"_5":17585,"_23966":99130,"_2399":99338},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2872":59051,"_25347":58963,"_17690":99340,"_5":17585,"_23966":99130,"_2399":99341},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2872":59052,"_25347":58963,"_17690":99343,"_5":17585,"_23966":99130,"_2399":99344},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2872":59053,"_25347":58963,"_17690":99346,"_5":17585,"_23966":99134,"_2399":99347},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2872":59054,"_25347":58963,"_17690":99349,"_5":17585,"_23966":99138,"_2399":99350},[],"Campo de `settings.reenrollment_settings`",{"_2872":59055,"_25347":58963,"_17690":99352,"_5":17585,"_23966":99138,"_2399":99353},[],"Función",{"_2872":59056,"_25347":58963,"_17690":99355,"_5":17585,"_23966":99138,"_2399":44022},[],{"_2872":59057,"_25347":58963,"_17690":99357,"_5":17585,"_23966":99138,"_2399":99358},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2872":59058,"_25347":58963,"_17690":99360,"_5":17585,"_23966":99138,"_2399":44028},[],{"_2872":59059,"_25347":58963,"_17690":99362,"_5":17585,"_23966":99138,"_2399":99363},[],"Umbral operativo preventivo de monitorización.",{"_2872":59060,"_25347":58963,"_17690":99365,"_5":17585,"_23966":99138,"_2399":44034},[],{"_2872":59061,"_25347":58963,"_17690":99367,"_5":17585,"_23966":99138,"_2399":99368},[],"Umbral operativo crítico de monitorización.",{"_2872":59062,"_25347":58963,"_17690":99370,"_5":17585,"_23966":99138,"_2399":44040},[],{"_2872":59063,"_25347":58963,"_17690":99372,"_5":17585,"_23966":99138,"_2399":99373},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2872":59064,"_25347":58963,"_17690":99375,"_5":17585,"_23966":99138,"_2399":44046},[],{"_2872":59065,"_25347":58963,"_17690":99377,"_5":17585,"_23966":99138,"_2399":99378},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2872":59066,"_25347":58963,"_17690":99380,"_5":17585,"_23966":99138,"_2399":44052},[],{"_2872":59067,"_25347":58963,"_17690":99382,"_5":17585,"_23966":99138,"_2399":99383},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2872":59068,"_25347":58963,"_17690":99385,"_5":17585,"_23966":99138,"_2399":99386},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2872":59069,"_25347":58963,"_17690":99388,"_5":17585,"_23966":99142,"_2399":99389},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2872":59070,"_25347":58963,"_17690":99391,"_5":17585,"_23966":99145,"_2399":96869},[],{"_2872":59071,"_25347":58963,"_17690":99393,"_5":17585,"_23966":99145,"_2399":99394},[],"Qué publica",{"_2872":59072,"_25347":58963,"_17690":99396,"_5":17585,"_23966":99145,"_2399":44069},[],{"_2872":59073,"_25347":58963,"_17690":99398,"_5":17585,"_23966":99145,"_2399":99399},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2872":59074,"_25347":58963,"_17690":99401,"_5":17585,"_23966":99145,"_2399":44075},[],{"_2872":59075,"_25347":58963,"_17690":99403,"_5":17585,"_23966":99145,"_2399":99404},[],"Certificado de la CA emisora seleccionada.",{"_2872":59076,"_25347":58963,"_17690":99406,"_5":17585,"_23966":99145,"_2399":44081},[],{"_2872":59077,"_25347":58963,"_17690":99408,"_5":17585,"_23966":99145,"_2399":99409},[],"Certificados de las CAs elegidas explícitamente.",{"_2872":59078,"_25347":58963,"_17690":99411,"_5":17585,"_23966":99145,"_2399":99412},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2872":59079,"_25347":58963,"_17690":99414,"_5":17585,"_23966":99149,"_2399":99415},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2872":59080,"_25347":58963,"_17690":99417,"_5":17585,"_23966":99149,"_2399":99418},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2872":59081,"_25347":58963,"_17690":99420,"_5":17585,"_23966":99149,"_2399":99421},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2872":59082,"_25347":58963,"_17690":99423,"_5":17585,"_23966":99153,"_2399":99424},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2872":59083,"_25347":59083,"_5":12438,"_2399":99426,"_25683":99427,"_17690":99428,"_23966":59083},"Integra el cliente EST",[41104,97860,43471,98832,99007],[],{"_2872":59084,"_25347":59083,"_17690":99430,"_5":17585,"_23966":59083,"_2399":99431},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2872":59085,"_25347":59083,"_5":25680,"_17690":99433,"_23966":99434,"_2399":96512},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2872":59086,"_25347":59083,"_5":25680,"_17690":99436,"_23966":99437,"_2399":99438},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2872":59087,"_25347":59083,"_5":25680,"_17690":99440,"_23966":99441,"_2399":99442},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2872":59088,"_25347":59083,"_5":25680,"_17690":99444,"_23966":99445,"_2399":99446},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2872":59089,"_25347":59083,"_5":25680,"_17690":99448,"_23966":99449,"_2399":99450},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2872":59090,"_25347":59083,"_5":25680,"_17690":99452,"_23966":99453,"_2399":99454},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2872":59091,"_25347":59083,"_17690":99456,"_5":17585,"_23966":59083,"_2399":99457},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2872":59092,"_25347":59083,"_17690":99459,"_5":17585,"_23966":99434,"_2399":99460},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2872":59093,"_25347":59083,"_17690":99462,"_5":17585,"_23966":99434,"_2399":99463},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2872":59094,"_25347":59083,"_17690":99465,"_5":17585,"_23966":99434,"_2399":99466},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2872":59095,"_25347":59083,"_17690":99468,"_5":17585,"_23966":99437,"_2399":99469},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2872":59096,"_25347":59083,"_17690":99471,"_5":17585,"_23966":99437,"_2399":99472},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2872":59097,"_25347":59083,"_17690":99474,"_5":17585,"_23966":99441,"_2399":99475},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2872":59098,"_25347":59083,"_17690":99477,"_5":17585,"_23966":99441,"_2399":99478},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2872":59099,"_25347":59083,"_17690":99480,"_5":17585,"_23966":99445,"_2399":99481},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2872":59100,"_25347":59083,"_17690":99483,"_5":17585,"_23966":99445,"_2399":99484},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2872":59101,"_25347":59083,"_17690":99486,"_5":17585,"_23966":99449,"_2399":99487},[],"Para el caso de una raíz que emite directamente:",{"_2872":59102,"_25347":59083,"_17690":99489,"_5":17585,"_23966":99449,"_2399":99490},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2872":59103,"_25347":59083,"_17690":99492,"_5":17585,"_23966":99449,"_2399":99493},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2872":59104,"_25347":59083,"_17690":99495,"_5":17585,"_23966":99453,"_2399":99496},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2872":59105,"_25347":59105,"_5":12438,"_2399":99498,"_25683":99499,"_17690":99500,"_23966":59105},"Referencia EST",[41104,97860,43471,98832,99007],[],{"_2872":59106,"_25347":59105,"_17690":99502,"_5":17585,"_23966":59105,"_2399":99503},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2872":59107,"_25347":59105,"_5":25680,"_17690":99505,"_23966":99506,"_2399":99507},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2872":59108,"_25347":59105,"_5":25680,"_17690":99509,"_23966":99510,"_2399":19194},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2872":59109,"_25347":59105,"_5":25680,"_17690":99512,"_23966":99513,"_2399":21985},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2872":59110,"_25347":59105,"_5":25680,"_17690":99515,"_23966":99516,"_2399":21992},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2872":59111,"_25347":59105,"_5":25680,"_17690":99518,"_23966":99519,"_2399":21356},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2872":59112,"_25347":59105,"_5":25680,"_17690":99521,"_23966":99522,"_2399":99523},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2872":59113,"_25347":59105,"_5":25680,"_17690":99525,"_23966":99526,"_2399":99527},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2872":59114,"_25347":59105,"_5":25680,"_17690":99529,"_23966":99530,"_2399":99531},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2872":59115,"_25347":59105,"_17690":99533,"_5":17585,"_23966":59105,"_2399":99534},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2872":59116,"_25347":59105,"_17690":99536,"_5":17585,"_23966":99506,"_2399":99537},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2872":59117,"_25347":59105,"_17690":99539,"_5":17585,"_23966":99506,"_2399":97630},[],{"_2872":59118,"_25347":59105,"_17690":99541,"_5":17585,"_23966":99506,"_2399":99542},[],"Método",{"_2872":59119,"_25347":59105,"_17690":99544,"_5":17585,"_23966":99506,"_2399":99545},[],"Autenticación y condición",{"_2872":59120,"_25347":59105,"_17690":99547,"_5":17585,"_23966":99506,"_2399":44224},[],{"_2872":59121,"_25347":59105,"_17690":99549,"_5":17585,"_23966":99506,"_2399":44227},[],{"_2872":59122,"_25347":59105,"_17690":99551,"_5":17585,"_23966":99506,"_2399":99552},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2872":59123,"_25347":59105,"_17690":99554,"_5":17585,"_23966":99506,"_2399":44233},[],{"_2872":59124,"_25347":59105,"_17690":99556,"_5":17585,"_23966":99506,"_2399":44236},[],{"_2872":59125,"_25347":59105,"_17690":99558,"_5":17585,"_23966":99506,"_2399":99559},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2872":59126,"_25347":59105,"_17690":99561,"_5":17585,"_23966":99506,"_2399":44242},[],{"_2872":59127,"_25347":59105,"_17690":99563,"_5":17585,"_23966":99506,"_2399":44236},[],{"_2872":59128,"_25347":59105,"_17690":99565,"_5":17585,"_23966":99506,"_2399":99566},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2872":59129,"_25347":59105,"_17690":99568,"_5":17585,"_23966":99506,"_2399":44250},[],{"_2872":59130,"_25347":59105,"_17690":99570,"_5":17585,"_23966":99506,"_2399":44236},[],{"_2872":59131,"_25347":59105,"_17690":99572,"_5":17585,"_23966":99506,"_2399":99573},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2872":59132,"_25347":59105,"_17690":99575,"_5":17585,"_23966":99506,"_2399":99576},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2872":59133,"_25347":59105,"_17690":99578,"_5":17585,"_23966":99510,"_2399":99579},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2872":59134,"_25347":59105,"_17690":99581,"_5":17585,"_23966":99510,"_2399":99582},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2872":59135,"_25347":59105,"_17690":99584,"_5":17585,"_23966":99513,"_2399":99585},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2872":59136,"_25347":59105,"_17690":99587,"_5":17585,"_23966":99513,"_2399":99588},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2872":59137,"_25347":59105,"_17690":99590,"_5":17585,"_23966":99516,"_2399":99591},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2872":59138,"_25347":59105,"_17690":99593,"_5":17585,"_23966":99516,"_2399":99594},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2872":59139,"_25347":59105,"_17690":99596,"_5":17585,"_23966":99519,"_2399":99597},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2872":59140,"_25347":59105,"_17690":99599,"_5":17585,"_23966":99519,"_2399":99600},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2872":59141,"_25347":59105,"_17690":99602,"_5":17585,"_23966":99522,"_2399":99603},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2872":59142,"_25347":59105,"_17690":99605,"_5":17585,"_23966":99522,"_2399":99606},[],"Parte",{"_2872":59143,"_25347":59105,"_17690":99608,"_5":17585,"_23966":99522,"_2399":99609},[],"Contenido tras decodificar su Base64",{"_2872":59144,"_25347":59105,"_17690":99611,"_5":17585,"_23966":99522,"_2399":44294},[],{"_2872":59145,"_25347":59105,"_17690":99613,"_5":17585,"_23966":99522,"_2399":99614},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2872":59146,"_25347":59105,"_17690":99616,"_5":17585,"_23966":99522,"_2399":44300},[],{"_2872":59147,"_25347":59105,"_17690":99618,"_5":17585,"_23966":99522,"_2399":99619},[],"PKCS#7 DER con el certificado emitido.",{"_2872":59148,"_25347":59105,"_17690":99621,"_5":17585,"_23966":99522,"_2399":99622},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2872":59149,"_25347":59105,"_17690":99624,"_5":17585,"_23966":99526,"_2399":99625},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2872":59150,"_25347":59105,"_17690":99627,"_5":17585,"_23966":99526,"_2399":99628},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2872":59151,"_25347":59105,"_17690":99630,"_5":17585,"_23966":99526,"_2399":99631},[],"Convierte y comprueba el resultado:",{"_2872":59152,"_25347":59105,"_17690":99633,"_5":17585,"_23966":99526,"_2399":99634},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2872":59153,"_25347":59105,"_17690":99636,"_5":17585,"_23966":99530,"_2399":99637},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2872":59154,"_25347":59105,"_17690":99639,"_5":17585,"_23966":99530,"_2399":99640},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2872":59155,"_25347":59155,"_5":12438,"_2399":99007,"_25683":99642,"_17690":99643,"_23966":59155},[41104,97860,43471,98832,99007],[],{"_2872":59156,"_25347":59155,"_17690":99645,"_5":17585,"_23966":59155,"_2399":99646},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2872":59157,"_25347":59155,"_5":25680,"_17690":99648,"_23966":99649,"_2399":99650},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2872":59158,"_25347":59155,"_5":25680,"_17690":99652,"_23966":99653,"_2399":99654},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2872":59159,"_25347":59155,"_5":25680,"_17690":99656,"_23966":99657,"_2399":99658},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2872":59160,"_25347":59155,"_5":25680,"_17690":99660,"_23966":99661,"_2399":99662},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2872":59161,"_25347":59155,"_17690":99664,"_5":17585,"_23966":59155,"_2399":99665},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2872":59162,"_25347":59155,"_17690":99667,"_5":17585,"_23966":99649,"_2399":99668},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2872":59163,"_25347":59155,"_17690":99670,"_5":17585,"_23966":99649,"_2399":99671},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2872":59164,"_25347":59155,"_17690":99673,"_5":17585,"_23966":99649,"_2399":99674},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2872":59165,"_25347":59155,"_17690":99676,"_5":17585,"_23966":99649,"_2399":99677},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2872":59166,"_25347":59155,"_17690":99679,"_5":17585,"_23966":99649,"_2399":99680},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2872":59167,"_25347":59155,"_17690":99682,"_5":17585,"_23966":99649,"_2399":99683},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2872":59168,"_25347":59155,"_17690":99685,"_5":17585,"_23966":99653,"_2399":99686},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2872":59169,"_25347":59155,"_17690":99688,"_5":17585,"_23966":99653,"_2399":99689},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2872":59170,"_25347":59155,"_17690":99691,"_5":17585,"_23966":99653,"_2399":99692},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2872":59171,"_25347":59155,"_17690":99694,"_5":17585,"_23966":99653,"_2399":99695},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2872":59172,"_25347":59155,"_17690":99697,"_5":17585,"_23966":99657,"_2399":99698},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2872":59173,"_25347":59155,"_17690":99700,"_5":17585,"_23966":99657,"_2399":99701},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2872":59174,"_25347":59155,"_17690":99703,"_5":17585,"_23966":99657,"_2399":99704},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2872":59175,"_25347":59155,"_17690":99706,"_5":17585,"_23966":99657,"_2399":99707},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2872":59176,"_25347":59155,"_17690":99709,"_5":17585,"_23966":99661,"_2399":99710},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2872":59177,"_25347":59155,"_17690":99712,"_5":17585,"_23966":99661,"_2399":99713},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2872":59178,"_25347":59178,"_5":12438,"_2399":99715,"_25683":99716,"_17690":99717,"_23966":59178},"Estrategias de aprovisionamiento",[41104,97860,43471,98832,99007],[],{"_2872":59179,"_25347":59178,"_17690":99719,"_5":17585,"_23966":59178,"_2399":99720},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2872":59180,"_25347":59178,"_5":25680,"_17690":99722,"_23966":99723,"_2399":99724},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2872":59181,"_25347":59178,"_5":25680,"_17690":99726,"_23966":99727,"_2399":99728},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2872":59182,"_25347":59178,"_5":25680,"_17690":99730,"_23966":99731,"_2399":99732},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2872":59183,"_25347":59178,"_5":25680,"_17690":99734,"_23966":99735,"_2399":99736},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2872":59184,"_25347":59178,"_5":25680,"_17690":99738,"_23966":99739,"_2399":99740},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2872":59185,"_25347":59178,"_17690":99742,"_5":17585,"_23966":59178,"_2399":99743},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2872":59186,"_25347":59178,"_17690":99745,"_5":17585,"_23966":99723,"_2399":99746},[],"Recorrido",{"_2872":59187,"_25347":59178,"_17690":99748,"_5":17585,"_23966":99723,"_2399":99749},[],"Cuándo existe el dispositivo",{"_2872":59188,"_25347":59178,"_17690":99751,"_5":17585,"_23966":99723,"_2399":99752},[],"Qué compruebas",{"_2872":59189,"_25347":59178,"_17690":99754,"_5":17585,"_23966":99723,"_2399":99755},[],"Asignación manual",{"_2872":59190,"_25347":59178,"_17690":99757,"_5":17585,"_23966":99723,"_2399":99758},[],"El operador lo crea antes de asociar un certificado.",{"_2872":59191,"_25347":59178,"_17690":99760,"_5":17585,"_23966":99723,"_2399":99761},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2872":59192,"_25347":59178,"_17690":99763,"_5":17585,"_23966":99723,"_2399":99764},[],"EST con `JITP`",{"_2872":59193,"_25347":59178,"_17690":99766,"_5":17585,"_23966":99723,"_2399":99767},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2872":59194,"_25347":59178,"_17690":99769,"_5":17585,"_23966":99723,"_2399":99770},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2872":59195,"_25347":59178,"_17690":99772,"_5":17585,"_23966":99723,"_2399":99773},[],"EST con `PRE_REGISTRATION`",{"_2872":59196,"_25347":59178,"_17690":99775,"_5":17585,"_23966":99723,"_2399":99776},[],"Debe existir antes de `/simpleenroll`.",{"_2872":59197,"_25347":59178,"_17690":99778,"_5":17585,"_23966":99723,"_2399":99779},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2872":59198,"_25347":59178,"_17690":99781,"_5":17585,"_23966":99723,"_2399":99782},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2872":59199,"_25347":59178,"_17690":99784,"_5":17585,"_23966":99723,"_2399":99785},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2872":59200,"_25347":59178,"_17690":99787,"_5":17585,"_23966":99727,"_2399":99788},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2872":59201,"_25347":59178,"_17690":99790,"_5":17585,"_23966":99727,"_2399":99791},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2872":59202,"_25347":59178,"_17690":99793,"_5":17585,"_23966":99727,"_2399":99794},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2872":59203,"_25347":59178,"_17690":99796,"_5":17585,"_23966":99731,"_2399":99797},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2872":59204,"_25347":59178,"_17690":99799,"_5":17585,"_23966":99731,"_2399":99800},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2872":59205,"_25347":59178,"_17690":99802,"_5":17585,"_23966":99731,"_2399":99803},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2872":59206,"_25347":59178,"_17690":99805,"_5":17585,"_23966":99731,"_2399":99806},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2872":59207,"_25347":59178,"_17690":99808,"_5":17585,"_23966":99731,"_2399":99809},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2872":59208,"_25347":59178,"_17690":99811,"_5":17585,"_23966":99731,"_2399":99812},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2872":59209,"_25347":59178,"_17690":99814,"_5":17585,"_23966":99735,"_2399":96869},[],{"_2872":59210,"_25347":59178,"_17690":99816,"_5":17585,"_23966":99735,"_2399":99817},[],"Material que atraviesa EST",{"_2872":59211,"_25347":59178,"_17690":99819,"_5":17585,"_23966":99735,"_2399":99820},[],"Clave generada por el dispositivo",{"_2872":59212,"_25347":59178,"_17690":99822,"_5":17585,"_23966":99735,"_2399":99823},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2872":59213,"_25347":59178,"_17690":99825,"_5":17585,"_23966":99735,"_2399":99826},[],"Clave ya disponible en el dispositivo",{"_2872":59214,"_25347":59178,"_17690":99828,"_5":17585,"_23966":99735,"_2399":99829},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2872":59215,"_25347":59178,"_17690":99831,"_5":17585,"_23966":99735,"_2399":43790},[],{"_2872":59216,"_25347":59178,"_17690":99833,"_5":17585,"_23966":99735,"_2399":99834},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2872":59217,"_25347":59178,"_17690":99836,"_5":17585,"_23966":99735,"_2399":99837},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2872":59218,"_25347":59178,"_17690":99839,"_5":17585,"_23966":99739,"_2399":99840},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2872":59219,"_25347":59219,"_5":12438,"_2399":99842,"_25683":99843,"_17690":99844,"_23966":59219},"Renovación y recuperación",[41104,97860,43471,98832,99007],[],{"_2872":59220,"_25347":59219,"_17690":99846,"_5":17585,"_23966":59219,"_2399":99847},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2872":59221,"_25347":59219,"_5":25680,"_17690":99849,"_23966":99850,"_2399":99851},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2872":59222,"_25347":59219,"_5":25680,"_17690":99853,"_23966":99854,"_2399":99855},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2872":59223,"_25347":59219,"_5":25680,"_17690":99857,"_23966":99858,"_2399":99859},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2872":59224,"_25347":59219,"_5":25680,"_17690":99861,"_23966":99862,"_2399":99863},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2872":59225,"_25347":59219,"_5":25680,"_17690":99865,"_23966":99866,"_2399":99867},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2872":59226,"_25347":59219,"_17690":99869,"_5":17585,"_23966":59219,"_2399":99870},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2872":59227,"_25347":59219,"_17690":99872,"_5":17585,"_23966":99850,"_2399":99873},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2872":59228,"_25347":59219,"_17690":99875,"_5":17585,"_23966":99850,"_2399":99876},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2872":59229,"_25347":59219,"_17690":99878,"_5":17585,"_23966":99850,"_2399":99879},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2872":59230,"_25347":59219,"_17690":99881,"_5":17585,"_23966":99850,"_2399":99882},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2872":59231,"_25347":59219,"_17690":99884,"_5":17585,"_23966":99854,"_2399":99885},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2872":59232,"_25347":59219,"_17690":99887,"_5":17585,"_23966":99854,"_2399":99888},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2872":59233,"_25347":59219,"_17690":99890,"_5":17585,"_23966":99858,"_2399":99891},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2872":59234,"_25347":59219,"_17690":99893,"_5":17585,"_23966":99858,"_2399":99894},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2872":59235,"_25347":59219,"_17690":99896,"_5":17585,"_23966":99858,"_2399":99897},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2872":59236,"_25347":59219,"_17690":99899,"_5":17585,"_23966":99862,"_2399":99900},[],"Situación",{"_2872":59237,"_25347":59219,"_17690":99902,"_5":17585,"_23966":99862,"_2399":99903},[],"Procedimiento",{"_2872":59238,"_25347":59219,"_17690":99905,"_5":17585,"_23966":99862,"_2399":99906},[],"Certificado vigente, fuera de ventana",{"_2872":59239,"_25347":59219,"_17690":99908,"_5":17585,"_23966":99862,"_2399":99909},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2872":59240,"_25347":59219,"_17690":99911,"_5":17585,"_23966":99862,"_2399":99912},[],"Certificado vencido, clave disponible",{"_2872":59241,"_25347":59219,"_17690":99914,"_5":17585,"_23966":99862,"_2399":99915},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2872":59242,"_25347":59219,"_17690":99917,"_5":17585,"_23966":99862,"_2399":99918},[],"Renovación por webhook o `NO_AUTH`",{"_2872":59243,"_25347":59219,"_17690":99920,"_5":17585,"_23966":99862,"_2399":99921},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2872":59244,"_25347":59219,"_17690":99923,"_5":17585,"_23966":99862,"_2399":99924},[],"Clave perdida o inaccesible",{"_2872":59245,"_25347":59219,"_17690":99926,"_5":17585,"_23966":99862,"_2399":99927},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2872":59246,"_25347":59219,"_17690":99929,"_5":17585,"_23966":99862,"_2399":99930},[],"Identidad actual revocada",{"_2872":59247,"_25347":59219,"_17690":99932,"_5":17585,"_23966":99862,"_2399":99933},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2872":59248,"_25347":59219,"_17690":99935,"_5":17585,"_23966":99862,"_2399":99936},[],"Dispositivo sin identidad",{"_2872":59249,"_25347":59219,"_17690":99938,"_5":17585,"_23966":99862,"_2399":99939},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2872":59250,"_25347":59219,"_17690":99941,"_5":17585,"_23966":99862,"_2399":99942},[],"Dispositivo retirado",{"_2872":59251,"_25347":59219,"_17690":99944,"_5":17585,"_23966":99862,"_2399":99945},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2872":59252,"_25347":59219,"_17690":99947,"_5":17585,"_23966":99862,"_2399":99948},[],"Timeout, HTTP 500 o fallo de instalación",{"_2872":59253,"_25347":59219,"_17690":99950,"_5":17585,"_23966":99862,"_2399":99951},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2872":59254,"_25347":59219,"_17690":99953,"_5":17585,"_23966":99866,"_2399":99954},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2872":59255,"_25347":59219,"_17690":99956,"_5":17585,"_23966":99866,"_2399":99957},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2872":59256,"_25347":59256,"_5":12438,"_2399":99959,"_25683":99960,"_17690":99961,"_23966":59256},"Diagnóstico de enrolamiento",[41104,97860,43471,98832,99007],[],{"_2872":59257,"_25347":59256,"_17690":99963,"_5":17585,"_23966":59256,"_2399":99964},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2872":59258,"_25347":59256,"_5":25680,"_17690":99966,"_23966":99967,"_2399":99968},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2872":59259,"_25347":59256,"_5":25680,"_17690":99970,"_23966":99971,"_2399":99972},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2872":59260,"_25347":59256,"_5":25680,"_17690":99974,"_23966":99975,"_2399":99531},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2872":59261,"_25347":59256,"_5":25680,"_17690":99977,"_23966":99978,"_2399":99979},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2872":59262,"_25347":59256,"_17690":99981,"_5":17585,"_23966":59256,"_2399":99982},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2872":59263,"_25347":59256,"_17690":99984,"_5":17585,"_23966":99971,"_2399":99985},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2872":59264,"_25347":59256,"_17690":99987,"_5":17585,"_23966":99971,"_2399":99988},[],"Síntoma o mensaje",{"_2872":59265,"_25347":59256,"_17690":99990,"_5":17585,"_23966":99971,"_2399":99991},[],"Qué revisar",{"_2872":59266,"_25347":59256,"_17690":99993,"_5":17585,"_23966":99971,"_2399":99994},[],"curl rechaza TLS, nombre o emisor",{"_2872":59267,"_25347":59256,"_17690":99996,"_5":17585,"_23966":99971,"_2399":99997},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2872":59268,"_25347":59256,"_17690":99999,"_5":17585,"_23966":99971,"_2399":100000},[],"404 o APS ausente",{"_2872":59269,"_25347":59256,"_17690":100002,"_5":17585,"_23966":99971,"_2399":100003},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2872":59270,"_25347":59256,"_17690":100005,"_5":17585,"_23966":99971,"_2399":100006},[],"400, error de CSR o formato",{"_2872":59271,"_25347":59256,"_17690":100008,"_5":17585,"_23966":99971,"_2399":100009},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2872":59272,"_25347":59256,"_17690":100011,"_5":17585,"_23966":99971,"_2399":100012},[],"Credencial ausente o certificado no válido",{"_2872":59273,"_25347":59256,"_17690":100014,"_5":17585,"_23966":99971,"_2399":100015},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2872":59274,"_25347":59256,"_17690":100017,"_5":17585,"_23966":99971,"_2399":100018},[],"Webhook deniega, expira o responde sin autorización",{"_2872":59275,"_25347":59256,"_17690":100020,"_5":17585,"_23966":99971,"_2399":100021},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2872":59276,"_25347":59256,"_17690":100023,"_5":17585,"_23966":99971,"_2399":44707},[],{"_2872":59277,"_25347":59256,"_17690":100025,"_5":17585,"_23966":99971,"_2399":100026},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2872":59278,"_25347":59256,"_17690":100028,"_5":17585,"_23966":99971,"_2399":44713},[],{"_2872":59279,"_25347":59256,"_17690":100030,"_5":17585,"_23966":99971,"_2399":100031},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2872":59280,"_25347":59256,"_17690":100033,"_5":17585,"_23966":99971,"_2399":44719},[],{"_2872":59281,"_25347":59256,"_17690":100035,"_5":17585,"_23966":99971,"_2399":100036},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2872":59282,"_25347":59256,"_17690":100038,"_5":17585,"_23966":99971,"_2399":100039},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2872":59283,"_25347":59256,"_17690":100041,"_5":17585,"_23966":99971,"_2399":100042},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2872":59284,"_25347":59256,"_17690":100044,"_5":17585,"_23966":99971,"_2399":100045},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2872":59285,"_25347":59256,"_17690":100047,"_5":17585,"_23966":99971,"_2399":100048},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2872":59286,"_25347":59256,"_17690":100050,"_5":17585,"_23966":99971,"_2399":44737},[],{"_2872":59287,"_25347":59256,"_17690":100052,"_5":17585,"_23966":99971,"_2399":100053},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2872":59288,"_25347":59256,"_17690":100055,"_5":17585,"_23966":99971,"_2399":44743},[],{"_2872":59289,"_25347":59256,"_17690":100057,"_5":17585,"_23966":99971,"_2399":100058},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2872":59290,"_25347":59256,"_17690":100060,"_5":17585,"_23966":99971,"_2399":100061},[],"DMS propietario distinto",{"_2872":59291,"_25347":59256,"_17690":100063,"_5":17585,"_23966":99971,"_2399":100064},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2872":59292,"_25347":59256,"_17690":100066,"_5":17585,"_23966":99971,"_2399":44755},[],{"_2872":59293,"_25347":59256,"_17690":100068,"_5":17585,"_23966":99971,"_2399":100069},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2872":59294,"_25347":59256,"_17690":100071,"_5":17585,"_23966":99971,"_2399":44761},[],{"_2872":59295,"_25347":59256,"_17690":100073,"_5":17585,"_23966":99971,"_2399":100074},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2872":59296,"_25347":59256,"_17690":100076,"_5":17585,"_23966":99971,"_2399":100077},[],"Certificado actual revocado",{"_2872":59297,"_25347":59256,"_17690":100079,"_5":17585,"_23966":99971,"_2399":100080},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2872":59298,"_25347":59256,"_17690":100082,"_5":17585,"_23966":99971,"_2399":100083},[],"Error de CA, perfil o firma",{"_2872":59299,"_25347":59256,"_17690":100085,"_5":17585,"_23966":99971,"_2399":100086},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2872":59300,"_25347":59256,"_17690":100088,"_5":17585,"_23966":99971,"_2399":100089},[],"HTTP 200 sin conexión del dispositivo",{"_2872":59301,"_25347":59256,"_17690":100091,"_5":17585,"_23966":99971,"_2399":100092},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2872":59302,"_25347":59256,"_17690":100094,"_5":17585,"_23966":99971,"_2399":100095},[],"Timeout o error después de emitir",{"_2872":59303,"_25347":59256,"_17690":100097,"_5":17585,"_23966":99971,"_2399":100098},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2872":59304,"_25347":59256,"_17690":100100,"_5":17585,"_23966":99975,"_2399":100101},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2872":59305,"_25347":59256,"_17690":100103,"_5":17585,"_23966":99975,"_2399":100104},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2872":59306,"_25347":59256,"_17690":100106,"_5":17585,"_23966":99978,"_2399":100107},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2872":59307,"_25347":59256,"_17690":100109,"_5":17585,"_23966":99978,"_2399":100110},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2872":59308,"_25347":59256,"_17690":100112,"_5":17585,"_23966":99978,"_2399":100113},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2872":59309,"_25347":59256,"_17690":100115,"_5":17585,"_23966":99978,"_2399":100116},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2872":59310,"_25347":59256,"_17690":100118,"_5":17585,"_23966":99978,"_2399":100119},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2872":59311,"_25347":59256,"_17690":100121,"_5":17585,"_23966":99978,"_2399":100122},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2872":59312,"_25347":59256,"_17690":100124,"_5":17585,"_23966":99978,"_2399":100125},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2872":59313,"_25347":59313,"_5":12438,"_2399":100127,"_25683":100128,"_17690":100129,"_23966":59313},"Distribución y actualización de confianza",[41104,97860,43471,98832,99007],[],{"_2872":59314,"_25347":59313,"_17690":100131,"_5":17585,"_23966":59313,"_2399":100132},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2872":59315,"_25347":59313,"_5":25680,"_17690":100134,"_23966":100135,"_2399":100136},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2872":59316,"_25347":59313,"_5":25680,"_17690":100138,"_23966":100139,"_2399":100140},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2872":59317,"_25347":59313,"_5":25680,"_17690":100142,"_23966":100143,"_2399":100144},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2872":59318,"_25347":59313,"_5":25680,"_17690":100146,"_23966":100147,"_2399":100148},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2872":59319,"_25347":59313,"_5":25680,"_17690":100150,"_23966":100151,"_2399":100152},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2872":59320,"_25347":59313,"_17690":100154,"_5":17585,"_23966":59313,"_2399":100155},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2872":59321,"_25347":59313,"_17690":100157,"_5":17585,"_23966":100135,"_2399":100158},[],"Relación",{"_2872":59322,"_25347":59313,"_17690":100160,"_5":17585,"_23966":100135,"_2399":100161},[],"Material que prepara el responsable",{"_2872":59323,"_25347":59313,"_17690":100163,"_5":17585,"_23966":100135,"_2399":100164},[],"Dispositivo → servidor EST",{"_2872":59324,"_25347":59313,"_17690":100166,"_5":17585,"_23966":100135,"_2399":100167},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2872":59325,"_25347":59313,"_17690":100169,"_5":17585,"_23966":100135,"_2399":100170},[],"DMS → solicitante",{"_2872":59326,"_25347":59313,"_17690":100172,"_5":17585,"_23966":100135,"_2399":100173},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2872":59327,"_25347":59313,"_17690":100175,"_5":17585,"_23966":100135,"_2399":100176},[],"Consumidor → dispositivo",{"_2872":59328,"_25347":59313,"_17690":100178,"_5":17585,"_23966":100135,"_2399":100179},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2872":59329,"_25347":59313,"_17690":100181,"_5":17585,"_23966":100135,"_2399":100182},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2872":59330,"_25347":59313,"_17690":100184,"_5":17585,"_23966":100139,"_2399":100185},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2872":59331,"_25347":59313,"_17690":100187,"_5":17585,"_23966":100139,"_2399":100188},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2872":59332,"_25347":59313,"_17690":100190,"_5":17585,"_23966":100143,"_2399":100191},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2872":59333,"_25347":59313,"_17690":100193,"_5":17585,"_23966":100143,"_2399":100194},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2872":59334,"_25347":59313,"_17690":100196,"_5":17585,"_23966":100143,"_2399":100197},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2872":59335,"_25347":59313,"_17690":100199,"_5":17585,"_23966":100143,"_2399":100200},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2872":59336,"_25347":59313,"_17690":100202,"_5":17585,"_23966":100143,"_2399":100203},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2872":59337,"_25347":59313,"_17690":100205,"_5":17585,"_23966":100143,"_2399":100206},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2872":59338,"_25347":59313,"_17690":100208,"_5":17585,"_23966":100147,"_2399":100209},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2872":59339,"_25347":59313,"_17690":100211,"_5":17585,"_23966":100147,"_2399":100212},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2872":59340,"_25347":59313,"_17690":100214,"_5":17585,"_23966":100147,"_2399":100215},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2872":59341,"_25347":59313,"_17690":100217,"_5":17585,"_23966":100151,"_2399":100218},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2872":59342,"_25347":59342,"_5":12438,"_2399":44910,"_25683":100220,"_17690":100222,"_23966":59342},[41104,97860,43471,98832,100221],"Integraciones",[],{"_2872":59343,"_25347":59342,"_17690":100224,"_5":17585,"_23966":59342,"_2399":100225},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2872":59344,"_25347":59342,"_5":25680,"_17690":100227,"_23966":100228,"_2399":100229},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2872":59345,"_25347":59342,"_5":25680,"_17690":100231,"_23966":100232,"_2399":100233},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2872":59346,"_25347":59342,"_5":25680,"_17690":100235,"_23966":100236,"_2399":100237},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2872":59347,"_25347":59342,"_5":25680,"_17690":100239,"_23966":100240,"_2399":100241},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2872":59348,"_25347":59342,"_5":25680,"_17690":100243,"_23966":100244,"_2399":100245},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2872":59349,"_25347":59342,"_5":25680,"_17690":100247,"_23966":100248,"_2399":100249},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2872":59350,"_25347":59342,"_5":25680,"_17690":100251,"_23966":100252,"_2399":44944},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2872":59351,"_25347":59342,"_5":25680,"_17690":100254,"_23966":100255,"_2399":44948},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2872":59352,"_25347":59342,"_5":25680,"_17690":100257,"_23966":100258,"_2399":100259},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2872":59353,"_25347":59342,"_5":25680,"_17690":100261,"_23966":100262,"_2399":100263},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2872":59354,"_25347":59342,"_5":25680,"_17690":100265,"_23966":100266,"_2399":100267},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2872":59355,"_25347":59342,"_5":25680,"_17690":100269,"_23966":100270,"_2399":100271},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2872":59356,"_25347":59342,"_5":25680,"_17690":100273,"_23966":100274,"_2399":100275},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2872":59357,"_25347":59342,"_5":25680,"_17690":100277,"_23966":100278,"_2399":100279},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2872":59358,"_25347":59342,"_5":25680,"_17690":100281,"_23966":100282,"_2399":100283},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2872":59359,"_25347":59342,"_5":25680,"_17690":100285,"_23966":100286,"_2399":100287},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2872":59360,"_25347":59342,"_5":25680,"_17690":100289,"_23966":100290,"_2399":100291},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2872":59361,"_25347":59342,"_5":25680,"_17690":100293,"_23966":100294,"_2399":100295},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2872":59362,"_25347":59342,"_5":25680,"_17690":100297,"_23966":100298,"_2399":100299},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2872":59363,"_25347":59342,"_5":25680,"_17690":100301,"_23966":100302,"_2399":100303},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2872":59364,"_25347":59342,"_17690":100305,"_5":17585,"_23966":59342,"_2399":100306},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2872":59365,"_25347":59342,"_17690":100308,"_5":17585,"_23966":59342,"_2399":100309},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2872":59366,"_25347":59342,"_17690":100311,"_5":17585,"_23966":59342,"_2399":100312},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2872":59367,"_25347":59342,"_17690":100314,"_5":17585,"_23966":100228,"_2399":100315},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2872":59368,"_25347":59342,"_17690":100317,"_5":17585,"_23966":100228,"_2399":100318},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2872":59369,"_25347":59342,"_17690":100320,"_5":17585,"_23966":100228,"_2399":100321},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2872":59370,"_25347":59342,"_17690":100323,"_5":17585,"_23966":100228,"_2399":100324},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2872":59371,"_25347":59342,"_17690":100326,"_5":17585,"_23966":100232,"_2399":100327},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2872":59372,"_25347":59342,"_17690":100329,"_5":17585,"_23966":100236,"_2399":100330},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2872":59373,"_25347":59342,"_17690":100332,"_5":17585,"_23966":100236,"_2399":100333},[],"Acción IAM",{"_2872":59374,"_25347":59342,"_17690":100335,"_5":17585,"_23966":100236,"_2399":96875},[],{"_2872":59375,"_25347":59342,"_17690":100337,"_5":17585,"_23966":100236,"_2399":45031},[],{"_2872":59376,"_25347":59342,"_17690":100339,"_5":17585,"_23966":100236,"_2399":100340},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2872":59377,"_25347":59342,"_17690":100342,"_5":17585,"_23966":100236,"_2399":45037},[],{"_2872":59378,"_25347":59342,"_17690":100344,"_5":17585,"_23966":100236,"_2399":100345},[],"Registrar la CA en AWS IoT",{"_2872":59379,"_25347":59342,"_17690":100347,"_5":17585,"_23966":100236,"_2399":45043},[],{"_2872":59380,"_25347":59342,"_17690":100349,"_5":17585,"_23966":100236,"_2399":100350},[],"Consultar el estado del registro de la CA",{"_2872":59381,"_25347":59342,"_17690":100352,"_5":17585,"_23966":100236,"_2399":45049},[],{"_2872":59382,"_25347":59342,"_17690":100354,"_5":17585,"_23966":100236,"_2399":100355},[],"Crear o actualizar Things en IoT Core",{"_2872":59383,"_25347":59342,"_17690":100357,"_5":17585,"_23966":100236,"_2399":45055},[],{"_2872":59384,"_25347":59342,"_17690":100359,"_5":17585,"_23966":100236,"_2399":100360},[],"Aprovisionar Things mediante plantilla",{"_2872":59385,"_25347":59342,"_17690":100362,"_5":17585,"_23966":100236,"_2399":45061},[],{"_2872":59386,"_25347":59342,"_17690":100364,"_5":17585,"_23966":100236,"_2399":100365},[],"Registrar certificados de dispositivo",{"_2872":59387,"_25347":59342,"_17690":100367,"_5":17585,"_23966":100236,"_2399":45067},[],{"_2872":59388,"_25347":59342,"_17690":100369,"_5":17585,"_23966":100236,"_2399":100370},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2872":59389,"_25347":59342,"_17690":100372,"_5":17585,"_23966":100236,"_2399":45073},[],{"_2872":59390,"_25347":59342,"_17690":100374,"_5":17585,"_23966":100236,"_2399":100375},[],"Crear y adjuntar políticas IoT",{"_2872":59391,"_25347":59342,"_17690":100377,"_5":17585,"_23966":100236,"_2399":45079},[],{"_2872":59392,"_25347":59342,"_17690":100379,"_5":17585,"_23966":100236,"_2399":100380},[],"Gestionar grupos de Things",{"_2872":59393,"_25347":59342,"_17690":100382,"_5":17585,"_23966":100236,"_2399":45085},[],{"_2872":59394,"_25347":59342,"_17690":100384,"_5":17585,"_23966":100236,"_2399":100385},[],"Crear plantillas JITP",{"_2872":59395,"_25347":59342,"_17690":100387,"_5":17585,"_23966":100236,"_2399":45091},[],{"_2872":59396,"_25347":59342,"_17690":100389,"_5":17585,"_23966":100236,"_2399":100390},[],"Leer y escribir el Device Shadow",{"_2872":59397,"_25347":59342,"_17690":100392,"_5":17585,"_23966":100236,"_2399":100393},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2872":59398,"_25347":59342,"_17690":100395,"_5":17585,"_23966":100240,"_2399":100396},[],"Parámetro",{"_2872":59399,"_25347":59342,"_17690":100398,"_5":17585,"_23966":100240,"_2399":100399},[],"Tipo",{"_2872":59400,"_25347":59342,"_17690":100401,"_5":17585,"_23966":100240,"_2399":100402},[],"Requerido",{"_2872":59401,"_25347":59342,"_17690":100404,"_5":17585,"_23966":100240,"_2399":100405},[],"Descripción",{"_2872":59402,"_25347":59342,"_17690":100407,"_5":17585,"_23966":100240,"_2399":45112},[],{"_2872":59403,"_25347":59342,"_17690":100409,"_5":17585,"_23966":100240,"_2399":21095},[],{"_2872":59404,"_25347":59342,"_17690":100411,"_5":17585,"_23966":100240,"_2399":100412},[],"Sí",{"_2872":59405,"_25347":59342,"_17690":100414,"_5":17585,"_23966":100240,"_2399":100415},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2872":59406,"_25347":59342,"_17690":100417,"_5":17585,"_23966":100240,"_2399":45123},[],{"_2872":59407,"_25347":59342,"_17690":100419,"_5":17585,"_23966":100240,"_2399":21095},[],{"_2872":59408,"_25347":59342,"_17690":100421,"_5":17585,"_23966":100240,"_2399":100412},[],{"_2872":59409,"_25347":59342,"_17690":100423,"_5":17585,"_23966":100240,"_2399":100424},[],"Región AWS donde opera el conector.",{"_2872":59410,"_25347":59342,"_17690":100426,"_5":17585,"_23966":100240,"_2399":45133},[],{"_2872":59411,"_25347":59342,"_17690":100428,"_5":17585,"_23966":100240,"_2399":21095},[],{"_2872":59412,"_25347":59342,"_17690":100430,"_5":17585,"_23966":100240,"_2399":100412},[],{"_2872":59413,"_25347":59342,"_17690":100432,"_5":17585,"_23966":100240,"_2399":100433},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2872":59414,"_25347":59342,"_17690":100435,"_5":17585,"_23966":100240,"_2399":45143},[],{"_2872":59415,"_25347":59342,"_17690":100437,"_5":17585,"_23966":100240,"_2399":21095},[],{"_2872":59416,"_25347":59342,"_17690":100439,"_5":17585,"_23966":100240,"_2399":100440},[],"Solo con `auth_method=static`",{"_2872":59417,"_25347":59342,"_17690":100442,"_5":17585,"_23966":100240,"_2399":100443},[],"Clave de acceso AWS.",{"_2872":59418,"_25347":59342,"_17690":100445,"_5":17585,"_23966":100240,"_2399":45154},[],{"_2872":59419,"_25347":59342,"_17690":100447,"_5":17585,"_23966":100240,"_2399":21095},[],{"_2872":59420,"_25347":59342,"_17690":100449,"_5":17585,"_23966":100240,"_2399":100440},[],{"_2872":59421,"_25347":59342,"_17690":100451,"_5":17585,"_23966":100240,"_2399":100452},[],"Clave secreta AWS.",{"_2872":59422,"_25347":59342,"_17690":100454,"_5":17585,"_23966":100240,"_2399":45164},[],{"_2872":59423,"_25347":59342,"_17690":100456,"_5":17585,"_23966":100240,"_2399":21095},[],{"_2872":59424,"_25347":59342,"_17690":100458,"_5":17585,"_23966":100240,"_2399":45169},[],{"_2872":59425,"_25347":59342,"_17690":100460,"_5":17585,"_23966":100240,"_2399":100461},[],"Token de sesión (con `auth_method=static`).",{"_2872":59426,"_25347":59342,"_17690":100463,"_5":17585,"_23966":100240,"_2399":45175},[],{"_2872":59427,"_25347":59342,"_17690":100465,"_5":17585,"_23966":100240,"_2399":21095},[],{"_2872":59428,"_25347":59342,"_17690":100467,"_5":17585,"_23966":100240,"_2399":100468},[],"Solo con `auth_method=role`",{"_2872":59429,"_25347":59342,"_17690":100470,"_5":17585,"_23966":100240,"_2399":100471},[],"ARN del rol a asumir.",{"_2872":59430,"_25347":59342,"_17690":100473,"_5":17585,"_23966":100240,"_2399":45186},[],{"_2872":59431,"_25347":59342,"_17690":100475,"_5":17585,"_23966":100240,"_2399":21095},[],{"_2872":59432,"_25347":59342,"_17690":100477,"_5":17585,"_23966":100240,"_2399":45169},[],{"_2872":59433,"_25347":59342,"_17690":100479,"_5":17585,"_23966":100240,"_2399":100480},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2872":59434,"_25347":59342,"_17690":100482,"_5":17585,"_23966":100240,"_2399":45196},[],{"_2872":59435,"_25347":59342,"_17690":100484,"_5":17585,"_23966":100240,"_2399":14868},[],{"_2872":59436,"_25347":59342,"_17690":100486,"_5":17585,"_23966":100240,"_2399":100412},[],{"_2872":59437,"_25347":59342,"_17690":100488,"_5":17585,"_23966":100240,"_2399":100489},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2872":59438,"_25347":59342,"_17690":100491,"_5":17585,"_23966":100240,"_2399":45206},[],{"_2872":59439,"_25347":59342,"_17690":100493,"_5":17585,"_23966":100240,"_2399":21095},[],{"_2872":59440,"_25347":59342,"_17690":100495,"_5":17585,"_23966":100240,"_2399":100412},[],{"_2872":59441,"_25347":59342,"_17690":100497,"_5":17585,"_23966":100240,"_2399":100498},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2872":59442,"_25347":59342,"_17690":100500,"_5":17585,"_23966":100240,"_2399":45216},[],{"_2872":59443,"_25347":59342,"_17690":100502,"_5":17585,"_23966":100240,"_2399":21095},[],{"_2872":59444,"_25347":59342,"_17690":100504,"_5":17585,"_23966":100240,"_2399":100412},[],{"_2872":59445,"_25347":59342,"_17690":100506,"_5":17585,"_23966":100240,"_2399":100507},[],"URL HTTP del Device Manager de Lamassu.",{"_2872":59446,"_25347":59342,"_17690":100509,"_5":17585,"_23966":100240,"_2399":45226},[],{"_2872":59447,"_25347":59342,"_17690":100511,"_5":17585,"_23966":100240,"_2399":21095},[],{"_2872":59448,"_25347":59342,"_17690":100513,"_5":17585,"_23966":100240,"_2399":100412},[],{"_2872":59449,"_25347":59342,"_17690":100515,"_5":17585,"_23966":100240,"_2399":100516},[],"URL HTTP del servicio de CA de Lamassu.",{"_2872":59450,"_25347":59342,"_17690":100518,"_5":17585,"_23966":100244,"_2399":100519},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2872":59451,"_25347":59342,"_17690":100521,"_5":17585,"_23966":100248,"_2399":100522},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2872":59452,"_25347":59342,"_17690":100524,"_5":17585,"_23966":100248,"_2399":100525},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2872":59453,"_25347":59342,"_17690":100527,"_5":17585,"_23966":100252,"_2399":100528},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2872":59454,"_25347":59342,"_17690":100530,"_5":17585,"_23966":100252,"_2399":100531},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2872":59455,"_25347":59342,"_17690":100533,"_5":17585,"_23966":100252,"_2399":100534},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2872":59456,"_25347":59342,"_17690":100536,"_5":17585,"_23966":100252,"_2399":100537},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2872":59457,"_25347":59342,"_17690":100539,"_5":17585,"_23966":100252,"_2399":100540},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2872":59458,"_25347":59342,"_17690":100542,"_5":17585,"_23966":100252,"_2399":100543},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2872":59459,"_25347":59342,"_17690":100545,"_5":17585,"_23966":100255,"_2399":100546},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2872":59460,"_25347":59342,"_17690":100548,"_5":17585,"_23966":100258,"_2399":100549},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2872":59461,"_25347":59342,"_17690":100551,"_5":17585,"_23966":100258,"_2399":100552},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2872":59462,"_25347":59342,"_17690":100554,"_5":17585,"_23966":100262,"_2399":100555},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2872":59463,"_25347":59342,"_17690":100557,"_5":17585,"_23966":100266,"_2399":100558},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2872":59464,"_25347":59342,"_17690":100560,"_5":17585,"_23966":100266,"_2399":100561},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2872":59465,"_25347":59342,"_17690":100563,"_5":17585,"_23966":100266,"_2399":100564},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2872":59466,"_25347":59342,"_17690":100566,"_5":17585,"_23966":100266,"_2399":100567},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2872":59467,"_25347":59342,"_17690":100569,"_5":17585,"_23966":100266,"_2399":100570},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2872":59468,"_25347":59342,"_17690":100572,"_5":17585,"_23966":100266,"_2399":100573},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2872":59469,"_25347":59342,"_17690":100575,"_5":17585,"_23966":100270,"_2399":100576},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2872":59470,"_25347":59342,"_17690":100578,"_5":17585,"_23966":100270,"_2399":100579},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2872":59471,"_25347":59342,"_17690":100581,"_5":17585,"_23966":100270,"_2399":100582},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2872":59472,"_25347":59342,"_17690":100584,"_5":17585,"_23966":100274,"_2399":100585},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2872":59473,"_25347":59342,"_17690":100587,"_5":17585,"_23966":100274,"_2399":100588},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2872":59474,"_25347":59342,"_17690":100590,"_5":17585,"_23966":100274,"_2399":100591},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2872":59475,"_25347":59342,"_17690":100593,"_5":17585,"_23966":100278,"_2399":100594},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2872":59476,"_25347":59342,"_17690":100596,"_5":17585,"_23966":100278,"_2399":100597},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2872":59477,"_25347":59342,"_17690":100599,"_5":17585,"_23966":100278,"_2399":100600},[],"Para que el flujo JITP funcione correctamente:",{"_2872":59478,"_25347":59342,"_17690":100602,"_5":17585,"_23966":100278,"_2399":100603},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2872":59479,"_25347":59342,"_17690":100605,"_5":17585,"_23966":100278,"_2399":100606},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2872":59480,"_25347":59342,"_17690":100608,"_5":17585,"_23966":100278,"_2399":100609},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2872":59481,"_25347":59342,"_17690":100611,"_5":17585,"_23966":100278,"_2399":100612},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2872":59482,"_25347":59342,"_17690":100614,"_5":17585,"_23966":100282,"_2399":100615},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2872":59483,"_25347":59342,"_17690":100617,"_5":17585,"_23966":100282,"_2399":100618},[],"Estado en Lamassu",{"_2872":59484,"_25347":59342,"_17690":100620,"_5":17585,"_23966":100282,"_2399":100621},[],"Razón de revocación",{"_2872":59485,"_25347":59342,"_17690":100623,"_5":17585,"_23966":100282,"_2399":100624},[],"Estado en AWS IoT Core",{"_2872":59486,"_25347":59342,"_17690":100626,"_5":17585,"_23966":100282,"_2399":45347},[],{"_2872":59487,"_25347":59342,"_17690":100628,"_5":17585,"_23966":100282,"_2399":100629},[],"Ninguna",{"_2872":59488,"_25347":59342,"_17690":100631,"_5":17585,"_23966":100282,"_2399":45353},[],{"_2872":59489,"_25347":59342,"_17690":100633,"_5":17585,"_23966":100282,"_2399":45356},[],{"_2872":59490,"_25347":59342,"_17690":100635,"_5":17585,"_23966":100282,"_2399":45359},[],{"_2872":59491,"_25347":59342,"_17690":100637,"_5":17585,"_23966":100282,"_2399":45362},[],{"_2872":59492,"_25347":59342,"_17690":100639,"_5":17585,"_23966":100282,"_2399":45356},[],{"_2872":59493,"_25347":59342,"_17690":100641,"_5":17585,"_23966":100282,"_2399":100642},[],"Cualquier otra razón",{"_2872":59494,"_25347":59342,"_17690":100644,"_5":17585,"_23966":100282,"_2399":45370},[],{"_2872":59495,"_25347":59342,"_17690":100646,"_5":17585,"_23966":100282,"_2399":100647},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2872":59496,"_25347":59342,"_17690":100649,"_5":17585,"_23966":100286,"_2399":100650},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2872":59497,"_25347":59342,"_17690":100652,"_5":17585,"_23966":100286,"_2399":100653},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2872":59498,"_25347":59342,"_17690":100655,"_5":17585,"_23966":100286,"_2399":100656},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2872":59499,"_25347":59342,"_17690":100658,"_5":17585,"_23966":100290,"_2399":100659},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2872":59500,"_25347":59342,"_17690":100661,"_5":17585,"_23966":100290,"_2399":100662},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2872":59501,"_25347":59342,"_17690":100664,"_5":17585,"_23966":100294,"_2399":100665},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2872":59502,"_25347":59342,"_17690":100667,"_5":17585,"_23966":100294,"_2399":100668},[],"Existen dos tipos de acciones:",{"_2872":59503,"_25347":59342,"_17690":100670,"_5":17585,"_23966":100294,"_2399":100671},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2872":59504,"_25347":59342,"_17690":100673,"_5":17585,"_23966":100294,"_2399":100674},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2872":59505,"_25347":59342,"_17690":100676,"_5":17585,"_23966":100294,"_2399":100677},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2872":59506,"_25347":59342,"_17690":100679,"_5":17585,"_23966":100298,"_2399":100680},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2872":59507,"_25347":59342,"_17690":100682,"_5":17585,"_23966":100298,"_2399":100683},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2872":59508,"_25347":59342,"_17690":100685,"_5":17585,"_23966":100298,"_2399":100686},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2872":59509,"_25347":59342,"_17690":100688,"_5":17585,"_23966":100302,"_2399":100689},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2872":59510,"_25347":59342,"_17690":100691,"_5":17585,"_23966":100302,"_2399":100692},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2872":59511,"_25347":59342,"_17690":100694,"_5":17585,"_23966":100302,"_2399":100695},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2872":59512,"_25347":59342,"_17690":100697,"_5":17585,"_23966":100302,"_2399":100698},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2872":59513,"_25347":59342,"_17690":100700,"_5":17585,"_23966":100302,"_2399":100701},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2872":59514,"_25347":59342,"_17690":100703,"_5":17585,"_23966":100302,"_2399":100704},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2872":59515,"_25347":59342,"_17690":100706,"_5":17585,"_23966":100302,"_2399":100707},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2872":59516,"_25347":59342,"_17690":100709,"_5":17585,"_23966":100302,"_2399":100710},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2872":59517,"_25347":59342,"_17690":100712,"_5":17585,"_23966":100302,"_2399":100713},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2872":59518,"_25347":59342,"_17690":100715,"_5":17585,"_23966":100302,"_2399":100716},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2872":59519,"_25347":59342,"_17690":100718,"_5":17585,"_23966":100302,"_2399":100719},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2872":59520,"_25347":59342,"_17690":100721,"_5":17585,"_23966":100302,"_2399":100722},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2872":59521,"_25347":59342,"_17690":100724,"_5":17585,"_23966":100302,"_2399":100725},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2872":59522,"_25347":59342,"_17690":100727,"_5":17585,"_23966":100302,"_2399":100728},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2872":59523,"_25347":59342,"_17690":100730,"_5":17585,"_23966":100302,"_2399":100731},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2872":59524,"_25347":59342,"_17690":100733,"_5":17585,"_23966":100302,"_2399":100734},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2872":59525,"_25347":59342,"_17690":100736,"_5":17585,"_23966":100302,"_2399":100737},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2872":59526,"_25347":59342,"_17690":100739,"_5":17585,"_23966":100302,"_2399":100740},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2872":59527,"_25347":59342,"_17690":100742,"_5":17585,"_23966":100302,"_2399":100743},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2872":59528,"_25347":59342,"_17690":100745,"_5":17585,"_23966":100302,"_2399":100746},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2872":59529,"_25347":59342,"_17690":100748,"_5":17585,"_23966":100302,"_2399":100749},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2872":59530,"_25347":59530,"_5":12438,"_2399":43471,"_25683":100751,"_17690":100752,"_23966":59530},[41104,97860,43471],[],{"_2872":59531,"_25347":59530,"_17690":100754,"_5":17585,"_23966":59530,"_2399":100755},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2872":59532,"_25347":59530,"_5":25680,"_17690":100757,"_23966":100758,"_2399":100759},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2872":59533,"_25347":59530,"_5":25680,"_17690":100761,"_23966":100762,"_2399":98832},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2872":59534,"_25347":59530,"_5":25680,"_17690":100764,"_23966":100765,"_2399":99007},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2872":59535,"_25347":59530,"_5":25680,"_17690":100767,"_23966":100768,"_2399":100221},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#integraciones",{"_2872":59536,"_25347":59530,"_5":25680,"_17690":100770,"_23966":100771,"_2399":100772},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2872":59537,"_25347":59530,"_17690":100774,"_5":17585,"_23966":59530,"_2399":100775},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2872":59538,"_25347":59530,"_17690":100777,"_5":17585,"_23966":100758,"_2399":100778},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2872":59539,"_25347":59530,"_17690":100780,"_5":17585,"_23966":100758,"_2399":100781},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2872":59540,"_25347":59530,"_17690":100783,"_5":17585,"_23966":100762,"_2399":100784},[],"Recurso",{"_2872":59541,"_25347":59530,"_17690":100786,"_5":17585,"_23966":100762,"_2399":100787},[],"Qué representa",{"_2872":59542,"_25347":59530,"_17690":100789,"_5":17585,"_23966":100762,"_2399":100790},[],"**Dispositivo**",{"_2872":59543,"_25347":59530,"_17690":100792,"_5":17585,"_23966":100762,"_2399":100793},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2872":59544,"_25347":59530,"_17690":100795,"_5":17585,"_23966":100762,"_2399":100796},[],"**Identidad**",{"_2872":59545,"_25347":59530,"_17690":100798,"_5":17585,"_23966":100762,"_2399":100799},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2872":59546,"_25347":59530,"_17690":100801,"_5":17585,"_23966":100762,"_2399":45528},[],{"_2872":59547,"_25347":59530,"_17690":100803,"_5":17585,"_23966":100762,"_2399":100804},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2872":59548,"_25347":59530,"_17690":100806,"_5":17585,"_23966":100762,"_2399":100807},[],"**Flota**",{"_2872":59549,"_25347":59530,"_17690":100809,"_5":17585,"_23966":100762,"_2399":100810},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2872":59550,"_25347":59530,"_17690":100812,"_5":17585,"_23966":100762,"_2399":100813},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2872":59551,"_25347":59530,"_17690":100815,"_5":17585,"_23966":100762,"_2399":100816},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2872":59552,"_25347":59530,"_17690":100818,"_5":17585,"_23966":100765,"_2399":100819},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2872":59553,"_25347":59530,"_17690":100821,"_5":17585,"_23966":100765,"_2399":100822},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2872":59554,"_25347":59530,"_17690":100824,"_5":17585,"_23966":100765,"_2399":100825},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2872":59555,"_25347":59530,"_17690":100827,"_5":17585,"_23966":100765,"_2399":100828},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2872":59556,"_25347":59530,"_17690":100830,"_5":17585,"_23966":100765,"_2399":100831},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2872":59557,"_25347":59530,"_17690":100833,"_5":17585,"_23966":100765,"_2399":100834},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2872":59558,"_25347":59530,"_17690":100836,"_5":17585,"_23966":100765,"_2399":100837},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2872":59559,"_25347":59530,"_17690":100839,"_5":17585,"_23966":100765,"_2399":100840},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2872":59560,"_25347":59530,"_17690":100842,"_5":17585,"_23966":100768,"_2399":100843},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2872":59561,"_25347":59530,"_17690":100845,"_5":17585,"_23966":100768,"_2399":100846},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2872":59562,"_25347":59530,"_17690":100848,"_5":17585,"_23966":100771,"_2399":100849},[],"Participante",{"_2872":59563,"_25347":59530,"_17690":100851,"_5":17585,"_23966":100771,"_2399":100852},[],"Responsabilidad",{"_2872":59564,"_25347":59530,"_17690":100854,"_5":17585,"_23966":100771,"_2399":100855},[],"Administrador PKI",{"_2872":59565,"_25347":59530,"_17690":100857,"_5":17585,"_23966":100771,"_2399":100858},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2872":59566,"_25347":59530,"_17690":100860,"_5":17585,"_23966":100771,"_2399":100861},[],"Administrador del aprovisionamiento",{"_2872":59567,"_25347":59530,"_17690":100863,"_5":17585,"_23966":100771,"_2399":100864},[],"DMS, admisión, autenticación por operación e inventario.",{"_2872":59568,"_25347":59530,"_17690":100866,"_5":17585,"_23966":100771,"_2399":100867},[],"Integrador del dispositivo",{"_2872":59569,"_25347":59530,"_17690":100869,"_5":17585,"_23966":100771,"_2399":100870},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2872":59570,"_25347":59530,"_17690":100872,"_5":17585,"_23966":100771,"_2399":100873},[],"Integrador del consumidor",{"_2872":59571,"_25347":59530,"_17690":100875,"_5":17585,"_23966":100771,"_2399":100876},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2872":59572,"_25347":59530,"_17690":100878,"_5":17585,"_23966":100771,"_2399":100879},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2872":59573,"_25347":59573,"_5":12438,"_2399":100881,"_25683":100882,"_17690":100884,"_23966":59573},"Enrola y conecta tu primer dispositivo",[41104,97860,43471,100883],"Primeros pasos",[],{"_2872":59574,"_25347":59573,"_17690":100886,"_5":17585,"_23966":59573,"_2399":100887},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2872":59575,"_25347":59573,"_5":25680,"_17690":100889,"_23966":100890,"_2399":96512},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2872":59576,"_25347":59573,"_5":25680,"_17690":100892,"_23966":100893,"_2399":100894},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2872":59577,"_25347":59573,"_5":25680,"_17690":100896,"_23966":100897,"_2399":100898},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2872":59578,"_25347":59573,"_5":25680,"_17690":100900,"_23966":100901,"_2399":100902},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2872":59579,"_25347":59573,"_5":25680,"_17690":100904,"_23966":100905,"_2399":100906},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2872":59580,"_25347":59573,"_5":25680,"_17690":100908,"_23966":100909,"_2399":100910},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2872":59581,"_25347":59573,"_5":25680,"_17690":100912,"_23966":100913,"_2399":100914},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2872":59582,"_25347":59573,"_5":25680,"_17690":100916,"_23966":100917,"_2399":100918},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2872":59583,"_25347":59573,"_17690":100920,"_5":17585,"_23966":59573,"_2399":100921},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2872":59584,"_25347":59573,"_17690":100923,"_5":17585,"_23966":100890,"_2399":100924},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2872":59585,"_25347":59573,"_17690":100926,"_5":17585,"_23966":100890,"_2399":100927},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2872":59586,"_25347":59573,"_17690":100929,"_5":17585,"_23966":100890,"_2399":100930},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2872":59587,"_25347":59573,"_17690":100932,"_5":17585,"_23966":100890,"_2399":100933},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2872":59588,"_25347":59573,"_17690":100935,"_5":17585,"_23966":100890,"_2399":100936},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2872":59589,"_25347":59573,"_17690":100938,"_5":17585,"_23966":100893,"_2399":100939},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2872":59590,"_25347":59573,"_17690":100941,"_5":17585,"_23966":100893,"_2399":100942},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2872":59591,"_25347":59573,"_17690":100944,"_5":17585,"_23966":100897,"_2399":100945},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2872":59592,"_25347":59573,"_17690":100947,"_5":17585,"_23966":100897,"_2399":100948},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2872":59593,"_25347":59573,"_17690":100950,"_5":17585,"_23966":100897,"_2399":100951},[],"Ajuste",{"_2872":59594,"_25347":59573,"_17690":100953,"_5":17585,"_23966":100897,"_2399":100954},[],"Valor de evaluación",{"_2872":59595,"_25347":59573,"_17690":100956,"_5":17585,"_23966":100897,"_2399":45684},[],{"_2872":59596,"_25347":59573,"_17690":100958,"_5":17585,"_23966":100897,"_2399":100959},[],"Raíz emisora de `device-root.pem`.",{"_2872":59597,"_25347":59573,"_17690":100961,"_5":17585,"_23966":100897,"_2399":99135},[],{"_2872":59598,"_25347":59573,"_17690":100963,"_5":17585,"_23966":100897,"_2399":100964},[],"Perfil final de 1 hora que acabas de preparar.",{"_2872":59599,"_25347":59573,"_17690":100966,"_5":17585,"_23966":100897,"_2399":45695},[],{"_2872":59600,"_25347":59573,"_17690":100968,"_5":17585,"_23966":100897,"_2399":45698},[],{"_2872":59601,"_25347":59573,"_17690":100970,"_5":17585,"_23966":100897,"_2399":45701},[],{"_2872":59602,"_25347":59573,"_17690":100972,"_5":17585,"_23966":100897,"_2399":100973},[],"Habilitado.",{"_2872":59603,"_25347":59573,"_17690":100975,"_5":17585,"_23966":100897,"_2399":45707},[],{"_2872":59604,"_25347":59573,"_17690":100977,"_5":17585,"_23966":100897,"_2399":100978},[],"Deshabilitado; el ID debe ser nuevo.",{"_2872":59605,"_25347":59573,"_17690":100980,"_5":17585,"_23966":100897,"_2399":100981},[],"Autenticación inicial",{"_2872":59606,"_25347":59573,"_17690":100983,"_5":17585,"_23966":100897,"_2399":100984},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2872":59607,"_25347":59573,"_17690":100986,"_5":17585,"_23966":100897,"_2399":100987},[],"Autenticación de renovación",{"_2872":59608,"_25347":59573,"_17690":100989,"_5":17585,"_23966":100897,"_2399":100990},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2872":59609,"_25347":59573,"_17690":100992,"_5":17585,"_23966":100897,"_2399":45725},[],{"_2872":59610,"_25347":59573,"_17690":100994,"_5":17585,"_23966":100897,"_2399":100995},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2872":59611,"_25347":59573,"_17690":100997,"_5":17585,"_23966":100897,"_2399":45731},[],{"_2872":59612,"_25347":59573,"_17690":100999,"_5":17585,"_23966":100897,"_2399":101000},[],"1 hora.",{"_2872":59613,"_25347":59573,"_17690":101002,"_5":17585,"_23966":100897,"_2399":45737},[],{"_2872":59614,"_25347":59573,"_17690":101004,"_5":17585,"_23966":100897,"_2399":101005},[],"30 minutos / 10 minutos.",{"_2872":59615,"_25347":59573,"_17690":101007,"_5":17585,"_23966":100897,"_2399":45743},[],{"_2872":59616,"_25347":59573,"_17690":101009,"_5":17585,"_23966":100897,"_2399":101010},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2872":59617,"_25347":59573,"_17690":101012,"_5":17585,"_23966":100897,"_2399":43790},[],{"_2872":59618,"_25347":59573,"_17690":101014,"_5":17585,"_23966":100897,"_2399":101015},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2872":59619,"_25347":59573,"_17690":101017,"_5":17585,"_23966":100897,"_2399":45754},[],{"_2872":59620,"_25347":59573,"_17690":101019,"_5":17585,"_23966":100897,"_2399":101020},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2872":59621,"_25347":59573,"_17690":101022,"_5":17585,"_23966":100897,"_2399":101023},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2872":59622,"_25347":59573,"_17690":101025,"_5":17585,"_23966":100901,"_2399":101026},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2872":59623,"_25347":59573,"_17690":101028,"_5":17585,"_23966":100901,"_2399":101029},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2872":59624,"_25347":59573,"_17690":101031,"_5":17585,"_23966":100905,"_2399":101032},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2872":59625,"_25347":59573,"_17690":101034,"_5":17585,"_23966":100905,"_2399":101035},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2872":59626,"_25347":59573,"_17690":101037,"_5":17585,"_23966":100905,"_2399":101038},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2872":59627,"_25347":59573,"_17690":101040,"_5":17585,"_23966":100909,"_2399":101041},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2872":59628,"_25347":59573,"_17690":101043,"_5":17585,"_23966":100909,"_2399":101044},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2872":59629,"_25347":59573,"_17690":101046,"_5":17585,"_23966":100913,"_2399":101047},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2872":59630,"_25347":59573,"_17690":101049,"_5":17585,"_23966":100913,"_2399":101050},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2872":59631,"_25347":59573,"_17690":101052,"_5":17585,"_23966":100913,"_2399":101053},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2872":59632,"_25347":59573,"_17690":101055,"_5":17585,"_23966":100913,"_2399":101056},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2872":59633,"_25347":59573,"_17690":101058,"_5":17585,"_23966":100913,"_2399":101059},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2872":59634,"_25347":59573,"_17690":101061,"_5":17585,"_23966":100917,"_2399":101062},[],"Comprobación",{"_2872":59635,"_25347":59573,"_17690":101064,"_5":17585,"_23966":100917,"_2399":101065},[],"Resultado esperado",{"_2872":59636,"_25347":59573,"_17690":101067,"_5":17585,"_23966":100917,"_2399":101068},[],"Registro",{"_2872":59637,"_25347":59573,"_17690":101070,"_5":17585,"_23966":100917,"_2399":101071},[],"ID creado automáticamente y DMS correcto.",{"_2872":59638,"_25347":59573,"_17690":101073,"_5":17585,"_23966":100917,"_2399":101074},[],"Certificado",{"_2872":59639,"_25347":59573,"_17690":101076,"_5":17585,"_23966":100917,"_2399":101077},[],"CN, perfil, serie y clave verificados.",{"_2872":59640,"_25347":59573,"_17690":101079,"_5":17585,"_23966":100917,"_2399":101080},[],"Inventario",{"_2872":59641,"_25347":59573,"_17690":101082,"_5":17585,"_23966":100917,"_2399":101083},[],"Serie recibida visible como identidad actual y en el historial.",{"_2872":59642,"_25347":59573,"_17690":101085,"_5":17585,"_23966":100917,"_2399":101086},[],"Consumidor",{"_2872":59643,"_25347":59573,"_17690":101088,"_5":17585,"_23966":100917,"_2399":101089},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2872":59644,"_25347":59573,"_17690":101091,"_5":17585,"_23966":100917,"_2399":101092},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2872":59645,"_25347":59573,"_17690":101094,"_5":17585,"_23966":100917,"_2399":101095},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2872":59646,"_25347":59646,"_5":12438,"_2399":98849,"_25683":101097,"_17690":101098,"_23966":59646},[41104,97860,43471,100883],[],{"_2872":59647,"_25347":59646,"_17690":101100,"_5":17585,"_23966":59646,"_2399":101101},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2872":59648,"_25347":59646,"_5":25680,"_17690":101103,"_23966":101104,"_2399":96512},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2872":59649,"_25347":59646,"_5":25680,"_17690":101106,"_23966":101107,"_2399":101108},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2872":59650,"_25347":59646,"_5":25680,"_17690":101110,"_23966":101111,"_2399":101112},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2872":59651,"_25347":59646,"_5":25680,"_17690":101114,"_23966":101115,"_2399":101116},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2872":59652,"_25347":59646,"_5":25680,"_17690":101118,"_23966":101119,"_2399":101120},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2872":59653,"_25347":59646,"_5":25680,"_17690":101122,"_23966":101123,"_2399":101124},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2872":59654,"_25347":59646,"_5":25680,"_17690":101126,"_23966":101127,"_2399":101065},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2872":59655,"_25347":59646,"_5":25680,"_17690":101129,"_23966":101130,"_2399":101131},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2872":59656,"_25347":59646,"_5":25680,"_17690":101133,"_23966":101134,"_2399":101135},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2872":59657,"_25347":59646,"_17690":101137,"_5":17585,"_23966":59646,"_2399":101138},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2872":59658,"_25347":59646,"_17690":101140,"_5":17585,"_23966":59646,"_2399":101141},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2872":59659,"_25347":59646,"_17690":101143,"_5":17585,"_23966":101104,"_2399":101144},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2872":59660,"_25347":59646,"_17690":101146,"_5":17585,"_23966":101104,"_2399":101147},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2872":59661,"_25347":59646,"_17690":101149,"_5":17585,"_23966":101104,"_2399":101150},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2872":59662,"_25347":59646,"_17690":101152,"_5":17585,"_23966":101104,"_2399":101153},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2872":59663,"_25347":59646,"_17690":101155,"_5":17585,"_23966":101107,"_2399":101156},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2872":59664,"_25347":59646,"_17690":101158,"_5":17585,"_23966":101107,"_2399":101159},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2872":59665,"_25347":59646,"_17690":101161,"_5":17585,"_23966":101107,"_2399":101162},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2872":59666,"_25347":59646,"_17690":101164,"_5":17585,"_23966":101107,"_2399":101165},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2872":59667,"_25347":59646,"_17690":101167,"_5":17585,"_23966":101107,"_2399":101168},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2872":59668,"_25347":59646,"_17690":101170,"_5":17585,"_23966":101107,"_2399":101171},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2872":59669,"_25347":59646,"_17690":101173,"_5":17585,"_23966":101107,"_2399":101174},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2872":59670,"_25347":59646,"_17690":101176,"_5":17585,"_23966":101107,"_2399":101177},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2872":59671,"_25347":59646,"_17690":101179,"_5":17585,"_23966":101111,"_2399":101180},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2872":59672,"_25347":59646,"_17690":101182,"_5":17585,"_23966":101111,"_2399":45920},[],{"_2872":59673,"_25347":59646,"_17690":101184,"_5":17585,"_23966":101111,"_2399":101185},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2872":59674,"_25347":59646,"_17690":101187,"_5":17585,"_23966":101111,"_2399":101188},[],"**Icon** y **Tags**: clasificación opcional.",{"_2872":59675,"_25347":59646,"_17690":101190,"_5":17585,"_23966":101111,"_2399":101191},[],"Confirma el registro.",{"_2872":59676,"_25347":59646,"_17690":101193,"_5":17585,"_23966":101115,"_2399":101194},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2872":59677,"_25347":59646,"_17690":101196,"_5":17585,"_23966":101115,"_2399":101197},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2872":59678,"_25347":59646,"_17690":101199,"_5":17585,"_23966":101119,"_2399":101200},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2872":59679,"_25347":59646,"_17690":101202,"_5":17585,"_23966":101119,"_2399":101203},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2872":59680,"_25347":59646,"_17690":101205,"_5":17585,"_23966":101123,"_2399":101206},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2872":59681,"_25347":59646,"_17690":101208,"_5":17585,"_23966":101123,"_2399":101209},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2872":59682,"_25347":59646,"_17690":101211,"_5":17585,"_23966":101127,"_2399":101062},[],{"_2872":59683,"_25347":59646,"_17690":101213,"_5":17585,"_23966":101127,"_2399":101214},[],"Resultado",{"_2872":59684,"_25347":59646,"_17690":101216,"_5":17585,"_23966":101127,"_2399":101217},[],"Dispositivo",{"_2872":59685,"_25347":59646,"_17690":101219,"_5":17585,"_23966":101127,"_2399":101220},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2872":59686,"_25347":59646,"_17690":101222,"_5":17585,"_23966":101127,"_2399":101223},[],"Identidad actual",{"_2872":59687,"_25347":59646,"_17690":101225,"_5":17585,"_23966":101127,"_2399":101226},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2872":59688,"_25347":59646,"_17690":101228,"_5":17585,"_23966":101127,"_2399":101229},[],"Historial",{"_2872":59689,"_25347":59646,"_17690":101231,"_5":17585,"_23966":101127,"_2399":101232},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2872":59690,"_25347":59646,"_17690":101234,"_5":17585,"_23966":101127,"_2399":101235},[],"Clave y certificado",{"_2872":59691,"_25347":59646,"_17690":101237,"_5":17585,"_23966":101127,"_2399":101238},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2872":59692,"_25347":59646,"_17690":101240,"_5":17585,"_23966":101130,"_2399":101241},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2872":59693,"_25347":59646,"_17690":101243,"_5":17585,"_23966":101130,"_2399":101244},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2872":59694,"_25347":59646,"_17690":101246,"_5":17585,"_23966":101130,"_2399":101247},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2872":59695,"_25347":59646,"_17690":101249,"_5":17585,"_23966":101130,"_2399":101250},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2872":59696,"_25347":59646,"_17690":101252,"_5":17585,"_23966":101134,"_2399":101253},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2872":59697,"_25347":59646,"_17690":101255,"_5":17585,"_23966":101134,"_2399":101256},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2872":59698,"_25347":59646,"_17690":101258,"_5":17585,"_23966":101134,"_2399":101259},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2872":59699,"_25347":59699,"_5":12438,"_2399":101261,"_25683":101262,"_17690":101263,"_23966":59699},"Plataforma Lamassu IoT",[41104,97860],[],{"_2872":59700,"_25347":59699,"_17690":101265,"_5":17585,"_23966":59699,"_2399":101266},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2872":59701,"_25347":59699,"_5":25680,"_17690":101268,"_23966":101269,"_2399":100759},[],"/docs/pr-preview/pr-42/es/platform/overview#empieza-aquí",{"_2872":59702,"_25347":59699,"_5":25680,"_17690":101271,"_23966":101272,"_2399":101273},[],"/docs/pr-preview/pr-42/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2872":59703,"_25347":59699,"_5":25680,"_17690":101275,"_23966":101276,"_2399":101277},[],"/docs/pr-preview/pr-42/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2872":59704,"_25347":59699,"_5":25680,"_17690":101279,"_23966":101280,"_2399":101281},[],"/docs/pr-preview/pr-42/es/platform/overview#capacidades-principales","Capacidades principales",{"_2872":59705,"_25347":59699,"_5":25680,"_17690":101283,"_23966":101284,"_2399":101285},[],"/docs/pr-preview/pr-42/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2872":59706,"_25347":59699,"_5":25680,"_17690":101287,"_23966":101288,"_2399":101289},[],"/docs/pr-preview/pr-42/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2872":59707,"_25347":59699,"_5":25680,"_17690":101291,"_23966":101292,"_2399":101293},[],"/docs/pr-preview/pr-42/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2872":59708,"_25347":59699,"_5":25680,"_17690":101295,"_23966":101296,"_2399":101297},[],"/docs/pr-preview/pr-42/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2872":59709,"_25347":59699,"_5":25680,"_17690":101299,"_23966":101300,"_2399":101301},[],"/docs/pr-preview/pr-42/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2872":59710,"_25347":59699,"_5":25680,"_17690":101303,"_23966":101304,"_2399":101305},[],"/docs/pr-preview/pr-42/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2872":59711,"_25347":59699,"_5":25680,"_17690":101307,"_23966":101308,"_2399":101309},[],"/docs/pr-preview/pr-42/es/platform/overview#referencia-operativa","Referencia operativa",{"_2872":59712,"_25347":59699,"_17690":101311,"_5":17585,"_23966":59699,"_2399":101312},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2872":59713,"_25347":59699,"_17690":101314,"_5":17585,"_23966":101269,"_2399":101315},[],"Elige el resultado que necesitas obtener:",{"_2872":59714,"_25347":59699,"_17690":101317,"_5":17585,"_23966":101269,"_2399":101318},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2872":59715,"_25347":59699,"_17690":101320,"_5":17585,"_23966":101269,"_2399":101321},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2872":59716,"_25347":59699,"_17690":101323,"_5":17585,"_23966":101269,"_2399":101324},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2872":59717,"_25347":59699,"_17690":101326,"_5":17585,"_23966":101272,"_2399":101327},[],"Bloque",{"_2872":59718,"_25347":59699,"_17690":101329,"_5":17585,"_23966":101272,"_2399":101330},[],"Qué gestionas",{"_2872":59719,"_25347":59699,"_17690":101332,"_5":17585,"_23966":101272,"_2399":101333},[],"Punto de entrada",{"_2872":59720,"_25347":59699,"_17690":101335,"_5":17585,"_23966":101272,"_2399":46074},[],{"_2872":59721,"_25347":59699,"_17690":101337,"_5":17585,"_23966":101272,"_2399":101338},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2872":59722,"_25347":59699,"_17690":101340,"_5":17585,"_23966":101272,"_2399":101341},[],"Visión general de PKI",{"_2872":59723,"_25347":59699,"_17690":101343,"_5":17585,"_23966":101272,"_2399":46083},[],{"_2872":59724,"_25347":59699,"_17690":101345,"_5":17585,"_23966":101272,"_2399":101346},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2872":59725,"_25347":59699,"_17690":101348,"_5":17585,"_23966":101272,"_2399":101349},[],"Visión general de IoT Fleets",{"_2872":59726,"_25347":59699,"_17690":101351,"_5":17585,"_23966":101272,"_2399":101352},[],"**Administración**",{"_2872":59727,"_25347":59699,"_17690":101354,"_5":17585,"_23966":101272,"_2399":101355},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2872":59728,"_25347":59699,"_17690":101357,"_5":17585,"_23966":101272,"_2399":97858},[],{"_2872":59729,"_25347":59699,"_17690":101359,"_5":17585,"_23966":101272,"_2399":101360},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2872":59730,"_25347":59699,"_17690":101362,"_5":17585,"_23966":101276,"_2399":101363},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2872":59731,"_25347":59699,"_17690":101365,"_5":17585,"_23966":101276,"_2399":101366},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2872":59732,"_25347":59699,"_17690":101368,"_5":17585,"_23966":101276,"_2399":101369},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2872":59733,"_25347":59699,"_17690":101371,"_5":17585,"_23966":101276,"_2399":101372},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2872":59734,"_25347":59699,"_17690":101374,"_5":17585,"_23966":101276,"_2399":101375},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2872":59735,"_25347":59699,"_17690":101377,"_5":17585,"_23966":101276,"_2399":101378},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2872":59736,"_25347":59699,"_17690":101380,"_5":17585,"_23966":101284,"_2399":101381},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2872":59737,"_25347":59699,"_17690":101383,"_5":17585,"_23966":101288,"_2399":101384},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2872":59738,"_25347":59699,"_17690":101386,"_5":17585,"_23966":101292,"_2399":101387},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2872":59739,"_25347":59699,"_17690":101389,"_5":17585,"_23966":101296,"_2399":101390},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2872":59740,"_25347":59699,"_17690":101392,"_5":17585,"_23966":101300,"_2399":101393},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2872":59741,"_25347":59699,"_17690":101395,"_5":17585,"_23966":101304,"_2399":101396},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2872":59742,"_25347":59699,"_17690":101398,"_5":17585,"_23966":101308,"_2399":100852},[],{"_2872":59743,"_25347":59699,"_17690":101400,"_5":17585,"_23966":101308,"_2399":101401},[],"Qué prepara o comprueba",{"_2872":59744,"_25347":59699,"_17690":101403,"_5":17585,"_23966":101308,"_2399":100855},[],{"_2872":59745,"_25347":59699,"_17690":101405,"_5":17585,"_23966":101308,"_2399":101406},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2872":59746,"_25347":59699,"_17690":101408,"_5":17585,"_23966":101308,"_2399":101409},[],"Administrador de la flota",{"_2872":59747,"_25347":59699,"_17690":101411,"_5":17585,"_23966":101308,"_2399":101412},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2872":59748,"_25347":59699,"_17690":101414,"_5":17585,"_23966":101308,"_2399":100867},[],{"_2872":59749,"_25347":59699,"_17690":101416,"_5":17585,"_23966":101308,"_2399":101417},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2872":59750,"_25347":59699,"_17690":101419,"_5":17585,"_23966":101308,"_2399":100873},[],{"_2872":59751,"_25347":59699,"_17690":101421,"_5":17585,"_23966":101308,"_2399":101422},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2872":59752,"_25347":59699,"_17690":101424,"_5":17585,"_23966":101308,"_2399":101425},[],"Operador de infraestructura",{"_2872":59753,"_25347":59699,"_17690":101427,"_5":17585,"_23966":101308,"_2399":101428},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2872":59754,"_25347":59699,"_17690":101430,"_5":17585,"_23966":101308,"_2399":101431},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2872":59755,"_25347":59755,"_5":12438,"_2399":101433,"_25683":101434,"_17690":101436,"_23966":59755},"Jerarquía y rotación de CAs",[41104,97860,46175,101435],"Claves, autoridades y certificados",[],{"_2872":59756,"_25347":59755,"_17690":101438,"_5":17585,"_23966":59755,"_2399":101439},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2872":59757,"_25347":59755,"_5":25680,"_17690":101441,"_23966":101442,"_2399":101443},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2872":59758,"_25347":59755,"_5":25680,"_17690":101445,"_23966":101446,"_2399":101447},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2872":59759,"_25347":59755,"_5":25680,"_17690":101449,"_23966":101450,"_2399":101451},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2872":59760,"_25347":59755,"_5":25680,"_17690":101453,"_23966":101454,"_2399":101455},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2872":59761,"_25347":59755,"_5":25680,"_17690":101457,"_23966":101458,"_2399":101459},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2872":59762,"_25347":59755,"_5":25680,"_17690":101461,"_23966":101462,"_2399":101463},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2872":59763,"_25347":59755,"_5":25680,"_17690":101465,"_23966":101466,"_2399":101467},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2872":59764,"_25347":59755,"_5":25680,"_17690":101469,"_23966":101470,"_2399":101471},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2872":59765,"_25347":59755,"_5":25680,"_17690":101473,"_23966":101474,"_2399":101475},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2872":59766,"_25347":59755,"_5":25680,"_17690":101477,"_23966":101478,"_2399":101479},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2872":59767,"_25347":59755,"_5":25680,"_17690":101481,"_23966":101482,"_2399":101483},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2872":59768,"_25347":59755,"_5":25680,"_17690":101485,"_23966":101486,"_2399":101487},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2872":59769,"_25347":59755,"_17690":101489,"_5":17585,"_23966":59755,"_2399":101490},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2872":59770,"_25347":59755,"_17690":101492,"_5":17585,"_23966":59755,"_2399":101493},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2872":59771,"_25347":59755,"_17690":101495,"_5":17585,"_23966":101442,"_2399":101496},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2872":59772,"_25347":59755,"_17690":101498,"_5":17585,"_23966":101442,"_2399":101499},[],"entorno, como producción y preproducción;",{"_2872":59773,"_25347":59755,"_17690":101501,"_5":17585,"_23966":101442,"_2399":101502},[],"propietario o equipo operador;",{"_2872":59774,"_25347":59755,"_17690":101504,"_5":17585,"_23966":101442,"_2399":101505},[],"familia de dispositivos o proceso de fabricación;",{"_2872":59775,"_25347":59755,"_17690":101507,"_5":17585,"_23966":101442,"_2399":101508},[],"región o requisito regulatorio;",{"_2872":59776,"_25347":59755,"_17690":101510,"_5":17585,"_23966":101442,"_2399":101511},[],"motor criptográfico o política de clave;",{"_2872":59777,"_25347":59755,"_17690":101513,"_5":17585,"_23966":101442,"_2399":101514},[],"ventana de mantenimiento y ritmo de renovación.",{"_2872":59778,"_25347":59755,"_17690":101516,"_5":17585,"_23966":101442,"_2399":101517},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2872":59779,"_25347":59755,"_17690":101519,"_5":17585,"_23966":101442,"_2399":101520},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2872":59780,"_25347":59755,"_17690":101522,"_5":17585,"_23966":101446,"_2399":101523},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2872":59781,"_25347":59755,"_17690":101525,"_5":17585,"_23966":101446,"_2399":101526},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2872":59782,"_25347":59755,"_17690":101528,"_5":17585,"_23966":101446,"_2399":101529},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2872":59783,"_25347":59755,"_17690":101531,"_5":17585,"_23966":101450,"_2399":101532},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2872":59784,"_25347":59755,"_17690":101534,"_5":17585,"_23966":101450,"_2399":101535},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2872":59785,"_25347":59755,"_17690":101537,"_5":17585,"_23966":101450,"_2399":101538},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2872":59786,"_25347":59755,"_17690":101540,"_5":17585,"_23966":101450,"_2399":101541},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2872":59787,"_25347":59755,"_17690":101543,"_5":17585,"_23966":101458,"_2399":101544},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2872":59788,"_25347":59755,"_17690":101546,"_5":17585,"_23966":101462,"_2399":101547},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2872":59789,"_25347":59755,"_17690":101549,"_5":17585,"_23966":101466,"_2399":101550},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2872":59790,"_25347":59755,"_17690":101552,"_5":17585,"_23966":101470,"_2399":101553},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2872":59791,"_25347":59755,"_17690":101555,"_5":17585,"_23966":101474,"_2399":101556},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2872":59792,"_25347":59755,"_17690":101558,"_5":17585,"_23966":101478,"_2399":101559},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2872":59793,"_25347":59755,"_17690":101561,"_5":17585,"_23966":101482,"_2399":101562},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2872":59794,"_25347":59755,"_17690":101564,"_5":17585,"_23966":101482,"_2399":101565},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2872":59795,"_25347":59755,"_17690":101567,"_5":17585,"_23966":101482,"_2399":101568},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2872":59796,"_25347":59755,"_17690":101570,"_5":17585,"_23966":101482,"_2399":101571},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2872":59797,"_25347":59755,"_17690":101573,"_5":17585,"_23966":101486,"_2399":101574},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2872":59798,"_25347":59755,"_17690":101576,"_5":17585,"_23966":101486,"_2399":101577},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2872":59799,"_25347":59755,"_17690":101579,"_5":17585,"_23966":101486,"_2399":101580},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2872":59800,"_25347":59755,"_17690":101582,"_5":17585,"_23966":101486,"_2399":101583},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2872":59801,"_25347":59755,"_17690":101585,"_5":17585,"_23966":101486,"_2399":101586},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2872":59802,"_25347":59755,"_17690":101588,"_5":17585,"_23966":101486,"_2399":101589},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2872":59803,"_25347":59755,"_17690":101591,"_5":17585,"_23966":101486,"_2399":101592},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2872":59804,"_25347":59804,"_5":12438,"_2399":101594,"_25683":101595,"_17690":101596,"_23966":59804},"Autoridades de certificación",[41104,97860,46175,101435],[],{"_2872":59805,"_25347":59804,"_17690":101598,"_5":17585,"_23966":59804,"_2399":101599},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2872":59806,"_25347":59804,"_5":25680,"_17690":101601,"_23966":101602,"_2399":101603},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2872":59807,"_25347":59804,"_5":25680,"_17690":101605,"_23966":101606,"_2399":101607},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2872":59808,"_25347":59804,"_5":25680,"_17690":101609,"_23966":101610,"_2399":96512},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2872":59809,"_25347":59804,"_5":25680,"_17690":101612,"_23966":101613,"_2399":101614},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2872":59810,"_25347":59804,"_5":25680,"_17690":101616,"_23966":101617,"_2399":101618},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2872":59811,"_25347":59804,"_5":25680,"_17690":101620,"_23966":101621,"_2399":101622},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2872":59812,"_25347":59804,"_5":25680,"_17690":101624,"_23966":101625,"_2399":101626},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2872":59813,"_25347":59804,"_5":25680,"_17690":101628,"_23966":101629,"_2399":101630},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2872":59814,"_25347":59804,"_5":25680,"_17690":101632,"_23966":101633,"_2399":101634},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2872":59815,"_25347":59804,"_5":25680,"_17690":101636,"_23966":101637,"_2399":101638},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2872":59816,"_25347":59804,"_5":25680,"_17690":101640,"_23966":101641,"_2399":101642},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2872":59817,"_25347":59804,"_5":25680,"_17690":101644,"_23966":101645,"_2399":101646},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2872":59818,"_25347":59804,"_5":25680,"_17690":101648,"_23966":101649,"_2399":101650},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2872":59819,"_25347":59804,"_5":25680,"_17690":101652,"_23966":101653,"_2399":101654},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2872":59820,"_25347":59804,"_5":25680,"_17690":101656,"_23966":101657,"_2399":101658},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2872":59821,"_25347":59804,"_5":25680,"_17690":101660,"_23966":101661,"_2399":101662},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2872":59822,"_25347":59804,"_5":25680,"_17690":101664,"_23966":101665,"_2399":101666},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2872":59823,"_25347":59804,"_5":25680,"_17690":101668,"_23966":101669,"_2399":101670},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2872":59824,"_25347":59804,"_5":25680,"_17690":101672,"_23966":101673,"_2399":101674},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2872":59825,"_25347":59804,"_5":25680,"_17690":101676,"_23966":101677,"_2399":101678},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2872":59826,"_25347":59804,"_5":25680,"_17690":101680,"_23966":101681,"_2399":101682},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2872":59827,"_25347":59804,"_5":25680,"_17690":101684,"_23966":101685,"_2399":101686},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2872":59828,"_25347":59804,"_17690":101688,"_5":17585,"_23966":59804,"_2399":101689},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2872":59829,"_25347":59804,"_17690":101691,"_5":17585,"_23966":59804,"_2399":101692},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2872":59830,"_25347":59804,"_17690":101694,"_5":17585,"_23966":59804,"_2399":101695},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2872":59831,"_25347":59804,"_17690":101697,"_5":17585,"_23966":101602,"_2399":101698},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2872":59832,"_25347":59804,"_17690":101700,"_5":17585,"_23966":101602,"_2399":101701},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2872":59833,"_25347":59804,"_17690":101703,"_5":17585,"_23966":101602,"_2399":101704},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2872":59834,"_25347":59804,"_17690":101706,"_5":17585,"_23966":101602,"_2399":101707},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2872":59835,"_25347":59804,"_17690":101709,"_5":17585,"_23966":101602,"_2399":101710},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2872":59836,"_25347":59804,"_17690":101712,"_5":17585,"_23966":101610,"_2399":101713},[],"Decide si la CA será raíz o intermedia.",{"_2872":59837,"_25347":59804,"_17690":101715,"_5":17585,"_23966":101610,"_2399":101716},[],"Elige el motor que custodiará la clave.",{"_2872":59838,"_25347":59804,"_17690":101718,"_5":17585,"_23966":101610,"_2399":101719},[],"Define una validez superior a la de los certificados que emitirá.",{"_2872":59839,"_25347":59804,"_17690":101721,"_5":17585,"_23966":101610,"_2399":101722},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2872":59840,"_25347":59804,"_17690":101724,"_5":17585,"_23966":101613,"_2399":101725},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2872":59841,"_25347":59804,"_17690":101727,"_5":17585,"_23966":101617,"_2399":101728},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2872":59842,"_25347":59804,"_17690":101730,"_5":17585,"_23966":101617,"_2399":101731},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2872":59843,"_25347":59804,"_17690":101733,"_5":17585,"_23966":101621,"_2399":101734},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2872":59844,"_25347":59804,"_17690":101736,"_5":17585,"_23966":101625,"_2399":101737},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2872":59845,"_25347":59804,"_17690":101739,"_5":17585,"_23966":101625,"_2399":101740},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2872":59846,"_25347":59804,"_17690":101742,"_5":17585,"_23966":101625,"_2399":101743},[],"`ST`: estado o provincia.",{"_2872":59847,"_25347":59804,"_17690":101745,"_5":17585,"_23966":101625,"_2399":101746},[],"`L`: localidad.",{"_2872":59848,"_25347":59804,"_17690":101748,"_5":17585,"_23966":101625,"_2399":101749},[],"`O`: organización.",{"_2872":59849,"_25347":59804,"_17690":101751,"_5":17585,"_23966":101625,"_2399":101752},[],"`OU`: unidad organizativa.",{"_2872":59850,"_25347":59804,"_17690":101754,"_5":17585,"_23966":101625,"_2399":101755},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2872":59851,"_25347":59804,"_17690":101757,"_5":17585,"_23966":101629,"_2399":101758},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2872":59852,"_25347":59804,"_17690":101760,"_5":17585,"_23966":101629,"_2399":101761},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2872":59853,"_25347":59804,"_17690":101763,"_5":17585,"_23966":101633,"_2399":101764},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2872":59854,"_25347":59804,"_17690":101766,"_5":17585,"_23966":101633,"_2399":101767},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2872":59855,"_25347":59804,"_17690":101769,"_5":17585,"_23966":101637,"_2399":101770},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2872":59856,"_25347":59804,"_17690":101772,"_5":17585,"_23966":101637,"_2399":101773},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2872":59857,"_25347":59804,"_17690":101775,"_5":17585,"_23966":101641,"_2399":101776},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2872":59858,"_25347":59804,"_17690":101778,"_5":17585,"_23966":101645,"_2399":101779},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2872":59859,"_25347":59804,"_17690":101781,"_5":17585,"_23966":101649,"_2399":101782},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2872":59860,"_25347":59804,"_17690":101784,"_5":17585,"_23966":101653,"_2399":101785},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2872":59861,"_25347":59804,"_17690":101787,"_5":17585,"_23966":101657,"_2399":101788},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2872":59862,"_25347":59804,"_17690":101790,"_5":17585,"_23966":101657,"_2399":101791},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2872":59863,"_25347":59804,"_17690":101793,"_5":17585,"_23966":101661,"_2399":101794},[],"Abre una CA desde el inventario para consultar:",{"_2872":59864,"_25347":59804,"_17690":101796,"_5":17585,"_23966":101661,"_2399":101797},[],"Estado y periodo de validez.",{"_2872":59865,"_25347":59804,"_17690":101799,"_5":17585,"_23966":101661,"_2399":101800},[],"Certificado y cadena en formato PEM.",{"_2872":59866,"_25347":59804,"_17690":101802,"_5":17585,"_23966":101661,"_2399":101803},[],"Número de certificados activos, expirados y revocados.",{"_2872":59867,"_25347":59804,"_17690":101805,"_5":17585,"_23966":101661,"_2399":101806},[],"Certificados emitidos en **Issued Certificates**.",{"_2872":59868,"_25347":59804,"_17690":101808,"_5":17585,"_23966":101661,"_2399":101809},[],"CRL vinculada a la autoridad.",{"_2872":59869,"_25347":59804,"_17690":101811,"_5":17585,"_23966":101661,"_2399":101812},[],"Metadatos y motor criptográfico asociado.",{"_2872":59870,"_25347":59804,"_17690":101814,"_5":17585,"_23966":101661,"_2399":101815},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2872":59871,"_25347":59804,"_17690":101817,"_5":17585,"_23966":101665,"_2399":101818},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2872":59872,"_25347":59804,"_17690":101820,"_5":17585,"_23966":101665,"_2399":101821},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2872":59873,"_25347":59804,"_17690":101823,"_5":17585,"_23966":101665,"_2399":101824},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2872":59874,"_25347":59804,"_17690":101826,"_5":17585,"_23966":101665,"_2399":101827},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2872":59875,"_25347":59804,"_17690":101829,"_5":17585,"_23966":101669,"_2399":101830},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2872":59876,"_25347":59804,"_17690":101832,"_5":17585,"_23966":101673,"_2399":101833},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2872":59877,"_25347":59804,"_17690":101835,"_5":17585,"_23966":101677,"_2399":101836},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2872":59878,"_25347":59804,"_17690":101838,"_5":17585,"_23966":101681,"_2399":101839},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2872":59879,"_25347":59804,"_17690":101841,"_5":17585,"_23966":101685,"_2399":101842},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2872":59880,"_25347":59804,"_17690":101844,"_5":17585,"_23966":101685,"_2399":101845},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2872":59881,"_25347":59881,"_5":12438,"_2399":101847,"_25683":101848,"_17690":101849,"_23966":59881},"Perfiles de certificado",[41104,97860,46175,101435],[],{"_2872":59882,"_25347":59881,"_17690":101851,"_5":17585,"_23966":59881,"_2399":101852},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2872":59883,"_25347":59881,"_5":25680,"_17690":101854,"_23966":101855,"_2399":101856},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2872":59884,"_25347":59881,"_5":25680,"_17690":101858,"_23966":101859,"_2399":101860},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#validez","Validez",{"_2872":59885,"_25347":59881,"_5":25680,"_17690":101862,"_23966":101863,"_2399":101864},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2872":59886,"_25347":59881,"_5":25680,"_17690":101866,"_23966":101867,"_2399":101868},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2872":59887,"_25347":59881,"_5":25680,"_17690":101870,"_23966":101871,"_2399":101872},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2872":59888,"_25347":59881,"_5":25680,"_17690":101874,"_23966":101875,"_2399":101876},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2872":59889,"_25347":59881,"_5":25680,"_17690":101878,"_23966":101879,"_2399":101880},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2872":59890,"_25347":59881,"_5":25680,"_17690":101882,"_23966":101883,"_2399":101884},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2872":59891,"_25347":59881,"_5":25680,"_17690":101886,"_23966":101887,"_2399":101888},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2872":59892,"_25347":59881,"_5":25680,"_17690":101890,"_23966":101891,"_2399":101892},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2872":59893,"_25347":59881,"_5":25680,"_17690":101894,"_23966":101895,"_2399":101896},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2872":59894,"_25347":59881,"_5":25680,"_17690":101898,"_23966":101899,"_2399":101900},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2872":59895,"_25347":59881,"_5":25680,"_17690":101902,"_23966":101903,"_2399":101904},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2872":59896,"_25347":59881,"_5":25680,"_17690":101906,"_23966":101907,"_2399":101908},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2872":59897,"_25347":59881,"_5":25680,"_17690":101910,"_23966":101911,"_2399":101912},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2872":59898,"_25347":59881,"_5":25680,"_17690":101914,"_23966":101915,"_2399":101916},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2872":59899,"_25347":59881,"_17690":101918,"_5":17585,"_23966":59881,"_2399":101919},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2872":59900,"_25347":59881,"_17690":101921,"_5":17585,"_23966":59881,"_2399":101922},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2872":59901,"_25347":59881,"_17690":101924,"_5":17585,"_23966":101859,"_2399":101925},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2872":59902,"_25347":59881,"_17690":101927,"_5":17585,"_23966":101859,"_2399":101928},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2872":59903,"_25347":59881,"_17690":101930,"_5":17585,"_23966":101863,"_2399":101931},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2872":59904,"_25347":59881,"_17690":101933,"_5":17585,"_23966":101867,"_2399":101934},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2872":59905,"_25347":59881,"_17690":101936,"_5":17585,"_23966":101867,"_2399":101937},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2872":59906,"_25347":59881,"_17690":101939,"_5":17585,"_23966":101867,"_2399":101940},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2872":59907,"_25347":59881,"_17690":101942,"_5":17585,"_23966":101871,"_2399":101943},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2872":59908,"_25347":59881,"_17690":101945,"_5":17585,"_23966":101875,"_2399":101946},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2872":59909,"_25347":59881,"_17690":101948,"_5":17585,"_23966":101875,"_2399":101949},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2872":59910,"_25347":59881,"_17690":101951,"_5":17585,"_23966":101879,"_2399":101952},[],"La aplicación criptográfica puede:",{"_2872":59911,"_25347":59881,"_17690":101954,"_5":17585,"_23966":101879,"_2399":101955},[],"permitir o bloquear claves RSA;",{"_2872":59912,"_25347":59881,"_17690":101957,"_5":17585,"_23966":101879,"_2399":101958},[],"limitar los tamaños RSA admitidos;",{"_2872":59913,"_25347":59881,"_17690":101960,"_5":17585,"_23966":101879,"_2399":101961},[],"permitir o bloquear claves ECDSA;",{"_2872":59914,"_25347":59881,"_17690":101963,"_5":17585,"_23966":101879,"_2399":101964},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2872":59915,"_25347":59881,"_17690":101966,"_5":17585,"_23966":101879,"_2399":101967},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2872":59916,"_25347":59881,"_17690":101969,"_5":17585,"_23966":101883,"_2399":101970},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2872":59917,"_25347":59881,"_17690":101972,"_5":17585,"_23966":101883,"_2399":97630},[],{"_2872":59918,"_25347":59881,"_17690":101974,"_5":17585,"_23966":101883,"_2399":101975},[],"Primera opción",{"_2872":59919,"_25347":59881,"_17690":101977,"_5":17585,"_23966":101883,"_2399":101978},[],"Segunda opción",{"_2872":59920,"_25347":59881,"_17690":101980,"_5":17585,"_23966":101883,"_2399":101981},[],"Si no hay ninguna",{"_2872":59921,"_25347":59881,"_17690":101983,"_5":17585,"_23966":101883,"_2399":101984},[],"Firma directa con una CA",{"_2872":59922,"_25347":59881,"_17690":101986,"_5":17585,"_23966":101883,"_2399":101987},[],"`issuance_profile` incluido en la solicitud",{"_2872":59923,"_25347":59881,"_17690":101989,"_5":17585,"_23966":101883,"_2399":101990},[],"`issuance_profile_id` de la solicitud",{"_2872":59924,"_25347":59881,"_17690":101992,"_5":17585,"_23966":101883,"_2399":101993},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2872":59925,"_25347":59881,"_17690":101995,"_5":17585,"_23966":101883,"_2399":101996},[],"Emisión mediante DMS",{"_2872":59926,"_25347":59881,"_17690":101998,"_5":17585,"_23966":101883,"_2399":46740},[],{"_2872":59927,"_25347":59881,"_17690":102000,"_5":17585,"_23966":101883,"_2399":102001},[],"`settings.issuance_profile` incluido en el DMS",{"_2872":59928,"_25347":59881,"_17690":102003,"_5":17585,"_23966":101883,"_2399":102004},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2872":59929,"_25347":59881,"_17690":102006,"_5":17585,"_23966":101883,"_2399":102007},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2872":59930,"_25347":59881,"_17690":102009,"_5":17585,"_23966":101883,"_2399":102010},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2872":59931,"_25347":59881,"_17690":102012,"_5":17585,"_23966":101891,"_2399":102013},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2872":59932,"_25347":59881,"_17690":102015,"_5":17585,"_23966":101895,"_2399":102016},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2872":59933,"_25347":59881,"_17690":102018,"_5":17585,"_23966":101899,"_2399":102019},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2872":59934,"_25347":59881,"_17690":102021,"_5":17585,"_23966":101903,"_2399":102022},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2872":59935,"_25347":59881,"_17690":102024,"_5":17585,"_23966":101907,"_2399":102025},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2872":59936,"_25347":59881,"_17690":102027,"_5":17585,"_23966":101907,"_2399":102028},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2872":59937,"_25347":59881,"_17690":102030,"_5":17585,"_23966":101911,"_2399":102031},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2872":59938,"_25347":59881,"_17690":102033,"_5":17585,"_23966":101911,"_2399":102034},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2872":59939,"_25347":59881,"_17690":102036,"_5":17585,"_23966":101911,"_2399":102037},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2872":59940,"_25347":59881,"_17690":102039,"_5":17585,"_23966":101911,"_2399":102040},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2872":59941,"_25347":59881,"_17690":102042,"_5":17585,"_23966":101915,"_2399":102043},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2872":59942,"_25347":59881,"_17690":102045,"_5":17585,"_23966":101915,"_2399":102046},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2872":59943,"_25347":59943,"_5":12438,"_2399":102048,"_25683":102049,"_17690":102051,"_23966":59943},"Validación de certificados",[41104,97860,46175,102050],"Validación",[],{"_2872":59944,"_25347":59943,"_17690":102053,"_5":17585,"_23966":59943,"_2399":102054},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2872":59945,"_25347":59943,"_5":25680,"_17690":102056,"_23966":102057,"_2399":102058},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2872":59946,"_25347":59943,"_5":25680,"_17690":102060,"_23966":102061,"_2399":102062},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2872":59947,"_25347":59943,"_5":25680,"_17690":102064,"_23966":102065,"_2399":102066},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2872":59948,"_25347":59943,"_17690":102068,"_5":17585,"_23966":59943,"_2399":102069},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2872":59949,"_25347":59943,"_17690":102071,"_5":17585,"_23966":102057,"_2399":102072},[],"Verifica estos criterios juntos:",{"_2872":59950,"_25347":59943,"_17690":102074,"_5":17585,"_23966":102057,"_2399":101062},[],{"_2872":59951,"_25347":59943,"_17690":102076,"_5":17585,"_23966":102057,"_2399":102077},[],"Resultado necesario",{"_2872":59952,"_25347":59943,"_17690":102079,"_5":17585,"_23966":102057,"_2399":102080},[],"Cadena y firma",{"_2872":59953,"_25347":59943,"_17690":102082,"_5":17585,"_23966":102057,"_2399":102083},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2872":59954,"_25347":59943,"_17690":102085,"_5":17585,"_23966":102057,"_2399":102086},[],"Fechas",{"_2872":59955,"_25347":59943,"_17690":102088,"_5":17585,"_23966":102057,"_2399":102089},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2872":59956,"_25347":59943,"_17690":102091,"_5":17585,"_23966":102057,"_2399":97543},[],{"_2872":59957,"_25347":59943,"_17690":102093,"_5":17585,"_23966":102057,"_2399":102094},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2872":59958,"_25347":59943,"_17690":102096,"_5":17585,"_23966":102057,"_2399":102097},[],"Uso",{"_2872":59959,"_25347":59943,"_17690":102099,"_5":17585,"_23966":102057,"_2399":102100},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2872":59960,"_25347":59943,"_17690":102102,"_5":17585,"_23966":102057,"_2399":102103},[],"Revocación",{"_2872":59961,"_25347":59943,"_17690":102105,"_5":17585,"_23966":102057,"_2399":102106},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2872":59962,"_25347":59943,"_17690":102108,"_5":17585,"_23966":102057,"_2399":102109},[],"Autorización",{"_2872":59963,"_25347":59943,"_17690":102111,"_5":17585,"_23966":102057,"_2399":102112},[],"La aplicación permite la acción a esa identidad.",{"_2872":59964,"_25347":59943,"_17690":102114,"_5":17585,"_23966":102057,"_2399":102115},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2872":59965,"_25347":59943,"_17690":102117,"_5":17585,"_23966":102061,"_2399":102118},[],"Mecanismo",{"_2872":59966,"_25347":59943,"_17690":102120,"_5":17585,"_23966":102061,"_2399":102121},[],"Cuándo utilizarlo",{"_2872":59967,"_25347":59943,"_17690":102123,"_5":17585,"_23966":102061,"_2399":102124},[],"Qué debes mantener",{"_2872":59968,"_25347":59943,"_17690":102126,"_5":17585,"_23966":102061,"_2399":46868},[],{"_2872":59969,"_25347":59943,"_17690":102128,"_5":17585,"_23966":102061,"_2399":102129},[],"Consulta del estado de un certificado concreto.",{"_2872":59970,"_25347":59943,"_17690":102131,"_5":17585,"_23966":102061,"_2399":102132},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2872":59971,"_25347":59943,"_17690":102134,"_5":17585,"_23966":102061,"_2399":46877},[],{"_2872":59972,"_25347":59943,"_17690":102136,"_5":17585,"_23966":102061,"_2399":102137},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2872":59973,"_25347":59943,"_17690":102139,"_5":17585,"_23966":102061,"_2399":102140},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2872":59974,"_25347":59943,"_17690":102142,"_5":17585,"_23966":102061,"_2399":102143},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2872":59975,"_25347":59943,"_17690":102145,"_5":17585,"_23966":102061,"_2399":102146},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2872":59976,"_25347":59943,"_17690":102148,"_5":17585,"_23966":102065,"_2399":102149},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2872":59977,"_25347":59943,"_17690":102151,"_5":17585,"_23966":102065,"_2399":102152},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2872":59978,"_25347":59943,"_17690":102154,"_5":17585,"_23966":102065,"_2399":102155},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2872":59979,"_25347":59943,"_17690":102157,"_5":17585,"_23966":102065,"_2399":102158},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2872":59980,"_25347":59943,"_17690":102160,"_5":17585,"_23966":102065,"_2399":102161},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2872":59981,"_25347":59943,"_17690":102163,"_5":17585,"_23966":102065,"_2399":102164},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2872":59982,"_25347":59943,"_17690":102166,"_5":17585,"_23966":102065,"_2399":102167},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2872":59983,"_25347":59943,"_17690":102169,"_5":17585,"_23966":102065,"_2399":102170},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2872":59984,"_25347":59943,"_17690":102172,"_5":17585,"_23966":102065,"_2399":102173},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2872":59985,"_25347":59985,"_5":12438,"_2399":102175,"_25683":102176,"_17690":102177,"_23966":59985},"Certificados",[41104,97860,46175,101435],[],{"_2872":59986,"_25347":59985,"_17690":102179,"_5":17585,"_23966":59985,"_2399":102180},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2872":59987,"_25347":59985,"_5":25680,"_17690":102182,"_23966":102183,"_2399":102184},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2872":59988,"_25347":59985,"_5":25680,"_17690":102186,"_23966":102187,"_2399":102188},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2872":59989,"_25347":59985,"_5":25680,"_17690":102190,"_23966":102191,"_2399":102192},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2872":59990,"_25347":59985,"_5":25680,"_17690":102194,"_23966":102195,"_2399":102196},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2872":59991,"_25347":59985,"_5":25680,"_17690":102198,"_23966":102199,"_2399":102200},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2872":59992,"_25347":59985,"_5":25680,"_17690":102202,"_23966":102203,"_2399":102204},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2872":59993,"_25347":59985,"_5":25680,"_17690":102206,"_23966":102207,"_2399":102208},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2872":59994,"_25347":59985,"_5":25680,"_17690":102210,"_23966":102211,"_2399":102212},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2872":59995,"_25347":59985,"_5":25680,"_17690":102214,"_23966":102215,"_2399":102216},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#continúa","Continúa",{"_2872":59996,"_25347":59985,"_17690":102218,"_5":17585,"_23966":59985,"_2399":102219},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2872":59997,"_25347":59985,"_17690":102221,"_5":17585,"_23966":102183,"_2399":102222},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2872":59998,"_25347":59985,"_17690":102224,"_5":17585,"_23966":102183,"_2399":102225},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2872":59999,"_25347":59985,"_17690":102227,"_5":17585,"_23966":102187,"_2399":102228},[],"Descarga el PEM e inspecciónalo:",{"_2872":60000,"_25347":59985,"_17690":102230,"_5":17585,"_23966":102187,"_2399":102231},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2872":60001,"_25347":59985,"_17690":102233,"_5":17585,"_23966":102191,"_2399":102234},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2872":60002,"_25347":59985,"_17690":102236,"_5":17585,"_23966":102191,"_2399":102237},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2872":60003,"_25347":59985,"_17690":102239,"_5":17585,"_23966":102191,"_2399":102240},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2872":60004,"_25347":59985,"_17690":102242,"_5":17585,"_23966":102191,"_2399":102243},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2872":60005,"_25347":59985,"_17690":102245,"_5":17585,"_23966":102191,"_2399":102246},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2872":60006,"_25347":59985,"_17690":102248,"_5":17585,"_23966":102191,"_2399":102249},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2872":60007,"_25347":59985,"_17690":102251,"_5":17585,"_23966":102191,"_2399":102252},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2872":60008,"_25347":59985,"_17690":102254,"_5":17585,"_23966":102195,"_2399":102255},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2872":60009,"_25347":59985,"_17690":102257,"_5":17585,"_23966":102199,"_2399":102258},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2872":60010,"_25347":59985,"_17690":102260,"_5":17585,"_23966":102203,"_2399":102261},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2872":60011,"_25347":59985,"_17690":102263,"_5":17585,"_23966":102207,"_2399":102264},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2872":60012,"_25347":59985,"_17690":102266,"_5":17585,"_23966":102207,"_2399":102267},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2872":60013,"_25347":59985,"_17690":102269,"_5":17585,"_23966":102207,"_2399":102270},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2872":60014,"_25347":59985,"_17690":102272,"_5":17585,"_23966":102211,"_2399":102273},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2872":60015,"_25347":59985,"_17690":102275,"_5":17585,"_23966":102211,"_2399":102276},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2872":60016,"_25347":59985,"_17690":102278,"_5":17585,"_23966":102211,"_2399":102279},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2872":60017,"_25347":59985,"_17690":102281,"_5":17585,"_23966":102215,"_2399":102282},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2872":60018,"_25347":59985,"_17690":102284,"_5":17585,"_23966":102215,"_2399":102285},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2872":60019,"_25347":60019,"_5":12438,"_2399":102287,"_25683":102288,"_17690":102290,"_23966":60019},"Ciclo de vida de un certificado",[41104,97860,46175,102289],"Conceptos",[],{"_2872":60020,"_25347":60019,"_17690":102292,"_5":17585,"_23966":60019,"_2399":102293},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2872":60021,"_25347":60019,"_5":25680,"_17690":102295,"_23966":102296,"_2399":102297},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2872":60022,"_25347":60019,"_5":25680,"_17690":102299,"_23966":102300,"_2399":102301},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2872":60023,"_25347":60019,"_5":25680,"_17690":102303,"_23966":102304,"_2399":102305},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2872":60024,"_25347":60019,"_5":25680,"_17690":102307,"_23966":102308,"_2399":102309},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2872":60025,"_25347":60019,"_5":25680,"_17690":102311,"_23966":102312,"_2399":102313},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2872":60026,"_25347":60019,"_5":25680,"_17690":102315,"_23966":102316,"_2399":102317},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2872":60027,"_25347":60019,"_5":25680,"_17690":102319,"_23966":102320,"_2399":102321},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2872":60028,"_25347":60019,"_5":25680,"_17690":102323,"_23966":102324,"_2399":102325},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2872":60029,"_25347":60019,"_5":25680,"_17690":102327,"_23966":102328,"_2399":102329},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2872":60030,"_25347":60019,"_5":25680,"_17690":102331,"_23966":102332,"_2399":102333},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2872":60031,"_25347":60019,"_17690":102335,"_5":17585,"_23966":60019,"_2399":102336},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2872":60032,"_25347":60019,"_17690":102338,"_5":17585,"_23966":102300,"_2399":102339},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2872":60033,"_25347":60019,"_17690":102341,"_5":17585,"_23966":102304,"_2399":102342},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2872":60034,"_25347":60019,"_17690":102344,"_5":17585,"_23966":102308,"_2399":102345},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2872":60035,"_25347":60019,"_17690":102347,"_5":17585,"_23966":102312,"_2399":102348},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2872":60036,"_25347":60019,"_17690":102350,"_5":17585,"_23966":102316,"_2399":102351},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2872":60037,"_25347":60019,"_17690":102353,"_5":17585,"_23966":102320,"_2399":102354},[],"Lamassu persiste cuatro estados X.509:",{"_2872":60038,"_25347":60019,"_17690":102356,"_5":17585,"_23966":102320,"_2399":102357},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2872":60039,"_25347":60019,"_17690":102359,"_5":17585,"_23966":102320,"_2399":102360},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2872":60040,"_25347":60019,"_17690":102362,"_5":17585,"_23966":102320,"_2399":102363},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2872":60041,"_25347":60019,"_17690":102365,"_5":17585,"_23966":102320,"_2399":102366},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2872":60042,"_25347":60019,"_17690":102368,"_5":17585,"_23966":102320,"_2399":102369},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2872":60043,"_25347":60019,"_17690":102371,"_5":17585,"_23966":102324,"_2399":102372},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2872":60044,"_25347":60019,"_17690":102374,"_5":17585,"_23966":102324,"_2399":102375},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2872":60045,"_25347":60019,"_17690":102377,"_5":17585,"_23966":102324,"_2399":102378},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2872":60046,"_25347":60019,"_17690":102380,"_5":17585,"_23966":102328,"_2399":102381},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2872":60047,"_25347":60019,"_17690":102383,"_5":17585,"_23966":102328,"_2399":102384},[],"Antes de confirmar:",{"_2872":60048,"_25347":60019,"_17690":102386,"_5":17585,"_23966":102328,"_2399":102387},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2872":60049,"_25347":60019,"_17690":102389,"_5":17585,"_23966":102328,"_2399":102390},[],"Distribuye la nueva cadena de confianza.",{"_2872":60050,"_25347":60019,"_17690":102392,"_5":17585,"_23966":102328,"_2399":102393},[],"Reemite las identidades necesarias.",{"_2872":60051,"_25347":60019,"_17690":102395,"_5":17585,"_23966":102328,"_2399":102396},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2872":60052,"_25347":60019,"_17690":102398,"_5":17585,"_23966":102328,"_2399":102399},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2872":60053,"_25347":60019,"_17690":102401,"_5":17585,"_23966":102328,"_2399":102402},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2872":60054,"_25347":60019,"_17690":102404,"_5":17585,"_23966":102332,"_2399":102405},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2872":60055,"_25347":60019,"_17690":102407,"_5":17585,"_23966":102332,"_2399":102408},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2872":60056,"_25347":60019,"_17690":102410,"_5":17585,"_23966":102332,"_2399":102411},[],"Cambios de estado y razones de revocación.",{"_2872":60057,"_25347":60019,"_17690":102413,"_5":17585,"_23966":102332,"_2399":102414},[],"Publicación y vigencia de OCSP y CRLs.",{"_2872":60058,"_25347":60019,"_17690":102416,"_5":17585,"_23966":102332,"_2399":102417},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2872":60059,"_25347":60019,"_17690":102419,"_5":17585,"_23966":102332,"_2399":102420},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2872":60060,"_25347":60060,"_5":12438,"_2399":102422,"_25683":102423,"_17690":102424,"_23966":60060},"Modelo de confianza",[41104,97860,46175,102289],[],{"_2872":60061,"_25347":60060,"_17690":102426,"_5":17585,"_23966":60060,"_2399":102427},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2872":60062,"_25347":60060,"_5":25680,"_17690":102429,"_23966":102430,"_2399":102431},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2872":60063,"_25347":60060,"_5":25680,"_17690":102433,"_23966":102434,"_2399":102435},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2872":60064,"_25347":60060,"_5":25680,"_17690":102437,"_23966":102438,"_2399":102439},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2872":60065,"_25347":60060,"_5":25680,"_17690":102441,"_23966":102442,"_2399":102443},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2872":60066,"_25347":60060,"_5":25680,"_17690":102445,"_23966":102446,"_2399":102447},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2872":60067,"_25347":60060,"_5":25680,"_17690":102449,"_23966":102450,"_2399":102451},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2872":60068,"_25347":60060,"_5":25680,"_17690":102453,"_23966":102454,"_2399":102455},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2872":60069,"_25347":60060,"_5":25680,"_17690":102457,"_23966":102458,"_2399":102459},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2872":60070,"_25347":60060,"_5":25680,"_17690":102461,"_23966":102462,"_2399":102463},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2872":60071,"_25347":60060,"_5":25680,"_17690":102465,"_23966":102466,"_2399":102467},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2872":60072,"_25347":60060,"_17690":102469,"_5":17585,"_23966":60060,"_2399":102470},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2872":60073,"_25347":60060,"_17690":102472,"_5":17585,"_23966":102434,"_2399":102473},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2872":60074,"_25347":60060,"_17690":102475,"_5":17585,"_23966":102438,"_2399":102476},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2872":60075,"_25347":60060,"_17690":102478,"_5":17585,"_23966":102442,"_2399":102479},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2872":60076,"_25347":60060,"_17690":102481,"_5":17585,"_23966":102446,"_2399":102482},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2872":60077,"_25347":60060,"_17690":102484,"_5":17585,"_23966":102450,"_2399":102485},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2872":60078,"_25347":60060,"_17690":102487,"_5":17585,"_23966":102450,"_2399":102488},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2872":60079,"_25347":60060,"_17690":102490,"_5":17585,"_23966":102450,"_2399":102491},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2872":60080,"_25347":60060,"_17690":102493,"_5":17585,"_23966":102450,"_2399":102494},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2872":60081,"_25347":60060,"_17690":102496,"_5":17585,"_23966":102450,"_2399":102497},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2872":60082,"_25347":60060,"_17690":102499,"_5":17585,"_23966":102450,"_2399":102500},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2872":60083,"_25347":60060,"_17690":102502,"_5":17585,"_23966":102454,"_2399":102503},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2872":60084,"_25347":60060,"_17690":102505,"_5":17585,"_23966":102454,"_2399":102506},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2872":60085,"_25347":60060,"_17690":102508,"_5":17585,"_23966":102454,"_2399":102509},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2872":60086,"_25347":60060,"_17690":102511,"_5":17585,"_23966":102454,"_2399":102512},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2872":60087,"_25347":60060,"_17690":102514,"_5":17585,"_23966":102454,"_2399":102515},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2872":60088,"_25347":60060,"_17690":102517,"_5":17585,"_23966":102458,"_2399":102518},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2872":60089,"_25347":60060,"_17690":102520,"_5":17585,"_23966":102458,"_2399":102521},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2872":60090,"_25347":60060,"_17690":102523,"_5":17585,"_23966":102458,"_2399":102524},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2872":60091,"_25347":60060,"_17690":102526,"_5":17585,"_23966":102458,"_2399":102527},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2872":60092,"_25347":60060,"_17690":102529,"_5":17585,"_23966":102458,"_2399":102530},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2872":60093,"_25347":60060,"_17690":102532,"_5":17585,"_23966":102458,"_2399":102533},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2872":60094,"_25347":60060,"_17690":102535,"_5":17585,"_23966":102458,"_2399":102536},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2872":60095,"_25347":60060,"_17690":102538,"_5":17585,"_23966":102462,"_2399":102539},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2872":60096,"_25347":60060,"_17690":102541,"_5":17585,"_23966":102466,"_2399":102542},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2872":60097,"_25347":60060,"_17690":102544,"_5":17585,"_23966":102466,"_2399":102545},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2872":60098,"_25347":60060,"_17690":102547,"_5":17585,"_23966":102466,"_2399":102548},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2872":60099,"_25347":60060,"_17690":102550,"_5":17585,"_23966":102466,"_2399":102551},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2872":60100,"_25347":60060,"_17690":102553,"_5":17585,"_23966":102466,"_2399":102554},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2872":60101,"_25347":60060,"_17690":102556,"_5":17585,"_23966":102466,"_2399":102557},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2872":60102,"_25347":60060,"_17690":102559,"_5":17585,"_23966":102466,"_2399":102560},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2872":60103,"_25347":60103,"_5":12438,"_2399":102562,"_25683":102563,"_17690":102564,"_23966":60103},"Listas de revocación (CRL)",[41104,97860,46175,102050],[],{"_2872":60104,"_25347":60103,"_17690":102566,"_5":17585,"_23966":60103,"_2399":102567},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2872":60105,"_25347":60103,"_5":25680,"_17690":102569,"_23966":102570,"_2399":102571},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2872":60106,"_25347":60103,"_5":25680,"_17690":102573,"_23966":102574,"_2399":102575},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2872":60107,"_25347":60103,"_5":25680,"_17690":102577,"_23966":102578,"_2399":102579},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2872":60108,"_25347":60103,"_5":25680,"_17690":102581,"_23966":102582,"_2399":102583},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2872":60109,"_25347":60103,"_5":25680,"_17690":102585,"_23966":102586,"_2399":102587},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2872":60110,"_25347":60103,"_5":25680,"_17690":102589,"_23966":102590,"_2399":102591},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2872":60111,"_25347":60103,"_5":25680,"_17690":102593,"_23966":102594,"_2399":102595},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#referencias","Referencias",{"_2872":60112,"_25347":60103,"_17690":102597,"_5":17585,"_23966":60103,"_2399":102598},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2872":60113,"_25347":60103,"_17690":102600,"_5":17585,"_23966":102570,"_2399":102601},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2872":60114,"_25347":60103,"_17690":102603,"_5":17585,"_23966":102570,"_2399":102604},[],"Campo de `crl_options`",{"_2872":60115,"_25347":60103,"_17690":102606,"_5":17585,"_23966":102570,"_2399":99353},[],{"_2872":60116,"_25347":60103,"_17690":102608,"_5":17585,"_23966":102570,"_2399":102609},[],"Valor inicial del backend",{"_2872":60117,"_25347":60103,"_17690":102611,"_5":17585,"_23966":102570,"_2399":47355},[],{"_2872":60118,"_25347":60103,"_17690":102613,"_5":17585,"_23966":102570,"_2399":102614},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2872":60119,"_25347":60103,"_17690":102616,"_5":17585,"_23966":102570,"_2399":102617},[],"7 días.",{"_2872":60120,"_25347":60103,"_17690":102619,"_5":17585,"_23966":102570,"_2399":47364},[],{"_2872":60121,"_25347":60103,"_17690":102621,"_5":17585,"_23966":102570,"_2399":102622},[],"Plazo desde la publicación que activa la renovación programada.",{"_2872":60122,"_25347":60103,"_17690":102624,"_5":17585,"_23966":102570,"_2399":102625},[],"6 días y 23 horas.",{"_2872":60123,"_25347":60103,"_17690":102627,"_5":17585,"_23966":102570,"_2399":47373},[],{"_2872":60124,"_25347":60103,"_17690":102629,"_5":17585,"_23966":102570,"_2399":102630},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2872":60125,"_25347":60103,"_17690":102632,"_5":17585,"_23966":102570,"_2399":47379},[],{"_2872":60126,"_25347":60103,"_17690":102634,"_5":17585,"_23966":102570,"_2399":47382},[],{"_2872":60127,"_25347":60103,"_17690":102636,"_5":17585,"_23966":102570,"_2399":102637},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2872":60128,"_25347":60103,"_17690":102639,"_5":17585,"_23966":102570,"_2399":102640},[],"SKI de la CA.",{"_2872":60129,"_25347":60103,"_17690":102642,"_5":17585,"_23966":102570,"_2399":102643},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2872":60130,"_25347":60103,"_17690":102645,"_5":17585,"_23966":102570,"_2399":102646},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2872":60131,"_25347":60103,"_17690":102648,"_5":17585,"_23966":102574,"_2399":102649},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2872":60132,"_25347":60103,"_17690":102651,"_5":17585,"_23966":102574,"_2399":102652},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2872":60133,"_25347":60103,"_17690":102654,"_5":17585,"_23966":102574,"_2399":102655},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2872":60134,"_25347":60103,"_17690":102657,"_5":17585,"_23966":102578,"_2399":102658},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2872":60135,"_25347":60103,"_17690":102660,"_5":17585,"_23966":102578,"_2399":102661},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2872":60136,"_25347":60103,"_17690":102663,"_5":17585,"_23966":102582,"_2399":102664},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2872":60137,"_25347":60103,"_17690":102666,"_5":17585,"_23966":102582,"_2399":102667},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2872":60138,"_25347":60103,"_17690":102669,"_5":17585,"_23966":102582,"_2399":102670},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2872":60139,"_25347":60103,"_17690":102672,"_5":17585,"_23966":102582,"_2399":102673},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2872":60140,"_25347":60103,"_17690":102675,"_5":17585,"_23966":102582,"_2399":102676},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2872":60141,"_25347":60103,"_17690":102678,"_5":17585,"_23966":102586,"_2399":102679},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2872":60142,"_25347":60103,"_17690":102681,"_5":17585,"_23966":102586,"_2399":99542},[],{"_2872":60143,"_25347":60103,"_17690":102683,"_5":17585,"_23966":102586,"_2399":102684},[],"Path relativo",{"_2872":60144,"_25347":60103,"_17690":102686,"_5":17585,"_23966":102586,"_2399":97630},[],{"_2872":60145,"_25347":60103,"_17690":102688,"_5":17585,"_23966":102586,"_2399":47437},[],{"_2872":60146,"_25347":60103,"_17690":102690,"_5":17585,"_23966":102586,"_2399":47440},[],{"_2872":60147,"_25347":60103,"_17690":102692,"_5":17585,"_23966":102586,"_2399":102693},[],"Consultar `crl_options` y `latest_crl`.",{"_2872":60148,"_25347":60103,"_17690":102695,"_5":17585,"_23966":102586,"_2399":47446},[],{"_2872":60149,"_25347":60103,"_17690":102697,"_5":17585,"_23966":102586,"_2399":47440},[],{"_2872":60150,"_25347":60103,"_17690":102699,"_5":17585,"_23966":102586,"_2399":102700},[],"Sustituir la configuración de CRL.",{"_2872":60151,"_25347":60103,"_17690":102702,"_5":17585,"_23966":102586,"_2399":102703},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2872":60152,"_25347":60103,"_17690":102705,"_5":17585,"_23966":102586,"_2399":102706},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2872":60153,"_25347":60103,"_17690":102708,"_5":17585,"_23966":102590,"_2399":102709},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2872":60154,"_25347":60103,"_17690":102711,"_5":17585,"_23966":102594,"_2399":102712},[],"RFC 5280: perfil X.509 y CRL.",{"_2872":60155,"_25347":60103,"_17690":102714,"_5":17585,"_23966":102594,"_2399":47466},[],{"_2872":60156,"_25347":60103,"_17690":102716,"_5":17585,"_23966":102594,"_2399":47469},[],{"_2872":60157,"_25347":60103,"_17690":102718,"_5":17585,"_23966":102594,"_2399":102719},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2872":60158,"_25347":60103,"_17690":102721,"_5":17585,"_23966":102594,"_2399":102722},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2872":60159,"_25347":60159,"_5":12438,"_2399":102724,"_25683":102725,"_17690":102726,"_23966":60159},"Claves y motores criptográficos",[41104,97860,46175,101435],[],{"_2872":60160,"_25347":60159,"_17690":102728,"_5":17585,"_23966":60159,"_2399":102729},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2872":60161,"_25347":60159,"_5":25680,"_17690":102731,"_23966":102732,"_2399":102733},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2872":60162,"_25347":60159,"_5":25680,"_17690":102735,"_23966":102736,"_2399":102737},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2872":60163,"_25347":60159,"_5":25680,"_17690":102739,"_23966":102740,"_2399":47494},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#file-system",{"_2872":60164,"_25347":60159,"_5":25680,"_17690":102742,"_23966":102743,"_2399":47498},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#hashicorp-vault",{"_2872":60165,"_25347":60159,"_5":25680,"_17690":102745,"_23966":102746,"_2399":47502},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#aws-secrets-manager",{"_2872":60166,"_25347":60159,"_5":25680,"_17690":102748,"_23966":102749,"_2399":47506},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#aws-kms",{"_2872":60167,"_25347":60159,"_5":25680,"_17690":102751,"_23966":102752,"_2399":47510},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#pkcs11",{"_2872":60168,"_25347":60159,"_5":25680,"_17690":102754,"_23966":102755,"_2399":47514},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#azure-key-vault",{"_2872":60169,"_25347":60159,"_5":25680,"_17690":102757,"_23966":102758,"_2399":102759},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2872":60170,"_25347":60159,"_5":25680,"_17690":102761,"_23966":102762,"_2399":102763},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2872":60171,"_25347":60159,"_5":25680,"_17690":102765,"_23966":102766,"_2399":102767},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2872":60172,"_25347":60159,"_5":25680,"_17690":102769,"_23966":102770,"_2399":102771},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2872":60173,"_25347":60159,"_5":25680,"_17690":102773,"_23966":102774,"_2399":102775},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2872":60174,"_25347":60159,"_5":25680,"_17690":102777,"_23966":102778,"_2399":102779},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2872":60175,"_25347":60159,"_5":25680,"_17690":102781,"_23966":102782,"_2399":102783},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2872":60176,"_25347":60159,"_5":25680,"_17690":102785,"_23966":102786,"_2399":47546},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#sign",{"_2872":60177,"_25347":60159,"_5":25680,"_17690":102788,"_23966":102789,"_2399":47550},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#verify",{"_2872":60178,"_25347":60159,"_5":25680,"_17690":102791,"_23966":102792,"_2399":102793},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2872":60179,"_25347":60159,"_5":25680,"_17690":102795,"_23966":102796,"_2399":102797},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2872":60180,"_25347":60159,"_5":25680,"_17690":102799,"_23966":102800,"_2399":102801},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2872":60181,"_25347":60159,"_17690":102803,"_5":17585,"_23966":60159,"_2399":102804},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2872":60182,"_25347":60159,"_17690":102806,"_5":17585,"_23966":60159,"_2399":102807},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2872":60183,"_25347":60159,"_17690":102809,"_5":17585,"_23966":102732,"_2399":102810},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2872":60184,"_25347":60159,"_17690":102812,"_5":17585,"_23966":102732,"_2399":102813},[],"En la práctica, permite:",{"_2872":60185,"_25347":60159,"_17690":102815,"_5":17585,"_23966":102732,"_2399":102816},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2872":60186,"_25347":60159,"_17690":102818,"_5":17585,"_23966":102732,"_2399":102819},[],"Importar claves creadas externamente.",{"_2872":60187,"_25347":60159,"_17690":102821,"_5":17585,"_23966":102732,"_2399":102822},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2872":60188,"_25347":60159,"_17690":102824,"_5":17585,"_23966":102732,"_2399":102825},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2872":60189,"_25347":60159,"_17690":102827,"_5":17585,"_23966":102736,"_2399":102828},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2872":60190,"_25347":60159,"_17690":102830,"_5":17585,"_23966":102736,"_2399":102831},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2872":60191,"_25347":60159,"_17690":102833,"_5":17585,"_23966":102736,"_2399":102834},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2872":60192,"_25347":60159,"_17690":102836,"_5":17585,"_23966":102740,"_2399":102837},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2872":60193,"_25347":60159,"_17690":102839,"_5":17585,"_23966":102743,"_2399":102840},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2872":60194,"_25347":60159,"_17690":102842,"_5":17585,"_23966":102746,"_2399":102843},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2872":60195,"_25347":60159,"_17690":102845,"_5":17585,"_23966":102749,"_2399":102846},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2872":60196,"_25347":60159,"_17690":102848,"_5":17585,"_23966":102752,"_2399":102849},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2872":60197,"_25347":60159,"_17690":102851,"_5":17585,"_23966":102755,"_2399":102852},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2872":60198,"_25347":60159,"_17690":102854,"_5":17585,"_23966":102755,"_2399":102855},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2872":60199,"_25347":60159,"_17690":102857,"_5":17585,"_23966":102755,"_2399":102858},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2872":60200,"_25347":60159,"_17690":102860,"_5":17585,"_23966":102755,"_2399":102861},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2872":60201,"_25347":60159,"_17690":102863,"_5":17585,"_23966":102758,"_2399":102864},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2872":60202,"_25347":60159,"_17690":102866,"_5":17585,"_23966":102758,"_2399":102867},[],"La tabla incluye los siguientes campos:",{"_2872":60203,"_25347":60159,"_17690":102869,"_5":17585,"_23966":102758,"_2399":102870},[],"**Name**: nombre descriptivo de la clave.",{"_2872":60204,"_25347":60159,"_17690":102872,"_5":17585,"_23966":102758,"_2399":102873},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2872":60205,"_25347":60159,"_17690":102875,"_5":17585,"_23966":102758,"_2399":102876},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2872":60206,"_25347":60159,"_17690":102878,"_5":17585,"_23966":102758,"_2399":102879},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2872":60207,"_25347":60159,"_17690":102881,"_5":17585,"_23966":102758,"_2399":102882},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2872":60208,"_25347":60159,"_17690":102884,"_5":17585,"_23966":102758,"_2399":102885},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2872":60209,"_25347":60159,"_17690":102887,"_5":17585,"_23966":102758,"_2399":102888},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2872":60210,"_25347":60159,"_17690":102890,"_5":17585,"_23966":102758,"_2399":102891},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2872":60211,"_25347":60159,"_17690":102893,"_5":17585,"_23966":102758,"_2399":102894},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2872":60212,"_25347":60159,"_17690":102896,"_5":17585,"_23966":102758,"_2399":102897},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2872":60213,"_25347":60159,"_17690":102899,"_5":17585,"_23966":102758,"_2399":102900},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2872":60214,"_25347":60159,"_17690":102902,"_5":17585,"_23966":102758,"_2399":102903},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2872":60215,"_25347":60159,"_17690":102905,"_5":17585,"_23966":102758,"_2399":102906},[],"**Delete Key** para eliminar la clave del sistema.",{"_2872":60216,"_25347":60159,"_17690":102908,"_5":17585,"_23966":102762,"_2399":102909},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2872":60217,"_25347":60159,"_17690":102911,"_5":17585,"_23966":102766,"_2399":102912},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2872":60218,"_25347":60159,"_17690":102914,"_5":17585,"_23966":102766,"_2399":102915},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2872":60219,"_25347":60159,"_17690":102917,"_5":17585,"_23966":102766,"_2399":102918},[],"**Key Name**: nombre único y descriptivo.",{"_2872":60220,"_25347":60159,"_17690":102920,"_5":17585,"_23966":102766,"_2399":102921},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2872":60221,"_25347":60159,"_17690":102923,"_5":17585,"_23966":102766,"_2399":102924},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2872":60222,"_25347":60159,"_17690":102926,"_5":17585,"_23966":102766,"_2399":102927},[],"**Tags**: metadatos para clasificar la clave.",{"_2872":60223,"_25347":60159,"_17690":102929,"_5":17585,"_23966":102766,"_2399":102930},[],"**Metadata**: información adicional para usos avanzados.",{"_2872":60224,"_25347":60159,"_17690":102932,"_5":17585,"_23966":102770,"_2399":102933},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2872":60225,"_25347":60159,"_17690":102935,"_5":17585,"_23966":102770,"_2399":102936},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2872":60226,"_25347":60159,"_17690":102938,"_5":17585,"_23966":102770,"_2399":102939},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2872":60227,"_25347":60159,"_17690":102941,"_5":17585,"_23966":102770,"_2399":102942},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2872":60228,"_25347":60159,"_17690":102944,"_5":17585,"_23966":102770,"_2399":102945},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2872":60229,"_25347":60159,"_17690":102947,"_5":17585,"_23966":102770,"_2399":102948},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2872":60230,"_25347":60159,"_17690":102950,"_5":17585,"_23966":102770,"_2399":102951},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2872":60231,"_25347":60159,"_17690":102953,"_5":17585,"_23966":102770,"_2399":102954},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2872":60232,"_25347":60159,"_17690":102956,"_5":17585,"_23966":102770,"_2399":102957},[],"**Metadata**: información adicional opcional.",{"_2872":60233,"_25347":60159,"_17690":102959,"_5":17585,"_23966":102770,"_2399":102960},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2872":60234,"_25347":60159,"_17690":102962,"_5":17585,"_23966":102770,"_2399":102963},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2872":60235,"_25347":60159,"_17690":102965,"_5":17585,"_23966":102774,"_2399":102966},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2872":60236,"_25347":60159,"_17690":102968,"_5":17585,"_23966":102778,"_2399":102969},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2872":60237,"_25347":60159,"_17690":102971,"_5":17585,"_23966":102778,"_2399":102972},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2872":60238,"_25347":60159,"_17690":102974,"_5":17585,"_23966":102778,"_2399":102975},[],"**Key Name**: nombre descriptivo.",{"_2872":60239,"_25347":60159,"_17690":102977,"_5":17585,"_23966":102778,"_2399":102978},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2872":60240,"_25347":60159,"_17690":102980,"_5":17585,"_23966":102778,"_2399":102981},[],"**Tags**: etiquetas asociadas.",{"_2872":60241,"_25347":60159,"_17690":102983,"_5":17585,"_23966":102778,"_2399":102984},[],"**Aliases**: nombres alternativos.",{"_2872":60242,"_25347":60159,"_17690":102986,"_5":17585,"_23966":102778,"_2399":102987},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2872":60243,"_25347":60159,"_17690":102989,"_5":17585,"_23966":102778,"_2399":102990},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2872":60244,"_25347":60159,"_17690":102992,"_5":17585,"_23966":102778,"_2399":102993},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2872":60245,"_25347":60159,"_17690":102995,"_5":17585,"_23966":102778,"_2399":102996},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2872":60246,"_25347":60159,"_17690":102998,"_5":17585,"_23966":102782,"_2399":102999},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2872":60247,"_25347":60159,"_17690":103001,"_5":17585,"_23966":102782,"_2399":103002},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2872":60248,"_25347":60159,"_17690":103004,"_5":17585,"_23966":102782,"_2399":103005},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2872":60249,"_25347":60159,"_17690":103007,"_5":17585,"_23966":102786,"_2399":103008},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2872":60250,"_25347":60159,"_17690":103010,"_5":17585,"_23966":102786,"_2399":103011},[],"Campos principales:",{"_2872":60251,"_25347":60159,"_17690":103013,"_5":17585,"_23966":102786,"_2399":103014},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2872":60252,"_25347":60159,"_17690":103016,"_5":17585,"_23966":102786,"_2399":103017},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2872":60253,"_25347":60159,"_17690":103019,"_5":17585,"_23966":102786,"_2399":103020},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2872":60254,"_25347":60159,"_17690":103022,"_5":17585,"_23966":102786,"_2399":103023},[],"**Message**: contenido que se va a firmar.",{"_2872":60255,"_25347":60159,"_17690":103025,"_5":17585,"_23966":102786,"_2399":103026},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2872":60256,"_25347":60159,"_17690":103028,"_5":17585,"_23966":102789,"_2399":103029},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2872":60257,"_25347":60159,"_17690":103031,"_5":17585,"_23966":102789,"_2399":103011},[],{"_2872":60258,"_25347":60159,"_17690":103033,"_5":17585,"_23966":102789,"_2399":103034},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2872":60259,"_25347":60159,"_17690":103036,"_5":17585,"_23966":102789,"_2399":103037},[],"**Message Type**: `Raw` o `Digest`.",{"_2872":60260,"_25347":60159,"_17690":103039,"_5":17585,"_23966":102789,"_2399":103040},[],"**Payload Encoding**: codificación del mensaje.",{"_2872":60261,"_25347":60159,"_17690":103042,"_5":17585,"_23966":102789,"_2399":103043},[],"**Message**: mensaje original o hash.",{"_2872":60262,"_25347":60159,"_17690":103045,"_5":17585,"_23966":102789,"_2399":103046},[],"**Signature**: firma que se desea comprobar.",{"_2872":60263,"_25347":60159,"_17690":103048,"_5":17585,"_23966":102789,"_2399":103049},[],"**Result**: indicador del resultado de la validación.",{"_2872":60264,"_25347":60159,"_17690":103051,"_5":17585,"_23966":102792,"_2399":103052},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2872":60265,"_25347":60159,"_17690":103054,"_5":17585,"_23966":102792,"_2399":103055},[],"Este flujo es útil para:",{"_2872":60266,"_25347":60159,"_17690":103057,"_5":17585,"_23966":102792,"_2399":103058},[],"Solicitar certificados a una CA externa.",{"_2872":60267,"_25347":60159,"_17690":103060,"_5":17585,"_23966":102792,"_2399":103061},[],"Renovar una identidad manteniendo la misma clave.",{"_2872":60268,"_25347":60159,"_17690":103063,"_5":17585,"_23966":102792,"_2399":103064},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2872":60269,"_25347":60159,"_17690":103066,"_5":17585,"_23966":102792,"_2399":103067},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2872":60270,"_25347":60159,"_17690":103069,"_5":17585,"_23966":102792,"_2399":103070},[],"**Organization (O)**: organización o empresa.",{"_2872":60271,"_25347":60159,"_17690":103072,"_5":17585,"_23966":102792,"_2399":103073},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2872":60272,"_25347":60159,"_17690":103075,"_5":17585,"_23966":102792,"_2399":103076},[],"**Country (C)**: código de país de dos letras.",{"_2872":60273,"_25347":60159,"_17690":103078,"_5":17585,"_23966":102792,"_2399":103079},[],"**State / Province (ST)**: estado o provincia.",{"_2872":60274,"_25347":60159,"_17690":103081,"_5":17585,"_23966":102792,"_2399":103082},[],"**Locality (L)**: ciudad o localidad.",{"_2872":60275,"_25347":60159,"_17690":103084,"_5":17585,"_23966":102792,"_2399":103085},[],"**Email Address**: correo de contacto.",{"_2872":60276,"_25347":60159,"_17690":103087,"_5":17585,"_23966":102792,"_2399":103088},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2872":60277,"_25347":60159,"_17690":103090,"_5":17585,"_23966":102792,"_2399":103091},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2872":60278,"_25347":60159,"_17690":103093,"_5":17585,"_23966":102796,"_2399":103094},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2872":60279,"_25347":60159,"_17690":103096,"_5":17585,"_23966":102796,"_2399":47858},[],{"_2872":60280,"_25347":60159,"_17690":103098,"_5":17585,"_23966":102800,"_2399":103099},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2872":60281,"_25347":60281,"_5":12438,"_2399":103101,"_25683":103102,"_17690":103103,"_23966":60281},"Validación online con OCSP",[41104,97860,46175,102050],[],{"_2872":60282,"_25347":60281,"_17690":103105,"_5":17585,"_23966":60281,"_2399":103106},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2872":60283,"_25347":60281,"_5":25680,"_17690":103108,"_23966":103109,"_2399":103110},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2872":60284,"_25347":60281,"_5":25680,"_17690":103112,"_23966":103113,"_2399":103114},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2872":60285,"_25347":60281,"_5":25680,"_17690":103116,"_23966":103117,"_2399":103118},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2872":60286,"_25347":60281,"_5":25680,"_17690":103120,"_23966":103121,"_2399":103122},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2872":60287,"_25347":60281,"_5":25680,"_17690":103124,"_23966":103125,"_2399":103126},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2872":60288,"_25347":60281,"_5":25680,"_17690":103128,"_23966":103129,"_2399":102595},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#referencias",{"_2872":60289,"_25347":60281,"_17690":103131,"_5":17585,"_23966":60281,"_2399":103132},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2872":60290,"_25347":60281,"_17690":103134,"_5":17585,"_23966":103109,"_2399":103135},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2872":60291,"_25347":60281,"_17690":103137,"_5":17585,"_23966":103109,"_2399":103138},[],"Estado del registro",{"_2872":60292,"_25347":60281,"_17690":103140,"_5":17585,"_23966":103109,"_2399":103141},[],"Respuesta firmada",{"_2872":60293,"_25347":60281,"_17690":103143,"_5":17585,"_23966":103109,"_2399":45353},[],{"_2872":60294,"_25347":60281,"_17690":103145,"_5":17585,"_23966":103109,"_2399":47908},[],{"_2872":60295,"_25347":60281,"_17690":103147,"_5":17585,"_23966":103109,"_2399":45370},[],{"_2872":60296,"_25347":60281,"_17690":103149,"_5":17585,"_23966":103109,"_2399":103150},[],"`Revoked`, con razón y fecha de revocación.",{"_2872":60297,"_25347":60281,"_17690":103152,"_5":17585,"_23966":103109,"_2399":103153},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2872":60298,"_25347":60281,"_17690":103155,"_5":17585,"_23966":103109,"_2399":103156},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2872":60299,"_25347":60281,"_17690":103158,"_5":17585,"_23966":103109,"_2399":103159},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2872":60300,"_25347":60281,"_17690":103161,"_5":17585,"_23966":103109,"_2399":103162},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2872":60301,"_25347":60281,"_17690":103164,"_5":17585,"_23966":103109,"_2399":103165},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2872":60302,"_25347":60281,"_17690":103167,"_5":17585,"_23966":103113,"_2399":103168},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2872":60303,"_25347":60281,"_17690":103170,"_5":17585,"_23966":103113,"_2399":103171},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2872":60304,"_25347":60281,"_17690":103173,"_5":17585,"_23966":103117,"_2399":103174},[],"El servicio acepta:",{"_2872":60305,"_25347":60281,"_17690":103176,"_5":17585,"_23966":103117,"_2399":99542},[],{"_2872":60306,"_25347":60281,"_17690":103178,"_5":17585,"_23966":103117,"_2399":103179},[],"Ruta del servicio VA",{"_2872":60307,"_25347":60281,"_17690":103181,"_5":17585,"_23966":103117,"_2399":103182},[],"Formato",{"_2872":60308,"_25347":60281,"_17690":103184,"_5":17585,"_23966":103117,"_2399":47948},[],{"_2872":60309,"_25347":60281,"_17690":103186,"_5":17585,"_23966":103117,"_2399":47951},[],{"_2872":60310,"_25347":60281,"_17690":103188,"_5":17585,"_23966":103117,"_2399":103189},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2872":60311,"_25347":60281,"_17690":103191,"_5":17585,"_23966":103117,"_2399":47437},[],{"_2872":60312,"_25347":60281,"_17690":103193,"_5":17585,"_23966":103117,"_2399":47959},[],{"_2872":60313,"_25347":60281,"_17690":103195,"_5":17585,"_23966":103117,"_2399":103196},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2872":60314,"_25347":60281,"_17690":103198,"_5":17585,"_23966":103117,"_2399":103199},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2872":60315,"_25347":60281,"_17690":103201,"_5":17585,"_23966":103121,"_2399":103202},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2872":60316,"_25347":60281,"_17690":103204,"_5":17585,"_23966":103121,"_2399":103205},[],"Genera la solicitud:",{"_2872":60317,"_25347":60281,"_17690":103207,"_5":17585,"_23966":103121,"_2399":103208},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2872":60318,"_25347":60281,"_17690":103210,"_5":17585,"_23966":103121,"_2399":103211},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2872":60319,"_25347":60281,"_17690":103213,"_5":17585,"_23966":103121,"_2399":103214},[],"Verifica el DER recibido:",{"_2872":60320,"_25347":60281,"_17690":103216,"_5":17585,"_23966":103121,"_2399":103217},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2872":60321,"_25347":60281,"_17690":103219,"_5":17585,"_23966":103125,"_2399":103220},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2872":60322,"_25347":60281,"_17690":103222,"_5":17585,"_23966":103125,"_2399":103223},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2872":60323,"_25347":60281,"_17690":103225,"_5":17585,"_23966":103129,"_2399":47992},[],{"_2872":60324,"_25347":60281,"_17690":103227,"_5":17585,"_23966":103129,"_2399":47995},[],{"_2872":60325,"_25347":60281,"_17690":103229,"_5":17585,"_23966":103129,"_2399":103230},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2872":60326,"_25347":60281,"_17690":103232,"_5":17585,"_23966":103129,"_2399":102722},[],{"_2872":60327,"_25347":60327,"_5":12438,"_2399":46175,"_25683":103234,"_17690":103235,"_23966":60327},[41104,97860,46175],[],{"_2872":60328,"_25347":60327,"_17690":103237,"_5":17585,"_23966":60327,"_2399":103238},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2872":60329,"_25347":60327,"_5":25680,"_17690":103240,"_23966":103241,"_2399":100759},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#empieza-aquí",{"_2872":60330,"_25347":60327,"_5":25680,"_17690":103243,"_23966":103244,"_2399":103245},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2872":60331,"_25347":60327,"_5":25680,"_17690":103247,"_23966":103248,"_2399":101281},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#capacidades-principales",{"_2872":60332,"_25347":60327,"_5":25680,"_17690":103250,"_23966":103251,"_2399":101285},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2872":60333,"_25347":60327,"_5":25680,"_17690":103253,"_23966":103254,"_2399":101289},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2872":60334,"_25347":60327,"_5":25680,"_17690":103256,"_23966":103257,"_2399":101293},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#emite-y-controla-certificados",{"_2872":60335,"_25347":60327,"_5":25680,"_17690":103259,"_23966":103260,"_2399":101301},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#publica-el-estado-de-validación",{"_2872":60336,"_25347":60327,"_5":25680,"_17690":103262,"_23966":103263,"_2399":103264},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2872":60337,"_25347":60327,"_5":25680,"_17690":103266,"_23966":103267,"_2399":102216},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#continúa",{"_2872":60338,"_25347":60327,"_17690":103269,"_5":17585,"_23966":60327,"_2399":103270},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2872":60339,"_25347":60327,"_17690":103272,"_5":17585,"_23966":103241,"_2399":103273},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2872":60340,"_25347":60327,"_17690":103275,"_5":17585,"_23966":103241,"_2399":103276},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2872":60341,"_25347":60327,"_17690":103278,"_5":17585,"_23966":103244,"_2399":103279},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2872":60342,"_25347":60327,"_17690":103281,"_5":17585,"_23966":103244,"_2399":103282},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2872":60343,"_25347":60327,"_17690":103284,"_5":17585,"_23966":103244,"_2399":103285},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2872":60344,"_25347":60327,"_17690":103287,"_5":17585,"_23966":103244,"_2399":103288},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2872":60345,"_25347":60327,"_17690":103290,"_5":17585,"_23966":103244,"_2399":103291},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2872":60346,"_25347":60327,"_17690":103293,"_5":17585,"_23966":103251,"_2399":103294},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2872":60347,"_25347":60327,"_17690":103296,"_5":17585,"_23966":103254,"_2399":103297},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2872":60348,"_25347":60327,"_17690":103299,"_5":17585,"_23966":103257,"_2399":103300},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2872":60349,"_25347":60327,"_17690":103302,"_5":17585,"_23966":103260,"_2399":103303},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2872":60350,"_25347":60327,"_17690":103305,"_5":17585,"_23966":103263,"_2399":103306},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2872":60351,"_25347":60327,"_17690":103308,"_5":17585,"_23966":103263,"_2399":103309},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2872":60352,"_25347":60327,"_17690":103311,"_5":17585,"_23966":103263,"_2399":103312},[],"su clave pública corresponda a la clave privada del cliente;",{"_2872":60353,"_25347":60327,"_17690":103314,"_5":17585,"_23966":103263,"_2399":103315},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2872":60354,"_25347":60327,"_17690":103317,"_5":17585,"_23966":103263,"_2399":103318},[],"sus fechas y usos permitan la operación;",{"_2872":60355,"_25347":60327,"_17690":103320,"_5":17585,"_23966":103263,"_2399":103321},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2872":60356,"_25347":60327,"_17690":103323,"_5":17585,"_23966":103263,"_2399":103324},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2872":60357,"_25347":60327,"_17690":103326,"_5":17585,"_23966":103267,"_2399":103327},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2872":60358,"_25347":60327,"_17690":103329,"_5":17585,"_23966":103267,"_2399":103330},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2872":60359,"_25347":60327,"_17690":103332,"_5":17585,"_23966":103267,"_2399":103333},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2872":60360,"_25347":60360,"_5":12438,"_2399":103335,"_25683":103336,"_17690":103337,"_23966":60360},"Crea tu primera CA",[41104,97860,46175,100883],[],{"_2872":60361,"_25347":60360,"_17690":103339,"_5":17585,"_23966":60360,"_2399":103340},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2872":60362,"_25347":60360,"_5":25680,"_17690":103342,"_23966":103343,"_2399":96512},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2872":60363,"_25347":60360,"_5":25680,"_17690":103345,"_23966":103346,"_2399":103347},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2872":60364,"_25347":60360,"_5":25680,"_17690":103349,"_23966":103350,"_2399":103351},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2872":60365,"_25347":60360,"_5":25680,"_17690":103353,"_23966":103354,"_2399":103355},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2872":60366,"_25347":60360,"_5":25680,"_17690":103357,"_23966":103358,"_2399":103359},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2872":60367,"_25347":60360,"_5":25680,"_17690":103361,"_23966":103362,"_2399":103363},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2872":60368,"_25347":60360,"_5":25680,"_17690":103365,"_23966":103366,"_2399":103367},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2872":60369,"_25347":60360,"_5":25680,"_17690":103369,"_23966":103370,"_2399":101131},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2872":60370,"_25347":60360,"_5":25680,"_17690":103372,"_23966":103373,"_2399":96536},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2872":60371,"_25347":60360,"_17690":103375,"_5":17585,"_23966":60360,"_2399":103376},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2872":60372,"_25347":60360,"_17690":103378,"_5":17585,"_23966":103343,"_2399":103379},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2872":60373,"_25347":60360,"_17690":103381,"_5":17585,"_23966":103343,"_2399":103382},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2872":60374,"_25347":60360,"_17690":103384,"_5":17585,"_23966":103343,"_2399":103385},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2872":60375,"_25347":60360,"_17690":103387,"_5":17585,"_23966":103343,"_2399":103388},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2872":60376,"_25347":60360,"_17690":103390,"_5":17585,"_23966":103346,"_2399":103391},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2872":60377,"_25347":60360,"_17690":103393,"_5":17585,"_23966":103346,"_2399":103394},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2872":60378,"_25347":60360,"_17690":103396,"_5":17585,"_23966":103350,"_2399":103397},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2872":60379,"_25347":60360,"_17690":103399,"_5":17585,"_23966":103350,"_2399":103400},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2872":60380,"_25347":60360,"_17690":103402,"_5":17585,"_23966":103354,"_2399":103403},[],"Selecciona **Root CA** y completa:",{"_2872":60381,"_25347":60360,"_17690":103405,"_5":17585,"_23966":103354,"_2399":48174},[],{"_2872":60382,"_25347":60360,"_17690":103407,"_5":17585,"_23966":103354,"_2399":103408},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2872":60383,"_25347":60360,"_17690":103410,"_5":17585,"_23966":103354,"_2399":103411},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2872":60384,"_25347":60360,"_17690":103413,"_5":17585,"_23966":103354,"_2399":103414},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2872":60385,"_25347":60360,"_17690":103416,"_5":17585,"_23966":103354,"_2399":103417},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2872":60386,"_25347":60360,"_17690":103419,"_5":17585,"_23966":103358,"_2399":103420},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2872":60387,"_25347":60360,"_17690":103422,"_5":17585,"_23966":103362,"_2399":103423},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2872":60388,"_25347":60360,"_17690":103425,"_5":17585,"_23966":103362,"_2399":103426},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2872":60389,"_25347":60360,"_17690":103428,"_5":17585,"_23966":103366,"_2399":103429},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2872":60390,"_25347":60360,"_17690":103431,"_5":17585,"_23966":103366,"_2399":103432},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2872":60391,"_25347":60360,"_17690":103434,"_5":17585,"_23966":103366,"_2399":103435},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2872":60392,"_25347":60360,"_17690":103437,"_5":17585,"_23966":103370,"_2399":103438},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2872":60393,"_25347":60360,"_17690":103440,"_5":17585,"_23966":103370,"_2399":103441},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2872":60394,"_25347":60360,"_17690":103443,"_5":17585,"_23966":103370,"_2399":103444},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2872":60395,"_25347":60360,"_17690":103446,"_5":17585,"_23966":103370,"_2399":103447},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2872":60396,"_25347":60360,"_17690":103449,"_5":17585,"_23966":103373,"_2399":103450},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2872":60397,"_25347":60397,"_5":12438,"_2399":103452,"_25683":103453,"_17690":103454,"_23966":60397},"Emite y verifica un certificado",[41104,97860,46175,100883],[],{"_2872":60398,"_25347":60397,"_17690":103456,"_5":17585,"_23966":60397,"_2399":103457},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2872":60399,"_25347":60397,"_5":25680,"_17690":103459,"_23966":103460,"_2399":96512},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2872":60400,"_25347":60397,"_5":25680,"_17690":103462,"_23966":103463,"_2399":103464},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2872":60401,"_25347":60397,"_5":25680,"_17690":103466,"_23966":103467,"_2399":103468},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2872":60402,"_25347":60397,"_5":25680,"_17690":103470,"_23966":103471,"_2399":103472},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2872":60403,"_25347":60397,"_5":25680,"_17690":103474,"_23966":103475,"_2399":103476},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2872":60404,"_25347":60397,"_5":25680,"_17690":103478,"_23966":103479,"_2399":103480},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2872":60405,"_25347":60397,"_5":25680,"_17690":103482,"_23966":103483,"_2399":103363},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2872":60406,"_25347":60397,"_5":25680,"_17690":103485,"_23966":103486,"_2399":103487},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2872":60407,"_25347":60397,"_5":25680,"_17690":103489,"_23966":103490,"_2399":103491},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2872":60408,"_25347":60397,"_5":25680,"_17690":103493,"_23966":103494,"_2399":103495},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2872":60409,"_25347":60397,"_5":25680,"_17690":103497,"_23966":103498,"_2399":101131},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2872":60410,"_25347":60397,"_5":25680,"_17690":103500,"_23966":103501,"_2399":96536},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2872":60411,"_25347":60397,"_17690":103503,"_5":17585,"_23966":60397,"_2399":103504},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2872":60412,"_25347":60397,"_17690":103506,"_5":17585,"_23966":103460,"_2399":103507},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2872":60413,"_25347":60397,"_17690":103509,"_5":17585,"_23966":103460,"_2399":103510},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2872":60414,"_25347":60397,"_17690":103512,"_5":17585,"_23966":103460,"_2399":103513},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2872":60415,"_25347":60397,"_17690":103515,"_5":17585,"_23966":103460,"_2399":103516},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2872":60416,"_25347":60397,"_17690":103518,"_5":17585,"_23966":103460,"_2399":103519},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2872":60417,"_25347":60397,"_17690":103521,"_5":17585,"_23966":103463,"_2399":103522},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2872":60418,"_25347":60397,"_17690":103524,"_5":17585,"_23966":103467,"_2399":103525},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2872":60419,"_25347":60397,"_17690":103527,"_5":17585,"_23966":103467,"_2399":103528},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2872":60420,"_25347":60397,"_17690":103530,"_5":17585,"_23966":103471,"_2399":103531},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2872":60421,"_25347":60397,"_17690":103533,"_5":17585,"_23966":103471,"_2399":103534},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2872":60422,"_25347":60397,"_17690":103536,"_5":17585,"_23966":103475,"_2399":103537},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2872":60423,"_25347":60397,"_17690":103539,"_5":17585,"_23966":103475,"_2399":103540},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2872":60424,"_25347":60397,"_17690":103542,"_5":17585,"_23966":103479,"_2399":103543},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2872":60425,"_25347":60397,"_17690":103545,"_5":17585,"_23966":103483,"_2399":103546},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2872":60426,"_25347":60397,"_17690":103548,"_5":17585,"_23966":103486,"_2399":103549},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2872":60427,"_25347":60397,"_17690":103551,"_5":17585,"_23966":103490,"_2399":103552},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2872":60428,"_25347":60397,"_17690":103554,"_5":17585,"_23966":103490,"_2399":103555},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2872":60429,"_25347":60397,"_17690":103557,"_5":17585,"_23966":103490,"_2399":103558},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2872":60430,"_25347":60397,"_17690":103560,"_5":17585,"_23966":103494,"_2399":103561},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2872":60431,"_25347":60397,"_17690":103563,"_5":17585,"_23966":103494,"_2399":103564},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2872":60432,"_25347":60397,"_17690":103566,"_5":17585,"_23966":103494,"_2399":103567},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2872":60433,"_25347":60397,"_17690":103569,"_5":17585,"_23966":103498,"_2399":101214},[],{"_2872":60434,"_25347":60397,"_17690":103571,"_5":17585,"_23966":103498,"_2399":99991},[],{"_2872":60435,"_25347":60397,"_17690":103573,"_5":17585,"_23966":103498,"_2399":103574},[],"La CA rechaza la emisión",{"_2872":60436,"_25347":60397,"_17690":103576,"_5":17585,"_23966":103498,"_2399":103577},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2872":60437,"_25347":60397,"_17690":103579,"_5":17585,"_23966":103498,"_2399":103580},[],"Sujeto o usos diferentes",{"_2872":60438,"_25347":60397,"_17690":103582,"_5":17585,"_23966":103498,"_2399":103583},[],"Perfil aplicado y valores solicitados.",{"_2872":60439,"_25347":60397,"_17690":103585,"_5":17585,"_23966":103498,"_2399":103586},[],"No se encuentra el emisor",{"_2872":60440,"_25347":60397,"_17690":103588,"_5":17585,"_23966":103498,"_2399":103589},[],"CA descargada y cadena intermedia necesaria.",{"_2872":60441,"_25347":60397,"_17690":103591,"_5":17585,"_23966":103498,"_2399":103592},[],"Falla la vigencia",{"_2872":60442,"_25347":60397,"_17690":103594,"_5":17585,"_23966":103498,"_2399":103595},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2872":60443,"_25347":60397,"_17690":103597,"_5":17585,"_23966":103498,"_2399":103598},[],"Los resúmenes de clave difieren",{"_2872":60444,"_25347":60397,"_17690":103600,"_5":17585,"_23966":103498,"_2399":103601},[],"Archivos de certificado y clave de la misma emisión.",{"_2872":60445,"_25347":60397,"_17690":103603,"_5":17585,"_23966":103498,"_2399":103604},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2872":60446,"_25347":60397,"_17690":103606,"_5":17585,"_23966":103501,"_2399":103607},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2872":60447,"_25347":60397,"_17690":103609,"_5":17585,"_23966":103501,"_2399":103610},[],"Gestionar certificados para inspección, estado y revocación.",{"_2872":60448,"_25347":60397,"_17690":103612,"_5":17585,"_23966":103501,"_2399":103613},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2872":60449,"_25347":60397,"_17690":103615,"_5":17585,"_23966":103501,"_2399":103616},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2872":60450,"_25347":60397,"_17690":103618,"_5":17585,"_23966":103501,"_2399":103619},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2872":60451,"_25347":60451,"_5":12438,"_2399":103621,"_25683":103622,"_17690":103623,"_23966":60451},"Primeros pasos de PKI",[41104,97860,46175,100883],[],{"_2872":60452,"_25347":60451,"_17690":103625,"_5":17585,"_23966":60451,"_2399":103626},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2872":60453,"_25347":60451,"_5":25680,"_17690":103628,"_23966":103629,"_2399":96512},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2872":60454,"_25347":60451,"_5":25680,"_17690":103631,"_23966":103632,"_2399":103633},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2872":60455,"_25347":60451,"_5":25680,"_17690":103635,"_23966":103636,"_2399":101065},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2872":60456,"_25347":60451,"_5":25680,"_17690":103638,"_23966":103639,"_2399":103640},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2872":60457,"_25347":60451,"_17690":103642,"_5":17585,"_23966":60451,"_2399":103643},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2872":60458,"_25347":60451,"_17690":103645,"_5":17585,"_23966":103629,"_2399":103646},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2872":60459,"_25347":60451,"_17690":103648,"_5":17585,"_23966":103629,"_2399":103649},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2872":60460,"_25347":60451,"_17690":103651,"_5":17585,"_23966":103629,"_2399":103652},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2872":60461,"_25347":60451,"_17690":103654,"_5":17585,"_23966":103629,"_2399":103655},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2872":60462,"_25347":60451,"_17690":103657,"_5":17585,"_23966":103629,"_2399":103658},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2872":60463,"_25347":60451,"_17690":103660,"_5":17585,"_23966":103632,"_2399":103661},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2872":60464,"_25347":60451,"_17690":103663,"_5":17585,"_23966":103632,"_2399":103664},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2872":60465,"_25347":60451,"_17690":103666,"_5":17585,"_23966":103632,"_2399":103667},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2872":60466,"_25347":60451,"_17690":103669,"_5":17585,"_23966":103632,"_2399":103670},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2872":60467,"_25347":60451,"_17690":103672,"_5":17585,"_23966":103636,"_2399":103673},[],"Archivo o recurso",{"_2872":60468,"_25347":60451,"_17690":103675,"_5":17585,"_23966":103636,"_2399":101062},[],{"_2872":60469,"_25347":60451,"_17690":103677,"_5":17585,"_23966":103636,"_2399":103678},[],"CA raíz activa y `ca.pem`",{"_2872":60470,"_25347":60451,"_17690":103680,"_5":17585,"_23966":103636,"_2399":103681},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2872":60471,"_25347":60451,"_17690":103683,"_5":17585,"_23966":103636,"_2399":103684},[],"Certificado final y `device.crt`",{"_2872":60472,"_25347":60451,"_17690":103686,"_5":17585,"_23966":103636,"_2399":103687},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2872":60473,"_25347":60451,"_17690":103689,"_5":17585,"_23966":103636,"_2399":103690},[],"Clave privada `device.key`",{"_2872":60474,"_25347":60451,"_17690":103692,"_5":17585,"_23966":103636,"_2399":103693},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2872":60475,"_25347":60451,"_17690":103695,"_5":17585,"_23966":103636,"_2399":103696},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2872":60476,"_25347":60451,"_17690":103698,"_5":17585,"_23966":103639,"_2399":103699},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2872":60477,"_25347":60451,"_17690":103701,"_5":17585,"_23966":103639,"_2399":103702},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2872":60478,"_25347":60451,"_17690":103704,"_5":17585,"_23966":103639,"_2399":103705},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2872":60479,"_25347":60479,"_5":12438,"_2399":103707,"_25683":103708,"_17690":103710,"_23966":60479},"Resolución de problemas PKI",[41104,97860,46175,103709],"Resolución de problemas",[],{"_2872":60480,"_25347":60479,"_17690":103712,"_5":17585,"_23966":60479,"_2399":103713},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2872":60481,"_25347":60479,"_5":25680,"_17690":103715,"_23966":103716,"_2399":103717},[],"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2872":60482,"_25347":60479,"_5":25680,"_17690":103719,"_23966":103720,"_2399":103721},[],"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2872":60483,"_25347":60479,"_5":25680,"_17690":103723,"_23966":103724,"_2399":103725},[],"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2872":60484,"_25347":60479,"_17690":103727,"_5":17585,"_23966":60479,"_2399":103728},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2872":60485,"_25347":60479,"_17690":103730,"_5":17585,"_23966":60479,"_2399":103731},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2872":60486,"_25347":60479,"_17690":103733,"_5":17585,"_23966":103716,"_2399":101062},[],{"_2872":60487,"_25347":60479,"_17690":103735,"_5":17585,"_23966":103716,"_2399":99991},[],{"_2872":60488,"_25347":60479,"_17690":103737,"_5":17585,"_23966":103716,"_2399":96536},[],{"_2872":60489,"_25347":60479,"_17690":103739,"_5":17585,"_23966":103716,"_2399":48510},[],{"_2872":60490,"_25347":60479,"_17690":103741,"_5":17585,"_23966":103716,"_2399":103742},[],"Existe, está activa y sus fechas son utilizables.",{"_2872":60491,"_25347":60479,"_17690":103744,"_5":17585,"_23966":103716,"_2399":103745},[],"Autoridades.",{"_2872":60492,"_25347":60479,"_17690":103747,"_5":17585,"_23966":103716,"_2399":103748},[],"Clave",{"_2872":60493,"_25347":60479,"_17690":103750,"_5":17585,"_23966":103716,"_2399":103751},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2872":60494,"_25347":60479,"_17690":103753,"_5":17585,"_23966":103716,"_2399":103754},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2872":60495,"_25347":60479,"_17690":103756,"_5":17585,"_23966":103716,"_2399":48528},[],{"_2872":60496,"_25347":60479,"_17690":103758,"_5":17585,"_23966":103716,"_2399":103759},[],"PEM correcto y firma verificable.",{"_2872":60497,"_25347":60479,"_17690":103761,"_5":17585,"_23966":103716,"_2399":48534},[],{"_2872":60498,"_25347":60479,"_17690":103763,"_5":17585,"_23966":103716,"_2399":103764},[],"Perfil",{"_2872":60499,"_25347":60479,"_17690":103766,"_5":17585,"_23966":103716,"_2399":103767},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2872":60500,"_25347":60479,"_17690":103769,"_5":17585,"_23966":103716,"_2399":103770},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2872":60501,"_25347":60479,"_17690":103772,"_5":17585,"_23966":103716,"_2399":101214},[],{"_2872":60502,"_25347":60479,"_17690":103774,"_5":17585,"_23966":103716,"_2399":103775},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2872":60503,"_25347":60479,"_17690":103777,"_5":17585,"_23966":103716,"_2399":103778},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2872":60504,"_25347":60479,"_17690":103780,"_5":17585,"_23966":103716,"_2399":103781},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2872":60505,"_25347":60479,"_17690":103783,"_5":17585,"_23966":103716,"_2399":103784},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2872":60506,"_25347":60479,"_17690":103786,"_5":17585,"_23966":103720,"_2399":103787},[],"Revisa cada frontera por separado:",{"_2872":60507,"_25347":60479,"_17690":103789,"_5":17585,"_23966":103720,"_2399":103790},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2872":60508,"_25347":60479,"_17690":103792,"_5":17585,"_23966":103720,"_2399":103793},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2872":60509,"_25347":60479,"_17690":103795,"_5":17585,"_23966":103720,"_2399":103796},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2872":60510,"_25347":60479,"_17690":103798,"_5":17585,"_23966":103720,"_2399":103799},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2872":60511,"_25347":60479,"_17690":103801,"_5":17585,"_23966":103720,"_2399":103802},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2872":60512,"_25347":60479,"_17690":103804,"_5":17585,"_23966":103720,"_2399":103805},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2872":60513,"_25347":60479,"_17690":103807,"_5":17585,"_23966":103724,"_2399":103808},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2872":60514,"_25347":60479,"_17690":103810,"_5":17585,"_23966":103724,"_2399":103811},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48588":103813,"_48590":103814,"_48592":103815,"_48594":103816,"_15302":2421,"_58129":2421},"spanish",[2399,25347,5,23966],{"_2399":21095,"_25347":21095,"_5":21095,"_23966":21095},{"_2399":103817,"_25347":106199,"_5":108581,"_23966":110963},{"_3852":103818,"_48598":103819,"_5":21095},{"_12183":15860,"_12526":12569,"_12533":2961,"_24528":4740,"_24079":5433,"_16804":6200,"_12204":6321,"_12211":6209,"_24474":3970,"_24840":20093,"_24861":18261,"_24503":6224,"_29151":6379,"_24872":6975,"_29156":5188,"_29159":2558,"_29162":6259,"_29165":5830,"_29168":8540,"_25194":13839,"_29173":2828,"_29175":7187,"_25242":5751,"_25184":3929,"_29179":13263,"_25210":20459,"_29183":6215,"_24890":6329,"_25189":6355,"_25260":14036,"_29188":4033,"_29190":4275,"_29192":8845,"_29194":11996,"_29196":2586,"_29198":6268,"_29200":4942,"_29202":9314,"_29204":4946,"_24541":10041,"_29207":8086,"_25405":9308,"_24535":23308,"_24916":4901,"_29212":5710,"_29214":6255,"_29217":5125,"_24571":2519,"_29221":9318,"_24465":2632,"_29224":3957,"_24508":4177,"_29227":4974,"_29229":16412,"_29232":8728,"_25237":14511,"_29235":5718,"_29237":5792,"_29240":3413,"_29242":3317,"_29244":15113,"_29246":17219,"_29248":4826,"_16807":5825,"_29251":14923,"_29253":13207,"_24481":6346,"_24884":5754,"_29257":3823,"_29259":9120,"_29261":3321,"_29263":2717,"_29265":7149,"_29267":5716,"_29269":4244,"_25343":2881,"_24932":17619,"_29273":5720,"_29275":10993,"_24519":6143,"_29278":5946,"_29280":9602,"_29282":6365,"_25265":17050,"_29285":6350,"_29287":3594,"_29289":3813,"_29291":5806,"_29293":12411,"_24617":3327,"_29298":2705,"_24878":8844,"_29301":5079,"_29303":2948,"_29305":4619,"_29307":4468,"_29309":5954,"_29311":17055,"_24611":6275,"_24845":6120,"_29315":6217,"_29317":21097,"_29320":14778,"_29322":6378,"_29324":12567,"_29326":7629,"_29328":5606,"_29330":3103,"_29333":11798,"_29335":4129,"_29337":18364,"_29339":4803,"_29341