91,"_37938":54494,"_37940":54497,"_37942":54500,"_37944":54503,"_37946":54506,"_37948":54509,"_37950":54512,"_37952":54515,"_37954":54518,"_37956":54521,"_37958":54524,"_37960":54527,"_37962":54530,"_37964":54533,"_37967":54536,"_37969":54539,"_37971":54542,"_37973":54545,"_37975":54548,"_37977":54551,"_37979":54554,"_37981":54557,"_37983":54560,"_37985":54563,"_37987":54566,"_37989":54569,"_37991":54572,"_37993":54575,"_37995":54578,"_37997":54581,"_37999":54584,"_38001":54587,"_38003":54590,"_38005":54593,"_38007":54596,"_38009":54599,"_38011":54602,"_38013":54605,"_38015":54608,"_38017":54611,"_38019":54614,"_38021":54617,"_38023":54620,"_38025":54623,"_38027":54626,"_38030":54629,"_38032":54632,"_38034":54635,"_38037":54638,"_38039":54641,"_38041":54644,"_38043":54647,"_38045":54650,"_38047":54653,"_38049":54656,"_38051":54659,"_38053":54662,"_38055":54665,"_38057":54668,"_38059":54671,"_38061":54674,"_38063":54677,"_38065":54680,"_38067":54683,"_38069":54686,"_38072":54689,"_38074":54692,"_38076":54695,"_38078":54698,"_38080":54701,"_38082":54704,"_38084":54707,"_38086":54710,"_38088":54713,"_38090":54716,"_38092":54719,"_38094":54722,"_38096":54725,"_38098":54728,"_38100":54731,"_38102":54734,"_38104":54737,"_38106":54740,"_38108":54743,"_38110":54746,"_38112":54749,"_38115":54752,"_38117":54755,"_38119":54758,"_38121":54761},{"_3226":15,"_28565":15,"_5":13914,"_2719":46295,"_28908":46296,"_19778":46300,"_25987":15},"Deploy from AWS Marketplace",[46297,46298,46299],"Docs","Deployment","Other models",[],{"_3226":16,"_28565":15,"_19778":46302,"_5":13556,"_25987":15,"_2719":46303},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3226":17,"_28565":15,"_5":28905,"_19778":46305,"_25987":46306,"_2719":46307},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3226":18,"_28565":15,"_5":28905,"_19778":46309,"_25987":46310,"_2719":46311},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3226":19,"_28565":15,"_5":28905,"_19778":46313,"_25987":46314,"_2719":46315},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3226":20,"_28565":15,"_5":28905,"_19778":46317,"_25987":46318,"_2719":46319},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3226":21,"_28565":15,"_5":28905,"_19778":46321,"_25987":46322,"_2719":46323},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3226":22,"_28565":15,"_5":28905,"_19778":46325,"_25987":46326,"_2719":46327},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3226":23,"_28565":15,"_5":28905,"_19778":46329,"_25987":46330,"_2719":46331},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#next-step","Next step",{"_3226":24,"_28565":15,"_19778":46333,"_5":13556,"_25987":15,"_2719":46334},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3226":25,"_28565":15,"_19778":46336,"_5":13556,"_25987":46306,"_2719":46337},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3226":26,"_28565":15,"_19778":46339,"_5":13556,"_25987":46306,"_2719":46340},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3226":27,"_28565":15,"_19778":46342,"_5":13556,"_25987":46306,"_2719":46343},[],"A security group allowing the necessary endpoints.",{"_3226":28,"_28565":15,"_19778":46345,"_5":13556,"_25987":46310,"_2719":46346},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3226":29,"_28565":15,"_19778":46348,"_5":13556,"_25987":46310,"_2719":46349},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3226":30,"_28565":15,"_19778":46351,"_5":13556,"_25987":46310,"_2719":46352},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3226":31,"_28565":15,"_19778":46354,"_5":13556,"_25987":46314,"_2719":46355},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3226":32,"_28565":15,"_19778":46357,"_5":13556,"_25987":46318,"_2719":46358},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3226":33,"_28565":15,"_19778":46360,"_5":13556,"_25987":46322,"_2719":46361},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3226":34,"_28565":15,"_19778":46363,"_5":13556,"_25987":46326,"_2719":46364},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3226":35,"_28565":15,"_19778":46366,"_5":13556,"_25987":46330,"_2719":46367},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3226":36,"_28565":36,"_5":13914,"_2719":46369,"_28908":46370,"_19778":46371,"_25987":36},"Deploy Lamassu",[46297,46298],[],{"_3226":37,"_28565":36,"_19778":46373,"_5":13556,"_25987":36,"_2719":46374},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3226":38,"_28565":36,"_5":28905,"_19778":46376,"_25987":46377,"_2719":46378},[],"/docs/pr-preview/pr-42/deployment/overview#choose-a-model","Choose a model",{"_3226":39,"_28565":36,"_5":28905,"_19778":46380,"_25987":46381,"_2719":46382},[],"/docs/pr-preview/pr-42/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3226":40,"_28565":36,"_5":28905,"_19778":46384,"_25987":46385,"_2719":46386},[],"/docs/pr-preview/pr-42/deployment/overview#after-deployment","After deployment",{"_3226":41,"_28565":36,"_19778":46388,"_5":13556,"_25987":36,"_2719":46389},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3226":42,"_28565":36,"_19778":46391,"_5":13556,"_25987":46377,"_2719":46392},[],"Model",{"_3226":43,"_28565":36,"_19778":46394,"_5":13556,"_25987":46377,"_2719":46395},[],"Recommended for",{"_3226":44,"_28565":36,"_19778":46397,"_5":13556,"_25987":46377,"_2719":46398},[],"Who operates the infrastructure",{"_3226":45,"_28565":36,"_19778":46400,"_5":13556,"_25987":46377,"_2719":46401},[],"Starting point",{"_3226":46,"_28565":36,"_19778":46403,"_5":13556,"_25987":46377,"_2719":46404},[],"Kubernetes self-managed",{"_3226":47,"_28565":36,"_19778":46406,"_5":13556,"_25987":46377,"_2719":46407},[],"Production, regulated environments and custom deployments",{"_3226":48,"_28565":36,"_19778":46409,"_5":13556,"_25987":46377,"_2719":46410},[],"Your team",{"_3226":49,"_28565":36,"_19778":46412,"_5":13556,"_25987":46377,"_2719":46413},[],"Helm or Fastlane",{"_3226":50,"_28565":36,"_19778":46415,"_5":13556,"_25987":46377,"_2719":46416},[],"AWS Marketplace",{"_3226":51,"_28565":36,"_19778":46418,"_5":13556,"_25987":46377,"_2719":46419},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3226":52,"_28565":36,"_19778":46421,"_5":13556,"_25987":46377,"_2719":46410},[],{"_3226":53,"_28565":36,"_19778":46423,"_5":13556,"_25987":46377,"_2719":46424},[],"Preconfigured image on EC2",{"_3226":54,"_28565":36,"_19778":46426,"_5":13556,"_25987":46377,"_2719":46427},[],"SaaS",{"_3226":55,"_28565":36,"_19778":46429,"_5":13556,"_25987":46377,"_2719":46430},[],"Teams that want to use the platform without operating it",{"_3226":56,"_28565":36,"_19778":46432,"_5":13556,"_25987":46377,"_2719":46433},[],"Lamassu",{"_3226":57,"_28565":36,"_19778":46435,"_5":13556,"_25987":46377,"_2719":46436},[],"Managed subscription",{"_3226":58,"_28565":36,"_19778":46438,"_5":13556,"_25987":46377,"_2719":46439},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3226":59,"_28565":36,"_19778":46441,"_5":13556,"_25987":46377,"_2719":46442},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3226":60,"_28565":36,"_19778":46444,"_5":13556,"_25987":46377,"_2719":46445},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3226":61,"_28565":36,"_19778":46447,"_5":13556,"_25987":46381,"_2719":46448},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3226":62,"_28565":36,"_19778":46450,"_5":13556,"_25987":46385,"_2719":46451},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3226":63,"_28565":63,"_5":13914,"_2719":46453,"_28908":46454,"_19778":46455,"_25987":63},"Use Lamassu as SaaS",[46297,46298,46299],[],{"_3226":64,"_28565":63,"_19778":46457,"_5":13556,"_25987":63,"_2719":46458},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3226":65,"_28565":63,"_5":28905,"_19778":46460,"_25987":46461,"_2719":46462},[],"/docs/pr-preview/pr-42/deployment/saas#what-the-service-manages","What the service manages",{"_3226":66,"_28565":63,"_5":28905,"_19778":46464,"_25987":46465,"_2719":46466},[],"/docs/pr-preview/pr-42/deployment/saas#plans","Plans",{"_3226":67,"_28565":63,"_5":28905,"_19778":46468,"_25987":46469,"_2719":46470},[],"/docs/pr-preview/pr-42/deployment/saas#request-access","Request access",{"_3226":68,"_28565":63,"_19778":46472,"_5":13556,"_25987":63,"_2719":46473},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3226":69,"_28565":63,"_19778":46475,"_5":13556,"_25987":46461,"_2719":46476},[],"Platform availability and maintenance.",{"_3226":70,"_28565":63,"_19778":46478,"_5":13556,"_25987":46461,"_2719":46479},[],"Automatic backups.",{"_3226":71,"_28565":63,"_19778":46481,"_5":13556,"_25987":46461,"_2719":46482},[],"Version upgrades.",{"_3226":72,"_28565":63,"_19778":46484,"_5":13556,"_25987":46461,"_2719":46485},[],"Technical support and SLA according to your plan.",{"_3226":73,"_28565":63,"_19778":46487,"_5":13556,"_25987":46465,"_2719":46488},[],"Plan",{"_3226":74,"_28565":63,"_19778":46490,"_5":13556,"_25987":46465,"_2719":46491},[],"Devices",{"_3226":75,"_28565":63,"_19778":46493,"_5":13556,"_25987":46465,"_2719":46494},[],"Support",{"_3226":76,"_28565":63,"_19778":46496,"_5":13556,"_25987":46465,"_2719":46497},[],"SLA",{"_3226":77,"_28565":63,"_19778":46499,"_5":13556,"_25987":46465,"_2719":46500},[],"Starter",{"_3226":78,"_28565":63,"_19778":46502,"_5":13556,"_25987":46465,"_2719":46503},[],"Up to 1,000",{"_3226":79,"_28565":63,"_19778":46505,"_5":13556,"_25987":46465,"_2719":46506},[],"Email",{"_3226":80,"_28565":63,"_19778":46508,"_5":13556,"_25987":46465,"_2719":46509},[],"99.5 %",{"_3226":81,"_28565":63,"_19778":46511,"_5":13556,"_25987":46465,"_2719":46512},[],"Professional",{"_3226":82,"_28565":63,"_19778":46514,"_5":13556,"_25987":46465,"_2719":46515},[],"Up to 10,000",{"_3226":83,"_28565":63,"_19778":46517,"_5":13556,"_25987":46465,"_2719":46518},[],"Email and chat",{"_3226":84,"_28565":63,"_19778":46520,"_5":13556,"_25987":46465,"_2719":46521},[],"99.9 %",{"_3226":85,"_28565":63,"_19778":46523,"_5":13556,"_25987":46465,"_2719":46524},[],"Enterprise",{"_3226":86,"_28565":63,"_19778":46526,"_5":13556,"_25987":46465,"_2719":46527},[],"Unlimited",{"_3226":87,"_28565":63,"_19778":46529,"_5":13556,"_25987":46465,"_2719":46530},[],"Dedicated",{"_3226":88,"_28565":63,"_19778":46532,"_5":13556,"_25987":46465,"_2719":46533},[],"99.99 %",{"_3226":89,"_28565":63,"_19778":46535,"_5":13556,"_25987":46469,"_2719":46536},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3226":90,"_28565":63,"_19778":46538,"_5":13556,"_25987":46469,"_2719":46539},[],"When you receive your instance's credentials, continue with Get started.",{"_3226":91,"_28565":91,"_5":13914,"_2719":46541,"_28908":46542,"_19778":46543,"_25987":91},"Fastlane",[46297,46298,46404],[],{"_3226":92,"_28565":91,"_19778":46545,"_5":13556,"_25987":91,"_2719":46546},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3226":93,"_28565":91,"_5":28905,"_19778":46548,"_25987":46549,"_2719":46550},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3226":94,"_28565":91,"_5":28905,"_19778":46552,"_25987":46553,"_2719":46554},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3226":95,"_28565":91,"_5":28905,"_19778":46556,"_25987":46557,"_2719":46307},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#before-you-begin",{"_3226":96,"_28565":91,"_5":28905,"_19778":46559,"_25987":46560,"_2719":46561},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3226":97,"_28565":91,"_5":28905,"_19778":46563,"_25987":46564,"_2719":46565},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3226":98,"_28565":91,"_5":28905,"_19778":46567,"_25987":46568,"_2719":46569},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3226":99,"_28565":91,"_5":28905,"_19778":46571,"_25987":46572,"_2719":46573},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3226":100,"_28565":91,"_5":28905,"_19778":46575,"_25987":46576,"_2719":46577},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3226":101,"_28565":91,"_5":28905,"_19778":46579,"_25987":46580,"_2719":46581},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3226":102,"_28565":91,"_5":28905,"_19778":46583,"_25987":46584,"_2719":46585},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3226":103,"_28565":91,"_5":28905,"_19778":46587,"_25987":46588,"_2719":46589},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3226":104,"_28565":91,"_19778":46591,"_5":13556,"_25987":46549,"_2719":46592},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3226":105,"_28565":91,"_19778":46594,"_5":13556,"_25987":46549,"_2719":46595},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3226":106,"_28565":91,"_19778":46597,"_5":13556,"_25987":46553,"_2719":46598},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3226":107,"_28565":91,"_19778":46600,"_5":13556,"_25987":46553,"_2719":46601},[],"Fastlane installs or configures",{"_3226":108,"_28565":91,"_19778":46603,"_5":13556,"_25987":46553,"_2719":46604},[],"You still provide",{"_3226":109,"_28565":91,"_19778":46606,"_5":13556,"_25987":46553,"_2719":46607},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3226":110,"_28565":91,"_19778":46609,"_5":13556,"_25987":46553,"_2719":46610},[],"The Kubernetes cluster, nodes and persistent storage",{"_3226":111,"_28565":91,"_19778":46612,"_5":13556,"_25987":46553,"_2719":46613},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3226":112,"_28565":91,"_19778":46615,"_5":13556,"_25987":46553,"_2719":46616},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3226":113,"_28565":91,"_19778":46618,"_5":13556,"_25987":46553,"_2719":46619},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3226":114,"_28565":91,"_19778":46621,"_5":13556,"_25987":46553,"_2719":46622},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3226":115,"_28565":91,"_19778":46624,"_5":13556,"_25987":46553,"_2719":46625},[],"Optional observability and lab HSM components",{"_3226":116,"_28565":91,"_19778":46627,"_5":13556,"_25987":46553,"_2719":46628},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3226":117,"_28565":91,"_19778":46630,"_5":13556,"_25987":46553,"_2719":46631},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3226":118,"_28565":91,"_19778":46633,"_5":13556,"_25987":46557,"_2719":46634},[],"You need:",{"_3226":119,"_28565":91,"_19778":46636,"_5":13556,"_25987":46557,"_2719":46637},[],"an existing Kubernetes cluster",{"_3226":120,"_28565":91,"_19778":46639,"_5":13556,"_25987":46557,"_2719":46640},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3226":121,"_28565":91,"_19778":46642,"_5":13556,"_25987":46557,"_2719":46643},[],"`yq`",{"_3226":122,"_28565":91,"_19778":46645,"_5":13556,"_25987":46557,"_2719":22396},[],{"_3226":123,"_28565":91,"_19778":46647,"_5":13556,"_25987":46557,"_2719":46648},[],"`jq` only when using `--sample-data` or `--development`",{"_3226":124,"_28565":91,"_19778":46650,"_5":13556,"_25987":46557,"_2719":46651},[],"`ssh-keygen` only when using `--with-hsm`",{"_3226":125,"_28565":91,"_19778":46653,"_5":13556,"_25987":46557,"_2719":46654},[],"free external ports 80 and 443 on a single-node K3s host",{"_3226":126,"_28565":91,"_19778":46656,"_5":13556,"_25987":46557,"_2719":46657},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3226":127,"_28565":91,"_19778":46659,"_5":13556,"_25987":46557,"_2719":46660},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3226":128,"_28565":91,"_19778":46662,"_5":13556,"_25987":46560,"_2719":46663},[],"Run the script from a clone of the Helm repository:",{"_3226":129,"_28565":91,"_19778":46665,"_5":13556,"_25987":46560,"_2719":46666},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3226":130,"_28565":91,"_19778":46668,"_5":13556,"_25987":46564,"_2719":46669},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3226":131,"_28565":91,"_19778":46671,"_5":13556,"_25987":46564,"_2719":46672},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3226":132,"_28565":91,"_19778":46674,"_5":13556,"_25987":46564,"_2719":46675},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3226":133,"_28565":91,"_19778":46677,"_5":13556,"_25987":46564,"_2719":46678},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3226":134,"_28565":91,"_19778":46680,"_5":13556,"_25987":46568,"_2719":46681},[],"Option",{"_3226":135,"_28565":91,"_19778":46683,"_5":13556,"_25987":46568,"_2719":46684},[],"Default",{"_3226":136,"_28565":91,"_19778":46686,"_5":13556,"_25987":46568,"_2719":46687},[],"Purpose",{"_3226":137,"_28565":91,"_19778":46689,"_5":13556,"_25987":46568,"_2719":46690},[],"`-h`, `--help`",{"_3226":138,"_28565":91,"_19778":46692,"_5":13556,"_25987":46568,"_2719":46693},[],"—",{"_3226":139,"_28565":91,"_19778":46695,"_5":13556,"_25987":46568,"_2719":46696},[],"Show help",{"_3226":140,"_28565":91,"_19778":46698,"_5":13556,"_25987":46568,"_2719":46699},[],"`-c`, `--context`",{"_3226":141,"_28565":91,"_19778":46701,"_5":13556,"_25987":46568,"_2719":46702},[],"current context",{"_3226":142,"_28565":91,"_19778":46704,"_5":13556,"_25987":46568,"_2719":46705},[],"Select the kubeconfig context for kubectl and Helm",{"_3226":143,"_28565":91,"_19778":46707,"_5":13556,"_25987":46568,"_2719":46708},[],"`-n`, `--non-interactive`",{"_3226":144,"_28565":91,"_19778":46710,"_5":13556,"_25987":46568,"_2719":6084},[],{"_3226":145,"_28565":91,"_19778":46712,"_5":13556,"_25987":46568,"_2719":46713},[],"Skip prompts and generate dependency credentials",{"_3226":146,"_28565":91,"_19778":46715,"_5":13556,"_25987":46568,"_2719":46716},[],"`-ns`, `--namespace`",{"_3226":147,"_28565":91,"_19778":46718,"_5":13556,"_25987":46568,"_2719":46719},[],"`lamassu-dev`",{"_3226":148,"_28565":91,"_19778":46721,"_5":13556,"_25987":46568,"_2719":46722},[],"Namespace for the installation",{"_3226":149,"_28565":91,"_19778":46724,"_5":13556,"_25987":46568,"_2719":46725},[],"`-d`, `--domain`",{"_3226":150,"_28565":91,"_19778":46727,"_5":13556,"_25987":46568,"_2719":46728},[],"`dev.lamassu.io`",{"_3226":151,"_28565":91,"_19778":46730,"_5":13556,"_25987":46568,"_2719":46731},[],"Domain used by the UI, OIDC and certificate",{"_3226":152,"_28565":91,"_19778":46733,"_5":13556,"_25987":46568,"_2719":46734},[],"`-v`, `--version`",{"_3226":153,"_28565":91,"_19778":46736,"_5":13556,"_25987":46568,"_2719":14214},[],{"_3226":154,"_28565":91,"_19778":46738,"_5":13556,"_25987":46568,"_2719":46739},[],"Lamassu chart version",{"_3226":155,"_28565":91,"_19778":46741,"_5":13556,"_25987":46568,"_2719":46742},[],"`--https-port`",{"_3226":156,"_28565":91,"_19778":46744,"_5":13556,"_25987":46568,"_2719":46745},[],"`443`",{"_3226":157,"_28565":91,"_19778":46747,"_5":13556,"_25987":46568,"_2719":46748},[],"Gateway HTTPS listener port",{"_3226":158,"_28565":91,"_19778":46750,"_5":13556,"_25987":46568,"_2719":46751},[],"`--http-port`",{"_3226":159,"_28565":91,"_19778":46753,"_5":13556,"_25987":46568,"_2719":46754},[],"`80`",{"_3226":160,"_28565":91,"_19778":46756,"_5":13556,"_25987":46568,"_2719":46757},[],"Gateway HTTP listener port",{"_3226":161,"_28565":91,"_19778":46759,"_5":13556,"_25987":46568,"_2719":46760},[],"`--tls-crt`",{"_3226":162,"_28565":91,"_19778":46762,"_5":13556,"_25987":46568,"_2719":46693},[],{"_3226":163,"_28565":91,"_19778":46764,"_5":13556,"_25987":46568,"_2719":46765},[],"PEM certificate for downstream TLS",{"_3226":164,"_28565":91,"_19778":46767,"_5":13556,"_25987":46568,"_2719":46768},[],"`--tls-key`",{"_3226":165,"_28565":91,"_19778":46770,"_5":13556,"_25987":46568,"_2719":46693},[],{"_3226":166,"_28565":91,"_19778":46772,"_5":13556,"_25987":46568,"_2719":46773},[],"PEM private key for downstream TLS",{"_3226":167,"_28565":91,"_19778":46775,"_5":13556,"_25987":46568,"_2719":46776},[],"`-l`, `--local-chart-path`",{"_3226":168,"_28565":91,"_19778":46778,"_5":13556,"_25987":46568,"_2719":46779},[],"repository chart",{"_3226":169,"_28565":91,"_19778":46781,"_5":13556,"_25987":46568,"_2719":46782},[],"Use an unpacked local Lamassu chart",{"_3226":170,"_28565":91,"_19778":46784,"_5":13556,"_25987":46568,"_2719":46785},[],"`-ip`, `--gateway-ip`",{"_3226":171,"_28565":91,"_19778":46787,"_5":13556,"_25987":46568,"_2719":8199},[],{"_3226":172,"_28565":91,"_19778":46789,"_5":13556,"_25987":46568,"_2719":46790},[],"Override the address written to `gateway.addresses`",{"_3226":173,"_28565":91,"_19778":46792,"_5":13556,"_25987":46568,"_2719":46793},[],"`--otel`",{"_3226":174,"_28565":91,"_19778":46795,"_5":13556,"_25987":46568,"_2719":6084},[],{"_3226":175,"_28565":91,"_19778":46797,"_5":13556,"_25987":46568,"_2719":46798},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3226":176,"_28565":91,"_19778":46800,"_5":13556,"_25987":46568,"_2719":46801},[],"`--development`",{"_3226":177,"_28565":91,"_19778":46803,"_5":13556,"_25987":46568,"_2719":6084},[],{"_3226":178,"_28565":91,"_19778":46805,"_5":13556,"_25987":46568,"_2719":46806},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3226":179,"_28565":91,"_19778":46808,"_5":13556,"_25987":46568,"_2719":46809},[],"`--sample-data`",{"_3226":180,"_28565":91,"_19778":46811,"_5":13556,"_25987":46568,"_2719":6084},[],{"_3226":181,"_28565":91,"_19778":46813,"_5":13556,"_25987":46568,"_2719":46814},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3226":182,"_28565":91,"_19778":46816,"_5":13556,"_25987":46568,"_2719":46817},[],"`--with-hsm`",{"_3226":183,"_28565":91,"_19778":46819,"_5":13556,"_25987":46568,"_2719":6084},[],{"_3226":184,"_28565":91,"_19778":46821,"_5":13556,"_25987":46568,"_2719":46822},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3226":185,"_28565":91,"_19778":46824,"_5":13556,"_25987":46568,"_2719":46825},[],"`--softhsm-chart-path`",{"_3226":186,"_28565":91,"_19778":46827,"_5":13556,"_25987":46568,"_2719":46828},[],"`./charts/softhsm`",{"_3226":187,"_28565":91,"_19778":46830,"_5":13556,"_25987":46568,"_2719":46831},[],"Use a different local SoftHSM chart",{"_3226":188,"_28565":91,"_19778":46833,"_5":13556,"_25987":46568,"_2719":46834},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3226":189,"_28565":91,"_19778":46836,"_5":13556,"_25987":46572,"_2719":46837},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3226":190,"_28565":91,"_19778":46839,"_5":13556,"_25987":46572,"_2719":46840},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3226":191,"_28565":91,"_19778":46842,"_5":13556,"_25987":46572,"_2719":46843},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3226":192,"_28565":91,"_19778":46845,"_5":13556,"_25987":46572,"_2719":46846},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3226":193,"_28565":91,"_19778":46848,"_5":13556,"_25987":46572,"_2719":46849},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3226":194,"_28565":91,"_19778":46851,"_5":13556,"_25987":46572,"_2719":46852},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3226":195,"_28565":91,"_19778":46854,"_5":13556,"_25987":46576,"_2719":46855},[],"Fastlane:",{"_3226":196,"_28565":91,"_19778":46857,"_5":13556,"_25987":46576,"_2719":46858},[],"validates local tools and the selected cluster",{"_3226":197,"_28565":91,"_19778":46860,"_5":13556,"_25987":46576,"_2719":46861},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3226":198,"_28565":91,"_19778":46863,"_5":13556,"_25987":46576,"_2719":46864},[],"creates the namespace",{"_3226":199,"_28565":91,"_19778":46866,"_5":13556,"_25987":46576,"_2719":46867},[],"installs PostgreSQL and creates the required databases",{"_3226":200,"_28565":91,"_19778":46869,"_5":13556,"_25987":46576,"_2719":46870},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3226":201,"_28565":91,"_19778":46872,"_5":13556,"_25987":46576,"_2719":46873},[],"installs RabbitMQ",{"_3226":202,"_28565":91,"_19778":46875,"_5":13556,"_25987":46576,"_2719":46876},[],"optionally installs observability and lab HSM components",{"_3226":203,"_28565":91,"_19778":46878,"_5":13556,"_25987":46576,"_2719":46879},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3226":204,"_28565":91,"_19778":46881,"_5":13556,"_25987":46576,"_2719":46882},[],"optionally loads sample data",{"_3226":205,"_28565":91,"_19778":46884,"_5":13556,"_25987":46576,"_2719":46885},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3226":206,"_28565":91,"_19778":46887,"_5":13556,"_25987":46580,"_2719":46888},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3226":207,"_28565":91,"_19778":46890,"_5":13556,"_25987":46580,"_2719":46891},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3226":208,"_28565":91,"_19778":46893,"_5":13556,"_25987":46584,"_2719":46894},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3226":209,"_28565":91,"_19778":46896,"_5":13556,"_25987":46584,"_2719":46897},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3226":210,"_28565":91,"_19778":46899,"_5":13556,"_25987":46584,"_2719":46900},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3226":211,"_28565":91,"_19778":46902,"_5":13556,"_25987":46588,"_2719":46903},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3226":212,"_28565":212,"_5":13914,"_2719":46905,"_28908":46906,"_19778":46907,"_25987":212},"Install with Helm",[46297,46298,46404],[],{"_3226":213,"_28565":212,"_19778":46909,"_5":13556,"_25987":212,"_2719":46910},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3226":214,"_28565":212,"_5":28905,"_19778":46912,"_25987":46913,"_2719":46914},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3226":215,"_28565":212,"_5":28905,"_19778":46916,"_25987":46917,"_2719":46307},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#before-you-begin",{"_3226":216,"_28565":212,"_5":28905,"_19778":46919,"_25987":46920,"_2719":46921},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3226":217,"_28565":212,"_5":28905,"_19778":46923,"_25987":46924,"_2719":46925},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3226":218,"_28565":212,"_5":28905,"_19778":46927,"_25987":46928,"_2719":46929},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3226":219,"_28565":212,"_5":28905,"_19778":46931,"_25987":46932,"_2719":46933},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3226":220,"_28565":212,"_5":28905,"_19778":46935,"_25987":46936,"_2719":46937},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3226":221,"_28565":212,"_5":28905,"_19778":46939,"_25987":46940,"_2719":46941},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3226":222,"_28565":212,"_5":28905,"_19778":46943,"_25987":46944,"_2719":46945},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3226":223,"_28565":212,"_5":28905,"_19778":46947,"_25987":46948,"_2719":46949},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3226":224,"_28565":212,"_19778":46951,"_5":13556,"_25987":46913,"_2719":46952},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3226":225,"_28565":212,"_19778":46954,"_5":13556,"_25987":46917,"_2719":46955},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3226":226,"_28565":212,"_19778":46957,"_5":13556,"_25987":46917,"_2719":46958},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3226":227,"_28565":212,"_19778":46960,"_5":13556,"_25987":46917,"_2719":46961},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3226":228,"_28565":212,"_19778":46963,"_5":13556,"_25987":46917,"_2719":46964},[],"a reachable RabbitMQ broker and credentials",{"_3226":229,"_28565":212,"_19778":46966,"_5":13556,"_25987":46917,"_2719":46967},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3226":230,"_28565":212,"_19778":46969,"_5":13556,"_25987":46917,"_2719":46970},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3226":231,"_28565":212,"_19778":46972,"_5":13556,"_25987":46917,"_2719":46973},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3226":232,"_28565":212,"_19778":46975,"_5":13556,"_25987":46917,"_2719":46976},[],"a StorageClass and an external traffic design",{"_3226":233,"_28565":212,"_19778":46978,"_5":13556,"_25987":46917,"_2719":46979},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3226":234,"_28565":212,"_19778":46981,"_5":13556,"_25987":46917,"_2719":46982},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3226":235,"_28565":212,"_19778":46984,"_5":13556,"_25987":46917,"_2719":46985},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3226":236,"_28565":212,"_19778":46987,"_5":13556,"_25987":46920,"_2719":46988},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3226":237,"_28565":212,"_19778":46990,"_5":13556,"_25987":46920,"_2719":46991},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3226":238,"_28565":212,"_19778":46993,"_5":13556,"_25987":46920,"_2719":46994},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3226":239,"_28565":212,"_19778":46996,"_5":13556,"_25987":46924,"_2719":46997},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3226":240,"_28565":212,"_19778":46999,"_5":13556,"_25987":46924,"_2719":47000},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3226":241,"_28565":212,"_19778":47002,"_5":13556,"_25987":46924,"_2719":47003},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3226":242,"_28565":212,"_19778":47005,"_5":13556,"_25987":46924,"_2719":47006},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3226":243,"_28565":212,"_19778":47008,"_5":13556,"_25987":46928,"_2719":47009},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3226":244,"_28565":212,"_19778":47011,"_5":13556,"_25987":46932,"_2719":47012},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3226":245,"_28565":212,"_19778":47014,"_5":13556,"_25987":46932,"_2719":47015},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3226":246,"_28565":212,"_19778":47017,"_5":13556,"_25987":46932,"_2719":47018},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3226":247,"_28565":212,"_19778":47020,"_5":13556,"_25987":46932,"_2719":47021},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3226":248,"_28565":212,"_19778":47023,"_5":13556,"_25987":46932,"_2719":47024},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3226":249,"_28565":212,"_19778":47026,"_5":13556,"_25987":46932,"_2719":47027},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3226":250,"_28565":212,"_19778":47029,"_5":13556,"_25987":46932,"_2719":47030},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP.",{"_3226":251,"_28565":212,"_19778":47032,"_5":13556,"_25987":46936,"_2719":47033},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3226":252,"_28565":212,"_19778":47035,"_5":13556,"_25987":46936,"_2719":47036},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3226":253,"_28565":212,"_19778":47038,"_5":13556,"_25987":46936,"_2719":47039},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3226":254,"_28565":212,"_19778":47041,"_5":13556,"_25987":46936,"_2719":47042},[],"See Access control for the principal and policy model.",{"_3226":255,"_28565":212,"_19778":47044,"_5":13556,"_25987":46940,"_2719":47045},[],"To install a local checkout instead:",{"_3226":256,"_28565":212,"_19778":47047,"_5":13556,"_25987":46944,"_2719":47048},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3226":257,"_28565":212,"_19778":47050,"_5":13556,"_25987":46944,"_2719":47051},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3226":258,"_28565":212,"_19778":47053,"_5":13556,"_25987":46948,"_2719":47054},[],"Before going live, review:",{"_3226":259,"_28565":212,"_19778":47056,"_5":13556,"_25987":46948,"_2719":47057},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3226":260,"_28565":212,"_19778":47059,"_5":13556,"_25987":46948,"_2719":47060},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3226":261,"_28565":212,"_19778":47062,"_5":13556,"_25987":46948,"_2719":47063},[],"shared VA storage before increasing VA replicas",{"_3226":262,"_28565":212,"_19778":47065,"_5":13556,"_25987":46948,"_2719":47066},[],"managed OIDC roles and removal of evaluation credentials",{"_3226":263,"_28565":212,"_19778":47068,"_5":13556,"_25987":46948,"_2719":47069},[],"a trusted TLS issuer or externally managed certificate",{"_3226":264,"_28565":212,"_19778":47071,"_5":13556,"_25987":46948,"_2719":47072},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3226":265,"_28565":212,"_19778":47074,"_5":13556,"_25987":46948,"_2719":47075},[],"SMTP, observability and alert delivery",{"_3226":266,"_28565":212,"_19778":47077,"_5":13556,"_25987":46948,"_2719":47078},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3226":267,"_28565":212,"_19778":47080,"_5":13556,"_25987":46948,"_2719":47081},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3226":268,"_28565":268,"_5":13914,"_2719":47083,"_28908":47084,"_19778":47085,"_25987":268},"Expose the Gateway",[46297,46298,46404],[],{"_3226":269,"_28565":268,"_19778":47087,"_5":13556,"_25987":268,"_2719":47088},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3226":270,"_28565":268,"_5":28905,"_19778":47090,"_25987":47091,"_2719":47092},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3226":271,"_28565":268,"_5":28905,"_19778":47094,"_25987":47095,"_2719":47096},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3226":272,"_28565":268,"_5":28905,"_19778":47098,"_25987":47099,"_2719":47100},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3226":273,"_28565":268,"_5":28905,"_19778":47102,"_25987":47103,"_2719":47104},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#k3s","K3s",{"_3226":274,"_28565":268,"_5":28905,"_19778":47106,"_25987":47107,"_2719":47108},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3226":275,"_28565":268,"_5":28905,"_19778":47110,"_25987":47111,"_2719":47112},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3226":276,"_28565":268,"_5":28905,"_19778":47114,"_25987":47115,"_2719":47116},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3226":277,"_28565":268,"_5":28905,"_19778":47118,"_25987":47119,"_2719":47120},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3226":278,"_28565":268,"_5":28905,"_19778":47122,"_25987":47123,"_2719":47124},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3226":279,"_28565":268,"_5":28905,"_19778":47126,"_25987":47127,"_2719":47128},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3226":280,"_28565":268,"_19778":47130,"_5":13556,"_25987":47091,"_2719":47131},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3226":281,"_28565":268,"_19778":47133,"_5":13556,"_25987":47091,"_2719":47134},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3226":282,"_28565":268,"_19778":47136,"_5":13556,"_25987":47095,"_2719":47137},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3226":283,"_28565":268,"_19778":47139,"_5":13556,"_25987":47095,"_2719":47140},[],"Set it only when:",{"_3226":284,"_28565":268,"_19778":47142,"_5":13556,"_25987":47095,"_2719":47143},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3226":285,"_28565":268,"_19778":47145,"_5":13556,"_25987":47095,"_2719":47146},[],"that address is allocated to this Gateway",{"_3226":286,"_28565":268,"_19778":47148,"_5":13556,"_25987":47095,"_2719":47149},[],"the surrounding network already routes traffic for it to the cluster",{"_3226":287,"_28565":268,"_19778":47151,"_5":13556,"_25987":47095,"_2719":47152},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3226":288,"_28565":268,"_19778":47154,"_5":13556,"_25987":47095,"_2719":47155},[],"Keep these two settings separate:",{"_3226":289,"_28565":268,"_19778":47157,"_5":13556,"_25987":47095,"_2719":47158},[],"`gateway.addresses` requests an address for the Gateway.",{"_3226":290,"_28565":268,"_19778":47160,"_5":13556,"_25987":47095,"_2719":47161},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3226":291,"_28565":268,"_19778":47163,"_5":13556,"_25987":47095,"_2719":47164},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3226":292,"_28565":268,"_19778":47166,"_5":13556,"_25987":47099,"_2719":47167},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3226":293,"_28565":268,"_19778":47169,"_5":13556,"_25987":47099,"_2719":47170},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3226":294,"_28565":268,"_19778":47172,"_5":13556,"_25987":47103,"_2719":47173},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3226":295,"_28565":268,"_19778":47175,"_5":13556,"_25987":47103,"_2719":47176},[],"For the recommended design:",{"_3226":296,"_28565":268,"_19778":47178,"_5":13556,"_25987":47103,"_2719":47179},[],"Use only one externally exposed Lamassu Gateway.",{"_3226":297,"_28565":268,"_19778":47181,"_5":13556,"_25987":47103,"_2719":47182},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3226":298,"_28565":268,"_19778":47184,"_5":13556,"_25987":47103,"_2719":47185},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3226":299,"_28565":268,"_19778":47187,"_5":13556,"_25987":47103,"_2719":47188},[],"Point DNS at the VM's reachable address.",{"_3226":300,"_28565":268,"_19778":47190,"_5":13556,"_25987":47103,"_2719":47191},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3226":301,"_28565":268,"_19778":47193,"_5":13556,"_25987":47107,"_2719":47194},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3226":302,"_28565":268,"_19778":47196,"_5":13556,"_25987":47111,"_2719":47197},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3226":303,"_28565":268,"_19778":47199,"_5":13556,"_25987":47111,"_2719":47200},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3226":304,"_28565":268,"_19778":47202,"_5":13556,"_25987":47115,"_2719":47203},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3226":305,"_28565":268,"_19778":47205,"_5":13556,"_25987":47115,"_2719":47206},[],"Requirement",{"_3226":306,"_28565":268,"_19778":47208,"_5":13556,"_25987":47115,"_2719":47209},[],"Recommended design",{"_3226":307,"_28565":268,"_19778":47211,"_5":13556,"_25987":47115,"_2719":47212},[],"Consequence",{"_3226":308,"_28565":268,"_19778":47214,"_5":13556,"_25987":47115,"_2719":47215},[],"Several Lamassu URLs or services",{"_3226":309,"_28565":268,"_19778":47217,"_5":13556,"_25987":47115,"_2719":47218},[],"One Gateway with multiple routes",{"_3226":310,"_28565":268,"_19778":47220,"_5":13556,"_25987":47115,"_2719":47221},[],"One IP and one proxy fleet; this is the chart default",{"_3226":311,"_28565":268,"_19778":47223,"_5":13556,"_25987":47115,"_2719":47224},[],"Independent Gateways and separate external IPs",{"_3226":312,"_28565":268,"_19778":47226,"_5":13556,"_25987":47115,"_2719":47227},[],"One VIP per Gateway",{"_3226":313,"_28565":268,"_19778":47229,"_5":13556,"_25987":47115,"_2719":47230},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3226":314,"_28565":268,"_19778":47232,"_5":13556,"_25987":47115,"_2719":47233},[],"Independent Gateways on one node and one IP",{"_3226":315,"_28565":268,"_19778":47235,"_5":13556,"_25987":47115,"_2719":47236},[],"Use different external ports",{"_3226":316,"_28565":268,"_19778":47238,"_5":13556,"_25987":47115,"_2719":47239},[],"Clients must include non-standard ports",{"_3226":317,"_28565":268,"_19778":47241,"_5":13556,"_25987":47115,"_2719":47242},[],"Separate TLS/mTLS termination behind one IP",{"_3226":318,"_28565":268,"_19778":47244,"_5":13556,"_25987":47115,"_2719":47245},[],"Front-door SNI routing to internal Gateways",{"_3226":319,"_28565":268,"_19778":47247,"_5":13556,"_25987":47115,"_2719":47248},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3226":320,"_28565":268,"_19778":47250,"_5":13556,"_25987":47115,"_2719":47251},[],"Separate Gateway resources but shared proxy infrastructure",{"_3226":321,"_28565":268,"_19778":47253,"_5":13556,"_25987":47115,"_2719":47254},[],"Envoy merged-Gateway mode",{"_3226":322,"_28565":268,"_19778":47256,"_5":13556,"_25987":47115,"_2719":47257},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3226":323,"_28565":268,"_19778":47259,"_5":13556,"_25987":47115,"_2719":47260},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3226":324,"_28565":268,"_19778":47262,"_5":13556,"_25987":47115,"_2719":47263},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3226":325,"_28565":268,"_19778":47265,"_5":13556,"_25987":47115,"_2719":47266},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3226":326,"_28565":268,"_19778":47268,"_5":13556,"_25987":47115,"_2719":47269},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3226":327,"_28565":268,"_19778":47271,"_5":13556,"_25987":47119,"_2719":47272},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3226":328,"_28565":268,"_19778":47274,"_5":13556,"_25987":47119,"_2719":47275},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3226":329,"_28565":268,"_19778":47277,"_5":13556,"_25987":47119,"_2719":47278},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3226":330,"_28565":268,"_19778":47280,"_5":13556,"_25987":47119,"_2719":47281},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3226":331,"_28565":268,"_19778":47283,"_5":13556,"_25987":47119,"_2719":47284},[],"If none of those are possible, use different external ports or change the external network design.",{"_3226":332,"_28565":268,"_19778":47286,"_5":13556,"_25987":47123,"_2719":47287},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3226":333,"_28565":268,"_19778":47289,"_5":13556,"_25987":47123,"_2719":47290},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3226":334,"_28565":268,"_19778":47292,"_5":13556,"_25987":47127,"_2719":47293},[],"Check, in order:",{"_3226":335,"_28565":268,"_19778":47295,"_5":13556,"_25987":47127,"_2719":47296},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3226":336,"_28565":268,"_19778":47298,"_5":13556,"_25987":47127,"_2719":47299},[],"Its status contains the expected address.",{"_3226":337,"_28565":268,"_19778":47301,"_5":13556,"_25987":47127,"_2719":47302},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3226":338,"_28565":268,"_19778":47304,"_5":13556,"_25987":47127,"_2719":47305},[],"Port 443 reaches that address from the client network.",{"_3226":339,"_28565":268,"_19778":47307,"_5":13556,"_25987":47127,"_2719":47308},[],"DNS resolves to the externally reachable endpoint.",{"_3226":340,"_28565":268,"_19778":47310,"_5":13556,"_25987":47127,"_2719":47311},[],"The certificate contains the DNS name or IP used by the client.",{"_3226":341,"_28565":268,"_19778":47313,"_5":13556,"_25987":47127,"_2719":47314},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3226":342,"_28565":342,"_5":13914,"_2719":46404,"_28908":47316,"_19778":47317,"_25987":342},[46297,46298,46404],[],{"_3226":343,"_28565":342,"_19778":47319,"_5":13556,"_25987":342,"_2719":47320},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3226":344,"_28565":342,"_5":28905,"_19778":47322,"_25987":47323,"_2719":47324},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3226":345,"_28565":342,"_5":28905,"_19778":47326,"_25987":47327,"_2719":47328},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3226":346,"_28565":342,"_5":28905,"_19778":47330,"_25987":47331,"_2719":47332},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3226":347,"_28565":342,"_5":28905,"_19778":47334,"_25987":47335,"_2719":47336},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3226":348,"_28565":342,"_5":28905,"_19778":47338,"_25987":47339,"_2719":47340},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3226":349,"_28565":342,"_5":28905,"_19778":47342,"_25987":47343,"_2719":47344},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3226":350,"_28565":342,"_19778":47346,"_5":13556,"_25987":47323,"_2719":47347},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3226":351,"_28565":342,"_19778":47349,"_5":13556,"_25987":47327,"_2719":47350},[],"Workflow",{"_3226":352,"_28565":342,"_19778":47352,"_5":13556,"_25987":47327,"_2719":47353},[],"Use it for",{"_3226":353,"_28565":342,"_19778":47355,"_5":13556,"_25987":47327,"_2719":47356},[],"What it installs",{"_3226":354,"_28565":342,"_19778":47358,"_5":13556,"_25987":47327,"_2719":47359},[],"Helm",{"_3226":355,"_28565":342,"_19778":47361,"_5":13556,"_25987":47327,"_2719":47362},[],"Production and controlled environments",{"_3226":356,"_28565":342,"_19778":47364,"_5":13556,"_25987":47327,"_2719":47365},[],"Lamassu services and Gateway API resources",{"_3226":357,"_28565":342,"_19778":47367,"_5":13556,"_25987":47327,"_2719":46541},[],{"_3226":358,"_28565":342,"_19778":47369,"_5":13556,"_25987":47327,"_2719":47370},[],"Evaluation, demos, CI and small lab clusters",{"_3226":359,"_28565":342,"_19778":47372,"_5":13556,"_25987":47327,"_2719":47373},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3226":360,"_28565":342,"_19778":47375,"_5":13556,"_25987":47331,"_2719":47376},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3226":361,"_28565":342,"_19778":47378,"_5":13556,"_25987":47331,"_2719":47379},[],"Area",{"_3226":362,"_28565":342,"_19778":47381,"_5":13556,"_25987":47331,"_2719":47382},[],"The Lamassu chart provides",{"_3226":363,"_28565":342,"_19778":47384,"_5":13556,"_25987":47331,"_2719":47385},[],"You provide",{"_3226":364,"_28565":342,"_19778":47387,"_5":13556,"_25987":47331,"_2719":47388},[],"Lamassu applications",{"_3226":365,"_28565":342,"_19778":47390,"_5":13556,"_25987":47331,"_2719":47391},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3226":366,"_28565":342,"_19778":47393,"_5":13556,"_25987":47331,"_2719":47394},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3226":367,"_28565":342,"_19778":47396,"_5":13556,"_25987":47331,"_2719":47397},[],"PostgreSQL data",{"_3226":368,"_28565":342,"_19778":47399,"_5":13556,"_25987":47331,"_2719":47400},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3226":369,"_28565":342,"_19778":47402,"_5":13556,"_25987":47331,"_2719":47403},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3226":370,"_28565":342,"_19778":47405,"_5":13556,"_25987":47331,"_2719":47406},[],"Messaging",{"_3226":371,"_28565":342,"_19778":47408,"_5":13556,"_25987":47331,"_2719":47409},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3226":372,"_28565":342,"_19778":47411,"_5":13556,"_25987":47331,"_2719":47412},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3226":373,"_28565":342,"_19778":47414,"_5":13556,"_25987":47331,"_2719":47415},[],"Identity",{"_3226":374,"_28565":342,"_19778":47417,"_5":13556,"_25987":47331,"_2719":47418},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3226":375,"_28565":342,"_19778":47420,"_5":13556,"_25987":47331,"_2719":47421},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3226":376,"_28565":342,"_19778":47423,"_5":13556,"_25987":47331,"_2719":47424},[],"External routing",{"_3226":377,"_28565":342,"_19778":47426,"_5":13556,"_25987":47331,"_2719":47427},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3226":378,"_28565":342,"_19778":47429,"_5":13556,"_25987":47331,"_2719":47430},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3226":379,"_28565":342,"_19778":47432,"_5":13556,"_25987":47331,"_2719":47433},[],"TLS",{"_3226":380,"_28565":342,"_19778":47435,"_5":13556,"_25987":47331,"_2719":47436},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3226":381,"_28565":342,"_19778":47438,"_5":13556,"_25987":47331,"_2719":47439},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3226":382,"_28565":342,"_19778":47441,"_5":13556,"_25987":47331,"_2719":47442},[],"Persistent application data",{"_3226":383,"_28565":342,"_19778":47444,"_5":13556,"_25987":47331,"_2719":47445},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3226":384,"_28565":342,"_19778":47447,"_5":13556,"_25987":47331,"_2719":47448},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3226":385,"_28565":342,"_19778":47450,"_5":13556,"_25987":47331,"_2719":47451},[],"Optional integrations",{"_3226":386,"_28565":342,"_19778":47453,"_5":13556,"_25987":47331,"_2719":47454},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3226":387,"_28565":342,"_19778":47456,"_5":13556,"_25987":47331,"_2719":47457},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3226":388,"_28565":342,"_19778":47459,"_5":13556,"_25987":47331,"_2719":47460},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3226":389,"_28565":342,"_19778":47462,"_5":13556,"_25987":47331,"_2719":47463},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3226":390,"_28565":342,"_19778":47465,"_5":13556,"_25987":47335,"_2719":47466},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3226":391,"_28565":342,"_19778":47468,"_5":13556,"_25987":47335,"_2719":47469},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3226":392,"_28565":342,"_19778":47471,"_5":13556,"_25987":47339,"_2719":47472},[],"Kubernetes 1.24 or newer",{"_3226":393,"_28565":342,"_19778":47474,"_5":13556,"_25987":47339,"_2719":47475},[],"Helm 3.2 or newer",{"_3226":394,"_28565":342,"_19778":47477,"_5":13556,"_25987":47339,"_2719":47478},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3226":395,"_28565":342,"_19778":47480,"_5":13556,"_25987":47339,"_2719":47481},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3226":396,"_28565":342,"_19778":47483,"_5":13556,"_25987":47339,"_2719":47484},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3226":397,"_28565":342,"_19778":47486,"_5":13556,"_25987":47339,"_2719":47487},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3226":398,"_28565":342,"_19778":47489,"_5":13556,"_25987":47339,"_2719":47490},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3226":399,"_28565":342,"_19778":47492,"_5":13556,"_25987":47343,"_2719":47493},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3226":400,"_28565":342,"_19778":47495,"_5":13556,"_25987":47343,"_2719":47496},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3226":401,"_28565":342,"_19778":47498,"_5":13556,"_25987":47343,"_2719":47499},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3226":402,"_28565":342,"_19778":47501,"_5":13556,"_25987":47343,"_2719":47502},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3226":403,"_28565":403,"_5":13914,"_2719":47504,"_28908":47505,"_19778":47507,"_25987":403},"Deployment troubleshooting",[46297,46298,47506],"Operations",[],{"_3226":404,"_28565":403,"_19778":47509,"_5":13556,"_25987":403,"_2719":47510},[],"Diagnose access, service health and infrastructure dependencies.",{"_3226":405,"_28565":403,"_5":28905,"_19778":47512,"_25987":47513,"_2719":47514},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3226":406,"_28565":403,"_5":28905,"_19778":47516,"_25987":47517,"_2719":47518},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3226":407,"_28565":403,"_5":28905,"_19778":47520,"_25987":47521,"_2719":47522},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3226":408,"_28565":403,"_5":28905,"_19778":47524,"_25987":47525,"_2719":47526},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3226":409,"_28565":403,"_5":28905,"_19778":47528,"_25987":47529,"_2719":47530},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3226":410,"_28565":403,"_5":28905,"_19778":47532,"_25987":47533,"_2719":47534},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3226":411,"_28565":403,"_5":28905,"_19778":47536,"_25987":47537,"_2719":47538},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3226":412,"_28565":403,"_5":28905,"_19778":47540,"_25987":47541,"_2719":47542},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3226":413,"_28565":403,"_5":28905,"_19778":47544,"_25987":47545,"_2719":47546},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3226":414,"_28565":403,"_5":28905,"_19778":47548,"_25987":47549,"_2719":47550},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3226":415,"_28565":403,"_5":28905,"_19778":47552,"_25987":47553,"_2719":47554},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3226":416,"_28565":403,"_5":28905,"_19778":47556,"_25987":47557,"_2719":47558},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3226":417,"_28565":403,"_5":28905,"_19778":47560,"_25987":47561,"_2719":47562},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#observability","Observability",{"_3226":418,"_28565":403,"_19778":47564,"_5":13556,"_25987":403,"_2719":47565},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3226":419,"_28565":403,"_19778":47567,"_5":13556,"_25987":47517,"_2719":47568},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3226":420,"_28565":403,"_19778":47570,"_5":13556,"_25987":47521,"_2719":47571},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3226":421,"_28565":403,"_19778":47573,"_5":13556,"_25987":47525,"_2719":47574},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3226":422,"_28565":403,"_19778":47576,"_5":13556,"_25987":47529,"_2719":47577},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3226":423,"_28565":403,"_19778":47579,"_5":13556,"_25987":47533,"_2719":47580},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3226":424,"_28565":403,"_19778":47582,"_5":13556,"_25987":47537,"_2719":47583},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3226":425,"_28565":403,"_19778":47585,"_5":13556,"_25987":47537,"_2719":47586},[],"Also run the chart's connectivity test:",{"_3226":426,"_28565":403,"_19778":47588,"_5":13556,"_25987":47537,"_2719":47589},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3226":427,"_28565":403,"_19778":47591,"_5":13556,"_25987":47537,"_2719":47592},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3226":428,"_28565":403,"_19778":47594,"_5":13556,"_25987":47541,"_2719":47595},[],"If you receive a 401:",{"_3226":429,"_28565":403,"_19778":47597,"_5":13556,"_25987":47541,"_2719":47598},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3226":430,"_28565":403,"_19778":47600,"_5":13556,"_25987":47541,"_2719":47601},[],"verify issuer, audience and expiration of the token;",{"_3226":431,"_28565":403,"_19778":47603,"_5":13556,"_25987":47541,"_2719":47604},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3226":432,"_28565":403,"_19778":47606,"_5":13556,"_25987":47541,"_2719":47607},[],"check that the provider's public and internal routes point to the same realm.",{"_3226":433,"_28565":403,"_19778":47609,"_5":13556,"_25987":47541,"_2719":47610},[],"If login succeeds but the APIs return 403:",{"_3226":434,"_28565":403,"_19778":47612,"_5":13556,"_25987":47541,"_2719":47613},[],"inspect the token's real claims;",{"_3226":435,"_28565":403,"_19778":47615,"_5":13556,"_25987":47541,"_2719":47616},[],"confirm they match an active principal;",{"_3226":436,"_28565":403,"_19778":47618,"_5":13556,"_25987":47541,"_2719":47619},[],"review the policies granted to that principal;",{"_3226":437,"_28565":403,"_19778":47621,"_5":13556,"_25987":47541,"_2719":47622},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3226":438,"_28565":403,"_19778":47624,"_5":13556,"_25987":47541,"_2719":47625},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3226":439,"_28565":403,"_19778":47627,"_5":13556,"_25987":47545,"_2719":47628},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3226":440,"_28565":403,"_19778":47630,"_5":13556,"_25987":47545,"_2719":47631},[],"Locate the authz pod and Service.",{"_3226":441,"_28565":403,"_19778":47633,"_5":13556,"_25987":47545,"_2719":47634},[],"Check /health, logs and its database connection.",{"_3226":442,"_28565":403,"_19778":47636,"_5":13556,"_25987":47545,"_2719":47637},[],"Verify the DNS and port configured in externalAuthorization.",{"_3226":443,"_28565":403,"_19778":47639,"_5":13556,"_25987":47545,"_2719":47640},[],"Check the check route is /v1/ext\\_authz/check.",{"_3226":444,"_28565":403,"_19778":47642,"_5":13556,"_25987":47545,"_2719":47643},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3226":445,"_28565":403,"_19778":47645,"_5":13556,"_25987":47549,"_2719":47646},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3226":446,"_28565":403,"_19778":47648,"_5":13556,"_25987":47553,"_2719":47649},[],"Review kubectl describe pod first. Common causes are:",{"_3226":447,"_28565":403,"_19778":47651,"_5":13556,"_25987":47553,"_2719":47652},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3226":448,"_28565":403,"_19778":47654,"_5":13556,"_25987":47553,"_2719":47655},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3226":449,"_28565":403,"_19778":47657,"_5":13556,"_25987":47553,"_2719":47658},[],"unbound persistent volume;",{"_3226":450,"_28565":403,"_19778":47660,"_5":13556,"_25987":47553,"_2719":47661},[],"inaccessible image or incorrect pull policy;",{"_3226":451,"_28565":403,"_19778":47663,"_5":13556,"_25987":47553,"_2719":47664},[],"invalid cryptographic engine configuration;",{"_3226":452,"_28565":403,"_19778":47666,"_5":13556,"_25987":47553,"_2719":47667},[],"CPU or memory limits set too low;",{"_3226":453,"_28565":403,"_19778":47669,"_5":13556,"_25987":47553,"_2719":47670},[],"an incomplete prior migration.",{"_3226":454,"_28565":403,"_19778":47672,"_5":13556,"_25987":47553,"_2719":47673},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3226":455,"_28565":403,"_19778":47675,"_5":13556,"_25987":47553,"_2719":47676},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3226":456,"_28565":403,"_19778":47678,"_5":13556,"_25987":47553,"_2719":47679},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3226":457,"_28565":403,"_19778":47681,"_5":13556,"_25987":47557,"_2719":47682},[],"Domain and audit events depend on the bus publisher:",{"_3226":458,"_28565":403,"_19778":47684,"_5":13556,"_25987":47557,"_2719":47685},[],"verify it is enabled in the emitting service;",{"_3226":459,"_28565":403,"_19778":47687,"_5":13556,"_25987":47557,"_2719":47688},[],"check AMQP connectivity and credentials;",{"_3226":460,"_28565":403,"_19778":47690,"_5":13556,"_25987":47557,"_2719":47691},[],"review exchange, routing key, queues and consumers;",{"_3226":461,"_28565":403,"_19778":47693,"_5":13556,"_25987":47557,"_2719":47694},[],"inspect dead-letter queues;",{"_3226":462,"_28565":403,"_19778":47696,"_5":13556,"_25987":47557,"_2719":47697},[],"alert on orphan durable queues and backlog growth.",{"_3226":463,"_28565":403,"_19778":47699,"_5":13556,"_25987":47557,"_2719":47700},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3226":464,"_28565":403,"_19778":47702,"_5":13556,"_25987":47557,"_2719":47703},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3226":465,"_28565":403,"_19778":47705,"_5":13556,"_25987":47557,"_2719":47706},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); without it, the clients trust the system CAs;",{"_3226":466,"_28565":403,"_19778":47708,"_5":13556,"_25987":47557,"_2719":47709},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3226":467,"_28565":403,"_19778":47711,"_5":13556,"_25987":47557,"_2719":47712},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3226":468,"_28565":403,"_19778":47714,"_5":13556,"_25987":47557,"_2719":47715},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3226":469,"_28565":403,"_19778":47717,"_5":13556,"_25987":47557,"_2719":47718},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3226":470,"_28565":403,"_19778":47720,"_5":13556,"_25987":47561,"_2719":47721},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3226":471,"_28565":403,"_19778":47723,"_5":13556,"_25987":47561,"_2719":47724},[],"Before closing an incident, record:",{"_3226":472,"_28565":403,"_19778":47726,"_5":13556,"_25987":47561,"_2719":47727},[],"the confirmed cause;",{"_3226":473,"_28565":403,"_19778":47729,"_5":13556,"_25987":47561,"_2719":47730},[],"the time scope and affected resources;",{"_3226":474,"_28565":403,"_19778":47732,"_5":13556,"_25987":47561,"_2719":47733},[],"the commands or queries used;",{"_3226":475,"_28565":403,"_19778":47735,"_5":13556,"_25987":47561,"_2719":47736},[],"the applied change and how to revert it;",{"_3226":476,"_28565":403,"_19778":47738,"_5":13556,"_25987":47561,"_2719":47739},[],"validation from a consumer;",{"_3226":477,"_28565":403,"_19778":47741,"_5":13556,"_25987":47561,"_2719":47742},[],"the preventive action and its owner.",{"_3226":478,"_28565":478,"_5":13914,"_2719":47744,"_28908":47745,"_19778":47748,"_25987":478},"Access control",[46297,47746,47747],"Platform","Administration",[],{"_3226":479,"_28565":478,"_19778":47750,"_5":13556,"_25987":478,"_2719":47751},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3226":480,"_28565":478,"_5":28905,"_19778":47753,"_25987":47754,"_2719":47755},[],"/docs/pr-preview/pr-42/platform/administration/access-control#essential-concepts","Essential concepts",{"_3226":481,"_28565":478,"_5":28905,"_19778":47757,"_25987":47758,"_2719":47759},[],"/docs/pr-preview/pr-42/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3226":482,"_28565":478,"_5":28905,"_19778":47761,"_25987":47762,"_2719":47763},[],"/docs/pr-preview/pr-42/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3226":483,"_28565":478,"_5":28905,"_19778":47765,"_25987":47766,"_2719":47767},[],"/docs/pr-preview/pr-42/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3226":484,"_28565":478,"_5":28905,"_19778":47769,"_25987":47770,"_2719":47771},[],"/docs/pr-preview/pr-42/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3226":485,"_28565":478,"_5":28905,"_19778":47773,"_25987":47774,"_2719":47775},[],"/docs/pr-preview/pr-42/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3226":486,"_28565":478,"_5":28905,"_19778":47777,"_25987":47778,"_2719":47779},[],"/docs/pr-preview/pr-42/platform/administration/access-control#oidc-principals","OIDC principals",{"_3226":487,"_28565":478,"_5":28905,"_19778":47781,"_25987":47782,"_2719":47783},[],"/docs/pr-preview/pr-42/platform/administration/access-control#x509-principals","X.509 principals",{"_3226":488,"_28565":478,"_5":28905,"_19778":47785,"_25987":47786,"_2719":47787},[],"/docs/pr-preview/pr-42/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3226":489,"_28565":478,"_5":28905,"_19778":47789,"_25987":47790,"_2719":47791},[],"/docs/pr-preview/pr-42/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3226":490,"_28565":478,"_5":28905,"_19778":47793,"_25987":47794,"_2719":47795},[],"/docs/pr-preview/pr-42/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3226":491,"_28565":478,"_5":28905,"_19778":47797,"_25987":47798,"_2719":47799},[],"/docs/pr-preview/pr-42/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3226":492,"_28565":478,"_5":28905,"_19778":47801,"_25987":47802,"_2719":47803},[],"/docs/pr-preview/pr-42/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3226":493,"_28565":478,"_5":28905,"_19778":47805,"_25987":47806,"_2719":47807},[],"/docs/pr-preview/pr-42/platform/administration/access-control#http-rules","HTTP rules",{"_3226":494,"_28565":478,"_5":28905,"_19778":47809,"_25987":47810,"_2719":47811},[],"/docs/pr-preview/pr-42/platform/administration/access-control#included-policies","Included policies",{"_3226":495,"_28565":478,"_5":28905,"_19778":47813,"_25987":47814,"_2719":46937},[],"/docs/pr-preview/pr-42/platform/administration/access-control#provision-the-first-administrator",{"_3226":496,"_28565":478,"_5":28905,"_19778":47816,"_25987":47817,"_2719":47818},[],"/docs/pr-preview/pr-42/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3226":497,"_28565":478,"_5":28905,"_19778":47820,"_25987":47821,"_2719":47822},[],"/docs/pr-preview/pr-42/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3226":498,"_28565":478,"_5":28905,"_19778":47824,"_25987":47825,"_2719":47826},[],"/docs/pr-preview/pr-42/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3226":499,"_28565":478,"_5":28905,"_19778":47828,"_25987":47829,"_2719":47830},[],"/docs/pr-preview/pr-42/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3226":500,"_28565":478,"_5":28905,"_19778":47832,"_25987":47833,"_2719":47834},[],"/docs/pr-preview/pr-42/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3226":501,"_28565":478,"_5":28905,"_19778":47836,"_25987":47837,"_2719":47838},[],"/docs/pr-preview/pr-42/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3226":502,"_28565":478,"_5":28905,"_19778":47840,"_25987":47841,"_2719":47842},[],"/docs/pr-preview/pr-42/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3226":503,"_28565":478,"_5":28905,"_19778":47844,"_25987":47845,"_2719":47846},[],"/docs/pr-preview/pr-42/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3226":504,"_28565":478,"_5":28905,"_19778":47848,"_25987":47849,"_2719":47850},[],"/docs/pr-preview/pr-42/platform/administration/access-control#operational-checklist","Operational checklist",{"_3226":505,"_28565":478,"_5":28905,"_19778":47852,"_25987":47853,"_2719":47854},[],"/docs/pr-preview/pr-42/platform/administration/access-control#diagnostics","Diagnostics",{"_3226":506,"_28565":478,"_5":28905,"_19778":47856,"_25987":47857,"_2719":47858},[],"/docs/pr-preview/pr-42/platform/administration/access-control#the-response-is-401","The response is 401",{"_3226":507,"_28565":478,"_5":28905,"_19778":47860,"_25987":47861,"_2719":47862},[],"/docs/pr-preview/pr-42/platform/administration/access-control#the-response-is-403","The response is 403",{"_3226":508,"_28565":478,"_5":28905,"_19778":47864,"_25987":47865,"_2719":47866},[],"/docs/pr-preview/pr-42/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3226":509,"_28565":478,"_5":28905,"_19778":47868,"_25987":47869,"_2719":47870},[],"/docs/pr-preview/pr-42/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3226":510,"_28565":478,"_5":28905,"_19778":47872,"_25987":47873,"_2719":47874},[],"/docs/pr-preview/pr-42/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3226":511,"_28565":478,"_19778":47876,"_5":13556,"_25987":478,"_2719":47877},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3226":512,"_28565":478,"_19778":47879,"_5":13556,"_25987":478,"_2719":47880},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3226":513,"_28565":478,"_19778":47882,"_5":13556,"_25987":478,"_2719":47883},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3226":514,"_28565":478,"_19778":47885,"_5":13556,"_25987":47754,"_2719":47886},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3226":515,"_28565":478,"_19778":47888,"_5":13556,"_25987":47754,"_2719":47889},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3226":516,"_28565":478,"_19778":47891,"_5":13556,"_25987":47754,"_2719":47892},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3226":517,"_28565":478,"_19778":47894,"_5":13556,"_25987":47754,"_2719":47895},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3226":518,"_28565":478,"_19778":47897,"_5":13556,"_25987":47754,"_2719":47898},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3226":519,"_28565":478,"_19778":47900,"_5":13556,"_25987":47754,"_2719":47901},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3226":520,"_28565":478,"_19778":47903,"_5":13556,"_25987":47758,"_2719":47904},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3226":521,"_28565":478,"_19778":47906,"_5":13556,"_25987":47758,"_2719":47907},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3226":522,"_28565":478,"_19778":47909,"_5":13556,"_25987":47762,"_2719":47910},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3226":523,"_28565":478,"_19778":47912,"_5":13556,"_25987":47762,"_2719":47913},[],"The decision is made **before forwarding the request to the service**:",{"_3226":524,"_28565":478,"_19778":47915,"_5":13556,"_25987":47762,"_2719":47916},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3226":525,"_28565":478,"_19778":47918,"_5":13556,"_25987":47762,"_2719":47919},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3226":526,"_28565":478,"_19778":47921,"_5":13556,"_25987":47762,"_2719":47922},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3226":527,"_28565":478,"_19778":47924,"_5":13556,"_25987":47762,"_2719":47925},[],"It separately loads the policies granted to each principal.",{"_3226":528,"_28565":478,"_19778":47927,"_5":13556,"_25987":47762,"_2719":47928},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3226":529,"_28565":478,"_19778":47930,"_5":13556,"_25987":47762,"_2719":47931},[],"`authz` looks for an HTTP rule granting that action.",{"_3226":530,"_28565":478,"_19778":47933,"_5":13556,"_25987":47762,"_2719":47934},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3226":531,"_28565":478,"_19778":47936,"_5":13556,"_25987":47762,"_2719":47937},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3226":532,"_28565":478,"_19778":47939,"_5":13556,"_25987":47762,"_2719":47940},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3226":533,"_28565":478,"_19778":47942,"_5":13556,"_25987":47762,"_2719":47943},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3226":534,"_28565":478,"_19778":47945,"_5":13556,"_25987":47766,"_2719":47946},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3226":535,"_28565":478,"_19778":47948,"_5":13556,"_25987":47766,"_2719":47949},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3226":536,"_28565":478,"_19778":47951,"_5":13556,"_25987":47766,"_2719":47952},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3226":537,"_28565":478,"_19778":47954,"_5":13556,"_25987":47766,"_2719":47955},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3226":538,"_28565":478,"_19778":47957,"_5":13556,"_25987":47766,"_2719":47958},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3226":539,"_28565":478,"_19778":47960,"_5":13556,"_25987":47766,"_2719":47961},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3226":540,"_28565":478,"_19778":47963,"_5":13556,"_25987":47766,"_2719":47964},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3226":541,"_28565":478,"_19778":47966,"_5":13556,"_25987":47766,"_2719":47967},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3226":542,"_28565":478,"_19778":47969,"_5":13556,"_25987":47770,"_2719":47970},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3226":543,"_28565":478,"_19778":47972,"_5":13556,"_25987":47770,"_2719":47973},[],"The decision is made with the domain operation context:",{"_3226":544,"_28565":478,"_19778":47975,"_5":13556,"_25987":47770,"_2719":47976},[],"The middleware extracts the credential and resolves the matching principals.",{"_3226":545,"_28565":478,"_19778":47978,"_5":13556,"_25987":47770,"_2719":47979},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3226":546,"_28565":478,"_19778":47981,"_5":13556,"_25987":47770,"_2719":47982},[],"`authz` gathers the entity rules of the granted policies.",{"_3226":547,"_28565":478,"_19778":47984,"_5":13556,"_25987":47770,"_2719":47985},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3226":548,"_28565":478,"_19778":47987,"_5":13556,"_25987":47770,"_2719":47988},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3226":549,"_28565":478,"_19778":47990,"_5":13556,"_25987":47770,"_2719":47991},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3226":550,"_28565":478,"_19778":47993,"_5":13556,"_25987":47770,"_2719":47994},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3226":551,"_28565":478,"_19778":47996,"_5":13556,"_25987":47770,"_2719":47997},[],"Actions fall into two groups:",{"_3226":552,"_28565":478,"_19778":47999,"_5":13556,"_25987":47770,"_2719":48000},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3226":553,"_28565":478,"_19778":48002,"_5":13556,"_25987":47770,"_2719":48003},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3226":554,"_28565":478,"_19778":48005,"_5":13556,"_25987":47770,"_2719":48006},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3226":555,"_28565":478,"_19778":48008,"_5":13556,"_25987":47774,"_2719":48009},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3226":556,"_28565":478,"_19778":48011,"_5":13556,"_25987":47774,"_2719":48012},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3226":557,"_28565":478,"_19778":48014,"_5":13556,"_25987":47774,"_2719":48015},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3226":558,"_28565":478,"_19778":48017,"_5":13556,"_25987":47778,"_2719":48018},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3226":559,"_28565":478,"_19778":48020,"_5":13556,"_25987":47778,"_2719":48021},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3226":560,"_28565":478,"_19778":48023,"_5":13556,"_25987":47778,"_2719":48024},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3226":561,"_28565":478,"_19778":48026,"_5":13556,"_25987":47778,"_2719":48027},[],"The implemented operators are:",{"_3226":562,"_28565":478,"_19778":48029,"_5":13556,"_25987":47778,"_2719":48030},[],"`equals`, for exact equality;",{"_3226":563,"_28565":478,"_19778":48032,"_5":13556,"_25987":47778,"_2719":48033},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3226":564,"_28565":478,"_19778":48035,"_5":13556,"_25987":47778,"_2719":48036},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3226":565,"_28565":478,"_19778":48038,"_5":13556,"_25987":47778,"_2719":48039},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3226":566,"_28565":478,"_19778":48041,"_5":13556,"_25987":47782,"_2719":48042},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3226":567,"_28565":478,"_19778":48044,"_5":13556,"_25987":47782,"_2719":48045},[],"The available modes are:",{"_3226":568,"_28565":478,"_19778":48047,"_5":13556,"_25987":47782,"_2719":48048},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3226":569,"_28565":478,"_19778":48050,"_5":13556,"_25987":47782,"_2719":48051},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3226":570,"_28565":478,"_19778":48053,"_5":13556,"_25987":47782,"_2719":48054},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3226":571,"_28565":478,"_19778":48056,"_5":13556,"_25987":47782,"_2719":48057},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3226":572,"_28565":478,"_19778":48059,"_5":13556,"_25987":47782,"_2719":48060},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3226":573,"_28565":478,"_19778":48062,"_5":13556,"_25987":47782,"_2719":48063},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3226":574,"_28565":478,"_19778":48065,"_5":13556,"_25987":47786,"_2719":48066},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3226":575,"_28565":478,"_19778":48068,"_5":13556,"_25987":47786,"_2719":48069},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3226":576,"_28565":478,"_19778":48071,"_5":13556,"_25987":47786,"_2719":48072},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3226":577,"_28565":478,"_19778":48074,"_5":13556,"_25987":47786,"_2719":48075},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3226":578,"_28565":478,"_19778":48077,"_5":13556,"_25987":47794,"_2719":48078},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3226":579,"_28565":478,"_19778":48080,"_5":13556,"_25987":47794,"_2719":48081},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3226":580,"_28565":478,"_19778":48083,"_5":13556,"_25987":47798,"_2719":48084},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3226":581,"_28565":478,"_19778":48086,"_5":13556,"_25987":47798,"_2719":48087},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3226":582,"_28565":478,"_19778":48089,"_5":13556,"_25987":47802,"_2719":48090},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3226":583,"_28565":478,"_19778":48092,"_5":13556,"_25987":47802,"_2719":48093},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3226":584,"_28565":478,"_19778":48095,"_5":13556,"_25987":47802,"_2719":48096},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3226":585,"_28565":478,"_19778":48098,"_5":13556,"_25987":47806,"_2719":48099},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3226":586,"_28565":478,"_19778":48101,"_5":13556,"_25987":47806,"_2719":48102},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3226":587,"_28565":478,"_19778":48104,"_5":13556,"_25987":47806,"_2719":48105},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3226":588,"_28565":478,"_19778":48107,"_5":13556,"_25987":47806,"_2719":48108},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3226":589,"_28565":478,"_19778":48110,"_5":13556,"_25987":47806,"_2719":48111},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3226":590,"_28565":478,"_19778":48113,"_5":13556,"_25987":47806,"_2719":48114},[],"Note that:",{"_3226":591,"_28565":478,"_19778":48116,"_5":13556,"_25987":47806,"_2719":48117},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3226":592,"_28565":478,"_19778":48119,"_5":13556,"_25987":47806,"_2719":48120},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3226":593,"_28565":478,"_19778":48122,"_5":13556,"_25987":47806,"_2719":48123},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3226":594,"_28565":478,"_19778":48125,"_5":13556,"_25987":47810,"_2719":48126},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3226":595,"_28565":478,"_19778":48128,"_5":13556,"_25987":47810,"_2719":48129},[],"full and read-only access to certificates and authorities;",{"_3226":596,"_28565":478,"_19778":48131,"_5":13556,"_25987":47810,"_2719":48132},[],"full and read-only access to the KMS;",{"_3226":597,"_28565":478,"_19778":48134,"_5":13556,"_25987":47810,"_2719":48135},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3226":598,"_28565":478,"_19778":48137,"_5":13556,"_25987":47810,"_2719":48138},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3226":599,"_28565":478,"_19778":48140,"_5":13556,"_25987":47810,"_2719":48141},[],"console access;",{"_3226":600,"_28565":478,"_19778":48143,"_5":13556,"_25987":47810,"_2719":48144},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3226":601,"_28565":478,"_19778":48146,"_5":13556,"_25987":47810,"_2719":48147},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3226":602,"_28565":478,"_19778":48149,"_5":13556,"_25987":47810,"_2719":48150},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3226":603,"_28565":478,"_19778":48152,"_5":13556,"_25987":47814,"_2719":48153},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3226":604,"_28565":478,"_19778":48155,"_5":13556,"_25987":47814,"_2719":48156},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3226":605,"_28565":478,"_19778":48158,"_5":13556,"_25987":47814,"_2719":48159},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3226":606,"_28565":478,"_19778":48161,"_5":13556,"_25987":47817,"_2719":48162},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3226":607,"_28565":478,"_19778":48164,"_5":13556,"_25987":47821,"_2719":48165},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3226":608,"_28565":478,"_19778":48167,"_5":13556,"_25987":47821,"_2719":48168},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3226":609,"_28565":478,"_19778":48170,"_5":13556,"_25987":47825,"_2719":48171},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3226":610,"_28565":478,"_19778":48173,"_5":13556,"_25987":47829,"_2719":48174},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3226":611,"_28565":478,"_19778":48176,"_5":13556,"_25987":47833,"_2719":48177},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3226":612,"_28565":478,"_19778":48179,"_5":13556,"_25987":47837,"_2719":48180},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3226":613,"_28565":478,"_19778":48182,"_5":13556,"_25987":47837,"_2719":48183},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3226":614,"_28565":478,"_19778":48185,"_5":13556,"_25987":47841,"_2719":48186},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3226":615,"_28565":478,"_19778":48188,"_5":13556,"_25987":47841,"_2719":48189},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3226":616,"_28565":478,"_19778":48191,"_5":13556,"_25987":47841,"_2719":48192},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3226":617,"_28565":478,"_19778":48194,"_5":13556,"_25987":47841,"_2719":48195},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3226":618,"_28565":478,"_19778":48197,"_5":13556,"_25987":47841,"_2719":48198},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3226":619,"_28565":478,"_19778":48200,"_5":13556,"_25987":47841,"_2719":48201},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3226":620,"_28565":478,"_19778":48203,"_5":13556,"_25987":47841,"_2719":48204},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3226":621,"_28565":478,"_19778":48206,"_5":13556,"_25987":47841,"_2719":48207},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3226":622,"_28565":478,"_19778":48209,"_5":13556,"_25987":47845,"_2719":48210},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3226":623,"_28565":478,"_19778":48212,"_5":13556,"_25987":47845,"_2719":48213},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3226":624,"_28565":478,"_19778":48215,"_5":13556,"_25987":47845,"_2719":48216},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3226":625,"_28565":478,"_19778":48218,"_5":13556,"_25987":47849,"_2719":48219},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3226":626,"_28565":478,"_19778":48221,"_5":13556,"_25987":47849,"_2719":48222},[],"Use groups or stable roles for people and independent identities for automations.",{"_3226":627,"_28565":478,"_19778":48224,"_5":13556,"_25987":47849,"_2719":48225},[],"Keep at least two recovery administrators and test their access periodically.",{"_3226":628,"_28565":478,"_19778":48227,"_5":13556,"_25987":47849,"_2719":48228},[],"Review active principals, their matches and their grants after IdP changes.",{"_3226":629,"_28565":478,"_19778":48230,"_5":13556,"_25987":47849,"_2719":48231},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3226":630,"_28565":478,"_19778":48233,"_5":13556,"_25987":47849,"_2719":48234},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3226":631,"_28565":478,"_19778":48236,"_5":13556,"_25987":47849,"_2719":48237},[],"Always test one allowed and one denied operation for each role.",{"_3226":632,"_28565":478,"_19778":48239,"_5":13556,"_25987":47849,"_2719":48240},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3226":633,"_28565":478,"_19778":48242,"_5":13556,"_25987":47857,"_2719":48243},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3226":634,"_28565":478,"_19778":48245,"_5":13556,"_25987":47861,"_2719":48246},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3226":635,"_28565":478,"_19778":48248,"_5":13556,"_25987":47861,"_2719":48249},[],"that an active principal of the correct type exists;",{"_3226":636,"_28565":478,"_19778":48251,"_5":13556,"_25987":47861,"_2719":48252},[],"that the claim paths and values match the real token exactly;",{"_3226":637,"_28565":478,"_19778":48254,"_5":13556,"_25987":47861,"_2719":48255},[],"that all of the principal's conditions hold;",{"_3226":638,"_28565":478,"_19778":48257,"_5":13556,"_25987":47861,"_2719":48258},[],"that the principal has the expected policy granted;",{"_3226":639,"_28565":478,"_19778":48260,"_5":13556,"_25987":47861,"_2719":48261},[],"that the policy includes the action and the requested resource type or route;",{"_3226":640,"_28565":478,"_19778":48263,"_5":13556,"_25987":47861,"_2719":48264},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3226":641,"_28565":478,"_19778":48266,"_5":13556,"_25987":47861,"_2719":48267},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3226":642,"_28565":478,"_19778":48269,"_5":13556,"_25987":47865,"_2719":48270},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3226":643,"_28565":478,"_19778":48272,"_5":13556,"_25987":47869,"_2719":48273},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3226":644,"_28565":478,"_19778":48275,"_5":13556,"_25987":47873,"_2719":48276},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3226":645,"_28565":478,"_19778":48278,"_5":13556,"_25987":47873,"_2719":48279},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3226":646,"_28565":646,"_5":13914,"_2719":48281,"_28908":48282,"_19778":48283,"_25987":646},"Alerts and subscriptions",[46297,47746,47747],[],{"_3226":647,"_28565":646,"_19778":48285,"_5":13556,"_25987":646,"_2719":48286},[],"Send PKI events to people and external systems.",{"_3226":648,"_28565":646,"_5":28905,"_19778":48288,"_25987":48289,"_2719":48290},[],"/docs/pr-preview/pr-42/platform/administration/alerts#how-it-works","How it works",{"_3226":649,"_28565":646,"_5":28905,"_19778":48292,"_25987":48293,"_2719":48294},[],"/docs/pr-preview/pr-42/platform/administration/alerts#available-channels","Available channels",{"_3226":650,"_28565":646,"_5":28905,"_19778":48296,"_25987":48297,"_2719":48298},[],"/docs/pr-preview/pr-42/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3226":651,"_28565":646,"_5":28905,"_19778":48300,"_25987":48301,"_2719":48302},[],"/docs/pr-preview/pr-42/platform/administration/alerts#choose-the-event","Choose the event",{"_3226":652,"_28565":646,"_5":28905,"_19778":48304,"_25987":48305,"_2719":48306},[],"/docs/pr-preview/pr-42/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3226":653,"_28565":646,"_5":28905,"_19778":48308,"_25987":48309,"_2719":48310},[],"/docs/pr-preview/pr-42/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3226":654,"_28565":646,"_5":28905,"_19778":48312,"_25987":48313,"_2719":48314},[],"/docs/pr-preview/pr-42/platform/administration/alerts#review-and-activate","Review and activate",{"_3226":655,"_28565":646,"_5":28905,"_19778":48316,"_25987":48317,"_2719":48318},[],"/docs/pr-preview/pr-42/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3226":656,"_28565":646,"_5":28905,"_19778":48320,"_25987":48321,"_2719":48322},[],"/docs/pr-preview/pr-42/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3226":657,"_28565":646,"_5":28905,"_19778":48324,"_25987":48325,"_2719":48326},[],"/docs/pr-preview/pr-42/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3226":658,"_28565":646,"_5":28905,"_19778":48328,"_25987":48329,"_2719":48330},[],"/docs/pr-preview/pr-42/platform/administration/alerts#event-families","Event families",{"_3226":659,"_28565":646,"_19778":48332,"_5":13556,"_25987":646,"_2719":48333},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3226":660,"_28565":646,"_19778":48335,"_5":13556,"_25987":48289,"_2719":48336},[],"A service publishes a domain event.",{"_3226":661,"_28565":646,"_19778":48338,"_5":13556,"_25987":48289,"_2719":48339},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3226":662,"_28565":646,"_19778":48341,"_5":13556,"_25987":48289,"_2719":48342},[],"Each subscription's filter decides whether it should be notified.",{"_3226":663,"_28565":646,"_19778":48344,"_5":13556,"_25987":48289,"_2719":48345},[],"Lamassu delivers the event to the configured channel.",{"_3226":664,"_28565":646,"_19778":48347,"_5":13556,"_25987":48289,"_2719":48348},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3226":665,"_28565":646,"_19778":48350,"_5":13556,"_25987":48293,"_2719":48351},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3226":666,"_28565":646,"_19778":48353,"_5":13556,"_25987":48293,"_2719":48354},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3226":667,"_28565":646,"_19778":48356,"_5":13556,"_25987":48293,"_2719":48357},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3226":668,"_28565":646,"_19778":48359,"_5":13556,"_25987":48293,"_2719":48360},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3226":669,"_28565":646,"_19778":48362,"_5":13556,"_25987":48293,"_2719":48363},[],"`apikey_options` requires `header` and `key`.",{"_3226":670,"_28565":646,"_19778":48365,"_5":13556,"_25987":48293,"_2719":48366},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3226":671,"_28565":646,"_19778":48368,"_5":13556,"_25987":48293,"_2719":48369},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3226":672,"_28565":646,"_19778":48371,"_5":13556,"_25987":48293,"_2719":48372},[],"The alerts API reference documents the full `http_client` schema.",{"_3226":673,"_28565":646,"_19778":48374,"_5":13556,"_25987":48301,"_2719":48375},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3226":674,"_28565":646,"_19778":48377,"_5":13556,"_25987":48305,"_2719":48378},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3226":675,"_28565":646,"_19778":48380,"_5":13556,"_25987":48309,"_2719":48381},[],"Add a filter if you don't want to receive every instance of the event.",{"_3226":676,"_28565":646,"_19778":48383,"_5":13556,"_25987":48309,"_2719":48384},[],"**None** notifies all instances of the event.",{"_3226":677,"_28565":646,"_19778":48386,"_5":13556,"_25987":48309,"_2719":48387},[],"**JSON Path** evaluates one or more specific fields.",{"_3226":678,"_28565":646,"_19778":48389,"_5":13556,"_25987":48309,"_2719":48390},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3226":679,"_28565":646,"_19778":48392,"_5":13556,"_25987":48309,"_2719":48393},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3226":680,"_28565":646,"_19778":48395,"_5":13556,"_25987":48309,"_2719":48396},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3226":681,"_28565":646,"_19778":48398,"_5":13556,"_25987":48313,"_2719":48399},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3226":682,"_28565":646,"_19778":48401,"_5":13556,"_25987":48317,"_2719":48402},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3226":683,"_28565":646,"_19778":48404,"_5":13556,"_25987":48317,"_2719":48405},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3226":684,"_28565":646,"_19778":48407,"_5":13556,"_25987":48317,"_2719":48408},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3226":685,"_28565":646,"_19778":48410,"_5":13556,"_25987":48317,"_2719":48411},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3226":686,"_28565":646,"_19778":48413,"_5":13556,"_25987":48317,"_2719":48414},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3226":687,"_28565":646,"_19778":48416,"_5":13556,"_25987":48317,"_2719":48417},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3226":688,"_28565":646,"_19778":48419,"_5":13556,"_25987":48317,"_2719":48420},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3226":689,"_28565":646,"_19778":48422,"_5":13556,"_25987":48317,"_2719":48423},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3226":690,"_28565":646,"_19778":48425,"_5":13556,"_25987":48321,"_2719":48426},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3226":691,"_28565":646,"_19778":48428,"_5":13556,"_25987":48321,"_2719":48429},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3226":692,"_28565":646,"_19778":48431,"_5":13556,"_25987":48321,"_2719":48432},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3226":693,"_28565":646,"_19778":48434,"_5":13556,"_25987":48321,"_2719":48435},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3226":694,"_28565":646,"_19778":48437,"_5":13556,"_25987":48321,"_2719":48438},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3226":695,"_28565":646,"_19778":48440,"_5":13556,"_25987":48321,"_2719":48441},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3226":696,"_28565":646,"_19778":48443,"_5":13556,"_25987":48321,"_2719":48444},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3226":697,"_28565":646,"_19778":48446,"_5":13556,"_25987":48321,"_2719":48447},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3226":698,"_28565":646,"_19778":48449,"_5":13556,"_25987":48325,"_2719":48450},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3226":699,"_28565":646,"_19778":48452,"_5":13556,"_25987":48325,"_2719":48453},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3226":700,"_28565":646,"_19778":48455,"_5":13556,"_25987":48329,"_2719":48456},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3226":701,"_28565":646,"_19778":48458,"_5":13556,"_25987":48329,"_2719":48459},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3226":702,"_28565":646,"_19778":48461,"_5":13556,"_25987":48329,"_2719":48462},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3226":703,"_28565":646,"_19778":48464,"_5":13556,"_25987":48329,"_2719":48465},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3226":704,"_28565":646,"_19778":48467,"_5":13556,"_25987":48329,"_2719":48468},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3226":705,"_28565":646,"_19778":48470,"_5":13556,"_25987":48329,"_2719":48471},[],"**Validation:** `va.role.crl.create`.",{"_3226":706,"_28565":646,"_19778":48473,"_5":13556,"_25987":48329,"_2719":48474},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3226":707,"_28565":646,"_19778":48476,"_5":13556,"_25987":48329,"_2719":48477},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3226":708,"_28565":708,"_5":13914,"_2719":48479,"_28908":48480,"_19778":48481,"_25987":708},"Audit logs",[46297,47746,47747],[],{"_3226":709,"_28565":708,"_19778":48483,"_5":13556,"_25987":708,"_2719":48484},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3226":710,"_28565":708,"_5":28905,"_19778":48486,"_25987":48487,"_2719":48488},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3226":711,"_28565":708,"_5":28905,"_19778":48490,"_25987":48491,"_2719":48492},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#coverage","Coverage",{"_3226":712,"_28565":708,"_5":28905,"_19778":48494,"_25987":48495,"_2719":48496},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3226":713,"_28565":708,"_5":28905,"_19778":48498,"_25987":48499,"_2719":48500},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3226":714,"_28565":708,"_5":28905,"_19778":48502,"_25987":48503,"_2719":48504},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3226":715,"_28565":708,"_5":28905,"_19778":48506,"_25987":48507,"_2719":48508},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3226":716,"_28565":708,"_5":28905,"_19778":48510,"_25987":48511,"_2719":48512},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3226":717,"_28565":708,"_5":28905,"_19778":48514,"_25987":48515,"_2719":48516},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3226":718,"_28565":708,"_5":28905,"_19778":48518,"_25987":48519,"_2719":48520},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3226":719,"_28565":708,"_5":28905,"_19778":48522,"_25987":48523,"_2719":48524},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3226":720,"_28565":708,"_5":28905,"_19778":48526,"_25987":48527,"_2719":48528},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3226":721,"_28565":708,"_19778":48530,"_5":13556,"_25987":708,"_2719":48531},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3226":722,"_28565":708,"_19778":48533,"_5":13556,"_25987":48487,"_2719":48534},[],"The audit body includes:",{"_3226":723,"_28565":708,"_19778":48536,"_5":13556,"_25987":48487,"_2719":48537},[],"input: data received by the operation;",{"_3226":724,"_28565":708,"_19778":48539,"_5":13556,"_25987":48487,"_2719":48540},[],"has\\_error: whether the service returned an error;",{"_3226":725,"_28565":708,"_19778":48542,"_5":13556,"_25987":48487,"_2719":48543},[],"output: produced result or error message;",{"_3226":726,"_28565":708,"_19778":48545,"_5":13556,"_25987":48487,"_2719":48546},[],"principals: identifiers of the principals that matched the request.",{"_3226":727,"_28565":708,"_19778":48548,"_5":13556,"_25987":48487,"_2719":48549},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3226":728,"_28565":708,"_19778":48551,"_5":13556,"_25987":48487,"_2719":48552},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3226":729,"_28565":708,"_19778":48554,"_5":13556,"_25987":48491,"_2719":48555},[],"The backend applies auditing to mutations of:",{"_3226":730,"_28565":708,"_19778":48557,"_5":13556,"_25987":48491,"_2719":48558},[],"authorities, certificates and issuance profiles;",{"_3226":731,"_28565":708,"_19778":48560,"_5":13556,"_25987":48491,"_2719":48561},[],"keys and KMS engines;",{"_3226":732,"_28565":708,"_19778":48563,"_5":13556,"_25987":48491,"_2719":48564},[],"devices and identities;",{"_3226":733,"_28565":708,"_19778":48566,"_5":13556,"_25987":48491,"_2719":48567},[],"DMSs and enrollment operations;",{"_3226":734,"_28565":708,"_19778":48569,"_5":13556,"_25987":48491,"_2719":48570},[],"validation functions and CRL;",{"_3226":735,"_28565":708,"_19778":48572,"_5":13556,"_25987":48491,"_2719":48573},[],"principals, policies and authorization grants.",{"_3226":736,"_28565":708,"_19778":48575,"_5":13556,"_25987":48491,"_2719":48576},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3226":737,"_28565":708,"_19778":48578,"_5":13556,"_25987":48495,"_2719":48579},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3226":738,"_28565":708,"_19778":48581,"_5":13556,"_25987":48495,"_2719":48582},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3226":739,"_28565":708,"_19778":48584,"_5":13556,"_25987":48495,"_2719":48585},[],"Design the consumer to:",{"_3226":740,"_28565":708,"_19778":48587,"_5":13556,"_25987":48495,"_2719":48588},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3226":741,"_28565":708,"_19778":48590,"_5":13556,"_25987":48495,"_2719":48591},[],"keep the complete CloudEvent unmodified;",{"_3226":742,"_28565":708,"_19778":48593,"_5":13556,"_25987":48495,"_2719":48594},[],"record the ingestion time and detect duplicates by ID;",{"_3226":743,"_28565":708,"_19778":48596,"_5":13556,"_25987":48495,"_2719":48597},[],"encrypt in transit and at rest;",{"_3226":744,"_28565":708,"_19778":48599,"_5":13556,"_25987":48495,"_2719":48600},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3226":745,"_28565":708,"_19778":48602,"_5":13556,"_25987":48495,"_2719":48603},[],"apply an explicit retention and legal hold policy;",{"_3226":746,"_28565":708,"_19778":48605,"_5":13556,"_25987":48495,"_2719":48606},[],"alert if it stops consuming or the pending queue grows.",{"_3226":747,"_28565":708,"_19778":48608,"_5":13556,"_25987":48499,"_2719":48609},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3226":748,"_28565":708,"_19778":48611,"_5":13556,"_25987":48499,"_2719":48612},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3226":749,"_28565":708,"_19778":48614,"_5":13556,"_25987":48507,"_2719":48615},[],"Start from the reported time and normalize every source to UTC.",{"_3226":750,"_28565":708,"_19778":48617,"_5":13556,"_25987":48511,"_2719":48618},[],"Filter by event type, service source and resource identifier.",{"_3226":751,"_28565":708,"_19778":48620,"_5":13556,"_25987":48515,"_2719":48621},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3226":752,"_28565":708,"_19778":48623,"_5":13556,"_25987":48519,"_2719":48624},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3226":753,"_28565":708,"_19778":48626,"_5":13556,"_25987":48523,"_2719":48627},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3226":754,"_28565":708,"_19778":48629,"_5":13556,"_25987":48527,"_2719":48630},[],"Generate a controlled mutation in a test environment and check that:",{"_3226":755,"_28565":708,"_19778":48632,"_5":13556,"_25987":48527,"_2719":48633},[],"a successful audit event appears;",{"_3226":756,"_28565":708,"_19778":48635,"_5":13556,"_25987":48527,"_2719":48636},[],"the principal matches the identity used;",{"_3226":757,"_28565":708,"_19778":48638,"_5":13556,"_25987":48527,"_2719":48639},[],"the consumer persists it exactly once;",{"_3226":758,"_28565":708,"_19778":48641,"_5":13556,"_25987":48527,"_2719":48642},[],"it can be retrieved by resource, actor and period;",{"_3226":759,"_28565":708,"_19778":48644,"_5":13556,"_25987":48527,"_2719":48645},[],"a consumer outage raises an alert.",{"_3226":760,"_28565":708,"_19778":48647,"_5":13556,"_25987":48527,"_2719":48648},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3226":761,"_28565":761,"_5":13914,"_2719":48650,"_28908":48651,"_19778":48652,"_25987":761},"Platform architecture",[46297,47746],[],{"_3226":762,"_28565":761,"_19778":48654,"_5":13556,"_25987":761,"_2719":48655},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3226":763,"_28565":761,"_5":28905,"_19778":48657,"_25987":48658,"_2719":48659},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#control-plane","Control plane",{"_3226":764,"_28565":761,"_5":28905,"_19778":48661,"_25987":48662,"_2719":48663},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3226":765,"_28565":761,"_5":28905,"_19778":48665,"_25987":48666,"_2719":48667},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3226":766,"_28565":761,"_5":28905,"_19778":48669,"_25987":48670,"_2719":48671},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#status-and-validation","Status and validation",{"_3226":767,"_28565":761,"_5":28905,"_19778":48673,"_25987":48674,"_2719":48675},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3226":768,"_28565":761,"_19778":48677,"_5":13556,"_25987":761,"_2719":48678},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3226":769,"_28565":761,"_19778":48680,"_5":13556,"_25987":761,"_2719":48681},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3226":770,"_28565":761,"_19778":48683,"_5":13556,"_25987":48658,"_2719":48684},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3226":771,"_28565":761,"_19778":48686,"_5":13556,"_25987":48662,"_2719":48687},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3226":772,"_28565":761,"_19778":48689,"_5":13556,"_25987":48666,"_2719":48690},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3226":773,"_28565":761,"_19778":48692,"_5":13556,"_25987":48670,"_2719":48693},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3226":774,"_28565":761,"_19778":48695,"_5":13556,"_25987":48674,"_2719":48696},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3226":775,"_28565":775,"_5":13914,"_2719":48698,"_28908":48699,"_19778":48700,"_25987":775},"How Lamassu works",[46297,47746],[],{"_3226":776,"_28565":775,"_19778":48702,"_5":13556,"_25987":775,"_2719":48703},[],"The mental model of trust, keys, certificates and devices.",{"_3226":777,"_28565":775,"_5":28905,"_19778":48705,"_25987":48706,"_2719":48707},[],"/docs/pr-preview/pr-42/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3226":778,"_28565":775,"_5":28905,"_19778":48709,"_25987":48710,"_2719":48711},[],"/docs/pr-preview/pr-42/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3226":779,"_28565":775,"_19778":48713,"_5":13556,"_25987":775,"_2719":48714},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3226":780,"_28565":775,"_19778":48716,"_5":13556,"_25987":48706,"_2719":48717},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3226":781,"_28565":775,"_19778":48719,"_5":13556,"_25987":48706,"_2719":48720},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3226":782,"_28565":775,"_19778":48722,"_5":13556,"_25987":48706,"_2719":48723},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3226":783,"_28565":775,"_19778":48725,"_5":13556,"_25987":48706,"_2719":48726},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3226":784,"_28565":775,"_19778":48728,"_5":13556,"_25987":48706,"_2719":48729},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3226":785,"_28565":775,"_19778":48731,"_5":13556,"_25987":48710,"_2719":48732},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3226":786,"_28565":775,"_19778":48734,"_5":13556,"_25987":48710,"_2719":48735},[],"A DMS relates that CA to an enrollment policy.",{"_3226":787,"_28565":775,"_19778":48737,"_5":13556,"_25987":48710,"_2719":48738},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3226":788,"_28565":775,"_19778":48740,"_5":13556,"_25987":48710,"_2719":48741},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3226":789,"_28565":775,"_19778":48743,"_5":13556,"_25987":48710,"_2719":48744},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3226":790,"_28565":775,"_19778":48746,"_5":13556,"_25987":48710,"_2719":48747},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3226":791,"_28565":775,"_19778":48749,"_5":13556,"_25987":48710,"_2719":48750},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3226":792,"_28565":792,"_5":13914,"_2719":48752,"_28908":48753,"_19778":48755,"_25987":792},"Devices and identities",[46297,47746,48754,48752],"IoT Fleets",[],{"_3226":793,"_28565":792,"_19778":48757,"_5":13556,"_25987":792,"_2719":48758},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3226":794,"_28565":792,"_5":28905,"_19778":48760,"_25987":48761,"_2719":48762},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","Device states",{"_3226":795,"_28565":792,"_5":28905,"_19778":48764,"_25987":48765,"_2719":48766},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3226":796,"_28565":792,"_5":28905,"_19778":48768,"_25987":48769,"_2719":48770},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3226":797,"_28565":792,"_5":28905,"_19778":48772,"_25987":48773,"_2719":48774},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3226":798,"_28565":792,"_5":28905,"_19778":48776,"_25987":48777,"_2719":48778},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3226":799,"_28565":792,"_5":28905,"_19778":48780,"_25987":48781,"_2719":48782},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3226":800,"_28565":792,"_5":28905,"_19778":48784,"_25987":48785,"_2719":48786},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3226":801,"_28565":792,"_5":28905,"_19778":48788,"_25987":48789,"_2719":48790},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3226":802,"_28565":792,"_5":28905,"_19778":48792,"_25987":48793,"_2719":48794},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3226":803,"_28565":792,"_5":28905,"_19778":48796,"_25987":48797,"_2719":48798},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3226":804,"_28565":792,"_5":28905,"_19778":48800,"_25987":48801,"_2719":48802},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3226":805,"_28565":792,"_19778":48804,"_5":13556,"_25987":792,"_2719":48805},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3226":806,"_28565":792,"_19778":48807,"_5":13556,"_25987":792,"_2719":48808},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3226":807,"_28565":792,"_19778":48810,"_5":13556,"_25987":48761,"_2719":48811},[],"Operational view",{"_3226":808,"_28565":792,"_19778":48813,"_5":13556,"_25987":48761,"_2719":48814},[],"Meaning",{"_3226":809,"_28565":792,"_19778":48816,"_5":13556,"_25987":48761,"_2719":48817},[],"**No Identity**",{"_3226":810,"_28565":792,"_19778":48819,"_5":13556,"_25987":48761,"_2719":48820},[],"A record exists without an associated identity.",{"_3226":811,"_28565":792,"_19778":48822,"_5":13556,"_25987":48761,"_2719":48823},[],"**Active**",{"_3226":812,"_28565":792,"_19778":48825,"_5":13556,"_25987":48761,"_2719":48826},[],"The slot is active; also check certificate dates, status and usages.",{"_3226":813,"_28565":792,"_19778":48828,"_5":13556,"_25987":48761,"_2719":48829},[],"**Renewal Pending**",{"_3226":814,"_28565":792,"_19778":48831,"_5":13556,"_25987":48761,"_2719":48832},[],"The identity is in the operational renewal window.",{"_3226":815,"_28565":792,"_19778":48834,"_5":13556,"_25987":48761,"_2719":48835},[],"**Expiring Soon**",{"_3226":816,"_28565":792,"_19778":48837,"_5":13556,"_25987":48761,"_2719":48838},[],"Expiration is approaching according to configured thresholds.",{"_3226":817,"_28565":792,"_19778":48840,"_5":13556,"_25987":48761,"_2719":48841},[],"**Expired**",{"_3226":818,"_28565":792,"_19778":48843,"_5":13556,"_25987":48761,"_2719":48844},[],"The identity has expired.",{"_3226":819,"_28565":792,"_19778":48846,"_5":13556,"_25987":48761,"_2719":48847},[],"**Revoked**",{"_3226":820,"_28565":792,"_19778":48849,"_5":13556,"_25987":48761,"_2719":48850},[],"The identity is marked revoked.",{"_3226":821,"_28565":792,"_19778":48852,"_5":13556,"_25987":48761,"_2719":48853},[],"**Decommissioned**",{"_3226":822,"_28565":792,"_19778":48855,"_5":13556,"_25987":48761,"_2719":48856},[],"The record is retired and ordinary updates do not restore operation.",{"_3226":823,"_28565":792,"_19778":48858,"_5":13556,"_25987":48761,"_2719":48859},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3226":824,"_28565":792,"_19778":48861,"_5":13556,"_25987":48765,"_2719":48862},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3226":825,"_28565":792,"_19778":48864,"_5":13556,"_25987":48765,"_2719":48865},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3226":826,"_28565":792,"_19778":48867,"_5":13556,"_25987":48765,"_2719":48868},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3226":827,"_28565":792,"_19778":48870,"_5":13556,"_25987":48765,"_2719":48871},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3226":828,"_28565":792,"_19778":48873,"_5":13556,"_25987":48769,"_2719":48874},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3226":829,"_28565":792,"_19778":48876,"_5":13556,"_25987":48773,"_2719":48877},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3226":830,"_28565":792,"_19778":48879,"_5":13556,"_25987":48777,"_2719":48880},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3226":831,"_28565":792,"_19778":48882,"_5":13556,"_25987":48781,"_2719":48883},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3226":832,"_28565":792,"_19778":48885,"_5":13556,"_25987":48785,"_2719":48886},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3226":833,"_28565":792,"_19778":48888,"_5":13556,"_25987":48785,"_2719":48889},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3226":834,"_28565":792,"_19778":48891,"_5":13556,"_25987":48789,"_2719":48892},[],"From **No Identity**, use **Assign Identity**:",{"_3226":835,"_28565":792,"_19778":48894,"_5":13556,"_25987":48789,"_2719":48895},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3226":836,"_28565":792,"_19778":48897,"_5":13556,"_25987":48789,"_2719":48898},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3226":837,"_28565":792,"_19778":48900,"_5":13556,"_25987":48789,"_2719":48901},[],"Confirm and read the serial, active version and history again.",{"_3226":838,"_28565":792,"_19778":48903,"_5":13556,"_25987":48789,"_2719":48904},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3226":839,"_28565":792,"_19778":48906,"_5":13556,"_25987":48789,"_2719":48907},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3226":840,"_28565":792,"_19778":48909,"_5":13556,"_25987":48793,"_2719":48910},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3226":841,"_28565":792,"_19778":48912,"_5":13556,"_25987":48793,"_2719":48913},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3226":842,"_28565":792,"_19778":48915,"_5":13556,"_25987":48797,"_2719":48916},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3226":843,"_28565":792,"_19778":48918,"_5":13556,"_25987":48797,"_2719":48919},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3226":844,"_28565":792,"_19778":48921,"_5":13556,"_25987":48797,"_2719":48922},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3226":845,"_28565":792,"_19778":48924,"_5":13556,"_25987":48797,"_2719":48925},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3226":846,"_28565":792,"_19778":48927,"_5":13556,"_25987":48801,"_2719":48928},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3226":847,"_28565":792,"_19778":48930,"_5":13556,"_25987":48801,"_2719":48931},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3226":848,"_28565":848,"_5":13914,"_2719":48933,"_28908":48934,"_19778":48936,"_25987":848},"Bootstrap identity and authentication",[46297,47746,48754,48752,48935],"Enrollment with PKI",[],{"_3226":849,"_28565":848,"_19778":48938,"_5":13556,"_25987":848,"_2719":48939},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3226":850,"_28565":848,"_5":28905,"_19778":48941,"_25987":48942,"_2719":48943},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3226":851,"_28565":848,"_5":28905,"_19778":48945,"_25987":48946,"_2719":48947},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3226":852,"_28565":848,"_5":28905,"_19778":48949,"_25987":48950,"_2719":48951},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3226":853,"_28565":848,"_5":28905,"_19778":48953,"_25987":48954,"_2719":48955},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3226":854,"_28565":848,"_5":28905,"_19778":48957,"_25987":48958,"_2719":48959},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3226":855,"_28565":848,"_19778":48961,"_5":13556,"_25987":848,"_2719":48962},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3226":856,"_28565":848,"_19778":48964,"_5":13556,"_25987":48942,"_2719":48965},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3226":857,"_28565":848,"_19778":48967,"_5":13556,"_25987":48942,"_2719":48968},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3226":858,"_28565":848,"_19778":48970,"_5":13556,"_25987":48946,"_2719":48971},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3226":859,"_28565":848,"_19778":48973,"_5":13556,"_25987":48946,"_2719":48974},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3226":860,"_28565":848,"_19778":48976,"_5":13556,"_25987":48946,"_2719":48977},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3226":861,"_28565":848,"_19778":48979,"_5":13556,"_25987":48950,"_2719":48980},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3226":862,"_28565":848,"_19778":48982,"_5":13556,"_25987":48950,"_2719":48983},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3226":863,"_28565":848,"_19778":48985,"_5":13556,"_25987":48954,"_2719":48986},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3226":864,"_28565":848,"_19778":48988,"_5":13556,"_25987":48954,"_2719":48989},[],"Example body:",{"_3226":865,"_28565":848,"_19778":48991,"_5":13556,"_25987":48954,"_2719":48992},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3226":866,"_28565":848,"_19778":48994,"_5":13556,"_25987":48954,"_2719":48995},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3226":867,"_28565":848,"_19778":48997,"_5":13556,"_25987":48954,"_2719":48998},[],"Continuation requires a successful HTTP response and JSON:",{"_3226":868,"_28565":848,"_19778":49000,"_5":13556,"_25987":48954,"_2719":49001},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3226":869,"_28565":848,"_19778":49003,"_5":13556,"_25987":48958,"_2719":49004},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3226":870,"_28565":848,"_19778":49006,"_5":13556,"_25987":48958,"_2719":49007},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3226":871,"_28565":871,"_5":13914,"_2719":49009,"_28908":49010,"_19778":49011,"_25987":871},"Configure and operate the DMS",[46297,47746,48754,48752,48935],[],{"_3226":872,"_28565":871,"_19778":49013,"_5":13556,"_25987":871,"_2719":49014},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3226":873,"_28565":871,"_5":28905,"_19778":49016,"_25987":49017,"_2719":46307},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3226":874,"_28565":871,"_5":28905,"_19778":49019,"_25987":49020,"_2719":49021},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3226":875,"_28565":871,"_5":28905,"_19778":49023,"_25987":49024,"_2719":49025},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3226":876,"_28565":871,"_5":28905,"_19778":49027,"_25987":49028,"_2719":49029},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3226":877,"_28565":871,"_5":28905,"_19778":49031,"_25987":49032,"_2719":49033},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3226":878,"_28565":871,"_5":28905,"_19778":49035,"_25987":49036,"_2719":49037},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3226":879,"_28565":871,"_5":28905,"_19778":49039,"_25987":49040,"_2719":49041},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3226":880,"_28565":871,"_5":28905,"_19778":49043,"_25987":49044,"_2719":49045},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3226":881,"_28565":871,"_5":28905,"_19778":49047,"_25987":49048,"_2719":49049},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3226":882,"_28565":871,"_5":28905,"_19778":49051,"_25987":49052,"_2719":49053},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3226":883,"_28565":871,"_5":28905,"_19778":49055,"_25987":49056,"_2719":49057},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3226":884,"_28565":871,"_5":28905,"_19778":49059,"_25987":49060,"_2719":49061},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3226":885,"_28565":871,"_5":28905,"_19778":49063,"_25987":49064,"_2719":49065},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3226":886,"_28565":871,"_5":28905,"_19778":49067,"_25987":49068,"_2719":49069},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3226":887,"_28565":871,"_5":28905,"_19778":49071,"_25987":49072,"_2719":49073},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3226":888,"_28565":871,"_5":28905,"_19778":49075,"_25987":49076,"_2719":49077},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3226":889,"_28565":871,"_5":28905,"_19778":49079,"_25987":49080,"_2719":49081},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3226":890,"_28565":871,"_5":28905,"_19778":49083,"_25987":49084,"_2719":49085},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3226":891,"_28565":871,"_19778":49087,"_5":13556,"_25987":871,"_2719":49088},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3226":892,"_28565":871,"_19778":49090,"_5":13556,"_25987":49017,"_2719":49091},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3226":893,"_28565":871,"_19778":49093,"_5":13556,"_25987":49017,"_2719":49094},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3226":894,"_28565":871,"_19778":49096,"_5":13556,"_25987":49024,"_2719":49097},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3226":895,"_28565":871,"_19778":49099,"_5":13556,"_25987":49028,"_2719":49100},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3226":896,"_28565":871,"_19778":49102,"_5":13556,"_25987":49032,"_2719":49103},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3226":897,"_28565":871,"_19778":49105,"_5":13556,"_25987":49036,"_2719":49106},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3226":898,"_28565":871,"_19778":49108,"_5":13556,"_25987":49040,"_2719":49109},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3226":899,"_28565":871,"_19778":49111,"_5":13556,"_25987":49048,"_2719":49112},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3226":900,"_28565":871,"_19778":49114,"_5":13556,"_25987":49048,"_2719":49115},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3226":901,"_28565":871,"_19778":49117,"_5":13556,"_25987":49052,"_2719":49118},[],"`settings.enrollment_settings` field",{"_3226":902,"_28565":871,"_19778":49120,"_5":13556,"_25987":49052,"_2719":49121},[],"Decision",{"_3226":903,"_28565":871,"_19778":49123,"_5":13556,"_25987":49052,"_2719":49124},[],"`protocol`",{"_3226":904,"_28565":871,"_19778":49126,"_5":13556,"_25987":49052,"_2719":49127},[],"`EST_RFC7030` for these operations.",{"_3226":905,"_28565":871,"_19778":49129,"_5":13556,"_25987":49052,"_2719":49130},[],"`enrollment_ca`",{"_3226":906,"_28565":871,"_19778":49132,"_5":13556,"_25987":49052,"_2719":49133},[],"ID of the signing CA.",{"_3226":907,"_28565":871,"_19778":49135,"_5":13556,"_25987":49052,"_2719":49136},[],"`verify_csr_signature`",{"_3226":908,"_28565":871,"_19778":49138,"_5":13556,"_25987":49052,"_2719":49139},[],"Keep `true` to verify CSR key possession.",{"_3226":909,"_28565":871,"_19778":49141,"_5":13556,"_25987":49052,"_2719":49142},[],"`enable_replaceable_enrollment`",{"_3226":910,"_28565":871,"_19778":49144,"_5":13556,"_25987":49052,"_2719":49145},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3226":911,"_28565":871,"_19778":49147,"_5":13556,"_25987":49052,"_2719":49148},[],"`est_rfc7030_settings.auth_mode`",{"_3226":912,"_28565":871,"_19778":49150,"_5":13556,"_25987":49052,"_2719":49151},[],"One of the four authentication modes.",{"_3226":913,"_28565":871,"_19778":49153,"_5":13556,"_25987":49052,"_2719":49154},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3226":914,"_28565":871,"_19778":49156,"_5":13556,"_25987":49056,"_2719":49157},[],"The blocks are independent:",{"_3226":915,"_28565":871,"_19778":49159,"_5":13556,"_25987":49056,"_2719":49160},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3226":916,"_28565":871,"_19778":49162,"_5":13556,"_25987":49056,"_2719":49163},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3226":917,"_28565":871,"_19778":49165,"_5":13556,"_25987":49056,"_2719":49166},[],"`auth_mode`",{"_3226":918,"_28565":871,"_19778":49168,"_5":13556,"_25987":49056,"_2719":49169},[],"Control applied in the configured operation",{"_3226":919,"_28565":871,"_19778":49171,"_5":13556,"_25987":49056,"_2719":49172},[],"`CLIENT_CERTIFICATE`",{"_3226":920,"_28565":871,"_19778":49174,"_5":13556,"_25987":49056,"_2719":49175},[],"Presented certificate validation.",{"_3226":921,"_28565":871,"_19778":49177,"_5":13556,"_25987":49056,"_2719":49178},[],"`EXTERNAL_WEBHOOK`",{"_3226":922,"_28565":871,"_19778":49180,"_5":13556,"_25987":49056,"_2719":49181},[],"Configured webhook authorization.",{"_3226":923,"_28565":871,"_19778":49183,"_5":13556,"_25987":49056,"_2719":49184},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3226":924,"_28565":871,"_19778":49186,"_5":13556,"_25987":49056,"_2719":49187},[],"Certificate validation followed by webhook approval.",{"_3226":925,"_28565":871,"_19778":49189,"_5":13556,"_25987":49056,"_2719":49190},[],"`NO_AUTH`",{"_3226":926,"_28565":871,"_19778":49192,"_5":13556,"_25987":49056,"_2719":49193},[],"No DMS requester authentication.",{"_3226":927,"_28565":871,"_19778":49195,"_5":13556,"_25987":49056,"_2719":49196},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3226":928,"_28565":871,"_19778":49198,"_5":13556,"_25987":49056,"_2719":49199},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3226":929,"_28565":871,"_19778":49201,"_5":13556,"_25987":49056,"_2719":49202},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3226":930,"_28565":871,"_19778":49204,"_5":13556,"_25987":49056,"_2719":49205},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3226":931,"_28565":871,"_19778":49207,"_5":13556,"_25987":49060,"_2719":49208},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3226":932,"_28565":871,"_19778":49210,"_5":13556,"_25987":49060,"_2719":49211},[],"`external_webhook_settings` field",{"_3226":933,"_28565":871,"_19778":49213,"_5":13556,"_25987":49060,"_2719":49121},[],{"_3226":934,"_28565":871,"_19778":49215,"_5":13556,"_25987":49060,"_2719":49216},[],"`url`",{"_3226":935,"_28565":871,"_19778":49218,"_5":13556,"_25987":49060,"_2719":49219},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3226":936,"_28565":871,"_19778":49221,"_5":13556,"_25987":49060,"_2719":49222},[],"`method`",{"_3226":937,"_28565":871,"_19778":49224,"_5":13556,"_25987":49060,"_2719":49225},[],"`POST` or `PUT`; `POST` by default.",{"_3226":938,"_28565":871,"_19778":49227,"_5":13556,"_25987":49060,"_2719":49228},[],"`name`",{"_3226":939,"_28565":871,"_19778":49230,"_5":13556,"_25987":49060,"_2719":49231},[],"Label used in service logs.",{"_3226":940,"_28565":871,"_19778":49233,"_5":13556,"_25987":49060,"_2719":49234},[],"`config.auth_mode`",{"_3226":941,"_28565":871,"_19778":49236,"_5":13556,"_25987":49060,"_2719":49237},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3226":942,"_28565":871,"_19778":49239,"_5":13556,"_25987":49060,"_2719":49240},[],"`config.log_level`",{"_3226":943,"_28565":871,"_19778":49242,"_5":13556,"_25987":49060,"_2719":49243},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3226":944,"_28565":871,"_19778":49245,"_5":13556,"_25987":49060,"_2719":49246},[],"`config.apikey_options`",{"_3226":945,"_28565":871,"_19778":49248,"_5":13556,"_25987":49060,"_2719":49249},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3226":946,"_28565":871,"_19778":49251,"_5":13556,"_25987":49060,"_2719":49252},[],"`config.jwt_options`",{"_3226":947,"_28565":871,"_19778":49254,"_5":13556,"_25987":49060,"_2719":49255},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3226":948,"_28565":871,"_19778":49257,"_5":13556,"_25987":49060,"_2719":49258},[],"`config.mtls_options`",{"_3226":949,"_28565":871,"_19778":49260,"_5":13556,"_25987":49060,"_2719":49261},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3226":950,"_28565":871,"_19778":49263,"_5":13556,"_25987":49060,"_2719":49264},[],"`config.insecure_skip_verify`",{"_3226":951,"_28565":871,"_19778":49266,"_5":13556,"_25987":49060,"_2719":49267},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3226":952,"_28565":871,"_19778":49269,"_5":13556,"_25987":49060,"_2719":49270},[],"`config.call_timeout`",{"_3226":953,"_28565":871,"_19778":49272,"_5":13556,"_25987":49060,"_2719":49273},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3226":954,"_28565":871,"_19778":49275,"_5":13556,"_25987":49060,"_2719":49276},[],"Rules for that configuration:",{"_3226":955,"_28565":871,"_19778":49278,"_5":13556,"_25987":49060,"_2719":49279},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3226":956,"_28565":871,"_19778":49281,"_5":13556,"_25987":49060,"_2719":49282},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3226":957,"_28565":871,"_19778":49284,"_5":13556,"_25987":49060,"_2719":49285},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3226":958,"_28565":871,"_19778":49287,"_5":13556,"_25987":49060,"_2719":49288},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3226":959,"_28565":871,"_19778":49290,"_5":13556,"_25987":49060,"_2719":49291},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3226":960,"_28565":871,"_19778":49293,"_5":13556,"_25987":49060,"_2719":49294},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3226":961,"_28565":871,"_19778":49296,"_5":13556,"_25987":49060,"_2719":49297},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3226":962,"_28565":871,"_19778":49299,"_5":13556,"_25987":49060,"_2719":49300},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3226":963,"_28565":871,"_19778":49302,"_5":13556,"_25987":49060,"_2719":49303},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3226":964,"_28565":871,"_19778":49305,"_5":13556,"_25987":49064,"_2719":49306},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3226":965,"_28565":871,"_19778":49308,"_5":13556,"_25987":49068,"_2719":49309},[],"`settings.reenrollment_settings` field",{"_3226":966,"_28565":871,"_19778":49311,"_5":13556,"_25987":49068,"_2719":46687},[],{"_3226":967,"_28565":871,"_19778":49313,"_5":13556,"_25987":49068,"_2719":49314},[],"`reenrollment_delta`",{"_3226":968,"_28565":871,"_19778":49316,"_5":13556,"_25987":49068,"_2719":49317},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3226":969,"_28565":871,"_19778":49319,"_5":13556,"_25987":49068,"_2719":49320},[],"`preventive_delta`",{"_3226":970,"_28565":871,"_19778":49322,"_5":13556,"_25987":49068,"_2719":49323},[],"Preventive operational monitoring threshold.",{"_3226":971,"_28565":871,"_19778":49325,"_5":13556,"_25987":49068,"_2719":49326},[],"`critical_delta`",{"_3226":972,"_28565":871,"_19778":49328,"_5":13556,"_25987":49068,"_2719":49329},[],"Critical operational monitoring threshold.",{"_3226":973,"_28565":871,"_19778":49331,"_5":13556,"_25987":49068,"_2719":49332},[],"`enable_expired_renewal`",{"_3226":974,"_28565":871,"_19778":49334,"_5":13556,"_25987":49068,"_2719":49335},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3226":975,"_28565":871,"_19778":49337,"_5":13556,"_25987":49068,"_2719":49338},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3226":976,"_28565":871,"_19778":49340,"_5":13556,"_25987":49068,"_2719":49341},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3226":977,"_28565":871,"_19778":49343,"_5":13556,"_25987":49068,"_2719":49344},[],"`revoke_on_reenrollment`",{"_3226":978,"_28565":871,"_19778":49346,"_5":13556,"_25987":49068,"_2719":49347},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3226":979,"_28565":871,"_19778":49349,"_5":13556,"_25987":49068,"_2719":49350},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3226":980,"_28565":871,"_19778":49352,"_5":13556,"_25987":49072,"_2719":49353},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3226":981,"_28565":871,"_19778":49355,"_5":13556,"_25987":49076,"_2719":46681},[],{"_3226":982,"_28565":871,"_19778":49357,"_5":13556,"_25987":49076,"_2719":49358},[],"Published material",{"_3226":983,"_28565":871,"_19778":49360,"_5":13556,"_25987":49076,"_2719":49361},[],"**Include Lamassu System CA**",{"_3226":984,"_28565":871,"_19778":49363,"_5":13556,"_25987":49076,"_2719":49364},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3226":985,"_28565":871,"_19778":49366,"_5":13556,"_25987":49076,"_2719":49367},[],"**Include Enrollment CA**",{"_3226":986,"_28565":871,"_19778":49369,"_5":13556,"_25987":49076,"_2719":49370},[],"Selected issuing CA certificate.",{"_3226":987,"_28565":871,"_19778":49372,"_5":13556,"_25987":49076,"_2719":49373},[],"**Managed CAs**",{"_3226":988,"_28565":871,"_19778":49375,"_5":13556,"_25987":49076,"_2719":49376},[],"Explicitly selected CA certificates.",{"_3226":989,"_28565":871,"_19778":49378,"_5":13556,"_25987":49076,"_2719":49379},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3226":990,"_28565":871,"_19778":49381,"_5":13556,"_25987":49080,"_2719":49382},[],"**Edit** changes name, settings and metadata. When using the API, read the DMS before editing it: `name` and `settings` are replaced entirely. Omitted or `null` `metadata` keeps the stored value, and an object replaces it entirely. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3226":991,"_28565":871,"_19778":49384,"_5":13556,"_25987":49080,"_2719":49385},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3226":992,"_28565":871,"_19778":49387,"_5":13556,"_25987":49080,"_2719":49388},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3226":993,"_28565":871,"_19778":49390,"_5":13556,"_25987":49084,"_2719":49391},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3226":994,"_28565":994,"_5":13914,"_2719":49393,"_28908":49394,"_19778":49395,"_25987":994},"Integrate the EST client",[46297,47746,48754,48752,48935],[],{"_3226":995,"_28565":994,"_19778":49397,"_5":13556,"_25987":994,"_2719":49398},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3226":996,"_28565":994,"_5":28905,"_19778":49400,"_25987":49401,"_2719":46307},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3226":997,"_28565":994,"_5":28905,"_19778":49403,"_25987":49404,"_2719":49405},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3226":998,"_28565":994,"_5":28905,"_19778":49407,"_25987":49408,"_2719":49409},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3226":999,"_28565":994,"_5":28905,"_19778":49411,"_25987":49412,"_2719":49413},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3226":1000,"_28565":994,"_5":28905,"_19778":49415,"_25987":49416,"_2719":49417},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3226":1001,"_28565":994,"_5":28905,"_19778":49419,"_25987":49420,"_2719":49421},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3226":1002,"_28565":994,"_19778":49423,"_5":13556,"_25987":994,"_2719":49424},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3226":1003,"_28565":994,"_19778":49426,"_5":13556,"_25987":49401,"_2719":49427},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3226":1004,"_28565":994,"_19778":49429,"_5":13556,"_25987":49401,"_2719":49430},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3226":1005,"_28565":994,"_19778":49432,"_5":13556,"_25987":49401,"_2719":49433},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3226":1006,"_28565":994,"_19778":49435,"_5":13556,"_25987":49404,"_2719":49436},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3226":1007,"_28565":994,"_19778":49438,"_5":13556,"_25987":49404,"_2719":49439},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3226":1008,"_28565":994,"_19778":49441,"_5":13556,"_25987":49408,"_2719":49442},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3226":1009,"_28565":994,"_19778":49444,"_5":13556,"_25987":49408,"_2719":49445},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3226":1010,"_28565":994,"_19778":49447,"_5":13556,"_25987":49412,"_2719":49448},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3226":1011,"_28565":994,"_19778":49450,"_5":13556,"_25987":49412,"_2719":49451},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3226":1012,"_28565":994,"_19778":49453,"_5":13556,"_25987":49416,"_2719":49454},[],"For a root that issues directly:",{"_3226":1013,"_28565":994,"_19778":49456,"_5":13556,"_25987":49416,"_2719":49457},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3226":1014,"_28565":994,"_19778":49459,"_5":13556,"_25987":49416,"_2719":49460},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3226":1015,"_28565":994,"_19778":49462,"_5":13556,"_25987":49420,"_2719":49463},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3226":1016,"_28565":1016,"_5":13914,"_2719":49465,"_28908":49466,"_19778":49467,"_25987":1016},"EST reference",[46297,47746,48754,48752,48935],[],{"_3226":1017,"_28565":1016,"_19778":49469,"_5":13556,"_25987":1016,"_2719":49470},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3226":1018,"_28565":1016,"_5":28905,"_19778":49472,"_25987":49473,"_2719":49474},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3226":1019,"_28565":1016,"_5":28905,"_19778":49476,"_25987":49477,"_2719":21487},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3226":1020,"_28565":1016,"_5":28905,"_19778":49479,"_25987":49480,"_2719":24636},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3226":1021,"_28565":1016,"_5":28905,"_19778":49482,"_25987":49483,"_2719":24643},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3226":1022,"_28565":1016,"_5":28905,"_19778":49485,"_25987":49486,"_2719":23976},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3226":1023,"_28565":1016,"_5":28905,"_19778":49488,"_25987":49489,"_2719":49490},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3226":1024,"_28565":1016,"_5":28905,"_19778":49492,"_25987":49493,"_2719":49494},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3226":1025,"_28565":1016,"_5":28905,"_19778":49496,"_25987":49497,"_2719":49498},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3226":1026,"_28565":1016,"_19778":49500,"_5":13556,"_25987":1016,"_2719":49501},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3226":1027,"_28565":1016,"_19778":49503,"_5":13556,"_25987":49473,"_2719":49504},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3226":1028,"_28565":1016,"_19778":49506,"_5":13556,"_25987":49473,"_2719":49507},[],"Operation",{"_3226":1029,"_28565":1016,"_19778":49509,"_5":13556,"_25987":49473,"_2719":49510},[],"Method",{"_3226":1030,"_28565":1016,"_19778":49512,"_5":13556,"_25987":49473,"_2719":49513},[],"Authentication and condition",{"_3226":1031,"_28565":1016,"_19778":49515,"_5":13556,"_25987":49473,"_2719":49516},[],"`/cacerts`",{"_3226":1032,"_28565":1016,"_19778":49518,"_5":13556,"_25987":49473,"_2719":49519},[],"GET",{"_3226":1033,"_28565":1016,"_19778":49521,"_5":13556,"_25987":49473,"_2719":49522},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3226":1034,"_28565":1016,"_19778":49524,"_5":13556,"_25987":49473,"_2719":49525},[],"`/simpleenroll`",{"_3226":1035,"_28565":1016,"_19778":49527,"_5":13556,"_25987":49473,"_2719":49528},[],"POST",{"_3226":1036,"_28565":1016,"_19778":49530,"_5":13556,"_25987":49473,"_2719":49531},[],"Initial authentication and DMS registration/replacement policy.",{"_3226":1037,"_28565":1016,"_19778":49533,"_5":13556,"_25987":49473,"_2719":49534},[],"`/simplereenroll`",{"_3226":1038,"_28565":1016,"_19778":49536,"_5":13556,"_25987":49473,"_2719":49528},[],{"_3226":1039,"_28565":1016,"_19778":49538,"_5":13556,"_25987":49473,"_2719":49539},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3226":1040,"_28565":1016,"_19778":49541,"_5":13556,"_25987":49473,"_2719":49542},[],"`/serverkeygen`",{"_3226":1041,"_28565":1016,"_19778":49544,"_5":13556,"_25987":49473,"_2719":49528},[],{"_3226":1042,"_28565":1016,"_19778":49546,"_5":13556,"_25987":49473,"_2719":49547},[],"Initial authentication and admission; server generation enabled.",{"_3226":1043,"_28565":1016,"_19778":49549,"_5":13556,"_25987":49473,"_2719":49550},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3226":1044,"_28565":1016,"_19778":49552,"_5":13556,"_25987":49477,"_2719":49553},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3226":1045,"_28565":1016,"_19778":49555,"_5":13556,"_25987":49477,"_2719":49556},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3226":1046,"_28565":1016,"_19778":49558,"_5":13556,"_25987":49480,"_2719":49559},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3226":1047,"_28565":1016,"_19778":49561,"_5":13556,"_25987":49480,"_2719":49562},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3226":1048,"_28565":1016,"_19778":49564,"_5":13556,"_25987":49483,"_2719":49565},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3226":1049,"_28565":1016,"_19778":49567,"_5":13556,"_25987":49483,"_2719":49568},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3226":1050,"_28565":1016,"_19778":49570,"_5":13556,"_25987":49486,"_2719":49571},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3226":1051,"_28565":1016,"_19778":49573,"_5":13556,"_25987":49486,"_2719":49574},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3226":1052,"_28565":1016,"_19778":49576,"_5":13556,"_25987":49489,"_2719":49577},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3226":1053,"_28565":1016,"_19778":49579,"_5":13556,"_25987":49489,"_2719":49580},[],"Part",{"_3226":1054,"_28565":1016,"_19778":49582,"_5":13556,"_25987":49489,"_2719":49583},[],"Content after decoding its Base64",{"_3226":1055,"_28565":1016,"_19778":49585,"_5":13556,"_25987":49489,"_2719":49586},[],"`application/pkcs8`",{"_3226":1056,"_28565":1016,"_19778":49588,"_5":13556,"_25987":49489,"_2719":49589},[],"Unencrypted DER PKCS#8 private key.",{"_3226":1057,"_28565":1016,"_19778":49591,"_5":13556,"_25987":49489,"_2719":49592},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3226":1058,"_28565":1016,"_19778":49594,"_5":13556,"_25987":49489,"_2719":49595},[],"DER PKCS#7 containing the issued certificate.",{"_3226":1059,"_28565":1016,"_19778":49597,"_5":13556,"_25987":49489,"_2719":49598},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3226":1060,"_28565":1016,"_19778":49600,"_5":13556,"_25987":49493,"_2719":49601},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3226":1061,"_28565":1016,"_19778":49603,"_5":13556,"_25987":49493,"_2719":49604},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3226":1062,"_28565":1016,"_19778":49606,"_5":13556,"_25987":49493,"_2719":49607},[],"Convert and check the result:",{"_3226":1063,"_28565":1016,"_19778":49609,"_5":13556,"_25987":49493,"_2719":49610},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3226":1064,"_28565":1016,"_19778":49612,"_5":13556,"_25987":49497,"_2719":49613},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3226":1065,"_28565":1016,"_19778":49615,"_5":13556,"_25987":49497,"_2719":49616},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3226":1066,"_28565":1066,"_5":13914,"_2719":48935,"_28908":49618,"_19778":49619,"_25987":1066},[46297,47746,48754,48752,48935],[],{"_3226":1067,"_28565":1066,"_19778":49621,"_5":13556,"_25987":1066,"_2719":49622},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3226":1068,"_28565":1066,"_5":28905,"_19778":49624,"_25987":49625,"_2719":49626},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3226":1069,"_28565":1066,"_5":28905,"_19778":49628,"_25987":49629,"_2719":49630},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3226":1070,"_28565":1066,"_5":28905,"_19778":49632,"_25987":49633,"_2719":49634},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3226":1071,"_28565":1066,"_5":28905,"_19778":49636,"_25987":49637,"_2719":49638},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3226":1072,"_28565":1066,"_19778":49640,"_5":13556,"_25987":1066,"_2719":49641},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3226":1073,"_28565":1066,"_19778":49643,"_5":13556,"_25987":49625,"_2719":49644},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3226":1074,"_28565":1066,"_19778":49646,"_5":13556,"_25987":49625,"_2719":49647},[],"The integrator installs initial EST server trust and an admission credential.",{"_3226":1075,"_28565":1066,"_19778":49649,"_5":13556,"_25987":49625,"_2719":49650},[],"The client requests an identity for its `Device ID` through EST.",{"_3226":1076,"_28565":1066,"_19778":49652,"_5":13556,"_25987":49625,"_2719":49653},[],"Certificate, device binding and key/certificate installation are checked.",{"_3226":1077,"_28565":1066,"_19778":49655,"_5":13556,"_25987":49625,"_2719":49656},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3226":1078,"_28565":1066,"_19778":49658,"_5":13556,"_25987":49625,"_2719":49659},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3226":1079,"_28565":1066,"_19778":49661,"_5":13556,"_25987":49629,"_2719":49662},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3226":1080,"_28565":1066,"_19778":49664,"_5":13556,"_25987":49629,"_2719":49665},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3226":1081,"_28565":1066,"_19778":49667,"_5":13556,"_25987":49629,"_2719":49668},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3226":1082,"_28565":1066,"_19778":49670,"_5":13556,"_25987":49629,"_2719":49671},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3226":1083,"_28565":1066,"_19778":49673,"_5":13556,"_25987":49633,"_2719":49674},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3226":1084,"_28565":1066,"_19778":49676,"_5":13556,"_25987":49633,"_2719":49677},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3226":1085,"_28565":1066,"_19778":49679,"_5":13556,"_25987":49633,"_2719":49680},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3226":1086,"_28565":1066,"_19778":49682,"_5":13556,"_25987":49633,"_2719":49683},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3226":1087,"_28565":1066,"_19778":49685,"_5":13556,"_25987":49637,"_2719":49686},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3226":1088,"_28565":1066,"_19778":49688,"_5":13556,"_25987":49637,"_2719":49689},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3226":1089,"_28565":1089,"_5":13914,"_2719":49691,"_28908":49692,"_19778":49693,"_25987":1089},"Provisioning strategies",[46297,47746,48754,48752,48935],[],{"_3226":1090,"_28565":1089,"_19778":49695,"_5":13556,"_25987":1089,"_2719":49696},[],"Choose device registration, identity authorization and key generation.",{"_3226":1091,"_28565":1089,"_5":28905,"_19778":49698,"_25987":49699,"_2719":49700},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3226":1092,"_28565":1089,"_5":28905,"_19778":49702,"_25987":49703,"_2719":49704},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3226":1093,"_28565":1089,"_5":28905,"_19778":49706,"_25987":49707,"_2719":49708},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3226":1094,"_28565":1089,"_5":28905,"_19778":49710,"_25987":49711,"_2719":49712},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3226":1095,"_28565":1089,"_5":28905,"_19778":49714,"_25987":49715,"_2719":49716},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3226":1096,"_28565":1089,"_19778":49718,"_5":13556,"_25987":1089,"_2719":49719},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3226":1097,"_28565":1089,"_19778":49721,"_5":13556,"_25987":49699,"_2719":49722},[],"Path",{"_3226":1098,"_28565":1089,"_19778":49724,"_5":13556,"_25987":49699,"_2719":49725},[],"When the device exists",{"_3226":1099,"_28565":1089,"_19778":49727,"_5":13556,"_25987":49699,"_2719":49728},[],"What to check",{"_3226":1100,"_28565":1089,"_19778":49730,"_5":13556,"_25987":49699,"_2719":49731},[],"Manual assignment",{"_3226":1101,"_28565":1089,"_19778":49733,"_5":13556,"_25987":49699,"_2719":49734},[],"An operator creates it before associating a certificate.",{"_3226":1102,"_28565":1089,"_19778":49736,"_5":13556,"_25987":49699,"_2719":49737},[],"ID, owning DMS, certificate CN and bound serial.",{"_3226":1103,"_28565":1089,"_19778":49739,"_5":13556,"_25987":49699,"_2719":49740},[],"EST with `JITP`",{"_3226":1104,"_28565":1089,"_19778":49742,"_5":13556,"_25987":49699,"_2719":49743},[],"Created for an unknown CN during `/simpleenroll`.",{"_3226":1105,"_28565":1089,"_19778":49745,"_5":13556,"_25987":49699,"_2719":49746},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3226":1106,"_28565":1089,"_19778":49748,"_5":13556,"_25987":49699,"_2719":49749},[],"EST with `PRE_REGISTRATION`",{"_3226":1107,"_28565":1089,"_19778":49751,"_5":13556,"_25987":49699,"_2719":49752},[],"Must exist before `/simpleenroll`.",{"_3226":1108,"_28565":1089,"_19778":49754,"_5":13556,"_25987":49699,"_2719":49755},[],"Approved record, same DMS and replacement conditions for your version.",{"_3226":1109,"_28565":1089,"_19778":49757,"_5":13556,"_25987":49699,"_2719":49758},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3226":1110,"_28565":1089,"_19778":49760,"_5":13556,"_25987":49699,"_2719":49761},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3226":1111,"_28565":1089,"_19778":49763,"_5":13556,"_25987":49703,"_2719":49764},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3226":1112,"_28565":1089,"_19778":49766,"_5":13556,"_25987":49703,"_2719":49767},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3226":1113,"_28565":1089,"_19778":49769,"_5":13556,"_25987":49703,"_2719":49770},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3226":1114,"_28565":1089,"_19778":49772,"_5":13556,"_25987":49707,"_2719":49773},[],"Decide initial enrollment and re-enrollment separately:",{"_3226":1115,"_28565":1089,"_19778":49775,"_5":13556,"_25987":49707,"_2719":49776},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3226":1116,"_28565":1089,"_19778":49778,"_5":13556,"_25987":49707,"_2719":49779},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3226":1117,"_28565":1089,"_19778":49781,"_5":13556,"_25987":49707,"_2719":49782},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3226":1118,"_28565":1089,"_19778":49784,"_5":13556,"_25987":49707,"_2719":49785},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3226":1119,"_28565":1089,"_19778":49787,"_5":13556,"_25987":49707,"_2719":49788},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3226":1120,"_28565":1089,"_19778":49790,"_5":13556,"_25987":49711,"_2719":46681},[],{"_3226":1121,"_28565":1089,"_19778":49792,"_5":13556,"_25987":49711,"_2719":49793},[],"Material crossing EST",{"_3226":1122,"_28565":1089,"_19778":49795,"_5":13556,"_25987":49711,"_2719":49796},[],"Device-generated key",{"_3226":1123,"_28565":1089,"_19778":49798,"_5":13556,"_25987":49711,"_2719":49799},[],"Public CSR and certificate; the key stays on the client.",{"_3226":1124,"_28565":1089,"_19778":49801,"_5":13556,"_25987":49711,"_2719":49802},[],"Existing device key",{"_3226":1125,"_28565":1089,"_19778":49804,"_5":13556,"_25987":49711,"_2719":49805},[],"CSR signed with that key and a new certificate.",{"_3226":1126,"_28565":1089,"_19778":49807,"_5":13556,"_25987":49711,"_2719":49073},[],{"_3226":1127,"_28565":1089,"_19778":49809,"_5":13556,"_25987":49711,"_2719":49810},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3226":1128,"_28565":1089,"_19778":49812,"_5":13556,"_25987":49711,"_2719":49813},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3226":1129,"_28565":1089,"_19778":49815,"_5":13556,"_25987":49715,"_2719":49816},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3226":1130,"_28565":1130,"_5":13914,"_2719":49818,"_28908":49819,"_19778":49820,"_25987":1130},"Renewal and recovery",[46297,47746,48754,48752,48935],[],{"_3226":1131,"_28565":1130,"_19778":49822,"_5":13556,"_25987":1130,"_2719":49823},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3226":1132,"_28565":1130,"_5":28905,"_19778":49825,"_25987":49826,"_2719":49827},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3226":1133,"_28565":1130,"_5":28905,"_19778":49829,"_25987":49830,"_2719":49831},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3226":1134,"_28565":1130,"_5":28905,"_19778":49833,"_25987":49834,"_2719":49835},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3226":1135,"_28565":1130,"_5":28905,"_19778":49837,"_25987":49838,"_2719":49839},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3226":1136,"_28565":1130,"_5":28905,"_19778":49841,"_25987":49842,"_2719":49843},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3226":1137,"_28565":1130,"_19778":49845,"_5":13556,"_25987":1130,"_2719":49846},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3226":1138,"_28565":1130,"_19778":49848,"_5":13556,"_25987":49826,"_2719":49849},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3226":1139,"_28565":1130,"_19778":49851,"_5":13556,"_25987":49826,"_2719":49852},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3226":1140,"_28565":1130,"_19778":49854,"_5":13556,"_25987":49826,"_2719":49855},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3226":1141,"_28565":1130,"_19778":49857,"_5":13556,"_25987":49826,"_2719":49858},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3226":1142,"_28565":1130,"_19778":49860,"_5":13556,"_25987":49830,"_2719":49861},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3226":1143,"_28565":1130,"_19778":49863,"_5":13556,"_25987":49830,"_2719":49864},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3226":1144,"_28565":1130,"_19778":49866,"_5":13556,"_25987":49834,"_2719":49867},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3226":1145,"_28565":1130,"_19778":49869,"_5":13556,"_25987":49834,"_2719":49870},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3226":1146,"_28565":1130,"_19778":49872,"_5":13556,"_25987":49834,"_2719":49873},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3226":1147,"_28565":1130,"_19778":49875,"_5":13556,"_25987":49838,"_2719":49876},[],"Situation",{"_3226":1148,"_28565":1130,"_19778":49878,"_5":13556,"_25987":49838,"_2719":49879},[],"Procedure",{"_3226":1149,"_28565":1130,"_19778":49881,"_5":13556,"_25987":49838,"_2719":49882},[],"Valid certificate, outside the window",{"_3226":1150,"_28565":1130,"_19778":49884,"_5":13556,"_25987":49838,"_2719":49885},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3226":1151,"_28565":1130,"_19778":49887,"_5":13556,"_25987":49838,"_2719":49888},[],"Expired certificate, key available",{"_3226":1152,"_28565":1130,"_19778":49890,"_5":13556,"_25987":49838,"_2719":49891},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3226":1153,"_28565":1130,"_19778":49893,"_5":13556,"_25987":49838,"_2719":49894},[],"Renewal through webhook or `NO_AUTH`",{"_3226":1154,"_28565":1130,"_19778":49896,"_5":13556,"_25987":49838,"_2719":49897},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3226":1155,"_28565":1130,"_19778":49899,"_5":13556,"_25987":49838,"_2719":49900},[],"Lost or inaccessible key",{"_3226":1156,"_28565":1130,"_19778":49902,"_5":13556,"_25987":49838,"_2719":49903},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3226":1157,"_28565":1130,"_19778":49905,"_5":13556,"_25987":49838,"_2719":49906},[],"Current identity revoked",{"_3226":1158,"_28565":1130,"_19778":49908,"_5":13556,"_25987":49838,"_2719":49909},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3226":1159,"_28565":1130,"_19778":49911,"_5":13556,"_25987":49838,"_2719":49912},[],"Device without an identity",{"_3226":1160,"_28565":1130,"_19778":49914,"_5":13556,"_25987":49838,"_2719":49915},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3226":1161,"_28565":1130,"_19778":49917,"_5":13556,"_25987":49838,"_2719":49918},[],"Retired device",{"_3226":1162,"_28565":1130,"_19778":49920,"_5":13556,"_25987":49838,"_2719":49921},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3226":1163,"_28565":1130,"_19778":49923,"_5":13556,"_25987":49838,"_2719":49924},[],"Timeout, HTTP 500 or installation failure",{"_3226":1164,"_28565":1130,"_19778":49926,"_5":13556,"_25987":49838,"_2719":49927},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3226":1165,"_28565":1130,"_19778":49929,"_5":13556,"_25987":49842,"_2719":49930},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3226":1166,"_28565":1130,"_19778":49932,"_5":13556,"_25987":49842,"_2719":49933},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3226":1167,"_28565":1167,"_5":13914,"_2719":49935,"_28908":49936,"_19778":49937,"_25987":1167},"Enrollment troubleshooting",[46297,47746,48754,48752,48935],[],{"_3226":1168,"_28565":1167,"_19778":49939,"_5":13556,"_25987":1167,"_2719":49940},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3226":1169,"_28565":1167,"_5":28905,"_19778":49942,"_25987":49943,"_2719":49944},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3226":1170,"_28565":1167,"_5":28905,"_19778":49946,"_25987":49947,"_2719":49948},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3226":1171,"_28565":1167,"_5":28905,"_19778":49950,"_25987":49951,"_2719":49498},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3226":1172,"_28565":1167,"_5":28905,"_19778":49953,"_25987":49954,"_2719":49955},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3226":1173,"_28565":1167,"_19778":49957,"_5":13556,"_25987":1167,"_2719":49958},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3226":1174,"_28565":1167,"_19778":49960,"_5":13556,"_25987":49947,"_2719":49961},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3226":1175,"_28565":1167,"_19778":49963,"_5":13556,"_25987":49947,"_2719":49964},[],"Symptom or message",{"_3226":1176,"_28565":1167,"_19778":49966,"_5":13556,"_25987":49947,"_2719":49728},[],{"_3226":1177,"_28565":1167,"_19778":49968,"_5":13556,"_25987":49947,"_2719":49969},[],"curl rejects TLS, name or issuer",{"_3226":1178,"_28565":1167,"_19778":49971,"_5":13556,"_25987":49947,"_2719":49972},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3226":1179,"_28565":1167,"_19778":49974,"_5":13556,"_25987":49947,"_2719":49975},[],"404 or missing APS",{"_3226":1180,"_28565":1167,"_19778":49977,"_5":13556,"_25987":49947,"_2719":49978},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3226":1181,"_28565":1167,"_19778":49980,"_5":13556,"_25987":49947,"_2719":49981},[],"400, CSR or format error",{"_3226":1182,"_28565":1167,"_19778":49983,"_5":13556,"_25987":49947,"_2719":49984},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3226":1183,"_28565":1167,"_19778":49986,"_5":13556,"_25987":49947,"_2719":49987},[],"Missing credential or invalid certificate",{"_3226":1184,"_28565":1167,"_19778":49989,"_5":13556,"_25987":49947,"_2719":49990},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3226":1185,"_28565":1167,"_19778":49992,"_5":13556,"_25987":49947,"_2719":49993},[],"Webhook denies, times out or responds without authorization",{"_3226":1186,"_28565":1167,"_19778":49995,"_5":13556,"_25987":49947,"_2719":49996},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3226":1187,"_28565":1167,"_19778":49998,"_5":13556,"_25987":49947,"_2719":49999},[],"`unexpected status code: <n>: redirects are not followed`",{"_3226":1188,"_28565":1167,"_19778":50001,"_5":13556,"_25987":49947,"_2719":50002},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3226":1189,"_28565":1167,"_19778":50004,"_5":13556,"_25987":49947,"_2719":50005},[],"`webhook response exceeds 1048576 bytes`",{"_3226":1190,"_28565":1167,"_19778":50007,"_5":13556,"_25987":49947,"_2719":50008},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3226":1191,"_28565":1167,"_19778":50010,"_5":13556,"_25987":49947,"_2719":50011},[],"`webhook config must not reference files`",{"_3226":1192,"_28565":1167,"_19778":50013,"_5":13556,"_25987":49947,"_2719":50014},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3226":1193,"_28565":1167,"_19778":50016,"_5":13556,"_25987":49947,"_2719":50017},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3226":1194,"_28565":1167,"_19778":50019,"_5":13556,"_25987":49947,"_2719":50020},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3226":1195,"_28565":1167,"_19778":50022,"_5":13556,"_25987":49947,"_2719":50023},[],"`webhook mTLS certificate and key are invalid: …`",{"_3226":1196,"_28565":1167,"_19778":50025,"_5":13556,"_25987":49947,"_2719":50026},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3226":1197,"_28565":1167,"_19778":50028,"_5":13556,"_25987":49947,"_2719":50029},[],"400 `struct validation error` creating or updating a DMS",{"_3226":1198,"_28565":1167,"_19778":50031,"_5":13556,"_25987":49947,"_2719":50032},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3226":1199,"_28565":1167,"_19778":50034,"_5":13556,"_25987":49947,"_2719":50035},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3226":1200,"_28565":1167,"_19778":50037,"_5":13556,"_25987":49947,"_2719":50038},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3226":1201,"_28565":1167,"_19778":50040,"_5":13556,"_25987":49947,"_2719":50041},[],"`device not preregistered`",{"_3226":1202,"_28565":1167,"_19778":50043,"_5":13556,"_25987":49947,"_2719":50044},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3226":1203,"_28565":1167,"_19778":50046,"_5":13556,"_25987":49947,"_2719":50047},[],"`forbiddenNewEnrollment`",{"_3226":1204,"_28565":1167,"_19778":50049,"_5":13556,"_25987":49947,"_2719":50050},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3226":1205,"_28565":1167,"_19778":50052,"_5":13556,"_25987":49947,"_2719":50053},[],"Different owning DMS",{"_3226":1206,"_28565":1167,"_19778":50055,"_5":13556,"_25987":49947,"_2719":50056},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3226":1207,"_28565":1167,"_19778":50058,"_5":13556,"_25987":49947,"_2719":50059},[],"`invalid RawSubject bytes`",{"_3226":1208,"_28565":1167,"_19778":50061,"_5":13556,"_25987":49947,"_2719":50062},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3226":1209,"_28565":1167,"_19778":50064,"_5":13556,"_25987":49947,"_2719":50065},[],"`invalid reenroll window`",{"_3226":1210,"_28565":1167,"_19778":50067,"_5":13556,"_25987":49947,"_2719":50068},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3226":1211,"_28565":1167,"_19778":50070,"_5":13556,"_25987":49947,"_2719":50071},[],"Current certificate revoked",{"_3226":1212,"_28565":1167,"_19778":50073,"_5":13556,"_25987":49947,"_2719":50074},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3226":1213,"_28565":1167,"_19778":50076,"_5":13556,"_25987":49947,"_2719":50077},[],"CA, profile or signing error",{"_3226":1214,"_28565":1167,"_19778":50079,"_5":13556,"_25987":49947,"_2719":50080},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3226":1215,"_28565":1167,"_19778":50082,"_5":13556,"_25987":49947,"_2719":50083},[],"HTTP 200 without a device connection",{"_3226":1216,"_28565":1167,"_19778":50085,"_5":13556,"_25987":49947,"_2719":50086},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3226":1217,"_28565":1167,"_19778":50088,"_5":13556,"_25987":49947,"_2719":50089},[],"Timeout or error after issuance",{"_3226":1218,"_28565":1167,"_19778":50091,"_5":13556,"_25987":49947,"_2719":50092},[],"New certificates, current slot and previous identity's state before retrying.",{"_3226":1219,"_28565":1167,"_19778":50094,"_5":13556,"_25987":49951,"_2719":50095},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3226":1220,"_28565":1167,"_19778":50097,"_5":13556,"_25987":49951,"_2719":50098},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3226":1221,"_28565":1167,"_19778":50100,"_5":13556,"_25987":49954,"_2719":50101},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3226":1222,"_28565":1167,"_19778":50103,"_5":13556,"_25987":49954,"_2719":50104},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3226":1223,"_28565":1167,"_19778":50106,"_5":13556,"_25987":49954,"_2719":50107},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3226":1224,"_28565":1167,"_19778":50109,"_5":13556,"_25987":49954,"_2719":50110},[],"Make one request, save headers/body and query the device and certificates.",{"_3226":1225,"_28565":1167,"_19778":50112,"_5":13556,"_25987":49954,"_2719":50113},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3226":1226,"_28565":1167,"_19778":50115,"_5":13556,"_25987":49954,"_2719":50116},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3226":1227,"_28565":1167,"_19778":50118,"_5":13556,"_25987":49954,"_2719":50119},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3226":1228,"_28565":1228,"_5":13914,"_2719":50121,"_28908":50122,"_19778":50123,"_25987":1228},"Trust distribution and updates",[46297,47746,48754,48752,48935],[],{"_3226":1229,"_28565":1228,"_19778":50125,"_5":13556,"_25987":1228,"_2719":50126},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3226":1230,"_28565":1228,"_5":28905,"_19778":50128,"_25987":50129,"_2719":50130},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3226":1231,"_28565":1228,"_5":28905,"_19778":50132,"_25987":50133,"_2719":50134},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3226":1232,"_28565":1228,"_5":28905,"_19778":50136,"_25987":50137,"_2719":50138},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3226":1233,"_28565":1228,"_5":28905,"_19778":50140,"_25987":50141,"_2719":50142},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3226":1234,"_28565":1228,"_5":28905,"_19778":50144,"_25987":50145,"_2719":50146},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3226":1235,"_28565":1228,"_19778":50148,"_5":13556,"_25987":1228,"_2719":50149},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3226":1236,"_28565":1228,"_19778":50151,"_5":13556,"_25987":50129,"_2719":50152},[],"Relationship",{"_3226":1237,"_28565":1228,"_19778":50154,"_5":13556,"_25987":50129,"_2719":50155},[],"Material prepared by its owner",{"_3226":1238,"_28565":1228,"_19778":50157,"_5":13556,"_25987":50129,"_2719":50158},[],"Device → EST server",{"_3226":1239,"_28565":1228,"_19778":50160,"_5":13556,"_25987":50129,"_2719":50161},[],"Previously verified server root, chain or pin and TLS name.",{"_3226":1240,"_28565":1228,"_19778":50163,"_5":13556,"_25987":50129,"_2719":50164},[],"DMS → requester",{"_3226":1241,"_28565":1228,"_19778":50166,"_5":13556,"_25987":50129,"_2719":50167},[],"CAs and rules authorizing initial or renewal credentials.",{"_3226":1242,"_28565":1228,"_19778":50169,"_5":13556,"_25987":50129,"_2719":50170},[],"Consumer → device",{"_3226":1243,"_28565":1228,"_19778":50172,"_5":13556,"_25987":50129,"_2719":50173},[],"Operational identity roots, intermediates, validation and permissions.",{"_3226":1244,"_28565":1228,"_19778":50175,"_5":13556,"_25987":50129,"_2719":50176},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3226":1245,"_28565":1228,"_19778":50178,"_5":13556,"_25987":50133,"_2719":50179},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3226":1246,"_28565":1228,"_19778":50181,"_5":13556,"_25987":50133,"_2719":50182},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3226":1247,"_28565":1228,"_19778":50184,"_5":13556,"_25987":50137,"_2719":50185},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3226":1248,"_28565":1228,"_19778":50187,"_5":13556,"_25987":50137,"_2719":50188},[],"Select policy-approved roots as anchors.",{"_3226":1249,"_28565":1228,"_19778":50190,"_5":13556,"_25987":50137,"_2719":50191},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3226":1250,"_28565":1228,"_19778":50193,"_5":13556,"_25987":50137,"_2719":50194},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3226":1251,"_28565":1228,"_19778":50196,"_5":13556,"_25987":50137,"_2719":50197},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3226":1252,"_28565":1228,"_19778":50199,"_5":13556,"_25987":50137,"_2719":50200},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3226":1253,"_28565":1228,"_19778":50202,"_5":13556,"_25987":50141,"_2719":50203},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3226":1254,"_28565":1228,"_19778":50205,"_5":13556,"_25987":50141,"_2719":50206},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3226":1255,"_28565":1228,"_19778":50208,"_5":13556,"_25987":50141,"_2719":50209},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3226":1256,"_28565":1228,"_19778":50211,"_5":13556,"_25987":50145,"_2719":50212},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3226":1257,"_28565":1257,"_5":13914,"_2719":50214,"_28908":50215,"_19778":50217,"_25987":1257},"AWS IoT Core",[46297,47746,48754,48752,50216],"Integrations",[],{"_3226":1258,"_28565":1257,"_19778":50219,"_5":13556,"_25987":1257,"_2719":50220},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3226":1259,"_28565":1257,"_5":28905,"_19778":50222,"_25987":50223,"_2719":50224},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3226":1260,"_28565":1257,"_5":28905,"_19778":50226,"_25987":50227,"_2719":50228},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3226":1261,"_28565":1257,"_5":28905,"_19778":50230,"_25987":50231,"_2719":50232},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3226":1262,"_28565":1257,"_5":28905,"_19778":50234,"_25987":50235,"_2719":50236},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3226":1263,"_28565":1257,"_5":28905,"_19778":50238,"_25987":50239,"_2719":50240},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3226":1264,"_28565":1257,"_5":28905,"_19778":50242,"_25987":50243,"_2719":50244},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3226":1265,"_28565":1257,"_5":28905,"_19778":50246,"_25987":50247,"_2719":50248},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3226":1266,"_28565":1257,"_5":28905,"_19778":50250,"_25987":50251,"_2719":50252},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3226":1267,"_28565":1257,"_5":28905,"_19778":50254,"_25987":50255,"_2719":50256},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3226":1268,"_28565":1257,"_5":28905,"_19778":50258,"_25987":50259,"_2719":50260},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3226":1269,"_28565":1257,"_5":28905,"_19778":50262,"_25987":50263,"_2719":50264},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3226":1270,"_28565":1257,"_5":28905,"_19778":50266,"_25987":50267,"_2719":50268},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3226":1271,"_28565":1257,"_5":28905,"_19778":50270,"_25987":50271,"_2719":50272},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3226":1272,"_28565":1257,"_5":28905,"_19778":50274,"_25987":50275,"_2719":50276},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3226":1273,"_28565":1257,"_5":28905,"_19778":50278,"_25987":50279,"_2719":50280},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3226":1274,"_28565":1257,"_5":28905,"_19778":50282,"_25987":50283,"_2719":50284},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3226":1275,"_28565":1257,"_5":28905,"_19778":50286,"_25987":50287,"_2719":50288},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3226":1276,"_28565":1257,"_5":28905,"_19778":50290,"_25987":50291,"_2719":50292},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3226":1277,"_28565":1257,"_5":28905,"_19778":50294,"_25987":50295,"_2719":50296},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3226":1278,"_28565":1257,"_5":28905,"_19778":50298,"_25987":50299,"_2719":50300},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3226":1279,"_28565":1257,"_19778":50302,"_5":13556,"_25987":1257,"_2719":50303},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3226":1280,"_28565":1257,"_19778":50305,"_5":13556,"_25987":1257,"_2719":50306},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3226":1281,"_28565":1257,"_19778":50308,"_5":13556,"_25987":1257,"_2719":50309},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3226":1282,"_28565":1257,"_19778":50311,"_5":13556,"_25987":50223,"_2719":50312},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3226":1283,"_28565":1257,"_19778":50314,"_5":13556,"_25987":50223,"_2719":50315},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3226":1284,"_28565":1257,"_19778":50317,"_5":13556,"_25987":50223,"_2719":50318},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3226":1285,"_28565":1257,"_19778":50320,"_5":13556,"_25987":50223,"_2719":50321},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3226":1286,"_28565":1257,"_19778":50323,"_5":13556,"_25987":50227,"_2719":50324},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3226":1287,"_28565":1257,"_19778":50326,"_5":13556,"_25987":50231,"_2719":50327},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3226":1288,"_28565":1257,"_19778":50329,"_5":13556,"_25987":50231,"_2719":50330},[],"IAM action",{"_3226":1289,"_28565":1257,"_19778":50332,"_5":13556,"_25987":50231,"_2719":46687},[],{"_3226":1290,"_28565":1257,"_19778":50334,"_5":13556,"_25987":50231,"_2719":50335},[],"`iot:GetRegistrationCode`",{"_3226":1291,"_28565":1257,"_19778":50337,"_5":13556,"_25987":50231,"_2719":50338},[],"Obtain the verification code for CA registration in the Primary Account",{"_3226":1292,"_28565":1257,"_19778":50340,"_5":13556,"_25987":50231,"_2719":50341},[],"`iot:RegisterCACertificate`",{"_3226":1293,"_28565":1257,"_19778":50343,"_5":13556,"_25987":50231,"_2719":50344},[],"Register the CA in AWS IoT",{"_3226":1294,"_28565":1257,"_19778":50346,"_5":13556,"_25987":50231,"_2719":50347},[],"`iot:DescribeCACertificate`",{"_3226":1295,"_28565":1257,"_19778":50349,"_5":13556,"_25987":50231,"_2719":50350},[],"Check the CA registration status",{"_3226":1296,"_28565":1257,"_19778":50352,"_5":13556,"_25987":50231,"_2719":50353},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3226":1297,"_28565":1257,"_19778":50355,"_5":13556,"_25987":50231,"_2719":50356},[],"Create or update Things in IoT Core",{"_3226":1298,"_28565":1257,"_19778":50358,"_5":13556,"_25987":50231,"_2719":50359},[],"`iot:RegisterThing`",{"_3226":1299,"_28565":1257,"_19778":50361,"_5":13556,"_25987":50231,"_2719":50362},[],"Provision Things through a template",{"_3226":1300,"_28565":1257,"_19778":50364,"_5":13556,"_25987":50231,"_2719":50365},[],"`iot:RegisterCertificate`",{"_3226":1301,"_28565":1257,"_19778":50367,"_5":13556,"_25987":50231,"_2719":50368},[],"Register device certificates",{"_3226":1302,"_28565":1257,"_19778":50370,"_5":13556,"_25987":50231,"_2719":50371},[],"`iot:UpdateCertificate`",{"_3226":1303,"_28565":1257,"_19778":50373,"_5":13556,"_25987":50231,"_2719":50374},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3226":1304,"_28565":1257,"_19778":50376,"_5":13556,"_25987":50231,"_2719":50377},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3226":1305,"_28565":1257,"_19778":50379,"_5":13556,"_25987":50231,"_2719":50380},[],"Create and attach IoT policies",{"_3226":1306,"_28565":1257,"_19778":50382,"_5":13556,"_25987":50231,"_2719":50383},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3226":1307,"_28565":1257,"_19778":50385,"_5":13556,"_25987":50231,"_2719":50386},[],"Manage Thing groups",{"_3226":1308,"_28565":1257,"_19778":50388,"_5":13556,"_25987":50231,"_2719":50389},[],"`iot:CreateProvisioningTemplate`",{"_3226":1309,"_28565":1257,"_19778":50391,"_5":13556,"_25987":50231,"_2719":50392},[],"Create JITP templates",{"_3226":1310,"_28565":1257,"_19778":50394,"_5":13556,"_25987":50231,"_2719":50395},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3226":1311,"_28565":1257,"_19778":50397,"_5":13556,"_25987":50231,"_2719":50398},[],"Read and write the Device Shadow",{"_3226":1312,"_28565":1257,"_19778":50400,"_5":13556,"_25987":50231,"_2719":50401},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3226":1313,"_28565":1257,"_19778":50403,"_5":13556,"_25987":50235,"_2719":50404},[],"Parameter",{"_3226":1314,"_28565":1257,"_19778":50406,"_5":13556,"_25987":50235,"_2719":50407},[],"Type",{"_3226":1315,"_28565":1257,"_19778":50409,"_5":13556,"_25987":50235,"_2719":50410},[],"Required",{"_3226":1316,"_28565":1257,"_19778":50412,"_5":13556,"_25987":50235,"_2719":50413},[],"Description",{"_3226":1317,"_28565":1257,"_19778":50415,"_5":13556,"_25987":50235,"_2719":50416},[],"`connector_id`",{"_3226":1318,"_28565":1257,"_19778":50418,"_5":13556,"_25987":50235,"_2719":23638},[],{"_3226":1319,"_28565":1257,"_19778":50420,"_5":13556,"_25987":50235,"_2719":50421},[],"Yes",{"_3226":1320,"_28565":1257,"_19778":50423,"_5":13556,"_25987":50235,"_2719":50424},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3226":1321,"_28565":1257,"_19778":50426,"_5":13556,"_25987":50235,"_2719":50427},[],"`aws_config.region`",{"_3226":1322,"_28565":1257,"_19778":50429,"_5":13556,"_25987":50235,"_2719":23638},[],{"_3226":1323,"_28565":1257,"_19778":50431,"_5":13556,"_25987":50235,"_2719":50421},[],{"_3226":1324,"_28565":1257,"_19778":50433,"_5":13556,"_25987":50235,"_2719":50434},[],"AWS region where the connector operates.",{"_3226":1325,"_28565":1257,"_19778":50436,"_5":13556,"_25987":50235,"_2719":50437},[],"`aws_config.auth_method`",{"_3226":1326,"_28565":1257,"_19778":50439,"_5":13556,"_25987":50235,"_2719":23638},[],{"_3226":1327,"_28565":1257,"_19778":50441,"_5":13556,"_25987":50235,"_2719":50421},[],{"_3226":1328,"_28565":1257,"_19778":50443,"_5":13556,"_25987":50235,"_2719":50444},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3226":1329,"_28565":1257,"_19778":50446,"_5":13556,"_25987":50235,"_2719":50447},[],"`aws_config.access_key_id`",{"_3226":1330,"_28565":1257,"_19778":50449,"_5":13556,"_25987":50235,"_2719":23638},[],{"_3226":1331,"_28565":1257,"_19778":50451,"_5":13556,"_25987":50235,"_2719":50452},[],"Only with `auth_method=static`",{"_3226":1332,"_28565":1257,"_19778":50454,"_5":13556,"_25987":50235,"_2719":50455},[],"AWS access key.",{"_3226":1333,"_28565":1257,"_19778":50457,"_5":13556,"_25987":50235,"_2719":50458},[],"`aws_config.secret_access_key`",{"_3226":1334,"_28565":1257,"_19778":50460,"_5":13556,"_25987":50235,"_2719":23638},[],{"_3226":1335,"_28565":1257,"_19778":50462,"_5":13556,"_25987":50235,"_2719":50452},[],{"_3226":1336,"_28565":1257,"_19778":50464,"_5":13556,"_25987":50235,"_2719":50465},[],"AWS secret key.",{"_3226":1337,"_28565":1257,"_19778":50467,"_5":13556,"_25987":50235,"_2719":50468},[],"`aws_config.session_token`",{"_3226":1338,"_28565":1257,"_19778":50470,"_5":13556,"_25987":50235,"_2719":23638},[],{"_3226":1339,"_28565":1257,"_19778":50472,"_5":13556,"_25987":50235,"_2719":50473},[],"No",{"_3226":1340,"_28565":1257,"_19778":50475,"_5":13556,"_25987":50235,"_2719":50476},[],"Session token (with `auth_method=static`).",{"_3226":1341,"_28565":1257,"_19778":50478,"_5":13556,"_25987":50235,"_2719":50479},[],"`aws_config.role_arn`",{"_3226":1342,"_28565":1257,"_19778":50481,"_5":13556,"_25987":50235,"_2719":23638},[],{"_3226":1343,"_28565":1257,"_19778":50483,"_5":13556,"_25987":50235,"_2719":50484},[],"Only with `auth_method=role`",{"_3226":1344,"_28565":1257,"_19778":50486,"_5":13556,"_25987":50235,"_2719":50487},[],"ARN of the role to assume.",{"_3226":1345,"_28565":1257,"_19778":50489,"_5":13556,"_25987":50235,"_2719":50490},[],"`aws_config.endpoint_url`",{"_3226":1346,"_28565":1257,"_19778":50492,"_5":13556,"_25987":50235,"_2719":23638},[],{"_3226":1347,"_28565":1257,"_19778":50494,"_5":13556,"_25987":50235,"_2719":50473},[],{"_3226":1348,"_28565":1257,"_19778":50496,"_5":13556,"_25987":50235,"_2719":50497},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3226":1349,"_28565":1257,"_19778":50499,"_5":13556,"_25987":50235,"_2719":50500},[],"`subscriber_event_bus`",{"_3226":1350,"_28565":1257,"_19778":50502,"_5":13556,"_25987":50235,"_2719":16648},[],{"_3226":1351,"_28565":1257,"_19778":50504,"_5":13556,"_25987":50235,"_2719":50421},[],{"_3226":1352,"_28565":1257,"_19778":50506,"_5":13556,"_25987":50235,"_2719":50507},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3226":1353,"_28565":1257,"_19778":50509,"_5":13556,"_25987":50235,"_2719":50510},[],"`dms_manager_client`",{"_3226":1354,"_28565":1257,"_19778":50512,"_5":13556,"_25987":50235,"_2719":23638},[],{"_3226":1355,"_28565":1257,"_19778":50514,"_5":13556,"_25987":50235,"_2719":50421},[],{"_3226":1356,"_28565":1257,"_19778":50516,"_5":13556,"_25987":50235,"_2719":50517},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3226":1357,"_28565":1257,"_19778":50519,"_5":13556,"_25987":50235,"_2719":50520},[],"`device_manager_client`",{"_3226":1358,"_28565":1257,"_19778":50522,"_5":13556,"_25987":50235,"_2719":23638},[],{"_3226":1359,"_28565":1257,"_19778":50524,"_5":13556,"_25987":50235,"_2719":50421},[],{"_3226":1360,"_28565":1257,"_19778":50526,"_5":13556,"_25987":50235,"_2719":50527},[],"HTTP URL of Lamassu's Device Manager.",{"_3226":1361,"_28565":1257,"_19778":50529,"_5":13556,"_25987":50235,"_2719":50530},[],"`ca_client`",{"_3226":1362,"_28565":1257,"_19778":50532,"_5":13556,"_25987":50235,"_2719":23638},[],{"_3226":1363,"_28565":1257,"_19778":50534,"_5":13556,"_25987":50235,"_2719":50421},[],{"_3226":1364,"_28565":1257,"_19778":50536,"_5":13556,"_25987":50235,"_2719":50537},[],"HTTP URL of Lamassu's CA service.",{"_3226":1365,"_28565":1257,"_19778":50539,"_5":13556,"_25987":50239,"_2719":50540},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3226":1366,"_28565":1257,"_19778":50542,"_5":13556,"_25987":50243,"_2719":50543},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3226":1367,"_28565":1257,"_19778":50545,"_5":13556,"_25987":50243,"_2719":50546},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3226":1368,"_28565":1257,"_19778":50548,"_5":13556,"_25987":50247,"_2719":50549},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3226":1369,"_28565":1257,"_19778":50551,"_5":13556,"_25987":50247,"_2719":50552},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3226":1370,"_28565":1257,"_19778":50554,"_5":13556,"_25987":50247,"_2719":50555},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3226":1371,"_28565":1257,"_19778":50557,"_5":13556,"_25987":50247,"_2719":50558},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3226":1372,"_28565":1257,"_19778":50560,"_5":13556,"_25987":50247,"_2719":50561},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3226":1373,"_28565":1257,"_19778":50563,"_5":13556,"_25987":50247,"_2719":50564},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3226":1374,"_28565":1257,"_19778":50566,"_5":13556,"_25987":50251,"_2719":50567},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3226":1375,"_28565":1257,"_19778":50569,"_5":13556,"_25987":50255,"_2719":50570},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3226":1376,"_28565":1257,"_19778":50572,"_5":13556,"_25987":50255,"_2719":50573},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3226":1377,"_28565":1257,"_19778":50575,"_5":13556,"_25987":50259,"_2719":50576},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3226":1378,"_28565":1257,"_19778":50578,"_5":13556,"_25987":50263,"_2719":50579},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3226":1379,"_28565":1257,"_19778":50581,"_5":13556,"_25987":50263,"_2719":50582},[],"Creates or updates the IoT policies configured in the DMS.",{"_3226":1380,"_28565":1257,"_19778":50584,"_5":13556,"_25987":50263,"_2719":50585},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3226":1381,"_28565":1257,"_19778":50587,"_5":13556,"_25987":50263,"_2719":50588},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3226":1382,"_28565":1257,"_19778":50590,"_5":13556,"_25987":50263,"_2719":50591},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3226":1383,"_28565":1257,"_19778":50593,"_5":13556,"_25987":50263,"_2719":50594},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3226":1384,"_28565":1257,"_19778":50596,"_5":13556,"_25987":50263,"_2719":50597},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3226":1385,"_28565":1257,"_19778":50599,"_5":13556,"_25987":50267,"_2719":50600},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The template is created when the DMS is created in Lamassu, not at device enrollment, and it is not updated afterwards (see the notice below). From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3226":1386,"_28565":1257,"_19778":50602,"_5":13556,"_25987":50267,"_2719":50603},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3226":1387,"_28565":1257,"_19778":50605,"_5":13556,"_25987":50267,"_2719":50606},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3226":1388,"_28565":1257,"_19778":50608,"_5":13556,"_25987":50267,"_2719":50609},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3226":1389,"_28565":1257,"_19778":50611,"_5":13556,"_25987":50267,"_2719":50612},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3226":1390,"_28565":1257,"_19778":50614,"_5":13556,"_25987":50271,"_2719":50615},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3226":1391,"_28565":1257,"_19778":50617,"_5":13556,"_25987":50271,"_2719":50618},[],"The full flow from the device's perspective is:",{"_3226":1392,"_28565":1257,"_19778":50620,"_5":13556,"_25987":50271,"_2719":50621},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3226":1393,"_28565":1257,"_19778":50623,"_5":13556,"_25987":50275,"_2719":50624},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3226":1394,"_28565":1257,"_19778":50626,"_5":13556,"_25987":50275,"_2719":50627},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3226":1395,"_28565":1257,"_19778":50629,"_5":13556,"_25987":50275,"_2719":50630},[],"For the JITP flow to work correctly:",{"_3226":1396,"_28565":1257,"_19778":50632,"_5":13556,"_25987":50275,"_2719":50633},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3226":1397,"_28565":1257,"_19778":50635,"_5":13556,"_25987":50275,"_2719":50636},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3226":1398,"_28565":1257,"_19778":50638,"_5":13556,"_25987":50275,"_2719":50639},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3226":1399,"_28565":1257,"_19778":50641,"_5":13556,"_25987":50275,"_2719":50642},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3226":1400,"_28565":1257,"_19778":50644,"_5":13556,"_25987":50279,"_2719":50645},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3226":1401,"_28565":1257,"_19778":50647,"_5":13556,"_25987":50279,"_2719":50648},[],"Status in Lamassu",{"_3226":1402,"_28565":1257,"_19778":50650,"_5":13556,"_25987":50279,"_2719":50651},[],"Revocation reason",{"_3226":1403,"_28565":1257,"_19778":50653,"_5":13556,"_25987":50279,"_2719":50654},[],"Status in AWS IoT Core",{"_3226":1404,"_28565":1257,"_19778":50656,"_5":13556,"_25987":50279,"_2719":50657},[],"`Active`",{"_3226":1405,"_28565":1257,"_19778":50659,"_5":13556,"_25987":50279,"_2719":50660},[],"None",{"_3226":1406,"_28565":1257,"_19778":50662,"_5":13556,"_25987":50279,"_2719":50663},[],"`ACTIVE`",{"_3226":1407,"_28565":1257,"_19778":50665,"_5":13556,"_25987":50279,"_2719":50666},[],"`Revoked`",{"_3226":1408,"_28565":1257,"_19778":50668,"_5":13556,"_25987":50279,"_2719":50669},[],"`certificateHold`",{"_3226":1409,"_28565":1257,"_19778":50671,"_5":13556,"_25987":50279,"_2719":50672},[],"`INACTIVE`",{"_3226":1410,"_28565":1257,"_19778":50674,"_5":13556,"_25987":50279,"_2719":50666},[],{"_3226":1411,"_28565":1257,"_19778":50676,"_5":13556,"_25987":50279,"_2719":50677},[],"Any other reason",{"_3226":1412,"_28565":1257,"_19778":50679,"_5":13556,"_25987":50279,"_2719":50680},[],"`REVOKED`",{"_3226":1413,"_28565":1257,"_19778":50682,"_5":13556,"_25987":50279,"_2719":50683},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3226":1414,"_28565":1257,"_19778":50685,"_5":13556,"_25987":50283,"_2719":50686},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3226":1415,"_28565":1257,"_19778":50688,"_5":13556,"_25987":50283,"_2719":50689},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3226":1416,"_28565":1257,"_19778":50691,"_5":13556,"_25987":50283,"_2719":50692},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3226":1417,"_28565":1257,"_19778":50694,"_5":13556,"_25987":50287,"_2719":50695},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3226":1418,"_28565":1257,"_19778":50697,"_5":13556,"_25987":50287,"_2719":50698},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3226":1419,"_28565":1257,"_19778":50700,"_5":13556,"_25987":50291,"_2719":50701},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3226":1420,"_28565":1257,"_19778":50703,"_5":13556,"_25987":50291,"_2719":50704},[],"There are two action types:",{"_3226":1421,"_28565":1257,"_19778":50706,"_5":13556,"_25987":50291,"_2719":50707},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3226":1422,"_28565":1257,"_19778":50709,"_5":13556,"_25987":50291,"_2719":50710},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3226":1423,"_28565":1257,"_19778":50712,"_5":13556,"_25987":50291,"_2719":50713},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3226":1424,"_28565":1257,"_19778":50715,"_5":13556,"_25987":50295,"_2719":50716},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3226":1425,"_28565":1257,"_19778":50718,"_5":13556,"_25987":50295,"_2719":50719},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3226":1426,"_28565":1257,"_19778":50721,"_5":13556,"_25987":50295,"_2719":50722},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3226":1427,"_28565":1257,"_19778":50724,"_5":13556,"_25987":50299,"_2719":50725},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3226":1428,"_28565":1257,"_19778":50727,"_5":13556,"_25987":50299,"_2719":50728},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3226":1429,"_28565":1257,"_19778":50730,"_5":13556,"_25987":50299,"_2719":50731},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3226":1430,"_28565":1257,"_19778":50733,"_5":13556,"_25987":50299,"_2719":50734},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3226":1431,"_28565":1257,"_19778":50736,"_5":13556,"_25987":50299,"_2719":50737},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3226":1432,"_28565":1257,"_19778":50739,"_5":13556,"_25987":50299,"_2719":50740},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3226":1433,"_28565":1257,"_19778":50742,"_5":13556,"_25987":50299,"_2719":50743},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3226":1434,"_28565":1257,"_19778":50745,"_5":13556,"_25987":50299,"_2719":50746},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3226":1435,"_28565":1257,"_19778":50748,"_5":13556,"_25987":50299,"_2719":50749},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3226":1436,"_28565":1257,"_19778":50751,"_5":13556,"_25987":50299,"_2719":50752},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3226":1437,"_28565":1257,"_19778":50754,"_5":13556,"_25987":50299,"_2719":50755},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3226":1438,"_28565":1257,"_19778":50757,"_5":13556,"_25987":50299,"_2719":50758},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3226":1439,"_28565":1257,"_19778":50760,"_5":13556,"_25987":50299,"_2719":50761},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3226":1440,"_28565":1257,"_19778":50763,"_5":13556,"_25987":50299,"_2719":50764},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3226":1441,"_28565":1257,"_19778":50766,"_5":13556,"_25987":50299,"_2719":50767},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3226":1442,"_28565":1257,"_19778":50769,"_5":13556,"_25987":50299,"_2719":50770},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3226":1443,"_28565":1257,"_19778":50772,"_5":13556,"_25987":50299,"_2719":50773},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3226":1444,"_28565":1257,"_19778":50775,"_5":13556,"_25987":50299,"_2719":50776},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3226":1445,"_28565":1257,"_19778":50778,"_5":13556,"_25987":50299,"_2719":50779},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3226":1446,"_28565":1257,"_19778":50781,"_5":13556,"_25987":50299,"_2719":50782},[],"**Cause:** The edit triggers a new attempt to create the JITP template, which already exists in AWS. The attempt fails and the connector's later steps are skipped.\n&#x2A;*Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3226":1447,"_28565":1257,"_19778":50784,"_5":13556,"_25987":50299,"_2719":50785},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3226":1448,"_28565":1257,"_19778":50787,"_5":13556,"_25987":50299,"_2719":50788},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3226":1449,"_28565":1257,"_19778":50790,"_5":13556,"_25987":50299,"_2719":50791},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3226":1450,"_28565":1450,"_5":13914,"_2719":48754,"_28908":50793,"_19778":50794,"_25987":1450},[46297,47746,48754],[],{"_3226":1451,"_28565":1450,"_19778":50796,"_5":13556,"_25987":1450,"_2719":50797},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3226":1452,"_28565":1450,"_5":28905,"_19778":50799,"_25987":50800,"_2719":50801},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#start-here","Start here",{"_3226":1453,"_28565":1450,"_5":28905,"_19778":50803,"_25987":50804,"_2719":48752},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#devices-and-identities",{"_3226":1454,"_28565":1450,"_5":28905,"_19778":50806,"_25987":50807,"_2719":48935},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#enrollment-with-pki",{"_3226":1455,"_28565":1450,"_5":28905,"_19778":50809,"_25987":50810,"_2719":50216},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#integrations",{"_3226":1456,"_28565":1450,"_5":28905,"_19778":50812,"_25987":50813,"_2719":50814},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3226":1457,"_28565":1450,"_19778":50816,"_5":13556,"_25987":1450,"_2719":50817},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3226":1458,"_28565":1450,"_19778":50819,"_5":13556,"_25987":50800,"_2719":50820},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3226":1459,"_28565":1450,"_19778":50822,"_5":13556,"_25987":50800,"_2719":50823},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3226":1460,"_28565":1450,"_19778":50825,"_5":13556,"_25987":50804,"_2719":50826},[],"Resource",{"_3226":1461,"_28565":1450,"_19778":50828,"_5":13556,"_25987":50804,"_2719":50829},[],"What it represents",{"_3226":1462,"_28565":1450,"_19778":50831,"_5":13556,"_25987":50804,"_2719":50832},[],"**Device**",{"_3226":1463,"_28565":1450,"_19778":50834,"_5":13556,"_25987":50804,"_2719":50835},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3226":1464,"_28565":1450,"_19778":50837,"_5":13556,"_25987":50804,"_2719":50838},[],"**Identity**",{"_3226":1465,"_28565":1450,"_19778":50840,"_5":13556,"_25987":50804,"_2719":50841},[],"The device's association with its certificates: an active version and a history.",{"_3226":1466,"_28565":1450,"_19778":50843,"_5":13556,"_25987":50804,"_2719":50844},[],"**DMS**",{"_3226":1467,"_28565":1450,"_19778":50846,"_5":13556,"_25987":50804,"_2719":50847},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3226":1468,"_28565":1450,"_19778":50849,"_5":13556,"_25987":50804,"_2719":50850},[],"**Fleet**",{"_3226":1469,"_28565":1450,"_19778":50852,"_5":13556,"_25987":50804,"_2719":50853},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3226":1470,"_28565":1450,"_19778":50855,"_5":13556,"_25987":50804,"_2719":50856},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3226":1471,"_28565":1450,"_19778":50858,"_5":13556,"_25987":50804,"_2719":50859},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3226":1472,"_28565":1450,"_19778":50861,"_5":13556,"_25987":50807,"_2719":50862},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3226":1473,"_28565":1450,"_19778":50864,"_5":13556,"_25987":50807,"_2719":50865},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3226":1474,"_28565":1450,"_19778":50867,"_5":13556,"_25987":50807,"_2719":50868},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3226":1475,"_28565":1450,"_19778":50870,"_5":13556,"_25987":50807,"_2719":50871},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3226":1476,"_28565":1450,"_19778":50873,"_5":13556,"_25987":50807,"_2719":50874},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3226":1477,"_28565":1450,"_19778":50876,"_5":13556,"_25987":50807,"_2719":50877},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3226":1478,"_28565":1450,"_19778":50879,"_5":13556,"_25987":50807,"_2719":50880},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3226":1479,"_28565":1450,"_19778":50882,"_5":13556,"_25987":50807,"_2719":50883},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3226":1480,"_28565":1450,"_19778":50885,"_5":13556,"_25987":50810,"_2719":50886},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3226":1481,"_28565":1450,"_19778":50888,"_5":13556,"_25987":50810,"_2719":50889},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3226":1482,"_28565":1450,"_19778":50891,"_5":13556,"_25987":50813,"_2719":50892},[],"Participant",{"_3226":1483,"_28565":1450,"_19778":50894,"_5":13556,"_25987":50813,"_2719":50895},[],"Responsibility",{"_3226":1484,"_28565":1450,"_19778":50897,"_5":13556,"_25987":50813,"_2719":50898},[],"PKI administrator",{"_3226":1485,"_28565":1450,"_19778":50900,"_5":13556,"_25987":50813,"_2719":50901},[],"CA, issuance profile, chain and revocation publication.",{"_3226":1486,"_28565":1450,"_19778":50903,"_5":13556,"_25987":50813,"_2719":50904},[],"Provisioning administrator",{"_3226":1487,"_28565":1450,"_19778":50906,"_5":13556,"_25987":50813,"_2719":50907},[],"DMS, admission, authentication per operation and inventory.",{"_3226":1488,"_28565":1450,"_19778":50909,"_5":13556,"_25987":50813,"_2719":50910},[],"Device integrator",{"_3226":1489,"_28565":1450,"_19778":50912,"_5":13556,"_25987":50813,"_2719":50913},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3226":1490,"_28565":1450,"_19778":50915,"_5":13556,"_25987":50813,"_2719":50916},[],"Consumer integrator",{"_3226":1491,"_28565":1450,"_19778":50918,"_5":13556,"_25987":50813,"_2719":50919},[],"Trusted issuers, validation and device permissions in the destination.",{"_3226":1492,"_28565":1450,"_19778":50921,"_5":13556,"_25987":50813,"_2719":50922},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3226":1493,"_28565":1493,"_5":13914,"_2719":50924,"_28908":50925,"_19778":50927,"_25987":1493},"Enroll and connect your first device",[46297,47746,48754,50926],"Getting started",[],{"_3226":1494,"_28565":1493,"_19778":50929,"_5":13556,"_25987":1493,"_2719":50930},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3226":1495,"_28565":1493,"_5":28905,"_19778":50932,"_25987":50933,"_2719":46307},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3226":1496,"_28565":1493,"_5":28905,"_19778":50935,"_25987":50936,"_2719":50937},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3226":1497,"_28565":1493,"_5":28905,"_19778":50939,"_25987":50940,"_2719":50941},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3226":1498,"_28565":1493,"_5":28905,"_19778":50943,"_25987":50944,"_2719":50945},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3226":1499,"_28565":1493,"_5":28905,"_19778":50947,"_25987":50948,"_2719":50949},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3226":1500,"_28565":1493,"_5":28905,"_19778":50951,"_25987":50952,"_2719":50953},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3226":1501,"_28565":1493,"_5":28905,"_19778":50955,"_25987":50956,"_2719":50957},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3226":1502,"_28565":1493,"_5":28905,"_19778":50959,"_25987":50960,"_2719":50961},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3226":1503,"_28565":1493,"_19778":50963,"_5":13556,"_25987":1493,"_2719":50964},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3226":1504,"_28565":1493,"_19778":50966,"_5":13556,"_25987":50933,"_2719":50967},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3226":1505,"_28565":1493,"_19778":50969,"_5":13556,"_25987":50933,"_2719":50970},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3226":1506,"_28565":1493,"_19778":50972,"_5":13556,"_25987":50933,"_2719":50973},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3226":1507,"_28565":1493,"_19778":50975,"_5":13556,"_25987":50933,"_2719":50976},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3226":1508,"_28565":1493,"_19778":50978,"_5":13556,"_25987":50933,"_2719":50979},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3226":1509,"_28565":1493,"_19778":50981,"_5":13556,"_25987":50936,"_2719":50982},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3226":1510,"_28565":1493,"_19778":50984,"_5":13556,"_25987":50936,"_2719":50985},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3226":1511,"_28565":1493,"_19778":50987,"_5":13556,"_25987":50940,"_2719":50988},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3226":1512,"_28565":1493,"_19778":50990,"_5":13556,"_25987":50940,"_2719":50991},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3226":1513,"_28565":1493,"_19778":50993,"_5":13556,"_25987":50940,"_2719":50994},[],"Setting",{"_3226":1514,"_28565":1493,"_19778":50996,"_5":13556,"_25987":50940,"_2719":50997},[],"Evaluation value",{"_3226":1515,"_28565":1493,"_19778":50999,"_5":13556,"_25987":50940,"_2719":51000},[],"Enrollment CA",{"_3226":1516,"_28565":1493,"_19778":51002,"_5":13556,"_25987":50940,"_2719":51003},[],"Issuing root from `device-root.pem`.",{"_3226":1517,"_28565":1493,"_19778":51005,"_5":13556,"_25987":50940,"_2719":49065},[],{"_3226":1518,"_28565":1493,"_19778":51007,"_5":13556,"_25987":50940,"_2719":51008},[],"The 1-hour leaf profile you just prepared.",{"_3226":1519,"_28565":1493,"_19778":51010,"_5":13556,"_25987":50940,"_2719":51011},[],"Protocol / Registration Mode",{"_3226":1520,"_28565":1493,"_19778":51013,"_5":13556,"_25987":50940,"_2719":51014},[],"`EST_RFC7030` / `JITP`.",{"_3226":1521,"_28565":1493,"_19778":51016,"_5":13556,"_25987":50940,"_2719":51017},[],"Verify CSR Signature",{"_3226":1522,"_28565":1493,"_19778":51019,"_5":13556,"_25987":50940,"_2719":51020},[],"Enabled.",{"_3226":1523,"_28565":1493,"_19778":51022,"_5":13556,"_25987":50940,"_2719":51023},[],"Enable Replaceable Enrollment",{"_3226":1524,"_28565":1493,"_19778":51025,"_5":13556,"_25987":50940,"_2719":51026},[],"Disabled; the ID must be new.",{"_3226":1525,"_28565":1493,"_19778":51028,"_5":13556,"_25987":50940,"_2719":51029},[],"Initial authentication",{"_3226":1526,"_28565":1493,"_19778":51031,"_5":13556,"_25987":50940,"_2719":51032},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3226":1527,"_28565":1493,"_19778":51034,"_5":13556,"_25987":50940,"_2719":51035},[],"Renewal authentication",{"_3226":1528,"_28565":1493,"_19778":51037,"_5":13556,"_25987":50940,"_2719":51038},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3226":1529,"_28565":1493,"_19778":51040,"_5":13556,"_25987":50940,"_2719":51041},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3226":1530,"_28565":1493,"_19778":51043,"_5":13556,"_25987":50940,"_2719":51044},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3226":1531,"_28565":1493,"_19778":51046,"_5":13556,"_25987":50940,"_2719":51047},[],"Re-enrollment Delta",{"_3226":1532,"_28565":1493,"_19778":51049,"_5":13556,"_25987":50940,"_2719":51050},[],"1 hour.",{"_3226":1533,"_28565":1493,"_19778":51052,"_5":13556,"_25987":50940,"_2719":51053},[],"Preventive / Critical Delta",{"_3226":1534,"_28565":1493,"_19778":51055,"_5":13556,"_25987":50940,"_2719":51056},[],"30 minutes / 10 minutes.",{"_3226":1535,"_28565":1493,"_19778":51058,"_5":13556,"_25987":50940,"_2719":51059},[],"Revoke on Re-enrollment",{"_3226":1536,"_28565":1493,"_19778":51061,"_5":13556,"_25987":50940,"_2719":51062},[],"Disabled to test the successor before retiring the previous identity.",{"_3226":1537,"_28565":1493,"_19778":51064,"_5":13556,"_25987":50940,"_2719":49073},[],{"_3226":1538,"_28565":1493,"_19778":51066,"_5":13556,"_25987":50940,"_2719":51067},[],"Disabled; the operational key is generated in the client.",{"_3226":1539,"_28565":1493,"_19778":51069,"_5":13556,"_25987":50940,"_2719":51070},[],"CA Distribution",{"_3226":1540,"_28565":1493,"_19778":51072,"_5":13556,"_25987":50940,"_2719":51073},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3226":1541,"_28565":1493,"_19778":51075,"_5":13556,"_25987":50940,"_2719":51076},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3226":1542,"_28565":1493,"_19778":51078,"_5":13556,"_25987":50944,"_2719":51079},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3226":1543,"_28565":1493,"_19778":51081,"_5":13556,"_25987":50944,"_2719":51082},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3226":1544,"_28565":1493,"_19778":51084,"_5":13556,"_25987":50948,"_2719":51085},[],"Generate a new key and CSR with the selected identifier:",{"_3226":1545,"_28565":1493,"_19778":51087,"_5":13556,"_25987":50948,"_2719":51088},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3226":1546,"_28565":1493,"_19778":51090,"_5":13556,"_25987":50948,"_2719":51091},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3226":1547,"_28565":1493,"_19778":51093,"_5":13556,"_25987":50952,"_2719":51094},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3226":1548,"_28565":1493,"_19778":51096,"_5":13556,"_25987":50952,"_2719":51097},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3226":1549,"_28565":1493,"_19778":51099,"_5":13556,"_25987":50956,"_2719":51100},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3226":1550,"_28565":1493,"_19778":51102,"_5":13556,"_25987":50956,"_2719":51103},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3226":1551,"_28565":1493,"_19778":51105,"_5":13556,"_25987":50956,"_2719":51106},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3226":1552,"_28565":1493,"_19778":51108,"_5":13556,"_25987":50956,"_2719":51109},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3226":1553,"_28565":1493,"_19778":51111,"_5":13556,"_25987":50956,"_2719":51112},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3226":1554,"_28565":1493,"_19778":51114,"_5":13556,"_25987":50960,"_2719":51115},[],"Check",{"_3226":1555,"_28565":1493,"_19778":51117,"_5":13556,"_25987":50960,"_2719":51118},[],"Expected result",{"_3226":1556,"_28565":1493,"_19778":51120,"_5":13556,"_25987":50960,"_2719":51121},[],"Registration",{"_3226":1557,"_28565":1493,"_19778":51123,"_5":13556,"_25987":50960,"_2719":51124},[],"ID created automatically and correct DMS.",{"_3226":1558,"_28565":1493,"_19778":51126,"_5":13556,"_25987":50960,"_2719":51127},[],"Certificate",{"_3226":1559,"_28565":1493,"_19778":51129,"_5":13556,"_25987":50960,"_2719":51130},[],"CN, profile, serial and key verified.",{"_3226":1560,"_28565":1493,"_19778":51132,"_5":13556,"_25987":50960,"_2719":51133},[],"Inventory",{"_3226":1561,"_28565":1493,"_19778":51135,"_5":13556,"_25987":50960,"_2719":51136},[],"Received serial visible as the current identity and in history.",{"_3226":1562,"_28565":1493,"_19778":51138,"_5":13556,"_25987":50960,"_2719":51139},[],"Consumer",{"_3226":1563,"_28565":1493,"_19778":51141,"_5":13556,"_25987":50960,"_2719":51142},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3226":1564,"_28565":1493,"_19778":51144,"_5":13556,"_25987":50960,"_2719":51145},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3226":1565,"_28565":1493,"_19778":51147,"_5":13556,"_25987":50960,"_2719":51148},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3226":1566,"_28565":1566,"_5":13914,"_2719":48770,"_28908":51150,"_19778":51151,"_25987":1566},[46297,47746,48754,50926],[],{"_3226":1567,"_28565":1566,"_19778":51153,"_5":13556,"_25987":1566,"_2719":51154},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3226":1568,"_28565":1566,"_5":28905,"_19778":51156,"_25987":51157,"_2719":46307},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3226":1569,"_28565":1566,"_5":28905,"_19778":51159,"_25987":51160,"_2719":51161},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3226":1570,"_28565":1566,"_5":28905,"_19778":51163,"_25987":51164,"_2719":51165},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3226":1571,"_28565":1566,"_5":28905,"_19778":51167,"_25987":51168,"_2719":51169},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3226":1572,"_28565":1566,"_5":28905,"_19778":51171,"_25987":51172,"_2719":51173},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3226":1573,"_28565":1566,"_5":28905,"_19778":51175,"_25987":51176,"_2719":51177},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3226":1574,"_28565":1566,"_5":28905,"_19778":51179,"_25987":51180,"_2719":51118},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3226":1575,"_28565":1566,"_5":28905,"_19778":51182,"_25987":51183,"_2719":51184},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3226":1576,"_28565":1566,"_5":28905,"_19778":51186,"_25987":51187,"_2719":51188},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3226":1577,"_28565":1566,"_19778":51190,"_5":13556,"_25987":1566,"_2719":51191},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3226":1578,"_28565":1566,"_19778":51193,"_5":13556,"_25987":1566,"_2719":51194},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3226":1579,"_28565":1566,"_19778":51196,"_5":13556,"_25987":51157,"_2719":51197},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3226":1580,"_28565":1566,"_19778":51199,"_5":13556,"_25987":51157,"_2719":51200},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3226":1581,"_28565":1566,"_19778":51202,"_5":13556,"_25987":51157,"_2719":51203},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3226":1582,"_28565":1566,"_19778":51205,"_5":13556,"_25987":51157,"_2719":51206},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3226":1583,"_28565":1566,"_19778":51208,"_5":13556,"_25987":51160,"_2719":51209},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3226":1584,"_28565":1566,"_19778":51211,"_5":13556,"_25987":51160,"_2719":51212},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3226":1585,"_28565":1566,"_19778":51214,"_5":13556,"_25987":51160,"_2719":51215},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3226":1586,"_28565":1566,"_19778":51217,"_5":13556,"_25987":51160,"_2719":51218},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3226":1587,"_28565":1566,"_19778":51220,"_5":13556,"_25987":51160,"_2719":51221},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3226":1588,"_28565":1566,"_19778":51223,"_5":13556,"_25987":51160,"_2719":51224},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3226":1589,"_28565":1566,"_19778":51226,"_5":13556,"_25987":51160,"_2719":51227},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3226":1590,"_28565":1566,"_19778":51229,"_5":13556,"_25987":51160,"_2719":51230},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3226":1591,"_28565":1566,"_19778":51232,"_5":13556,"_25987":51164,"_2719":51233},[],"Open **Managed Devices** and the registration action. Complete:",{"_3226":1592,"_28565":1566,"_19778":51235,"_5":13556,"_25987":51164,"_2719":51236},[],"**Device ID**: `device-001`.",{"_3226":1593,"_28565":1566,"_19778":51238,"_5":13556,"_25987":51164,"_2719":51239},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3226":1594,"_28565":1566,"_19778":51241,"_5":13556,"_25987":51164,"_2719":51242},[],"**Icon** and **Tags**: optional classification.",{"_3226":1595,"_28565":1566,"_19778":51244,"_5":13556,"_25987":51164,"_2719":51245},[],"Confirm registration.",{"_3226":1596,"_28565":1566,"_19778":51247,"_5":13556,"_25987":51168,"_2719":51248},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3226":1597,"_28565":1566,"_19778":51250,"_5":13556,"_25987":51168,"_2719":51251},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3226":1598,"_28565":1566,"_19778":51253,"_5":13556,"_25987":51172,"_2719":51254},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3226":1599,"_28565":1566,"_19778":51256,"_5":13556,"_25987":51172,"_2719":51257},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3226":1600,"_28565":1566,"_19778":51259,"_5":13556,"_25987":51176,"_2719":51260},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3226":1601,"_28565":1566,"_19778":51262,"_5":13556,"_25987":51176,"_2719":51263},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3226":1602,"_28565":1566,"_19778":51265,"_5":13556,"_25987":51180,"_2719":51115},[],{"_3226":1603,"_28565":1566,"_19778":51267,"_5":13556,"_25987":51180,"_2719":51268},[],"Result",{"_3226":1604,"_28565":1566,"_19778":51270,"_5":13556,"_25987":51180,"_2719":51271},[],"Device",{"_3226":1605,"_28565":1566,"_19778":51273,"_5":13556,"_25987":51180,"_2719":51274},[],"`device-001` appears in inventory with the expected DMS.",{"_3226":1606,"_28565":1566,"_19778":51276,"_5":13556,"_25987":51180,"_2719":51277},[],"Current identity",{"_3226":1607,"_28565":1566,"_19778":51279,"_5":13556,"_25987":51180,"_2719":51280},[],"The associated certificate matches the one you verified in PKI.",{"_3226":1608,"_28565":1566,"_19778":51282,"_5":13556,"_25987":51180,"_2719":51283},[],"History",{"_3226":1609,"_28565":1566,"_19778":51285,"_5":13556,"_25987":51180,"_2719":51286},[],"The associated issuance appears with its serial number and dates.",{"_3226":1610,"_28565":1566,"_19778":51288,"_5":13556,"_25987":51180,"_2719":51289},[],"Key and certificate",{"_3226":1611,"_28565":1566,"_19778":51291,"_5":13556,"_25987":51180,"_2719":51292},[],"You have the verified pair ready to install on the device.",{"_3226":1612,"_28565":1566,"_19778":51294,"_5":13556,"_25987":51183,"_2719":51295},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3226":1613,"_28565":1566,"_19778":51297,"_5":13556,"_25987":51183,"_2719":51298},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3226":1614,"_28565":1566,"_19778":51300,"_5":13556,"_25987":51183,"_2719":51301},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3226":1615,"_28565":1566,"_19778":51303,"_5":13556,"_25987":51183,"_2719":51304},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3226":1616,"_28565":1566,"_19778":51306,"_5":13556,"_25987":51187,"_2719":51307},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3226":1617,"_28565":1566,"_19778":51309,"_5":13556,"_25987":51187,"_2719":51310},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3226":1618,"_28565":1566,"_19778":51312,"_5":13556,"_25987":51187,"_2719":51313},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3226":1619,"_28565":1619,"_5":13914,"_2719":51315,"_28908":51316,"_19778":51317,"_25987":1619},"Lamassu IoT Platform",[46297,47746],[],{"_3226":1620,"_28565":1619,"_19778":51319,"_5":13556,"_25987":1619,"_2719":51320},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3226":1621,"_28565":1619,"_5":28905,"_19778":51322,"_25987":51323,"_2719":50801},[],"/docs/pr-preview/pr-42/platform/overview#start-here",{"_3226":1622,"_28565":1619,"_5":28905,"_19778":51325,"_25987":51326,"_2719":51327},[],"/docs/pr-preview/pr-42/platform/overview#choose-your-path","Choose your path",{"_3226":1623,"_28565":1619,"_5":28905,"_19778":51329,"_25987":51330,"_2719":51331},[],"/docs/pr-preview/pr-42/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3226":1624,"_28565":1619,"_5":28905,"_19778":51333,"_25987":51334,"_2719":51335},[],"/docs/pr-preview/pr-42/platform/overview#core-capabilities","Core capabilities",{"_3226":1625,"_28565":1619,"_5":28905,"_19778":51337,"_25987":51338,"_2719":51339},[],"/docs/pr-preview/pr-42/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3226":1626,"_28565":1619,"_5":28905,"_19778":51341,"_25987":51342,"_2719":51343},[],"/docs/pr-preview/pr-42/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3226":1627,"_28565":1619,"_5":28905,"_19778":51345,"_25987":51346,"_2719":51347},[],"/docs/pr-preview/pr-42/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3226":1628,"_28565":1619,"_5":28905,"_19778":51349,"_25987":51350,"_2719":51351},[],"/docs/pr-preview/pr-42/platform/overview#automate-device-identities","Automate device identities",{"_3226":1629,"_28565":1619,"_5":28905,"_19778":51353,"_25987":51354,"_2719":51355},[],"/docs/pr-preview/pr-42/platform/overview#publish-validation-status","Publish validation status",{"_3226":1630,"_28565":1619,"_5":28905,"_19778":51357,"_25987":51358,"_2719":51359},[],"/docs/pr-preview/pr-42/platform/overview#react-to-events","React to events",{"_3226":1631,"_28565":1619,"_5":28905,"_19778":51361,"_25987":51362,"_2719":51363},[],"/docs/pr-preview/pr-42/platform/overview#operational-reference","Operational reference",{"_3226":1632,"_28565":1619,"_19778":51365,"_5":13556,"_25987":1619,"_2719":51366},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3226":1633,"_28565":1619,"_19778":51368,"_5":13556,"_25987":51323,"_2719":51369},[],"Choose the result you need:",{"_3226":1634,"_28565":1619,"_19778":51371,"_5":13556,"_25987":51323,"_2719":51372},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3226":1635,"_28565":1619,"_19778":51374,"_5":13556,"_25987":51323,"_2719":51375},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3226":1636,"_28565":1619,"_19778":51377,"_5":13556,"_25987":51323,"_2719":51378},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3226":1637,"_28565":1619,"_19778":51380,"_5":13556,"_25987":51326,"_2719":51381},[],"Section",{"_3226":1638,"_28565":1619,"_19778":51383,"_5":13556,"_25987":51326,"_2719":51384},[],"What you manage",{"_3226":1639,"_28565":1619,"_19778":51386,"_5":13556,"_25987":51326,"_2719":51387},[],"Entry point",{"_3226":1640,"_28565":1619,"_19778":51389,"_5":13556,"_25987":51326,"_2719":51390},[],"**PKI**",{"_3226":1641,"_28565":1619,"_19778":51392,"_5":13556,"_25987":51326,"_2719":51393},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3226":1642,"_28565":1619,"_19778":51395,"_5":13556,"_25987":51326,"_2719":51396},[],"PKI overview",{"_3226":1643,"_28565":1619,"_19778":51398,"_5":13556,"_25987":51326,"_2719":51399},[],"**IoT Fleets**",{"_3226":1644,"_28565":1619,"_19778":51401,"_5":13556,"_25987":51326,"_2719":51402},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3226":1645,"_28565":1619,"_19778":51404,"_5":13556,"_25987":51326,"_2719":51405},[],"IoT Fleets overview",{"_3226":1646,"_28565":1619,"_19778":51407,"_5":13556,"_25987":51326,"_2719":51408},[],"**Administration**",{"_3226":1647,"_28565":1619,"_19778":51410,"_5":13556,"_25987":51326,"_2719":51411},[],"Operator permissions, audit and event subscriptions.",{"_3226":1648,"_28565":1619,"_19778":51413,"_5":13556,"_25987":51326,"_2719":47744},[],{"_3226":1649,"_28565":1619,"_19778":51415,"_5":13556,"_25987":51326,"_2719":51416},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3226":1650,"_28565":1619,"_19778":51418,"_5":13556,"_25987":51330,"_2719":51419},[],"An identity's journey connects four responsibilities:",{"_3226":1651,"_28565":1619,"_19778":51421,"_5":13556,"_25987":51330,"_2719":51422},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3226":1652,"_28565":1619,"_19778":51424,"_5":13556,"_25987":51330,"_2719":51425},[],"The provisioning administrator configures the DMS and initial trust.",{"_3226":1653,"_28565":1619,"_19778":51427,"_5":13556,"_25987":51330,"_2719":51428},[],"The device client requests a certificate and installs it with the matching key.",{"_3226":1654,"_28565":1619,"_19778":51430,"_5":13556,"_25987":51330,"_2719":51431},[],"The consumer validates the identity and applies its access permissions.",{"_3226":1655,"_28565":1619,"_19778":51433,"_5":13556,"_25987":51330,"_2719":51434},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3226":1656,"_28565":1619,"_19778":51436,"_5":13556,"_25987":51338,"_2719":51437},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3226":1657,"_28565":1619,"_19778":51439,"_5":13556,"_25987":51342,"_2719":51440},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3226":1658,"_28565":1619,"_19778":51442,"_5":13556,"_25987":51346,"_2719":51443},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3226":1659,"_28565":1619,"_19778":51445,"_5":13556,"_25987":51350,"_2719":51446},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3226":1660,"_28565":1619,"_19778":51448,"_5":13556,"_25987":51354,"_2719":51449},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3226":1661,"_28565":1619,"_19778":51451,"_5":13556,"_25987":51358,"_2719":51452},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3226":1662,"_28565":1619,"_19778":51454,"_5":13556,"_25987":51362,"_2719":50895},[],{"_3226":1663,"_28565":1619,"_19778":51456,"_5":13556,"_25987":51362,"_2719":51457},[],"What it prepares or checks",{"_3226":1664,"_28565":1619,"_19778":51459,"_5":13556,"_25987":51362,"_2719":50898},[],{"_3226":1665,"_28565":1619,"_19778":51461,"_5":13556,"_25987":51362,"_2719":51462},[],"Key custody, CA hierarchy, profiles and validation.",{"_3226":1666,"_28565":1619,"_19778":51464,"_5":13556,"_25987":51362,"_2719":51465},[],"Fleet administrator",{"_3226":1667,"_28565":1619,"_19778":51467,"_5":13556,"_25987":51362,"_2719":51468},[],"DMS, device admission, renewal policy and inventory.",{"_3226":1668,"_28565":1619,"_19778":51470,"_5":13556,"_25987":51362,"_2719":50910},[],{"_3226":1669,"_28565":1619,"_19778":51472,"_5":13556,"_25987":51362,"_2719":51473},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3226":1670,"_28565":1619,"_19778":51475,"_5":13556,"_25987":51362,"_2719":50916},[],{"_3226":1671,"_28565":1619,"_19778":51477,"_5":13556,"_25987":51362,"_2719":51478},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3226":1672,"_28565":1619,"_19778":51480,"_5":13556,"_25987":51362,"_2719":51481},[],"Infrastructure operator",{"_3226":1673,"_28565":1619,"_19778":51483,"_5":13556,"_25987":51362,"_2719":51484},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3226":1674,"_28565":1619,"_19778":51486,"_5":13556,"_25987":51362,"_2719":51487},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3226":1675,"_28565":1675,"_5":13914,"_2719":51489,"_28908":51490,"_19778":51493,"_25987":1675},"CA hierarchy and rotation",[46297,47746,51491,51492],"PKI","Keys, authorities and certificates",[],{"_3226":1676,"_28565":1675,"_19778":51495,"_5":13556,"_25987":1675,"_2719":51496},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3226":1677,"_28565":1675,"_5":28905,"_19778":51498,"_25987":51499,"_2719":51500},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3226":1678,"_28565":1675,"_5":28905,"_19778":51502,"_25987":51503,"_2719":51504},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3226":1679,"_28565":1675,"_5":28905,"_19778":51506,"_25987":51507,"_2719":51508},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3226":1680,"_28565":1675,"_5":28905,"_19778":51510,"_25987":51511,"_2719":51512},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3226":1681,"_28565":1675,"_5":28905,"_19778":51514,"_25987":51515,"_2719":51516},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3226":1682,"_28565":1675,"_5":28905,"_19778":51518,"_25987":51519,"_2719":51520},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3226":1683,"_28565":1675,"_5":28905,"_19778":51522,"_25987":51523,"_2719":51524},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3226":1684,"_28565":1675,"_5":28905,"_19778":51526,"_25987":51527,"_2719":51528},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3226":1685,"_28565":1675,"_5":28905,"_19778":51530,"_25987":51531,"_2719":51532},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3226":1686,"_28565":1675,"_5":28905,"_19778":51534,"_25987":51535,"_2719":51536},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3226":1687,"_28565":1675,"_5":28905,"_19778":51538,"_25987":51539,"_2719":51540},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3226":1688,"_28565":1675,"_5":28905,"_19778":51542,"_25987":51543,"_2719":51544},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3226":1689,"_28565":1675,"_19778":51546,"_5":13556,"_25987":1675,"_2719":51547},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3226":1690,"_28565":1675,"_19778":51549,"_5":13556,"_25987":1675,"_2719":51550},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3226":1691,"_28565":1675,"_19778":51552,"_5":13556,"_25987":51499,"_2719":51553},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3226":1692,"_28565":1675,"_19778":51555,"_5":13556,"_25987":51499,"_2719":51556},[],"environment, such as production and preproduction;",{"_3226":1693,"_28565":1675,"_19778":51558,"_5":13556,"_25987":51499,"_2719":51559},[],"owner or operating team;",{"_3226":1694,"_28565":1675,"_19778":51561,"_5":13556,"_25987":51499,"_2719":51562},[],"device family or manufacturing process;",{"_3226":1695,"_28565":1675,"_19778":51564,"_5":13556,"_25987":51499,"_2719":51565},[],"region or regulatory requirement;",{"_3226":1696,"_28565":1675,"_19778":51567,"_5":13556,"_25987":51499,"_2719":51568},[],"cryptographic engine or key policy;",{"_3226":1697,"_28565":1675,"_19778":51570,"_5":13556,"_25987":51499,"_2719":51571},[],"maintenance window and renewal cadence.",{"_3226":1698,"_28565":1675,"_19778":51573,"_5":13556,"_25987":51499,"_2719":51574},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3226":1699,"_28565":1675,"_19778":51576,"_5":13556,"_25987":51499,"_2719":51577},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3226":1700,"_28565":1675,"_19778":51579,"_5":13556,"_25987":51503,"_2719":51580},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3226":1701,"_28565":1675,"_19778":51582,"_5":13556,"_25987":51503,"_2719":51583},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3226":1702,"_28565":1675,"_19778":51585,"_5":13556,"_25987":51503,"_2719":51586},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3226":1703,"_28565":1675,"_19778":51588,"_5":13556,"_25987":51507,"_2719":51589},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3226":1704,"_28565":1675,"_19778":51591,"_5":13556,"_25987":51507,"_2719":51592},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3226":1705,"_28565":1675,"_19778":51594,"_5":13556,"_25987":51507,"_2719":51595},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3226":1706,"_28565":1675,"_19778":51597,"_5":13556,"_25987":51507,"_2719":51598},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3226":1707,"_28565":1675,"_19778":51600,"_5":13556,"_25987":51515,"_2719":51601},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3226":1708,"_28565":1675,"_19778":51603,"_5":13556,"_25987":51519,"_2719":51604},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3226":1709,"_28565":1675,"_19778":51606,"_5":13556,"_25987":51523,"_2719":51607},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3226":1710,"_28565":1675,"_19778":51609,"_5":13556,"_25987":51527,"_2719":51610},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3226":1711,"_28565":1675,"_19778":51612,"_5":13556,"_25987":51531,"_2719":51613},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3226":1712,"_28565":1675,"_19778":51615,"_5":13556,"_25987":51535,"_2719":51616},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3226":1713,"_28565":1675,"_19778":51618,"_5":13556,"_25987":51539,"_2719":51619},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3226":1714,"_28565":1675,"_19778":51621,"_5":13556,"_25987":51539,"_2719":51622},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3226":1715,"_28565":1675,"_19778":51624,"_5":13556,"_25987":51539,"_2719":51625},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3226":1716,"_28565":1675,"_19778":51627,"_5":13556,"_25987":51539,"_2719":51628},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3226":1717,"_28565":1675,"_19778":51630,"_5":13556,"_25987":51543,"_2719":51631},[],"The new chain ends in an anchor installed by the consumer.",{"_3226":1718,"_28565":1675,"_19778":51633,"_5":13556,"_25987":51543,"_2719":51634},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3226":1719,"_28565":1675,"_19778":51636,"_5":13556,"_25987":51543,"_2719":51637},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3226":1720,"_28565":1675,"_19778":51639,"_5":13556,"_25987":51543,"_2719":51640},[],"Re-enrollment accepts the old identity during the planned period.",{"_3226":1721,"_28565":1675,"_19778":51642,"_5":13556,"_25987":51543,"_2719":51643},[],"OCSP and CRL respond for the authorities that remain active.",{"_3226":1722,"_28565":1675,"_19778":51645,"_5":13556,"_25987":51543,"_2719":51646},[],"No DMS is left accidentally issuing from the old CA.",{"_3226":1723,"_28565":1675,"_19778":51648,"_5":13556,"_25987":51543,"_2719":51649},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3226":1724,"_28565":1724,"_5":13914,"_2719":51651,"_28908":51652,"_19778":51653,"_25987":1724},"Certification authorities",[46297,47746,51491,51492],[],{"_3226":1725,"_28565":1724,"_19778":51655,"_5":13556,"_25987":1724,"_2719":51656},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3226":1726,"_28565":1724,"_5":28905,"_19778":51658,"_25987":51659,"_2719":51660},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3226":1727,"_28565":1724,"_5":28905,"_19778":51662,"_25987":51663,"_2719":51664},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3226":1728,"_28565":1724,"_5":28905,"_19778":51666,"_25987":51667,"_2719":46307},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#before-you-begin",{"_3226":1729,"_28565":1724,"_5":28905,"_19778":51669,"_25987":51670,"_2719":51671},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3226":1730,"_28565":1724,"_5":28905,"_19778":51673,"_25987":51674,"_2719":51675},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3226":1731,"_28565":1724,"_5":28905,"_19778":51677,"_25987":51678,"_2719":51679},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3226":1732,"_28565":1724,"_5":28905,"_19778":51681,"_25987":51682,"_2719":51683},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3226":1733,"_28565":1724,"_5":28905,"_19778":51685,"_25987":51686,"_2719":51687},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3226":1734,"_28565":1724,"_5":28905,"_19778":51689,"_25987":51690,"_2719":51691},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3226":1735,"_28565":1724,"_5":28905,"_19778":51693,"_25987":51694,"_2719":51695},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3226":1736,"_28565":1724,"_5":28905,"_19778":51697,"_25987":51698,"_2719":51699},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3226":1737,"_28565":1724,"_5":28905,"_19778":51701,"_25987":51702,"_2719":51703},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3226":1738,"_28565":1724,"_5":28905,"_19778":51705,"_25987":51706,"_2719":51707},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3226":1739,"_28565":1724,"_5":28905,"_19778":51709,"_25987":51710,"_2719":51711},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3226":1740,"_28565":1724,"_5":28905,"_19778":51713,"_25987":51714,"_2719":51715},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3226":1741,"_28565":1724,"_5":28905,"_19778":51717,"_25987":51718,"_2719":51719},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3226":1742,"_28565":1724,"_5":28905,"_19778":51721,"_25987":51722,"_2719":51723},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3226":1743,"_28565":1724,"_5":28905,"_19778":51725,"_25987":51726,"_2719":51727},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3226":1744,"_28565":1724,"_5":28905,"_19778":51729,"_25987":51730,"_2719":51731},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3226":1745,"_28565":1724,"_5":28905,"_19778":51733,"_25987":51734,"_2719":51735},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3226":1746,"_28565":1724,"_5":28905,"_19778":51737,"_25987":51738,"_2719":51739},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3226":1747,"_28565":1724,"_5":28905,"_19778":51741,"_25987":51742,"_2719":51743},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3226":1748,"_28565":1724,"_5":28905,"_19778":51745,"_25987":51746,"_2719":51747},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3226":1749,"_28565":1724,"_19778":51749,"_5":13556,"_25987":1724,"_2719":51750},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3226":1750,"_28565":1724,"_19778":51752,"_5":13556,"_25987":1724,"_2719":51753},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3226":1751,"_28565":1724,"_19778":51755,"_5":13556,"_25987":1724,"_2719":51756},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3226":1752,"_28565":1724,"_19778":51758,"_5":13556,"_25987":51659,"_2719":51759},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3226":1753,"_28565":1724,"_19778":51761,"_5":13556,"_25987":51659,"_2719":51762},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3226":1754,"_28565":1724,"_19778":51764,"_5":13556,"_25987":51659,"_2719":51765},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3226":1755,"_28565":1724,"_19778":51767,"_5":13556,"_25987":51659,"_2719":51768},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3226":1756,"_28565":1724,"_19778":51770,"_5":13556,"_25987":51659,"_2719":51771},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3226":1757,"_28565":1724,"_19778":51773,"_5":13556,"_25987":51667,"_2719":51774},[],"Decide whether the CA will be a root or an intermediate.",{"_3226":1758,"_28565":1724,"_19778":51776,"_5":13556,"_25987":51667,"_2719":51777},[],"Choose the engine that will keep the key.",{"_3226":1759,"_28565":1724,"_19778":51779,"_5":13556,"_25987":51667,"_2719":51780},[],"Define a validity longer than that of the certificates it will issue.",{"_3226":1760,"_28565":1724,"_19778":51782,"_5":13556,"_25987":51667,"_2719":51783},[],"For an intermediate CA, make sure the parent CA is active.",{"_3226":1761,"_28565":1724,"_19778":51785,"_5":13556,"_25987":51670,"_2719":51786},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3226":1762,"_28565":1724,"_19778":51788,"_5":13556,"_25987":51674,"_2719":51789},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3226":1763,"_28565":1724,"_19778":51791,"_5":13556,"_25987":51674,"_2719":51792},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3226":1764,"_28565":1724,"_19778":51794,"_5":13556,"_25987":51678,"_2719":51795},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3226":1765,"_28565":1724,"_19778":51797,"_5":13556,"_25987":51682,"_2719":51798},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3226":1766,"_28565":1724,"_19778":51800,"_5":13556,"_25987":51682,"_2719":51801},[],"`C`: two-letter ISO 3166-1 country code.",{"_3226":1767,"_28565":1724,"_19778":51803,"_5":13556,"_25987":51682,"_2719":51804},[],"`ST`: state or province.",{"_3226":1768,"_28565":1724,"_19778":51806,"_5":13556,"_25987":51682,"_2719":51807},[],"`L`: locality.",{"_3226":1769,"_28565":1724,"_19778":51809,"_5":13556,"_25987":51682,"_2719":51810},[],"`O`: organization.",{"_3226":1770,"_28565":1724,"_19778":51812,"_5":13556,"_25987":51682,"_2719":51813},[],"`OU`: organizational unit.",{"_3226":1771,"_28565":1724,"_19778":51815,"_5":13556,"_25987":51682,"_2719":51816},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3226":1772,"_28565":1724,"_19778":51818,"_5":13556,"_25987":51686,"_2719":51819},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3226":1773,"_28565":1724,"_19778":51821,"_5":13556,"_25987":51686,"_2719":51822},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3226":1774,"_28565":1724,"_19778":51824,"_5":13556,"_25987":51690,"_2719":51825},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3226":1775,"_28565":1724,"_19778":51827,"_5":13556,"_25987":51690,"_2719":51828},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3226":1776,"_28565":1724,"_19778":51830,"_5":13556,"_25987":51694,"_2719":51831},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3226":1777,"_28565":1724,"_19778":51833,"_5":13556,"_25987":51694,"_2719":51834},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3226":1778,"_28565":1724,"_19778":51836,"_5":13556,"_25987":51698,"_2719":51837},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3226":1779,"_28565":1724,"_19778":51839,"_5":13556,"_25987":51702,"_2719":51840},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3226":1780,"_28565":1724,"_19778":51842,"_5":13556,"_25987":51706,"_2719":51843},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3226":1781,"_28565":1724,"_19778":51845,"_5":13556,"_25987":51710,"_2719":51846},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3226":1782,"_28565":1724,"_19778":51848,"_5":13556,"_25987":51714,"_2719":51849},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3226":1783,"_28565":1724,"_19778":51851,"_5":13556,"_25987":51714,"_2719":51852},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3226":1784,"_28565":1724,"_19778":51854,"_5":13556,"_25987":51718,"_2719":51855},[],"Open a CA from the inventory to review:",{"_3226":1785,"_28565":1724,"_19778":51857,"_5":13556,"_25987":51718,"_2719":51858},[],"Status and validity period.",{"_3226":1786,"_28565":1724,"_19778":51860,"_5":13556,"_25987":51718,"_2719":51861},[],"Certificate and chain in PEM format.",{"_3226":1787,"_28565":1724,"_19778":51863,"_5":13556,"_25987":51718,"_2719":51864},[],"Number of active, expired and revoked certificates.",{"_3226":1788,"_28565":1724,"_19778":51866,"_5":13556,"_25987":51718,"_2719":51867},[],"Certificates issued in **Issued Certificates**.",{"_3226":1789,"_28565":1724,"_19778":51869,"_5":13556,"_25987":51718,"_2719":51870},[],"The CRL linked to the authority.",{"_3226":1790,"_28565":1724,"_19778":51872,"_5":13556,"_25987":51718,"_2719":51873},[],"Metadata and the associated cryptographic engine.",{"_3226":1791,"_28565":1724,"_19778":51875,"_5":13556,"_25987":51718,"_2719":51876},[],"You can filter the inventory by name, status and CA type.",{"_3226":1792,"_28565":1724,"_19778":51878,"_5":13556,"_25987":51722,"_2719":51879},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3226":1793,"_28565":1724,"_19778":51881,"_5":13556,"_25987":51722,"_2719":51882},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3226":1794,"_28565":1724,"_19778":51884,"_5":13556,"_25987":51722,"_2719":51885},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3226":1795,"_28565":1724,"_19778":51887,"_5":13556,"_25987":51722,"_2719":51888},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3226":1796,"_28565":1724,"_19778":51890,"_5":13556,"_25987":51726,"_2719":51891},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3226":1797,"_28565":1724,"_19778":51893,"_5":13556,"_25987":51730,"_2719":51894},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3226":1798,"_28565":1724,"_19778":51896,"_5":13556,"_25987":51734,"_2719":51897},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3226":1799,"_28565":1724,"_19778":51899,"_5":13556,"_25987":51738,"_2719":51900},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3226":1800,"_28565":1724,"_19778":51902,"_5":13556,"_25987":51742,"_2719":51903},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3226":1801,"_28565":1724,"_19778":51905,"_5":13556,"_25987":51746,"_2719":51906},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3226":1802,"_28565":1724,"_19778":51908,"_5":13556,"_25987":51746,"_2719":51909},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3226":1803,"_28565":1724,"_19778":51911,"_5":13556,"_25987":51746,"_2719":51912},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3226":1804,"_28565":1804,"_5":13914,"_2719":51914,"_28908":51915,"_19778":51916,"_25987":1804},"Certificate profiles",[46297,47746,51491,51492],[],{"_3226":1805,"_28565":1804,"_19778":51918,"_5":13556,"_25987":1804,"_2719":51919},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3226":1806,"_28565":1804,"_5":28905,"_19778":51921,"_25987":51922,"_2719":51923},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3226":1807,"_28565":1804,"_5":28905,"_19778":51925,"_25987":51926,"_2719":51927},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#validity","Validity",{"_3226":1808,"_28565":1804,"_5":28905,"_19778":51929,"_25987":51930,"_2719":51931},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3226":1809,"_28565":1804,"_5":28905,"_19778":51933,"_25987":51934,"_2719":51935},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3226":1810,"_28565":1804,"_5":28905,"_19778":51937,"_25987":51938,"_2719":51939},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#subject","Subject",{"_3226":1811,"_28565":1804,"_5":28905,"_19778":51941,"_25987":51942,"_2719":51943},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3226":1812,"_28565":1804,"_5":28905,"_19778":51945,"_25987":51946,"_2719":51947},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3226":1813,"_28565":1804,"_5":28905,"_19778":51949,"_25987":51950,"_2719":51951},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3226":1814,"_28565":1804,"_5":28905,"_19778":51953,"_25987":51954,"_2719":51955},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3226":1815,"_28565":1804,"_5":28905,"_19778":51957,"_25987":51958,"_2719":51959},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3226":1816,"_28565":1804,"_5":28905,"_19778":51961,"_25987":51962,"_2719":51963},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3226":1817,"_28565":1804,"_5":28905,"_19778":51965,"_25987":51966,"_2719":51967},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3226":1818,"_28565":1804,"_5":28905,"_19778":51969,"_25987":51970,"_2719":51971},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3226":1819,"_28565":1804,"_5":28905,"_19778":51973,"_25987":51974,"_2719":51975},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3226":1820,"_28565":1804,"_5":28905,"_19778":51977,"_25987":51978,"_2719":51979},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#design-examples","Design examples",{"_3226":1821,"_28565":1804,"_5":28905,"_19778":51981,"_25987":51982,"_2719":51983},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3226":1822,"_28565":1804,"_19778":51985,"_5":13556,"_25987":1804,"_2719":51986},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3226":1823,"_28565":1804,"_19778":51988,"_5":13556,"_25987":1804,"_2719":51989},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3226":1824,"_28565":1804,"_19778":51991,"_5":13556,"_25987":51926,"_2719":51992},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3226":1825,"_28565":1804,"_19778":51994,"_5":13556,"_25987":51926,"_2719":51995},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3226":1826,"_28565":1804,"_19778":51997,"_5":13556,"_25987":51930,"_2719":51998},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3226":1827,"_28565":1804,"_19778":52000,"_5":13556,"_25987":51934,"_2719":52001},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3226":1828,"_28565":1804,"_19778":52003,"_5":13556,"_25987":51934,"_2719":52004},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3226":1829,"_28565":1804,"_19778":52006,"_5":13556,"_25987":51934,"_2719":52007},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3226":1830,"_28565":1804,"_19778":52009,"_5":13556,"_25987":51938,"_2719":52010},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3226":1831,"_28565":1804,"_19778":52012,"_5":13556,"_25987":51942,"_2719":52013},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3226":1832,"_28565":1804,"_19778":52015,"_5":13556,"_25987":51942,"_2719":52016},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3226":1833,"_28565":1804,"_19778":52018,"_5":13556,"_25987":51946,"_2719":52019},[],"The cryptographic enforcement can:",{"_3226":1834,"_28565":1804,"_19778":52021,"_5":13556,"_25987":51946,"_2719":52022},[],"allow or block RSA keys;",{"_3226":1835,"_28565":1804,"_19778":52024,"_5":13556,"_25987":51946,"_2719":52025},[],"limit the supported RSA sizes;",{"_3226":1836,"_28565":1804,"_19778":52027,"_5":13556,"_25987":51946,"_2719":52028},[],"allow or block ECDSA keys;",{"_3226":1837,"_28565":1804,"_19778":52030,"_5":13556,"_25987":51946,"_2719":52031},[],"limit the supported ECDSA sizes or curves.",{"_3226":1838,"_28565":1804,"_19778":52033,"_5":13556,"_25987":51946,"_2719":52034},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3226":1839,"_28565":1804,"_19778":52036,"_5":13556,"_25987":51950,"_2719":52037},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3226":1840,"_28565":1804,"_19778":52039,"_5":13556,"_25987":51950,"_2719":49507},[],{"_3226":1841,"_28565":1804,"_19778":52041,"_5":13556,"_25987":51950,"_2719":52042},[],"First choice",{"_3226":1842,"_28565":1804,"_19778":52044,"_5":13556,"_25987":51950,"_2719":52045},[],"Second choice",{"_3226":1843,"_28565":1804,"_19778":52047,"_5":13556,"_25987":51950,"_2719":52048},[],"If neither is supplied",{"_3226":1844,"_28565":1804,"_19778":52050,"_5":13556,"_25987":51950,"_2719":52051},[],"Direct signing with a CA",{"_3226":1845,"_28565":1804,"_19778":52053,"_5":13556,"_25987":51950,"_2719":52054},[],"`issuance_profile` embedded in the request",{"_3226":1846,"_28565":1804,"_19778":52056,"_5":13556,"_25987":51950,"_2719":52057},[],"Request `issuance_profile_id`",{"_3226":1847,"_28565":1804,"_19778":52059,"_5":13556,"_25987":51950,"_2719":52060},[],"CA default profile (`profile_id`).",{"_3226":1848,"_28565":1804,"_19778":52062,"_5":13556,"_25987":51950,"_2719":52063},[],"Issuance through a DMS",{"_3226":1849,"_28565":1804,"_19778":52065,"_5":13556,"_25987":51950,"_2719":52066},[],"`settings.issuance_profile_id`",{"_3226":1850,"_28565":1804,"_19778":52068,"_5":13556,"_25987":51950,"_2719":52069},[],"`settings.issuance_profile` embedded in the DMS",{"_3226":1851,"_28565":1804,"_19778":52071,"_5":13556,"_25987":51950,"_2719":52072},[],"Enrollment CA default profile.",{"_3226":1852,"_28565":1804,"_19778":52074,"_5":13556,"_25987":51950,"_2719":52075},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3226":1853,"_28565":1804,"_19778":52077,"_5":13556,"_25987":51950,"_2719":52078},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3226":1854,"_28565":1804,"_19778":52080,"_5":13556,"_25987":51958,"_2719":52081},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3226":1855,"_28565":1804,"_19778":52083,"_5":13556,"_25987":51962,"_2719":52084},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3226":1856,"_28565":1804,"_19778":52086,"_5":13556,"_25987":51966,"_2719":52087},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3226":1857,"_28565":1804,"_19778":52089,"_5":13556,"_25987":51970,"_2719":52090},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3226":1858,"_28565":1804,"_19778":52092,"_5":13556,"_25987":51974,"_2719":52093},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3226":1859,"_28565":1804,"_19778":52095,"_5":13556,"_25987":51974,"_2719":52096},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3226":1860,"_28565":1804,"_19778":52098,"_5":13556,"_25987":51978,"_2719":52099},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3226":1861,"_28565":1804,"_19778":52101,"_5":13556,"_25987":51978,"_2719":52102},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3226":1862,"_28565":1804,"_19778":52104,"_5":13556,"_25987":51978,"_2719":52105},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3226":1863,"_28565":1804,"_19778":52107,"_5":13556,"_25987":51978,"_2719":52108},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3226":1864,"_28565":1804,"_19778":52110,"_5":13556,"_25987":51982,"_2719":52111},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3226":1865,"_28565":1804,"_19778":52113,"_5":13556,"_25987":51982,"_2719":52114},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3226":1866,"_28565":1866,"_5":13914,"_2719":52116,"_28908":52117,"_19778":52119,"_25987":1866},"Certificate validation",[46297,47746,51491,52118],"Validation",[],{"_3226":1867,"_28565":1866,"_19778":52121,"_5":13556,"_25987":1866,"_2719":52122},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3226":1868,"_28565":1866,"_5":28905,"_19778":52124,"_25987":52125,"_2719":52126},[],"/docs/pr-preview/pr-42/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3226":1869,"_28565":1866,"_5":28905,"_19778":52128,"_25987":52129,"_2719":52130},[],"/docs/pr-preview/pr-42/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3226":1870,"_28565":1866,"_5":28905,"_19778":52132,"_25987":52133,"_2719":52134},[],"/docs/pr-preview/pr-42/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3226":1871,"_28565":1866,"_19778":52136,"_5":13556,"_25987":1866,"_2719":52137},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3226":1872,"_28565":1866,"_19778":52139,"_5":13556,"_25987":52125,"_2719":52140},[],"Verify these criteria together:",{"_3226":1873,"_28565":1866,"_19778":52142,"_5":13556,"_25987":52125,"_2719":51115},[],{"_3226":1874,"_28565":1866,"_19778":52144,"_5":13556,"_25987":52125,"_2719":52145},[],"Required result",{"_3226":1875,"_28565":1866,"_19778":52147,"_5":13556,"_25987":52125,"_2719":52148},[],"Chain and signature",{"_3226":1876,"_28565":1866,"_19778":52150,"_5":13556,"_25987":52125,"_2719":52151},[],"Valid chain to a root deliberately installed in the consumer.",{"_3226":1877,"_28565":1866,"_19778":52153,"_5":13556,"_25987":52125,"_2719":52154},[],"Dates",{"_3226":1878,"_28565":1866,"_19778":52156,"_5":13556,"_25987":52125,"_2719":52157},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3226":1879,"_28565":1866,"_19778":52159,"_5":13556,"_25987":52125,"_2719":47415},[],{"_3226":1880,"_28565":1866,"_19778":52161,"_5":13556,"_25987":52125,"_2719":52162},[],"Name, SAN or identifier matches the expected peer.",{"_3226":1881,"_28565":1866,"_19778":52164,"_5":13556,"_25987":52125,"_2719":46687},[],{"_3226":1882,"_28565":1866,"_19778":52166,"_5":13556,"_25987":52125,"_2719":52167},[],"KU, EKU and constraints permit the specific operation.",{"_3226":1883,"_28565":1866,"_19778":52169,"_5":13556,"_25987":52125,"_2719":52170},[],"Revocation",{"_3226":1884,"_28565":1866,"_19778":52172,"_5":13556,"_25987":52125,"_2719":52173},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3226":1885,"_28565":1866,"_19778":52175,"_5":13556,"_25987":52125,"_2719":52176},[],"Authorization",{"_3226":1886,"_28565":1866,"_19778":52178,"_5":13556,"_25987":52125,"_2719":52179},[],"The application permits that identity to perform the action.",{"_3226":1887,"_28565":1866,"_19778":52181,"_5":13556,"_25987":52125,"_2719":52182},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3226":1888,"_28565":1866,"_19778":52184,"_5":13556,"_25987":52129,"_2719":52185},[],"Mechanism",{"_3226":1889,"_28565":1866,"_19778":52187,"_5":13556,"_25987":52129,"_2719":52188},[],"When to use it",{"_3226":1890,"_28565":1866,"_19778":52190,"_5":13556,"_25987":52129,"_2719":52191},[],"What you must maintain",{"_3226":1891,"_28565":1866,"_19778":52193,"_5":13556,"_25987":52129,"_2719":52194},[],"OCSP",{"_3226":1892,"_28565":1866,"_19778":52196,"_5":13556,"_25987":52129,"_2719":52197},[],"Status query for a specific certificate.",{"_3226":1893,"_28565":1866,"_19778":52199,"_5":13556,"_25987":52129,"_2719":52200},[],"Responder access, signature verification and cache/freshness policy.",{"_3226":1894,"_28565":1866,"_19778":52202,"_5":13556,"_25987":52129,"_2719":52203},[],"CRL",{"_3226":1895,"_28565":1866,"_19778":52205,"_5":13556,"_25987":52129,"_2719":52206},[],"Local checks for many certificates or offline operation.",{"_3226":1896,"_28565":1866,"_19778":52208,"_5":13556,"_25987":52129,"_2719":52209},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3226":1897,"_28565":1866,"_19778":52211,"_5":13556,"_25987":52129,"_2719":52212},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3226":1898,"_28565":1866,"_19778":52214,"_5":13556,"_25987":52129,"_2719":52215},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3226":1899,"_28565":1866,"_19778":52217,"_5":13556,"_25987":52133,"_2719":52218},[],"Accept a current, authorized certificate with a known chain.",{"_3226":1900,"_28565":1866,"_19778":52220,"_5":13556,"_25987":52133,"_2719":52221},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3226":1901,"_28565":1866,"_19778":52223,"_5":13556,"_25987":52133,"_2719":52224},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3226":1902,"_28565":1866,"_19778":52226,"_5":13556,"_25987":52133,"_2719":52227},[],"Check that a new connection with that identity is rejected.",{"_3226":1903,"_28565":1866,"_19778":52229,"_5":13556,"_25987":52133,"_2719":52230},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3226":1904,"_28565":1866,"_19778":52232,"_5":13556,"_25987":52133,"_2719":52233},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3226":1905,"_28565":1866,"_19778":52235,"_5":13556,"_25987":52133,"_2719":52236},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3226":1906,"_28565":1866,"_19778":52238,"_5":13556,"_25987":52133,"_2719":52239},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3226":1907,"_28565":1866,"_19778":52241,"_5":13556,"_25987":52133,"_2719":52242},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3226":1908,"_28565":1908,"_5":13914,"_2719":52244,"_28908":52245,"_19778":52246,"_25987":1908},"Certificates",[46297,47746,51491,51492],[],{"_3226":1909,"_28565":1908,"_19778":52248,"_5":13556,"_25987":1908,"_2719":52249},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3226":1910,"_28565":1908,"_5":28905,"_19778":52251,"_25987":52252,"_2719":52253},[],"/docs/pr-preview/pr-42/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3226":1911,"_28565":1908,"_5":28905,"_19778":52255,"_25987":52256,"_2719":52257},[],"/docs/pr-preview/pr-42/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3226":1912,"_28565":1908,"_5":28905,"_19778":52259,"_25987":52260,"_2719":52261},[],"/docs/pr-preview/pr-42/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3226":1913,"_28565":1908,"_5":28905,"_19778":52263,"_25987":52264,"_2719":52265},[],"/docs/pr-preview/pr-42/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3226":1914,"_28565":1908,"_5":28905,"_19778":52267,"_25987":52268,"_2719":52269},[],"/docs/pr-preview/pr-42/platform/pki/certificates#open-the-action","Open the action",{"_3226":1915,"_28565":1908,"_5":28905,"_19778":52271,"_25987":52272,"_2719":52273},[],"/docs/pr-preview/pr-42/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3226":1916,"_28565":1908,"_5":28905,"_19778":52275,"_25987":52276,"_2719":52277},[],"/docs/pr-preview/pr-42/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3226":1917,"_28565":1908,"_5":28905,"_19778":52279,"_25987":52280,"_2719":52281},[],"/docs/pr-preview/pr-42/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3226":1918,"_28565":1908,"_5":28905,"_19778":52283,"_25987":52284,"_2719":52285},[],"/docs/pr-preview/pr-42/platform/pki/certificates#continue","Continue",{"_3226":1919,"_28565":1908,"_19778":52287,"_5":13556,"_25987":1908,"_2719":52288},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3226":1920,"_28565":1908,"_19778":52290,"_5":13556,"_25987":52252,"_2719":52291},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3226":1921,"_28565":1908,"_19778":52293,"_5":13556,"_25987":52252,"_2719":52294},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3226":1922,"_28565":1908,"_19778":52296,"_5":13556,"_25987":52256,"_2719":52297},[],"Download the PEM and inspect it:",{"_3226":1923,"_28565":1908,"_19778":52299,"_5":13556,"_25987":52256,"_2719":52300},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3226":1924,"_28565":1908,"_19778":52302,"_5":13556,"_25987":52260,"_2719":52303},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3226":1925,"_28565":1908,"_19778":52305,"_5":13556,"_25987":52260,"_2719":52306},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3226":1926,"_28565":1908,"_19778":52308,"_5":13556,"_25987":52260,"_2719":52309},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3226":1927,"_28565":1908,"_19778":52311,"_5":13556,"_25987":52260,"_2719":52312},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3226":1928,"_28565":1908,"_19778":52314,"_5":13556,"_25987":52260,"_2719":52315},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3226":1929,"_28565":1908,"_19778":52317,"_5":13556,"_25987":52260,"_2719":52318},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3226":1930,"_28565":1908,"_19778":52320,"_5":13556,"_25987":52260,"_2719":52321},[],"For browser key generation, follow Issue your first certificate.",{"_3226":1931,"_28565":1908,"_19778":52323,"_5":13556,"_25987":52264,"_2719":52324},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3226":1932,"_28565":1908,"_19778":52326,"_5":13556,"_25987":52268,"_2719":52327},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3226":1933,"_28565":1908,"_19778":52329,"_5":13556,"_25987":52272,"_2719":52330},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3226":1934,"_28565":1908,"_19778":52332,"_5":13556,"_25987":52276,"_2719":52333},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3226":1935,"_28565":1908,"_19778":52335,"_5":13556,"_25987":52276,"_2719":52336},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3226":1936,"_28565":1908,"_19778":52338,"_5":13556,"_25987":52276,"_2719":52339},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3226":1937,"_28565":1908,"_19778":52341,"_5":13556,"_25987":52280,"_2719":52342},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3226":1938,"_28565":1908,"_19778":52344,"_5":13556,"_25987":52280,"_2719":52345},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3226":1939,"_28565":1908,"_19778":52347,"_5":13556,"_25987":52280,"_2719":52348},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3226":1940,"_28565":1908,"_19778":52350,"_5":13556,"_25987":52284,"_2719":52351},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3226":1941,"_28565":1908,"_19778":52353,"_5":13556,"_25987":52284,"_2719":52354},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3226":1942,"_28565":1942,"_5":13914,"_2719":52356,"_28908":52357,"_19778":52359,"_25987":1942},"Certificate lifecycle",[46297,47746,51491,52358],"Concepts",[],{"_3226":1943,"_28565":1942,"_19778":52361,"_5":13556,"_25987":1942,"_2719":52362},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3226":1944,"_28565":1942,"_5":28905,"_19778":52364,"_25987":52365,"_2719":52366},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3226":1945,"_28565":1942,"_5":28905,"_19778":52368,"_25987":52369,"_2719":52370},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3226":1946,"_28565":1942,"_5":28905,"_19778":52372,"_25987":52373,"_2719":52374},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3226":1947,"_28565":1942,"_5":28905,"_19778":52376,"_25987":52377,"_2719":52378},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3226":1948,"_28565":1942,"_5":28905,"_19778":52380,"_25987":52381,"_2719":52382},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3226":1949,"_28565":1942,"_5":28905,"_19778":52384,"_25987":52385,"_2719":52386},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3226":1950,"_28565":1942,"_5":28905,"_19778":52388,"_25987":52389,"_2719":52390},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3226":1951,"_28565":1942,"_5":28905,"_19778":52392,"_25987":52393,"_2719":52394},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3226":1952,"_28565":1942,"_5":28905,"_19778":52396,"_25987":52397,"_2719":52398},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3226":1953,"_28565":1942,"_5":28905,"_19778":52400,"_25987":52401,"_2719":52402},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3226":1954,"_28565":1942,"_19778":52404,"_5":13556,"_25987":1942,"_2719":52405},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3226":1955,"_28565":1942,"_19778":52407,"_5":13556,"_25987":52369,"_2719":52408},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3226":1956,"_28565":1942,"_19778":52410,"_5":13556,"_25987":52373,"_2719":52411},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3226":1957,"_28565":1942,"_19778":52413,"_5":13556,"_25987":52377,"_2719":52414},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3226":1958,"_28565":1942,"_19778":52416,"_5":13556,"_25987":52381,"_2719":52417},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3226":1959,"_28565":1942,"_19778":52419,"_5":13556,"_25987":52385,"_2719":52420},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3226":1960,"_28565":1942,"_19778":52422,"_5":13556,"_25987":52389,"_2719":52423},[],"Lamassu persists four X.509 states:",{"_3226":1961,"_28565":1942,"_19778":52425,"_5":13556,"_25987":52389,"_2719":52426},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3226":1962,"_28565":1942,"_19778":52428,"_5":13556,"_25987":52389,"_2719":52429},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3226":1963,"_28565":1942,"_19778":52431,"_5":13556,"_25987":52389,"_2719":52432},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3226":1964,"_28565":1942,"_19778":52434,"_5":13556,"_25987":52389,"_2719":52435},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3226":1965,"_28565":1942,"_19778":52437,"_5":13556,"_25987":52389,"_2719":52438},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3226":1966,"_28565":1942,"_19778":52440,"_5":13556,"_25987":52393,"_2719":52441},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3226":1967,"_28565":1942,"_19778":52443,"_5":13556,"_25987":52393,"_2719":52444},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3226":1968,"_28565":1942,"_19778":52446,"_5":13556,"_25987":52393,"_2719":52447},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3226":1969,"_28565":1942,"_19778":52449,"_5":13556,"_25987":52397,"_2719":52450},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3226":1970,"_28565":1942,"_19778":52452,"_5":13556,"_25987":52397,"_2719":52453},[],"Before confirming:",{"_3226":1971,"_28565":1942,"_19778":52455,"_5":13556,"_25987":52397,"_2719":52456},[],"Identify DMSs, devices and services that trust that chain.",{"_3226":1972,"_28565":1942,"_19778":52458,"_5":13556,"_25987":52397,"_2719":52459},[],"Distribute the new chain of trust.",{"_3226":1973,"_28565":1942,"_19778":52461,"_5":13556,"_25987":52397,"_2719":52462},[],"Reissue the necessary identities.",{"_3226":1974,"_28565":1942,"_19778":52464,"_5":13556,"_25987":52397,"_2719":52465},[],"Check OCSP and CRL from a real consumer.",{"_3226":1975,"_28565":1942,"_19778":52467,"_5":13556,"_25987":52397,"_2719":52468},[],"Revoke the old CA once no legitimate traffic remains.",{"_3226":1976,"_28565":1942,"_19778":52470,"_5":13556,"_25987":52397,"_2719":52471},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3226":1977,"_28565":1942,"_19778":52473,"_5":13556,"_25987":52401,"_2719":52474},[],"Certificates entering the preventive or critical renewal window.",{"_3226":1978,"_28565":1942,"_19778":52476,"_5":13556,"_25987":52401,"_2719":52477},[],"Repeated enrollment or re-enrollment failures.",{"_3226":1979,"_28565":1942,"_19778":52479,"_5":13556,"_25987":52401,"_2719":52480},[],"Status changes and revocation reasons.",{"_3226":1980,"_28565":1942,"_19778":52482,"_5":13556,"_25987":52401,"_2719":52483},[],"OCSP and CRL publication and validity.",{"_3226":1981,"_28565":1942,"_19778":52485,"_5":13556,"_25987":52401,"_2719":52486},[],"Dependencies still presenting a replaced certificate.",{"_3226":1982,"_28565":1942,"_19778":52488,"_5":13556,"_25987":52401,"_2719":52489},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3226":1983,"_28565":1983,"_5":13914,"_2719":52491,"_28908":52492,"_19778":52493,"_25987":1983},"Trust model",[46297,47746,51491,52358],[],{"_3226":1984,"_28565":1983,"_19778":52495,"_5":13556,"_25987":1983,"_2719":52496},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3226":1985,"_28565":1983,"_5":28905,"_19778":52498,"_25987":52499,"_2719":52500},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3226":1986,"_28565":1983,"_5":28905,"_19778":52502,"_25987":52503,"_2719":52504},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3226":1987,"_28565":1983,"_5":28905,"_19778":52506,"_25987":52507,"_2719":52508},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3226":1988,"_28565":1983,"_5":28905,"_19778":52510,"_25987":52511,"_2719":52512},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3226":1989,"_28565":1983,"_5":28905,"_19778":52514,"_25987":52515,"_2719":52516},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3226":1990,"_28565":1983,"_5":28905,"_19778":52518,"_25987":52519,"_2719":52520},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3226":1991,"_28565":1983,"_5":28905,"_19778":52522,"_25987":52523,"_2719":52524},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3226":1992,"_28565":1983,"_5":28905,"_19778":52526,"_25987":52527,"_2719":52528},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3226":1993,"_28565":1983,"_5":28905,"_19778":52530,"_25987":52531,"_2719":52532},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3226":1994,"_28565":1983,"_5":28905,"_19778":52534,"_25987":52535,"_2719":52536},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3226":1995,"_28565":1983,"_19778":52538,"_5":13556,"_25987":1983,"_2719":52539},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3226":1996,"_28565":1983,"_19778":52541,"_5":13556,"_25987":52503,"_2719":52542},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3226":1997,"_28565":1983,"_19778":52544,"_5":13556,"_25987":52507,"_2719":52545},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3226":1998,"_28565":1983,"_19778":52547,"_5":13556,"_25987":52511,"_2719":52548},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3226":1999,"_28565":1983,"_19778":52550,"_5":13556,"_25987":52515,"_2719":52551},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3226":2000,"_28565":1983,"_19778":52553,"_5":13556,"_25987":52519,"_2719":52554},[],"The device proves it can enroll according to the DMS policy.",{"_3226":2001,"_28565":1983,"_19778":52556,"_5":13556,"_25987":52519,"_2719":52557},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3226":2002,"_28565":1983,"_19778":52559,"_5":13556,"_25987":52519,"_2719":52560},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3226":2003,"_28565":1983,"_19778":52562,"_5":13556,"_25987":52519,"_2719":52563},[],"The device installs the certificate and the chain it needs.",{"_3226":2004,"_28565":1983,"_19778":52565,"_5":13556,"_25987":52519,"_2719":52566},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3226":2005,"_28565":1983,"_19778":52568,"_5":13556,"_25987":52519,"_2719":52569},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3226":2006,"_28565":1983,"_19778":52571,"_5":13556,"_25987":52523,"_2719":52572},[],"A DMS relates three sets that are worth designing separately:",{"_3226":2007,"_28565":1983,"_19778":52574,"_5":13556,"_25987":52523,"_2719":52575},[],"**Enrollment CA:** signs the new identities.",{"_3226":2008,"_28565":1983,"_19778":52577,"_5":13556,"_25987":52523,"_2719":52578},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3226":2009,"_28565":1983,"_19778":52580,"_5":13556,"_25987":52523,"_2719":52581},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3226":2010,"_28565":1983,"_19778":52583,"_5":13556,"_25987":52523,"_2719":52584},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3226":2011,"_28565":1983,"_19778":52586,"_5":13556,"_25987":52527,"_2719":52587},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3226":2012,"_28565":1983,"_19778":52589,"_5":13556,"_25987":52527,"_2719":52590},[],"that the current date is between `Not Before` and `Not After`;",{"_3226":2013,"_28565":1983,"_19778":52592,"_5":13556,"_25987":52527,"_2719":52593},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3226":2014,"_28565":1983,"_19778":52595,"_5":13556,"_25987":52527,"_2719":52596},[],"that names, SANs and subject match the expected identity;",{"_3226":2015,"_28565":1983,"_19778":52598,"_5":13556,"_25987":52527,"_2719":52599},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3226":2016,"_28565":1983,"_19778":52601,"_5":13556,"_25987":52527,"_2719":52602},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3226":2017,"_28565":1983,"_19778":52604,"_5":13556,"_25987":52527,"_2719":52605},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3226":2018,"_28565":1983,"_19778":52607,"_5":13556,"_25987":52531,"_2719":52608},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3226":2019,"_28565":1983,"_19778":52610,"_5":13556,"_25987":52535,"_2719":52611},[],"Keep the root out of daily operations, or with very restricted access.",{"_3226":2020,"_28565":1983,"_19778":52613,"_5":13556,"_25987":52535,"_2719":52614},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3226":2021,"_28565":1983,"_19778":52616,"_5":13556,"_25987":52535,"_2719":52617},[],"Assign explicit profiles to every use case.",{"_3226":2022,"_28565":1983,"_19778":52619,"_5":13556,"_25987":52535,"_2719":52620},[],"Distribute the new trust before starting a rotation.",{"_3226":2023,"_28565":1983,"_19778":52622,"_5":13556,"_25987":52535,"_2719":52623},[],"Keep enough overlap to renew a disconnected fleet.",{"_3226":2024,"_28565":1983,"_19778":52625,"_5":13556,"_25987":52535,"_2719":52626},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3226":2025,"_28565":1983,"_19778":52628,"_5":13556,"_25987":52535,"_2719":52629},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3226":2026,"_28565":2026,"_5":13914,"_2719":52631,"_28908":52632,"_19778":52633,"_25987":2026},"Revocation lists (CRL)",[46297,47746,51491,52118],[],{"_3226":2027,"_28565":2026,"_19778":52635,"_5":13556,"_25987":2026,"_2719":52636},[],"Generate and distribute signed lists to validate certificates offline.",{"_3226":2028,"_28565":2026,"_5":28905,"_19778":52638,"_25987":52639,"_2719":52640},[],"/docs/pr-preview/pr-42/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3226":2029,"_28565":2026,"_5":28905,"_19778":52642,"_25987":52643,"_2719":52644},[],"/docs/pr-preview/pr-42/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3226":2030,"_28565":2026,"_5":28905,"_19778":52646,"_25987":52647,"_2719":52648},[],"/docs/pr-preview/pr-42/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3226":2031,"_28565":2026,"_5":28905,"_19778":52650,"_25987":52651,"_2719":52652},[],"/docs/pr-preview/pr-42/platform/pki/crl#crl-contents","CRL contents",{"_3226":2032,"_28565":2026,"_5":28905,"_19778":52654,"_25987":52655,"_2719":52656},[],"/docs/pr-preview/pr-42/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3226":2033,"_28565":2026,"_5":28905,"_19778":52658,"_25987":52659,"_2719":52660},[],"/docs/pr-preview/pr-42/platform/pki/crl#va-role-management-api","VA role management API",{"_3226":2034,"_28565":2026,"_5":28905,"_19778":52662,"_25987":52663,"_2719":52664},[],"/docs/pr-preview/pr-42/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3226":2035,"_28565":2026,"_5":28905,"_19778":52666,"_25987":52667,"_2719":52668},[],"/docs/pr-preview/pr-42/platform/pki/crl#from-the-interface","From the interface",{"_3226":2036,"_28565":2026,"_5":28905,"_19778":52670,"_25987":52671,"_2719":52672},[],"/docs/pr-preview/pr-42/platform/pki/crl#references","References",{"_3226":2037,"_28565":2026,"_19778":52674,"_5":13556,"_25987":2026,"_2719":52675},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3226":2038,"_28565":2026,"_19778":52677,"_5":13556,"_25987":52639,"_2719":52678},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3226":2039,"_28565":2026,"_19778":52680,"_5":13556,"_25987":52639,"_2719":52681},[],"`crl_options` field",{"_3226":2040,"_28565":2026,"_19778":52683,"_5":13556,"_25987":52639,"_2719":46687},[],{"_3226":2041,"_28565":2026,"_19778":52685,"_5":13556,"_25987":52639,"_2719":52686},[],"Backend initial value",{"_3226":2042,"_28565":2026,"_19778":52688,"_5":13556,"_25987":52639,"_2719":52689},[],"`validity`",{"_3226":2043,"_28565":2026,"_19778":52691,"_5":13556,"_25987":52639,"_2719":52692},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3226":2044,"_28565":2026,"_19778":52694,"_5":13556,"_25987":52639,"_2719":52695},[],"7 days.",{"_3226":2045,"_28565":2026,"_19778":52697,"_5":13556,"_25987":52639,"_2719":52698},[],"`refresh_interval`",{"_3226":2046,"_28565":2026,"_19778":52700,"_5":13556,"_25987":52639,"_2719":52701},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_3226":2047,"_28565":2026,"_19778":52703,"_5":13556,"_25987":52639,"_2719":52704},[],"6 days and 23 hours.",{"_3226":2048,"_28565":2026,"_19778":52706,"_5":13556,"_25987":52639,"_2719":52707},[],"`regenerate_on_revoke`",{"_3226":2049,"_28565":2026,"_19778":52709,"_5":13556,"_25987":52639,"_2719":52710},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3226":2050,"_28565":2026,"_19778":52712,"_5":13556,"_25987":52639,"_2719":52713},[],"`true`.",{"_3226":2051,"_28565":2026,"_19778":52715,"_5":13556,"_25987":52639,"_2719":52716},[],"`signer_certificate_serial_number`",{"_3226":2052,"_28565":2026,"_19778":52718,"_5":13556,"_25987":52639,"_2719":52719},[],"Serial number of the existing certificate that signs the CRL.",{"_3226":2053,"_28565":2026,"_19778":52721,"_5":13556,"_25987":52639,"_2719":52722},[],"Serial number of the CA’s current certificate.",{"_3226":2054,"_28565":2026,"_19778":52724,"_5":13556,"_25987":52639,"_2719":52725},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3226":2055,"_28565":2026,"_19778":52727,"_5":13556,"_25987":52639,"_2719":52728},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3226":2056,"_28565":2026,"_19778":52730,"_5":13556,"_25987":52639,"_2719":52731},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3226":2057,"_28565":2026,"_19778":52733,"_5":13556,"_25987":52639,"_2719":52734},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_3226":2058,"_28565":2026,"_19778":52736,"_5":13556,"_25987":52639,"_2719":52737},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3226":2059,"_28565":2026,"_19778":52739,"_5":13556,"_25987":52639,"_2719":52740},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3226":2060,"_28565":2026,"_19778":52742,"_5":13556,"_25987":52643,"_2719":52743},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3226":2061,"_28565":2026,"_19778":52745,"_5":13556,"_25987":52643,"_2719":52746},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.3) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3226":2062,"_28565":2026,"_19778":52748,"_5":13556,"_25987":52643,"_2719":52749},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3226":2063,"_28565":2026,"_19778":52751,"_5":13556,"_25987":52643,"_2719":52752},[],"To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Restrict the permission to import CAs until a per-CA CRL exists; it is proposed in lamassuiot#834.",{"_3226":2064,"_28565":2026,"_19778":52754,"_5":13556,"_25987":52647,"_2719":52755},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3226":2065,"_28565":2026,"_19778":52757,"_5":13556,"_25987":52647,"_2719":52758},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3226":2066,"_28565":2026,"_19778":52760,"_5":13556,"_25987":52647,"_2719":52761},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3226":2067,"_28565":2026,"_19778":52763,"_5":13556,"_25987":52647,"_2719":52764},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3226":2068,"_28565":2026,"_19778":52766,"_5":13556,"_25987":52651,"_2719":52767},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3226":2069,"_28565":2026,"_19778":52769,"_5":13556,"_25987":52651,"_2719":52770},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3226":2070,"_28565":2026,"_19778":52772,"_5":13556,"_25987":52655,"_2719":52773},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3226":2071,"_28565":2026,"_19778":52775,"_5":13556,"_25987":52655,"_2719":52776},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3226":2072,"_28565":2026,"_19778":52778,"_5":13556,"_25987":52655,"_2719":52779},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3226":2073,"_28565":2026,"_19778":52781,"_5":13556,"_25987":52655,"_2719":52782},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3226":2074,"_28565":2026,"_19778":52784,"_5":13556,"_25987":52655,"_2719":52785},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3226":2075,"_28565":2026,"_19778":52787,"_5":13556,"_25987":52659,"_2719":52788},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3226":2076,"_28565":2026,"_19778":52790,"_5":13556,"_25987":52659,"_2719":49510},[],{"_3226":2077,"_28565":2026,"_19778":52792,"_5":13556,"_25987":52659,"_2719":52793},[],"Relative path",{"_3226":2078,"_28565":2026,"_19778":52795,"_5":13556,"_25987":52659,"_2719":49507},[],{"_3226":2079,"_28565":2026,"_19778":52797,"_5":13556,"_25987":52659,"_2719":52798},[],"`GET`",{"_3226":2080,"_28565":2026,"_19778":52800,"_5":13556,"_25987":52659,"_2719":52801},[],"`/v1/roles/{ca-ski}`",{"_3226":2081,"_28565":2026,"_19778":52803,"_5":13556,"_25987":52659,"_2719":52804},[],"Read `crl_options` and `latest_crl`.",{"_3226":2082,"_28565":2026,"_19778":52806,"_5":13556,"_25987":52659,"_2719":52807},[],"`PUT`",{"_3226":2083,"_28565":2026,"_19778":52809,"_5":13556,"_25987":52659,"_2719":52801},[],{"_3226":2084,"_28565":2026,"_19778":52811,"_5":13556,"_25987":52659,"_2719":52812},[],"Replace CRL configuration.",{"_3226":2085,"_28565":2026,"_19778":52814,"_5":13556,"_25987":52659,"_2719":52815},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3226":2086,"_28565":2026,"_19778":52817,"_5":13556,"_25987":52659,"_2719":52818},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3226":2087,"_28565":2026,"_19778":52820,"_5":13556,"_25987":52663,"_2719":52821},[],"Symptom",{"_3226":2088,"_28565":2026,"_19778":52823,"_5":13556,"_25987":52663,"_2719":52824},[],"Cause",{"_3226":2089,"_28565":2026,"_19778":52826,"_5":13556,"_25987":52663,"_2719":52827},[],"Action",{"_3226":2090,"_28565":2026,"_19778":52829,"_5":13556,"_25987":52663,"_2719":52830},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3226":2091,"_28565":2026,"_19778":52832,"_5":13556,"_25987":52663,"_2719":52833},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3226":2092,"_28565":2026,"_19778":52835,"_5":13556,"_25987":52663,"_2719":52836},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3226":2093,"_28565":2026,"_19778":52838,"_5":13556,"_25987":52663,"_2719":52839},[],"`PUT` returns 400.",{"_3226":2094,"_28565":2026,"_19778":52841,"_5":13556,"_25987":52663,"_2719":52842},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3226":2095,"_28565":2026,"_19778":52844,"_5":13556,"_25987":52663,"_2719":52845},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3226":2096,"_28565":2026,"_19778":52847,"_5":13556,"_25987":52663,"_2719":52848},[],"`PUT` returns 400 from a 3.x client.",{"_3226":2097,"_28565":2026,"_19778":52850,"_5":13556,"_25987":52663,"_2719":52851},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3226":2098,"_28565":2026,"_19778":52853,"_5":13556,"_25987":52663,"_2719":52854},[],"Update the client to send the new field.",{"_3226":2099,"_28565":2026,"_19778":52856,"_5":13556,"_25987":52663,"_2719":52857},[],"The CRL does not change after revoking a certificate.",{"_3226":2100,"_28565":2026,"_19778":52859,"_5":13556,"_25987":52663,"_2719":52860},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3226":2101,"_28565":2026,"_19778":52862,"_5":13556,"_25987":52663,"_2719":52863},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3226":2102,"_28565":2026,"_19778":52865,"_5":13556,"_25987":52663,"_2719":52866},[],"A verifier rejects the CRL because of the issuer.",{"_3226":2103,"_28565":2026,"_19778":52868,"_5":13556,"_25987":52663,"_2719":52869},[],"Several CAs share an SKI.",{"_3226":2104,"_28565":2026,"_19778":52871,"_5":13556,"_25987":52663,"_2719":52872},[],"See CAs that share a key.",{"_3226":2105,"_28565":2026,"_19778":52874,"_5":13556,"_25987":52667,"_2719":52875},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3226":2106,"_28565":2026,"_19778":52877,"_5":13556,"_25987":52671,"_2719":52878},[],"RFC 5280: X.509 and CRL profile.",{"_3226":2107,"_28565":2026,"_19778":52880,"_5":13556,"_25987":52671,"_2719":52881},[],"OpenSSL: openssl-crl.",{"_3226":2108,"_28565":2026,"_19778":52883,"_5":13556,"_25987":52671,"_2719":52884},[],"OpenSSL: openssl-verify.",{"_3226":2109,"_28565":2026,"_19778":52886,"_5":13556,"_25987":52671,"_2719":52887},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3226":2110,"_28565":2026,"_19778":52889,"_5":13556,"_25987":52671,"_2719":52890},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3226":2111,"_28565":2111,"_5":13914,"_2719":52892,"_28908":52893,"_19778":52894,"_25987":2111},"Keys and cryptographic engines",[46297,47746,51491,51492],[],{"_3226":2112,"_28565":2111,"_19778":52896,"_5":13556,"_25987":2111,"_2719":52897},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3226":2113,"_28565":2111,"_5":28905,"_19778":52899,"_25987":52900,"_2719":52901},[],"/docs/pr-preview/pr-42/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3226":2114,"_28565":2111,"_5":28905,"_19778":52903,"_25987":52904,"_2719":52905},[],"/docs/pr-preview/pr-42/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3226":2115,"_28565":2111,"_5":28905,"_19778":52907,"_25987":52908,"_2719":52909},[],"/docs/pr-preview/pr-42/platform/pki/key-management#file-system","File System",{"_3226":2116,"_28565":2111,"_5":28905,"_19778":52911,"_25987":52912,"_2719":52913},[],"/docs/pr-preview/pr-42/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3226":2117,"_28565":2111,"_5":28905,"_19778":52915,"_25987":52916,"_2719":52917},[],"/docs/pr-preview/pr-42/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3226":2118,"_28565":2111,"_5":28905,"_19778":52919,"_25987":52920,"_2719":52921},[],"/docs/pr-preview/pr-42/platform/pki/key-management#aws-kms","AWS KMS",{"_3226":2119,"_28565":2111,"_5":28905,"_19778":52923,"_25987":52924,"_2719":52925},[],"/docs/pr-preview/pr-42/platform/pki/key-management#pkcs11","PKCS#11",{"_3226":2120,"_28565":2111,"_5":28905,"_19778":52927,"_25987":52928,"_2719":52929},[],"/docs/pr-preview/pr-42/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3226":2121,"_28565":2111,"_5":28905,"_19778":52931,"_25987":52932,"_2719":52933},[],"/docs/pr-preview/pr-42/platform/pki/key-management#key-inventory","Key inventory",{"_3226":2122,"_28565":2111,"_5":28905,"_19778":52935,"_25987":52936,"_2719":52937},[],"/docs/pr-preview/pr-42/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3226":2123,"_28565":2111,"_5":28905,"_19778":52939,"_25987":52940,"_2719":52941},[],"/docs/pr-preview/pr-42/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3226":2124,"_28565":2111,"_5":28905,"_19778":52943,"_25987":52944,"_2719":52945},[],"/docs/pr-preview/pr-42/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3226":2125,"_28565":2111,"_5":28905,"_19778":52947,"_25987":52948,"_2719":52949},[],"/docs/pr-preview/pr-42/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3226":2126,"_28565":2111,"_5":28905,"_19778":52951,"_25987":52952,"_2719":52953},[],"/docs/pr-preview/pr-42/platform/pki/key-management#view-details","View details",{"_3226":2127,"_28565":2111,"_5":28905,"_19778":52955,"_25987":52956,"_2719":52957},[],"/docs/pr-preview/pr-42/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3226":2128,"_28565":2111,"_5":28905,"_19778":52959,"_25987":52960,"_2719":52961},[],"/docs/pr-preview/pr-42/platform/pki/key-management#sign","Sign",{"_3226":2129,"_28565":2111,"_5":28905,"_19778":52963,"_25987":52964,"_2719":52965},[],"/docs/pr-preview/pr-42/platform/pki/key-management#verify","Verify",{"_3226":2130,"_28565":2111,"_5":28905,"_19778":52967,"_25987":52968,"_2719":52969},[],"/docs/pr-preview/pr-42/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3226":2131,"_28565":2111,"_5":28905,"_19778":52971,"_25987":52972,"_2719":52973},[],"/docs/pr-preview/pr-42/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3226":2132,"_28565":2111,"_5":28905,"_19778":52975,"_25987":52976,"_2719":52977},[],"/docs/pr-preview/pr-42/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3226":2133,"_28565":2111,"_19778":52979,"_5":13556,"_25987":2111,"_2719":52980},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3226":2134,"_28565":2111,"_19778":52982,"_5":13556,"_25987":2111,"_2719":52983},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3226":2135,"_28565":2111,"_19778":52985,"_5":13556,"_25987":52900,"_2719":52986},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3226":2136,"_28565":2111,"_19778":52988,"_5":13556,"_25987":52900,"_2719":52989},[],"In practice, it lets you:",{"_3226":2137,"_28565":2111,"_19778":52991,"_5":13556,"_25987":52900,"_2719":52992},[],"Generate new key pairs from Lamassu IoT.",{"_3226":2138,"_28565":2111,"_19778":52994,"_5":13556,"_25987":52900,"_2719":52995},[],"Import keys created externally.",{"_3226":2139,"_28565":2111,"_19778":52997,"_5":13556,"_25987":52900,"_2719":52998},[],"Delegate custody and cryptographic operations to external engines.",{"_3226":2140,"_28565":2111,"_19778":53000,"_5":13556,"_25987":52900,"_2719":53001},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3226":2141,"_28565":2111,"_19778":53003,"_5":13556,"_25987":52904,"_2719":53004},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3226":2142,"_28565":2111,"_19778":53006,"_5":13556,"_25987":52904,"_2719":53007},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3226":2143,"_28565":2111,"_19778":53009,"_5":13556,"_25987":52904,"_2719":53010},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3226":2144,"_28565":2111,"_19778":53012,"_5":13556,"_25987":52908,"_2719":53013},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3226":2145,"_28565":2111,"_19778":53015,"_5":13556,"_25987":52912,"_2719":53016},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3226":2146,"_28565":2111,"_19778":53018,"_5":13556,"_25987":52912,"_2719":53019},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3226":2147,"_28565":2111,"_19778":53021,"_5":13556,"_25987":52916,"_2719":53022},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3226":2148,"_28565":2111,"_19778":53024,"_5":13556,"_25987":52920,"_2719":53025},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3226":2149,"_28565":2111,"_19778":53027,"_5":13556,"_25987":52924,"_2719":53028},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3226":2150,"_28565":2111,"_19778":53030,"_5":13556,"_25987":52928,"_2719":53031},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3226":2151,"_28565":2111,"_19778":53033,"_5":13556,"_25987":52928,"_2719":53034},[],"Lamassu shows the enabled engines in the console.",{"_3226":2152,"_28565":2111,"_19778":53036,"_5":13556,"_25987":52928,"_2719":53037},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3226":2153,"_28565":2111,"_19778":53039,"_5":13556,"_25987":52928,"_2719":53040},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3226":2154,"_28565":2111,"_19778":53042,"_5":13556,"_25987":52932,"_2719":53043},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3226":2155,"_28565":2111,"_19778":53045,"_5":13556,"_25987":52932,"_2719":53046},[],"The table includes the following fields:",{"_3226":2156,"_28565":2111,"_19778":53048,"_5":13556,"_25987":52932,"_2719":53049},[],"**Name**: descriptive name of the key.",{"_3226":2157,"_28565":2111,"_19778":53051,"_5":13556,"_25987":52932,"_2719":53052},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3226":2158,"_28565":2111,"_19778":53054,"_5":13556,"_25987":52932,"_2719":53055},[],"**Strength**: visual indicator of cryptographic strength.",{"_3226":2159,"_28565":2111,"_19778":53057,"_5":13556,"_25987":52932,"_2719":53058},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3226":2160,"_28565":2111,"_19778":53060,"_5":13556,"_25987":52932,"_2719":53061},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3226":2161,"_28565":2111,"_19778":53063,"_5":13556,"_25987":52932,"_2719":53064},[],"**Aliases**: alternative names associated with the key.",{"_3226":2162,"_28565":2111,"_19778":53066,"_5":13556,"_25987":52932,"_2719":53067},[],"**Tags**: labels for classification and search.",{"_3226":2163,"_28565":2111,"_19778":53069,"_5":13556,"_25987":52932,"_2719":53070},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3226":2164,"_28565":2111,"_19778":53072,"_5":13556,"_25987":52932,"_2719":53073},[],"From this view you also reach the most common actions:",{"_3226":2165,"_28565":2111,"_19778":53075,"_5":13556,"_25987":52932,"_2719":53076},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3226":2166,"_28565":2111,"_19778":53078,"_5":13556,"_25987":52932,"_2719":53079},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3226":2167,"_28565":2111,"_19778":53081,"_5":13556,"_25987":52932,"_2719":53082},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3226":2168,"_28565":2111,"_19778":53084,"_5":13556,"_25987":52932,"_2719":53085},[],"**Delete Key** to remove the key from the system.",{"_3226":2169,"_28565":2111,"_19778":53087,"_5":13556,"_25987":52936,"_2719":53088},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3226":2170,"_28565":2111,"_19778":53090,"_5":13556,"_25987":52940,"_2719":53091},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3226":2171,"_28565":2111,"_19778":53093,"_5":13556,"_25987":52940,"_2719":53094},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3226":2172,"_28565":2111,"_19778":53096,"_5":13556,"_25987":52940,"_2719":53097},[],"**Key Name**: unique and descriptive name.",{"_3226":2173,"_28565":2111,"_19778":53099,"_5":13556,"_25987":52940,"_2719":53100},[],"**Crypto Engine**: engine that will keep the key.",{"_3226":2174,"_28565":2111,"_19778":53102,"_5":13556,"_25987":52940,"_2719":53103},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3226":2175,"_28565":2111,"_19778":53105,"_5":13556,"_25987":52940,"_2719":53106},[],"**Tags**: metadata to classify the key.",{"_3226":2176,"_28565":2111,"_19778":53108,"_5":13556,"_25987":52940,"_2719":53109},[],"**Metadata**: additional information for advanced uses.",{"_3226":2177,"_28565":2111,"_19778":53111,"_5":13556,"_25987":52944,"_2719":53112},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3226":2178,"_28565":2111,"_19778":53114,"_5":13556,"_25987":52944,"_2719":53115},[],"When you have an exportable private key and the destination engine supports import.",{"_3226":2179,"_28565":2111,"_19778":53117,"_5":13556,"_25987":52944,"_2719":53118},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3226":2180,"_28565":2111,"_19778":53120,"_5":13556,"_25987":52944,"_2719":53121},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3226":2181,"_28565":2111,"_19778":53123,"_5":13556,"_25987":52944,"_2719":53124},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3226":2182,"_28565":2111,"_19778":53126,"_5":13556,"_25987":52944,"_2719":53127},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3226":2183,"_28565":2111,"_19778":53129,"_5":13556,"_25987":52944,"_2719":53130},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3226":2184,"_28565":2111,"_19778":53132,"_5":13556,"_25987":52944,"_2719":53133},[],"**Tags**: labels for organization and search.",{"_3226":2185,"_28565":2111,"_19778":53135,"_5":13556,"_25987":52944,"_2719":53136},[],"**Metadata**: additional optional information.",{"_3226":2186,"_28565":2111,"_19778":53138,"_5":13556,"_25987":52944,"_2719":53139},[],"**Private Key (PEM)**: private key in PEM format.",{"_3226":2187,"_28565":2111,"_19778":53141,"_5":13556,"_25987":52944,"_2719":53142},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3226":2188,"_28565":2111,"_19778":53144,"_5":13556,"_25987":52948,"_2719":53145},[],"Each registered key has a detail view and several operational actions.",{"_3226":2189,"_28565":2111,"_19778":53147,"_5":13556,"_25987":52952,"_2719":53148},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3226":2190,"_28565":2111,"_19778":53150,"_5":13556,"_25987":52952,"_2719":53151},[],"The **Overview** tab shows, among others, these fields:",{"_3226":2191,"_28565":2111,"_19778":53153,"_5":13556,"_25987":52952,"_2719":53154},[],"**Key Name**: descriptive name.",{"_3226":2192,"_28565":2111,"_19778":53156,"_5":13556,"_25987":52952,"_2719":53157},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3226":2193,"_28565":2111,"_19778":53159,"_5":13556,"_25987":52952,"_2719":53160},[],"**Tags**: associated labels.",{"_3226":2194,"_28565":2111,"_19778":53162,"_5":13556,"_25987":52952,"_2719":53163},[],"**Aliases**: alternative names.",{"_3226":2195,"_28565":2111,"_19778":53165,"_5":13556,"_25987":52952,"_2719":53166},[],"**Crypto Engine**: engine where the key resides.",{"_3226":2196,"_28565":2111,"_19778":53168,"_5":13556,"_25987":52952,"_2719":53169},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3226":2197,"_28565":2111,"_19778":53171,"_5":13556,"_25987":52952,"_2719":53172},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3226":2198,"_28565":2111,"_19778":53174,"_5":13556,"_25987":52952,"_2719":53175},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3226":2199,"_28565":2111,"_19778":53177,"_5":13556,"_25987":52956,"_2719":53178},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3226":2200,"_28565":2111,"_19778":53180,"_5":13556,"_25987":52956,"_2719":53181},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3226":2201,"_28565":2111,"_19778":53183,"_5":13556,"_25987":52956,"_2719":53184},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3226":2202,"_28565":2111,"_19778":53186,"_5":13556,"_25987":52960,"_2719":53187},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3226":2203,"_28565":2111,"_19778":53189,"_5":13556,"_25987":52960,"_2719":53190},[],"Main fields:",{"_3226":2204,"_28565":2111,"_19778":53192,"_5":13556,"_25987":52960,"_2719":53193},[],"**Algorithm**: signing algorithm available for the key type.",{"_3226":2205,"_28565":2111,"_19778":53195,"_5":13556,"_25987":52960,"_2719":53196},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3226":2206,"_28565":2111,"_19778":53198,"_5":13556,"_25987":52960,"_2719":53199},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3226":2207,"_28565":2111,"_19778":53201,"_5":13556,"_25987":52960,"_2719":53202},[],"**Message**: content to sign.",{"_3226":2208,"_28565":2111,"_19778":53204,"_5":13556,"_25987":52960,"_2719":53205},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3226":2209,"_28565":2111,"_19778":53207,"_5":13556,"_25987":52964,"_2719":53208},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3226":2210,"_28565":2111,"_19778":53210,"_5":13556,"_25987":52964,"_2719":53190},[],{"_3226":2211,"_28565":2111,"_19778":53212,"_5":13556,"_25987":52964,"_2719":53213},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3226":2212,"_28565":2111,"_19778":53215,"_5":13556,"_25987":52964,"_2719":53216},[],"**Message Type**: `Raw` or `Digest`.",{"_3226":2213,"_28565":2111,"_19778":53218,"_5":13556,"_25987":52964,"_2719":53219},[],"**Payload Encoding**: encoding of the message.",{"_3226":2214,"_28565":2111,"_19778":53221,"_5":13556,"_25987":52964,"_2719":53222},[],"**Message**: original message or hash.",{"_3226":2215,"_28565":2111,"_19778":53224,"_5":13556,"_25987":52964,"_2719":53225},[],"**Signature**: signature to check.",{"_3226":2216,"_28565":2111,"_19778":53227,"_5":13556,"_25987":52964,"_2719":53228},[],"**Result**: indicator of the validation result.",{"_3226":2217,"_28565":2111,"_19778":53230,"_5":13556,"_25987":52968,"_2719":53231},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3226":2218,"_28565":2111,"_19778":53233,"_5":13556,"_25987":52968,"_2719":53234},[],"This flow is useful for:",{"_3226":2219,"_28565":2111,"_19778":53236,"_5":13556,"_25987":52968,"_2719":53237},[],"Requesting certificates from an external CA.",{"_3226":2220,"_28565":2111,"_19778":53239,"_5":13556,"_25987":52968,"_2719":53240},[],"Renewing an identity while keeping the same key.",{"_3226":2221,"_28565":2111,"_19778":53242,"_5":13556,"_25987":52968,"_2719":53243},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3226":2222,"_28565":2111,"_19778":53245,"_5":13556,"_25987":52968,"_2719":53246},[],"**Common Name (CN)**: main name of the identity.",{"_3226":2223,"_28565":2111,"_19778":53248,"_5":13556,"_25987":52968,"_2719":53249},[],"**Organization (O)**: organization or company.",{"_3226":2224,"_28565":2111,"_19778":53251,"_5":13556,"_25987":52968,"_2719":53252},[],"**Organizational Unit (OU)**: department or unit.",{"_3226":2225,"_28565":2111,"_19778":53254,"_5":13556,"_25987":52968,"_2719":53255},[],"**Country (C)**: two-letter country code.",{"_3226":2226,"_28565":2111,"_19778":53257,"_5":13556,"_25987":52968,"_2719":53258},[],"**State / Province (ST)**: state or province.",{"_3226":2227,"_28565":2111,"_19778":53260,"_5":13556,"_25987":52968,"_2719":53261},[],"**Locality (L)**: city or locality.",{"_3226":2228,"_28565":2111,"_19778":53263,"_5":13556,"_25987":52968,"_2719":53264},[],"**Email Address**: contact email.",{"_3226":2229,"_28565":2111,"_19778":53266,"_5":13556,"_25987":52968,"_2719":53267},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3226":2230,"_28565":2111,"_19778":53269,"_5":13556,"_25987":52968,"_2719":53270},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3226":2231,"_28565":2111,"_19778":53272,"_5":13556,"_25987":52972,"_2719":53273},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3226":2232,"_28565":2111,"_19778":53275,"_5":13556,"_25987":52972,"_2719":53276},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3226":2233,"_28565":2111,"_19778":53278,"_5":13556,"_25987":52976,"_2719":53279},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3226":2234,"_28565":2234,"_5":13914,"_2719":53281,"_28908":53282,"_19778":53283,"_25987":2234},"Online validation with OCSP",[46297,47746,51491,52118],[],{"_3226":2235,"_28565":2234,"_19778":53285,"_5":13556,"_25987":2234,"_2719":53286},[],"Query signed status and verify the responder’s response.",{"_3226":2236,"_28565":2234,"_5":28905,"_19778":53288,"_25987":53289,"_2719":53290},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3226":2237,"_28565":2234,"_5":28905,"_19778":53292,"_25987":53293,"_2719":53294},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3226":2238,"_28565":2234,"_5":28905,"_19778":53296,"_25987":53297,"_2719":53298},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3226":2239,"_28565":2234,"_5":28905,"_19778":53300,"_25987":53301,"_2719":53302},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3226":2240,"_28565":2234,"_5":28905,"_19778":53304,"_25987":53305,"_2719":53306},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3226":2241,"_28565":2234,"_5":28905,"_19778":53308,"_25987":53309,"_2719":52672},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#references",{"_3226":2242,"_28565":2234,"_19778":53311,"_5":13556,"_25987":2234,"_2719":53312},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3226":2243,"_28565":2234,"_19778":53314,"_5":13556,"_25987":53289,"_2719":53315},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3226":2244,"_28565":2234,"_19778":53317,"_5":13556,"_25987":53289,"_2719":53318},[],"Record status",{"_3226":2245,"_28565":2234,"_19778":53320,"_5":13556,"_25987":53289,"_2719":53321},[],"Signed response",{"_3226":2246,"_28565":2234,"_19778":53323,"_5":13556,"_25987":53289,"_2719":50663},[],{"_3226":2247,"_28565":2234,"_19778":53325,"_5":13556,"_25987":53289,"_2719":53326},[],"`Good`.",{"_3226":2248,"_28565":2234,"_19778":53328,"_5":13556,"_25987":53289,"_2719":50680},[],{"_3226":2249,"_28565":2234,"_19778":53330,"_5":13556,"_25987":53289,"_2719":53331},[],"`Revoked`, with revocation reason and timestamp.",{"_3226":2250,"_28565":2234,"_19778":53333,"_5":13556,"_25987":53289,"_2719":53334},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3226":2251,"_28565":2234,"_19778":53336,"_5":13556,"_25987":53289,"_2719":53337},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3226":2252,"_28565":2234,"_19778":53339,"_5":13556,"_25987":53289,"_2719":53340},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3226":2253,"_28565":2234,"_19778":53342,"_5":13556,"_25987":53289,"_2719":53343},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3226":2254,"_28565":2234,"_19778":53345,"_5":13556,"_25987":53289,"_2719":53346},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3226":2255,"_28565":2234,"_19778":53348,"_5":13556,"_25987":53293,"_2719":53349},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3226":2256,"_28565":2234,"_19778":53351,"_5":13556,"_25987":53293,"_2719":53352},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3226":2257,"_28565":2234,"_19778":53354,"_5":13556,"_25987":53297,"_2719":53355},[],"The service accepts:",{"_3226":2258,"_28565":2234,"_19778":53357,"_5":13556,"_25987":53297,"_2719":49510},[],{"_3226":2259,"_28565":2234,"_19778":53359,"_5":13556,"_25987":53297,"_2719":53360},[],"VA service path",{"_3226":2260,"_28565":2234,"_19778":53362,"_5":13556,"_25987":53297,"_2719":53363},[],"Format",{"_3226":2261,"_28565":2234,"_19778":53365,"_5":13556,"_25987":53297,"_2719":53366},[],"`POST`",{"_3226":2262,"_28565":2234,"_19778":53368,"_5":13556,"_25987":53297,"_2719":53369},[],"`/ocsp`",{"_3226":2263,"_28565":2234,"_19778":53371,"_5":13556,"_25987":53297,"_2719":53372},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3226":2264,"_28565":2234,"_19778":53374,"_5":13556,"_25987":53297,"_2719":52798},[],{"_3226":2265,"_28565":2234,"_19778":53376,"_5":13556,"_25987":53297,"_2719":53377},[],"`/ocsp/{ocsp_request}`",{"_3226":2266,"_28565":2234,"_19778":53379,"_5":13556,"_25987":53297,"_2719":53380},[],"DER request encoded using padded URL Base64.",{"_3226":2267,"_28565":2234,"_19778":53382,"_5":13556,"_25987":53297,"_2719":53383},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3226":2268,"_28565":2234,"_19778":53385,"_5":13556,"_25987":53301,"_2719":53386},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3226":2269,"_28565":2234,"_19778":53388,"_5":13556,"_25987":53301,"_2719":53389},[],"Generate the request:",{"_3226":2270,"_28565":2234,"_19778":53391,"_5":13556,"_25987":53301,"_2719":53392},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3226":2271,"_28565":2234,"_19778":53394,"_5":13556,"_25987":53301,"_2719":53395},[],"Replace the example URL with the inspected endpoint:",{"_3226":2272,"_28565":2234,"_19778":53397,"_5":13556,"_25987":53301,"_2719":53398},[],"Verify the returned DER:",{"_3226":2273,"_28565":2234,"_19778":53400,"_5":13556,"_25987":53301,"_2719":53401},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3226":2274,"_28565":2234,"_19778":53403,"_5":13556,"_25987":53305,"_2719":53404},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3226":2275,"_28565":2234,"_19778":53406,"_5":13556,"_25987":53305,"_2719":53407},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3226":2276,"_28565":2234,"_19778":53409,"_5":13556,"_25987":53309,"_2719":53410},[],"RFC 6960: OCSP.",{"_3226":2277,"_28565":2234,"_19778":53412,"_5":13556,"_25987":53309,"_2719":53413},[],"OpenSSL: openssl-ocsp.",{"_3226":2278,"_28565":2234,"_19778":53415,"_5":13556,"_25987":53309,"_2719":53416},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3226":2279,"_28565":2234,"_19778":53418,"_5":13556,"_25987":53309,"_2719":52890},[],{"_3226":2280,"_28565":2280,"_5":13914,"_2719":51491,"_28908":53420,"_19778":53421,"_25987":2280},[46297,47746,51491],[],{"_3226":2281,"_28565":2280,"_19778":53423,"_5":13556,"_25987":2280,"_2719":53424},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3226":2282,"_28565":2280,"_5":28905,"_19778":53426,"_25987":53427,"_2719":50801},[],"/docs/pr-preview/pr-42/platform/pki/overview#start-here",{"_3226":2283,"_28565":2280,"_5":28905,"_19778":53429,"_25987":53430,"_2719":53431},[],"/docs/pr-preview/pr-42/platform/pki/overview#what-you-need","What you need",{"_3226":2284,"_28565":2280,"_5":28905,"_19778":53433,"_25987":53434,"_2719":51335},[],"/docs/pr-preview/pr-42/platform/pki/overview#core-capabilities",{"_3226":2285,"_28565":2280,"_5":28905,"_19778":53436,"_25987":53437,"_2719":51339},[],"/docs/pr-preview/pr-42/platform/pki/overview#build-your-trust-hierarchy",{"_3226":2286,"_28565":2280,"_5":28905,"_19778":53439,"_25987":53440,"_2719":51343},[],"/docs/pr-preview/pr-42/platform/pki/overview#protect-cryptographic-keys",{"_3226":2287,"_28565":2280,"_5":28905,"_19778":53442,"_25987":53443,"_2719":51347},[],"/docs/pr-preview/pr-42/platform/pki/overview#issue-and-control-certificates",{"_3226":2288,"_28565":2280,"_5":28905,"_19778":53445,"_25987":53446,"_2719":51355},[],"/docs/pr-preview/pr-42/platform/pki/overview#publish-validation-status",{"_3226":2289,"_28565":2280,"_5":28905,"_19778":53448,"_25987":53449,"_2719":53450},[],"/docs/pr-preview/pr-42/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3226":2290,"_28565":2280,"_5":28905,"_19778":53452,"_25987":53453,"_2719":52285},[],"/docs/pr-preview/pr-42/platform/pki/overview#continue",{"_3226":2291,"_28565":2280,"_19778":53455,"_5":13556,"_25987":2280,"_2719":53456},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3226":2292,"_28565":2280,"_19778":53458,"_5":13556,"_25987":53427,"_2719":53459},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3226":2293,"_28565":2280,"_19778":53461,"_5":13556,"_25987":53427,"_2719":53462},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3226":2294,"_28565":2280,"_19778":53464,"_5":13556,"_25987":53430,"_2719":53465},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3226":2295,"_28565":2280,"_19778":53467,"_5":13556,"_25987":53430,"_2719":53468},[],"An available cryptographic engine to keep the authority's key.",{"_3226":2296,"_28565":2280,"_19778":53470,"_5":13556,"_25987":53430,"_2719":53471},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3226":2297,"_28565":2280,"_19778":53473,"_5":13556,"_25987":53430,"_2719":53474},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3226":2298,"_28565":2280,"_19778":53476,"_5":13556,"_25987":53430,"_2719":53477},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3226":2299,"_28565":2280,"_19778":53479,"_5":13556,"_25987":53437,"_2719":53480},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3226":2300,"_28565":2280,"_19778":53482,"_5":13556,"_25987":53440,"_2719":53483},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3226":2301,"_28565":2280,"_19778":53485,"_5":13556,"_25987":53443,"_2719":53486},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3226":2302,"_28565":2280,"_19778":53488,"_5":13556,"_25987":53446,"_2719":53489},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3226":2303,"_28565":2280,"_19778":53491,"_5":13556,"_25987":53449,"_2719":53492},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3226":2304,"_28565":2280,"_19778":53494,"_5":13556,"_25987":53449,"_2719":53495},[],"its subject and extensions identify the expected client;",{"_3226":2305,"_28565":2280,"_19778":53497,"_5":13556,"_25987":53449,"_2719":53498},[],"its public key matches the client's private key;",{"_3226":2306,"_28565":2280,"_19778":53500,"_5":13556,"_25987":53449,"_2719":53501},[],"its chain reaches a root trusted by the consumer;",{"_3226":2307,"_28565":2280,"_19778":53503,"_5":13556,"_25987":53449,"_2719":53504},[],"its dates and usages allow the operation;",{"_3226":2308,"_28565":2280,"_19778":53506,"_5":13556,"_25987":53449,"_2719":53507},[],"the consumer applies revocation checks and authorization.",{"_3226":2309,"_28565":2280,"_19778":53509,"_5":13556,"_25987":53449,"_2719":53510},[],"The issuance path includes the first independent checks.",{"_3226":2310,"_28565":2280,"_19778":53512,"_5":13556,"_25987":53453,"_2719":53513},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3226":2311,"_28565":2280,"_19778":53515,"_5":13556,"_25987":53453,"_2719":53516},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3226":2312,"_28565":2280,"_19778":53518,"_5":13556,"_25987":53453,"_2719":53519},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3226":2313,"_28565":2313,"_5":13914,"_2719":53521,"_28908":53522,"_19778":53523,"_25987":2313},"Create your first CA",[46297,47746,51491,50926],[],{"_3226":2314,"_28565":2313,"_19778":53525,"_5":13556,"_25987":2313,"_2719":53526},[],"Create an evaluation root and check its certificate before issuing.",{"_3226":2315,"_28565":2313,"_5":28905,"_19778":53528,"_25987":53529,"_2719":46307},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3226":2316,"_28565":2313,"_5":28905,"_19778":53531,"_25987":53532,"_2719":53533},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3226":2317,"_28565":2313,"_5":28905,"_19778":53535,"_25987":53536,"_2719":53537},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3226":2318,"_28565":2313,"_5":28905,"_19778":53539,"_25987":53540,"_2719":53541},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3226":2319,"_28565":2313,"_5":28905,"_19778":53543,"_25987":53544,"_2719":53545},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3226":2320,"_28565":2313,"_5":28905,"_19778":53547,"_25987":53548,"_2719":53549},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3226":2321,"_28565":2313,"_5":28905,"_19778":53551,"_25987":53552,"_2719":53553},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3226":2322,"_28565":2313,"_5":28905,"_19778":53555,"_25987":53556,"_2719":51184},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3226":2323,"_28565":2313,"_5":28905,"_19778":53558,"_25987":53559,"_2719":46331},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3226":2324,"_28565":2313,"_19778":53561,"_5":13556,"_25987":2313,"_2719":53562},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3226":2325,"_28565":2313,"_19778":53564,"_5":13556,"_25987":53529,"_2719":53565},[],"Console access and permission to create keys and authorities.",{"_3226":2326,"_28565":2313,"_19778":53567,"_5":13556,"_25987":53529,"_2719":53568},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3226":2327,"_28565":2313,"_19778":53570,"_5":13556,"_25987":53529,"_2719":53571},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3226":2328,"_28565":2313,"_19778":53573,"_5":13556,"_25987":53529,"_2719":53574},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3226":2329,"_28565":2313,"_19778":53576,"_5":13556,"_25987":53532,"_2719":53577},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3226":2330,"_28565":2313,"_19778":53579,"_5":13556,"_25987":53532,"_2719":53580},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3226":2331,"_28565":2313,"_19778":53582,"_5":13556,"_25987":53536,"_2719":53583},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3226":2332,"_28565":2313,"_19778":53585,"_5":13556,"_25987":53536,"_2719":53586},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3226":2333,"_28565":2313,"_19778":53588,"_5":13556,"_25987":53540,"_2719":53589},[],"Select **Root CA** and complete:",{"_3226":2334,"_28565":2313,"_19778":53591,"_5":13556,"_25987":53540,"_2719":53592},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3226":2335,"_28565":2313,"_19778":53594,"_5":13556,"_25987":53540,"_2719":53595},[],"**Subject**: organization and country details for your evaluation.",{"_3226":2336,"_28565":2313,"_19778":53597,"_5":13556,"_25987":53540,"_2719":53598},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3226":2337,"_28565":2313,"_19778":53600,"_5":13556,"_25987":53540,"_2719":53601},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3226":2338,"_28565":2313,"_19778":53603,"_5":13556,"_25987":53540,"_2719":53604},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3226":2339,"_28565":2313,"_19778":53606,"_5":13556,"_25987":53544,"_2719":53607},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3226":2340,"_28565":2313,"_19778":53609,"_5":13556,"_25987":53548,"_2719":53610},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3226":2341,"_28565":2313,"_19778":53612,"_5":13556,"_25987":53548,"_2719":53613},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3226":2342,"_28565":2313,"_19778":53615,"_5":13556,"_25987":53552,"_2719":53616},[],"Run from the directory where you saved `ca.pem`:",{"_3226":2343,"_28565":2313,"_19778":53618,"_5":13556,"_25987":53552,"_2719":53619},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3226":2344,"_28565":2313,"_19778":53621,"_5":13556,"_25987":53552,"_2719":53622},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3226":2345,"_28565":2313,"_19778":53624,"_5":13556,"_25987":53556,"_2719":53625},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3226":2346,"_28565":2313,"_19778":53627,"_5":13556,"_25987":53556,"_2719":53628},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3226":2347,"_28565":2313,"_19778":53630,"_5":13556,"_25987":53556,"_2719":53631},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3226":2348,"_28565":2313,"_19778":53633,"_5":13556,"_25987":53556,"_2719":53634},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3226":2349,"_28565":2313,"_19778":53636,"_5":13556,"_25987":53559,"_2719":53637},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3226":2350,"_28565":2350,"_5":13914,"_2719":53639,"_28908":53640,"_19778":53641,"_25987":2350},"Issue and verify a certificate",[46297,47746,51491,50926],[],{"_3226":2351,"_28565":2350,"_19778":53643,"_5":13556,"_25987":2350,"_2719":53644},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3226":2352,"_28565":2350,"_5":28905,"_19778":53646,"_25987":53647,"_2719":46307},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3226":2353,"_28565":2350,"_5":28905,"_19778":53649,"_25987":53650,"_2719":53651},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3226":2354,"_28565":2350,"_5":28905,"_19778":53653,"_25987":53654,"_2719":53655},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3226":2355,"_28565":2350,"_5":28905,"_19778":53657,"_25987":53658,"_2719":53659},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3226":2356,"_28565":2350,"_5":28905,"_19778":53661,"_25987":53662,"_2719":53663},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3226":2357,"_28565":2350,"_5":28905,"_19778":53665,"_25987":53666,"_2719":53667},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3226":2358,"_28565":2350,"_5":28905,"_19778":53669,"_25987":53670,"_2719":53549},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3226":2359,"_28565":2350,"_5":28905,"_19778":53672,"_25987":53673,"_2719":53674},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3226":2360,"_28565":2350,"_5":28905,"_19778":53676,"_25987":53677,"_2719":53678},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3226":2361,"_28565":2350,"_5":28905,"_19778":53680,"_25987":53681,"_2719":53682},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3226":2362,"_28565":2350,"_5":28905,"_19778":53684,"_25987":53685,"_2719":51184},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3226":2363,"_28565":2350,"_5":28905,"_19778":53687,"_25987":53688,"_2719":46331},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#next-step",{"_3226":2364,"_28565":2350,"_19778":53690,"_5":13556,"_25987":2350,"_2719":53691},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3226":2365,"_28565":2350,"_19778":53693,"_5":13556,"_25987":53647,"_2719":53694},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3226":2366,"_28565":2350,"_19778":53696,"_5":13556,"_25987":53647,"_2719":53697},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3226":2367,"_28565":2350,"_19778":53699,"_5":13556,"_25987":53647,"_2719":53700},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3226":2368,"_28565":2350,"_19778":53702,"_5":13556,"_25987":53647,"_2719":53703},[],"A client identifier: here we use `device-001`.",{"_3226":2369,"_28565":2350,"_19778":53705,"_5":13556,"_25987":53647,"_2719":53706},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3226":2370,"_28565":2350,"_19778":53708,"_5":13556,"_25987":53650,"_2719":53709},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3226":2371,"_28565":2350,"_19778":53711,"_5":13556,"_25987":53654,"_2719":53712},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3226":2372,"_28565":2350,"_19778":53714,"_5":13556,"_25987":53654,"_2719":53715},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3226":2373,"_28565":2350,"_19778":53717,"_5":13556,"_25987":53658,"_2719":53718},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3226":2374,"_28565":2350,"_19778":53720,"_5":13556,"_25987":53658,"_2719":53721},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3226":2375,"_28565":2350,"_19778":53723,"_5":13556,"_25987":53662,"_2719":53724},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3226":2376,"_28565":2350,"_19778":53726,"_5":13556,"_25987":53662,"_2719":53727},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3226":2377,"_28565":2350,"_19778":53729,"_5":13556,"_25987":53666,"_2719":53730},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3226":2378,"_28565":2350,"_19778":53732,"_5":13556,"_25987":53670,"_2719":53733},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3226":2379,"_28565":2350,"_19778":53735,"_5":13556,"_25987":53673,"_2719":53736},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3226":2380,"_28565":2350,"_19778":53738,"_5":13556,"_25987":53677,"_2719":53739},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3226":2381,"_28565":2350,"_19778":53741,"_5":13556,"_25987":53677,"_2719":53742},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3226":2382,"_28565":2350,"_19778":53744,"_5":13556,"_25987":53677,"_2719":53745},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3226":2383,"_28565":2350,"_19778":53747,"_5":13556,"_25987":53681,"_2719":53748},[],"In Bash, compare the two public-key digests:",{"_3226":2384,"_28565":2350,"_19778":53750,"_5":13556,"_25987":53681,"_2719":53751},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3226":2385,"_28565":2350,"_19778":53753,"_5":13556,"_25987":53681,"_2719":53754},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3226":2386,"_28565":2350,"_19778":53756,"_5":13556,"_25987":53685,"_2719":51268},[],{"_3226":2387,"_28565":2350,"_19778":53758,"_5":13556,"_25987":53685,"_2719":53759},[],"What to review",{"_3226":2388,"_28565":2350,"_19778":53761,"_5":13556,"_25987":53685,"_2719":53762},[],"The CA rejects issuance",{"_3226":2389,"_28565":2350,"_19778":53764,"_5":13556,"_25987":53685,"_2719":53765},[],"Permissions, CA state and key, algorithm and profile.",{"_3226":2390,"_28565":2350,"_19778":53767,"_5":13556,"_25987":53685,"_2719":53768},[],"Different subject or usages",{"_3226":2391,"_28565":2350,"_19778":53770,"_5":13556,"_25987":53685,"_2719":53771},[],"Applied profile and requested values.",{"_3226":2392,"_28565":2350,"_19778":53773,"_5":13556,"_25987":53685,"_2719":53774},[],"Issuer cannot be found",{"_3226":2393,"_28565":2350,"_19778":53776,"_5":13556,"_25987":53685,"_2719":53777},[],"Downloaded CA and required intermediate chain.",{"_3226":2394,"_28565":2350,"_19778":53779,"_5":13556,"_25987":53685,"_2719":53780},[],"Validity fails",{"_3226":2395,"_28565":2350,"_19778":53782,"_5":13556,"_25987":53685,"_2719":53783},[],"Certificate and CA dates, and the computer's clock.",{"_3226":2396,"_28565":2350,"_19778":53785,"_5":13556,"_25987":53685,"_2719":53786},[],"Public-key digests differ",{"_3226":2397,"_28565":2350,"_19778":53788,"_5":13556,"_25987":53685,"_2719":53789},[],"Certificate and key files from the same issuance.",{"_3226":2398,"_28565":2350,"_19778":53791,"_5":13556,"_25987":53685,"_2719":53792},[],"See PKI diagnostics to narrow an issuance failure.",{"_3226":2399,"_28565":2350,"_19778":53794,"_5":13556,"_25987":53688,"_2719":53795},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3226":2400,"_28565":2350,"_19778":53797,"_5":13556,"_25987":53688,"_2719":53798},[],"Manage certificates for inspection, status and revocation.",{"_3226":2401,"_28565":2350,"_19778":53800,"_5":13556,"_25987":53688,"_2719":53801},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3226":2402,"_28565":2350,"_19778":53803,"_5":13556,"_25987":53688,"_2719":53804},[],"Prepare EST for the device to request its next identities.",{"_3226":2403,"_28565":2350,"_19778":53806,"_5":13556,"_25987":53688,"_2719":53807},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3226":2404,"_28565":2404,"_5":13914,"_2719":53809,"_28908":53810,"_19778":53811,"_25987":2404},"PKI getting started",[46297,47746,51491,50926],[],{"_3226":2405,"_28565":2404,"_19778":53813,"_5":13556,"_25987":2404,"_2719":53814},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3226":2406,"_28565":2404,"_5":28905,"_19778":53816,"_25987":53817,"_2719":46307},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#before-you-begin",{"_3226":2407,"_28565":2404,"_5":28905,"_19778":53819,"_25987":53820,"_2719":53821},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3226":2408,"_28565":2404,"_5":28905,"_19778":53823,"_25987":53824,"_2719":51118},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#expected-result",{"_3226":2409,"_28565":2404,"_5":28905,"_19778":53826,"_25987":53827,"_2719":53828},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3226":2410,"_28565":2404,"_19778":53830,"_5":13556,"_25987":2404,"_2719":53831},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3226":2411,"_28565":2404,"_19778":53833,"_5":13556,"_25987":53817,"_2719":53834},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3226":2412,"_28565":2404,"_19778":53836,"_5":13556,"_25987":53817,"_2719":53837},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3226":2413,"_28565":2404,"_19778":53839,"_5":13556,"_25987":53817,"_2719":53840},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3226":2414,"_28565":2404,"_19778":53842,"_5":13556,"_25987":53817,"_2719":53843},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3226":2415,"_28565":2404,"_19778":53845,"_5":13556,"_25987":53817,"_2719":53846},[],"A working directory with restricted access for the downloaded key.",{"_3226":2416,"_28565":2404,"_19778":53848,"_5":13556,"_25987":53820,"_2719":53849},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3226":2417,"_28565":2404,"_19778":53851,"_5":13556,"_25987":53820,"_2719":53852},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3226":2418,"_28565":2404,"_19778":53854,"_5":13556,"_25987":53820,"_2719":53855},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3226":2419,"_28565":2404,"_19778":53857,"_5":13556,"_25987":53820,"_2719":53858},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3226":2420,"_28565":2404,"_19778":53860,"_5":13556,"_25987":53824,"_2719":53861},[],"File or resource",{"_3226":2421,"_28565":2404,"_19778":53863,"_5":13556,"_25987":53824,"_2719":51115},[],{"_3226":2422,"_28565":2404,"_19778":53865,"_5":13556,"_25987":53824,"_2719":53866},[],"Active root CA and `ca.pem`",{"_3226":2423,"_28565":2404,"_19778":53868,"_5":13556,"_25987":53824,"_2719":53869},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3226":2424,"_28565":2404,"_19778":53871,"_5":13556,"_25987":53824,"_2719":53872},[],"End-entity certificate and `device.crt`",{"_3226":2425,"_28565":2404,"_19778":53874,"_5":13556,"_25987":53824,"_2719":53875},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3226":2426,"_28565":2404,"_19778":53877,"_5":13556,"_25987":53824,"_2719":53878},[],"Private key `device.key`",{"_3226":2427,"_28565":2404,"_19778":53880,"_5":13556,"_25987":53824,"_2719":53881},[],"Its public key matches the one included in `device.crt`.",{"_3226":2428,"_28565":2404,"_19778":53883,"_5":13556,"_25987":53824,"_2719":53884},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3226":2429,"_28565":2404,"_19778":53886,"_5":13556,"_25987":53827,"_2719":53887},[],"To operate certificates, continue with Certificates and Validation.",{"_3226":2430,"_28565":2404,"_19778":53889,"_5":13556,"_25987":53827,"_2719":53890},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3226":2431,"_28565":2404,"_19778":53892,"_5":13556,"_25987":53827,"_2719":53893},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3226":2432,"_28565":2432,"_5":13914,"_2719":53895,"_28908":53896,"_19778":53897,"_25987":2432},"PKI troubleshooting",[46297,47746,51491,50300],[],{"_3226":2433,"_28565":2432,"_19778":53899,"_5":13556,"_25987":2432,"_2719":53900},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3226":2434,"_28565":2432,"_5":28905,"_19778":53902,"_25987":53903,"_2719":53904},[],"/docs/pr-preview/pr-42/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3226":2435,"_28565":2432,"_5":28905,"_19778":53906,"_25987":53907,"_2719":53908},[],"/docs/pr-preview/pr-42/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3226":2436,"_28565":2432,"_5":28905,"_19778":53910,"_25987":53911,"_2719":53912},[],"/docs/pr-preview/pr-42/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3226":2437,"_28565":2432,"_19778":53914,"_5":13556,"_25987":2432,"_2719":53915},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3226":2438,"_28565":2432,"_19778":53917,"_5":13556,"_25987":2432,"_2719":53918},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3226":2439,"_28565":2432,"_19778":53920,"_5":13556,"_25987":53903,"_2719":51115},[],{"_3226":2440,"_28565":2432,"_19778":53922,"_5":13556,"_25987":53903,"_2719":53923},[],"What to inspect",{"_3226":2441,"_28565":2432,"_19778":53925,"_5":13556,"_25987":53903,"_2719":46331},[],{"_3226":2442,"_28565":2432,"_19778":53927,"_5":13556,"_25987":53903,"_2719":53928},[],"CA",{"_3226":2443,"_28565":2432,"_19778":53930,"_5":13556,"_25987":53903,"_2719":53931},[],"Exists, is active and has usable dates.",{"_3226":2444,"_28565":2432,"_19778":53933,"_5":13556,"_25987":53903,"_2719":53934},[],"Authorities.",{"_3226":2445,"_28565":2432,"_19778":53936,"_5":13556,"_25987":53903,"_2719":53937},[],"Key",{"_3226":2446,"_28565":2432,"_19778":53939,"_5":13556,"_25987":53903,"_2719":53940},[],"The record has a usable private key and the engine can sign.",{"_3226":2447,"_28565":2432,"_19778":53942,"_5":13556,"_25987":53903,"_2719":53943},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3226":2448,"_28565":2432,"_19778":53945,"_5":13556,"_25987":53903,"_2719":53946},[],"CSR",{"_3226":2449,"_28565":2432,"_19778":53948,"_5":13556,"_25987":53903,"_2719":53949},[],"Correct PEM and verifiable signature.",{"_3226":2450,"_28565":2432,"_19778":53951,"_5":13556,"_25987":53903,"_2719":53952},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3226":2451,"_28565":2432,"_19778":53954,"_5":13556,"_25987":53903,"_2719":53955},[],"Profile",{"_3226":2452,"_28565":2432,"_19778":53957,"_5":13556,"_25987":53903,"_2719":53958},[],"Selected source, existing ID, allowed algorithm and size.",{"_3226":2453,"_28565":2432,"_19778":53960,"_5":13556,"_25987":53903,"_2719":53961},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3226":2454,"_28565":2432,"_19778":53963,"_5":13556,"_25987":53903,"_2719":51268},[],{"_3226":2455,"_28565":2432,"_19778":53965,"_5":13556,"_25987":53903,"_2719":53966},[],"Appropriate subject, SAN, usages and dates.",{"_3226":2456,"_28565":2432,"_19778":53968,"_5":13556,"_25987":53903,"_2719":53969},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3226":2457,"_28565":2432,"_19778":53971,"_5":13556,"_25987":53903,"_2719":53972},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3226":2458,"_28565":2432,"_19778":53974,"_5":13556,"_25987":53903,"_2719":53975},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3226":2459,"_28565":2432,"_19778":53977,"_5":13556,"_25987":53907,"_2719":53978},[],"Check each boundary independently:",{"_3226":2460,"_28565":2432,"_19778":53980,"_5":13556,"_25987":53907,"_2719":53981},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3226":2461,"_28565":2432,"_19778":53983,"_5":13556,"_25987":53907,"_2719":53984},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3226":2462,"_28565":2432,"_19778":53986,"_5":13556,"_25987":53907,"_2719":53987},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3226":2463,"_28565":2432,"_19778":53989,"_5":13556,"_25987":53907,"_2719":53990},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3226":2464,"_28565":2432,"_19778":53992,"_5":13556,"_25987":53907,"_2719":53993},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3226":2465,"_28565":2432,"_19778":53995,"_5":13556,"_25987":53907,"_2719":53996},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3226":2466,"_28565":2432,"_19778":53998,"_5":13556,"_25987":53911,"_2719":53999},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3226":2467,"_28565":2432,"_19778":54001,"_5":13556,"_25987":53911,"_2719":54002},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3226":2468,"_28565":2468,"_5":13914,"_2719":54004,"_28908":54005,"_19778":54007,"_25987":2468},"3.8.0 to 4.0.0",[46297,54006],"Upgrades",[],{"_3226":2469,"_28565":2468,"_19778":54009,"_5":13556,"_25987":2468,"_2719":54010},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3226":2470,"_28565":2468,"_5":28905,"_19778":54012,"_25987":54013,"_2719":54014},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3226":2471,"_28565":2468,"_5":28905,"_19778":54016,"_25987":54017,"_2719":54018},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3226":2472,"_28565":2468,"_5":28905,"_19778":54020,"_25987":54021,"_2719":54022},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3226":2473,"_28565":2468,"_5":28905,"_19778":54024,"_25987":54025,"_2719":54026},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3226":2474,"_28565":2468,"_5":28905,"_19778":54028,"_25987":54029,"_2719":54030},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3226":2475,"_28565":2468,"_5":28905,"_19778":54032,"_25987":54033,"_2719":54034},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3226":2476,"_28565":2468,"_5":28905,"_19778":54036,"_25987":54037,"_2719":54038},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3226":2477,"_28565":2468,"_5":28905,"_19778":54040,"_25987":54041,"_2719":54042},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3226":2478,"_28565":2468,"_5":28905,"_19778":54044,"_25987":54045,"_2719":54046},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3226":2479,"_28565":2468,"_5":28905,"_19778":54048,"_25987":54049,"_2719":54050},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3226":2480,"_28565":2468,"_5":28905,"_19778":54052,"_25987":54053,"_2719":54054},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3226":2481,"_28565":2468,"_5":28905,"_19778":54056,"_25987":54057,"_2719":54058},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3226":2482,"_28565":2468,"_5":28905,"_19778":54060,"_25987":54061,"_2719":54062},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3226":2483,"_28565":2468,"_5":28905,"_19778":54064,"_25987":54065,"_2719":54066},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3226":2484,"_28565":2468,"_5":28905,"_19778":54068,"_25987":54069,"_2719":54070},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3226":2485,"_28565":2468,"_5":28905,"_19778":54072,"_25987":54073,"_2719":54074},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3226":2486,"_28565":2468,"_5":28905,"_19778":54076,"_25987":54077,"_2719":54078},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3226":2487,"_28565":2468,"_5":28905,"_19778":54080,"_25987":54081,"_2719":54082},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3226":2488,"_28565":2468,"_5":28905,"_19778":54084,"_25987":54085,"_2719":54086},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3226":2489,"_28565":2468,"_5":28905,"_19778":54088,"_25987":54089,"_2719":54090},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3226":2490,"_28565":2468,"_5":28905,"_19778":54092,"_25987":54093,"_2719":54094},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3226":2491,"_28565":2468,"_5":28905,"_19778":54096,"_25987":54097,"_2719":54098},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3226":2492,"_28565":2468,"_5":28905,"_19778":54100,"_25987":54101,"_2719":54102},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3226":2493,"_28565":2468,"_5":28905,"_19778":54104,"_25987":54105,"_2719":54106},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3226":2494,"_28565":2468,"_5":28905,"_19778":54108,"_25987":54109,"_2719":54110},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3226":2495,"_28565":2468,"_5":28905,"_19778":54112,"_25987":54113,"_2719":54114},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3226":2496,"_28565":2468,"_5":28905,"_19778":54116,"_25987":54117,"_2719":54118},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3226":2497,"_28565":2468,"_5":28905,"_19778":54120,"_25987":54121,"_2719":54122},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3226":2498,"_28565":2468,"_5":28905,"_19778":54124,"_25987":54125,"_2719":54126},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3226":2499,"_28565":2468,"_5":28905,"_19778":54128,"_25987":54129,"_2719":54130},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3226":2500,"_28565":2468,"_5":28905,"_19778":54132,"_25987":54133,"_2719":54134},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3226":2501,"_28565":2468,"_5":28905,"_19778":54136,"_25987":54137,"_2719":54138},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3226":2502,"_28565":2468,"_5":28905,"_19778":54140,"_25987":54141,"_2719":54142},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3226":2503,"_28565":2468,"_5":28905,"_19778":54144,"_25987":54145,"_2719":50300},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3226":2504,"_28565":2468,"_5":28905,"_19778":54147,"_25987":54148,"_2719":54149},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3226":2505,"_28565":2468,"_5":28905,"_19778":54151,"_25987":54152,"_2719":54153},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3226":2506,"_28565":2468,"_19778":54155,"_5":13556,"_25987":2468,"_2719":54156},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3226":2507,"_28565":2468,"_19778":54158,"_5":13556,"_25987":2468,"_2719":54159},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3226":2508,"_28565":2468,"_19778":54161,"_5":13556,"_25987":2468,"_2719":54162},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3226":2509,"_28565":2468,"_19778":54164,"_5":13556,"_25987":2468,"_2719":54165},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3226":2510,"_28565":2468,"_19778":54167,"_5":13556,"_25987":2468,"_2719":54168},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3226":2511,"_28565":2468,"_19778":54170,"_5":13556,"_25987":2468,"_2719":54171},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3226":2512,"_28565":2468,"_19778":54173,"_5":13556,"_25987":2468,"_2719":54174},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3226":2513,"_28565":2468,"_19778":54176,"_5":13556,"_25987":54017,"_2719":54177},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3226":2514,"_28565":2468,"_19778":54179,"_5":13556,"_25987":54017,"_2719":54180},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3226":2515,"_28565":2468,"_19778":54182,"_5":13556,"_25987":54021,"_2719":54183},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3226":2516,"_28565":2468,"_19778":54185,"_5":13556,"_25987":54021,"_2719":54186},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3226":2517,"_28565":2468,"_19778":54188,"_5":13556,"_25987":54025,"_2719":54189},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3226":2518,"_28565":2468,"_19778":54191,"_5":13556,"_25987":54029,"_2719":54192},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3226":2519,"_28565":2468,"_19778":54194,"_5":13556,"_25987":54029,"_2719":54195},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3226":2520,"_28565":2468,"_19778":54197,"_5":13556,"_25987":54029,"_2719":54198},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3226":2521,"_28565":2468,"_19778":54200,"_5":13556,"_25987":54029,"_2719":54201},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3226":2522,"_28565":2468,"_19778":54203,"_5":13556,"_25987":54029,"_2719":54204},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3226":2523,"_28565":2468,"_19778":54206,"_5":13556,"_25987":54033,"_2719":54207},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3226":2524,"_28565":2468,"_19778":54209,"_5":13556,"_25987":54033,"_2719":54210},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3226":2525,"_28565":2468,"_19778":54212,"_5":13556,"_25987":54033,"_2719":54213},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3226":2526,"_28565":2468,"_19778":54215,"_5":13556,"_25987":54033,"_2719":54216},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3226":2527,"_28565":2468,"_19778":54218,"_5":13556,"_25987":54033,"_2719":54219},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3226":2528,"_28565":2468,"_19778":54221,"_5":13556,"_25987":54037,"_2719":54222},[],"Change",{"_3226":2529,"_28565":2468,"_19778":54224,"_5":13556,"_25987":54037,"_2719":54225},[],"Who is affected",{"_3226":2530,"_28565":2468,"_19778":54227,"_5":13556,"_25987":54037,"_2719":54228},[],"Severity",{"_3226":2531,"_28565":2468,"_19778":54230,"_5":13556,"_25987":54037,"_2719":52827},[],{"_3226":2532,"_28565":2468,"_19778":54232,"_5":13556,"_25987":54037,"_2719":54046},[],{"_3226":2533,"_28565":2468,"_19778":54234,"_5":13556,"_25987":54037,"_2719":54235},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3226":2534,"_28565":2468,"_19778":54237,"_5":13556,"_25987":54037,"_2719":54238},[],"High: KMS and VA start on empty volumes",{"_3226":2535,"_28565":2468,"_19778":54240,"_5":13556,"_25987":54037,"_2719":54241},[],"Copy the data into the new volumes",{"_3226":2536,"_28565":2468,"_19778":54243,"_5":13556,"_25987":54037,"_2719":54050},[],{"_3226":2537,"_28565":2468,"_19778":54245,"_5":13556,"_25987":54037,"_2719":54246},[],"Every Helm release",{"_3226":2538,"_28565":2468,"_19778":54248,"_5":13556,"_25987":54037,"_2719":54249},[],"High: `helm upgrade` fails",{"_3226":2539,"_28565":2468,"_19778":54251,"_5":13556,"_25987":54037,"_2719":54252},[],"Remove or rename legacy keys",{"_3226":2540,"_28565":2468,"_19778":54254,"_5":13556,"_25987":54037,"_2719":54054},[],{"_3226":2541,"_28565":2468,"_19778":54256,"_5":13556,"_25987":54037,"_2719":54257},[],"Every deployment",{"_3226":2542,"_28565":2468,"_19778":54259,"_5":13556,"_25987":54037,"_2719":54260},[],"High: without a bootstrap principal there is no administrator",{"_3226":2543,"_28565":2468,"_19778":54262,"_5":13556,"_25987":54037,"_2719":54263},[],"Configure `services.authz`",{"_3226":2544,"_28565":2468,"_19778":54265,"_5":13556,"_25987":54037,"_2719":54058},[],{"_3226":2545,"_28565":2468,"_19778":54267,"_5":13556,"_25987":54037,"_2719":54246},[],{"_3226":2546,"_28565":2468,"_19778":54269,"_5":13556,"_25987":54037,"_2719":54270},[],"High: `helm upgrade` fails on the old keys",{"_3226":2547,"_28565":2468,"_19778":54272,"_5":13556,"_25987":54037,"_2719":54273},[],"Move JWKS and roles into `services.authz`",{"_3226":2548,"_28565":2468,"_19778":54275,"_5":13556,"_25987":54037,"_2719":54078},[],{"_3226":2549,"_28565":2468,"_19778":54277,"_5":13556,"_25987":54037,"_2719":54278},[],"3.8.0 deployments with per-service databases",{"_3226":2550,"_28565":2468,"_19778":54280,"_5":13556,"_25987":54037,"_2719":54281},[],"High: services find no data, or a migration aborts",{"_3226":2551,"_28565":2468,"_19778":54283,"_5":13556,"_25987":54037,"_2719":54284},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3226":2552,"_28565":2468,"_19778":54286,"_5":13556,"_25987":54037,"_2719":54082},[],{"_3226":2553,"_28565":2468,"_19778":54288,"_5":13556,"_25987":54037,"_2719":54289},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3226":2554,"_28565":2468,"_19778":54291,"_5":13556,"_25987":54037,"_2719":54292},[],"High: the backend no longer starts with them",{"_3226":2555,"_28565":2468,"_19778":54294,"_5":13556,"_25987":54037,"_2719":54295},[],"Move to PostgreSQL before upgrading",{"_3226":2556,"_28565":2468,"_19778":54297,"_5":13556,"_25987":54037,"_2719":54298},[],"Webhooks with file references",{"_3226":2557,"_28565":2468,"_19778":54300,"_5":13556,"_25987":54037,"_2719":54301},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3226":2558,"_28565":2468,"_19778":54303,"_5":13556,"_25987":54037,"_2719":54304},[],"High: enrollments calling the webhook fail",{"_3226":2559,"_28565":2468,"_19778":54306,"_5":13556,"_25987":54037,"_2719":54307},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3226":2560,"_28565":2468,"_19778":54309,"_5":13556,"_25987":54037,"_2719":54062},[],{"_3226":2561,"_28565":2468,"_19778":54311,"_5":13556,"_25987":54037,"_2719":54312},[],"Releases with per-service identity overrides or mounted key material",{"_3226":2562,"_28565":2468,"_19778":54314,"_5":13556,"_25987":54037,"_2719":54315},[],"Medium: services cannot read their files",{"_3226":2563,"_28565":2468,"_19778":54317,"_5":13556,"_25987":54037,"_2719":54318},[],"Remove the overrides and fix volume ownership",{"_3226":2564,"_28565":2468,"_19778":54320,"_5":13556,"_25987":54037,"_2719":54066},[],{"_3226":2565,"_28565":2468,"_19778":54322,"_5":13556,"_25987":54037,"_2719":54323},[],"Releases that set `amqp.tls`",{"_3226":2566,"_28565":2468,"_19778":54325,"_5":13556,"_25987":54037,"_2719":54326},[],"Medium: clients connect to the wrong port",{"_3226":2567,"_28565":2468,"_19778":54328,"_5":13556,"_25987":54037,"_2719":54329},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3226":2568,"_28565":2468,"_19778":54331,"_5":13556,"_25987":54037,"_2719":54086},[],{"_3226":2569,"_28565":2468,"_19778":54333,"_5":13556,"_25987":54037,"_2719":54334},[],"Installations whose CA keys predate the KMS",{"_3226":2570,"_28565":2468,"_19778":54336,"_5":13556,"_25987":54037,"_2719":54337},[],"Medium: CA keys stay unmanaged",{"_3226":2571,"_28565":2468,"_19778":54339,"_5":13556,"_25987":54037,"_2719":54340},[],"Run the CA-to-KMS migration",{"_3226":2572,"_28565":2468,"_19778":54342,"_5":13556,"_25987":54037,"_2719":54343},[],"Receiver certificate verification",{"_3226":2573,"_28565":2468,"_19778":54345,"_5":13556,"_25987":54037,"_2719":54346},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3226":2574,"_28565":2468,"_19778":54348,"_5":13556,"_25987":54037,"_2719":54349},[],"Medium: credentials go to an unverified receiver",{"_3226":2575,"_28565":2468,"_19778":54351,"_5":13556,"_25987":54037,"_2719":54352},[],"Set `insecure_skip_verify` to `false`",{"_3226":2576,"_28565":2468,"_19778":54354,"_5":13556,"_25987":54037,"_2719":54098},[],{"_3226":2577,"_28565":2468,"_19778":54356,"_5":13556,"_25987":54037,"_2719":54357},[],"Scripts and consoles that edit DMSs through the API",{"_3226":2578,"_28565":2468,"_19778":54359,"_5":13556,"_25987":54037,"_2719":54360},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3226":2579,"_28565":2468,"_19778":54362,"_5":13556,"_25987":54037,"_2719":54363},[],"Read the DMS before editing and use the new field",{"_3226":2580,"_28565":2468,"_19778":54365,"_5":13556,"_25987":54037,"_2719":54114},[],{"_3226":2581,"_28565":2468,"_19778":54367,"_5":13556,"_25987":54037,"_2719":54368},[],"Consumers that read the device `events` field",{"_3226":2582,"_28565":2468,"_19778":54370,"_5":13556,"_25987":54037,"_2719":54371},[],"Medium: the field disappears",{"_3226":2583,"_28565":2468,"_19778":54373,"_5":13556,"_25987":54037,"_2719":54374},[],"Use the new event endpoints",{"_3226":2584,"_28565":2468,"_19778":54376,"_5":13556,"_25987":54037,"_2719":54070},[],{"_3226":2585,"_28565":2468,"_19778":54378,"_5":13556,"_25987":54037,"_2719":54379},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3226":2586,"_28565":2468,"_19778":54381,"_5":13556,"_25987":54037,"_2719":54382},[],"Low to medium: validation errors or changed defaults",{"_3226":2587,"_28565":2468,"_19778":54384,"_5":13556,"_25987":54037,"_2719":54385},[],"Update the values file",{"_3226":2588,"_28565":2468,"_19778":54387,"_5":13556,"_25987":54037,"_2719":54106},[],{"_3226":2589,"_28565":2468,"_19778":54389,"_5":13556,"_25987":54037,"_2719":54390},[],"Clients that send the DMS ID in the update body",{"_3226":2590,"_28565":2468,"_19778":54392,"_5":13556,"_25987":54037,"_2719":54393},[],"Low: the ID in the URL wins",{"_3226":2591,"_28565":2468,"_19778":54395,"_5":13556,"_25987":54037,"_2719":54396},[],"Send the ID in the URL",{"_3226":2592,"_28565":2468,"_19778":54398,"_5":13556,"_25987":54037,"_2719":54110},[],{"_3226":2593,"_28565":2468,"_19778":54400,"_5":13556,"_25987":54037,"_2719":54401},[],"Consumers that match on certificate `type`",{"_3226":2594,"_28565":2468,"_19778":54403,"_5":13556,"_25987":54037,"_2719":54404},[],"Low: two values are renamed",{"_3226":2595,"_28565":2468,"_19778":54406,"_5":13556,"_25987":54037,"_2719":54407},[],"Adapt consumers",{"_3226":2596,"_28565":2468,"_19778":54409,"_5":13556,"_25987":54037,"_2719":54102},[],{"_3226":2597,"_28565":2468,"_19778":54411,"_5":13556,"_25987":54037,"_2719":54412},[],"Any DMS",{"_3226":2598,"_28565":2468,"_19778":54414,"_5":13556,"_25987":54037,"_2719":54415},[],"Low: informational",{"_3226":2599,"_28565":2468,"_19778":54417,"_5":13556,"_25987":54037,"_2719":54418},[],"Read both blocks before editing",{"_3226":2600,"_28565":2468,"_19778":54420,"_5":13556,"_25987":54045,"_2719":54421},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3226":2601,"_28565":2468,"_19778":54423,"_5":13556,"_25987":54045,"_2719":54424},[],"Step 4 of the migration guide copies the data.",{"_3226":2602,"_28565":2468,"_19778":54426,"_5":13556,"_25987":54049,"_2719":54427},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3226":2603,"_28565":2468,"_19778":54429,"_5":13556,"_25987":54053,"_2719":54430},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3226":2604,"_28565":2468,"_19778":54432,"_5":13556,"_25987":54057,"_2719":54433},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3226":2605,"_28565":2468,"_19778":54435,"_5":13556,"_25987":54061,"_2719":54436},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3226":2606,"_28565":2468,"_19778":54438,"_5":13556,"_25987":54061,"_2719":54439},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3226":2607,"_28565":2468,"_19778":54441,"_5":13556,"_25987":54065,"_2719":54442},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3226":2608,"_28565":2468,"_19778":54444,"_5":13556,"_25987":54069,"_2719":54445},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3226":2609,"_28565":2468,"_19778":54447,"_5":13556,"_25987":54069,"_2719":54448},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3226":2610,"_28565":2468,"_19778":54450,"_5":13556,"_25987":54069,"_2719":54451},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3226":2611,"_28565":2468,"_19778":54453,"_5":13556,"_25987":54069,"_2719":54454},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3226":2612,"_28565":2468,"_19778":54456,"_5":13556,"_25987":54069,"_2719":54457},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3226":2613,"_28565":2468,"_19778":54459,"_5":13556,"_25987":54069,"_2719":54460},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3226":2614,"_28565":2468,"_19778":54462,"_5":13556,"_25987":54077,"_2719":54463},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3226":2615,"_28565":2468,"_19778":54465,"_5":13556,"_25987":54077,"_2719":54466},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3226":2616,"_28565":2468,"_19778":54468,"_5":13556,"_25987":54077,"_2719":54469},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3226":2617,"_28565":2468,"_19778":54471,"_5":13556,"_25987":54077,"_2719":54472},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3226":2618,"_28565":2468,"_19778":54474,"_5":13556,"_25987":54077,"_2719":54475},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3226":2619,"_28565":2468,"_19778":54477,"_5":13556,"_25987":54081,"_2719":54478},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3226":2620,"_28565":2468,"_19778":54480,"_5":13556,"_25987":54085,"_2719":54481},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3226":2621,"_28565":2468,"_19778":54483,"_5":13556,"_25987":54085,"_2719":54484},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3226":2622,"_28565":2468,"_19778":54486,"_5":13556,"_25987":54085,"_2719":54487},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3226":2623,"_28565":2468,"_19778":54489,"_5":13556,"_25987":54085,"_2719":54490},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3226":2624,"_28565":2468,"_19778":54492,"_5":13556,"_25987":54085,"_2719":54493},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3226":2625,"_28565":2468,"_19778":54495,"_5":13556,"_25987":54085,"_2719":54496},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3226":2626,"_28565":2468,"_19778":54498,"_5":13556,"_25987":54093,"_2719":54499},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3226":2627,"_28565":2468,"_19778":54501,"_5":13556,"_25987":54093,"_2719":54502},[],"Field in 3.8.0",{"_3226":2628,"_28565":2468,"_19778":54504,"_5":13556,"_25987":54093,"_2719":54505},[],"Field in 4.0.0",{"_3226":2629,"_28565":2468,"_19778":54507,"_5":13556,"_25987":54093,"_2719":54508},[],"`validate_server_cert`",{"_3226":2630,"_28565":2468,"_19778":54510,"_5":13556,"_25987":54093,"_2719":54511},[],"`insecure_skip_verify` (value negated)",{"_3226":2631,"_28565":2468,"_19778":54513,"_5":13556,"_25987":54093,"_2719":54514},[],"`oidc`",{"_3226":2632,"_28565":2468,"_19778":54516,"_5":13556,"_25987":54093,"_2719":54517},[],"`jwt_options`",{"_3226":2633,"_28565":2468,"_19778":54519,"_5":13556,"_25987":54093,"_2719":54520},[],"`apikey`",{"_3226":2634,"_28565":2468,"_19778":54522,"_5":13556,"_25987":54093,"_2719":54523},[],"`apikey_options`",{"_3226":2635,"_28565":2468,"_19778":54525,"_5":13556,"_25987":54093,"_2719":54526},[],"`mtls`",{"_3226":2636,"_28565":2468,"_19778":54528,"_5":13556,"_25987":54093,"_2719":54529},[],"`mtls_options`",{"_3226":2637,"_28565":2468,"_19778":54531,"_5":13556,"_25987":54093,"_2719":54532},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3226":2638,"_28565":2468,"_19778":54534,"_5":13556,"_25987":54093,"_2719":54535},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3226":2639,"_28565":2468,"_19778":54537,"_5":13556,"_25987":54093,"_2719":54538},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3226":2640,"_28565":2468,"_19778":54540,"_5":13556,"_25987":54097,"_2719":54541},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3226":2641,"_28565":2468,"_19778":54543,"_5":13556,"_25987":54097,"_2719":54544},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3226":2642,"_28565":2468,"_19778":54546,"_5":13556,"_25987":54097,"_2719":54547},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3226":2643,"_28565":2468,"_19778":54549,"_5":13556,"_25987":54101,"_2719":54550},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3226":2644,"_28565":2468,"_19778":54552,"_5":13556,"_25987":54105,"_2719":54553},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3226":2645,"_28565":2468,"_19778":54555,"_5":13556,"_25987":54109,"_2719":54556},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3226":2646,"_28565":2468,"_19778":54558,"_5":13556,"_25987":54113,"_2719":54559},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3226":2647,"_28565":2468,"_19778":54561,"_5":13556,"_25987":54113,"_2719":54562},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3226":2648,"_28565":2468,"_19778":54564,"_5":13556,"_25987":54113,"_2719":54565},[],"`POST /v1/devices/:id/events` creates an event.",{"_3226":2649,"_28565":2468,"_19778":54567,"_5":13556,"_25987":54113,"_2719":54568},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3226":2650,"_28565":2468,"_19778":54570,"_5":13556,"_25987":54117,"_2719":54571},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3226":2651,"_28565":2468,"_19778":54573,"_5":13556,"_25987":54121,"_2719":54574},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3226":2652,"_28565":2468,"_19778":54576,"_5":13556,"_25987":54121,"_2719":54577},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3226":2653,"_28565":2468,"_19778":54579,"_5":13556,"_25987":54121,"_2719":54580},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3226":2654,"_28565":2468,"_19778":54582,"_5":13556,"_25987":54121,"_2719":54583},[],"Record the names of your local-storage PVCs:",{"_3226":2655,"_28565":2468,"_19778":54585,"_5":13556,"_25987":54121,"_2719":54586},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3226":2656,"_28565":2468,"_19778":54588,"_5":13556,"_25987":54125,"_2719":54589},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3226":2657,"_28565":2468,"_19778":54591,"_5":13556,"_25987":54125,"_2719":54592},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3226":2658,"_28565":2468,"_19778":54594,"_5":13556,"_25987":54125,"_2719":54595},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3226":2659,"_28565":2468,"_19778":54597,"_5":13556,"_25987":54125,"_2719":54598},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3226":2660,"_28565":2468,"_19778":54600,"_5":13556,"_25987":54125,"_2719":54601},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3226":2661,"_28565":2468,"_19778":54603,"_5":13556,"_25987":54125,"_2719":54604},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3226":2662,"_28565":2468,"_19778":54606,"_5":13556,"_25987":54125,"_2719":54607},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3226":2663,"_28565":2468,"_19778":54609,"_5":13556,"_25987":54125,"_2719":54610},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3226":2664,"_28565":2468,"_19778":54612,"_5":13556,"_25987":54125,"_2719":54613},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3226":2665,"_28565":2468,"_19778":54615,"_5":13556,"_25987":54125,"_2719":54616},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3226":2666,"_28565":2468,"_19778":54618,"_5":13556,"_25987":54125,"_2719":54619},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3226":2667,"_28565":2468,"_19778":54621,"_5":13556,"_25987":54125,"_2719":54622},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3226":2668,"_28565":2468,"_19778":54624,"_5":13556,"_25987":54129,"_2719":54625},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3226":2669,"_28565":2468,"_19778":54627,"_5":13556,"_25987":54129,"_2719":54628},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3226":2670,"_28565":2468,"_19778":54630,"_5":13556,"_25987":54133,"_2719":54631},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3226":2671,"_28565":2468,"_19778":54633,"_5":13556,"_25987":54133,"_2719":54634},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3226":2672,"_28565":2468,"_19778":54636,"_5":13556,"_25987":54133,"_2719":54637},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3226":2673,"_28565":2468,"_19778":54639,"_5":13556,"_25987":54133,"_2719":54640},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3226":2674,"_28565":2468,"_19778":54642,"_5":13556,"_25987":54133,"_2719":54643},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3226":2675,"_28565":2468,"_19778":54645,"_5":13556,"_25987":54133,"_2719":54646},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3226":2676,"_28565":2468,"_19778":54648,"_5":13556,"_25987":54133,"_2719":54649},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3226":2677,"_28565":2468,"_19778":54651,"_5":13556,"_25987":54133,"_2719":54652},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3226":2678,"_28565":2468,"_19778":54654,"_5":13556,"_25987":54133,"_2719":54655},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3226":2679,"_28565":2468,"_19778":54657,"_5":13556,"_25987":54133,"_2719":54658},[],"**Remove the helper and restore the recorded replica counts:**",{"_3226":2680,"_28565":2468,"_19778":54660,"_5":13556,"_25987":54133,"_2719":54661},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3226":2681,"_28565":2468,"_19778":54663,"_5":13556,"_25987":54137,"_2719":54664},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3226":2682,"_28565":2468,"_19778":54666,"_5":13556,"_25987":54137,"_2719":54667},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3226":2683,"_28565":2468,"_19778":54669,"_5":13556,"_25987":54141,"_2719":54670},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3226":2684,"_28565":2468,"_19778":54672,"_5":13556,"_25987":54141,"_2719":54673},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3226":2685,"_28565":2468,"_19778":54675,"_5":13556,"_25987":54141,"_2719":54676},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3226":2686,"_28565":2468,"_19778":54678,"_5":13556,"_25987":54141,"_2719":54679},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3226":2687,"_28565":2468,"_19778":54681,"_5":13556,"_25987":54141,"_2719":54682},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3226":2688,"_28565":2468,"_19778":54684,"_5":13556,"_25987":54145,"_2719":54685},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3226":2689,"_28565":2468,"_19778":54687,"_5":13556,"_25987":54145,"_2719":54688},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3226":2690,"_28565":2468,"_19778":54690,"_5":13556,"_25987":54145,"_2719":54691},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3226":2691,"_28565":2468,"_19778":54693,"_5":13556,"_25987":54145,"_2719":54694},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3226":2692,"_28565":2468,"_19778":54696,"_5":13556,"_25987":54145,"_2719":54697},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3226":2693,"_28565":2468,"_19778":54699,"_5":13556,"_25987":54145,"_2719":54700},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3226":2694,"_28565":2468,"_19778":54702,"_5":13556,"_25987":54145,"_2719":54703},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3226":2695,"_28565":2468,"_19778":54705,"_5":13556,"_25987":54148,"_2719":54706},[],"After the upgrade, check in this order:",{"_3226":2696,"_28565":2468,"_19778":54708,"_5":13556,"_25987":54148,"_2719":54709},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3226":2697,"_28565":2468,"_19778":54711,"_5":13556,"_25987":54148,"_2719":54712},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3226":2698,"_28565":2468,"_19778":54714,"_5":13556,"_25987":54148,"_2719":54715},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3226":2699,"_28565":2468,"_19778":54717,"_5":13556,"_25987":54148,"_2719":54718},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3226":2700,"_28565":2468,"_19778":54720,"_5":13556,"_25987":54148,"_2719":54721},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3226":2701,"_28565":2468,"_19778":54723,"_5":13556,"_25987":54148,"_2719":54724},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3226":2702,"_28565":2468,"_19778":54726,"_5":13556,"_25987":54148,"_2719":54727},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3226":2703,"_28565":2468,"_19778":54729,"_5":13556,"_25987":54148,"_2719":54730},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3226":2704,"_28565":2468,"_19778":54732,"_5":13556,"_25987":54148,"_2719":54733},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3226":2705,"_28565":2468,"_19778":54735,"_5":13556,"_25987":54148,"_2719":54736},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3226":2706,"_28565":2468,"_19778":54738,"_5":13556,"_25987":54148,"_2719":54739},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3226":2707,"_28565":2468,"_19778":54741,"_5":13556,"_25987":54148,"_2719":54742},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3226":2708,"_28565":2468,"_19778":54744,"_5":13556,"_25987":54148,"_2719":54745},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3226":2709,"_28565":2468,"_19778":54747,"_5":13556,"_25987":54148,"_2719":54748},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3226":2710,"_28565":2468,"_19778":54750,"_5":13556,"_25987":54152,"_2719":54751},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3226":2711,"_28565":2468,"_19778":54753,"_5":13556,"_25987":54152,"_2719":54754},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3226":2712,"_28565":2468,"_19778":54756,"_5":13556,"_25987":54152,"_2719":54757},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3226":2713,"_28565":2468,"_19778":54759,"_5":13556,"_25987":54152,"_2719":54760},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3226":2714,"_28565":2468,"_19778":54762,"_5":13556,"_25987":54152,"_2719":54763},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_54766":54767,"_54768":54769,"_54770":54771,"_54772":54773,"_17145":2741,"_65587":2741},"language","english","sortableProperties",[2719,28565,5,25987],"sortablePropertiesWithTypes",{"_2719":23638,"_28565":23638,"_5":23638,"_25987":23638},"sorts",{"_2719":54774,"_28565":57478,"_5":60181,"_25987":62884},{"_4349":54775,"_54776":54777,"_5":23638},{"_13638":11485,"_14013":20313,"_14032":8225,"_12234":3313,"_14019":4060,"_18784":2997,"_13659":4834,"_13666":3100,"_27552":7100,"_27960":16934,"_27981":5597,"_27586":6905,"_32738":3782,"_27688":