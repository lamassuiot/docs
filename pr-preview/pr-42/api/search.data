0":103456,"_33682":103459,"_33684":103462,"_33686":103464,"_33688":103466,"_33690":103469,"_33692":103472,"_33694":103475,"_33696":103478,"_33698":103481,"_33700":103484,"_33702":103487,"_33704":103490,"_33706":103493,"_33708":103496,"_33710":103499,"_33712":103502,"_33714":103505,"_33716":103508,"_33718":103511,"_33720":103514,"_33722":103518,"_33724":103521,"_33726":103524,"_33728":103528,"_33730":103531,"_33732":103535,"_33734":103538,"_33736":103541,"_33738":103544,"_33740":103547,"_33742":103550,"_33744":103553,"_33746":103556,"_33748":103559,"_33750":103562,"_33752":103565,"_33754":103568,"_33756":103570,"_33758":103573,"_33760":103576,"_33762":103579,"_33764":103582,"_33766":103585,"_33768":103588,"_33770":103591,"_33772":103594,"_33774":103597,"_33776":103600,"_33778":103605,"_33780":103608,"_33782":103612,"_33784":103616,"_33786":103620,"_33788":103623,"_33790":103626,"_33792":103628,"_33794":103630,"_33796":103632,"_33798":103634,"_33800":103637,"_33802":103640,"_33804":103643,"_33806":103646,"_33808":103649,"_33810":103651,"_33812":103654,"_33814":103656,"_33816":103659,"_33818":103662,"_33820":103665,"_33822":103667,"_33824":103670,"_33826":103673,"_33828":103676,"_33830":103679,"_33832":103682,"_33834":103685,"_33836":103688,"_33838":103691,"_33840":103694,"_33842":103697,"_33844":103700,"_33846":103703},{"_2871":58085,"_25310":58085,"_5":12413,"_2398":96398,"_25646":96399,"_17659":96402,"_23935":58085},"Despliega desde AWS Marketplace",[41060,96400,96401],"Despliegue","Otros modelos",[],{"_2871":58086,"_25310":58085,"_17659":96404,"_5":17554,"_23935":58085,"_2398":96405},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2871":58087,"_25310":58085,"_5":25643,"_17659":96407,"_23935":96408,"_2398":96409},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2871":58088,"_25310":58085,"_5":25643,"_17659":96411,"_23935":96412,"_2398":96413},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2871":58089,"_25310":58085,"_5":25643,"_17659":96415,"_23935":96416,"_2398":96417},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2871":58090,"_25310":58085,"_5":25643,"_17659":96419,"_23935":96420,"_2398":96421},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2871":58091,"_25310":58085,"_5":25643,"_17659":96423,"_23935":96424,"_2398":96425},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2871":58092,"_25310":58085,"_5":25643,"_17659":96427,"_23935":96428,"_2398":96429},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2871":58093,"_25310":58085,"_5":25643,"_17659":96431,"_23935":96432,"_2398":96433},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2871":58094,"_25310":58085,"_17659":96435,"_5":17554,"_23935":58085,"_2398":96436},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2871":58095,"_25310":58085,"_17659":96438,"_5":17554,"_23935":96408,"_2398":96439},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2871":58096,"_25310":58085,"_17659":96441,"_5":17554,"_23935":96408,"_2398":96442},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2871":58097,"_25310":58085,"_17659":96444,"_5":17554,"_23935":96408,"_2398":96445},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2871":58098,"_25310":58085,"_17659":96447,"_5":17554,"_23935":96412,"_2398":96448},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2871":58099,"_25310":58085,"_17659":96450,"_5":17554,"_23935":96412,"_2398":96451},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2871":58100,"_25310":58085,"_17659":96453,"_5":17554,"_23935":96412,"_2398":96454},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2871":58101,"_25310":58085,"_17659":96456,"_5":17554,"_23935":96416,"_2398":96457},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2871":58102,"_25310":58085,"_17659":96459,"_5":17554,"_23935":96420,"_2398":96460},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2871":58103,"_25310":58085,"_17659":96462,"_5":17554,"_23935":96424,"_2398":96463},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2871":58104,"_25310":58085,"_17659":96465,"_5":17554,"_23935":96428,"_2398":96466},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2871":58105,"_25310":58085,"_17659":96468,"_5":17554,"_23935":96432,"_2398":96469},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2871":58106,"_25310":58106,"_5":12413,"_2398":96471,"_25646":96472,"_17659":96473,"_23935":58106},"Despliega Lamassu",[41060,96400],[],{"_2871":58107,"_25310":58106,"_17659":96475,"_5":17554,"_23935":58106,"_2398":96476},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2871":58108,"_25310":58106,"_5":25643,"_17659":96478,"_23935":96479,"_2398":96480},[],"/docs/pr-preview/pr-42/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2871":58109,"_25310":58106,"_5":25643,"_17659":96482,"_23935":96483,"_2398":96484},[],"/docs/pr-preview/pr-42/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2871":58110,"_25310":58106,"_5":25643,"_17659":96486,"_23935":96487,"_2398":96488},[],"/docs/pr-preview/pr-42/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2871":58111,"_25310":58106,"_17659":96490,"_5":17554,"_23935":58106,"_2398":96491},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2871":58112,"_25310":58106,"_17659":96493,"_5":17554,"_23935":96479,"_2398":96494},[],"Modelo",{"_2871":58113,"_25310":58106,"_17659":96496,"_5":17554,"_23935":96479,"_2398":96497},[],"Recomendado para",{"_2871":58114,"_25310":58106,"_17659":96499,"_5":17554,"_23935":96479,"_2398":96500},[],"Quién opera la infraestructura",{"_2871":58115,"_25310":58106,"_17659":96502,"_5":17554,"_23935":96479,"_2398":96503},[],"Punto de partida",{"_2871":58116,"_25310":58106,"_17659":96505,"_5":17554,"_23935":96479,"_2398":41167},[],{"_2871":58117,"_25310":58106,"_17659":96507,"_5":17554,"_23935":96479,"_2398":96508},[],"Producción, entornos regulados y despliegues personalizados",{"_2871":58118,"_25310":58106,"_17659":96510,"_5":17554,"_23935":96479,"_2398":96511},[],"Tu equipo",{"_2871":58119,"_25310":58106,"_17659":96513,"_5":17554,"_23935":96479,"_2398":96514},[],"Helm o Fastlane",{"_2871":58120,"_25310":58106,"_17659":96516,"_5":17554,"_23935":96479,"_2398":41179},[],{"_2871":58121,"_25310":58106,"_17659":96518,"_5":17554,"_23935":96479,"_2398":96519},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2871":58122,"_25310":58106,"_17659":96521,"_5":17554,"_23935":96479,"_2398":96511},[],{"_2871":58123,"_25310":58106,"_17659":96523,"_5":17554,"_23935":96479,"_2398":96524},[],"Imagen preconfigurada en EC2",{"_2871":58124,"_25310":58106,"_17659":96526,"_5":17554,"_23935":96479,"_2398":41190},[],{"_2871":58125,"_25310":58106,"_17659":96528,"_5":17554,"_23935":96479,"_2398":96529},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2871":58126,"_25310":58106,"_17659":96531,"_5":17554,"_23935":96479,"_2398":41196},[],{"_2871":58127,"_25310":58106,"_17659":96533,"_5":17554,"_23935":96479,"_2398":96534},[],"Suscripción gestionada",{"_2871":58128,"_25310":58106,"_17659":96536,"_5":17554,"_23935":96479,"_2398":96537},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2871":58129,"_25310":58106,"_17659":96539,"_5":17554,"_23935":96479,"_2398":96540},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2871":58130,"_25310":58106,"_17659":96542,"_5":17554,"_23935":96479,"_2398":96543},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2871":58131,"_25310":58106,"_17659":96545,"_5":17554,"_23935":96483,"_2398":96546},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2871":58132,"_25310":58106,"_17659":96548,"_5":17554,"_23935":96487,"_2398":96549},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2871":58133,"_25310":58133,"_5":12413,"_2398":96551,"_25646":96552,"_17659":96553,"_23935":58133},"Utiliza Lamassu como SaaS",[41060,96400,96401],[],{"_2871":58134,"_25310":58133,"_17659":96555,"_5":17554,"_23935":58133,"_2398":96556},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2871":58135,"_25310":58133,"_5":25643,"_17659":96558,"_23935":96559,"_2398":96560},[],"/docs/pr-preview/pr-42/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2871":58136,"_25310":58133,"_5":25643,"_17659":96562,"_23935":96563,"_2398":96564},[],"/docs/pr-preview/pr-42/es/deployment/saas#planes","Planes",{"_2871":58137,"_25310":58133,"_5":25643,"_17659":96566,"_23935":96567,"_2398":96568},[],"/docs/pr-preview/pr-42/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2871":58138,"_25310":58133,"_17659":96570,"_5":17554,"_23935":58133,"_2398":96571},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2871":58139,"_25310":58133,"_17659":96573,"_5":17554,"_23935":96559,"_2398":96574},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2871":58140,"_25310":58133,"_17659":96576,"_5":17554,"_23935":96559,"_2398":96577},[],"Copias de seguridad automáticas.",{"_2871":58141,"_25310":58133,"_17659":96579,"_5":17554,"_23935":96559,"_2398":96580},[],"Actualizaciones de versión.",{"_2871":58142,"_25310":58133,"_17659":96582,"_5":17554,"_23935":96559,"_2398":96583},[],"Soporte técnico y SLA según el plan contratado.",{"_2871":58143,"_25310":58133,"_17659":96585,"_5":17554,"_23935":96563,"_2398":41251},[],{"_2871":58144,"_25310":58133,"_17659":96587,"_5":17554,"_23935":96563,"_2398":96588},[],"Dispositivos",{"_2871":58145,"_25310":58133,"_17659":96590,"_5":17554,"_23935":96563,"_2398":96591},[],"Soporte",{"_2871":58146,"_25310":58133,"_17659":96593,"_5":17554,"_23935":96563,"_2398":41260},[],{"_2871":58147,"_25310":58133,"_17659":96595,"_5":17554,"_23935":96563,"_2398":41263},[],{"_2871":58148,"_25310":58133,"_17659":96597,"_5":17554,"_23935":96563,"_2398":96598},[],"Hasta 1.000",{"_2871":58149,"_25310":58133,"_17659":96600,"_5":17554,"_23935":96563,"_2398":41269},[],{"_2871":58150,"_25310":58133,"_17659":96602,"_5":17554,"_23935":96563,"_2398":96603},[],"99,5 %",{"_2871":58151,"_25310":58133,"_17659":96605,"_5":17554,"_23935":96563,"_2398":41275},[],{"_2871":58152,"_25310":58133,"_17659":96607,"_5":17554,"_23935":96563,"_2398":96608},[],"Hasta 10.000",{"_2871":58153,"_25310":58133,"_17659":96610,"_5":17554,"_23935":96563,"_2398":96611},[],"Email y chat",{"_2871":58154,"_25310":58133,"_17659":96613,"_5":17554,"_23935":96563,"_2398":96614},[],"99,9 %",{"_2871":58155,"_25310":58133,"_17659":96616,"_5":17554,"_23935":96563,"_2398":41287},[],{"_2871":58156,"_25310":58133,"_17659":96618,"_5":17554,"_23935":96563,"_2398":96619},[],"Ilimitados",{"_2871":58157,"_25310":58133,"_17659":96621,"_5":17554,"_23935":96563,"_2398":96622},[],"Dedicado",{"_2871":58158,"_25310":58133,"_17659":96624,"_5":17554,"_23935":96563,"_2398":96625},[],"99,99 %",{"_2871":58159,"_25310":58133,"_17659":96627,"_5":17554,"_23935":96567,"_2398":96628},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2871":58160,"_25310":58133,"_17659":96630,"_5":17554,"_23935":96567,"_2398":96631},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2871":58161,"_25310":58161,"_5":12413,"_2398":41304,"_25646":96633,"_17659":96635,"_23935":58161},[41060,96400,96634],"Kubernetes autogestionado",[],{"_2871":58162,"_25310":58161,"_17659":96637,"_5":17554,"_23935":58161,"_2398":96638},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2871":58163,"_25310":58161,"_5":25643,"_17659":96640,"_23935":96641,"_2398":96642},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2871":58164,"_25310":58161,"_5":25643,"_17659":96644,"_23935":96645,"_2398":96646},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2871":58165,"_25310":58161,"_5":25643,"_17659":96648,"_23935":96649,"_2398":96650},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2871":58166,"_25310":58161,"_5":25643,"_17659":96652,"_23935":96653,"_2398":96654},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2871":58167,"_25310":58161,"_5":25643,"_17659":96656,"_23935":96657,"_2398":96658},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2871":58168,"_25310":58161,"_5":25643,"_17659":96660,"_23935":96661,"_2398":96662},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2871":58169,"_25310":58161,"_5":25643,"_17659":96664,"_23935":96665,"_2398":96666},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2871":58170,"_25310":58161,"_5":25643,"_17659":96668,"_23935":96669,"_2398":96670},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2871":58171,"_25310":58161,"_5":25643,"_17659":96672,"_23935":96673,"_2398":96674},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2871":58172,"_25310":58161,"_5":25643,"_17659":96676,"_23935":96677,"_2398":96678},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2871":58173,"_25310":58161,"_17659":96680,"_5":17554,"_23935":96641,"_2398":96681},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2871":58174,"_25310":58161,"_17659":96683,"_5":17554,"_23935":96641,"_2398":96684},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2871":58175,"_25310":58161,"_17659":96686,"_5":17554,"_23935":96645,"_2398":96687},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2871":58176,"_25310":58161,"_17659":96689,"_5":17554,"_23935":96645,"_2398":96690},[],"Fastlane instala o configura",{"_2871":58177,"_25310":58161,"_17659":96692,"_5":17554,"_23935":96645,"_2398":96693},[],"Tú sigues proporcionando",{"_2871":58178,"_25310":58161,"_17659":96695,"_5":17554,"_23935":96645,"_2398":96696},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2871":58179,"_25310":58161,"_17659":96698,"_5":17554,"_23935":96645,"_2398":96699},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2871":58180,"_25310":58161,"_17659":96701,"_5":17554,"_23935":96645,"_2398":96702},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2871":58181,"_25310":58161,"_17659":96704,"_5":17554,"_23935":96645,"_2398":96705},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2871":58182,"_25310":58161,"_17659":96707,"_5":17554,"_23935":96645,"_2398":96708},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2871":58183,"_25310":58161,"_17659":96710,"_5":17554,"_23935":96645,"_2398":96711},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2871":58184,"_25310":58161,"_17659":96713,"_5":17554,"_23935":96645,"_2398":96714},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2871":58185,"_25310":58161,"_17659":96716,"_5":17554,"_23935":96645,"_2398":96717},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2871":58186,"_25310":58161,"_17659":96719,"_5":17554,"_23935":96645,"_2398":96720},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2871":58187,"_25310":58161,"_17659":96722,"_5":17554,"_23935":96649,"_2398":96723},[],"Necesitas:",{"_2871":58188,"_25310":58161,"_17659":96725,"_5":17554,"_23935":96649,"_2398":96726},[],"un clúster Kubernetes existente",{"_2871":58189,"_25310":58161,"_17659":96728,"_5":17554,"_23935":96649,"_2398":96729},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2871":58190,"_25310":58161,"_17659":96731,"_5":17554,"_23935":96649,"_2398":41402},[],{"_2871":58191,"_25310":58161,"_17659":96733,"_5":17554,"_23935":96649,"_2398":19973},[],{"_2871":58192,"_25310":58161,"_17659":96735,"_5":17554,"_23935":96649,"_2398":96736},[],"`jq` solo si usas `--sample-data`",{"_2871":58193,"_25310":58161,"_17659":96738,"_5":17554,"_23935":96649,"_2398":96739},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2871":58194,"_25310":58161,"_17659":96741,"_5":17554,"_23935":96649,"_2398":96742},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2871":58195,"_25310":58161,"_17659":96744,"_5":17554,"_23935":96649,"_2398":96745},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2871":58196,"_25310":58161,"_17659":96747,"_5":17554,"_23935":96653,"_2398":96748},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2871":58197,"_25310":58161,"_17659":96750,"_5":17554,"_23935":96653,"_2398":96751},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2871":58198,"_25310":58161,"_17659":96753,"_5":17554,"_23935":96657,"_2398":96754},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2871":58199,"_25310":58161,"_17659":96756,"_5":17554,"_23935":96657,"_2398":96757},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2871":58200,"_25310":58161,"_17659":96759,"_5":17554,"_23935":96657,"_2398":96760},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2871":58201,"_25310":58161,"_17659":96762,"_5":17554,"_23935":96657,"_2398":96763},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2871":58202,"_25310":58161,"_17659":96765,"_5":17554,"_23935":96661,"_2398":96766},[],"Opción",{"_2871":58203,"_25310":58161,"_17659":96768,"_5":17554,"_23935":96661,"_2398":96769},[],"Valor predeterminado",{"_2871":58204,"_25310":58161,"_17659":96771,"_5":17554,"_23935":96661,"_2398":96772},[],"Propósito",{"_2871":58205,"_25310":58161,"_17659":96774,"_5":17554,"_23935":96661,"_2398":41446},[],{"_2871":58206,"_25310":58161,"_17659":96776,"_5":17554,"_23935":96661,"_2398":41449},[],{"_2871":58207,"_25310":58161,"_17659":96778,"_5":17554,"_23935":96661,"_2398":96779},[],"Muestra la ayuda",{"_2871":58208,"_25310":58161,"_17659":96781,"_5":17554,"_23935":96661,"_2398":41455},[],{"_2871":58209,"_25310":58161,"_17659":96783,"_5":17554,"_23935":96661,"_2398":96784},[],"contexto actual",{"_2871":58210,"_25310":58161,"_17659":96786,"_5":17554,"_23935":96661,"_2398":96787},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2871":58211,"_25310":58161,"_17659":96789,"_5":17554,"_23935":96661,"_2398":41464},[],{"_2871":58212,"_25310":58161,"_17659":96791,"_5":17554,"_23935":96661,"_2398":5391},[],{"_2871":58213,"_25310":58161,"_17659":96793,"_5":17554,"_23935":96661,"_2398":96794},[],"Omite prompts y genera credenciales para las dependencias",{"_2871":58214,"_25310":58161,"_17659":96796,"_5":17554,"_23935":96661,"_2398":41472},[],{"_2871":58215,"_25310":58161,"_17659":96798,"_5":17554,"_23935":96661,"_2398":41475},[],{"_2871":58216,"_25310":58161,"_17659":96800,"_5":17554,"_23935":96661,"_2398":96801},[],"Namespace de la instalación",{"_2871":58217,"_25310":58161,"_17659":96803,"_5":17554,"_23935":96661,"_2398":41481},[],{"_2871":58218,"_25310":58161,"_17659":96805,"_5":17554,"_23935":96661,"_2398":41484},[],{"_2871":58219,"_25310":58161,"_17659":96807,"_5":17554,"_23935":96661,"_2398":96808},[],"Dominio usado por la UI, OIDC y el certificado",{"_2871":58220,"_25310":58161,"_17659":96810,"_5":17554,"_23935":96661,"_2398":41490},[],{"_2871":58221,"_25310":58161,"_17659":96812,"_5":17554,"_23935":96661,"_2398":12639},[],{"_2871":58222,"_25310":58161,"_17659":96814,"_5":17554,"_23935":96661,"_2398":96815},[],"Versión del chart de Lamassu",{"_2871":58223,"_25310":58161,"_17659":96817,"_5":17554,"_23935":96661,"_2398":41498},[],{"_2871":58224,"_25310":58161,"_17659":96819,"_5":17554,"_23935":96661,"_2398":41501},[],{"_2871":58225,"_25310":58161,"_17659":96821,"_5":17554,"_23935":96661,"_2398":96822},[],"Puerto del listener HTTPS",{"_2871":58226,"_25310":58161,"_17659":96824,"_5":17554,"_23935":96661,"_2398":41507},[],{"_2871":58227,"_25310":58161,"_17659":96826,"_5":17554,"_23935":96661,"_2398":41510},[],{"_2871":58228,"_25310":58161,"_17659":96828,"_5":17554,"_23935":96661,"_2398":96829},[],"Puerto del listener HTTP",{"_2871":58229,"_25310":58161,"_17659":96831,"_5":17554,"_23935":96661,"_2398":41516},[],{"_2871":58230,"_25310":58161,"_17659":96833,"_5":17554,"_23935":96661,"_2398":41449},[],{"_2871":58231,"_25310":58161,"_17659":96835,"_5":17554,"_23935":96661,"_2398":96836},[],"Certificado PEM para TLS downstream",{"_2871":58232,"_25310":58161,"_17659":96838,"_5":17554,"_23935":96661,"_2398":41524},[],{"_2871":58233,"_25310":58161,"_17659":96840,"_5":17554,"_23935":96661,"_2398":41449},[],{"_2871":58234,"_25310":58161,"_17659":96842,"_5":17554,"_23935":96661,"_2398":96843},[],"Clave privada PEM para TLS downstream",{"_2871":58235,"_25310":58161,"_17659":96845,"_5":17554,"_23935":96661,"_2398":41532},[],{"_2871":58236,"_25310":58161,"_17659":96847,"_5":17554,"_23935":96661,"_2398":96848},[],"chart del repositorio",{"_2871":58237,"_25310":58161,"_17659":96850,"_5":17554,"_23935":96661,"_2398":96851},[],"Usa un chart local de Lamassu sin empaquetar",{"_2871":58238,"_25310":58161,"_17659":96853,"_5":17554,"_23935":96661,"_2398":41541},[],{"_2871":58239,"_25310":58161,"_17659":96855,"_5":17554,"_23935":96661,"_2398":96856},[],"detección automática",{"_2871":58240,"_25310":58161,"_17659":96858,"_5":17554,"_23935":96661,"_2398":96859},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2871":58241,"_25310":58161,"_17659":96861,"_5":17554,"_23935":96661,"_2398":41549},[],{"_2871":58242,"_25310":58161,"_17659":96863,"_5":17554,"_23935":96661,"_2398":5391},[],{"_2871":58243,"_25310":58161,"_17659":96865,"_5":17554,"_23935":96661,"_2398":96866},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2871":58244,"_25310":58161,"_17659":96868,"_5":17554,"_23935":96661,"_2398":41557},[],{"_2871":58245,"_25310":58161,"_17659":96870,"_5":17554,"_23935":96661,"_2398":5391},[],{"_2871":58246,"_25310":58161,"_17659":96872,"_5":17554,"_23935":96661,"_2398":96873},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2871":58247,"_25310":58161,"_17659":96875,"_5":17554,"_23935":96661,"_2398":41565},[],{"_2871":58248,"_25310":58161,"_17659":96877,"_5":17554,"_23935":96661,"_2398":5391},[],{"_2871":58249,"_25310":58161,"_17659":96879,"_5":17554,"_23935":96661,"_2398":96880},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2871":58250,"_25310":58161,"_17659":96882,"_5":17554,"_23935":96661,"_2398":41573},[],{"_2871":58251,"_25310":58161,"_17659":96884,"_5":17554,"_23935":96661,"_2398":41576},[],{"_2871":58252,"_25310":58161,"_17659":96886,"_5":17554,"_23935":96661,"_2398":96887},[],"Usa otro chart local de SoftHSM",{"_2871":58253,"_25310":58161,"_17659":96889,"_5":17554,"_23935":96661,"_2398":96890},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2871":58254,"_25310":58161,"_17659":96892,"_5":17554,"_23935":96665,"_2398":41585},[],{"_2871":58255,"_25310":58161,"_17659":96894,"_5":17554,"_23935":96665,"_2398":96895},[],"valida las herramientas locales y el clúster seleccionado",{"_2871":58256,"_25310":58161,"_17659":96897,"_5":17554,"_23935":96665,"_2398":96898},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2871":58257,"_25310":58161,"_17659":96900,"_5":17554,"_23935":96665,"_2398":96901},[],"crea el namespace",{"_2871":58258,"_25310":58161,"_17659":96903,"_5":17554,"_23935":96665,"_2398":96904},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2871":58259,"_25310":58161,"_17659":96906,"_5":17554,"_23935":96665,"_2398":96907},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2871":58260,"_25310":58161,"_17659":96909,"_5":17554,"_23935":96665,"_2398":96910},[],"instala RabbitMQ",{"_2871":58261,"_25310":58161,"_17659":96912,"_5":17554,"_23935":96665,"_2398":96913},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2871":58262,"_25310":58161,"_17659":96915,"_5":17554,"_23935":96665,"_2398":96916},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2871":58263,"_25310":58161,"_17659":96918,"_5":17554,"_23935":96665,"_2398":96919},[],"carga datos de ejemplo opcionalmente",{"_2871":58264,"_25310":58161,"_17659":96921,"_5":17554,"_23935":96665,"_2398":96922},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2871":58265,"_25310":58161,"_17659":96924,"_5":17554,"_23935":96669,"_2398":96925},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2871":58266,"_25310":58161,"_17659":96927,"_5":17554,"_23935":96669,"_2398":96928},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2871":58267,"_25310":58161,"_17659":96930,"_5":17554,"_23935":96673,"_2398":96931},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2871":58268,"_25310":58161,"_17659":96933,"_5":17554,"_23935":96673,"_2398":96934},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2871":58269,"_25310":58161,"_17659":96936,"_5":17554,"_23935":96673,"_2398":96937},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2871":58270,"_25310":58161,"_17659":96939,"_5":17554,"_23935":96677,"_2398":96940},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2871":58271,"_25310":58271,"_5":12413,"_2398":96942,"_25646":96943,"_17659":96944,"_23935":58271},"Instala con Helm",[41060,96400,96634],[],{"_2871":58272,"_25310":58271,"_17659":96946,"_5":17554,"_23935":58271,"_2398":96947},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2871":58273,"_25310":58271,"_5":25643,"_17659":96949,"_23935":96950,"_2398":96951},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2871":58274,"_25310":58271,"_5":25643,"_17659":96953,"_23935":96954,"_2398":96650},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2871":58275,"_25310":58271,"_5":25643,"_17659":96956,"_23935":96957,"_2398":96958},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2871":58276,"_25310":58271,"_5":25643,"_17659":96960,"_23935":96961,"_2398":96962},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2871":58277,"_25310":58271,"_5":25643,"_17659":96964,"_23935":96965,"_2398":96966},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2871":58278,"_25310":58271,"_5":25643,"_17659":96968,"_23935":96969,"_2398":96970},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_2871":58279,"_25310":58271,"_5":25643,"_17659":96972,"_23935":96973,"_2398":96974},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2871":58280,"_25310":58271,"_5":25643,"_17659":96976,"_23935":96977,"_2398":96978},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2871":58281,"_25310":58271,"_5":25643,"_17659":96980,"_23935":96981,"_2398":96982},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2871":58282,"_25310":58271,"_5":25643,"_17659":96984,"_23935":96985,"_2398":96986},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2871":58283,"_25310":58271,"_17659":96988,"_5":17554,"_23935":96950,"_2398":96989},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2871":58284,"_25310":58271,"_17659":96991,"_5":17554,"_23935":96954,"_2398":96992},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2871":58285,"_25310":58271,"_17659":96994,"_5":17554,"_23935":96954,"_2398":96995},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2871":58286,"_25310":58271,"_17659":96997,"_5":17554,"_23935":96954,"_2398":96998},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2871":58287,"_25310":58271,"_17659":97000,"_5":17554,"_23935":96954,"_2398":97001},[],"un broker RabbitMQ accesible y sus credenciales",{"_2871":58288,"_25310":58271,"_17659":97003,"_5":17554,"_23935":96954,"_2398":97004},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2871":58289,"_25310":58271,"_17659":97006,"_5":17554,"_23935":96954,"_2398":97007},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2871":58290,"_25310":58271,"_17659":97009,"_5":17554,"_23935":96954,"_2398":97010},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2871":58291,"_25310":58271,"_17659":97012,"_5":17554,"_23935":96954,"_2398":97013},[],"una StorageClass y un diseño de tráfico externo",{"_2871":58292,"_25310":58271,"_17659":97015,"_5":17554,"_23935":96954,"_2398":97016},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2871":58293,"_25310":58271,"_17659":97018,"_5":17554,"_23935":96954,"_2398":97019},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2871":58294,"_25310":58271,"_17659":97021,"_5":17554,"_23935":96954,"_2398":97022},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2871":58295,"_25310":58271,"_17659":97024,"_5":17554,"_23935":96957,"_2398":97025},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2871":58296,"_25310":58271,"_17659":97027,"_5":17554,"_23935":96957,"_2398":97028},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2871":58297,"_25310":58271,"_17659":97030,"_5":17554,"_23935":96957,"_2398":97031},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2871":58298,"_25310":58271,"_17659":97033,"_5":17554,"_23935":96961,"_2398":97034},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2871":58299,"_25310":58271,"_17659":97036,"_5":17554,"_23935":96961,"_2398":97037},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2871":58300,"_25310":58271,"_17659":97039,"_5":17554,"_23935":96961,"_2398":97040},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2871":58301,"_25310":58271,"_17659":97042,"_5":17554,"_23935":96961,"_2398":97043},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente.",{"_2871":58302,"_25310":58271,"_17659":97045,"_5":17554,"_23935":96965,"_2398":97046},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2871":58303,"_25310":58271,"_17659":97048,"_5":17554,"_23935":96969,"_2398":97049},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del event bus. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_2871":58304,"_25310":58271,"_17659":97051,"_5":17554,"_23935":96969,"_2398":97052},[],"Sin un Secret de CA configurado, los clientes del event bus usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_2871":58305,"_25310":58271,"_17659":97054,"_5":17554,"_23935":96969,"_2398":97055},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_2871":58306,"_25310":58271,"_17659":97057,"_5":17554,"_23935":96969,"_2398":97058},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`).",{"_2871":58307,"_25310":58271,"_17659":97060,"_5":17554,"_23935":96969,"_2398":97061},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_2871":58308,"_25310":58271,"_17659":97063,"_5":17554,"_23935":96969,"_2398":97064},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_2871":58309,"_25310":58271,"_17659":97066,"_5":17554,"_23935":96969,"_2398":97067},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del event bus usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro.",{"_2871":58310,"_25310":58271,"_17659":97069,"_5":17554,"_23935":96973,"_2398":97070},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2871":58311,"_25310":58271,"_17659":97072,"_5":17554,"_23935":96973,"_2398":97073},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2871":58312,"_25310":58271,"_17659":97075,"_5":17554,"_23935":96973,"_2398":97076},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2871":58313,"_25310":58271,"_17659":97078,"_5":17554,"_23935":96973,"_2398":97079},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2871":58314,"_25310":58271,"_17659":97081,"_5":17554,"_23935":96977,"_2398":97082},[],"Para instalar un checkout local:",{"_2871":58315,"_25310":58271,"_17659":97084,"_5":17554,"_23935":96981,"_2398":97085},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2871":58316,"_25310":58271,"_17659":97087,"_5":17554,"_23935":96981,"_2398":97088},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2871":58317,"_25310":58271,"_17659":97090,"_5":17554,"_23935":96985,"_2398":97091},[],"Antes de pasar a producción, revisa:",{"_2871":58318,"_25310":58271,"_17659":97093,"_5":17554,"_23935":96985,"_2398":97094},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2871":58319,"_25310":58271,"_17659":97096,"_5":17554,"_23935":96985,"_2398":97097},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2871":58320,"_25310":58271,"_17659":97099,"_5":17554,"_23935":96985,"_2398":97100},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2871":58321,"_25310":58271,"_17659":97102,"_5":17554,"_23935":96985,"_2398":97103},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2871":58322,"_25310":58271,"_17659":97105,"_5":17554,"_23935":96985,"_2398":97106},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2871":58323,"_25310":58271,"_17659":97108,"_5":17554,"_23935":96985,"_2398":97109},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2871":58324,"_25310":58271,"_17659":97111,"_5":17554,"_23935":96985,"_2398":97112},[],"SMTP, observabilidad y entrega de alertas",{"_2871":58325,"_25310":58271,"_17659":97114,"_5":17554,"_23935":96985,"_2398":97115},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2871":58326,"_25310":58271,"_17659":97117,"_5":17554,"_23935":96985,"_2398":97118},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2871":58327,"_25310":58327,"_5":12413,"_2398":97120,"_25646":97121,"_17659":97122,"_23935":58327},"Expón el Gateway",[41060,96400,96634],[],{"_2871":58328,"_25310":58327,"_17659":97124,"_5":17554,"_23935":58327,"_2398":97125},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2871":58329,"_25310":58327,"_5":25643,"_17659":97127,"_23935":97128,"_2398":97129},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2871":58330,"_25310":58327,"_5":25643,"_17659":97131,"_23935":97132,"_2398":97133},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2871":58331,"_25310":58327,"_5":25643,"_17659":97135,"_23935":97136,"_2398":97137},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2871":58332,"_25310":58327,"_5":25643,"_17659":97139,"_23935":97140,"_2398":41834},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#k3s",{"_2871":58333,"_25310":58327,"_5":25643,"_17659":97142,"_23935":97143,"_2398":97144},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2871":58334,"_25310":58327,"_5":25643,"_17659":97146,"_23935":97147,"_2398":97148},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2871":58335,"_25310":58327,"_5":25643,"_17659":97150,"_23935":97151,"_2398":97152},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2871":58336,"_25310":58327,"_5":25643,"_17659":97154,"_23935":97155,"_2398":97156},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2871":58337,"_25310":58327,"_5":25643,"_17659":97158,"_23935":97159,"_2398":97160},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2871":58338,"_25310":58327,"_17659":97162,"_5":17554,"_23935":97128,"_2398":97163},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2871":58339,"_25310":58327,"_17659":97165,"_5":17554,"_23935":97128,"_2398":97166},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2871":58340,"_25310":58327,"_17659":97168,"_5":17554,"_23935":97132,"_2398":97169},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2871":58341,"_25310":58327,"_17659":97171,"_5":17554,"_23935":97132,"_2398":97172},[],"Defínelo únicamente cuando:",{"_2871":58342,"_25310":58327,"_17659":97174,"_5":17554,"_23935":97132,"_2398":97175},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2871":58343,"_25310":58327,"_17659":97177,"_5":17554,"_23935":97132,"_2398":97178},[],"esa dirección está asignada a este Gateway",{"_2871":58344,"_25310":58327,"_17659":97180,"_5":17554,"_23935":97132,"_2398":97181},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2871":58345,"_25310":58327,"_17659":97183,"_5":17554,"_23935":97132,"_2398":97184},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2871":58346,"_25310":58327,"_17659":97186,"_5":17554,"_23935":97132,"_2398":97187},[],"No confundas estos valores:",{"_2871":58347,"_25310":58327,"_17659":97189,"_5":17554,"_23935":97132,"_2398":97190},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2871":58348,"_25310":58327,"_17659":97192,"_5":17554,"_23935":97132,"_2398":97193},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2871":58349,"_25310":58327,"_17659":97195,"_5":17554,"_23935":97132,"_2398":97196},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2871":58350,"_25310":58327,"_17659":97198,"_5":17554,"_23935":97136,"_2398":97199},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2871":58351,"_25310":58327,"_17659":97201,"_5":17554,"_23935":97136,"_2398":97202},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2871":58352,"_25310":58327,"_17659":97204,"_5":17554,"_23935":97140,"_2398":97205},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2871":58353,"_25310":58327,"_17659":97207,"_5":17554,"_23935":97140,"_2398":97208},[],"Para el diseño recomendado:",{"_2871":58354,"_25310":58327,"_17659":97210,"_5":17554,"_23935":97140,"_2398":97211},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2871":58355,"_25310":58327,"_17659":97213,"_5":17554,"_23935":97140,"_2398":97214},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2871":58356,"_25310":58327,"_17659":97216,"_5":17554,"_23935":97140,"_2398":97217},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2871":58357,"_25310":58327,"_17659":97219,"_5":17554,"_23935":97140,"_2398":97220},[],"Apunta DNS a la dirección accesible de la VM.",{"_2871":58358,"_25310":58327,"_17659":97222,"_5":17554,"_23935":97140,"_2398":97223},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2871":58359,"_25310":58327,"_17659":97225,"_5":17554,"_23935":97143,"_2398":97226},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2871":58360,"_25310":58327,"_17659":97228,"_5":17554,"_23935":97147,"_2398":97229},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2871":58361,"_25310":58327,"_17659":97231,"_5":17554,"_23935":97147,"_2398":97232},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2871":58362,"_25310":58327,"_17659":97234,"_5":17554,"_23935":97151,"_2398":97235},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2871":58363,"_25310":58327,"_17659":97237,"_5":17554,"_23935":97151,"_2398":97238},[],"Requisito",{"_2871":58364,"_25310":58327,"_17659":97240,"_5":17554,"_23935":97151,"_2398":97241},[],"Diseño recomendado",{"_2871":58365,"_25310":58327,"_17659":97243,"_5":17554,"_23935":97151,"_2398":97244},[],"Consecuencia",{"_2871":58366,"_25310":58327,"_17659":97246,"_5":17554,"_23935":97151,"_2398":97247},[],"Varias URL o servicios de Lamassu",{"_2871":58367,"_25310":58327,"_17659":97249,"_5":17554,"_23935":97151,"_2398":97250},[],"Un Gateway con varias rutas",{"_2871":58368,"_25310":58327,"_17659":97252,"_5":17554,"_23935":97151,"_2398":97253},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2871":58369,"_25310":58327,"_17659":97255,"_5":17554,"_23935":97151,"_2398":97256},[],"Gateways independientes e IP externas distintas",{"_2871":58370,"_25310":58327,"_17659":97258,"_5":17554,"_23935":97151,"_2398":97259},[],"Una VIP por Gateway",{"_2871":58371,"_25310":58327,"_17659":97261,"_5":17554,"_23935":97151,"_2398":97262},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2871":58372,"_25310":58327,"_17659":97264,"_5":17554,"_23935":97151,"_2398":97265},[],"Gateways independientes, un nodo y una IP",{"_2871":58373,"_25310":58327,"_17659":97267,"_5":17554,"_23935":97151,"_2398":97268},[],"Puertos externos diferentes",{"_2871":58374,"_25310":58327,"_17659":97270,"_5":17554,"_23935":97151,"_2398":97271},[],"Los clientes deben indicar puertos no estándar",{"_2871":58375,"_25310":58327,"_17659":97273,"_5":17554,"_23935":97151,"_2398":97274},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2871":58376,"_25310":58327,"_17659":97276,"_5":17554,"_23935":97151,"_2398":97277},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2871":58377,"_25310":58327,"_17659":97279,"_5":17554,"_23935":97151,"_2398":97280},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2871":58378,"_25310":58327,"_17659":97282,"_5":17554,"_23935":97151,"_2398":97283},[],"Recursos Gateway separados pero proxy compartido",{"_2871":58379,"_25310":58327,"_17659":97285,"_5":17554,"_23935":97151,"_2398":97286},[],"Modo merged Gateway de Envoy",{"_2871":58380,"_25310":58327,"_17659":97288,"_5":17554,"_23935":97151,"_2398":97289},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2871":58381,"_25310":58327,"_17659":97291,"_5":17554,"_23935":97151,"_2398":97292},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2871":58382,"_25310":58327,"_17659":97294,"_5":17554,"_23935":97151,"_2398":97295},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2871":58383,"_25310":58327,"_17659":97297,"_5":17554,"_23935":97151,"_2398":97298},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2871":58384,"_25310":58327,"_17659":97300,"_5":17554,"_23935":97151,"_2398":97301},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2871":58385,"_25310":58327,"_17659":97303,"_5":17554,"_23935":97155,"_2398":97304},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2871":58386,"_25310":58327,"_17659":97306,"_5":17554,"_23935":97155,"_2398":97307},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2871":58387,"_25310":58327,"_17659":97309,"_5":17554,"_23935":97155,"_2398":97310},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2871":58388,"_25310":58327,"_17659":97312,"_5":17554,"_23935":97155,"_2398":97313},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2871":58389,"_25310":58327,"_17659":97315,"_5":17554,"_23935":97155,"_2398":97316},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2871":58390,"_25310":58327,"_17659":97318,"_5":17554,"_23935":97159,"_2398":97319},[],"Comprueba, en orden:",{"_2871":58391,"_25310":58327,"_17659":97321,"_5":17554,"_23935":97159,"_2398":97322},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2871":58392,"_25310":58327,"_17659":97324,"_5":17554,"_23935":97159,"_2398":97325},[],"Su estado contiene la dirección esperada.",{"_2871":58393,"_25310":58327,"_17659":97327,"_5":17554,"_23935":97159,"_2398":97328},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2871":58394,"_25310":58327,"_17659":97330,"_5":17554,"_23935":97159,"_2398":97331},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2871":58395,"_25310":58327,"_17659":97333,"_5":17554,"_23935":97159,"_2398":97334},[],"DNS resuelve al endpoint accesible externamente.",{"_2871":58396,"_25310":58327,"_17659":97336,"_5":17554,"_23935":97159,"_2398":97337},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2871":58397,"_25310":58327,"_17659":97339,"_5":17554,"_23935":97159,"_2398":97340},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2871":58398,"_25310":58398,"_5":12413,"_2398":41167,"_25646":97342,"_17659":97343,"_23935":58398},[41060,96400,96634],[],{"_2871":58399,"_25310":58398,"_17659":97345,"_5":17554,"_23935":58398,"_2398":97346},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2871":58400,"_25310":58398,"_5":25643,"_17659":97348,"_23935":97349,"_2398":97350},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2871":58401,"_25310":58398,"_5":25643,"_17659":97352,"_23935":97353,"_2398":97354},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2871":58402,"_25310":58398,"_5":25643,"_17659":97356,"_23935":97357,"_2398":97358},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2871":58403,"_25310":58398,"_5":25643,"_17659":97360,"_23935":97361,"_2398":97362},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2871":58404,"_25310":58398,"_5":25643,"_17659":97364,"_23935":97365,"_2398":97366},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2871":58405,"_25310":58398,"_5":25643,"_17659":97368,"_23935":97369,"_2398":97370},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2871":58406,"_25310":58398,"_17659":97372,"_5":17554,"_23935":97349,"_2398":97373},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2871":58407,"_25310":58398,"_17659":97375,"_5":17554,"_23935":97353,"_2398":97376},[],"Flujo",{"_2871":58408,"_25310":58398,"_17659":97378,"_5":17554,"_23935":97353,"_2398":97379},[],"Úsalo para",{"_2871":58409,"_25310":58398,"_17659":97381,"_5":17554,"_23935":97353,"_2398":97382},[],"Qué instala",{"_2871":58410,"_25310":58398,"_17659":97384,"_5":17554,"_23935":97353,"_2398":42079},[],{"_2871":58411,"_25310":58398,"_17659":97386,"_5":17554,"_23935":97353,"_2398":97387},[],"Producción y entornos controlados",{"_2871":58412,"_25310":58398,"_17659":97389,"_5":17554,"_23935":97353,"_2398":97390},[],"Servicios de Lamassu y recursos de Gateway API",{"_2871":58413,"_25310":58398,"_17659":97392,"_5":17554,"_23935":97353,"_2398":41304},[],{"_2871":58414,"_25310":58398,"_17659":97394,"_5":17554,"_23935":97353,"_2398":97395},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2871":58415,"_25310":58398,"_17659":97397,"_5":17554,"_23935":97353,"_2398":97398},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2871":58416,"_25310":58398,"_17659":97400,"_5":17554,"_23935":97357,"_2398":97401},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2871":58417,"_25310":58398,"_17659":97403,"_5":17554,"_23935":97357,"_2398":97404},[],"Área",{"_2871":58418,"_25310":58398,"_17659":97406,"_5":17554,"_23935":97357,"_2398":97407},[],"El chart de Lamassu proporciona",{"_2871":58419,"_25310":58398,"_17659":97409,"_5":17554,"_23935":97357,"_2398":97410},[],"Tú proporcionas",{"_2871":58420,"_25310":58398,"_17659":97412,"_5":17554,"_23935":97357,"_2398":97413},[],"Aplicaciones Lamassu",{"_2871":58421,"_25310":58398,"_17659":97415,"_5":17554,"_23935":97357,"_2398":97416},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2871":58422,"_25310":58398,"_17659":97418,"_5":17554,"_23935":97357,"_2398":97419},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2871":58423,"_25310":58398,"_17659":97421,"_5":17554,"_23935":97357,"_2398":97422},[],"Datos PostgreSQL",{"_2871":58424,"_25310":58398,"_17659":97424,"_5":17554,"_23935":97357,"_2398":97425},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2871":58425,"_25310":58398,"_17659":97427,"_5":17554,"_23935":97357,"_2398":97428},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2871":58426,"_25310":58398,"_17659":97430,"_5":17554,"_23935":97357,"_2398":97431},[],"Mensajería",{"_2871":58427,"_25310":58398,"_17659":97433,"_5":17554,"_23935":97357,"_2398":97434},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS con una CA privada y un certificado de cliente opcional, definidos mediante valores del chart",{"_2871":58428,"_25310":58398,"_17659":97436,"_5":17554,"_23935":97357,"_2398":97437},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2871":58429,"_25310":58398,"_17659":97439,"_5":17554,"_23935":97357,"_2398":97440},[],"Identidad",{"_2871":58430,"_25310":58398,"_17659":97442,"_5":17554,"_23935":97357,"_2398":97443},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2871":58431,"_25310":58398,"_17659":97445,"_5":17554,"_23935":97357,"_2398":97446},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2871":58432,"_25310":58398,"_17659":97448,"_5":17554,"_23935":97357,"_2398":97449},[],"Enrutamiento externo",{"_2871":58433,"_25310":58398,"_17659":97451,"_5":17554,"_23935":97357,"_2398":97452},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2871":58434,"_25310":58398,"_17659":97454,"_5":17554,"_23935":97357,"_2398":97455},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2871":58435,"_25310":58398,"_17659":97457,"_5":17554,"_23935":97357,"_2398":42153},[],{"_2871":58436,"_25310":58398,"_17659":97459,"_5":17554,"_23935":97357,"_2398":97460},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2871":58437,"_25310":58398,"_17659":97462,"_5":17554,"_23935":97357,"_2398":97463},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2871":58438,"_25310":58398,"_17659":97465,"_5":17554,"_23935":97357,"_2398":97466},[],"Datos persistentes de la aplicación",{"_2871":58439,"_25310":58398,"_17659":97468,"_5":17554,"_23935":97357,"_2398":97469},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2871":58440,"_25310":58398,"_17659":97471,"_5":17554,"_23935":97357,"_2398":97472},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2871":58441,"_25310":58398,"_17659":97474,"_5":17554,"_23935":97357,"_2398":97475},[],"Integraciones opcionales",{"_2871":58442,"_25310":58398,"_17659":97477,"_5":17554,"_23935":97357,"_2398":97478},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2871":58443,"_25310":58398,"_17659":97480,"_5":17554,"_23935":97357,"_2398":97481},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2871":58444,"_25310":58398,"_17659":97483,"_5":17554,"_23935":97357,"_2398":97484},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2871":58445,"_25310":58398,"_17659":97486,"_5":17554,"_23935":97357,"_2398":97487},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2871":58446,"_25310":58398,"_17659":97489,"_5":17554,"_23935":97361,"_2398":97490},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2871":58447,"_25310":58398,"_17659":97492,"_5":17554,"_23935":97361,"_2398":97493},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2871":58448,"_25310":58398,"_17659":97495,"_5":17554,"_23935":97365,"_2398":97496},[],"Kubernetes 1.24 o posterior",{"_2871":58449,"_25310":58398,"_17659":97498,"_5":17554,"_23935":97365,"_2398":97499},[],"Helm 3.2 o posterior",{"_2871":58450,"_25310":58398,"_17659":97501,"_5":17554,"_23935":97365,"_2398":97502},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2871":58451,"_25310":58398,"_17659":97504,"_5":17554,"_23935":97365,"_2398":97505},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2871":58452,"_25310":58398,"_17659":97507,"_5":17554,"_23935":97365,"_2398":97508},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2871":58453,"_25310":58398,"_17659":97510,"_5":17554,"_23935":97365,"_2398":97511},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2871":58454,"_25310":58398,"_17659":97513,"_5":17554,"_23935":97365,"_2398":97514},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2871":58455,"_25310":58398,"_17659":97516,"_5":17554,"_23935":97369,"_2398":97517},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2871":58456,"_25310":58398,"_17659":97519,"_5":17554,"_23935":97369,"_2398":97520},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2871":58457,"_25310":58398,"_17659":97522,"_5":17554,"_23935":97369,"_2398":97523},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2871":58458,"_25310":58458,"_5":12413,"_2398":97525,"_25646":97526,"_17659":97528,"_23935":58458},"Resolución de problemas de despliegue",[41060,96400,97527],"Operación",[],{"_2871":58459,"_25310":58458,"_17659":97530,"_5":17554,"_23935":58458,"_2398":97531},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2871":58460,"_25310":58458,"_5":25643,"_17659":97533,"_23935":97534,"_2398":97535},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2871":58461,"_25310":58458,"_5":25643,"_17659":97537,"_23935":97538,"_2398":97539},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2871":58462,"_25310":58458,"_5":25643,"_17659":97541,"_23935":97542,"_2398":97543},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2871":58463,"_25310":58458,"_5":25643,"_17659":97545,"_23935":97546,"_2398":97547},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2871":58464,"_25310":58458,"_5":25643,"_17659":97549,"_23935":97550,"_2398":97551},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2871":58465,"_25310":58458,"_5":25643,"_17659":97553,"_23935":97554,"_2398":97555},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2871":58466,"_25310":58458,"_5":25643,"_17659":97557,"_23935":97558,"_2398":97559},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2871":58467,"_25310":58458,"_5":25643,"_17659":97561,"_23935":97562,"_2398":97563},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2871":58468,"_25310":58458,"_5":25643,"_17659":97565,"_23935":97566,"_2398":97567},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2871":58469,"_25310":58458,"_5":25643,"_17659":97569,"_23935":97570,"_2398":97571},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2871":58470,"_25310":58458,"_5":25643,"_17659":97573,"_23935":97574,"_2398":97575},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2871":58471,"_25310":58458,"_5":25643,"_17659":97577,"_23935":97578,"_2398":97579},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2871":58472,"_25310":58458,"_17659":97581,"_5":17554,"_23935":58458,"_2398":97582},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2871":58473,"_25310":58458,"_17659":97584,"_5":17554,"_23935":97538,"_2398":97585},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2871":58474,"_25310":58458,"_17659":97587,"_5":17554,"_23935":97542,"_2398":97588},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2871":58475,"_25310":58458,"_17659":97590,"_5":17554,"_23935":97546,"_2398":97591},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2871":58476,"_25310":58458,"_17659":97593,"_5":17554,"_23935":97550,"_2398":97594},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2871":58477,"_25310":58458,"_17659":97596,"_5":17554,"_23935":97554,"_2398":97597},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2871":58478,"_25310":58458,"_17659":97599,"_5":17554,"_23935":97558,"_2398":97600},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2871":58479,"_25310":58458,"_17659":97602,"_5":17554,"_23935":97558,"_2398":97603},[],"Ejecuta también la prueba de conectividad del chart:",{"_2871":58480,"_25310":58458,"_17659":97605,"_5":17554,"_23935":97558,"_2398":97606},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2871":58481,"_25310":58458,"_17659":97608,"_5":17554,"_23935":97558,"_2398":97609},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2871":58482,"_25310":58458,"_17659":97611,"_5":17554,"_23935":97562,"_2398":97612},[],"Si recibes un 401:",{"_2871":58483,"_25310":58458,"_17659":97614,"_5":17554,"_23935":97562,"_2398":97615},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2871":58484,"_25310":58458,"_17659":97617,"_5":17554,"_23935":97562,"_2398":97618},[],"verifica emisor, audiencia y expiración del token;",{"_2871":58485,"_25310":58458,"_17659":97620,"_5":17554,"_23935":97562,"_2398":97621},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2871":58486,"_25310":58458,"_17659":97623,"_5":17554,"_23935":97562,"_2398":97624},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2871":58487,"_25310":58458,"_17659":97626,"_5":17554,"_23935":97562,"_2398":97627},[],"Si el login termina pero las APIs devuelven 403:",{"_2871":58488,"_25310":58458,"_17659":97629,"_5":17554,"_23935":97562,"_2398":97630},[],"inspecciona los claims reales del token;",{"_2871":58489,"_25310":58458,"_17659":97632,"_5":17554,"_23935":97562,"_2398":97633},[],"confirma que coinciden con un principal activo;",{"_2871":58490,"_25310":58458,"_17659":97635,"_5":17554,"_23935":97562,"_2398":97636},[],"revisa las políticas concedidas al principal;",{"_2871":58491,"_25310":58458,"_17659":97638,"_5":17554,"_23935":97562,"_2398":97639},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2871":58492,"_25310":58458,"_17659":97641,"_5":17554,"_23935":97562,"_2398":97642},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2871":58493,"_25310":58458,"_17659":97644,"_5":17554,"_23935":97566,"_2398":97645},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2871":58494,"_25310":58458,"_17659":97647,"_5":17554,"_23935":97566,"_2398":97648},[],"Localiza el pod y Service de authz.",{"_2871":58495,"_25310":58458,"_17659":97650,"_5":17554,"_23935":97566,"_2398":97651},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2871":58496,"_25310":58458,"_17659":97653,"_5":17554,"_23935":97566,"_2398":97654},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2871":58497,"_25310":58458,"_17659":97656,"_5":17554,"_23935":97566,"_2398":97657},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2871":58498,"_25310":58458,"_17659":97659,"_5":17554,"_23935":97566,"_2398":97660},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2871":58499,"_25310":58458,"_17659":97662,"_5":17554,"_23935":97570,"_2398":97663},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2871":58500,"_25310":58458,"_17659":97665,"_5":17554,"_23935":97570,"_2398":97666},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2871":58501,"_25310":58458,"_17659":97668,"_5":17554,"_23935":97570,"_2398":97669},[],"volumen persistente sin enlazar;",{"_2871":58502,"_25310":58458,"_17659":97671,"_5":17554,"_23935":97570,"_2398":97672},[],"imagen inaccesible o política de pull incorrecta;",{"_2871":58503,"_25310":58458,"_17659":97674,"_5":17554,"_23935":97570,"_2398":97675},[],"configuración inválida del motor criptográfico;",{"_2871":58504,"_25310":58458,"_17659":97677,"_5":17554,"_23935":97570,"_2398":97678},[],"límites de CPU o memoria demasiado bajos;",{"_2871":58505,"_25310":58458,"_17659":97680,"_5":17554,"_23935":97570,"_2398":97681},[],"migración previa incompleta.",{"_2871":58506,"_25310":58458,"_17659":97683,"_5":17554,"_23935":97570,"_2398":97684},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2871":58507,"_25310":58458,"_17659":97686,"_5":17554,"_23935":97570,"_2398":97687},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2871":58508,"_25310":58458,"_17659":97689,"_5":17554,"_23935":97574,"_2398":97690},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2871":58509,"_25310":58458,"_17659":97692,"_5":17554,"_23935":97574,"_2398":97693},[],"verifica que esté habilitado en el servicio emisor;",{"_2871":58510,"_25310":58458,"_17659":97695,"_5":17554,"_23935":97574,"_2398":97696},[],"comprueba conectividad y credenciales AMQP;",{"_2871":58511,"_25310":58458,"_17659":97698,"_5":17554,"_23935":97574,"_2398":97699},[],"revisa exchange, routing key, colas y consumidores;",{"_2871":58512,"_25310":58458,"_17659":97701,"_5":17554,"_23935":97574,"_2398":97702},[],"inspecciona dead-letter queues;",{"_2871":58513,"_25310":58458,"_17659":97704,"_5":17554,"_23935":97574,"_2398":97705},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2871":58514,"_25310":58458,"_17659":97707,"_5":17554,"_23935":97574,"_2398":97708},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_2871":58515,"_25310":58458,"_17659":97710,"_5":17554,"_23935":97574,"_2398":97711},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_2871":58516,"_25310":58458,"_17659":97713,"_5":17554,"_23935":97574,"_2398":97714},[],"confirma que el Secret de la CA exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey`;",{"_2871":58517,"_25310":58458,"_17659":97716,"_5":17554,"_23935":97574,"_2398":97717},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_2871":58518,"_25310":58458,"_17659":97719,"_5":17554,"_23935":97574,"_2398":97720},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_2871":58519,"_25310":58458,"_17659":97722,"_5":17554,"_23935":97574,"_2398":97723},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_2871":58520,"_25310":58458,"_17659":97725,"_5":17554,"_23935":97574,"_2398":97726},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2871":58521,"_25310":58458,"_17659":97728,"_5":17554,"_23935":97578,"_2398":97729},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2871":58522,"_25310":58458,"_17659":97731,"_5":17554,"_23935":97578,"_2398":97732},[],"Antes de cerrar una incidencia, guarda:",{"_2871":58523,"_25310":58458,"_17659":97734,"_5":17554,"_23935":97578,"_2398":97735},[],"causa confirmada;",{"_2871":58524,"_25310":58458,"_17659":97737,"_5":17554,"_23935":97578,"_2398":97738},[],"alcance temporal y recursos afectados;",{"_2871":58525,"_25310":58458,"_17659":97740,"_5":17554,"_23935":97578,"_2398":97741},[],"comandos o consultas utilizados;",{"_2871":58526,"_25310":58458,"_17659":97743,"_5":17554,"_23935":97578,"_2398":97744},[],"cambio aplicado y forma de revertirlo;",{"_2871":58527,"_25310":58458,"_17659":97746,"_5":17554,"_23935":97578,"_2398":97747},[],"validación desde un consumidor;",{"_2871":58528,"_25310":58458,"_17659":97749,"_5":17554,"_23935":97578,"_2398":97750},[],"acción preventiva y propietario.",{"_2871":58529,"_25310":58529,"_5":12413,"_2398":97752,"_25646":97753,"_17659":97756,"_23935":58529},"Control de acceso",[41060,97754,97755],"Plataforma","Administración",[],{"_2871":58530,"_25310":58529,"_17659":97758,"_5":17554,"_23935":58529,"_2398":97759},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2871":58531,"_25310":58529,"_5":25643,"_17659":97761,"_23935":97762,"_2398":97763},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2871":58532,"_25310":58529,"_5":25643,"_17659":97765,"_23935":97766,"_2398":97767},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2871":58533,"_25310":58529,"_5":25643,"_17659":97769,"_23935":97770,"_2398":97771},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2871":58534,"_25310":58529,"_5":25643,"_17659":97773,"_23935":97774,"_2398":97775},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2871":58535,"_25310":58529,"_5":25643,"_17659":97777,"_23935":97778,"_2398":97779},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2871":58536,"_25310":58529,"_5":25643,"_17659":97781,"_23935":97782,"_2398":97783},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2871":58537,"_25310":58529,"_5":25643,"_17659":97785,"_23935":97786,"_2398":97787},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2871":58538,"_25310":58529,"_5":25643,"_17659":97789,"_23935":97790,"_2398":97791},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2871":58539,"_25310":58529,"_5":25643,"_17659":97793,"_23935":97794,"_2398":97795},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2871":58540,"_25310":58529,"_5":25643,"_17659":97797,"_23935":97798,"_2398":97799},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2871":58541,"_25310":58529,"_5":25643,"_17659":97801,"_23935":97802,"_2398":97803},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2871":58542,"_25310":58529,"_5":25643,"_17659":97805,"_23935":97806,"_2398":97807},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2871":58543,"_25310":58529,"_5":25643,"_17659":97809,"_23935":97810,"_2398":97811},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2871":58544,"_25310":58529,"_5":25643,"_17659":97813,"_23935":97814,"_2398":97815},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2871":58545,"_25310":58529,"_5":25643,"_17659":97817,"_23935":97818,"_2398":97819},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2871":58546,"_25310":58529,"_5":25643,"_17659":97821,"_23935":97822,"_2398":96974},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2871":58547,"_25310":58529,"_5":25643,"_17659":97824,"_23935":97825,"_2398":97826},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2871":58548,"_25310":58529,"_5":25643,"_17659":97828,"_23935":97829,"_2398":97830},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2871":58549,"_25310":58529,"_5":25643,"_17659":97832,"_23935":97833,"_2398":97834},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2871":58550,"_25310":58529,"_5":25643,"_17659":97836,"_23935":97837,"_2398":97838},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2871":58551,"_25310":58529,"_5":25643,"_17659":97840,"_23935":97841,"_2398":97842},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2871":58552,"_25310":58529,"_5":25643,"_17659":97844,"_23935":97845,"_2398":97846},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2871":58553,"_25310":58529,"_5":25643,"_17659":97848,"_23935":97849,"_2398":97850},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2871":58554,"_25310":58529,"_5":25643,"_17659":97852,"_23935":97853,"_2398":97854},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2871":58555,"_25310":58529,"_5":25643,"_17659":97856,"_23935":97857,"_2398":97858},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2871":58556,"_25310":58529,"_5":25643,"_17659":97860,"_23935":97861,"_2398":97862},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2871":58557,"_25310":58529,"_5":25643,"_17659":97864,"_23935":97865,"_2398":97866},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2871":58558,"_25310":58529,"_5":25643,"_17659":97868,"_23935":97869,"_2398":97870},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2871":58559,"_25310":58529,"_5":25643,"_17659":97872,"_23935":97873,"_2398":97874},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2871":58560,"_25310":58529,"_5":25643,"_17659":97876,"_23935":97877,"_2398":97878},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2871":58561,"_25310":58529,"_5":25643,"_17659":97880,"_23935":97881,"_2398":97882},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2871":58562,"_25310":58529,"_17659":97884,"_5":17554,"_23935":58529,"_2398":97885},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2871":58563,"_25310":58529,"_17659":97887,"_5":17554,"_23935":58529,"_2398":97888},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2871":58564,"_25310":58529,"_17659":97890,"_5":17554,"_23935":58529,"_2398":97891},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2871":58565,"_25310":58529,"_17659":97893,"_5":17554,"_23935":97762,"_2398":97894},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2871":58566,"_25310":58529,"_17659":97896,"_5":17554,"_23935":97762,"_2398":97897},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2871":58567,"_25310":58529,"_17659":97899,"_5":17554,"_23935":97762,"_2398":97900},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2871":58568,"_25310":58529,"_17659":97902,"_5":17554,"_23935":97762,"_2398":97903},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2871":58569,"_25310":58529,"_17659":97905,"_5":17554,"_23935":97762,"_2398":97906},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2871":58570,"_25310":58529,"_17659":97908,"_5":17554,"_23935":97762,"_2398":97909},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2871":58571,"_25310":58529,"_17659":97911,"_5":17554,"_23935":97766,"_2398":97912},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2871":58572,"_25310":58529,"_17659":97914,"_5":17554,"_23935":97766,"_2398":97915},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2871":58573,"_25310":58529,"_17659":97917,"_5":17554,"_23935":97770,"_2398":97918},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2871":58574,"_25310":58529,"_17659":97920,"_5":17554,"_23935":97770,"_2398":97921},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2871":58575,"_25310":58529,"_17659":97923,"_5":17554,"_23935":97770,"_2398":97924},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2871":58576,"_25310":58529,"_17659":97926,"_5":17554,"_23935":97770,"_2398":97927},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2871":58577,"_25310":58529,"_17659":97929,"_5":17554,"_23935":97770,"_2398":97930},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2871":58578,"_25310":58529,"_17659":97932,"_5":17554,"_23935":97770,"_2398":97933},[],"Carga por separado las políticas concedidas a cada principal.",{"_2871":58579,"_25310":58529,"_17659":97935,"_5":17554,"_23935":97770,"_2398":97936},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2871":58580,"_25310":58529,"_17659":97938,"_5":17554,"_23935":97770,"_2398":97939},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2871":58581,"_25310":58529,"_17659":97941,"_5":17554,"_23935":97770,"_2398":97942},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2871":58582,"_25310":58529,"_17659":97944,"_5":17554,"_23935":97770,"_2398":97945},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2871":58583,"_25310":58529,"_17659":97947,"_5":17554,"_23935":97770,"_2398":97948},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2871":58584,"_25310":58529,"_17659":97950,"_5":17554,"_23935":97770,"_2398":97951},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2871":58585,"_25310":58529,"_17659":97953,"_5":17554,"_23935":97774,"_2398":97954},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2871":58586,"_25310":58529,"_17659":97956,"_5":17554,"_23935":97774,"_2398":97957},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2871":58587,"_25310":58529,"_17659":97959,"_5":17554,"_23935":97774,"_2398":97960},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2871":58588,"_25310":58529,"_17659":97962,"_5":17554,"_23935":97774,"_2398":97963},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2871":58589,"_25310":58529,"_17659":97965,"_5":17554,"_23935":97774,"_2398":97966},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2871":58590,"_25310":58529,"_17659":97968,"_5":17554,"_23935":97774,"_2398":97969},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2871":58591,"_25310":58529,"_17659":97971,"_5":17554,"_23935":97774,"_2398":97972},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2871":58592,"_25310":58529,"_17659":97974,"_5":17554,"_23935":97774,"_2398":97975},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2871":58593,"_25310":58529,"_17659":97977,"_5":17554,"_23935":97778,"_2398":97978},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2871":58594,"_25310":58529,"_17659":97980,"_5":17554,"_23935":97778,"_2398":97981},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2871":58595,"_25310":58529,"_17659":97983,"_5":17554,"_23935":97778,"_2398":97984},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2871":58596,"_25310":58529,"_17659":97986,"_5":17554,"_23935":97778,"_2398":97987},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2871":58597,"_25310":58529,"_17659":97989,"_5":17554,"_23935":97778,"_2398":97990},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2871":58598,"_25310":58529,"_17659":97992,"_5":17554,"_23935":97778,"_2398":97993},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2871":58599,"_25310":58529,"_17659":97995,"_5":17554,"_23935":97778,"_2398":97996},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2871":58600,"_25310":58529,"_17659":97998,"_5":17554,"_23935":97778,"_2398":97999},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2871":58601,"_25310":58529,"_17659":98001,"_5":17554,"_23935":97778,"_2398":98002},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2871":58602,"_25310":58529,"_17659":98004,"_5":17554,"_23935":97778,"_2398":98005},[],"Las acciones se dividen en dos grupos:",{"_2871":58603,"_25310":58529,"_17659":98007,"_5":17554,"_23935":97778,"_2398":98008},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2871":58604,"_25310":58529,"_17659":98010,"_5":17554,"_23935":97778,"_2398":98011},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2871":58605,"_25310":58529,"_17659":98013,"_5":17554,"_23935":97778,"_2398":98014},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2871":58606,"_25310":58529,"_17659":98016,"_5":17554,"_23935":97782,"_2398":98017},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2871":58607,"_25310":58529,"_17659":98019,"_5":17554,"_23935":97782,"_2398":98020},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2871":58608,"_25310":58529,"_17659":98022,"_5":17554,"_23935":97782,"_2398":98023},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2871":58609,"_25310":58529,"_17659":98025,"_5":17554,"_23935":97786,"_2398":98026},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2871":58610,"_25310":58529,"_17659":98028,"_5":17554,"_23935":97786,"_2398":98029},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2871":58611,"_25310":58529,"_17659":98031,"_5":17554,"_23935":97786,"_2398":98032},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2871":58612,"_25310":58529,"_17659":98034,"_5":17554,"_23935":97786,"_2398":98035},[],"Los operadores implementados son:",{"_2871":58613,"_25310":58529,"_17659":98037,"_5":17554,"_23935":97786,"_2398":98038},[],"`equals`, para igualdad exacta;",{"_2871":58614,"_25310":58529,"_17659":98040,"_5":17554,"_23935":97786,"_2398":98041},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2871":58615,"_25310":58529,"_17659":98043,"_5":17554,"_23935":97786,"_2398":98044},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2871":58616,"_25310":58529,"_17659":98046,"_5":17554,"_23935":97786,"_2398":98047},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2871":58617,"_25310":58529,"_17659":98049,"_5":17554,"_23935":97790,"_2398":98050},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2871":58618,"_25310":58529,"_17659":98052,"_5":17554,"_23935":97790,"_2398":98053},[],"Los modos disponibles son:",{"_2871":58619,"_25310":58529,"_17659":98055,"_5":17554,"_23935":97790,"_2398":98056},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2871":58620,"_25310":58529,"_17659":98058,"_5":17554,"_23935":97790,"_2398":98059},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2871":58621,"_25310":58529,"_17659":98061,"_5":17554,"_23935":97790,"_2398":98062},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2871":58622,"_25310":58529,"_17659":98064,"_5":17554,"_23935":97790,"_2398":98065},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2871":58623,"_25310":58529,"_17659":98067,"_5":17554,"_23935":97790,"_2398":98068},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2871":58624,"_25310":58529,"_17659":98070,"_5":17554,"_23935":97790,"_2398":98071},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2871":58625,"_25310":58529,"_17659":98073,"_5":17554,"_23935":97794,"_2398":98074},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2871":58626,"_25310":58529,"_17659":98076,"_5":17554,"_23935":97794,"_2398":98077},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2871":58627,"_25310":58529,"_17659":98079,"_5":17554,"_23935":97794,"_2398":98080},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2871":58628,"_25310":58529,"_17659":98082,"_5":17554,"_23935":97794,"_2398":98083},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2871":58629,"_25310":58529,"_17659":98085,"_5":17554,"_23935":97802,"_2398":98086},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2871":58630,"_25310":58529,"_17659":98088,"_5":17554,"_23935":97802,"_2398":98089},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2871":58631,"_25310":58529,"_17659":98091,"_5":17554,"_23935":97806,"_2398":98092},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2871":58632,"_25310":58529,"_17659":98094,"_5":17554,"_23935":97806,"_2398":98095},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2871":58633,"_25310":58529,"_17659":98097,"_5":17554,"_23935":97810,"_2398":98098},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2871":58634,"_25310":58529,"_17659":98100,"_5":17554,"_23935":97810,"_2398":98101},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2871":58635,"_25310":58529,"_17659":98103,"_5":17554,"_23935":97810,"_2398":98104},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2871":58636,"_25310":58529,"_17659":98106,"_5":17554,"_23935":97814,"_2398":98107},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2871":58637,"_25310":58529,"_17659":98109,"_5":17554,"_23935":97814,"_2398":98110},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2871":58638,"_25310":58529,"_17659":98112,"_5":17554,"_23935":97814,"_2398":98113},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2871":58639,"_25310":58529,"_17659":98115,"_5":17554,"_23935":97814,"_2398":98116},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2871":58640,"_25310":58529,"_17659":98118,"_5":17554,"_23935":97814,"_2398":98119},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2871":58641,"_25310":58529,"_17659":98121,"_5":17554,"_23935":97814,"_2398":98122},[],"Ten en cuenta que:",{"_2871":58642,"_25310":58529,"_17659":98124,"_5":17554,"_23935":97814,"_2398":98125},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2871":58643,"_25310":58529,"_17659":98127,"_5":17554,"_23935":97814,"_2398":98128},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2871":58644,"_25310":58529,"_17659":98130,"_5":17554,"_23935":97814,"_2398":98131},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2871":58645,"_25310":58529,"_17659":98133,"_5":17554,"_23935":97818,"_2398":98134},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2871":58646,"_25310":58529,"_17659":98136,"_5":17554,"_23935":97818,"_2398":98137},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2871":58647,"_25310":58529,"_17659":98139,"_5":17554,"_23935":97818,"_2398":98140},[],"acceso completo y de solo lectura a KMS;",{"_2871":58648,"_25310":58529,"_17659":98142,"_5":17554,"_23935":97818,"_2398":98143},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2871":58649,"_25310":58529,"_17659":98145,"_5":17554,"_23935":97818,"_2398":98146},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2871":58650,"_25310":58529,"_17659":98148,"_5":17554,"_23935":97818,"_2398":98149},[],"acceso a la interfaz;",{"_2871":58651,"_25310":58529,"_17659":98151,"_5":17554,"_23935":97818,"_2398":98152},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2871":58652,"_25310":58529,"_17659":98154,"_5":17554,"_23935":97818,"_2398":98155},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2871":58653,"_25310":58529,"_17659":98157,"_5":17554,"_23935":97818,"_2398":98158},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2871":58654,"_25310":58529,"_17659":98160,"_5":17554,"_23935":97822,"_2398":98161},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2871":58655,"_25310":58529,"_17659":98163,"_5":17554,"_23935":97822,"_2398":98164},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2871":58656,"_25310":58529,"_17659":98166,"_5":17554,"_23935":97822,"_2398":98167},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2871":58657,"_25310":58529,"_17659":98169,"_5":17554,"_23935":97825,"_2398":98170},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2871":58658,"_25310":58529,"_17659":98172,"_5":17554,"_23935":97829,"_2398":98173},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2871":58659,"_25310":58529,"_17659":98175,"_5":17554,"_23935":97833,"_2398":98176},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2871":58660,"_25310":58529,"_17659":98178,"_5":17554,"_23935":97837,"_2398":98179},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2871":58661,"_25310":58529,"_17659":98181,"_5":17554,"_23935":97841,"_2398":98182},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2871":58662,"_25310":58529,"_17659":98184,"_5":17554,"_23935":97845,"_2398":98185},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2871":58663,"_25310":58529,"_17659":98187,"_5":17554,"_23935":97845,"_2398":98188},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2871":58664,"_25310":58529,"_17659":98190,"_5":17554,"_23935":97849,"_2398":98191},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2871":58665,"_25310":58529,"_17659":98193,"_5":17554,"_23935":97849,"_2398":98194},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2871":58666,"_25310":58529,"_17659":98196,"_5":17554,"_23935":97849,"_2398":98197},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2871":58667,"_25310":58529,"_17659":98199,"_5":17554,"_23935":97849,"_2398":98200},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2871":58668,"_25310":58529,"_17659":98202,"_5":17554,"_23935":97849,"_2398":98203},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2871":58669,"_25310":58529,"_17659":98205,"_5":17554,"_23935":97849,"_2398":98206},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2871":58670,"_25310":58529,"_17659":98208,"_5":17554,"_23935":97849,"_2398":98209},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2871":58671,"_25310":58529,"_17659":98211,"_5":17554,"_23935":97849,"_2398":98212},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2871":58672,"_25310":58529,"_17659":98214,"_5":17554,"_23935":97853,"_2398":98215},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2871":58673,"_25310":58529,"_17659":98217,"_5":17554,"_23935":97853,"_2398":98218},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2871":58674,"_25310":58529,"_17659":98220,"_5":17554,"_23935":97853,"_2398":98221},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2871":58675,"_25310":58529,"_17659":98223,"_5":17554,"_23935":97857,"_2398":98224},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2871":58676,"_25310":58529,"_17659":98226,"_5":17554,"_23935":97857,"_2398":98227},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2871":58677,"_25310":58529,"_17659":98229,"_5":17554,"_23935":97857,"_2398":98230},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2871":58678,"_25310":58529,"_17659":98232,"_5":17554,"_23935":97857,"_2398":98233},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2871":58679,"_25310":58529,"_17659":98235,"_5":17554,"_23935":97857,"_2398":98236},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2871":58680,"_25310":58529,"_17659":98238,"_5":17554,"_23935":97857,"_2398":98239},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2871":58681,"_25310":58529,"_17659":98241,"_5":17554,"_23935":97857,"_2398":98242},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2871":58682,"_25310":58529,"_17659":98244,"_5":17554,"_23935":97857,"_2398":98245},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2871":58683,"_25310":58529,"_17659":98247,"_5":17554,"_23935":97865,"_2398":98248},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2871":58684,"_25310":58529,"_17659":98250,"_5":17554,"_23935":97869,"_2398":98251},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2871":58685,"_25310":58529,"_17659":98253,"_5":17554,"_23935":97869,"_2398":98254},[],"que exista un principal activo del tipo correcto;",{"_2871":58686,"_25310":58529,"_17659":98256,"_5":17554,"_23935":97869,"_2398":98257},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2871":58687,"_25310":58529,"_17659":98259,"_5":17554,"_23935":97869,"_2398":98260},[],"que todas las condiciones del principal se cumplan;",{"_2871":58688,"_25310":58529,"_17659":98262,"_5":17554,"_23935":97869,"_2398":98263},[],"que el principal tenga concedida la política esperada;",{"_2871":58689,"_25310":58529,"_17659":98265,"_5":17554,"_23935":97869,"_2398":98266},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2871":58690,"_25310":58529,"_17659":98268,"_5":17554,"_23935":97869,"_2398":98269},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2871":58691,"_25310":58529,"_17659":98271,"_5":17554,"_23935":97869,"_2398":98272},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2871":58692,"_25310":58529,"_17659":98274,"_5":17554,"_23935":97873,"_2398":98275},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2871":58693,"_25310":58529,"_17659":98277,"_5":17554,"_23935":97877,"_2398":98278},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2871":58694,"_25310":58529,"_17659":98280,"_5":17554,"_23935":97881,"_2398":98281},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2871":58695,"_25310":58529,"_17659":98283,"_5":17554,"_23935":97881,"_2398":98284},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2871":58696,"_25310":58696,"_5":12413,"_2398":98286,"_25646":98287,"_17659":98288,"_23935":58696},"Alertas y suscripciones",[41060,97754,97755],[],{"_2871":58697,"_25310":58696,"_17659":98290,"_5":17554,"_23935":58696,"_2398":98291},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2871":58698,"_25310":58696,"_5":25643,"_17659":98293,"_23935":98294,"_2398":98295},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2871":58699,"_25310":58696,"_5":25643,"_17659":98297,"_23935":98298,"_2398":98299},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2871":58700,"_25310":58696,"_5":25643,"_17659":98301,"_23935":98302,"_2398":98303},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2871":58701,"_25310":58696,"_5":25643,"_17659":98305,"_23935":98306,"_2398":98307},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2871":58702,"_25310":58696,"_5":25643,"_17659":98309,"_23935":98310,"_2398":98311},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2871":58703,"_25310":58696,"_5":25643,"_17659":98313,"_23935":98314,"_2398":98315},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2871":58704,"_25310":58696,"_5":25643,"_17659":98317,"_23935":98318,"_2398":98319},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2871":58705,"_25310":58696,"_5":25643,"_17659":98321,"_23935":98322,"_2398":98323},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2871":58706,"_25310":58696,"_5":25643,"_17659":98325,"_23935":98326,"_2398":98327},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2871":58707,"_25310":58696,"_5":25643,"_17659":98329,"_23935":98330,"_2398":98331},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2871":58708,"_25310":58696,"_17659":98333,"_5":17554,"_23935":58696,"_2398":98334},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2871":58709,"_25310":58696,"_17659":98336,"_5":17554,"_23935":98294,"_2398":98337},[],"Un servicio publica un evento de dominio.",{"_2871":58710,"_25310":58696,"_17659":98339,"_5":17554,"_23935":98294,"_2398":98340},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2871":58711,"_25310":58696,"_17659":98342,"_5":17554,"_23935":98294,"_2398":98343},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2871":58712,"_25310":58696,"_17659":98345,"_5":17554,"_23935":98294,"_2398":98346},[],"Lamassu entrega el evento al canal configurado.",{"_2871":58713,"_25310":58696,"_17659":98348,"_5":17554,"_23935":98294,"_2398":98349},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2871":58714,"_25310":58696,"_17659":98351,"_5":17554,"_23935":98298,"_2398":98352},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2871":58715,"_25310":58696,"_17659":98354,"_5":17554,"_23935":98298,"_2398":98355},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2871":58716,"_25310":58696,"_17659":98357,"_5":17554,"_23935":98298,"_2398":98358},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2871":58717,"_25310":58696,"_17659":98360,"_5":17554,"_23935":98298,"_2398":98361},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2871":58718,"_25310":58696,"_17659":98363,"_5":17554,"_23935":98298,"_2398":98364},[],"`apikey_options` necesita `header` y `key`.",{"_2871":58719,"_25310":58696,"_17659":98366,"_5":17554,"_23935":98298,"_2398":98367},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2871":58720,"_25310":58696,"_17659":98369,"_5":17554,"_23935":98298,"_2398":98370},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2871":58721,"_25310":58696,"_17659":98372,"_5":17554,"_23935":98298,"_2398":98373},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2871":58722,"_25310":58696,"_17659":98375,"_5":17554,"_23935":98306,"_2398":98376},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2871":58723,"_25310":58696,"_17659":98378,"_5":17554,"_23935":98310,"_2398":98379},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2871":58724,"_25310":58696,"_17659":98381,"_5":17554,"_23935":98314,"_2398":98382},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2871":58725,"_25310":58696,"_17659":98384,"_5":17554,"_23935":98314,"_2398":98385},[],"**None** notifica todas las instancias del evento.",{"_2871":58726,"_25310":58696,"_17659":98387,"_5":17554,"_23935":98314,"_2398":98388},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2871":58727,"_25310":58696,"_17659":98390,"_5":17554,"_23935":98314,"_2398":98391},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2871":58728,"_25310":58696,"_17659":98393,"_5":17554,"_23935":98314,"_2398":98394},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2871":58729,"_25310":58696,"_17659":98396,"_5":17554,"_23935":98314,"_2398":98397},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2871":58730,"_25310":58696,"_17659":98399,"_5":17554,"_23935":98318,"_2398":98400},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2871":58731,"_25310":58696,"_17659":98402,"_5":17554,"_23935":98322,"_2398":98403},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2871":58732,"_25310":58696,"_17659":98405,"_5":17554,"_23935":98322,"_2398":98406},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2871":58733,"_25310":58696,"_17659":98408,"_5":17554,"_23935":98322,"_2398":98409},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2871":58734,"_25310":58696,"_17659":98411,"_5":17554,"_23935":98322,"_2398":98412},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2871":58735,"_25310":58696,"_17659":98414,"_5":17554,"_23935":98322,"_2398":98415},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2871":58736,"_25310":58696,"_17659":98417,"_5":17554,"_23935":98322,"_2398":98418},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2871":58737,"_25310":58696,"_17659":98420,"_5":17554,"_23935":98322,"_2398":98421},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2871":58738,"_25310":58696,"_17659":98423,"_5":17554,"_23935":98322,"_2398":98424},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2871":58739,"_25310":58696,"_17659":98426,"_5":17554,"_23935":98326,"_2398":98427},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2871":58740,"_25310":58696,"_17659":98429,"_5":17554,"_23935":98330,"_2398":98430},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2871":58741,"_25310":58696,"_17659":98432,"_5":17554,"_23935":98330,"_2398":98433},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2871":58742,"_25310":58696,"_17659":98435,"_5":17554,"_23935":98330,"_2398":98436},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2871":58743,"_25310":58696,"_17659":98438,"_5":17554,"_23935":98330,"_2398":98439},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2871":58744,"_25310":58696,"_17659":98441,"_5":17554,"_23935":98330,"_2398":98442},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2871":58745,"_25310":58696,"_17659":98444,"_5":17554,"_23935":98330,"_2398":98445},[],"**Validación:** `va.role.crl.create`.",{"_2871":58746,"_25310":58696,"_17659":98447,"_5":17554,"_23935":98330,"_2398":98448},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2871":58747,"_25310":58696,"_17659":98450,"_5":17554,"_23935":98330,"_2398":98451},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2871":58748,"_25310":58748,"_5":12413,"_2398":98453,"_25646":98454,"_17659":98455,"_23935":58748},"Registros de auditoría",[41060,97754,97755],[],{"_2871":58749,"_25310":58748,"_17659":98457,"_5":17554,"_23935":58748,"_2398":98458},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2871":58750,"_25310":58748,"_5":25643,"_17659":98460,"_23935":98461,"_2398":98462},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2871":58751,"_25310":58748,"_5":25643,"_17659":98464,"_23935":98465,"_2398":98466},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2871":58752,"_25310":58748,"_5":25643,"_17659":98468,"_23935":98469,"_2398":98470},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2871":58753,"_25310":58748,"_5":25643,"_17659":98472,"_23935":98473,"_2398":98474},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2871":58754,"_25310":58748,"_5":25643,"_17659":98476,"_23935":98477,"_2398":98478},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2871":58755,"_25310":58748,"_5":25643,"_17659":98480,"_23935":98481,"_2398":98482},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2871":58756,"_25310":58748,"_5":25643,"_17659":98484,"_23935":98485,"_2398":98486},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2871":58757,"_25310":58748,"_5":25643,"_17659":98488,"_23935":98489,"_2398":98490},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2871":58758,"_25310":58748,"_5":25643,"_17659":98492,"_23935":98493,"_2398":98494},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2871":58759,"_25310":58748,"_5":25643,"_17659":98496,"_23935":98497,"_2398":98498},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2871":58760,"_25310":58748,"_5":25643,"_17659":98500,"_23935":98501,"_2398":98502},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2871":58761,"_25310":58748,"_17659":98504,"_5":17554,"_23935":58748,"_2398":98505},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2871":58762,"_25310":58748,"_17659":98507,"_5":17554,"_23935":98461,"_2398":98508},[],"El cuerpo de auditoría incluye:",{"_2871":58763,"_25310":58748,"_17659":98510,"_5":17554,"_23935":98461,"_2398":98511},[],"input: datos recibidos por la operación;",{"_2871":58764,"_25310":58748,"_17659":98513,"_5":17554,"_23935":98461,"_2398":98514},[],"has\\_error: indica si el servicio devolvió un error;",{"_2871":58765,"_25310":58748,"_17659":98516,"_5":17554,"_23935":98461,"_2398":98517},[],"output: resultado producido o mensaje de error;",{"_2871":58766,"_25310":58748,"_17659":98519,"_5":17554,"_23935":98461,"_2398":98520},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2871":58767,"_25310":58748,"_17659":98522,"_5":17554,"_23935":98461,"_2398":98523},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2871":58768,"_25310":58748,"_17659":98525,"_5":17554,"_23935":98461,"_2398":98526},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2871":58769,"_25310":58748,"_17659":98528,"_5":17554,"_23935":98465,"_2398":98529},[],"El backend aplica auditoría a mutaciones de:",{"_2871":58770,"_25310":58748,"_17659":98531,"_5":17554,"_23935":98465,"_2398":98532},[],"autoridades, certificados y perfiles de emisión;",{"_2871":58771,"_25310":58748,"_17659":98534,"_5":17554,"_23935":98465,"_2398":98535},[],"claves y motores KMS;",{"_2871":58772,"_25310":58748,"_17659":98537,"_5":17554,"_23935":98465,"_2398":98538},[],"dispositivos e identidades;",{"_2871":58773,"_25310":58748,"_17659":98540,"_5":17554,"_23935":98465,"_2398":98541},[],"DMS y operaciones de enrolamiento;",{"_2871":58774,"_25310":58748,"_17659":98543,"_5":17554,"_23935":98465,"_2398":98544},[],"funciones de validación y CRL;",{"_2871":58775,"_25310":58748,"_17659":98546,"_5":17554,"_23935":98465,"_2398":98547},[],"principales, políticas y concesiones de autorización.",{"_2871":58776,"_25310":58748,"_17659":98549,"_5":17554,"_23935":98465,"_2398":98550},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2871":58777,"_25310":58748,"_17659":98552,"_5":17554,"_23935":98469,"_2398":98553},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2871":58778,"_25310":58748,"_17659":98555,"_5":17554,"_23935":98469,"_2398":98556},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2871":58779,"_25310":58748,"_17659":98558,"_5":17554,"_23935":98469,"_2398":98559},[],"Diseña el consumidor para:",{"_2871":58780,"_25310":58748,"_17659":98561,"_5":17554,"_23935":98469,"_2398":98562},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2871":58781,"_25310":58748,"_17659":98564,"_5":17554,"_23935":98469,"_2398":98565},[],"conservar el CloudEvent completo sin modificar;",{"_2871":58782,"_25310":58748,"_17659":98567,"_5":17554,"_23935":98469,"_2398":98568},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2871":58783,"_25310":58748,"_17659":98570,"_5":17554,"_23935":98469,"_2398":98571},[],"cifrar en tránsito y en reposo;",{"_2871":58784,"_25310":58748,"_17659":98573,"_5":17554,"_23935":98469,"_2398":98574},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2871":58785,"_25310":58748,"_17659":98576,"_5":17554,"_23935":98469,"_2398":98577},[],"aplicar una política explícita de retención y legal hold;",{"_2871":58786,"_25310":58748,"_17659":98579,"_5":17554,"_23935":98469,"_2398":98580},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2871":58787,"_25310":58748,"_17659":98582,"_5":17554,"_23935":98473,"_2398":98583},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2871":58788,"_25310":58748,"_17659":98585,"_5":17554,"_23935":98473,"_2398":98586},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2871":58789,"_25310":58748,"_17659":98588,"_5":17554,"_23935":98481,"_2398":98589},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2871":58790,"_25310":58748,"_17659":98591,"_5":17554,"_23935":98485,"_2398":98592},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2871":58791,"_25310":58748,"_17659":98594,"_5":17554,"_23935":98489,"_2398":98595},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2871":58792,"_25310":58748,"_17659":98597,"_5":17554,"_23935":98493,"_2398":98598},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2871":58793,"_25310":58748,"_17659":98600,"_5":17554,"_23935":98497,"_2398":98601},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2871":58794,"_25310":58748,"_17659":98603,"_5":17554,"_23935":98501,"_2398":98604},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2871":58795,"_25310":58748,"_17659":98606,"_5":17554,"_23935":98501,"_2398":98607},[],"aparece un evento de auditoría correcto;",{"_2871":58796,"_25310":58748,"_17659":98609,"_5":17554,"_23935":98501,"_2398":98610},[],"el principal coincide con la identidad utilizada;",{"_2871":58797,"_25310":58748,"_17659":98612,"_5":17554,"_23935":98501,"_2398":98613},[],"el consumidor lo persiste una sola vez;",{"_2871":58798,"_25310":58748,"_17659":98615,"_5":17554,"_23935":98501,"_2398":98616},[],"puede recuperarse por recurso, actor y periodo;",{"_2871":58799,"_25310":58748,"_17659":98618,"_5":17554,"_23935":98501,"_2398":98619},[],"una interrupción del consumidor produce una alerta.",{"_2871":58800,"_25310":58748,"_17659":98621,"_5":17554,"_23935":98501,"_2398":98622},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2871":58801,"_25310":58801,"_5":12413,"_2398":98624,"_25646":98625,"_17659":98626,"_23935":58801},"Arquitectura de la plataforma",[41060,97754],[],{"_2871":58802,"_25310":58801,"_17659":98628,"_5":17554,"_23935":58801,"_2398":98629},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2871":58803,"_25310":58801,"_5":25643,"_17659":98631,"_23935":98632,"_2398":98633},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2871":58804,"_25310":58801,"_5":25643,"_17659":98635,"_23935":98636,"_2398":98637},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2871":58805,"_25310":58801,"_5":25643,"_17659":98639,"_23935":98640,"_2398":98641},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2871":58806,"_25310":58801,"_5":25643,"_17659":98643,"_23935":98644,"_2398":98645},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2871":58807,"_25310":58801,"_5":25643,"_17659":98647,"_23935":98648,"_2398":98649},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2871":58808,"_25310":58801,"_17659":98651,"_5":17554,"_23935":58801,"_2398":98652},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2871":58809,"_25310":58801,"_17659":98654,"_5":17554,"_23935":58801,"_2398":98655},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2871":58810,"_25310":58801,"_17659":98657,"_5":17554,"_23935":98632,"_2398":98658},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2871":58811,"_25310":58801,"_17659":98660,"_5":17554,"_23935":98636,"_2398":98661},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2871":58812,"_25310":58801,"_17659":98663,"_5":17554,"_23935":98640,"_2398":98664},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2871":58813,"_25310":58801,"_17659":98666,"_5":17554,"_23935":98644,"_2398":98667},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2871":58814,"_25310":58801,"_17659":98669,"_5":17554,"_23935":98648,"_2398":98670},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2871":58815,"_25310":58815,"_5":12413,"_2398":98672,"_25646":98673,"_17659":98674,"_23935":58815},"Cómo funciona Lamassu",[41060,97754],[],{"_2871":58816,"_25310":58815,"_17659":98676,"_5":17554,"_23935":58815,"_2398":98677},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2871":58817,"_25310":58815,"_5":25643,"_17659":98679,"_23935":98680,"_2398":98681},[],"/docs/pr-preview/pr-42/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2871":58818,"_25310":58815,"_5":25643,"_17659":98683,"_23935":98684,"_2398":98685},[],"/docs/pr-preview/pr-42/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2871":58819,"_25310":58815,"_17659":98687,"_5":17554,"_23935":58815,"_2398":98688},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2871":58820,"_25310":58815,"_17659":98690,"_5":17554,"_23935":98680,"_2398":98691},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2871":58821,"_25310":58815,"_17659":98693,"_5":17554,"_23935":98680,"_2398":98694},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2871":58822,"_25310":58815,"_17659":98696,"_5":17554,"_23935":98680,"_2398":98697},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2871":58823,"_25310":58815,"_17659":98699,"_5":17554,"_23935":98680,"_2398":98700},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2871":58824,"_25310":58815,"_17659":98702,"_5":17554,"_23935":98680,"_2398":98703},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2871":58825,"_25310":58815,"_17659":98705,"_5":17554,"_23935":98684,"_2398":98706},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2871":58826,"_25310":58815,"_17659":98708,"_5":17554,"_23935":98684,"_2398":98709},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2871":58827,"_25310":58815,"_17659":98711,"_5":17554,"_23935":98684,"_2398":98712},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2871":58828,"_25310":58815,"_17659":98714,"_5":17554,"_23935":98684,"_2398":98715},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2871":58829,"_25310":58815,"_17659":98717,"_5":17554,"_23935":98684,"_2398":98718},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2871":58830,"_25310":58815,"_17659":98720,"_5":17554,"_23935":98684,"_2398":98721},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2871":58831,"_25310":58815,"_17659":98723,"_5":17554,"_23935":98684,"_2398":98724},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2871":58832,"_25310":58832,"_5":12413,"_2398":98726,"_25646":98727,"_17659":98728,"_23935":58832},"Dispositivos e identidades",[41060,97754,43424,98726],[],{"_2871":58833,"_25310":58832,"_17659":98730,"_5":17554,"_23935":58832,"_2398":98731},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2871":58834,"_25310":58832,"_5":25643,"_17659":98733,"_23935":98734,"_2398":98735},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2871":58835,"_25310":58832,"_5":25643,"_17659":98737,"_23935":98738,"_2398":98739},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2871":58836,"_25310":58832,"_5":25643,"_17659":98741,"_23935":98742,"_2398":98743},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2871":58837,"_25310":58832,"_5":25643,"_17659":98745,"_23935":98746,"_2398":98747},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2871":58838,"_25310":58832,"_5":25643,"_17659":98749,"_23935":98750,"_2398":98751},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2871":58839,"_25310":58832,"_5":25643,"_17659":98753,"_23935":98754,"_2398":98755},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2871":58840,"_25310":58832,"_5":25643,"_17659":98757,"_23935":98758,"_2398":98759},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2871":58841,"_25310":58832,"_5":25643,"_17659":98761,"_23935":98762,"_2398":98763},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2871":58842,"_25310":58832,"_5":25643,"_17659":98765,"_23935":98766,"_2398":98767},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2871":58843,"_25310":58832,"_5":25643,"_17659":98769,"_23935":98770,"_2398":98771},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2871":58844,"_25310":58832,"_5":25643,"_17659":98773,"_23935":98774,"_2398":98775},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2871":58845,"_25310":58832,"_17659":98777,"_5":17554,"_23935":58832,"_2398":98778},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2871":58846,"_25310":58832,"_17659":98780,"_5":17554,"_23935":58832,"_2398":98781},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2871":58847,"_25310":58832,"_17659":98783,"_5":17554,"_23935":98734,"_2398":98784},[],"Vista operativa",{"_2871":58848,"_25310":58832,"_17659":98786,"_5":17554,"_23935":98734,"_2398":98787},[],"Interpretación",{"_2871":58849,"_25310":58832,"_17659":98789,"_5":17554,"_23935":98734,"_2398":43487},[],{"_2871":58850,"_25310":58832,"_17659":98791,"_5":17554,"_23935":98734,"_2398":98792},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2871":58851,"_25310":58832,"_17659":98794,"_5":17554,"_23935":98734,"_2398":43493},[],{"_2871":58852,"_25310":58832,"_17659":98796,"_5":17554,"_23935":98734,"_2398":98797},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2871":58853,"_25310":58832,"_17659":98799,"_5":17554,"_23935":98734,"_2398":43499},[],{"_2871":58854,"_25310":58832,"_17659":98801,"_5":17554,"_23935":98734,"_2398":98802},[],"La identidad está en la ventana operativa de renovación.",{"_2871":58855,"_25310":58832,"_17659":98804,"_5":17554,"_23935":98734,"_2398":43505},[],{"_2871":58856,"_25310":58832,"_17659":98806,"_5":17554,"_23935":98734,"_2398":98807},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2871":58857,"_25310":58832,"_17659":98809,"_5":17554,"_23935":98734,"_2398":43511},[],{"_2871":58858,"_25310":58832,"_17659":98811,"_5":17554,"_23935":98734,"_2398":98812},[],"La identidad ha vencido.",{"_2871":58859,"_25310":58832,"_17659":98814,"_5":17554,"_23935":98734,"_2398":43517},[],{"_2871":58860,"_25310":58832,"_17659":98816,"_5":17554,"_23935":98734,"_2398":98817},[],"La identidad está marcada como revocada.",{"_2871":58861,"_25310":58832,"_17659":98819,"_5":17554,"_23935":98734,"_2398":43523},[],{"_2871":58862,"_25310":58832,"_17659":98821,"_5":17554,"_23935":98734,"_2398":98822},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2871":58863,"_25310":58832,"_17659":98824,"_5":17554,"_23935":98734,"_2398":98825},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2871":58864,"_25310":58832,"_17659":98827,"_5":17554,"_23935":98738,"_2398":98828},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2871":58865,"_25310":58832,"_17659":98830,"_5":17554,"_23935":98738,"_2398":98831},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2871":58866,"_25310":58832,"_17659":98833,"_5":17554,"_23935":98738,"_2398":98834},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2871":58867,"_25310":58832,"_17659":98836,"_5":17554,"_23935":98738,"_2398":98837},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2871":58868,"_25310":58832,"_17659":98839,"_5":17554,"_23935":98742,"_2398":98840},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2871":58869,"_25310":58832,"_17659":98842,"_5":17554,"_23935":98746,"_2398":98843},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2871":58870,"_25310":58832,"_17659":98845,"_5":17554,"_23935":98750,"_2398":98846},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2871":58871,"_25310":58832,"_17659":98848,"_5":17554,"_23935":98754,"_2398":98849},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2871":58872,"_25310":58832,"_17659":98851,"_5":17554,"_23935":98758,"_2398":98852},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2871":58873,"_25310":58832,"_17659":98854,"_5":17554,"_23935":98758,"_2398":98855},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2871":58874,"_25310":58832,"_17659":98857,"_5":17554,"_23935":98762,"_2398":98858},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2871":58875,"_25310":58832,"_17659":98860,"_5":17554,"_23935":98762,"_2398":98861},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2871":58876,"_25310":58832,"_17659":98863,"_5":17554,"_23935":98762,"_2398":98864},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2871":58877,"_25310":58832,"_17659":98866,"_5":17554,"_23935":98762,"_2398":98867},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2871":58878,"_25310":58832,"_17659":98869,"_5":17554,"_23935":98762,"_2398":98870},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2871":58879,"_25310":58832,"_17659":98872,"_5":17554,"_23935":98762,"_2398":98873},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2871":58880,"_25310":58832,"_17659":98875,"_5":17554,"_23935":98766,"_2398":98876},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2871":58881,"_25310":58832,"_17659":98878,"_5":17554,"_23935":98766,"_2398":98879},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2871":58882,"_25310":58832,"_17659":98881,"_5":17554,"_23935":98770,"_2398":98882},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2871":58883,"_25310":58832,"_17659":98884,"_5":17554,"_23935":98770,"_2398":98885},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2871":58884,"_25310":58832,"_17659":98887,"_5":17554,"_23935":98770,"_2398":98888},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2871":58885,"_25310":58832,"_17659":98890,"_5":17554,"_23935":98770,"_2398":98891},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2871":58886,"_25310":58832,"_17659":98893,"_5":17554,"_23935":98774,"_2398":98894},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2871":58887,"_25310":58832,"_17659":98896,"_5":17554,"_23935":98774,"_2398":98897},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2871":58888,"_25310":58888,"_5":12413,"_2398":98899,"_25646":98900,"_17659":98902,"_23935":58888},"Identidad inicial y autenticación",[41060,97754,43424,98726,98901],"Enrolamiento con PKI",[],{"_2871":58889,"_25310":58888,"_17659":98904,"_5":17554,"_23935":58888,"_2398":98905},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2871":58890,"_25310":58888,"_5":25643,"_17659":98907,"_23935":98908,"_2398":98909},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2871":58891,"_25310":58888,"_5":25643,"_17659":98911,"_23935":98912,"_2398":98913},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2871":58892,"_25310":58888,"_5":25643,"_17659":98915,"_23935":98916,"_2398":98917},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2871":58893,"_25310":58888,"_5":25643,"_17659":98919,"_23935":98920,"_2398":98921},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2871":58894,"_25310":58888,"_5":25643,"_17659":98923,"_23935":98924,"_2398":98925},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2871":58895,"_25310":58888,"_17659":98927,"_5":17554,"_23935":58888,"_2398":98928},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2871":58896,"_25310":58888,"_17659":98930,"_5":17554,"_23935":98908,"_2398":98931},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2871":58897,"_25310":58888,"_17659":98933,"_5":17554,"_23935":98908,"_2398":98934},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2871":58898,"_25310":58888,"_17659":98936,"_5":17554,"_23935":98912,"_2398":98937},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2871":58899,"_25310":58888,"_17659":98939,"_5":17554,"_23935":98912,"_2398":98940},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2871":58900,"_25310":58888,"_17659":98942,"_5":17554,"_23935":98912,"_2398":98943},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2871":58901,"_25310":58888,"_17659":98945,"_5":17554,"_23935":98916,"_2398":98946},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2871":58902,"_25310":58888,"_17659":98948,"_5":17554,"_23935":98916,"_2398":98949},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2871":58903,"_25310":58888,"_17659":98951,"_5":17554,"_23935":98920,"_2398":98952},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2871":58904,"_25310":58888,"_17659":98954,"_5":17554,"_23935":98920,"_2398":98955},[],"Ejemplo de cuerpo:",{"_2871":58905,"_25310":58888,"_17659":98957,"_5":17554,"_23935":98920,"_2398":98958},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2871":58906,"_25310":58888,"_17659":98960,"_5":17554,"_23935":98920,"_2398":98961},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2871":58907,"_25310":58888,"_17659":98963,"_5":17554,"_23935":98920,"_2398":98964},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2871":58908,"_25310":58888,"_17659":98966,"_5":17554,"_23935":98920,"_2398":98967},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2871":58909,"_25310":58888,"_17659":98969,"_5":17554,"_23935":98924,"_2398":98970},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2871":58910,"_25310":58888,"_17659":98972,"_5":17554,"_23935":98924,"_2398":98973},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2871":58911,"_25310":58911,"_5":12413,"_2398":98975,"_25646":98976,"_17659":98977,"_23935":58911},"Configura y opera el DMS",[41060,97754,43424,98726,98901],[],{"_2871":58912,"_25310":58911,"_17659":98979,"_5":17554,"_23935":58911,"_2398":98980},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2871":58913,"_25310":58911,"_5":25643,"_17659":98982,"_23935":98983,"_2398":96409},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2871":58914,"_25310":58911,"_5":25643,"_17659":98985,"_23935":98986,"_2398":98987},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2871":58915,"_25310":58911,"_5":25643,"_17659":98989,"_23935":98990,"_2398":98991},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2871":58916,"_25310":58911,"_5":25643,"_17659":98993,"_23935":98994,"_2398":98995},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2871":58917,"_25310":58911,"_5":25643,"_17659":98997,"_23935":98998,"_2398":98999},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2871":58918,"_25310":58911,"_5":25643,"_17659":99001,"_23935":99002,"_2398":99003},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2871":58919,"_25310":58911,"_5":25643,"_17659":99005,"_23935":99006,"_2398":99007},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2871":58920,"_25310":58911,"_5":25643,"_17659":99009,"_23935":99010,"_2398":99011},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2871":58921,"_25310":58911,"_5":25643,"_17659":99013,"_23935":99014,"_2398":43719},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2871":58922,"_25310":58911,"_5":25643,"_17659":99016,"_23935":99017,"_2398":43723},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2871":58923,"_25310":58911,"_5":25643,"_17659":99019,"_23935":99020,"_2398":99021},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2871":58924,"_25310":58911,"_5":25643,"_17659":99023,"_23935":99024,"_2398":99025},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2871":58925,"_25310":58911,"_5":25643,"_17659":99027,"_23935":99028,"_2398":99029},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2871":58926,"_25310":58911,"_5":25643,"_17659":99031,"_23935":99032,"_2398":99033},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2871":58927,"_25310":58911,"_5":25643,"_17659":99035,"_23935":99036,"_2398":43743},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2871":58928,"_25310":58911,"_5":25643,"_17659":99038,"_23935":99039,"_2398":99040},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2871":58929,"_25310":58911,"_5":25643,"_17659":99042,"_23935":99043,"_2398":99044},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2871":58930,"_25310":58911,"_5":25643,"_17659":99046,"_23935":99047,"_2398":99048},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2871":58931,"_25310":58911,"_17659":99050,"_5":17554,"_23935":58911,"_2398":99051},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2871":58932,"_25310":58911,"_17659":99053,"_5":17554,"_23935":98983,"_2398":99054},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2871":58933,"_25310":58911,"_17659":99056,"_5":17554,"_23935":98983,"_2398":99057},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2871":58934,"_25310":58911,"_17659":99059,"_5":17554,"_23935":98990,"_2398":99060},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2871":58935,"_25310":58911,"_17659":99062,"_5":17554,"_23935":98994,"_2398":99063},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2871":58936,"_25310":58911,"_17659":99065,"_5":17554,"_23935":98998,"_2398":99066},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2871":58937,"_25310":58911,"_17659":99068,"_5":17554,"_23935":99002,"_2398":99069},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2871":58938,"_25310":58911,"_17659":99071,"_5":17554,"_23935":99006,"_2398":99072},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2871":58939,"_25310":58911,"_17659":99074,"_5":17554,"_23935":99014,"_2398":99075},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2871":58940,"_25310":58911,"_17659":99077,"_5":17554,"_23935":99014,"_2398":99078},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2871":58941,"_25310":58911,"_17659":99080,"_5":17554,"_23935":99017,"_2398":99081},[],"Campo de `settings.enrollment_settings`",{"_2871":58942,"_25310":58911,"_17659":99083,"_5":17554,"_23935":99017,"_2398":99084},[],"Decisión",{"_2871":58943,"_25310":58911,"_17659":99086,"_5":17554,"_23935":99017,"_2398":43794},[],{"_2871":58944,"_25310":58911,"_17659":99088,"_5":17554,"_23935":99017,"_2398":99089},[],"`EST_RFC7030` para estas operaciones.",{"_2871":58945,"_25310":58911,"_17659":99091,"_5":17554,"_23935":99017,"_2398":43800},[],{"_2871":58946,"_25310":58911,"_17659":99093,"_5":17554,"_23935":99017,"_2398":99094},[],"ID de la CA que firmará.",{"_2871":58947,"_25310":58911,"_17659":99096,"_5":17554,"_23935":99017,"_2398":43806},[],{"_2871":58948,"_25310":58911,"_17659":99098,"_5":17554,"_23935":99017,"_2398":99099},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2871":58949,"_25310":58911,"_17659":99101,"_5":17554,"_23935":99017,"_2398":43812},[],{"_2871":58950,"_25310":58911,"_17659":99103,"_5":17554,"_23935":99017,"_2398":99104},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2871":58951,"_25310":58911,"_17659":99106,"_5":17554,"_23935":99017,"_2398":43818},[],{"_2871":58952,"_25310":58911,"_17659":99108,"_5":17554,"_23935":99017,"_2398":99109},[],"Uno de los cuatro modos de autenticación.",{"_2871":58953,"_25310":58911,"_17659":99111,"_5":17554,"_23935":99017,"_2398":99112},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2871":58954,"_25310":58911,"_17659":99114,"_5":17554,"_23935":99020,"_2398":99115},[],"Los bloques son independientes:",{"_2871":58955,"_25310":58911,"_17659":99117,"_5":17554,"_23935":99020,"_2398":99118},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2871":58956,"_25310":58911,"_17659":99120,"_5":17554,"_23935":99020,"_2398":99121},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2871":58957,"_25310":58911,"_17659":99123,"_5":17554,"_23935":99020,"_2398":43836},[],{"_2871":58958,"_25310":58911,"_17659":99125,"_5":17554,"_23935":99020,"_2398":99126},[],"Control aplicado en la operación configurada",{"_2871":58959,"_25310":58911,"_17659":99128,"_5":17554,"_23935":99020,"_2398":43842},[],{"_2871":58960,"_25310":58911,"_17659":99130,"_5":17554,"_23935":99020,"_2398":99131},[],"Validación del certificado presentado.",{"_2871":58961,"_25310":58911,"_17659":99133,"_5":17554,"_23935":99020,"_2398":43848},[],{"_2871":58962,"_25310":58911,"_17659":99135,"_5":17554,"_23935":99020,"_2398":99136},[],"Autorización del webhook configurado.",{"_2871":58963,"_25310":58911,"_17659":99138,"_5":17554,"_23935":99020,"_2398":43854},[],{"_2871":58964,"_25310":58911,"_17659":99140,"_5":17554,"_23935":99020,"_2398":99141},[],"Validación del certificado y, después, aprobación del webhook.",{"_2871":58965,"_25310":58911,"_17659":99143,"_5":17554,"_23935":99020,"_2398":43860},[],{"_2871":58966,"_25310":58911,"_17659":99145,"_5":17554,"_23935":99020,"_2398":99146},[],"Sin autenticación del solicitante por el DMS.",{"_2871":58967,"_25310":58911,"_17659":99148,"_5":17554,"_23935":99020,"_2398":99149},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2871":58968,"_25310":58911,"_17659":99151,"_5":17554,"_23935":99020,"_2398":99152},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2871":58969,"_25310":58911,"_17659":99154,"_5":17554,"_23935":99020,"_2398":99155},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2871":58970,"_25310":58911,"_17659":99157,"_5":17554,"_23935":99020,"_2398":99158},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2871":58971,"_25310":58911,"_17659":99160,"_5":17554,"_23935":99024,"_2398":99161},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2871":58972,"_25310":58911,"_17659":99163,"_5":17554,"_23935":99024,"_2398":99164},[],"Campo de `external_webhook_settings`",{"_2871":58973,"_25310":58911,"_17659":99166,"_5":17554,"_23935":99024,"_2398":99084},[],{"_2871":58974,"_25310":58911,"_17659":99168,"_5":17554,"_23935":99024,"_2398":43886},[],{"_2871":58975,"_25310":58911,"_17659":99170,"_5":17554,"_23935":99024,"_2398":99171},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2871":58976,"_25310":58911,"_17659":99173,"_5":17554,"_23935":99024,"_2398":43892},[],{"_2871":58977,"_25310":58911,"_17659":99175,"_5":17554,"_23935":99024,"_2398":99176},[],"`POST` o `PUT`; `POST` por defecto.",{"_2871":58978,"_25310":58911,"_17659":99178,"_5":17554,"_23935":99024,"_2398":43898},[],{"_2871":58979,"_25310":58911,"_17659":99180,"_5":17554,"_23935":99024,"_2398":99181},[],"Etiqueta usada en los logs del servicio.",{"_2871":58980,"_25310":58911,"_17659":99183,"_5":17554,"_23935":99024,"_2398":43904},[],{"_2871":58981,"_25310":58911,"_17659":99185,"_5":17554,"_23935":99024,"_2398":99186},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2871":58982,"_25310":58911,"_17659":99188,"_5":17554,"_23935":99024,"_2398":43910},[],{"_2871":58983,"_25310":58911,"_17659":99190,"_5":17554,"_23935":99024,"_2398":99191},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2871":58984,"_25310":58911,"_17659":99193,"_5":17554,"_23935":99024,"_2398":43916},[],{"_2871":58985,"_25310":58911,"_17659":99195,"_5":17554,"_23935":99024,"_2398":99196},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2871":58986,"_25310":58911,"_17659":99198,"_5":17554,"_23935":99024,"_2398":43922},[],{"_2871":58987,"_25310":58911,"_17659":99200,"_5":17554,"_23935":99024,"_2398":99201},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2871":58988,"_25310":58911,"_17659":99203,"_5":17554,"_23935":99024,"_2398":43928},[],{"_2871":58989,"_25310":58911,"_17659":99205,"_5":17554,"_23935":99024,"_2398":99206},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2871":58990,"_25310":58911,"_17659":99208,"_5":17554,"_23935":99024,"_2398":43934},[],{"_2871":58991,"_25310":58911,"_17659":99210,"_5":17554,"_23935":99024,"_2398":99211},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2871":58992,"_25310":58911,"_17659":99213,"_5":17554,"_23935":99024,"_2398":99214},[],"Reglas de esa configuración:",{"_2871":58993,"_25310":58911,"_17659":99216,"_5":17554,"_23935":99024,"_2398":99217},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2871":58994,"_25310":58911,"_17659":99219,"_5":17554,"_23935":99024,"_2398":99220},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2871":58995,"_25310":58911,"_17659":99222,"_5":17554,"_23935":99024,"_2398":99223},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2871":58996,"_25310":58911,"_17659":99225,"_5":17554,"_23935":99024,"_2398":99226},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2871":58997,"_25310":58911,"_17659":99228,"_5":17554,"_23935":99024,"_2398":99229},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2871":58998,"_25310":58911,"_17659":99231,"_5":17554,"_23935":99024,"_2398":99232},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2871":58999,"_25310":58911,"_17659":99234,"_5":17554,"_23935":99024,"_2398":99235},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2871":59000,"_25310":58911,"_17659":99237,"_5":17554,"_23935":99024,"_2398":99238},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2871":59001,"_25310":58911,"_17659":99240,"_5":17554,"_23935":99028,"_2398":99241},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2871":59002,"_25310":58911,"_17659":99243,"_5":17554,"_23935":99032,"_2398":99244},[],"Campo de `settings.reenrollment_settings`",{"_2871":59003,"_25310":58911,"_17659":99246,"_5":17554,"_23935":99032,"_2398":99247},[],"Función",{"_2871":59004,"_25310":58911,"_17659":99249,"_5":17554,"_23935":99032,"_2398":43975},[],{"_2871":59005,"_25310":58911,"_17659":99251,"_5":17554,"_23935":99032,"_2398":99252},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2871":59006,"_25310":58911,"_17659":99254,"_5":17554,"_23935":99032,"_2398":43981},[],{"_2871":59007,"_25310":58911,"_17659":99256,"_5":17554,"_23935":99032,"_2398":99257},[],"Umbral operativo preventivo de monitorización.",{"_2871":59008,"_25310":58911,"_17659":99259,"_5":17554,"_23935":99032,"_2398":43987},[],{"_2871":59009,"_25310":58911,"_17659":99261,"_5":17554,"_23935":99032,"_2398":99262},[],"Umbral operativo crítico de monitorización.",{"_2871":59010,"_25310":58911,"_17659":99264,"_5":17554,"_23935":99032,"_2398":43993},[],{"_2871":59011,"_25310":58911,"_17659":99266,"_5":17554,"_23935":99032,"_2398":99267},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2871":59012,"_25310":58911,"_17659":99269,"_5":17554,"_23935":99032,"_2398":43999},[],{"_2871":59013,"_25310":58911,"_17659":99271,"_5":17554,"_23935":99032,"_2398":99272},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2871":59014,"_25310":58911,"_17659":99274,"_5":17554,"_23935":99032,"_2398":44005},[],{"_2871":59015,"_25310":58911,"_17659":99276,"_5":17554,"_23935":99032,"_2398":99277},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2871":59016,"_25310":58911,"_17659":99279,"_5":17554,"_23935":99032,"_2398":99280},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2871":59017,"_25310":58911,"_17659":99282,"_5":17554,"_23935":99036,"_2398":99283},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2871":59018,"_25310":58911,"_17659":99285,"_5":17554,"_23935":99039,"_2398":96766},[],{"_2871":59019,"_25310":58911,"_17659":99287,"_5":17554,"_23935":99039,"_2398":99288},[],"Qué publica",{"_2871":59020,"_25310":58911,"_17659":99290,"_5":17554,"_23935":99039,"_2398":44022},[],{"_2871":59021,"_25310":58911,"_17659":99292,"_5":17554,"_23935":99039,"_2398":99293},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2871":59022,"_25310":58911,"_17659":99295,"_5":17554,"_23935":99039,"_2398":44028},[],{"_2871":59023,"_25310":58911,"_17659":99297,"_5":17554,"_23935":99039,"_2398":99298},[],"Certificado de la CA emisora seleccionada.",{"_2871":59024,"_25310":58911,"_17659":99300,"_5":17554,"_23935":99039,"_2398":44034},[],{"_2871":59025,"_25310":58911,"_17659":99302,"_5":17554,"_23935":99039,"_2398":99303},[],"Certificados de las CAs elegidas explícitamente.",{"_2871":59026,"_25310":58911,"_17659":99305,"_5":17554,"_23935":99039,"_2398":99306},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2871":59027,"_25310":58911,"_17659":99308,"_5":17554,"_23935":99043,"_2398":99309},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2871":59028,"_25310":58911,"_17659":99311,"_5":17554,"_23935":99043,"_2398":99312},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2871":59029,"_25310":58911,"_17659":99314,"_5":17554,"_23935":99043,"_2398":99315},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2871":59030,"_25310":58911,"_17659":99317,"_5":17554,"_23935":99047,"_2398":99318},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2871":59031,"_25310":59031,"_5":12413,"_2398":99320,"_25646":99321,"_17659":99322,"_23935":59031},"Integra el cliente EST",[41060,97754,43424,98726,98901],[],{"_2871":59032,"_25310":59031,"_17659":99324,"_5":17554,"_23935":59031,"_2398":99325},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2871":59033,"_25310":59031,"_5":25643,"_17659":99327,"_23935":99328,"_2398":96409},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2871":59034,"_25310":59031,"_5":25643,"_17659":99330,"_23935":99331,"_2398":99332},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2871":59035,"_25310":59031,"_5":25643,"_17659":99334,"_23935":99335,"_2398":99336},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2871":59036,"_25310":59031,"_5":25643,"_17659":99338,"_23935":99339,"_2398":99340},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2871":59037,"_25310":59031,"_5":25643,"_17659":99342,"_23935":99343,"_2398":99344},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2871":59038,"_25310":59031,"_5":25643,"_17659":99346,"_23935":99347,"_2398":99348},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2871":59039,"_25310":59031,"_17659":99350,"_5":17554,"_23935":59031,"_2398":99351},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2871":59040,"_25310":59031,"_17659":99353,"_5":17554,"_23935":99328,"_2398":99354},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2871":59041,"_25310":59031,"_17659":99356,"_5":17554,"_23935":99328,"_2398":99357},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2871":59042,"_25310":59031,"_17659":99359,"_5":17554,"_23935":99328,"_2398":99360},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2871":59043,"_25310":59031,"_17659":99362,"_5":17554,"_23935":99331,"_2398":99363},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2871":59044,"_25310":59031,"_17659":99365,"_5":17554,"_23935":99331,"_2398":99366},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2871":59045,"_25310":59031,"_17659":99368,"_5":17554,"_23935":99335,"_2398":99369},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2871":59046,"_25310":59031,"_17659":99371,"_5":17554,"_23935":99335,"_2398":99372},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2871":59047,"_25310":59031,"_17659":99374,"_5":17554,"_23935":99339,"_2398":99375},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2871":59048,"_25310":59031,"_17659":99377,"_5":17554,"_23935":99339,"_2398":99378},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2871":59049,"_25310":59031,"_17659":99380,"_5":17554,"_23935":99343,"_2398":99381},[],"Para el caso de una raíz que emite directamente:",{"_2871":59050,"_25310":59031,"_17659":99383,"_5":17554,"_23935":99343,"_2398":99384},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2871":59051,"_25310":59031,"_17659":99386,"_5":17554,"_23935":99343,"_2398":99387},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2871":59052,"_25310":59031,"_17659":99389,"_5":17554,"_23935":99347,"_2398":99390},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2871":59053,"_25310":59053,"_5":12413,"_2398":99392,"_25646":99393,"_17659":99394,"_23935":59053},"Referencia EST",[41060,97754,43424,98726,98901],[],{"_2871":59054,"_25310":59053,"_17659":99396,"_5":17554,"_23935":59053,"_2398":99397},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2871":59055,"_25310":59053,"_5":25643,"_17659":99399,"_23935":99400,"_2398":99401},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2871":59056,"_25310":59053,"_5":25643,"_17659":99403,"_23935":99404,"_2398":19163},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2871":59057,"_25310":59053,"_5":25643,"_17659":99406,"_23935":99407,"_2398":21954},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2871":59058,"_25310":59053,"_5":25643,"_17659":99409,"_23935":99410,"_2398":21961},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2871":59059,"_25310":59053,"_5":25643,"_17659":99412,"_23935":99413,"_2398":21325},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2871":59060,"_25310":59053,"_5":25643,"_17659":99415,"_23935":99416,"_2398":99417},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2871":59061,"_25310":59053,"_5":25643,"_17659":99419,"_23935":99420,"_2398":99421},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2871":59062,"_25310":59053,"_5":25643,"_17659":99423,"_23935":99424,"_2398":99425},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2871":59063,"_25310":59053,"_17659":99427,"_5":17554,"_23935":59053,"_2398":99428},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2871":59064,"_25310":59053,"_17659":99430,"_5":17554,"_23935":99400,"_2398":99431},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2871":59065,"_25310":59053,"_17659":99433,"_5":17554,"_23935":99400,"_2398":97527},[],{"_2871":59066,"_25310":59053,"_17659":99435,"_5":17554,"_23935":99400,"_2398":99436},[],"Método",{"_2871":59067,"_25310":59053,"_17659":99438,"_5":17554,"_23935":99400,"_2398":99439},[],"Autenticación y condición",{"_2871":59068,"_25310":59053,"_17659":99441,"_5":17554,"_23935":99400,"_2398":44177},[],{"_2871":59069,"_25310":59053,"_17659":99443,"_5":17554,"_23935":99400,"_2398":44180},[],{"_2871":59070,"_25310":59053,"_17659":99445,"_5":17554,"_23935":99400,"_2398":99446},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2871":59071,"_25310":59053,"_17659":99448,"_5":17554,"_23935":99400,"_2398":44186},[],{"_2871":59072,"_25310":59053,"_17659":99450,"_5":17554,"_23935":99400,"_2398":44189},[],{"_2871":59073,"_25310":59053,"_17659":99452,"_5":17554,"_23935":99400,"_2398":99453},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2871":59074,"_25310":59053,"_17659":99455,"_5":17554,"_23935":99400,"_2398":44195},[],{"_2871":59075,"_25310":59053,"_17659":99457,"_5":17554,"_23935":99400,"_2398":44189},[],{"_2871":59076,"_25310":59053,"_17659":99459,"_5":17554,"_23935":99400,"_2398":99460},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2871":59077,"_25310":59053,"_17659":99462,"_5":17554,"_23935":99400,"_2398":44203},[],{"_2871":59078,"_25310":59053,"_17659":99464,"_5":17554,"_23935":99400,"_2398":44189},[],{"_2871":59079,"_25310":59053,"_17659":99466,"_5":17554,"_23935":99400,"_2398":99467},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2871":59080,"_25310":59053,"_17659":99469,"_5":17554,"_23935":99400,"_2398":99470},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2871":59081,"_25310":59053,"_17659":99472,"_5":17554,"_23935":99404,"_2398":99473},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2871":59082,"_25310":59053,"_17659":99475,"_5":17554,"_23935":99404,"_2398":99476},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2871":59083,"_25310":59053,"_17659":99478,"_5":17554,"_23935":99407,"_2398":99479},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2871":59084,"_25310":59053,"_17659":99481,"_5":17554,"_23935":99407,"_2398":99482},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2871":59085,"_25310":59053,"_17659":99484,"_5":17554,"_23935":99410,"_2398":99485},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2871":59086,"_25310":59053,"_17659":99487,"_5":17554,"_23935":99410,"_2398":99488},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2871":59087,"_25310":59053,"_17659":99490,"_5":17554,"_23935":99413,"_2398":99491},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2871":59088,"_25310":59053,"_17659":99493,"_5":17554,"_23935":99413,"_2398":99494},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2871":59089,"_25310":59053,"_17659":99496,"_5":17554,"_23935":99416,"_2398":99497},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2871":59090,"_25310":59053,"_17659":99499,"_5":17554,"_23935":99416,"_2398":99500},[],"Parte",{"_2871":59091,"_25310":59053,"_17659":99502,"_5":17554,"_23935":99416,"_2398":99503},[],"Contenido tras decodificar su Base64",{"_2871":59092,"_25310":59053,"_17659":99505,"_5":17554,"_23935":99416,"_2398":44247},[],{"_2871":59093,"_25310":59053,"_17659":99507,"_5":17554,"_23935":99416,"_2398":99508},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2871":59094,"_25310":59053,"_17659":99510,"_5":17554,"_23935":99416,"_2398":44253},[],{"_2871":59095,"_25310":59053,"_17659":99512,"_5":17554,"_23935":99416,"_2398":99513},[],"PKCS#7 DER con el certificado emitido.",{"_2871":59096,"_25310":59053,"_17659":99515,"_5":17554,"_23935":99416,"_2398":99516},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2871":59097,"_25310":59053,"_17659":99518,"_5":17554,"_23935":99420,"_2398":99519},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2871":59098,"_25310":59053,"_17659":99521,"_5":17554,"_23935":99420,"_2398":99522},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2871":59099,"_25310":59053,"_17659":99524,"_5":17554,"_23935":99420,"_2398":99525},[],"Convierte y comprueba el resultado:",{"_2871":59100,"_25310":59053,"_17659":99527,"_5":17554,"_23935":99420,"_2398":99528},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2871":59101,"_25310":59053,"_17659":99530,"_5":17554,"_23935":99424,"_2398":99531},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2871":59102,"_25310":59053,"_17659":99533,"_5":17554,"_23935":99424,"_2398":99534},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2871":59103,"_25310":59103,"_5":12413,"_2398":98901,"_25646":99536,"_17659":99537,"_23935":59103},[41060,97754,43424,98726,98901],[],{"_2871":59104,"_25310":59103,"_17659":99539,"_5":17554,"_23935":59103,"_2398":99540},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2871":59105,"_25310":59103,"_5":25643,"_17659":99542,"_23935":99543,"_2398":99544},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2871":59106,"_25310":59103,"_5":25643,"_17659":99546,"_23935":99547,"_2398":99548},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2871":59107,"_25310":59103,"_5":25643,"_17659":99550,"_23935":99551,"_2398":99552},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2871":59108,"_25310":59103,"_5":25643,"_17659":99554,"_23935":99555,"_2398":99556},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2871":59109,"_25310":59103,"_17659":99558,"_5":17554,"_23935":59103,"_2398":99559},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2871":59110,"_25310":59103,"_17659":99561,"_5":17554,"_23935":99543,"_2398":99562},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2871":59111,"_25310":59103,"_17659":99564,"_5":17554,"_23935":99543,"_2398":99565},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2871":59112,"_25310":59103,"_17659":99567,"_5":17554,"_23935":99543,"_2398":99568},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2871":59113,"_25310":59103,"_17659":99570,"_5":17554,"_23935":99543,"_2398":99571},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2871":59114,"_25310":59103,"_17659":99573,"_5":17554,"_23935":99543,"_2398":99574},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2871":59115,"_25310":59103,"_17659":99576,"_5":17554,"_23935":99543,"_2398":99577},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2871":59116,"_25310":59103,"_17659":99579,"_5":17554,"_23935":99547,"_2398":99580},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2871":59117,"_25310":59103,"_17659":99582,"_5":17554,"_23935":99547,"_2398":99583},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2871":59118,"_25310":59103,"_17659":99585,"_5":17554,"_23935":99547,"_2398":99586},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2871":59119,"_25310":59103,"_17659":99588,"_5":17554,"_23935":99547,"_2398":99589},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2871":59120,"_25310":59103,"_17659":99591,"_5":17554,"_23935":99551,"_2398":99592},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2871":59121,"_25310":59103,"_17659":99594,"_5":17554,"_23935":99551,"_2398":99595},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2871":59122,"_25310":59103,"_17659":99597,"_5":17554,"_23935":99551,"_2398":99598},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2871":59123,"_25310":59103,"_17659":99600,"_5":17554,"_23935":99551,"_2398":99601},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2871":59124,"_25310":59103,"_17659":99603,"_5":17554,"_23935":99555,"_2398":99604},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2871":59125,"_25310":59103,"_17659":99606,"_5":17554,"_23935":99555,"_2398":99607},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2871":59126,"_25310":59126,"_5":12413,"_2398":99609,"_25646":99610,"_17659":99611,"_23935":59126},"Estrategias de aprovisionamiento",[41060,97754,43424,98726,98901],[],{"_2871":59127,"_25310":59126,"_17659":99613,"_5":17554,"_23935":59126,"_2398":99614},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2871":59128,"_25310":59126,"_5":25643,"_17659":99616,"_23935":99617,"_2398":99618},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2871":59129,"_25310":59126,"_5":25643,"_17659":99620,"_23935":99621,"_2398":99622},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2871":59130,"_25310":59126,"_5":25643,"_17659":99624,"_23935":99625,"_2398":99626},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2871":59131,"_25310":59126,"_5":25643,"_17659":99628,"_23935":99629,"_2398":99630},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2871":59132,"_25310":59126,"_5":25643,"_17659":99632,"_23935":99633,"_2398":99634},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2871":59133,"_25310":59126,"_17659":99636,"_5":17554,"_23935":59126,"_2398":99637},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2871":59134,"_25310":59126,"_17659":99639,"_5":17554,"_23935":99617,"_2398":99640},[],"Recorrido",{"_2871":59135,"_25310":59126,"_17659":99642,"_5":17554,"_23935":99617,"_2398":99643},[],"Cuándo existe el dispositivo",{"_2871":59136,"_25310":59126,"_17659":99645,"_5":17554,"_23935":99617,"_2398":99646},[],"Qué compruebas",{"_2871":59137,"_25310":59126,"_17659":99648,"_5":17554,"_23935":99617,"_2398":99649},[],"Asignación manual",{"_2871":59138,"_25310":59126,"_17659":99651,"_5":17554,"_23935":99617,"_2398":99652},[],"El operador lo crea antes de asociar un certificado.",{"_2871":59139,"_25310":59126,"_17659":99654,"_5":17554,"_23935":99617,"_2398":99655},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2871":59140,"_25310":59126,"_17659":99657,"_5":17554,"_23935":99617,"_2398":99658},[],"EST con `JITP`",{"_2871":59141,"_25310":59126,"_17659":99660,"_5":17554,"_23935":99617,"_2398":99661},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2871":59142,"_25310":59126,"_17659":99663,"_5":17554,"_23935":99617,"_2398":99664},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2871":59143,"_25310":59126,"_17659":99666,"_5":17554,"_23935":99617,"_2398":99667},[],"EST con `PRE_REGISTRATION`",{"_2871":59144,"_25310":59126,"_17659":99669,"_5":17554,"_23935":99617,"_2398":99670},[],"Debe existir antes de `/simpleenroll`.",{"_2871":59145,"_25310":59126,"_17659":99672,"_5":17554,"_23935":99617,"_2398":99673},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2871":59146,"_25310":59126,"_17659":99675,"_5":17554,"_23935":99617,"_2398":99676},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2871":59147,"_25310":59126,"_17659":99678,"_5":17554,"_23935":99617,"_2398":99679},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2871":59148,"_25310":59126,"_17659":99681,"_5":17554,"_23935":99621,"_2398":99682},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2871":59149,"_25310":59126,"_17659":99684,"_5":17554,"_23935":99621,"_2398":99685},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2871":59150,"_25310":59126,"_17659":99687,"_5":17554,"_23935":99621,"_2398":99688},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2871":59151,"_25310":59126,"_17659":99690,"_5":17554,"_23935":99625,"_2398":99691},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2871":59152,"_25310":59126,"_17659":99693,"_5":17554,"_23935":99625,"_2398":99694},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2871":59153,"_25310":59126,"_17659":99696,"_5":17554,"_23935":99625,"_2398":99697},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2871":59154,"_25310":59126,"_17659":99699,"_5":17554,"_23935":99625,"_2398":99700},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2871":59155,"_25310":59126,"_17659":99702,"_5":17554,"_23935":99625,"_2398":99703},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2871":59156,"_25310":59126,"_17659":99705,"_5":17554,"_23935":99625,"_2398":99706},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2871":59157,"_25310":59126,"_17659":99708,"_5":17554,"_23935":99629,"_2398":96766},[],{"_2871":59158,"_25310":59126,"_17659":99710,"_5":17554,"_23935":99629,"_2398":99711},[],"Material que atraviesa EST",{"_2871":59159,"_25310":59126,"_17659":99713,"_5":17554,"_23935":99629,"_2398":99714},[],"Clave generada por el dispositivo",{"_2871":59160,"_25310":59126,"_17659":99716,"_5":17554,"_23935":99629,"_2398":99717},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2871":59161,"_25310":59126,"_17659":99719,"_5":17554,"_23935":99629,"_2398":99720},[],"Clave ya disponible en el dispositivo",{"_2871":59162,"_25310":59126,"_17659":99722,"_5":17554,"_23935":99629,"_2398":99723},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2871":59163,"_25310":59126,"_17659":99725,"_5":17554,"_23935":99629,"_2398":43743},[],{"_2871":59164,"_25310":59126,"_17659":99727,"_5":17554,"_23935":99629,"_2398":99728},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2871":59165,"_25310":59126,"_17659":99730,"_5":17554,"_23935":99629,"_2398":99731},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2871":59166,"_25310":59126,"_17659":99733,"_5":17554,"_23935":99633,"_2398":99734},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2871":59167,"_25310":59167,"_5":12413,"_2398":99736,"_25646":99737,"_17659":99738,"_23935":59167},"Renovación y recuperación",[41060,97754,43424,98726,98901],[],{"_2871":59168,"_25310":59167,"_17659":99740,"_5":17554,"_23935":59167,"_2398":99741},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2871":59169,"_25310":59167,"_5":25643,"_17659":99743,"_23935":99744,"_2398":99745},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2871":59170,"_25310":59167,"_5":25643,"_17659":99747,"_23935":99748,"_2398":99749},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2871":59171,"_25310":59167,"_5":25643,"_17659":99751,"_23935":99752,"_2398":99753},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2871":59172,"_25310":59167,"_5":25643,"_17659":99755,"_23935":99756,"_2398":99757},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2871":59173,"_25310":59167,"_5":25643,"_17659":99759,"_23935":99760,"_2398":99761},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2871":59174,"_25310":59167,"_17659":99763,"_5":17554,"_23935":59167,"_2398":99764},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2871":59175,"_25310":59167,"_17659":99766,"_5":17554,"_23935":99744,"_2398":99767},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2871":59176,"_25310":59167,"_17659":99769,"_5":17554,"_23935":99744,"_2398":99770},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2871":59177,"_25310":59167,"_17659":99772,"_5":17554,"_23935":99744,"_2398":99773},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2871":59178,"_25310":59167,"_17659":99775,"_5":17554,"_23935":99744,"_2398":99776},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2871":59179,"_25310":59167,"_17659":99778,"_5":17554,"_23935":99748,"_2398":99779},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2871":59180,"_25310":59167,"_17659":99781,"_5":17554,"_23935":99748,"_2398":99782},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2871":59181,"_25310":59167,"_17659":99784,"_5":17554,"_23935":99752,"_2398":99785},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2871":59182,"_25310":59167,"_17659":99787,"_5":17554,"_23935":99752,"_2398":99788},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2871":59183,"_25310":59167,"_17659":99790,"_5":17554,"_23935":99752,"_2398":99791},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2871":59184,"_25310":59167,"_17659":99793,"_5":17554,"_23935":99756,"_2398":99794},[],"Situación",{"_2871":59185,"_25310":59167,"_17659":99796,"_5":17554,"_23935":99756,"_2398":99797},[],"Procedimiento",{"_2871":59186,"_25310":59167,"_17659":99799,"_5":17554,"_23935":99756,"_2398":99800},[],"Certificado vigente, fuera de ventana",{"_2871":59187,"_25310":59167,"_17659":99802,"_5":17554,"_23935":99756,"_2398":99803},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2871":59188,"_25310":59167,"_17659":99805,"_5":17554,"_23935":99756,"_2398":99806},[],"Certificado vencido, clave disponible",{"_2871":59189,"_25310":59167,"_17659":99808,"_5":17554,"_23935":99756,"_2398":99809},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2871":59190,"_25310":59167,"_17659":99811,"_5":17554,"_23935":99756,"_2398":99812},[],"Renovación por webhook o `NO_AUTH`",{"_2871":59191,"_25310":59167,"_17659":99814,"_5":17554,"_23935":99756,"_2398":99815},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2871":59192,"_25310":59167,"_17659":99817,"_5":17554,"_23935":99756,"_2398":99818},[],"Clave perdida o inaccesible",{"_2871":59193,"_25310":59167,"_17659":99820,"_5":17554,"_23935":99756,"_2398":99821},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2871":59194,"_25310":59167,"_17659":99823,"_5":17554,"_23935":99756,"_2398":99824},[],"Identidad actual revocada",{"_2871":59195,"_25310":59167,"_17659":99826,"_5":17554,"_23935":99756,"_2398":99827},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2871":59196,"_25310":59167,"_17659":99829,"_5":17554,"_23935":99756,"_2398":99830},[],"Dispositivo sin identidad",{"_2871":59197,"_25310":59167,"_17659":99832,"_5":17554,"_23935":99756,"_2398":99833},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2871":59198,"_25310":59167,"_17659":99835,"_5":17554,"_23935":99756,"_2398":99836},[],"Dispositivo retirado",{"_2871":59199,"_25310":59167,"_17659":99838,"_5":17554,"_23935":99756,"_2398":99839},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2871":59200,"_25310":59167,"_17659":99841,"_5":17554,"_23935":99756,"_2398":99842},[],"Timeout, HTTP 500 o fallo de instalación",{"_2871":59201,"_25310":59167,"_17659":99844,"_5":17554,"_23935":99756,"_2398":99845},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2871":59202,"_25310":59167,"_17659":99847,"_5":17554,"_23935":99760,"_2398":99848},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2871":59203,"_25310":59167,"_17659":99850,"_5":17554,"_23935":99760,"_2398":99851},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2871":59204,"_25310":59204,"_5":12413,"_2398":99853,"_25646":99854,"_17659":99855,"_23935":59204},"Diagnóstico de enrolamiento",[41060,97754,43424,98726,98901],[],{"_2871":59205,"_25310":59204,"_17659":99857,"_5":17554,"_23935":59204,"_2398":99858},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2871":59206,"_25310":59204,"_5":25643,"_17659":99860,"_23935":99861,"_2398":99862},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2871":59207,"_25310":59204,"_5":25643,"_17659":99864,"_23935":99865,"_2398":99866},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2871":59208,"_25310":59204,"_5":25643,"_17659":99868,"_23935":99869,"_2398":99425},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2871":59209,"_25310":59204,"_5":25643,"_17659":99871,"_23935":99872,"_2398":99873},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2871":59210,"_25310":59204,"_17659":99875,"_5":17554,"_23935":59204,"_2398":99876},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2871":59211,"_25310":59204,"_17659":99878,"_5":17554,"_23935":99865,"_2398":99879},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2871":59212,"_25310":59204,"_17659":99881,"_5":17554,"_23935":99865,"_2398":99882},[],"Síntoma o mensaje",{"_2871":59213,"_25310":59204,"_17659":99884,"_5":17554,"_23935":99865,"_2398":99885},[],"Qué revisar",{"_2871":59214,"_25310":59204,"_17659":99887,"_5":17554,"_23935":99865,"_2398":99888},[],"curl rechaza TLS, nombre o emisor",{"_2871":59215,"_25310":59204,"_17659":99890,"_5":17554,"_23935":99865,"_2398":99891},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2871":59216,"_25310":59204,"_17659":99893,"_5":17554,"_23935":99865,"_2398":99894},[],"404 o APS ausente",{"_2871":59217,"_25310":59204,"_17659":99896,"_5":17554,"_23935":99865,"_2398":99897},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2871":59218,"_25310":59204,"_17659":99899,"_5":17554,"_23935":99865,"_2398":99900},[],"400, error de CSR o formato",{"_2871":59219,"_25310":59204,"_17659":99902,"_5":17554,"_23935":99865,"_2398":99903},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2871":59220,"_25310":59204,"_17659":99905,"_5":17554,"_23935":99865,"_2398":99906},[],"Credencial ausente o certificado no válido",{"_2871":59221,"_25310":59204,"_17659":99908,"_5":17554,"_23935":99865,"_2398":99909},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2871":59222,"_25310":59204,"_17659":99911,"_5":17554,"_23935":99865,"_2398":99912},[],"Webhook deniega, expira o responde sin autorización",{"_2871":59223,"_25310":59204,"_17659":99914,"_5":17554,"_23935":99865,"_2398":99915},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2871":59224,"_25310":59204,"_17659":99917,"_5":17554,"_23935":99865,"_2398":44660},[],{"_2871":59225,"_25310":59204,"_17659":99919,"_5":17554,"_23935":99865,"_2398":99920},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2871":59226,"_25310":59204,"_17659":99922,"_5":17554,"_23935":99865,"_2398":44666},[],{"_2871":59227,"_25310":59204,"_17659":99924,"_5":17554,"_23935":99865,"_2398":99925},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2871":59228,"_25310":59204,"_17659":99927,"_5":17554,"_23935":99865,"_2398":44672},[],{"_2871":59229,"_25310":59204,"_17659":99929,"_5":17554,"_23935":99865,"_2398":99930},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2871":59230,"_25310":59204,"_17659":99932,"_5":17554,"_23935":99865,"_2398":99933},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2871":59231,"_25310":59204,"_17659":99935,"_5":17554,"_23935":99865,"_2398":99936},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2871":59232,"_25310":59204,"_17659":99938,"_5":17554,"_23935":99865,"_2398":99939},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2871":59233,"_25310":59204,"_17659":99941,"_5":17554,"_23935":99865,"_2398":99942},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2871":59234,"_25310":59204,"_17659":99944,"_5":17554,"_23935":99865,"_2398":44690},[],{"_2871":59235,"_25310":59204,"_17659":99946,"_5":17554,"_23935":99865,"_2398":99947},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2871":59236,"_25310":59204,"_17659":99949,"_5":17554,"_23935":99865,"_2398":44696},[],{"_2871":59237,"_25310":59204,"_17659":99951,"_5":17554,"_23935":99865,"_2398":99952},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2871":59238,"_25310":59204,"_17659":99954,"_5":17554,"_23935":99865,"_2398":99955},[],"DMS propietario distinto",{"_2871":59239,"_25310":59204,"_17659":99957,"_5":17554,"_23935":99865,"_2398":99958},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2871":59240,"_25310":59204,"_17659":99960,"_5":17554,"_23935":99865,"_2398":44708},[],{"_2871":59241,"_25310":59204,"_17659":99962,"_5":17554,"_23935":99865,"_2398":99963},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2871":59242,"_25310":59204,"_17659":99965,"_5":17554,"_23935":99865,"_2398":44714},[],{"_2871":59243,"_25310":59204,"_17659":99967,"_5":17554,"_23935":99865,"_2398":99968},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2871":59244,"_25310":59204,"_17659":99970,"_5":17554,"_23935":99865,"_2398":99971},[],"Certificado actual revocado",{"_2871":59245,"_25310":59204,"_17659":99973,"_5":17554,"_23935":99865,"_2398":99974},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2871":59246,"_25310":59204,"_17659":99976,"_5":17554,"_23935":99865,"_2398":99977},[],"Error de CA, perfil o firma",{"_2871":59247,"_25310":59204,"_17659":99979,"_5":17554,"_23935":99865,"_2398":99980},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2871":59248,"_25310":59204,"_17659":99982,"_5":17554,"_23935":99865,"_2398":99983},[],"HTTP 200 sin conexión del dispositivo",{"_2871":59249,"_25310":59204,"_17659":99985,"_5":17554,"_23935":99865,"_2398":99986},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2871":59250,"_25310":59204,"_17659":99988,"_5":17554,"_23935":99865,"_2398":99989},[],"Timeout o error después de emitir",{"_2871":59251,"_25310":59204,"_17659":99991,"_5":17554,"_23935":99865,"_2398":99992},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2871":59252,"_25310":59204,"_17659":99994,"_5":17554,"_23935":99869,"_2398":99995},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2871":59253,"_25310":59204,"_17659":99997,"_5":17554,"_23935":99869,"_2398":99998},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2871":59254,"_25310":59204,"_17659":100000,"_5":17554,"_23935":99872,"_2398":100001},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2871":59255,"_25310":59204,"_17659":100003,"_5":17554,"_23935":99872,"_2398":100004},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2871":59256,"_25310":59204,"_17659":100006,"_5":17554,"_23935":99872,"_2398":100007},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2871":59257,"_25310":59204,"_17659":100009,"_5":17554,"_23935":99872,"_2398":100010},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2871":59258,"_25310":59204,"_17659":100012,"_5":17554,"_23935":99872,"_2398":100013},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2871":59259,"_25310":59204,"_17659":100015,"_5":17554,"_23935":99872,"_2398":100016},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2871":59260,"_25310":59204,"_17659":100018,"_5":17554,"_23935":99872,"_2398":100019},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2871":59261,"_25310":59261,"_5":12413,"_2398":100021,"_25646":100022,"_17659":100023,"_23935":59261},"Distribución y actualización de confianza",[41060,97754,43424,98726,98901],[],{"_2871":59262,"_25310":59261,"_17659":100025,"_5":17554,"_23935":59261,"_2398":100026},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2871":59263,"_25310":59261,"_5":25643,"_17659":100028,"_23935":100029,"_2398":100030},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2871":59264,"_25310":59261,"_5":25643,"_17659":100032,"_23935":100033,"_2398":100034},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2871":59265,"_25310":59261,"_5":25643,"_17659":100036,"_23935":100037,"_2398":100038},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2871":59266,"_25310":59261,"_5":25643,"_17659":100040,"_23935":100041,"_2398":100042},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2871":59267,"_25310":59261,"_5":25643,"_17659":100044,"_23935":100045,"_2398":100046},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2871":59268,"_25310":59261,"_17659":100048,"_5":17554,"_23935":59261,"_2398":100049},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2871":59269,"_25310":59261,"_17659":100051,"_5":17554,"_23935":100029,"_2398":100052},[],"Relación",{"_2871":59270,"_25310":59261,"_17659":100054,"_5":17554,"_23935":100029,"_2398":100055},[],"Material que prepara el responsable",{"_2871":59271,"_25310":59261,"_17659":100057,"_5":17554,"_23935":100029,"_2398":100058},[],"Dispositivo → servidor EST",{"_2871":59272,"_25310":59261,"_17659":100060,"_5":17554,"_23935":100029,"_2398":100061},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2871":59273,"_25310":59261,"_17659":100063,"_5":17554,"_23935":100029,"_2398":100064},[],"DMS → solicitante",{"_2871":59274,"_25310":59261,"_17659":100066,"_5":17554,"_23935":100029,"_2398":100067},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2871":59275,"_25310":59261,"_17659":100069,"_5":17554,"_23935":100029,"_2398":100070},[],"Consumidor → dispositivo",{"_2871":59276,"_25310":59261,"_17659":100072,"_5":17554,"_23935":100029,"_2398":100073},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2871":59277,"_25310":59261,"_17659":100075,"_5":17554,"_23935":100029,"_2398":100076},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2871":59278,"_25310":59261,"_17659":100078,"_5":17554,"_23935":100033,"_2398":100079},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2871":59279,"_25310":59261,"_17659":100081,"_5":17554,"_23935":100033,"_2398":100082},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2871":59280,"_25310":59261,"_17659":100084,"_5":17554,"_23935":100037,"_2398":100085},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2871":59281,"_25310":59261,"_17659":100087,"_5":17554,"_23935":100037,"_2398":100088},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2871":59282,"_25310":59261,"_17659":100090,"_5":17554,"_23935":100037,"_2398":100091},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2871":59283,"_25310":59261,"_17659":100093,"_5":17554,"_23935":100037,"_2398":100094},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2871":59284,"_25310":59261,"_17659":100096,"_5":17554,"_23935":100037,"_2398":100097},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2871":59285,"_25310":59261,"_17659":100099,"_5":17554,"_23935":100037,"_2398":100100},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2871":59286,"_25310":59261,"_17659":100102,"_5":17554,"_23935":100041,"_2398":100103},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2871":59287,"_25310":59261,"_17659":100105,"_5":17554,"_23935":100041,"_2398":100106},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2871":59288,"_25310":59261,"_17659":100108,"_5":17554,"_23935":100041,"_2398":100109},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2871":59289,"_25310":59261,"_17659":100111,"_5":17554,"_23935":100045,"_2398":100112},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2871":59290,"_25310":59290,"_5":12413,"_2398":44863,"_25646":100114,"_17659":100116,"_23935":59290},[41060,97754,43424,98726,100115],"Integraciones",[],{"_2871":59291,"_25310":59290,"_17659":100118,"_5":17554,"_23935":59290,"_2398":100119},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2871":59292,"_25310":59290,"_5":25643,"_17659":100121,"_23935":100122,"_2398":100123},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2871":59293,"_25310":59290,"_5":25643,"_17659":100125,"_23935":100126,"_2398":100127},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2871":59294,"_25310":59290,"_5":25643,"_17659":100129,"_23935":100130,"_2398":100131},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2871":59295,"_25310":59290,"_5":25643,"_17659":100133,"_23935":100134,"_2398":100135},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2871":59296,"_25310":59290,"_5":25643,"_17659":100137,"_23935":100138,"_2398":100139},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2871":59297,"_25310":59290,"_5":25643,"_17659":100141,"_23935":100142,"_2398":100143},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2871":59298,"_25310":59290,"_5":25643,"_17659":100145,"_23935":100146,"_2398":44897},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2871":59299,"_25310":59290,"_5":25643,"_17659":100148,"_23935":100149,"_2398":44901},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2871":59300,"_25310":59290,"_5":25643,"_17659":100151,"_23935":100152,"_2398":100153},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2871":59301,"_25310":59290,"_5":25643,"_17659":100155,"_23935":100156,"_2398":100157},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2871":59302,"_25310":59290,"_5":25643,"_17659":100159,"_23935":100160,"_2398":100161},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2871":59303,"_25310":59290,"_5":25643,"_17659":100163,"_23935":100164,"_2398":100165},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2871":59304,"_25310":59290,"_5":25643,"_17659":100167,"_23935":100168,"_2398":100169},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2871":59305,"_25310":59290,"_5":25643,"_17659":100171,"_23935":100172,"_2398":100173},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2871":59306,"_25310":59290,"_5":25643,"_17659":100175,"_23935":100176,"_2398":100177},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2871":59307,"_25310":59290,"_5":25643,"_17659":100179,"_23935":100180,"_2398":100181},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2871":59308,"_25310":59290,"_5":25643,"_17659":100183,"_23935":100184,"_2398":100185},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2871":59309,"_25310":59290,"_5":25643,"_17659":100187,"_23935":100188,"_2398":100189},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2871":59310,"_25310":59290,"_5":25643,"_17659":100191,"_23935":100192,"_2398":100193},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2871":59311,"_25310":59290,"_5":25643,"_17659":100195,"_23935":100196,"_2398":100197},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2871":59312,"_25310":59290,"_17659":100199,"_5":17554,"_23935":59290,"_2398":100200},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2871":59313,"_25310":59290,"_17659":100202,"_5":17554,"_23935":59290,"_2398":100203},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2871":59314,"_25310":59290,"_17659":100205,"_5":17554,"_23935":59290,"_2398":100206},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2871":59315,"_25310":59290,"_17659":100208,"_5":17554,"_23935":100122,"_2398":100209},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2871":59316,"_25310":59290,"_17659":100211,"_5":17554,"_23935":100122,"_2398":100212},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2871":59317,"_25310":59290,"_17659":100214,"_5":17554,"_23935":100122,"_2398":100215},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2871":59318,"_25310":59290,"_17659":100217,"_5":17554,"_23935":100122,"_2398":100218},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2871":59319,"_25310":59290,"_17659":100220,"_5":17554,"_23935":100126,"_2398":100221},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2871":59320,"_25310":59290,"_17659":100223,"_5":17554,"_23935":100130,"_2398":100224},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2871":59321,"_25310":59290,"_17659":100226,"_5":17554,"_23935":100130,"_2398":100227},[],"Acción IAM",{"_2871":59322,"_25310":59290,"_17659":100229,"_5":17554,"_23935":100130,"_2398":96772},[],{"_2871":59323,"_25310":59290,"_17659":100231,"_5":17554,"_23935":100130,"_2398":44984},[],{"_2871":59324,"_25310":59290,"_17659":100233,"_5":17554,"_23935":100130,"_2398":100234},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2871":59325,"_25310":59290,"_17659":100236,"_5":17554,"_23935":100130,"_2398":44990},[],{"_2871":59326,"_25310":59290,"_17659":100238,"_5":17554,"_23935":100130,"_2398":100239},[],"Registrar la CA en AWS IoT",{"_2871":59327,"_25310":59290,"_17659":100241,"_5":17554,"_23935":100130,"_2398":44996},[],{"_2871":59328,"_25310":59290,"_17659":100243,"_5":17554,"_23935":100130,"_2398":100244},[],"Consultar el estado del registro de la CA",{"_2871":59329,"_25310":59290,"_17659":100246,"_5":17554,"_23935":100130,"_2398":45002},[],{"_2871":59330,"_25310":59290,"_17659":100248,"_5":17554,"_23935":100130,"_2398":100249},[],"Crear o actualizar Things en IoT Core",{"_2871":59331,"_25310":59290,"_17659":100251,"_5":17554,"_23935":100130,"_2398":45008},[],{"_2871":59332,"_25310":59290,"_17659":100253,"_5":17554,"_23935":100130,"_2398":100254},[],"Aprovisionar Things mediante plantilla",{"_2871":59333,"_25310":59290,"_17659":100256,"_5":17554,"_23935":100130,"_2398":45014},[],{"_2871":59334,"_25310":59290,"_17659":100258,"_5":17554,"_23935":100130,"_2398":100259},[],"Registrar certificados de dispositivo",{"_2871":59335,"_25310":59290,"_17659":100261,"_5":17554,"_23935":100130,"_2398":45020},[],{"_2871":59336,"_25310":59290,"_17659":100263,"_5":17554,"_23935":100130,"_2398":100264},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2871":59337,"_25310":59290,"_17659":100266,"_5":17554,"_23935":100130,"_2398":45026},[],{"_2871":59338,"_25310":59290,"_17659":100268,"_5":17554,"_23935":100130,"_2398":100269},[],"Crear y adjuntar políticas IoT",{"_2871":59339,"_25310":59290,"_17659":100271,"_5":17554,"_23935":100130,"_2398":45032},[],{"_2871":59340,"_25310":59290,"_17659":100273,"_5":17554,"_23935":100130,"_2398":100274},[],"Gestionar grupos de Things",{"_2871":59341,"_25310":59290,"_17659":100276,"_5":17554,"_23935":100130,"_2398":45038},[],{"_2871":59342,"_25310":59290,"_17659":100278,"_5":17554,"_23935":100130,"_2398":100279},[],"Crear plantillas JITP",{"_2871":59343,"_25310":59290,"_17659":100281,"_5":17554,"_23935":100130,"_2398":45044},[],{"_2871":59344,"_25310":59290,"_17659":100283,"_5":17554,"_23935":100130,"_2398":100284},[],"Leer y escribir el Device Shadow",{"_2871":59345,"_25310":59290,"_17659":100286,"_5":17554,"_23935":100130,"_2398":100287},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2871":59346,"_25310":59290,"_17659":100289,"_5":17554,"_23935":100134,"_2398":100290},[],"Parámetro",{"_2871":59347,"_25310":59290,"_17659":100292,"_5":17554,"_23935":100134,"_2398":100293},[],"Tipo",{"_2871":59348,"_25310":59290,"_17659":100295,"_5":17554,"_23935":100134,"_2398":100296},[],"Requerido",{"_2871":59349,"_25310":59290,"_17659":100298,"_5":17554,"_23935":100134,"_2398":100299},[],"Descripción",{"_2871":59350,"_25310":59290,"_17659":100301,"_5":17554,"_23935":100134,"_2398":45065},[],{"_2871":59351,"_25310":59290,"_17659":100303,"_5":17554,"_23935":100134,"_2398":21064},[],{"_2871":59352,"_25310":59290,"_17659":100305,"_5":17554,"_23935":100134,"_2398":100306},[],"Sí",{"_2871":59353,"_25310":59290,"_17659":100308,"_5":17554,"_23935":100134,"_2398":100309},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2871":59354,"_25310":59290,"_17659":100311,"_5":17554,"_23935":100134,"_2398":45076},[],{"_2871":59355,"_25310":59290,"_17659":100313,"_5":17554,"_23935":100134,"_2398":21064},[],{"_2871":59356,"_25310":59290,"_17659":100315,"_5":17554,"_23935":100134,"_2398":100306},[],{"_2871":59357,"_25310":59290,"_17659":100317,"_5":17554,"_23935":100134,"_2398":100318},[],"Región AWS donde opera el conector.",{"_2871":59358,"_25310":59290,"_17659":100320,"_5":17554,"_23935":100134,"_2398":45086},[],{"_2871":59359,"_25310":59290,"_17659":100322,"_5":17554,"_23935":100134,"_2398":21064},[],{"_2871":59360,"_25310":59290,"_17659":100324,"_5":17554,"_23935":100134,"_2398":100306},[],{"_2871":59361,"_25310":59290,"_17659":100326,"_5":17554,"_23935":100134,"_2398":100327},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2871":59362,"_25310":59290,"_17659":100329,"_5":17554,"_23935":100134,"_2398":45096},[],{"_2871":59363,"_25310":59290,"_17659":100331,"_5":17554,"_23935":100134,"_2398":21064},[],{"_2871":59364,"_25310":59290,"_17659":100333,"_5":17554,"_23935":100134,"_2398":100334},[],"Solo con `auth_method=static`",{"_2871":59365,"_25310":59290,"_17659":100336,"_5":17554,"_23935":100134,"_2398":100337},[],"Clave de acceso AWS.",{"_2871":59366,"_25310":59290,"_17659":100339,"_5":17554,"_23935":100134,"_2398":45107},[],{"_2871":59367,"_25310":59290,"_17659":100341,"_5":17554,"_23935":100134,"_2398":21064},[],{"_2871":59368,"_25310":59290,"_17659":100343,"_5":17554,"_23935":100134,"_2398":100334},[],{"_2871":59369,"_25310":59290,"_17659":100345,"_5":17554,"_23935":100134,"_2398":100346},[],"Clave secreta AWS.",{"_2871":59370,"_25310":59290,"_17659":100348,"_5":17554,"_23935":100134,"_2398":45117},[],{"_2871":59371,"_25310":59290,"_17659":100350,"_5":17554,"_23935":100134,"_2398":21064},[],{"_2871":59372,"_25310":59290,"_17659":100352,"_5":17554,"_23935":100134,"_2398":45122},[],{"_2871":59373,"_25310":59290,"_17659":100354,"_5":17554,"_23935":100134,"_2398":100355},[],"Token de sesión (con `auth_method=static`).",{"_2871":59374,"_25310":59290,"_17659":100357,"_5":17554,"_23935":100134,"_2398":45128},[],{"_2871":59375,"_25310":59290,"_17659":100359,"_5":17554,"_23935":100134,"_2398":21064},[],{"_2871":59376,"_25310":59290,"_17659":100361,"_5":17554,"_23935":100134,"_2398":100362},[],"Solo con `auth_method=role`",{"_2871":59377,"_25310":59290,"_17659":100364,"_5":17554,"_23935":100134,"_2398":100365},[],"ARN del rol a asumir.",{"_2871":59378,"_25310":59290,"_17659":100367,"_5":17554,"_23935":100134,"_2398":45139},[],{"_2871":59379,"_25310":59290,"_17659":100369,"_5":17554,"_23935":100134,"_2398":21064},[],{"_2871":59380,"_25310":59290,"_17659":100371,"_5":17554,"_23935":100134,"_2398":45122},[],{"_2871":59381,"_25310":59290,"_17659":100373,"_5":17554,"_23935":100134,"_2398":100374},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2871":59382,"_25310":59290,"_17659":100376,"_5":17554,"_23935":100134,"_2398":45149},[],{"_2871":59383,"_25310":59290,"_17659":100378,"_5":17554,"_23935":100134,"_2398":14837},[],{"_2871":59384,"_25310":59290,"_17659":100380,"_5":17554,"_23935":100134,"_2398":100306},[],{"_2871":59385,"_25310":59290,"_17659":100382,"_5":17554,"_23935":100134,"_2398":100383},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2871":59386,"_25310":59290,"_17659":100385,"_5":17554,"_23935":100134,"_2398":45159},[],{"_2871":59387,"_25310":59290,"_17659":100387,"_5":17554,"_23935":100134,"_2398":21064},[],{"_2871":59388,"_25310":59290,"_17659":100389,"_5":17554,"_23935":100134,"_2398":100306},[],{"_2871":59389,"_25310":59290,"_17659":100391,"_5":17554,"_23935":100134,"_2398":100392},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2871":59390,"_25310":59290,"_17659":100394,"_5":17554,"_23935":100134,"_2398":45169},[],{"_2871":59391,"_25310":59290,"_17659":100396,"_5":17554,"_23935":100134,"_2398":21064},[],{"_2871":59392,"_25310":59290,"_17659":100398,"_5":17554,"_23935":100134,"_2398":100306},[],{"_2871":59393,"_25310":59290,"_17659":100400,"_5":17554,"_23935":100134,"_2398":100401},[],"URL HTTP del Device Manager de Lamassu.",{"_2871":59394,"_25310":59290,"_17659":100403,"_5":17554,"_23935":100134,"_2398":45179},[],{"_2871":59395,"_25310":59290,"_17659":100405,"_5":17554,"_23935":100134,"_2398":21064},[],{"_2871":59396,"_25310":59290,"_17659":100407,"_5":17554,"_23935":100134,"_2398":100306},[],{"_2871":59397,"_25310":59290,"_17659":100409,"_5":17554,"_23935":100134,"_2398":100410},[],"URL HTTP del servicio de CA de Lamassu.",{"_2871":59398,"_25310":59290,"_17659":100412,"_5":17554,"_23935":100138,"_2398":100413},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2871":59399,"_25310":59290,"_17659":100415,"_5":17554,"_23935":100142,"_2398":100416},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2871":59400,"_25310":59290,"_17659":100418,"_5":17554,"_23935":100142,"_2398":100419},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2871":59401,"_25310":59290,"_17659":100421,"_5":17554,"_23935":100146,"_2398":100422},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2871":59402,"_25310":59290,"_17659":100424,"_5":17554,"_23935":100146,"_2398":100425},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2871":59403,"_25310":59290,"_17659":100427,"_5":17554,"_23935":100146,"_2398":100428},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2871":59404,"_25310":59290,"_17659":100430,"_5":17554,"_23935":100146,"_2398":100431},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2871":59405,"_25310":59290,"_17659":100433,"_5":17554,"_23935":100146,"_2398":100434},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2871":59406,"_25310":59290,"_17659":100436,"_5":17554,"_23935":100146,"_2398":100437},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2871":59407,"_25310":59290,"_17659":100439,"_5":17554,"_23935":100149,"_2398":100440},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2871":59408,"_25310":59290,"_17659":100442,"_5":17554,"_23935":100152,"_2398":100443},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2871":59409,"_25310":59290,"_17659":100445,"_5":17554,"_23935":100152,"_2398":100446},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2871":59410,"_25310":59290,"_17659":100448,"_5":17554,"_23935":100156,"_2398":100449},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2871":59411,"_25310":59290,"_17659":100451,"_5":17554,"_23935":100160,"_2398":100452},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2871":59412,"_25310":59290,"_17659":100454,"_5":17554,"_23935":100160,"_2398":100455},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2871":59413,"_25310":59290,"_17659":100457,"_5":17554,"_23935":100160,"_2398":100458},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2871":59414,"_25310":59290,"_17659":100460,"_5":17554,"_23935":100160,"_2398":100461},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2871":59415,"_25310":59290,"_17659":100463,"_5":17554,"_23935":100160,"_2398":100464},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2871":59416,"_25310":59290,"_17659":100466,"_5":17554,"_23935":100160,"_2398":100467},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2871":59417,"_25310":59290,"_17659":100469,"_5":17554,"_23935":100164,"_2398":100470},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2871":59418,"_25310":59290,"_17659":100472,"_5":17554,"_23935":100164,"_2398":100473},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2871":59419,"_25310":59290,"_17659":100475,"_5":17554,"_23935":100164,"_2398":100476},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2871":59420,"_25310":59290,"_17659":100478,"_5":17554,"_23935":100168,"_2398":100479},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2871":59421,"_25310":59290,"_17659":100481,"_5":17554,"_23935":100168,"_2398":100482},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2871":59422,"_25310":59290,"_17659":100484,"_5":17554,"_23935":100168,"_2398":100485},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2871":59423,"_25310":59290,"_17659":100487,"_5":17554,"_23935":100172,"_2398":100488},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2871":59424,"_25310":59290,"_17659":100490,"_5":17554,"_23935":100172,"_2398":100491},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2871":59425,"_25310":59290,"_17659":100493,"_5":17554,"_23935":100172,"_2398":100494},[],"Para que el flujo JITP funcione correctamente:",{"_2871":59426,"_25310":59290,"_17659":100496,"_5":17554,"_23935":100172,"_2398":100497},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2871":59427,"_25310":59290,"_17659":100499,"_5":17554,"_23935":100172,"_2398":100500},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2871":59428,"_25310":59290,"_17659":100502,"_5":17554,"_23935":100172,"_2398":100503},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2871":59429,"_25310":59290,"_17659":100505,"_5":17554,"_23935":100172,"_2398":100506},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2871":59430,"_25310":59290,"_17659":100508,"_5":17554,"_23935":100176,"_2398":100509},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2871":59431,"_25310":59290,"_17659":100511,"_5":17554,"_23935":100176,"_2398":100512},[],"Estado en Lamassu",{"_2871":59432,"_25310":59290,"_17659":100514,"_5":17554,"_23935":100176,"_2398":100515},[],"Razón de revocación",{"_2871":59433,"_25310":59290,"_17659":100517,"_5":17554,"_23935":100176,"_2398":100518},[],"Estado en AWS IoT Core",{"_2871":59434,"_25310":59290,"_17659":100520,"_5":17554,"_23935":100176,"_2398":45300},[],{"_2871":59435,"_25310":59290,"_17659":100522,"_5":17554,"_23935":100176,"_2398":100523},[],"Ninguna",{"_2871":59436,"_25310":59290,"_17659":100525,"_5":17554,"_23935":100176,"_2398":45306},[],{"_2871":59437,"_25310":59290,"_17659":100527,"_5":17554,"_23935":100176,"_2398":45309},[],{"_2871":59438,"_25310":59290,"_17659":100529,"_5":17554,"_23935":100176,"_2398":45312},[],{"_2871":59439,"_25310":59290,"_17659":100531,"_5":17554,"_23935":100176,"_2398":45315},[],{"_2871":59440,"_25310":59290,"_17659":100533,"_5":17554,"_23935":100176,"_2398":45309},[],{"_2871":59441,"_25310":59290,"_17659":100535,"_5":17554,"_23935":100176,"_2398":100536},[],"Cualquier otra razón",{"_2871":59442,"_25310":59290,"_17659":100538,"_5":17554,"_23935":100176,"_2398":45323},[],{"_2871":59443,"_25310":59290,"_17659":100540,"_5":17554,"_23935":100176,"_2398":100541},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2871":59444,"_25310":59290,"_17659":100543,"_5":17554,"_23935":100180,"_2398":100544},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2871":59445,"_25310":59290,"_17659":100546,"_5":17554,"_23935":100180,"_2398":100547},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2871":59446,"_25310":59290,"_17659":100549,"_5":17554,"_23935":100180,"_2398":100550},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2871":59447,"_25310":59290,"_17659":100552,"_5":17554,"_23935":100184,"_2398":100553},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2871":59448,"_25310":59290,"_17659":100555,"_5":17554,"_23935":100184,"_2398":100556},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2871":59449,"_25310":59290,"_17659":100558,"_5":17554,"_23935":100188,"_2398":100559},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2871":59450,"_25310":59290,"_17659":100561,"_5":17554,"_23935":100188,"_2398":100562},[],"Existen dos tipos de acciones:",{"_2871":59451,"_25310":59290,"_17659":100564,"_5":17554,"_23935":100188,"_2398":100565},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2871":59452,"_25310":59290,"_17659":100567,"_5":17554,"_23935":100188,"_2398":100568},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2871":59453,"_25310":59290,"_17659":100570,"_5":17554,"_23935":100188,"_2398":100571},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2871":59454,"_25310":59290,"_17659":100573,"_5":17554,"_23935":100192,"_2398":100574},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2871":59455,"_25310":59290,"_17659":100576,"_5":17554,"_23935":100192,"_2398":100577},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2871":59456,"_25310":59290,"_17659":100579,"_5":17554,"_23935":100192,"_2398":100580},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2871":59457,"_25310":59290,"_17659":100582,"_5":17554,"_23935":100196,"_2398":100583},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2871":59458,"_25310":59290,"_17659":100585,"_5":17554,"_23935":100196,"_2398":100586},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2871":59459,"_25310":59290,"_17659":100588,"_5":17554,"_23935":100196,"_2398":100589},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2871":59460,"_25310":59290,"_17659":100591,"_5":17554,"_23935":100196,"_2398":100592},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2871":59461,"_25310":59290,"_17659":100594,"_5":17554,"_23935":100196,"_2398":100595},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2871":59462,"_25310":59290,"_17659":100597,"_5":17554,"_23935":100196,"_2398":100598},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2871":59463,"_25310":59290,"_17659":100600,"_5":17554,"_23935":100196,"_2398":100601},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2871":59464,"_25310":59290,"_17659":100603,"_5":17554,"_23935":100196,"_2398":100604},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2871":59465,"_25310":59290,"_17659":100606,"_5":17554,"_23935":100196,"_2398":100607},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2871":59466,"_25310":59290,"_17659":100609,"_5":17554,"_23935":100196,"_2398":100610},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2871":59467,"_25310":59290,"_17659":100612,"_5":17554,"_23935":100196,"_2398":100613},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2871":59468,"_25310":59290,"_17659":100615,"_5":17554,"_23935":100196,"_2398":100616},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2871":59469,"_25310":59290,"_17659":100618,"_5":17554,"_23935":100196,"_2398":100619},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2871":59470,"_25310":59290,"_17659":100621,"_5":17554,"_23935":100196,"_2398":100622},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2871":59471,"_25310":59290,"_17659":100624,"_5":17554,"_23935":100196,"_2398":100625},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2871":59472,"_25310":59290,"_17659":100627,"_5":17554,"_23935":100196,"_2398":100628},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2871":59473,"_25310":59290,"_17659":100630,"_5":17554,"_23935":100196,"_2398":100631},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2871":59474,"_25310":59290,"_17659":100633,"_5":17554,"_23935":100196,"_2398":100634},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2871":59475,"_25310":59290,"_17659":100636,"_5":17554,"_23935":100196,"_2398":100637},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2871":59476,"_25310":59290,"_17659":100639,"_5":17554,"_23935":100196,"_2398":100640},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2871":59477,"_25310":59290,"_17659":100642,"_5":17554,"_23935":100196,"_2398":100643},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2871":59478,"_25310":59478,"_5":12413,"_2398":43424,"_25646":100645,"_17659":100646,"_23935":59478},[41060,97754,43424],[],{"_2871":59479,"_25310":59478,"_17659":100648,"_5":17554,"_23935":59478,"_2398":100649},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2871":59480,"_25310":59478,"_5":25643,"_17659":100651,"_23935":100652,"_2398":100653},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2871":59481,"_25310":59478,"_5":25643,"_17659":100655,"_23935":100656,"_2398":98726},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2871":59482,"_25310":59478,"_5":25643,"_17659":100658,"_23935":100659,"_2398":98901},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2871":59483,"_25310":59478,"_5":25643,"_17659":100661,"_23935":100662,"_2398":100115},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#integraciones",{"_2871":59484,"_25310":59478,"_5":25643,"_17659":100664,"_23935":100665,"_2398":100666},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2871":59485,"_25310":59478,"_17659":100668,"_5":17554,"_23935":59478,"_2398":100669},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2871":59486,"_25310":59478,"_17659":100671,"_5":17554,"_23935":100652,"_2398":100672},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2871":59487,"_25310":59478,"_17659":100674,"_5":17554,"_23935":100652,"_2398":100675},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2871":59488,"_25310":59478,"_17659":100677,"_5":17554,"_23935":100656,"_2398":100678},[],"Recurso",{"_2871":59489,"_25310":59478,"_17659":100680,"_5":17554,"_23935":100656,"_2398":100681},[],"Qué representa",{"_2871":59490,"_25310":59478,"_17659":100683,"_5":17554,"_23935":100656,"_2398":100684},[],"**Dispositivo**",{"_2871":59491,"_25310":59478,"_17659":100686,"_5":17554,"_23935":100656,"_2398":100687},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2871":59492,"_25310":59478,"_17659":100689,"_5":17554,"_23935":100656,"_2398":100690},[],"**Identidad**",{"_2871":59493,"_25310":59478,"_17659":100692,"_5":17554,"_23935":100656,"_2398":100693},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2871":59494,"_25310":59478,"_17659":100695,"_5":17554,"_23935":100656,"_2398":45481},[],{"_2871":59495,"_25310":59478,"_17659":100697,"_5":17554,"_23935":100656,"_2398":100698},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2871":59496,"_25310":59478,"_17659":100700,"_5":17554,"_23935":100656,"_2398":100701},[],"**Flota**",{"_2871":59497,"_25310":59478,"_17659":100703,"_5":17554,"_23935":100656,"_2398":100704},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2871":59498,"_25310":59478,"_17659":100706,"_5":17554,"_23935":100656,"_2398":100707},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2871":59499,"_25310":59478,"_17659":100709,"_5":17554,"_23935":100656,"_2398":100710},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2871":59500,"_25310":59478,"_17659":100712,"_5":17554,"_23935":100659,"_2398":100713},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2871":59501,"_25310":59478,"_17659":100715,"_5":17554,"_23935":100659,"_2398":100716},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2871":59502,"_25310":59478,"_17659":100718,"_5":17554,"_23935":100659,"_2398":100719},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2871":59503,"_25310":59478,"_17659":100721,"_5":17554,"_23935":100659,"_2398":100722},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2871":59504,"_25310":59478,"_17659":100724,"_5":17554,"_23935":100659,"_2398":100725},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2871":59505,"_25310":59478,"_17659":100727,"_5":17554,"_23935":100659,"_2398":100728},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2871":59506,"_25310":59478,"_17659":100730,"_5":17554,"_23935":100659,"_2398":100731},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2871":59507,"_25310":59478,"_17659":100733,"_5":17554,"_23935":100659,"_2398":100734},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2871":59508,"_25310":59478,"_17659":100736,"_5":17554,"_23935":100662,"_2398":100737},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2871":59509,"_25310":59478,"_17659":100739,"_5":17554,"_23935":100662,"_2398":100740},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2871":59510,"_25310":59478,"_17659":100742,"_5":17554,"_23935":100665,"_2398":100743},[],"Participante",{"_2871":59511,"_25310":59478,"_17659":100745,"_5":17554,"_23935":100665,"_2398":100746},[],"Responsabilidad",{"_2871":59512,"_25310":59478,"_17659":100748,"_5":17554,"_23935":100665,"_2398":100749},[],"Administrador PKI",{"_2871":59513,"_25310":59478,"_17659":100751,"_5":17554,"_23935":100665,"_2398":100752},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2871":59514,"_25310":59478,"_17659":100754,"_5":17554,"_23935":100665,"_2398":100755},[],"Administrador del aprovisionamiento",{"_2871":59515,"_25310":59478,"_17659":100757,"_5":17554,"_23935":100665,"_2398":100758},[],"DMS, admisión, autenticación por operación e inventario.",{"_2871":59516,"_25310":59478,"_17659":100760,"_5":17554,"_23935":100665,"_2398":100761},[],"Integrador del dispositivo",{"_2871":59517,"_25310":59478,"_17659":100763,"_5":17554,"_23935":100665,"_2398":100764},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2871":59518,"_25310":59478,"_17659":100766,"_5":17554,"_23935":100665,"_2398":100767},[],"Integrador del consumidor",{"_2871":59519,"_25310":59478,"_17659":100769,"_5":17554,"_23935":100665,"_2398":100770},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2871":59520,"_25310":59478,"_17659":100772,"_5":17554,"_23935":100665,"_2398":100773},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2871":59521,"_25310":59521,"_5":12413,"_2398":100775,"_25646":100776,"_17659":100778,"_23935":59521},"Enrola y conecta tu primer dispositivo",[41060,97754,43424,100777],"Primeros pasos",[],{"_2871":59522,"_25310":59521,"_17659":100780,"_5":17554,"_23935":59521,"_2398":100781},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2871":59523,"_25310":59521,"_5":25643,"_17659":100783,"_23935":100784,"_2398":96409},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2871":59524,"_25310":59521,"_5":25643,"_17659":100786,"_23935":100787,"_2398":100788},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2871":59525,"_25310":59521,"_5":25643,"_17659":100790,"_23935":100791,"_2398":100792},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2871":59526,"_25310":59521,"_5":25643,"_17659":100794,"_23935":100795,"_2398":100796},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2871":59527,"_25310":59521,"_5":25643,"_17659":100798,"_23935":100799,"_2398":100800},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2871":59528,"_25310":59521,"_5":25643,"_17659":100802,"_23935":100803,"_2398":100804},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2871":59529,"_25310":59521,"_5":25643,"_17659":100806,"_23935":100807,"_2398":100808},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2871":59530,"_25310":59521,"_5":25643,"_17659":100810,"_23935":100811,"_2398":100812},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2871":59531,"_25310":59521,"_17659":100814,"_5":17554,"_23935":59521,"_2398":100815},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2871":59532,"_25310":59521,"_17659":100817,"_5":17554,"_23935":100784,"_2398":100818},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2871":59533,"_25310":59521,"_17659":100820,"_5":17554,"_23935":100784,"_2398":100821},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2871":59534,"_25310":59521,"_17659":100823,"_5":17554,"_23935":100784,"_2398":100824},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2871":59535,"_25310":59521,"_17659":100826,"_5":17554,"_23935":100784,"_2398":100827},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2871":59536,"_25310":59521,"_17659":100829,"_5":17554,"_23935":100784,"_2398":100830},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2871":59537,"_25310":59521,"_17659":100832,"_5":17554,"_23935":100787,"_2398":100833},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2871":59538,"_25310":59521,"_17659":100835,"_5":17554,"_23935":100787,"_2398":100836},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2871":59539,"_25310":59521,"_17659":100838,"_5":17554,"_23935":100791,"_2398":100839},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2871":59540,"_25310":59521,"_17659":100841,"_5":17554,"_23935":100791,"_2398":100842},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2871":59541,"_25310":59521,"_17659":100844,"_5":17554,"_23935":100791,"_2398":100845},[],"Ajuste",{"_2871":59542,"_25310":59521,"_17659":100847,"_5":17554,"_23935":100791,"_2398":100848},[],"Valor de evaluación",{"_2871":59543,"_25310":59521,"_17659":100850,"_5":17554,"_23935":100791,"_2398":45637},[],{"_2871":59544,"_25310":59521,"_17659":100852,"_5":17554,"_23935":100791,"_2398":100853},[],"Raíz emisora de `device-root.pem`.",{"_2871":59545,"_25310":59521,"_17659":100855,"_5":17554,"_23935":100791,"_2398":99029},[],{"_2871":59546,"_25310":59521,"_17659":100857,"_5":17554,"_23935":100791,"_2398":100858},[],"Perfil final de 1 hora que acabas de preparar.",{"_2871":59547,"_25310":59521,"_17659":100860,"_5":17554,"_23935":100791,"_2398":45648},[],{"_2871":59548,"_25310":59521,"_17659":100862,"_5":17554,"_23935":100791,"_2398":45651},[],{"_2871":59549,"_25310":59521,"_17659":100864,"_5":17554,"_23935":100791,"_2398":45654},[],{"_2871":59550,"_25310":59521,"_17659":100866,"_5":17554,"_23935":100791,"_2398":100867},[],"Habilitado.",{"_2871":59551,"_25310":59521,"_17659":100869,"_5":17554,"_23935":100791,"_2398":45660},[],{"_2871":59552,"_25310":59521,"_17659":100871,"_5":17554,"_23935":100791,"_2398":100872},[],"Deshabilitado; el ID debe ser nuevo.",{"_2871":59553,"_25310":59521,"_17659":100874,"_5":17554,"_23935":100791,"_2398":100875},[],"Autenticación inicial",{"_2871":59554,"_25310":59521,"_17659":100877,"_5":17554,"_23935":100791,"_2398":100878},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2871":59555,"_25310":59521,"_17659":100880,"_5":17554,"_23935":100791,"_2398":100881},[],"Autenticación de renovación",{"_2871":59556,"_25310":59521,"_17659":100883,"_5":17554,"_23935":100791,"_2398":100884},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2871":59557,"_25310":59521,"_17659":100886,"_5":17554,"_23935":100791,"_2398":45678},[],{"_2871":59558,"_25310":59521,"_17659":100888,"_5":17554,"_23935":100791,"_2398":100889},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2871":59559,"_25310":59521,"_17659":100891,"_5":17554,"_23935":100791,"_2398":45684},[],{"_2871":59560,"_25310":59521,"_17659":100893,"_5":17554,"_23935":100791,"_2398":100894},[],"1 hora.",{"_2871":59561,"_25310":59521,"_17659":100896,"_5":17554,"_23935":100791,"_2398":45690},[],{"_2871":59562,"_25310":59521,"_17659":100898,"_5":17554,"_23935":100791,"_2398":100899},[],"30 minutos / 10 minutos.",{"_2871":59563,"_25310":59521,"_17659":100901,"_5":17554,"_23935":100791,"_2398":45696},[],{"_2871":59564,"_25310":59521,"_17659":100903,"_5":17554,"_23935":100791,"_2398":100904},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2871":59565,"_25310":59521,"_17659":100906,"_5":17554,"_23935":100791,"_2398":43743},[],{"_2871":59566,"_25310":59521,"_17659":100908,"_5":17554,"_23935":100791,"_2398":100909},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2871":59567,"_25310":59521,"_17659":100911,"_5":17554,"_23935":100791,"_2398":45707},[],{"_2871":59568,"_25310":59521,"_17659":100913,"_5":17554,"_23935":100791,"_2398":100914},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2871":59569,"_25310":59521,"_17659":100916,"_5":17554,"_23935":100791,"_2398":100917},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2871":59570,"_25310":59521,"_17659":100919,"_5":17554,"_23935":100795,"_2398":100920},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2871":59571,"_25310":59521,"_17659":100922,"_5":17554,"_23935":100795,"_2398":100923},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2871":59572,"_25310":59521,"_17659":100925,"_5":17554,"_23935":100799,"_2398":100926},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2871":59573,"_25310":59521,"_17659":100928,"_5":17554,"_23935":100799,"_2398":100929},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2871":59574,"_25310":59521,"_17659":100931,"_5":17554,"_23935":100799,"_2398":100932},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2871":59575,"_25310":59521,"_17659":100934,"_5":17554,"_23935":100803,"_2398":100935},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2871":59576,"_25310":59521,"_17659":100937,"_5":17554,"_23935":100803,"_2398":100938},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2871":59577,"_25310":59521,"_17659":100940,"_5":17554,"_23935":100807,"_2398":100941},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2871":59578,"_25310":59521,"_17659":100943,"_5":17554,"_23935":100807,"_2398":100944},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2871":59579,"_25310":59521,"_17659":100946,"_5":17554,"_23935":100807,"_2398":100947},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2871":59580,"_25310":59521,"_17659":100949,"_5":17554,"_23935":100807,"_2398":100950},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2871":59581,"_25310":59521,"_17659":100952,"_5":17554,"_23935":100807,"_2398":100953},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2871":59582,"_25310":59521,"_17659":100955,"_5":17554,"_23935":100811,"_2398":100956},[],"Comprobación",{"_2871":59583,"_25310":59521,"_17659":100958,"_5":17554,"_23935":100811,"_2398":100959},[],"Resultado esperado",{"_2871":59584,"_25310":59521,"_17659":100961,"_5":17554,"_23935":100811,"_2398":100962},[],"Registro",{"_2871":59585,"_25310":59521,"_17659":100964,"_5":17554,"_23935":100811,"_2398":100965},[],"ID creado automáticamente y DMS correcto.",{"_2871":59586,"_25310":59521,"_17659":100967,"_5":17554,"_23935":100811,"_2398":100968},[],"Certificado",{"_2871":59587,"_25310":59521,"_17659":100970,"_5":17554,"_23935":100811,"_2398":100971},[],"CN, perfil, serie y clave verificados.",{"_2871":59588,"_25310":59521,"_17659":100973,"_5":17554,"_23935":100811,"_2398":100974},[],"Inventario",{"_2871":59589,"_25310":59521,"_17659":100976,"_5":17554,"_23935":100811,"_2398":100977},[],"Serie recibida visible como identidad actual y en el historial.",{"_2871":59590,"_25310":59521,"_17659":100979,"_5":17554,"_23935":100811,"_2398":100980},[],"Consumidor",{"_2871":59591,"_25310":59521,"_17659":100982,"_5":17554,"_23935":100811,"_2398":100983},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2871":59592,"_25310":59521,"_17659":100985,"_5":17554,"_23935":100811,"_2398":100986},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2871":59593,"_25310":59521,"_17659":100988,"_5":17554,"_23935":100811,"_2398":100989},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2871":59594,"_25310":59594,"_5":12413,"_2398":98743,"_25646":100991,"_17659":100992,"_23935":59594},[41060,97754,43424,100777],[],{"_2871":59595,"_25310":59594,"_17659":100994,"_5":17554,"_23935":59594,"_2398":100995},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2871":59596,"_25310":59594,"_5":25643,"_17659":100997,"_23935":100998,"_2398":96409},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2871":59597,"_25310":59594,"_5":25643,"_17659":101000,"_23935":101001,"_2398":101002},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2871":59598,"_25310":59594,"_5":25643,"_17659":101004,"_23935":101005,"_2398":101006},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2871":59599,"_25310":59594,"_5":25643,"_17659":101008,"_23935":101009,"_2398":101010},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2871":59600,"_25310":59594,"_5":25643,"_17659":101012,"_23935":101013,"_2398":101014},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2871":59601,"_25310":59594,"_5":25643,"_17659":101016,"_23935":101017,"_2398":101018},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2871":59602,"_25310":59594,"_5":25643,"_17659":101020,"_23935":101021,"_2398":100959},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2871":59603,"_25310":59594,"_5":25643,"_17659":101023,"_23935":101024,"_2398":101025},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2871":59604,"_25310":59594,"_5":25643,"_17659":101027,"_23935":101028,"_2398":101029},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2871":59605,"_25310":59594,"_17659":101031,"_5":17554,"_23935":59594,"_2398":101032},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2871":59606,"_25310":59594,"_17659":101034,"_5":17554,"_23935":59594,"_2398":101035},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2871":59607,"_25310":59594,"_17659":101037,"_5":17554,"_23935":100998,"_2398":101038},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2871":59608,"_25310":59594,"_17659":101040,"_5":17554,"_23935":100998,"_2398":101041},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2871":59609,"_25310":59594,"_17659":101043,"_5":17554,"_23935":100998,"_2398":101044},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2871":59610,"_25310":59594,"_17659":101046,"_5":17554,"_23935":100998,"_2398":101047},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2871":59611,"_25310":59594,"_17659":101049,"_5":17554,"_23935":101001,"_2398":101050},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2871":59612,"_25310":59594,"_17659":101052,"_5":17554,"_23935":101001,"_2398":101053},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2871":59613,"_25310":59594,"_17659":101055,"_5":17554,"_23935":101001,"_2398":101056},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2871":59614,"_25310":59594,"_17659":101058,"_5":17554,"_23935":101001,"_2398":101059},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2871":59615,"_25310":59594,"_17659":101061,"_5":17554,"_23935":101001,"_2398":101062},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2871":59616,"_25310":59594,"_17659":101064,"_5":17554,"_23935":101001,"_2398":101065},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2871":59617,"_25310":59594,"_17659":101067,"_5":17554,"_23935":101001,"_2398":101068},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2871":59618,"_25310":59594,"_17659":101070,"_5":17554,"_23935":101001,"_2398":101071},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2871":59619,"_25310":59594,"_17659":101073,"_5":17554,"_23935":101005,"_2398":101074},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2871":59620,"_25310":59594,"_17659":101076,"_5":17554,"_23935":101005,"_2398":45873},[],{"_2871":59621,"_25310":59594,"_17659":101078,"_5":17554,"_23935":101005,"_2398":101079},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2871":59622,"_25310":59594,"_17659":101081,"_5":17554,"_23935":101005,"_2398":101082},[],"**Icon** y **Tags**: clasificación opcional.",{"_2871":59623,"_25310":59594,"_17659":101084,"_5":17554,"_23935":101005,"_2398":101085},[],"Confirma el registro.",{"_2871":59624,"_25310":59594,"_17659":101087,"_5":17554,"_23935":101009,"_2398":101088},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2871":59625,"_25310":59594,"_17659":101090,"_5":17554,"_23935":101009,"_2398":101091},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2871":59626,"_25310":59594,"_17659":101093,"_5":17554,"_23935":101013,"_2398":101094},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2871":59627,"_25310":59594,"_17659":101096,"_5":17554,"_23935":101013,"_2398":101097},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2871":59628,"_25310":59594,"_17659":101099,"_5":17554,"_23935":101017,"_2398":101100},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2871":59629,"_25310":59594,"_17659":101102,"_5":17554,"_23935":101017,"_2398":101103},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2871":59630,"_25310":59594,"_17659":101105,"_5":17554,"_23935":101021,"_2398":100956},[],{"_2871":59631,"_25310":59594,"_17659":101107,"_5":17554,"_23935":101021,"_2398":101108},[],"Resultado",{"_2871":59632,"_25310":59594,"_17659":101110,"_5":17554,"_23935":101021,"_2398":101111},[],"Dispositivo",{"_2871":59633,"_25310":59594,"_17659":101113,"_5":17554,"_23935":101021,"_2398":101114},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2871":59634,"_25310":59594,"_17659":101116,"_5":17554,"_23935":101021,"_2398":101117},[],"Identidad actual",{"_2871":59635,"_25310":59594,"_17659":101119,"_5":17554,"_23935":101021,"_2398":101120},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2871":59636,"_25310":59594,"_17659":101122,"_5":17554,"_23935":101021,"_2398":101123},[],"Historial",{"_2871":59637,"_25310":59594,"_17659":101125,"_5":17554,"_23935":101021,"_2398":101126},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2871":59638,"_25310":59594,"_17659":101128,"_5":17554,"_23935":101021,"_2398":101129},[],"Clave y certificado",{"_2871":59639,"_25310":59594,"_17659":101131,"_5":17554,"_23935":101021,"_2398":101132},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2871":59640,"_25310":59594,"_17659":101134,"_5":17554,"_23935":101024,"_2398":101135},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2871":59641,"_25310":59594,"_17659":101137,"_5":17554,"_23935":101024,"_2398":101138},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2871":59642,"_25310":59594,"_17659":101140,"_5":17554,"_23935":101024,"_2398":101141},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2871":59643,"_25310":59594,"_17659":101143,"_5":17554,"_23935":101024,"_2398":101144},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2871":59644,"_25310":59594,"_17659":101146,"_5":17554,"_23935":101028,"_2398":101147},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2871":59645,"_25310":59594,"_17659":101149,"_5":17554,"_23935":101028,"_2398":101150},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2871":59646,"_25310":59594,"_17659":101152,"_5":17554,"_23935":101028,"_2398":101153},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2871":59647,"_25310":59647,"_5":12413,"_2398":101155,"_25646":101156,"_17659":101157,"_23935":59647},"Plataforma Lamassu IoT",[41060,97754],[],{"_2871":59648,"_25310":59647,"_17659":101159,"_5":17554,"_23935":59647,"_2398":101160},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2871":59649,"_25310":59647,"_5":25643,"_17659":101162,"_23935":101163,"_2398":100653},[],"/docs/pr-preview/pr-42/es/platform/overview#empieza-aquí",{"_2871":59650,"_25310":59647,"_5":25643,"_17659":101165,"_23935":101166,"_2398":101167},[],"/docs/pr-preview/pr-42/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2871":59651,"_25310":59647,"_5":25643,"_17659":101169,"_23935":101170,"_2398":101171},[],"/docs/pr-preview/pr-42/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2871":59652,"_25310":59647,"_5":25643,"_17659":101173,"_23935":101174,"_2398":101175},[],"/docs/pr-preview/pr-42/es/platform/overview#capacidades-principales","Capacidades principales",{"_2871":59653,"_25310":59647,"_5":25643,"_17659":101177,"_23935":101178,"_2398":101179},[],"/docs/pr-preview/pr-42/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2871":59654,"_25310":59647,"_5":25643,"_17659":101181,"_23935":101182,"_2398":101183},[],"/docs/pr-preview/pr-42/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2871":59655,"_25310":59647,"_5":25643,"_17659":101185,"_23935":101186,"_2398":101187},[],"/docs/pr-preview/pr-42/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2871":59656,"_25310":59647,"_5":25643,"_17659":101189,"_23935":101190,"_2398":101191},[],"/docs/pr-preview/pr-42/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2871":59657,"_25310":59647,"_5":25643,"_17659":101193,"_23935":101194,"_2398":101195},[],"/docs/pr-preview/pr-42/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2871":59658,"_25310":59647,"_5":25643,"_17659":101197,"_23935":101198,"_2398":101199},[],"/docs/pr-preview/pr-42/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2871":59659,"_25310":59647,"_5":25643,"_17659":101201,"_23935":101202,"_2398":101203},[],"/docs/pr-preview/pr-42/es/platform/overview#referencia-operativa","Referencia operativa",{"_2871":59660,"_25310":59647,"_17659":101205,"_5":17554,"_23935":59647,"_2398":101206},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2871":59661,"_25310":59647,"_17659":101208,"_5":17554,"_23935":101163,"_2398":101209},[],"Elige el resultado que necesitas obtener:",{"_2871":59662,"_25310":59647,"_17659":101211,"_5":17554,"_23935":101163,"_2398":101212},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2871":59663,"_25310":59647,"_17659":101214,"_5":17554,"_23935":101163,"_2398":101215},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2871":59664,"_25310":59647,"_17659":101217,"_5":17554,"_23935":101163,"_2398":101218},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2871":59665,"_25310":59647,"_17659":101220,"_5":17554,"_23935":101166,"_2398":101221},[],"Bloque",{"_2871":59666,"_25310":59647,"_17659":101223,"_5":17554,"_23935":101166,"_2398":101224},[],"Qué gestionas",{"_2871":59667,"_25310":59647,"_17659":101226,"_5":17554,"_23935":101166,"_2398":101227},[],"Punto de entrada",{"_2871":59668,"_25310":59647,"_17659":101229,"_5":17554,"_23935":101166,"_2398":46027},[],{"_2871":59669,"_25310":59647,"_17659":101231,"_5":17554,"_23935":101166,"_2398":101232},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2871":59670,"_25310":59647,"_17659":101234,"_5":17554,"_23935":101166,"_2398":101235},[],"Visión general de PKI",{"_2871":59671,"_25310":59647,"_17659":101237,"_5":17554,"_23935":101166,"_2398":46036},[],{"_2871":59672,"_25310":59647,"_17659":101239,"_5":17554,"_23935":101166,"_2398":101240},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2871":59673,"_25310":59647,"_17659":101242,"_5":17554,"_23935":101166,"_2398":101243},[],"Visión general de IoT Fleets",{"_2871":59674,"_25310":59647,"_17659":101245,"_5":17554,"_23935":101166,"_2398":101246},[],"**Administración**",{"_2871":59675,"_25310":59647,"_17659":101248,"_5":17554,"_23935":101166,"_2398":101249},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2871":59676,"_25310":59647,"_17659":101251,"_5":17554,"_23935":101166,"_2398":97752},[],{"_2871":59677,"_25310":59647,"_17659":101253,"_5":17554,"_23935":101166,"_2398":101254},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2871":59678,"_25310":59647,"_17659":101256,"_5":17554,"_23935":101170,"_2398":101257},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2871":59679,"_25310":59647,"_17659":101259,"_5":17554,"_23935":101170,"_2398":101260},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2871":59680,"_25310":59647,"_17659":101262,"_5":17554,"_23935":101170,"_2398":101263},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2871":59681,"_25310":59647,"_17659":101265,"_5":17554,"_23935":101170,"_2398":101266},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2871":59682,"_25310":59647,"_17659":101268,"_5":17554,"_23935":101170,"_2398":101269},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2871":59683,"_25310":59647,"_17659":101271,"_5":17554,"_23935":101170,"_2398":101272},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2871":59684,"_25310":59647,"_17659":101274,"_5":17554,"_23935":101178,"_2398":101275},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2871":59685,"_25310":59647,"_17659":101277,"_5":17554,"_23935":101182,"_2398":101278},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2871":59686,"_25310":59647,"_17659":101280,"_5":17554,"_23935":101186,"_2398":101281},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2871":59687,"_25310":59647,"_17659":101283,"_5":17554,"_23935":101190,"_2398":101284},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2871":59688,"_25310":59647,"_17659":101286,"_5":17554,"_23935":101194,"_2398":101287},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2871":59689,"_25310":59647,"_17659":101289,"_5":17554,"_23935":101198,"_2398":101290},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2871":59690,"_25310":59647,"_17659":101292,"_5":17554,"_23935":101202,"_2398":100746},[],{"_2871":59691,"_25310":59647,"_17659":101294,"_5":17554,"_23935":101202,"_2398":101295},[],"Qué prepara o comprueba",{"_2871":59692,"_25310":59647,"_17659":101297,"_5":17554,"_23935":101202,"_2398":100749},[],{"_2871":59693,"_25310":59647,"_17659":101299,"_5":17554,"_23935":101202,"_2398":101300},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2871":59694,"_25310":59647,"_17659":101302,"_5":17554,"_23935":101202,"_2398":101303},[],"Administrador de la flota",{"_2871":59695,"_25310":59647,"_17659":101305,"_5":17554,"_23935":101202,"_2398":101306},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2871":59696,"_25310":59647,"_17659":101308,"_5":17554,"_23935":101202,"_2398":100761},[],{"_2871":59697,"_25310":59647,"_17659":101310,"_5":17554,"_23935":101202,"_2398":101311},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2871":59698,"_25310":59647,"_17659":101313,"_5":17554,"_23935":101202,"_2398":100767},[],{"_2871":59699,"_25310":59647,"_17659":101315,"_5":17554,"_23935":101202,"_2398":101316},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2871":59700,"_25310":59647,"_17659":101318,"_5":17554,"_23935":101202,"_2398":101319},[],"Operador de infraestructura",{"_2871":59701,"_25310":59647,"_17659":101321,"_5":17554,"_23935":101202,"_2398":101322},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2871":59702,"_25310":59647,"_17659":101324,"_5":17554,"_23935":101202,"_2398":101325},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2871":59703,"_25310":59703,"_5":12413,"_2398":101327,"_25646":101328,"_17659":101330,"_23935":59703},"Jerarquía y rotación de CAs",[41060,97754,46128,101329],"Claves, autoridades y certificados",[],{"_2871":59704,"_25310":59703,"_17659":101332,"_5":17554,"_23935":59703,"_2398":101333},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2871":59705,"_25310":59703,"_5":25643,"_17659":101335,"_23935":101336,"_2398":101337},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2871":59706,"_25310":59703,"_5":25643,"_17659":101339,"_23935":101340,"_2398":101341},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2871":59707,"_25310":59703,"_5":25643,"_17659":101343,"_23935":101344,"_2398":101345},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2871":59708,"_25310":59703,"_5":25643,"_17659":101347,"_23935":101348,"_2398":101349},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2871":59709,"_25310":59703,"_5":25643,"_17659":101351,"_23935":101352,"_2398":101353},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2871":59710,"_25310":59703,"_5":25643,"_17659":101355,"_23935":101356,"_2398":101357},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2871":59711,"_25310":59703,"_5":25643,"_17659":101359,"_23935":101360,"_2398":101361},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2871":59712,"_25310":59703,"_5":25643,"_17659":101363,"_23935":101364,"_2398":101365},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2871":59713,"_25310":59703,"_5":25643,"_17659":101367,"_23935":101368,"_2398":101369},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2871":59714,"_25310":59703,"_5":25643,"_17659":101371,"_23935":101372,"_2398":101373},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2871":59715,"_25310":59703,"_5":25643,"_17659":101375,"_23935":101376,"_2398":101377},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2871":59716,"_25310":59703,"_5":25643,"_17659":101379,"_23935":101380,"_2398":101381},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2871":59717,"_25310":59703,"_17659":101383,"_5":17554,"_23935":59703,"_2398":101384},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2871":59718,"_25310":59703,"_17659":101386,"_5":17554,"_23935":59703,"_2398":101387},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2871":59719,"_25310":59703,"_17659":101389,"_5":17554,"_23935":101336,"_2398":101390},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2871":59720,"_25310":59703,"_17659":101392,"_5":17554,"_23935":101336,"_2398":101393},[],"entorno, como producción y preproducción;",{"_2871":59721,"_25310":59703,"_17659":101395,"_5":17554,"_23935":101336,"_2398":101396},[],"propietario o equipo operador;",{"_2871":59722,"_25310":59703,"_17659":101398,"_5":17554,"_23935":101336,"_2398":101399},[],"familia de dispositivos o proceso de fabricación;",{"_2871":59723,"_25310":59703,"_17659":101401,"_5":17554,"_23935":101336,"_2398":101402},[],"región o requisito regulatorio;",{"_2871":59724,"_25310":59703,"_17659":101404,"_5":17554,"_23935":101336,"_2398":101405},[],"motor criptográfico o política de clave;",{"_2871":59725,"_25310":59703,"_17659":101407,"_5":17554,"_23935":101336,"_2398":101408},[],"ventana de mantenimiento y ritmo de renovación.",{"_2871":59726,"_25310":59703,"_17659":101410,"_5":17554,"_23935":101336,"_2398":101411},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2871":59727,"_25310":59703,"_17659":101413,"_5":17554,"_23935":101336,"_2398":101414},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2871":59728,"_25310":59703,"_17659":101416,"_5":17554,"_23935":101340,"_2398":101417},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2871":59729,"_25310":59703,"_17659":101419,"_5":17554,"_23935":101340,"_2398":101420},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2871":59730,"_25310":59703,"_17659":101422,"_5":17554,"_23935":101340,"_2398":101423},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2871":59731,"_25310":59703,"_17659":101425,"_5":17554,"_23935":101344,"_2398":101426},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2871":59732,"_25310":59703,"_17659":101428,"_5":17554,"_23935":101344,"_2398":101429},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2871":59733,"_25310":59703,"_17659":101431,"_5":17554,"_23935":101344,"_2398":101432},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2871":59734,"_25310":59703,"_17659":101434,"_5":17554,"_23935":101344,"_2398":101435},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2871":59735,"_25310":59703,"_17659":101437,"_5":17554,"_23935":101352,"_2398":101438},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2871":59736,"_25310":59703,"_17659":101440,"_5":17554,"_23935":101356,"_2398":101441},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2871":59737,"_25310":59703,"_17659":101443,"_5":17554,"_23935":101360,"_2398":101444},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2871":59738,"_25310":59703,"_17659":101446,"_5":17554,"_23935":101364,"_2398":101447},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2871":59739,"_25310":59703,"_17659":101449,"_5":17554,"_23935":101368,"_2398":101450},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2871":59740,"_25310":59703,"_17659":101452,"_5":17554,"_23935":101372,"_2398":101453},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2871":59741,"_25310":59703,"_17659":101455,"_5":17554,"_23935":101376,"_2398":101456},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2871":59742,"_25310":59703,"_17659":101458,"_5":17554,"_23935":101376,"_2398":101459},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2871":59743,"_25310":59703,"_17659":101461,"_5":17554,"_23935":101376,"_2398":101462},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2871":59744,"_25310":59703,"_17659":101464,"_5":17554,"_23935":101376,"_2398":101465},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2871":59745,"_25310":59703,"_17659":101467,"_5":17554,"_23935":101380,"_2398":101468},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2871":59746,"_25310":59703,"_17659":101470,"_5":17554,"_23935":101380,"_2398":101471},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2871":59747,"_25310":59703,"_17659":101473,"_5":17554,"_23935":101380,"_2398":101474},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2871":59748,"_25310":59703,"_17659":101476,"_5":17554,"_23935":101380,"_2398":101477},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2871":59749,"_25310":59703,"_17659":101479,"_5":17554,"_23935":101380,"_2398":101480},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2871":59750,"_25310":59703,"_17659":101482,"_5":17554,"_23935":101380,"_2398":101483},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2871":59751,"_25310":59703,"_17659":101485,"_5":17554,"_23935":101380,"_2398":101486},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2871":59752,"_25310":59752,"_5":12413,"_2398":101488,"_25646":101489,"_17659":101490,"_23935":59752},"Autoridades de certificación",[41060,97754,46128,101329],[],{"_2871":59753,"_25310":59752,"_17659":101492,"_5":17554,"_23935":59752,"_2398":101493},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2871":59754,"_25310":59752,"_5":25643,"_17659":101495,"_23935":101496,"_2398":101497},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2871":59755,"_25310":59752,"_5":25643,"_17659":101499,"_23935":101500,"_2398":101501},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2871":59756,"_25310":59752,"_5":25643,"_17659":101503,"_23935":101504,"_2398":96409},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2871":59757,"_25310":59752,"_5":25643,"_17659":101506,"_23935":101507,"_2398":101508},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2871":59758,"_25310":59752,"_5":25643,"_17659":101510,"_23935":101511,"_2398":101512},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2871":59759,"_25310":59752,"_5":25643,"_17659":101514,"_23935":101515,"_2398":101516},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2871":59760,"_25310":59752,"_5":25643,"_17659":101518,"_23935":101519,"_2398":101520},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2871":59761,"_25310":59752,"_5":25643,"_17659":101522,"_23935":101523,"_2398":101524},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2871":59762,"_25310":59752,"_5":25643,"_17659":101526,"_23935":101527,"_2398":101528},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2871":59763,"_25310":59752,"_5":25643,"_17659":101530,"_23935":101531,"_2398":101532},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2871":59764,"_25310":59752,"_5":25643,"_17659":101534,"_23935":101535,"_2398":101536},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2871":59765,"_25310":59752,"_5":25643,"_17659":101538,"_23935":101539,"_2398":101540},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2871":59766,"_25310":59752,"_5":25643,"_17659":101542,"_23935":101543,"_2398":101544},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2871":59767,"_25310":59752,"_5":25643,"_17659":101546,"_23935":101547,"_2398":101548},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2871":59768,"_25310":59752,"_5":25643,"_17659":101550,"_23935":101551,"_2398":101552},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2871":59769,"_25310":59752,"_5":25643,"_17659":101554,"_23935":101555,"_2398":101556},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2871":59770,"_25310":59752,"_5":25643,"_17659":101558,"_23935":101559,"_2398":101560},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2871":59771,"_25310":59752,"_5":25643,"_17659":101562,"_23935":101563,"_2398":101564},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2871":59772,"_25310":59752,"_5":25643,"_17659":101566,"_23935":101567,"_2398":101568},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2871":59773,"_25310":59752,"_5":25643,"_17659":101570,"_23935":101571,"_2398":101572},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2871":59774,"_25310":59752,"_5":25643,"_17659":101574,"_23935":101575,"_2398":101576},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2871":59775,"_25310":59752,"_5":25643,"_17659":101578,"_23935":101579,"_2398":101580},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2871":59776,"_25310":59752,"_17659":101582,"_5":17554,"_23935":59752,"_2398":101583},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2871":59777,"_25310":59752,"_17659":101585,"_5":17554,"_23935":59752,"_2398":101586},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2871":59778,"_25310":59752,"_17659":101588,"_5":17554,"_23935":59752,"_2398":101589},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2871":59779,"_25310":59752,"_17659":101591,"_5":17554,"_23935":101496,"_2398":101592},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2871":59780,"_25310":59752,"_17659":101594,"_5":17554,"_23935":101496,"_2398":101595},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2871":59781,"_25310":59752,"_17659":101597,"_5":17554,"_23935":101496,"_2398":101598},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2871":59782,"_25310":59752,"_17659":101600,"_5":17554,"_23935":101496,"_2398":101601},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2871":59783,"_25310":59752,"_17659":101603,"_5":17554,"_23935":101496,"_2398":101604},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2871":59784,"_25310":59752,"_17659":101606,"_5":17554,"_23935":101504,"_2398":101607},[],"Decide si la CA será raíz o intermedia.",{"_2871":59785,"_25310":59752,"_17659":101609,"_5":17554,"_23935":101504,"_2398":101610},[],"Elige el motor que custodiará la clave.",{"_2871":59786,"_25310":59752,"_17659":101612,"_5":17554,"_23935":101504,"_2398":101613},[],"Define una validez superior a la de los certificados que emitirá.",{"_2871":59787,"_25310":59752,"_17659":101615,"_5":17554,"_23935":101504,"_2398":101616},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2871":59788,"_25310":59752,"_17659":101618,"_5":17554,"_23935":101507,"_2398":101619},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2871":59789,"_25310":59752,"_17659":101621,"_5":17554,"_23935":101511,"_2398":101622},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2871":59790,"_25310":59752,"_17659":101624,"_5":17554,"_23935":101511,"_2398":101625},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2871":59791,"_25310":59752,"_17659":101627,"_5":17554,"_23935":101515,"_2398":101628},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2871":59792,"_25310":59752,"_17659":101630,"_5":17554,"_23935":101519,"_2398":101631},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2871":59793,"_25310":59752,"_17659":101633,"_5":17554,"_23935":101519,"_2398":101634},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2871":59794,"_25310":59752,"_17659":101636,"_5":17554,"_23935":101519,"_2398":101637},[],"`ST`: estado o provincia.",{"_2871":59795,"_25310":59752,"_17659":101639,"_5":17554,"_23935":101519,"_2398":101640},[],"`L`: localidad.",{"_2871":59796,"_25310":59752,"_17659":101642,"_5":17554,"_23935":101519,"_2398":101643},[],"`O`: organización.",{"_2871":59797,"_25310":59752,"_17659":101645,"_5":17554,"_23935":101519,"_2398":101646},[],"`OU`: unidad organizativa.",{"_2871":59798,"_25310":59752,"_17659":101648,"_5":17554,"_23935":101519,"_2398":101649},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2871":59799,"_25310":59752,"_17659":101651,"_5":17554,"_23935":101523,"_2398":101652},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2871":59800,"_25310":59752,"_17659":101654,"_5":17554,"_23935":101523,"_2398":101655},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2871":59801,"_25310":59752,"_17659":101657,"_5":17554,"_23935":101527,"_2398":101658},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2871":59802,"_25310":59752,"_17659":101660,"_5":17554,"_23935":101527,"_2398":101661},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2871":59803,"_25310":59752,"_17659":101663,"_5":17554,"_23935":101531,"_2398":101664},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2871":59804,"_25310":59752,"_17659":101666,"_5":17554,"_23935":101531,"_2398":101667},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2871":59805,"_25310":59752,"_17659":101669,"_5":17554,"_23935":101535,"_2398":101670},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2871":59806,"_25310":59752,"_17659":101672,"_5":17554,"_23935":101539,"_2398":101673},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2871":59807,"_25310":59752,"_17659":101675,"_5":17554,"_23935":101543,"_2398":101676},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2871":59808,"_25310":59752,"_17659":101678,"_5":17554,"_23935":101547,"_2398":101679},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2871":59809,"_25310":59752,"_17659":101681,"_5":17554,"_23935":101551,"_2398":101682},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2871":59810,"_25310":59752,"_17659":101684,"_5":17554,"_23935":101551,"_2398":101685},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2871":59811,"_25310":59752,"_17659":101687,"_5":17554,"_23935":101555,"_2398":101688},[],"Abre una CA desde el inventario para consultar:",{"_2871":59812,"_25310":59752,"_17659":101690,"_5":17554,"_23935":101555,"_2398":101691},[],"Estado y periodo de validez.",{"_2871":59813,"_25310":59752,"_17659":101693,"_5":17554,"_23935":101555,"_2398":101694},[],"Certificado y cadena en formato PEM.",{"_2871":59814,"_25310":59752,"_17659":101696,"_5":17554,"_23935":101555,"_2398":101697},[],"Número de certificados activos, expirados y revocados.",{"_2871":59815,"_25310":59752,"_17659":101699,"_5":17554,"_23935":101555,"_2398":101700},[],"Certificados emitidos en **Issued Certificates**.",{"_2871":59816,"_25310":59752,"_17659":101702,"_5":17554,"_23935":101555,"_2398":101703},[],"CRL vinculada a la autoridad.",{"_2871":59817,"_25310":59752,"_17659":101705,"_5":17554,"_23935":101555,"_2398":101706},[],"Metadatos y motor criptográfico asociado.",{"_2871":59818,"_25310":59752,"_17659":101708,"_5":17554,"_23935":101555,"_2398":101709},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2871":59819,"_25310":59752,"_17659":101711,"_5":17554,"_23935":101559,"_2398":101712},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2871":59820,"_25310":59752,"_17659":101714,"_5":17554,"_23935":101559,"_2398":101715},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2871":59821,"_25310":59752,"_17659":101717,"_5":17554,"_23935":101559,"_2398":101718},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2871":59822,"_25310":59752,"_17659":101720,"_5":17554,"_23935":101559,"_2398":101721},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2871":59823,"_25310":59752,"_17659":101723,"_5":17554,"_23935":101563,"_2398":101724},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2871":59824,"_25310":59752,"_17659":101726,"_5":17554,"_23935":101567,"_2398":101727},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2871":59825,"_25310":59752,"_17659":101729,"_5":17554,"_23935":101571,"_2398":101730},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2871":59826,"_25310":59752,"_17659":101732,"_5":17554,"_23935":101575,"_2398":101733},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2871":59827,"_25310":59752,"_17659":101735,"_5":17554,"_23935":101579,"_2398":101736},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2871":59828,"_25310":59752,"_17659":101738,"_5":17554,"_23935":101579,"_2398":101739},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2871":59829,"_25310":59829,"_5":12413,"_2398":101741,"_25646":101742,"_17659":101743,"_23935":59829},"Perfiles de certificado",[41060,97754,46128,101329],[],{"_2871":59830,"_25310":59829,"_17659":101745,"_5":17554,"_23935":59829,"_2398":101746},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2871":59831,"_25310":59829,"_5":25643,"_17659":101748,"_23935":101749,"_2398":101750},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2871":59832,"_25310":59829,"_5":25643,"_17659":101752,"_23935":101753,"_2398":101754},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#validez","Validez",{"_2871":59833,"_25310":59829,"_5":25643,"_17659":101756,"_23935":101757,"_2398":101758},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2871":59834,"_25310":59829,"_5":25643,"_17659":101760,"_23935":101761,"_2398":101762},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2871":59835,"_25310":59829,"_5":25643,"_17659":101764,"_23935":101765,"_2398":101766},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2871":59836,"_25310":59829,"_5":25643,"_17659":101768,"_23935":101769,"_2398":101770},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2871":59837,"_25310":59829,"_5":25643,"_17659":101772,"_23935":101773,"_2398":101774},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2871":59838,"_25310":59829,"_5":25643,"_17659":101776,"_23935":101777,"_2398":101778},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2871":59839,"_25310":59829,"_5":25643,"_17659":101780,"_23935":101781,"_2398":101782},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2871":59840,"_25310":59829,"_5":25643,"_17659":101784,"_23935":101785,"_2398":101786},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2871":59841,"_25310":59829,"_5":25643,"_17659":101788,"_23935":101789,"_2398":101790},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2871":59842,"_25310":59829,"_5":25643,"_17659":101792,"_23935":101793,"_2398":101794},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2871":59843,"_25310":59829,"_5":25643,"_17659":101796,"_23935":101797,"_2398":101798},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2871":59844,"_25310":59829,"_5":25643,"_17659":101800,"_23935":101801,"_2398":101802},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2871":59845,"_25310":59829,"_5":25643,"_17659":101804,"_23935":101805,"_2398":101806},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2871":59846,"_25310":59829,"_5":25643,"_17659":101808,"_23935":101809,"_2398":101810},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2871":59847,"_25310":59829,"_17659":101812,"_5":17554,"_23935":59829,"_2398":101813},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2871":59848,"_25310":59829,"_17659":101815,"_5":17554,"_23935":59829,"_2398":101816},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2871":59849,"_25310":59829,"_17659":101818,"_5":17554,"_23935":101753,"_2398":101819},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2871":59850,"_25310":59829,"_17659":101821,"_5":17554,"_23935":101753,"_2398":101822},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2871":59851,"_25310":59829,"_17659":101824,"_5":17554,"_23935":101757,"_2398":101825},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2871":59852,"_25310":59829,"_17659":101827,"_5":17554,"_23935":101761,"_2398":101828},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2871":59853,"_25310":59829,"_17659":101830,"_5":17554,"_23935":101761,"_2398":101831},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2871":59854,"_25310":59829,"_17659":101833,"_5":17554,"_23935":101761,"_2398":101834},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2871":59855,"_25310":59829,"_17659":101836,"_5":17554,"_23935":101765,"_2398":101837},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2871":59856,"_25310":59829,"_17659":101839,"_5":17554,"_23935":101769,"_2398":101840},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2871":59857,"_25310":59829,"_17659":101842,"_5":17554,"_23935":101769,"_2398":101843},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2871":59858,"_25310":59829,"_17659":101845,"_5":17554,"_23935":101773,"_2398":101846},[],"La aplicación criptográfica puede:",{"_2871":59859,"_25310":59829,"_17659":101848,"_5":17554,"_23935":101773,"_2398":101849},[],"permitir o bloquear claves RSA;",{"_2871":59860,"_25310":59829,"_17659":101851,"_5":17554,"_23935":101773,"_2398":101852},[],"limitar los tamaños RSA admitidos;",{"_2871":59861,"_25310":59829,"_17659":101854,"_5":17554,"_23935":101773,"_2398":101855},[],"permitir o bloquear claves ECDSA;",{"_2871":59862,"_25310":59829,"_17659":101857,"_5":17554,"_23935":101773,"_2398":101858},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2871":59863,"_25310":59829,"_17659":101860,"_5":17554,"_23935":101773,"_2398":101861},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2871":59864,"_25310":59829,"_17659":101863,"_5":17554,"_23935":101777,"_2398":101864},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2871":59865,"_25310":59829,"_17659":101866,"_5":17554,"_23935":101777,"_2398":97527},[],{"_2871":59866,"_25310":59829,"_17659":101868,"_5":17554,"_23935":101777,"_2398":101869},[],"Primera opción",{"_2871":59867,"_25310":59829,"_17659":101871,"_5":17554,"_23935":101777,"_2398":101872},[],"Segunda opción",{"_2871":59868,"_25310":59829,"_17659":101874,"_5":17554,"_23935":101777,"_2398":101875},[],"Si no hay ninguna",{"_2871":59869,"_25310":59829,"_17659":101877,"_5":17554,"_23935":101777,"_2398":101878},[],"Firma directa con una CA",{"_2871":59870,"_25310":59829,"_17659":101880,"_5":17554,"_23935":101777,"_2398":101881},[],"`issuance_profile` incluido en la solicitud",{"_2871":59871,"_25310":59829,"_17659":101883,"_5":17554,"_23935":101777,"_2398":101884},[],"`issuance_profile_id` de la solicitud",{"_2871":59872,"_25310":59829,"_17659":101886,"_5":17554,"_23935":101777,"_2398":101887},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2871":59873,"_25310":59829,"_17659":101889,"_5":17554,"_23935":101777,"_2398":101890},[],"Emisión mediante DMS",{"_2871":59874,"_25310":59829,"_17659":101892,"_5":17554,"_23935":101777,"_2398":46693},[],{"_2871":59875,"_25310":59829,"_17659":101894,"_5":17554,"_23935":101777,"_2398":101895},[],"`settings.issuance_profile` incluido en el DMS",{"_2871":59876,"_25310":59829,"_17659":101897,"_5":17554,"_23935":101777,"_2398":101898},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2871":59877,"_25310":59829,"_17659":101900,"_5":17554,"_23935":101777,"_2398":101901},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2871":59878,"_25310":59829,"_17659":101903,"_5":17554,"_23935":101777,"_2398":101904},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2871":59879,"_25310":59829,"_17659":101906,"_5":17554,"_23935":101785,"_2398":101907},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2871":59880,"_25310":59829,"_17659":101909,"_5":17554,"_23935":101789,"_2398":101910},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2871":59881,"_25310":59829,"_17659":101912,"_5":17554,"_23935":101793,"_2398":101913},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2871":59882,"_25310":59829,"_17659":101915,"_5":17554,"_23935":101797,"_2398":101916},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2871":59883,"_25310":59829,"_17659":101918,"_5":17554,"_23935":101801,"_2398":101919},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2871":59884,"_25310":59829,"_17659":101921,"_5":17554,"_23935":101801,"_2398":101922},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2871":59885,"_25310":59829,"_17659":101924,"_5":17554,"_23935":101805,"_2398":101925},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2871":59886,"_25310":59829,"_17659":101927,"_5":17554,"_23935":101805,"_2398":101928},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2871":59887,"_25310":59829,"_17659":101930,"_5":17554,"_23935":101805,"_2398":101931},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2871":59888,"_25310":59829,"_17659":101933,"_5":17554,"_23935":101805,"_2398":101934},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2871":59889,"_25310":59829,"_17659":101936,"_5":17554,"_23935":101809,"_2398":101937},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2871":59890,"_25310":59829,"_17659":101939,"_5":17554,"_23935":101809,"_2398":101940},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2871":59891,"_25310":59891,"_5":12413,"_2398":101942,"_25646":101943,"_17659":101945,"_23935":59891},"Validación de certificados",[41060,97754,46128,101944],"Validación",[],{"_2871":59892,"_25310":59891,"_17659":101947,"_5":17554,"_23935":59891,"_2398":101948},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2871":59893,"_25310":59891,"_5":25643,"_17659":101950,"_23935":101951,"_2398":101952},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2871":59894,"_25310":59891,"_5":25643,"_17659":101954,"_23935":101955,"_2398":101956},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2871":59895,"_25310":59891,"_5":25643,"_17659":101958,"_23935":101959,"_2398":101960},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2871":59896,"_25310":59891,"_17659":101962,"_5":17554,"_23935":59891,"_2398":101963},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2871":59897,"_25310":59891,"_17659":101965,"_5":17554,"_23935":101951,"_2398":101966},[],"Verifica estos criterios juntos:",{"_2871":59898,"_25310":59891,"_17659":101968,"_5":17554,"_23935":101951,"_2398":100956},[],{"_2871":59899,"_25310":59891,"_17659":101970,"_5":17554,"_23935":101951,"_2398":101971},[],"Resultado necesario",{"_2871":59900,"_25310":59891,"_17659":101973,"_5":17554,"_23935":101951,"_2398":101974},[],"Cadena y firma",{"_2871":59901,"_25310":59891,"_17659":101976,"_5":17554,"_23935":101951,"_2398":101977},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2871":59902,"_25310":59891,"_17659":101979,"_5":17554,"_23935":101951,"_2398":101980},[],"Fechas",{"_2871":59903,"_25310":59891,"_17659":101982,"_5":17554,"_23935":101951,"_2398":101983},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2871":59904,"_25310":59891,"_17659":101985,"_5":17554,"_23935":101951,"_2398":97440},[],{"_2871":59905,"_25310":59891,"_17659":101987,"_5":17554,"_23935":101951,"_2398":101988},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2871":59906,"_25310":59891,"_17659":101990,"_5":17554,"_23935":101951,"_2398":101991},[],"Uso",{"_2871":59907,"_25310":59891,"_17659":101993,"_5":17554,"_23935":101951,"_2398":101994},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2871":59908,"_25310":59891,"_17659":101996,"_5":17554,"_23935":101951,"_2398":101997},[],"Revocación",{"_2871":59909,"_25310":59891,"_17659":101999,"_5":17554,"_23935":101951,"_2398":102000},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2871":59910,"_25310":59891,"_17659":102002,"_5":17554,"_23935":101951,"_2398":102003},[],"Autorización",{"_2871":59911,"_25310":59891,"_17659":102005,"_5":17554,"_23935":101951,"_2398":102006},[],"La aplicación permite la acción a esa identidad.",{"_2871":59912,"_25310":59891,"_17659":102008,"_5":17554,"_23935":101951,"_2398":102009},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2871":59913,"_25310":59891,"_17659":102011,"_5":17554,"_23935":101955,"_2398":102012},[],"Mecanismo",{"_2871":59914,"_25310":59891,"_17659":102014,"_5":17554,"_23935":101955,"_2398":102015},[],"Cuándo utilizarlo",{"_2871":59915,"_25310":59891,"_17659":102017,"_5":17554,"_23935":101955,"_2398":102018},[],"Qué debes mantener",{"_2871":59916,"_25310":59891,"_17659":102020,"_5":17554,"_23935":101955,"_2398":46821},[],{"_2871":59917,"_25310":59891,"_17659":102022,"_5":17554,"_23935":101955,"_2398":102023},[],"Consulta del estado de un certificado concreto.",{"_2871":59918,"_25310":59891,"_17659":102025,"_5":17554,"_23935":101955,"_2398":102026},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2871":59919,"_25310":59891,"_17659":102028,"_5":17554,"_23935":101955,"_2398":46830},[],{"_2871":59920,"_25310":59891,"_17659":102030,"_5":17554,"_23935":101955,"_2398":102031},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2871":59921,"_25310":59891,"_17659":102033,"_5":17554,"_23935":101955,"_2398":102034},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2871":59922,"_25310":59891,"_17659":102036,"_5":17554,"_23935":101955,"_2398":102037},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2871":59923,"_25310":59891,"_17659":102039,"_5":17554,"_23935":101955,"_2398":102040},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2871":59924,"_25310":59891,"_17659":102042,"_5":17554,"_23935":101959,"_2398":102043},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2871":59925,"_25310":59891,"_17659":102045,"_5":17554,"_23935":101959,"_2398":102046},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2871":59926,"_25310":59891,"_17659":102048,"_5":17554,"_23935":101959,"_2398":102049},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2871":59927,"_25310":59891,"_17659":102051,"_5":17554,"_23935":101959,"_2398":102052},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2871":59928,"_25310":59891,"_17659":102054,"_5":17554,"_23935":101959,"_2398":102055},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2871":59929,"_25310":59891,"_17659":102057,"_5":17554,"_23935":101959,"_2398":102058},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2871":59930,"_25310":59891,"_17659":102060,"_5":17554,"_23935":101959,"_2398":102061},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2871":59931,"_25310":59891,"_17659":102063,"_5":17554,"_23935":101959,"_2398":102064},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2871":59932,"_25310":59891,"_17659":102066,"_5":17554,"_23935":101959,"_2398":102067},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2871":59933,"_25310":59933,"_5":12413,"_2398":102069,"_25646":102070,"_17659":102071,"_23935":59933},"Certificados",[41060,97754,46128,101329],[],{"_2871":59934,"_25310":59933,"_17659":102073,"_5":17554,"_23935":59933,"_2398":102074},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2871":59935,"_25310":59933,"_5":25643,"_17659":102076,"_23935":102077,"_2398":102078},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2871":59936,"_25310":59933,"_5":25643,"_17659":102080,"_23935":102081,"_2398":102082},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2871":59937,"_25310":59933,"_5":25643,"_17659":102084,"_23935":102085,"_2398":102086},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2871":59938,"_25310":59933,"_5":25643,"_17659":102088,"_23935":102089,"_2398":102090},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2871":59939,"_25310":59933,"_5":25643,"_17659":102092,"_23935":102093,"_2398":102094},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2871":59940,"_25310":59933,"_5":25643,"_17659":102096,"_23935":102097,"_2398":102098},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2871":59941,"_25310":59933,"_5":25643,"_17659":102100,"_23935":102101,"_2398":102102},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2871":59942,"_25310":59933,"_5":25643,"_17659":102104,"_23935":102105,"_2398":102106},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2871":59943,"_25310":59933,"_5":25643,"_17659":102108,"_23935":102109,"_2398":102110},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#continúa","Continúa",{"_2871":59944,"_25310":59933,"_17659":102112,"_5":17554,"_23935":59933,"_2398":102113},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2871":59945,"_25310":59933,"_17659":102115,"_5":17554,"_23935":102077,"_2398":102116},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2871":59946,"_25310":59933,"_17659":102118,"_5":17554,"_23935":102077,"_2398":102119},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2871":59947,"_25310":59933,"_17659":102121,"_5":17554,"_23935":102081,"_2398":102122},[],"Descarga el PEM e inspecciónalo:",{"_2871":59948,"_25310":59933,"_17659":102124,"_5":17554,"_23935":102081,"_2398":102125},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2871":59949,"_25310":59933,"_17659":102127,"_5":17554,"_23935":102085,"_2398":102128},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2871":59950,"_25310":59933,"_17659":102130,"_5":17554,"_23935":102085,"_2398":102131},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2871":59951,"_25310":59933,"_17659":102133,"_5":17554,"_23935":102085,"_2398":102134},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2871":59952,"_25310":59933,"_17659":102136,"_5":17554,"_23935":102085,"_2398":102137},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2871":59953,"_25310":59933,"_17659":102139,"_5":17554,"_23935":102085,"_2398":102140},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2871":59954,"_25310":59933,"_17659":102142,"_5":17554,"_23935":102085,"_2398":102143},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2871":59955,"_25310":59933,"_17659":102145,"_5":17554,"_23935":102085,"_2398":102146},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2871":59956,"_25310":59933,"_17659":102148,"_5":17554,"_23935":102089,"_2398":102149},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2871":59957,"_25310":59933,"_17659":102151,"_5":17554,"_23935":102093,"_2398":102152},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2871":59958,"_25310":59933,"_17659":102154,"_5":17554,"_23935":102097,"_2398":102155},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2871":59959,"_25310":59933,"_17659":102157,"_5":17554,"_23935":102101,"_2398":102158},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2871":59960,"_25310":59933,"_17659":102160,"_5":17554,"_23935":102101,"_2398":102161},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2871":59961,"_25310":59933,"_17659":102163,"_5":17554,"_23935":102101,"_2398":102164},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2871":59962,"_25310":59933,"_17659":102166,"_5":17554,"_23935":102105,"_2398":102167},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2871":59963,"_25310":59933,"_17659":102169,"_5":17554,"_23935":102105,"_2398":102170},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2871":59964,"_25310":59933,"_17659":102172,"_5":17554,"_23935":102105,"_2398":102173},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2871":59965,"_25310":59933,"_17659":102175,"_5":17554,"_23935":102109,"_2398":102176},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2871":59966,"_25310":59933,"_17659":102178,"_5":17554,"_23935":102109,"_2398":102179},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2871":59967,"_25310":59967,"_5":12413,"_2398":102181,"_25646":102182,"_17659":102184,"_23935":59967},"Ciclo de vida de un certificado",[41060,97754,46128,102183],"Conceptos",[],{"_2871":59968,"_25310":59967,"_17659":102186,"_5":17554,"_23935":59967,"_2398":102187},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2871":59969,"_25310":59967,"_5":25643,"_17659":102189,"_23935":102190,"_2398":102191},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2871":59970,"_25310":59967,"_5":25643,"_17659":102193,"_23935":102194,"_2398":102195},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2871":59971,"_25310":59967,"_5":25643,"_17659":102197,"_23935":102198,"_2398":102199},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2871":59972,"_25310":59967,"_5":25643,"_17659":102201,"_23935":102202,"_2398":102203},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2871":59973,"_25310":59967,"_5":25643,"_17659":102205,"_23935":102206,"_2398":102207},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2871":59974,"_25310":59967,"_5":25643,"_17659":102209,"_23935":102210,"_2398":102211},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2871":59975,"_25310":59967,"_5":25643,"_17659":102213,"_23935":102214,"_2398":102215},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2871":59976,"_25310":59967,"_5":25643,"_17659":102217,"_23935":102218,"_2398":102219},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2871":59977,"_25310":59967,"_5":25643,"_17659":102221,"_23935":102222,"_2398":102223},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2871":59978,"_25310":59967,"_5":25643,"_17659":102225,"_23935":102226,"_2398":102227},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2871":59979,"_25310":59967,"_17659":102229,"_5":17554,"_23935":59967,"_2398":102230},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2871":59980,"_25310":59967,"_17659":102232,"_5":17554,"_23935":102194,"_2398":102233},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2871":59981,"_25310":59967,"_17659":102235,"_5":17554,"_23935":102198,"_2398":102236},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2871":59982,"_25310":59967,"_17659":102238,"_5":17554,"_23935":102202,"_2398":102239},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2871":59983,"_25310":59967,"_17659":102241,"_5":17554,"_23935":102206,"_2398":102242},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2871":59984,"_25310":59967,"_17659":102244,"_5":17554,"_23935":102210,"_2398":102245},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2871":59985,"_25310":59967,"_17659":102247,"_5":17554,"_23935":102214,"_2398":102248},[],"Lamassu persiste cuatro estados X.509:",{"_2871":59986,"_25310":59967,"_17659":102250,"_5":17554,"_23935":102214,"_2398":102251},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2871":59987,"_25310":59967,"_17659":102253,"_5":17554,"_23935":102214,"_2398":102254},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2871":59988,"_25310":59967,"_17659":102256,"_5":17554,"_23935":102214,"_2398":102257},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2871":59989,"_25310":59967,"_17659":102259,"_5":17554,"_23935":102214,"_2398":102260},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2871":59990,"_25310":59967,"_17659":102262,"_5":17554,"_23935":102214,"_2398":102263},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2871":59991,"_25310":59967,"_17659":102265,"_5":17554,"_23935":102218,"_2398":102266},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2871":59992,"_25310":59967,"_17659":102268,"_5":17554,"_23935":102218,"_2398":102269},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2871":59993,"_25310":59967,"_17659":102271,"_5":17554,"_23935":102218,"_2398":102272},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2871":59994,"_25310":59967,"_17659":102274,"_5":17554,"_23935":102222,"_2398":102275},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2871":59995,"_25310":59967,"_17659":102277,"_5":17554,"_23935":102222,"_2398":102278},[],"Antes de confirmar:",{"_2871":59996,"_25310":59967,"_17659":102280,"_5":17554,"_23935":102222,"_2398":102281},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2871":59997,"_25310":59967,"_17659":102283,"_5":17554,"_23935":102222,"_2398":102284},[],"Distribuye la nueva cadena de confianza.",{"_2871":59998,"_25310":59967,"_17659":102286,"_5":17554,"_23935":102222,"_2398":102287},[],"Reemite las identidades necesarias.",{"_2871":59999,"_25310":59967,"_17659":102289,"_5":17554,"_23935":102222,"_2398":102290},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2871":60000,"_25310":59967,"_17659":102292,"_5":17554,"_23935":102222,"_2398":102293},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2871":60001,"_25310":59967,"_17659":102295,"_5":17554,"_23935":102222,"_2398":102296},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2871":60002,"_25310":59967,"_17659":102298,"_5":17554,"_23935":102226,"_2398":102299},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2871":60003,"_25310":59967,"_17659":102301,"_5":17554,"_23935":102226,"_2398":102302},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2871":60004,"_25310":59967,"_17659":102304,"_5":17554,"_23935":102226,"_2398":102305},[],"Cambios de estado y razones de revocación.",{"_2871":60005,"_25310":59967,"_17659":102307,"_5":17554,"_23935":102226,"_2398":102308},[],"Publicación y vigencia de OCSP y CRLs.",{"_2871":60006,"_25310":59967,"_17659":102310,"_5":17554,"_23935":102226,"_2398":102311},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2871":60007,"_25310":59967,"_17659":102313,"_5":17554,"_23935":102226,"_2398":102314},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2871":60008,"_25310":60008,"_5":12413,"_2398":102316,"_25646":102317,"_17659":102318,"_23935":60008},"Modelo de confianza",[41060,97754,46128,102183],[],{"_2871":60009,"_25310":60008,"_17659":102320,"_5":17554,"_23935":60008,"_2398":102321},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2871":60010,"_25310":60008,"_5":25643,"_17659":102323,"_23935":102324,"_2398":102325},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2871":60011,"_25310":60008,"_5":25643,"_17659":102327,"_23935":102328,"_2398":102329},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2871":60012,"_25310":60008,"_5":25643,"_17659":102331,"_23935":102332,"_2398":102333},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2871":60013,"_25310":60008,"_5":25643,"_17659":102335,"_23935":102336,"_2398":102337},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2871":60014,"_25310":60008,"_5":25643,"_17659":102339,"_23935":102340,"_2398":102341},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2871":60015,"_25310":60008,"_5":25643,"_17659":102343,"_23935":102344,"_2398":102345},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2871":60016,"_25310":60008,"_5":25643,"_17659":102347,"_23935":102348,"_2398":102349},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2871":60017,"_25310":60008,"_5":25643,"_17659":102351,"_23935":102352,"_2398":102353},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2871":60018,"_25310":60008,"_5":25643,"_17659":102355,"_23935":102356,"_2398":102357},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2871":60019,"_25310":60008,"_5":25643,"_17659":102359,"_23935":102360,"_2398":102361},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2871":60020,"_25310":60008,"_17659":102363,"_5":17554,"_23935":60008,"_2398":102364},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2871":60021,"_25310":60008,"_17659":102366,"_5":17554,"_23935":102328,"_2398":102367},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2871":60022,"_25310":60008,"_17659":102369,"_5":17554,"_23935":102332,"_2398":102370},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2871":60023,"_25310":60008,"_17659":102372,"_5":17554,"_23935":102336,"_2398":102373},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2871":60024,"_25310":60008,"_17659":102375,"_5":17554,"_23935":102340,"_2398":102376},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2871":60025,"_25310":60008,"_17659":102378,"_5":17554,"_23935":102344,"_2398":102379},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2871":60026,"_25310":60008,"_17659":102381,"_5":17554,"_23935":102344,"_2398":102382},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2871":60027,"_25310":60008,"_17659":102384,"_5":17554,"_23935":102344,"_2398":102385},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2871":60028,"_25310":60008,"_17659":102387,"_5":17554,"_23935":102344,"_2398":102388},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2871":60029,"_25310":60008,"_17659":102390,"_5":17554,"_23935":102344,"_2398":102391},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2871":60030,"_25310":60008,"_17659":102393,"_5":17554,"_23935":102344,"_2398":102394},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2871":60031,"_25310":60008,"_17659":102396,"_5":17554,"_23935":102348,"_2398":102397},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2871":60032,"_25310":60008,"_17659":102399,"_5":17554,"_23935":102348,"_2398":102400},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2871":60033,"_25310":60008,"_17659":102402,"_5":17554,"_23935":102348,"_2398":102403},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2871":60034,"_25310":60008,"_17659":102405,"_5":17554,"_23935":102348,"_2398":102406},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2871":60035,"_25310":60008,"_17659":102408,"_5":17554,"_23935":102348,"_2398":102409},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2871":60036,"_25310":60008,"_17659":102411,"_5":17554,"_23935":102352,"_2398":102412},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2871":60037,"_25310":60008,"_17659":102414,"_5":17554,"_23935":102352,"_2398":102415},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2871":60038,"_25310":60008,"_17659":102417,"_5":17554,"_23935":102352,"_2398":102418},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2871":60039,"_25310":60008,"_17659":102420,"_5":17554,"_23935":102352,"_2398":102421},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2871":60040,"_25310":60008,"_17659":102423,"_5":17554,"_23935":102352,"_2398":102424},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2871":60041,"_25310":60008,"_17659":102426,"_5":17554,"_23935":102352,"_2398":102427},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2871":60042,"_25310":60008,"_17659":102429,"_5":17554,"_23935":102352,"_2398":102430},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2871":60043,"_25310":60008,"_17659":102432,"_5":17554,"_23935":102356,"_2398":102433},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2871":60044,"_25310":60008,"_17659":102435,"_5":17554,"_23935":102360,"_2398":102436},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2871":60045,"_25310":60008,"_17659":102438,"_5":17554,"_23935":102360,"_2398":102439},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2871":60046,"_25310":60008,"_17659":102441,"_5":17554,"_23935":102360,"_2398":102442},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2871":60047,"_25310":60008,"_17659":102444,"_5":17554,"_23935":102360,"_2398":102445},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2871":60048,"_25310":60008,"_17659":102447,"_5":17554,"_23935":102360,"_2398":102448},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2871":60049,"_25310":60008,"_17659":102450,"_5":17554,"_23935":102360,"_2398":102451},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2871":60050,"_25310":60008,"_17659":102453,"_5":17554,"_23935":102360,"_2398":102454},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2871":60051,"_25310":60051,"_5":12413,"_2398":102456,"_25646":102457,"_17659":102458,"_23935":60051},"Listas de revocación (CRL)",[41060,97754,46128,101944],[],{"_2871":60052,"_25310":60051,"_17659":102460,"_5":17554,"_23935":60051,"_2398":102461},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2871":60053,"_25310":60051,"_5":25643,"_17659":102463,"_23935":102464,"_2398":102465},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2871":60054,"_25310":60051,"_5":25643,"_17659":102467,"_23935":102468,"_2398":102469},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2871":60055,"_25310":60051,"_5":25643,"_17659":102471,"_23935":102472,"_2398":102473},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2871":60056,"_25310":60051,"_5":25643,"_17659":102475,"_23935":102476,"_2398":102477},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2871":60057,"_25310":60051,"_5":25643,"_17659":102479,"_23935":102480,"_2398":102481},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2871":60058,"_25310":60051,"_5":25643,"_17659":102483,"_23935":102484,"_2398":102485},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2871":60059,"_25310":60051,"_5":25643,"_17659":102487,"_23935":102488,"_2398":102489},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#referencias","Referencias",{"_2871":60060,"_25310":60051,"_17659":102491,"_5":17554,"_23935":60051,"_2398":102492},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2871":60061,"_25310":60051,"_17659":102494,"_5":17554,"_23935":102464,"_2398":102495},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2871":60062,"_25310":60051,"_17659":102497,"_5":17554,"_23935":102464,"_2398":102498},[],"Campo de `crl_options`",{"_2871":60063,"_25310":60051,"_17659":102500,"_5":17554,"_23935":102464,"_2398":99247},[],{"_2871":60064,"_25310":60051,"_17659":102502,"_5":17554,"_23935":102464,"_2398":102503},[],"Valor inicial del backend",{"_2871":60065,"_25310":60051,"_17659":102505,"_5":17554,"_23935":102464,"_2398":47308},[],{"_2871":60066,"_25310":60051,"_17659":102507,"_5":17554,"_23935":102464,"_2398":102508},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2871":60067,"_25310":60051,"_17659":102510,"_5":17554,"_23935":102464,"_2398":102511},[],"7 días.",{"_2871":60068,"_25310":60051,"_17659":102513,"_5":17554,"_23935":102464,"_2398":47317},[],{"_2871":60069,"_25310":60051,"_17659":102515,"_5":17554,"_23935":102464,"_2398":102516},[],"Plazo desde la publicación que activa la renovación programada.",{"_2871":60070,"_25310":60051,"_17659":102518,"_5":17554,"_23935":102464,"_2398":102519},[],"6 días y 23 horas.",{"_2871":60071,"_25310":60051,"_17659":102521,"_5":17554,"_23935":102464,"_2398":47326},[],{"_2871":60072,"_25310":60051,"_17659":102523,"_5":17554,"_23935":102464,"_2398":102524},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2871":60073,"_25310":60051,"_17659":102526,"_5":17554,"_23935":102464,"_2398":47332},[],{"_2871":60074,"_25310":60051,"_17659":102528,"_5":17554,"_23935":102464,"_2398":47335},[],{"_2871":60075,"_25310":60051,"_17659":102530,"_5":17554,"_23935":102464,"_2398":102531},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2871":60076,"_25310":60051,"_17659":102533,"_5":17554,"_23935":102464,"_2398":102534},[],"SKI de la CA.",{"_2871":60077,"_25310":60051,"_17659":102536,"_5":17554,"_23935":102464,"_2398":102537},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2871":60078,"_25310":60051,"_17659":102539,"_5":17554,"_23935":102464,"_2398":102540},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2871":60079,"_25310":60051,"_17659":102542,"_5":17554,"_23935":102468,"_2398":102543},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2871":60080,"_25310":60051,"_17659":102545,"_5":17554,"_23935":102468,"_2398":102546},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2871":60081,"_25310":60051,"_17659":102548,"_5":17554,"_23935":102468,"_2398":102549},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2871":60082,"_25310":60051,"_17659":102551,"_5":17554,"_23935":102472,"_2398":102552},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2871":60083,"_25310":60051,"_17659":102554,"_5":17554,"_23935":102472,"_2398":102555},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2871":60084,"_25310":60051,"_17659":102557,"_5":17554,"_23935":102476,"_2398":102558},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2871":60085,"_25310":60051,"_17659":102560,"_5":17554,"_23935":102476,"_2398":102561},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2871":60086,"_25310":60051,"_17659":102563,"_5":17554,"_23935":102476,"_2398":102564},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2871":60087,"_25310":60051,"_17659":102566,"_5":17554,"_23935":102476,"_2398":102567},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2871":60088,"_25310":60051,"_17659":102569,"_5":17554,"_23935":102476,"_2398":102570},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2871":60089,"_25310":60051,"_17659":102572,"_5":17554,"_23935":102480,"_2398":102573},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2871":60090,"_25310":60051,"_17659":102575,"_5":17554,"_23935":102480,"_2398":99436},[],{"_2871":60091,"_25310":60051,"_17659":102577,"_5":17554,"_23935":102480,"_2398":102578},[],"Path relativo",{"_2871":60092,"_25310":60051,"_17659":102580,"_5":17554,"_23935":102480,"_2398":97527},[],{"_2871":60093,"_25310":60051,"_17659":102582,"_5":17554,"_23935":102480,"_2398":47390},[],{"_2871":60094,"_25310":60051,"_17659":102584,"_5":17554,"_23935":102480,"_2398":47393},[],{"_2871":60095,"_25310":60051,"_17659":102586,"_5":17554,"_23935":102480,"_2398":102587},[],"Consultar `crl_options` y `latest_crl`.",{"_2871":60096,"_25310":60051,"_17659":102589,"_5":17554,"_23935":102480,"_2398":47399},[],{"_2871":60097,"_25310":60051,"_17659":102591,"_5":17554,"_23935":102480,"_2398":47393},[],{"_2871":60098,"_25310":60051,"_17659":102593,"_5":17554,"_23935":102480,"_2398":102594},[],"Sustituir la configuración de CRL.",{"_2871":60099,"_25310":60051,"_17659":102596,"_5":17554,"_23935":102480,"_2398":102597},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2871":60100,"_25310":60051,"_17659":102599,"_5":17554,"_23935":102480,"_2398":102600},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2871":60101,"_25310":60051,"_17659":102602,"_5":17554,"_23935":102484,"_2398":102603},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2871":60102,"_25310":60051,"_17659":102605,"_5":17554,"_23935":102488,"_2398":102606},[],"RFC 5280: perfil X.509 y CRL.",{"_2871":60103,"_25310":60051,"_17659":102608,"_5":17554,"_23935":102488,"_2398":47419},[],{"_2871":60104,"_25310":60051,"_17659":102610,"_5":17554,"_23935":102488,"_2398":47422},[],{"_2871":60105,"_25310":60051,"_17659":102612,"_5":17554,"_23935":102488,"_2398":102613},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2871":60106,"_25310":60051,"_17659":102615,"_5":17554,"_23935":102488,"_2398":102616},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2871":60107,"_25310":60107,"_5":12413,"_2398":102618,"_25646":102619,"_17659":102620,"_23935":60107},"Claves y motores criptográficos",[41060,97754,46128,101329],[],{"_2871":60108,"_25310":60107,"_17659":102622,"_5":17554,"_23935":60107,"_2398":102623},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2871":60109,"_25310":60107,"_5":25643,"_17659":102625,"_23935":102626,"_2398":102627},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2871":60110,"_25310":60107,"_5":25643,"_17659":102629,"_23935":102630,"_2398":102631},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2871":60111,"_25310":60107,"_5":25643,"_17659":102633,"_23935":102634,"_2398":47447},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#file-system",{"_2871":60112,"_25310":60107,"_5":25643,"_17659":102636,"_23935":102637,"_2398":47451},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#hashicorp-vault",{"_2871":60113,"_25310":60107,"_5":25643,"_17659":102639,"_23935":102640,"_2398":47455},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#aws-secrets-manager",{"_2871":60114,"_25310":60107,"_5":25643,"_17659":102642,"_23935":102643,"_2398":47459},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#aws-kms",{"_2871":60115,"_25310":60107,"_5":25643,"_17659":102645,"_23935":102646,"_2398":47463},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#pkcs11",{"_2871":60116,"_25310":60107,"_5":25643,"_17659":102648,"_23935":102649,"_2398":47467},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#azure-key-vault",{"_2871":60117,"_25310":60107,"_5":25643,"_17659":102651,"_23935":102652,"_2398":102653},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2871":60118,"_25310":60107,"_5":25643,"_17659":102655,"_23935":102656,"_2398":102657},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2871":60119,"_25310":60107,"_5":25643,"_17659":102659,"_23935":102660,"_2398":102661},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2871":60120,"_25310":60107,"_5":25643,"_17659":102663,"_23935":102664,"_2398":102665},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2871":60121,"_25310":60107,"_5":25643,"_17659":102667,"_23935":102668,"_2398":102669},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2871":60122,"_25310":60107,"_5":25643,"_17659":102671,"_23935":102672,"_2398":102673},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2871":60123,"_25310":60107,"_5":25643,"_17659":102675,"_23935":102676,"_2398":102677},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2871":60124,"_25310":60107,"_5":25643,"_17659":102679,"_23935":102680,"_2398":47499},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#sign",{"_2871":60125,"_25310":60107,"_5":25643,"_17659":102682,"_23935":102683,"_2398":47503},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#verify",{"_2871":60126,"_25310":60107,"_5":25643,"_17659":102685,"_23935":102686,"_2398":102687},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2871":60127,"_25310":60107,"_5":25643,"_17659":102689,"_23935":102690,"_2398":102691},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2871":60128,"_25310":60107,"_5":25643,"_17659":102693,"_23935":102694,"_2398":102695},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2871":60129,"_25310":60107,"_17659":102697,"_5":17554,"_23935":60107,"_2398":102698},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2871":60130,"_25310":60107,"_17659":102700,"_5":17554,"_23935":60107,"_2398":102701},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2871":60131,"_25310":60107,"_17659":102703,"_5":17554,"_23935":102626,"_2398":102704},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2871":60132,"_25310":60107,"_17659":102706,"_5":17554,"_23935":102626,"_2398":102707},[],"En la práctica, permite:",{"_2871":60133,"_25310":60107,"_17659":102709,"_5":17554,"_23935":102626,"_2398":102710},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2871":60134,"_25310":60107,"_17659":102712,"_5":17554,"_23935":102626,"_2398":102713},[],"Importar claves creadas externamente.",{"_2871":60135,"_25310":60107,"_17659":102715,"_5":17554,"_23935":102626,"_2398":102716},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2871":60136,"_25310":60107,"_17659":102718,"_5":17554,"_23935":102626,"_2398":102719},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2871":60137,"_25310":60107,"_17659":102721,"_5":17554,"_23935":102630,"_2398":102722},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2871":60138,"_25310":60107,"_17659":102724,"_5":17554,"_23935":102630,"_2398":102725},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2871":60139,"_25310":60107,"_17659":102727,"_5":17554,"_23935":102630,"_2398":102728},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2871":60140,"_25310":60107,"_17659":102730,"_5":17554,"_23935":102634,"_2398":102731},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2871":60141,"_25310":60107,"_17659":102733,"_5":17554,"_23935":102637,"_2398":102734},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2871":60142,"_25310":60107,"_17659":102736,"_5":17554,"_23935":102640,"_2398":102737},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2871":60143,"_25310":60107,"_17659":102739,"_5":17554,"_23935":102643,"_2398":102740},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2871":60144,"_25310":60107,"_17659":102742,"_5":17554,"_23935":102646,"_2398":102743},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2871":60145,"_25310":60107,"_17659":102745,"_5":17554,"_23935":102649,"_2398":102746},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2871":60146,"_25310":60107,"_17659":102748,"_5":17554,"_23935":102649,"_2398":102749},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2871":60147,"_25310":60107,"_17659":102751,"_5":17554,"_23935":102649,"_2398":102752},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2871":60148,"_25310":60107,"_17659":102754,"_5":17554,"_23935":102649,"_2398":102755},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2871":60149,"_25310":60107,"_17659":102757,"_5":17554,"_23935":102652,"_2398":102758},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2871":60150,"_25310":60107,"_17659":102760,"_5":17554,"_23935":102652,"_2398":102761},[],"La tabla incluye los siguientes campos:",{"_2871":60151,"_25310":60107,"_17659":102763,"_5":17554,"_23935":102652,"_2398":102764},[],"**Name**: nombre descriptivo de la clave.",{"_2871":60152,"_25310":60107,"_17659":102766,"_5":17554,"_23935":102652,"_2398":102767},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2871":60153,"_25310":60107,"_17659":102769,"_5":17554,"_23935":102652,"_2398":102770},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2871":60154,"_25310":60107,"_17659":102772,"_5":17554,"_23935":102652,"_2398":102773},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2871":60155,"_25310":60107,"_17659":102775,"_5":17554,"_23935":102652,"_2398":102776},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2871":60156,"_25310":60107,"_17659":102778,"_5":17554,"_23935":102652,"_2398":102779},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2871":60157,"_25310":60107,"_17659":102781,"_5":17554,"_23935":102652,"_2398":102782},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2871":60158,"_25310":60107,"_17659":102784,"_5":17554,"_23935":102652,"_2398":102785},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2871":60159,"_25310":60107,"_17659":102787,"_5":17554,"_23935":102652,"_2398":102788},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2871":60160,"_25310":60107,"_17659":102790,"_5":17554,"_23935":102652,"_2398":102791},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2871":60161,"_25310":60107,"_17659":102793,"_5":17554,"_23935":102652,"_2398":102794},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2871":60162,"_25310":60107,"_17659":102796,"_5":17554,"_23935":102652,"_2398":102797},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2871":60163,"_25310":60107,"_17659":102799,"_5":17554,"_23935":102652,"_2398":102800},[],"**Delete Key** para eliminar la clave del sistema.",{"_2871":60164,"_25310":60107,"_17659":102802,"_5":17554,"_23935":102656,"_2398":102803},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2871":60165,"_25310":60107,"_17659":102805,"_5":17554,"_23935":102660,"_2398":102806},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2871":60166,"_25310":60107,"_17659":102808,"_5":17554,"_23935":102660,"_2398":102809},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2871":60167,"_25310":60107,"_17659":102811,"_5":17554,"_23935":102660,"_2398":102812},[],"**Key Name**: nombre único y descriptivo.",{"_2871":60168,"_25310":60107,"_17659":102814,"_5":17554,"_23935":102660,"_2398":102815},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2871":60169,"_25310":60107,"_17659":102817,"_5":17554,"_23935":102660,"_2398":102818},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2871":60170,"_25310":60107,"_17659":102820,"_5":17554,"_23935":102660,"_2398":102821},[],"**Tags**: metadatos para clasificar la clave.",{"_2871":60171,"_25310":60107,"_17659":102823,"_5":17554,"_23935":102660,"_2398":102824},[],"**Metadata**: información adicional para usos avanzados.",{"_2871":60172,"_25310":60107,"_17659":102826,"_5":17554,"_23935":102664,"_2398":102827},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2871":60173,"_25310":60107,"_17659":102829,"_5":17554,"_23935":102664,"_2398":102830},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2871":60174,"_25310":60107,"_17659":102832,"_5":17554,"_23935":102664,"_2398":102833},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2871":60175,"_25310":60107,"_17659":102835,"_5":17554,"_23935":102664,"_2398":102836},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2871":60176,"_25310":60107,"_17659":102838,"_5":17554,"_23935":102664,"_2398":102839},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2871":60177,"_25310":60107,"_17659":102841,"_5":17554,"_23935":102664,"_2398":102842},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2871":60178,"_25310":60107,"_17659":102844,"_5":17554,"_23935":102664,"_2398":102845},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2871":60179,"_25310":60107,"_17659":102847,"_5":17554,"_23935":102664,"_2398":102848},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2871":60180,"_25310":60107,"_17659":102850,"_5":17554,"_23935":102664,"_2398":102851},[],"**Metadata**: información adicional opcional.",{"_2871":60181,"_25310":60107,"_17659":102853,"_5":17554,"_23935":102664,"_2398":102854},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2871":60182,"_25310":60107,"_17659":102856,"_5":17554,"_23935":102664,"_2398":102857},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2871":60183,"_25310":60107,"_17659":102859,"_5":17554,"_23935":102668,"_2398":102860},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2871":60184,"_25310":60107,"_17659":102862,"_5":17554,"_23935":102672,"_2398":102863},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2871":60185,"_25310":60107,"_17659":102865,"_5":17554,"_23935":102672,"_2398":102866},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2871":60186,"_25310":60107,"_17659":102868,"_5":17554,"_23935":102672,"_2398":102869},[],"**Key Name**: nombre descriptivo.",{"_2871":60187,"_25310":60107,"_17659":102871,"_5":17554,"_23935":102672,"_2398":102872},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2871":60188,"_25310":60107,"_17659":102874,"_5":17554,"_23935":102672,"_2398":102875},[],"**Tags**: etiquetas asociadas.",{"_2871":60189,"_25310":60107,"_17659":102877,"_5":17554,"_23935":102672,"_2398":102878},[],"**Aliases**: nombres alternativos.",{"_2871":60190,"_25310":60107,"_17659":102880,"_5":17554,"_23935":102672,"_2398":102881},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2871":60191,"_25310":60107,"_17659":102883,"_5":17554,"_23935":102672,"_2398":102884},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2871":60192,"_25310":60107,"_17659":102886,"_5":17554,"_23935":102672,"_2398":102887},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2871":60193,"_25310":60107,"_17659":102889,"_5":17554,"_23935":102672,"_2398":102890},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2871":60194,"_25310":60107,"_17659":102892,"_5":17554,"_23935":102676,"_2398":102893},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2871":60195,"_25310":60107,"_17659":102895,"_5":17554,"_23935":102676,"_2398":102896},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2871":60196,"_25310":60107,"_17659":102898,"_5":17554,"_23935":102676,"_2398":102899},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2871":60197,"_25310":60107,"_17659":102901,"_5":17554,"_23935":102680,"_2398":102902},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2871":60198,"_25310":60107,"_17659":102904,"_5":17554,"_23935":102680,"_2398":102905},[],"Campos principales:",{"_2871":60199,"_25310":60107,"_17659":102907,"_5":17554,"_23935":102680,"_2398":102908},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2871":60200,"_25310":60107,"_17659":102910,"_5":17554,"_23935":102680,"_2398":102911},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2871":60201,"_25310":60107,"_17659":102913,"_5":17554,"_23935":102680,"_2398":102914},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2871":60202,"_25310":60107,"_17659":102916,"_5":17554,"_23935":102680,"_2398":102917},[],"**Message**: contenido que se va a firmar.",{"_2871":60203,"_25310":60107,"_17659":102919,"_5":17554,"_23935":102680,"_2398":102920},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2871":60204,"_25310":60107,"_17659":102922,"_5":17554,"_23935":102683,"_2398":102923},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2871":60205,"_25310":60107,"_17659":102925,"_5":17554,"_23935":102683,"_2398":102905},[],{"_2871":60206,"_25310":60107,"_17659":102927,"_5":17554,"_23935":102683,"_2398":102928},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2871":60207,"_25310":60107,"_17659":102930,"_5":17554,"_23935":102683,"_2398":102931},[],"**Message Type**: `Raw` o `Digest`.",{"_2871":60208,"_25310":60107,"_17659":102933,"_5":17554,"_23935":102683,"_2398":102934},[],"**Payload Encoding**: codificación del mensaje.",{"_2871":60209,"_25310":60107,"_17659":102936,"_5":17554,"_23935":102683,"_2398":102937},[],"**Message**: mensaje original o hash.",{"_2871":60210,"_25310":60107,"_17659":102939,"_5":17554,"_23935":102683,"_2398":102940},[],"**Signature**: firma que se desea comprobar.",{"_2871":60211,"_25310":60107,"_17659":102942,"_5":17554,"_23935":102683,"_2398":102943},[],"**Result**: indicador del resultado de la validación.",{"_2871":60212,"_25310":60107,"_17659":102945,"_5":17554,"_23935":102686,"_2398":102946},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2871":60213,"_25310":60107,"_17659":102948,"_5":17554,"_23935":102686,"_2398":102949},[],"Este flujo es útil para:",{"_2871":60214,"_25310":60107,"_17659":102951,"_5":17554,"_23935":102686,"_2398":102952},[],"Solicitar certificados a una CA externa.",{"_2871":60215,"_25310":60107,"_17659":102954,"_5":17554,"_23935":102686,"_2398":102955},[],"Renovar una identidad manteniendo la misma clave.",{"_2871":60216,"_25310":60107,"_17659":102957,"_5":17554,"_23935":102686,"_2398":102958},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2871":60217,"_25310":60107,"_17659":102960,"_5":17554,"_23935":102686,"_2398":102961},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2871":60218,"_25310":60107,"_17659":102963,"_5":17554,"_23935":102686,"_2398":102964},[],"**Organization (O)**: organización o empresa.",{"_2871":60219,"_25310":60107,"_17659":102966,"_5":17554,"_23935":102686,"_2398":102967},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2871":60220,"_25310":60107,"_17659":102969,"_5":17554,"_23935":102686,"_2398":102970},[],"**Country (C)**: código de país de dos letras.",{"_2871":60221,"_25310":60107,"_17659":102972,"_5":17554,"_23935":102686,"_2398":102973},[],"**State / Province (ST)**: estado o provincia.",{"_2871":60222,"_25310":60107,"_17659":102975,"_5":17554,"_23935":102686,"_2398":102976},[],"**Locality (L)**: ciudad o localidad.",{"_2871":60223,"_25310":60107,"_17659":102978,"_5":17554,"_23935":102686,"_2398":102979},[],"**Email Address**: correo de contacto.",{"_2871":60224,"_25310":60107,"_17659":102981,"_5":17554,"_23935":102686,"_2398":102982},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2871":60225,"_25310":60107,"_17659":102984,"_5":17554,"_23935":102686,"_2398":102985},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2871":60226,"_25310":60107,"_17659":102987,"_5":17554,"_23935":102690,"_2398":102988},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2871":60227,"_25310":60107,"_17659":102990,"_5":17554,"_23935":102690,"_2398":47811},[],{"_2871":60228,"_25310":60107,"_17659":102992,"_5":17554,"_23935":102694,"_2398":102993},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2871":60229,"_25310":60229,"_5":12413,"_2398":102995,"_25646":102996,"_17659":102997,"_23935":60229},"Validación online con OCSP",[41060,97754,46128,101944],[],{"_2871":60230,"_25310":60229,"_17659":102999,"_5":17554,"_23935":60229,"_2398":103000},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2871":60231,"_25310":60229,"_5":25643,"_17659":103002,"_23935":103003,"_2398":103004},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2871":60232,"_25310":60229,"_5":25643,"_17659":103006,"_23935":103007,"_2398":103008},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2871":60233,"_25310":60229,"_5":25643,"_17659":103010,"_23935":103011,"_2398":103012},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2871":60234,"_25310":60229,"_5":25643,"_17659":103014,"_23935":103015,"_2398":103016},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2871":60235,"_25310":60229,"_5":25643,"_17659":103018,"_23935":103019,"_2398":103020},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2871":60236,"_25310":60229,"_5":25643,"_17659":103022,"_23935":103023,"_2398":102489},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#referencias",{"_2871":60237,"_25310":60229,"_17659":103025,"_5":17554,"_23935":60229,"_2398":103026},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2871":60238,"_25310":60229,"_17659":103028,"_5":17554,"_23935":103003,"_2398":103029},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2871":60239,"_25310":60229,"_17659":103031,"_5":17554,"_23935":103003,"_2398":103032},[],"Estado del registro",{"_2871":60240,"_25310":60229,"_17659":103034,"_5":17554,"_23935":103003,"_2398":103035},[],"Respuesta firmada",{"_2871":60241,"_25310":60229,"_17659":103037,"_5":17554,"_23935":103003,"_2398":45306},[],{"_2871":60242,"_25310":60229,"_17659":103039,"_5":17554,"_23935":103003,"_2398":47861},[],{"_2871":60243,"_25310":60229,"_17659":103041,"_5":17554,"_23935":103003,"_2398":45323},[],{"_2871":60244,"_25310":60229,"_17659":103043,"_5":17554,"_23935":103003,"_2398":103044},[],"`Revoked`, con razón y fecha de revocación.",{"_2871":60245,"_25310":60229,"_17659":103046,"_5":17554,"_23935":103003,"_2398":103047},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2871":60246,"_25310":60229,"_17659":103049,"_5":17554,"_23935":103003,"_2398":103050},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2871":60247,"_25310":60229,"_17659":103052,"_5":17554,"_23935":103003,"_2398":103053},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2871":60248,"_25310":60229,"_17659":103055,"_5":17554,"_23935":103003,"_2398":103056},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2871":60249,"_25310":60229,"_17659":103058,"_5":17554,"_23935":103003,"_2398":103059},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2871":60250,"_25310":60229,"_17659":103061,"_5":17554,"_23935":103007,"_2398":103062},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2871":60251,"_25310":60229,"_17659":103064,"_5":17554,"_23935":103007,"_2398":103065},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2871":60252,"_25310":60229,"_17659":103067,"_5":17554,"_23935":103011,"_2398":103068},[],"El servicio acepta:",{"_2871":60253,"_25310":60229,"_17659":103070,"_5":17554,"_23935":103011,"_2398":99436},[],{"_2871":60254,"_25310":60229,"_17659":103072,"_5":17554,"_23935":103011,"_2398":103073},[],"Ruta del servicio VA",{"_2871":60255,"_25310":60229,"_17659":103075,"_5":17554,"_23935":103011,"_2398":103076},[],"Formato",{"_2871":60256,"_25310":60229,"_17659":103078,"_5":17554,"_23935":103011,"_2398":47901},[],{"_2871":60257,"_25310":60229,"_17659":103080,"_5":17554,"_23935":103011,"_2398":47904},[],{"_2871":60258,"_25310":60229,"_17659":103082,"_5":17554,"_23935":103011,"_2398":103083},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2871":60259,"_25310":60229,"_17659":103085,"_5":17554,"_23935":103011,"_2398":47390},[],{"_2871":60260,"_25310":60229,"_17659":103087,"_5":17554,"_23935":103011,"_2398":47912},[],{"_2871":60261,"_25310":60229,"_17659":103089,"_5":17554,"_23935":103011,"_2398":103090},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2871":60262,"_25310":60229,"_17659":103092,"_5":17554,"_23935":103011,"_2398":103093},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2871":60263,"_25310":60229,"_17659":103095,"_5":17554,"_23935":103015,"_2398":103096},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2871":60264,"_25310":60229,"_17659":103098,"_5":17554,"_23935":103015,"_2398":103099},[],"Genera la solicitud:",{"_2871":60265,"_25310":60229,"_17659":103101,"_5":17554,"_23935":103015,"_2398":103102},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2871":60266,"_25310":60229,"_17659":103104,"_5":17554,"_23935":103015,"_2398":103105},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2871":60267,"_25310":60229,"_17659":103107,"_5":17554,"_23935":103015,"_2398":103108},[],"Verifica el DER recibido:",{"_2871":60268,"_25310":60229,"_17659":103110,"_5":17554,"_23935":103015,"_2398":103111},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2871":60269,"_25310":60229,"_17659":103113,"_5":17554,"_23935":103019,"_2398":103114},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2871":60270,"_25310":60229,"_17659":103116,"_5":17554,"_23935":103019,"_2398":103117},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2871":60271,"_25310":60229,"_17659":103119,"_5":17554,"_23935":103023,"_2398":47945},[],{"_2871":60272,"_25310":60229,"_17659":103121,"_5":17554,"_23935":103023,"_2398":47948},[],{"_2871":60273,"_25310":60229,"_17659":103123,"_5":17554,"_23935":103023,"_2398":103124},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2871":60274,"_25310":60229,"_17659":103126,"_5":17554,"_23935":103023,"_2398":102616},[],{"_2871":60275,"_25310":60275,"_5":12413,"_2398":46128,"_25646":103128,"_17659":103129,"_23935":60275},[41060,97754,46128],[],{"_2871":60276,"_25310":60275,"_17659":103131,"_5":17554,"_23935":60275,"_2398":103132},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2871":60277,"_25310":60275,"_5":25643,"_17659":103134,"_23935":103135,"_2398":100653},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#empieza-aquí",{"_2871":60278,"_25310":60275,"_5":25643,"_17659":103137,"_23935":103138,"_2398":103139},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2871":60279,"_25310":60275,"_5":25643,"_17659":103141,"_23935":103142,"_2398":101175},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#capacidades-principales",{"_2871":60280,"_25310":60275,"_5":25643,"_17659":103144,"_23935":103145,"_2398":101179},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2871":60281,"_25310":60275,"_5":25643,"_17659":103147,"_23935":103148,"_2398":101183},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2871":60282,"_25310":60275,"_5":25643,"_17659":103150,"_23935":103151,"_2398":101187},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#emite-y-controla-certificados",{"_2871":60283,"_25310":60275,"_5":25643,"_17659":103153,"_23935":103154,"_2398":101195},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#publica-el-estado-de-validación",{"_2871":60284,"_25310":60275,"_5":25643,"_17659":103156,"_23935":103157,"_2398":103158},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2871":60285,"_25310":60275,"_5":25643,"_17659":103160,"_23935":103161,"_2398":102110},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#continúa",{"_2871":60286,"_25310":60275,"_17659":103163,"_5":17554,"_23935":60275,"_2398":103164},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2871":60287,"_25310":60275,"_17659":103166,"_5":17554,"_23935":103135,"_2398":103167},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2871":60288,"_25310":60275,"_17659":103169,"_5":17554,"_23935":103135,"_2398":103170},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2871":60289,"_25310":60275,"_17659":103172,"_5":17554,"_23935":103138,"_2398":103173},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2871":60290,"_25310":60275,"_17659":103175,"_5":17554,"_23935":103138,"_2398":103176},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2871":60291,"_25310":60275,"_17659":103178,"_5":17554,"_23935":103138,"_2398":103179},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2871":60292,"_25310":60275,"_17659":103181,"_5":17554,"_23935":103138,"_2398":103182},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2871":60293,"_25310":60275,"_17659":103184,"_5":17554,"_23935":103138,"_2398":103185},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2871":60294,"_25310":60275,"_17659":103187,"_5":17554,"_23935":103145,"_2398":103188},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2871":60295,"_25310":60275,"_17659":103190,"_5":17554,"_23935":103148,"_2398":103191},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2871":60296,"_25310":60275,"_17659":103193,"_5":17554,"_23935":103151,"_2398":103194},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2871":60297,"_25310":60275,"_17659":103196,"_5":17554,"_23935":103154,"_2398":103197},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2871":60298,"_25310":60275,"_17659":103199,"_5":17554,"_23935":103157,"_2398":103200},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2871":60299,"_25310":60275,"_17659":103202,"_5":17554,"_23935":103157,"_2398":103203},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2871":60300,"_25310":60275,"_17659":103205,"_5":17554,"_23935":103157,"_2398":103206},[],"su clave pública corresponda a la clave privada del cliente;",{"_2871":60301,"_25310":60275,"_17659":103208,"_5":17554,"_23935":103157,"_2398":103209},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2871":60302,"_25310":60275,"_17659":103211,"_5":17554,"_23935":103157,"_2398":103212},[],"sus fechas y usos permitan la operación;",{"_2871":60303,"_25310":60275,"_17659":103214,"_5":17554,"_23935":103157,"_2398":103215},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2871":60304,"_25310":60275,"_17659":103217,"_5":17554,"_23935":103157,"_2398":103218},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2871":60305,"_25310":60275,"_17659":103220,"_5":17554,"_23935":103161,"_2398":103221},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2871":60306,"_25310":60275,"_17659":103223,"_5":17554,"_23935":103161,"_2398":103224},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2871":60307,"_25310":60275,"_17659":103226,"_5":17554,"_23935":103161,"_2398":103227},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2871":60308,"_25310":60308,"_5":12413,"_2398":103229,"_25646":103230,"_17659":103231,"_23935":60308},"Crea tu primera CA",[41060,97754,46128,100777],[],{"_2871":60309,"_25310":60308,"_17659":103233,"_5":17554,"_23935":60308,"_2398":103234},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2871":60310,"_25310":60308,"_5":25643,"_17659":103236,"_23935":103237,"_2398":96409},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2871":60311,"_25310":60308,"_5":25643,"_17659":103239,"_23935":103240,"_2398":103241},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2871":60312,"_25310":60308,"_5":25643,"_17659":103243,"_23935":103244,"_2398":103245},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2871":60313,"_25310":60308,"_5":25643,"_17659":103247,"_23935":103248,"_2398":103249},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2871":60314,"_25310":60308,"_5":25643,"_17659":103251,"_23935":103252,"_2398":103253},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2871":60315,"_25310":60308,"_5":25643,"_17659":103255,"_23935":103256,"_2398":103257},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2871":60316,"_25310":60308,"_5":25643,"_17659":103259,"_23935":103260,"_2398":103261},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2871":60317,"_25310":60308,"_5":25643,"_17659":103263,"_23935":103264,"_2398":101025},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2871":60318,"_25310":60308,"_5":25643,"_17659":103266,"_23935":103267,"_2398":96433},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2871":60319,"_25310":60308,"_17659":103269,"_5":17554,"_23935":60308,"_2398":103270},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2871":60320,"_25310":60308,"_17659":103272,"_5":17554,"_23935":103237,"_2398":103273},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2871":60321,"_25310":60308,"_17659":103275,"_5":17554,"_23935":103237,"_2398":103276},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2871":60322,"_25310":60308,"_17659":103278,"_5":17554,"_23935":103237,"_2398":103279},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2871":60323,"_25310":60308,"_17659":103281,"_5":17554,"_23935":103237,"_2398":103282},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2871":60324,"_25310":60308,"_17659":103284,"_5":17554,"_23935":103240,"_2398":103285},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2871":60325,"_25310":60308,"_17659":103287,"_5":17554,"_23935":103240,"_2398":103288},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2871":60326,"_25310":60308,"_17659":103290,"_5":17554,"_23935":103244,"_2398":103291},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2871":60327,"_25310":60308,"_17659":103293,"_5":17554,"_23935":103244,"_2398":103294},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2871":60328,"_25310":60308,"_17659":103296,"_5":17554,"_23935":103248,"_2398":103297},[],"Selecciona **Root CA** y completa:",{"_2871":60329,"_25310":60308,"_17659":103299,"_5":17554,"_23935":103248,"_2398":48127},[],{"_2871":60330,"_25310":60308,"_17659":103301,"_5":17554,"_23935":103248,"_2398":103302},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2871":60331,"_25310":60308,"_17659":103304,"_5":17554,"_23935":103248,"_2398":103305},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2871":60332,"_25310":60308,"_17659":103307,"_5":17554,"_23935":103248,"_2398":103308},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2871":60333,"_25310":60308,"_17659":103310,"_5":17554,"_23935":103248,"_2398":103311},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2871":60334,"_25310":60308,"_17659":103313,"_5":17554,"_23935":103252,"_2398":103314},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2871":60335,"_25310":60308,"_17659":103316,"_5":17554,"_23935":103256,"_2398":103317},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2871":60336,"_25310":60308,"_17659":103319,"_5":17554,"_23935":103256,"_2398":103320},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2871":60337,"_25310":60308,"_17659":103322,"_5":17554,"_23935":103260,"_2398":103323},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2871":60338,"_25310":60308,"_17659":103325,"_5":17554,"_23935":103260,"_2398":103326},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2871":60339,"_25310":60308,"_17659":103328,"_5":17554,"_23935":103260,"_2398":103329},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2871":60340,"_25310":60308,"_17659":103331,"_5":17554,"_23935":103264,"_2398":103332},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2871":60341,"_25310":60308,"_17659":103334,"_5":17554,"_23935":103264,"_2398":103335},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2871":60342,"_25310":60308,"_17659":103337,"_5":17554,"_23935":103264,"_2398":103338},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2871":60343,"_25310":60308,"_17659":103340,"_5":17554,"_23935":103264,"_2398":103341},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2871":60344,"_25310":60308,"_17659":103343,"_5":17554,"_23935":103267,"_2398":103344},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2871":60345,"_25310":60345,"_5":12413,"_2398":103346,"_25646":103347,"_17659":103348,"_23935":60345},"Emite y verifica un certificado",[41060,97754,46128,100777],[],{"_2871":60346,"_25310":60345,"_17659":103350,"_5":17554,"_23935":60345,"_2398":103351},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2871":60347,"_25310":60345,"_5":25643,"_17659":103353,"_23935":103354,"_2398":96409},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2871":60348,"_25310":60345,"_5":25643,"_17659":103356,"_23935":103357,"_2398":103358},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2871":60349,"_25310":60345,"_5":25643,"_17659":103360,"_23935":103361,"_2398":103362},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2871":60350,"_25310":60345,"_5":25643,"_17659":103364,"_23935":103365,"_2398":103366},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2871":60351,"_25310":60345,"_5":25643,"_17659":103368,"_23935":103369,"_2398":103370},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2871":60352,"_25310":60345,"_5":25643,"_17659":103372,"_23935":103373,"_2398":103374},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2871":60353,"_25310":60345,"_5":25643,"_17659":103376,"_23935":103377,"_2398":103257},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2871":60354,"_25310":60345,"_5":25643,"_17659":103379,"_23935":103380,"_2398":103381},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2871":60355,"_25310":60345,"_5":25643,"_17659":103383,"_23935":103384,"_2398":103385},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2871":60356,"_25310":60345,"_5":25643,"_17659":103387,"_23935":103388,"_2398":103389},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2871":60357,"_25310":60345,"_5":25643,"_17659":103391,"_23935":103392,"_2398":101025},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2871":60358,"_25310":60345,"_5":25643,"_17659":103394,"_23935":103395,"_2398":96433},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2871":60359,"_25310":60345,"_17659":103397,"_5":17554,"_23935":60345,"_2398":103398},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2871":60360,"_25310":60345,"_17659":103400,"_5":17554,"_23935":103354,"_2398":103401},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2871":60361,"_25310":60345,"_17659":103403,"_5":17554,"_23935":103354,"_2398":103404},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2871":60362,"_25310":60345,"_17659":103406,"_5":17554,"_23935":103354,"_2398":103407},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2871":60363,"_25310":60345,"_17659":103409,"_5":17554,"_23935":103354,"_2398":103410},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2871":60364,"_25310":60345,"_17659":103412,"_5":17554,"_23935":103354,"_2398":103413},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2871":60365,"_25310":60345,"_17659":103415,"_5":17554,"_23935":103357,"_2398":103416},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2871":60366,"_25310":60345,"_17659":103418,"_5":17554,"_23935":103361,"_2398":103419},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2871":60367,"_25310":60345,"_17659":103421,"_5":17554,"_23935":103361,"_2398":103422},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2871":60368,"_25310":60345,"_17659":103424,"_5":17554,"_23935":103365,"_2398":103425},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2871":60369,"_25310":60345,"_17659":103427,"_5":17554,"_23935":103365,"_2398":103428},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2871":60370,"_25310":60345,"_17659":103430,"_5":17554,"_23935":103369,"_2398":103431},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2871":60371,"_25310":60345,"_17659":103433,"_5":17554,"_23935":103369,"_2398":103434},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2871":60372,"_25310":60345,"_17659":103436,"_5":17554,"_23935":103373,"_2398":103437},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2871":60373,"_25310":60345,"_17659":103439,"_5":17554,"_23935":103377,"_2398":103440},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2871":60374,"_25310":60345,"_17659":103442,"_5":17554,"_23935":103380,"_2398":103443},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2871":60375,"_25310":60345,"_17659":103445,"_5":17554,"_23935":103384,"_2398":103446},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2871":60376,"_25310":60345,"_17659":103448,"_5":17554,"_23935":103384,"_2398":103449},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2871":60377,"_25310":60345,"_17659":103451,"_5":17554,"_23935":103384,"_2398":103452},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2871":60378,"_25310":60345,"_17659":103454,"_5":17554,"_23935":103388,"_2398":103455},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2871":60379,"_25310":60345,"_17659":103457,"_5":17554,"_23935":103388,"_2398":103458},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2871":60380,"_25310":60345,"_17659":103460,"_5":17554,"_23935":103388,"_2398":103461},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2871":60381,"_25310":60345,"_17659":103463,"_5":17554,"_23935":103392,"_2398":101108},[],{"_2871":60382,"_25310":60345,"_17659":103465,"_5":17554,"_23935":103392,"_2398":99885},[],{"_2871":60383,"_25310":60345,"_17659":103467,"_5":17554,"_23935":103392,"_2398":103468},[],"La CA rechaza la emisión",{"_2871":60384,"_25310":60345,"_17659":103470,"_5":17554,"_23935":103392,"_2398":103471},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2871":60385,"_25310":60345,"_17659":103473,"_5":17554,"_23935":103392,"_2398":103474},[],"Sujeto o usos diferentes",{"_2871":60386,"_25310":60345,"_17659":103476,"_5":17554,"_23935":103392,"_2398":103477},[],"Perfil aplicado y valores solicitados.",{"_2871":60387,"_25310":60345,"_17659":103479,"_5":17554,"_23935":103392,"_2398":103480},[],"No se encuentra el emisor",{"_2871":60388,"_25310":60345,"_17659":103482,"_5":17554,"_23935":103392,"_2398":103483},[],"CA descargada y cadena intermedia necesaria.",{"_2871":60389,"_25310":60345,"_17659":103485,"_5":17554,"_23935":103392,"_2398":103486},[],"Falla la vigencia",{"_2871":60390,"_25310":60345,"_17659":103488,"_5":17554,"_23935":103392,"_2398":103489},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2871":60391,"_25310":60345,"_17659":103491,"_5":17554,"_23935":103392,"_2398":103492},[],"Los resúmenes de clave difieren",{"_2871":60392,"_25310":60345,"_17659":103494,"_5":17554,"_23935":103392,"_2398":103495},[],"Archivos de certificado y clave de la misma emisión.",{"_2871":60393,"_25310":60345,"_17659":103497,"_5":17554,"_23935":103392,"_2398":103498},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2871":60394,"_25310":60345,"_17659":103500,"_5":17554,"_23935":103395,"_2398":103501},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2871":60395,"_25310":60345,"_17659":103503,"_5":17554,"_23935":103395,"_2398":103504},[],"Gestionar certificados para inspección, estado y revocación.",{"_2871":60396,"_25310":60345,"_17659":103506,"_5":17554,"_23935":103395,"_2398":103507},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2871":60397,"_25310":60345,"_17659":103509,"_5":17554,"_23935":103395,"_2398":103510},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2871":60398,"_25310":60345,"_17659":103512,"_5":17554,"_23935":103395,"_2398":103513},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2871":60399,"_25310":60399,"_5":12413,"_2398":103515,"_25646":103516,"_17659":103517,"_23935":60399},"Primeros pasos de PKI",[41060,97754,46128,100777],[],{"_2871":60400,"_25310":60399,"_17659":103519,"_5":17554,"_23935":60399,"_2398":103520},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2871":60401,"_25310":60399,"_5":25643,"_17659":103522,"_23935":103523,"_2398":96409},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2871":60402,"_25310":60399,"_5":25643,"_17659":103525,"_23935":103526,"_2398":103527},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2871":60403,"_25310":60399,"_5":25643,"_17659":103529,"_23935":103530,"_2398":100959},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2871":60404,"_25310":60399,"_5":25643,"_17659":103532,"_23935":103533,"_2398":103534},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2871":60405,"_25310":60399,"_17659":103536,"_5":17554,"_23935":60399,"_2398":103537},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2871":60406,"_25310":60399,"_17659":103539,"_5":17554,"_23935":103523,"_2398":103540},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2871":60407,"_25310":60399,"_17659":103542,"_5":17554,"_23935":103523,"_2398":103543},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2871":60408,"_25310":60399,"_17659":103545,"_5":17554,"_23935":103523,"_2398":103546},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2871":60409,"_25310":60399,"_17659":103548,"_5":17554,"_23935":103523,"_2398":103549},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2871":60410,"_25310":60399,"_17659":103551,"_5":17554,"_23935":103523,"_2398":103552},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2871":60411,"_25310":60399,"_17659":103554,"_5":17554,"_23935":103526,"_2398":103555},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2871":60412,"_25310":60399,"_17659":103557,"_5":17554,"_23935":103526,"_2398":103558},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2871":60413,"_25310":60399,"_17659":103560,"_5":17554,"_23935":103526,"_2398":103561},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2871":60414,"_25310":60399,"_17659":103563,"_5":17554,"_23935":103526,"_2398":103564},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2871":60415,"_25310":60399,"_17659":103566,"_5":17554,"_23935":103530,"_2398":103567},[],"Archivo o recurso",{"_2871":60416,"_25310":60399,"_17659":103569,"_5":17554,"_23935":103530,"_2398":100956},[],{"_2871":60417,"_25310":60399,"_17659":103571,"_5":17554,"_23935":103530,"_2398":103572},[],"CA raíz activa y `ca.pem`",{"_2871":60418,"_25310":60399,"_17659":103574,"_5":17554,"_23935":103530,"_2398":103575},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2871":60419,"_25310":60399,"_17659":103577,"_5":17554,"_23935":103530,"_2398":103578},[],"Certificado final y `device.crt`",{"_2871":60420,"_25310":60399,"_17659":103580,"_5":17554,"_23935":103530,"_2398":103581},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2871":60421,"_25310":60399,"_17659":103583,"_5":17554,"_23935":103530,"_2398":103584},[],"Clave privada `device.key`",{"_2871":60422,"_25310":60399,"_17659":103586,"_5":17554,"_23935":103530,"_2398":103587},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2871":60423,"_25310":60399,"_17659":103589,"_5":17554,"_23935":103530,"_2398":103590},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2871":60424,"_25310":60399,"_17659":103592,"_5":17554,"_23935":103533,"_2398":103593},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2871":60425,"_25310":60399,"_17659":103595,"_5":17554,"_23935":103533,"_2398":103596},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2871":60426,"_25310":60399,"_17659":103598,"_5":17554,"_23935":103533,"_2398":103599},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2871":60427,"_25310":60427,"_5":12413,"_2398":103601,"_25646":103602,"_17659":103604,"_23935":60427},"Resolución de problemas PKI",[41060,97754,46128,103603],"Resolución de problemas",[],{"_2871":60428,"_25310":60427,"_17659":103606,"_5":17554,"_23935":60427,"_2398":103607},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2871":60429,"_25310":60427,"_5":25643,"_17659":103609,"_23935":103610,"_2398":103611},[],"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2871":60430,"_25310":60427,"_5":25643,"_17659":103613,"_23935":103614,"_2398":103615},[],"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2871":60431,"_25310":60427,"_5":25643,"_17659":103617,"_23935":103618,"_2398":103619},[],"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2871":60432,"_25310":60427,"_17659":103621,"_5":17554,"_23935":60427,"_2398":103622},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2871":60433,"_25310":60427,"_17659":103624,"_5":17554,"_23935":60427,"_2398":103625},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2871":60434,"_25310":60427,"_17659":103627,"_5":17554,"_23935":103610,"_2398":100956},[],{"_2871":60435,"_25310":60427,"_17659":103629,"_5":17554,"_23935":103610,"_2398":99885},[],{"_2871":60436,"_25310":60427,"_17659":103631,"_5":17554,"_23935":103610,"_2398":96433},[],{"_2871":60437,"_25310":60427,"_17659":103633,"_5":17554,"_23935":103610,"_2398":48463},[],{"_2871":60438,"_25310":60427,"_17659":103635,"_5":17554,"_23935":103610,"_2398":103636},[],"Existe, está activa y sus fechas son utilizables.",{"_2871":60439,"_25310":60427,"_17659":103638,"_5":17554,"_23935":103610,"_2398":103639},[],"Autoridades.",{"_2871":60440,"_25310":60427,"_17659":103641,"_5":17554,"_23935":103610,"_2398":103642},[],"Clave",{"_2871":60441,"_25310":60427,"_17659":103644,"_5":17554,"_23935":103610,"_2398":103645},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2871":60442,"_25310":60427,"_17659":103647,"_5":17554,"_23935":103610,"_2398":103648},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2871":60443,"_25310":60427,"_17659":103650,"_5":17554,"_23935":103610,"_2398":48481},[],{"_2871":60444,"_25310":60427,"_17659":103652,"_5":17554,"_23935":103610,"_2398":103653},[],"PEM correcto y firma verificable.",{"_2871":60445,"_25310":60427,"_17659":103655,"_5":17554,"_23935":103610,"_2398":48487},[],{"_2871":60446,"_25310":60427,"_17659":103657,"_5":17554,"_23935":103610,"_2398":103658},[],"Perfil",{"_2871":60447,"_25310":60427,"_17659":103660,"_5":17554,"_23935":103610,"_2398":103661},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2871":60448,"_25310":60427,"_17659":103663,"_5":17554,"_23935":103610,"_2398":103664},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2871":60449,"_25310":60427,"_17659":103666,"_5":17554,"_23935":103610,"_2398":101108},[],{"_2871":60450,"_25310":60427,"_17659":103668,"_5":17554,"_23935":103610,"_2398":103669},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2871":60451,"_25310":60427,"_17659":103671,"_5":17554,"_23935":103610,"_2398":103672},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2871":60452,"_25310":60427,"_17659":103674,"_5":17554,"_23935":103610,"_2398":103675},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2871":60453,"_25310":60427,"_17659":103677,"_5":17554,"_23935":103610,"_2398":103678},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2871":60454,"_25310":60427,"_17659":103680,"_5":17554,"_23935":103614,"_2398":103681},[],"Revisa cada frontera por separado:",{"_2871":60455,"_25310":60427,"_17659":103683,"_5":17554,"_23935":103614,"_2398":103684},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2871":60456,"_25310":60427,"_17659":103686,"_5":17554,"_23935":103614,"_2398":103687},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2871":60457,"_25310":60427,"_17659":103689,"_5":17554,"_23935":103614,"_2398":103690},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2871":60458,"_25310":60427,"_17659":103692,"_5":17554,"_23935":103614,"_2398":103693},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2871":60459,"_25310":60427,"_17659":103695,"_5":17554,"_23935":103614,"_2398":103696},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2871":60460,"_25310":60427,"_17659":103698,"_5":17554,"_23935":103614,"_2398":103699},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2871":60461,"_25310":60427,"_17659":103701,"_5":17554,"_23935":103618,"_2398":103702},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2871":60462,"_25310":60427,"_17659":103704,"_5":17554,"_23935":103618,"_2398":103705},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48541":103707,"_48543":103708,"_48545":103709,"_48547":103710,"_15271":2420,"_58078":2420},"spanish",[2398,25310,5,23935],{"_2398":21064,"_25310":21064,"_5":21064,"_23935":21064},{"_2398":103711,"_25310":106092,"_5":108473,"_23935":110854},{"_3851":103712,"_48551":103713,"_5":21064},{"_12158":7179,"_12501":4013,"_12508":10378,"_24497":2795,"_24048":5432,"_16773":7365,"_12179":9827,"_12186":2752,"_24443":6362,"_24809":15273,"_24830":10820,"_24472":6216,"_29114":9301,"_24841":6967,"_29119":5187,"_29122":2557,"_29125":6251,"_29128":5823,"_29131":8046,"_25163":9587,"_29136":2633,"_29138":19719,"_25211":2679,"_25153":22018,"_29142":13238,"_25179":4249,"_29146":3953,"_24859":5550,"_25158":5117,"_25229":6345,"_29151":4814,"_29153":4468,"_29155":6338,"_29157":9300,"_29159":4175,"_29161":6129,"_29163":9860,"_29165":18049,"_29167":12545,"_24510":3965,"_29170":8217,"_25368":9826,"_24504":14941,"_24885":4900,"_29175":5703,"_29177":6247,"_29180":5124,"_24540":3920,"_29184":9304,"_24434":6279,"_29187":4034,"_24477":3948,"_29190":4824,"_29192":4281,"_29195":4931,"_25206":8687,"_29198":11633,"_29200":4825,