0":115109,"_37292":115111,"_37294":115114,"_37296":115117,"_37298":115120,"_37300":115123,"_37303":115126,"_37305":115129,"_37307":115132,"_37309":115135,"_37311":115138,"_37313":115141,"_37315":115144,"_37317":115147,"_37319":115150,"_37321":115153,"_37323":115156,"_37325":115159,"_37327":115162,"_37329":115165,"_37331":115168,"_37333":115171,"_37335":115174,"_37337":115177,"_37339":115180,"_37341":115183,"_37343":115186,"_37345":115189,"_37347":115192,"_37349":115195,"_37351":115198,"_37353":115201,"_37355":115204,"_37357":115207,"_37359":115209,"_37361":115212,"_37363":115214,"_37365":115216,"_37367":115218,"_37369":115220,"_37371":115222,"_37373":115224,"_37375":115227,"_37377":115230,"_37380":115233,"_37382":115236,"_37384":115239,"_37386":115242,"_37388":115245,"_37390":115248,"_37392":115251,"_37394":115254,"_37396":115257,"_37398":115260,"_37400":115263,"_37402":115266,"_37404":115269,"_37406":115272,"_37408":115275,"_37410":115278,"_37412":115281,"_37414":115284,"_37416":115287,"_37418":115290,"_37420":115293,"_37422":115296,"_37424":115299,"_37426":115302,"_37428":115305,"_37430":115308,"_37432":115311,"_37434":115314,"_37436":115317,"_37438":115320,"_37440":115323,"_37443":115326,"_37445":115329,"_37447":115332,"_37450":115335,"_37452":115338,"_37454":115341,"_37456":115344,"_37458":115347,"_37460":115350,"_37462":115353,"_37464":115356,"_37466":115359,"_37468":115362,"_37470":115365,"_37472":115368,"_37474":115371,"_37476":115374,"_37478":115377,"_37480":115380,"_37482":115383,"_37485":115386,"_37487":115389,"_37489":115392,"_37491":115395,"_37493":115398,"_37495":115401,"_37497":115404,"_37499":115407,"_37501":115410,"_37503":115413,"_37505":115416,"_37507":115419,"_37509":115422,"_37511":115425,"_37513":115428,"_37515":115431,"_37517":115434,"_37519":115437,"_37521":115440,"_37523":115443,"_37525":115446,"_37528":115449,"_37530":115452,"_37532":115455},{"_3185":64635,"_28073":64635,"_5":13700,"_2682":107285,"_28416":107286,"_19451":107289,"_26530":64635},"Despliega desde AWS Marketplace",[45599,107287,107288],"Despliegue","Otros modelos",[],{"_3185":64636,"_28073":64635,"_19451":107291,"_5":13353,"_26530":64635,"_2682":107292},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3185":64637,"_28073":64635,"_5":28413,"_19451":107294,"_26530":107295,"_2682":107296},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3185":64638,"_28073":64635,"_5":28413,"_19451":107298,"_26530":107299,"_2682":107300},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3185":64639,"_28073":64635,"_5":28413,"_19451":107302,"_26530":107303,"_2682":107304},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3185":64640,"_28073":64635,"_5":28413,"_19451":107306,"_26530":107307,"_2682":107308},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3185":64641,"_28073":64635,"_5":28413,"_19451":107310,"_26530":107311,"_2682":107312},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3185":64642,"_28073":64635,"_5":28413,"_19451":107314,"_26530":107315,"_2682":107316},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3185":64643,"_28073":64635,"_5":28413,"_19451":107318,"_26530":107319,"_2682":107320},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3185":64644,"_28073":64635,"_19451":107322,"_5":13353,"_26530":64635,"_2682":107323},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3185":64645,"_28073":64635,"_19451":107325,"_5":13353,"_26530":107295,"_2682":107326},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3185":64646,"_28073":64635,"_19451":107328,"_5":13353,"_26530":107295,"_2682":107329},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3185":64647,"_28073":64635,"_19451":107331,"_5":13353,"_26530":107295,"_2682":107332},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3185":64648,"_28073":64635,"_19451":107334,"_5":13353,"_26530":107299,"_2682":107335},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3185":64649,"_28073":64635,"_19451":107337,"_5":13353,"_26530":107299,"_2682":107338},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3185":64650,"_28073":64635,"_19451":107340,"_5":13353,"_26530":107299,"_2682":107341},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3185":64651,"_28073":64635,"_19451":107343,"_5":13353,"_26530":107303,"_2682":107344},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3185":64652,"_28073":64635,"_19451":107346,"_5":13353,"_26530":107307,"_2682":107347},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3185":64653,"_28073":64635,"_19451":107349,"_5":13353,"_26530":107311,"_2682":107350},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3185":64654,"_28073":64635,"_19451":107352,"_5":13353,"_26530":107315,"_2682":107353},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3185":64655,"_28073":64635,"_19451":107355,"_5":13353,"_26530":107319,"_2682":107356},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3185":64656,"_28073":64656,"_5":13700,"_2682":107358,"_28416":107359,"_19451":107360,"_26530":64656},"Despliega Lamassu",[45599,107287],[],{"_3185":64657,"_28073":64656,"_19451":107362,"_5":13353,"_26530":64656,"_2682":107363},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3185":64658,"_28073":64656,"_5":28413,"_19451":107365,"_26530":107366,"_2682":107367},[],"/docs/pr-preview/pr-42/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3185":64659,"_28073":64656,"_5":28413,"_19451":107369,"_26530":107370,"_2682":107371},[],"/docs/pr-preview/pr-42/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3185":64660,"_28073":64656,"_5":28413,"_19451":107373,"_26530":107374,"_2682":107375},[],"/docs/pr-preview/pr-42/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3185":64661,"_28073":64656,"_19451":107377,"_5":13353,"_26530":64656,"_2682":107378},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3185":64662,"_28073":64656,"_19451":107380,"_5":13353,"_26530":107366,"_2682":107381},[],"Modelo",{"_3185":64663,"_28073":64656,"_19451":107383,"_5":13353,"_26530":107366,"_2682":107384},[],"Recomendado para",{"_3185":64664,"_28073":64656,"_19451":107386,"_5":13353,"_26530":107366,"_2682":107387},[],"Quién opera la infraestructura",{"_3185":64665,"_28073":64656,"_19451":107389,"_5":13353,"_26530":107366,"_2682":107390},[],"Punto de partida",{"_3185":64666,"_28073":64656,"_19451":107392,"_5":13353,"_26530":107366,"_2682":45706},[],{"_3185":64667,"_28073":64656,"_19451":107394,"_5":13353,"_26530":107366,"_2682":107395},[],"Producción, entornos regulados y despliegues personalizados",{"_3185":64668,"_28073":64656,"_19451":107397,"_5":13353,"_26530":107366,"_2682":107398},[],"Tu equipo",{"_3185":64669,"_28073":64656,"_19451":107400,"_5":13353,"_26530":107366,"_2682":107401},[],"Helm o Fastlane",{"_3185":64670,"_28073":64656,"_19451":107403,"_5":13353,"_26530":107366,"_2682":45718},[],{"_3185":64671,"_28073":64656,"_19451":107405,"_5":13353,"_26530":107366,"_2682":107406},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3185":64672,"_28073":64656,"_19451":107408,"_5":13353,"_26530":107366,"_2682":107398},[],{"_3185":64673,"_28073":64656,"_19451":107410,"_5":13353,"_26530":107366,"_2682":107411},[],"Imagen preconfigurada en EC2",{"_3185":64674,"_28073":64656,"_19451":107413,"_5":13353,"_26530":107366,"_2682":45729},[],{"_3185":64675,"_28073":64656,"_19451":107415,"_5":13353,"_26530":107366,"_2682":107416},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3185":64676,"_28073":64656,"_19451":107418,"_5":13353,"_26530":107366,"_2682":45735},[],{"_3185":64677,"_28073":64656,"_19451":107420,"_5":13353,"_26530":107366,"_2682":107421},[],"Suscripción gestionada",{"_3185":64678,"_28073":64656,"_19451":107423,"_5":13353,"_26530":107366,"_2682":107424},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3185":64679,"_28073":64656,"_19451":107426,"_5":13353,"_26530":107366,"_2682":107427},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3185":64680,"_28073":64656,"_19451":107429,"_5":13353,"_26530":107366,"_2682":107430},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3185":64681,"_28073":64656,"_19451":107432,"_5":13353,"_26530":107370,"_2682":107433},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3185":64682,"_28073":64656,"_19451":107435,"_5":13353,"_26530":107374,"_2682":107436},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3185":64683,"_28073":64683,"_5":13700,"_2682":107438,"_28416":107439,"_19451":107440,"_26530":64683},"Utiliza Lamassu como SaaS",[45599,107287,107288],[],{"_3185":64684,"_28073":64683,"_19451":107442,"_5":13353,"_26530":64683,"_2682":107443},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3185":64685,"_28073":64683,"_5":28413,"_19451":107445,"_26530":107446,"_2682":107447},[],"/docs/pr-preview/pr-42/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3185":64686,"_28073":64683,"_5":28413,"_19451":107449,"_26530":107450,"_2682":107451},[],"/docs/pr-preview/pr-42/es/deployment/saas#planes","Planes",{"_3185":64687,"_28073":64683,"_5":28413,"_19451":107453,"_26530":107454,"_2682":107455},[],"/docs/pr-preview/pr-42/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3185":64688,"_28073":64683,"_19451":107457,"_5":13353,"_26530":64683,"_2682":107458},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3185":64689,"_28073":64683,"_19451":107460,"_5":13353,"_26530":107446,"_2682":107461},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3185":64690,"_28073":64683,"_19451":107463,"_5":13353,"_26530":107446,"_2682":107464},[],"Copias de seguridad automáticas.",{"_3185":64691,"_28073":64683,"_19451":107466,"_5":13353,"_26530":107446,"_2682":107467},[],"Actualizaciones de versión.",{"_3185":64692,"_28073":64683,"_19451":107469,"_5":13353,"_26530":107446,"_2682":107470},[],"Soporte técnico y SLA según el plan contratado.",{"_3185":64693,"_28073":64683,"_19451":107472,"_5":13353,"_26530":107450,"_2682":45790},[],{"_3185":64694,"_28073":64683,"_19451":107474,"_5":13353,"_26530":107450,"_2682":107475},[],"Dispositivos",{"_3185":64695,"_28073":64683,"_19451":107477,"_5":13353,"_26530":107450,"_2682":107478},[],"Soporte",{"_3185":64696,"_28073":64683,"_19451":107480,"_5":13353,"_26530":107450,"_2682":45799},[],{"_3185":64697,"_28073":64683,"_19451":107482,"_5":13353,"_26530":107450,"_2682":45802},[],{"_3185":64698,"_28073":64683,"_19451":107484,"_5":13353,"_26530":107450,"_2682":107485},[],"Hasta 1.000",{"_3185":64699,"_28073":64683,"_19451":107487,"_5":13353,"_26530":107450,"_2682":45808},[],{"_3185":64700,"_28073":64683,"_19451":107489,"_5":13353,"_26530":107450,"_2682":107490},[],"99,5 %",{"_3185":64701,"_28073":64683,"_19451":107492,"_5":13353,"_26530":107450,"_2682":45814},[],{"_3185":64702,"_28073":64683,"_19451":107494,"_5":13353,"_26530":107450,"_2682":107495},[],"Hasta 10.000",{"_3185":64703,"_28073":64683,"_19451":107497,"_5":13353,"_26530":107450,"_2682":107498},[],"Email y chat",{"_3185":64704,"_28073":64683,"_19451":107500,"_5":13353,"_26530":107450,"_2682":107501},[],"99,9 %",{"_3185":64705,"_28073":64683,"_19451":107503,"_5":13353,"_26530":107450,"_2682":45826},[],{"_3185":64706,"_28073":64683,"_19451":107505,"_5":13353,"_26530":107450,"_2682":107506},[],"Ilimitados",{"_3185":64707,"_28073":64683,"_19451":107508,"_5":13353,"_26530":107450,"_2682":107509},[],"Dedicado",{"_3185":64708,"_28073":64683,"_19451":107511,"_5":13353,"_26530":107450,"_2682":107512},[],"99,99 %",{"_3185":64709,"_28073":64683,"_19451":107514,"_5":13353,"_26530":107454,"_2682":107515},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3185":64710,"_28073":64683,"_19451":107517,"_5":13353,"_26530":107454,"_2682":107518},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3185":64711,"_28073":64711,"_5":13700,"_2682":45843,"_28416":107520,"_19451":107522,"_26530":64711},[45599,107287,107521],"Kubernetes autogestionado",[],{"_3185":64712,"_28073":64711,"_19451":107524,"_5":13353,"_26530":64711,"_2682":107525},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3185":64713,"_28073":64711,"_5":28413,"_19451":107527,"_26530":107528,"_2682":107529},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3185":64714,"_28073":64711,"_5":28413,"_19451":107531,"_26530":107532,"_2682":107533},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3185":64715,"_28073":64711,"_5":28413,"_19451":107535,"_26530":107536,"_2682":107537},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3185":64716,"_28073":64711,"_5":28413,"_19451":107539,"_26530":107540,"_2682":107541},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3185":64717,"_28073":64711,"_5":28413,"_19451":107543,"_26530":107544,"_2682":107545},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3185":64718,"_28073":64711,"_5":28413,"_19451":107547,"_26530":107548,"_2682":107549},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3185":64719,"_28073":64711,"_5":28413,"_19451":107551,"_26530":107552,"_2682":107553},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3185":64720,"_28073":64711,"_5":28413,"_19451":107555,"_26530":107556,"_2682":107557},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3185":64721,"_28073":64711,"_5":28413,"_19451":107559,"_26530":107560,"_2682":107561},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3185":64722,"_28073":64711,"_5":28413,"_19451":107563,"_26530":107564,"_2682":107565},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3185":64723,"_28073":64711,"_5":28413,"_19451":107567,"_26530":107568,"_2682":107569},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3185":64724,"_28073":64711,"_19451":107571,"_5":13353,"_26530":107528,"_2682":107572},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3185":64725,"_28073":64711,"_19451":107574,"_5":13353,"_26530":107528,"_2682":107575},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3185":64726,"_28073":64711,"_19451":107577,"_5":13353,"_26530":107532,"_2682":107578},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3185":64727,"_28073":64711,"_19451":107580,"_5":13353,"_26530":107532,"_2682":107581},[],"Fastlane instala o configura",{"_3185":64728,"_28073":64711,"_19451":107583,"_5":13353,"_26530":107532,"_2682":107584},[],"Tú sigues proporcionando",{"_3185":64729,"_28073":64711,"_19451":107586,"_5":13353,"_26530":107532,"_2682":107587},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3185":64730,"_28073":64711,"_19451":107589,"_5":13353,"_26530":107532,"_2682":107590},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3185":64731,"_28073":64711,"_19451":107592,"_5":13353,"_26530":107532,"_2682":107593},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3185":64732,"_28073":64711,"_19451":107595,"_5":13353,"_26530":107532,"_2682":107596},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3185":64733,"_28073":64711,"_19451":107598,"_5":13353,"_26530":107532,"_2682":107599},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3185":64734,"_28073":64711,"_19451":107601,"_5":13353,"_26530":107532,"_2682":107602},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3185":64735,"_28073":64711,"_19451":107604,"_5":13353,"_26530":107532,"_2682":107605},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3185":64736,"_28073":64711,"_19451":107607,"_5":13353,"_26530":107532,"_2682":107608},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3185":64737,"_28073":64711,"_19451":107610,"_5":13353,"_26530":107532,"_2682":107611},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3185":64738,"_28073":64711,"_19451":107613,"_5":13353,"_26530":107536,"_2682":107614},[],"Necesitas:",{"_3185":64739,"_28073":64711,"_19451":107616,"_5":13353,"_26530":107536,"_2682":107617},[],"un clúster Kubernetes existente",{"_3185":64740,"_28073":64711,"_19451":107619,"_5":13353,"_26530":107536,"_2682":107620},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3185":64741,"_28073":64711,"_19451":107622,"_5":13353,"_26530":107536,"_2682":45945},[],{"_3185":64742,"_28073":64711,"_19451":107624,"_5":13353,"_26530":107536,"_2682":22022},[],{"_3185":64743,"_28073":64711,"_19451":107626,"_5":13353,"_26530":107536,"_2682":107627},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3185":64744,"_28073":64711,"_19451":107629,"_5":13353,"_26530":107536,"_2682":107630},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3185":64745,"_28073":64711,"_19451":107632,"_5":13353,"_26530":107536,"_2682":107633},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3185":64746,"_28073":64711,"_19451":107635,"_5":13353,"_26530":107536,"_2682":107636},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3185":64747,"_28073":64711,"_19451":107638,"_5":13353,"_26530":107536,"_2682":107639},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3185":64748,"_28073":64711,"_19451":107641,"_5":13353,"_26530":107540,"_2682":107642},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3185":64749,"_28073":64711,"_19451":107644,"_5":13353,"_26530":107540,"_2682":107645},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3185":64750,"_28073":64711,"_19451":107647,"_5":13353,"_26530":107544,"_2682":107648},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3185":64751,"_28073":64711,"_19451":107650,"_5":13353,"_26530":107544,"_2682":107651},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3185":64752,"_28073":64711,"_19451":107653,"_5":13353,"_26530":107544,"_2682":107654},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3185":64753,"_28073":64711,"_19451":107656,"_5":13353,"_26530":107544,"_2682":107657},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3185":64754,"_28073":64711,"_19451":107659,"_5":13353,"_26530":107548,"_2682":107660},[],"Opción",{"_3185":64755,"_28073":64711,"_19451":107662,"_5":13353,"_26530":107548,"_2682":107663},[],"Valor predeterminado",{"_3185":64756,"_28073":64711,"_19451":107665,"_5":13353,"_26530":107548,"_2682":107666},[],"Propósito",{"_3185":64757,"_28073":64711,"_19451":107668,"_5":13353,"_26530":107548,"_2682":45992},[],{"_3185":64758,"_28073":64711,"_19451":107670,"_5":13353,"_26530":107548,"_2682":45995},[],{"_3185":64759,"_28073":64711,"_19451":107672,"_5":13353,"_26530":107548,"_2682":107673},[],"Muestra la ayuda",{"_3185":64760,"_28073":64711,"_19451":107675,"_5":13353,"_26530":107548,"_2682":46001},[],{"_3185":64761,"_28073":64711,"_19451":107677,"_5":13353,"_26530":107548,"_2682":107678},[],"contexto actual",{"_3185":64762,"_28073":64711,"_19451":107680,"_5":13353,"_26530":107548,"_2682":107681},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3185":64763,"_28073":64711,"_19451":107683,"_5":13353,"_26530":107548,"_2682":46010},[],{"_3185":64764,"_28073":64711,"_19451":107685,"_5":13353,"_26530":107548,"_2682":5971},[],{"_3185":64765,"_28073":64711,"_19451":107687,"_5":13353,"_26530":107548,"_2682":107688},[],"Omite prompts y genera credenciales para las dependencias",{"_3185":64766,"_28073":64711,"_19451":107690,"_5":13353,"_26530":107548,"_2682":46018},[],{"_3185":64767,"_28073":64711,"_19451":107692,"_5":13353,"_26530":107548,"_2682":46021},[],{"_3185":64768,"_28073":64711,"_19451":107694,"_5":13353,"_26530":107548,"_2682":107695},[],"Namespace de la instalación",{"_3185":64769,"_28073":64711,"_19451":107697,"_5":13353,"_26530":107548,"_2682":46027},[],{"_3185":64770,"_28073":64711,"_19451":107699,"_5":13353,"_26530":107548,"_2682":46030},[],{"_3185":64771,"_28073":64711,"_19451":107701,"_5":13353,"_26530":107548,"_2682":107702},[],"Dominio usado por la UI, OIDC y el certificado",{"_3185":64772,"_28073":64711,"_19451":107704,"_5":13353,"_26530":107548,"_2682":46036},[],{"_3185":64773,"_28073":64711,"_19451":107706,"_5":13353,"_26530":107548,"_2682":14000},[],{"_3185":64774,"_28073":64711,"_19451":107708,"_5":13353,"_26530":107548,"_2682":107709},[],"Versión del chart de Lamassu",{"_3185":64775,"_28073":64711,"_19451":107711,"_5":13353,"_26530":107548,"_2682":46044},[],{"_3185":64776,"_28073":64711,"_19451":107713,"_5":13353,"_26530":107548,"_2682":46047},[],{"_3185":64777,"_28073":64711,"_19451":107715,"_5":13353,"_26530":107548,"_2682":107716},[],"Puerto del listener HTTPS",{"_3185":64778,"_28073":64711,"_19451":107718,"_5":13353,"_26530":107548,"_2682":46053},[],{"_3185":64779,"_28073":64711,"_19451":107720,"_5":13353,"_26530":107548,"_2682":46056},[],{"_3185":64780,"_28073":64711,"_19451":107722,"_5":13353,"_26530":107548,"_2682":107723},[],"Puerto del listener HTTP",{"_3185":64781,"_28073":64711,"_19451":107725,"_5":13353,"_26530":107548,"_2682":46062},[],{"_3185":64782,"_28073":64711,"_19451":107727,"_5":13353,"_26530":107548,"_2682":45995},[],{"_3185":64783,"_28073":64711,"_19451":107729,"_5":13353,"_26530":107548,"_2682":107730},[],"Certificado PEM para TLS downstream",{"_3185":64784,"_28073":64711,"_19451":107732,"_5":13353,"_26530":107548,"_2682":46070},[],{"_3185":64785,"_28073":64711,"_19451":107734,"_5":13353,"_26530":107548,"_2682":45995},[],{"_3185":64786,"_28073":64711,"_19451":107736,"_5":13353,"_26530":107548,"_2682":107737},[],"Clave privada PEM para TLS downstream",{"_3185":64787,"_28073":64711,"_19451":107739,"_5":13353,"_26530":107548,"_2682":46078},[],{"_3185":64788,"_28073":64711,"_19451":107741,"_5":13353,"_26530":107548,"_2682":107742},[],"chart del repositorio",{"_3185":64789,"_28073":64711,"_19451":107744,"_5":13353,"_26530":107548,"_2682":107745},[],"Usa un chart local de Lamassu sin empaquetar",{"_3185":64790,"_28073":64711,"_19451":107747,"_5":13353,"_26530":107548,"_2682":46087},[],{"_3185":64791,"_28073":64711,"_19451":107749,"_5":13353,"_26530":107548,"_2682":107750},[],"detección automática",{"_3185":64792,"_28073":64711,"_19451":107752,"_5":13353,"_26530":107548,"_2682":107753},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3185":64793,"_28073":64711,"_19451":107755,"_5":13353,"_26530":107548,"_2682":46095},[],{"_3185":64794,"_28073":64711,"_19451":107757,"_5":13353,"_26530":107548,"_2682":5971},[],{"_3185":64795,"_28073":64711,"_19451":107759,"_5":13353,"_26530":107548,"_2682":107760},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3185":64796,"_28073":64711,"_19451":107762,"_5":13353,"_26530":107548,"_2682":46103},[],{"_3185":64797,"_28073":64711,"_19451":107764,"_5":13353,"_26530":107548,"_2682":5971},[],{"_3185":64798,"_28073":64711,"_19451":107766,"_5":13353,"_26530":107548,"_2682":107767},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3185":64799,"_28073":64711,"_19451":107769,"_5":13353,"_26530":107548,"_2682":46111},[],{"_3185":64800,"_28073":64711,"_19451":107771,"_5":13353,"_26530":107548,"_2682":5971},[],{"_3185":64801,"_28073":64711,"_19451":107773,"_5":13353,"_26530":107548,"_2682":107774},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3185":64802,"_28073":64711,"_19451":107776,"_5":13353,"_26530":107548,"_2682":46119},[],{"_3185":64803,"_28073":64711,"_19451":107778,"_5":13353,"_26530":107548,"_2682":5971},[],{"_3185":64804,"_28073":64711,"_19451":107780,"_5":13353,"_26530":107548,"_2682":107781},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3185":64805,"_28073":64711,"_19451":107783,"_5":13353,"_26530":107548,"_2682":46127},[],{"_3185":64806,"_28073":64711,"_19451":107785,"_5":13353,"_26530":107548,"_2682":46130},[],{"_3185":64807,"_28073":64711,"_19451":107787,"_5":13353,"_26530":107548,"_2682":107788},[],"Usa otro chart local de SoftHSM",{"_3185":64808,"_28073":64711,"_19451":107790,"_5":13353,"_26530":107548,"_2682":107791},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3185":64809,"_28073":64711,"_19451":107793,"_5":13353,"_26530":107552,"_2682":107794},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3185":64810,"_28073":64711,"_19451":107796,"_5":13353,"_26530":107552,"_2682":107797},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3185":64811,"_28073":64711,"_19451":107799,"_5":13353,"_26530":107552,"_2682":107800},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3185":64812,"_28073":64711,"_19451":107802,"_5":13353,"_26530":107552,"_2682":107803},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3185":64813,"_28073":64711,"_19451":107805,"_5":13353,"_26530":107552,"_2682":107806},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3185":64814,"_28073":64711,"_19451":107808,"_5":13353,"_26530":107552,"_2682":107809},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3185":64815,"_28073":64711,"_19451":107811,"_5":13353,"_26530":107556,"_2682":46157},[],{"_3185":64816,"_28073":64711,"_19451":107813,"_5":13353,"_26530":107556,"_2682":107814},[],"valida las herramientas locales y el clúster seleccionado",{"_3185":64817,"_28073":64711,"_19451":107816,"_5":13353,"_26530":107556,"_2682":107817},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3185":64818,"_28073":64711,"_19451":107819,"_5":13353,"_26530":107556,"_2682":107820},[],"crea el namespace",{"_3185":64819,"_28073":64711,"_19451":107822,"_5":13353,"_26530":107556,"_2682":107823},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3185":64820,"_28073":64711,"_19451":107825,"_5":13353,"_26530":107556,"_2682":107826},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3185":64821,"_28073":64711,"_19451":107828,"_5":13353,"_26530":107556,"_2682":107829},[],"instala RabbitMQ",{"_3185":64822,"_28073":64711,"_19451":107831,"_5":13353,"_26530":107556,"_2682":107832},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3185":64823,"_28073":64711,"_19451":107834,"_5":13353,"_26530":107556,"_2682":107835},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3185":64824,"_28073":64711,"_19451":107837,"_5":13353,"_26530":107556,"_2682":107838},[],"carga datos de ejemplo opcionalmente",{"_3185":64825,"_28073":64711,"_19451":107840,"_5":13353,"_26530":107556,"_2682":107841},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3185":64826,"_28073":64711,"_19451":107843,"_5":13353,"_26530":107560,"_2682":107844},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3185":64827,"_28073":64711,"_19451":107846,"_5":13353,"_26530":107560,"_2682":107847},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3185":64828,"_28073":64711,"_19451":107849,"_5":13353,"_26530":107564,"_2682":107850},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3185":64829,"_28073":64711,"_19451":107852,"_5":13353,"_26530":107564,"_2682":107853},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3185":64830,"_28073":64711,"_19451":107855,"_5":13353,"_26530":107564,"_2682":107856},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3185":64831,"_28073":64711,"_19451":107858,"_5":13353,"_26530":107568,"_2682":107859},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3185":64832,"_28073":64832,"_5":13700,"_2682":107861,"_28416":107862,"_19451":107863,"_26530":64832},"Instala con Helm",[45599,107287,107521],[],{"_3185":64833,"_28073":64832,"_19451":107865,"_5":13353,"_26530":64832,"_2682":107866},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3185":64834,"_28073":64832,"_5":28413,"_19451":107868,"_26530":107869,"_2682":107870},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3185":64835,"_28073":64832,"_5":28413,"_19451":107872,"_26530":107873,"_2682":107537},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3185":64836,"_28073":64832,"_5":28413,"_19451":107875,"_26530":107876,"_2682":107877},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3185":64837,"_28073":64832,"_5":28413,"_19451":107879,"_26530":107880,"_2682":107881},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3185":64838,"_28073":64832,"_5":28413,"_19451":107883,"_26530":107884,"_2682":107885},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3185":64839,"_28073":64832,"_5":28413,"_19451":107887,"_26530":107888,"_2682":107889},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3185":64840,"_28073":64832,"_5":28413,"_19451":107891,"_26530":107892,"_2682":107893},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3185":64841,"_28073":64832,"_5":28413,"_19451":107895,"_26530":107896,"_2682":107897},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3185":64842,"_28073":64832,"_5":28413,"_19451":107899,"_26530":107900,"_2682":107901},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3185":64843,"_28073":64832,"_5":28413,"_19451":107903,"_26530":107904,"_2682":107905},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3185":64844,"_28073":64832,"_19451":107907,"_5":13353,"_26530":107869,"_2682":107908},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3185":64845,"_28073":64832,"_19451":107910,"_5":13353,"_26530":107873,"_2682":107911},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3185":64846,"_28073":64832,"_19451":107913,"_5":13353,"_26530":107873,"_2682":107914},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3185":64847,"_28073":64832,"_19451":107916,"_5":13353,"_26530":107873,"_2682":107917},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3185":64848,"_28073":64832,"_19451":107919,"_5":13353,"_26530":107873,"_2682":107920},[],"un broker RabbitMQ accesible y sus credenciales",{"_3185":64849,"_28073":64832,"_19451":107922,"_5":13353,"_26530":107873,"_2682":107923},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3185":64850,"_28073":64832,"_19451":107925,"_5":13353,"_26530":107873,"_2682":107926},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3185":64851,"_28073":64832,"_19451":107928,"_5":13353,"_26530":107873,"_2682":107929},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3185":64852,"_28073":64832,"_19451":107931,"_5":13353,"_26530":107873,"_2682":107932},[],"una StorageClass y un diseño de tráfico externo",{"_3185":64853,"_28073":64832,"_19451":107934,"_5":13353,"_26530":107873,"_2682":107935},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3185":64854,"_28073":64832,"_19451":107937,"_5":13353,"_26530":107873,"_2682":107938},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3185":64855,"_28073":64832,"_19451":107940,"_5":13353,"_26530":107873,"_2682":107941},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3185":64856,"_28073":64832,"_19451":107943,"_5":13353,"_26530":107876,"_2682":107944},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3185":64857,"_28073":64832,"_19451":107946,"_5":13353,"_26530":107876,"_2682":107947},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3185":64858,"_28073":64832,"_19451":107949,"_5":13353,"_26530":107876,"_2682":107950},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3185":64859,"_28073":64832,"_19451":107952,"_5":13353,"_26530":107880,"_2682":107953},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3185":64860,"_28073":64832,"_19451":107955,"_5":13353,"_26530":107880,"_2682":107956},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3185":64861,"_28073":64832,"_19451":107958,"_5":13353,"_26530":107880,"_2682":107959},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3185":64862,"_28073":64832,"_19451":107961,"_5":13353,"_26530":107880,"_2682":107962},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3185":64863,"_28073":64832,"_19451":107964,"_5":13353,"_26530":107884,"_2682":107965},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3185":64864,"_28073":64832,"_19451":107967,"_5":13353,"_26530":107888,"_2682":107968},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del event bus. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3185":64865,"_28073":64832,"_19451":107970,"_5":13353,"_26530":107888,"_2682":107971},[],"Sin un Secret de CA configurado, los clientes del event bus usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3185":64866,"_28073":64832,"_19451":107973,"_5":13353,"_26530":107888,"_2682":107974},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3185":64867,"_28073":64832,"_19451":107976,"_5":13353,"_26530":107888,"_2682":107977},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3185":64868,"_28073":64832,"_19451":107979,"_5":13353,"_26530":107888,"_2682":107980},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3185":64869,"_28073":64832,"_19451":107982,"_5":13353,"_26530":107888,"_2682":107983},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3185":64870,"_28073":64832,"_19451":107985,"_5":13353,"_26530":107888,"_2682":107986},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del event bus usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro.",{"_3185":64871,"_28073":64832,"_19451":107988,"_5":13353,"_26530":107892,"_2682":107989},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3185":64872,"_28073":64832,"_19451":107991,"_5":13353,"_26530":107892,"_2682":107992},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3185":64873,"_28073":64832,"_19451":107994,"_5":13353,"_26530":107892,"_2682":107995},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3185":64874,"_28073":64832,"_19451":107997,"_5":13353,"_26530":107892,"_2682":107998},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3185":64875,"_28073":64832,"_19451":108000,"_5":13353,"_26530":107896,"_2682":108001},[],"Para instalar un checkout local:",{"_3185":64876,"_28073":64832,"_19451":108003,"_5":13353,"_26530":107900,"_2682":108004},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3185":64877,"_28073":64832,"_19451":108006,"_5":13353,"_26530":107900,"_2682":108007},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3185":64878,"_28073":64832,"_19451":108009,"_5":13353,"_26530":107904,"_2682":108010},[],"Antes de pasar a producción, revisa:",{"_3185":64879,"_28073":64832,"_19451":108012,"_5":13353,"_26530":107904,"_2682":108013},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3185":64880,"_28073":64832,"_19451":108015,"_5":13353,"_26530":107904,"_2682":108016},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3185":64881,"_28073":64832,"_19451":108018,"_5":13353,"_26530":107904,"_2682":108019},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3185":64882,"_28073":64832,"_19451":108021,"_5":13353,"_26530":107904,"_2682":108022},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3185":64883,"_28073":64832,"_19451":108024,"_5":13353,"_26530":107904,"_2682":108025},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3185":64884,"_28073":64832,"_19451":108027,"_5":13353,"_26530":107904,"_2682":108028},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3185":64885,"_28073":64832,"_19451":108030,"_5":13353,"_26530":107904,"_2682":108031},[],"SMTP, observabilidad y entrega de alertas",{"_3185":64886,"_28073":64832,"_19451":108033,"_5":13353,"_26530":107904,"_2682":108034},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3185":64887,"_28073":64832,"_19451":108036,"_5":13353,"_26530":107904,"_2682":108037},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3185":64888,"_28073":64888,"_5":13700,"_2682":108039,"_28416":108040,"_19451":108041,"_26530":64888},"Expón el Gateway",[45599,107287,107521],[],{"_3185":64889,"_28073":64888,"_19451":108043,"_5":13353,"_26530":64888,"_2682":108044},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3185":64890,"_28073":64888,"_5":28413,"_19451":108046,"_26530":108047,"_2682":108048},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3185":64891,"_28073":64888,"_5":28413,"_19451":108050,"_26530":108051,"_2682":108052},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3185":64892,"_28073":64888,"_5":28413,"_19451":108054,"_26530":108055,"_2682":108056},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3185":64893,"_28073":64888,"_5":28413,"_19451":108058,"_26530":108059,"_2682":46406},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#k3s",{"_3185":64894,"_28073":64888,"_5":28413,"_19451":108061,"_26530":108062,"_2682":108063},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3185":64895,"_28073":64888,"_5":28413,"_19451":108065,"_26530":108066,"_2682":108067},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3185":64896,"_28073":64888,"_5":28413,"_19451":108069,"_26530":108070,"_2682":108071},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3185":64897,"_28073":64888,"_5":28413,"_19451":108073,"_26530":108074,"_2682":108075},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3185":64898,"_28073":64888,"_5":28413,"_19451":108077,"_26530":108078,"_2682":108079},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3185":64899,"_28073":64888,"_19451":108081,"_5":13353,"_26530":108047,"_2682":108082},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3185":64900,"_28073":64888,"_19451":108084,"_5":13353,"_26530":108047,"_2682":108085},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3185":64901,"_28073":64888,"_19451":108087,"_5":13353,"_26530":108051,"_2682":108088},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3185":64902,"_28073":64888,"_19451":108090,"_5":13353,"_26530":108051,"_2682":108091},[],"Defínelo únicamente cuando:",{"_3185":64903,"_28073":64888,"_19451":108093,"_5":13353,"_26530":108051,"_2682":108094},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3185":64904,"_28073":64888,"_19451":108096,"_5":13353,"_26530":108051,"_2682":108097},[],"esa dirección está asignada a este Gateway",{"_3185":64905,"_28073":64888,"_19451":108099,"_5":13353,"_26530":108051,"_2682":108100},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3185":64906,"_28073":64888,"_19451":108102,"_5":13353,"_26530":108051,"_2682":108103},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3185":64907,"_28073":64888,"_19451":108105,"_5":13353,"_26530":108051,"_2682":108106},[],"No confundas estos valores:",{"_3185":64908,"_28073":64888,"_19451":108108,"_5":13353,"_26530":108051,"_2682":108109},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3185":64909,"_28073":64888,"_19451":108111,"_5":13353,"_26530":108051,"_2682":108112},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3185":64910,"_28073":64888,"_19451":108114,"_5":13353,"_26530":108051,"_2682":108115},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3185":64911,"_28073":64888,"_19451":108117,"_5":13353,"_26530":108055,"_2682":108118},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3185":64912,"_28073":64888,"_19451":108120,"_5":13353,"_26530":108055,"_2682":108121},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3185":64913,"_28073":64888,"_19451":108123,"_5":13353,"_26530":108059,"_2682":108124},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3185":64914,"_28073":64888,"_19451":108126,"_5":13353,"_26530":108059,"_2682":108127},[],"Para el diseño recomendado:",{"_3185":64915,"_28073":64888,"_19451":108129,"_5":13353,"_26530":108059,"_2682":108130},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3185":64916,"_28073":64888,"_19451":108132,"_5":13353,"_26530":108059,"_2682":108133},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3185":64917,"_28073":64888,"_19451":108135,"_5":13353,"_26530":108059,"_2682":108136},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3185":64918,"_28073":64888,"_19451":108138,"_5":13353,"_26530":108059,"_2682":108139},[],"Apunta DNS a la dirección accesible de la VM.",{"_3185":64919,"_28073":64888,"_19451":108141,"_5":13353,"_26530":108059,"_2682":108142},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3185":64920,"_28073":64888,"_19451":108144,"_5":13353,"_26530":108062,"_2682":108145},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3185":64921,"_28073":64888,"_19451":108147,"_5":13353,"_26530":108066,"_2682":108148},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3185":64922,"_28073":64888,"_19451":108150,"_5":13353,"_26530":108066,"_2682":108151},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3185":64923,"_28073":64888,"_19451":108153,"_5":13353,"_26530":108070,"_2682":108154},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3185":64924,"_28073":64888,"_19451":108156,"_5":13353,"_26530":108070,"_2682":108157},[],"Requisito",{"_3185":64925,"_28073":64888,"_19451":108159,"_5":13353,"_26530":108070,"_2682":108160},[],"Diseño recomendado",{"_3185":64926,"_28073":64888,"_19451":108162,"_5":13353,"_26530":108070,"_2682":108163},[],"Consecuencia",{"_3185":64927,"_28073":64888,"_19451":108165,"_5":13353,"_26530":108070,"_2682":108166},[],"Varias URL o servicios de Lamassu",{"_3185":64928,"_28073":64888,"_19451":108168,"_5":13353,"_26530":108070,"_2682":108169},[],"Un Gateway con varias rutas",{"_3185":64929,"_28073":64888,"_19451":108171,"_5":13353,"_26530":108070,"_2682":108172},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3185":64930,"_28073":64888,"_19451":108174,"_5":13353,"_26530":108070,"_2682":108175},[],"Gateways independientes e IP externas distintas",{"_3185":64931,"_28073":64888,"_19451":108177,"_5":13353,"_26530":108070,"_2682":108178},[],"Una VIP por Gateway",{"_3185":64932,"_28073":64888,"_19451":108180,"_5":13353,"_26530":108070,"_2682":108181},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3185":64933,"_28073":64888,"_19451":108183,"_5":13353,"_26530":108070,"_2682":108184},[],"Gateways independientes, un nodo y una IP",{"_3185":64934,"_28073":64888,"_19451":108186,"_5":13353,"_26530":108070,"_2682":108187},[],"Puertos externos diferentes",{"_3185":64935,"_28073":64888,"_19451":108189,"_5":13353,"_26530":108070,"_2682":108190},[],"Los clientes deben indicar puertos no estándar",{"_3185":64936,"_28073":64888,"_19451":108192,"_5":13353,"_26530":108070,"_2682":108193},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3185":64937,"_28073":64888,"_19451":108195,"_5":13353,"_26530":108070,"_2682":108196},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3185":64938,"_28073":64888,"_19451":108198,"_5":13353,"_26530":108070,"_2682":108199},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3185":64939,"_28073":64888,"_19451":108201,"_5":13353,"_26530":108070,"_2682":108202},[],"Recursos Gateway separados pero proxy compartido",{"_3185":64940,"_28073":64888,"_19451":108204,"_5":13353,"_26530":108070,"_2682":108205},[],"Modo merged Gateway de Envoy",{"_3185":64941,"_28073":64888,"_19451":108207,"_5":13353,"_26530":108070,"_2682":108208},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3185":64942,"_28073":64888,"_19451":108210,"_5":13353,"_26530":108070,"_2682":108211},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3185":64943,"_28073":64888,"_19451":108213,"_5":13353,"_26530":108070,"_2682":108214},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3185":64944,"_28073":64888,"_19451":108216,"_5":13353,"_26530":108070,"_2682":108217},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3185":64945,"_28073":64888,"_19451":108219,"_5":13353,"_26530":108070,"_2682":108220},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3185":64946,"_28073":64888,"_19451":108222,"_5":13353,"_26530":108074,"_2682":108223},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3185":64947,"_28073":64888,"_19451":108225,"_5":13353,"_26530":108074,"_2682":108226},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3185":64948,"_28073":64888,"_19451":108228,"_5":13353,"_26530":108074,"_2682":108229},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3185":64949,"_28073":64888,"_19451":108231,"_5":13353,"_26530":108074,"_2682":108232},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3185":64950,"_28073":64888,"_19451":108234,"_5":13353,"_26530":108074,"_2682":108235},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3185":64951,"_28073":64888,"_19451":108237,"_5":13353,"_26530":108078,"_2682":108238},[],"Comprueba, en orden:",{"_3185":64952,"_28073":64888,"_19451":108240,"_5":13353,"_26530":108078,"_2682":108241},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3185":64953,"_28073":64888,"_19451":108243,"_5":13353,"_26530":108078,"_2682":108244},[],"Su estado contiene la dirección esperada.",{"_3185":64954,"_28073":64888,"_19451":108246,"_5":13353,"_26530":108078,"_2682":108247},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3185":64955,"_28073":64888,"_19451":108249,"_5":13353,"_26530":108078,"_2682":108250},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3185":64956,"_28073":64888,"_19451":108252,"_5":13353,"_26530":108078,"_2682":108253},[],"DNS resuelve al endpoint accesible externamente.",{"_3185":64957,"_28073":64888,"_19451":108255,"_5":13353,"_26530":108078,"_2682":108256},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3185":64958,"_28073":64888,"_19451":108258,"_5":13353,"_26530":108078,"_2682":108259},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3185":64959,"_28073":64959,"_5":13700,"_2682":45706,"_28416":108261,"_19451":108262,"_26530":64959},[45599,107287,107521],[],{"_3185":64960,"_28073":64959,"_19451":108264,"_5":13353,"_26530":64959,"_2682":108265},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3185":64961,"_28073":64959,"_5":28413,"_19451":108267,"_26530":108268,"_2682":108269},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3185":64962,"_28073":64959,"_5":28413,"_19451":108271,"_26530":108272,"_2682":108273},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3185":64963,"_28073":64959,"_5":28413,"_19451":108275,"_26530":108276,"_2682":108277},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3185":64964,"_28073":64959,"_5":28413,"_19451":108279,"_26530":108280,"_2682":108281},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3185":64965,"_28073":64959,"_5":28413,"_19451":108283,"_26530":108284,"_2682":108285},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3185":64966,"_28073":64959,"_5":28413,"_19451":108287,"_26530":108288,"_2682":108289},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3185":64967,"_28073":64959,"_19451":108291,"_5":13353,"_26530":108268,"_2682":108292},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3185":64968,"_28073":64959,"_19451":108294,"_5":13353,"_26530":108272,"_2682":108295},[],"Flujo",{"_3185":64969,"_28073":64959,"_19451":108297,"_5":13353,"_26530":108272,"_2682":108298},[],"Úsalo para",{"_3185":64970,"_28073":64959,"_19451":108300,"_5":13353,"_26530":108272,"_2682":108301},[],"Qué instala",{"_3185":64971,"_28073":64959,"_19451":108303,"_5":13353,"_26530":108272,"_2682":46651},[],{"_3185":64972,"_28073":64959,"_19451":108305,"_5":13353,"_26530":108272,"_2682":108306},[],"Producción y entornos controlados",{"_3185":64973,"_28073":64959,"_19451":108308,"_5":13353,"_26530":108272,"_2682":108309},[],"Servicios de Lamassu y recursos de Gateway API",{"_3185":64974,"_28073":64959,"_19451":108311,"_5":13353,"_26530":108272,"_2682":45843},[],{"_3185":64975,"_28073":64959,"_19451":108313,"_5":13353,"_26530":108272,"_2682":108314},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3185":64976,"_28073":64959,"_19451":108316,"_5":13353,"_26530":108272,"_2682":108317},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3185":64977,"_28073":64959,"_19451":108319,"_5":13353,"_26530":108276,"_2682":108320},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3185":64978,"_28073":64959,"_19451":108322,"_5":13353,"_26530":108276,"_2682":108323},[],"Área",{"_3185":64979,"_28073":64959,"_19451":108325,"_5":13353,"_26530":108276,"_2682":108326},[],"El chart de Lamassu proporciona",{"_3185":64980,"_28073":64959,"_19451":108328,"_5":13353,"_26530":108276,"_2682":108329},[],"Tú proporcionas",{"_3185":64981,"_28073":64959,"_19451":108331,"_5":13353,"_26530":108276,"_2682":108332},[],"Aplicaciones Lamassu",{"_3185":64982,"_28073":64959,"_19451":108334,"_5":13353,"_26530":108276,"_2682":108335},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3185":64983,"_28073":64959,"_19451":108337,"_5":13353,"_26530":108276,"_2682":108338},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3185":64984,"_28073":64959,"_19451":108340,"_5":13353,"_26530":108276,"_2682":108341},[],"Datos PostgreSQL",{"_3185":64985,"_28073":64959,"_19451":108343,"_5":13353,"_26530":108276,"_2682":108344},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3185":64986,"_28073":64959,"_19451":108346,"_5":13353,"_26530":108276,"_2682":108347},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3185":64987,"_28073":64959,"_19451":108349,"_5":13353,"_26530":108276,"_2682":108350},[],"Mensajería",{"_3185":64988,"_28073":64959,"_19451":108352,"_5":13353,"_26530":108276,"_2682":108353},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS con una CA privada y un certificado de cliente opcional, definidos mediante valores del chart",{"_3185":64989,"_28073":64959,"_19451":108355,"_5":13353,"_26530":108276,"_2682":108356},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3185":64990,"_28073":64959,"_19451":108358,"_5":13353,"_26530":108276,"_2682":108359},[],"Identidad",{"_3185":64991,"_28073":64959,"_19451":108361,"_5":13353,"_26530":108276,"_2682":108362},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3185":64992,"_28073":64959,"_19451":108364,"_5":13353,"_26530":108276,"_2682":108365},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3185":64993,"_28073":64959,"_19451":108367,"_5":13353,"_26530":108276,"_2682":108368},[],"Enrutamiento externo",{"_3185":64994,"_28073":64959,"_19451":108370,"_5":13353,"_26530":108276,"_2682":108371},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3185":64995,"_28073":64959,"_19451":108373,"_5":13353,"_26530":108276,"_2682":108374},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3185":64996,"_28073":64959,"_19451":108376,"_5":13353,"_26530":108276,"_2682":46725},[],{"_3185":64997,"_28073":64959,"_19451":108378,"_5":13353,"_26530":108276,"_2682":108379},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3185":64998,"_28073":64959,"_19451":108381,"_5":13353,"_26530":108276,"_2682":108382},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3185":64999,"_28073":64959,"_19451":108384,"_5":13353,"_26530":108276,"_2682":108385},[],"Datos persistentes de la aplicación",{"_3185":65000,"_28073":64959,"_19451":108387,"_5":13353,"_26530":108276,"_2682":108388},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3185":65001,"_28073":64959,"_19451":108390,"_5":13353,"_26530":108276,"_2682":108391},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3185":65002,"_28073":64959,"_19451":108393,"_5":13353,"_26530":108276,"_2682":108394},[],"Integraciones opcionales",{"_3185":65003,"_28073":64959,"_19451":108396,"_5":13353,"_26530":108276,"_2682":108397},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3185":65004,"_28073":64959,"_19451":108399,"_5":13353,"_26530":108276,"_2682":108400},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3185":65005,"_28073":64959,"_19451":108402,"_5":13353,"_26530":108276,"_2682":108403},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3185":65006,"_28073":64959,"_19451":108405,"_5":13353,"_26530":108276,"_2682":108406},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3185":65007,"_28073":64959,"_19451":108408,"_5":13353,"_26530":108280,"_2682":108409},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3185":65008,"_28073":64959,"_19451":108411,"_5":13353,"_26530":108280,"_2682":108412},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3185":65009,"_28073":64959,"_19451":108414,"_5":13353,"_26530":108284,"_2682":108415},[],"Kubernetes 1.24 o posterior",{"_3185":65010,"_28073":64959,"_19451":108417,"_5":13353,"_26530":108284,"_2682":108418},[],"Helm 3.2 o posterior",{"_3185":65011,"_28073":64959,"_19451":108420,"_5":13353,"_26530":108284,"_2682":108421},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3185":65012,"_28073":64959,"_19451":108423,"_5":13353,"_26530":108284,"_2682":108424},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3185":65013,"_28073":64959,"_19451":108426,"_5":13353,"_26530":108284,"_2682":108427},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3185":65014,"_28073":64959,"_19451":108429,"_5":13353,"_26530":108284,"_2682":108430},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3185":65015,"_28073":64959,"_19451":108432,"_5":13353,"_26530":108284,"_2682":108433},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3185":65016,"_28073":64959,"_19451":108435,"_5":13353,"_26530":108288,"_2682":108436},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3185":65017,"_28073":64959,"_19451":108438,"_5":13353,"_26530":108288,"_2682":108439},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3185":65018,"_28073":64959,"_19451":108441,"_5":13353,"_26530":108288,"_2682":108442},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3185":65019,"_28073":64959,"_19451":108444,"_5":13353,"_26530":108288,"_2682":108445},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3185":65020,"_28073":65020,"_5":13700,"_2682":108447,"_28416":108448,"_19451":108450,"_26530":65020},"Resolución de problemas de despliegue",[45599,107287,108449],"Operación",[],{"_3185":65021,"_28073":65020,"_19451":108452,"_5":13353,"_26530":65020,"_2682":108453},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3185":65022,"_28073":65020,"_5":28413,"_19451":108455,"_26530":108456,"_2682":108457},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3185":65023,"_28073":65020,"_5":28413,"_19451":108459,"_26530":108460,"_2682":108461},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3185":65024,"_28073":65020,"_5":28413,"_19451":108463,"_26530":108464,"_2682":108465},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3185":65025,"_28073":65020,"_5":28413,"_19451":108467,"_26530":108468,"_2682":108469},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3185":65026,"_28073":65020,"_5":28413,"_19451":108471,"_26530":108472,"_2682":108473},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3185":65027,"_28073":65020,"_5":28413,"_19451":108475,"_26530":108476,"_2682":108477},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3185":65028,"_28073":65020,"_5":28413,"_19451":108479,"_26530":108480,"_2682":108481},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3185":65029,"_28073":65020,"_5":28413,"_19451":108483,"_26530":108484,"_2682":108485},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3185":65030,"_28073":65020,"_5":28413,"_19451":108487,"_26530":108488,"_2682":108489},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3185":65031,"_28073":65020,"_5":28413,"_19451":108491,"_26530":108492,"_2682":108493},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3185":65032,"_28073":65020,"_5":28413,"_19451":108495,"_26530":108496,"_2682":108497},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3185":65033,"_28073":65020,"_5":28413,"_19451":108499,"_26530":108500,"_2682":108501},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3185":65034,"_28073":65020,"_5":28413,"_19451":108503,"_26530":108504,"_2682":108505},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3185":65035,"_28073":65020,"_19451":108507,"_5":13353,"_26530":65020,"_2682":108508},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3185":65036,"_28073":65020,"_19451":108510,"_5":13353,"_26530":108460,"_2682":108511},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3185":65037,"_28073":65020,"_19451":108513,"_5":13353,"_26530":108464,"_2682":108514},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3185":65038,"_28073":65020,"_19451":108516,"_5":13353,"_26530":108468,"_2682":108517},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3185":65039,"_28073":65020,"_19451":108519,"_5":13353,"_26530":108472,"_2682":108520},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3185":65040,"_28073":65020,"_19451":108522,"_5":13353,"_26530":108476,"_2682":108523},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3185":65041,"_28073":65020,"_19451":108525,"_5":13353,"_26530":108480,"_2682":108526},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3185":65042,"_28073":65020,"_19451":108528,"_5":13353,"_26530":108480,"_2682":108529},[],"Ejecuta también la prueba de conectividad del chart:",{"_3185":65043,"_28073":65020,"_19451":108531,"_5":13353,"_26530":108480,"_2682":108532},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3185":65044,"_28073":65020,"_19451":108534,"_5":13353,"_26530":108480,"_2682":108535},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3185":65045,"_28073":65020,"_19451":108537,"_5":13353,"_26530":108484,"_2682":108538},[],"Si recibes un 401:",{"_3185":65046,"_28073":65020,"_19451":108540,"_5":13353,"_26530":108484,"_2682":108541},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3185":65047,"_28073":65020,"_19451":108543,"_5":13353,"_26530":108484,"_2682":108544},[],"verifica emisor, audiencia y expiración del token;",{"_3185":65048,"_28073":65020,"_19451":108546,"_5":13353,"_26530":108484,"_2682":108547},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3185":65049,"_28073":65020,"_19451":108549,"_5":13353,"_26530":108484,"_2682":108550},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3185":65050,"_28073":65020,"_19451":108552,"_5":13353,"_26530":108484,"_2682":108553},[],"Si el login termina pero las APIs devuelven 403:",{"_3185":65051,"_28073":65020,"_19451":108555,"_5":13353,"_26530":108484,"_2682":108556},[],"inspecciona los claims reales del token;",{"_3185":65052,"_28073":65020,"_19451":108558,"_5":13353,"_26530":108484,"_2682":108559},[],"confirma que coinciden con un principal activo;",{"_3185":65053,"_28073":65020,"_19451":108561,"_5":13353,"_26530":108484,"_2682":108562},[],"revisa las políticas concedidas al principal;",{"_3185":65054,"_28073":65020,"_19451":108564,"_5":13353,"_26530":108484,"_2682":108565},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3185":65055,"_28073":65020,"_19451":108567,"_5":13353,"_26530":108484,"_2682":108568},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3185":65056,"_28073":65020,"_19451":108570,"_5":13353,"_26530":108488,"_2682":108571},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3185":65057,"_28073":65020,"_19451":108573,"_5":13353,"_26530":108488,"_2682":108574},[],"Localiza el pod y Service de authz.",{"_3185":65058,"_28073":65020,"_19451":108576,"_5":13353,"_26530":108488,"_2682":108577},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3185":65059,"_28073":65020,"_19451":108579,"_5":13353,"_26530":108488,"_2682":108580},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3185":65060,"_28073":65020,"_19451":108582,"_5":13353,"_26530":108488,"_2682":108583},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3185":65061,"_28073":65020,"_19451":108585,"_5":13353,"_26530":108488,"_2682":108586},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3185":65062,"_28073":65020,"_19451":108588,"_5":13353,"_26530":108492,"_2682":108589},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y revisa el cuerpo antes de reenviarlo a terceros. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3185":65063,"_28073":65020,"_19451":108591,"_5":13353,"_26530":108496,"_2682":108592},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3185":65064,"_28073":65020,"_19451":108594,"_5":13353,"_26530":108496,"_2682":108595},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3185":65065,"_28073":65020,"_19451":108597,"_5":13353,"_26530":108496,"_2682":108598},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3185":65066,"_28073":65020,"_19451":108600,"_5":13353,"_26530":108496,"_2682":108601},[],"volumen persistente sin enlazar;",{"_3185":65067,"_28073":65020,"_19451":108603,"_5":13353,"_26530":108496,"_2682":108604},[],"imagen inaccesible o política de pull incorrecta;",{"_3185":65068,"_28073":65020,"_19451":108606,"_5":13353,"_26530":108496,"_2682":108607},[],"configuración inválida del motor criptográfico;",{"_3185":65069,"_28073":65020,"_19451":108609,"_5":13353,"_26530":108496,"_2682":108610},[],"límites de CPU o memoria demasiado bajos;",{"_3185":65070,"_28073":65020,"_19451":108612,"_5":13353,"_26530":108496,"_2682":108613},[],"migración previa incompleta.",{"_3185":65071,"_28073":65020,"_19451":108615,"_5":13353,"_26530":108496,"_2682":108616},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3185":65072,"_28073":65020,"_19451":108618,"_5":13353,"_26530":108496,"_2682":108619},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3185":65073,"_28073":65020,"_19451":108621,"_5":13353,"_26530":108500,"_2682":108622},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3185":65074,"_28073":65020,"_19451":108624,"_5":13353,"_26530":108500,"_2682":108625},[],"verifica que esté habilitado en el servicio emisor;",{"_3185":65075,"_28073":65020,"_19451":108627,"_5":13353,"_26530":108500,"_2682":108628},[],"comprueba conectividad y credenciales AMQP;",{"_3185":65076,"_28073":65020,"_19451":108630,"_5":13353,"_26530":108500,"_2682":108631},[],"revisa exchange, routing key, colas y consumidores;",{"_3185":65077,"_28073":65020,"_19451":108633,"_5":13353,"_26530":108500,"_2682":108634},[],"inspecciona dead-letter queues;",{"_3185":65078,"_28073":65020,"_19451":108636,"_5":13353,"_26530":108500,"_2682":108637},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3185":65079,"_28073":65020,"_19451":108639,"_5":13353,"_26530":108500,"_2682":108640},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3185":65080,"_28073":65020,"_19451":108642,"_5":13353,"_26530":108500,"_2682":108643},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3185":65081,"_28073":65020,"_19451":108645,"_5":13353,"_26530":108500,"_2682":108646},[],"confirma que el Secret de la CA exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey`;",{"_3185":65082,"_28073":65020,"_19451":108648,"_5":13353,"_26530":108500,"_2682":108649},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3185":65083,"_28073":65020,"_19451":108651,"_5":13353,"_26530":108500,"_2682":108652},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3185":65084,"_28073":65020,"_19451":108654,"_5":13353,"_26530":108500,"_2682":108655},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3185":65085,"_28073":65020,"_19451":108657,"_5":13353,"_26530":108500,"_2682":108658},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3185":65086,"_28073":65020,"_19451":108660,"_5":13353,"_26530":108504,"_2682":108661},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3185":65087,"_28073":65020,"_19451":108663,"_5":13353,"_26530":108504,"_2682":108664},[],"Antes de cerrar una incidencia, guarda:",{"_3185":65088,"_28073":65020,"_19451":108666,"_5":13353,"_26530":108504,"_2682":108667},[],"causa confirmada;",{"_3185":65089,"_28073":65020,"_19451":108669,"_5":13353,"_26530":108504,"_2682":108670},[],"alcance temporal y recursos afectados;",{"_3185":65090,"_28073":65020,"_19451":108672,"_5":13353,"_26530":108504,"_2682":108673},[],"comandos o consultas utilizados;",{"_3185":65091,"_28073":65020,"_19451":108675,"_5":13353,"_26530":108504,"_2682":108676},[],"cambio aplicado y forma de revertirlo;",{"_3185":65092,"_28073":65020,"_19451":108678,"_5":13353,"_26530":108504,"_2682":108679},[],"validación desde un consumidor;",{"_3185":65093,"_28073":65020,"_19451":108681,"_5":13353,"_26530":108504,"_2682":108682},[],"acción preventiva y propietario.",{"_3185":65094,"_28073":65094,"_5":13700,"_2682":108684,"_28416":108685,"_19451":108688,"_26530":65094},"Control de acceso",[45599,108686,108687],"Plataforma","Administración",[],{"_3185":65095,"_28073":65094,"_19451":108690,"_5":13353,"_26530":65094,"_2682":108691},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3185":65096,"_28073":65094,"_5":28413,"_19451":108693,"_26530":108694,"_2682":108695},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3185":65097,"_28073":65094,"_5":28413,"_19451":108697,"_26530":108698,"_2682":108699},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3185":65098,"_28073":65094,"_5":28413,"_19451":108701,"_26530":108702,"_2682":108703},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3185":65099,"_28073":65094,"_5":28413,"_19451":108705,"_26530":108706,"_2682":108707},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3185":65100,"_28073":65094,"_5":28413,"_19451":108709,"_26530":108710,"_2682":108711},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3185":65101,"_28073":65094,"_5":28413,"_19451":108713,"_26530":108714,"_2682":108715},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3185":65102,"_28073":65094,"_5":28413,"_19451":108717,"_26530":108718,"_2682":108719},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3185":65103,"_28073":65094,"_5":28413,"_19451":108721,"_26530":108722,"_2682":108723},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3185":65104,"_28073":65094,"_5":28413,"_19451":108725,"_26530":108726,"_2682":108727},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3185":65105,"_28073":65094,"_5":28413,"_19451":108729,"_26530":108730,"_2682":108731},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3185":65106,"_28073":65094,"_5":28413,"_19451":108733,"_26530":108734,"_2682":108735},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3185":65107,"_28073":65094,"_5":28413,"_19451":108737,"_26530":108738,"_2682":108739},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3185":65108,"_28073":65094,"_5":28413,"_19451":108741,"_26530":108742,"_2682":108743},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3185":65109,"_28073":65094,"_5":28413,"_19451":108745,"_26530":108746,"_2682":108747},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3185":65110,"_28073":65094,"_5":28413,"_19451":108749,"_26530":108750,"_2682":108751},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3185":65111,"_28073":65094,"_5":28413,"_19451":108753,"_26530":108754,"_2682":107893},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3185":65112,"_28073":65094,"_5":28413,"_19451":108756,"_26530":108757,"_2682":108758},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3185":65113,"_28073":65094,"_5":28413,"_19451":108760,"_26530":108761,"_2682":108762},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3185":65114,"_28073":65094,"_5":28413,"_19451":108764,"_26530":108765,"_2682":108766},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3185":65115,"_28073":65094,"_5":28413,"_19451":108768,"_26530":108769,"_2682":108770},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3185":65116,"_28073":65094,"_5":28413,"_19451":108772,"_26530":108773,"_2682":108774},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3185":65117,"_28073":65094,"_5":28413,"_19451":108776,"_26530":108777,"_2682":108778},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3185":65118,"_28073":65094,"_5":28413,"_19451":108780,"_26530":108781,"_2682":108782},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3185":65119,"_28073":65094,"_5":28413,"_19451":108784,"_26530":108785,"_2682":108786},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3185":65120,"_28073":65094,"_5":28413,"_19451":108788,"_26530":108789,"_2682":108790},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3185":65121,"_28073":65094,"_5":28413,"_19451":108792,"_26530":108793,"_2682":108794},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3185":65122,"_28073":65094,"_5":28413,"_19451":108796,"_26530":108797,"_2682":108798},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3185":65123,"_28073":65094,"_5":28413,"_19451":108800,"_26530":108801,"_2682":108802},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3185":65124,"_28073":65094,"_5":28413,"_19451":108804,"_26530":108805,"_2682":108806},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3185":65125,"_28073":65094,"_5":28413,"_19451":108808,"_26530":108809,"_2682":108810},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3185":65126,"_28073":65094,"_5":28413,"_19451":108812,"_26530":108813,"_2682":108814},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3185":65127,"_28073":65094,"_19451":108816,"_5":13353,"_26530":65094,"_2682":108817},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3185":65128,"_28073":65094,"_19451":108819,"_5":13353,"_26530":65094,"_2682":108820},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3185":65129,"_28073":65094,"_19451":108822,"_5":13353,"_26530":65094,"_2682":108823},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3185":65130,"_28073":65094,"_19451":108825,"_5":13353,"_26530":108694,"_2682":108826},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3185":65131,"_28073":65094,"_19451":108828,"_5":13353,"_26530":108694,"_2682":108829},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3185":65132,"_28073":65094,"_19451":108831,"_5":13353,"_26530":108694,"_2682":108832},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3185":65133,"_28073":65094,"_19451":108834,"_5":13353,"_26530":108694,"_2682":108835},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3185":65134,"_28073":65094,"_19451":108837,"_5":13353,"_26530":108694,"_2682":108838},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3185":65135,"_28073":65094,"_19451":108840,"_5":13353,"_26530":108694,"_2682":108841},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3185":65136,"_28073":65094,"_19451":108843,"_5":13353,"_26530":108698,"_2682":108844},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3185":65137,"_28073":65094,"_19451":108846,"_5":13353,"_26530":108698,"_2682":108847},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3185":65138,"_28073":65094,"_19451":108849,"_5":13353,"_26530":108702,"_2682":108850},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3185":65139,"_28073":65094,"_19451":108852,"_5":13353,"_26530":108702,"_2682":108853},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3185":65140,"_28073":65094,"_19451":108855,"_5":13353,"_26530":108702,"_2682":108856},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3185":65141,"_28073":65094,"_19451":108858,"_5":13353,"_26530":108702,"_2682":108859},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3185":65142,"_28073":65094,"_19451":108861,"_5":13353,"_26530":108702,"_2682":108862},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3185":65143,"_28073":65094,"_19451":108864,"_5":13353,"_26530":108702,"_2682":108865},[],"Carga por separado las políticas concedidas a cada principal.",{"_3185":65144,"_28073":65094,"_19451":108867,"_5":13353,"_26530":108702,"_2682":108868},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3185":65145,"_28073":65094,"_19451":108870,"_5":13353,"_26530":108702,"_2682":108871},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3185":65146,"_28073":65094,"_19451":108873,"_5":13353,"_26530":108702,"_2682":108874},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3185":65147,"_28073":65094,"_19451":108876,"_5":13353,"_26530":108702,"_2682":108877},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3185":65148,"_28073":65094,"_19451":108879,"_5":13353,"_26530":108702,"_2682":108880},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3185":65149,"_28073":65094,"_19451":108882,"_5":13353,"_26530":108702,"_2682":108883},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3185":65150,"_28073":65094,"_19451":108885,"_5":13353,"_26530":108706,"_2682":108886},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3185":65151,"_28073":65094,"_19451":108888,"_5":13353,"_26530":108706,"_2682":108889},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3185":65152,"_28073":65094,"_19451":108891,"_5":13353,"_26530":108706,"_2682":108892},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3185":65153,"_28073":65094,"_19451":108894,"_5":13353,"_26530":108706,"_2682":108895},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3185":65154,"_28073":65094,"_19451":108897,"_5":13353,"_26530":108706,"_2682":108898},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3185":65155,"_28073":65094,"_19451":108900,"_5":13353,"_26530":108706,"_2682":108901},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3185":65156,"_28073":65094,"_19451":108903,"_5":13353,"_26530":108706,"_2682":108904},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3185":65157,"_28073":65094,"_19451":108906,"_5":13353,"_26530":108706,"_2682":108907},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3185":65158,"_28073":65094,"_19451":108909,"_5":13353,"_26530":108710,"_2682":108910},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3185":65159,"_28073":65094,"_19451":108912,"_5":13353,"_26530":108710,"_2682":108913},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3185":65160,"_28073":65094,"_19451":108915,"_5":13353,"_26530":108710,"_2682":108916},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3185":65161,"_28073":65094,"_19451":108918,"_5":13353,"_26530":108710,"_2682":108919},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3185":65162,"_28073":65094,"_19451":108921,"_5":13353,"_26530":108710,"_2682":108922},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3185":65163,"_28073":65094,"_19451":108924,"_5":13353,"_26530":108710,"_2682":108925},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3185":65164,"_28073":65094,"_19451":108927,"_5":13353,"_26530":108710,"_2682":108928},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3185":65165,"_28073":65094,"_19451":108930,"_5":13353,"_26530":108710,"_2682":108931},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3185":65166,"_28073":65094,"_19451":108933,"_5":13353,"_26530":108710,"_2682":108934},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3185":65167,"_28073":65094,"_19451":108936,"_5":13353,"_26530":108710,"_2682":108937},[],"Las acciones se dividen en dos grupos:",{"_3185":65168,"_28073":65094,"_19451":108939,"_5":13353,"_26530":108710,"_2682":108940},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3185":65169,"_28073":65094,"_19451":108942,"_5":13353,"_26530":108710,"_2682":108943},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3185":65170,"_28073":65094,"_19451":108945,"_5":13353,"_26530":108710,"_2682":108946},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3185":65171,"_28073":65094,"_19451":108948,"_5":13353,"_26530":108714,"_2682":108949},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3185":65172,"_28073":65094,"_19451":108951,"_5":13353,"_26530":108714,"_2682":108952},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3185":65173,"_28073":65094,"_19451":108954,"_5":13353,"_26530":108714,"_2682":108955},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3185":65174,"_28073":65094,"_19451":108957,"_5":13353,"_26530":108718,"_2682":108958},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3185":65175,"_28073":65094,"_19451":108960,"_5":13353,"_26530":108718,"_2682":108961},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3185":65176,"_28073":65094,"_19451":108963,"_5":13353,"_26530":108718,"_2682":108964},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3185":65177,"_28073":65094,"_19451":108966,"_5":13353,"_26530":108718,"_2682":108967},[],"Los operadores implementados son:",{"_3185":65178,"_28073":65094,"_19451":108969,"_5":13353,"_26530":108718,"_2682":108970},[],"`equals`, para igualdad exacta;",{"_3185":65179,"_28073":65094,"_19451":108972,"_5":13353,"_26530":108718,"_2682":108973},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3185":65180,"_28073":65094,"_19451":108975,"_5":13353,"_26530":108718,"_2682":108976},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3185":65181,"_28073":65094,"_19451":108978,"_5":13353,"_26530":108718,"_2682":108979},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3185":65182,"_28073":65094,"_19451":108981,"_5":13353,"_26530":108722,"_2682":108982},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3185":65183,"_28073":65094,"_19451":108984,"_5":13353,"_26530":108722,"_2682":108985},[],"Los modos disponibles son:",{"_3185":65184,"_28073":65094,"_19451":108987,"_5":13353,"_26530":108722,"_2682":108988},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3185":65185,"_28073":65094,"_19451":108990,"_5":13353,"_26530":108722,"_2682":108991},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3185":65186,"_28073":65094,"_19451":108993,"_5":13353,"_26530":108722,"_2682":108994},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3185":65187,"_28073":65094,"_19451":108996,"_5":13353,"_26530":108722,"_2682":108997},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3185":65188,"_28073":65094,"_19451":108999,"_5":13353,"_26530":108722,"_2682":109000},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3185":65189,"_28073":65094,"_19451":109002,"_5":13353,"_26530":108722,"_2682":109003},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3185":65190,"_28073":65094,"_19451":109005,"_5":13353,"_26530":108726,"_2682":109006},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3185":65191,"_28073":65094,"_19451":109008,"_5":13353,"_26530":108726,"_2682":109009},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3185":65192,"_28073":65094,"_19451":109011,"_5":13353,"_26530":108726,"_2682":109012},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3185":65193,"_28073":65094,"_19451":109014,"_5":13353,"_26530":108726,"_2682":109015},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3185":65194,"_28073":65094,"_19451":109017,"_5":13353,"_26530":108734,"_2682":109018},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3185":65195,"_28073":65094,"_19451":109020,"_5":13353,"_26530":108734,"_2682":109021},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3185":65196,"_28073":65094,"_19451":109023,"_5":13353,"_26530":108738,"_2682":109024},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3185":65197,"_28073":65094,"_19451":109026,"_5":13353,"_26530":108738,"_2682":109027},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3185":65198,"_28073":65094,"_19451":109029,"_5":13353,"_26530":108742,"_2682":109030},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3185":65199,"_28073":65094,"_19451":109032,"_5":13353,"_26530":108742,"_2682":109033},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3185":65200,"_28073":65094,"_19451":109035,"_5":13353,"_26530":108742,"_2682":109036},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3185":65201,"_28073":65094,"_19451":109038,"_5":13353,"_26530":108746,"_2682":109039},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3185":65202,"_28073":65094,"_19451":109041,"_5":13353,"_26530":108746,"_2682":109042},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3185":65203,"_28073":65094,"_19451":109044,"_5":13353,"_26530":108746,"_2682":109045},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3185":65204,"_28073":65094,"_19451":109047,"_5":13353,"_26530":108746,"_2682":109048},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3185":65205,"_28073":65094,"_19451":109050,"_5":13353,"_26530":108746,"_2682":109051},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3185":65206,"_28073":65094,"_19451":109053,"_5":13353,"_26530":108746,"_2682":109054},[],"Ten en cuenta que:",{"_3185":65207,"_28073":65094,"_19451":109056,"_5":13353,"_26530":108746,"_2682":109057},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3185":65208,"_28073":65094,"_19451":109059,"_5":13353,"_26530":108746,"_2682":109060},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3185":65209,"_28073":65094,"_19451":109062,"_5":13353,"_26530":108746,"_2682":109063},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3185":65210,"_28073":65094,"_19451":109065,"_5":13353,"_26530":108750,"_2682":109066},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3185":65211,"_28073":65094,"_19451":109068,"_5":13353,"_26530":108750,"_2682":109069},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3185":65212,"_28073":65094,"_19451":109071,"_5":13353,"_26530":108750,"_2682":109072},[],"acceso completo y de solo lectura a KMS;",{"_3185":65213,"_28073":65094,"_19451":109074,"_5":13353,"_26530":108750,"_2682":109075},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3185":65214,"_28073":65094,"_19451":109077,"_5":13353,"_26530":108750,"_2682":109078},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3185":65215,"_28073":65094,"_19451":109080,"_5":13353,"_26530":108750,"_2682":109081},[],"acceso a la interfaz;",{"_3185":65216,"_28073":65094,"_19451":109083,"_5":13353,"_26530":108750,"_2682":109084},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3185":65217,"_28073":65094,"_19451":109086,"_5":13353,"_26530":108750,"_2682":109087},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3185":65218,"_28073":65094,"_19451":109089,"_5":13353,"_26530":108750,"_2682":109090},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3185":65219,"_28073":65094,"_19451":109092,"_5":13353,"_26530":108754,"_2682":109093},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3185":65220,"_28073":65094,"_19451":109095,"_5":13353,"_26530":108754,"_2682":109096},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3185":65221,"_28073":65094,"_19451":109098,"_5":13353,"_26530":108754,"_2682":109099},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3185":65222,"_28073":65094,"_19451":109101,"_5":13353,"_26530":108757,"_2682":109102},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3185":65223,"_28073":65094,"_19451":109104,"_5":13353,"_26530":108761,"_2682":109105},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3185":65224,"_28073":65094,"_19451":109107,"_5":13353,"_26530":108761,"_2682":109108},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3185":65225,"_28073":65094,"_19451":109110,"_5":13353,"_26530":108765,"_2682":109111},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3185":65226,"_28073":65094,"_19451":109113,"_5":13353,"_26530":108769,"_2682":109114},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3185":65227,"_28073":65094,"_19451":109116,"_5":13353,"_26530":108773,"_2682":109117},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3185":65228,"_28073":65094,"_19451":109119,"_5":13353,"_26530":108777,"_2682":109120},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3185":65229,"_28073":65094,"_19451":109122,"_5":13353,"_26530":108777,"_2682":109123},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3185":65230,"_28073":65094,"_19451":109125,"_5":13353,"_26530":108781,"_2682":109126},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3185":65231,"_28073":65094,"_19451":109128,"_5":13353,"_26530":108781,"_2682":109129},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3185":65232,"_28073":65094,"_19451":109131,"_5":13353,"_26530":108781,"_2682":109132},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3185":65233,"_28073":65094,"_19451":109134,"_5":13353,"_26530":108781,"_2682":109135},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3185":65234,"_28073":65094,"_19451":109137,"_5":13353,"_26530":108781,"_2682":109138},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3185":65235,"_28073":65094,"_19451":109140,"_5":13353,"_26530":108781,"_2682":109141},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3185":65236,"_28073":65094,"_19451":109143,"_5":13353,"_26530":108781,"_2682":109144},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3185":65237,"_28073":65094,"_19451":109146,"_5":13353,"_26530":108781,"_2682":109147},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3185":65238,"_28073":65094,"_19451":109149,"_5":13353,"_26530":108785,"_2682":109150},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3185":65239,"_28073":65094,"_19451":109152,"_5":13353,"_26530":108785,"_2682":109153},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3185":65240,"_28073":65094,"_19451":109155,"_5":13353,"_26530":108785,"_2682":109156},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3185":65241,"_28073":65094,"_19451":109158,"_5":13353,"_26530":108789,"_2682":109159},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3185":65242,"_28073":65094,"_19451":109161,"_5":13353,"_26530":108789,"_2682":109162},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3185":65243,"_28073":65094,"_19451":109164,"_5":13353,"_26530":108789,"_2682":109165},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3185":65244,"_28073":65094,"_19451":109167,"_5":13353,"_26530":108789,"_2682":109168},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3185":65245,"_28073":65094,"_19451":109170,"_5":13353,"_26530":108789,"_2682":109171},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3185":65246,"_28073":65094,"_19451":109173,"_5":13353,"_26530":108789,"_2682":109174},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3185":65247,"_28073":65094,"_19451":109176,"_5":13353,"_26530":108789,"_2682":109177},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3185":65248,"_28073":65094,"_19451":109179,"_5":13353,"_26530":108789,"_2682":109180},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3185":65249,"_28073":65094,"_19451":109182,"_5":13353,"_26530":108797,"_2682":109183},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3185":65250,"_28073":65094,"_19451":109185,"_5":13353,"_26530":108801,"_2682":109186},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3185":65251,"_28073":65094,"_19451":109188,"_5":13353,"_26530":108801,"_2682":109189},[],"que exista un principal activo del tipo correcto;",{"_3185":65252,"_28073":65094,"_19451":109191,"_5":13353,"_26530":108801,"_2682":109192},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3185":65253,"_28073":65094,"_19451":109194,"_5":13353,"_26530":108801,"_2682":109195},[],"que todas las condiciones del principal se cumplan;",{"_3185":65254,"_28073":65094,"_19451":109197,"_5":13353,"_26530":108801,"_2682":109198},[],"que el principal tenga concedida la política esperada;",{"_3185":65255,"_28073":65094,"_19451":109200,"_5":13353,"_26530":108801,"_2682":109201},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3185":65256,"_28073":65094,"_19451":109203,"_5":13353,"_26530":108801,"_2682":109204},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3185":65257,"_28073":65094,"_19451":109206,"_5":13353,"_26530":108801,"_2682":109207},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3185":65258,"_28073":65094,"_19451":109209,"_5":13353,"_26530":108805,"_2682":109210},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3185":65259,"_28073":65094,"_19451":109212,"_5":13353,"_26530":108809,"_2682":109213},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3185":65260,"_28073":65094,"_19451":109215,"_5":13353,"_26530":108813,"_2682":109216},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3185":65261,"_28073":65094,"_19451":109218,"_5":13353,"_26530":108813,"_2682":109219},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3185":65262,"_28073":65262,"_5":13700,"_2682":109221,"_28416":109222,"_19451":109223,"_26530":65262},"Alertas y suscripciones",[45599,108686,108687],[],{"_3185":65263,"_28073":65262,"_19451":109225,"_5":13353,"_26530":65262,"_2682":109226},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3185":65264,"_28073":65262,"_5":28413,"_19451":109228,"_26530":109229,"_2682":109230},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3185":65265,"_28073":65262,"_5":28413,"_19451":109232,"_26530":109233,"_2682":109234},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3185":65266,"_28073":65262,"_5":28413,"_19451":109236,"_26530":109237,"_2682":109238},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3185":65267,"_28073":65262,"_5":28413,"_19451":109240,"_26530":109241,"_2682":109242},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3185":65268,"_28073":65262,"_5":28413,"_19451":109244,"_26530":109245,"_2682":109246},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3185":65269,"_28073":65262,"_5":28413,"_19451":109248,"_26530":109249,"_2682":109250},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3185":65270,"_28073":65262,"_5":28413,"_19451":109252,"_26530":109253,"_2682":109254},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3185":65271,"_28073":65262,"_5":28413,"_19451":109256,"_26530":109257,"_2682":109258},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3185":65272,"_28073":65262,"_5":28413,"_19451":109260,"_26530":109261,"_2682":109262},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3185":65273,"_28073":65262,"_5":28413,"_19451":109264,"_26530":109265,"_2682":109266},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3185":65274,"_28073":65262,"_19451":109268,"_5":13353,"_26530":65262,"_2682":109269},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3185":65275,"_28073":65262,"_19451":109271,"_5":13353,"_26530":109229,"_2682":109272},[],"Un servicio publica un evento de dominio.",{"_3185":65276,"_28073":65262,"_19451":109274,"_5":13353,"_26530":109229,"_2682":109275},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3185":65277,"_28073":65262,"_19451":109277,"_5":13353,"_26530":109229,"_2682":109278},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3185":65278,"_28073":65262,"_19451":109280,"_5":13353,"_26530":109229,"_2682":109281},[],"Lamassu entrega el evento al canal configurado.",{"_3185":65279,"_28073":65262,"_19451":109283,"_5":13353,"_26530":109229,"_2682":109284},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3185":65280,"_28073":65262,"_19451":109286,"_5":13353,"_26530":109233,"_2682":109287},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3185":65281,"_28073":65262,"_19451":109289,"_5":13353,"_26530":109233,"_2682":109290},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3185":65282,"_28073":65262,"_19451":109292,"_5":13353,"_26530":109233,"_2682":109293},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3185":65283,"_28073":65262,"_19451":109295,"_5":13353,"_26530":109233,"_2682":109296},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3185":65284,"_28073":65262,"_19451":109298,"_5":13353,"_26530":109233,"_2682":109299},[],"`apikey_options` necesita `header` y `key`.",{"_3185":65285,"_28073":65262,"_19451":109301,"_5":13353,"_26530":109233,"_2682":109302},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3185":65286,"_28073":65262,"_19451":109304,"_5":13353,"_26530":109233,"_2682":109305},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3185":65287,"_28073":65262,"_19451":109307,"_5":13353,"_26530":109233,"_2682":109308},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3185":65288,"_28073":65262,"_19451":109310,"_5":13353,"_26530":109241,"_2682":109311},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3185":65289,"_28073":65262,"_19451":109313,"_5":13353,"_26530":109245,"_2682":109314},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3185":65290,"_28073":65262,"_19451":109316,"_5":13353,"_26530":109249,"_2682":109317},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3185":65291,"_28073":65262,"_19451":109319,"_5":13353,"_26530":109249,"_2682":109320},[],"**None** notifica todas las instancias del evento.",{"_3185":65292,"_28073":65262,"_19451":109322,"_5":13353,"_26530":109249,"_2682":109323},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3185":65293,"_28073":65262,"_19451":109325,"_5":13353,"_26530":109249,"_2682":109326},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3185":65294,"_28073":65262,"_19451":109328,"_5":13353,"_26530":109249,"_2682":109329},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3185":65295,"_28073":65262,"_19451":109331,"_5":13353,"_26530":109249,"_2682":109332},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3185":65296,"_28073":65262,"_19451":109334,"_5":13353,"_26530":109253,"_2682":109335},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3185":65297,"_28073":65262,"_19451":109337,"_5":13353,"_26530":109257,"_2682":109338},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3185":65298,"_28073":65262,"_19451":109340,"_5":13353,"_26530":109257,"_2682":109341},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3185":65299,"_28073":65262,"_19451":109343,"_5":13353,"_26530":109257,"_2682":109344},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3185":65300,"_28073":65262,"_19451":109346,"_5":13353,"_26530":109257,"_2682":109347},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3185":65301,"_28073":65262,"_19451":109349,"_5":13353,"_26530":109257,"_2682":109350},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3185":65302,"_28073":65262,"_19451":109352,"_5":13353,"_26530":109257,"_2682":109353},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3185":65303,"_28073":65262,"_19451":109355,"_5":13353,"_26530":109257,"_2682":109356},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3185":65304,"_28073":65262,"_19451":109358,"_5":13353,"_26530":109257,"_2682":109359},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3185":65305,"_28073":65262,"_19451":109361,"_5":13353,"_26530":109261,"_2682":109362},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3185":65306,"_28073":65262,"_19451":109364,"_5":13353,"_26530":109265,"_2682":109365},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3185":65307,"_28073":65262,"_19451":109367,"_5":13353,"_26530":109265,"_2682":109368},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3185":65308,"_28073":65262,"_19451":109370,"_5":13353,"_26530":109265,"_2682":109371},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3185":65309,"_28073":65262,"_19451":109373,"_5":13353,"_26530":109265,"_2682":109374},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3185":65310,"_28073":65262,"_19451":109376,"_5":13353,"_26530":109265,"_2682":109377},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3185":65311,"_28073":65262,"_19451":109379,"_5":13353,"_26530":109265,"_2682":109380},[],"**Validación:** `va.role.crl.create`.",{"_3185":65312,"_28073":65262,"_19451":109382,"_5":13353,"_26530":109265,"_2682":109383},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3185":65313,"_28073":65262,"_19451":109385,"_5":13353,"_26530":109265,"_2682":109386},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3185":65314,"_28073":65314,"_5":13700,"_2682":109388,"_28416":109389,"_19451":109390,"_26530":65314},"Registros de auditoría",[45599,108686,108687],[],{"_3185":65315,"_28073":65314,"_19451":109392,"_5":13353,"_26530":65314,"_2682":109393},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3185":65316,"_28073":65314,"_5":28413,"_19451":109395,"_26530":109396,"_2682":109397},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3185":65317,"_28073":65314,"_5":28413,"_19451":109399,"_26530":109400,"_2682":109401},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3185":65318,"_28073":65314,"_5":28413,"_19451":109403,"_26530":109404,"_2682":109405},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3185":65319,"_28073":65314,"_5":28413,"_19451":109407,"_26530":109408,"_2682":109409},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3185":65320,"_28073":65314,"_5":28413,"_19451":109411,"_26530":109412,"_2682":109413},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3185":65321,"_28073":65314,"_5":28413,"_19451":109415,"_26530":109416,"_2682":109417},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3185":65322,"_28073":65314,"_5":28413,"_19451":109419,"_26530":109420,"_2682":109421},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3185":65323,"_28073":65314,"_5":28413,"_19451":109423,"_26530":109424,"_2682":109425},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3185":65324,"_28073":65314,"_5":28413,"_19451":109427,"_26530":109428,"_2682":109429},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3185":65325,"_28073":65314,"_5":28413,"_19451":109431,"_26530":109432,"_2682":109433},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3185":65326,"_28073":65314,"_5":28413,"_19451":109435,"_26530":109436,"_2682":109437},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3185":65327,"_28073":65314,"_19451":109439,"_5":13353,"_26530":65314,"_2682":109440},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3185":65328,"_28073":65314,"_19451":109442,"_5":13353,"_26530":109396,"_2682":109443},[],"El cuerpo de auditoría incluye:",{"_3185":65329,"_28073":65314,"_19451":109445,"_5":13353,"_26530":109396,"_2682":109446},[],"input: datos recibidos por la operación;",{"_3185":65330,"_28073":65314,"_19451":109448,"_5":13353,"_26530":109396,"_2682":109449},[],"has\\_error: indica si el servicio devolvió un error;",{"_3185":65331,"_28073":65314,"_19451":109451,"_5":13353,"_26530":109396,"_2682":109452},[],"output: resultado producido o mensaje de error;",{"_3185":65332,"_28073":65314,"_19451":109454,"_5":13353,"_26530":109396,"_2682":109455},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3185":65333,"_28073":65314,"_19451":109457,"_5":13353,"_26530":109396,"_2682":109458},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3185":65334,"_28073":65314,"_19451":109460,"_5":13353,"_26530":109396,"_2682":109461},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3185":65335,"_28073":65314,"_19451":109463,"_5":13353,"_26530":109400,"_2682":109464},[],"El backend aplica auditoría a mutaciones de:",{"_3185":65336,"_28073":65314,"_19451":109466,"_5":13353,"_26530":109400,"_2682":109467},[],"autoridades, certificados y perfiles de emisión;",{"_3185":65337,"_28073":65314,"_19451":109469,"_5":13353,"_26530":109400,"_2682":109470},[],"claves y motores KMS;",{"_3185":65338,"_28073":65314,"_19451":109472,"_5":13353,"_26530":109400,"_2682":109473},[],"dispositivos e identidades;",{"_3185":65339,"_28073":65314,"_19451":109475,"_5":13353,"_26530":109400,"_2682":109476},[],"DMS y operaciones de enrolamiento;",{"_3185":65340,"_28073":65314,"_19451":109478,"_5":13353,"_26530":109400,"_2682":109479},[],"funciones de validación y CRL;",{"_3185":65341,"_28073":65314,"_19451":109481,"_5":13353,"_26530":109400,"_2682":109482},[],"principales, políticas y concesiones de autorización.",{"_3185":65342,"_28073":65314,"_19451":109484,"_5":13353,"_26530":109400,"_2682":109485},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3185":65343,"_28073":65314,"_19451":109487,"_5":13353,"_26530":109404,"_2682":109488},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3185":65344,"_28073":65314,"_19451":109490,"_5":13353,"_26530":109404,"_2682":109491},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3185":65345,"_28073":65314,"_19451":109493,"_5":13353,"_26530":109404,"_2682":109494},[],"Diseña el consumidor para:",{"_3185":65346,"_28073":65314,"_19451":109496,"_5":13353,"_26530":109404,"_2682":109497},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3185":65347,"_28073":65314,"_19451":109499,"_5":13353,"_26530":109404,"_2682":109500},[],"conservar el CloudEvent completo sin modificar;",{"_3185":65348,"_28073":65314,"_19451":109502,"_5":13353,"_26530":109404,"_2682":109503},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3185":65349,"_28073":65314,"_19451":109505,"_5":13353,"_26530":109404,"_2682":109506},[],"cifrar en tránsito y en reposo;",{"_3185":65350,"_28073":65314,"_19451":109508,"_5":13353,"_26530":109404,"_2682":109509},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3185":65351,"_28073":65314,"_19451":109511,"_5":13353,"_26530":109404,"_2682":109512},[],"aplicar una política explícita de retención y legal hold;",{"_3185":65352,"_28073":65314,"_19451":109514,"_5":13353,"_26530":109404,"_2682":109515},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3185":65353,"_28073":65314,"_19451":109517,"_5":13353,"_26530":109408,"_2682":109518},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3185":65354,"_28073":65314,"_19451":109520,"_5":13353,"_26530":109408,"_2682":109521},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3185":65355,"_28073":65314,"_19451":109523,"_5":13353,"_26530":109416,"_2682":109524},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3185":65356,"_28073":65314,"_19451":109526,"_5":13353,"_26530":109420,"_2682":109527},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3185":65357,"_28073":65314,"_19451":109529,"_5":13353,"_26530":109424,"_2682":109530},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3185":65358,"_28073":65314,"_19451":109532,"_5":13353,"_26530":109428,"_2682":109533},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3185":65359,"_28073":65314,"_19451":109535,"_5":13353,"_26530":109432,"_2682":109536},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3185":65360,"_28073":65314,"_19451":109538,"_5":13353,"_26530":109436,"_2682":109539},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3185":65361,"_28073":65314,"_19451":109541,"_5":13353,"_26530":109436,"_2682":109542},[],"aparece un evento de auditoría correcto;",{"_3185":65362,"_28073":65314,"_19451":109544,"_5":13353,"_26530":109436,"_2682":109545},[],"el principal coincide con la identidad utilizada;",{"_3185":65363,"_28073":65314,"_19451":109547,"_5":13353,"_26530":109436,"_2682":109548},[],"el consumidor lo persiste una sola vez;",{"_3185":65364,"_28073":65314,"_19451":109550,"_5":13353,"_26530":109436,"_2682":109551},[],"puede recuperarse por recurso, actor y periodo;",{"_3185":65365,"_28073":65314,"_19451":109553,"_5":13353,"_26530":109436,"_2682":109554},[],"una interrupción del consumidor produce una alerta.",{"_3185":65366,"_28073":65314,"_19451":109556,"_5":13353,"_26530":109436,"_2682":109557},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3185":65367,"_28073":65367,"_5":13700,"_2682":109559,"_28416":109560,"_19451":109561,"_26530":65367},"Arquitectura de la plataforma",[45599,108686],[],{"_3185":65368,"_28073":65367,"_19451":109563,"_5":13353,"_26530":65367,"_2682":109564},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3185":65369,"_28073":65367,"_5":28413,"_19451":109566,"_26530":109567,"_2682":109568},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3185":65370,"_28073":65367,"_5":28413,"_19451":109570,"_26530":109571,"_2682":109572},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3185":65371,"_28073":65367,"_5":28413,"_19451":109574,"_26530":109575,"_2682":109576},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3185":65372,"_28073":65367,"_5":28413,"_19451":109578,"_26530":109579,"_2682":109580},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3185":65373,"_28073":65367,"_5":28413,"_19451":109582,"_26530":109583,"_2682":109584},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3185":65374,"_28073":65367,"_19451":109586,"_5":13353,"_26530":65367,"_2682":109587},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3185":65375,"_28073":65367,"_19451":109589,"_5":13353,"_26530":65367,"_2682":109590},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3185":65376,"_28073":65367,"_19451":109592,"_5":13353,"_26530":109567,"_2682":109593},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3185":65377,"_28073":65367,"_19451":109595,"_5":13353,"_26530":109571,"_2682":109596},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3185":65378,"_28073":65367,"_19451":109598,"_5":13353,"_26530":109575,"_2682":109599},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3185":65379,"_28073":65367,"_19451":109601,"_5":13353,"_26530":109579,"_2682":109602},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3185":65380,"_28073":65367,"_19451":109604,"_5":13353,"_26530":109583,"_2682":109605},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3185":65381,"_28073":65381,"_5":13700,"_2682":109607,"_28416":109608,"_19451":109609,"_26530":65381},"Cómo funciona Lamassu",[45599,108686],[],{"_3185":65382,"_28073":65381,"_19451":109611,"_5":13353,"_26530":65381,"_2682":109612},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3185":65383,"_28073":65381,"_5":28413,"_19451":109614,"_26530":109615,"_2682":109616},[],"/docs/pr-preview/pr-42/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3185":65384,"_28073":65381,"_5":28413,"_19451":109618,"_26530":109619,"_2682":109620},[],"/docs/pr-preview/pr-42/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3185":65385,"_28073":65381,"_19451":109622,"_5":13353,"_26530":65381,"_2682":109623},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3185":65386,"_28073":65381,"_19451":109625,"_5":13353,"_26530":109615,"_2682":109626},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3185":65387,"_28073":65381,"_19451":109628,"_5":13353,"_26530":109615,"_2682":109629},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3185":65388,"_28073":65381,"_19451":109631,"_5":13353,"_26530":109615,"_2682":109632},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3185":65389,"_28073":65381,"_19451":109634,"_5":13353,"_26530":109615,"_2682":109635},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3185":65390,"_28073":65381,"_19451":109637,"_5":13353,"_26530":109615,"_2682":109638},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3185":65391,"_28073":65381,"_19451":109640,"_5":13353,"_26530":109619,"_2682":109641},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3185":65392,"_28073":65381,"_19451":109643,"_5":13353,"_26530":109619,"_2682":109644},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3185":65393,"_28073":65381,"_19451":109646,"_5":13353,"_26530":109619,"_2682":109647},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3185":65394,"_28073":65381,"_19451":109649,"_5":13353,"_26530":109619,"_2682":109650},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3185":65395,"_28073":65381,"_19451":109652,"_5":13353,"_26530":109619,"_2682":109653},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3185":65396,"_28073":65381,"_19451":109655,"_5":13353,"_26530":109619,"_2682":109656},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3185":65397,"_28073":65381,"_19451":109658,"_5":13353,"_26530":109619,"_2682":109659},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3185":65398,"_28073":65398,"_5":13700,"_2682":109661,"_28416":109662,"_19451":109663,"_26530":65398},"Dispositivos e identidades",[45599,108686,48012,109661],[],{"_3185":65399,"_28073":65398,"_19451":109665,"_5":13353,"_26530":65398,"_2682":109666},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3185":65400,"_28073":65398,"_5":28413,"_19451":109668,"_26530":109669,"_2682":109670},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3185":65401,"_28073":65398,"_5":28413,"_19451":109672,"_26530":109673,"_2682":109674},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3185":65402,"_28073":65398,"_5":28413,"_19451":109676,"_26530":109677,"_2682":109678},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3185":65403,"_28073":65398,"_5":28413,"_19451":109680,"_26530":109681,"_2682":109682},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3185":65404,"_28073":65398,"_5":28413,"_19451":109684,"_26530":109685,"_2682":109686},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3185":65405,"_28073":65398,"_5":28413,"_19451":109688,"_26530":109689,"_2682":109690},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3185":65406,"_28073":65398,"_5":28413,"_19451":109692,"_26530":109693,"_2682":109694},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3185":65407,"_28073":65398,"_5":28413,"_19451":109696,"_26530":109697,"_2682":109698},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3185":65408,"_28073":65398,"_5":28413,"_19451":109700,"_26530":109701,"_2682":109702},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3185":65409,"_28073":65398,"_5":28413,"_19451":109704,"_26530":109705,"_2682":109706},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3185":65410,"_28073":65398,"_5":28413,"_19451":109708,"_26530":109709,"_2682":109710},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3185":65411,"_28073":65398,"_19451":109712,"_5":13353,"_26530":65398,"_2682":109713},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3185":65412,"_28073":65398,"_19451":109715,"_5":13353,"_26530":65398,"_2682":109716},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3185":65413,"_28073":65398,"_19451":109718,"_5":13353,"_26530":109669,"_2682":109719},[],"Vista operativa",{"_3185":65414,"_28073":65398,"_19451":109721,"_5":13353,"_26530":109669,"_2682":109722},[],"Interpretación",{"_3185":65415,"_28073":65398,"_19451":109724,"_5":13353,"_26530":109669,"_2682":48075},[],{"_3185":65416,"_28073":65398,"_19451":109726,"_5":13353,"_26530":109669,"_2682":109727},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3185":65417,"_28073":65398,"_19451":109729,"_5":13353,"_26530":109669,"_2682":48081},[],{"_3185":65418,"_28073":65398,"_19451":109731,"_5":13353,"_26530":109669,"_2682":109732},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3185":65419,"_28073":65398,"_19451":109734,"_5":13353,"_26530":109669,"_2682":48087},[],{"_3185":65420,"_28073":65398,"_19451":109736,"_5":13353,"_26530":109669,"_2682":109737},[],"La identidad está en la ventana operativa de renovación.",{"_3185":65421,"_28073":65398,"_19451":109739,"_5":13353,"_26530":109669,"_2682":48093},[],{"_3185":65422,"_28073":65398,"_19451":109741,"_5":13353,"_26530":109669,"_2682":109742},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3185":65423,"_28073":65398,"_19451":109744,"_5":13353,"_26530":109669,"_2682":48099},[],{"_3185":65424,"_28073":65398,"_19451":109746,"_5":13353,"_26530":109669,"_2682":109747},[],"La identidad ha vencido.",{"_3185":65425,"_28073":65398,"_19451":109749,"_5":13353,"_26530":109669,"_2682":48105},[],{"_3185":65426,"_28073":65398,"_19451":109751,"_5":13353,"_26530":109669,"_2682":109752},[],"La identidad está marcada como revocada.",{"_3185":65427,"_28073":65398,"_19451":109754,"_5":13353,"_26530":109669,"_2682":48111},[],{"_3185":65428,"_28073":65398,"_19451":109756,"_5":13353,"_26530":109669,"_2682":109757},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3185":65429,"_28073":65398,"_19451":109759,"_5":13353,"_26530":109669,"_2682":109760},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3185":65430,"_28073":65398,"_19451":109762,"_5":13353,"_26530":109673,"_2682":109763},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3185":65431,"_28073":65398,"_19451":109765,"_5":13353,"_26530":109673,"_2682":109766},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3185":65432,"_28073":65398,"_19451":109768,"_5":13353,"_26530":109673,"_2682":109769},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3185":65433,"_28073":65398,"_19451":109771,"_5":13353,"_26530":109673,"_2682":109772},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3185":65434,"_28073":65398,"_19451":109774,"_5":13353,"_26530":109677,"_2682":109775},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3185":65435,"_28073":65398,"_19451":109777,"_5":13353,"_26530":109681,"_2682":109778},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3185":65436,"_28073":65398,"_19451":109780,"_5":13353,"_26530":109685,"_2682":109781},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3185":65437,"_28073":65398,"_19451":109783,"_5":13353,"_26530":109689,"_2682":109784},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3185":65438,"_28073":65398,"_19451":109786,"_5":13353,"_26530":109693,"_2682":109787},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3185":65439,"_28073":65398,"_19451":109789,"_5":13353,"_26530":109693,"_2682":109790},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3185":65440,"_28073":65398,"_19451":109792,"_5":13353,"_26530":109697,"_2682":109793},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3185":65441,"_28073":65398,"_19451":109795,"_5":13353,"_26530":109697,"_2682":109796},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3185":65442,"_28073":65398,"_19451":109798,"_5":13353,"_26530":109697,"_2682":109799},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3185":65443,"_28073":65398,"_19451":109801,"_5":13353,"_26530":109697,"_2682":109802},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3185":65444,"_28073":65398,"_19451":109804,"_5":13353,"_26530":109697,"_2682":109805},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3185":65445,"_28073":65398,"_19451":109807,"_5":13353,"_26530":109697,"_2682":109808},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3185":65446,"_28073":65398,"_19451":109810,"_5":13353,"_26530":109701,"_2682":109811},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3185":65447,"_28073":65398,"_19451":109813,"_5":13353,"_26530":109701,"_2682":109814},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3185":65448,"_28073":65398,"_19451":109816,"_5":13353,"_26530":109705,"_2682":109817},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3185":65449,"_28073":65398,"_19451":109819,"_5":13353,"_26530":109705,"_2682":109820},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3185":65450,"_28073":65398,"_19451":109822,"_5":13353,"_26530":109705,"_2682":109823},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3185":65451,"_28073":65398,"_19451":109825,"_5":13353,"_26530":109705,"_2682":109826},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3185":65452,"_28073":65398,"_19451":109828,"_5":13353,"_26530":109709,"_2682":109829},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3185":65453,"_28073":65398,"_19451":109831,"_5":13353,"_26530":109709,"_2682":109832},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3185":65454,"_28073":65454,"_5":13700,"_2682":109834,"_28416":109835,"_19451":109837,"_26530":65454},"Identidad inicial y autenticación",[45599,108686,48012,109661,109836],"Enrolamiento con PKI",[],{"_3185":65455,"_28073":65454,"_19451":109839,"_5":13353,"_26530":65454,"_2682":109840},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3185":65456,"_28073":65454,"_5":28413,"_19451":109842,"_26530":109843,"_2682":109844},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3185":65457,"_28073":65454,"_5":28413,"_19451":109846,"_26530":109847,"_2682":109848},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3185":65458,"_28073":65454,"_5":28413,"_19451":109850,"_26530":109851,"_2682":109852},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3185":65459,"_28073":65454,"_5":28413,"_19451":109854,"_26530":109855,"_2682":109856},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3185":65460,"_28073":65454,"_5":28413,"_19451":109858,"_26530":109859,"_2682":109860},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3185":65461,"_28073":65454,"_19451":109862,"_5":13353,"_26530":65454,"_2682":109863},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3185":65462,"_28073":65454,"_19451":109865,"_5":13353,"_26530":109843,"_2682":109866},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3185":65463,"_28073":65454,"_19451":109868,"_5":13353,"_26530":109843,"_2682":109869},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3185":65464,"_28073":65454,"_19451":109871,"_5":13353,"_26530":109847,"_2682":109872},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3185":65465,"_28073":65454,"_19451":109874,"_5":13353,"_26530":109847,"_2682":109875},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3185":65466,"_28073":65454,"_19451":109877,"_5":13353,"_26530":109847,"_2682":109878},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3185":65467,"_28073":65454,"_19451":109880,"_5":13353,"_26530":109851,"_2682":109881},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3185":65468,"_28073":65454,"_19451":109883,"_5":13353,"_26530":109851,"_2682":109884},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3185":65469,"_28073":65454,"_19451":109886,"_5":13353,"_26530":109855,"_2682":109887},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3185":65470,"_28073":65454,"_19451":109889,"_5":13353,"_26530":109855,"_2682":109890},[],"Ejemplo de cuerpo:",{"_3185":65471,"_28073":65454,"_19451":109892,"_5":13353,"_26530":109855,"_2682":109893},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3185":65472,"_28073":65454,"_19451":109895,"_5":13353,"_26530":109855,"_2682":109896},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3185":65473,"_28073":65454,"_19451":109898,"_5":13353,"_26530":109855,"_2682":109899},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3185":65474,"_28073":65454,"_19451":109901,"_5":13353,"_26530":109855,"_2682":109902},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3185":65475,"_28073":65454,"_19451":109904,"_5":13353,"_26530":109859,"_2682":109905},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3185":65476,"_28073":65454,"_19451":109907,"_5":13353,"_26530":109859,"_2682":109908},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3185":65477,"_28073":65477,"_5":13700,"_2682":109910,"_28416":109911,"_19451":109912,"_26530":65477},"Configura y opera el DMS",[45599,108686,48012,109661,109836],[],{"_3185":65478,"_28073":65477,"_19451":109914,"_5":13353,"_26530":65477,"_2682":109915},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3185":65479,"_28073":65477,"_5":28413,"_19451":109917,"_26530":109918,"_2682":107296},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3185":65480,"_28073":65477,"_5":28413,"_19451":109920,"_26530":109921,"_2682":109922},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3185":65481,"_28073":65477,"_5":28413,"_19451":109924,"_26530":109925,"_2682":109926},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3185":65482,"_28073":65477,"_5":28413,"_19451":109928,"_26530":109929,"_2682":109930},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3185":65483,"_28073":65477,"_5":28413,"_19451":109932,"_26530":109933,"_2682":109934},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3185":65484,"_28073":65477,"_5":28413,"_19451":109936,"_26530":109937,"_2682":109938},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3185":65485,"_28073":65477,"_5":28413,"_19451":109940,"_26530":109941,"_2682":109942},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3185":65486,"_28073":65477,"_5":28413,"_19451":109944,"_26530":109945,"_2682":109946},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3185":65487,"_28073":65477,"_5":28413,"_19451":109948,"_26530":109949,"_2682":48307},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3185":65488,"_28073":65477,"_5":28413,"_19451":109951,"_26530":109952,"_2682":48311},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3185":65489,"_28073":65477,"_5":28413,"_19451":109954,"_26530":109955,"_2682":109956},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3185":65490,"_28073":65477,"_5":28413,"_19451":109958,"_26530":109959,"_2682":109960},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3185":65491,"_28073":65477,"_5":28413,"_19451":109962,"_26530":109963,"_2682":109964},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3185":65492,"_28073":65477,"_5":28413,"_19451":109966,"_26530":109967,"_2682":109968},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3185":65493,"_28073":65477,"_5":28413,"_19451":109970,"_26530":109971,"_2682":48331},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3185":65494,"_28073":65477,"_5":28413,"_19451":109973,"_26530":109974,"_2682":109975},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3185":65495,"_28073":65477,"_5":28413,"_19451":109977,"_26530":109978,"_2682":109979},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3185":65496,"_28073":65477,"_5":28413,"_19451":109981,"_26530":109982,"_2682":109983},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3185":65497,"_28073":65477,"_19451":109985,"_5":13353,"_26530":65477,"_2682":109986},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3185":65498,"_28073":65477,"_19451":109988,"_5":13353,"_26530":109918,"_2682":109989},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3185":65499,"_28073":65477,"_19451":109991,"_5":13353,"_26530":109918,"_2682":109992},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3185":65500,"_28073":65477,"_19451":109994,"_5":13353,"_26530":109925,"_2682":109995},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3185":65501,"_28073":65477,"_19451":109997,"_5":13353,"_26530":109929,"_2682":109998},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3185":65502,"_28073":65477,"_19451":110000,"_5":13353,"_26530":109933,"_2682":110001},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3185":65503,"_28073":65477,"_19451":110003,"_5":13353,"_26530":109937,"_2682":110004},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3185":65504,"_28073":65477,"_19451":110006,"_5":13353,"_26530":109941,"_2682":110007},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3185":65505,"_28073":65477,"_19451":110009,"_5":13353,"_26530":109949,"_2682":110010},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3185":65506,"_28073":65477,"_19451":110012,"_5":13353,"_26530":109949,"_2682":110013},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3185":65507,"_28073":65477,"_19451":110015,"_5":13353,"_26530":109952,"_2682":110016},[],"Campo de `settings.enrollment_settings`",{"_3185":65508,"_28073":65477,"_19451":110018,"_5":13353,"_26530":109952,"_2682":110019},[],"Decisión",{"_3185":65509,"_28073":65477,"_19451":110021,"_5":13353,"_26530":109952,"_2682":48382},[],{"_3185":65510,"_28073":65477,"_19451":110023,"_5":13353,"_26530":109952,"_2682":110024},[],"`EST_RFC7030` para estas operaciones.",{"_3185":65511,"_28073":65477,"_19451":110026,"_5":13353,"_26530":109952,"_2682":48388},[],{"_3185":65512,"_28073":65477,"_19451":110028,"_5":13353,"_26530":109952,"_2682":110029},[],"ID de la CA que firmará.",{"_3185":65513,"_28073":65477,"_19451":110031,"_5":13353,"_26530":109952,"_2682":48394},[],{"_3185":65514,"_28073":65477,"_19451":110033,"_5":13353,"_26530":109952,"_2682":110034},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3185":65515,"_28073":65477,"_19451":110036,"_5":13353,"_26530":109952,"_2682":48400},[],{"_3185":65516,"_28073":65477,"_19451":110038,"_5":13353,"_26530":109952,"_2682":110039},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3185":65517,"_28073":65477,"_19451":110041,"_5":13353,"_26530":109952,"_2682":48406},[],{"_3185":65518,"_28073":65477,"_19451":110043,"_5":13353,"_26530":109952,"_2682":110044},[],"Uno de los cuatro modos de autenticación.",{"_3185":65519,"_28073":65477,"_19451":110046,"_5":13353,"_26530":109952,"_2682":110047},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3185":65520,"_28073":65477,"_19451":110049,"_5":13353,"_26530":109955,"_2682":110050},[],"Los bloques son independientes:",{"_3185":65521,"_28073":65477,"_19451":110052,"_5":13353,"_26530":109955,"_2682":110053},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3185":65522,"_28073":65477,"_19451":110055,"_5":13353,"_26530":109955,"_2682":110056},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3185":65523,"_28073":65477,"_19451":110058,"_5":13353,"_26530":109955,"_2682":48424},[],{"_3185":65524,"_28073":65477,"_19451":110060,"_5":13353,"_26530":109955,"_2682":110061},[],"Control aplicado en la operación configurada",{"_3185":65525,"_28073":65477,"_19451":110063,"_5":13353,"_26530":109955,"_2682":48430},[],{"_3185":65526,"_28073":65477,"_19451":110065,"_5":13353,"_26530":109955,"_2682":110066},[],"Validación del certificado presentado.",{"_3185":65527,"_28073":65477,"_19451":110068,"_5":13353,"_26530":109955,"_2682":48436},[],{"_3185":65528,"_28073":65477,"_19451":110070,"_5":13353,"_26530":109955,"_2682":110071},[],"Autorización del webhook configurado.",{"_3185":65529,"_28073":65477,"_19451":110073,"_5":13353,"_26530":109955,"_2682":48442},[],{"_3185":65530,"_28073":65477,"_19451":110075,"_5":13353,"_26530":109955,"_2682":110076},[],"Validación del certificado y, después, aprobación del webhook.",{"_3185":65531,"_28073":65477,"_19451":110078,"_5":13353,"_26530":109955,"_2682":48448},[],{"_3185":65532,"_28073":65477,"_19451":110080,"_5":13353,"_26530":109955,"_2682":110081},[],"Sin autenticación del solicitante por el DMS.",{"_3185":65533,"_28073":65477,"_19451":110083,"_5":13353,"_26530":109955,"_2682":110084},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3185":65534,"_28073":65477,"_19451":110086,"_5":13353,"_26530":109955,"_2682":110087},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3185":65535,"_28073":65477,"_19451":110089,"_5":13353,"_26530":109955,"_2682":110090},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3185":65536,"_28073":65477,"_19451":110092,"_5":13353,"_26530":109955,"_2682":110093},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3185":65537,"_28073":65477,"_19451":110095,"_5":13353,"_26530":109959,"_2682":110096},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3185":65538,"_28073":65477,"_19451":110098,"_5":13353,"_26530":109959,"_2682":110099},[],"Campo de `external_webhook_settings`",{"_3185":65539,"_28073":65477,"_19451":110101,"_5":13353,"_26530":109959,"_2682":110019},[],{"_3185":65540,"_28073":65477,"_19451":110103,"_5":13353,"_26530":109959,"_2682":48474},[],{"_3185":65541,"_28073":65477,"_19451":110105,"_5":13353,"_26530":109959,"_2682":110106},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3185":65542,"_28073":65477,"_19451":110108,"_5":13353,"_26530":109959,"_2682":48480},[],{"_3185":65543,"_28073":65477,"_19451":110110,"_5":13353,"_26530":109959,"_2682":110111},[],"`POST` o `PUT`; `POST` por defecto.",{"_3185":65544,"_28073":65477,"_19451":110113,"_5":13353,"_26530":109959,"_2682":48486},[],{"_3185":65545,"_28073":65477,"_19451":110115,"_5":13353,"_26530":109959,"_2682":110116},[],"Etiqueta usada en los logs del servicio.",{"_3185":65546,"_28073":65477,"_19451":110118,"_5":13353,"_26530":109959,"_2682":48492},[],{"_3185":65547,"_28073":65477,"_19451":110120,"_5":13353,"_26530":109959,"_2682":110121},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3185":65548,"_28073":65477,"_19451":110123,"_5":13353,"_26530":109959,"_2682":48498},[],{"_3185":65549,"_28073":65477,"_19451":110125,"_5":13353,"_26530":109959,"_2682":110126},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3185":65550,"_28073":65477,"_19451":110128,"_5":13353,"_26530":109959,"_2682":48504},[],{"_3185":65551,"_28073":65477,"_19451":110130,"_5":13353,"_26530":109959,"_2682":110131},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3185":65552,"_28073":65477,"_19451":110133,"_5":13353,"_26530":109959,"_2682":48510},[],{"_3185":65553,"_28073":65477,"_19451":110135,"_5":13353,"_26530":109959,"_2682":110136},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3185":65554,"_28073":65477,"_19451":110138,"_5":13353,"_26530":109959,"_2682":48516},[],{"_3185":65555,"_28073":65477,"_19451":110140,"_5":13353,"_26530":109959,"_2682":110141},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3185":65556,"_28073":65477,"_19451":110143,"_5":13353,"_26530":109959,"_2682":48522},[],{"_3185":65557,"_28073":65477,"_19451":110145,"_5":13353,"_26530":109959,"_2682":110146},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3185":65558,"_28073":65477,"_19451":110148,"_5":13353,"_26530":109959,"_2682":110149},[],"Reglas de esa configuración:",{"_3185":65559,"_28073":65477,"_19451":110151,"_5":13353,"_26530":109959,"_2682":110152},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3185":65560,"_28073":65477,"_19451":110154,"_5":13353,"_26530":109959,"_2682":110155},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3185":65561,"_28073":65477,"_19451":110157,"_5":13353,"_26530":109959,"_2682":110158},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3185":65562,"_28073":65477,"_19451":110160,"_5":13353,"_26530":109959,"_2682":110161},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3185":65563,"_28073":65477,"_19451":110163,"_5":13353,"_26530":109959,"_2682":110164},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3185":65564,"_28073":65477,"_19451":110166,"_5":13353,"_26530":109959,"_2682":110167},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3185":65565,"_28073":65477,"_19451":110169,"_5":13353,"_26530":109959,"_2682":110170},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar, y si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_3185":65566,"_28073":65477,"_19451":110172,"_5":13353,"_26530":109959,"_2682":110173},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3185":65567,"_28073":65477,"_19451":110175,"_5":13353,"_26530":109959,"_2682":110176},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3185":65568,"_28073":65477,"_19451":110178,"_5":13353,"_26530":109963,"_2682":110179},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3185":65569,"_28073":65477,"_19451":110181,"_5":13353,"_26530":109967,"_2682":110182},[],"Campo de `settings.reenrollment_settings`",{"_3185":65570,"_28073":65477,"_19451":110184,"_5":13353,"_26530":109967,"_2682":110185},[],"Función",{"_3185":65571,"_28073":65477,"_19451":110187,"_5":13353,"_26530":109967,"_2682":48566},[],{"_3185":65572,"_28073":65477,"_19451":110189,"_5":13353,"_26530":109967,"_2682":110190},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3185":65573,"_28073":65477,"_19451":110192,"_5":13353,"_26530":109967,"_2682":48572},[],{"_3185":65574,"_28073":65477,"_19451":110194,"_5":13353,"_26530":109967,"_2682":110195},[],"Umbral operativo preventivo de monitorización.",{"_3185":65575,"_28073":65477,"_19451":110197,"_5":13353,"_26530":109967,"_2682":48578},[],{"_3185":65576,"_28073":65477,"_19451":110199,"_5":13353,"_26530":109967,"_2682":110200},[],"Umbral operativo crítico de monitorización.",{"_3185":65577,"_28073":65477,"_19451":110202,"_5":13353,"_26530":109967,"_2682":48584},[],{"_3185":65578,"_28073":65477,"_19451":110204,"_5":13353,"_26530":109967,"_2682":110205},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3185":65579,"_28073":65477,"_19451":110207,"_5":13353,"_26530":109967,"_2682":48590},[],{"_3185":65580,"_28073":65477,"_19451":110209,"_5":13353,"_26530":109967,"_2682":110210},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3185":65581,"_28073":65477,"_19451":110212,"_5":13353,"_26530":109967,"_2682":48596},[],{"_3185":65582,"_28073":65477,"_19451":110214,"_5":13353,"_26530":109967,"_2682":110215},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3185":65583,"_28073":65477,"_19451":110217,"_5":13353,"_26530":109967,"_2682":110218},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3185":65584,"_28073":65477,"_19451":110220,"_5":13353,"_26530":109971,"_2682":110221},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3185":65585,"_28073":65477,"_19451":110223,"_5":13353,"_26530":109974,"_2682":107660},[],{"_3185":65586,"_28073":65477,"_19451":110225,"_5":13353,"_26530":109974,"_2682":110226},[],"Qué publica",{"_3185":65587,"_28073":65477,"_19451":110228,"_5":13353,"_26530":109974,"_2682":48613},[],{"_3185":65588,"_28073":65477,"_19451":110230,"_5":13353,"_26530":109974,"_2682":110231},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3185":65589,"_28073":65477,"_19451":110233,"_5":13353,"_26530":109974,"_2682":48619},[],{"_3185":65590,"_28073":65477,"_19451":110235,"_5":13353,"_26530":109974,"_2682":110236},[],"Certificado de la CA emisora seleccionada.",{"_3185":65591,"_28073":65477,"_19451":110238,"_5":13353,"_26530":109974,"_2682":48625},[],{"_3185":65592,"_28073":65477,"_19451":110240,"_5":13353,"_26530":109974,"_2682":110241},[],"Certificados de las CAs elegidas explícitamente.",{"_3185":65593,"_28073":65477,"_19451":110243,"_5":13353,"_26530":109974,"_2682":110244},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3185":65594,"_28073":65477,"_19451":110246,"_5":13353,"_26530":109978,"_2682":110247},[],"**Edit** cambia nombre, ajustes y metadatos. Al usar la API, lee el DMS antes de editarlo: `name` y `settings` se sustituyen por completo. `metadata` omitido o `null` conserva el almacenado, y un objeto lo sustituye por completo. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3185":65595,"_28073":65477,"_19451":110249,"_5":13353,"_26530":109978,"_2682":110250},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3185":65596,"_28073":65477,"_19451":110252,"_5":13353,"_26530":109978,"_2682":110253},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3185":65597,"_28073":65477,"_19451":110255,"_5":13353,"_26530":109982,"_2682":110256},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3185":65598,"_28073":65598,"_5":13700,"_2682":110258,"_28416":110259,"_19451":110260,"_26530":65598},"Integra el cliente EST",[45599,108686,48012,109661,109836],[],{"_3185":65599,"_28073":65598,"_19451":110262,"_5":13353,"_26530":65598,"_2682":110263},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3185":65600,"_28073":65598,"_5":28413,"_19451":110265,"_26530":110266,"_2682":107296},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3185":65601,"_28073":65598,"_5":28413,"_19451":110268,"_26530":110269,"_2682":110270},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3185":65602,"_28073":65598,"_5":28413,"_19451":110272,"_26530":110273,"_2682":110274},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3185":65603,"_28073":65598,"_5":28413,"_19451":110276,"_26530":110277,"_2682":110278},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3185":65604,"_28073":65598,"_5":28413,"_19451":110280,"_26530":110281,"_2682":110282},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3185":65605,"_28073":65598,"_5":28413,"_19451":110284,"_26530":110285,"_2682":110286},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3185":65606,"_28073":65598,"_19451":110288,"_5":13353,"_26530":65598,"_2682":110289},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3185":65607,"_28073":65598,"_19451":110291,"_5":13353,"_26530":110266,"_2682":110292},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3185":65608,"_28073":65598,"_19451":110294,"_5":13353,"_26530":110266,"_2682":110295},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3185":65609,"_28073":65598,"_19451":110297,"_5":13353,"_26530":110266,"_2682":110298},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3185":65610,"_28073":65598,"_19451":110300,"_5":13353,"_26530":110269,"_2682":110301},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3185":65611,"_28073":65598,"_19451":110303,"_5":13353,"_26530":110269,"_2682":110304},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3185":65612,"_28073":65598,"_19451":110306,"_5":13353,"_26530":110273,"_2682":110307},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3185":65613,"_28073":65598,"_19451":110309,"_5":13353,"_26530":110273,"_2682":110310},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3185":65614,"_28073":65598,"_19451":110312,"_5":13353,"_26530":110277,"_2682":110313},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3185":65615,"_28073":65598,"_19451":110315,"_5":13353,"_26530":110277,"_2682":110316},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3185":65616,"_28073":65598,"_19451":110318,"_5":13353,"_26530":110281,"_2682":110319},[],"Para el caso de una raíz que emite directamente:",{"_3185":65617,"_28073":65598,"_19451":110321,"_5":13353,"_26530":110281,"_2682":110322},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3185":65618,"_28073":65598,"_19451":110324,"_5":13353,"_26530":110281,"_2682":110325},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3185":65619,"_28073":65598,"_19451":110327,"_5":13353,"_26530":110285,"_2682":110328},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3185":65620,"_28073":65620,"_5":13700,"_2682":110330,"_28416":110331,"_19451":110332,"_26530":65620},"Referencia EST",[45599,108686,48012,109661,109836],[],{"_3185":65621,"_28073":65620,"_19451":110334,"_5":13353,"_26530":65620,"_2682":110335},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3185":65622,"_28073":65620,"_5":28413,"_19451":110337,"_26530":110338,"_2682":110339},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3185":65623,"_28073":65620,"_5":28413,"_19451":110341,"_26530":110342,"_2682":21131},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3185":65624,"_28073":65620,"_5":28413,"_19451":110344,"_26530":110345,"_2682":24242},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3185":65625,"_28073":65620,"_5":28413,"_19451":110347,"_26530":110348,"_2682":24249},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3185":65626,"_28073":65620,"_5":28413,"_19451":110350,"_26530":110351,"_2682":23588},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3185":65627,"_28073":65620,"_5":28413,"_19451":110353,"_26530":110354,"_2682":110355},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3185":65628,"_28073":65620,"_5":28413,"_19451":110357,"_26530":110358,"_2682":110359},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3185":65629,"_28073":65620,"_5":28413,"_19451":110361,"_26530":110362,"_2682":110363},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3185":65630,"_28073":65620,"_19451":110365,"_5":13353,"_26530":65620,"_2682":110366},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3185":65631,"_28073":65620,"_19451":110368,"_5":13353,"_26530":110338,"_2682":110369},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3185":65632,"_28073":65620,"_19451":110371,"_5":13353,"_26530":110338,"_2682":108449},[],{"_3185":65633,"_28073":65620,"_19451":110373,"_5":13353,"_26530":110338,"_2682":110374},[],"Método",{"_3185":65634,"_28073":65620,"_19451":110376,"_5":13353,"_26530":110338,"_2682":110377},[],"Autenticación y condición",{"_3185":65635,"_28073":65620,"_19451":110379,"_5":13353,"_26530":110338,"_2682":48768},[],{"_3185":65636,"_28073":65620,"_19451":110381,"_5":13353,"_26530":110338,"_2682":48771},[],{"_3185":65637,"_28073":65620,"_19451":110383,"_5":13353,"_26530":110338,"_2682":110384},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3185":65638,"_28073":65620,"_19451":110386,"_5":13353,"_26530":110338,"_2682":48777},[],{"_3185":65639,"_28073":65620,"_19451":110388,"_5":13353,"_26530":110338,"_2682":48780},[],{"_3185":65640,"_28073":65620,"_19451":110390,"_5":13353,"_26530":110338,"_2682":110391},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3185":65641,"_28073":65620,"_19451":110393,"_5":13353,"_26530":110338,"_2682":48786},[],{"_3185":65642,"_28073":65620,"_19451":110395,"_5":13353,"_26530":110338,"_2682":48780},[],{"_3185":65643,"_28073":65620,"_19451":110397,"_5":13353,"_26530":110338,"_2682":110398},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3185":65644,"_28073":65620,"_19451":110400,"_5":13353,"_26530":110338,"_2682":48794},[],{"_3185":65645,"_28073":65620,"_19451":110402,"_5":13353,"_26530":110338,"_2682":48780},[],{"_3185":65646,"_28073":65620,"_19451":110404,"_5":13353,"_26530":110338,"_2682":110405},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3185":65647,"_28073":65620,"_19451":110407,"_5":13353,"_26530":110338,"_2682":110408},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3185":65648,"_28073":65620,"_19451":110410,"_5":13353,"_26530":110342,"_2682":110411},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3185":65649,"_28073":65620,"_19451":110413,"_5":13353,"_26530":110342,"_2682":110414},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3185":65650,"_28073":65620,"_19451":110416,"_5":13353,"_26530":110345,"_2682":110417},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3185":65651,"_28073":65620,"_19451":110419,"_5":13353,"_26530":110345,"_2682":110420},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3185":65652,"_28073":65620,"_19451":110422,"_5":13353,"_26530":110348,"_2682":110423},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3185":65653,"_28073":65620,"_19451":110425,"_5":13353,"_26530":110348,"_2682":110426},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3185":65654,"_28073":65620,"_19451":110428,"_5":13353,"_26530":110351,"_2682":110429},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3185":65655,"_28073":65620,"_19451":110431,"_5":13353,"_26530":110351,"_2682":110432},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3185":65656,"_28073":65620,"_19451":110434,"_5":13353,"_26530":110354,"_2682":110435},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3185":65657,"_28073":65620,"_19451":110437,"_5":13353,"_26530":110354,"_2682":110438},[],"Parte",{"_3185":65658,"_28073":65620,"_19451":110440,"_5":13353,"_26530":110354,"_2682":110441},[],"Contenido tras decodificar su Base64",{"_3185":65659,"_28073":65620,"_19451":110443,"_5":13353,"_26530":110354,"_2682":48838},[],{"_3185":65660,"_28073":65620,"_19451":110445,"_5":13353,"_26530":110354,"_2682":110446},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3185":65661,"_28073":65620,"_19451":110448,"_5":13353,"_26530":110354,"_2682":48844},[],{"_3185":65662,"_28073":65620,"_19451":110450,"_5":13353,"_26530":110354,"_2682":110451},[],"PKCS#7 DER con el certificado emitido.",{"_3185":65663,"_28073":65620,"_19451":110453,"_5":13353,"_26530":110354,"_2682":110454},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3185":65664,"_28073":65620,"_19451":110456,"_5":13353,"_26530":110358,"_2682":110457},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3185":65665,"_28073":65620,"_19451":110459,"_5":13353,"_26530":110358,"_2682":110460},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3185":65666,"_28073":65620,"_19451":110462,"_5":13353,"_26530":110358,"_2682":110463},[],"Convierte y comprueba el resultado:",{"_3185":65667,"_28073":65620,"_19451":110465,"_5":13353,"_26530":110358,"_2682":110466},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3185":65668,"_28073":65620,"_19451":110468,"_5":13353,"_26530":110362,"_2682":110469},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3185":65669,"_28073":65620,"_19451":110471,"_5":13353,"_26530":110362,"_2682":110472},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3185":65670,"_28073":65670,"_5":13700,"_2682":109836,"_28416":110474,"_19451":110475,"_26530":65670},[45599,108686,48012,109661,109836],[],{"_3185":65671,"_28073":65670,"_19451":110477,"_5":13353,"_26530":65670,"_2682":110478},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3185":65672,"_28073":65670,"_5":28413,"_19451":110480,"_26530":110481,"_2682":110482},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3185":65673,"_28073":65670,"_5":28413,"_19451":110484,"_26530":110485,"_2682":110486},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3185":65674,"_28073":65670,"_5":28413,"_19451":110488,"_26530":110489,"_2682":110490},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3185":65675,"_28073":65670,"_5":28413,"_19451":110492,"_26530":110493,"_2682":110494},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3185":65676,"_28073":65670,"_19451":110496,"_5":13353,"_26530":65670,"_2682":110497},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3185":65677,"_28073":65670,"_19451":110499,"_5":13353,"_26530":110481,"_2682":110500},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3185":65678,"_28073":65670,"_19451":110502,"_5":13353,"_26530":110481,"_2682":110503},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3185":65679,"_28073":65670,"_19451":110505,"_5":13353,"_26530":110481,"_2682":110506},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3185":65680,"_28073":65670,"_19451":110508,"_5":13353,"_26530":110481,"_2682":110509},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3185":65681,"_28073":65670,"_19451":110511,"_5":13353,"_26530":110481,"_2682":110512},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3185":65682,"_28073":65670,"_19451":110514,"_5":13353,"_26530":110481,"_2682":110515},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3185":65683,"_28073":65670,"_19451":110517,"_5":13353,"_26530":110485,"_2682":110518},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3185":65684,"_28073":65670,"_19451":110520,"_5":13353,"_26530":110485,"_2682":110521},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3185":65685,"_28073":65670,"_19451":110523,"_5":13353,"_26530":110485,"_2682":110524},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3185":65686,"_28073":65670,"_19451":110526,"_5":13353,"_26530":110485,"_2682":110527},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3185":65687,"_28073":65670,"_19451":110529,"_5":13353,"_26530":110489,"_2682":110530},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3185":65688,"_28073":65670,"_19451":110532,"_5":13353,"_26530":110489,"_2682":110533},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3185":65689,"_28073":65670,"_19451":110535,"_5":13353,"_26530":110489,"_2682":110536},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3185":65690,"_28073":65670,"_19451":110538,"_5":13353,"_26530":110489,"_2682":110539},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3185":65691,"_28073":65670,"_19451":110541,"_5":13353,"_26530":110493,"_2682":110542},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3185":65692,"_28073":65670,"_19451":110544,"_5":13353,"_26530":110493,"_2682":110545},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3185":65693,"_28073":65693,"_5":13700,"_2682":110547,"_28416":110548,"_19451":110549,"_26530":65693},"Estrategias de aprovisionamiento",[45599,108686,48012,109661,109836],[],{"_3185":65694,"_28073":65693,"_19451":110551,"_5":13353,"_26530":65693,"_2682":110552},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3185":65695,"_28073":65693,"_5":28413,"_19451":110554,"_26530":110555,"_2682":110556},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3185":65696,"_28073":65693,"_5":28413,"_19451":110558,"_26530":110559,"_2682":110560},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3185":65697,"_28073":65693,"_5":28413,"_19451":110562,"_26530":110563,"_2682":110564},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3185":65698,"_28073":65693,"_5":28413,"_19451":110566,"_26530":110567,"_2682":110568},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3185":65699,"_28073":65693,"_5":28413,"_19451":110570,"_26530":110571,"_2682":110572},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3185":65700,"_28073":65693,"_19451":110574,"_5":13353,"_26530":65693,"_2682":110575},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3185":65701,"_28073":65693,"_19451":110577,"_5":13353,"_26530":110555,"_2682":110578},[],"Recorrido",{"_3185":65702,"_28073":65693,"_19451":110580,"_5":13353,"_26530":110555,"_2682":110581},[],"Cuándo existe el dispositivo",{"_3185":65703,"_28073":65693,"_19451":110583,"_5":13353,"_26530":110555,"_2682":110584},[],"Qué compruebas",{"_3185":65704,"_28073":65693,"_19451":110586,"_5":13353,"_26530":110555,"_2682":110587},[],"Asignación manual",{"_3185":65705,"_28073":65693,"_19451":110589,"_5":13353,"_26530":110555,"_2682":110590},[],"El operador lo crea antes de asociar un certificado.",{"_3185":65706,"_28073":65693,"_19451":110592,"_5":13353,"_26530":110555,"_2682":110593},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3185":65707,"_28073":65693,"_19451":110595,"_5":13353,"_26530":110555,"_2682":110596},[],"EST con `JITP`",{"_3185":65708,"_28073":65693,"_19451":110598,"_5":13353,"_26530":110555,"_2682":110599},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3185":65709,"_28073":65693,"_19451":110601,"_5":13353,"_26530":110555,"_2682":110602},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3185":65710,"_28073":65693,"_19451":110604,"_5":13353,"_26530":110555,"_2682":110605},[],"EST con `PRE_REGISTRATION`",{"_3185":65711,"_28073":65693,"_19451":110607,"_5":13353,"_26530":110555,"_2682":110608},[],"Debe existir antes de `/simpleenroll`.",{"_3185":65712,"_28073":65693,"_19451":110610,"_5":13353,"_26530":110555,"_2682":110611},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3185":65713,"_28073":65693,"_19451":110613,"_5":13353,"_26530":110555,"_2682":110614},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3185":65714,"_28073":65693,"_19451":110616,"_5":13353,"_26530":110555,"_2682":110617},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3185":65715,"_28073":65693,"_19451":110619,"_5":13353,"_26530":110559,"_2682":110620},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3185":65716,"_28073":65693,"_19451":110622,"_5":13353,"_26530":110559,"_2682":110623},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3185":65717,"_28073":65693,"_19451":110625,"_5":13353,"_26530":110559,"_2682":110626},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3185":65718,"_28073":65693,"_19451":110628,"_5":13353,"_26530":110563,"_2682":110629},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3185":65719,"_28073":65693,"_19451":110631,"_5":13353,"_26530":110563,"_2682":110632},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3185":65720,"_28073":65693,"_19451":110634,"_5":13353,"_26530":110563,"_2682":110635},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3185":65721,"_28073":65693,"_19451":110637,"_5":13353,"_26530":110563,"_2682":110638},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3185":65722,"_28073":65693,"_19451":110640,"_5":13353,"_26530":110563,"_2682":110641},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3185":65723,"_28073":65693,"_19451":110643,"_5":13353,"_26530":110563,"_2682":110644},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3185":65724,"_28073":65693,"_19451":110646,"_5":13353,"_26530":110567,"_2682":107660},[],{"_3185":65725,"_28073":65693,"_19451":110648,"_5":13353,"_26530":110567,"_2682":110649},[],"Material que atraviesa EST",{"_3185":65726,"_28073":65693,"_19451":110651,"_5":13353,"_26530":110567,"_2682":110652},[],"Clave generada por el dispositivo",{"_3185":65727,"_28073":65693,"_19451":110654,"_5":13353,"_26530":110567,"_2682":110655},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3185":65728,"_28073":65693,"_19451":110657,"_5":13353,"_26530":110567,"_2682":110658},[],"Clave ya disponible en el dispositivo",{"_3185":65729,"_28073":65693,"_19451":110660,"_5":13353,"_26530":110567,"_2682":110661},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3185":65730,"_28073":65693,"_19451":110663,"_5":13353,"_26530":110567,"_2682":48331},[],{"_3185":65731,"_28073":65693,"_19451":110665,"_5":13353,"_26530":110567,"_2682":110666},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3185":65732,"_28073":65693,"_19451":110668,"_5":13353,"_26530":110567,"_2682":110669},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3185":65733,"_28073":65693,"_19451":110671,"_5":13353,"_26530":110571,"_2682":110672},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3185":65734,"_28073":65734,"_5":13700,"_2682":110674,"_28416":110675,"_19451":110676,"_26530":65734},"Renovación y recuperación",[45599,108686,48012,109661,109836],[],{"_3185":65735,"_28073":65734,"_19451":110678,"_5":13353,"_26530":65734,"_2682":110679},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3185":65736,"_28073":65734,"_5":28413,"_19451":110681,"_26530":110682,"_2682":110683},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3185":65737,"_28073":65734,"_5":28413,"_19451":110685,"_26530":110686,"_2682":110687},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3185":65738,"_28073":65734,"_5":28413,"_19451":110689,"_26530":110690,"_2682":110691},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3185":65739,"_28073":65734,"_5":28413,"_19451":110693,"_26530":110694,"_2682":110695},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3185":65740,"_28073":65734,"_5":28413,"_19451":110697,"_26530":110698,"_2682":110699},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3185":65741,"_28073":65734,"_19451":110701,"_5":13353,"_26530":65734,"_2682":110702},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3185":65742,"_28073":65734,"_19451":110704,"_5":13353,"_26530":110682,"_2682":110705},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3185":65743,"_28073":65734,"_19451":110707,"_5":13353,"_26530":110682,"_2682":110708},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3185":65744,"_28073":65734,"_19451":110710,"_5":13353,"_26530":110682,"_2682":110711},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3185":65745,"_28073":65734,"_19451":110713,"_5":13353,"_26530":110682,"_2682":110714},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3185":65746,"_28073":65734,"_19451":110716,"_5":13353,"_26530":110686,"_2682":110717},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3185":65747,"_28073":65734,"_19451":110719,"_5":13353,"_26530":110686,"_2682":110720},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3185":65748,"_28073":65734,"_19451":110722,"_5":13353,"_26530":110690,"_2682":110723},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3185":65749,"_28073":65734,"_19451":110725,"_5":13353,"_26530":110690,"_2682":110726},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3185":65750,"_28073":65734,"_19451":110728,"_5":13353,"_26530":110690,"_2682":110729},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3185":65751,"_28073":65734,"_19451":110731,"_5":13353,"_26530":110694,"_2682":110732},[],"Situación",{"_3185":65752,"_28073":65734,"_19451":110734,"_5":13353,"_26530":110694,"_2682":110735},[],"Procedimiento",{"_3185":65753,"_28073":65734,"_19451":110737,"_5":13353,"_26530":110694,"_2682":110738},[],"Certificado vigente, fuera de ventana",{"_3185":65754,"_28073":65734,"_19451":110740,"_5":13353,"_26530":110694,"_2682":110741},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3185":65755,"_28073":65734,"_19451":110743,"_5":13353,"_26530":110694,"_2682":110744},[],"Certificado vencido, clave disponible",{"_3185":65756,"_28073":65734,"_19451":110746,"_5":13353,"_26530":110694,"_2682":110747},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3185":65757,"_28073":65734,"_19451":110749,"_5":13353,"_26530":110694,"_2682":110750},[],"Renovación por webhook o `NO_AUTH`",{"_3185":65758,"_28073":65734,"_19451":110752,"_5":13353,"_26530":110694,"_2682":110753},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3185":65759,"_28073":65734,"_19451":110755,"_5":13353,"_26530":110694,"_2682":110756},[],"Clave perdida o inaccesible",{"_3185":65760,"_28073":65734,"_19451":110758,"_5":13353,"_26530":110694,"_2682":110759},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3185":65761,"_28073":65734,"_19451":110761,"_5":13353,"_26530":110694,"_2682":110762},[],"Identidad actual revocada",{"_3185":65762,"_28073":65734,"_19451":110764,"_5":13353,"_26530":110694,"_2682":110765},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3185":65763,"_28073":65734,"_19451":110767,"_5":13353,"_26530":110694,"_2682":110768},[],"Dispositivo sin identidad",{"_3185":65764,"_28073":65734,"_19451":110770,"_5":13353,"_26530":110694,"_2682":110771},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3185":65765,"_28073":65734,"_19451":110773,"_5":13353,"_26530":110694,"_2682":110774},[],"Dispositivo retirado",{"_3185":65766,"_28073":65734,"_19451":110776,"_5":13353,"_26530":110694,"_2682":110777},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3185":65767,"_28073":65734,"_19451":110779,"_5":13353,"_26530":110694,"_2682":110780},[],"Timeout, HTTP 500 o fallo de instalación",{"_3185":65768,"_28073":65734,"_19451":110782,"_5":13353,"_26530":110694,"_2682":110783},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3185":65769,"_28073":65734,"_19451":110785,"_5":13353,"_26530":110698,"_2682":110786},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3185":65770,"_28073":65734,"_19451":110788,"_5":13353,"_26530":110698,"_2682":110789},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3185":65771,"_28073":65771,"_5":13700,"_2682":110791,"_28416":110792,"_19451":110793,"_26530":65771},"Diagnóstico de enrolamiento",[45599,108686,48012,109661,109836],[],{"_3185":65772,"_28073":65771,"_19451":110795,"_5":13353,"_26530":65771,"_2682":110796},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3185":65773,"_28073":65771,"_5":28413,"_19451":110798,"_26530":110799,"_2682":110800},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3185":65774,"_28073":65771,"_5":28413,"_19451":110802,"_26530":110803,"_2682":110804},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3185":65775,"_28073":65771,"_5":28413,"_19451":110806,"_26530":110807,"_2682":110363},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3185":65776,"_28073":65771,"_5":28413,"_19451":110809,"_26530":110810,"_2682":110811},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3185":65777,"_28073":65771,"_19451":110813,"_5":13353,"_26530":65771,"_2682":110814},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3185":65778,"_28073":65771,"_19451":110816,"_5":13353,"_26530":110803,"_2682":110817},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3185":65779,"_28073":65771,"_19451":110819,"_5":13353,"_26530":110803,"_2682":110820},[],"Síntoma o mensaje",{"_3185":65780,"_28073":65771,"_19451":110822,"_5":13353,"_26530":110803,"_2682":110823},[],"Qué revisar",{"_3185":65781,"_28073":65771,"_19451":110825,"_5":13353,"_26530":110803,"_2682":110826},[],"curl rechaza TLS, nombre o emisor",{"_3185":65782,"_28073":65771,"_19451":110828,"_5":13353,"_26530":110803,"_2682":110829},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3185":65783,"_28073":65771,"_19451":110831,"_5":13353,"_26530":110803,"_2682":110832},[],"404 o APS ausente",{"_3185":65784,"_28073":65771,"_19451":110834,"_5":13353,"_26530":110803,"_2682":110835},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3185":65785,"_28073":65771,"_19451":110837,"_5":13353,"_26530":110803,"_2682":110838},[],"400, error de CSR o formato",{"_3185":65786,"_28073":65771,"_19451":110840,"_5":13353,"_26530":110803,"_2682":110841},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3185":65787,"_28073":65771,"_19451":110843,"_5":13353,"_26530":110803,"_2682":110844},[],"Credencial ausente o certificado no válido",{"_3185":65788,"_28073":65771,"_19451":110846,"_5":13353,"_26530":110803,"_2682":110847},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3185":65789,"_28073":65771,"_19451":110849,"_5":13353,"_26530":110803,"_2682":110850},[],"Webhook deniega, expira o responde sin autorización",{"_3185":65790,"_28073":65771,"_19451":110852,"_5":13353,"_26530":110803,"_2682":110853},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3185":65791,"_28073":65771,"_19451":110855,"_5":13353,"_26530":110803,"_2682":49251},[],{"_3185":65792,"_28073":65771,"_19451":110857,"_5":13353,"_26530":110803,"_2682":110858},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3185":65793,"_28073":65771,"_19451":110860,"_5":13353,"_26530":110803,"_2682":49257},[],{"_3185":65794,"_28073":65771,"_19451":110862,"_5":13353,"_26530":110803,"_2682":110863},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3185":65795,"_28073":65771,"_19451":110865,"_5":13353,"_26530":110803,"_2682":49263},[],{"_3185":65796,"_28073":65771,"_19451":110867,"_5":13353,"_26530":110803,"_2682":110868},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3185":65797,"_28073":65771,"_19451":110870,"_5":13353,"_26530":110803,"_2682":49269},[],{"_3185":65798,"_28073":65771,"_19451":110872,"_5":13353,"_26530":110803,"_2682":110873},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3185":65799,"_28073":65771,"_19451":110875,"_5":13353,"_26530":110803,"_2682":49275},[],{"_3185":65800,"_28073":65771,"_19451":110877,"_5":13353,"_26530":110803,"_2682":110878},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3185":65801,"_28073":65771,"_19451":110880,"_5":13353,"_26530":110803,"_2682":110881},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3185":65802,"_28073":65771,"_19451":110883,"_5":13353,"_26530":110803,"_2682":110884},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3185":65803,"_28073":65771,"_19451":110886,"_5":13353,"_26530":110803,"_2682":110887},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3185":65804,"_28073":65771,"_19451":110889,"_5":13353,"_26530":110803,"_2682":110890},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3185":65805,"_28073":65771,"_19451":110892,"_5":13353,"_26530":110803,"_2682":49293},[],{"_3185":65806,"_28073":65771,"_19451":110894,"_5":13353,"_26530":110803,"_2682":110895},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3185":65807,"_28073":65771,"_19451":110897,"_5":13353,"_26530":110803,"_2682":49299},[],{"_3185":65808,"_28073":65771,"_19451":110899,"_5":13353,"_26530":110803,"_2682":110900},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3185":65809,"_28073":65771,"_19451":110902,"_5":13353,"_26530":110803,"_2682":110903},[],"DMS propietario distinto",{"_3185":65810,"_28073":65771,"_19451":110905,"_5":13353,"_26530":110803,"_2682":110906},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3185":65811,"_28073":65771,"_19451":110908,"_5":13353,"_26530":110803,"_2682":49311},[],{"_3185":65812,"_28073":65771,"_19451":110910,"_5":13353,"_26530":110803,"_2682":110911},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3185":65813,"_28073":65771,"_19451":110913,"_5":13353,"_26530":110803,"_2682":49317},[],{"_3185":65814,"_28073":65771,"_19451":110915,"_5":13353,"_26530":110803,"_2682":110916},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3185":65815,"_28073":65771,"_19451":110918,"_5":13353,"_26530":110803,"_2682":110919},[],"Certificado actual revocado",{"_3185":65816,"_28073":65771,"_19451":110921,"_5":13353,"_26530":110803,"_2682":110922},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3185":65817,"_28073":65771,"_19451":110924,"_5":13353,"_26530":110803,"_2682":110925},[],"Error de CA, perfil o firma",{"_3185":65818,"_28073":65771,"_19451":110927,"_5":13353,"_26530":110803,"_2682":110928},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3185":65819,"_28073":65771,"_19451":110930,"_5":13353,"_26530":110803,"_2682":110931},[],"HTTP 200 sin conexión del dispositivo",{"_3185":65820,"_28073":65771,"_19451":110933,"_5":13353,"_26530":110803,"_2682":110934},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3185":65821,"_28073":65771,"_19451":110936,"_5":13353,"_26530":110803,"_2682":110937},[],"Timeout o error después de emitir",{"_3185":65822,"_28073":65771,"_19451":110939,"_5":13353,"_26530":110803,"_2682":110940},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3185":65823,"_28073":65771,"_19451":110942,"_5":13353,"_26530":110807,"_2682":110943},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3185":65824,"_28073":65771,"_19451":110945,"_5":13353,"_26530":110807,"_2682":110946},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3185":65825,"_28073":65771,"_19451":110948,"_5":13353,"_26530":110810,"_2682":110949},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3185":65826,"_28073":65771,"_19451":110951,"_5":13353,"_26530":110810,"_2682":110952},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3185":65827,"_28073":65771,"_19451":110954,"_5":13353,"_26530":110810,"_2682":110955},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3185":65828,"_28073":65771,"_19451":110957,"_5":13353,"_26530":110810,"_2682":110958},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3185":65829,"_28073":65771,"_19451":110960,"_5":13353,"_26530":110810,"_2682":110961},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3185":65830,"_28073":65771,"_19451":110963,"_5":13353,"_26530":110810,"_2682":110964},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3185":65831,"_28073":65771,"_19451":110966,"_5":13353,"_26530":110810,"_2682":110967},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3185":65832,"_28073":65832,"_5":13700,"_2682":110969,"_28416":110970,"_19451":110971,"_26530":65832},"Distribución y actualización de confianza",[45599,108686,48012,109661,109836],[],{"_3185":65833,"_28073":65832,"_19451":110973,"_5":13353,"_26530":65832,"_2682":110974},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3185":65834,"_28073":65832,"_5":28413,"_19451":110976,"_26530":110977,"_2682":110978},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3185":65835,"_28073":65832,"_5":28413,"_19451":110980,"_26530":110981,"_2682":110982},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3185":65836,"_28073":65832,"_5":28413,"_19451":110984,"_26530":110985,"_2682":110986},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3185":65837,"_28073":65832,"_5":28413,"_19451":110988,"_26530":110989,"_2682":110990},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3185":65838,"_28073":65832,"_5":28413,"_19451":110992,"_26530":110993,"_2682":110994},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3185":65839,"_28073":65832,"_19451":110996,"_5":13353,"_26530":65832,"_2682":110997},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3185":65840,"_28073":65832,"_19451":110999,"_5":13353,"_26530":110977,"_2682":111000},[],"Relación",{"_3185":65841,"_28073":65832,"_19451":111002,"_5":13353,"_26530":110977,"_2682":111003},[],"Material que prepara el responsable",{"_3185":65842,"_28073":65832,"_19451":111005,"_5":13353,"_26530":110977,"_2682":111006},[],"Dispositivo → servidor EST",{"_3185":65843,"_28073":65832,"_19451":111008,"_5":13353,"_26530":110977,"_2682":111009},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3185":65844,"_28073":65832,"_19451":111011,"_5":13353,"_26530":110977,"_2682":111012},[],"DMS → solicitante",{"_3185":65845,"_28073":65832,"_19451":111014,"_5":13353,"_26530":110977,"_2682":111015},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3185":65846,"_28073":65832,"_19451":111017,"_5":13353,"_26530":110977,"_2682":111018},[],"Consumidor → dispositivo",{"_3185":65847,"_28073":65832,"_19451":111020,"_5":13353,"_26530":110977,"_2682":111021},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3185":65848,"_28073":65832,"_19451":111023,"_5":13353,"_26530":110977,"_2682":111024},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3185":65849,"_28073":65832,"_19451":111026,"_5":13353,"_26530":110981,"_2682":111027},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3185":65850,"_28073":65832,"_19451":111029,"_5":13353,"_26530":110981,"_2682":111030},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3185":65851,"_28073":65832,"_19451":111032,"_5":13353,"_26530":110985,"_2682":111033},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3185":65852,"_28073":65832,"_19451":111035,"_5":13353,"_26530":110985,"_2682":111036},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3185":65853,"_28073":65832,"_19451":111038,"_5":13353,"_26530":110985,"_2682":111039},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3185":65854,"_28073":65832,"_19451":111041,"_5":13353,"_26530":110985,"_2682":111042},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3185":65855,"_28073":65832,"_19451":111044,"_5":13353,"_26530":110985,"_2682":111045},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3185":65856,"_28073":65832,"_19451":111047,"_5":13353,"_26530":110985,"_2682":111048},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3185":65857,"_28073":65832,"_19451":111050,"_5":13353,"_26530":110989,"_2682":111051},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3185":65858,"_28073":65832,"_19451":111053,"_5":13353,"_26530":110989,"_2682":111054},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3185":65859,"_28073":65832,"_19451":111056,"_5":13353,"_26530":110989,"_2682":111057},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3185":65860,"_28073":65832,"_19451":111059,"_5":13353,"_26530":110993,"_2682":111060},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3185":65861,"_28073":65861,"_5":13700,"_2682":49466,"_28416":111062,"_19451":111064,"_26530":65861},[45599,108686,48012,109661,111063],"Integraciones",[],{"_3185":65862,"_28073":65861,"_19451":111066,"_5":13353,"_26530":65861,"_2682":111067},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3185":65863,"_28073":65861,"_5":28413,"_19451":111069,"_26530":111070,"_2682":111071},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3185":65864,"_28073":65861,"_5":28413,"_19451":111073,"_26530":111074,"_2682":111075},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3185":65865,"_28073":65861,"_5":28413,"_19451":111077,"_26530":111078,"_2682":111079},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3185":65866,"_28073":65861,"_5":28413,"_19451":111081,"_26530":111082,"_2682":111083},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3185":65867,"_28073":65861,"_5":28413,"_19451":111085,"_26530":111086,"_2682":111087},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3185":65868,"_28073":65861,"_5":28413,"_19451":111089,"_26530":111090,"_2682":111091},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3185":65869,"_28073":65861,"_5":28413,"_19451":111093,"_26530":111094,"_2682":49500},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3185":65870,"_28073":65861,"_5":28413,"_19451":111096,"_26530":111097,"_2682":49504},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3185":65871,"_28073":65861,"_5":28413,"_19451":111099,"_26530":111100,"_2682":111101},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3185":65872,"_28073":65861,"_5":28413,"_19451":111103,"_26530":111104,"_2682":111105},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3185":65873,"_28073":65861,"_5":28413,"_19451":111107,"_26530":111108,"_2682":111109},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3185":65874,"_28073":65861,"_5":28413,"_19451":111111,"_26530":111112,"_2682":111113},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3185":65875,"_28073":65861,"_5":28413,"_19451":111115,"_26530":111116,"_2682":111117},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3185":65876,"_28073":65861,"_5":28413,"_19451":111119,"_26530":111120,"_2682":111121},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3185":65877,"_28073":65861,"_5":28413,"_19451":111123,"_26530":111124,"_2682":111125},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3185":65878,"_28073":65861,"_5":28413,"_19451":111127,"_26530":111128,"_2682":111129},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3185":65879,"_28073":65861,"_5":28413,"_19451":111131,"_26530":111132,"_2682":111133},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3185":65880,"_28073":65861,"_5":28413,"_19451":111135,"_26530":111136,"_2682":111137},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3185":65881,"_28073":65861,"_5":28413,"_19451":111139,"_26530":111140,"_2682":111141},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3185":65882,"_28073":65861,"_5":28413,"_19451":111143,"_26530":111144,"_2682":111145},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3185":65883,"_28073":65861,"_19451":111147,"_5":13353,"_26530":65861,"_2682":111148},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3185":65884,"_28073":65861,"_19451":111150,"_5":13353,"_26530":65861,"_2682":111151},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3185":65885,"_28073":65861,"_19451":111153,"_5":13353,"_26530":65861,"_2682":111154},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3185":65886,"_28073":65861,"_19451":111156,"_5":13353,"_26530":111070,"_2682":111157},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3185":65887,"_28073":65861,"_19451":111159,"_5":13353,"_26530":111070,"_2682":111160},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3185":65888,"_28073":65861,"_19451":111162,"_5":13353,"_26530":111070,"_2682":111163},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3185":65889,"_28073":65861,"_19451":111165,"_5":13353,"_26530":111070,"_2682":111166},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3185":65890,"_28073":65861,"_19451":111168,"_5":13353,"_26530":111074,"_2682":111169},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3185":65891,"_28073":65861,"_19451":111171,"_5":13353,"_26530":111078,"_2682":111172},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3185":65892,"_28073":65861,"_19451":111174,"_5":13353,"_26530":111078,"_2682":111175},[],"Acción IAM",{"_3185":65893,"_28073":65861,"_19451":111177,"_5":13353,"_26530":111078,"_2682":107666},[],{"_3185":65894,"_28073":65861,"_19451":111179,"_5":13353,"_26530":111078,"_2682":49587},[],{"_3185":65895,"_28073":65861,"_19451":111181,"_5":13353,"_26530":111078,"_2682":111182},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3185":65896,"_28073":65861,"_19451":111184,"_5":13353,"_26530":111078,"_2682":49593},[],{"_3185":65897,"_28073":65861,"_19451":111186,"_5":13353,"_26530":111078,"_2682":111187},[],"Registrar la CA en AWS IoT",{"_3185":65898,"_28073":65861,"_19451":111189,"_5":13353,"_26530":111078,"_2682":49599},[],{"_3185":65899,"_28073":65861,"_19451":111191,"_5":13353,"_26530":111078,"_2682":111192},[],"Consultar el estado del registro de la CA",{"_3185":65900,"_28073":65861,"_19451":111194,"_5":13353,"_26530":111078,"_2682":49605},[],{"_3185":65901,"_28073":65861,"_19451":111196,"_5":13353,"_26530":111078,"_2682":111197},[],"Crear o actualizar Things en IoT Core",{"_3185":65902,"_28073":65861,"_19451":111199,"_5":13353,"_26530":111078,"_2682":49611},[],{"_3185":65903,"_28073":65861,"_19451":111201,"_5":13353,"_26530":111078,"_2682":111202},[],"Aprovisionar Things mediante plantilla",{"_3185":65904,"_28073":65861,"_19451":111204,"_5":13353,"_26530":111078,"_2682":49617},[],{"_3185":65905,"_28073":65861,"_19451":111206,"_5":13353,"_26530":111078,"_2682":111207},[],"Registrar certificados de dispositivo",{"_3185":65906,"_28073":65861,"_19451":111209,"_5":13353,"_26530":111078,"_2682":49623},[],{"_3185":65907,"_28073":65861,"_19451":111211,"_5":13353,"_26530":111078,"_2682":111212},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3185":65908,"_28073":65861,"_19451":111214,"_5":13353,"_26530":111078,"_2682":49629},[],{"_3185":65909,"_28073":65861,"_19451":111216,"_5":13353,"_26530":111078,"_2682":111217},[],"Crear y adjuntar políticas IoT",{"_3185":65910,"_28073":65861,"_19451":111219,"_5":13353,"_26530":111078,"_2682":49635},[],{"_3185":65911,"_28073":65861,"_19451":111221,"_5":13353,"_26530":111078,"_2682":111222},[],"Gestionar grupos de Things",{"_3185":65912,"_28073":65861,"_19451":111224,"_5":13353,"_26530":111078,"_2682":49641},[],{"_3185":65913,"_28073":65861,"_19451":111226,"_5":13353,"_26530":111078,"_2682":111227},[],"Crear plantillas JITP",{"_3185":65914,"_28073":65861,"_19451":111229,"_5":13353,"_26530":111078,"_2682":49647},[],{"_3185":65915,"_28073":65861,"_19451":111231,"_5":13353,"_26530":111078,"_2682":111232},[],"Leer y escribir el Device Shadow",{"_3185":65916,"_28073":65861,"_19451":111234,"_5":13353,"_26530":111078,"_2682":111235},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3185":65917,"_28073":65861,"_19451":111237,"_5":13353,"_26530":111082,"_2682":111238},[],"Parámetro",{"_3185":65918,"_28073":65861,"_19451":111240,"_5":13353,"_26530":111082,"_2682":111241},[],"Tipo",{"_3185":65919,"_28073":65861,"_19451":111243,"_5":13353,"_26530":111082,"_2682":111244},[],"Requerido",{"_3185":65920,"_28073":65861,"_19451":111246,"_5":13353,"_26530":111082,"_2682":111247},[],"Descripción",{"_3185":65921,"_28073":65861,"_19451":111249,"_5":13353,"_26530":111082,"_2682":49668},[],{"_3185":65922,"_28073":65861,"_19451":111251,"_5":13353,"_26530":111082,"_2682":23260},[],{"_3185":65923,"_28073":65861,"_19451":111253,"_5":13353,"_26530":111082,"_2682":111254},[],"Sí",{"_3185":65924,"_28073":65861,"_19451":111256,"_5":13353,"_26530":111082,"_2682":111257},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3185":65925,"_28073":65861,"_19451":111259,"_5":13353,"_26530":111082,"_2682":49679},[],{"_3185":65926,"_28073":65861,"_19451":111261,"_5":13353,"_26530":111082,"_2682":23260},[],{"_3185":65927,"_28073":65861,"_19451":111263,"_5":13353,"_26530":111082,"_2682":111254},[],{"_3185":65928,"_28073":65861,"_19451":111265,"_5":13353,"_26530":111082,"_2682":111266},[],"Región AWS donde opera el conector.",{"_3185":65929,"_28073":65861,"_19451":111268,"_5":13353,"_26530":111082,"_2682":49689},[],{"_3185":65930,"_28073":65861,"_19451":111270,"_5":13353,"_26530":111082,"_2682":23260},[],{"_3185":65931,"_28073":65861,"_19451":111272,"_5":13353,"_26530":111082,"_2682":111254},[],{"_3185":65932,"_28073":65861,"_19451":111274,"_5":13353,"_26530":111082,"_2682":111275},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3185":65933,"_28073":65861,"_19451":111277,"_5":13353,"_26530":111082,"_2682":49699},[],{"_3185":65934,"_28073":65861,"_19451":111279,"_5":13353,"_26530":111082,"_2682":23260},[],{"_3185":65935,"_28073":65861,"_19451":111281,"_5":13353,"_26530":111082,"_2682":111282},[],"Solo con `auth_method=static`",{"_3185":65936,"_28073":65861,"_19451":111284,"_5":13353,"_26530":111082,"_2682":111285},[],"Clave de acceso AWS.",{"_3185":65937,"_28073":65861,"_19451":111287,"_5":13353,"_26530":111082,"_2682":49710},[],{"_3185":65938,"_28073":65861,"_19451":111289,"_5":13353,"_26530":111082,"_2682":23260},[],{"_3185":65939,"_28073":65861,"_19451":111291,"_5":13353,"_26530":111082,"_2682":111282},[],{"_3185":65940,"_28073":65861,"_19451":111293,"_5":13353,"_26530":111082,"_2682":111294},[],"Clave secreta AWS.",{"_3185":65941,"_28073":65861,"_19451":111296,"_5":13353,"_26530":111082,"_2682":49720},[],{"_3185":65942,"_28073":65861,"_19451":111298,"_5":13353,"_26530":111082,"_2682":23260},[],{"_3185":65943,"_28073":65861,"_19451":111300,"_5":13353,"_26530":111082,"_2682":49725},[],{"_3185":65944,"_28073":65861,"_19451":111302,"_5":13353,"_26530":111082,"_2682":111303},[],"Token de sesión (con `auth_method=static`).",{"_3185":65945,"_28073":65861,"_19451":111305,"_5":13353,"_26530":111082,"_2682":49731},[],{"_3185":65946,"_28073":65861,"_19451":111307,"_5":13353,"_26530":111082,"_2682":23260},[],{"_3185":65947,"_28073":65861,"_19451":111309,"_5":13353,"_26530":111082,"_2682":111310},[],"Solo con `auth_method=role`",{"_3185":65948,"_28073":65861,"_19451":111312,"_5":13353,"_26530":111082,"_2682":111313},[],"ARN del rol a asumir.",{"_3185":65949,"_28073":65861,"_19451":111315,"_5":13353,"_26530":111082,"_2682":49742},[],{"_3185":65950,"_28073":65861,"_19451":111317,"_5":13353,"_26530":111082,"_2682":23260},[],{"_3185":65951,"_28073":65861,"_19451":111319,"_5":13353,"_26530":111082,"_2682":49725},[],{"_3185":65952,"_28073":65861,"_19451":111321,"_5":13353,"_26530":111082,"_2682":111322},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3185":65953,"_28073":65861,"_19451":111324,"_5":13353,"_26530":111082,"_2682":49752},[],{"_3185":65954,"_28073":65861,"_19451":111326,"_5":13353,"_26530":111082,"_2682":16399},[],{"_3185":65955,"_28073":65861,"_19451":111328,"_5":13353,"_26530":111082,"_2682":111254},[],{"_3185":65956,"_28073":65861,"_19451":111330,"_5":13353,"_26530":111082,"_2682":111331},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3185":65957,"_28073":65861,"_19451":111333,"_5":13353,"_26530":111082,"_2682":49762},[],{"_3185":65958,"_28073":65861,"_19451":111335,"_5":13353,"_26530":111082,"_2682":23260},[],{"_3185":65959,"_28073":65861,"_19451":111337,"_5":13353,"_26530":111082,"_2682":111254},[],{"_3185":65960,"_28073":65861,"_19451":111339,"_5":13353,"_26530":111082,"_2682":111340},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3185":65961,"_28073":65861,"_19451":111342,"_5":13353,"_26530":111082,"_2682":49772},[],{"_3185":65962,"_28073":65861,"_19451":111344,"_5":13353,"_26530":111082,"_2682":23260},[],{"_3185":65963,"_28073":65861,"_19451":111346,"_5":13353,"_26530":111082,"_2682":111254},[],{"_3185":65964,"_28073":65861,"_19451":111348,"_5":13353,"_26530":111082,"_2682":111349},[],"URL HTTP del Device Manager de Lamassu.",{"_3185":65965,"_28073":65861,"_19451":111351,"_5":13353,"_26530":111082,"_2682":49782},[],{"_3185":65966,"_28073":65861,"_19451":111353,"_5":13353,"_26530":111082,"_2682":23260},[],{"_3185":65967,"_28073":65861,"_19451":111355,"_5":13353,"_26530":111082,"_2682":111254},[],{"_3185":65968,"_28073":65861,"_19451":111357,"_5":13353,"_26530":111082,"_2682":111358},[],"URL HTTP del servicio de CA de Lamassu.",{"_3185":65969,"_28073":65861,"_19451":111360,"_5":13353,"_26530":111086,"_2682":111361},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3185":65970,"_28073":65861,"_19451":111363,"_5":13353,"_26530":111090,"_2682":111364},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3185":65971,"_28073":65861,"_19451":111366,"_5":13353,"_26530":111090,"_2682":111367},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3185":65972,"_28073":65861,"_19451":111369,"_5":13353,"_26530":111094,"_2682":111370},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3185":65973,"_28073":65861,"_19451":111372,"_5":13353,"_26530":111094,"_2682":111373},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3185":65974,"_28073":65861,"_19451":111375,"_5":13353,"_26530":111094,"_2682":111376},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3185":65975,"_28073":65861,"_19451":111378,"_5":13353,"_26530":111094,"_2682":111379},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3185":65976,"_28073":65861,"_19451":111381,"_5":13353,"_26530":111094,"_2682":111382},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3185":65977,"_28073":65861,"_19451":111384,"_5":13353,"_26530":111094,"_2682":111385},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3185":65978,"_28073":65861,"_19451":111387,"_5":13353,"_26530":111097,"_2682":111388},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3185":65979,"_28073":65861,"_19451":111390,"_5":13353,"_26530":111100,"_2682":111391},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3185":65980,"_28073":65861,"_19451":111393,"_5":13353,"_26530":111100,"_2682":111394},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3185":65981,"_28073":65861,"_19451":111396,"_5":13353,"_26530":111104,"_2682":111397},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3185":65982,"_28073":65861,"_19451":111399,"_5":13353,"_26530":111108,"_2682":111400},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3185":65983,"_28073":65861,"_19451":111402,"_5":13353,"_26530":111108,"_2682":111403},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3185":65984,"_28073":65861,"_19451":111405,"_5":13353,"_26530":111108,"_2682":111406},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3185":65985,"_28073":65861,"_19451":111408,"_5":13353,"_26530":111108,"_2682":111409},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3185":65986,"_28073":65861,"_19451":111411,"_5":13353,"_26530":111108,"_2682":111412},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3185":65987,"_28073":65861,"_19451":111414,"_5":13353,"_26530":111108,"_2682":111415},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3185":65988,"_28073":65861,"_19451":111417,"_5":13353,"_26530":111112,"_2682":111418},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. La plantilla se crea cuando el DMS se crea en Lamassu, no en el enrolamiento del dispositivo, y no se actualiza después (ver el aviso siguiente). A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3185":65989,"_28073":65861,"_19451":111420,"_5":13353,"_26530":111112,"_2682":111421},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3185":65990,"_28073":65861,"_19451":111423,"_5":13353,"_26530":111112,"_2682":111424},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3185":65991,"_28073":65861,"_19451":111426,"_5":13353,"_26530":111112,"_2682":111427},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3185":65992,"_28073":65861,"_19451":111429,"_5":13353,"_26530":111112,"_2682":111430},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3185":65993,"_28073":65861,"_19451":111432,"_5":13353,"_26530":111116,"_2682":111433},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3185":65994,"_28073":65861,"_19451":111435,"_5":13353,"_26530":111116,"_2682":111436},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3185":65995,"_28073":65861,"_19451":111438,"_5":13353,"_26530":111116,"_2682":111439},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3185":65996,"_28073":65861,"_19451":111441,"_5":13353,"_26530":111120,"_2682":111442},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3185":65997,"_28073":65861,"_19451":111444,"_5":13353,"_26530":111120,"_2682":111445},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3185":65998,"_28073":65861,"_19451":111447,"_5":13353,"_26530":111120,"_2682":111448},[],"Para que el flujo JITP funcione correctamente:",{"_3185":65999,"_28073":65861,"_19451":111450,"_5":13353,"_26530":111120,"_2682":111451},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3185":66000,"_28073":65861,"_19451":111453,"_5":13353,"_26530":111120,"_2682":111454},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3185":66001,"_28073":65861,"_19451":111456,"_5":13353,"_26530":111120,"_2682":111457},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3185":66002,"_28073":65861,"_19451":111459,"_5":13353,"_26530":111120,"_2682":111460},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3185":66003,"_28073":65861,"_19451":111462,"_5":13353,"_26530":111124,"_2682":111463},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3185":66004,"_28073":65861,"_19451":111465,"_5":13353,"_26530":111124,"_2682":111466},[],"Estado en Lamassu",{"_3185":66005,"_28073":65861,"_19451":111468,"_5":13353,"_26530":111124,"_2682":111469},[],"Razón de revocación",{"_3185":66006,"_28073":65861,"_19451":111471,"_5":13353,"_26530":111124,"_2682":111472},[],"Estado en AWS IoT Core",{"_3185":66007,"_28073":65861,"_19451":111474,"_5":13353,"_26530":111124,"_2682":49909},[],{"_3185":66008,"_28073":65861,"_19451":111476,"_5":13353,"_26530":111124,"_2682":111477},[],"Ninguna",{"_3185":66009,"_28073":65861,"_19451":111479,"_5":13353,"_26530":111124,"_2682":49915},[],{"_3185":66010,"_28073":65861,"_19451":111481,"_5":13353,"_26530":111124,"_2682":49918},[],{"_3185":66011,"_28073":65861,"_19451":111483,"_5":13353,"_26530":111124,"_2682":49921},[],{"_3185":66012,"_28073":65861,"_19451":111485,"_5":13353,"_26530":111124,"_2682":49924},[],{"_3185":66013,"_28073":65861,"_19451":111487,"_5":13353,"_26530":111124,"_2682":49918},[],{"_3185":66014,"_28073":65861,"_19451":111489,"_5":13353,"_26530":111124,"_2682":111490},[],"Cualquier otra razón",{"_3185":66015,"_28073":65861,"_19451":111492,"_5":13353,"_26530":111124,"_2682":49932},[],{"_3185":66016,"_28073":65861,"_19451":111494,"_5":13353,"_26530":111124,"_2682":111495},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3185":66017,"_28073":65861,"_19451":111497,"_5":13353,"_26530":111128,"_2682":111498},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3185":66018,"_28073":65861,"_19451":111500,"_5":13353,"_26530":111128,"_2682":111501},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3185":66019,"_28073":65861,"_19451":111503,"_5":13353,"_26530":111128,"_2682":111504},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3185":66020,"_28073":65861,"_19451":111506,"_5":13353,"_26530":111132,"_2682":111507},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3185":66021,"_28073":65861,"_19451":111509,"_5":13353,"_26530":111132,"_2682":111510},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3185":66022,"_28073":65861,"_19451":111512,"_5":13353,"_26530":111136,"_2682":111513},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3185":66023,"_28073":65861,"_19451":111515,"_5":13353,"_26530":111136,"_2682":111516},[],"Existen dos tipos de acciones:",{"_3185":66024,"_28073":65861,"_19451":111518,"_5":13353,"_26530":111136,"_2682":111519},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3185":66025,"_28073":65861,"_19451":111521,"_5":13353,"_26530":111136,"_2682":111522},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3185":66026,"_28073":65861,"_19451":111524,"_5":13353,"_26530":111136,"_2682":111525},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3185":66027,"_28073":65861,"_19451":111527,"_5":13353,"_26530":111140,"_2682":111528},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3185":66028,"_28073":65861,"_19451":111530,"_5":13353,"_26530":111140,"_2682":111531},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3185":66029,"_28073":65861,"_19451":111533,"_5":13353,"_26530":111140,"_2682":111534},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3185":66030,"_28073":65861,"_19451":111536,"_5":13353,"_26530":111144,"_2682":111537},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3185":66031,"_28073":65861,"_19451":111539,"_5":13353,"_26530":111144,"_2682":111540},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3185":66032,"_28073":65861,"_19451":111542,"_5":13353,"_26530":111144,"_2682":111543},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3185":66033,"_28073":65861,"_19451":111545,"_5":13353,"_26530":111144,"_2682":111546},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3185":66034,"_28073":65861,"_19451":111548,"_5":13353,"_26530":111144,"_2682":111549},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3185":66035,"_28073":65861,"_19451":111551,"_5":13353,"_26530":111144,"_2682":111552},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3185":66036,"_28073":65861,"_19451":111554,"_5":13353,"_26530":111144,"_2682":111555},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3185":66037,"_28073":65861,"_19451":111557,"_5":13353,"_26530":111144,"_2682":111558},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3185":66038,"_28073":65861,"_19451":111560,"_5":13353,"_26530":111144,"_2682":111561},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3185":66039,"_28073":65861,"_19451":111563,"_5":13353,"_26530":111144,"_2682":111564},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3185":66040,"_28073":65861,"_19451":111566,"_5":13353,"_26530":111144,"_2682":111567},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3185":66041,"_28073":65861,"_19451":111569,"_5":13353,"_26530":111144,"_2682":111570},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3185":66042,"_28073":65861,"_19451":111572,"_5":13353,"_26530":111144,"_2682":111573},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3185":66043,"_28073":65861,"_19451":111575,"_5":13353,"_26530":111144,"_2682":111576},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3185":66044,"_28073":65861,"_19451":111578,"_5":13353,"_26530":111144,"_2682":111579},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3185":66045,"_28073":65861,"_19451":111581,"_5":13353,"_26530":111144,"_2682":111582},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3185":66046,"_28073":65861,"_19451":111584,"_5":13353,"_26530":111144,"_2682":111585},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3185":66047,"_28073":65861,"_19451":111587,"_5":13353,"_26530":111144,"_2682":111588},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3185":66048,"_28073":65861,"_19451":111590,"_5":13353,"_26530":111144,"_2682":111591},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3185":66049,"_28073":65861,"_19451":111593,"_5":13353,"_26530":111144,"_2682":111594},[],"**Causa:** La edición dispara un nuevo intento de crear la plantilla JITP, que ya existe en AWS. El intento falla y se omiten los pasos posteriores del conector.",{"_3185":66050,"_28073":65861,"_19451":111596,"_5":13353,"_26530":111144,"_2682":111597},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3185":66051,"_28073":65861,"_19451":111599,"_5":13353,"_26530":111144,"_2682":111600},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3185":66052,"_28073":65861,"_19451":111602,"_5":13353,"_26530":111144,"_2682":111603},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3185":66053,"_28073":65861,"_19451":111605,"_5":13353,"_26530":111144,"_2682":111606},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3185":66054,"_28073":66054,"_5":13700,"_2682":48012,"_28416":111608,"_19451":111609,"_26530":66054},[45599,108686,48012],[],{"_3185":66055,"_28073":66054,"_19451":111611,"_5":13353,"_26530":66054,"_2682":111612},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3185":66056,"_28073":66054,"_5":28413,"_19451":111614,"_26530":111615,"_2682":111616},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3185":66057,"_28073":66054,"_5":28413,"_19451":111618,"_26530":111619,"_2682":109661},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3185":66058,"_28073":66054,"_5":28413,"_19451":111621,"_26530":111622,"_2682":109836},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3185":66059,"_28073":66054,"_5":28413,"_19451":111624,"_26530":111625,"_2682":111063},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#integraciones",{"_3185":66060,"_28073":66054,"_5":28413,"_19451":111627,"_26530":111628,"_2682":111629},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3185":66061,"_28073":66054,"_19451":111631,"_5":13353,"_26530":66054,"_2682":111632},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3185":66062,"_28073":66054,"_19451":111634,"_5":13353,"_26530":111615,"_2682":111635},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3185":66063,"_28073":66054,"_19451":111637,"_5":13353,"_26530":111615,"_2682":111638},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3185":66064,"_28073":66054,"_19451":111640,"_5":13353,"_26530":111619,"_2682":111641},[],"Recurso",{"_3185":66065,"_28073":66054,"_19451":111643,"_5":13353,"_26530":111619,"_2682":111644},[],"Qué representa",{"_3185":66066,"_28073":66054,"_19451":111646,"_5":13353,"_26530":111619,"_2682":111647},[],"**Dispositivo**",{"_3185":66067,"_28073":66054,"_19451":111649,"_5":13353,"_26530":111619,"_2682":111650},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3185":66068,"_28073":66054,"_19451":111652,"_5":13353,"_26530":111619,"_2682":111653},[],"**Identidad**",{"_3185":66069,"_28073":66054,"_19451":111655,"_5":13353,"_26530":111619,"_2682":111656},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3185":66070,"_28073":66054,"_19451":111658,"_5":13353,"_26530":111619,"_2682":50099},[],{"_3185":66071,"_28073":66054,"_19451":111660,"_5":13353,"_26530":111619,"_2682":111661},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3185":66072,"_28073":66054,"_19451":111663,"_5":13353,"_26530":111619,"_2682":111664},[],"**Flota**",{"_3185":66073,"_28073":66054,"_19451":111666,"_5":13353,"_26530":111619,"_2682":111667},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3185":66074,"_28073":66054,"_19451":111669,"_5":13353,"_26530":111619,"_2682":111670},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3185":66075,"_28073":66054,"_19451":111672,"_5":13353,"_26530":111619,"_2682":111673},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3185":66076,"_28073":66054,"_19451":111675,"_5":13353,"_26530":111622,"_2682":111676},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3185":66077,"_28073":66054,"_19451":111678,"_5":13353,"_26530":111622,"_2682":111679},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3185":66078,"_28073":66054,"_19451":111681,"_5":13353,"_26530":111622,"_2682":111682},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3185":66079,"_28073":66054,"_19451":111684,"_5":13353,"_26530":111622,"_2682":111685},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3185":66080,"_28073":66054,"_19451":111687,"_5":13353,"_26530":111622,"_2682":111688},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3185":66081,"_28073":66054,"_19451":111690,"_5":13353,"_26530":111622,"_2682":111691},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3185":66082,"_28073":66054,"_19451":111693,"_5":13353,"_26530":111622,"_2682":111694},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3185":66083,"_28073":66054,"_19451":111696,"_5":13353,"_26530":111622,"_2682":111697},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3185":66084,"_28073":66054,"_19451":111699,"_5":13353,"_26530":111625,"_2682":111700},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3185":66085,"_28073":66054,"_19451":111702,"_5":13353,"_26530":111625,"_2682":111703},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3185":66086,"_28073":66054,"_19451":111705,"_5":13353,"_26530":111628,"_2682":111706},[],"Participante",{"_3185":66087,"_28073":66054,"_19451":111708,"_5":13353,"_26530":111628,"_2682":111709},[],"Responsabilidad",{"_3185":66088,"_28073":66054,"_19451":111711,"_5":13353,"_26530":111628,"_2682":111712},[],"Administrador PKI",{"_3185":66089,"_28073":66054,"_19451":111714,"_5":13353,"_26530":111628,"_2682":111715},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3185":66090,"_28073":66054,"_19451":111717,"_5":13353,"_26530":111628,"_2682":111718},[],"Administrador del aprovisionamiento",{"_3185":66091,"_28073":66054,"_19451":111720,"_5":13353,"_26530":111628,"_2682":111721},[],"DMS, admisión, autenticación por operación e inventario.",{"_3185":66092,"_28073":66054,"_19451":111723,"_5":13353,"_26530":111628,"_2682":111724},[],"Integrador del dispositivo",{"_3185":66093,"_28073":66054,"_19451":111726,"_5":13353,"_26530":111628,"_2682":111727},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3185":66094,"_28073":66054,"_19451":111729,"_5":13353,"_26530":111628,"_2682":111730},[],"Integrador del consumidor",{"_3185":66095,"_28073":66054,"_19451":111732,"_5":13353,"_26530":111628,"_2682":111733},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3185":66096,"_28073":66054,"_19451":111735,"_5":13353,"_26530":111628,"_2682":111736},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3185":66097,"_28073":66097,"_5":13700,"_2682":111738,"_28416":111739,"_19451":111741,"_26530":66097},"Enrola y conecta tu primer dispositivo",[45599,108686,48012,111740],"Primeros pasos",[],{"_3185":66098,"_28073":66097,"_19451":111743,"_5":13353,"_26530":66097,"_2682":111744},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3185":66099,"_28073":66097,"_5":28413,"_19451":111746,"_26530":111747,"_2682":107296},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3185":66100,"_28073":66097,"_5":28413,"_19451":111749,"_26530":111750,"_2682":111751},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3185":66101,"_28073":66097,"_5":28413,"_19451":111753,"_26530":111754,"_2682":111755},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3185":66102,"_28073":66097,"_5":28413,"_19451":111757,"_26530":111758,"_2682":111759},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3185":66103,"_28073":66097,"_5":28413,"_19451":111761,"_26530":111762,"_2682":111763},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3185":66104,"_28073":66097,"_5":28413,"_19451":111765,"_26530":111766,"_2682":111767},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3185":66105,"_28073":66097,"_5":28413,"_19451":111769,"_26530":111770,"_2682":111771},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3185":66106,"_28073":66097,"_5":28413,"_19451":111773,"_26530":111774,"_2682":111775},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3185":66107,"_28073":66097,"_19451":111777,"_5":13353,"_26530":66097,"_2682":111778},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3185":66108,"_28073":66097,"_19451":111780,"_5":13353,"_26530":111747,"_2682":111781},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3185":66109,"_28073":66097,"_19451":111783,"_5":13353,"_26530":111747,"_2682":111784},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3185":66110,"_28073":66097,"_19451":111786,"_5":13353,"_26530":111747,"_2682":111787},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3185":66111,"_28073":66097,"_19451":111789,"_5":13353,"_26530":111747,"_2682":111790},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3185":66112,"_28073":66097,"_19451":111792,"_5":13353,"_26530":111747,"_2682":111793},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3185":66113,"_28073":66097,"_19451":111795,"_5":13353,"_26530":111750,"_2682":111796},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3185":66114,"_28073":66097,"_19451":111798,"_5":13353,"_26530":111750,"_2682":111799},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3185":66115,"_28073":66097,"_19451":111801,"_5":13353,"_26530":111754,"_2682":111802},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3185":66116,"_28073":66097,"_19451":111804,"_5":13353,"_26530":111754,"_2682":111805},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3185":66117,"_28073":66097,"_19451":111807,"_5":13353,"_26530":111754,"_2682":111808},[],"Ajuste",{"_3185":66118,"_28073":66097,"_19451":111810,"_5":13353,"_26530":111754,"_2682":111811},[],"Valor de evaluación",{"_3185":66119,"_28073":66097,"_19451":111813,"_5":13353,"_26530":111754,"_2682":50255},[],{"_3185":66120,"_28073":66097,"_19451":111815,"_5":13353,"_26530":111754,"_2682":111816},[],"Raíz emisora de `device-root.pem`.",{"_3185":66121,"_28073":66097,"_19451":111818,"_5":13353,"_26530":111754,"_2682":109964},[],{"_3185":66122,"_28073":66097,"_19451":111820,"_5":13353,"_26530":111754,"_2682":111821},[],"Perfil final de 1 hora que acabas de preparar.",{"_3185":66123,"_28073":66097,"_19451":111823,"_5":13353,"_26530":111754,"_2682":50266},[],{"_3185":66124,"_28073":66097,"_19451":111825,"_5":13353,"_26530":111754,"_2682":50269},[],{"_3185":66125,"_28073":66097,"_19451":111827,"_5":13353,"_26530":111754,"_2682":50272},[],{"_3185":66126,"_28073":66097,"_19451":111829,"_5":13353,"_26530":111754,"_2682":111830},[],"Habilitado.",{"_3185":66127,"_28073":66097,"_19451":111832,"_5":13353,"_26530":111754,"_2682":50278},[],{"_3185":66128,"_28073":66097,"_19451":111834,"_5":13353,"_26530":111754,"_2682":111835},[],"Deshabilitado; el ID debe ser nuevo.",{"_3185":66129,"_28073":66097,"_19451":111837,"_5":13353,"_26530":111754,"_2682":111838},[],"Autenticación inicial",{"_3185":66130,"_28073":66097,"_19451":111840,"_5":13353,"_26530":111754,"_2682":111841},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3185":66131,"_28073":66097,"_19451":111843,"_5":13353,"_26530":111754,"_2682":111844},[],"Autenticación de renovación",{"_3185":66132,"_28073":66097,"_19451":111846,"_5":13353,"_26530":111754,"_2682":111847},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3185":66133,"_28073":66097,"_19451":111849,"_5":13353,"_26530":111754,"_2682":50296},[],{"_3185":66134,"_28073":66097,"_19451":111851,"_5":13353,"_26530":111754,"_2682":111852},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3185":66135,"_28073":66097,"_19451":111854,"_5":13353,"_26530":111754,"_2682":50302},[],{"_3185":66136,"_28073":66097,"_19451":111856,"_5":13353,"_26530":111754,"_2682":111857},[],"1 hora.",{"_3185":66137,"_28073":66097,"_19451":111859,"_5":13353,"_26530":111754,"_2682":50308},[],{"_3185":66138,"_28073":66097,"_19451":111861,"_5":13353,"_26530":111754,"_2682":111862},[],"30 minutos / 10 minutos.",{"_3185":66139,"_28073":66097,"_19451":111864,"_5":13353,"_26530":111754,"_2682":50314},[],{"_3185":66140,"_28073":66097,"_19451":111866,"_5":13353,"_26530":111754,"_2682":111867},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3185":66141,"_28073":66097,"_19451":111869,"_5":13353,"_26530":111754,"_2682":48331},[],{"_3185":66142,"_28073":66097,"_19451":111871,"_5":13353,"_26530":111754,"_2682":111872},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3185":66143,"_28073":66097,"_19451":111874,"_5":13353,"_26530":111754,"_2682":50325},[],{"_3185":66144,"_28073":66097,"_19451":111876,"_5":13353,"_26530":111754,"_2682":111877},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3185":66145,"_28073":66097,"_19451":111879,"_5":13353,"_26530":111754,"_2682":111880},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_3185":66146,"_28073":66097,"_19451":111882,"_5":13353,"_26530":111758,"_2682":111883},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3185":66147,"_28073":66097,"_19451":111885,"_5":13353,"_26530":111758,"_2682":111886},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3185":66148,"_28073":66097,"_19451":111888,"_5":13353,"_26530":111762,"_2682":111889},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3185":66149,"_28073":66097,"_19451":111891,"_5":13353,"_26530":111762,"_2682":111892},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3185":66150,"_28073":66097,"_19451":111894,"_5":13353,"_26530":111762,"_2682":111895},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3185":66151,"_28073":66097,"_19451":111897,"_5":13353,"_26530":111766,"_2682":111898},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3185":66152,"_28073":66097,"_19451":111900,"_5":13353,"_26530":111766,"_2682":111901},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3185":66153,"_28073":66097,"_19451":111903,"_5":13353,"_26530":111770,"_2682":111904},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3185":66154,"_28073":66097,"_19451":111906,"_5":13353,"_26530":111770,"_2682":111907},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3185":66155,"_28073":66097,"_19451":111909,"_5":13353,"_26530":111770,"_2682":111910},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3185":66156,"_28073":66097,"_19451":111912,"_5":13353,"_26530":111770,"_2682":111913},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3185":66157,"_28073":66097,"_19451":111915,"_5":13353,"_26530":111770,"_2682":111916},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3185":66158,"_28073":66097,"_19451":111918,"_5":13353,"_26530":111774,"_2682":111919},[],"Comprobación",{"_3185":66159,"_28073":66097,"_19451":111921,"_5":13353,"_26530":111774,"_2682":111922},[],"Resultado esperado",{"_3185":66160,"_28073":66097,"_19451":111924,"_5":13353,"_26530":111774,"_2682":111925},[],"Registro",{"_3185":66161,"_28073":66097,"_19451":111927,"_5":13353,"_26530":111774,"_2682":111928},[],"ID creado automáticamente y DMS correcto.",{"_3185":66162,"_28073":66097,"_19451":111930,"_5":13353,"_26530":111774,"_2682":111931},[],"Certificado",{"_3185":66163,"_28073":66097,"_19451":111933,"_5":13353,"_26530":111774,"_2682":111934},[],"CN, perfil, serie y clave verificados.",{"_3185":66164,"_28073":66097,"_19451":111936,"_5":13353,"_26530":111774,"_2682":111937},[],"Inventario",{"_3185":66165,"_28073":66097,"_19451":111939,"_5":13353,"_26530":111774,"_2682":111940},[],"Serie recibida visible como identidad actual y en el historial.",{"_3185":66166,"_28073":66097,"_19451":111942,"_5":13353,"_26530":111774,"_2682":111943},[],"Consumidor",{"_3185":66167,"_28073":66097,"_19451":111945,"_5":13353,"_26530":111774,"_2682":111946},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3185":66168,"_28073":66097,"_19451":111948,"_5":13353,"_26530":111774,"_2682":111949},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3185":66169,"_28073":66097,"_19451":111951,"_5":13353,"_26530":111774,"_2682":111952},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3185":66170,"_28073":66170,"_5":13700,"_2682":109678,"_28416":111954,"_19451":111955,"_26530":66170},[45599,108686,48012,111740],[],{"_3185":66171,"_28073":66170,"_19451":111957,"_5":13353,"_26530":66170,"_2682":111958},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3185":66172,"_28073":66170,"_5":28413,"_19451":111960,"_26530":111961,"_2682":107296},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3185":66173,"_28073":66170,"_5":28413,"_19451":111963,"_26530":111964,"_2682":111965},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3185":66174,"_28073":66170,"_5":28413,"_19451":111967,"_26530":111968,"_2682":111969},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3185":66175,"_28073":66170,"_5":28413,"_19451":111971,"_26530":111972,"_2682":111973},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3185":66176,"_28073":66170,"_5":28413,"_19451":111975,"_26530":111976,"_2682":111977},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3185":66177,"_28073":66170,"_5":28413,"_19451":111979,"_26530":111980,"_2682":111981},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3185":66178,"_28073":66170,"_5":28413,"_19451":111983,"_26530":111984,"_2682":111922},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3185":66179,"_28073":66170,"_5":28413,"_19451":111986,"_26530":111987,"_2682":111988},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3185":66180,"_28073":66170,"_5":28413,"_19451":111990,"_26530":111991,"_2682":111992},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3185":66181,"_28073":66170,"_19451":111994,"_5":13353,"_26530":66170,"_2682":111995},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3185":66182,"_28073":66170,"_19451":111997,"_5":13353,"_26530":66170,"_2682":111998},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3185":66183,"_28073":66170,"_19451":112000,"_5":13353,"_26530":111961,"_2682":112001},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3185":66184,"_28073":66170,"_19451":112003,"_5":13353,"_26530":111961,"_2682":112004},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3185":66185,"_28073":66170,"_19451":112006,"_5":13353,"_26530":111961,"_2682":112007},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3185":66186,"_28073":66170,"_19451":112009,"_5":13353,"_26530":111961,"_2682":112010},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3185":66187,"_28073":66170,"_19451":112012,"_5":13353,"_26530":111964,"_2682":112013},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3185":66188,"_28073":66170,"_19451":112015,"_5":13353,"_26530":111964,"_2682":112016},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3185":66189,"_28073":66170,"_19451":112018,"_5":13353,"_26530":111964,"_2682":112019},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3185":66190,"_28073":66170,"_19451":112021,"_5":13353,"_26530":111964,"_2682":112022},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3185":66191,"_28073":66170,"_19451":112024,"_5":13353,"_26530":111964,"_2682":112025},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3185":66192,"_28073":66170,"_19451":112027,"_5":13353,"_26530":111964,"_2682":112028},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3185":66193,"_28073":66170,"_19451":112030,"_5":13353,"_26530":111964,"_2682":112031},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3185":66194,"_28073":66170,"_19451":112033,"_5":13353,"_26530":111964,"_2682":112034},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3185":66195,"_28073":66170,"_19451":112036,"_5":13353,"_26530":111968,"_2682":112037},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3185":66196,"_28073":66170,"_19451":112039,"_5":13353,"_26530":111968,"_2682":50491},[],{"_3185":66197,"_28073":66170,"_19451":112041,"_5":13353,"_26530":111968,"_2682":112042},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3185":66198,"_28073":66170,"_19451":112044,"_5":13353,"_26530":111968,"_2682":112045},[],"**Icon** y **Tags**: clasificación opcional.",{"_3185":66199,"_28073":66170,"_19451":112047,"_5":13353,"_26530":111968,"_2682":112048},[],"Confirma el registro.",{"_3185":66200,"_28073":66170,"_19451":112050,"_5":13353,"_26530":111972,"_2682":112051},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3185":66201,"_28073":66170,"_19451":112053,"_5":13353,"_26530":111972,"_2682":112054},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3185":66202,"_28073":66170,"_19451":112056,"_5":13353,"_26530":111976,"_2682":112057},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3185":66203,"_28073":66170,"_19451":112059,"_5":13353,"_26530":111976,"_2682":112060},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3185":66204,"_28073":66170,"_19451":112062,"_5":13353,"_26530":111980,"_2682":112063},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3185":66205,"_28073":66170,"_19451":112065,"_5":13353,"_26530":111980,"_2682":112066},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3185":66206,"_28073":66170,"_19451":112068,"_5":13353,"_26530":111984,"_2682":111919},[],{"_3185":66207,"_28073":66170,"_19451":112070,"_5":13353,"_26530":111984,"_2682":112071},[],"Resultado",{"_3185":66208,"_28073":66170,"_19451":112073,"_5":13353,"_26530":111984,"_2682":112074},[],"Dispositivo",{"_3185":66209,"_28073":66170,"_19451":112076,"_5":13353,"_26530":111984,"_2682":112077},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3185":66210,"_28073":66170,"_19451":112079,"_5":13353,"_26530":111984,"_2682":112080},[],"Identidad actual",{"_3185":66211,"_28073":66170,"_19451":112082,"_5":13353,"_26530":111984,"_2682":112083},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3185":66212,"_28073":66170,"_19451":112085,"_5":13353,"_26530":111984,"_2682":112086},[],"Historial",{"_3185":66213,"_28073":66170,"_19451":112088,"_5":13353,"_26530":111984,"_2682":112089},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3185":66214,"_28073":66170,"_19451":112091,"_5":13353,"_26530":111984,"_2682":112092},[],"Clave y certificado",{"_3185":66215,"_28073":66170,"_19451":112094,"_5":13353,"_26530":111984,"_2682":112095},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3185":66216,"_28073":66170,"_19451":112097,"_5":13353,"_26530":111987,"_2682":112098},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3185":66217,"_28073":66170,"_19451":112100,"_5":13353,"_26530":111987,"_2682":112101},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3185":66218,"_28073":66170,"_19451":112103,"_5":13353,"_26530":111987,"_2682":112104},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3185":66219,"_28073":66170,"_19451":112106,"_5":13353,"_26530":111987,"_2682":112107},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3185":66220,"_28073":66170,"_19451":112109,"_5":13353,"_26530":111991,"_2682":112110},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3185":66221,"_28073":66170,"_19451":112112,"_5":13353,"_26530":111991,"_2682":112113},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3185":66222,"_28073":66170,"_19451":112115,"_5":13353,"_26530":111991,"_2682":112116},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3185":66223,"_28073":66223,"_5":13700,"_2682":112118,"_28416":112119,"_19451":112120,"_26530":66223},"Plataforma Lamassu IoT",[45599,108686],[],{"_3185":66224,"_28073":66223,"_19451":112122,"_5":13353,"_26530":66223,"_2682":112123},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3185":66225,"_28073":66223,"_5":28413,"_19451":112125,"_26530":112126,"_2682":111616},[],"/docs/pr-preview/pr-42/es/platform/overview#empieza-aquí",{"_3185":66226,"_28073":66223,"_5":28413,"_19451":112128,"_26530":112129,"_2682":112130},[],"/docs/pr-preview/pr-42/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3185":66227,"_28073":66223,"_5":28413,"_19451":112132,"_26530":112133,"_2682":112134},[],"/docs/pr-preview/pr-42/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3185":66228,"_28073":66223,"_5":28413,"_19451":112136,"_26530":112137,"_2682":112138},[],"/docs/pr-preview/pr-42/es/platform/overview#capacidades-principales","Capacidades principales",{"_3185":66229,"_28073":66223,"_5":28413,"_19451":112140,"_26530":112141,"_2682":112142},[],"/docs/pr-preview/pr-42/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3185":66230,"_28073":66223,"_5":28413,"_19451":112144,"_26530":112145,"_2682":112146},[],"/docs/pr-preview/pr-42/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3185":66231,"_28073":66223,"_5":28413,"_19451":112148,"_26530":112149,"_2682":112150},[],"/docs/pr-preview/pr-42/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3185":66232,"_28073":66223,"_5":28413,"_19451":112152,"_26530":112153,"_2682":112154},[],"/docs/pr-preview/pr-42/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3185":66233,"_28073":66223,"_5":28413,"_19451":112156,"_26530":112157,"_2682":112158},[],"/docs/pr-preview/pr-42/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3185":66234,"_28073":66223,"_5":28413,"_19451":112160,"_26530":112161,"_2682":112162},[],"/docs/pr-preview/pr-42/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3185":66235,"_28073":66223,"_5":28413,"_19451":112164,"_26530":112165,"_2682":112166},[],"/docs/pr-preview/pr-42/es/platform/overview#referencia-operativa","Referencia operativa",{"_3185":66236,"_28073":66223,"_19451":112168,"_5":13353,"_26530":66223,"_2682":112169},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3185":66237,"_28073":66223,"_19451":112171,"_5":13353,"_26530":112126,"_2682":112172},[],"Elige el resultado que necesitas obtener:",{"_3185":66238,"_28073":66223,"_19451":112174,"_5":13353,"_26530":112126,"_2682":112175},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3185":66239,"_28073":66223,"_19451":112177,"_5":13353,"_26530":112126,"_2682":112178},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3185":66240,"_28073":66223,"_19451":112180,"_5":13353,"_26530":112126,"_2682":112181},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3185":66241,"_28073":66223,"_19451":112183,"_5":13353,"_26530":112129,"_2682":112184},[],"Bloque",{"_3185":66242,"_28073":66223,"_19451":112186,"_5":13353,"_26530":112129,"_2682":112187},[],"Qué gestionas",{"_3185":66243,"_28073":66223,"_19451":112189,"_5":13353,"_26530":112129,"_2682":112190},[],"Punto de entrada",{"_3185":66244,"_28073":66223,"_19451":112192,"_5":13353,"_26530":112129,"_2682":50645},[],{"_3185":66245,"_28073":66223,"_19451":112194,"_5":13353,"_26530":112129,"_2682":112195},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3185":66246,"_28073":66223,"_19451":112197,"_5":13353,"_26530":112129,"_2682":112198},[],"Visión general de PKI",{"_3185":66247,"_28073":66223,"_19451":112200,"_5":13353,"_26530":112129,"_2682":50654},[],{"_3185":66248,"_28073":66223,"_19451":112202,"_5":13353,"_26530":112129,"_2682":112203},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3185":66249,"_28073":66223,"_19451":112205,"_5":13353,"_26530":112129,"_2682":112206},[],"Visión general de IoT Fleets",{"_3185":66250,"_28073":66223,"_19451":112208,"_5":13353,"_26530":112129,"_2682":112209},[],"**Administración**",{"_3185":66251,"_28073":66223,"_19451":112211,"_5":13353,"_26530":112129,"_2682":112212},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3185":66252,"_28073":66223,"_19451":112214,"_5":13353,"_26530":112129,"_2682":108684},[],{"_3185":66253,"_28073":66223,"_19451":112216,"_5":13353,"_26530":112129,"_2682":112217},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3185":66254,"_28073":66223,"_19451":112219,"_5":13353,"_26530":112133,"_2682":112220},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3185":66255,"_28073":66223,"_19451":112222,"_5":13353,"_26530":112133,"_2682":112223},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3185":66256,"_28073":66223,"_19451":112225,"_5":13353,"_26530":112133,"_2682":112226},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3185":66257,"_28073":66223,"_19451":112228,"_5":13353,"_26530":112133,"_2682":112229},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3185":66258,"_28073":66223,"_19451":112231,"_5":13353,"_26530":112133,"_2682":112232},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3185":66259,"_28073":66223,"_19451":112234,"_5":13353,"_26530":112133,"_2682":112235},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3185":66260,"_28073":66223,"_19451":112237,"_5":13353,"_26530":112141,"_2682":112238},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3185":66261,"_28073":66223,"_19451":112240,"_5":13353,"_26530":112145,"_2682":112241},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3185":66262,"_28073":66223,"_19451":112243,"_5":13353,"_26530":112149,"_2682":112244},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3185":66263,"_28073":66223,"_19451":112246,"_5":13353,"_26530":112153,"_2682":112247},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3185":66264,"_28073":66223,"_19451":112249,"_5":13353,"_26530":112157,"_2682":112250},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3185":66265,"_28073":66223,"_19451":112252,"_5":13353,"_26530":112161,"_2682":112253},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3185":66266,"_28073":66223,"_19451":112255,"_5":13353,"_26530":112165,"_2682":111709},[],{"_3185":66267,"_28073":66223,"_19451":112257,"_5":13353,"_26530":112165,"_2682":112258},[],"Qué prepara o comprueba",{"_3185":66268,"_28073":66223,"_19451":112260,"_5":13353,"_26530":112165,"_2682":111712},[],{"_3185":66269,"_28073":66223,"_19451":112262,"_5":13353,"_26530":112165,"_2682":112263},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3185":66270,"_28073":66223,"_19451":112265,"_5":13353,"_26530":112165,"_2682":112266},[],"Administrador de la flota",{"_3185":66271,"_28073":66223,"_19451":112268,"_5":13353,"_26530":112165,"_2682":112269},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3185":66272,"_28073":66223,"_19451":112271,"_5":13353,"_26530":112165,"_2682":111724},[],{"_3185":66273,"_28073":66223,"_19451":112273,"_5":13353,"_26530":112165,"_2682":112274},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3185":66274,"_28073":66223,"_19451":112276,"_5":13353,"_26530":112165,"_2682":111730},[],{"_3185":66275,"_28073":66223,"_19451":112278,"_5":13353,"_26530":112165,"_2682":112279},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3185":66276,"_28073":66223,"_19451":112281,"_5":13353,"_26530":112165,"_2682":112282},[],"Operador de infraestructura",{"_3185":66277,"_28073":66223,"_19451":112284,"_5":13353,"_26530":112165,"_2682":112285},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3185":66278,"_28073":66223,"_19451":112287,"_5":13353,"_26530":112165,"_2682":112288},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3185":66279,"_28073":66279,"_5":13700,"_2682":112290,"_28416":112291,"_19451":112293,"_26530":66279},"Jerarquía y rotación de CAs",[45599,108686,50746,112292],"Claves, autoridades y certificados",[],{"_3185":66280,"_28073":66279,"_19451":112295,"_5":13353,"_26530":66279,"_2682":112296},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3185":66281,"_28073":66279,"_5":28413,"_19451":112298,"_26530":112299,"_2682":112300},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3185":66282,"_28073":66279,"_5":28413,"_19451":112302,"_26530":112303,"_2682":112304},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3185":66283,"_28073":66279,"_5":28413,"_19451":112306,"_26530":112307,"_2682":112308},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3185":66284,"_28073":66279,"_5":28413,"_19451":112310,"_26530":112311,"_2682":112312},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3185":66285,"_28073":66279,"_5":28413,"_19451":112314,"_26530":112315,"_2682":112316},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3185":66286,"_28073":66279,"_5":28413,"_19451":112318,"_26530":112319,"_2682":112320},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3185":66287,"_28073":66279,"_5":28413,"_19451":112322,"_26530":112323,"_2682":112324},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3185":66288,"_28073":66279,"_5":28413,"_19451":112326,"_26530":112327,"_2682":112328},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3185":66289,"_28073":66279,"_5":28413,"_19451":112330,"_26530":112331,"_2682":112332},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3185":66290,"_28073":66279,"_5":28413,"_19451":112334,"_26530":112335,"_2682":112336},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3185":66291,"_28073":66279,"_5":28413,"_19451":112338,"_26530":112339,"_2682":112340},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3185":66292,"_28073":66279,"_5":28413,"_19451":112342,"_26530":112343,"_2682":112344},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3185":66293,"_28073":66279,"_19451":112346,"_5":13353,"_26530":66279,"_2682":112347},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3185":66294,"_28073":66279,"_19451":112349,"_5":13353,"_26530":66279,"_2682":112350},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3185":66295,"_28073":66279,"_19451":112352,"_5":13353,"_26530":112299,"_2682":112353},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3185":66296,"_28073":66279,"_19451":112355,"_5":13353,"_26530":112299,"_2682":112356},[],"entorno, como producción y preproducción;",{"_3185":66297,"_28073":66279,"_19451":112358,"_5":13353,"_26530":112299,"_2682":112359},[],"propietario o equipo operador;",{"_3185":66298,"_28073":66279,"_19451":112361,"_5":13353,"_26530":112299,"_2682":112362},[],"familia de dispositivos o proceso de fabricación;",{"_3185":66299,"_28073":66279,"_19451":112364,"_5":13353,"_26530":112299,"_2682":112365},[],"región o requisito regulatorio;",{"_3185":66300,"_28073":66279,"_19451":112367,"_5":13353,"_26530":112299,"_2682":112368},[],"motor criptográfico o política de clave;",{"_3185":66301,"_28073":66279,"_19451":112370,"_5":13353,"_26530":112299,"_2682":112371},[],"ventana de mantenimiento y ritmo de renovación.",{"_3185":66302,"_28073":66279,"_19451":112373,"_5":13353,"_26530":112299,"_2682":112374},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3185":66303,"_28073":66279,"_19451":112376,"_5":13353,"_26530":112299,"_2682":112377},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3185":66304,"_28073":66279,"_19451":112379,"_5":13353,"_26530":112303,"_2682":112380},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3185":66305,"_28073":66279,"_19451":112382,"_5":13353,"_26530":112303,"_2682":112383},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3185":66306,"_28073":66279,"_19451":112385,"_5":13353,"_26530":112303,"_2682":112386},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3185":66307,"_28073":66279,"_19451":112388,"_5":13353,"_26530":112307,"_2682":112389},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3185":66308,"_28073":66279,"_19451":112391,"_5":13353,"_26530":112307,"_2682":112392},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3185":66309,"_28073":66279,"_19451":112394,"_5":13353,"_26530":112307,"_2682":112395},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3185":66310,"_28073":66279,"_19451":112397,"_5":13353,"_26530":112307,"_2682":112398},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3185":66311,"_28073":66279,"_19451":112400,"_5":13353,"_26530":112315,"_2682":112401},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3185":66312,"_28073":66279,"_19451":112403,"_5":13353,"_26530":112319,"_2682":112404},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3185":66313,"_28073":66279,"_19451":112406,"_5":13353,"_26530":112323,"_2682":112407},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3185":66314,"_28073":66279,"_19451":112409,"_5":13353,"_26530":112327,"_2682":112410},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3185":66315,"_28073":66279,"_19451":112412,"_5":13353,"_26530":112331,"_2682":112413},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3185":66316,"_28073":66279,"_19451":112415,"_5":13353,"_26530":112335,"_2682":112416},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3185":66317,"_28073":66279,"_19451":112418,"_5":13353,"_26530":112339,"_2682":112419},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3185":66318,"_28073":66279,"_19451":112421,"_5":13353,"_26530":112339,"_2682":112422},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3185":66319,"_28073":66279,"_19451":112424,"_5":13353,"_26530":112339,"_2682":112425},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3185":66320,"_28073":66279,"_19451":112427,"_5":13353,"_26530":112339,"_2682":112428},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3185":66321,"_28073":66279,"_19451":112430,"_5":13353,"_26530":112343,"_2682":112431},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3185":66322,"_28073":66279,"_19451":112433,"_5":13353,"_26530":112343,"_2682":112434},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3185":66323,"_28073":66279,"_19451":112436,"_5":13353,"_26530":112343,"_2682":112437},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3185":66324,"_28073":66279,"_19451":112439,"_5":13353,"_26530":112343,"_2682":112440},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3185":66325,"_28073":66279,"_19451":112442,"_5":13353,"_26530":112343,"_2682":112443},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3185":66326,"_28073":66279,"_19451":112445,"_5":13353,"_26530":112343,"_2682":112446},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3185":66327,"_28073":66279,"_19451":112448,"_5":13353,"_26530":112343,"_2682":112449},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3185":66328,"_28073":66328,"_5":13700,"_2682":112451,"_28416":112452,"_19451":112453,"_26530":66328},"Autoridades de certificación",[45599,108686,50746,112292],[],{"_3185":66329,"_28073":66328,"_19451":112455,"_5":13353,"_26530":66328,"_2682":112456},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3185":66330,"_28073":66328,"_5":28413,"_19451":112458,"_26530":112459,"_2682":112460},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3185":66331,"_28073":66328,"_5":28413,"_19451":112462,"_26530":112463,"_2682":112464},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3185":66332,"_28073":66328,"_5":28413,"_19451":112466,"_26530":112467,"_2682":107296},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3185":66333,"_28073":66328,"_5":28413,"_19451":112469,"_26530":112470,"_2682":112471},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3185":66334,"_28073":66328,"_5":28413,"_19451":112473,"_26530":112474,"_2682":112475},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3185":66335,"_28073":66328,"_5":28413,"_19451":112477,"_26530":112478,"_2682":112479},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3185":66336,"_28073":66328,"_5":28413,"_19451":112481,"_26530":112482,"_2682":112483},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3185":66337,"_28073":66328,"_5":28413,"_19451":112485,"_26530":112486,"_2682":112487},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3185":66338,"_28073":66328,"_5":28413,"_19451":112489,"_26530":112490,"_2682":112491},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3185":66339,"_28073":66328,"_5":28413,"_19451":112493,"_26530":112494,"_2682":112495},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3185":66340,"_28073":66328,"_5":28413,"_19451":112497,"_26530":112498,"_2682":112499},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3185":66341,"_28073":66328,"_5":28413,"_19451":112501,"_26530":112502,"_2682":112503},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3185":66342,"_28073":66328,"_5":28413,"_19451":112505,"_26530":112506,"_2682":112507},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3185":66343,"_28073":66328,"_5":28413,"_19451":112509,"_26530":112510,"_2682":112511},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3185":66344,"_28073":66328,"_5":28413,"_19451":112513,"_26530":112514,"_2682":112515},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3185":66345,"_28073":66328,"_5":28413,"_19451":112517,"_26530":112518,"_2682":112519},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3185":66346,"_28073":66328,"_5":28413,"_19451":112521,"_26530":112522,"_2682":112523},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3185":66347,"_28073":66328,"_5":28413,"_19451":112525,"_26530":112526,"_2682":112527},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3185":66348,"_28073":66328,"_5":28413,"_19451":112529,"_26530":112530,"_2682":112531},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3185":66349,"_28073":66328,"_5":28413,"_19451":112533,"_26530":112534,"_2682":112535},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3185":66350,"_28073":66328,"_5":28413,"_19451":112537,"_26530":112538,"_2682":112539},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3185":66351,"_28073":66328,"_5":28413,"_19451":112541,"_26530":112542,"_2682":112543},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3185":66352,"_28073":66328,"_5":28413,"_19451":112545,"_26530":112546,"_2682":112547},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3185":66353,"_28073":66328,"_19451":112549,"_5":13353,"_26530":66328,"_2682":112550},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3185":66354,"_28073":66328,"_19451":112552,"_5":13353,"_26530":66328,"_2682":112553},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3185":66355,"_28073":66328,"_19451":112555,"_5":13353,"_26530":66328,"_2682":112556},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3185":66356,"_28073":66328,"_19451":112558,"_5":13353,"_26530":112459,"_2682":112559},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3185":66357,"_28073":66328,"_19451":112561,"_5":13353,"_26530":112459,"_2682":112562},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3185":66358,"_28073":66328,"_19451":112564,"_5":13353,"_26530":112459,"_2682":112565},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3185":66359,"_28073":66328,"_19451":112567,"_5":13353,"_26530":112459,"_2682":112568},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3185":66360,"_28073":66328,"_19451":112570,"_5":13353,"_26530":112459,"_2682":112571},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3185":66361,"_28073":66328,"_19451":112573,"_5":13353,"_26530":112467,"_2682":112574},[],"Decide si la CA será raíz o intermedia.",{"_3185":66362,"_28073":66328,"_19451":112576,"_5":13353,"_26530":112467,"_2682":112577},[],"Elige el motor que custodiará la clave.",{"_3185":66363,"_28073":66328,"_19451":112579,"_5":13353,"_26530":112467,"_2682":112580},[],"Define una validez superior a la de los certificados que emitirá.",{"_3185":66364,"_28073":66328,"_19451":112582,"_5":13353,"_26530":112467,"_2682":112583},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3185":66365,"_28073":66328,"_19451":112585,"_5":13353,"_26530":112470,"_2682":112586},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3185":66366,"_28073":66328,"_19451":112588,"_5":13353,"_26530":112474,"_2682":112589},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3185":66367,"_28073":66328,"_19451":112591,"_5":13353,"_26530":112474,"_2682":112592},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3185":66368,"_28073":66328,"_19451":112594,"_5":13353,"_26530":112478,"_2682":112595},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3185":66369,"_28073":66328,"_19451":112597,"_5":13353,"_26530":112482,"_2682":112598},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3185":66370,"_28073":66328,"_19451":112600,"_5":13353,"_26530":112482,"_2682":112601},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3185":66371,"_28073":66328,"_19451":112603,"_5":13353,"_26530":112482,"_2682":112604},[],"`ST`: estado o provincia.",{"_3185":66372,"_28073":66328,"_19451":112606,"_5":13353,"_26530":112482,"_2682":112607},[],"`L`: localidad.",{"_3185":66373,"_28073":66328,"_19451":112609,"_5":13353,"_26530":112482,"_2682":112610},[],"`O`: organización.",{"_3185":66374,"_28073":66328,"_19451":112612,"_5":13353,"_26530":112482,"_2682":112613},[],"`OU`: unidad organizativa.",{"_3185":66375,"_28073":66328,"_19451":112615,"_5":13353,"_26530":112482,"_2682":112616},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3185":66376,"_28073":66328,"_19451":112618,"_5":13353,"_26530":112486,"_2682":112619},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3185":66377,"_28073":66328,"_19451":112621,"_5":13353,"_26530":112486,"_2682":112622},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3185":66378,"_28073":66328,"_19451":112624,"_5":13353,"_26530":112490,"_2682":112625},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3185":66379,"_28073":66328,"_19451":112627,"_5":13353,"_26530":112490,"_2682":112628},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3185":66380,"_28073":66328,"_19451":112630,"_5":13353,"_26530":112494,"_2682":112631},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3185":66381,"_28073":66328,"_19451":112633,"_5":13353,"_26530":112494,"_2682":112634},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3185":66382,"_28073":66328,"_19451":112636,"_5":13353,"_26530":112498,"_2682":112637},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3185":66383,"_28073":66328,"_19451":112639,"_5":13353,"_26530":112502,"_2682":112640},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3185":66384,"_28073":66328,"_19451":112642,"_5":13353,"_26530":112506,"_2682":112643},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3185":66385,"_28073":66328,"_19451":112645,"_5":13353,"_26530":112510,"_2682":112646},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3185":66386,"_28073":66328,"_19451":112648,"_5":13353,"_26530":112514,"_2682":112649},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3185":66387,"_28073":66328,"_19451":112651,"_5":13353,"_26530":112514,"_2682":112652},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3185":66388,"_28073":66328,"_19451":112654,"_5":13353,"_26530":112518,"_2682":112655},[],"Abre una CA desde el inventario para consultar:",{"_3185":66389,"_28073":66328,"_19451":112657,"_5":13353,"_26530":112518,"_2682":112658},[],"Estado y periodo de validez.",{"_3185":66390,"_28073":66328,"_19451":112660,"_5":13353,"_26530":112518,"_2682":112661},[],"Certificado y cadena en formato PEM.",{"_3185":66391,"_28073":66328,"_19451":112663,"_5":13353,"_26530":112518,"_2682":112664},[],"Número de certificados activos, expirados y revocados.",{"_3185":66392,"_28073":66328,"_19451":112666,"_5":13353,"_26530":112518,"_2682":112667},[],"Certificados emitidos en **Issued Certificates**.",{"_3185":66393,"_28073":66328,"_19451":112669,"_5":13353,"_26530":112518,"_2682":112670},[],"CRL vinculada a la autoridad.",{"_3185":66394,"_28073":66328,"_19451":112672,"_5":13353,"_26530":112518,"_2682":112673},[],"Metadatos y motor criptográfico asociado.",{"_3185":66395,"_28073":66328,"_19451":112675,"_5":13353,"_26530":112518,"_2682":112676},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3185":66396,"_28073":66328,"_19451":112678,"_5":13353,"_26530":112522,"_2682":112679},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3185":66397,"_28073":66328,"_19451":112681,"_5":13353,"_26530":112522,"_2682":112682},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3185":66398,"_28073":66328,"_19451":112684,"_5":13353,"_26530":112522,"_2682":112685},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3185":66399,"_28073":66328,"_19451":112687,"_5":13353,"_26530":112522,"_2682":112688},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3185":66400,"_28073":66328,"_19451":112690,"_5":13353,"_26530":112526,"_2682":112691},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3185":66401,"_28073":66328,"_19451":112693,"_5":13353,"_26530":112530,"_2682":112694},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3185":66402,"_28073":66328,"_19451":112696,"_5":13353,"_26530":112534,"_2682":112697},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3185":66403,"_28073":66328,"_19451":112699,"_5":13353,"_26530":112538,"_2682":112700},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3185":66404,"_28073":66328,"_19451":112702,"_5":13353,"_26530":112542,"_2682":112703},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3185":66405,"_28073":66328,"_19451":112705,"_5":13353,"_26530":112546,"_2682":112706},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3185":66406,"_28073":66328,"_19451":112708,"_5":13353,"_26530":112546,"_2682":112709},[],"El rol VA de la CA se conserva pero deja de ser editable (consulta CRL), así que ajusta antes su validez, intervalo y firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3185":66407,"_28073":66328,"_19451":112711,"_5":13353,"_26530":112546,"_2682":112712},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si después se importa otra CA con un certificado distinto pero el mismo número de serie, la importación termina bien y Lamassu sigue mostrando el estado, el tipo y el emisor del certificado antiguo. Usa certificados con números de serie distintos y comprueba el resultado tras importar. La importación solo se rechaza cuando el número de serie pertenece a una CA existente.",{"_3185":66408,"_28073":66408,"_5":13700,"_2682":112714,"_28416":112715,"_19451":112716,"_26530":66408},"Perfiles de certificado",[45599,108686,50746,112292],[],{"_3185":66409,"_28073":66408,"_19451":112718,"_5":13353,"_26530":66408,"_2682":112719},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3185":66410,"_28073":66408,"_5":28413,"_19451":112721,"_26530":112722,"_2682":112723},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3185":66411,"_28073":66408,"_5":28413,"_19451":112725,"_26530":112726,"_2682":112727},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#validez","Validez",{"_3185":66412,"_28073":66408,"_5":28413,"_19451":112729,"_26530":112730,"_2682":112731},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3185":66413,"_28073":66408,"_5":28413,"_19451":112733,"_26530":112734,"_2682":112735},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3185":66414,"_28073":66408,"_5":28413,"_19451":112737,"_26530":112738,"_2682":112739},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3185":66415,"_28073":66408,"_5":28413,"_19451":112741,"_26530":112742,"_2682":112743},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3185":66416,"_28073":66408,"_5":28413,"_19451":112745,"_26530":112746,"_2682":112747},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3185":66417,"_28073":66408,"_5":28413,"_19451":112749,"_26530":112750,"_2682":112751},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3185":66418,"_28073":66408,"_5":28413,"_19451":112753,"_26530":112754,"_2682":112755},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3185":66419,"_28073":66408,"_5":28413,"_19451":112757,"_26530":112758,"_2682":112759},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3185":66420,"_28073":66408,"_5":28413,"_19451":112761,"_26530":112762,"_2682":112763},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3185":66421,"_28073":66408,"_5":28413,"_19451":112765,"_26530":112766,"_2682":112767},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3185":66422,"_28073":66408,"_5":28413,"_19451":112769,"_26530":112770,"_2682":112771},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3185":66423,"_28073":66408,"_5":28413,"_19451":112773,"_26530":112774,"_2682":112775},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3185":66424,"_28073":66408,"_5":28413,"_19451":112777,"_26530":112778,"_2682":112779},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3185":66425,"_28073":66408,"_5":28413,"_19451":112781,"_26530":112782,"_2682":112783},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3185":66426,"_28073":66408,"_19451":112785,"_5":13353,"_26530":66408,"_2682":112786},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3185":66427,"_28073":66408,"_19451":112788,"_5":13353,"_26530":66408,"_2682":112789},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3185":66428,"_28073":66408,"_19451":112791,"_5":13353,"_26530":112726,"_2682":112792},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3185":66429,"_28073":66408,"_19451":112794,"_5":13353,"_26530":112726,"_2682":112795},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3185":66430,"_28073":66408,"_19451":112797,"_5":13353,"_26530":112730,"_2682":112798},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3185":66431,"_28073":66408,"_19451":112800,"_5":13353,"_26530":112734,"_2682":112801},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3185":66432,"_28073":66408,"_19451":112803,"_5":13353,"_26530":112734,"_2682":112804},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3185":66433,"_28073":66408,"_19451":112806,"_5":13353,"_26530":112734,"_2682":112807},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3185":66434,"_28073":66408,"_19451":112809,"_5":13353,"_26530":112738,"_2682":112810},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3185":66435,"_28073":66408,"_19451":112812,"_5":13353,"_26530":112742,"_2682":112813},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3185":66436,"_28073":66408,"_19451":112815,"_5":13353,"_26530":112742,"_2682":112816},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3185":66437,"_28073":66408,"_19451":112818,"_5":13353,"_26530":112746,"_2682":112819},[],"La aplicación criptográfica puede:",{"_3185":66438,"_28073":66408,"_19451":112821,"_5":13353,"_26530":112746,"_2682":112822},[],"permitir o bloquear claves RSA;",{"_3185":66439,"_28073":66408,"_19451":112824,"_5":13353,"_26530":112746,"_2682":112825},[],"limitar los tamaños RSA admitidos;",{"_3185":66440,"_28073":66408,"_19451":112827,"_5":13353,"_26530":112746,"_2682":112828},[],"permitir o bloquear claves ECDSA;",{"_3185":66441,"_28073":66408,"_19451":112830,"_5":13353,"_26530":112746,"_2682":112831},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3185":66442,"_28073":66408,"_19451":112833,"_5":13353,"_26530":112746,"_2682":112834},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3185":66443,"_28073":66408,"_19451":112836,"_5":13353,"_26530":112750,"_2682":112837},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3185":66444,"_28073":66408,"_19451":112839,"_5":13353,"_26530":112750,"_2682":108449},[],{"_3185":66445,"_28073":66408,"_19451":112841,"_5":13353,"_26530":112750,"_2682":112842},[],"Primera opción",{"_3185":66446,"_28073":66408,"_19451":112844,"_5":13353,"_26530":112750,"_2682":112845},[],"Segunda opción",{"_3185":66447,"_28073":66408,"_19451":112847,"_5":13353,"_26530":112750,"_2682":112848},[],"Si no hay ninguna",{"_3185":66448,"_28073":66408,"_19451":112850,"_5":13353,"_26530":112750,"_2682":112851},[],"Firma directa con una CA",{"_3185":66449,"_28073":66408,"_19451":112853,"_5":13353,"_26530":112750,"_2682":112854},[],"`issuance_profile` incluido en la solicitud",{"_3185":66450,"_28073":66408,"_19451":112856,"_5":13353,"_26530":112750,"_2682":112857},[],"`issuance_profile_id` de la solicitud",{"_3185":66451,"_28073":66408,"_19451":112859,"_5":13353,"_26530":112750,"_2682":112860},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3185":66452,"_28073":66408,"_19451":112862,"_5":13353,"_26530":112750,"_2682":112863},[],"Emisión mediante DMS",{"_3185":66453,"_28073":66408,"_19451":112865,"_5":13353,"_26530":112750,"_2682":51321},[],{"_3185":66454,"_28073":66408,"_19451":112867,"_5":13353,"_26530":112750,"_2682":112868},[],"`settings.issuance_profile` incluido en el DMS",{"_3185":66455,"_28073":66408,"_19451":112870,"_5":13353,"_26530":112750,"_2682":112871},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3185":66456,"_28073":66408,"_19451":112873,"_5":13353,"_26530":112750,"_2682":112874},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3185":66457,"_28073":66408,"_19451":112876,"_5":13353,"_26530":112750,"_2682":112877},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3185":66458,"_28073":66408,"_19451":112879,"_5":13353,"_26530":112758,"_2682":112880},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3185":66459,"_28073":66408,"_19451":112882,"_5":13353,"_26530":112762,"_2682":112883},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3185":66460,"_28073":66408,"_19451":112885,"_5":13353,"_26530":112766,"_2682":112886},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3185":66461,"_28073":66408,"_19451":112888,"_5":13353,"_26530":112770,"_2682":112889},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3185":66462,"_28073":66408,"_19451":112891,"_5":13353,"_26530":112774,"_2682":112892},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3185":66463,"_28073":66408,"_19451":112894,"_5":13353,"_26530":112774,"_2682":112895},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3185":66464,"_28073":66408,"_19451":112897,"_5":13353,"_26530":112778,"_2682":112898},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3185":66465,"_28073":66408,"_19451":112900,"_5":13353,"_26530":112778,"_2682":112901},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3185":66466,"_28073":66408,"_19451":112903,"_5":13353,"_26530":112778,"_2682":112904},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3185":66467,"_28073":66408,"_19451":112906,"_5":13353,"_26530":112778,"_2682":112907},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3185":66468,"_28073":66408,"_19451":112909,"_5":13353,"_26530":112782,"_2682":112910},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3185":66469,"_28073":66408,"_19451":112912,"_5":13353,"_26530":112782,"_2682":112913},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3185":66470,"_28073":66470,"_5":13700,"_2682":112915,"_28416":112916,"_19451":112918,"_26530":66470},"Validación de certificados",[45599,108686,50746,112917],"Validación",[],{"_3185":66471,"_28073":66470,"_19451":112920,"_5":13353,"_26530":66470,"_2682":112921},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3185":66472,"_28073":66470,"_5":28413,"_19451":112923,"_26530":112924,"_2682":112925},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3185":66473,"_28073":66470,"_5":28413,"_19451":112927,"_26530":112928,"_2682":112929},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3185":66474,"_28073":66470,"_5":28413,"_19451":112931,"_26530":112932,"_2682":112933},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3185":66475,"_28073":66470,"_19451":112935,"_5":13353,"_26530":66470,"_2682":112936},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3185":66476,"_28073":66470,"_19451":112938,"_5":13353,"_26530":112924,"_2682":112939},[],"Verifica estos criterios juntos:",{"_3185":66477,"_28073":66470,"_19451":112941,"_5":13353,"_26530":112924,"_2682":111919},[],{"_3185":66478,"_28073":66470,"_19451":112943,"_5":13353,"_26530":112924,"_2682":112944},[],"Resultado necesario",{"_3185":66479,"_28073":66470,"_19451":112946,"_5":13353,"_26530":112924,"_2682":112947},[],"Cadena y firma",{"_3185":66480,"_28073":66470,"_19451":112949,"_5":13353,"_26530":112924,"_2682":112950},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3185":66481,"_28073":66470,"_19451":112952,"_5":13353,"_26530":112924,"_2682":112953},[],"Fechas",{"_3185":66482,"_28073":66470,"_19451":112955,"_5":13353,"_26530":112924,"_2682":112956},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3185":66483,"_28073":66470,"_19451":112958,"_5":13353,"_26530":112924,"_2682":108359},[],{"_3185":66484,"_28073":66470,"_19451":112960,"_5":13353,"_26530":112924,"_2682":112961},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3185":66485,"_28073":66470,"_19451":112963,"_5":13353,"_26530":112924,"_2682":112964},[],"Uso",{"_3185":66486,"_28073":66470,"_19451":112966,"_5":13353,"_26530":112924,"_2682":112967},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3185":66487,"_28073":66470,"_19451":112969,"_5":13353,"_26530":112924,"_2682":112970},[],"Revocación",{"_3185":66488,"_28073":66470,"_19451":112972,"_5":13353,"_26530":112924,"_2682":112973},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3185":66489,"_28073":66470,"_19451":112975,"_5":13353,"_26530":112924,"_2682":112976},[],"Autorización",{"_3185":66490,"_28073":66470,"_19451":112978,"_5":13353,"_26530":112924,"_2682":112979},[],"La aplicación permite la acción a esa identidad.",{"_3185":66491,"_28073":66470,"_19451":112981,"_5":13353,"_26530":112924,"_2682":112982},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3185":66492,"_28073":66470,"_19451":112984,"_5":13353,"_26530":112928,"_2682":112985},[],"Mecanismo",{"_3185":66493,"_28073":66470,"_19451":112987,"_5":13353,"_26530":112928,"_2682":112988},[],"Cuándo utilizarlo",{"_3185":66494,"_28073":66470,"_19451":112990,"_5":13353,"_26530":112928,"_2682":112991},[],"Qué debes mantener",{"_3185":66495,"_28073":66470,"_19451":112993,"_5":13353,"_26530":112928,"_2682":51449},[],{"_3185":66496,"_28073":66470,"_19451":112995,"_5":13353,"_26530":112928,"_2682":112996},[],"Consulta del estado de un certificado concreto.",{"_3185":66497,"_28073":66470,"_19451":112998,"_5":13353,"_26530":112928,"_2682":112999},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3185":66498,"_28073":66470,"_19451":113001,"_5":13353,"_26530":112928,"_2682":51458},[],{"_3185":66499,"_28073":66470,"_19451":113003,"_5":13353,"_26530":112928,"_2682":113004},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3185":66500,"_28073":66470,"_19451":113006,"_5":13353,"_26530":112928,"_2682":113007},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3185":66501,"_28073":66470,"_19451":113009,"_5":13353,"_26530":112928,"_2682":113010},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3185":66502,"_28073":66470,"_19451":113012,"_5":13353,"_26530":112928,"_2682":113013},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3185":66503,"_28073":66470,"_19451":113015,"_5":13353,"_26530":112932,"_2682":113016},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3185":66504,"_28073":66470,"_19451":113018,"_5":13353,"_26530":112932,"_2682":113019},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3185":66505,"_28073":66470,"_19451":113021,"_5":13353,"_26530":112932,"_2682":113022},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3185":66506,"_28073":66470,"_19451":113024,"_5":13353,"_26530":112932,"_2682":113025},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3185":66507,"_28073":66470,"_19451":113027,"_5":13353,"_26530":112932,"_2682":113028},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3185":66508,"_28073":66470,"_19451":113030,"_5":13353,"_26530":112932,"_2682":113031},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3185":66509,"_28073":66470,"_19451":113033,"_5":13353,"_26530":112932,"_2682":113034},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3185":66510,"_28073":66470,"_19451":113036,"_5":13353,"_26530":112932,"_2682":113037},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3185":66511,"_28073":66470,"_19451":113039,"_5":13353,"_26530":112932,"_2682":113040},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3185":66512,"_28073":66512,"_5":13700,"_2682":113042,"_28416":113043,"_19451":113044,"_26530":66512},"Certificados",[45599,108686,50746,112292],[],{"_3185":66513,"_28073":66512,"_19451":113046,"_5":13353,"_26530":66512,"_2682":113047},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3185":66514,"_28073":66512,"_5":28413,"_19451":113049,"_26530":113050,"_2682":113051},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3185":66515,"_28073":66512,"_5":28413,"_19451":113053,"_26530":113054,"_2682":113055},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3185":66516,"_28073":66512,"_5":28413,"_19451":113057,"_26530":113058,"_2682":113059},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3185":66517,"_28073":66512,"_5":28413,"_19451":113061,"_26530":113062,"_2682":113063},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3185":66518,"_28073":66512,"_5":28413,"_19451":113065,"_26530":113066,"_2682":113067},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3185":66519,"_28073":66512,"_5":28413,"_19451":113069,"_26530":113070,"_2682":113071},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3185":66520,"_28073":66512,"_5":28413,"_19451":113073,"_26530":113074,"_2682":113075},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3185":66521,"_28073":66512,"_5":28413,"_19451":113077,"_26530":113078,"_2682":113079},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3185":66522,"_28073":66512,"_5":28413,"_19451":113081,"_26530":113082,"_2682":113083},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#continúa","Continúa",{"_3185":66523,"_28073":66512,"_19451":113085,"_5":13353,"_26530":66512,"_2682":113086},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3185":66524,"_28073":66512,"_19451":113088,"_5":13353,"_26530":113050,"_2682":113089},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3185":66525,"_28073":66512,"_19451":113091,"_5":13353,"_26530":113050,"_2682":113092},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3185":66526,"_28073":66512,"_19451":113094,"_5":13353,"_26530":113054,"_2682":113095},[],"Descarga el PEM e inspecciónalo:",{"_3185":66527,"_28073":66512,"_19451":113097,"_5":13353,"_26530":113054,"_2682":113098},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3185":66528,"_28073":66512,"_19451":113100,"_5":13353,"_26530":113058,"_2682":113101},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3185":66529,"_28073":66512,"_19451":113103,"_5":13353,"_26530":113058,"_2682":113104},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3185":66530,"_28073":66512,"_19451":113106,"_5":13353,"_26530":113058,"_2682":113107},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3185":66531,"_28073":66512,"_19451":113109,"_5":13353,"_26530":113058,"_2682":113110},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3185":66532,"_28073":66512,"_19451":113112,"_5":13353,"_26530":113058,"_2682":113113},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3185":66533,"_28073":66512,"_19451":113115,"_5":13353,"_26530":113058,"_2682":113116},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3185":66534,"_28073":66512,"_19451":113118,"_5":13353,"_26530":113058,"_2682":113119},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3185":66535,"_28073":66512,"_19451":113121,"_5":13353,"_26530":113062,"_2682":113122},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3185":66536,"_28073":66512,"_19451":113124,"_5":13353,"_26530":113066,"_2682":113125},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3185":66537,"_28073":66512,"_19451":113127,"_5":13353,"_26530":113070,"_2682":113128},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3185":66538,"_28073":66512,"_19451":113130,"_5":13353,"_26530":113074,"_2682":113131},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3185":66539,"_28073":66512,"_19451":113133,"_5":13353,"_26530":113074,"_2682":113134},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3185":66540,"_28073":66512,"_19451":113136,"_5":13353,"_26530":113074,"_2682":113137},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3185":66541,"_28073":66512,"_19451":113139,"_5":13353,"_26530":113078,"_2682":113140},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3185":66542,"_28073":66512,"_19451":113142,"_5":13353,"_26530":113078,"_2682":113143},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3185":66543,"_28073":66512,"_19451":113145,"_5":13353,"_26530":113078,"_2682":113146},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3185":66544,"_28073":66512,"_19451":113148,"_5":13353,"_26530":113082,"_2682":113149},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3185":66545,"_28073":66512,"_19451":113151,"_5":13353,"_26530":113082,"_2682":113152},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3185":66546,"_28073":66546,"_5":13700,"_2682":113154,"_28416":113155,"_19451":113157,"_26530":66546},"Ciclo de vida de un certificado",[45599,108686,50746,113156],"Conceptos",[],{"_3185":66547,"_28073":66546,"_19451":113159,"_5":13353,"_26530":66546,"_2682":113160},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3185":66548,"_28073":66546,"_5":28413,"_19451":113162,"_26530":113163,"_2682":113164},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3185":66549,"_28073":66546,"_5":28413,"_19451":113166,"_26530":113167,"_2682":113168},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3185":66550,"_28073":66546,"_5":28413,"_19451":113170,"_26530":113171,"_2682":113172},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3185":66551,"_28073":66546,"_5":28413,"_19451":113174,"_26530":113175,"_2682":113176},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3185":66552,"_28073":66546,"_5":28413,"_19451":113178,"_26530":113179,"_2682":113180},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3185":66553,"_28073":66546,"_5":28413,"_19451":113182,"_26530":113183,"_2682":113184},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3185":66554,"_28073":66546,"_5":28413,"_19451":113186,"_26530":113187,"_2682":113188},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3185":66555,"_28073":66546,"_5":28413,"_19451":113190,"_26530":113191,"_2682":113192},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3185":66556,"_28073":66546,"_5":28413,"_19451":113194,"_26530":113195,"_2682":113196},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3185":66557,"_28073":66546,"_5":28413,"_19451":113198,"_26530":113199,"_2682":113200},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3185":66558,"_28073":66546,"_19451":113202,"_5":13353,"_26530":66546,"_2682":113203},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3185":66559,"_28073":66546,"_19451":113205,"_5":13353,"_26530":113167,"_2682":113206},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3185":66560,"_28073":66546,"_19451":113208,"_5":13353,"_26530":113171,"_2682":113209},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3185":66561,"_28073":66546,"_19451":113211,"_5":13353,"_26530":113175,"_2682":113212},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3185":66562,"_28073":66546,"_19451":113214,"_5":13353,"_26530":113179,"_2682":113215},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3185":66563,"_28073":66546,"_19451":113217,"_5":13353,"_26530":113183,"_2682":113218},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3185":66564,"_28073":66546,"_19451":113220,"_5":13353,"_26530":113187,"_2682":113221},[],"Lamassu persiste cuatro estados X.509:",{"_3185":66565,"_28073":66546,"_19451":113223,"_5":13353,"_26530":113187,"_2682":113224},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3185":66566,"_28073":66546,"_19451":113226,"_5":13353,"_26530":113187,"_2682":113227},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3185":66567,"_28073":66546,"_19451":113229,"_5":13353,"_26530":113187,"_2682":113230},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3185":66568,"_28073":66546,"_19451":113232,"_5":13353,"_26530":113187,"_2682":113233},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3185":66569,"_28073":66546,"_19451":113235,"_5":13353,"_26530":113187,"_2682":113236},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3185":66570,"_28073":66546,"_19451":113238,"_5":13353,"_26530":113191,"_2682":113239},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3185":66571,"_28073":66546,"_19451":113241,"_5":13353,"_26530":113191,"_2682":113242},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3185":66572,"_28073":66546,"_19451":113244,"_5":13353,"_26530":113191,"_2682":113245},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3185":66573,"_28073":66546,"_19451":113247,"_5":13353,"_26530":113195,"_2682":113248},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3185":66574,"_28073":66546,"_19451":113250,"_5":13353,"_26530":113195,"_2682":113251},[],"Antes de confirmar:",{"_3185":66575,"_28073":66546,"_19451":113253,"_5":13353,"_26530":113195,"_2682":113254},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3185":66576,"_28073":66546,"_19451":113256,"_5":13353,"_26530":113195,"_2682":113257},[],"Distribuye la nueva cadena de confianza.",{"_3185":66577,"_28073":66546,"_19451":113259,"_5":13353,"_26530":113195,"_2682":113260},[],"Reemite las identidades necesarias.",{"_3185":66578,"_28073":66546,"_19451":113262,"_5":13353,"_26530":113195,"_2682":113263},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3185":66579,"_28073":66546,"_19451":113265,"_5":13353,"_26530":113195,"_2682":113266},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3185":66580,"_28073":66546,"_19451":113268,"_5":13353,"_26530":113195,"_2682":113269},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3185":66581,"_28073":66546,"_19451":113271,"_5":13353,"_26530":113199,"_2682":113272},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3185":66582,"_28073":66546,"_19451":113274,"_5":13353,"_26530":113199,"_2682":113275},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3185":66583,"_28073":66546,"_19451":113277,"_5":13353,"_26530":113199,"_2682":113278},[],"Cambios de estado y razones de revocación.",{"_3185":66584,"_28073":66546,"_19451":113280,"_5":13353,"_26530":113199,"_2682":113281},[],"Publicación y vigencia de OCSP y CRLs.",{"_3185":66585,"_28073":66546,"_19451":113283,"_5":13353,"_26530":113199,"_2682":113284},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3185":66586,"_28073":66546,"_19451":113286,"_5":13353,"_26530":113199,"_2682":113287},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3185":66587,"_28073":66587,"_5":13700,"_2682":113289,"_28416":113290,"_19451":113291,"_26530":66587},"Modelo de confianza",[45599,108686,50746,113156],[],{"_3185":66588,"_28073":66587,"_19451":113293,"_5":13353,"_26530":66587,"_2682":113294},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3185":66589,"_28073":66587,"_5":28413,"_19451":113296,"_26530":113297,"_2682":113298},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3185":66590,"_28073":66587,"_5":28413,"_19451":113300,"_26530":113301,"_2682":113302},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3185":66591,"_28073":66587,"_5":28413,"_19451":113304,"_26530":113305,"_2682":113306},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3185":66592,"_28073":66587,"_5":28413,"_19451":113308,"_26530":113309,"_2682":113310},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3185":66593,"_28073":66587,"_5":28413,"_19451":113312,"_26530":113313,"_2682":113314},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3185":66594,"_28073":66587,"_5":28413,"_19451":113316,"_26530":113317,"_2682":113318},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3185":66595,"_28073":66587,"_5":28413,"_19451":113320,"_26530":113321,"_2682":113322},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3185":66596,"_28073":66587,"_5":28413,"_19451":113324,"_26530":113325,"_2682":113326},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3185":66597,"_28073":66587,"_5":28413,"_19451":113328,"_26530":113329,"_2682":113330},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3185":66598,"_28073":66587,"_5":28413,"_19451":113332,"_26530":113333,"_2682":113334},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3185":66599,"_28073":66587,"_19451":113336,"_5":13353,"_26530":66587,"_2682":113337},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3185":66600,"_28073":66587,"_19451":113339,"_5":13353,"_26530":113301,"_2682":113340},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3185":66601,"_28073":66587,"_19451":113342,"_5":13353,"_26530":113305,"_2682":113343},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3185":66602,"_28073":66587,"_19451":113345,"_5":13353,"_26530":113309,"_2682":113346},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3185":66603,"_28073":66587,"_19451":113348,"_5":13353,"_26530":113313,"_2682":113349},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3185":66604,"_28073":66587,"_19451":113351,"_5":13353,"_26530":113317,"_2682":113352},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3185":66605,"_28073":66587,"_19451":113354,"_5":13353,"_26530":113317,"_2682":113355},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3185":66606,"_28073":66587,"_19451":113357,"_5":13353,"_26530":113317,"_2682":113358},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3185":66607,"_28073":66587,"_19451":113360,"_5":13353,"_26530":113317,"_2682":113361},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3185":66608,"_28073":66587,"_19451":113363,"_5":13353,"_26530":113317,"_2682":113364},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3185":66609,"_28073":66587,"_19451":113366,"_5":13353,"_26530":113317,"_2682":113367},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3185":66610,"_28073":66587,"_19451":113369,"_5":13353,"_26530":113321,"_2682":113370},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3185":66611,"_28073":66587,"_19451":113372,"_5":13353,"_26530":113321,"_2682":113373},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3185":66612,"_28073":66587,"_19451":113375,"_5":13353,"_26530":113321,"_2682":113376},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3185":66613,"_28073":66587,"_19451":113378,"_5":13353,"_26530":113321,"_2682":113379},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3185":66614,"_28073":66587,"_19451":113381,"_5":13353,"_26530":113321,"_2682":113382},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3185":66615,"_28073":66587,"_19451":113384,"_5":13353,"_26530":113325,"_2682":113385},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3185":66616,"_28073":66587,"_19451":113387,"_5":13353,"_26530":113325,"_2682":113388},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3185":66617,"_28073":66587,"_19451":113390,"_5":13353,"_26530":113325,"_2682":113391},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3185":66618,"_28073":66587,"_19451":113393,"_5":13353,"_26530":113325,"_2682":113394},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3185":66619,"_28073":66587,"_19451":113396,"_5":13353,"_26530":113325,"_2682":113397},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3185":66620,"_28073":66587,"_19451":113399,"_5":13353,"_26530":113325,"_2682":113400},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3185":66621,"_28073":66587,"_19451":113402,"_5":13353,"_26530":113325,"_2682":113403},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3185":66622,"_28073":66587,"_19451":113405,"_5":13353,"_26530":113329,"_2682":113406},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3185":66623,"_28073":66587,"_19451":113408,"_5":13353,"_26530":113333,"_2682":113409},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3185":66624,"_28073":66587,"_19451":113411,"_5":13353,"_26530":113333,"_2682":113412},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3185":66625,"_28073":66587,"_19451":113414,"_5":13353,"_26530":113333,"_2682":113415},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3185":66626,"_28073":66587,"_19451":113417,"_5":13353,"_26530":113333,"_2682":113418},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3185":66627,"_28073":66587,"_19451":113420,"_5":13353,"_26530":113333,"_2682":113421},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3185":66628,"_28073":66587,"_19451":113423,"_5":13353,"_26530":113333,"_2682":113424},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3185":66629,"_28073":66587,"_19451":113426,"_5":13353,"_26530":113333,"_2682":113427},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3185":66630,"_28073":66630,"_5":13700,"_2682":113429,"_28416":113430,"_19451":113431,"_26530":66630},"Listas de revocación (CRL)",[45599,108686,50746,112917],[],{"_3185":66631,"_28073":66630,"_19451":113433,"_5":13353,"_26530":66630,"_2682":113434},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3185":66632,"_28073":66630,"_5":28413,"_19451":113436,"_26530":113437,"_2682":113438},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3185":66633,"_28073":66630,"_5":28413,"_19451":113440,"_26530":113441,"_2682":113442},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3185":66634,"_28073":66630,"_5":28413,"_19451":113444,"_26530":113445,"_2682":113446},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3185":66635,"_28073":66630,"_5":28413,"_19451":113448,"_26530":113449,"_2682":113450},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3185":66636,"_28073":66630,"_5":28413,"_19451":113452,"_26530":113453,"_2682":113454},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3185":66637,"_28073":66630,"_5":28413,"_19451":113456,"_26530":113457,"_2682":113458},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3185":66638,"_28073":66630,"_5":28413,"_19451":113460,"_26530":113461,"_2682":113462},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3185":66639,"_28073":66630,"_5":28413,"_19451":113464,"_26530":113465,"_2682":113466},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#referencias","Referencias",{"_3185":66640,"_28073":66630,"_19451":113468,"_5":13353,"_26530":66630,"_2682":113469},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3185":66641,"_28073":66630,"_19451":113471,"_5":13353,"_26530":113437,"_2682":113472},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3185":66642,"_28073":66630,"_19451":113474,"_5":13353,"_26530":113437,"_2682":113475},[],"Campo de `crl_options`",{"_3185":66643,"_28073":66630,"_19451":113477,"_5":13353,"_26530":113437,"_2682":110185},[],{"_3185":66644,"_28073":66630,"_19451":113479,"_5":13353,"_26530":113437,"_2682":113480},[],"Valor inicial del backend",{"_3185":66645,"_28073":66630,"_19451":113482,"_5":13353,"_26530":113437,"_2682":51940},[],{"_3185":66646,"_28073":66630,"_19451":113484,"_5":13353,"_26530":113437,"_2682":113485},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3185":66647,"_28073":66630,"_19451":113487,"_5":13353,"_26530":113437,"_2682":113488},[],"7 días.",{"_3185":66648,"_28073":66630,"_19451":113490,"_5":13353,"_26530":113437,"_2682":51949},[],{"_3185":66649,"_28073":66630,"_19451":113492,"_5":13353,"_26530":113437,"_2682":113493},[],"Plazo desde la publicación que activa la renovación programada.",{"_3185":66650,"_28073":66630,"_19451":113495,"_5":13353,"_26530":113437,"_2682":113496},[],"6 días y 23 horas.",{"_3185":66651,"_28073":66630,"_19451":113498,"_5":13353,"_26530":113437,"_2682":51958},[],{"_3185":66652,"_28073":66630,"_19451":113500,"_5":13353,"_26530":113437,"_2682":113501},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3185":66653,"_28073":66630,"_19451":113503,"_5":13353,"_26530":113437,"_2682":51964},[],{"_3185":66654,"_28073":66630,"_19451":113505,"_5":13353,"_26530":113437,"_2682":51967},[],{"_3185":66655,"_28073":66630,"_19451":113507,"_5":13353,"_26530":113437,"_2682":113508},[],"Número de serie del certificado existente que firma la CRL.",{"_3185":66656,"_28073":66630,"_19451":113510,"_5":13353,"_26530":113437,"_2682":113511},[],"Número de serie del certificado actual de la CA.",{"_3185":66657,"_28073":66630,"_19451":113513,"_5":13353,"_26530":113437,"_2682":113514},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3185":66658,"_28073":66630,"_19451":113516,"_5":13353,"_26530":113437,"_2682":113517},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_3185":66659,"_28073":66630,"_19451":113519,"_5":13353,"_26530":113437,"_2682":113520},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API: puede consultarse, pero no actualizarse (la API devuelve 404). Ajusta validez, intervalo y firmante antes de eliminarla.",{"_3185":66660,"_28073":66630,"_19451":113522,"_5":13353,"_26530":113437,"_2682":113523},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya.",{"_3185":66661,"_28073":66630,"_19451":113525,"_5":13353,"_26530":113437,"_2682":113526},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3185":66662,"_28073":66630,"_19451":113528,"_5":13353,"_26530":113441,"_2682":113529},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3185":66663,"_28073":66630,"_19451":113531,"_5":13353,"_26530":113441,"_2682":113532},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.3) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3185":66664,"_28073":66630,"_19451":113534,"_5":13353,"_26530":113441,"_2682":113535},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3185":66665,"_28073":66630,"_19451":113537,"_5":13353,"_26530":113441,"_2682":113538},[],"Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Limita además el permiso de importar CAs, porque una CA importada con un SKI colisionante puede dejar sin CRL a la legítima.",{"_3185":66666,"_28073":66630,"_19451":113540,"_5":13353,"_26530":113445,"_2682":113541},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3185":66667,"_28073":66630,"_19451":113543,"_5":13353,"_26530":113445,"_2682":113544},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3185":66668,"_28073":66630,"_19451":113546,"_5":13353,"_26530":113445,"_2682":113547},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3185":66669,"_28073":66630,"_19451":113549,"_5":13353,"_26530":113449,"_2682":113550},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3185":66670,"_28073":66630,"_19451":113552,"_5":13353,"_26530":113449,"_2682":113553},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3185":66671,"_28073":66630,"_19451":113555,"_5":13353,"_26530":113453,"_2682":113556},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3185":66672,"_28073":66630,"_19451":113558,"_5":13353,"_26530":113453,"_2682":113559},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3185":66673,"_28073":66630,"_19451":113561,"_5":13353,"_26530":113453,"_2682":113562},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3185":66674,"_28073":66630,"_19451":113564,"_5":13353,"_26530":113453,"_2682":113565},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3185":66675,"_28073":66630,"_19451":113567,"_5":13353,"_26530":113453,"_2682":113568},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3185":66676,"_28073":66630,"_19451":113570,"_5":13353,"_26530":113457,"_2682":113571},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3185":66677,"_28073":66630,"_19451":113573,"_5":13353,"_26530":113457,"_2682":110374},[],{"_3185":66678,"_28073":66630,"_19451":113575,"_5":13353,"_26530":113457,"_2682":113576},[],"Path relativo",{"_3185":66679,"_28073":66630,"_19451":113578,"_5":13353,"_26530":113457,"_2682":108449},[],{"_3185":66680,"_28073":66630,"_19451":113580,"_5":13353,"_26530":113457,"_2682":52043},[],{"_3185":66681,"_28073":66630,"_19451":113582,"_5":13353,"_26530":113457,"_2682":52046},[],{"_3185":66682,"_28073":66630,"_19451":113584,"_5":13353,"_26530":113457,"_2682":113585},[],"Consultar `crl_options` y `latest_crl`.",{"_3185":66683,"_28073":66630,"_19451":113587,"_5":13353,"_26530":113457,"_2682":52052},[],{"_3185":66684,"_28073":66630,"_19451":113589,"_5":13353,"_26530":113457,"_2682":52046},[],{"_3185":66685,"_28073":66630,"_19451":113591,"_5":13353,"_26530":113457,"_2682":113592},[],"Sustituir la configuración de CRL.",{"_3185":66686,"_28073":66630,"_19451":113594,"_5":13353,"_26530":113457,"_2682":113595},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3185":66687,"_28073":66630,"_19451":113597,"_5":13353,"_26530":113457,"_2682":113598},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3185":66688,"_28073":66630,"_19451":113600,"_5":13353,"_26530":113461,"_2682":113601},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3185":66689,"_28073":66630,"_19451":113603,"_5":13353,"_26530":113465,"_2682":113604},[],"RFC 5280: perfil X.509 y CRL.",{"_3185":66690,"_28073":66630,"_19451":113606,"_5":13353,"_26530":113465,"_2682":52072},[],{"_3185":66691,"_28073":66630,"_19451":113608,"_5":13353,"_26530":113465,"_2682":52075},[],{"_3185":66692,"_28073":66630,"_19451":113610,"_5":13353,"_26530":113465,"_2682":113611},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3185":66693,"_28073":66630,"_19451":113613,"_5":13353,"_26530":113465,"_2682":113614},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3185":66694,"_28073":66694,"_5":13700,"_2682":113616,"_28416":113617,"_19451":113618,"_26530":66694},"Claves y motores criptográficos",[45599,108686,50746,112292],[],{"_3185":66695,"_28073":66694,"_19451":113620,"_5":13353,"_26530":66694,"_2682":113621},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3185":66696,"_28073":66694,"_5":28413,"_19451":113623,"_26530":113624,"_2682":113625},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3185":66697,"_28073":66694,"_5":28413,"_19451":113627,"_26530":113628,"_2682":113629},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3185":66698,"_28073":66694,"_5":28413,"_19451":113631,"_26530":113632,"_2682":52100},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#file-system",{"_3185":66699,"_28073":66694,"_5":28413,"_19451":113634,"_26530":113635,"_2682":52104},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#hashicorp-vault",{"_3185":66700,"_28073":66694,"_5":28413,"_19451":113637,"_26530":113638,"_2682":52108},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#aws-secrets-manager",{"_3185":66701,"_28073":66694,"_5":28413,"_19451":113640,"_26530":113641,"_2682":52112},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#aws-kms",{"_3185":66702,"_28073":66694,"_5":28413,"_19451":113643,"_26530":113644,"_2682":52116},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#pkcs11",{"_3185":66703,"_28073":66694,"_5":28413,"_19451":113646,"_26530":113647,"_2682":52120},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#azure-key-vault",{"_3185":66704,"_28073":66694,"_5":28413,"_19451":113649,"_26530":113650,"_2682":113651},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3185":66705,"_28073":66694,"_5":28413,"_19451":113653,"_26530":113654,"_2682":113655},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3185":66706,"_28073":66694,"_5":28413,"_19451":113657,"_26530":113658,"_2682":113659},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3185":66707,"_28073":66694,"_5":28413,"_19451":113661,"_26530":113662,"_2682":113663},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3185":66708,"_28073":66694,"_5":28413,"_19451":113665,"_26530":113666,"_2682":113667},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3185":66709,"_28073":66694,"_5":28413,"_19451":113669,"_26530":113670,"_2682":113671},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3185":66710,"_28073":66694,"_5":28413,"_19451":113673,"_26530":113674,"_2682":113675},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3185":66711,"_28073":66694,"_5":28413,"_19451":113677,"_26530":113678,"_2682":52152},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#sign",{"_3185":66712,"_28073":66694,"_5":28413,"_19451":113680,"_26530":113681,"_2682":52156},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#verify",{"_3185":66713,"_28073":66694,"_5":28413,"_19451":113683,"_26530":113684,"_2682":113685},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3185":66714,"_28073":66694,"_5":28413,"_19451":113687,"_26530":113688,"_2682":113689},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3185":66715,"_28073":66694,"_5":28413,"_19451":113691,"_26530":113692,"_2682":113693},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3185":66716,"_28073":66694,"_19451":113695,"_5":13353,"_26530":66694,"_2682":113696},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3185":66717,"_28073":66694,"_19451":113698,"_5":13353,"_26530":66694,"_2682":113699},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3185":66718,"_28073":66694,"_19451":113701,"_5":13353,"_26530":113624,"_2682":113702},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3185":66719,"_28073":66694,"_19451":113704,"_5":13353,"_26530":113624,"_2682":113705},[],"En la práctica, permite:",{"_3185":66720,"_28073":66694,"_19451":113707,"_5":13353,"_26530":113624,"_2682":113708},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3185":66721,"_28073":66694,"_19451":113710,"_5":13353,"_26530":113624,"_2682":113711},[],"Importar claves creadas externamente.",{"_3185":66722,"_28073":66694,"_19451":113713,"_5":13353,"_26530":113624,"_2682":113714},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3185":66723,"_28073":66694,"_19451":113716,"_5":13353,"_26530":113624,"_2682":113717},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3185":66724,"_28073":66694,"_19451":113719,"_5":13353,"_26530":113628,"_2682":113720},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3185":66725,"_28073":66694,"_19451":113722,"_5":13353,"_26530":113628,"_2682":113723},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3185":66726,"_28073":66694,"_19451":113725,"_5":13353,"_26530":113628,"_2682":113726},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3185":66727,"_28073":66694,"_19451":113728,"_5":13353,"_26530":113632,"_2682":113729},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3185":66728,"_28073":66694,"_19451":113731,"_5":13353,"_26530":113635,"_2682":113732},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3185":66729,"_28073":66694,"_19451":113734,"_5":13353,"_26530":113638,"_2682":113735},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3185":66730,"_28073":66694,"_19451":113737,"_5":13353,"_26530":113641,"_2682":113738},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3185":66731,"_28073":66694,"_19451":113740,"_5":13353,"_26530":113644,"_2682":113741},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3185":66732,"_28073":66694,"_19451":113743,"_5":13353,"_26530":113647,"_2682":113744},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3185":66733,"_28073":66694,"_19451":113746,"_5":13353,"_26530":113647,"_2682":113747},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3185":66734,"_28073":66694,"_19451":113749,"_5":13353,"_26530":113647,"_2682":113750},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3185":66735,"_28073":66694,"_19451":113752,"_5":13353,"_26530":113647,"_2682":113753},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3185":66736,"_28073":66694,"_19451":113755,"_5":13353,"_26530":113650,"_2682":113756},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3185":66737,"_28073":66694,"_19451":113758,"_5":13353,"_26530":113650,"_2682":113759},[],"La tabla incluye los siguientes campos:",{"_3185":66738,"_28073":66694,"_19451":113761,"_5":13353,"_26530":113650,"_2682":113762},[],"**Name**: nombre descriptivo de la clave.",{"_3185":66739,"_28073":66694,"_19451":113764,"_5":13353,"_26530":113650,"_2682":113765},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3185":66740,"_28073":66694,"_19451":113767,"_5":13353,"_26530":113650,"_2682":113768},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3185":66741,"_28073":66694,"_19451":113770,"_5":13353,"_26530":113650,"_2682":113771},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3185":66742,"_28073":66694,"_19451":113773,"_5":13353,"_26530":113650,"_2682":113774},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3185":66743,"_28073":66694,"_19451":113776,"_5":13353,"_26530":113650,"_2682":113777},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3185":66744,"_28073":66694,"_19451":113779,"_5":13353,"_26530":113650,"_2682":113780},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3185":66745,"_28073":66694,"_19451":113782,"_5":13353,"_26530":113650,"_2682":113783},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3185":66746,"_28073":66694,"_19451":113785,"_5":13353,"_26530":113650,"_2682":113786},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3185":66747,"_28073":66694,"_19451":113788,"_5":13353,"_26530":113650,"_2682":113789},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3185":66748,"_28073":66694,"_19451":113791,"_5":13353,"_26530":113650,"_2682":113792},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3185":66749,"_28073":66694,"_19451":113794,"_5":13353,"_26530":113650,"_2682":113795},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3185":66750,"_28073":66694,"_19451":113797,"_5":13353,"_26530":113650,"_2682":113798},[],"**Delete Key** para eliminar la clave del sistema.",{"_3185":66751,"_28073":66694,"_19451":113800,"_5":13353,"_26530":113654,"_2682":113801},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3185":66752,"_28073":66694,"_19451":113803,"_5":13353,"_26530":113658,"_2682":113804},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3185":66753,"_28073":66694,"_19451":113806,"_5":13353,"_26530":113658,"_2682":113807},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3185":66754,"_28073":66694,"_19451":113809,"_5":13353,"_26530":113658,"_2682":113810},[],"**Key Name**: nombre único y descriptivo.",{"_3185":66755,"_28073":66694,"_19451":113812,"_5":13353,"_26530":113658,"_2682":113813},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3185":66756,"_28073":66694,"_19451":113815,"_5":13353,"_26530":113658,"_2682":113816},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3185":66757,"_28073":66694,"_19451":113818,"_5":13353,"_26530":113658,"_2682":113819},[],"**Tags**: metadatos para clasificar la clave.",{"_3185":66758,"_28073":66694,"_19451":113821,"_5":13353,"_26530":113658,"_2682":113822},[],"**Metadata**: información adicional para usos avanzados.",{"_3185":66759,"_28073":66694,"_19451":113824,"_5":13353,"_26530":113662,"_2682":113825},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3185":66760,"_28073":66694,"_19451":113827,"_5":13353,"_26530":113662,"_2682":113828},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3185":66761,"_28073":66694,"_19451":113830,"_5":13353,"_26530":113662,"_2682":113831},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3185":66762,"_28073":66694,"_19451":113833,"_5":13353,"_26530":113662,"_2682":113834},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3185":66763,"_28073":66694,"_19451":113836,"_5":13353,"_26530":113662,"_2682":113837},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3185":66764,"_28073":66694,"_19451":113839,"_5":13353,"_26530":113662,"_2682":113840},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3185":66765,"_28073":66694,"_19451":113842,"_5":13353,"_26530":113662,"_2682":113843},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3185":66766,"_28073":66694,"_19451":113845,"_5":13353,"_26530":113662,"_2682":113846},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3185":66767,"_28073":66694,"_19451":113848,"_5":13353,"_26530":113662,"_2682":113849},[],"**Metadata**: información adicional opcional.",{"_3185":66768,"_28073":66694,"_19451":113851,"_5":13353,"_26530":113662,"_2682":113852},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3185":66769,"_28073":66694,"_19451":113854,"_5":13353,"_26530":113662,"_2682":113855},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3185":66770,"_28073":66694,"_19451":113857,"_5":13353,"_26530":113666,"_2682":113858},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3185":66771,"_28073":66694,"_19451":113860,"_5":13353,"_26530":113670,"_2682":113861},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3185":66772,"_28073":66694,"_19451":113863,"_5":13353,"_26530":113670,"_2682":113864},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3185":66773,"_28073":66694,"_19451":113866,"_5":13353,"_26530":113670,"_2682":113867},[],"**Key Name**: nombre descriptivo.",{"_3185":66774,"_28073":66694,"_19451":113869,"_5":13353,"_26530":113670,"_2682":113870},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3185":66775,"_28073":66694,"_19451":113872,"_5":13353,"_26530":113670,"_2682":113873},[],"**Tags**: etiquetas asociadas.",{"_3185":66776,"_28073":66694,"_19451":113875,"_5":13353,"_26530":113670,"_2682":113876},[],"**Aliases**: nombres alternativos.",{"_3185":66777,"_28073":66694,"_19451":113878,"_5":13353,"_26530":113670,"_2682":113879},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3185":66778,"_28073":66694,"_19451":113881,"_5":13353,"_26530":113670,"_2682":113882},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3185":66779,"_28073":66694,"_19451":113884,"_5":13353,"_26530":113670,"_2682":113885},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3185":66780,"_28073":66694,"_19451":113887,"_5":13353,"_26530":113670,"_2682":113888},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3185":66781,"_28073":66694,"_19451":113890,"_5":13353,"_26530":113674,"_2682":113891},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3185":66782,"_28073":66694,"_19451":113893,"_5":13353,"_26530":113674,"_2682":113894},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3185":66783,"_28073":66694,"_19451":113896,"_5":13353,"_26530":113674,"_2682":113897},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3185":66784,"_28073":66694,"_19451":113899,"_5":13353,"_26530":113678,"_2682":113900},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3185":66785,"_28073":66694,"_19451":113902,"_5":13353,"_26530":113678,"_2682":113903},[],"Campos principales:",{"_3185":66786,"_28073":66694,"_19451":113905,"_5":13353,"_26530":113678,"_2682":113906},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3185":66787,"_28073":66694,"_19451":113908,"_5":13353,"_26530":113678,"_2682":113909},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3185":66788,"_28073":66694,"_19451":113911,"_5":13353,"_26530":113678,"_2682":113912},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3185":66789,"_28073":66694,"_19451":113914,"_5":13353,"_26530":113678,"_2682":113915},[],"**Message**: contenido que se va a firmar.",{"_3185":66790,"_28073":66694,"_19451":113917,"_5":13353,"_26530":113678,"_2682":113918},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3185":66791,"_28073":66694,"_19451":113920,"_5":13353,"_26530":113681,"_2682":113921},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3185":66792,"_28073":66694,"_19451":113923,"_5":13353,"_26530":113681,"_2682":113903},[],{"_3185":66793,"_28073":66694,"_19451":113925,"_5":13353,"_26530":113681,"_2682":113926},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3185":66794,"_28073":66694,"_19451":113928,"_5":13353,"_26530":113681,"_2682":113929},[],"**Message Type**: `Raw` o `Digest`.",{"_3185":66795,"_28073":66694,"_19451":113931,"_5":13353,"_26530":113681,"_2682":113932},[],"**Payload Encoding**: codificación del mensaje.",{"_3185":66796,"_28073":66694,"_19451":113934,"_5":13353,"_26530":113681,"_2682":113935},[],"**Message**: mensaje original o hash.",{"_3185":66797,"_28073":66694,"_19451":113937,"_5":13353,"_26530":113681,"_2682":113938},[],"**Signature**: firma que se desea comprobar.",{"_3185":66798,"_28073":66694,"_19451":113940,"_5":13353,"_26530":113681,"_2682":113941},[],"**Result**: indicador del resultado de la validación.",{"_3185":66799,"_28073":66694,"_19451":113943,"_5":13353,"_26530":113684,"_2682":113944},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3185":66800,"_28073":66694,"_19451":113946,"_5":13353,"_26530":113684,"_2682":113947},[],"Este flujo es útil para:",{"_3185":66801,"_28073":66694,"_19451":113949,"_5":13353,"_26530":113684,"_2682":113950},[],"Solicitar certificados a una CA externa.",{"_3185":66802,"_28073":66694,"_19451":113952,"_5":13353,"_26530":113684,"_2682":113953},[],"Renovar una identidad manteniendo la misma clave.",{"_3185":66803,"_28073":66694,"_19451":113955,"_5":13353,"_26530":113684,"_2682":113956},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3185":66804,"_28073":66694,"_19451":113958,"_5":13353,"_26530":113684,"_2682":113959},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3185":66805,"_28073":66694,"_19451":113961,"_5":13353,"_26530":113684,"_2682":113962},[],"**Organization (O)**: organización o empresa.",{"_3185":66806,"_28073":66694,"_19451":113964,"_5":13353,"_26530":113684,"_2682":113965},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3185":66807,"_28073":66694,"_19451":113967,"_5":13353,"_26530":113684,"_2682":113968},[],"**Country (C)**: código de país de dos letras.",{"_3185":66808,"_28073":66694,"_19451":113970,"_5":13353,"_26530":113684,"_2682":113971},[],"**State / Province (ST)**: estado o provincia.",{"_3185":66809,"_28073":66694,"_19451":113973,"_5":13353,"_26530":113684,"_2682":113974},[],"**Locality (L)**: ciudad o localidad.",{"_3185":66810,"_28073":66694,"_19451":113976,"_5":13353,"_26530":113684,"_2682":113977},[],"**Email Address**: correo de contacto.",{"_3185":66811,"_28073":66694,"_19451":113979,"_5":13353,"_26530":113684,"_2682":113980},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3185":66812,"_28073":66694,"_19451":113982,"_5":13353,"_26530":113684,"_2682":113983},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3185":66813,"_28073":66694,"_19451":113985,"_5":13353,"_26530":113688,"_2682":113986},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3185":66814,"_28073":66694,"_19451":113988,"_5":13353,"_26530":113688,"_2682":52464},[],{"_3185":66815,"_28073":66694,"_19451":113990,"_5":13353,"_26530":113692,"_2682":113991},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3185":66816,"_28073":66816,"_5":13700,"_2682":113993,"_28416":113994,"_19451":113995,"_26530":66816},"Validación online con OCSP",[45599,108686,50746,112917],[],{"_3185":66817,"_28073":66816,"_19451":113997,"_5":13353,"_26530":66816,"_2682":113998},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3185":66818,"_28073":66816,"_5":28413,"_19451":114000,"_26530":114001,"_2682":114002},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3185":66819,"_28073":66816,"_5":28413,"_19451":114004,"_26530":114005,"_2682":114006},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3185":66820,"_28073":66816,"_5":28413,"_19451":114008,"_26530":114009,"_2682":114010},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3185":66821,"_28073":66816,"_5":28413,"_19451":114012,"_26530":114013,"_2682":114014},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3185":66822,"_28073":66816,"_5":28413,"_19451":114016,"_26530":114017,"_2682":114018},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3185":66823,"_28073":66816,"_5":28413,"_19451":114020,"_26530":114021,"_2682":113466},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#referencias",{"_3185":66824,"_28073":66816,"_19451":114023,"_5":13353,"_26530":66816,"_2682":114024},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3185":66825,"_28073":66816,"_19451":114026,"_5":13353,"_26530":114001,"_2682":114027},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3185":66826,"_28073":66816,"_19451":114029,"_5":13353,"_26530":114001,"_2682":114030},[],"Estado del registro",{"_3185":66827,"_28073":66816,"_19451":114032,"_5":13353,"_26530":114001,"_2682":114033},[],"Respuesta firmada",{"_3185":66828,"_28073":66816,"_19451":114035,"_5":13353,"_26530":114001,"_2682":49915},[],{"_3185":66829,"_28073":66816,"_19451":114037,"_5":13353,"_26530":114001,"_2682":52514},[],{"_3185":66830,"_28073":66816,"_19451":114039,"_5":13353,"_26530":114001,"_2682":49932},[],{"_3185":66831,"_28073":66816,"_19451":114041,"_5":13353,"_26530":114001,"_2682":114042},[],"`Revoked`, con razón y fecha de revocación.",{"_3185":66832,"_28073":66816,"_19451":114044,"_5":13353,"_26530":114001,"_2682":114045},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3185":66833,"_28073":66816,"_19451":114047,"_5":13353,"_26530":114001,"_2682":114048},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3185":66834,"_28073":66816,"_19451":114050,"_5":13353,"_26530":114001,"_2682":114051},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3185":66835,"_28073":66816,"_19451":114053,"_5":13353,"_26530":114001,"_2682":114054},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3185":66836,"_28073":66816,"_19451":114056,"_5":13353,"_26530":114001,"_2682":114057},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3185":66837,"_28073":66816,"_19451":114059,"_5":13353,"_26530":114005,"_2682":114060},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3185":66838,"_28073":66816,"_19451":114062,"_5":13353,"_26530":114005,"_2682":114063},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3185":66839,"_28073":66816,"_19451":114065,"_5":13353,"_26530":114009,"_2682":114066},[],"El servicio acepta:",{"_3185":66840,"_28073":66816,"_19451":114068,"_5":13353,"_26530":114009,"_2682":110374},[],{"_3185":66841,"_28073":66816,"_19451":114070,"_5":13353,"_26530":114009,"_2682":114071},[],"Ruta del servicio VA",{"_3185":66842,"_28073":66816,"_19451":114073,"_5":13353,"_26530":114009,"_2682":114074},[],"Formato",{"_3185":66843,"_28073":66816,"_19451":114076,"_5":13353,"_26530":114009,"_2682":52554},[],{"_3185":66844,"_28073":66816,"_19451":114078,"_5":13353,"_26530":114009,"_2682":52557},[],{"_3185":66845,"_28073":66816,"_19451":114080,"_5":13353,"_26530":114009,"_2682":114081},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3185":66846,"_28073":66816,"_19451":114083,"_5":13353,"_26530":114009,"_2682":52043},[],{"_3185":66847,"_28073":66816,"_19451":114085,"_5":13353,"_26530":114009,"_2682":52565},[],{"_3185":66848,"_28073":66816,"_19451":114087,"_5":13353,"_26530":114009,"_2682":114088},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3185":66849,"_28073":66816,"_19451":114090,"_5":13353,"_26530":114009,"_2682":114091},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3185":66850,"_28073":66816,"_19451":114093,"_5":13353,"_26530":114013,"_2682":114094},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3185":66851,"_28073":66816,"_19451":114096,"_5":13353,"_26530":114013,"_2682":114097},[],"Genera la solicitud:",{"_3185":66852,"_28073":66816,"_19451":114099,"_5":13353,"_26530":114013,"_2682":114100},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3185":66853,"_28073":66816,"_19451":114102,"_5":13353,"_26530":114013,"_2682":114103},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3185":66854,"_28073":66816,"_19451":114105,"_5":13353,"_26530":114013,"_2682":114106},[],"Verifica el DER recibido:",{"_3185":66855,"_28073":66816,"_19451":114108,"_5":13353,"_26530":114013,"_2682":114109},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3185":66856,"_28073":66816,"_19451":114111,"_5":13353,"_26530":114017,"_2682":114112},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3185":66857,"_28073":66816,"_19451":114114,"_5":13353,"_26530":114017,"_2682":114115},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3185":66858,"_28073":66816,"_19451":114117,"_5":13353,"_26530":114021,"_2682":52598},[],{"_3185":66859,"_28073":66816,"_19451":114119,"_5":13353,"_26530":114021,"_2682":52601},[],{"_3185":66860,"_28073":66816,"_19451":114121,"_5":13353,"_26530":114021,"_2682":114122},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3185":66861,"_28073":66816,"_19451":114124,"_5":13353,"_26530":114021,"_2682":113614},[],{"_3185":66862,"_28073":66862,"_5":13700,"_2682":50746,"_28416":114126,"_19451":114127,"_26530":66862},[45599,108686,50746],[],{"_3185":66863,"_28073":66862,"_19451":114129,"_5":13353,"_26530":66862,"_2682":114130},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3185":66864,"_28073":66862,"_5":28413,"_19451":114132,"_26530":114133,"_2682":111616},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#empieza-aquí",{"_3185":66865,"_28073":66862,"_5":28413,"_19451":114135,"_26530":114136,"_2682":114137},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3185":66866,"_28073":66862,"_5":28413,"_19451":114139,"_26530":114140,"_2682":112138},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#capacidades-principales",{"_3185":66867,"_28073":66862,"_5":28413,"_19451":114142,"_26530":114143,"_2682":112142},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3185":66868,"_28073":66862,"_5":28413,"_19451":114145,"_26530":114146,"_2682":112146},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3185":66869,"_28073":66862,"_5":28413,"_19451":114148,"_26530":114149,"_2682":112150},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#emite-y-controla-certificados",{"_3185":66870,"_28073":66862,"_5":28413,"_19451":114151,"_26530":114152,"_2682":112158},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#publica-el-estado-de-validación",{"_3185":66871,"_28073":66862,"_5":28413,"_19451":114154,"_26530":114155,"_2682":114156},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3185":66872,"_28073":66862,"_5":28413,"_19451":114158,"_26530":114159,"_2682":113083},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#continúa",{"_3185":66873,"_28073":66862,"_19451":114161,"_5":13353,"_26530":66862,"_2682":114162},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3185":66874,"_28073":66862,"_19451":114164,"_5":13353,"_26530":114133,"_2682":114165},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3185":66875,"_28073":66862,"_19451":114167,"_5":13353,"_26530":114133,"_2682":114168},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3185":66876,"_28073":66862,"_19451":114170,"_5":13353,"_26530":114136,"_2682":114171},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3185":66877,"_28073":66862,"_19451":114173,"_5":13353,"_26530":114136,"_2682":114174},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3185":66878,"_28073":66862,"_19451":114176,"_5":13353,"_26530":114136,"_2682":114177},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3185":66879,"_28073":66862,"_19451":114179,"_5":13353,"_26530":114136,"_2682":114180},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3185":66880,"_28073":66862,"_19451":114182,"_5":13353,"_26530":114136,"_2682":114183},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3185":66881,"_28073":66862,"_19451":114185,"_5":13353,"_26530":114143,"_2682":114186},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3185":66882,"_28073":66862,"_19451":114188,"_5":13353,"_26530":114146,"_2682":114189},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3185":66883,"_28073":66862,"_19451":114191,"_5":13353,"_26530":114149,"_2682":114192},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3185":66884,"_28073":66862,"_19451":114194,"_5":13353,"_26530":114152,"_2682":114195},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3185":66885,"_28073":66862,"_19451":114197,"_5":13353,"_26530":114155,"_2682":114198},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3185":66886,"_28073":66862,"_19451":114200,"_5":13353,"_26530":114155,"_2682":114201},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3185":66887,"_28073":66862,"_19451":114203,"_5":13353,"_26530":114155,"_2682":114204},[],"su clave pública corresponda a la clave privada del cliente;",{"_3185":66888,"_28073":66862,"_19451":114206,"_5":13353,"_26530":114155,"_2682":114207},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3185":66889,"_28073":66862,"_19451":114209,"_5":13353,"_26530":114155,"_2682":114210},[],"sus fechas y usos permitan la operación;",{"_3185":66890,"_28073":66862,"_19451":114212,"_5":13353,"_26530":114155,"_2682":114213},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3185":66891,"_28073":66862,"_19451":114215,"_5":13353,"_26530":114155,"_2682":114216},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3185":66892,"_28073":66862,"_19451":114218,"_5":13353,"_26530":114159,"_2682":114219},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3185":66893,"_28073":66862,"_19451":114221,"_5":13353,"_26530":114159,"_2682":114222},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3185":66894,"_28073":66862,"_19451":114224,"_5":13353,"_26530":114159,"_2682":114225},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3185":66895,"_28073":66895,"_5":13700,"_2682":114227,"_28416":114228,"_19451":114229,"_26530":66895},"Crea tu primera CA",[45599,108686,50746,111740],[],{"_3185":66896,"_28073":66895,"_19451":114231,"_5":13353,"_26530":66895,"_2682":114232},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3185":66897,"_28073":66895,"_5":28413,"_19451":114234,"_26530":114235,"_2682":107296},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3185":66898,"_28073":66895,"_5":28413,"_19451":114237,"_26530":114238,"_2682":114239},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3185":66899,"_28073":66895,"_5":28413,"_19451":114241,"_26530":114242,"_2682":114243},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3185":66900,"_28073":66895,"_5":28413,"_19451":114245,"_26530":114246,"_2682":114247},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3185":66901,"_28073":66895,"_5":28413,"_19451":114249,"_26530":114250,"_2682":114251},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3185":66902,"_28073":66895,"_5":28413,"_19451":114253,"_26530":114254,"_2682":114255},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3185":66903,"_28073":66895,"_5":28413,"_19451":114257,"_26530":114258,"_2682":114259},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3185":66904,"_28073":66895,"_5":28413,"_19451":114261,"_26530":114262,"_2682":111988},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3185":66905,"_28073":66895,"_5":28413,"_19451":114264,"_26530":114265,"_2682":107320},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3185":66906,"_28073":66895,"_19451":114267,"_5":13353,"_26530":66895,"_2682":114268},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3185":66907,"_28073":66895,"_19451":114270,"_5":13353,"_26530":114235,"_2682":114271},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3185":66908,"_28073":66895,"_19451":114273,"_5":13353,"_26530":114235,"_2682":114274},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3185":66909,"_28073":66895,"_19451":114276,"_5":13353,"_26530":114235,"_2682":114277},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3185":66910,"_28073":66895,"_19451":114279,"_5":13353,"_26530":114235,"_2682":114280},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3185":66911,"_28073":66895,"_19451":114282,"_5":13353,"_26530":114238,"_2682":114283},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3185":66912,"_28073":66895,"_19451":114285,"_5":13353,"_26530":114238,"_2682":114286},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3185":66913,"_28073":66895,"_19451":114288,"_5":13353,"_26530":114242,"_2682":114289},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3185":66914,"_28073":66895,"_19451":114291,"_5":13353,"_26530":114242,"_2682":114292},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3185":66915,"_28073":66895,"_19451":114294,"_5":13353,"_26530":114246,"_2682":114295},[],"Selecciona **Root CA** y completa:",{"_3185":66916,"_28073":66895,"_19451":114297,"_5":13353,"_26530":114246,"_2682":52780},[],{"_3185":66917,"_28073":66895,"_19451":114299,"_5":13353,"_26530":114246,"_2682":114300},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3185":66918,"_28073":66895,"_19451":114302,"_5":13353,"_26530":114246,"_2682":114303},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3185":66919,"_28073":66895,"_19451":114305,"_5":13353,"_26530":114246,"_2682":114306},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3185":66920,"_28073":66895,"_19451":114308,"_5":13353,"_26530":114246,"_2682":114309},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3185":66921,"_28073":66895,"_19451":114311,"_5":13353,"_26530":114250,"_2682":114312},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3185":66922,"_28073":66895,"_19451":114314,"_5":13353,"_26530":114254,"_2682":114315},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3185":66923,"_28073":66895,"_19451":114317,"_5":13353,"_26530":114254,"_2682":114318},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3185":66924,"_28073":66895,"_19451":114320,"_5":13353,"_26530":114258,"_2682":114321},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3185":66925,"_28073":66895,"_19451":114323,"_5":13353,"_26530":114258,"_2682":114324},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3185":66926,"_28073":66895,"_19451":114326,"_5":13353,"_26530":114258,"_2682":114327},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3185":66927,"_28073":66895,"_19451":114329,"_5":13353,"_26530":114262,"_2682":114330},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3185":66928,"_28073":66895,"_19451":114332,"_5":13353,"_26530":114262,"_2682":114333},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3185":66929,"_28073":66895,"_19451":114335,"_5":13353,"_26530":114262,"_2682":114336},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3185":66930,"_28073":66895,"_19451":114338,"_5":13353,"_26530":114262,"_2682":114339},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3185":66931,"_28073":66895,"_19451":114341,"_5":13353,"_26530":114265,"_2682":114342},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3185":66932,"_28073":66932,"_5":13700,"_2682":114344,"_28416":114345,"_19451":114346,"_26530":66932},"Emite y verifica un certificado",[45599,108686,50746,111740],[],{"_3185":66933,"_28073":66932,"_19451":114348,"_5":13353,"_26530":66932,"_2682":114349},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3185":66934,"_28073":66932,"_5":28413,"_19451":114351,"_26530":114352,"_2682":107296},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3185":66935,"_28073":66932,"_5":28413,"_19451":114354,"_26530":114355,"_2682":114356},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3185":66936,"_28073":66932,"_5":28413,"_19451":114358,"_26530":114359,"_2682":114360},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3185":66937,"_28073":66932,"_5":28413,"_19451":114362,"_26530":114363,"_2682":114364},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3185":66938,"_28073":66932,"_5":28413,"_19451":114366,"_26530":114367,"_2682":114368},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3185":66939,"_28073":66932,"_5":28413,"_19451":114370,"_26530":114371,"_2682":114372},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3185":66940,"_28073":66932,"_5":28413,"_19451":114374,"_26530":114375,"_2682":114255},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3185":66941,"_28073":66932,"_5":28413,"_19451":114377,"_26530":114378,"_2682":114379},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3185":66942,"_28073":66932,"_5":28413,"_19451":114381,"_26530":114382,"_2682":114383},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3185":66943,"_28073":66932,"_5":28413,"_19451":114385,"_26530":114386,"_2682":114387},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3185":66944,"_28073":66932,"_5":28413,"_19451":114389,"_26530":114390,"_2682":111988},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3185":66945,"_28073":66932,"_5":28413,"_19451":114392,"_26530":114393,"_2682":107320},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3185":66946,"_28073":66932,"_19451":114395,"_5":13353,"_26530":66932,"_2682":114396},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3185":66947,"_28073":66932,"_19451":114398,"_5":13353,"_26530":114352,"_2682":114399},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3185":66948,"_28073":66932,"_19451":114401,"_5":13353,"_26530":114352,"_2682":114402},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3185":66949,"_28073":66932,"_19451":114404,"_5":13353,"_26530":114352,"_2682":114405},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3185":66950,"_28073":66932,"_19451":114407,"_5":13353,"_26530":114352,"_2682":114408},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3185":66951,"_28073":66932,"_19451":114410,"_5":13353,"_26530":114352,"_2682":114411},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3185":66952,"_28073":66932,"_19451":114413,"_5":13353,"_26530":114355,"_2682":114414},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3185":66953,"_28073":66932,"_19451":114416,"_5":13353,"_26530":114359,"_2682":114417},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3185":66954,"_28073":66932,"_19451":114419,"_5":13353,"_26530":114359,"_2682":114420},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3185":66955,"_28073":66932,"_19451":114422,"_5":13353,"_26530":114363,"_2682":114423},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3185":66956,"_28073":66932,"_19451":114425,"_5":13353,"_26530":114363,"_2682":114426},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3185":66957,"_28073":66932,"_19451":114428,"_5":13353,"_26530":114367,"_2682":114429},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3185":66958,"_28073":66932,"_19451":114431,"_5":13353,"_26530":114367,"_2682":114432},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3185":66959,"_28073":66932,"_19451":114434,"_5":13353,"_26530":114371,"_2682":114435},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3185":66960,"_28073":66932,"_19451":114437,"_5":13353,"_26530":114375,"_2682":114438},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3185":66961,"_28073":66932,"_19451":114440,"_5":13353,"_26530":114378,"_2682":114441},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3185":66962,"_28073":66932,"_19451":114443,"_5":13353,"_26530":114382,"_2682":114444},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3185":66963,"_28073":66932,"_19451":114446,"_5":13353,"_26530":114382,"_2682":114447},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3185":66964,"_28073":66932,"_19451":114449,"_5":13353,"_26530":114382,"_2682":114450},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3185":66965,"_28073":66932,"_19451":114452,"_5":13353,"_26530":114386,"_2682":114453},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3185":66966,"_28073":66932,"_19451":114455,"_5":13353,"_26530":114386,"_2682":114456},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3185":66967,"_28073":66932,"_19451":114458,"_5":13353,"_26530":114386,"_2682":114459},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3185":66968,"_28073":66932,"_19451":114461,"_5":13353,"_26530":114390,"_2682":112071},[],{"_3185":66969,"_28073":66932,"_19451":114463,"_5":13353,"_26530":114390,"_2682":110823},[],{"_3185":66970,"_28073":66932,"_19451":114465,"_5":13353,"_26530":114390,"_2682":114466},[],"La CA rechaza la emisión",{"_3185":66971,"_28073":66932,"_19451":114468,"_5":13353,"_26530":114390,"_2682":114469},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3185":66972,"_28073":66932,"_19451":114471,"_5":13353,"_26530":114390,"_2682":114472},[],"Sujeto o usos diferentes",{"_3185":66973,"_28073":66932,"_19451":114474,"_5":13353,"_26530":114390,"_2682":114475},[],"Perfil aplicado y valores solicitados.",{"_3185":66974,"_28073":66932,"_19451":114477,"_5":13353,"_26530":114390,"_2682":114478},[],"No se encuentra el emisor",{"_3185":66975,"_28073":66932,"_19451":114480,"_5":13353,"_26530":114390,"_2682":114481},[],"CA descargada y cadena intermedia necesaria.",{"_3185":66976,"_28073":66932,"_19451":114483,"_5":13353,"_26530":114390,"_2682":114484},[],"Falla la vigencia",{"_3185":66977,"_28073":66932,"_19451":114486,"_5":13353,"_26530":114390,"_2682":114487},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3185":66978,"_28073":66932,"_19451":114489,"_5":13353,"_26530":114390,"_2682":114490},[],"Los resúmenes de clave difieren",{"_3185":66979,"_28073":66932,"_19451":114492,"_5":13353,"_26530":114390,"_2682":114493},[],"Archivos de certificado y clave de la misma emisión.",{"_3185":66980,"_28073":66932,"_19451":114495,"_5":13353,"_26530":114390,"_2682":114496},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3185":66981,"_28073":66932,"_19451":114498,"_5":13353,"_26530":114393,"_2682":114499},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3185":66982,"_28073":66932,"_19451":114501,"_5":13353,"_26530":114393,"_2682":114502},[],"Gestionar certificados para inspección, estado y revocación.",{"_3185":66983,"_28073":66932,"_19451":114504,"_5":13353,"_26530":114393,"_2682":114505},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3185":66984,"_28073":66932,"_19451":114507,"_5":13353,"_26530":114393,"_2682":114508},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3185":66985,"_28073":66932,"_19451":114510,"_5":13353,"_26530":114393,"_2682":114511},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3185":66986,"_28073":66986,"_5":13700,"_2682":114513,"_28416":114514,"_19451":114515,"_26530":66986},"Primeros pasos de PKI",[45599,108686,50746,111740],[],{"_3185":66987,"_28073":66986,"_19451":114517,"_5":13353,"_26530":66986,"_2682":114518},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3185":66988,"_28073":66986,"_5":28413,"_19451":114520,"_26530":114521,"_2682":107296},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3185":66989,"_28073":66986,"_5":28413,"_19451":114523,"_26530":114524,"_2682":114525},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3185":66990,"_28073":66986,"_5":28413,"_19451":114527,"_26530":114528,"_2682":111922},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3185":66991,"_28073":66986,"_5":28413,"_19451":114530,"_26530":114531,"_2682":114532},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3185":66992,"_28073":66986,"_19451":114534,"_5":13353,"_26530":66986,"_2682":114535},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3185":66993,"_28073":66986,"_19451":114537,"_5":13353,"_26530":114521,"_2682":114538},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3185":66994,"_28073":66986,"_19451":114540,"_5":13353,"_26530":114521,"_2682":114541},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3185":66995,"_28073":66986,"_19451":114543,"_5":13353,"_26530":114521,"_2682":114544},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3185":66996,"_28073":66986,"_19451":114546,"_5":13353,"_26530":114521,"_2682":114547},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3185":66997,"_28073":66986,"_19451":114549,"_5":13353,"_26530":114521,"_2682":114550},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3185":66998,"_28073":66986,"_19451":114552,"_5":13353,"_26530":114524,"_2682":114553},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3185":66999,"_28073":66986,"_19451":114555,"_5":13353,"_26530":114524,"_2682":114556},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3185":67000,"_28073":66986,"_19451":114558,"_5":13353,"_26530":114524,"_2682":114559},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3185":67001,"_28073":66986,"_19451":114561,"_5":13353,"_26530":114524,"_2682":114562},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3185":67002,"_28073":66986,"_19451":114564,"_5":13353,"_26530":114528,"_2682":114565},[],"Archivo o recurso",{"_3185":67003,"_28073":66986,"_19451":114567,"_5":13353,"_26530":114528,"_2682":111919},[],{"_3185":67004,"_28073":66986,"_19451":114569,"_5":13353,"_26530":114528,"_2682":114570},[],"CA raíz activa y `ca.pem`",{"_3185":67005,"_28073":66986,"_19451":114572,"_5":13353,"_26530":114528,"_2682":114573},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3185":67006,"_28073":66986,"_19451":114575,"_5":13353,"_26530":114528,"_2682":114576},[],"Certificado final y `device.crt`",{"_3185":67007,"_28073":66986,"_19451":114578,"_5":13353,"_26530":114528,"_2682":114579},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3185":67008,"_28073":66986,"_19451":114581,"_5":13353,"_26530":114528,"_2682":114582},[],"Clave privada `device.key`",{"_3185":67009,"_28073":66986,"_19451":114584,"_5":13353,"_26530":114528,"_2682":114585},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3185":67010,"_28073":66986,"_19451":114587,"_5":13353,"_26530":114528,"_2682":114588},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3185":67011,"_28073":66986,"_19451":114590,"_5":13353,"_26530":114531,"_2682":114591},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3185":67012,"_28073":66986,"_19451":114593,"_5":13353,"_26530":114531,"_2682":114594},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3185":67013,"_28073":66986,"_19451":114596,"_5":13353,"_26530":114531,"_2682":114597},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3185":67014,"_28073":67014,"_5":13700,"_2682":114599,"_28416":114600,"_19451":114602,"_26530":67014},"Resolución de problemas PKI",[45599,108686,50746,114601],"Resolución de problemas",[],{"_3185":67015,"_28073":67014,"_19451":114604,"_5":13353,"_26530":67014,"_2682":114605},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3185":67016,"_28073":67014,"_5":28413,"_19451":114607,"_26530":114608,"_2682":114609},[],"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3185":67017,"_28073":67014,"_5":28413,"_19451":114611,"_26530":114612,"_2682":114613},[],"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3185":67018,"_28073":67014,"_5":28413,"_19451":114615,"_26530":114616,"_2682":114617},[],"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3185":67019,"_28073":67014,"_19451":114619,"_5":13353,"_26530":67014,"_2682":114620},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3185":67020,"_28073":67014,"_19451":114622,"_5":13353,"_26530":67014,"_2682":114623},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3185":67021,"_28073":67014,"_19451":114625,"_5":13353,"_26530":114608,"_2682":111919},[],{"_3185":67022,"_28073":67014,"_19451":114627,"_5":13353,"_26530":114608,"_2682":110823},[],{"_3185":67023,"_28073":67014,"_19451":114629,"_5":13353,"_26530":114608,"_2682":107320},[],{"_3185":67024,"_28073":67014,"_19451":114631,"_5":13353,"_26530":114608,"_2682":53116},[],{"_3185":67025,"_28073":67014,"_19451":114633,"_5":13353,"_26530":114608,"_2682":114634},[],"Existe, está activa y sus fechas son utilizables.",{"_3185":67026,"_28073":67014,"_19451":114636,"_5":13353,"_26530":114608,"_2682":114637},[],"Autoridades.",{"_3185":67027,"_28073":67014,"_19451":114639,"_5":13353,"_26530":114608,"_2682":114640},[],"Clave",{"_3185":67028,"_28073":67014,"_19451":114642,"_5":13353,"_26530":114608,"_2682":114643},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3185":67029,"_28073":67014,"_19451":114645,"_5":13353,"_26530":114608,"_2682":114646},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3185":67030,"_28073":67014,"_19451":114648,"_5":13353,"_26530":114608,"_2682":53134},[],{"_3185":67031,"_28073":67014,"_19451":114650,"_5":13353,"_26530":114608,"_2682":114651},[],"PEM correcto y firma verificable.",{"_3185":67032,"_28073":67014,"_19451":114653,"_5":13353,"_26530":114608,"_2682":53140},[],{"_3185":67033,"_28073":67014,"_19451":114655,"_5":13353,"_26530":114608,"_2682":114656},[],"Perfil",{"_3185":67034,"_28073":67014,"_19451":114658,"_5":13353,"_26530":114608,"_2682":114659},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3185":67035,"_28073":67014,"_19451":114661,"_5":13353,"_26530":114608,"_2682":114662},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3185":67036,"_28073":67014,"_19451":114664,"_5":13353,"_26530":114608,"_2682":112071},[],{"_3185":67037,"_28073":67014,"_19451":114666,"_5":13353,"_26530":114608,"_2682":114667},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3185":67038,"_28073":67014,"_19451":114669,"_5":13353,"_26530":114608,"_2682":114670},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3185":67039,"_28073":67014,"_19451":114672,"_5":13353,"_26530":114608,"_2682":114673},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3185":67040,"_28073":67014,"_19451":114675,"_5":13353,"_26530":114608,"_2682":114676},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3185":67041,"_28073":67014,"_19451":114678,"_5":13353,"_26530":114612,"_2682":114679},[],"Revisa cada frontera por separado:",{"_3185":67042,"_28073":67014,"_19451":114681,"_5":13353,"_26530":114612,"_2682":114682},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3185":67043,"_28073":67014,"_19451":114684,"_5":13353,"_26530":114612,"_2682":114685},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3185":67044,"_28073":67014,"_19451":114687,"_5":13353,"_26530":114612,"_2682":114688},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3185":67045,"_28073":67014,"_19451":114690,"_5":13353,"_26530":114612,"_2682":114691},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3185":67046,"_28073":67014,"_19451":114693,"_5":13353,"_26530":114612,"_2682":114694},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3185":67047,"_28073":67014,"_19451":114696,"_5":13353,"_26530":114612,"_2682":114697},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3185":67048,"_28073":67014,"_19451":114699,"_5":13353,"_26530":114616,"_2682":114700},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3185":67049,"_28073":67014,"_19451":114702,"_5":13353,"_26530":114616,"_2682":114703},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3185":67050,"_28073":67050,"_5":13700,"_2682":114705,"_28416":114706,"_19451":114708,"_26530":67050},"3.8.0 a 4.0.0",[45599,114707],"Actualizaciones",[],{"_3185":67051,"_28073":67050,"_19451":114710,"_5":13353,"_26530":67050,"_2682":114711},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3185":67052,"_28073":67050,"_5":28413,"_19451":114713,"_26530":114714,"_2682":114715},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3185":67053,"_28073":67050,"_5":28413,"_19451":114717,"_26530":114718,"_2682":114719},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3185":67054,"_28073":67050,"_5":28413,"_19451":114721,"_26530":114722,"_2682":114723},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3185":67055,"_28073":67050,"_5":28413,"_19451":114725,"_26530":114726,"_2682":114727},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3185":67056,"_28073":67050,"_5":28413,"_19451":114729,"_26530":114730,"_2682":114731},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3185":67057,"_28073":67050,"_5":28413,"_19451":114733,"_26530":114734,"_2682":114735},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3185":67058,"_28073":67050,"_5":28413,"_19451":114737,"_26530":114738,"_2682":53226},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3185":67059,"_28073":67050,"_5":28413,"_19451":114740,"_26530":114741,"_2682":114742},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3185":67060,"_28073":67050,"_5":28413,"_19451":114744,"_26530":114745,"_2682":114746},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3185":67061,"_28073":67050,"_5":28413,"_19451":114748,"_26530":114749,"_2682":114750},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3185":67062,"_28073":67050,"_5":28413,"_19451":114752,"_26530":114753,"_2682":114754},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3185":67063,"_28073":67050,"_5":28413,"_19451":114756,"_26530":114757,"_2682":114758},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3185":67064,"_28073":67050,"_5":28413,"_19451":114760,"_26530":114761,"_2682":114762},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3185":67065,"_28073":67050,"_5":28413,"_19451":114764,"_26530":114765,"_2682":114766},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3185":67066,"_28073":67050,"_5":28413,"_19451":114768,"_26530":114769,"_2682":114770},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3185":67067,"_28073":67050,"_5":28413,"_19451":114772,"_26530":114773,"_2682":114774},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3185":67068,"_28073":67050,"_5":28413,"_19451":114776,"_26530":114777,"_2682":114778},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3185":67069,"_28073":67050,"_5":28413,"_19451":114780,"_26530":114781,"_2682":114782},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3185":67070,"_28073":67050,"_5":28413,"_19451":114784,"_26530":114785,"_2682":114786},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3185":67071,"_28073":67050,"_5":28413,"_19451":114788,"_26530":114789,"_2682":114790},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3185":67072,"_28073":67050,"_5":28413,"_19451":114792,"_26530":114793,"_2682":114794},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3185":67073,"_28073":67050,"_5":28413,"_19451":114796,"_26530":114797,"_2682":114798},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3185":67074,"_28073":67050,"_5":28413,"_19451":114800,"_26530":114801,"_2682":114802},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3185":67075,"_28073":67050,"_5":28413,"_19451":114804,"_26530":114805,"_2682":114806},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3185":67076,"_28073":67050,"_5":28413,"_19451":114808,"_26530":114809,"_2682":114810},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3185":67077,"_28073":67050,"_5":28413,"_19451":114812,"_26530":114813,"_2682":114814},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3185":67078,"_28073":67050,"_5":28413,"_19451":114816,"_26530":114817,"_2682":114818},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3185":67079,"_28073":67050,"_5":28413,"_19451":114820,"_26530":114821,"_2682":114822},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3185":67080,"_28073":67050,"_5":28413,"_19451":114824,"_26530":114825,"_2682":114826},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3185":67081,"_28073":67050,"_5":28413,"_19451":114828,"_26530":114829,"_2682":114830},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3185":67082,"_28073":67050,"_5":28413,"_19451":114832,"_26530":114833,"_2682":114834},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3185":67083,"_28073":67050,"_5":28413,"_19451":114836,"_26530":114837,"_2682":114838},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3185":67084,"_28073":67050,"_5":28413,"_19451":114840,"_26530":114841,"_2682":114842},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3185":67085,"_28073":67050,"_5":28413,"_19451":114844,"_26530":114845,"_2682":111145},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3185":67086,"_28073":67050,"_5":28413,"_19451":114847,"_26530":114848,"_2682":114849},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3185":67087,"_28073":67050,"_5":28413,"_19451":114851,"_26530":114852,"_2682":114853},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3185":67088,"_28073":67050,"_19451":114855,"_5":13353,"_26530":67050,"_2682":114856},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3185":67089,"_28073":67050,"_19451":114858,"_5":13353,"_26530":67050,"_2682":114859},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3185":67090,"_28073":67050,"_19451":114861,"_5":13353,"_26530":67050,"_2682":114862},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3185":67091,"_28073":67050,"_19451":114864,"_5":13353,"_26530":67050,"_2682":114865},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3185":67092,"_28073":67050,"_19451":114867,"_5":13353,"_26530":67050,"_2682":114868},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3185":67093,"_28073":67050,"_19451":114870,"_5":13353,"_26530":67050,"_2682":114871},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3185":67094,"_28073":67050,"_19451":114873,"_5":13353,"_26530":67050,"_2682":114874},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3185":67095,"_28073":67050,"_19451":114876,"_5":13353,"_26530":114718,"_2682":114877},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3185":67096,"_28073":67050,"_19451":114879,"_5":13353,"_26530":114718,"_2682":114880},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3185":67097,"_28073":67050,"_19451":114882,"_5":13353,"_26530":114722,"_2682":114883},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3185":67098,"_28073":67050,"_19451":114885,"_5":13353,"_26530":114722,"_2682":114886},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3185":67099,"_28073":67050,"_19451":114888,"_5":13353,"_26530":114726,"_2682":114889},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3185":67100,"_28073":67050,"_19451":114891,"_5":13353,"_26530":114730,"_2682":114892},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3185":67101,"_28073":67050,"_19451":114894,"_5":13353,"_26530":114730,"_2682":114895},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3185":67102,"_28073":67050,"_19451":114897,"_5":13353,"_26530":114730,"_2682":114898},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3185":67103,"_28073":67050,"_19451":114900,"_5":13353,"_26530":114730,"_2682":114901},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3185":67104,"_28073":67050,"_19451":114903,"_5":13353,"_26530":114730,"_2682":114904},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3185":67105,"_28073":67050,"_19451":114906,"_5":13353,"_26530":114734,"_2682":114907},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3185":67106,"_28073":67050,"_19451":114909,"_5":13353,"_26530":114734,"_2682":114910},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3185":67107,"_28073":67050,"_19451":114912,"_5":13353,"_26530":114734,"_2682":114913},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3185":67108,"_28073":67050,"_19451":114915,"_5":13353,"_26530":114734,"_2682":114916},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3185":67109,"_28073":67050,"_19451":114918,"_5":13353,"_26530":114734,"_2682":114919},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3185":67110,"_28073":67050,"_19451":114921,"_5":13353,"_26530":114738,"_2682":114922},[],"Cambio",{"_3185":67111,"_28073":67050,"_19451":114924,"_5":13353,"_26530":114738,"_2682":114925},[],"A quién afecta",{"_3185":67112,"_28073":67050,"_19451":114927,"_5":13353,"_26530":114738,"_2682":114928},[],"Gravedad",{"_3185":67113,"_28073":67050,"_19451":114930,"_5":13353,"_26530":114738,"_2682":114931},[],"Acción",{"_3185":67114,"_28073":67050,"_19451":114933,"_5":13353,"_26530":114738,"_2682":114746},[],{"_3185":67115,"_28073":67050,"_19451":114935,"_5":13353,"_26530":114738,"_2682":114936},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3185":67116,"_28073":67050,"_19451":114938,"_5":13353,"_26530":114738,"_2682":114939},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3185":67117,"_28073":67050,"_19451":114941,"_5":13353,"_26530":114738,"_2682":114942},[],"Copiar los datos a los volúmenes nuevos",{"_3185":67118,"_28073":67050,"_19451":114944,"_5":13353,"_26530":114738,"_2682":114750},[],{"_3185":67119,"_28073":67050,"_19451":114946,"_5":13353,"_26530":114738,"_2682":114947},[],"Todas las releases de Helm",{"_3185":67120,"_28073":67050,"_19451":114949,"_5":13353,"_26530":114738,"_2682":114950},[],"Alta: `helm upgrade` falla",{"_3185":67121,"_28073":67050,"_19451":114952,"_5":13353,"_26530":114738,"_2682":114953},[],"Eliminar o renombrar las claves heredadas",{"_3185":67122,"_28073":67050,"_19451":114955,"_5":13353,"_26530":114738,"_2682":114754},[],{"_3185":67123,"_28073":67050,"_19451":114957,"_5":13353,"_26530":114738,"_2682":114958},[],"Todos los despliegues",{"_3185":67124,"_28073":67050,"_19451":114960,"_5":13353,"_26530":114738,"_2682":114961},[],"Alta: sin principal de bootstrap no hay administrador",{"_3185":67125,"_28073":67050,"_19451":114963,"_5":13353,"_26530":114738,"_2682":114964},[],"Configurar `services.authz`",{"_3185":67126,"_28073":67050,"_19451":114966,"_5":13353,"_26530":114738,"_2682":114758},[],{"_3185":67127,"_28073":67050,"_19451":114968,"_5":13353,"_26530":114738,"_2682":114947},[],{"_3185":67128,"_28073":67050,"_19451":114970,"_5":13353,"_26530":114738,"_2682":114971},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3185":67129,"_28073":67050,"_19451":114973,"_5":13353,"_26530":114738,"_2682":114974},[],"Mover JWKS y roles a `services.authz`",{"_3185":67130,"_28073":67050,"_19451":114976,"_5":13353,"_26530":114738,"_2682":114778},[],{"_3185":67131,"_28073":67050,"_19451":114978,"_5":13353,"_26530":114738,"_2682":114979},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3185":67132,"_28073":67050,"_19451":114981,"_5":13353,"_26530":114738,"_2682":114982},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3185":67133,"_28073":67050,"_19451":114984,"_5":13353,"_26530":114738,"_2682":114985},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3185":67134,"_28073":67050,"_19451":114987,"_5":13353,"_26530":114738,"_2682":114782},[],{"_3185":67135,"_28073":67050,"_19451":114989,"_5":13353,"_26530":114738,"_2682":114990},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3185":67136,"_28073":67050,"_19451":114992,"_5":13353,"_26530":114738,"_2682":114993},[],"Alta: el backend ya no arranca con ellos",{"_3185":67137,"_28073":67050,"_19451":114995,"_5":13353,"_26530":114738,"_2682":114996},[],"Pasar a PostgreSQL antes de actualizar",{"_3185":67138,"_28073":67050,"_19451":114998,"_5":13353,"_26530":114738,"_2682":114999},[],"Webhooks con referencias a archivos",{"_3185":67139,"_28073":67050,"_19451":115001,"_5":13353,"_26530":114738,"_2682":115002},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3185":67140,"_28073":67050,"_19451":115004,"_5":13353,"_26530":114738,"_2682":115005},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3185":67141,"_28073":67050,"_19451":115007,"_5":13353,"_26530":114738,"_2682":115008},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3185":67142,"_28073":67050,"_19451":115010,"_5":13353,"_26530":114738,"_2682":114762},[],{"_3185":67143,"_28073":67050,"_19451":115012,"_5":13353,"_26530":114738,"_2682":115013},[],"Releases con identidades por servicio o material de claves montado",{"_3185":67144,"_28073":67050,"_19451":115015,"_5":13353,"_26530":114738,"_2682":115016},[],"Media: los servicios no pueden leer sus archivos",{"_3185":67145,"_28073":67050,"_19451":115018,"_5":13353,"_26530":114738,"_2682":115019},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3185":67146,"_28073":67050,"_19451":115021,"_5":13353,"_26530":114738,"_2682":114766},[],{"_3185":67147,"_28073":67050,"_19451":115023,"_5":13353,"_26530":114738,"_2682":115024},[],"Releases que definen `amqp.tls`",{"_3185":67148,"_28073":67050,"_19451":115026,"_5":13353,"_26530":114738,"_2682":115027},[],"Media: los clientes se conectan al puerto equivocado",{"_3185":67149,"_28073":67050,"_19451":115029,"_5":13353,"_26530":114738,"_2682":115030},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3185":67150,"_28073":67050,"_19451":115032,"_5":13353,"_26530":114738,"_2682":114786},[],{"_3185":67151,"_28073":67050,"_19451":115034,"_5":13353,"_26530":114738,"_2682":115035},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3185":67152,"_28073":67050,"_19451":115037,"_5":13353,"_26530":114738,"_2682":115038},[],"Media: las claves de CA quedan sin gestionar",{"_3185":67153,"_28073":67050,"_19451":115040,"_5":13353,"_26530":114738,"_2682":115041},[],"Ejecutar la migración de CA a KMS",{"_3185":67154,"_28073":67050,"_19451":115043,"_5":13353,"_26530":114738,"_2682":115044},[],"Verificación del certificado del receptor",{"_3185":67155,"_28073":67050,"_19451":115046,"_5":13353,"_26530":114738,"_2682":115047},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3185":67156,"_28073":67050,"_19451":115049,"_5":13353,"_26530":114738,"_2682":115050},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3185":67157,"_28073":67050,"_19451":115052,"_5":13353,"_26530":114738,"_2682":115053},[],"Poner `insecure_skip_verify` a `false`",{"_3185":67158,"_28073":67050,"_19451":115055,"_5":13353,"_26530":114738,"_2682":114798},[],{"_3185":67159,"_28073":67050,"_19451":115057,"_5":13353,"_26530":114738,"_2682":115058},[],"Scripts y consolas que editan DMS por API",{"_3185":67160,"_28073":67050,"_19451":115060,"_5":13353,"_26530":114738,"_2682":115061},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3185":67161,"_28073":67050,"_19451":115063,"_5":13353,"_26530":114738,"_2682":115064},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3185":67162,"_28073":67050,"_19451":115066,"_5":13353,"_26530":114738,"_2682":114814},[],{"_3185":67163,"_28073":67050,"_19451":115068,"_5":13353,"_26530":114738,"_2682":115069},[],"Consumidores que leen el campo `events` del dispositivo",{"_3185":67164,"_28073":67050,"_19451":115071,"_5":13353,"_26530":114738,"_2682":115072},[],"Media: el campo desaparece",{"_3185":67165,"_28073":67050,"_19451":115074,"_5":13353,"_26530":114738,"_2682":115075},[],"Usar los nuevos endpoints de eventos",{"_3185":67166,"_28073":67050,"_19451":115077,"_5":13353,"_26530":114738,"_2682":114770},[],{"_3185":67167,"_28073":67050,"_19451":115079,"_5":13353,"_26530":114738,"_2682":115080},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3185":67168,"_28073":67050,"_19451":115082,"_5":13353,"_26530":114738,"_2682":115083},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3185":67169,"_28073":67050,"_19451":115085,"_5":13353,"_26530":114738,"_2682":115086},[],"Actualizar el archivo de values",{"_3185":67170,"_28073":67050,"_19451":115088,"_5":13353,"_26530":114738,"_2682":114806},[],{"_3185":67171,"_28073":67050,"_19451":115090,"_5":13353,"_26530":114738,"_2682":115091},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3185":67172,"_28073":67050,"_19451":115093,"_5":13353,"_26530":114738,"_2682":115094},[],"Baja: prevalece el ID de la URL",{"_3185":67173,"_28073":67050,"_19451":115096,"_5":13353,"_26530":114738,"_2682":115097},[],"Enviar el ID en la URL",{"_3185":67174,"_28073":67050,"_19451":115099,"_5":13353,"_26530":114738,"_2682":114810},[],{"_3185":67175,"_28073":67050,"_19451":115101,"_5":13353,"_26530":114738,"_2682":115102},[],"Consumidores que comparan el `type` del certificado",{"_3185":67176,"_28073":67050,"_19451":115104,"_5":13353,"_26530":114738,"_2682":115105},[],"Baja: dos valores cambian de nombre",{"_3185":67177,"_28073":67050,"_19451":115107,"_5":13353,"_26530":114738,"_2682":115108},[],"Adaptar los consumidores",{"_3185":67178,"_28073":67050,"_19451":115110,"_5":13353,"_26530":114738,"_2682":114802},[],{"_3185":67179,"_28073":67050,"_19451":115112,"_5":13353,"_26530":114738,"_2682":115113},[],"Cualquier DMS",{"_3185":67180,"_28073":67050,"_19451":115115,"_5":13353,"_26530":114738,"_2682":115116},[],"Baja: solo informativo",{"_3185":67181,"_28073":67050,"_19451":115118,"_5":13353,"_26530":114738,"_2682":115119},[],"Revisar ambos bloques antes de editar",{"_3185":67182,"_28073":67050,"_19451":115121,"_5":13353,"_26530":114745,"_2682":115122},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3185":67183,"_28073":67050,"_19451":115124,"_5":13353,"_26530":114745,"_2682":115125},[],"El paso 4 de la guía de migración copia los datos.",{"_3185":67184,"_28073":67050,"_19451":115127,"_5":13353,"_26530":114749,"_2682":115128},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3185":67185,"_28073":67050,"_19451":115130,"_5":13353,"_26530":114753,"_2682":115131},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3185":67186,"_28073":67050,"_19451":115133,"_5":13353,"_26530":114757,"_2682":115134},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3185":67187,"_28073":67050,"_19451":115136,"_5":13353,"_26530":114761,"_2682":115137},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3185":67188,"_28073":67050,"_19451":115139,"_5":13353,"_26530":114761,"_2682":115140},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3185":67189,"_28073":67050,"_19451":115142,"_5":13353,"_26530":114765,"_2682":115143},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3185":67190,"_28073":67050,"_19451":115145,"_5":13353,"_26530":114769,"_2682":115146},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3185":67191,"_28073":67050,"_19451":115148,"_5":13353,"_26530":114769,"_2682":115149},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3185":67192,"_28073":67050,"_19451":115151,"_5":13353,"_26530":114769,"_2682":115152},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3185":67193,"_28073":67050,"_19451":115154,"_5":13353,"_26530":114769,"_2682":115155},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3185":67194,"_28073":67050,"_19451":115157,"_5":13353,"_26530":114769,"_2682":115158},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3185":67195,"_28073":67050,"_19451":115160,"_5":13353,"_26530":114769,"_2682":115161},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3185":67196,"_28073":67050,"_19451":115163,"_5":13353,"_26530":114777,"_2682":115164},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3185":67197,"_28073":67050,"_19451":115166,"_5":13353,"_26530":114777,"_2682":115167},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3185":67198,"_28073":67050,"_19451":115169,"_5":13353,"_26530":114777,"_2682":115170},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3185":67199,"_28073":67050,"_19451":115172,"_5":13353,"_26530":114777,"_2682":115173},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3185":67200,"_28073":67050,"_19451":115175,"_5":13353,"_26530":114777,"_2682":115176},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3185":67201,"_28073":67050,"_19451":115178,"_5":13353,"_26530":114781,"_2682":115179},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3185":67202,"_28073":67050,"_19451":115181,"_5":13353,"_26530":114785,"_2682":115182},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3185":67203,"_28073":67050,"_19451":115184,"_5":13353,"_26530":114785,"_2682":115185},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3185":67204,"_28073":67050,"_19451":115187,"_5":13353,"_26530":114785,"_2682":115188},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3185":67205,"_28073":67050,"_19451":115190,"_5":13353,"_26530":114785,"_2682":115191},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3185":67206,"_28073":67050,"_19451":115193,"_5":13353,"_26530":114785,"_2682":115194},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3185":67207,"_28073":67050,"_19451":115196,"_5":13353,"_26530":114785,"_2682":115197},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3185":67208,"_28073":67050,"_19451":115199,"_5":13353,"_26530":114793,"_2682":115200},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3185":67209,"_28073":67050,"_19451":115202,"_5":13353,"_26530":114793,"_2682":115203},[],"Campo en 3.8.0",{"_3185":67210,"_28073":67050,"_19451":115205,"_5":13353,"_26530":114793,"_2682":115206},[],"Campo en 4.0.0",{"_3185":67211,"_28073":67050,"_19451":115208,"_5":13353,"_26530":114793,"_2682":53697},[],{"_3185":67212,"_28073":67050,"_19451":115210,"_5":13353,"_26530":114793,"_2682":115211},[],"`insecure_skip_verify` (con el valor negado)",{"_3185":67213,"_28073":67050,"_19451":115213,"_5":13353,"_26530":114793,"_2682":53703},[],{"_3185":67214,"_28073":67050,"_19451":115215,"_5":13353,"_26530":114793,"_2682":53706},[],{"_3185":67215,"_28073":67050,"_19451":115217,"_5":13353,"_26530":114793,"_2682":53709},[],{"_3185":67216,"_28073":67050,"_19451":115219,"_5":13353,"_26530":114793,"_2682":53712},[],{"_3185":67217,"_28073":67050,"_19451":115221,"_5":13353,"_26530":114793,"_2682":53715},[],{"_3185":67218,"_28073":67050,"_19451":115223,"_5":13353,"_26530":114793,"_2682":53718},[],{"_3185":67219,"_28073":67050,"_19451":115225,"_5":13353,"_26530":114793,"_2682":115226},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3185":67220,"_28073":67050,"_19451":115228,"_5":13353,"_26530":114793,"_2682":115229},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3185":67221,"_28073":67050,"_19451":115231,"_5":13353,"_26530":114793,"_2682":115232},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3185":67222,"_28073":67050,"_19451":115234,"_5":13353,"_26530":114797,"_2682":115235},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3185":67223,"_28073":67050,"_19451":115237,"_5":13353,"_26530":114797,"_2682":115238},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3185":67224,"_28073":67050,"_19451":115240,"_5":13353,"_26530":114797,"_2682":115241},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3185":67225,"_28073":67050,"_19451":115243,"_5":13353,"_26530":114801,"_2682":115244},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. Si la versión de la consola no expone los ajustes independientes, edítalos mediante la API DMS.",{"_3185":67226,"_28073":67050,"_19451":115246,"_5":13353,"_26530":114805,"_2682":115247},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3185":67227,"_28073":67050,"_19451":115249,"_5":13353,"_26530":114809,"_2682":115250},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3185":67228,"_28073":67050,"_19451":115252,"_5":13353,"_26530":114813,"_2682":115253},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3185":67229,"_28073":67050,"_19451":115255,"_5":13353,"_26530":114813,"_2682":115256},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3185":67230,"_28073":67050,"_19451":115258,"_5":13353,"_26530":114813,"_2682":115259},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3185":67231,"_28073":67050,"_19451":115261,"_5":13353,"_26530":114813,"_2682":115262},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3185":67232,"_28073":67050,"_19451":115264,"_5":13353,"_26530":114817,"_2682":115265},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3185":67233,"_28073":67050,"_19451":115267,"_5":13353,"_26530":114821,"_2682":115268},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3185":67234,"_28073":67050,"_19451":115270,"_5":13353,"_26530":114821,"_2682":115271},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3185":67235,"_28073":67050,"_19451":115273,"_5":13353,"_26530":114821,"_2682":115274},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3185":67236,"_28073":67050,"_19451":115276,"_5":13353,"_26530":114821,"_2682":115277},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3185":67237,"_28073":67050,"_19451":115279,"_5":13353,"_26530":114821,"_2682":115280},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3185":67238,"_28073":67050,"_19451":115282,"_5":13353,"_26530":114825,"_2682":115283},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3185":67239,"_28073":67050,"_19451":115285,"_5":13353,"_26530":114825,"_2682":115286},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3185":67240,"_28073":67050,"_19451":115288,"_5":13353,"_26530":114825,"_2682":115289},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3185":67241,"_28073":67050,"_19451":115291,"_5":13353,"_26530":114825,"_2682":115292},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3185":67242,"_28073":67050,"_19451":115294,"_5":13353,"_26530":114825,"_2682":115295},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3185":67243,"_28073":67050,"_19451":115297,"_5":13353,"_26530":114825,"_2682":115298},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3185":67244,"_28073":67050,"_19451":115300,"_5":13353,"_26530":114825,"_2682":115301},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3185":67245,"_28073":67050,"_19451":115303,"_5":13353,"_26530":114825,"_2682":115304},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3185":67246,"_28073":67050,"_19451":115306,"_5":13353,"_26530":114825,"_2682":115307},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3185":67247,"_28073":67050,"_19451":115309,"_5":13353,"_26530":114825,"_2682":115310},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3185":67248,"_28073":67050,"_19451":115312,"_5":13353,"_26530":114825,"_2682":115313},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3185":67249,"_28073":67050,"_19451":115315,"_5":13353,"_26530":114825,"_2682":115316},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3185":67250,"_28073":67050,"_19451":115318,"_5":13353,"_26530":114829,"_2682":115319},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3185":67251,"_28073":67050,"_19451":115321,"_5":13353,"_26530":114829,"_2682":115322},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3185":67252,"_28073":67050,"_19451":115324,"_5":13353,"_26530":114833,"_2682":115325},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3185":67253,"_28073":67050,"_19451":115327,"_5":13353,"_26530":114833,"_2682":115328},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3185":67254,"_28073":67050,"_19451":115330,"_5":13353,"_26530":114833,"_2682":115331},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3185":67255,"_28073":67050,"_19451":115333,"_5":13353,"_26530":114833,"_2682":115334},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3185":67256,"_28073":67050,"_19451":115336,"_5":13353,"_26530":114833,"_2682":115337},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3185":67257,"_28073":67050,"_19451":115339,"_5":13353,"_26530":114833,"_2682":115340},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3185":67258,"_28073":67050,"_19451":115342,"_5":13353,"_26530":114833,"_2682":115343},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3185":67259,"_28073":67050,"_19451":115345,"_5":13353,"_26530":114833,"_2682":115346},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3185":67260,"_28073":67050,"_19451":115348,"_5":13353,"_26530":114833,"_2682":115349},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3185":67261,"_28073":67050,"_19451":115351,"_5":13353,"_26530":114833,"_2682":115352},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3185":67262,"_28073":67050,"_19451":115354,"_5":13353,"_26530":114833,"_2682":115355},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3185":67263,"_28073":67050,"_19451":115357,"_5":13353,"_26530":114837,"_2682":115358},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3185":67264,"_28073":67050,"_19451":115360,"_5":13353,"_26530":114837,"_2682":115361},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3185":67265,"_28073":67050,"_19451":115363,"_5":13353,"_26530":114841,"_2682":115364},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3185":67266,"_28073":67050,"_19451":115366,"_5":13353,"_26530":114841,"_2682":115367},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3185":67267,"_28073":67050,"_19451":115369,"_5":13353,"_26530":114841,"_2682":115370},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3185":67268,"_28073":67050,"_19451":115372,"_5":13353,"_26530":114841,"_2682":115373},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3185":67269,"_28073":67050,"_19451":115375,"_5":13353,"_26530":114841,"_2682":115376},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3185":67270,"_28073":67050,"_19451":115378,"_5":13353,"_26530":114845,"_2682":115379},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3185":67271,"_28073":67050,"_19451":115381,"_5":13353,"_26530":114845,"_2682":115382},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3185":67272,"_28073":67050,"_19451":115384,"_5":13353,"_26530":114845,"_2682":115385},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3185":67273,"_28073":67050,"_19451":115387,"_5":13353,"_26530":114845,"_2682":115388},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3185":67274,"_28073":67050,"_19451":115390,"_5":13353,"_26530":114845,"_2682":115391},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3185":67275,"_28073":67050,"_19451":115393,"_5":13353,"_26530":114845,"_2682":115394},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3185":67276,"_28073":67050,"_19451":115396,"_5":13353,"_26530":114845,"_2682":115397},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3185":67277,"_28073":67050,"_19451":115399,"_5":13353,"_26530":114848,"_2682":115400},[],"Tras la actualización, comprueba en este orden:",{"_3185":67278,"_28073":67050,"_19451":115402,"_5":13353,"_26530":114848,"_2682":115403},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3185":67279,"_28073":67050,"_19451":115405,"_5":13353,"_26530":114848,"_2682":115406},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3185":67280,"_28073":67050,"_19451":115408,"_5":13353,"_26530":114848,"_2682":115409},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3185":67281,"_28073":67050,"_19451":115411,"_5":13353,"_26530":114848,"_2682":115412},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3185":67282,"_28073":67050,"_19451":115414,"_5":13353,"_26530":114848,"_2682":115415},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3185":67283,"_28073":67050,"_19451":115417,"_5":13353,"_26530":114848,"_2682":115418},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3185":67284,"_28073":67050,"_19451":115420,"_5":13353,"_26530":114848,"_2682":115421},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3185":67285,"_28073":67050,"_19451":115423,"_5":13353,"_26530":114848,"_2682":115424},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3185":67286,"_28073":67050,"_19451":115426,"_5":13353,"_26530":114848,"_2682":115427},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3185":67287,"_28073":67050,"_19451":115429,"_5":13353,"_26530":114848,"_2682":115430},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3185":67288,"_28073":67050,"_19451":115432,"_5":13353,"_26530":114848,"_2682":115433},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3185":67289,"_28073":67050,"_19451":115435,"_5":13353,"_26530":114848,"_2682":115436},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3185":67290,"_28073":67050,"_19451":115438,"_5":13353,"_26530":114848,"_2682":115439},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3185":67291,"_28073":67050,"_19451":115441,"_5":13353,"_26530":114848,"_2682":115442},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3185":67292,"_28073":67050,"_19451":115444,"_5":13353,"_26530":114852,"_2682":115445},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3185":67293,"_28073":67050,"_19451":115447,"_5":13353,"_26530":114852,"_2682":115448},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3185":67294,"_28073":67050,"_19451":115450,"_5":13353,"_26530":114852,"_2682":115451},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3185":67295,"_28073":67050,"_19451":115453,"_5":13353,"_26530":114852,"_2682":115454},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3185":67296,"_28073":67050,"_19451":115456,"_5":13353,"_26530":114852,"_2682":115457},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_53955":115459,"_53957":115460,"_53959":115461,"_53961":115462,"_16875":2704,"_64628":2704},"spanish",[2682,28073,5,26530],{"_2682":23260,"_28073":23260,"_5":23260,"_26530":23260},{"_2682":115463,"_28073":118128,"_5":120793,"_26530":123458},{"_4271":115464,"_53965":115465,"_5":23260},{"_13429":4