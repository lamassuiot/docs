30":53944,"_37532":53947,"_37534":53950},{"_3185":15,"_28073":15,"_5":13700,"_2682":45597,"_28416":45598,"_19451":45602,"_26530":15},"Deploy from AWS Marketplace",[45599,45600,45601],"Docs","Deployment","Other models",[],{"_3185":16,"_28073":15,"_19451":45604,"_5":13353,"_26530":15,"_2682":45605},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3185":17,"_28073":15,"_5":28413,"_19451":45607,"_26530":45608,"_2682":45609},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3185":18,"_28073":15,"_5":28413,"_19451":45611,"_26530":45612,"_2682":45613},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3185":19,"_28073":15,"_5":28413,"_19451":45615,"_26530":45616,"_2682":45617},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3185":20,"_28073":15,"_5":28413,"_19451":45619,"_26530":45620,"_2682":45621},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3185":21,"_28073":15,"_5":28413,"_19451":45623,"_26530":45624,"_2682":45625},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3185":22,"_28073":15,"_5":28413,"_19451":45627,"_26530":45628,"_2682":45629},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3185":23,"_28073":15,"_5":28413,"_19451":45631,"_26530":45632,"_2682":45633},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#next-step","Next step",{"_3185":24,"_28073":15,"_19451":45635,"_5":13353,"_26530":15,"_2682":45636},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3185":25,"_28073":15,"_19451":45638,"_5":13353,"_26530":45608,"_2682":45639},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3185":26,"_28073":15,"_19451":45641,"_5":13353,"_26530":45608,"_2682":45642},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3185":27,"_28073":15,"_19451":45644,"_5":13353,"_26530":45608,"_2682":45645},[],"A security group allowing the necessary endpoints.",{"_3185":28,"_28073":15,"_19451":45647,"_5":13353,"_26530":45612,"_2682":45648},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3185":29,"_28073":15,"_19451":45650,"_5":13353,"_26530":45612,"_2682":45651},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3185":30,"_28073":15,"_19451":45653,"_5":13353,"_26530":45612,"_2682":45654},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3185":31,"_28073":15,"_19451":45656,"_5":13353,"_26530":45616,"_2682":45657},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3185":32,"_28073":15,"_19451":45659,"_5":13353,"_26530":45620,"_2682":45660},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3185":33,"_28073":15,"_19451":45662,"_5":13353,"_26530":45624,"_2682":45663},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3185":34,"_28073":15,"_19451":45665,"_5":13353,"_26530":45628,"_2682":45666},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3185":35,"_28073":15,"_19451":45668,"_5":13353,"_26530":45632,"_2682":45669},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3185":36,"_28073":36,"_5":13700,"_2682":45671,"_28416":45672,"_19451":45673,"_26530":36},"Deploy Lamassu",[45599,45600],[],{"_3185":37,"_28073":36,"_19451":45675,"_5":13353,"_26530":36,"_2682":45676},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3185":38,"_28073":36,"_5":28413,"_19451":45678,"_26530":45679,"_2682":45680},[],"/docs/pr-preview/pr-42/deployment/overview#choose-a-model","Choose a model",{"_3185":39,"_28073":36,"_5":28413,"_19451":45682,"_26530":45683,"_2682":45684},[],"/docs/pr-preview/pr-42/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3185":40,"_28073":36,"_5":28413,"_19451":45686,"_26530":45687,"_2682":45688},[],"/docs/pr-preview/pr-42/deployment/overview#after-deployment","After deployment",{"_3185":41,"_28073":36,"_19451":45690,"_5":13353,"_26530":36,"_2682":45691},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3185":42,"_28073":36,"_19451":45693,"_5":13353,"_26530":45679,"_2682":45694},[],"Model",{"_3185":43,"_28073":36,"_19451":45696,"_5":13353,"_26530":45679,"_2682":45697},[],"Recommended for",{"_3185":44,"_28073":36,"_19451":45699,"_5":13353,"_26530":45679,"_2682":45700},[],"Who operates the infrastructure",{"_3185":45,"_28073":36,"_19451":45702,"_5":13353,"_26530":45679,"_2682":45703},[],"Starting point",{"_3185":46,"_28073":36,"_19451":45705,"_5":13353,"_26530":45679,"_2682":45706},[],"Kubernetes self-managed",{"_3185":47,"_28073":36,"_19451":45708,"_5":13353,"_26530":45679,"_2682":45709},[],"Production, regulated environments and custom deployments",{"_3185":48,"_28073":36,"_19451":45711,"_5":13353,"_26530":45679,"_2682":45712},[],"Your team",{"_3185":49,"_28073":36,"_19451":45714,"_5":13353,"_26530":45679,"_2682":45715},[],"Helm or Fastlane",{"_3185":50,"_28073":36,"_19451":45717,"_5":13353,"_26530":45679,"_2682":45718},[],"AWS Marketplace",{"_3185":51,"_28073":36,"_19451":45720,"_5":13353,"_26530":45679,"_2682":45721},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3185":52,"_28073":36,"_19451":45723,"_5":13353,"_26530":45679,"_2682":45712},[],{"_3185":53,"_28073":36,"_19451":45725,"_5":13353,"_26530":45679,"_2682":45726},[],"Preconfigured image on EC2",{"_3185":54,"_28073":36,"_19451":45728,"_5":13353,"_26530":45679,"_2682":45729},[],"SaaS",{"_3185":55,"_28073":36,"_19451":45731,"_5":13353,"_26530":45679,"_2682":45732},[],"Teams that want to use the platform without operating it",{"_3185":56,"_28073":36,"_19451":45734,"_5":13353,"_26530":45679,"_2682":45735},[],"Lamassu",{"_3185":57,"_28073":36,"_19451":45737,"_5":13353,"_26530":45679,"_2682":45738},[],"Managed subscription",{"_3185":58,"_28073":36,"_19451":45740,"_5":13353,"_26530":45679,"_2682":45741},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3185":59,"_28073":36,"_19451":45743,"_5":13353,"_26530":45679,"_2682":45744},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3185":60,"_28073":36,"_19451":45746,"_5":13353,"_26530":45679,"_2682":45747},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3185":61,"_28073":36,"_19451":45749,"_5":13353,"_26530":45683,"_2682":45750},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3185":62,"_28073":36,"_19451":45752,"_5":13353,"_26530":45687,"_2682":45753},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3185":63,"_28073":63,"_5":13700,"_2682":45755,"_28416":45756,"_19451":45757,"_26530":63},"Use Lamassu as SaaS",[45599,45600,45601],[],{"_3185":64,"_28073":63,"_19451":45759,"_5":13353,"_26530":63,"_2682":45760},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3185":65,"_28073":63,"_5":28413,"_19451":45762,"_26530":45763,"_2682":45764},[],"/docs/pr-preview/pr-42/deployment/saas#what-the-service-manages","What the service manages",{"_3185":66,"_28073":63,"_5":28413,"_19451":45766,"_26530":45767,"_2682":45768},[],"/docs/pr-preview/pr-42/deployment/saas#plans","Plans",{"_3185":67,"_28073":63,"_5":28413,"_19451":45770,"_26530":45771,"_2682":45772},[],"/docs/pr-preview/pr-42/deployment/saas#request-access","Request access",{"_3185":68,"_28073":63,"_19451":45774,"_5":13353,"_26530":63,"_2682":45775},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3185":69,"_28073":63,"_19451":45777,"_5":13353,"_26530":45763,"_2682":45778},[],"Platform availability and maintenance.",{"_3185":70,"_28073":63,"_19451":45780,"_5":13353,"_26530":45763,"_2682":45781},[],"Automatic backups.",{"_3185":71,"_28073":63,"_19451":45783,"_5":13353,"_26530":45763,"_2682":45784},[],"Version upgrades.",{"_3185":72,"_28073":63,"_19451":45786,"_5":13353,"_26530":45763,"_2682":45787},[],"Technical support and SLA according to your plan.",{"_3185":73,"_28073":63,"_19451":45789,"_5":13353,"_26530":45767,"_2682":45790},[],"Plan",{"_3185":74,"_28073":63,"_19451":45792,"_5":13353,"_26530":45767,"_2682":45793},[],"Devices",{"_3185":75,"_28073":63,"_19451":45795,"_5":13353,"_26530":45767,"_2682":45796},[],"Support",{"_3185":76,"_28073":63,"_19451":45798,"_5":13353,"_26530":45767,"_2682":45799},[],"SLA",{"_3185":77,"_28073":63,"_19451":45801,"_5":13353,"_26530":45767,"_2682":45802},[],"Starter",{"_3185":78,"_28073":63,"_19451":45804,"_5":13353,"_26530":45767,"_2682":45805},[],"Up to 1,000",{"_3185":79,"_28073":63,"_19451":45807,"_5":13353,"_26530":45767,"_2682":45808},[],"Email",{"_3185":80,"_28073":63,"_19451":45810,"_5":13353,"_26530":45767,"_2682":45811},[],"99.5 %",{"_3185":81,"_28073":63,"_19451":45813,"_5":13353,"_26530":45767,"_2682":45814},[],"Professional",{"_3185":82,"_28073":63,"_19451":45816,"_5":13353,"_26530":45767,"_2682":45817},[],"Up to 10,000",{"_3185":83,"_28073":63,"_19451":45819,"_5":13353,"_26530":45767,"_2682":45820},[],"Email and chat",{"_3185":84,"_28073":63,"_19451":45822,"_5":13353,"_26530":45767,"_2682":45823},[],"99.9 %",{"_3185":85,"_28073":63,"_19451":45825,"_5":13353,"_26530":45767,"_2682":45826},[],"Enterprise",{"_3185":86,"_28073":63,"_19451":45828,"_5":13353,"_26530":45767,"_2682":45829},[],"Unlimited",{"_3185":87,"_28073":63,"_19451":45831,"_5":13353,"_26530":45767,"_2682":45832},[],"Dedicated",{"_3185":88,"_28073":63,"_19451":45834,"_5":13353,"_26530":45767,"_2682":45835},[],"99.99 %",{"_3185":89,"_28073":63,"_19451":45837,"_5":13353,"_26530":45771,"_2682":45838},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3185":90,"_28073":63,"_19451":45840,"_5":13353,"_26530":45771,"_2682":45841},[],"When you receive your instance's credentials, continue with Get started.",{"_3185":91,"_28073":91,"_5":13700,"_2682":45843,"_28416":45844,"_19451":45845,"_26530":91},"Fastlane",[45599,45600,45706],[],{"_3185":92,"_28073":91,"_19451":45847,"_5":13353,"_26530":91,"_2682":45848},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3185":93,"_28073":91,"_5":28413,"_19451":45850,"_26530":45851,"_2682":45852},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3185":94,"_28073":91,"_5":28413,"_19451":45854,"_26530":45855,"_2682":45856},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3185":95,"_28073":91,"_5":28413,"_19451":45858,"_26530":45859,"_2682":45609},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#before-you-begin",{"_3185":96,"_28073":91,"_5":28413,"_19451":45861,"_26530":45862,"_2682":45863},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3185":97,"_28073":91,"_5":28413,"_19451":45865,"_26530":45866,"_2682":45867},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3185":98,"_28073":91,"_5":28413,"_19451":45869,"_26530":45870,"_2682":45871},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3185":99,"_28073":91,"_5":28413,"_19451":45873,"_26530":45874,"_2682":45875},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3185":100,"_28073":91,"_5":28413,"_19451":45877,"_26530":45878,"_2682":45879},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3185":101,"_28073":91,"_5":28413,"_19451":45881,"_26530":45882,"_2682":45883},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3185":102,"_28073":91,"_5":28413,"_19451":45885,"_26530":45886,"_2682":45887},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3185":103,"_28073":91,"_5":28413,"_19451":45889,"_26530":45890,"_2682":45891},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3185":104,"_28073":91,"_19451":45893,"_5":13353,"_26530":45851,"_2682":45894},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3185":105,"_28073":91,"_19451":45896,"_5":13353,"_26530":45851,"_2682":45897},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3185":106,"_28073":91,"_19451":45899,"_5":13353,"_26530":45855,"_2682":45900},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3185":107,"_28073":91,"_19451":45902,"_5":13353,"_26530":45855,"_2682":45903},[],"Fastlane installs or configures",{"_3185":108,"_28073":91,"_19451":45905,"_5":13353,"_26530":45855,"_2682":45906},[],"You still provide",{"_3185":109,"_28073":91,"_19451":45908,"_5":13353,"_26530":45855,"_2682":45909},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3185":110,"_28073":91,"_19451":45911,"_5":13353,"_26530":45855,"_2682":45912},[],"The Kubernetes cluster, nodes and persistent storage",{"_3185":111,"_28073":91,"_19451":45914,"_5":13353,"_26530":45855,"_2682":45915},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3185":112,"_28073":91,"_19451":45917,"_5":13353,"_26530":45855,"_2682":45918},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3185":113,"_28073":91,"_19451":45920,"_5":13353,"_26530":45855,"_2682":45921},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3185":114,"_28073":91,"_19451":45923,"_5":13353,"_26530":45855,"_2682":45924},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3185":115,"_28073":91,"_19451":45926,"_5":13353,"_26530":45855,"_2682":45927},[],"Optional observability and lab HSM components",{"_3185":116,"_28073":91,"_19451":45929,"_5":13353,"_26530":45855,"_2682":45930},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3185":117,"_28073":91,"_19451":45932,"_5":13353,"_26530":45855,"_2682":45933},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3185":118,"_28073":91,"_19451":45935,"_5":13353,"_26530":45859,"_2682":45936},[],"You need:",{"_3185":119,"_28073":91,"_19451":45938,"_5":13353,"_26530":45859,"_2682":45939},[],"an existing Kubernetes cluster",{"_3185":120,"_28073":91,"_19451":45941,"_5":13353,"_26530":45859,"_2682":45942},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3185":121,"_28073":91,"_19451":45944,"_5":13353,"_26530":45859,"_2682":45945},[],"`yq`",{"_3185":122,"_28073":91,"_19451":45947,"_5":13353,"_26530":45859,"_2682":22022},[],{"_3185":123,"_28073":91,"_19451":45949,"_5":13353,"_26530":45859,"_2682":45950},[],"`jq` only when using `--sample-data` or `--development`",{"_3185":124,"_28073":91,"_19451":45952,"_5":13353,"_26530":45859,"_2682":45953},[],"`ssh-keygen` only when using `--with-hsm`",{"_3185":125,"_28073":91,"_19451":45955,"_5":13353,"_26530":45859,"_2682":45956},[],"free external ports 80 and 443 on a single-node K3s host",{"_3185":126,"_28073":91,"_19451":45958,"_5":13353,"_26530":45859,"_2682":45959},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3185":127,"_28073":91,"_19451":45961,"_5":13353,"_26530":45859,"_2682":45962},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3185":128,"_28073":91,"_19451":45964,"_5":13353,"_26530":45862,"_2682":45965},[],"Run the script from a clone of the Helm repository:",{"_3185":129,"_28073":91,"_19451":45967,"_5":13353,"_26530":45862,"_2682":45968},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3185":130,"_28073":91,"_19451":45970,"_5":13353,"_26530":45866,"_2682":45971},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3185":131,"_28073":91,"_19451":45973,"_5":13353,"_26530":45866,"_2682":45974},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3185":132,"_28073":91,"_19451":45976,"_5":13353,"_26530":45866,"_2682":45977},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3185":133,"_28073":91,"_19451":45979,"_5":13353,"_26530":45866,"_2682":45980},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3185":134,"_28073":91,"_19451":45982,"_5":13353,"_26530":45870,"_2682":45983},[],"Option",{"_3185":135,"_28073":91,"_19451":45985,"_5":13353,"_26530":45870,"_2682":45986},[],"Default",{"_3185":136,"_28073":91,"_19451":45988,"_5":13353,"_26530":45870,"_2682":45989},[],"Purpose",{"_3185":137,"_28073":91,"_19451":45991,"_5":13353,"_26530":45870,"_2682":45992},[],"`-h`, `--help`",{"_3185":138,"_28073":91,"_19451":45994,"_5":13353,"_26530":45870,"_2682":45995},[],"—",{"_3185":139,"_28073":91,"_19451":45997,"_5":13353,"_26530":45870,"_2682":45998},[],"Show help",{"_3185":140,"_28073":91,"_19451":46000,"_5":13353,"_26530":45870,"_2682":46001},[],"`-c`, `--context`",{"_3185":141,"_28073":91,"_19451":46003,"_5":13353,"_26530":45870,"_2682":46004},[],"current context",{"_3185":142,"_28073":91,"_19451":46006,"_5":13353,"_26530":45870,"_2682":46007},[],"Select the kubeconfig context for kubectl and Helm",{"_3185":143,"_28073":91,"_19451":46009,"_5":13353,"_26530":45870,"_2682":46010},[],"`-n`, `--non-interactive`",{"_3185":144,"_28073":91,"_19451":46012,"_5":13353,"_26530":45870,"_2682":5971},[],{"_3185":145,"_28073":91,"_19451":46014,"_5":13353,"_26530":45870,"_2682":46015},[],"Skip prompts and generate dependency credentials",{"_3185":146,"_28073":91,"_19451":46017,"_5":13353,"_26530":45870,"_2682":46018},[],"`-ns`, `--namespace`",{"_3185":147,"_28073":91,"_19451":46020,"_5":13353,"_26530":45870,"_2682":46021},[],"`lamassu-dev`",{"_3185":148,"_28073":91,"_19451":46023,"_5":13353,"_26530":45870,"_2682":46024},[],"Namespace for the installation",{"_3185":149,"_28073":91,"_19451":46026,"_5":13353,"_26530":45870,"_2682":46027},[],"`-d`, `--domain`",{"_3185":150,"_28073":91,"_19451":46029,"_5":13353,"_26530":45870,"_2682":46030},[],"`dev.lamassu.io`",{"_3185":151,"_28073":91,"_19451":46032,"_5":13353,"_26530":45870,"_2682":46033},[],"Domain used by the UI, OIDC and certificate",{"_3185":152,"_28073":91,"_19451":46035,"_5":13353,"_26530":45870,"_2682":46036},[],"`-v`, `--version`",{"_3185":153,"_28073":91,"_19451":46038,"_5":13353,"_26530":45870,"_2682":14000},[],{"_3185":154,"_28073":91,"_19451":46040,"_5":13353,"_26530":45870,"_2682":46041},[],"Lamassu chart version",{"_3185":155,"_28073":91,"_19451":46043,"_5":13353,"_26530":45870,"_2682":46044},[],"`--https-port`",{"_3185":156,"_28073":91,"_19451":46046,"_5":13353,"_26530":45870,"_2682":46047},[],"`443`",{"_3185":157,"_28073":91,"_19451":46049,"_5":13353,"_26530":45870,"_2682":46050},[],"Gateway HTTPS listener port",{"_3185":158,"_28073":91,"_19451":46052,"_5":13353,"_26530":45870,"_2682":46053},[],"`--http-port`",{"_3185":159,"_28073":91,"_19451":46055,"_5":13353,"_26530":45870,"_2682":46056},[],"`80`",{"_3185":160,"_28073":91,"_19451":46058,"_5":13353,"_26530":45870,"_2682":46059},[],"Gateway HTTP listener port",{"_3185":161,"_28073":91,"_19451":46061,"_5":13353,"_26530":45870,"_2682":46062},[],"`--tls-crt`",{"_3185":162,"_28073":91,"_19451":46064,"_5":13353,"_26530":45870,"_2682":45995},[],{"_3185":163,"_28073":91,"_19451":46066,"_5":13353,"_26530":45870,"_2682":46067},[],"PEM certificate for downstream TLS",{"_3185":164,"_28073":91,"_19451":46069,"_5":13353,"_26530":45870,"_2682":46070},[],"`--tls-key`",{"_3185":165,"_28073":91,"_19451":46072,"_5":13353,"_26530":45870,"_2682":45995},[],{"_3185":166,"_28073":91,"_19451":46074,"_5":13353,"_26530":45870,"_2682":46075},[],"PEM private key for downstream TLS",{"_3185":167,"_28073":91,"_19451":46077,"_5":13353,"_26530":45870,"_2682":46078},[],"`-l`, `--local-chart-path`",{"_3185":168,"_28073":91,"_19451":46080,"_5":13353,"_26530":45870,"_2682":46081},[],"repository chart",{"_3185":169,"_28073":91,"_19451":46083,"_5":13353,"_26530":45870,"_2682":46084},[],"Use an unpacked local Lamassu chart",{"_3185":170,"_28073":91,"_19451":46086,"_5":13353,"_26530":45870,"_2682":46087},[],"`-ip`, `--gateway-ip`",{"_3185":171,"_28073":91,"_19451":46089,"_5":13353,"_26530":45870,"_2682":8058},[],{"_3185":172,"_28073":91,"_19451":46091,"_5":13353,"_26530":45870,"_2682":46092},[],"Override the address written to `gateway.addresses`",{"_3185":173,"_28073":91,"_19451":46094,"_5":13353,"_26530":45870,"_2682":46095},[],"`--otel`",{"_3185":174,"_28073":91,"_19451":46097,"_5":13353,"_26530":45870,"_2682":5971},[],{"_3185":175,"_28073":91,"_19451":46099,"_5":13353,"_26530":45870,"_2682":46100},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3185":176,"_28073":91,"_19451":46102,"_5":13353,"_26530":45870,"_2682":46103},[],"`--development`",{"_3185":177,"_28073":91,"_19451":46105,"_5":13353,"_26530":45870,"_2682":5971},[],{"_3185":178,"_28073":91,"_19451":46107,"_5":13353,"_26530":45870,"_2682":46108},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3185":179,"_28073":91,"_19451":46110,"_5":13353,"_26530":45870,"_2682":46111},[],"`--sample-data`",{"_3185":180,"_28073":91,"_19451":46113,"_5":13353,"_26530":45870,"_2682":5971},[],{"_3185":181,"_28073":91,"_19451":46115,"_5":13353,"_26530":45870,"_2682":46116},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3185":182,"_28073":91,"_19451":46118,"_5":13353,"_26530":45870,"_2682":46119},[],"`--with-hsm`",{"_3185":183,"_28073":91,"_19451":46121,"_5":13353,"_26530":45870,"_2682":5971},[],{"_3185":184,"_28073":91,"_19451":46123,"_5":13353,"_26530":45870,"_2682":46124},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3185":185,"_28073":91,"_19451":46126,"_5":13353,"_26530":45870,"_2682":46127},[],"`--softhsm-chart-path`",{"_3185":186,"_28073":91,"_19451":46129,"_5":13353,"_26530":45870,"_2682":46130},[],"`./charts/softhsm`",{"_3185":187,"_28073":91,"_19451":46132,"_5":13353,"_26530":45870,"_2682":46133},[],"Use a different local SoftHSM chart",{"_3185":188,"_28073":91,"_19451":46135,"_5":13353,"_26530":45870,"_2682":46136},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3185":189,"_28073":91,"_19451":46138,"_5":13353,"_26530":45874,"_2682":46139},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3185":190,"_28073":91,"_19451":46141,"_5":13353,"_26530":45874,"_2682":46142},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3185":191,"_28073":91,"_19451":46144,"_5":13353,"_26530":45874,"_2682":46145},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3185":192,"_28073":91,"_19451":46147,"_5":13353,"_26530":45874,"_2682":46148},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3185":193,"_28073":91,"_19451":46150,"_5":13353,"_26530":45874,"_2682":46151},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3185":194,"_28073":91,"_19451":46153,"_5":13353,"_26530":45874,"_2682":46154},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3185":195,"_28073":91,"_19451":46156,"_5":13353,"_26530":45878,"_2682":46157},[],"Fastlane:",{"_3185":196,"_28073":91,"_19451":46159,"_5":13353,"_26530":45878,"_2682":46160},[],"validates local tools and the selected cluster",{"_3185":197,"_28073":91,"_19451":46162,"_5":13353,"_26530":45878,"_2682":46163},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3185":198,"_28073":91,"_19451":46165,"_5":13353,"_26530":45878,"_2682":46166},[],"creates the namespace",{"_3185":199,"_28073":91,"_19451":46168,"_5":13353,"_26530":45878,"_2682":46169},[],"installs PostgreSQL and creates the required databases",{"_3185":200,"_28073":91,"_19451":46171,"_5":13353,"_26530":45878,"_2682":46172},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3185":201,"_28073":91,"_19451":46174,"_5":13353,"_26530":45878,"_2682":46175},[],"installs RabbitMQ",{"_3185":202,"_28073":91,"_19451":46177,"_5":13353,"_26530":45878,"_2682":46178},[],"optionally installs observability and lab HSM components",{"_3185":203,"_28073":91,"_19451":46180,"_5":13353,"_26530":45878,"_2682":46181},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3185":204,"_28073":91,"_19451":46183,"_5":13353,"_26530":45878,"_2682":46184},[],"optionally loads sample data",{"_3185":205,"_28073":91,"_19451":46186,"_5":13353,"_26530":45878,"_2682":46187},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3185":206,"_28073":91,"_19451":46189,"_5":13353,"_26530":45882,"_2682":46190},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3185":207,"_28073":91,"_19451":46192,"_5":13353,"_26530":45882,"_2682":46193},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3185":208,"_28073":91,"_19451":46195,"_5":13353,"_26530":45886,"_2682":46196},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3185":209,"_28073":91,"_19451":46198,"_5":13353,"_26530":45886,"_2682":46199},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3185":210,"_28073":91,"_19451":46201,"_5":13353,"_26530":45886,"_2682":46202},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3185":211,"_28073":91,"_19451":46204,"_5":13353,"_26530":45890,"_2682":46205},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3185":212,"_28073":212,"_5":13700,"_2682":46207,"_28416":46208,"_19451":46209,"_26530":212},"Install with Helm",[45599,45600,45706],[],{"_3185":213,"_28073":212,"_19451":46211,"_5":13353,"_26530":212,"_2682":46212},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3185":214,"_28073":212,"_5":28413,"_19451":46214,"_26530":46215,"_2682":46216},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3185":215,"_28073":212,"_5":28413,"_19451":46218,"_26530":46219,"_2682":45609},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#before-you-begin",{"_3185":216,"_28073":212,"_5":28413,"_19451":46221,"_26530":46222,"_2682":46223},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3185":217,"_28073":212,"_5":28413,"_19451":46225,"_26530":46226,"_2682":46227},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3185":218,"_28073":212,"_5":28413,"_19451":46229,"_26530":46230,"_2682":46231},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3185":219,"_28073":212,"_5":28413,"_19451":46233,"_26530":46234,"_2682":46235},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3185":220,"_28073":212,"_5":28413,"_19451":46237,"_26530":46238,"_2682":46239},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3185":221,"_28073":212,"_5":28413,"_19451":46241,"_26530":46242,"_2682":46243},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3185":222,"_28073":212,"_5":28413,"_19451":46245,"_26530":46246,"_2682":46247},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3185":223,"_28073":212,"_5":28413,"_19451":46249,"_26530":46250,"_2682":46251},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3185":224,"_28073":212,"_19451":46253,"_5":13353,"_26530":46215,"_2682":46254},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3185":225,"_28073":212,"_19451":46256,"_5":13353,"_26530":46219,"_2682":46257},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3185":226,"_28073":212,"_19451":46259,"_5":13353,"_26530":46219,"_2682":46260},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3185":227,"_28073":212,"_19451":46262,"_5":13353,"_26530":46219,"_2682":46263},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3185":228,"_28073":212,"_19451":46265,"_5":13353,"_26530":46219,"_2682":46266},[],"a reachable RabbitMQ broker and credentials",{"_3185":229,"_28073":212,"_19451":46268,"_5":13353,"_26530":46219,"_2682":46269},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3185":230,"_28073":212,"_19451":46271,"_5":13353,"_26530":46219,"_2682":46272},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3185":231,"_28073":212,"_19451":46274,"_5":13353,"_26530":46219,"_2682":46275},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3185":232,"_28073":212,"_19451":46277,"_5":13353,"_26530":46219,"_2682":46278},[],"a StorageClass and an external traffic design",{"_3185":233,"_28073":212,"_19451":46280,"_5":13353,"_26530":46219,"_2682":46281},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3185":234,"_28073":212,"_19451":46283,"_5":13353,"_26530":46219,"_2682":46284},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3185":235,"_28073":212,"_19451":46286,"_5":13353,"_26530":46219,"_2682":46287},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3185":236,"_28073":212,"_19451":46289,"_5":13353,"_26530":46222,"_2682":46290},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3185":237,"_28073":212,"_19451":46292,"_5":13353,"_26530":46222,"_2682":46293},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3185":238,"_28073":212,"_19451":46295,"_5":13353,"_26530":46222,"_2682":46296},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3185":239,"_28073":212,"_19451":46298,"_5":13353,"_26530":46226,"_2682":46299},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3185":240,"_28073":212,"_19451":46301,"_5":13353,"_26530":46226,"_2682":46302},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3185":241,"_28073":212,"_19451":46304,"_5":13353,"_26530":46226,"_2682":46305},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3185":242,"_28073":212,"_19451":46307,"_5":13353,"_26530":46226,"_2682":46308},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3185":243,"_28073":212,"_19451":46310,"_5":13353,"_26530":46230,"_2682":46311},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3185":244,"_28073":212,"_19451":46313,"_5":13353,"_26530":46234,"_2682":46314},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3185":245,"_28073":212,"_19451":46316,"_5":13353,"_26530":46234,"_2682":46317},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3185":246,"_28073":212,"_19451":46319,"_5":13353,"_26530":46234,"_2682":46320},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3185":247,"_28073":212,"_19451":46322,"_5":13353,"_26530":46234,"_2682":46323},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3185":248,"_28073":212,"_19451":46325,"_5":13353,"_26530":46234,"_2682":46326},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3185":249,"_28073":212,"_19451":46328,"_5":13353,"_26530":46234,"_2682":46329},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3185":250,"_28073":212,"_19451":46331,"_5":13353,"_26530":46234,"_2682":46332},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP.",{"_3185":251,"_28073":212,"_19451":46334,"_5":13353,"_26530":46238,"_2682":46335},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3185":252,"_28073":212,"_19451":46337,"_5":13353,"_26530":46238,"_2682":46338},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3185":253,"_28073":212,"_19451":46340,"_5":13353,"_26530":46238,"_2682":46341},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3185":254,"_28073":212,"_19451":46343,"_5":13353,"_26530":46238,"_2682":46344},[],"See Access control for the principal and policy model.",{"_3185":255,"_28073":212,"_19451":46346,"_5":13353,"_26530":46242,"_2682":46347},[],"To install a local checkout instead:",{"_3185":256,"_28073":212,"_19451":46349,"_5":13353,"_26530":46246,"_2682":46350},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3185":257,"_28073":212,"_19451":46352,"_5":13353,"_26530":46246,"_2682":46353},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3185":258,"_28073":212,"_19451":46355,"_5":13353,"_26530":46250,"_2682":46356},[],"Before going live, review:",{"_3185":259,"_28073":212,"_19451":46358,"_5":13353,"_26530":46250,"_2682":46359},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3185":260,"_28073":212,"_19451":46361,"_5":13353,"_26530":46250,"_2682":46362},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3185":261,"_28073":212,"_19451":46364,"_5":13353,"_26530":46250,"_2682":46365},[],"shared VA storage before increasing VA replicas",{"_3185":262,"_28073":212,"_19451":46367,"_5":13353,"_26530":46250,"_2682":46368},[],"managed OIDC roles and removal of evaluation credentials",{"_3185":263,"_28073":212,"_19451":46370,"_5":13353,"_26530":46250,"_2682":46371},[],"a trusted TLS issuer or externally managed certificate",{"_3185":264,"_28073":212,"_19451":46373,"_5":13353,"_26530":46250,"_2682":46374},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3185":265,"_28073":212,"_19451":46376,"_5":13353,"_26530":46250,"_2682":46377},[],"SMTP, observability and alert delivery",{"_3185":266,"_28073":212,"_19451":46379,"_5":13353,"_26530":46250,"_2682":46380},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3185":267,"_28073":212,"_19451":46382,"_5":13353,"_26530":46250,"_2682":46383},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3185":268,"_28073":268,"_5":13700,"_2682":46385,"_28416":46386,"_19451":46387,"_26530":268},"Expose the Gateway",[45599,45600,45706],[],{"_3185":269,"_28073":268,"_19451":46389,"_5":13353,"_26530":268,"_2682":46390},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3185":270,"_28073":268,"_5":28413,"_19451":46392,"_26530":46393,"_2682":46394},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3185":271,"_28073":268,"_5":28413,"_19451":46396,"_26530":46397,"_2682":46398},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3185":272,"_28073":268,"_5":28413,"_19451":46400,"_26530":46401,"_2682":46402},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3185":273,"_28073":268,"_5":28413,"_19451":46404,"_26530":46405,"_2682":46406},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#k3s","K3s",{"_3185":274,"_28073":268,"_5":28413,"_19451":46408,"_26530":46409,"_2682":46410},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3185":275,"_28073":268,"_5":28413,"_19451":46412,"_26530":46413,"_2682":46414},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3185":276,"_28073":268,"_5":28413,"_19451":46416,"_26530":46417,"_2682":46418},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3185":277,"_28073":268,"_5":28413,"_19451":46420,"_26530":46421,"_2682":46422},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3185":278,"_28073":268,"_5":28413,"_19451":46424,"_26530":46425,"_2682":46426},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3185":279,"_28073":268,"_19451":46428,"_5":13353,"_26530":46393,"_2682":46429},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3185":280,"_28073":268,"_19451":46431,"_5":13353,"_26530":46393,"_2682":46432},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3185":281,"_28073":268,"_19451":46434,"_5":13353,"_26530":46397,"_2682":46435},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3185":282,"_28073":268,"_19451":46437,"_5":13353,"_26530":46397,"_2682":46438},[],"Set it only when:",{"_3185":283,"_28073":268,"_19451":46440,"_5":13353,"_26530":46397,"_2682":46441},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3185":284,"_28073":268,"_19451":46443,"_5":13353,"_26530":46397,"_2682":46444},[],"that address is allocated to this Gateway",{"_3185":285,"_28073":268,"_19451":46446,"_5":13353,"_26530":46397,"_2682":46447},[],"the surrounding network already routes traffic for it to the cluster",{"_3185":286,"_28073":268,"_19451":46449,"_5":13353,"_26530":46397,"_2682":46450},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3185":287,"_28073":268,"_19451":46452,"_5":13353,"_26530":46397,"_2682":46453},[],"Keep these two settings separate:",{"_3185":288,"_28073":268,"_19451":46455,"_5":13353,"_26530":46397,"_2682":46456},[],"`gateway.addresses` requests an address for the Gateway.",{"_3185":289,"_28073":268,"_19451":46458,"_5":13353,"_26530":46397,"_2682":46459},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3185":290,"_28073":268,"_19451":46461,"_5":13353,"_26530":46397,"_2682":46462},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3185":291,"_28073":268,"_19451":46464,"_5":13353,"_26530":46401,"_2682":46465},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3185":292,"_28073":268,"_19451":46467,"_5":13353,"_26530":46401,"_2682":46468},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3185":293,"_28073":268,"_19451":46470,"_5":13353,"_26530":46405,"_2682":46471},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3185":294,"_28073":268,"_19451":46473,"_5":13353,"_26530":46405,"_2682":46474},[],"For the recommended design:",{"_3185":295,"_28073":268,"_19451":46476,"_5":13353,"_26530":46405,"_2682":46477},[],"Use only one externally exposed Lamassu Gateway.",{"_3185":296,"_28073":268,"_19451":46479,"_5":13353,"_26530":46405,"_2682":46480},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3185":297,"_28073":268,"_19451":46482,"_5":13353,"_26530":46405,"_2682":46483},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3185":298,"_28073":268,"_19451":46485,"_5":13353,"_26530":46405,"_2682":46486},[],"Point DNS at the VM's reachable address.",{"_3185":299,"_28073":268,"_19451":46488,"_5":13353,"_26530":46405,"_2682":46489},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3185":300,"_28073":268,"_19451":46491,"_5":13353,"_26530":46409,"_2682":46492},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3185":301,"_28073":268,"_19451":46494,"_5":13353,"_26530":46413,"_2682":46495},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3185":302,"_28073":268,"_19451":46497,"_5":13353,"_26530":46413,"_2682":46498},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3185":303,"_28073":268,"_19451":46500,"_5":13353,"_26530":46417,"_2682":46501},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3185":304,"_28073":268,"_19451":46503,"_5":13353,"_26530":46417,"_2682":46504},[],"Requirement",{"_3185":305,"_28073":268,"_19451":46506,"_5":13353,"_26530":46417,"_2682":46507},[],"Recommended design",{"_3185":306,"_28073":268,"_19451":46509,"_5":13353,"_26530":46417,"_2682":46510},[],"Consequence",{"_3185":307,"_28073":268,"_19451":46512,"_5":13353,"_26530":46417,"_2682":46513},[],"Several Lamassu URLs or services",{"_3185":308,"_28073":268,"_19451":46515,"_5":13353,"_26530":46417,"_2682":46516},[],"One Gateway with multiple routes",{"_3185":309,"_28073":268,"_19451":46518,"_5":13353,"_26530":46417,"_2682":46519},[],"One IP and one proxy fleet; this is the chart default",{"_3185":310,"_28073":268,"_19451":46521,"_5":13353,"_26530":46417,"_2682":46522},[],"Independent Gateways and separate external IPs",{"_3185":311,"_28073":268,"_19451":46524,"_5":13353,"_26530":46417,"_2682":46525},[],"One VIP per Gateway",{"_3185":312,"_28073":268,"_19451":46527,"_5":13353,"_26530":46417,"_2682":46528},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3185":313,"_28073":268,"_19451":46530,"_5":13353,"_26530":46417,"_2682":46531},[],"Independent Gateways on one node and one IP",{"_3185":314,"_28073":268,"_19451":46533,"_5":13353,"_26530":46417,"_2682":46534},[],"Use different external ports",{"_3185":315,"_28073":268,"_19451":46536,"_5":13353,"_26530":46417,"_2682":46537},[],"Clients must include non-standard ports",{"_3185":316,"_28073":268,"_19451":46539,"_5":13353,"_26530":46417,"_2682":46540},[],"Separate TLS/mTLS termination behind one IP",{"_3185":317,"_28073":268,"_19451":46542,"_5":13353,"_26530":46417,"_2682":46543},[],"Front-door SNI routing to internal Gateways",{"_3185":318,"_28073":268,"_19451":46545,"_5":13353,"_26530":46417,"_2682":46546},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3185":319,"_28073":268,"_19451":46548,"_5":13353,"_26530":46417,"_2682":46549},[],"Separate Gateway resources but shared proxy infrastructure",{"_3185":320,"_28073":268,"_19451":46551,"_5":13353,"_26530":46417,"_2682":46552},[],"Envoy merged-Gateway mode",{"_3185":321,"_28073":268,"_19451":46554,"_5":13353,"_26530":46417,"_2682":46555},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3185":322,"_28073":268,"_19451":46557,"_5":13353,"_26530":46417,"_2682":46558},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3185":323,"_28073":268,"_19451":46560,"_5":13353,"_26530":46417,"_2682":46561},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3185":324,"_28073":268,"_19451":46563,"_5":13353,"_26530":46417,"_2682":46564},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3185":325,"_28073":268,"_19451":46566,"_5":13353,"_26530":46417,"_2682":46567},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3185":326,"_28073":268,"_19451":46569,"_5":13353,"_26530":46421,"_2682":46570},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3185":327,"_28073":268,"_19451":46572,"_5":13353,"_26530":46421,"_2682":46573},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3185":328,"_28073":268,"_19451":46575,"_5":13353,"_26530":46421,"_2682":46576},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3185":329,"_28073":268,"_19451":46578,"_5":13353,"_26530":46421,"_2682":46579},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3185":330,"_28073":268,"_19451":46581,"_5":13353,"_26530":46421,"_2682":46582},[],"If none of those are possible, use different external ports or change the external network design.",{"_3185":331,"_28073":268,"_19451":46584,"_5":13353,"_26530":46425,"_2682":46585},[],"Check, in order:",{"_3185":332,"_28073":268,"_19451":46587,"_5":13353,"_26530":46425,"_2682":46588},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3185":333,"_28073":268,"_19451":46590,"_5":13353,"_26530":46425,"_2682":46591},[],"Its status contains the expected address.",{"_3185":334,"_28073":268,"_19451":46593,"_5":13353,"_26530":46425,"_2682":46594},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3185":335,"_28073":268,"_19451":46596,"_5":13353,"_26530":46425,"_2682":46597},[],"Port 443 reaches that address from the client network.",{"_3185":336,"_28073":268,"_19451":46599,"_5":13353,"_26530":46425,"_2682":46600},[],"DNS resolves to the externally reachable endpoint.",{"_3185":337,"_28073":268,"_19451":46602,"_5":13353,"_26530":46425,"_2682":46603},[],"The certificate contains the DNS name or IP used by the client.",{"_3185":338,"_28073":268,"_19451":46605,"_5":13353,"_26530":46425,"_2682":46606},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3185":339,"_28073":339,"_5":13700,"_2682":45706,"_28416":46608,"_19451":46609,"_26530":339},[45599,45600,45706],[],{"_3185":340,"_28073":339,"_19451":46611,"_5":13353,"_26530":339,"_2682":46612},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3185":341,"_28073":339,"_5":28413,"_19451":46614,"_26530":46615,"_2682":46616},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3185":342,"_28073":339,"_5":28413,"_19451":46618,"_26530":46619,"_2682":46620},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3185":343,"_28073":339,"_5":28413,"_19451":46622,"_26530":46623,"_2682":46624},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3185":344,"_28073":339,"_5":28413,"_19451":46626,"_26530":46627,"_2682":46628},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3185":345,"_28073":339,"_5":28413,"_19451":46630,"_26530":46631,"_2682":46632},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3185":346,"_28073":339,"_5":28413,"_19451":46634,"_26530":46635,"_2682":46636},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3185":347,"_28073":339,"_19451":46638,"_5":13353,"_26530":46615,"_2682":46639},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3185":348,"_28073":339,"_19451":46641,"_5":13353,"_26530":46619,"_2682":46642},[],"Workflow",{"_3185":349,"_28073":339,"_19451":46644,"_5":13353,"_26530":46619,"_2682":46645},[],"Use it for",{"_3185":350,"_28073":339,"_19451":46647,"_5":13353,"_26530":46619,"_2682":46648},[],"What it installs",{"_3185":351,"_28073":339,"_19451":46650,"_5":13353,"_26530":46619,"_2682":46651},[],"Helm",{"_3185":352,"_28073":339,"_19451":46653,"_5":13353,"_26530":46619,"_2682":46654},[],"Production and controlled environments",{"_3185":353,"_28073":339,"_19451":46656,"_5":13353,"_26530":46619,"_2682":46657},[],"Lamassu services and Gateway API resources",{"_3185":354,"_28073":339,"_19451":46659,"_5":13353,"_26530":46619,"_2682":45843},[],{"_3185":355,"_28073":339,"_19451":46661,"_5":13353,"_26530":46619,"_2682":46662},[],"Evaluation, demos, CI and small lab clusters",{"_3185":356,"_28073":339,"_19451":46664,"_5":13353,"_26530":46619,"_2682":46665},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3185":357,"_28073":339,"_19451":46667,"_5":13353,"_26530":46623,"_2682":46668},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3185":358,"_28073":339,"_19451":46670,"_5":13353,"_26530":46623,"_2682":46671},[],"Area",{"_3185":359,"_28073":339,"_19451":46673,"_5":13353,"_26530":46623,"_2682":46674},[],"The Lamassu chart provides",{"_3185":360,"_28073":339,"_19451":46676,"_5":13353,"_26530":46623,"_2682":46677},[],"You provide",{"_3185":361,"_28073":339,"_19451":46679,"_5":13353,"_26530":46623,"_2682":46680},[],"Lamassu applications",{"_3185":362,"_28073":339,"_19451":46682,"_5":13353,"_26530":46623,"_2682":46683},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3185":363,"_28073":339,"_19451":46685,"_5":13353,"_26530":46623,"_2682":46686},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3185":364,"_28073":339,"_19451":46688,"_5":13353,"_26530":46623,"_2682":46689},[],"PostgreSQL data",{"_3185":365,"_28073":339,"_19451":46691,"_5":13353,"_26530":46623,"_2682":46692},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3185":366,"_28073":339,"_19451":46694,"_5":13353,"_26530":46623,"_2682":46695},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3185":367,"_28073":339,"_19451":46697,"_5":13353,"_26530":46623,"_2682":46698},[],"Messaging",{"_3185":368,"_28073":339,"_19451":46700,"_5":13353,"_26530":46623,"_2682":46701},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS with a private CA and an optional client certificate, both set through chart values",{"_3185":369,"_28073":339,"_19451":46703,"_5":13353,"_26530":46623,"_2682":46704},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3185":370,"_28073":339,"_19451":46706,"_5":13353,"_26530":46623,"_2682":46707},[],"Identity",{"_3185":371,"_28073":339,"_19451":46709,"_5":13353,"_26530":46623,"_2682":46710},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3185":372,"_28073":339,"_19451":46712,"_5":13353,"_26530":46623,"_2682":46713},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3185":373,"_28073":339,"_19451":46715,"_5":13353,"_26530":46623,"_2682":46716},[],"External routing",{"_3185":374,"_28073":339,"_19451":46718,"_5":13353,"_26530":46623,"_2682":46719},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3185":375,"_28073":339,"_19451":46721,"_5":13353,"_26530":46623,"_2682":46722},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3185":376,"_28073":339,"_19451":46724,"_5":13353,"_26530":46623,"_2682":46725},[],"TLS",{"_3185":377,"_28073":339,"_19451":46727,"_5":13353,"_26530":46623,"_2682":46728},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3185":378,"_28073":339,"_19451":46730,"_5":13353,"_26530":46623,"_2682":46731},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3185":379,"_28073":339,"_19451":46733,"_5":13353,"_26530":46623,"_2682":46734},[],"Persistent application data",{"_3185":380,"_28073":339,"_19451":46736,"_5":13353,"_26530":46623,"_2682":46737},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3185":381,"_28073":339,"_19451":46739,"_5":13353,"_26530":46623,"_2682":46740},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3185":382,"_28073":339,"_19451":46742,"_5":13353,"_26530":46623,"_2682":46743},[],"Optional integrations",{"_3185":383,"_28073":339,"_19451":46745,"_5":13353,"_26530":46623,"_2682":46746},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3185":384,"_28073":339,"_19451":46748,"_5":13353,"_26530":46623,"_2682":46749},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3185":385,"_28073":339,"_19451":46751,"_5":13353,"_26530":46623,"_2682":46752},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3185":386,"_28073":339,"_19451":46754,"_5":13353,"_26530":46623,"_2682":46755},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3185":387,"_28073":339,"_19451":46757,"_5":13353,"_26530":46627,"_2682":46758},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3185":388,"_28073":339,"_19451":46760,"_5":13353,"_26530":46627,"_2682":46761},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3185":389,"_28073":339,"_19451":46763,"_5":13353,"_26530":46631,"_2682":46764},[],"Kubernetes 1.24 or newer",{"_3185":390,"_28073":339,"_19451":46766,"_5":13353,"_26530":46631,"_2682":46767},[],"Helm 3.2 or newer",{"_3185":391,"_28073":339,"_19451":46769,"_5":13353,"_26530":46631,"_2682":46770},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3185":392,"_28073":339,"_19451":46772,"_5":13353,"_26530":46631,"_2682":46773},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3185":393,"_28073":339,"_19451":46775,"_5":13353,"_26530":46631,"_2682":46776},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3185":394,"_28073":339,"_19451":46778,"_5":13353,"_26530":46631,"_2682":46779},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3185":395,"_28073":339,"_19451":46781,"_5":13353,"_26530":46631,"_2682":46782},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3185":396,"_28073":339,"_19451":46784,"_5":13353,"_26530":46635,"_2682":46785},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3185":397,"_28073":339,"_19451":46787,"_5":13353,"_26530":46635,"_2682":46788},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3185":398,"_28073":339,"_19451":46790,"_5":13353,"_26530":46635,"_2682":46791},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3185":399,"_28073":339,"_19451":46793,"_5":13353,"_26530":46635,"_2682":46794},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3185":400,"_28073":400,"_5":13700,"_2682":46796,"_28416":46797,"_19451":46799,"_26530":400},"Deployment troubleshooting",[45599,45600,46798],"Operations",[],{"_3185":401,"_28073":400,"_19451":46801,"_5":13353,"_26530":400,"_2682":46802},[],"Diagnose access, service health and infrastructure dependencies.",{"_3185":402,"_28073":400,"_5":28413,"_19451":46804,"_26530":46805,"_2682":46806},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3185":403,"_28073":400,"_5":28413,"_19451":46808,"_26530":46809,"_2682":46810},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3185":404,"_28073":400,"_5":28413,"_19451":46812,"_26530":46813,"_2682":46814},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3185":405,"_28073":400,"_5":28413,"_19451":46816,"_26530":46817,"_2682":46818},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3185":406,"_28073":400,"_5":28413,"_19451":46820,"_26530":46821,"_2682":46822},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3185":407,"_28073":400,"_5":28413,"_19451":46824,"_26530":46825,"_2682":46826},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3185":408,"_28073":400,"_5":28413,"_19451":46828,"_26530":46829,"_2682":46830},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3185":409,"_28073":400,"_5":28413,"_19451":46832,"_26530":46833,"_2682":46834},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3185":410,"_28073":400,"_5":28413,"_19451":46836,"_26530":46837,"_2682":46838},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3185":411,"_28073":400,"_5":28413,"_19451":46840,"_26530":46841,"_2682":46842},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3185":412,"_28073":400,"_5":28413,"_19451":46844,"_26530":46845,"_2682":46846},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3185":413,"_28073":400,"_5":28413,"_19451":46848,"_26530":46849,"_2682":46850},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3185":414,"_28073":400,"_5":28413,"_19451":46852,"_26530":46853,"_2682":46854},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#observability","Observability",{"_3185":415,"_28073":400,"_19451":46856,"_5":13353,"_26530":400,"_2682":46857},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3185":416,"_28073":400,"_19451":46859,"_5":13353,"_26530":46809,"_2682":46860},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3185":417,"_28073":400,"_19451":46862,"_5":13353,"_26530":46813,"_2682":46863},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3185":418,"_28073":400,"_19451":46865,"_5":13353,"_26530":46817,"_2682":46866},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3185":419,"_28073":400,"_19451":46868,"_5":13353,"_26530":46821,"_2682":46869},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3185":420,"_28073":400,"_19451":46871,"_5":13353,"_26530":46825,"_2682":46872},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3185":421,"_28073":400,"_19451":46874,"_5":13353,"_26530":46829,"_2682":46875},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3185":422,"_28073":400,"_19451":46877,"_5":13353,"_26530":46829,"_2682":46878},[],"Also run the chart's connectivity test:",{"_3185":423,"_28073":400,"_19451":46880,"_5":13353,"_26530":46829,"_2682":46881},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3185":424,"_28073":400,"_19451":46883,"_5":13353,"_26530":46829,"_2682":46884},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3185":425,"_28073":400,"_19451":46886,"_5":13353,"_26530":46833,"_2682":46887},[],"If you receive a 401:",{"_3185":426,"_28073":400,"_19451":46889,"_5":13353,"_26530":46833,"_2682":46890},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3185":427,"_28073":400,"_19451":46892,"_5":13353,"_26530":46833,"_2682":46893},[],"verify issuer, audience and expiration of the token;",{"_3185":428,"_28073":400,"_19451":46895,"_5":13353,"_26530":46833,"_2682":46896},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3185":429,"_28073":400,"_19451":46898,"_5":13353,"_26530":46833,"_2682":46899},[],"check that the provider's public and internal routes point to the same realm.",{"_3185":430,"_28073":400,"_19451":46901,"_5":13353,"_26530":46833,"_2682":46902},[],"If login succeeds but the APIs return 403:",{"_3185":431,"_28073":400,"_19451":46904,"_5":13353,"_26530":46833,"_2682":46905},[],"inspect the token's real claims;",{"_3185":432,"_28073":400,"_19451":46907,"_5":13353,"_26530":46833,"_2682":46908},[],"confirm they match an active principal;",{"_3185":433,"_28073":400,"_19451":46910,"_5":13353,"_26530":46833,"_2682":46911},[],"review the policies granted to that principal;",{"_3185":434,"_28073":400,"_19451":46913,"_5":13353,"_26530":46833,"_2682":46914},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3185":435,"_28073":400,"_19451":46916,"_5":13353,"_26530":46833,"_2682":46917},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3185":436,"_28073":400,"_19451":46919,"_5":13353,"_26530":46837,"_2682":46920},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3185":437,"_28073":400,"_19451":46922,"_5":13353,"_26530":46837,"_2682":46923},[],"Locate the authz pod and Service.",{"_3185":438,"_28073":400,"_19451":46925,"_5":13353,"_26530":46837,"_2682":46926},[],"Check /health, logs and its database connection.",{"_3185":439,"_28073":400,"_19451":46928,"_5":13353,"_26530":46837,"_2682":46929},[],"Verify the DNS and port configured in externalAuthorization.",{"_3185":440,"_28073":400,"_19451":46931,"_5":13353,"_26530":46837,"_2682":46932},[],"Check the check route is /v1/ext\\_authz/check.",{"_3185":441,"_28073":400,"_19451":46934,"_5":13353,"_26530":46837,"_2682":46935},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3185":442,"_28073":400,"_19451":46937,"_5":13353,"_26530":46841,"_2682":46938},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and review the body before forwarding it to third parties. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3185":443,"_28073":400,"_19451":46940,"_5":13353,"_26530":46845,"_2682":46941},[],"Review kubectl describe pod first. Common causes are:",{"_3185":444,"_28073":400,"_19451":46943,"_5":13353,"_26530":46845,"_2682":46944},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3185":445,"_28073":400,"_19451":46946,"_5":13353,"_26530":46845,"_2682":46947},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3185":446,"_28073":400,"_19451":46949,"_5":13353,"_26530":46845,"_2682":46950},[],"unbound persistent volume;",{"_3185":447,"_28073":400,"_19451":46952,"_5":13353,"_26530":46845,"_2682":46953},[],"inaccessible image or incorrect pull policy;",{"_3185":448,"_28073":400,"_19451":46955,"_5":13353,"_26530":46845,"_2682":46956},[],"invalid cryptographic engine configuration;",{"_3185":449,"_28073":400,"_19451":46958,"_5":13353,"_26530":46845,"_2682":46959},[],"CPU or memory limits set too low;",{"_3185":450,"_28073":400,"_19451":46961,"_5":13353,"_26530":46845,"_2682":46962},[],"an incomplete prior migration.",{"_3185":451,"_28073":400,"_19451":46964,"_5":13353,"_26530":46845,"_2682":46965},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3185":452,"_28073":400,"_19451":46967,"_5":13353,"_26530":46845,"_2682":46968},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3185":453,"_28073":400,"_19451":46970,"_5":13353,"_26530":46849,"_2682":46971},[],"Domain and audit events depend on the bus publisher:",{"_3185":454,"_28073":400,"_19451":46973,"_5":13353,"_26530":46849,"_2682":46974},[],"verify it is enabled in the emitting service;",{"_3185":455,"_28073":400,"_19451":46976,"_5":13353,"_26530":46849,"_2682":46977},[],"check AMQP connectivity and credentials;",{"_3185":456,"_28073":400,"_19451":46979,"_5":13353,"_26530":46849,"_2682":46980},[],"review exchange, routing key, queues and consumers;",{"_3185":457,"_28073":400,"_19451":46982,"_5":13353,"_26530":46849,"_2682":46983},[],"inspect dead-letter queues;",{"_3185":458,"_28073":400,"_19451":46985,"_5":13353,"_26530":46849,"_2682":46986},[],"alert on orphan durable queues and backlog growth.",{"_3185":459,"_28073":400,"_19451":46988,"_5":13353,"_26530":46849,"_2682":46989},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3185":460,"_28073":400,"_19451":46991,"_5":13353,"_26530":46849,"_2682":46992},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3185":461,"_28073":400,"_19451":46994,"_5":13353,"_26530":46849,"_2682":46995},[],"confirm the CA Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey`;",{"_3185":462,"_28073":400,"_19451":46997,"_5":13353,"_26530":46849,"_2682":46998},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3185":463,"_28073":400,"_19451":47000,"_5":13353,"_26530":46849,"_2682":47001},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3185":464,"_28073":400,"_19451":47003,"_5":13353,"_26530":46849,"_2682":47004},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3185":465,"_28073":400,"_19451":47006,"_5":13353,"_26530":46849,"_2682":47007},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3185":466,"_28073":400,"_19451":47009,"_5":13353,"_26530":46853,"_2682":47010},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3185":467,"_28073":400,"_19451":47012,"_5":13353,"_26530":46853,"_2682":47013},[],"Before closing an incident, record:",{"_3185":468,"_28073":400,"_19451":47015,"_5":13353,"_26530":46853,"_2682":47016},[],"the confirmed cause;",{"_3185":469,"_28073":400,"_19451":47018,"_5":13353,"_26530":46853,"_2682":47019},[],"the time scope and affected resources;",{"_3185":470,"_28073":400,"_19451":47021,"_5":13353,"_26530":46853,"_2682":47022},[],"the commands or queries used;",{"_3185":471,"_28073":400,"_19451":47024,"_5":13353,"_26530":46853,"_2682":47025},[],"the applied change and how to revert it;",{"_3185":472,"_28073":400,"_19451":47027,"_5":13353,"_26530":46853,"_2682":47028},[],"validation from a consumer;",{"_3185":473,"_28073":400,"_19451":47030,"_5":13353,"_26530":46853,"_2682":47031},[],"the preventive action and its owner.",{"_3185":474,"_28073":474,"_5":13700,"_2682":47033,"_28416":47034,"_19451":47037,"_26530":474},"Access control",[45599,47035,47036],"Platform","Administration",[],{"_3185":475,"_28073":474,"_19451":47039,"_5":13353,"_26530":474,"_2682":47040},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3185":476,"_28073":474,"_5":28413,"_19451":47042,"_26530":47043,"_2682":47044},[],"/docs/pr-preview/pr-42/platform/administration/access-control#essential-concepts","Essential concepts",{"_3185":477,"_28073":474,"_5":28413,"_19451":47046,"_26530":47047,"_2682":47048},[],"/docs/pr-preview/pr-42/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3185":478,"_28073":474,"_5":28413,"_19451":47050,"_26530":47051,"_2682":47052},[],"/docs/pr-preview/pr-42/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3185":479,"_28073":474,"_5":28413,"_19451":47054,"_26530":47055,"_2682":47056},[],"/docs/pr-preview/pr-42/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3185":480,"_28073":474,"_5":28413,"_19451":47058,"_26530":47059,"_2682":47060},[],"/docs/pr-preview/pr-42/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3185":481,"_28073":474,"_5":28413,"_19451":47062,"_26530":47063,"_2682":47064},[],"/docs/pr-preview/pr-42/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3185":482,"_28073":474,"_5":28413,"_19451":47066,"_26530":47067,"_2682":47068},[],"/docs/pr-preview/pr-42/platform/administration/access-control#oidc-principals","OIDC principals",{"_3185":483,"_28073":474,"_5":28413,"_19451":47070,"_26530":47071,"_2682":47072},[],"/docs/pr-preview/pr-42/platform/administration/access-control#x509-principals","X.509 principals",{"_3185":484,"_28073":474,"_5":28413,"_19451":47074,"_26530":47075,"_2682":47076},[],"/docs/pr-preview/pr-42/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3185":485,"_28073":474,"_5":28413,"_19451":47078,"_26530":47079,"_2682":47080},[],"/docs/pr-preview/pr-42/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3185":486,"_28073":474,"_5":28413,"_19451":47082,"_26530":47083,"_2682":47084},[],"/docs/pr-preview/pr-42/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3185":487,"_28073":474,"_5":28413,"_19451":47086,"_26530":47087,"_2682":47088},[],"/docs/pr-preview/pr-42/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3185":488,"_28073":474,"_5":28413,"_19451":47090,"_26530":47091,"_2682":47092},[],"/docs/pr-preview/pr-42/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3185":489,"_28073":474,"_5":28413,"_19451":47094,"_26530":47095,"_2682":47096},[],"/docs/pr-preview/pr-42/platform/administration/access-control#http-rules","HTTP rules",{"_3185":490,"_28073":474,"_5":28413,"_19451":47098,"_26530":47099,"_2682":47100},[],"/docs/pr-preview/pr-42/platform/administration/access-control#included-policies","Included policies",{"_3185":491,"_28073":474,"_5":28413,"_19451":47102,"_26530":47103,"_2682":46239},[],"/docs/pr-preview/pr-42/platform/administration/access-control#provision-the-first-administrator",{"_3185":492,"_28073":474,"_5":28413,"_19451":47105,"_26530":47106,"_2682":47107},[],"/docs/pr-preview/pr-42/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3185":493,"_28073":474,"_5":28413,"_19451":47109,"_26530":47110,"_2682":47111},[],"/docs/pr-preview/pr-42/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3185":494,"_28073":474,"_5":28413,"_19451":47113,"_26530":47114,"_2682":47115},[],"/docs/pr-preview/pr-42/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3185":495,"_28073":474,"_5":28413,"_19451":47117,"_26530":47118,"_2682":47119},[],"/docs/pr-preview/pr-42/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3185":496,"_28073":474,"_5":28413,"_19451":47121,"_26530":47122,"_2682":47123},[],"/docs/pr-preview/pr-42/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3185":497,"_28073":474,"_5":28413,"_19451":47125,"_26530":47126,"_2682":47127},[],"/docs/pr-preview/pr-42/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3185":498,"_28073":474,"_5":28413,"_19451":47129,"_26530":47130,"_2682":47131},[],"/docs/pr-preview/pr-42/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3185":499,"_28073":474,"_5":28413,"_19451":47133,"_26530":47134,"_2682":47135},[],"/docs/pr-preview/pr-42/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3185":500,"_28073":474,"_5":28413,"_19451":47137,"_26530":47138,"_2682":47139},[],"/docs/pr-preview/pr-42/platform/administration/access-control#operational-checklist","Operational checklist",{"_3185":501,"_28073":474,"_5":28413,"_19451":47141,"_26530":47142,"_2682":47143},[],"/docs/pr-preview/pr-42/platform/administration/access-control#diagnostics","Diagnostics",{"_3185":502,"_28073":474,"_5":28413,"_19451":47145,"_26530":47146,"_2682":47147},[],"/docs/pr-preview/pr-42/platform/administration/access-control#the-response-is-401","The response is 401",{"_3185":503,"_28073":474,"_5":28413,"_19451":47149,"_26530":47150,"_2682":47151},[],"/docs/pr-preview/pr-42/platform/administration/access-control#the-response-is-403","The response is 403",{"_3185":504,"_28073":474,"_5":28413,"_19451":47153,"_26530":47154,"_2682":47155},[],"/docs/pr-preview/pr-42/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3185":505,"_28073":474,"_5":28413,"_19451":47157,"_26530":47158,"_2682":47159},[],"/docs/pr-preview/pr-42/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3185":506,"_28073":474,"_5":28413,"_19451":47161,"_26530":47162,"_2682":47163},[],"/docs/pr-preview/pr-42/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3185":507,"_28073":474,"_19451":47165,"_5":13353,"_26530":474,"_2682":47166},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3185":508,"_28073":474,"_19451":47168,"_5":13353,"_26530":474,"_2682":47169},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3185":509,"_28073":474,"_19451":47171,"_5":13353,"_26530":474,"_2682":47172},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3185":510,"_28073":474,"_19451":47174,"_5":13353,"_26530":47043,"_2682":47175},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3185":511,"_28073":474,"_19451":47177,"_5":13353,"_26530":47043,"_2682":47178},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3185":512,"_28073":474,"_19451":47180,"_5":13353,"_26530":47043,"_2682":47181},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3185":513,"_28073":474,"_19451":47183,"_5":13353,"_26530":47043,"_2682":47184},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3185":514,"_28073":474,"_19451":47186,"_5":13353,"_26530":47043,"_2682":47187},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3185":515,"_28073":474,"_19451":47189,"_5":13353,"_26530":47043,"_2682":47190},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3185":516,"_28073":474,"_19451":47192,"_5":13353,"_26530":47047,"_2682":47193},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3185":517,"_28073":474,"_19451":47195,"_5":13353,"_26530":47047,"_2682":47196},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3185":518,"_28073":474,"_19451":47198,"_5":13353,"_26530":47051,"_2682":47199},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3185":519,"_28073":474,"_19451":47201,"_5":13353,"_26530":47051,"_2682":47202},[],"The decision is made **before forwarding the request to the service**:",{"_3185":520,"_28073":474,"_19451":47204,"_5":13353,"_26530":47051,"_2682":47205},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3185":521,"_28073":474,"_19451":47207,"_5":13353,"_26530":47051,"_2682":47208},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3185":522,"_28073":474,"_19451":47210,"_5":13353,"_26530":47051,"_2682":47211},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3185":523,"_28073":474,"_19451":47213,"_5":13353,"_26530":47051,"_2682":47214},[],"It separately loads the policies granted to each principal.",{"_3185":524,"_28073":474,"_19451":47216,"_5":13353,"_26530":47051,"_2682":47217},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3185":525,"_28073":474,"_19451":47219,"_5":13353,"_26530":47051,"_2682":47220},[],"`authz` looks for an HTTP rule granting that action.",{"_3185":526,"_28073":474,"_19451":47222,"_5":13353,"_26530":47051,"_2682":47223},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3185":527,"_28073":474,"_19451":47225,"_5":13353,"_26530":47051,"_2682":47226},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3185":528,"_28073":474,"_19451":47228,"_5":13353,"_26530":47051,"_2682":47229},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3185":529,"_28073":474,"_19451":47231,"_5":13353,"_26530":47051,"_2682":47232},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3185":530,"_28073":474,"_19451":47234,"_5":13353,"_26530":47055,"_2682":47235},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3185":531,"_28073":474,"_19451":47237,"_5":13353,"_26530":47055,"_2682":47238},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3185":532,"_28073":474,"_19451":47240,"_5":13353,"_26530":47055,"_2682":47241},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3185":533,"_28073":474,"_19451":47243,"_5":13353,"_26530":47055,"_2682":47244},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3185":534,"_28073":474,"_19451":47246,"_5":13353,"_26530":47055,"_2682":47247},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3185":535,"_28073":474,"_19451":47249,"_5":13353,"_26530":47055,"_2682":47250},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3185":536,"_28073":474,"_19451":47252,"_5":13353,"_26530":47055,"_2682":47253},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3185":537,"_28073":474,"_19451":47255,"_5":13353,"_26530":47055,"_2682":47256},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3185":538,"_28073":474,"_19451":47258,"_5":13353,"_26530":47059,"_2682":47259},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3185":539,"_28073":474,"_19451":47261,"_5":13353,"_26530":47059,"_2682":47262},[],"The decision is made with the domain operation context:",{"_3185":540,"_28073":474,"_19451":47264,"_5":13353,"_26530":47059,"_2682":47265},[],"The middleware extracts the credential and resolves the matching principals.",{"_3185":541,"_28073":474,"_19451":47267,"_5":13353,"_26530":47059,"_2682":47268},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3185":542,"_28073":474,"_19451":47270,"_5":13353,"_26530":47059,"_2682":47271},[],"`authz` gathers the entity rules of the granted policies.",{"_3185":543,"_28073":474,"_19451":47273,"_5":13353,"_26530":47059,"_2682":47274},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3185":544,"_28073":474,"_19451":47276,"_5":13353,"_26530":47059,"_2682":47277},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3185":545,"_28073":474,"_19451":47279,"_5":13353,"_26530":47059,"_2682":47280},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3185":546,"_28073":474,"_19451":47282,"_5":13353,"_26530":47059,"_2682":47283},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3185":547,"_28073":474,"_19451":47285,"_5":13353,"_26530":47059,"_2682":47286},[],"Actions fall into two groups:",{"_3185":548,"_28073":474,"_19451":47288,"_5":13353,"_26530":47059,"_2682":47289},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3185":549,"_28073":474,"_19451":47291,"_5":13353,"_26530":47059,"_2682":47292},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3185":550,"_28073":474,"_19451":47294,"_5":13353,"_26530":47059,"_2682":47295},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3185":551,"_28073":474,"_19451":47297,"_5":13353,"_26530":47063,"_2682":47298},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3185":552,"_28073":474,"_19451":47300,"_5":13353,"_26530":47063,"_2682":47301},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3185":553,"_28073":474,"_19451":47303,"_5":13353,"_26530":47063,"_2682":47304},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3185":554,"_28073":474,"_19451":47306,"_5":13353,"_26530":47067,"_2682":47307},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3185":555,"_28073":474,"_19451":47309,"_5":13353,"_26530":47067,"_2682":47310},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3185":556,"_28073":474,"_19451":47312,"_5":13353,"_26530":47067,"_2682":47313},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3185":557,"_28073":474,"_19451":47315,"_5":13353,"_26530":47067,"_2682":47316},[],"The implemented operators are:",{"_3185":558,"_28073":474,"_19451":47318,"_5":13353,"_26530":47067,"_2682":47319},[],"`equals`, for exact equality;",{"_3185":559,"_28073":474,"_19451":47321,"_5":13353,"_26530":47067,"_2682":47322},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3185":560,"_28073":474,"_19451":47324,"_5":13353,"_26530":47067,"_2682":47325},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3185":561,"_28073":474,"_19451":47327,"_5":13353,"_26530":47067,"_2682":47328},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3185":562,"_28073":474,"_19451":47330,"_5":13353,"_26530":47071,"_2682":47331},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3185":563,"_28073":474,"_19451":47333,"_5":13353,"_26530":47071,"_2682":47334},[],"The available modes are:",{"_3185":564,"_28073":474,"_19451":47336,"_5":13353,"_26530":47071,"_2682":47337},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3185":565,"_28073":474,"_19451":47339,"_5":13353,"_26530":47071,"_2682":47340},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3185":566,"_28073":474,"_19451":47342,"_5":13353,"_26530":47071,"_2682":47343},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3185":567,"_28073":474,"_19451":47345,"_5":13353,"_26530":47071,"_2682":47346},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3185":568,"_28073":474,"_19451":47348,"_5":13353,"_26530":47071,"_2682":47349},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3185":569,"_28073":474,"_19451":47351,"_5":13353,"_26530":47071,"_2682":47352},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3185":570,"_28073":474,"_19451":47354,"_5":13353,"_26530":47075,"_2682":47355},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3185":571,"_28073":474,"_19451":47357,"_5":13353,"_26530":47075,"_2682":47358},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3185":572,"_28073":474,"_19451":47360,"_5":13353,"_26530":47075,"_2682":47361},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3185":573,"_28073":474,"_19451":47363,"_5":13353,"_26530":47075,"_2682":47364},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3185":574,"_28073":474,"_19451":47366,"_5":13353,"_26530":47083,"_2682":47367},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3185":575,"_28073":474,"_19451":47369,"_5":13353,"_26530":47083,"_2682":47370},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3185":576,"_28073":474,"_19451":47372,"_5":13353,"_26530":47087,"_2682":47373},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3185":577,"_28073":474,"_19451":47375,"_5":13353,"_26530":47087,"_2682":47376},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3185":578,"_28073":474,"_19451":47378,"_5":13353,"_26530":47091,"_2682":47379},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3185":579,"_28073":474,"_19451":47381,"_5":13353,"_26530":47091,"_2682":47382},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3185":580,"_28073":474,"_19451":47384,"_5":13353,"_26530":47091,"_2682":47385},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3185":581,"_28073":474,"_19451":47387,"_5":13353,"_26530":47095,"_2682":47388},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3185":582,"_28073":474,"_19451":47390,"_5":13353,"_26530":47095,"_2682":47391},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3185":583,"_28073":474,"_19451":47393,"_5":13353,"_26530":47095,"_2682":47394},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3185":584,"_28073":474,"_19451":47396,"_5":13353,"_26530":47095,"_2682":47397},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3185":585,"_28073":474,"_19451":47399,"_5":13353,"_26530":47095,"_2682":47400},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3185":586,"_28073":474,"_19451":47402,"_5":13353,"_26530":47095,"_2682":47403},[],"Note that:",{"_3185":587,"_28073":474,"_19451":47405,"_5":13353,"_26530":47095,"_2682":47406},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3185":588,"_28073":474,"_19451":47408,"_5":13353,"_26530":47095,"_2682":47409},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3185":589,"_28073":474,"_19451":47411,"_5":13353,"_26530":47095,"_2682":47412},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3185":590,"_28073":474,"_19451":47414,"_5":13353,"_26530":47099,"_2682":47415},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3185":591,"_28073":474,"_19451":47417,"_5":13353,"_26530":47099,"_2682":47418},[],"full and read-only access to certificates and authorities;",{"_3185":592,"_28073":474,"_19451":47420,"_5":13353,"_26530":47099,"_2682":47421},[],"full and read-only access to the KMS;",{"_3185":593,"_28073":474,"_19451":47423,"_5":13353,"_26530":47099,"_2682":47424},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3185":594,"_28073":474,"_19451":47426,"_5":13353,"_26530":47099,"_2682":47427},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3185":595,"_28073":474,"_19451":47429,"_5":13353,"_26530":47099,"_2682":47430},[],"console access;",{"_3185":596,"_28073":474,"_19451":47432,"_5":13353,"_26530":47099,"_2682":47433},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3185":597,"_28073":474,"_19451":47435,"_5":13353,"_26530":47099,"_2682":47436},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3185":598,"_28073":474,"_19451":47438,"_5":13353,"_26530":47099,"_2682":47439},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3185":599,"_28073":474,"_19451":47441,"_5":13353,"_26530":47103,"_2682":47442},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3185":600,"_28073":474,"_19451":47444,"_5":13353,"_26530":47103,"_2682":47445},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3185":601,"_28073":474,"_19451":47447,"_5":13353,"_26530":47103,"_2682":47448},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3185":602,"_28073":474,"_19451":47450,"_5":13353,"_26530":47106,"_2682":47451},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3185":603,"_28073":474,"_19451":47453,"_5":13353,"_26530":47110,"_2682":47454},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3185":604,"_28073":474,"_19451":47456,"_5":13353,"_26530":47110,"_2682":47457},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3185":605,"_28073":474,"_19451":47459,"_5":13353,"_26530":47114,"_2682":47460},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3185":606,"_28073":474,"_19451":47462,"_5":13353,"_26530":47118,"_2682":47463},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3185":607,"_28073":474,"_19451":47465,"_5":13353,"_26530":47122,"_2682":47466},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3185":608,"_28073":474,"_19451":47468,"_5":13353,"_26530":47126,"_2682":47469},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3185":609,"_28073":474,"_19451":47471,"_5":13353,"_26530":47126,"_2682":47472},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3185":610,"_28073":474,"_19451":47474,"_5":13353,"_26530":47130,"_2682":47475},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3185":611,"_28073":474,"_19451":47477,"_5":13353,"_26530":47130,"_2682":47478},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3185":612,"_28073":474,"_19451":47480,"_5":13353,"_26530":47130,"_2682":47481},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3185":613,"_28073":474,"_19451":47483,"_5":13353,"_26530":47130,"_2682":47484},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3185":614,"_28073":474,"_19451":47486,"_5":13353,"_26530":47130,"_2682":47487},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3185":615,"_28073":474,"_19451":47489,"_5":13353,"_26530":47130,"_2682":47490},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3185":616,"_28073":474,"_19451":47492,"_5":13353,"_26530":47130,"_2682":47493},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3185":617,"_28073":474,"_19451":47495,"_5":13353,"_26530":47130,"_2682":47496},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3185":618,"_28073":474,"_19451":47498,"_5":13353,"_26530":47134,"_2682":47499},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3185":619,"_28073":474,"_19451":47501,"_5":13353,"_26530":47134,"_2682":47502},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3185":620,"_28073":474,"_19451":47504,"_5":13353,"_26530":47134,"_2682":47505},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3185":621,"_28073":474,"_19451":47507,"_5":13353,"_26530":47138,"_2682":47508},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3185":622,"_28073":474,"_19451":47510,"_5":13353,"_26530":47138,"_2682":47511},[],"Use groups or stable roles for people and independent identities for automations.",{"_3185":623,"_28073":474,"_19451":47513,"_5":13353,"_26530":47138,"_2682":47514},[],"Keep at least two recovery administrators and test their access periodically.",{"_3185":624,"_28073":474,"_19451":47516,"_5":13353,"_26530":47138,"_2682":47517},[],"Review active principals, their matches and their grants after IdP changes.",{"_3185":625,"_28073":474,"_19451":47519,"_5":13353,"_26530":47138,"_2682":47520},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3185":626,"_28073":474,"_19451":47522,"_5":13353,"_26530":47138,"_2682":47523},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3185":627,"_28073":474,"_19451":47525,"_5":13353,"_26530":47138,"_2682":47526},[],"Always test one allowed and one denied operation for each role.",{"_3185":628,"_28073":474,"_19451":47528,"_5":13353,"_26530":47138,"_2682":47529},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3185":629,"_28073":474,"_19451":47531,"_5":13353,"_26530":47146,"_2682":47532},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3185":630,"_28073":474,"_19451":47534,"_5":13353,"_26530":47150,"_2682":47535},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3185":631,"_28073":474,"_19451":47537,"_5":13353,"_26530":47150,"_2682":47538},[],"that an active principal of the correct type exists;",{"_3185":632,"_28073":474,"_19451":47540,"_5":13353,"_26530":47150,"_2682":47541},[],"that the claim paths and values match the real token exactly;",{"_3185":633,"_28073":474,"_19451":47543,"_5":13353,"_26530":47150,"_2682":47544},[],"that all of the principal's conditions hold;",{"_3185":634,"_28073":474,"_19451":47546,"_5":13353,"_26530":47150,"_2682":47547},[],"that the principal has the expected policy granted;",{"_3185":635,"_28073":474,"_19451":47549,"_5":13353,"_26530":47150,"_2682":47550},[],"that the policy includes the action and the requested resource type or route;",{"_3185":636,"_28073":474,"_19451":47552,"_5":13353,"_26530":47150,"_2682":47553},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3185":637,"_28073":474,"_19451":47555,"_5":13353,"_26530":47150,"_2682":47556},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3185":638,"_28073":474,"_19451":47558,"_5":13353,"_26530":47154,"_2682":47559},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3185":639,"_28073":474,"_19451":47561,"_5":13353,"_26530":47158,"_2682":47562},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3185":640,"_28073":474,"_19451":47564,"_5":13353,"_26530":47162,"_2682":47565},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3185":641,"_28073":474,"_19451":47567,"_5":13353,"_26530":47162,"_2682":47568},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3185":642,"_28073":642,"_5":13700,"_2682":47570,"_28416":47571,"_19451":47572,"_26530":642},"Alerts and subscriptions",[45599,47035,47036],[],{"_3185":643,"_28073":642,"_19451":47574,"_5":13353,"_26530":642,"_2682":47575},[],"Send PKI events to people and external systems.",{"_3185":644,"_28073":642,"_5":28413,"_19451":47577,"_26530":47578,"_2682":47579},[],"/docs/pr-preview/pr-42/platform/administration/alerts#how-it-works","How it works",{"_3185":645,"_28073":642,"_5":28413,"_19451":47581,"_26530":47582,"_2682":47583},[],"/docs/pr-preview/pr-42/platform/administration/alerts#available-channels","Available channels",{"_3185":646,"_28073":642,"_5":28413,"_19451":47585,"_26530":47586,"_2682":47587},[],"/docs/pr-preview/pr-42/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3185":647,"_28073":642,"_5":28413,"_19451":47589,"_26530":47590,"_2682":47591},[],"/docs/pr-preview/pr-42/platform/administration/alerts#choose-the-event","Choose the event",{"_3185":648,"_28073":642,"_5":28413,"_19451":47593,"_26530":47594,"_2682":47595},[],"/docs/pr-preview/pr-42/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3185":649,"_28073":642,"_5":28413,"_19451":47597,"_26530":47598,"_2682":47599},[],"/docs/pr-preview/pr-42/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3185":650,"_28073":642,"_5":28413,"_19451":47601,"_26530":47602,"_2682":47603},[],"/docs/pr-preview/pr-42/platform/administration/alerts#review-and-activate","Review and activate",{"_3185":651,"_28073":642,"_5":28413,"_19451":47605,"_26530":47606,"_2682":47607},[],"/docs/pr-preview/pr-42/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3185":652,"_28073":642,"_5":28413,"_19451":47609,"_26530":47610,"_2682":47611},[],"/docs/pr-preview/pr-42/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3185":653,"_28073":642,"_5":28413,"_19451":47613,"_26530":47614,"_2682":47615},[],"/docs/pr-preview/pr-42/platform/administration/alerts#event-families","Event families",{"_3185":654,"_28073":642,"_19451":47617,"_5":13353,"_26530":642,"_2682":47618},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3185":655,"_28073":642,"_19451":47620,"_5":13353,"_26530":47578,"_2682":47621},[],"A service publishes a domain event.",{"_3185":656,"_28073":642,"_19451":47623,"_5":13353,"_26530":47578,"_2682":47624},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3185":657,"_28073":642,"_19451":47626,"_5":13353,"_26530":47578,"_2682":47627},[],"Each subscription's filter decides whether it should be notified.",{"_3185":658,"_28073":642,"_19451":47629,"_5":13353,"_26530":47578,"_2682":47630},[],"Lamassu delivers the event to the configured channel.",{"_3185":659,"_28073":642,"_19451":47632,"_5":13353,"_26530":47578,"_2682":47633},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3185":660,"_28073":642,"_19451":47635,"_5":13353,"_26530":47582,"_2682":47636},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3185":661,"_28073":642,"_19451":47638,"_5":13353,"_26530":47582,"_2682":47639},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3185":662,"_28073":642,"_19451":47641,"_5":13353,"_26530":47582,"_2682":47642},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3185":663,"_28073":642,"_19451":47644,"_5":13353,"_26530":47582,"_2682":47645},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3185":664,"_28073":642,"_19451":47647,"_5":13353,"_26530":47582,"_2682":47648},[],"`apikey_options` requires `header` and `key`.",{"_3185":665,"_28073":642,"_19451":47650,"_5":13353,"_26530":47582,"_2682":47651},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3185":666,"_28073":642,"_19451":47653,"_5":13353,"_26530":47582,"_2682":47654},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3185":667,"_28073":642,"_19451":47656,"_5":13353,"_26530":47582,"_2682":47657},[],"The alerts API reference documents the full `http_client` schema.",{"_3185":668,"_28073":642,"_19451":47659,"_5":13353,"_26530":47590,"_2682":47660},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3185":669,"_28073":642,"_19451":47662,"_5":13353,"_26530":47594,"_2682":47663},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3185":670,"_28073":642,"_19451":47665,"_5":13353,"_26530":47598,"_2682":47666},[],"Add a filter if you don't want to receive every instance of the event.",{"_3185":671,"_28073":642,"_19451":47668,"_5":13353,"_26530":47598,"_2682":47669},[],"**None** notifies all instances of the event.",{"_3185":672,"_28073":642,"_19451":47671,"_5":13353,"_26530":47598,"_2682":47672},[],"**JSON Path** evaluates one or more specific fields.",{"_3185":673,"_28073":642,"_19451":47674,"_5":13353,"_26530":47598,"_2682":47675},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3185":674,"_28073":642,"_19451":47677,"_5":13353,"_26530":47598,"_2682":47678},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3185":675,"_28073":642,"_19451":47680,"_5":13353,"_26530":47598,"_2682":47681},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3185":676,"_28073":642,"_19451":47683,"_5":13353,"_26530":47602,"_2682":47684},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3185":677,"_28073":642,"_19451":47686,"_5":13353,"_26530":47606,"_2682":47687},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3185":678,"_28073":642,"_19451":47689,"_5":13353,"_26530":47606,"_2682":47690},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3185":679,"_28073":642,"_19451":47692,"_5":13353,"_26530":47606,"_2682":47693},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3185":680,"_28073":642,"_19451":47695,"_5":13353,"_26530":47606,"_2682":47696},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3185":681,"_28073":642,"_19451":47698,"_5":13353,"_26530":47606,"_2682":47699},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3185":682,"_28073":642,"_19451":47701,"_5":13353,"_26530":47606,"_2682":47702},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3185":683,"_28073":642,"_19451":47704,"_5":13353,"_26530":47606,"_2682":47705},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3185":684,"_28073":642,"_19451":47707,"_5":13353,"_26530":47606,"_2682":47708},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3185":685,"_28073":642,"_19451":47710,"_5":13353,"_26530":47610,"_2682":47711},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3185":686,"_28073":642,"_19451":47713,"_5":13353,"_26530":47614,"_2682":47714},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3185":687,"_28073":642,"_19451":47716,"_5":13353,"_26530":47614,"_2682":47717},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3185":688,"_28073":642,"_19451":47719,"_5":13353,"_26530":47614,"_2682":47720},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3185":689,"_28073":642,"_19451":47722,"_5":13353,"_26530":47614,"_2682":47723},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3185":690,"_28073":642,"_19451":47725,"_5":13353,"_26530":47614,"_2682":47726},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3185":691,"_28073":642,"_19451":47728,"_5":13353,"_26530":47614,"_2682":47729},[],"**Validation:** `va.role.crl.create`.",{"_3185":692,"_28073":642,"_19451":47731,"_5":13353,"_26530":47614,"_2682":47732},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3185":693,"_28073":642,"_19451":47734,"_5":13353,"_26530":47614,"_2682":47735},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3185":694,"_28073":694,"_5":13700,"_2682":47737,"_28416":47738,"_19451":47739,"_26530":694},"Audit logs",[45599,47035,47036],[],{"_3185":695,"_28073":694,"_19451":47741,"_5":13353,"_26530":694,"_2682":47742},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3185":696,"_28073":694,"_5":28413,"_19451":47744,"_26530":47745,"_2682":47746},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3185":697,"_28073":694,"_5":28413,"_19451":47748,"_26530":47749,"_2682":47750},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#coverage","Coverage",{"_3185":698,"_28073":694,"_5":28413,"_19451":47752,"_26530":47753,"_2682":47754},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3185":699,"_28073":694,"_5":28413,"_19451":47756,"_26530":47757,"_2682":47758},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3185":700,"_28073":694,"_5":28413,"_19451":47760,"_26530":47761,"_2682":47762},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3185":701,"_28073":694,"_5":28413,"_19451":47764,"_26530":47765,"_2682":47766},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3185":702,"_28073":694,"_5":28413,"_19451":47768,"_26530":47769,"_2682":47770},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3185":703,"_28073":694,"_5":28413,"_19451":47772,"_26530":47773,"_2682":47774},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3185":704,"_28073":694,"_5":28413,"_19451":47776,"_26530":47777,"_2682":47778},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3185":705,"_28073":694,"_5":28413,"_19451":47780,"_26530":47781,"_2682":47782},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3185":706,"_28073":694,"_5":28413,"_19451":47784,"_26530":47785,"_2682":47786},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3185":707,"_28073":694,"_19451":47788,"_5":13353,"_26530":694,"_2682":47789},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3185":708,"_28073":694,"_19451":47791,"_5":13353,"_26530":47745,"_2682":47792},[],"The audit body includes:",{"_3185":709,"_28073":694,"_19451":47794,"_5":13353,"_26530":47745,"_2682":47795},[],"input: data received by the operation;",{"_3185":710,"_28073":694,"_19451":47797,"_5":13353,"_26530":47745,"_2682":47798},[],"has\\_error: whether the service returned an error;",{"_3185":711,"_28073":694,"_19451":47800,"_5":13353,"_26530":47745,"_2682":47801},[],"output: produced result or error message;",{"_3185":712,"_28073":694,"_19451":47803,"_5":13353,"_26530":47745,"_2682":47804},[],"principals: identifiers of the principals that matched the request.",{"_3185":713,"_28073":694,"_19451":47806,"_5":13353,"_26530":47745,"_2682":47807},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3185":714,"_28073":694,"_19451":47809,"_5":13353,"_26530":47745,"_2682":47810},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3185":715,"_28073":694,"_19451":47812,"_5":13353,"_26530":47749,"_2682":47813},[],"The backend applies auditing to mutations of:",{"_3185":716,"_28073":694,"_19451":47815,"_5":13353,"_26530":47749,"_2682":47816},[],"authorities, certificates and issuance profiles;",{"_3185":717,"_28073":694,"_19451":47818,"_5":13353,"_26530":47749,"_2682":47819},[],"keys and KMS engines;",{"_3185":718,"_28073":694,"_19451":47821,"_5":13353,"_26530":47749,"_2682":47822},[],"devices and identities;",{"_3185":719,"_28073":694,"_19451":47824,"_5":13353,"_26530":47749,"_2682":47825},[],"DMSs and enrollment operations;",{"_3185":720,"_28073":694,"_19451":47827,"_5":13353,"_26530":47749,"_2682":47828},[],"validation functions and CRL;",{"_3185":721,"_28073":694,"_19451":47830,"_5":13353,"_26530":47749,"_2682":47831},[],"principals, policies and authorization grants.",{"_3185":722,"_28073":694,"_19451":47833,"_5":13353,"_26530":47749,"_2682":47834},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3185":723,"_28073":694,"_19451":47836,"_5":13353,"_26530":47753,"_2682":47837},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3185":724,"_28073":694,"_19451":47839,"_5":13353,"_26530":47753,"_2682":47840},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3185":725,"_28073":694,"_19451":47842,"_5":13353,"_26530":47753,"_2682":47843},[],"Design the consumer to:",{"_3185":726,"_28073":694,"_19451":47845,"_5":13353,"_26530":47753,"_2682":47846},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3185":727,"_28073":694,"_19451":47848,"_5":13353,"_26530":47753,"_2682":47849},[],"keep the complete CloudEvent unmodified;",{"_3185":728,"_28073":694,"_19451":47851,"_5":13353,"_26530":47753,"_2682":47852},[],"record the ingestion time and detect duplicates by ID;",{"_3185":729,"_28073":694,"_19451":47854,"_5":13353,"_26530":47753,"_2682":47855},[],"encrypt in transit and at rest;",{"_3185":730,"_28073":694,"_19451":47857,"_5":13353,"_26530":47753,"_2682":47858},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3185":731,"_28073":694,"_19451":47860,"_5":13353,"_26530":47753,"_2682":47861},[],"apply an explicit retention and legal hold policy;",{"_3185":732,"_28073":694,"_19451":47863,"_5":13353,"_26530":47753,"_2682":47864},[],"alert if it stops consuming or the pending queue grows.",{"_3185":733,"_28073":694,"_19451":47866,"_5":13353,"_26530":47757,"_2682":47867},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3185":734,"_28073":694,"_19451":47869,"_5":13353,"_26530":47757,"_2682":47870},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3185":735,"_28073":694,"_19451":47872,"_5":13353,"_26530":47765,"_2682":47873},[],"Start from the reported time and normalize every source to UTC.",{"_3185":736,"_28073":694,"_19451":47875,"_5":13353,"_26530":47769,"_2682":47876},[],"Filter by event type, service source and resource identifier.",{"_3185":737,"_28073":694,"_19451":47878,"_5":13353,"_26530":47773,"_2682":47879},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3185":738,"_28073":694,"_19451":47881,"_5":13353,"_26530":47777,"_2682":47882},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3185":739,"_28073":694,"_19451":47884,"_5":13353,"_26530":47781,"_2682":47885},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3185":740,"_28073":694,"_19451":47887,"_5":13353,"_26530":47785,"_2682":47888},[],"Generate a controlled mutation in a test environment and check that:",{"_3185":741,"_28073":694,"_19451":47890,"_5":13353,"_26530":47785,"_2682":47891},[],"a successful audit event appears;",{"_3185":742,"_28073":694,"_19451":47893,"_5":13353,"_26530":47785,"_2682":47894},[],"the principal matches the identity used;",{"_3185":743,"_28073":694,"_19451":47896,"_5":13353,"_26530":47785,"_2682":47897},[],"the consumer persists it exactly once;",{"_3185":744,"_28073":694,"_19451":47899,"_5":13353,"_26530":47785,"_2682":47900},[],"it can be retrieved by resource, actor and period;",{"_3185":745,"_28073":694,"_19451":47902,"_5":13353,"_26530":47785,"_2682":47903},[],"a consumer outage raises an alert.",{"_3185":746,"_28073":694,"_19451":47905,"_5":13353,"_26530":47785,"_2682":47906},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3185":747,"_28073":747,"_5":13700,"_2682":47908,"_28416":47909,"_19451":47910,"_26530":747},"Platform architecture",[45599,47035],[],{"_3185":748,"_28073":747,"_19451":47912,"_5":13353,"_26530":747,"_2682":47913},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3185":749,"_28073":747,"_5":28413,"_19451":47915,"_26530":47916,"_2682":47917},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#control-plane","Control plane",{"_3185":750,"_28073":747,"_5":28413,"_19451":47919,"_26530":47920,"_2682":47921},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3185":751,"_28073":747,"_5":28413,"_19451":47923,"_26530":47924,"_2682":47925},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3185":752,"_28073":747,"_5":28413,"_19451":47927,"_26530":47928,"_2682":47929},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#status-and-validation","Status and validation",{"_3185":753,"_28073":747,"_5":28413,"_19451":47931,"_26530":47932,"_2682":47933},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3185":754,"_28073":747,"_19451":47935,"_5":13353,"_26530":747,"_2682":47936},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3185":755,"_28073":747,"_19451":47938,"_5":13353,"_26530":747,"_2682":47939},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3185":756,"_28073":747,"_19451":47941,"_5":13353,"_26530":47916,"_2682":47942},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3185":757,"_28073":747,"_19451":47944,"_5":13353,"_26530":47920,"_2682":47945},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3185":758,"_28073":747,"_19451":47947,"_5":13353,"_26530":47924,"_2682":47948},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3185":759,"_28073":747,"_19451":47950,"_5":13353,"_26530":47928,"_2682":47951},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3185":760,"_28073":747,"_19451":47953,"_5":13353,"_26530":47932,"_2682":47954},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3185":761,"_28073":761,"_5":13700,"_2682":47956,"_28416":47957,"_19451":47958,"_26530":761},"How Lamassu works",[45599,47035],[],{"_3185":762,"_28073":761,"_19451":47960,"_5":13353,"_26530":761,"_2682":47961},[],"The mental model of trust, keys, certificates and devices.",{"_3185":763,"_28073":761,"_5":28413,"_19451":47963,"_26530":47964,"_2682":47965},[],"/docs/pr-preview/pr-42/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3185":764,"_28073":761,"_5":28413,"_19451":47967,"_26530":47968,"_2682":47969},[],"/docs/pr-preview/pr-42/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3185":765,"_28073":761,"_19451":47971,"_5":13353,"_26530":761,"_2682":47972},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3185":766,"_28073":761,"_19451":47974,"_5":13353,"_26530":47964,"_2682":47975},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3185":767,"_28073":761,"_19451":47977,"_5":13353,"_26530":47964,"_2682":47978},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3185":768,"_28073":761,"_19451":47980,"_5":13353,"_26530":47964,"_2682":47981},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3185":769,"_28073":761,"_19451":47983,"_5":13353,"_26530":47964,"_2682":47984},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3185":770,"_28073":761,"_19451":47986,"_5":13353,"_26530":47964,"_2682":47987},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3185":771,"_28073":761,"_19451":47989,"_5":13353,"_26530":47968,"_2682":47990},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3185":772,"_28073":761,"_19451":47992,"_5":13353,"_26530":47968,"_2682":47993},[],"A DMS relates that CA to an enrollment policy.",{"_3185":773,"_28073":761,"_19451":47995,"_5":13353,"_26530":47968,"_2682":47996},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3185":774,"_28073":761,"_19451":47998,"_5":13353,"_26530":47968,"_2682":47999},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3185":775,"_28073":761,"_19451":48001,"_5":13353,"_26530":47968,"_2682":48002},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3185":776,"_28073":761,"_19451":48004,"_5":13353,"_26530":47968,"_2682":48005},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3185":777,"_28073":761,"_19451":48007,"_5":13353,"_26530":47968,"_2682":48008},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3185":778,"_28073":778,"_5":13700,"_2682":48010,"_28416":48011,"_19451":48013,"_26530":778},"Devices and identities",[45599,47035,48012,48010],"IoT Fleets",[],{"_3185":779,"_28073":778,"_19451":48015,"_5":13353,"_26530":778,"_2682":48016},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3185":780,"_28073":778,"_5":28413,"_19451":48018,"_26530":48019,"_2682":48020},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","Device states",{"_3185":781,"_28073":778,"_5":28413,"_19451":48022,"_26530":48023,"_2682":48024},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3185":782,"_28073":778,"_5":28413,"_19451":48026,"_26530":48027,"_2682":48028},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3185":783,"_28073":778,"_5":28413,"_19451":48030,"_26530":48031,"_2682":48032},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3185":784,"_28073":778,"_5":28413,"_19451":48034,"_26530":48035,"_2682":48036},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3185":785,"_28073":778,"_5":28413,"_19451":48038,"_26530":48039,"_2682":48040},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3185":786,"_28073":778,"_5":28413,"_19451":48042,"_26530":48043,"_2682":48044},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3185":787,"_28073":778,"_5":28413,"_19451":48046,"_26530":48047,"_2682":48048},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3185":788,"_28073":778,"_5":28413,"_19451":48050,"_26530":48051,"_2682":48052},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3185":789,"_28073":778,"_5":28413,"_19451":48054,"_26530":48055,"_2682":48056},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3185":790,"_28073":778,"_5":28413,"_19451":48058,"_26530":48059,"_2682":48060},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3185":791,"_28073":778,"_19451":48062,"_5":13353,"_26530":778,"_2682":48063},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3185":792,"_28073":778,"_19451":48065,"_5":13353,"_26530":778,"_2682":48066},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3185":793,"_28073":778,"_19451":48068,"_5":13353,"_26530":48019,"_2682":48069},[],"Operational view",{"_3185":794,"_28073":778,"_19451":48071,"_5":13353,"_26530":48019,"_2682":48072},[],"Meaning",{"_3185":795,"_28073":778,"_19451":48074,"_5":13353,"_26530":48019,"_2682":48075},[],"**No Identity**",{"_3185":796,"_28073":778,"_19451":48077,"_5":13353,"_26530":48019,"_2682":48078},[],"A record exists without an associated identity.",{"_3185":797,"_28073":778,"_19451":48080,"_5":13353,"_26530":48019,"_2682":48081},[],"**Active**",{"_3185":798,"_28073":778,"_19451":48083,"_5":13353,"_26530":48019,"_2682":48084},[],"The slot is active; also check certificate dates, status and usages.",{"_3185":799,"_28073":778,"_19451":48086,"_5":13353,"_26530":48019,"_2682":48087},[],"**Renewal Pending**",{"_3185":800,"_28073":778,"_19451":48089,"_5":13353,"_26530":48019,"_2682":48090},[],"The identity is in the operational renewal window.",{"_3185":801,"_28073":778,"_19451":48092,"_5":13353,"_26530":48019,"_2682":48093},[],"**Expiring Soon**",{"_3185":802,"_28073":778,"_19451":48095,"_5":13353,"_26530":48019,"_2682":48096},[],"Expiration is approaching according to configured thresholds.",{"_3185":803,"_28073":778,"_19451":48098,"_5":13353,"_26530":48019,"_2682":48099},[],"**Expired**",{"_3185":804,"_28073":778,"_19451":48101,"_5":13353,"_26530":48019,"_2682":48102},[],"The identity has expired.",{"_3185":805,"_28073":778,"_19451":48104,"_5":13353,"_26530":48019,"_2682":48105},[],"**Revoked**",{"_3185":806,"_28073":778,"_19451":48107,"_5":13353,"_26530":48019,"_2682":48108},[],"The identity is marked revoked.",{"_3185":807,"_28073":778,"_19451":48110,"_5":13353,"_26530":48019,"_2682":48111},[],"**Decommissioned**",{"_3185":808,"_28073":778,"_19451":48113,"_5":13353,"_26530":48019,"_2682":48114},[],"The record is retired and ordinary updates do not restore operation.",{"_3185":809,"_28073":778,"_19451":48116,"_5":13353,"_26530":48019,"_2682":48117},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3185":810,"_28073":778,"_19451":48119,"_5":13353,"_26530":48023,"_2682":48120},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3185":811,"_28073":778,"_19451":48122,"_5":13353,"_26530":48023,"_2682":48123},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3185":812,"_28073":778,"_19451":48125,"_5":13353,"_26530":48023,"_2682":48126},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3185":813,"_28073":778,"_19451":48128,"_5":13353,"_26530":48023,"_2682":48129},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3185":814,"_28073":778,"_19451":48131,"_5":13353,"_26530":48027,"_2682":48132},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3185":815,"_28073":778,"_19451":48134,"_5":13353,"_26530":48031,"_2682":48135},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3185":816,"_28073":778,"_19451":48137,"_5":13353,"_26530":48035,"_2682":48138},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3185":817,"_28073":778,"_19451":48140,"_5":13353,"_26530":48039,"_2682":48141},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3185":818,"_28073":778,"_19451":48143,"_5":13353,"_26530":48043,"_2682":48144},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3185":819,"_28073":778,"_19451":48146,"_5":13353,"_26530":48043,"_2682":48147},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3185":820,"_28073":778,"_19451":48149,"_5":13353,"_26530":48047,"_2682":48150},[],"From **No Identity**, use **Assign Identity**:",{"_3185":821,"_28073":778,"_19451":48152,"_5":13353,"_26530":48047,"_2682":48153},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3185":822,"_28073":778,"_19451":48155,"_5":13353,"_26530":48047,"_2682":48156},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3185":823,"_28073":778,"_19451":48158,"_5":13353,"_26530":48047,"_2682":48159},[],"Confirm and read the serial, active version and history again.",{"_3185":824,"_28073":778,"_19451":48161,"_5":13353,"_26530":48047,"_2682":48162},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3185":825,"_28073":778,"_19451":48164,"_5":13353,"_26530":48047,"_2682":48165},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3185":826,"_28073":778,"_19451":48167,"_5":13353,"_26530":48051,"_2682":48168},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3185":827,"_28073":778,"_19451":48170,"_5":13353,"_26530":48051,"_2682":48171},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3185":828,"_28073":778,"_19451":48173,"_5":13353,"_26530":48055,"_2682":48174},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3185":829,"_28073":778,"_19451":48176,"_5":13353,"_26530":48055,"_2682":48177},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3185":830,"_28073":778,"_19451":48179,"_5":13353,"_26530":48055,"_2682":48180},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3185":831,"_28073":778,"_19451":48182,"_5":13353,"_26530":48055,"_2682":48183},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3185":832,"_28073":778,"_19451":48185,"_5":13353,"_26530":48059,"_2682":48186},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3185":833,"_28073":778,"_19451":48188,"_5":13353,"_26530":48059,"_2682":48189},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3185":834,"_28073":834,"_5":13700,"_2682":48191,"_28416":48192,"_19451":48194,"_26530":834},"Bootstrap identity and authentication",[45599,47035,48012,48010,48193],"Enrollment with PKI",[],{"_3185":835,"_28073":834,"_19451":48196,"_5":13353,"_26530":834,"_2682":48197},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3185":836,"_28073":834,"_5":28413,"_19451":48199,"_26530":48200,"_2682":48201},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3185":837,"_28073":834,"_5":28413,"_19451":48203,"_26530":48204,"_2682":48205},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3185":838,"_28073":834,"_5":28413,"_19451":48207,"_26530":48208,"_2682":48209},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3185":839,"_28073":834,"_5":28413,"_19451":48211,"_26530":48212,"_2682":48213},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3185":840,"_28073":834,"_5":28413,"_19451":48215,"_26530":48216,"_2682":48217},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3185":841,"_28073":834,"_19451":48219,"_5":13353,"_26530":834,"_2682":48220},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3185":842,"_28073":834,"_19451":48222,"_5":13353,"_26530":48200,"_2682":48223},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3185":843,"_28073":834,"_19451":48225,"_5":13353,"_26530":48200,"_2682":48226},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3185":844,"_28073":834,"_19451":48228,"_5":13353,"_26530":48204,"_2682":48229},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3185":845,"_28073":834,"_19451":48231,"_5":13353,"_26530":48204,"_2682":48232},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3185":846,"_28073":834,"_19451":48234,"_5":13353,"_26530":48204,"_2682":48235},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3185":847,"_28073":834,"_19451":48237,"_5":13353,"_26530":48208,"_2682":48238},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3185":848,"_28073":834,"_19451":48240,"_5":13353,"_26530":48208,"_2682":48241},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3185":849,"_28073":834,"_19451":48243,"_5":13353,"_26530":48212,"_2682":48244},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3185":850,"_28073":834,"_19451":48246,"_5":13353,"_26530":48212,"_2682":48247},[],"Example body:",{"_3185":851,"_28073":834,"_19451":48249,"_5":13353,"_26530":48212,"_2682":48250},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3185":852,"_28073":834,"_19451":48252,"_5":13353,"_26530":48212,"_2682":48253},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3185":853,"_28073":834,"_19451":48255,"_5":13353,"_26530":48212,"_2682":48256},[],"Continuation requires a successful HTTP response and JSON:",{"_3185":854,"_28073":834,"_19451":48258,"_5":13353,"_26530":48212,"_2682":48259},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3185":855,"_28073":834,"_19451":48261,"_5":13353,"_26530":48216,"_2682":48262},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3185":856,"_28073":834,"_19451":48264,"_5":13353,"_26530":48216,"_2682":48265},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3185":857,"_28073":857,"_5":13700,"_2682":48267,"_28416":48268,"_19451":48269,"_26530":857},"Configure and operate the DMS",[45599,47035,48012,48010,48193],[],{"_3185":858,"_28073":857,"_19451":48271,"_5":13353,"_26530":857,"_2682":48272},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3185":859,"_28073":857,"_5":28413,"_19451":48274,"_26530":48275,"_2682":45609},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3185":860,"_28073":857,"_5":28413,"_19451":48277,"_26530":48278,"_2682":48279},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3185":861,"_28073":857,"_5":28413,"_19451":48281,"_26530":48282,"_2682":48283},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3185":862,"_28073":857,"_5":28413,"_19451":48285,"_26530":48286,"_2682":48287},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3185":863,"_28073":857,"_5":28413,"_19451":48289,"_26530":48290,"_2682":48291},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3185":864,"_28073":857,"_5":28413,"_19451":48293,"_26530":48294,"_2682":48295},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3185":865,"_28073":857,"_5":28413,"_19451":48297,"_26530":48298,"_2682":48299},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3185":866,"_28073":857,"_5":28413,"_19451":48301,"_26530":48302,"_2682":48303},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3185":867,"_28073":857,"_5":28413,"_19451":48305,"_26530":48306,"_2682":48307},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3185":868,"_28073":857,"_5":28413,"_19451":48309,"_26530":48310,"_2682":48311},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3185":869,"_28073":857,"_5":28413,"_19451":48313,"_26530":48314,"_2682":48315},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3185":870,"_28073":857,"_5":28413,"_19451":48317,"_26530":48318,"_2682":48319},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3185":871,"_28073":857,"_5":28413,"_19451":48321,"_26530":48322,"_2682":48323},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3185":872,"_28073":857,"_5":28413,"_19451":48325,"_26530":48326,"_2682":48327},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3185":873,"_28073":857,"_5":28413,"_19451":48329,"_26530":48330,"_2682":48331},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3185":874,"_28073":857,"_5":28413,"_19451":48333,"_26530":48334,"_2682":48335},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3185":875,"_28073":857,"_5":28413,"_19451":48337,"_26530":48338,"_2682":48339},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3185":876,"_28073":857,"_5":28413,"_19451":48341,"_26530":48342,"_2682":48343},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3185":877,"_28073":857,"_19451":48345,"_5":13353,"_26530":857,"_2682":48346},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3185":878,"_28073":857,"_19451":48348,"_5":13353,"_26530":48275,"_2682":48349},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3185":879,"_28073":857,"_19451":48351,"_5":13353,"_26530":48275,"_2682":48352},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3185":880,"_28073":857,"_19451":48354,"_5":13353,"_26530":48282,"_2682":48355},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3185":881,"_28073":857,"_19451":48357,"_5":13353,"_26530":48286,"_2682":48358},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3185":882,"_28073":857,"_19451":48360,"_5":13353,"_26530":48290,"_2682":48361},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3185":883,"_28073":857,"_19451":48363,"_5":13353,"_26530":48294,"_2682":48364},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3185":884,"_28073":857,"_19451":48366,"_5":13353,"_26530":48298,"_2682":48367},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3185":885,"_28073":857,"_19451":48369,"_5":13353,"_26530":48306,"_2682":48370},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3185":886,"_28073":857,"_19451":48372,"_5":13353,"_26530":48306,"_2682":48373},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3185":887,"_28073":857,"_19451":48375,"_5":13353,"_26530":48310,"_2682":48376},[],"`settings.enrollment_settings` field",{"_3185":888,"_28073":857,"_19451":48378,"_5":13353,"_26530":48310,"_2682":48379},[],"Decision",{"_3185":889,"_28073":857,"_19451":48381,"_5":13353,"_26530":48310,"_2682":48382},[],"`protocol`",{"_3185":890,"_28073":857,"_19451":48384,"_5":13353,"_26530":48310,"_2682":48385},[],"`EST_RFC7030` for these operations.",{"_3185":891,"_28073":857,"_19451":48387,"_5":13353,"_26530":48310,"_2682":48388},[],"`enrollment_ca`",{"_3185":892,"_28073":857,"_19451":48390,"_5":13353,"_26530":48310,"_2682":48391},[],"ID of the signing CA.",{"_3185":893,"_28073":857,"_19451":48393,"_5":13353,"_26530":48310,"_2682":48394},[],"`verify_csr_signature`",{"_3185":894,"_28073":857,"_19451":48396,"_5":13353,"_26530":48310,"_2682":48397},[],"Keep `true` to verify CSR key possession.",{"_3185":895,"_28073":857,"_19451":48399,"_5":13353,"_26530":48310,"_2682":48400},[],"`enable_replaceable_enrollment`",{"_3185":896,"_28073":857,"_19451":48402,"_5":13353,"_26530":48310,"_2682":48403},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3185":897,"_28073":857,"_19451":48405,"_5":13353,"_26530":48310,"_2682":48406},[],"`est_rfc7030_settings.auth_mode`",{"_3185":898,"_28073":857,"_19451":48408,"_5":13353,"_26530":48310,"_2682":48409},[],"One of the four authentication modes.",{"_3185":899,"_28073":857,"_19451":48411,"_5":13353,"_26530":48310,"_2682":48412},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3185":900,"_28073":857,"_19451":48414,"_5":13353,"_26530":48314,"_2682":48415},[],"The blocks are independent:",{"_3185":901,"_28073":857,"_19451":48417,"_5":13353,"_26530":48314,"_2682":48418},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3185":902,"_28073":857,"_19451":48420,"_5":13353,"_26530":48314,"_2682":48421},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3185":903,"_28073":857,"_19451":48423,"_5":13353,"_26530":48314,"_2682":48424},[],"`auth_mode`",{"_3185":904,"_28073":857,"_19451":48426,"_5":13353,"_26530":48314,"_2682":48427},[],"Control applied in the configured operation",{"_3185":905,"_28073":857,"_19451":48429,"_5":13353,"_26530":48314,"_2682":48430},[],"`CLIENT_CERTIFICATE`",{"_3185":906,"_28073":857,"_19451":48432,"_5":13353,"_26530":48314,"_2682":48433},[],"Presented certificate validation.",{"_3185":907,"_28073":857,"_19451":48435,"_5":13353,"_26530":48314,"_2682":48436},[],"`EXTERNAL_WEBHOOK`",{"_3185":908,"_28073":857,"_19451":48438,"_5":13353,"_26530":48314,"_2682":48439},[],"Configured webhook authorization.",{"_3185":909,"_28073":857,"_19451":48441,"_5":13353,"_26530":48314,"_2682":48442},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3185":910,"_28073":857,"_19451":48444,"_5":13353,"_26530":48314,"_2682":48445},[],"Certificate validation followed by webhook approval.",{"_3185":911,"_28073":857,"_19451":48447,"_5":13353,"_26530":48314,"_2682":48448},[],"`NO_AUTH`",{"_3185":912,"_28073":857,"_19451":48450,"_5":13353,"_26530":48314,"_2682":48451},[],"No DMS requester authentication.",{"_3185":913,"_28073":857,"_19451":48453,"_5":13353,"_26530":48314,"_2682":48454},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3185":914,"_28073":857,"_19451":48456,"_5":13353,"_26530":48314,"_2682":48457},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3185":915,"_28073":857,"_19451":48459,"_5":13353,"_26530":48314,"_2682":48460},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3185":916,"_28073":857,"_19451":48462,"_5":13353,"_26530":48314,"_2682":48463},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3185":917,"_28073":857,"_19451":48465,"_5":13353,"_26530":48318,"_2682":48466},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3185":918,"_28073":857,"_19451":48468,"_5":13353,"_26530":48318,"_2682":48469},[],"`external_webhook_settings` field",{"_3185":919,"_28073":857,"_19451":48471,"_5":13353,"_26530":48318,"_2682":48379},[],{"_3185":920,"_28073":857,"_19451":48473,"_5":13353,"_26530":48318,"_2682":48474},[],"`url`",{"_3185":921,"_28073":857,"_19451":48476,"_5":13353,"_26530":48318,"_2682":48477},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3185":922,"_28073":857,"_19451":48479,"_5":13353,"_26530":48318,"_2682":48480},[],"`method`",{"_3185":923,"_28073":857,"_19451":48482,"_5":13353,"_26530":48318,"_2682":48483},[],"`POST` or `PUT`; `POST` by default.",{"_3185":924,"_28073":857,"_19451":48485,"_5":13353,"_26530":48318,"_2682":48486},[],"`name`",{"_3185":925,"_28073":857,"_19451":48488,"_5":13353,"_26530":48318,"_2682":48489},[],"Label used in service logs.",{"_3185":926,"_28073":857,"_19451":48491,"_5":13353,"_26530":48318,"_2682":48492},[],"`config.auth_mode`",{"_3185":927,"_28073":857,"_19451":48494,"_5":13353,"_26530":48318,"_2682":48495},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3185":928,"_28073":857,"_19451":48497,"_5":13353,"_26530":48318,"_2682":48498},[],"`config.apikey_options`",{"_3185":929,"_28073":857,"_19451":48500,"_5":13353,"_26530":48318,"_2682":48501},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3185":930,"_28073":857,"_19451":48503,"_5":13353,"_26530":48318,"_2682":48504},[],"`config.jwt_options`",{"_3185":931,"_28073":857,"_19451":48506,"_5":13353,"_26530":48318,"_2682":48507},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3185":932,"_28073":857,"_19451":48509,"_5":13353,"_26530":48318,"_2682":48510},[],"`config.mtls_options`",{"_3185":933,"_28073":857,"_19451":48512,"_5":13353,"_26530":48318,"_2682":48513},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3185":934,"_28073":857,"_19451":48515,"_5":13353,"_26530":48318,"_2682":48516},[],"`config.insecure_skip_verify`",{"_3185":935,"_28073":857,"_19451":48518,"_5":13353,"_26530":48318,"_2682":48519},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3185":936,"_28073":857,"_19451":48521,"_5":13353,"_26530":48318,"_2682":48522},[],"`config.call_timeout`",{"_3185":937,"_28073":857,"_19451":48524,"_5":13353,"_26530":48318,"_2682":48525},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3185":938,"_28073":857,"_19451":48527,"_5":13353,"_26530":48318,"_2682":48528},[],"Rules for that configuration:",{"_3185":939,"_28073":857,"_19451":48530,"_5":13353,"_26530":48318,"_2682":48531},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3185":940,"_28073":857,"_19451":48533,"_5":13353,"_26530":48318,"_2682":48534},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3185":941,"_28073":857,"_19451":48536,"_5":13353,"_26530":48318,"_2682":48537},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3185":942,"_28073":857,"_19451":48539,"_5":13353,"_26530":48318,"_2682":48540},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3185":943,"_28073":857,"_19451":48542,"_5":13353,"_26530":48318,"_2682":48543},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3185":944,"_28073":857,"_19451":48545,"_5":13353,"_26530":48318,"_2682":48546},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3185":945,"_28073":857,"_19451":48548,"_5":13353,"_26530":48318,"_2682":48549},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_3185":946,"_28073":857,"_19451":48551,"_5":13353,"_26530":48318,"_2682":48552},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3185":947,"_28073":857,"_19451":48554,"_5":13353,"_26530":48318,"_2682":48555},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3185":948,"_28073":857,"_19451":48557,"_5":13353,"_26530":48322,"_2682":48558},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3185":949,"_28073":857,"_19451":48560,"_5":13353,"_26530":48326,"_2682":48561},[],"`settings.reenrollment_settings` field",{"_3185":950,"_28073":857,"_19451":48563,"_5":13353,"_26530":48326,"_2682":45989},[],{"_3185":951,"_28073":857,"_19451":48565,"_5":13353,"_26530":48326,"_2682":48566},[],"`reenrollment_delta`",{"_3185":952,"_28073":857,"_19451":48568,"_5":13353,"_26530":48326,"_2682":48569},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3185":953,"_28073":857,"_19451":48571,"_5":13353,"_26530":48326,"_2682":48572},[],"`preventive_delta`",{"_3185":954,"_28073":857,"_19451":48574,"_5":13353,"_26530":48326,"_2682":48575},[],"Preventive operational monitoring threshold.",{"_3185":955,"_28073":857,"_19451":48577,"_5":13353,"_26530":48326,"_2682":48578},[],"`critical_delta`",{"_3185":956,"_28073":857,"_19451":48580,"_5":13353,"_26530":48326,"_2682":48581},[],"Critical operational monitoring threshold.",{"_3185":957,"_28073":857,"_19451":48583,"_5":13353,"_26530":48326,"_2682":48584},[],"`enable_expired_renewal`",{"_3185":958,"_28073":857,"_19451":48586,"_5":13353,"_26530":48326,"_2682":48587},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3185":959,"_28073":857,"_19451":48589,"_5":13353,"_26530":48326,"_2682":48590},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3185":960,"_28073":857,"_19451":48592,"_5":13353,"_26530":48326,"_2682":48593},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3185":961,"_28073":857,"_19451":48595,"_5":13353,"_26530":48326,"_2682":48596},[],"`revoke_on_reenrollment`",{"_3185":962,"_28073":857,"_19451":48598,"_5":13353,"_26530":48326,"_2682":48599},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3185":963,"_28073":857,"_19451":48601,"_5":13353,"_26530":48326,"_2682":48602},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3185":964,"_28073":857,"_19451":48604,"_5":13353,"_26530":48330,"_2682":48605},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3185":965,"_28073":857,"_19451":48607,"_5":13353,"_26530":48334,"_2682":45983},[],{"_3185":966,"_28073":857,"_19451":48609,"_5":13353,"_26530":48334,"_2682":48610},[],"Published material",{"_3185":967,"_28073":857,"_19451":48612,"_5":13353,"_26530":48334,"_2682":48613},[],"**Include Lamassu System CA**",{"_3185":968,"_28073":857,"_19451":48615,"_5":13353,"_26530":48334,"_2682":48616},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3185":969,"_28073":857,"_19451":48618,"_5":13353,"_26530":48334,"_2682":48619},[],"**Include Enrollment CA**",{"_3185":970,"_28073":857,"_19451":48621,"_5":13353,"_26530":48334,"_2682":48622},[],"Selected issuing CA certificate.",{"_3185":971,"_28073":857,"_19451":48624,"_5":13353,"_26530":48334,"_2682":48625},[],"**Managed CAs**",{"_3185":972,"_28073":857,"_19451":48627,"_5":13353,"_26530":48334,"_2682":48628},[],"Explicitly selected CA certificates.",{"_3185":973,"_28073":857,"_19451":48630,"_5":13353,"_26530":48334,"_2682":48631},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3185":974,"_28073":857,"_19451":48633,"_5":13353,"_26530":48338,"_2682":48634},[],"**Edit** changes name, settings and metadata. When using the API, read the DMS before editing it: `name` and `settings` are replaced entirely. Omitted or `null` `metadata` keeps the stored value, and an object replaces it entirely. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3185":975,"_28073":857,"_19451":48636,"_5":13353,"_26530":48338,"_2682":48637},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3185":976,"_28073":857,"_19451":48639,"_5":13353,"_26530":48338,"_2682":48640},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3185":977,"_28073":857,"_19451":48642,"_5":13353,"_26530":48342,"_2682":48643},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3185":978,"_28073":978,"_5":13700,"_2682":48645,"_28416":48646,"_19451":48647,"_26530":978},"Integrate the EST client",[45599,47035,48012,48010,48193],[],{"_3185":979,"_28073":978,"_19451":48649,"_5":13353,"_26530":978,"_2682":48650},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3185":980,"_28073":978,"_5":28413,"_19451":48652,"_26530":48653,"_2682":45609},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3185":981,"_28073":978,"_5":28413,"_19451":48655,"_26530":48656,"_2682":48657},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3185":982,"_28073":978,"_5":28413,"_19451":48659,"_26530":48660,"_2682":48661},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3185":983,"_28073":978,"_5":28413,"_19451":48663,"_26530":48664,"_2682":48665},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3185":984,"_28073":978,"_5":28413,"_19451":48667,"_26530":48668,"_2682":48669},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3185":985,"_28073":978,"_5":28413,"_19451":48671,"_26530":48672,"_2682":48673},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3185":986,"_28073":978,"_19451":48675,"_5":13353,"_26530":978,"_2682":48676},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3185":987,"_28073":978,"_19451":48678,"_5":13353,"_26530":48653,"_2682":48679},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3185":988,"_28073":978,"_19451":48681,"_5":13353,"_26530":48653,"_2682":48682},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3185":989,"_28073":978,"_19451":48684,"_5":13353,"_26530":48653,"_2682":48685},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3185":990,"_28073":978,"_19451":48687,"_5":13353,"_26530":48656,"_2682":48688},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3185":991,"_28073":978,"_19451":48690,"_5":13353,"_26530":48656,"_2682":48691},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3185":992,"_28073":978,"_19451":48693,"_5":13353,"_26530":48660,"_2682":48694},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3185":993,"_28073":978,"_19451":48696,"_5":13353,"_26530":48660,"_2682":48697},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3185":994,"_28073":978,"_19451":48699,"_5":13353,"_26530":48664,"_2682":48700},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3185":995,"_28073":978,"_19451":48702,"_5":13353,"_26530":48664,"_2682":48703},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3185":996,"_28073":978,"_19451":48705,"_5":13353,"_26530":48668,"_2682":48706},[],"For a root that issues directly:",{"_3185":997,"_28073":978,"_19451":48708,"_5":13353,"_26530":48668,"_2682":48709},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3185":998,"_28073":978,"_19451":48711,"_5":13353,"_26530":48668,"_2682":48712},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3185":999,"_28073":978,"_19451":48714,"_5":13353,"_26530":48672,"_2682":48715},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3185":1000,"_28073":1000,"_5":13700,"_2682":48717,"_28416":48718,"_19451":48719,"_26530":1000},"EST reference",[45599,47035,48012,48010,48193],[],{"_3185":1001,"_28073":1000,"_19451":48721,"_5":13353,"_26530":1000,"_2682":48722},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3185":1002,"_28073":1000,"_5":28413,"_19451":48724,"_26530":48725,"_2682":48726},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3185":1003,"_28073":1000,"_5":28413,"_19451":48728,"_26530":48729,"_2682":21131},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3185":1004,"_28073":1000,"_5":28413,"_19451":48731,"_26530":48732,"_2682":24242},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3185":1005,"_28073":1000,"_5":28413,"_19451":48734,"_26530":48735,"_2682":24249},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3185":1006,"_28073":1000,"_5":28413,"_19451":48737,"_26530":48738,"_2682":23588},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3185":1007,"_28073":1000,"_5":28413,"_19451":48740,"_26530":48741,"_2682":48742},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3185":1008,"_28073":1000,"_5":28413,"_19451":48744,"_26530":48745,"_2682":48746},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3185":1009,"_28073":1000,"_5":28413,"_19451":48748,"_26530":48749,"_2682":48750},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3185":1010,"_28073":1000,"_19451":48752,"_5":13353,"_26530":1000,"_2682":48753},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3185":1011,"_28073":1000,"_19451":48755,"_5":13353,"_26530":48725,"_2682":48756},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3185":1012,"_28073":1000,"_19451":48758,"_5":13353,"_26530":48725,"_2682":48759},[],"Operation",{"_3185":1013,"_28073":1000,"_19451":48761,"_5":13353,"_26530":48725,"_2682":48762},[],"Method",{"_3185":1014,"_28073":1000,"_19451":48764,"_5":13353,"_26530":48725,"_2682":48765},[],"Authentication and condition",{"_3185":1015,"_28073":1000,"_19451":48767,"_5":13353,"_26530":48725,"_2682":48768},[],"`/cacerts`",{"_3185":1016,"_28073":1000,"_19451":48770,"_5":13353,"_26530":48725,"_2682":48771},[],"GET",{"_3185":1017,"_28073":1000,"_19451":48773,"_5":13353,"_26530":48725,"_2682":48774},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3185":1018,"_28073":1000,"_19451":48776,"_5":13353,"_26530":48725,"_2682":48777},[],"`/simpleenroll`",{"_3185":1019,"_28073":1000,"_19451":48779,"_5":13353,"_26530":48725,"_2682":48780},[],"POST",{"_3185":1020,"_28073":1000,"_19451":48782,"_5":13353,"_26530":48725,"_2682":48783},[],"Initial authentication and DMS registration/replacement policy.",{"_3185":1021,"_28073":1000,"_19451":48785,"_5":13353,"_26530":48725,"_2682":48786},[],"`/simplereenroll`",{"_3185":1022,"_28073":1000,"_19451":48788,"_5":13353,"_26530":48725,"_2682":48780},[],{"_3185":1023,"_28073":1000,"_19451":48790,"_5":13353,"_26530":48725,"_2682":48791},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3185":1024,"_28073":1000,"_19451":48793,"_5":13353,"_26530":48725,"_2682":48794},[],"`/serverkeygen`",{"_3185":1025,"_28073":1000,"_19451":48796,"_5":13353,"_26530":48725,"_2682":48780},[],{"_3185":1026,"_28073":1000,"_19451":48798,"_5":13353,"_26530":48725,"_2682":48799},[],"Initial authentication and admission; server generation enabled.",{"_3185":1027,"_28073":1000,"_19451":48801,"_5":13353,"_26530":48725,"_2682":48802},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3185":1028,"_28073":1000,"_19451":48804,"_5":13353,"_26530":48729,"_2682":48805},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3185":1029,"_28073":1000,"_19451":48807,"_5":13353,"_26530":48729,"_2682":48808},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3185":1030,"_28073":1000,"_19451":48810,"_5":13353,"_26530":48732,"_2682":48811},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3185":1031,"_28073":1000,"_19451":48813,"_5":13353,"_26530":48732,"_2682":48814},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3185":1032,"_28073":1000,"_19451":48816,"_5":13353,"_26530":48735,"_2682":48817},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3185":1033,"_28073":1000,"_19451":48819,"_5":13353,"_26530":48735,"_2682":48820},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3185":1034,"_28073":1000,"_19451":48822,"_5":13353,"_26530":48738,"_2682":48823},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3185":1035,"_28073":1000,"_19451":48825,"_5":13353,"_26530":48738,"_2682":48826},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3185":1036,"_28073":1000,"_19451":48828,"_5":13353,"_26530":48741,"_2682":48829},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3185":1037,"_28073":1000,"_19451":48831,"_5":13353,"_26530":48741,"_2682":48832},[],"Part",{"_3185":1038,"_28073":1000,"_19451":48834,"_5":13353,"_26530":48741,"_2682":48835},[],"Content after decoding its Base64",{"_3185":1039,"_28073":1000,"_19451":48837,"_5":13353,"_26530":48741,"_2682":48838},[],"`application/pkcs8`",{"_3185":1040,"_28073":1000,"_19451":48840,"_5":13353,"_26530":48741,"_2682":48841},[],"Unencrypted DER PKCS#8 private key.",{"_3185":1041,"_28073":1000,"_19451":48843,"_5":13353,"_26530":48741,"_2682":48844},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3185":1042,"_28073":1000,"_19451":48846,"_5":13353,"_26530":48741,"_2682":48847},[],"DER PKCS#7 containing the issued certificate.",{"_3185":1043,"_28073":1000,"_19451":48849,"_5":13353,"_26530":48741,"_2682":48850},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3185":1044,"_28073":1000,"_19451":48852,"_5":13353,"_26530":48745,"_2682":48853},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3185":1045,"_28073":1000,"_19451":48855,"_5":13353,"_26530":48745,"_2682":48856},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3185":1046,"_28073":1000,"_19451":48858,"_5":13353,"_26530":48745,"_2682":48859},[],"Convert and check the result:",{"_3185":1047,"_28073":1000,"_19451":48861,"_5":13353,"_26530":48745,"_2682":48862},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3185":1048,"_28073":1000,"_19451":48864,"_5":13353,"_26530":48749,"_2682":48865},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3185":1049,"_28073":1000,"_19451":48867,"_5":13353,"_26530":48749,"_2682":48868},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3185":1050,"_28073":1050,"_5":13700,"_2682":48193,"_28416":48870,"_19451":48871,"_26530":1050},[45599,47035,48012,48010,48193],[],{"_3185":1051,"_28073":1050,"_19451":48873,"_5":13353,"_26530":1050,"_2682":48874},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3185":1052,"_28073":1050,"_5":28413,"_19451":48876,"_26530":48877,"_2682":48878},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3185":1053,"_28073":1050,"_5":28413,"_19451":48880,"_26530":48881,"_2682":48882},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3185":1054,"_28073":1050,"_5":28413,"_19451":48884,"_26530":48885,"_2682":48886},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3185":1055,"_28073":1050,"_5":28413,"_19451":48888,"_26530":48889,"_2682":48890},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3185":1056,"_28073":1050,"_19451":48892,"_5":13353,"_26530":1050,"_2682":48893},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3185":1057,"_28073":1050,"_19451":48895,"_5":13353,"_26530":48877,"_2682":48896},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3185":1058,"_28073":1050,"_19451":48898,"_5":13353,"_26530":48877,"_2682":48899},[],"The integrator installs initial EST server trust and an admission credential.",{"_3185":1059,"_28073":1050,"_19451":48901,"_5":13353,"_26530":48877,"_2682":48902},[],"The client requests an identity for its `Device ID` through EST.",{"_3185":1060,"_28073":1050,"_19451":48904,"_5":13353,"_26530":48877,"_2682":48905},[],"Certificate, device binding and key/certificate installation are checked.",{"_3185":1061,"_28073":1050,"_19451":48907,"_5":13353,"_26530":48877,"_2682":48908},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3185":1062,"_28073":1050,"_19451":48910,"_5":13353,"_26530":48877,"_2682":48911},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3185":1063,"_28073":1050,"_19451":48913,"_5":13353,"_26530":48881,"_2682":48914},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3185":1064,"_28073":1050,"_19451":48916,"_5":13353,"_26530":48881,"_2682":48917},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3185":1065,"_28073":1050,"_19451":48919,"_5":13353,"_26530":48881,"_2682":48920},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3185":1066,"_28073":1050,"_19451":48922,"_5":13353,"_26530":48881,"_2682":48923},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3185":1067,"_28073":1050,"_19451":48925,"_5":13353,"_26530":48885,"_2682":48926},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3185":1068,"_28073":1050,"_19451":48928,"_5":13353,"_26530":48885,"_2682":48929},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3185":1069,"_28073":1050,"_19451":48931,"_5":13353,"_26530":48885,"_2682":48932},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3185":1070,"_28073":1050,"_19451":48934,"_5":13353,"_26530":48885,"_2682":48935},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3185":1071,"_28073":1050,"_19451":48937,"_5":13353,"_26530":48889,"_2682":48938},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3185":1072,"_28073":1050,"_19451":48940,"_5":13353,"_26530":48889,"_2682":48941},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3185":1073,"_28073":1073,"_5":13700,"_2682":48943,"_28416":48944,"_19451":48945,"_26530":1073},"Provisioning strategies",[45599,47035,48012,48010,48193],[],{"_3185":1074,"_28073":1073,"_19451":48947,"_5":13353,"_26530":1073,"_2682":48948},[],"Choose device registration, identity authorization and key generation.",{"_3185":1075,"_28073":1073,"_5":28413,"_19451":48950,"_26530":48951,"_2682":48952},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3185":1076,"_28073":1073,"_5":28413,"_19451":48954,"_26530":48955,"_2682":48956},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3185":1077,"_28073":1073,"_5":28413,"_19451":48958,"_26530":48959,"_2682":48960},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3185":1078,"_28073":1073,"_5":28413,"_19451":48962,"_26530":48963,"_2682":48964},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3185":1079,"_28073":1073,"_5":28413,"_19451":48966,"_26530":48967,"_2682":48968},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3185":1080,"_28073":1073,"_19451":48970,"_5":13353,"_26530":1073,"_2682":48971},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3185":1081,"_28073":1073,"_19451":48973,"_5":13353,"_26530":48951,"_2682":48974},[],"Path",{"_3185":1082,"_28073":1073,"_19451":48976,"_5":13353,"_26530":48951,"_2682":48977},[],"When the device exists",{"_3185":1083,"_28073":1073,"_19451":48979,"_5":13353,"_26530":48951,"_2682":48980},[],"What to check",{"_3185":1084,"_28073":1073,"_19451":48982,"_5":13353,"_26530":48951,"_2682":48983},[],"Manual assignment",{"_3185":1085,"_28073":1073,"_19451":48985,"_5":13353,"_26530":48951,"_2682":48986},[],"An operator creates it before associating a certificate.",{"_3185":1086,"_28073":1073,"_19451":48988,"_5":13353,"_26530":48951,"_2682":48989},[],"ID, owning DMS, certificate CN and bound serial.",{"_3185":1087,"_28073":1073,"_19451":48991,"_5":13353,"_26530":48951,"_2682":48992},[],"EST with `JITP`",{"_3185":1088,"_28073":1073,"_19451":48994,"_5":13353,"_26530":48951,"_2682":48995},[],"Created for an unknown CN during `/simpleenroll`.",{"_3185":1089,"_28073":1073,"_19451":48997,"_5":13353,"_26530":48951,"_2682":48998},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3185":1090,"_28073":1073,"_19451":49000,"_5":13353,"_26530":48951,"_2682":49001},[],"EST with `PRE_REGISTRATION`",{"_3185":1091,"_28073":1073,"_19451":49003,"_5":13353,"_26530":48951,"_2682":49004},[],"Must exist before `/simpleenroll`.",{"_3185":1092,"_28073":1073,"_19451":49006,"_5":13353,"_26530":48951,"_2682":49007},[],"Approved record, same DMS and replacement conditions for your version.",{"_3185":1093,"_28073":1073,"_19451":49009,"_5":13353,"_26530":48951,"_2682":49010},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3185":1094,"_28073":1073,"_19451":49012,"_5":13353,"_26530":48951,"_2682":49013},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3185":1095,"_28073":1073,"_19451":49015,"_5":13353,"_26530":48955,"_2682":49016},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3185":1096,"_28073":1073,"_19451":49018,"_5":13353,"_26530":48955,"_2682":49019},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3185":1097,"_28073":1073,"_19451":49021,"_5":13353,"_26530":48955,"_2682":49022},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3185":1098,"_28073":1073,"_19451":49024,"_5":13353,"_26530":48959,"_2682":49025},[],"Decide initial enrollment and re-enrollment separately:",{"_3185":1099,"_28073":1073,"_19451":49027,"_5":13353,"_26530":48959,"_2682":49028},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3185":1100,"_28073":1073,"_19451":49030,"_5":13353,"_26530":48959,"_2682":49031},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3185":1101,"_28073":1073,"_19451":49033,"_5":13353,"_26530":48959,"_2682":49034},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3185":1102,"_28073":1073,"_19451":49036,"_5":13353,"_26530":48959,"_2682":49037},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3185":1103,"_28073":1073,"_19451":49039,"_5":13353,"_26530":48959,"_2682":49040},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3185":1104,"_28073":1073,"_19451":49042,"_5":13353,"_26530":48963,"_2682":45983},[],{"_3185":1105,"_28073":1073,"_19451":49044,"_5":13353,"_26530":48963,"_2682":49045},[],"Material crossing EST",{"_3185":1106,"_28073":1073,"_19451":49047,"_5":13353,"_26530":48963,"_2682":49048},[],"Device-generated key",{"_3185":1107,"_28073":1073,"_19451":49050,"_5":13353,"_26530":48963,"_2682":49051},[],"Public CSR and certificate; the key stays on the client.",{"_3185":1108,"_28073":1073,"_19451":49053,"_5":13353,"_26530":48963,"_2682":49054},[],"Existing device key",{"_3185":1109,"_28073":1073,"_19451":49056,"_5":13353,"_26530":48963,"_2682":49057},[],"CSR signed with that key and a new certificate.",{"_3185":1110,"_28073":1073,"_19451":49059,"_5":13353,"_26530":48963,"_2682":48331},[],{"_3185":1111,"_28073":1073,"_19451":49061,"_5":13353,"_26530":48963,"_2682":49062},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3185":1112,"_28073":1073,"_19451":49064,"_5":13353,"_26530":48963,"_2682":49065},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3185":1113,"_28073":1073,"_19451":49067,"_5":13353,"_26530":48967,"_2682":49068},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3185":1114,"_28073":1114,"_5":13700,"_2682":49070,"_28416":49071,"_19451":49072,"_26530":1114},"Renewal and recovery",[45599,47035,48012,48010,48193],[],{"_3185":1115,"_28073":1114,"_19451":49074,"_5":13353,"_26530":1114,"_2682":49075},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3185":1116,"_28073":1114,"_5":28413,"_19451":49077,"_26530":49078,"_2682":49079},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3185":1117,"_28073":1114,"_5":28413,"_19451":49081,"_26530":49082,"_2682":49083},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3185":1118,"_28073":1114,"_5":28413,"_19451":49085,"_26530":49086,"_2682":49087},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3185":1119,"_28073":1114,"_5":28413,"_19451":49089,"_26530":49090,"_2682":49091},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3185":1120,"_28073":1114,"_5":28413,"_19451":49093,"_26530":49094,"_2682":49095},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3185":1121,"_28073":1114,"_19451":49097,"_5":13353,"_26530":1114,"_2682":49098},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3185":1122,"_28073":1114,"_19451":49100,"_5":13353,"_26530":49078,"_2682":49101},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3185":1123,"_28073":1114,"_19451":49103,"_5":13353,"_26530":49078,"_2682":49104},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3185":1124,"_28073":1114,"_19451":49106,"_5":13353,"_26530":49078,"_2682":49107},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3185":1125,"_28073":1114,"_19451":49109,"_5":13353,"_26530":49078,"_2682":49110},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3185":1126,"_28073":1114,"_19451":49112,"_5":13353,"_26530":49082,"_2682":49113},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3185":1127,"_28073":1114,"_19451":49115,"_5":13353,"_26530":49082,"_2682":49116},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3185":1128,"_28073":1114,"_19451":49118,"_5":13353,"_26530":49086,"_2682":49119},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3185":1129,"_28073":1114,"_19451":49121,"_5":13353,"_26530":49086,"_2682":49122},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3185":1130,"_28073":1114,"_19451":49124,"_5":13353,"_26530":49086,"_2682":49125},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3185":1131,"_28073":1114,"_19451":49127,"_5":13353,"_26530":49090,"_2682":49128},[],"Situation",{"_3185":1132,"_28073":1114,"_19451":49130,"_5":13353,"_26530":49090,"_2682":49131},[],"Procedure",{"_3185":1133,"_28073":1114,"_19451":49133,"_5":13353,"_26530":49090,"_2682":49134},[],"Valid certificate, outside the window",{"_3185":1134,"_28073":1114,"_19451":49136,"_5":13353,"_26530":49090,"_2682":49137},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3185":1135,"_28073":1114,"_19451":49139,"_5":13353,"_26530":49090,"_2682":49140},[],"Expired certificate, key available",{"_3185":1136,"_28073":1114,"_19451":49142,"_5":13353,"_26530":49090,"_2682":49143},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3185":1137,"_28073":1114,"_19451":49145,"_5":13353,"_26530":49090,"_2682":49146},[],"Renewal through webhook or `NO_AUTH`",{"_3185":1138,"_28073":1114,"_19451":49148,"_5":13353,"_26530":49090,"_2682":49149},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3185":1139,"_28073":1114,"_19451":49151,"_5":13353,"_26530":49090,"_2682":49152},[],"Lost or inaccessible key",{"_3185":1140,"_28073":1114,"_19451":49154,"_5":13353,"_26530":49090,"_2682":49155},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3185":1141,"_28073":1114,"_19451":49157,"_5":13353,"_26530":49090,"_2682":49158},[],"Current identity revoked",{"_3185":1142,"_28073":1114,"_19451":49160,"_5":13353,"_26530":49090,"_2682":49161},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3185":1143,"_28073":1114,"_19451":49163,"_5":13353,"_26530":49090,"_2682":49164},[],"Device without an identity",{"_3185":1144,"_28073":1114,"_19451":49166,"_5":13353,"_26530":49090,"_2682":49167},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3185":1145,"_28073":1114,"_19451":49169,"_5":13353,"_26530":49090,"_2682":49170},[],"Retired device",{"_3185":1146,"_28073":1114,"_19451":49172,"_5":13353,"_26530":49090,"_2682":49173},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3185":1147,"_28073":1114,"_19451":49175,"_5":13353,"_26530":49090,"_2682":49176},[],"Timeout, HTTP 500 or installation failure",{"_3185":1148,"_28073":1114,"_19451":49178,"_5":13353,"_26530":49090,"_2682":49179},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3185":1149,"_28073":1114,"_19451":49181,"_5":13353,"_26530":49094,"_2682":49182},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3185":1150,"_28073":1114,"_19451":49184,"_5":13353,"_26530":49094,"_2682":49185},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3185":1151,"_28073":1151,"_5":13700,"_2682":49187,"_28416":49188,"_19451":49189,"_26530":1151},"Enrollment troubleshooting",[45599,47035,48012,48010,48193],[],{"_3185":1152,"_28073":1151,"_19451":49191,"_5":13353,"_26530":1151,"_2682":49192},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3185":1153,"_28073":1151,"_5":28413,"_19451":49194,"_26530":49195,"_2682":49196},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3185":1154,"_28073":1151,"_5":28413,"_19451":49198,"_26530":49199,"_2682":49200},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3185":1155,"_28073":1151,"_5":28413,"_19451":49202,"_26530":49203,"_2682":48750},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3185":1156,"_28073":1151,"_5":28413,"_19451":49205,"_26530":49206,"_2682":49207},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3185":1157,"_28073":1151,"_19451":49209,"_5":13353,"_26530":1151,"_2682":49210},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3185":1158,"_28073":1151,"_19451":49212,"_5":13353,"_26530":49199,"_2682":49213},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3185":1159,"_28073":1151,"_19451":49215,"_5":13353,"_26530":49199,"_2682":49216},[],"Symptom or message",{"_3185":1160,"_28073":1151,"_19451":49218,"_5":13353,"_26530":49199,"_2682":48980},[],{"_3185":1161,"_28073":1151,"_19451":49220,"_5":13353,"_26530":49199,"_2682":49221},[],"curl rejects TLS, name or issuer",{"_3185":1162,"_28073":1151,"_19451":49223,"_5":13353,"_26530":49199,"_2682":49224},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3185":1163,"_28073":1151,"_19451":49226,"_5":13353,"_26530":49199,"_2682":49227},[],"404 or missing APS",{"_3185":1164,"_28073":1151,"_19451":49229,"_5":13353,"_26530":49199,"_2682":49230},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3185":1165,"_28073":1151,"_19451":49232,"_5":13353,"_26530":49199,"_2682":49233},[],"400, CSR or format error",{"_3185":1166,"_28073":1151,"_19451":49235,"_5":13353,"_26530":49199,"_2682":49236},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3185":1167,"_28073":1151,"_19451":49238,"_5":13353,"_26530":49199,"_2682":49239},[],"Missing credential or invalid certificate",{"_3185":1168,"_28073":1151,"_19451":49241,"_5":13353,"_26530":49199,"_2682":49242},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3185":1169,"_28073":1151,"_19451":49244,"_5":13353,"_26530":49199,"_2682":49245},[],"Webhook denies, times out or responds without authorization",{"_3185":1170,"_28073":1151,"_19451":49247,"_5":13353,"_26530":49199,"_2682":49248},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3185":1171,"_28073":1151,"_19451":49250,"_5":13353,"_26530":49199,"_2682":49251},[],"`unexpected status code: <n>: redirects are not followed`",{"_3185":1172,"_28073":1151,"_19451":49253,"_5":13353,"_26530":49199,"_2682":49254},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3185":1173,"_28073":1151,"_19451":49256,"_5":13353,"_26530":49199,"_2682":49257},[],"`webhook response exceeds 1048576 bytes`",{"_3185":1174,"_28073":1151,"_19451":49259,"_5":13353,"_26530":49199,"_2682":49260},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3185":1175,"_28073":1151,"_19451":49262,"_5":13353,"_26530":49199,"_2682":49263},[],"`webhook config must not reference files`",{"_3185":1176,"_28073":1151,"_19451":49265,"_5":13353,"_26530":49199,"_2682":49266},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3185":1177,"_28073":1151,"_19451":49268,"_5":13353,"_26530":49199,"_2682":49269},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3185":1178,"_28073":1151,"_19451":49271,"_5":13353,"_26530":49199,"_2682":49272},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3185":1179,"_28073":1151,"_19451":49274,"_5":13353,"_26530":49199,"_2682":49275},[],"`webhook mTLS certificate and key are invalid: …`",{"_3185":1180,"_28073":1151,"_19451":49277,"_5":13353,"_26530":49199,"_2682":49278},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3185":1181,"_28073":1151,"_19451":49280,"_5":13353,"_26530":49199,"_2682":49281},[],"400 `struct validation error` creating or updating a DMS",{"_3185":1182,"_28073":1151,"_19451":49283,"_5":13353,"_26530":49199,"_2682":49284},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3185":1183,"_28073":1151,"_19451":49286,"_5":13353,"_26530":49199,"_2682":49287},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3185":1184,"_28073":1151,"_19451":49289,"_5":13353,"_26530":49199,"_2682":49290},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3185":1185,"_28073":1151,"_19451":49292,"_5":13353,"_26530":49199,"_2682":49293},[],"`device not preregistered`",{"_3185":1186,"_28073":1151,"_19451":49295,"_5":13353,"_26530":49199,"_2682":49296},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3185":1187,"_28073":1151,"_19451":49298,"_5":13353,"_26530":49199,"_2682":49299},[],"`forbiddenNewEnrollment`",{"_3185":1188,"_28073":1151,"_19451":49301,"_5":13353,"_26530":49199,"_2682":49302},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3185":1189,"_28073":1151,"_19451":49304,"_5":13353,"_26530":49199,"_2682":49305},[],"Different owning DMS",{"_3185":1190,"_28073":1151,"_19451":49307,"_5":13353,"_26530":49199,"_2682":49308},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3185":1191,"_28073":1151,"_19451":49310,"_5":13353,"_26530":49199,"_2682":49311},[],"`invalid RawSubject bytes`",{"_3185":1192,"_28073":1151,"_19451":49313,"_5":13353,"_26530":49199,"_2682":49314},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3185":1193,"_28073":1151,"_19451":49316,"_5":13353,"_26530":49199,"_2682":49317},[],"`invalid reenroll window`",{"_3185":1194,"_28073":1151,"_19451":49319,"_5":13353,"_26530":49199,"_2682":49320},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3185":1195,"_28073":1151,"_19451":49322,"_5":13353,"_26530":49199,"_2682":49323},[],"Current certificate revoked",{"_3185":1196,"_28073":1151,"_19451":49325,"_5":13353,"_26530":49199,"_2682":49326},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3185":1197,"_28073":1151,"_19451":49328,"_5":13353,"_26530":49199,"_2682":49329},[],"CA, profile or signing error",{"_3185":1198,"_28073":1151,"_19451":49331,"_5":13353,"_26530":49199,"_2682":49332},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3185":1199,"_28073":1151,"_19451":49334,"_5":13353,"_26530":49199,"_2682":49335},[],"HTTP 200 without a device connection",{"_3185":1200,"_28073":1151,"_19451":49337,"_5":13353,"_26530":49199,"_2682":49338},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3185":1201,"_28073":1151,"_19451":49340,"_5":13353,"_26530":49199,"_2682":49341},[],"Timeout or error after issuance",{"_3185":1202,"_28073":1151,"_19451":49343,"_5":13353,"_26530":49199,"_2682":49344},[],"New certificates, current slot and previous identity's state before retrying.",{"_3185":1203,"_28073":1151,"_19451":49346,"_5":13353,"_26530":49203,"_2682":49347},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3185":1204,"_28073":1151,"_19451":49349,"_5":13353,"_26530":49203,"_2682":49350},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3185":1205,"_28073":1151,"_19451":49352,"_5":13353,"_26530":49206,"_2682":49353},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3185":1206,"_28073":1151,"_19451":49355,"_5":13353,"_26530":49206,"_2682":49356},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3185":1207,"_28073":1151,"_19451":49358,"_5":13353,"_26530":49206,"_2682":49359},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3185":1208,"_28073":1151,"_19451":49361,"_5":13353,"_26530":49206,"_2682":49362},[],"Make one request, save headers/body and query the device and certificates.",{"_3185":1209,"_28073":1151,"_19451":49364,"_5":13353,"_26530":49206,"_2682":49365},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3185":1210,"_28073":1151,"_19451":49367,"_5":13353,"_26530":49206,"_2682":49368},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3185":1211,"_28073":1151,"_19451":49370,"_5":13353,"_26530":49206,"_2682":49371},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3185":1212,"_28073":1212,"_5":13700,"_2682":49373,"_28416":49374,"_19451":49375,"_26530":1212},"Trust distribution and updates",[45599,47035,48012,48010,48193],[],{"_3185":1213,"_28073":1212,"_19451":49377,"_5":13353,"_26530":1212,"_2682":49378},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3185":1214,"_28073":1212,"_5":28413,"_19451":49380,"_26530":49381,"_2682":49382},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3185":1215,"_28073":1212,"_5":28413,"_19451":49384,"_26530":49385,"_2682":49386},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3185":1216,"_28073":1212,"_5":28413,"_19451":49388,"_26530":49389,"_2682":49390},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3185":1217,"_28073":1212,"_5":28413,"_19451":49392,"_26530":49393,"_2682":49394},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3185":1218,"_28073":1212,"_5":28413,"_19451":49396,"_26530":49397,"_2682":49398},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3185":1219,"_28073":1212,"_19451":49400,"_5":13353,"_26530":1212,"_2682":49401},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3185":1220,"_28073":1212,"_19451":49403,"_5":13353,"_26530":49381,"_2682":49404},[],"Relationship",{"_3185":1221,"_28073":1212,"_19451":49406,"_5":13353,"_26530":49381,"_2682":49407},[],"Material prepared by its owner",{"_3185":1222,"_28073":1212,"_19451":49409,"_5":13353,"_26530":49381,"_2682":49410},[],"Device → EST server",{"_3185":1223,"_28073":1212,"_19451":49412,"_5":13353,"_26530":49381,"_2682":49413},[],"Previously verified server root, chain or pin and TLS name.",{"_3185":1224,"_28073":1212,"_19451":49415,"_5":13353,"_26530":49381,"_2682":49416},[],"DMS → requester",{"_3185":1225,"_28073":1212,"_19451":49418,"_5":13353,"_26530":49381,"_2682":49419},[],"CAs and rules authorizing initial or renewal credentials.",{"_3185":1226,"_28073":1212,"_19451":49421,"_5":13353,"_26530":49381,"_2682":49422},[],"Consumer → device",{"_3185":1227,"_28073":1212,"_19451":49424,"_5":13353,"_26530":49381,"_2682":49425},[],"Operational identity roots, intermediates, validation and permissions.",{"_3185":1228,"_28073":1212,"_19451":49427,"_5":13353,"_26530":49381,"_2682":49428},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3185":1229,"_28073":1212,"_19451":49430,"_5":13353,"_26530":49385,"_2682":49431},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3185":1230,"_28073":1212,"_19451":49433,"_5":13353,"_26530":49385,"_2682":49434},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3185":1231,"_28073":1212,"_19451":49436,"_5":13353,"_26530":49389,"_2682":49437},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3185":1232,"_28073":1212,"_19451":49439,"_5":13353,"_26530":49389,"_2682":49440},[],"Select policy-approved roots as anchors.",{"_3185":1233,"_28073":1212,"_19451":49442,"_5":13353,"_26530":49389,"_2682":49443},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3185":1234,"_28073":1212,"_19451":49445,"_5":13353,"_26530":49389,"_2682":49446},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3185":1235,"_28073":1212,"_19451":49448,"_5":13353,"_26530":49389,"_2682":49449},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3185":1236,"_28073":1212,"_19451":49451,"_5":13353,"_26530":49389,"_2682":49452},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3185":1237,"_28073":1212,"_19451":49454,"_5":13353,"_26530":49393,"_2682":49455},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3185":1238,"_28073":1212,"_19451":49457,"_5":13353,"_26530":49393,"_2682":49458},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3185":1239,"_28073":1212,"_19451":49460,"_5":13353,"_26530":49393,"_2682":49461},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3185":1240,"_28073":1212,"_19451":49463,"_5":13353,"_26530":49397,"_2682":49464},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3185":1241,"_28073":1241,"_5":13700,"_2682":49466,"_28416":49467,"_19451":49469,"_26530":1241},"AWS IoT Core",[45599,47035,48012,48010,49468],"Integrations",[],{"_3185":1242,"_28073":1241,"_19451":49471,"_5":13353,"_26530":1241,"_2682":49472},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3185":1243,"_28073":1241,"_5":28413,"_19451":49474,"_26530":49475,"_2682":49476},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3185":1244,"_28073":1241,"_5":28413,"_19451":49478,"_26530":49479,"_2682":49480},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3185":1245,"_28073":1241,"_5":28413,"_19451":49482,"_26530":49483,"_2682":49484},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3185":1246,"_28073":1241,"_5":28413,"_19451":49486,"_26530":49487,"_2682":49488},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3185":1247,"_28073":1241,"_5":28413,"_19451":49490,"_26530":49491,"_2682":49492},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3185":1248,"_28073":1241,"_5":28413,"_19451":49494,"_26530":49495,"_2682":49496},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3185":1249,"_28073":1241,"_5":28413,"_19451":49498,"_26530":49499,"_2682":49500},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3185":1250,"_28073":1241,"_5":28413,"_19451":49502,"_26530":49503,"_2682":49504},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3185":1251,"_28073":1241,"_5":28413,"_19451":49506,"_26530":49507,"_2682":49508},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3185":1252,"_28073":1241,"_5":28413,"_19451":49510,"_26530":49511,"_2682":49512},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3185":1253,"_28073":1241,"_5":28413,"_19451":49514,"_26530":49515,"_2682":49516},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3185":1254,"_28073":1241,"_5":28413,"_19451":49518,"_26530":49519,"_2682":49520},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3185":1255,"_28073":1241,"_5":28413,"_19451":49522,"_26530":49523,"_2682":49524},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3185":1256,"_28073":1241,"_5":28413,"_19451":49526,"_26530":49527,"_2682":49528},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3185":1257,"_28073":1241,"_5":28413,"_19451":49530,"_26530":49531,"_2682":49532},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3185":1258,"_28073":1241,"_5":28413,"_19451":49534,"_26530":49535,"_2682":49536},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3185":1259,"_28073":1241,"_5":28413,"_19451":49538,"_26530":49539,"_2682":49540},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3185":1260,"_28073":1241,"_5":28413,"_19451":49542,"_26530":49543,"_2682":49544},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3185":1261,"_28073":1241,"_5":28413,"_19451":49546,"_26530":49547,"_2682":49548},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3185":1262,"_28073":1241,"_5":28413,"_19451":49550,"_26530":49551,"_2682":49552},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3185":1263,"_28073":1241,"_19451":49554,"_5":13353,"_26530":1241,"_2682":49555},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3185":1264,"_28073":1241,"_19451":49557,"_5":13353,"_26530":1241,"_2682":49558},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3185":1265,"_28073":1241,"_19451":49560,"_5":13353,"_26530":1241,"_2682":49561},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3185":1266,"_28073":1241,"_19451":49563,"_5":13353,"_26530":49475,"_2682":49564},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3185":1267,"_28073":1241,"_19451":49566,"_5":13353,"_26530":49475,"_2682":49567},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3185":1268,"_28073":1241,"_19451":49569,"_5":13353,"_26530":49475,"_2682":49570},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3185":1269,"_28073":1241,"_19451":49572,"_5":13353,"_26530":49475,"_2682":49573},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3185":1270,"_28073":1241,"_19451":49575,"_5":13353,"_26530":49479,"_2682":49576},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3185":1271,"_28073":1241,"_19451":49578,"_5":13353,"_26530":49483,"_2682":49579},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3185":1272,"_28073":1241,"_19451":49581,"_5":13353,"_26530":49483,"_2682":49582},[],"IAM action",{"_3185":1273,"_28073":1241,"_19451":49584,"_5":13353,"_26530":49483,"_2682":45989},[],{"_3185":1274,"_28073":1241,"_19451":49586,"_5":13353,"_26530":49483,"_2682":49587},[],"`iot:GetRegistrationCode`",{"_3185":1275,"_28073":1241,"_19451":49589,"_5":13353,"_26530":49483,"_2682":49590},[],"Obtain the verification code for CA registration in the Primary Account",{"_3185":1276,"_28073":1241,"_19451":49592,"_5":13353,"_26530":49483,"_2682":49593},[],"`iot:RegisterCACertificate`",{"_3185":1277,"_28073":1241,"_19451":49595,"_5":13353,"_26530":49483,"_2682":49596},[],"Register the CA in AWS IoT",{"_3185":1278,"_28073":1241,"_19451":49598,"_5":13353,"_26530":49483,"_2682":49599},[],"`iot:DescribeCACertificate`",{"_3185":1279,"_28073":1241,"_19451":49601,"_5":13353,"_26530":49483,"_2682":49602},[],"Check the CA registration status",{"_3185":1280,"_28073":1241,"_19451":49604,"_5":13353,"_26530":49483,"_2682":49605},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3185":1281,"_28073":1241,"_19451":49607,"_5":13353,"_26530":49483,"_2682":49608},[],"Create or update Things in IoT Core",{"_3185":1282,"_28073":1241,"_19451":49610,"_5":13353,"_26530":49483,"_2682":49611},[],"`iot:RegisterThing`",{"_3185":1283,"_28073":1241,"_19451":49613,"_5":13353,"_26530":49483,"_2682":49614},[],"Provision Things through a template",{"_3185":1284,"_28073":1241,"_19451":49616,"_5":13353,"_26530":49483,"_2682":49617},[],"`iot:RegisterCertificate`",{"_3185":1285,"_28073":1241,"_19451":49619,"_5":13353,"_26530":49483,"_2682":49620},[],"Register device certificates",{"_3185":1286,"_28073":1241,"_19451":49622,"_5":13353,"_26530":49483,"_2682":49623},[],"`iot:UpdateCertificate`",{"_3185":1287,"_28073":1241,"_19451":49625,"_5":13353,"_26530":49483,"_2682":49626},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3185":1288,"_28073":1241,"_19451":49628,"_5":13353,"_26530":49483,"_2682":49629},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3185":1289,"_28073":1241,"_19451":49631,"_5":13353,"_26530":49483,"_2682":49632},[],"Create and attach IoT policies",{"_3185":1290,"_28073":1241,"_19451":49634,"_5":13353,"_26530":49483,"_2682":49635},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3185":1291,"_28073":1241,"_19451":49637,"_5":13353,"_26530":49483,"_2682":49638},[],"Manage Thing groups",{"_3185":1292,"_28073":1241,"_19451":49640,"_5":13353,"_26530":49483,"_2682":49641},[],"`iot:CreateProvisioningTemplate`",{"_3185":1293,"_28073":1241,"_19451":49643,"_5":13353,"_26530":49483,"_2682":49644},[],"Create JITP templates",{"_3185":1294,"_28073":1241,"_19451":49646,"_5":13353,"_26530":49483,"_2682":49647},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3185":1295,"_28073":1241,"_19451":49649,"_5":13353,"_26530":49483,"_2682":49650},[],"Read and write the Device Shadow",{"_3185":1296,"_28073":1241,"_19451":49652,"_5":13353,"_26530":49483,"_2682":49653},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3185":1297,"_28073":1241,"_19451":49655,"_5":13353,"_26530":49487,"_2682":49656},[],"Parameter",{"_3185":1298,"_28073":1241,"_19451":49658,"_5":13353,"_26530":49487,"_2682":49659},[],"Type",{"_3185":1299,"_28073":1241,"_19451":49661,"_5":13353,"_26530":49487,"_2682":49662},[],"Required",{"_3185":1300,"_28073":1241,"_19451":49664,"_5":13353,"_26530":49487,"_2682":49665},[],"Description",{"_3185":1301,"_28073":1241,"_19451":49667,"_5":13353,"_26530":49487,"_2682":49668},[],"`connector_id`",{"_3185":1302,"_28073":1241,"_19451":49670,"_5":13353,"_26530":49487,"_2682":23260},[],{"_3185":1303,"_28073":1241,"_19451":49672,"_5":13353,"_26530":49487,"_2682":49673},[],"Yes",{"_3185":1304,"_28073":1241,"_19451":49675,"_5":13353,"_26530":49487,"_2682":49676},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3185":1305,"_28073":1241,"_19451":49678,"_5":13353,"_26530":49487,"_2682":49679},[],"`aws_config.region`",{"_3185":1306,"_28073":1241,"_19451":49681,"_5":13353,"_26530":49487,"_2682":23260},[],{"_3185":1307,"_28073":1241,"_19451":49683,"_5":13353,"_26530":49487,"_2682":49673},[],{"_3185":1308,"_28073":1241,"_19451":49685,"_5":13353,"_26530":49487,"_2682":49686},[],"AWS region where the connector operates.",{"_3185":1309,"_28073":1241,"_19451":49688,"_5":13353,"_26530":49487,"_2682":49689},[],"`aws_config.auth_method`",{"_3185":1310,"_28073":1241,"_19451":49691,"_5":13353,"_26530":49487,"_2682":23260},[],{"_3185":1311,"_28073":1241,"_19451":49693,"_5":13353,"_26530":49487,"_2682":49673},[],{"_3185":1312,"_28073":1241,"_19451":49695,"_5":13353,"_26530":49487,"_2682":49696},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3185":1313,"_28073":1241,"_19451":49698,"_5":13353,"_26530":49487,"_2682":49699},[],"`aws_config.access_key_id`",{"_3185":1314,"_28073":1241,"_19451":49701,"_5":13353,"_26530":49487,"_2682":23260},[],{"_3185":1315,"_28073":1241,"_19451":49703,"_5":13353,"_26530":49487,"_2682":49704},[],"Only with `auth_method=static`",{"_3185":1316,"_28073":1241,"_19451":49706,"_5":13353,"_26530":49487,"_2682":49707},[],"AWS access key.",{"_3185":1317,"_28073":1241,"_19451":49709,"_5":13353,"_26530":49487,"_2682":49710},[],"`aws_config.secret_access_key`",{"_3185":1318,"_28073":1241,"_19451":49712,"_5":13353,"_26530":49487,"_2682":23260},[],{"_3185":1319,"_28073":1241,"_19451":49714,"_5":13353,"_26530":49487,"_2682":49704},[],{"_3185":1320,"_28073":1241,"_19451":49716,"_5":13353,"_26530":49487,"_2682":49717},[],"AWS secret key.",{"_3185":1321,"_28073":1241,"_19451":49719,"_5":13353,"_26530":49487,"_2682":49720},[],"`aws_config.session_token`",{"_3185":1322,"_28073":1241,"_19451":49722,"_5":13353,"_26530":49487,"_2682":23260},[],{"_3185":1323,"_28073":1241,"_19451":49724,"_5":13353,"_26530":49487,"_2682":49725},[],"No",{"_3185":1324,"_28073":1241,"_19451":49727,"_5":13353,"_26530":49487,"_2682":49728},[],"Session token (with `auth_method=static`).",{"_3185":1325,"_28073":1241,"_19451":49730,"_5":13353,"_26530":49487,"_2682":49731},[],"`aws_config.role_arn`",{"_3185":1326,"_28073":1241,"_19451":49733,"_5":13353,"_26530":49487,"_2682":23260},[],{"_3185":1327,"_28073":1241,"_19451":49735,"_5":13353,"_26530":49487,"_2682":49736},[],"Only with `auth_method=role`",{"_3185":1328,"_28073":1241,"_19451":49738,"_5":13353,"_26530":49487,"_2682":49739},[],"ARN of the role to assume.",{"_3185":1329,"_28073":1241,"_19451":49741,"_5":13353,"_26530":49487,"_2682":49742},[],"`aws_config.endpoint_url`",{"_3185":1330,"_28073":1241,"_19451":49744,"_5":13353,"_26530":49487,"_2682":23260},[],{"_3185":1331,"_28073":1241,"_19451":49746,"_5":13353,"_26530":49487,"_2682":49725},[],{"_3185":1332,"_28073":1241,"_19451":49748,"_5":13353,"_26530":49487,"_2682":49749},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3185":1333,"_28073":1241,"_19451":49751,"_5":13353,"_26530":49487,"_2682":49752},[],"`subscriber_event_bus`",{"_3185":1334,"_28073":1241,"_19451":49754,"_5":13353,"_26530":49487,"_2682":16388},[],{"_3185":1335,"_28073":1241,"_19451":49756,"_5":13353,"_26530":49487,"_2682":49673},[],{"_3185":1336,"_28073":1241,"_19451":49758,"_5":13353,"_26530":49487,"_2682":49759},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3185":1337,"_28073":1241,"_19451":49761,"_5":13353,"_26530":49487,"_2682":49762},[],"`dms_manager_client`",{"_3185":1338,"_28073":1241,"_19451":49764,"_5":13353,"_26530":49487,"_2682":23260},[],{"_3185":1339,"_28073":1241,"_19451":49766,"_5":13353,"_26530":49487,"_2682":49673},[],{"_3185":1340,"_28073":1241,"_19451":49768,"_5":13353,"_26530":49487,"_2682":49769},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3185":1341,"_28073":1241,"_19451":49771,"_5":13353,"_26530":49487,"_2682":49772},[],"`device_manager_client`",{"_3185":1342,"_28073":1241,"_19451":49774,"_5":13353,"_26530":49487,"_2682":23260},[],{"_3185":1343,"_28073":1241,"_19451":49776,"_5":13353,"_26530":49487,"_2682":49673},[],{"_3185":1344,"_28073":1241,"_19451":49778,"_5":13353,"_26530":49487,"_2682":49779},[],"HTTP URL of Lamassu's Device Manager.",{"_3185":1345,"_28073":1241,"_19451":49781,"_5":13353,"_26530":49487,"_2682":49782},[],"`ca_client`",{"_3185":1346,"_28073":1241,"_19451":49784,"_5":13353,"_26530":49487,"_2682":23260},[],{"_3185":1347,"_28073":1241,"_19451":49786,"_5":13353,"_26530":49487,"_2682":49673},[],{"_3185":1348,"_28073":1241,"_19451":49788,"_5":13353,"_26530":49487,"_2682":49789},[],"HTTP URL of Lamassu's CA service.",{"_3185":1349,"_28073":1241,"_19451":49791,"_5":13353,"_26530":49491,"_2682":49792},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3185":1350,"_28073":1241,"_19451":49794,"_5":13353,"_26530":49495,"_2682":49795},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3185":1351,"_28073":1241,"_19451":49797,"_5":13353,"_26530":49495,"_2682":49798},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3185":1352,"_28073":1241,"_19451":49800,"_5":13353,"_26530":49499,"_2682":49801},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3185":1353,"_28073":1241,"_19451":49803,"_5":13353,"_26530":49499,"_2682":49804},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3185":1354,"_28073":1241,"_19451":49806,"_5":13353,"_26530":49499,"_2682":49807},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3185":1355,"_28073":1241,"_19451":49809,"_5":13353,"_26530":49499,"_2682":49810},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3185":1356,"_28073":1241,"_19451":49812,"_5":13353,"_26530":49499,"_2682":49813},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3185":1357,"_28073":1241,"_19451":49815,"_5":13353,"_26530":49499,"_2682":49816},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3185":1358,"_28073":1241,"_19451":49818,"_5":13353,"_26530":49503,"_2682":49819},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3185":1359,"_28073":1241,"_19451":49821,"_5":13353,"_26530":49507,"_2682":49822},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3185":1360,"_28073":1241,"_19451":49824,"_5":13353,"_26530":49507,"_2682":49825},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3185":1361,"_28073":1241,"_19451":49827,"_5":13353,"_26530":49511,"_2682":49828},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3185":1362,"_28073":1241,"_19451":49830,"_5":13353,"_26530":49515,"_2682":49831},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3185":1363,"_28073":1241,"_19451":49833,"_5":13353,"_26530":49515,"_2682":49834},[],"Creates or updates the IoT policies configured in the DMS.",{"_3185":1364,"_28073":1241,"_19451":49836,"_5":13353,"_26530":49515,"_2682":49837},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3185":1365,"_28073":1241,"_19451":49839,"_5":13353,"_26530":49515,"_2682":49840},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3185":1366,"_28073":1241,"_19451":49842,"_5":13353,"_26530":49515,"_2682":49843},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3185":1367,"_28073":1241,"_19451":49845,"_5":13353,"_26530":49515,"_2682":49846},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3185":1368,"_28073":1241,"_19451":49848,"_5":13353,"_26530":49515,"_2682":49849},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3185":1369,"_28073":1241,"_19451":49851,"_5":13353,"_26530":49519,"_2682":49852},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The template is created when the DMS is created in Lamassu, not at device enrollment, and it is not updated afterwards (see the notice below). From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3185":1370,"_28073":1241,"_19451":49854,"_5":13353,"_26530":49519,"_2682":49855},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3185":1371,"_28073":1241,"_19451":49857,"_5":13353,"_26530":49519,"_2682":49858},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3185":1372,"_28073":1241,"_19451":49860,"_5":13353,"_26530":49519,"_2682":49861},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3185":1373,"_28073":1241,"_19451":49863,"_5":13353,"_26530":49519,"_2682":49864},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3185":1374,"_28073":1241,"_19451":49866,"_5":13353,"_26530":49523,"_2682":49867},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3185":1375,"_28073":1241,"_19451":49869,"_5":13353,"_26530":49523,"_2682":49870},[],"The full flow from the device's perspective is:",{"_3185":1376,"_28073":1241,"_19451":49872,"_5":13353,"_26530":49523,"_2682":49873},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3185":1377,"_28073":1241,"_19451":49875,"_5":13353,"_26530":49527,"_2682":49876},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3185":1378,"_28073":1241,"_19451":49878,"_5":13353,"_26530":49527,"_2682":49879},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3185":1379,"_28073":1241,"_19451":49881,"_5":13353,"_26530":49527,"_2682":49882},[],"For the JITP flow to work correctly:",{"_3185":1380,"_28073":1241,"_19451":49884,"_5":13353,"_26530":49527,"_2682":49885},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3185":1381,"_28073":1241,"_19451":49887,"_5":13353,"_26530":49527,"_2682":49888},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3185":1382,"_28073":1241,"_19451":49890,"_5":13353,"_26530":49527,"_2682":49891},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3185":1383,"_28073":1241,"_19451":49893,"_5":13353,"_26530":49527,"_2682":49894},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3185":1384,"_28073":1241,"_19451":49896,"_5":13353,"_26530":49531,"_2682":49897},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3185":1385,"_28073":1241,"_19451":49899,"_5":13353,"_26530":49531,"_2682":49900},[],"Status in Lamassu",{"_3185":1386,"_28073":1241,"_19451":49902,"_5":13353,"_26530":49531,"_2682":49903},[],"Revocation reason",{"_3185":1387,"_28073":1241,"_19451":49905,"_5":13353,"_26530":49531,"_2682":49906},[],"Status in AWS IoT Core",{"_3185":1388,"_28073":1241,"_19451":49908,"_5":13353,"_26530":49531,"_2682":49909},[],"`Active`",{"_3185":1389,"_28073":1241,"_19451":49911,"_5":13353,"_26530":49531,"_2682":49912},[],"None",{"_3185":1390,"_28073":1241,"_19451":49914,"_5":13353,"_26530":49531,"_2682":49915},[],"`ACTIVE`",{"_3185":1391,"_28073":1241,"_19451":49917,"_5":13353,"_26530":49531,"_2682":49918},[],"`Revoked`",{"_3185":1392,"_28073":1241,"_19451":49920,"_5":13353,"_26530":49531,"_2682":49921},[],"`certificateHold`",{"_3185":1393,"_28073":1241,"_19451":49923,"_5":13353,"_26530":49531,"_2682":49924},[],"`INACTIVE`",{"_3185":1394,"_28073":1241,"_19451":49926,"_5":13353,"_26530":49531,"_2682":49918},[],{"_3185":1395,"_28073":1241,"_19451":49928,"_5":13353,"_26530":49531,"_2682":49929},[],"Any other reason",{"_3185":1396,"_28073":1241,"_19451":49931,"_5":13353,"_26530":49531,"_2682":49932},[],"`REVOKED`",{"_3185":1397,"_28073":1241,"_19451":49934,"_5":13353,"_26530":49531,"_2682":49935},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3185":1398,"_28073":1241,"_19451":49937,"_5":13353,"_26530":49535,"_2682":49938},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3185":1399,"_28073":1241,"_19451":49940,"_5":13353,"_26530":49535,"_2682":49941},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3185":1400,"_28073":1241,"_19451":49943,"_5":13353,"_26530":49535,"_2682":49944},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3185":1401,"_28073":1241,"_19451":49946,"_5":13353,"_26530":49539,"_2682":49947},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3185":1402,"_28073":1241,"_19451":49949,"_5":13353,"_26530":49539,"_2682":49950},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3185":1403,"_28073":1241,"_19451":49952,"_5":13353,"_26530":49543,"_2682":49953},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3185":1404,"_28073":1241,"_19451":49955,"_5":13353,"_26530":49543,"_2682":49956},[],"There are two action types:",{"_3185":1405,"_28073":1241,"_19451":49958,"_5":13353,"_26530":49543,"_2682":49959},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3185":1406,"_28073":1241,"_19451":49961,"_5":13353,"_26530":49543,"_2682":49962},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3185":1407,"_28073":1241,"_19451":49964,"_5":13353,"_26530":49543,"_2682":49965},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3185":1408,"_28073":1241,"_19451":49967,"_5":13353,"_26530":49547,"_2682":49968},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3185":1409,"_28073":1241,"_19451":49970,"_5":13353,"_26530":49547,"_2682":49971},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3185":1410,"_28073":1241,"_19451":49973,"_5":13353,"_26530":49547,"_2682":49974},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3185":1411,"_28073":1241,"_19451":49976,"_5":13353,"_26530":49551,"_2682":49977},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3185":1412,"_28073":1241,"_19451":49979,"_5":13353,"_26530":49551,"_2682":49980},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3185":1413,"_28073":1241,"_19451":49982,"_5":13353,"_26530":49551,"_2682":49983},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3185":1414,"_28073":1241,"_19451":49985,"_5":13353,"_26530":49551,"_2682":49986},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3185":1415,"_28073":1241,"_19451":49988,"_5":13353,"_26530":49551,"_2682":49989},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3185":1416,"_28073":1241,"_19451":49991,"_5":13353,"_26530":49551,"_2682":49992},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3185":1417,"_28073":1241,"_19451":49994,"_5":13353,"_26530":49551,"_2682":49995},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3185":1418,"_28073":1241,"_19451":49997,"_5":13353,"_26530":49551,"_2682":49998},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3185":1419,"_28073":1241,"_19451":50000,"_5":13353,"_26530":49551,"_2682":50001},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3185":1420,"_28073":1241,"_19451":50003,"_5":13353,"_26530":49551,"_2682":50004},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3185":1421,"_28073":1241,"_19451":50006,"_5":13353,"_26530":49551,"_2682":50007},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3185":1422,"_28073":1241,"_19451":50009,"_5":13353,"_26530":49551,"_2682":50010},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3185":1423,"_28073":1241,"_19451":50012,"_5":13353,"_26530":49551,"_2682":50013},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3185":1424,"_28073":1241,"_19451":50015,"_5":13353,"_26530":49551,"_2682":50016},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3185":1425,"_28073":1241,"_19451":50018,"_5":13353,"_26530":49551,"_2682":50019},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3185":1426,"_28073":1241,"_19451":50021,"_5":13353,"_26530":49551,"_2682":50022},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3185":1427,"_28073":1241,"_19451":50024,"_5":13353,"_26530":49551,"_2682":50025},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3185":1428,"_28073":1241,"_19451":50027,"_5":13353,"_26530":49551,"_2682":50028},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3185":1429,"_28073":1241,"_19451":50030,"_5":13353,"_26530":49551,"_2682":50031},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3185":1430,"_28073":1241,"_19451":50033,"_5":13353,"_26530":49551,"_2682":50034},[],"**Cause:** The edit triggers a new attempt to create the JITP template, which already exists in AWS. The attempt fails and the connector's later steps are skipped.",{"_3185":1431,"_28073":1241,"_19451":50036,"_5":13353,"_26530":49551,"_2682":50037},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3185":1432,"_28073":1241,"_19451":50039,"_5":13353,"_26530":49551,"_2682":50040},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3185":1433,"_28073":1241,"_19451":50042,"_5":13353,"_26530":49551,"_2682":50043},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3185":1434,"_28073":1241,"_19451":50045,"_5":13353,"_26530":49551,"_2682":50046},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3185":1435,"_28073":1435,"_5":13700,"_2682":48012,"_28416":50048,"_19451":50049,"_26530":1435},[45599,47035,48012],[],{"_3185":1436,"_28073":1435,"_19451":50051,"_5":13353,"_26530":1435,"_2682":50052},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3185":1437,"_28073":1435,"_5":28413,"_19451":50054,"_26530":50055,"_2682":50056},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#start-here","Start here",{"_3185":1438,"_28073":1435,"_5":28413,"_19451":50058,"_26530":50059,"_2682":48010},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#devices-and-identities",{"_3185":1439,"_28073":1435,"_5":28413,"_19451":50061,"_26530":50062,"_2682":48193},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#enrollment-with-pki",{"_3185":1440,"_28073":1435,"_5":28413,"_19451":50064,"_26530":50065,"_2682":49468},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#integrations",{"_3185":1441,"_28073":1435,"_5":28413,"_19451":50067,"_26530":50068,"_2682":50069},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3185":1442,"_28073":1435,"_19451":50071,"_5":13353,"_26530":1435,"_2682":50072},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3185":1443,"_28073":1435,"_19451":50074,"_5":13353,"_26530":50055,"_2682":50075},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3185":1444,"_28073":1435,"_19451":50077,"_5":13353,"_26530":50055,"_2682":50078},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3185":1445,"_28073":1435,"_19451":50080,"_5":13353,"_26530":50059,"_2682":50081},[],"Resource",{"_3185":1446,"_28073":1435,"_19451":50083,"_5":13353,"_26530":50059,"_2682":50084},[],"What it represents",{"_3185":1447,"_28073":1435,"_19451":50086,"_5":13353,"_26530":50059,"_2682":50087},[],"**Device**",{"_3185":1448,"_28073":1435,"_19451":50089,"_5":13353,"_26530":50059,"_2682":50090},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3185":1449,"_28073":1435,"_19451":50092,"_5":13353,"_26530":50059,"_2682":50093},[],"**Identity**",{"_3185":1450,"_28073":1435,"_19451":50095,"_5":13353,"_26530":50059,"_2682":50096},[],"The device's association with its certificates: an active version and a history.",{"_3185":1451,"_28073":1435,"_19451":50098,"_5":13353,"_26530":50059,"_2682":50099},[],"**DMS**",{"_3185":1452,"_28073":1435,"_19451":50101,"_5":13353,"_26530":50059,"_2682":50102},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3185":1453,"_28073":1435,"_19451":50104,"_5":13353,"_26530":50059,"_2682":50105},[],"**Fleet**",{"_3185":1454,"_28073":1435,"_19451":50107,"_5":13353,"_26530":50059,"_2682":50108},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3185":1455,"_28073":1435,"_19451":50110,"_5":13353,"_26530":50059,"_2682":50111},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3185":1456,"_28073":1435,"_19451":50113,"_5":13353,"_26530":50059,"_2682":50114},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3185":1457,"_28073":1435,"_19451":50116,"_5":13353,"_26530":50062,"_2682":50117},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3185":1458,"_28073":1435,"_19451":50119,"_5":13353,"_26530":50062,"_2682":50120},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3185":1459,"_28073":1435,"_19451":50122,"_5":13353,"_26530":50062,"_2682":50123},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3185":1460,"_28073":1435,"_19451":50125,"_5":13353,"_26530":50062,"_2682":50126},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3185":1461,"_28073":1435,"_19451":50128,"_5":13353,"_26530":50062,"_2682":50129},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3185":1462,"_28073":1435,"_19451":50131,"_5":13353,"_26530":50062,"_2682":50132},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3185":1463,"_28073":1435,"_19451":50134,"_5":13353,"_26530":50062,"_2682":50135},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3185":1464,"_28073":1435,"_19451":50137,"_5":13353,"_26530":50062,"_2682":50138},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3185":1465,"_28073":1435,"_19451":50140,"_5":13353,"_26530":50065,"_2682":50141},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3185":1466,"_28073":1435,"_19451":50143,"_5":13353,"_26530":50065,"_2682":50144},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3185":1467,"_28073":1435,"_19451":50146,"_5":13353,"_26530":50068,"_2682":50147},[],"Participant",{"_3185":1468,"_28073":1435,"_19451":50149,"_5":13353,"_26530":50068,"_2682":50150},[],"Responsibility",{"_3185":1469,"_28073":1435,"_19451":50152,"_5":13353,"_26530":50068,"_2682":50153},[],"PKI administrator",{"_3185":1470,"_28073":1435,"_19451":50155,"_5":13353,"_26530":50068,"_2682":50156},[],"CA, issuance profile, chain and revocation publication.",{"_3185":1471,"_28073":1435,"_19451":50158,"_5":13353,"_26530":50068,"_2682":50159},[],"Provisioning administrator",{"_3185":1472,"_28073":1435,"_19451":50161,"_5":13353,"_26530":50068,"_2682":50162},[],"DMS, admission, authentication per operation and inventory.",{"_3185":1473,"_28073":1435,"_19451":50164,"_5":13353,"_26530":50068,"_2682":50165},[],"Device integrator",{"_3185":1474,"_28073":1435,"_19451":50167,"_5":13353,"_26530":50068,"_2682":50168},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3185":1475,"_28073":1435,"_19451":50170,"_5":13353,"_26530":50068,"_2682":50171},[],"Consumer integrator",{"_3185":1476,"_28073":1435,"_19451":50173,"_5":13353,"_26530":50068,"_2682":50174},[],"Trusted issuers, validation and device permissions in the destination.",{"_3185":1477,"_28073":1435,"_19451":50176,"_5":13353,"_26530":50068,"_2682":50177},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3185":1478,"_28073":1478,"_5":13700,"_2682":50179,"_28416":50180,"_19451":50182,"_26530":1478},"Enroll and connect your first device",[45599,47035,48012,50181],"Getting started",[],{"_3185":1479,"_28073":1478,"_19451":50184,"_5":13353,"_26530":1478,"_2682":50185},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3185":1480,"_28073":1478,"_5":28413,"_19451":50187,"_26530":50188,"_2682":45609},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3185":1481,"_28073":1478,"_5":28413,"_19451":50190,"_26530":50191,"_2682":50192},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3185":1482,"_28073":1478,"_5":28413,"_19451":50194,"_26530":50195,"_2682":50196},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3185":1483,"_28073":1478,"_5":28413,"_19451":50198,"_26530":50199,"_2682":50200},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3185":1484,"_28073":1478,"_5":28413,"_19451":50202,"_26530":50203,"_2682":50204},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3185":1485,"_28073":1478,"_5":28413,"_19451":50206,"_26530":50207,"_2682":50208},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3185":1486,"_28073":1478,"_5":28413,"_19451":50210,"_26530":50211,"_2682":50212},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3185":1487,"_28073":1478,"_5":28413,"_19451":50214,"_26530":50215,"_2682":50216},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3185":1488,"_28073":1478,"_19451":50218,"_5":13353,"_26530":1478,"_2682":50219},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3185":1489,"_28073":1478,"_19451":50221,"_5":13353,"_26530":50188,"_2682":50222},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3185":1490,"_28073":1478,"_19451":50224,"_5":13353,"_26530":50188,"_2682":50225},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3185":1491,"_28073":1478,"_19451":50227,"_5":13353,"_26530":50188,"_2682":50228},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3185":1492,"_28073":1478,"_19451":50230,"_5":13353,"_26530":50188,"_2682":50231},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3185":1493,"_28073":1478,"_19451":50233,"_5":13353,"_26530":50188,"_2682":50234},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3185":1494,"_28073":1478,"_19451":50236,"_5":13353,"_26530":50191,"_2682":50237},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3185":1495,"_28073":1478,"_19451":50239,"_5":13353,"_26530":50191,"_2682":50240},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3185":1496,"_28073":1478,"_19451":50242,"_5":13353,"_26530":50195,"_2682":50243},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3185":1497,"_28073":1478,"_19451":50245,"_5":13353,"_26530":50195,"_2682":50246},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3185":1498,"_28073":1478,"_19451":50248,"_5":13353,"_26530":50195,"_2682":50249},[],"Setting",{"_3185":1499,"_28073":1478,"_19451":50251,"_5":13353,"_26530":50195,"_2682":50252},[],"Evaluation value",{"_3185":1500,"_28073":1478,"_19451":50254,"_5":13353,"_26530":50195,"_2682":50255},[],"Enrollment CA",{"_3185":1501,"_28073":1478,"_19451":50257,"_5":13353,"_26530":50195,"_2682":50258},[],"Issuing root from `device-root.pem`.",{"_3185":1502,"_28073":1478,"_19451":50260,"_5":13353,"_26530":50195,"_2682":48323},[],{"_3185":1503,"_28073":1478,"_19451":50262,"_5":13353,"_26530":50195,"_2682":50263},[],"The 1-hour leaf profile you just prepared.",{"_3185":1504,"_28073":1478,"_19451":50265,"_5":13353,"_26530":50195,"_2682":50266},[],"Protocol / Registration Mode",{"_3185":1505,"_28073":1478,"_19451":50268,"_5":13353,"_26530":50195,"_2682":50269},[],"`EST_RFC7030` / `JITP`.",{"_3185":1506,"_28073":1478,"_19451":50271,"_5":13353,"_26530":50195,"_2682":50272},[],"Verify CSR Signature",{"_3185":1507,"_28073":1478,"_19451":50274,"_5":13353,"_26530":50195,"_2682":50275},[],"Enabled.",{"_3185":1508,"_28073":1478,"_19451":50277,"_5":13353,"_26530":50195,"_2682":50278},[],"Enable Replaceable Enrollment",{"_3185":1509,"_28073":1478,"_19451":50280,"_5":13353,"_26530":50195,"_2682":50281},[],"Disabled; the ID must be new.",{"_3185":1510,"_28073":1478,"_19451":50283,"_5":13353,"_26530":50195,"_2682":50284},[],"Initial authentication",{"_3185":1511,"_28073":1478,"_19451":50286,"_5":13353,"_26530":50195,"_2682":50287},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3185":1512,"_28073":1478,"_19451":50289,"_5":13353,"_26530":50195,"_2682":50290},[],"Renewal authentication",{"_3185":1513,"_28073":1478,"_19451":50292,"_5":13353,"_26530":50195,"_2682":50293},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3185":1514,"_28073":1478,"_19451":50295,"_5":13353,"_26530":50195,"_2682":50296},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3185":1515,"_28073":1478,"_19451":50298,"_5":13353,"_26530":50195,"_2682":50299},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3185":1516,"_28073":1478,"_19451":50301,"_5":13353,"_26530":50195,"_2682":50302},[],"Re-enrollment Delta",{"_3185":1517,"_28073":1478,"_19451":50304,"_5":13353,"_26530":50195,"_2682":50305},[],"1 hour.",{"_3185":1518,"_28073":1478,"_19451":50307,"_5":13353,"_26530":50195,"_2682":50308},[],"Preventive / Critical Delta",{"_3185":1519,"_28073":1478,"_19451":50310,"_5":13353,"_26530":50195,"_2682":50311},[],"30 minutes / 10 minutes.",{"_3185":1520,"_28073":1478,"_19451":50313,"_5":13353,"_26530":50195,"_2682":50314},[],"Revoke on Re-enrollment",{"_3185":1521,"_28073":1478,"_19451":50316,"_5":13353,"_26530":50195,"_2682":50317},[],"Disabled to test the successor before retiring the previous identity.",{"_3185":1522,"_28073":1478,"_19451":50319,"_5":13353,"_26530":50195,"_2682":48331},[],{"_3185":1523,"_28073":1478,"_19451":50321,"_5":13353,"_26530":50195,"_2682":50322},[],"Disabled; the operational key is generated in the client.",{"_3185":1524,"_28073":1478,"_19451":50324,"_5":13353,"_26530":50195,"_2682":50325},[],"CA Distribution",{"_3185":1525,"_28073":1478,"_19451":50327,"_5":13353,"_26530":50195,"_2682":50328},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3185":1526,"_28073":1478,"_19451":50330,"_5":13353,"_26530":50195,"_2682":50331},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_3185":1527,"_28073":1478,"_19451":50333,"_5":13353,"_26530":50199,"_2682":50334},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3185":1528,"_28073":1478,"_19451":50336,"_5":13353,"_26530":50199,"_2682":50337},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3185":1529,"_28073":1478,"_19451":50339,"_5":13353,"_26530":50203,"_2682":50340},[],"Generate a new key and CSR with the selected identifier:",{"_3185":1530,"_28073":1478,"_19451":50342,"_5":13353,"_26530":50203,"_2682":50343},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3185":1531,"_28073":1478,"_19451":50345,"_5":13353,"_26530":50203,"_2682":50346},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3185":1532,"_28073":1478,"_19451":50348,"_5":13353,"_26530":50207,"_2682":50349},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3185":1533,"_28073":1478,"_19451":50351,"_5":13353,"_26530":50207,"_2682":50352},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3185":1534,"_28073":1478,"_19451":50354,"_5":13353,"_26530":50211,"_2682":50355},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3185":1535,"_28073":1478,"_19451":50357,"_5":13353,"_26530":50211,"_2682":50358},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3185":1536,"_28073":1478,"_19451":50360,"_5":13353,"_26530":50211,"_2682":50361},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3185":1537,"_28073":1478,"_19451":50363,"_5":13353,"_26530":50211,"_2682":50364},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3185":1538,"_28073":1478,"_19451":50366,"_5":13353,"_26530":50211,"_2682":50367},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3185":1539,"_28073":1478,"_19451":50369,"_5":13353,"_26530":50215,"_2682":50370},[],"Check",{"_3185":1540,"_28073":1478,"_19451":50372,"_5":13353,"_26530":50215,"_2682":50373},[],"Expected result",{"_3185":1541,"_28073":1478,"_19451":50375,"_5":13353,"_26530":50215,"_2682":50376},[],"Registration",{"_3185":1542,"_28073":1478,"_19451":50378,"_5":13353,"_26530":50215,"_2682":50379},[],"ID created automatically and correct DMS.",{"_3185":1543,"_28073":1478,"_19451":50381,"_5":13353,"_26530":50215,"_2682":50382},[],"Certificate",{"_3185":1544,"_28073":1478,"_19451":50384,"_5":13353,"_26530":50215,"_2682":50385},[],"CN, profile, serial and key verified.",{"_3185":1545,"_28073":1478,"_19451":50387,"_5":13353,"_26530":50215,"_2682":50388},[],"Inventory",{"_3185":1546,"_28073":1478,"_19451":50390,"_5":13353,"_26530":50215,"_2682":50391},[],"Received serial visible as the current identity and in history.",{"_3185":1547,"_28073":1478,"_19451":50393,"_5":13353,"_26530":50215,"_2682":50394},[],"Consumer",{"_3185":1548,"_28073":1478,"_19451":50396,"_5":13353,"_26530":50215,"_2682":50397},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3185":1549,"_28073":1478,"_19451":50399,"_5":13353,"_26530":50215,"_2682":50400},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3185":1550,"_28073":1478,"_19451":50402,"_5":13353,"_26530":50215,"_2682":50403},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3185":1551,"_28073":1551,"_5":13700,"_2682":48028,"_28416":50405,"_19451":50406,"_26530":1551},[45599,47035,48012,50181],[],{"_3185":1552,"_28073":1551,"_19451":50408,"_5":13353,"_26530":1551,"_2682":50409},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3185":1553,"_28073":1551,"_5":28413,"_19451":50411,"_26530":50412,"_2682":45609},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3185":1554,"_28073":1551,"_5":28413,"_19451":50414,"_26530":50415,"_2682":50416},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3185":1555,"_28073":1551,"_5":28413,"_19451":50418,"_26530":50419,"_2682":50420},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3185":1556,"_28073":1551,"_5":28413,"_19451":50422,"_26530":50423,"_2682":50424},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3185":1557,"_28073":1551,"_5":28413,"_19451":50426,"_26530":50427,"_2682":50428},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3185":1558,"_28073":1551,"_5":28413,"_19451":50430,"_26530":50431,"_2682":50432},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3185":1559,"_28073":1551,"_5":28413,"_19451":50434,"_26530":50435,"_2682":50373},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3185":1560,"_28073":1551,"_5":28413,"_19451":50437,"_26530":50438,"_2682":50439},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3185":1561,"_28073":1551,"_5":28413,"_19451":50441,"_26530":50442,"_2682":50443},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3185":1562,"_28073":1551,"_19451":50445,"_5":13353,"_26530":1551,"_2682":50446},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3185":1563,"_28073":1551,"_19451":50448,"_5":13353,"_26530":1551,"_2682":50449},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3185":1564,"_28073":1551,"_19451":50451,"_5":13353,"_26530":50412,"_2682":50452},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3185":1565,"_28073":1551,"_19451":50454,"_5":13353,"_26530":50412,"_2682":50455},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3185":1566,"_28073":1551,"_19451":50457,"_5":13353,"_26530":50412,"_2682":50458},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3185":1567,"_28073":1551,"_19451":50460,"_5":13353,"_26530":50412,"_2682":50461},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3185":1568,"_28073":1551,"_19451":50463,"_5":13353,"_26530":50415,"_2682":50464},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3185":1569,"_28073":1551,"_19451":50466,"_5":13353,"_26530":50415,"_2682":50467},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3185":1570,"_28073":1551,"_19451":50469,"_5":13353,"_26530":50415,"_2682":50470},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3185":1571,"_28073":1551,"_19451":50472,"_5":13353,"_26530":50415,"_2682":50473},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3185":1572,"_28073":1551,"_19451":50475,"_5":13353,"_26530":50415,"_2682":50476},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3185":1573,"_28073":1551,"_19451":50478,"_5":13353,"_26530":50415,"_2682":50479},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3185":1574,"_28073":1551,"_19451":50481,"_5":13353,"_26530":50415,"_2682":50482},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3185":1575,"_28073":1551,"_19451":50484,"_5":13353,"_26530":50415,"_2682":50485},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3185":1576,"_28073":1551,"_19451":50487,"_5":13353,"_26530":50419,"_2682":50488},[],"Open **Managed Devices** and the registration action. Complete:",{"_3185":1577,"_28073":1551,"_19451":50490,"_5":13353,"_26530":50419,"_2682":50491},[],"**Device ID**: `device-001`.",{"_3185":1578,"_28073":1551,"_19451":50493,"_5":13353,"_26530":50419,"_2682":50494},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3185":1579,"_28073":1551,"_19451":50496,"_5":13353,"_26530":50419,"_2682":50497},[],"**Icon** and **Tags**: optional classification.",{"_3185":1580,"_28073":1551,"_19451":50499,"_5":13353,"_26530":50419,"_2682":50500},[],"Confirm registration.",{"_3185":1581,"_28073":1551,"_19451":50502,"_5":13353,"_26530":50423,"_2682":50503},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3185":1582,"_28073":1551,"_19451":50505,"_5":13353,"_26530":50423,"_2682":50506},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3185":1583,"_28073":1551,"_19451":50508,"_5":13353,"_26530":50427,"_2682":50509},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3185":1584,"_28073":1551,"_19451":50511,"_5":13353,"_26530":50427,"_2682":50512},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3185":1585,"_28073":1551,"_19451":50514,"_5":13353,"_26530":50431,"_2682":50515},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3185":1586,"_28073":1551,"_19451":50517,"_5":13353,"_26530":50431,"_2682":50518},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3185":1587,"_28073":1551,"_19451":50520,"_5":13353,"_26530":50435,"_2682":50370},[],{"_3185":1588,"_28073":1551,"_19451":50522,"_5":13353,"_26530":50435,"_2682":50523},[],"Result",{"_3185":1589,"_28073":1551,"_19451":50525,"_5":13353,"_26530":50435,"_2682":50526},[],"Device",{"_3185":1590,"_28073":1551,"_19451":50528,"_5":13353,"_26530":50435,"_2682":50529},[],"`device-001` appears in inventory with the expected DMS.",{"_3185":1591,"_28073":1551,"_19451":50531,"_5":13353,"_26530":50435,"_2682":50532},[],"Current identity",{"_3185":1592,"_28073":1551,"_19451":50534,"_5":13353,"_26530":50435,"_2682":50535},[],"The associated certificate matches the one you verified in PKI.",{"_3185":1593,"_28073":1551,"_19451":50537,"_5":13353,"_26530":50435,"_2682":50538},[],"History",{"_3185":1594,"_28073":1551,"_19451":50540,"_5":13353,"_26530":50435,"_2682":50541},[],"The associated issuance appears with its serial number and dates.",{"_3185":1595,"_28073":1551,"_19451":50543,"_5":13353,"_26530":50435,"_2682":50544},[],"Key and certificate",{"_3185":1596,"_28073":1551,"_19451":50546,"_5":13353,"_26530":50435,"_2682":50547},[],"You have the verified pair ready to install on the device.",{"_3185":1597,"_28073":1551,"_19451":50549,"_5":13353,"_26530":50438,"_2682":50550},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3185":1598,"_28073":1551,"_19451":50552,"_5":13353,"_26530":50438,"_2682":50553},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3185":1599,"_28073":1551,"_19451":50555,"_5":13353,"_26530":50438,"_2682":50556},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3185":1600,"_28073":1551,"_19451":50558,"_5":13353,"_26530":50438,"_2682":50559},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3185":1601,"_28073":1551,"_19451":50561,"_5":13353,"_26530":50442,"_2682":50562},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3185":1602,"_28073":1551,"_19451":50564,"_5":13353,"_26530":50442,"_2682":50565},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3185":1603,"_28073":1551,"_19451":50567,"_5":13353,"_26530":50442,"_2682":50568},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3185":1604,"_28073":1604,"_5":13700,"_2682":50570,"_28416":50571,"_19451":50572,"_26530":1604},"Lamassu IoT Platform",[45599,47035],[],{"_3185":1605,"_28073":1604,"_19451":50574,"_5":13353,"_26530":1604,"_2682":50575},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3185":1606,"_28073":1604,"_5":28413,"_19451":50577,"_26530":50578,"_2682":50056},[],"/docs/pr-preview/pr-42/platform/overview#start-here",{"_3185":1607,"_28073":1604,"_5":28413,"_19451":50580,"_26530":50581,"_2682":50582},[],"/docs/pr-preview/pr-42/platform/overview#choose-your-path","Choose your path",{"_3185":1608,"_28073":1604,"_5":28413,"_19451":50584,"_26530":50585,"_2682":50586},[],"/docs/pr-preview/pr-42/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3185":1609,"_28073":1604,"_5":28413,"_19451":50588,"_26530":50589,"_2682":50590},[],"/docs/pr-preview/pr-42/platform/overview#core-capabilities","Core capabilities",{"_3185":1610,"_28073":1604,"_5":28413,"_19451":50592,"_26530":50593,"_2682":50594},[],"/docs/pr-preview/pr-42/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3185":1611,"_28073":1604,"_5":28413,"_19451":50596,"_26530":50597,"_2682":50598},[],"/docs/pr-preview/pr-42/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3185":1612,"_28073":1604,"_5":28413,"_19451":50600,"_26530":50601,"_2682":50602},[],"/docs/pr-preview/pr-42/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3185":1613,"_28073":1604,"_5":28413,"_19451":50604,"_26530":50605,"_2682":50606},[],"/docs/pr-preview/pr-42/platform/overview#automate-device-identities","Automate device identities",{"_3185":1614,"_28073":1604,"_5":28413,"_19451":50608,"_26530":50609,"_2682":50610},[],"/docs/pr-preview/pr-42/platform/overview#publish-validation-status","Publish validation status",{"_3185":1615,"_28073":1604,"_5":28413,"_19451":50612,"_26530":50613,"_2682":50614},[],"/docs/pr-preview/pr-42/platform/overview#react-to-events","React to events",{"_3185":1616,"_28073":1604,"_5":28413,"_19451":50616,"_26530":50617,"_2682":50618},[],"/docs/pr-preview/pr-42/platform/overview#operational-reference","Operational reference",{"_3185":1617,"_28073":1604,"_19451":50620,"_5":13353,"_26530":1604,"_2682":50621},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3185":1618,"_28073":1604,"_19451":50623,"_5":13353,"_26530":50578,"_2682":50624},[],"Choose the result you need:",{"_3185":1619,"_28073":1604,"_19451":50626,"_5":13353,"_26530":50578,"_2682":50627},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3185":1620,"_28073":1604,"_19451":50629,"_5":13353,"_26530":50578,"_2682":50630},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3185":1621,"_28073":1604,"_19451":50632,"_5":13353,"_26530":50578,"_2682":50633},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3185":1622,"_28073":1604,"_19451":50635,"_5":13353,"_26530":50581,"_2682":50636},[],"Section",{"_3185":1623,"_28073":1604,"_19451":50638,"_5":13353,"_26530":50581,"_2682":50639},[],"What you manage",{"_3185":1624,"_28073":1604,"_19451":50641,"_5":13353,"_26530":50581,"_2682":50642},[],"Entry point",{"_3185":1625,"_28073":1604,"_19451":50644,"_5":13353,"_26530":50581,"_2682":50645},[],"**PKI**",{"_3185":1626,"_28073":1604,"_19451":50647,"_5":13353,"_26530":50581,"_2682":50648},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3185":1627,"_28073":1604,"_19451":50650,"_5":13353,"_26530":50581,"_2682":50651},[],"PKI overview",{"_3185":1628,"_28073":1604,"_19451":50653,"_5":13353,"_26530":50581,"_2682":50654},[],"**IoT Fleets**",{"_3185":1629,"_28073":1604,"_19451":50656,"_5":13353,"_26530":50581,"_2682":50657},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3185":1630,"_28073":1604,"_19451":50659,"_5":13353,"_26530":50581,"_2682":50660},[],"IoT Fleets overview",{"_3185":1631,"_28073":1604,"_19451":50662,"_5":13353,"_26530":50581,"_2682":50663},[],"**Administration**",{"_3185":1632,"_28073":1604,"_19451":50665,"_5":13353,"_26530":50581,"_2682":50666},[],"Operator permissions, audit and event subscriptions.",{"_3185":1633,"_28073":1604,"_19451":50668,"_5":13353,"_26530":50581,"_2682":47033},[],{"_3185":1634,"_28073":1604,"_19451":50670,"_5":13353,"_26530":50581,"_2682":50671},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3185":1635,"_28073":1604,"_19451":50673,"_5":13353,"_26530":50585,"_2682":50674},[],"An identity's journey connects four responsibilities:",{"_3185":1636,"_28073":1604,"_19451":50676,"_5":13353,"_26530":50585,"_2682":50677},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3185":1637,"_28073":1604,"_19451":50679,"_5":13353,"_26530":50585,"_2682":50680},[],"The provisioning administrator configures the DMS and initial trust.",{"_3185":1638,"_28073":1604,"_19451":50682,"_5":13353,"_26530":50585,"_2682":50683},[],"The device client requests a certificate and installs it with the matching key.",{"_3185":1639,"_28073":1604,"_19451":50685,"_5":13353,"_26530":50585,"_2682":50686},[],"The consumer validates the identity and applies its access permissions.",{"_3185":1640,"_28073":1604,"_19451":50688,"_5":13353,"_26530":50585,"_2682":50689},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3185":1641,"_28073":1604,"_19451":50691,"_5":13353,"_26530":50593,"_2682":50692},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3185":1642,"_28073":1604,"_19451":50694,"_5":13353,"_26530":50597,"_2682":50695},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3185":1643,"_28073":1604,"_19451":50697,"_5":13353,"_26530":50601,"_2682":50698},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3185":1644,"_28073":1604,"_19451":50700,"_5":13353,"_26530":50605,"_2682":50701},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3185":1645,"_28073":1604,"_19451":50703,"_5":13353,"_26530":50609,"_2682":50704},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3185":1646,"_28073":1604,"_19451":50706,"_5":13353,"_26530":50613,"_2682":50707},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3185":1647,"_28073":1604,"_19451":50709,"_5":13353,"_26530":50617,"_2682":50150},[],{"_3185":1648,"_28073":1604,"_19451":50711,"_5":13353,"_26530":50617,"_2682":50712},[],"What it prepares or checks",{"_3185":1649,"_28073":1604,"_19451":50714,"_5":13353,"_26530":50617,"_2682":50153},[],{"_3185":1650,"_28073":1604,"_19451":50716,"_5":13353,"_26530":50617,"_2682":50717},[],"Key custody, CA hierarchy, profiles and validation.",{"_3185":1651,"_28073":1604,"_19451":50719,"_5":13353,"_26530":50617,"_2682":50720},[],"Fleet administrator",{"_3185":1652,"_28073":1604,"_19451":50722,"_5":13353,"_26530":50617,"_2682":50723},[],"DMS, device admission, renewal policy and inventory.",{"_3185":1653,"_28073":1604,"_19451":50725,"_5":13353,"_26530":50617,"_2682":50165},[],{"_3185":1654,"_28073":1604,"_19451":50727,"_5":13353,"_26530":50617,"_2682":50728},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3185":1655,"_28073":1604,"_19451":50730,"_5":13353,"_26530":50617,"_2682":50171},[],{"_3185":1656,"_28073":1604,"_19451":50732,"_5":13353,"_26530":50617,"_2682":50733},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3185":1657,"_28073":1604,"_19451":50735,"_5":13353,"_26530":50617,"_2682":50736},[],"Infrastructure operator",{"_3185":1658,"_28073":1604,"_19451":50738,"_5":13353,"_26530":50617,"_2682":50739},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3185":1659,"_28073":1604,"_19451":50741,"_5":13353,"_26530":50617,"_2682":50742},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3185":1660,"_28073":1660,"_5":13700,"_2682":50744,"_28416":50745,"_19451":50748,"_26530":1660},"CA hierarchy and rotation",[45599,47035,50746,50747],"PKI","Keys, authorities and certificates",[],{"_3185":1661,"_28073":1660,"_19451":50750,"_5":13353,"_26530":1660,"_2682":50751},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3185":1662,"_28073":1660,"_5":28413,"_19451":50753,"_26530":50754,"_2682":50755},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3185":1663,"_28073":1660,"_5":28413,"_19451":50757,"_26530":50758,"_2682":50759},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3185":1664,"_28073":1660,"_5":28413,"_19451":50761,"_26530":50762,"_2682":50763},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3185":1665,"_28073":1660,"_5":28413,"_19451":50765,"_26530":50766,"_2682":50767},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3185":1666,"_28073":1660,"_5":28413,"_19451":50769,"_26530":50770,"_2682":50771},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3185":1667,"_28073":1660,"_5":28413,"_19451":50773,"_26530":50774,"_2682":50775},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3185":1668,"_28073":1660,"_5":28413,"_19451":50777,"_26530":50778,"_2682":50779},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3185":1669,"_28073":1660,"_5":28413,"_19451":50781,"_26530":50782,"_2682":50783},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3185":1670,"_28073":1660,"_5":28413,"_19451":50785,"_26530":50786,"_2682":50787},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3185":1671,"_28073":1660,"_5":28413,"_19451":50789,"_26530":50790,"_2682":50791},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3185":1672,"_28073":1660,"_5":28413,"_19451":50793,"_26530":50794,"_2682":50795},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3185":1673,"_28073":1660,"_5":28413,"_19451":50797,"_26530":50798,"_2682":50799},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3185":1674,"_28073":1660,"_19451":50801,"_5":13353,"_26530":1660,"_2682":50802},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3185":1675,"_28073":1660,"_19451":50804,"_5":13353,"_26530":1660,"_2682":50805},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3185":1676,"_28073":1660,"_19451":50807,"_5":13353,"_26530":50754,"_2682":50808},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3185":1677,"_28073":1660,"_19451":50810,"_5":13353,"_26530":50754,"_2682":50811},[],"environment, such as production and preproduction;",{"_3185":1678,"_28073":1660,"_19451":50813,"_5":13353,"_26530":50754,"_2682":50814},[],"owner or operating team;",{"_3185":1679,"_28073":1660,"_19451":50816,"_5":13353,"_26530":50754,"_2682":50817},[],"device family or manufacturing process;",{"_3185":1680,"_28073":1660,"_19451":50819,"_5":13353,"_26530":50754,"_2682":50820},[],"region or regulatory requirement;",{"_3185":1681,"_28073":1660,"_19451":50822,"_5":13353,"_26530":50754,"_2682":50823},[],"cryptographic engine or key policy;",{"_3185":1682,"_28073":1660,"_19451":50825,"_5":13353,"_26530":50754,"_2682":50826},[],"maintenance window and renewal cadence.",{"_3185":1683,"_28073":1660,"_19451":50828,"_5":13353,"_26530":50754,"_2682":50829},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3185":1684,"_28073":1660,"_19451":50831,"_5":13353,"_26530":50754,"_2682":50832},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3185":1685,"_28073":1660,"_19451":50834,"_5":13353,"_26530":50758,"_2682":50835},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3185":1686,"_28073":1660,"_19451":50837,"_5":13353,"_26530":50758,"_2682":50838},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3185":1687,"_28073":1660,"_19451":50840,"_5":13353,"_26530":50758,"_2682":50841},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3185":1688,"_28073":1660,"_19451":50843,"_5":13353,"_26530":50762,"_2682":50844},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3185":1689,"_28073":1660,"_19451":50846,"_5":13353,"_26530":50762,"_2682":50847},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3185":1690,"_28073":1660,"_19451":50849,"_5":13353,"_26530":50762,"_2682":50850},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3185":1691,"_28073":1660,"_19451":50852,"_5":13353,"_26530":50762,"_2682":50853},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3185":1692,"_28073":1660,"_19451":50855,"_5":13353,"_26530":50770,"_2682":50856},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3185":1693,"_28073":1660,"_19451":50858,"_5":13353,"_26530":50774,"_2682":50859},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3185":1694,"_28073":1660,"_19451":50861,"_5":13353,"_26530":50778,"_2682":50862},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3185":1695,"_28073":1660,"_19451":50864,"_5":13353,"_26530":50782,"_2682":50865},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3185":1696,"_28073":1660,"_19451":50867,"_5":13353,"_26530":50786,"_2682":50868},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3185":1697,"_28073":1660,"_19451":50870,"_5":13353,"_26530":50790,"_2682":50871},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3185":1698,"_28073":1660,"_19451":50873,"_5":13353,"_26530":50794,"_2682":50874},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3185":1699,"_28073":1660,"_19451":50876,"_5":13353,"_26530":50794,"_2682":50877},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3185":1700,"_28073":1660,"_19451":50879,"_5":13353,"_26530":50794,"_2682":50880},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3185":1701,"_28073":1660,"_19451":50882,"_5":13353,"_26530":50794,"_2682":50883},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3185":1702,"_28073":1660,"_19451":50885,"_5":13353,"_26530":50798,"_2682":50886},[],"The new chain ends in an anchor installed by the consumer.",{"_3185":1703,"_28073":1660,"_19451":50888,"_5":13353,"_26530":50798,"_2682":50889},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3185":1704,"_28073":1660,"_19451":50891,"_5":13353,"_26530":50798,"_2682":50892},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3185":1705,"_28073":1660,"_19451":50894,"_5":13353,"_26530":50798,"_2682":50895},[],"Re-enrollment accepts the old identity during the planned period.",{"_3185":1706,"_28073":1660,"_19451":50897,"_5":13353,"_26530":50798,"_2682":50898},[],"OCSP and CRL respond for the authorities that remain active.",{"_3185":1707,"_28073":1660,"_19451":50900,"_5":13353,"_26530":50798,"_2682":50901},[],"No DMS is left accidentally issuing from the old CA.",{"_3185":1708,"_28073":1660,"_19451":50903,"_5":13353,"_26530":50798,"_2682":50904},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3185":1709,"_28073":1709,"_5":13700,"_2682":50906,"_28416":50907,"_19451":50908,"_26530":1709},"Certification authorities",[45599,47035,50746,50747],[],{"_3185":1710,"_28073":1709,"_19451":50910,"_5":13353,"_26530":1709,"_2682":50911},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3185":1711,"_28073":1709,"_5":28413,"_19451":50913,"_26530":50914,"_2682":50915},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3185":1712,"_28073":1709,"_5":28413,"_19451":50917,"_26530":50918,"_2682":50919},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3185":1713,"_28073":1709,"_5":28413,"_19451":50921,"_26530":50922,"_2682":45609},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#before-you-begin",{"_3185":1714,"_28073":1709,"_5":28413,"_19451":50924,"_26530":50925,"_2682":50926},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3185":1715,"_28073":1709,"_5":28413,"_19451":50928,"_26530":50929,"_2682":50930},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3185":1716,"_28073":1709,"_5":28413,"_19451":50932,"_26530":50933,"_2682":50934},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3185":1717,"_28073":1709,"_5":28413,"_19451":50936,"_26530":50937,"_2682":50938},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3185":1718,"_28073":1709,"_5":28413,"_19451":50940,"_26530":50941,"_2682":50942},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3185":1719,"_28073":1709,"_5":28413,"_19451":50944,"_26530":50945,"_2682":50946},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3185":1720,"_28073":1709,"_5":28413,"_19451":50948,"_26530":50949,"_2682":50950},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3185":1721,"_28073":1709,"_5":28413,"_19451":50952,"_26530":50953,"_2682":50954},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3185":1722,"_28073":1709,"_5":28413,"_19451":50956,"_26530":50957,"_2682":50958},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3185":1723,"_28073":1709,"_5":28413,"_19451":50960,"_26530":50961,"_2682":50962},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3185":1724,"_28073":1709,"_5":28413,"_19451":50964,"_26530":50965,"_2682":50966},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3185":1725,"_28073":1709,"_5":28413,"_19451":50968,"_26530":50969,"_2682":50970},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3185":1726,"_28073":1709,"_5":28413,"_19451":50972,"_26530":50973,"_2682":50974},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3185":1727,"_28073":1709,"_5":28413,"_19451":50976,"_26530":50977,"_2682":50978},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3185":1728,"_28073":1709,"_5":28413,"_19451":50980,"_26530":50981,"_2682":50982},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3185":1729,"_28073":1709,"_5":28413,"_19451":50984,"_26530":50985,"_2682":50986},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3185":1730,"_28073":1709,"_5":28413,"_19451":50988,"_26530":50989,"_2682":50990},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3185":1731,"_28073":1709,"_5":28413,"_19451":50992,"_26530":50993,"_2682":50994},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3185":1732,"_28073":1709,"_5":28413,"_19451":50996,"_26530":50997,"_2682":50998},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3185":1733,"_28073":1709,"_5":28413,"_19451":51000,"_26530":51001,"_2682":51002},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3185":1734,"_28073":1709,"_19451":51004,"_5":13353,"_26530":1709,"_2682":51005},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3185":1735,"_28073":1709,"_19451":51007,"_5":13353,"_26530":1709,"_2682":51008},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3185":1736,"_28073":1709,"_19451":51010,"_5":13353,"_26530":1709,"_2682":51011},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3185":1737,"_28073":1709,"_19451":51013,"_5":13353,"_26530":50914,"_2682":51014},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3185":1738,"_28073":1709,"_19451":51016,"_5":13353,"_26530":50914,"_2682":51017},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3185":1739,"_28073":1709,"_19451":51019,"_5":13353,"_26530":50914,"_2682":51020},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3185":1740,"_28073":1709,"_19451":51022,"_5":13353,"_26530":50914,"_2682":51023},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3185":1741,"_28073":1709,"_19451":51025,"_5":13353,"_26530":50914,"_2682":51026},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3185":1742,"_28073":1709,"_19451":51028,"_5":13353,"_26530":50922,"_2682":51029},[],"Decide whether the CA will be a root or an intermediate.",{"_3185":1743,"_28073":1709,"_19451":51031,"_5":13353,"_26530":50922,"_2682":51032},[],"Choose the engine that will keep the key.",{"_3185":1744,"_28073":1709,"_19451":51034,"_5":13353,"_26530":50922,"_2682":51035},[],"Define a validity longer than that of the certificates it will issue.",{"_3185":1745,"_28073":1709,"_19451":51037,"_5":13353,"_26530":50922,"_2682":51038},[],"For an intermediate CA, make sure the parent CA is active.",{"_3185":1746,"_28073":1709,"_19451":51040,"_5":13353,"_26530":50925,"_2682":51041},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3185":1747,"_28073":1709,"_19451":51043,"_5":13353,"_26530":50929,"_2682":51044},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3185":1748,"_28073":1709,"_19451":51046,"_5":13353,"_26530":50929,"_2682":51047},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3185":1749,"_28073":1709,"_19451":51049,"_5":13353,"_26530":50933,"_2682":51050},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3185":1750,"_28073":1709,"_19451":51052,"_5":13353,"_26530":50937,"_2682":51053},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3185":1751,"_28073":1709,"_19451":51055,"_5":13353,"_26530":50937,"_2682":51056},[],"`C`: two-letter ISO 3166-1 country code.",{"_3185":1752,"_28073":1709,"_19451":51058,"_5":13353,"_26530":50937,"_2682":51059},[],"`ST`: state or province.",{"_3185":1753,"_28073":1709,"_19451":51061,"_5":13353,"_26530":50937,"_2682":51062},[],"`L`: locality.",{"_3185":1754,"_28073":1709,"_19451":51064,"_5":13353,"_26530":50937,"_2682":51065},[],"`O`: organization.",{"_3185":1755,"_28073":1709,"_19451":51067,"_5":13353,"_26530":50937,"_2682":51068},[],"`OU`: organizational unit.",{"_3185":1756,"_28073":1709,"_19451":51070,"_5":13353,"_26530":50937,"_2682":51071},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3185":1757,"_28073":1709,"_19451":51073,"_5":13353,"_26530":50941,"_2682":51074},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3185":1758,"_28073":1709,"_19451":51076,"_5":13353,"_26530":50941,"_2682":51077},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3185":1759,"_28073":1709,"_19451":51079,"_5":13353,"_26530":50945,"_2682":51080},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3185":1760,"_28073":1709,"_19451":51082,"_5":13353,"_26530":50945,"_2682":51083},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3185":1761,"_28073":1709,"_19451":51085,"_5":13353,"_26530":50949,"_2682":51086},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3185":1762,"_28073":1709,"_19451":51088,"_5":13353,"_26530":50949,"_2682":51089},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3185":1763,"_28073":1709,"_19451":51091,"_5":13353,"_26530":50953,"_2682":51092},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3185":1764,"_28073":1709,"_19451":51094,"_5":13353,"_26530":50957,"_2682":51095},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3185":1765,"_28073":1709,"_19451":51097,"_5":13353,"_26530":50961,"_2682":51098},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3185":1766,"_28073":1709,"_19451":51100,"_5":13353,"_26530":50965,"_2682":51101},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3185":1767,"_28073":1709,"_19451":51103,"_5":13353,"_26530":50969,"_2682":51104},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3185":1768,"_28073":1709,"_19451":51106,"_5":13353,"_26530":50969,"_2682":51107},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3185":1769,"_28073":1709,"_19451":51109,"_5":13353,"_26530":50973,"_2682":51110},[],"Open a CA from the inventory to review:",{"_3185":1770,"_28073":1709,"_19451":51112,"_5":13353,"_26530":50973,"_2682":51113},[],"Status and validity period.",{"_3185":1771,"_28073":1709,"_19451":51115,"_5":13353,"_26530":50973,"_2682":51116},[],"Certificate and chain in PEM format.",{"_3185":1772,"_28073":1709,"_19451":51118,"_5":13353,"_26530":50973,"_2682":51119},[],"Number of active, expired and revoked certificates.",{"_3185":1773,"_28073":1709,"_19451":51121,"_5":13353,"_26530":50973,"_2682":51122},[],"Certificates issued in **Issued Certificates**.",{"_3185":1774,"_28073":1709,"_19451":51124,"_5":13353,"_26530":50973,"_2682":51125},[],"The CRL linked to the authority.",{"_3185":1775,"_28073":1709,"_19451":51127,"_5":13353,"_26530":50973,"_2682":51128},[],"Metadata and the associated cryptographic engine.",{"_3185":1776,"_28073":1709,"_19451":51130,"_5":13353,"_26530":50973,"_2682":51131},[],"You can filter the inventory by name, status and CA type.",{"_3185":1777,"_28073":1709,"_19451":51133,"_5":13353,"_26530":50977,"_2682":51134},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3185":1778,"_28073":1709,"_19451":51136,"_5":13353,"_26530":50977,"_2682":51137},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3185":1779,"_28073":1709,"_19451":51139,"_5":13353,"_26530":50977,"_2682":51140},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3185":1780,"_28073":1709,"_19451":51142,"_5":13353,"_26530":50977,"_2682":51143},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3185":1781,"_28073":1709,"_19451":51145,"_5":13353,"_26530":50981,"_2682":51146},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3185":1782,"_28073":1709,"_19451":51148,"_5":13353,"_26530":50985,"_2682":51149},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3185":1783,"_28073":1709,"_19451":51151,"_5":13353,"_26530":50989,"_2682":51152},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3185":1784,"_28073":1709,"_19451":51154,"_5":13353,"_26530":50993,"_2682":51155},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3185":1785,"_28073":1709,"_19451":51157,"_5":13353,"_26530":50997,"_2682":51158},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3185":1786,"_28073":1709,"_19451":51160,"_5":13353,"_26530":51001,"_2682":51161},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3185":1787,"_28073":1709,"_19451":51163,"_5":13353,"_26530":51001,"_2682":51164},[],"The CA’s VA role is kept but can no longer be edited (see CRL), so adjust its validity, interval and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3185":1788,"_28073":1709,"_19451":51166,"_5":13353,"_26530":51001,"_2682":51167},[],"Lamassu keeps the certificate record of a deleted CA. If another CA with a different certificate but the same serial number is imported later, the import succeeds and Lamassu keeps showing the status, type and issuer of the old certificate. Use certificates with distinct serial numbers and check the result after importing. The import is only rejected when the serial number belongs to an existing CA.",{"_3185":1789,"_28073":1789,"_5":13700,"_2682":51169,"_28416":51170,"_19451":51171,"_26530":1789},"Certificate profiles",[45599,47035,50746,50747],[],{"_3185":1790,"_28073":1789,"_19451":51173,"_5":13353,"_26530":1789,"_2682":51174},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3185":1791,"_28073":1789,"_5":28413,"_19451":51176,"_26530":51177,"_2682":51178},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3185":1792,"_28073":1789,"_5":28413,"_19451":51180,"_26530":51181,"_2682":51182},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#validity","Validity",{"_3185":1793,"_28073":1789,"_5":28413,"_19451":51184,"_26530":51185,"_2682":51186},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3185":1794,"_28073":1789,"_5":28413,"_19451":51188,"_26530":51189,"_2682":51190},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3185":1795,"_28073":1789,"_5":28413,"_19451":51192,"_26530":51193,"_2682":51194},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#subject","Subject",{"_3185":1796,"_28073":1789,"_5":28413,"_19451":51196,"_26530":51197,"_2682":51198},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3185":1797,"_28073":1789,"_5":28413,"_19451":51200,"_26530":51201,"_2682":51202},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3185":1798,"_28073":1789,"_5":28413,"_19451":51204,"_26530":51205,"_2682":51206},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3185":1799,"_28073":1789,"_5":28413,"_19451":51208,"_26530":51209,"_2682":51210},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3185":1800,"_28073":1789,"_5":28413,"_19451":51212,"_26530":51213,"_2682":51214},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3185":1801,"_28073":1789,"_5":28413,"_19451":51216,"_26530":51217,"_2682":51218},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3185":1802,"_28073":1789,"_5":28413,"_19451":51220,"_26530":51221,"_2682":51222},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3185":1803,"_28073":1789,"_5":28413,"_19451":51224,"_26530":51225,"_2682":51226},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3185":1804,"_28073":1789,"_5":28413,"_19451":51228,"_26530":51229,"_2682":51230},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3185":1805,"_28073":1789,"_5":28413,"_19451":51232,"_26530":51233,"_2682":51234},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#design-examples","Design examples",{"_3185":1806,"_28073":1789,"_5":28413,"_19451":51236,"_26530":51237,"_2682":51238},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3185":1807,"_28073":1789,"_19451":51240,"_5":13353,"_26530":1789,"_2682":51241},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3185":1808,"_28073":1789,"_19451":51243,"_5":13353,"_26530":1789,"_2682":51244},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3185":1809,"_28073":1789,"_19451":51246,"_5":13353,"_26530":51181,"_2682":51247},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3185":1810,"_28073":1789,"_19451":51249,"_5":13353,"_26530":51181,"_2682":51250},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3185":1811,"_28073":1789,"_19451":51252,"_5":13353,"_26530":51185,"_2682":51253},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3185":1812,"_28073":1789,"_19451":51255,"_5":13353,"_26530":51189,"_2682":51256},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3185":1813,"_28073":1789,"_19451":51258,"_5":13353,"_26530":51189,"_2682":51259},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3185":1814,"_28073":1789,"_19451":51261,"_5":13353,"_26530":51189,"_2682":51262},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3185":1815,"_28073":1789,"_19451":51264,"_5":13353,"_26530":51193,"_2682":51265},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3185":1816,"_28073":1789,"_19451":51267,"_5":13353,"_26530":51197,"_2682":51268},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3185":1817,"_28073":1789,"_19451":51270,"_5":13353,"_26530":51197,"_2682":51271},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3185":1818,"_28073":1789,"_19451":51273,"_5":13353,"_26530":51201,"_2682":51274},[],"The cryptographic enforcement can:",{"_3185":1819,"_28073":1789,"_19451":51276,"_5":13353,"_26530":51201,"_2682":51277},[],"allow or block RSA keys;",{"_3185":1820,"_28073":1789,"_19451":51279,"_5":13353,"_26530":51201,"_2682":51280},[],"limit the supported RSA sizes;",{"_3185":1821,"_28073":1789,"_19451":51282,"_5":13353,"_26530":51201,"_2682":51283},[],"allow or block ECDSA keys;",{"_3185":1822,"_28073":1789,"_19451":51285,"_5":13353,"_26530":51201,"_2682":51286},[],"limit the supported ECDSA sizes or curves.",{"_3185":1823,"_28073":1789,"_19451":51288,"_5":13353,"_26530":51201,"_2682":51289},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3185":1824,"_28073":1789,"_19451":51291,"_5":13353,"_26530":51205,"_2682":51292},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3185":1825,"_28073":1789,"_19451":51294,"_5":13353,"_26530":51205,"_2682":48759},[],{"_3185":1826,"_28073":1789,"_19451":51296,"_5":13353,"_26530":51205,"_2682":51297},[],"First choice",{"_3185":1827,"_28073":1789,"_19451":51299,"_5":13353,"_26530":51205,"_2682":51300},[],"Second choice",{"_3185":1828,"_28073":1789,"_19451":51302,"_5":13353,"_26530":51205,"_2682":51303},[],"If neither is supplied",{"_3185":1829,"_28073":1789,"_19451":51305,"_5":13353,"_26530":51205,"_2682":51306},[],"Direct signing with a CA",{"_3185":1830,"_28073":1789,"_19451":51308,"_5":13353,"_26530":51205,"_2682":51309},[],"`issuance_profile` embedded in the request",{"_3185":1831,"_28073":1789,"_19451":51311,"_5":13353,"_26530":51205,"_2682":51312},[],"Request `issuance_profile_id`",{"_3185":1832,"_28073":1789,"_19451":51314,"_5":13353,"_26530":51205,"_2682":51315},[],"CA default profile (`profile_id`).",{"_3185":1833,"_28073":1789,"_19451":51317,"_5":13353,"_26530":51205,"_2682":51318},[],"Issuance through a DMS",{"_3185":1834,"_28073":1789,"_19451":51320,"_5":13353,"_26530":51205,"_2682":51321},[],"`settings.issuance_profile_id`",{"_3185":1835,"_28073":1789,"_19451":51323,"_5":13353,"_26530":51205,"_2682":51324},[],"`settings.issuance_profile` embedded in the DMS",{"_3185":1836,"_28073":1789,"_19451":51326,"_5":13353,"_26530":51205,"_2682":51327},[],"Enrollment CA default profile.",{"_3185":1837,"_28073":1789,"_19451":51329,"_5":13353,"_26530":51205,"_2682":51330},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3185":1838,"_28073":1789,"_19451":51332,"_5":13353,"_26530":51205,"_2682":51333},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3185":1839,"_28073":1789,"_19451":51335,"_5":13353,"_26530":51213,"_2682":51336},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3185":1840,"_28073":1789,"_19451":51338,"_5":13353,"_26530":51217,"_2682":51339},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3185":1841,"_28073":1789,"_19451":51341,"_5":13353,"_26530":51221,"_2682":51342},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3185":1842,"_28073":1789,"_19451":51344,"_5":13353,"_26530":51225,"_2682":51345},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3185":1843,"_28073":1789,"_19451":51347,"_5":13353,"_26530":51229,"_2682":51348},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3185":1844,"_28073":1789,"_19451":51350,"_5":13353,"_26530":51229,"_2682":51351},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3185":1845,"_28073":1789,"_19451":51353,"_5":13353,"_26530":51233,"_2682":51354},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3185":1846,"_28073":1789,"_19451":51356,"_5":13353,"_26530":51233,"_2682":51357},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3185":1847,"_28073":1789,"_19451":51359,"_5":13353,"_26530":51233,"_2682":51360},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3185":1848,"_28073":1789,"_19451":51362,"_5":13353,"_26530":51233,"_2682":51363},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3185":1849,"_28073":1789,"_19451":51365,"_5":13353,"_26530":51237,"_2682":51366},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3185":1850,"_28073":1789,"_19451":51368,"_5":13353,"_26530":51237,"_2682":51369},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3185":1851,"_28073":1851,"_5":13700,"_2682":51371,"_28416":51372,"_19451":51374,"_26530":1851},"Certificate validation",[45599,47035,50746,51373],"Validation",[],{"_3185":1852,"_28073":1851,"_19451":51376,"_5":13353,"_26530":1851,"_2682":51377},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3185":1853,"_28073":1851,"_5":28413,"_19451":51379,"_26530":51380,"_2682":51381},[],"/docs/pr-preview/pr-42/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3185":1854,"_28073":1851,"_5":28413,"_19451":51383,"_26530":51384,"_2682":51385},[],"/docs/pr-preview/pr-42/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3185":1855,"_28073":1851,"_5":28413,"_19451":51387,"_26530":51388,"_2682":51389},[],"/docs/pr-preview/pr-42/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3185":1856,"_28073":1851,"_19451":51391,"_5":13353,"_26530":1851,"_2682":51392},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3185":1857,"_28073":1851,"_19451":51394,"_5":13353,"_26530":51380,"_2682":51395},[],"Verify these criteria together:",{"_3185":1858,"_28073":1851,"_19451":51397,"_5":13353,"_26530":51380,"_2682":50370},[],{"_3185":1859,"_28073":1851,"_19451":51399,"_5":13353,"_26530":51380,"_2682":51400},[],"Required result",{"_3185":1860,"_28073":1851,"_19451":51402,"_5":13353,"_26530":51380,"_2682":51403},[],"Chain and signature",{"_3185":1861,"_28073":1851,"_19451":51405,"_5":13353,"_26530":51380,"_2682":51406},[],"Valid chain to a root deliberately installed in the consumer.",{"_3185":1862,"_28073":1851,"_19451":51408,"_5":13353,"_26530":51380,"_2682":51409},[],"Dates",{"_3185":1863,"_28073":1851,"_19451":51411,"_5":13353,"_26530":51380,"_2682":51412},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3185":1864,"_28073":1851,"_19451":51414,"_5":13353,"_26530":51380,"_2682":46707},[],{"_3185":1865,"_28073":1851,"_19451":51416,"_5":13353,"_26530":51380,"_2682":51417},[],"Name, SAN or identifier matches the expected peer.",{"_3185":1866,"_28073":1851,"_19451":51419,"_5":13353,"_26530":51380,"_2682":45989},[],{"_3185":1867,"_28073":1851,"_19451":51421,"_5":13353,"_26530":51380,"_2682":51422},[],"KU, EKU and constraints permit the specific operation.",{"_3185":1868,"_28073":1851,"_19451":51424,"_5":13353,"_26530":51380,"_2682":51425},[],"Revocation",{"_3185":1869,"_28073":1851,"_19451":51427,"_5":13353,"_26530":51380,"_2682":51428},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3185":1870,"_28073":1851,"_19451":51430,"_5":13353,"_26530":51380,"_2682":51431},[],"Authorization",{"_3185":1871,"_28073":1851,"_19451":51433,"_5":13353,"_26530":51380,"_2682":51434},[],"The application permits that identity to perform the action.",{"_3185":1872,"_28073":1851,"_19451":51436,"_5":13353,"_26530":51380,"_2682":51437},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3185":1873,"_28073":1851,"_19451":51439,"_5":13353,"_26530":51384,"_2682":51440},[],"Mechanism",{"_3185":1874,"_28073":1851,"_19451":51442,"_5":13353,"_26530":51384,"_2682":51443},[],"When to use it",{"_3185":1875,"_28073":1851,"_19451":51445,"_5":13353,"_26530":51384,"_2682":51446},[],"What you must maintain",{"_3185":1876,"_28073":1851,"_19451":51448,"_5":13353,"_26530":51384,"_2682":51449},[],"OCSP",{"_3185":1877,"_28073":1851,"_19451":51451,"_5":13353,"_26530":51384,"_2682":51452},[],"Status query for a specific certificate.",{"_3185":1878,"_28073":1851,"_19451":51454,"_5":13353,"_26530":51384,"_2682":51455},[],"Responder access, signature verification and cache/freshness policy.",{"_3185":1879,"_28073":1851,"_19451":51457,"_5":13353,"_26530":51384,"_2682":51458},[],"CRL",{"_3185":1880,"_28073":1851,"_19451":51460,"_5":13353,"_26530":51384,"_2682":51461},[],"Local checks for many certificates or offline operation.",{"_3185":1881,"_28073":1851,"_19451":51463,"_5":13353,"_26530":51384,"_2682":51464},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3185":1882,"_28073":1851,"_19451":51466,"_5":13353,"_26530":51384,"_2682":51467},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3185":1883,"_28073":1851,"_19451":51469,"_5":13353,"_26530":51384,"_2682":51470},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3185":1884,"_28073":1851,"_19451":51472,"_5":13353,"_26530":51388,"_2682":51473},[],"Accept a current, authorized certificate with a known chain.",{"_3185":1885,"_28073":1851,"_19451":51475,"_5":13353,"_26530":51388,"_2682":51476},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3185":1886,"_28073":1851,"_19451":51478,"_5":13353,"_26530":51388,"_2682":51479},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3185":1887,"_28073":1851,"_19451":51481,"_5":13353,"_26530":51388,"_2682":51482},[],"Check that a new connection with that identity is rejected.",{"_3185":1888,"_28073":1851,"_19451":51484,"_5":13353,"_26530":51388,"_2682":51485},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3185":1889,"_28073":1851,"_19451":51487,"_5":13353,"_26530":51388,"_2682":51488},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3185":1890,"_28073":1851,"_19451":51490,"_5":13353,"_26530":51388,"_2682":51491},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3185":1891,"_28073":1851,"_19451":51493,"_5":13353,"_26530":51388,"_2682":51494},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3185":1892,"_28073":1851,"_19451":51496,"_5":13353,"_26530":51388,"_2682":51497},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3185":1893,"_28073":1893,"_5":13700,"_2682":51499,"_28416":51500,"_19451":51501,"_26530":1893},"Certificates",[45599,47035,50746,50747],[],{"_3185":1894,"_28073":1893,"_19451":51503,"_5":13353,"_26530":1893,"_2682":51504},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3185":1895,"_28073":1893,"_5":28413,"_19451":51506,"_26530":51507,"_2682":51508},[],"/docs/pr-preview/pr-42/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3185":1896,"_28073":1893,"_5":28413,"_19451":51510,"_26530":51511,"_2682":51512},[],"/docs/pr-preview/pr-42/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3185":1897,"_28073":1893,"_5":28413,"_19451":51514,"_26530":51515,"_2682":51516},[],"/docs/pr-preview/pr-42/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3185":1898,"_28073":1893,"_5":28413,"_19451":51518,"_26530":51519,"_2682":51520},[],"/docs/pr-preview/pr-42/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3185":1899,"_28073":1893,"_5":28413,"_19451":51522,"_26530":51523,"_2682":51524},[],"/docs/pr-preview/pr-42/platform/pki/certificates#open-the-action","Open the action",{"_3185":1900,"_28073":1893,"_5":28413,"_19451":51526,"_26530":51527,"_2682":51528},[],"/docs/pr-preview/pr-42/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3185":1901,"_28073":1893,"_5":28413,"_19451":51530,"_26530":51531,"_2682":51532},[],"/docs/pr-preview/pr-42/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3185":1902,"_28073":1893,"_5":28413,"_19451":51534,"_26530":51535,"_2682":51536},[],"/docs/pr-preview/pr-42/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3185":1903,"_28073":1893,"_5":28413,"_19451":51538,"_26530":51539,"_2682":51540},[],"/docs/pr-preview/pr-42/platform/pki/certificates#continue","Continue",{"_3185":1904,"_28073":1893,"_19451":51542,"_5":13353,"_26530":1893,"_2682":51543},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3185":1905,"_28073":1893,"_19451":51545,"_5":13353,"_26530":51507,"_2682":51546},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3185":1906,"_28073":1893,"_19451":51548,"_5":13353,"_26530":51507,"_2682":51549},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3185":1907,"_28073":1893,"_19451":51551,"_5":13353,"_26530":51511,"_2682":51552},[],"Download the PEM and inspect it:",{"_3185":1908,"_28073":1893,"_19451":51554,"_5":13353,"_26530":51511,"_2682":51555},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3185":1909,"_28073":1893,"_19451":51557,"_5":13353,"_26530":51515,"_2682":51558},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3185":1910,"_28073":1893,"_19451":51560,"_5":13353,"_26530":51515,"_2682":51561},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3185":1911,"_28073":1893,"_19451":51563,"_5":13353,"_26530":51515,"_2682":51564},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3185":1912,"_28073":1893,"_19451":51566,"_5":13353,"_26530":51515,"_2682":51567},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3185":1913,"_28073":1893,"_19451":51569,"_5":13353,"_26530":51515,"_2682":51570},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3185":1914,"_28073":1893,"_19451":51572,"_5":13353,"_26530":51515,"_2682":51573},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3185":1915,"_28073":1893,"_19451":51575,"_5":13353,"_26530":51515,"_2682":51576},[],"For browser key generation, follow Issue your first certificate.",{"_3185":1916,"_28073":1893,"_19451":51578,"_5":13353,"_26530":51519,"_2682":51579},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3185":1917,"_28073":1893,"_19451":51581,"_5":13353,"_26530":51523,"_2682":51582},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3185":1918,"_28073":1893,"_19451":51584,"_5":13353,"_26530":51527,"_2682":51585},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3185":1919,"_28073":1893,"_19451":51587,"_5":13353,"_26530":51531,"_2682":51588},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3185":1920,"_28073":1893,"_19451":51590,"_5":13353,"_26530":51531,"_2682":51591},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3185":1921,"_28073":1893,"_19451":51593,"_5":13353,"_26530":51531,"_2682":51594},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3185":1922,"_28073":1893,"_19451":51596,"_5":13353,"_26530":51535,"_2682":51597},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3185":1923,"_28073":1893,"_19451":51599,"_5":13353,"_26530":51535,"_2682":51600},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3185":1924,"_28073":1893,"_19451":51602,"_5":13353,"_26530":51535,"_2682":51603},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3185":1925,"_28073":1893,"_19451":51605,"_5":13353,"_26530":51539,"_2682":51606},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3185":1926,"_28073":1893,"_19451":51608,"_5":13353,"_26530":51539,"_2682":51609},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3185":1927,"_28073":1927,"_5":13700,"_2682":51611,"_28416":51612,"_19451":51614,"_26530":1927},"Certificate lifecycle",[45599,47035,50746,51613],"Concepts",[],{"_3185":1928,"_28073":1927,"_19451":51616,"_5":13353,"_26530":1927,"_2682":51617},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3185":1929,"_28073":1927,"_5":28413,"_19451":51619,"_26530":51620,"_2682":51621},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3185":1930,"_28073":1927,"_5":28413,"_19451":51623,"_26530":51624,"_2682":51625},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3185":1931,"_28073":1927,"_5":28413,"_19451":51627,"_26530":51628,"_2682":51629},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3185":1932,"_28073":1927,"_5":28413,"_19451":51631,"_26530":51632,"_2682":51633},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3185":1933,"_28073":1927,"_5":28413,"_19451":51635,"_26530":51636,"_2682":51637},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3185":1934,"_28073":1927,"_5":28413,"_19451":51639,"_26530":51640,"_2682":51641},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3185":1935,"_28073":1927,"_5":28413,"_19451":51643,"_26530":51644,"_2682":51645},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3185":1936,"_28073":1927,"_5":28413,"_19451":51647,"_26530":51648,"_2682":51649},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3185":1937,"_28073":1927,"_5":28413,"_19451":51651,"_26530":51652,"_2682":51653},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3185":1938,"_28073":1927,"_5":28413,"_19451":51655,"_26530":51656,"_2682":51657},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3185":1939,"_28073":1927,"_19451":51659,"_5":13353,"_26530":1927,"_2682":51660},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3185":1940,"_28073":1927,"_19451":51662,"_5":13353,"_26530":51624,"_2682":51663},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3185":1941,"_28073":1927,"_19451":51665,"_5":13353,"_26530":51628,"_2682":51666},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3185":1942,"_28073":1927,"_19451":51668,"_5":13353,"_26530":51632,"_2682":51669},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3185":1943,"_28073":1927,"_19451":51671,"_5":13353,"_26530":51636,"_2682":51672},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3185":1944,"_28073":1927,"_19451":51674,"_5":13353,"_26530":51640,"_2682":51675},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3185":1945,"_28073":1927,"_19451":51677,"_5":13353,"_26530":51644,"_2682":51678},[],"Lamassu persists four X.509 states:",{"_3185":1946,"_28073":1927,"_19451":51680,"_5":13353,"_26530":51644,"_2682":51681},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3185":1947,"_28073":1927,"_19451":51683,"_5":13353,"_26530":51644,"_2682":51684},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3185":1948,"_28073":1927,"_19451":51686,"_5":13353,"_26530":51644,"_2682":51687},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3185":1949,"_28073":1927,"_19451":51689,"_5":13353,"_26530":51644,"_2682":51690},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3185":1950,"_28073":1927,"_19451":51692,"_5":13353,"_26530":51644,"_2682":51693},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3185":1951,"_28073":1927,"_19451":51695,"_5":13353,"_26530":51648,"_2682":51696},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3185":1952,"_28073":1927,"_19451":51698,"_5":13353,"_26530":51648,"_2682":51699},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3185":1953,"_28073":1927,"_19451":51701,"_5":13353,"_26530":51648,"_2682":51702},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3185":1954,"_28073":1927,"_19451":51704,"_5":13353,"_26530":51652,"_2682":51705},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3185":1955,"_28073":1927,"_19451":51707,"_5":13353,"_26530":51652,"_2682":51708},[],"Before confirming:",{"_3185":1956,"_28073":1927,"_19451":51710,"_5":13353,"_26530":51652,"_2682":51711},[],"Identify DMSs, devices and services that trust that chain.",{"_3185":1957,"_28073":1927,"_19451":51713,"_5":13353,"_26530":51652,"_2682":51714},[],"Distribute the new chain of trust.",{"_3185":1958,"_28073":1927,"_19451":51716,"_5":13353,"_26530":51652,"_2682":51717},[],"Reissue the necessary identities.",{"_3185":1959,"_28073":1927,"_19451":51719,"_5":13353,"_26530":51652,"_2682":51720},[],"Check OCSP and CRL from a real consumer.",{"_3185":1960,"_28073":1927,"_19451":51722,"_5":13353,"_26530":51652,"_2682":51723},[],"Revoke the old CA once no legitimate traffic remains.",{"_3185":1961,"_28073":1927,"_19451":51725,"_5":13353,"_26530":51652,"_2682":51726},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3185":1962,"_28073":1927,"_19451":51728,"_5":13353,"_26530":51656,"_2682":51729},[],"Certificates entering the preventive or critical renewal window.",{"_3185":1963,"_28073":1927,"_19451":51731,"_5":13353,"_26530":51656,"_2682":51732},[],"Repeated enrollment or re-enrollment failures.",{"_3185":1964,"_28073":1927,"_19451":51734,"_5":13353,"_26530":51656,"_2682":51735},[],"Status changes and revocation reasons.",{"_3185":1965,"_28073":1927,"_19451":51737,"_5":13353,"_26530":51656,"_2682":51738},[],"OCSP and CRL publication and validity.",{"_3185":1966,"_28073":1927,"_19451":51740,"_5":13353,"_26530":51656,"_2682":51741},[],"Dependencies still presenting a replaced certificate.",{"_3185":1967,"_28073":1927,"_19451":51743,"_5":13353,"_26530":51656,"_2682":51744},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3185":1968,"_28073":1968,"_5":13700,"_2682":51746,"_28416":51747,"_19451":51748,"_26530":1968},"Trust model",[45599,47035,50746,51613],[],{"_3185":1969,"_28073":1968,"_19451":51750,"_5":13353,"_26530":1968,"_2682":51751},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3185":1970,"_28073":1968,"_5":28413,"_19451":51753,"_26530":51754,"_2682":51755},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3185":1971,"_28073":1968,"_5":28413,"_19451":51757,"_26530":51758,"_2682":51759},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3185":1972,"_28073":1968,"_5":28413,"_19451":51761,"_26530":51762,"_2682":51763},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3185":1973,"_28073":1968,"_5":28413,"_19451":51765,"_26530":51766,"_2682":51767},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3185":1974,"_28073":1968,"_5":28413,"_19451":51769,"_26530":51770,"_2682":51771},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3185":1975,"_28073":1968,"_5":28413,"_19451":51773,"_26530":51774,"_2682":51775},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3185":1976,"_28073":1968,"_5":28413,"_19451":51777,"_26530":51778,"_2682":51779},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3185":1977,"_28073":1968,"_5":28413,"_19451":51781,"_26530":51782,"_2682":51783},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3185":1978,"_28073":1968,"_5":28413,"_19451":51785,"_26530":51786,"_2682":51787},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3185":1979,"_28073":1968,"_5":28413,"_19451":51789,"_26530":51790,"_2682":51791},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3185":1980,"_28073":1968,"_19451":51793,"_5":13353,"_26530":1968,"_2682":51794},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3185":1981,"_28073":1968,"_19451":51796,"_5":13353,"_26530":51758,"_2682":51797},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3185":1982,"_28073":1968,"_19451":51799,"_5":13353,"_26530":51762,"_2682":51800},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3185":1983,"_28073":1968,"_19451":51802,"_5":13353,"_26530":51766,"_2682":51803},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3185":1984,"_28073":1968,"_19451":51805,"_5":13353,"_26530":51770,"_2682":51806},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3185":1985,"_28073":1968,"_19451":51808,"_5":13353,"_26530":51774,"_2682":51809},[],"The device proves it can enroll according to the DMS policy.",{"_3185":1986,"_28073":1968,"_19451":51811,"_5":13353,"_26530":51774,"_2682":51812},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3185":1987,"_28073":1968,"_19451":51814,"_5":13353,"_26530":51774,"_2682":51815},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3185":1988,"_28073":1968,"_19451":51817,"_5":13353,"_26530":51774,"_2682":51818},[],"The device installs the certificate and the chain it needs.",{"_3185":1989,"_28073":1968,"_19451":51820,"_5":13353,"_26530":51774,"_2682":51821},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3185":1990,"_28073":1968,"_19451":51823,"_5":13353,"_26530":51774,"_2682":51824},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3185":1991,"_28073":1968,"_19451":51826,"_5":13353,"_26530":51778,"_2682":51827},[],"A DMS relates three sets that are worth designing separately:",{"_3185":1992,"_28073":1968,"_19451":51829,"_5":13353,"_26530":51778,"_2682":51830},[],"**Enrollment CA:** signs the new identities.",{"_3185":1993,"_28073":1968,"_19451":51832,"_5":13353,"_26530":51778,"_2682":51833},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3185":1994,"_28073":1968,"_19451":51835,"_5":13353,"_26530":51778,"_2682":51836},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3185":1995,"_28073":1968,"_19451":51838,"_5":13353,"_26530":51778,"_2682":51839},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3185":1996,"_28073":1968,"_19451":51841,"_5":13353,"_26530":51782,"_2682":51842},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3185":1997,"_28073":1968,"_19451":51844,"_5":13353,"_26530":51782,"_2682":51845},[],"that the current date is between `Not Before` and `Not After`;",{"_3185":1998,"_28073":1968,"_19451":51847,"_5":13353,"_26530":51782,"_2682":51848},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3185":1999,"_28073":1968,"_19451":51850,"_5":13353,"_26530":51782,"_2682":51851},[],"that names, SANs and subject match the expected identity;",{"_3185":2000,"_28073":1968,"_19451":51853,"_5":13353,"_26530":51782,"_2682":51854},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3185":2001,"_28073":1968,"_19451":51856,"_5":13353,"_26530":51782,"_2682":51857},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3185":2002,"_28073":1968,"_19451":51859,"_5":13353,"_26530":51782,"_2682":51860},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3185":2003,"_28073":1968,"_19451":51862,"_5":13353,"_26530":51786,"_2682":51863},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3185":2004,"_28073":1968,"_19451":51865,"_5":13353,"_26530":51790,"_2682":51866},[],"Keep the root out of daily operations, or with very restricted access.",{"_3185":2005,"_28073":1968,"_19451":51868,"_5":13353,"_26530":51790,"_2682":51869},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3185":2006,"_28073":1968,"_19451":51871,"_5":13353,"_26530":51790,"_2682":51872},[],"Assign explicit profiles to every use case.",{"_3185":2007,"_28073":1968,"_19451":51874,"_5":13353,"_26530":51790,"_2682":51875},[],"Distribute the new trust before starting a rotation.",{"_3185":2008,"_28073":1968,"_19451":51877,"_5":13353,"_26530":51790,"_2682":51878},[],"Keep enough overlap to renew a disconnected fleet.",{"_3185":2009,"_28073":1968,"_19451":51880,"_5":13353,"_26530":51790,"_2682":51881},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3185":2010,"_28073":1968,"_19451":51883,"_5":13353,"_26530":51790,"_2682":51884},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3185":2011,"_28073":2011,"_5":13700,"_2682":51886,"_28416":51887,"_19451":51888,"_26530":2011},"Revocation lists (CRL)",[45599,47035,50746,51373],[],{"_3185":2012,"_28073":2011,"_19451":51890,"_5":13353,"_26530":2011,"_2682":51891},[],"Generate and distribute signed lists to validate certificates offline.",{"_3185":2013,"_28073":2011,"_5":28413,"_19451":51893,"_26530":51894,"_2682":51895},[],"/docs/pr-preview/pr-42/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3185":2014,"_28073":2011,"_5":28413,"_19451":51897,"_26530":51898,"_2682":51899},[],"/docs/pr-preview/pr-42/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3185":2015,"_28073":2011,"_5":28413,"_19451":51901,"_26530":51902,"_2682":51903},[],"/docs/pr-preview/pr-42/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3185":2016,"_28073":2011,"_5":28413,"_19451":51905,"_26530":51906,"_2682":51907},[],"/docs/pr-preview/pr-42/platform/pki/crl#crl-contents","CRL contents",{"_3185":2017,"_28073":2011,"_5":28413,"_19451":51909,"_26530":51910,"_2682":51911},[],"/docs/pr-preview/pr-42/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3185":2018,"_28073":2011,"_5":28413,"_19451":51913,"_26530":51914,"_2682":51915},[],"/docs/pr-preview/pr-42/platform/pki/crl#va-role-management-api","VA role management API",{"_3185":2019,"_28073":2011,"_5":28413,"_19451":51917,"_26530":51918,"_2682":51919},[],"/docs/pr-preview/pr-42/platform/pki/crl#from-the-interface","From the interface",{"_3185":2020,"_28073":2011,"_5":28413,"_19451":51921,"_26530":51922,"_2682":51923},[],"/docs/pr-preview/pr-42/platform/pki/crl#references","References",{"_3185":2021,"_28073":2011,"_19451":51925,"_5":13353,"_26530":2011,"_2682":51926},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3185":2022,"_28073":2011,"_19451":51928,"_5":13353,"_26530":51894,"_2682":51929},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3185":2023,"_28073":2011,"_19451":51931,"_5":13353,"_26530":51894,"_2682":51932},[],"`crl_options` field",{"_3185":2024,"_28073":2011,"_19451":51934,"_5":13353,"_26530":51894,"_2682":45989},[],{"_3185":2025,"_28073":2011,"_19451":51936,"_5":13353,"_26530":51894,"_2682":51937},[],"Backend initial value",{"_3185":2026,"_28073":2011,"_19451":51939,"_5":13353,"_26530":51894,"_2682":51940},[],"`validity`",{"_3185":2027,"_28073":2011,"_19451":51942,"_5":13353,"_26530":51894,"_2682":51943},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3185":2028,"_28073":2011,"_19451":51945,"_5":13353,"_26530":51894,"_2682":51946},[],"7 days.",{"_3185":2029,"_28073":2011,"_19451":51948,"_5":13353,"_26530":51894,"_2682":51949},[],"`refresh_interval`",{"_3185":2030,"_28073":2011,"_19451":51951,"_5":13353,"_26530":51894,"_2682":51952},[],"Time since publication that triggers scheduled renewal.",{"_3185":2031,"_28073":2011,"_19451":51954,"_5":13353,"_26530":51894,"_2682":51955},[],"6 days and 23 hours.",{"_3185":2032,"_28073":2011,"_19451":51957,"_5":13353,"_26530":51894,"_2682":51958},[],"`regenerate_on_revoke`",{"_3185":2033,"_28073":2011,"_19451":51960,"_5":13353,"_26530":51894,"_2682":51961},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3185":2034,"_28073":2011,"_19451":51963,"_5":13353,"_26530":51894,"_2682":51964},[],"`true`.",{"_3185":2035,"_28073":2011,"_19451":51966,"_5":13353,"_26530":51894,"_2682":51967},[],"`signer_certificate_serial_number`",{"_3185":2036,"_28073":2011,"_19451":51969,"_5":13353,"_26530":51894,"_2682":51970},[],"Serial number of the existing certificate that signs the CRL.",{"_3185":2037,"_28073":2011,"_19451":51972,"_5":13353,"_26530":51894,"_2682":51973},[],"Serial number of the CA’s current certificate.",{"_3185":2038,"_28073":2011,"_19451":51975,"_5":13353,"_26530":51894,"_2682":51976},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3185":2039,"_28073":2011,"_19451":51978,"_5":13353,"_26530":51894,"_2682":51979},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3185":2040,"_28073":2011,"_19451":51981,"_5":13353,"_26530":51894,"_2682":51982},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API: it can be read but not updated (the API returns 404). Adjust validity, interval and signer before deleting it.",{"_3185":2041,"_28073":2011,"_19451":51984,"_5":13353,"_26530":51894,"_2682":51985},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it.",{"_3185":2042,"_28073":2011,"_19451":51987,"_5":13353,"_26530":51894,"_2682":51988},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3185":2043,"_28073":2011,"_19451":51990,"_5":13353,"_26530":51898,"_2682":51991},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3185":2044,"_28073":2011,"_19451":51993,"_5":13353,"_26530":51898,"_2682":51994},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.3) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3185":2045,"_28073":2011,"_19451":51996,"_5":13353,"_26530":51898,"_2682":51997},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3185":2046,"_28073":2011,"_19451":51999,"_5":13353,"_26530":51898,"_2682":52000},[],"To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. Also restrict the permission to import CAs, because a CA imported with a colliding SKI can leave the legitimate one without a CRL.",{"_3185":2047,"_28073":2011,"_19451":52002,"_5":13353,"_26530":51902,"_2682":52003},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3185":2048,"_28073":2011,"_19451":52005,"_5":13353,"_26530":51902,"_2682":52006},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3185":2049,"_28073":2011,"_19451":52008,"_5":13353,"_26530":51902,"_2682":52009},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3185":2050,"_28073":2011,"_19451":52011,"_5":13353,"_26530":51906,"_2682":52012},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3185":2051,"_28073":2011,"_19451":52014,"_5":13353,"_26530":51906,"_2682":52015},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3185":2052,"_28073":2011,"_19451":52017,"_5":13353,"_26530":51910,"_2682":52018},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3185":2053,"_28073":2011,"_19451":52020,"_5":13353,"_26530":51910,"_2682":52021},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3185":2054,"_28073":2011,"_19451":52023,"_5":13353,"_26530":51910,"_2682":52024},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3185":2055,"_28073":2011,"_19451":52026,"_5":13353,"_26530":51910,"_2682":52027},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3185":2056,"_28073":2011,"_19451":52029,"_5":13353,"_26530":51910,"_2682":52030},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3185":2057,"_28073":2011,"_19451":52032,"_5":13353,"_26530":51914,"_2682":52033},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3185":2058,"_28073":2011,"_19451":52035,"_5":13353,"_26530":51914,"_2682":48762},[],{"_3185":2059,"_28073":2011,"_19451":52037,"_5":13353,"_26530":51914,"_2682":52038},[],"Relative path",{"_3185":2060,"_28073":2011,"_19451":52040,"_5":13353,"_26530":51914,"_2682":48759},[],{"_3185":2061,"_28073":2011,"_19451":52042,"_5":13353,"_26530":51914,"_2682":52043},[],"`GET`",{"_3185":2062,"_28073":2011,"_19451":52045,"_5":13353,"_26530":51914,"_2682":52046},[],"`/v1/roles/{ca-ski}`",{"_3185":2063,"_28073":2011,"_19451":52048,"_5":13353,"_26530":51914,"_2682":52049},[],"Read `crl_options` and `latest_crl`.",{"_3185":2064,"_28073":2011,"_19451":52051,"_5":13353,"_26530":51914,"_2682":52052},[],"`PUT`",{"_3185":2065,"_28073":2011,"_19451":52054,"_5":13353,"_26530":51914,"_2682":52046},[],{"_3185":2066,"_28073":2011,"_19451":52056,"_5":13353,"_26530":51914,"_2682":52057},[],"Replace CRL configuration.",{"_3185":2067,"_28073":2011,"_19451":52059,"_5":13353,"_26530":51914,"_2682":52060},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3185":2068,"_28073":2011,"_19451":52062,"_5":13353,"_26530":51914,"_2682":52063},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3185":2069,"_28073":2011,"_19451":52065,"_5":13353,"_26530":51918,"_2682":52066},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3185":2070,"_28073":2011,"_19451":52068,"_5":13353,"_26530":51922,"_2682":52069},[],"RFC 5280: X.509 and CRL profile.",{"_3185":2071,"_28073":2011,"_19451":52071,"_5":13353,"_26530":51922,"_2682":52072},[],"OpenSSL: openssl-crl.",{"_3185":2072,"_28073":2011,"_19451":52074,"_5":13353,"_26530":51922,"_2682":52075},[],"OpenSSL: openssl-verify.",{"_3185":2073,"_28073":2011,"_19451":52077,"_5":13353,"_26530":51922,"_2682":52078},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3185":2074,"_28073":2011,"_19451":52080,"_5":13353,"_26530":51922,"_2682":52081},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3185":2075,"_28073":2075,"_5":13700,"_2682":52083,"_28416":52084,"_19451":52085,"_26530":2075},"Keys and cryptographic engines",[45599,47035,50746,50747],[],{"_3185":2076,"_28073":2075,"_19451":52087,"_5":13353,"_26530":2075,"_2682":52088},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3185":2077,"_28073":2075,"_5":28413,"_19451":52090,"_26530":52091,"_2682":52092},[],"/docs/pr-preview/pr-42/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3185":2078,"_28073":2075,"_5":28413,"_19451":52094,"_26530":52095,"_2682":52096},[],"/docs/pr-preview/pr-42/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3185":2079,"_28073":2075,"_5":28413,"_19451":52098,"_26530":52099,"_2682":52100},[],"/docs/pr-preview/pr-42/platform/pki/key-management#file-system","File System",{"_3185":2080,"_28073":2075,"_5":28413,"_19451":52102,"_26530":52103,"_2682":52104},[],"/docs/pr-preview/pr-42/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3185":2081,"_28073":2075,"_5":28413,"_19451":52106,"_26530":52107,"_2682":52108},[],"/docs/pr-preview/pr-42/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3185":2082,"_28073":2075,"_5":28413,"_19451":52110,"_26530":52111,"_2682":52112},[],"/docs/pr-preview/pr-42/platform/pki/key-management#aws-kms","AWS KMS",{"_3185":2083,"_28073":2075,"_5":28413,"_19451":52114,"_26530":52115,"_2682":52116},[],"/docs/pr-preview/pr-42/platform/pki/key-management#pkcs11","PKCS#11",{"_3185":2084,"_28073":2075,"_5":28413,"_19451":52118,"_26530":52119,"_2682":52120},[],"/docs/pr-preview/pr-42/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3185":2085,"_28073":2075,"_5":28413,"_19451":52122,"_26530":52123,"_2682":52124},[],"/docs/pr-preview/pr-42/platform/pki/key-management#key-inventory","Key inventory",{"_3185":2086,"_28073":2075,"_5":28413,"_19451":52126,"_26530":52127,"_2682":52128},[],"/docs/pr-preview/pr-42/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3185":2087,"_28073":2075,"_5":28413,"_19451":52130,"_26530":52131,"_2682":52132},[],"/docs/pr-preview/pr-42/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3185":2088,"_28073":2075,"_5":28413,"_19451":52134,"_26530":52135,"_2682":52136},[],"/docs/pr-preview/pr-42/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3185":2089,"_28073":2075,"_5":28413,"_19451":52138,"_26530":52139,"_2682":52140},[],"/docs/pr-preview/pr-42/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3185":2090,"_28073":2075,"_5":28413,"_19451":52142,"_26530":52143,"_2682":52144},[],"/docs/pr-preview/pr-42/platform/pki/key-management#view-details","View details",{"_3185":2091,"_28073":2075,"_5":28413,"_19451":52146,"_26530":52147,"_2682":52148},[],"/docs/pr-preview/pr-42/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3185":2092,"_28073":2075,"_5":28413,"_19451":52150,"_26530":52151,"_2682":52152},[],"/docs/pr-preview/pr-42/platform/pki/key-management#sign","Sign",{"_3185":2093,"_28073":2075,"_5":28413,"_19451":52154,"_26530":52155,"_2682":52156},[],"/docs/pr-preview/pr-42/platform/pki/key-management#verify","Verify",{"_3185":2094,"_28073":2075,"_5":28413,"_19451":52158,"_26530":52159,"_2682":52160},[],"/docs/pr-preview/pr-42/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3185":2095,"_28073":2075,"_5":28413,"_19451":52162,"_26530":52163,"_2682":52164},[],"/docs/pr-preview/pr-42/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3185":2096,"_28073":2075,"_5":28413,"_19451":52166,"_26530":52167,"_2682":52168},[],"/docs/pr-preview/pr-42/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3185":2097,"_28073":2075,"_19451":52170,"_5":13353,"_26530":2075,"_2682":52171},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3185":2098,"_28073":2075,"_19451":52173,"_5":13353,"_26530":2075,"_2682":52174},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3185":2099,"_28073":2075,"_19451":52176,"_5":13353,"_26530":52091,"_2682":52177},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3185":2100,"_28073":2075,"_19451":52179,"_5":13353,"_26530":52091,"_2682":52180},[],"In practice, it lets you:",{"_3185":2101,"_28073":2075,"_19451":52182,"_5":13353,"_26530":52091,"_2682":52183},[],"Generate new key pairs from Lamassu IoT.",{"_3185":2102,"_28073":2075,"_19451":52185,"_5":13353,"_26530":52091,"_2682":52186},[],"Import keys created externally.",{"_3185":2103,"_28073":2075,"_19451":52188,"_5":13353,"_26530":52091,"_2682":52189},[],"Delegate custody and cryptographic operations to external engines.",{"_3185":2104,"_28073":2075,"_19451":52191,"_5":13353,"_26530":52091,"_2682":52192},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3185":2105,"_28073":2075,"_19451":52194,"_5":13353,"_26530":52095,"_2682":52195},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3185":2106,"_28073":2075,"_19451":52197,"_5":13353,"_26530":52095,"_2682":52198},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3185":2107,"_28073":2075,"_19451":52200,"_5":13353,"_26530":52095,"_2682":52201},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3185":2108,"_28073":2075,"_19451":52203,"_5":13353,"_26530":52099,"_2682":52204},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3185":2109,"_28073":2075,"_19451":52206,"_5":13353,"_26530":52103,"_2682":52207},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3185":2110,"_28073":2075,"_19451":52209,"_5":13353,"_26530":52107,"_2682":52210},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3185":2111,"_28073":2075,"_19451":52212,"_5":13353,"_26530":52111,"_2682":52213},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3185":2112,"_28073":2075,"_19451":52215,"_5":13353,"_26530":52115,"_2682":52216},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3185":2113,"_28073":2075,"_19451":52218,"_5":13353,"_26530":52119,"_2682":52219},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3185":2114,"_28073":2075,"_19451":52221,"_5":13353,"_26530":52119,"_2682":52222},[],"Lamassu shows the enabled engines in the console.",{"_3185":2115,"_28073":2075,"_19451":52224,"_5":13353,"_26530":52119,"_2682":52225},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3185":2116,"_28073":2075,"_19451":52227,"_5":13353,"_26530":52119,"_2682":52228},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3185":2117,"_28073":2075,"_19451":52230,"_5":13353,"_26530":52123,"_2682":52231},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3185":2118,"_28073":2075,"_19451":52233,"_5":13353,"_26530":52123,"_2682":52234},[],"The table includes the following fields:",{"_3185":2119,"_28073":2075,"_19451":52236,"_5":13353,"_26530":52123,"_2682":52237},[],"**Name**: descriptive name of the key.",{"_3185":2120,"_28073":2075,"_19451":52239,"_5":13353,"_26530":52123,"_2682":52240},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3185":2121,"_28073":2075,"_19451":52242,"_5":13353,"_26530":52123,"_2682":52243},[],"**Strength**: visual indicator of cryptographic strength.",{"_3185":2122,"_28073":2075,"_19451":52245,"_5":13353,"_26530":52123,"_2682":52246},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3185":2123,"_28073":2075,"_19451":52248,"_5":13353,"_26530":52123,"_2682":52249},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3185":2124,"_28073":2075,"_19451":52251,"_5":13353,"_26530":52123,"_2682":52252},[],"**Aliases**: alternative names associated with the key.",{"_3185":2125,"_28073":2075,"_19451":52254,"_5":13353,"_26530":52123,"_2682":52255},[],"**Tags**: labels for classification and search.",{"_3185":2126,"_28073":2075,"_19451":52257,"_5":13353,"_26530":52123,"_2682":52258},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3185":2127,"_28073":2075,"_19451":52260,"_5":13353,"_26530":52123,"_2682":52261},[],"From this view you also reach the most common actions:",{"_3185":2128,"_28073":2075,"_19451":52263,"_5":13353,"_26530":52123,"_2682":52264},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3185":2129,"_28073":2075,"_19451":52266,"_5":13353,"_26530":52123,"_2682":52267},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3185":2130,"_28073":2075,"_19451":52269,"_5":13353,"_26530":52123,"_2682":52270},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3185":2131,"_28073":2075,"_19451":52272,"_5":13353,"_26530":52123,"_2682":52273},[],"**Delete Key** to remove the key from the system.",{"_3185":2132,"_28073":2075,"_19451":52275,"_5":13353,"_26530":52127,"_2682":52276},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3185":2133,"_28073":2075,"_19451":52278,"_5":13353,"_26530":52131,"_2682":52279},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3185":2134,"_28073":2075,"_19451":52281,"_5":13353,"_26530":52131,"_2682":52282},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3185":2135,"_28073":2075,"_19451":52284,"_5":13353,"_26530":52131,"_2682":52285},[],"**Key Name**: unique and descriptive name.",{"_3185":2136,"_28073":2075,"_19451":52287,"_5":13353,"_26530":52131,"_2682":52288},[],"**Crypto Engine**: engine that will keep the key.",{"_3185":2137,"_28073":2075,"_19451":52290,"_5":13353,"_26530":52131,"_2682":52291},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3185":2138,"_28073":2075,"_19451":52293,"_5":13353,"_26530":52131,"_2682":52294},[],"**Tags**: metadata to classify the key.",{"_3185":2139,"_28073":2075,"_19451":52296,"_5":13353,"_26530":52131,"_2682":52297},[],"**Metadata**: additional information for advanced uses.",{"_3185":2140,"_28073":2075,"_19451":52299,"_5":13353,"_26530":52135,"_2682":52300},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3185":2141,"_28073":2075,"_19451":52302,"_5":13353,"_26530":52135,"_2682":52303},[],"When you have an exportable private key and the destination engine supports import.",{"_3185":2142,"_28073":2075,"_19451":52305,"_5":13353,"_26530":52135,"_2682":52306},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3185":2143,"_28073":2075,"_19451":52308,"_5":13353,"_26530":52135,"_2682":52309},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3185":2144,"_28073":2075,"_19451":52311,"_5":13353,"_26530":52135,"_2682":52312},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3185":2145,"_28073":2075,"_19451":52314,"_5":13353,"_26530":52135,"_2682":52315},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3185":2146,"_28073":2075,"_19451":52317,"_5":13353,"_26530":52135,"_2682":52318},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3185":2147,"_28073":2075,"_19451":52320,"_5":13353,"_26530":52135,"_2682":52321},[],"**Tags**: labels for organization and search.",{"_3185":2148,"_28073":2075,"_19451":52323,"_5":13353,"_26530":52135,"_2682":52324},[],"**Metadata**: additional optional information.",{"_3185":2149,"_28073":2075,"_19451":52326,"_5":13353,"_26530":52135,"_2682":52327},[],"**Private Key (PEM)**: private key in PEM format.",{"_3185":2150,"_28073":2075,"_19451":52329,"_5":13353,"_26530":52135,"_2682":52330},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3185":2151,"_28073":2075,"_19451":52332,"_5":13353,"_26530":52139,"_2682":52333},[],"Each registered key has a detail view and several operational actions.",{"_3185":2152,"_28073":2075,"_19451":52335,"_5":13353,"_26530":52143,"_2682":52336},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3185":2153,"_28073":2075,"_19451":52338,"_5":13353,"_26530":52143,"_2682":52339},[],"The **Overview** tab shows, among others, these fields:",{"_3185":2154,"_28073":2075,"_19451":52341,"_5":13353,"_26530":52143,"_2682":52342},[],"**Key Name**: descriptive name.",{"_3185":2155,"_28073":2075,"_19451":52344,"_5":13353,"_26530":52143,"_2682":52345},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3185":2156,"_28073":2075,"_19451":52347,"_5":13353,"_26530":52143,"_2682":52348},[],"**Tags**: associated labels.",{"_3185":2157,"_28073":2075,"_19451":52350,"_5":13353,"_26530":52143,"_2682":52351},[],"**Aliases**: alternative names.",{"_3185":2158,"_28073":2075,"_19451":52353,"_5":13353,"_26530":52143,"_2682":52354},[],"**Crypto Engine**: engine where the key resides.",{"_3185":2159,"_28073":2075,"_19451":52356,"_5":13353,"_26530":52143,"_2682":52357},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3185":2160,"_28073":2075,"_19451":52359,"_5":13353,"_26530":52143,"_2682":52360},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3185":2161,"_28073":2075,"_19451":52362,"_5":13353,"_26530":52143,"_2682":52363},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3185":2162,"_28073":2075,"_19451":52365,"_5":13353,"_26530":52147,"_2682":52366},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3185":2163,"_28073":2075,"_19451":52368,"_5":13353,"_26530":52147,"_2682":52369},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3185":2164,"_28073":2075,"_19451":52371,"_5":13353,"_26530":52147,"_2682":52372},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3185":2165,"_28073":2075,"_19451":52374,"_5":13353,"_26530":52151,"_2682":52375},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3185":2166,"_28073":2075,"_19451":52377,"_5":13353,"_26530":52151,"_2682":52378},[],"Main fields:",{"_3185":2167,"_28073":2075,"_19451":52380,"_5":13353,"_26530":52151,"_2682":52381},[],"**Algorithm**: signing algorithm available for the key type.",{"_3185":2168,"_28073":2075,"_19451":52383,"_5":13353,"_26530":52151,"_2682":52384},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3185":2169,"_28073":2075,"_19451":52386,"_5":13353,"_26530":52151,"_2682":52387},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3185":2170,"_28073":2075,"_19451":52389,"_5":13353,"_26530":52151,"_2682":52390},[],"**Message**: content to sign.",{"_3185":2171,"_28073":2075,"_19451":52392,"_5":13353,"_26530":52151,"_2682":52393},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3185":2172,"_28073":2075,"_19451":52395,"_5":13353,"_26530":52155,"_2682":52396},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3185":2173,"_28073":2075,"_19451":52398,"_5":13353,"_26530":52155,"_2682":52378},[],{"_3185":2174,"_28073":2075,"_19451":52400,"_5":13353,"_26530":52155,"_2682":52401},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3185":2175,"_28073":2075,"_19451":52403,"_5":13353,"_26530":52155,"_2682":52404},[],"**Message Type**: `Raw` or `Digest`.",{"_3185":2176,"_28073":2075,"_19451":52406,"_5":13353,"_26530":52155,"_2682":52407},[],"**Payload Encoding**: encoding of the message.",{"_3185":2177,"_28073":2075,"_19451":52409,"_5":13353,"_26530":52155,"_2682":52410},[],"**Message**: original message or hash.",{"_3185":2178,"_28073":2075,"_19451":52412,"_5":13353,"_26530":52155,"_2682":52413},[],"**Signature**: signature to check.",{"_3185":2179,"_28073":2075,"_19451":52415,"_5":13353,"_26530":52155,"_2682":52416},[],"**Result**: indicator of the validation result.",{"_3185":2180,"_28073":2075,"_19451":52418,"_5":13353,"_26530":52159,"_2682":52419},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3185":2181,"_28073":2075,"_19451":52421,"_5":13353,"_26530":52159,"_2682":52422},[],"This flow is useful for:",{"_3185":2182,"_28073":2075,"_19451":52424,"_5":13353,"_26530":52159,"_2682":52425},[],"Requesting certificates from an external CA.",{"_3185":2183,"_28073":2075,"_19451":52427,"_5":13353,"_26530":52159,"_2682":52428},[],"Renewing an identity while keeping the same key.",{"_3185":2184,"_28073":2075,"_19451":52430,"_5":13353,"_26530":52159,"_2682":52431},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3185":2185,"_28073":2075,"_19451":52433,"_5":13353,"_26530":52159,"_2682":52434},[],"**Common Name (CN)**: main name of the identity.",{"_3185":2186,"_28073":2075,"_19451":52436,"_5":13353,"_26530":52159,"_2682":52437},[],"**Organization (O)**: organization or company.",{"_3185":2187,"_28073":2075,"_19451":52439,"_5":13353,"_26530":52159,"_2682":52440},[],"**Organizational Unit (OU)**: department or unit.",{"_3185":2188,"_28073":2075,"_19451":52442,"_5":13353,"_26530":52159,"_2682":52443},[],"**Country (C)**: two-letter country code.",{"_3185":2189,"_28073":2075,"_19451":52445,"_5":13353,"_26530":52159,"_2682":52446},[],"**State / Province (ST)**: state or province.",{"_3185":2190,"_28073":2075,"_19451":52448,"_5":13353,"_26530":52159,"_2682":52449},[],"**Locality (L)**: city or locality.",{"_3185":2191,"_28073":2075,"_19451":52451,"_5":13353,"_26530":52159,"_2682":52452},[],"**Email Address**: contact email.",{"_3185":2192,"_28073":2075,"_19451":52454,"_5":13353,"_26530":52159,"_2682":52455},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3185":2193,"_28073":2075,"_19451":52457,"_5":13353,"_26530":52159,"_2682":52458},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3185":2194,"_28073":2075,"_19451":52460,"_5":13353,"_26530":52163,"_2682":52461},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3185":2195,"_28073":2075,"_19451":52463,"_5":13353,"_26530":52163,"_2682":52464},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3185":2196,"_28073":2075,"_19451":52466,"_5":13353,"_26530":52167,"_2682":52467},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3185":2197,"_28073":2197,"_5":13700,"_2682":52469,"_28416":52470,"_19451":52471,"_26530":2197},"Online validation with OCSP",[45599,47035,50746,51373],[],{"_3185":2198,"_28073":2197,"_19451":52473,"_5":13353,"_26530":2197,"_2682":52474},[],"Query signed status and verify the responder’s response.",{"_3185":2199,"_28073":2197,"_5":28413,"_19451":52476,"_26530":52477,"_2682":52478},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3185":2200,"_28073":2197,"_5":28413,"_19451":52480,"_26530":52481,"_2682":52482},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3185":2201,"_28073":2197,"_5":28413,"_19451":52484,"_26530":52485,"_2682":52486},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3185":2202,"_28073":2197,"_5":28413,"_19451":52488,"_26530":52489,"_2682":52490},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3185":2203,"_28073":2197,"_5":28413,"_19451":52492,"_26530":52493,"_2682":52494},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3185":2204,"_28073":2197,"_5":28413,"_19451":52496,"_26530":52497,"_2682":51923},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#references",{"_3185":2205,"_28073":2197,"_19451":52499,"_5":13353,"_26530":2197,"_2682":52500},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3185":2206,"_28073":2197,"_19451":52502,"_5":13353,"_26530":52477,"_2682":52503},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3185":2207,"_28073":2197,"_19451":52505,"_5":13353,"_26530":52477,"_2682":52506},[],"Record status",{"_3185":2208,"_28073":2197,"_19451":52508,"_5":13353,"_26530":52477,"_2682":52509},[],"Signed response",{"_3185":2209,"_28073":2197,"_19451":52511,"_5":13353,"_26530":52477,"_2682":49915},[],{"_3185":2210,"_28073":2197,"_19451":52513,"_5":13353,"_26530":52477,"_2682":52514},[],"`Good`.",{"_3185":2211,"_28073":2197,"_19451":52516,"_5":13353,"_26530":52477,"_2682":49932},[],{"_3185":2212,"_28073":2197,"_19451":52518,"_5":13353,"_26530":52477,"_2682":52519},[],"`Revoked`, with revocation reason and timestamp.",{"_3185":2213,"_28073":2197,"_19451":52521,"_5":13353,"_26530":52477,"_2682":52522},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3185":2214,"_28073":2197,"_19451":52524,"_5":13353,"_26530":52477,"_2682":52525},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3185":2215,"_28073":2197,"_19451":52527,"_5":13353,"_26530":52477,"_2682":52528},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3185":2216,"_28073":2197,"_19451":52530,"_5":13353,"_26530":52477,"_2682":52531},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3185":2217,"_28073":2197,"_19451":52533,"_5":13353,"_26530":52477,"_2682":52534},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3185":2218,"_28073":2197,"_19451":52536,"_5":13353,"_26530":52481,"_2682":52537},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3185":2219,"_28073":2197,"_19451":52539,"_5":13353,"_26530":52481,"_2682":52540},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3185":2220,"_28073":2197,"_19451":52542,"_5":13353,"_26530":52485,"_2682":52543},[],"The service accepts:",{"_3185":2221,"_28073":2197,"_19451":52545,"_5":13353,"_26530":52485,"_2682":48762},[],{"_3185":2222,"_28073":2197,"_19451":52547,"_5":13353,"_26530":52485,"_2682":52548},[],"VA service path",{"_3185":2223,"_28073":2197,"_19451":52550,"_5":13353,"_26530":52485,"_2682":52551},[],"Format",{"_3185":2224,"_28073":2197,"_19451":52553,"_5":13353,"_26530":52485,"_2682":52554},[],"`POST`",{"_3185":2225,"_28073":2197,"_19451":52556,"_5":13353,"_26530":52485,"_2682":52557},[],"`/ocsp`",{"_3185":2226,"_28073":2197,"_19451":52559,"_5":13353,"_26530":52485,"_2682":52560},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3185":2227,"_28073":2197,"_19451":52562,"_5":13353,"_26530":52485,"_2682":52043},[],{"_3185":2228,"_28073":2197,"_19451":52564,"_5":13353,"_26530":52485,"_2682":52565},[],"`/ocsp/{ocsp_request}`",{"_3185":2229,"_28073":2197,"_19451":52567,"_5":13353,"_26530":52485,"_2682":52568},[],"DER request encoded using padded URL Base64.",{"_3185":2230,"_28073":2197,"_19451":52570,"_5":13353,"_26530":52485,"_2682":52571},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3185":2231,"_28073":2197,"_19451":52573,"_5":13353,"_26530":52489,"_2682":52574},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3185":2232,"_28073":2197,"_19451":52576,"_5":13353,"_26530":52489,"_2682":52577},[],"Generate the request:",{"_3185":2233,"_28073":2197,"_19451":52579,"_5":13353,"_26530":52489,"_2682":52580},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3185":2234,"_28073":2197,"_19451":52582,"_5":13353,"_26530":52489,"_2682":52583},[],"Replace the example URL with the inspected endpoint:",{"_3185":2235,"_28073":2197,"_19451":52585,"_5":13353,"_26530":52489,"_2682":52586},[],"Verify the returned DER:",{"_3185":2236,"_28073":2197,"_19451":52588,"_5":13353,"_26530":52489,"_2682":52589},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3185":2237,"_28073":2197,"_19451":52591,"_5":13353,"_26530":52493,"_2682":52592},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3185":2238,"_28073":2197,"_19451":52594,"_5":13353,"_26530":52493,"_2682":52595},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3185":2239,"_28073":2197,"_19451":52597,"_5":13353,"_26530":52497,"_2682":52598},[],"RFC 6960: OCSP.",{"_3185":2240,"_28073":2197,"_19451":52600,"_5":13353,"_26530":52497,"_2682":52601},[],"OpenSSL: openssl-ocsp.",{"_3185":2241,"_28073":2197,"_19451":52603,"_5":13353,"_26530":52497,"_2682":52604},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3185":2242,"_28073":2197,"_19451":52606,"_5":13353,"_26530":52497,"_2682":52081},[],{"_3185":2243,"_28073":2243,"_5":13700,"_2682":50746,"_28416":52608,"_19451":52609,"_26530":2243},[45599,47035,50746],[],{"_3185":2244,"_28073":2243,"_19451":52611,"_5":13353,"_26530":2243,"_2682":52612},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3185":2245,"_28073":2243,"_5":28413,"_19451":52614,"_26530":52615,"_2682":50056},[],"/docs/pr-preview/pr-42/platform/pki/overview#start-here",{"_3185":2246,"_28073":2243,"_5":28413,"_19451":52617,"_26530":52618,"_2682":52619},[],"/docs/pr-preview/pr-42/platform/pki/overview#what-you-need","What you need",{"_3185":2247,"_28073":2243,"_5":28413,"_19451":52621,"_26530":52622,"_2682":50590},[],"/docs/pr-preview/pr-42/platform/pki/overview#core-capabilities",{"_3185":2248,"_28073":2243,"_5":28413,"_19451":52624,"_26530":52625,"_2682":50594},[],"/docs/pr-preview/pr-42/platform/pki/overview#build-your-trust-hierarchy",{"_3185":2249,"_28073":2243,"_5":28413,"_19451":52627,"_26530":52628,"_2682":50598},[],"/docs/pr-preview/pr-42/platform/pki/overview#protect-cryptographic-keys",{"_3185":2250,"_28073":2243,"_5":28413,"_19451":52630,"_26530":52631,"_2682":50602},[],"/docs/pr-preview/pr-42/platform/pki/overview#issue-and-control-certificates",{"_3185":2251,"_28073":2243,"_5":28413,"_19451":52633,"_26530":52634,"_2682":50610},[],"/docs/pr-preview/pr-42/platform/pki/overview#publish-validation-status",{"_3185":2252,"_28073":2243,"_5":28413,"_19451":52636,"_26530":52637,"_2682":52638},[],"/docs/pr-preview/pr-42/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3185":2253,"_28073":2243,"_5":28413,"_19451":52640,"_26530":52641,"_2682":51540},[],"/docs/pr-preview/pr-42/platform/pki/overview#continue",{"_3185":2254,"_28073":2243,"_19451":52643,"_5":13353,"_26530":2243,"_2682":52644},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3185":2255,"_28073":2243,"_19451":52646,"_5":13353,"_26530":52615,"_2682":52647},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3185":2256,"_28073":2243,"_19451":52649,"_5":13353,"_26530":52615,"_2682":52650},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3185":2257,"_28073":2243,"_19451":52652,"_5":13353,"_26530":52618,"_2682":52653},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3185":2258,"_28073":2243,"_19451":52655,"_5":13353,"_26530":52618,"_2682":52656},[],"An available cryptographic engine to keep the authority's key.",{"_3185":2259,"_28073":2243,"_19451":52658,"_5":13353,"_26530":52618,"_2682":52659},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3185":2260,"_28073":2243,"_19451":52661,"_5":13353,"_26530":52618,"_2682":52662},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3185":2261,"_28073":2243,"_19451":52664,"_5":13353,"_26530":52618,"_2682":52665},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3185":2262,"_28073":2243,"_19451":52667,"_5":13353,"_26530":52625,"_2682":52668},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3185":2263,"_28073":2243,"_19451":52670,"_5":13353,"_26530":52628,"_2682":52671},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3185":2264,"_28073":2243,"_19451":52673,"_5":13353,"_26530":52631,"_2682":52674},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3185":2265,"_28073":2243,"_19451":52676,"_5":13353,"_26530":52634,"_2682":52677},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3185":2266,"_28073":2243,"_19451":52679,"_5":13353,"_26530":52637,"_2682":52680},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3185":2267,"_28073":2243,"_19451":52682,"_5":13353,"_26530":52637,"_2682":52683},[],"its subject and extensions identify the expected client;",{"_3185":2268,"_28073":2243,"_19451":52685,"_5":13353,"_26530":52637,"_2682":52686},[],"its public key matches the client's private key;",{"_3185":2269,"_28073":2243,"_19451":52688,"_5":13353,"_26530":52637,"_2682":52689},[],"its chain reaches a root trusted by the consumer;",{"_3185":2270,"_28073":2243,"_19451":52691,"_5":13353,"_26530":52637,"_2682":52692},[],"its dates and usages allow the operation;",{"_3185":2271,"_28073":2243,"_19451":52694,"_5":13353,"_26530":52637,"_2682":52695},[],"the consumer applies revocation checks and authorization.",{"_3185":2272,"_28073":2243,"_19451":52697,"_5":13353,"_26530":52637,"_2682":52698},[],"The issuance path includes the first independent checks.",{"_3185":2273,"_28073":2243,"_19451":52700,"_5":13353,"_26530":52641,"_2682":52701},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3185":2274,"_28073":2243,"_19451":52703,"_5":13353,"_26530":52641,"_2682":52704},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3185":2275,"_28073":2243,"_19451":52706,"_5":13353,"_26530":52641,"_2682":52707},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3185":2276,"_28073":2276,"_5":13700,"_2682":52709,"_28416":52710,"_19451":52711,"_26530":2276},"Create your first CA",[45599,47035,50746,50181],[],{"_3185":2277,"_28073":2276,"_19451":52713,"_5":13353,"_26530":2276,"_2682":52714},[],"Create an evaluation root and check its certificate before issuing.",{"_3185":2278,"_28073":2276,"_5":28413,"_19451":52716,"_26530":52717,"_2682":45609},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3185":2279,"_28073":2276,"_5":28413,"_19451":52719,"_26530":52720,"_2682":52721},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3185":2280,"_28073":2276,"_5":28413,"_19451":52723,"_26530":52724,"_2682":52725},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3185":2281,"_28073":2276,"_5":28413,"_19451":52727,"_26530":52728,"_2682":52729},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3185":2282,"_28073":2276,"_5":28413,"_19451":52731,"_26530":52732,"_2682":52733},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3185":2283,"_28073":2276,"_5":28413,"_19451":52735,"_26530":52736,"_2682":52737},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3185":2284,"_28073":2276,"_5":28413,"_19451":52739,"_26530":52740,"_2682":52741},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3185":2285,"_28073":2276,"_5":28413,"_19451":52743,"_26530":52744,"_2682":50439},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3185":2286,"_28073":2276,"_5":28413,"_19451":52746,"_26530":52747,"_2682":45633},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3185":2287,"_28073":2276,"_19451":52749,"_5":13353,"_26530":2276,"_2682":52750},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3185":2288,"_28073":2276,"_19451":52752,"_5":13353,"_26530":52717,"_2682":52753},[],"Console access and permission to create keys and authorities.",{"_3185":2289,"_28073":2276,"_19451":52755,"_5":13353,"_26530":52717,"_2682":52756},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3185":2290,"_28073":2276,"_19451":52758,"_5":13353,"_26530":52717,"_2682":52759},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3185":2291,"_28073":2276,"_19451":52761,"_5":13353,"_26530":52717,"_2682":52762},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3185":2292,"_28073":2276,"_19451":52764,"_5":13353,"_26530":52720,"_2682":52765},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3185":2293,"_28073":2276,"_19451":52767,"_5":13353,"_26530":52720,"_2682":52768},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3185":2294,"_28073":2276,"_19451":52770,"_5":13353,"_26530":52724,"_2682":52771},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3185":2295,"_28073":2276,"_19451":52773,"_5":13353,"_26530":52724,"_2682":52774},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3185":2296,"_28073":2276,"_19451":52776,"_5":13353,"_26530":52728,"_2682":52777},[],"Select **Root CA** and complete:",{"_3185":2297,"_28073":2276,"_19451":52779,"_5":13353,"_26530":52728,"_2682":52780},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3185":2298,"_28073":2276,"_19451":52782,"_5":13353,"_26530":52728,"_2682":52783},[],"**Subject**: organization and country details for your evaluation.",{"_3185":2299,"_28073":2276,"_19451":52785,"_5":13353,"_26530":52728,"_2682":52786},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3185":2300,"_28073":2276,"_19451":52788,"_5":13353,"_26530":52728,"_2682":52789},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3185":2301,"_28073":2276,"_19451":52791,"_5":13353,"_26530":52728,"_2682":52792},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3185":2302,"_28073":2276,"_19451":52794,"_5":13353,"_26530":52732,"_2682":52795},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3185":2303,"_28073":2276,"_19451":52797,"_5":13353,"_26530":52736,"_2682":52798},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3185":2304,"_28073":2276,"_19451":52800,"_5":13353,"_26530":52736,"_2682":52801},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3185":2305,"_28073":2276,"_19451":52803,"_5":13353,"_26530":52740,"_2682":52804},[],"Run from the directory where you saved `ca.pem`:",{"_3185":2306,"_28073":2276,"_19451":52806,"_5":13353,"_26530":52740,"_2682":52807},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3185":2307,"_28073":2276,"_19451":52809,"_5":13353,"_26530":52740,"_2682":52810},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3185":2308,"_28073":2276,"_19451":52812,"_5":13353,"_26530":52744,"_2682":52813},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3185":2309,"_28073":2276,"_19451":52815,"_5":13353,"_26530":52744,"_2682":52816},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3185":2310,"_28073":2276,"_19451":52818,"_5":13353,"_26530":52744,"_2682":52819},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3185":2311,"_28073":2276,"_19451":52821,"_5":13353,"_26530":52744,"_2682":52822},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3185":2312,"_28073":2276,"_19451":52824,"_5":13353,"_26530":52747,"_2682":52825},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3185":2313,"_28073":2313,"_5":13700,"_2682":52827,"_28416":52828,"_19451":52829,"_26530":2313},"Issue and verify a certificate",[45599,47035,50746,50181],[],{"_3185":2314,"_28073":2313,"_19451":52831,"_5":13353,"_26530":2313,"_2682":52832},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3185":2315,"_28073":2313,"_5":28413,"_19451":52834,"_26530":52835,"_2682":45609},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3185":2316,"_28073":2313,"_5":28413,"_19451":52837,"_26530":52838,"_2682":52839},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3185":2317,"_28073":2313,"_5":28413,"_19451":52841,"_26530":52842,"_2682":52843},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3185":2318,"_28073":2313,"_5":28413,"_19451":52845,"_26530":52846,"_2682":52847},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3185":2319,"_28073":2313,"_5":28413,"_19451":52849,"_26530":52850,"_2682":52851},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3185":2320,"_28073":2313,"_5":28413,"_19451":52853,"_26530":52854,"_2682":52855},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3185":2321,"_28073":2313,"_5":28413,"_19451":52857,"_26530":52858,"_2682":52737},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3185":2322,"_28073":2313,"_5":28413,"_19451":52860,"_26530":52861,"_2682":52862},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3185":2323,"_28073":2313,"_5":28413,"_19451":52864,"_26530":52865,"_2682":52866},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3185":2324,"_28073":2313,"_5":28413,"_19451":52868,"_26530":52869,"_2682":52870},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3185":2325,"_28073":2313,"_5":28413,"_19451":52872,"_26530":52873,"_2682":50439},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3185":2326,"_28073":2313,"_5":28413,"_19451":52875,"_26530":52876,"_2682":45633},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#next-step",{"_3185":2327,"_28073":2313,"_19451":52878,"_5":13353,"_26530":2313,"_2682":52879},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3185":2328,"_28073":2313,"_19451":52881,"_5":13353,"_26530":52835,"_2682":52882},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3185":2329,"_28073":2313,"_19451":52884,"_5":13353,"_26530":52835,"_2682":52885},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3185":2330,"_28073":2313,"_19451":52887,"_5":13353,"_26530":52835,"_2682":52888},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3185":2331,"_28073":2313,"_19451":52890,"_5":13353,"_26530":52835,"_2682":52891},[],"A client identifier: here we use `device-001`.",{"_3185":2332,"_28073":2313,"_19451":52893,"_5":13353,"_26530":52835,"_2682":52894},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3185":2333,"_28073":2313,"_19451":52896,"_5":13353,"_26530":52838,"_2682":52897},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3185":2334,"_28073":2313,"_19451":52899,"_5":13353,"_26530":52842,"_2682":52900},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3185":2335,"_28073":2313,"_19451":52902,"_5":13353,"_26530":52842,"_2682":52903},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3185":2336,"_28073":2313,"_19451":52905,"_5":13353,"_26530":52846,"_2682":52906},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3185":2337,"_28073":2313,"_19451":52908,"_5":13353,"_26530":52846,"_2682":52909},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3185":2338,"_28073":2313,"_19451":52911,"_5":13353,"_26530":52850,"_2682":52912},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3185":2339,"_28073":2313,"_19451":52914,"_5":13353,"_26530":52850,"_2682":52915},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3185":2340,"_28073":2313,"_19451":52917,"_5":13353,"_26530":52854,"_2682":52918},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3185":2341,"_28073":2313,"_19451":52920,"_5":13353,"_26530":52858,"_2682":52921},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3185":2342,"_28073":2313,"_19451":52923,"_5":13353,"_26530":52861,"_2682":52924},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3185":2343,"_28073":2313,"_19451":52926,"_5":13353,"_26530":52865,"_2682":52927},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3185":2344,"_28073":2313,"_19451":52929,"_5":13353,"_26530":52865,"_2682":52930},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3185":2345,"_28073":2313,"_19451":52932,"_5":13353,"_26530":52865,"_2682":52933},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3185":2346,"_28073":2313,"_19451":52935,"_5":13353,"_26530":52869,"_2682":52936},[],"In Bash, compare the two public-key digests:",{"_3185":2347,"_28073":2313,"_19451":52938,"_5":13353,"_26530":52869,"_2682":52939},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3185":2348,"_28073":2313,"_19451":52941,"_5":13353,"_26530":52869,"_2682":52942},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3185":2349,"_28073":2313,"_19451":52944,"_5":13353,"_26530":52873,"_2682":50523},[],{"_3185":2350,"_28073":2313,"_19451":52946,"_5":13353,"_26530":52873,"_2682":52947},[],"What to review",{"_3185":2351,"_28073":2313,"_19451":52949,"_5":13353,"_26530":52873,"_2682":52950},[],"The CA rejects issuance",{"_3185":2352,"_28073":2313,"_19451":52952,"_5":13353,"_26530":52873,"_2682":52953},[],"Permissions, CA state and key, algorithm and profile.",{"_3185":2353,"_28073":2313,"_19451":52955,"_5":13353,"_26530":52873,"_2682":52956},[],"Different subject or usages",{"_3185":2354,"_28073":2313,"_19451":52958,"_5":13353,"_26530":52873,"_2682":52959},[],"Applied profile and requested values.",{"_3185":2355,"_28073":2313,"_19451":52961,"_5":13353,"_26530":52873,"_2682":52962},[],"Issuer cannot be found",{"_3185":2356,"_28073":2313,"_19451":52964,"_5":13353,"_26530":52873,"_2682":52965},[],"Downloaded CA and required intermediate chain.",{"_3185":2357,"_28073":2313,"_19451":52967,"_5":13353,"_26530":52873,"_2682":52968},[],"Validity fails",{"_3185":2358,"_28073":2313,"_19451":52970,"_5":13353,"_26530":52873,"_2682":52971},[],"Certificate and CA dates, and the computer's clock.",{"_3185":2359,"_28073":2313,"_19451":52973,"_5":13353,"_26530":52873,"_2682":52974},[],"Public-key digests differ",{"_3185":2360,"_28073":2313,"_19451":52976,"_5":13353,"_26530":52873,"_2682":52977},[],"Certificate and key files from the same issuance.",{"_3185":2361,"_28073":2313,"_19451":52979,"_5":13353,"_26530":52873,"_2682":52980},[],"See PKI diagnostics to narrow an issuance failure.",{"_3185":2362,"_28073":2313,"_19451":52982,"_5":13353,"_26530":52876,"_2682":52983},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3185":2363,"_28073":2313,"_19451":52985,"_5":13353,"_26530":52876,"_2682":52986},[],"Manage certificates for inspection, status and revocation.",{"_3185":2364,"_28073":2313,"_19451":52988,"_5":13353,"_26530":52876,"_2682":52989},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3185":2365,"_28073":2313,"_19451":52991,"_5":13353,"_26530":52876,"_2682":52992},[],"Prepare EST for the device to request its next identities.",{"_3185":2366,"_28073":2313,"_19451":52994,"_5":13353,"_26530":52876,"_2682":52995},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3185":2367,"_28073":2367,"_5":13700,"_2682":52997,"_28416":52998,"_19451":52999,"_26530":2367},"PKI getting started",[45599,47035,50746,50181],[],{"_3185":2368,"_28073":2367,"_19451":53001,"_5":13353,"_26530":2367,"_2682":53002},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3185":2369,"_28073":2367,"_5":28413,"_19451":53004,"_26530":53005,"_2682":45609},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#before-you-begin",{"_3185":2370,"_28073":2367,"_5":28413,"_19451":53007,"_26530":53008,"_2682":53009},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3185":2371,"_28073":2367,"_5":28413,"_19451":53011,"_26530":53012,"_2682":50373},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#expected-result",{"_3185":2372,"_28073":2367,"_5":28413,"_19451":53014,"_26530":53015,"_2682":53016},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3185":2373,"_28073":2367,"_19451":53018,"_5":13353,"_26530":2367,"_2682":53019},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3185":2374,"_28073":2367,"_19451":53021,"_5":13353,"_26530":53005,"_2682":53022},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3185":2375,"_28073":2367,"_19451":53024,"_5":13353,"_26530":53005,"_2682":53025},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3185":2376,"_28073":2367,"_19451":53027,"_5":13353,"_26530":53005,"_2682":53028},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3185":2377,"_28073":2367,"_19451":53030,"_5":13353,"_26530":53005,"_2682":53031},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3185":2378,"_28073":2367,"_19451":53033,"_5":13353,"_26530":53005,"_2682":53034},[],"A working directory with restricted access for the downloaded key.",{"_3185":2379,"_28073":2367,"_19451":53036,"_5":13353,"_26530":53008,"_2682":53037},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3185":2380,"_28073":2367,"_19451":53039,"_5":13353,"_26530":53008,"_2682":53040},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3185":2381,"_28073":2367,"_19451":53042,"_5":13353,"_26530":53008,"_2682":53043},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3185":2382,"_28073":2367,"_19451":53045,"_5":13353,"_26530":53008,"_2682":53046},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3185":2383,"_28073":2367,"_19451":53048,"_5":13353,"_26530":53012,"_2682":53049},[],"File or resource",{"_3185":2384,"_28073":2367,"_19451":53051,"_5":13353,"_26530":53012,"_2682":50370},[],{"_3185":2385,"_28073":2367,"_19451":53053,"_5":13353,"_26530":53012,"_2682":53054},[],"Active root CA and `ca.pem`",{"_3185":2386,"_28073":2367,"_19451":53056,"_5":13353,"_26530":53012,"_2682":53057},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3185":2387,"_28073":2367,"_19451":53059,"_5":13353,"_26530":53012,"_2682":53060},[],"End-entity certificate and `device.crt`",{"_3185":2388,"_28073":2367,"_19451":53062,"_5":13353,"_26530":53012,"_2682":53063},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3185":2389,"_28073":2367,"_19451":53065,"_5":13353,"_26530":53012,"_2682":53066},[],"Private key `device.key`",{"_3185":2390,"_28073":2367,"_19451":53068,"_5":13353,"_26530":53012,"_2682":53069},[],"Its public key matches the one included in `device.crt`.",{"_3185":2391,"_28073":2367,"_19451":53071,"_5":13353,"_26530":53012,"_2682":53072},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3185":2392,"_28073":2367,"_19451":53074,"_5":13353,"_26530":53015,"_2682":53075},[],"To operate certificates, continue with Certificates and Validation.",{"_3185":2393,"_28073":2367,"_19451":53077,"_5":13353,"_26530":53015,"_2682":53078},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3185":2394,"_28073":2367,"_19451":53080,"_5":13353,"_26530":53015,"_2682":53081},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3185":2395,"_28073":2395,"_5":13700,"_2682":53083,"_28416":53084,"_19451":53085,"_26530":2395},"PKI troubleshooting",[45599,47035,50746,49552],[],{"_3185":2396,"_28073":2395,"_19451":53087,"_5":13353,"_26530":2395,"_2682":53088},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3185":2397,"_28073":2395,"_5":28413,"_19451":53090,"_26530":53091,"_2682":53092},[],"/docs/pr-preview/pr-42/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3185":2398,"_28073":2395,"_5":28413,"_19451":53094,"_26530":53095,"_2682":53096},[],"/docs/pr-preview/pr-42/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3185":2399,"_28073":2395,"_5":28413,"_19451":53098,"_26530":53099,"_2682":53100},[],"/docs/pr-preview/pr-42/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3185":2400,"_28073":2395,"_19451":53102,"_5":13353,"_26530":2395,"_2682":53103},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3185":2401,"_28073":2395,"_19451":53105,"_5":13353,"_26530":2395,"_2682":53106},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3185":2402,"_28073":2395,"_19451":53108,"_5":13353,"_26530":53091,"_2682":50370},[],{"_3185":2403,"_28073":2395,"_19451":53110,"_5":13353,"_26530":53091,"_2682":53111},[],"What to inspect",{"_3185":2404,"_28073":2395,"_19451":53113,"_5":13353,"_26530":53091,"_2682":45633},[],{"_3185":2405,"_28073":2395,"_19451":53115,"_5":13353,"_26530":53091,"_2682":53116},[],"CA",{"_3185":2406,"_28073":2395,"_19451":53118,"_5":13353,"_26530":53091,"_2682":53119},[],"Exists, is active and has usable dates.",{"_3185":2407,"_28073":2395,"_19451":53121,"_5":13353,"_26530":53091,"_2682":53122},[],"Authorities.",{"_3185":2408,"_28073":2395,"_19451":53124,"_5":13353,"_26530":53091,"_2682":53125},[],"Key",{"_3185":2409,"_28073":2395,"_19451":53127,"_5":13353,"_26530":53091,"_2682":53128},[],"The record has a usable private key and the engine can sign.",{"_3185":2410,"_28073":2395,"_19451":53130,"_5":13353,"_26530":53091,"_2682":53131},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3185":2411,"_28073":2395,"_19451":53133,"_5":13353,"_26530":53091,"_2682":53134},[],"CSR",{"_3185":2412,"_28073":2395,"_19451":53136,"_5":13353,"_26530":53091,"_2682":53137},[],"Correct PEM and verifiable signature.",{"_3185":2413,"_28073":2395,"_19451":53139,"_5":13353,"_26530":53091,"_2682":53140},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3185":2414,"_28073":2395,"_19451":53142,"_5":13353,"_26530":53091,"_2682":53143},[],"Profile",{"_3185":2415,"_28073":2395,"_19451":53145,"_5":13353,"_26530":53091,"_2682":53146},[],"Selected source, existing ID, allowed algorithm and size.",{"_3185":2416,"_28073":2395,"_19451":53148,"_5":13353,"_26530":53091,"_2682":53149},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3185":2417,"_28073":2395,"_19451":53151,"_5":13353,"_26530":53091,"_2682":50523},[],{"_3185":2418,"_28073":2395,"_19451":53153,"_5":13353,"_26530":53091,"_2682":53154},[],"Appropriate subject, SAN, usages and dates.",{"_3185":2419,"_28073":2395,"_19451":53156,"_5":13353,"_26530":53091,"_2682":53157},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3185":2420,"_28073":2395,"_19451":53159,"_5":13353,"_26530":53091,"_2682":53160},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3185":2421,"_28073":2395,"_19451":53162,"_5":13353,"_26530":53091,"_2682":53163},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3185":2422,"_28073":2395,"_19451":53165,"_5":13353,"_26530":53095,"_2682":53166},[],"Check each boundary independently:",{"_3185":2423,"_28073":2395,"_19451":53168,"_5":13353,"_26530":53095,"_2682":53169},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3185":2424,"_28073":2395,"_19451":53171,"_5":13353,"_26530":53095,"_2682":53172},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3185":2425,"_28073":2395,"_19451":53174,"_5":13353,"_26530":53095,"_2682":53175},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3185":2426,"_28073":2395,"_19451":53177,"_5":13353,"_26530":53095,"_2682":53178},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3185":2427,"_28073":2395,"_19451":53180,"_5":13353,"_26530":53095,"_2682":53181},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3185":2428,"_28073":2395,"_19451":53183,"_5":13353,"_26530":53095,"_2682":53184},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3185":2429,"_28073":2395,"_19451":53186,"_5":13353,"_26530":53099,"_2682":53187},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3185":2430,"_28073":2395,"_19451":53189,"_5":13353,"_26530":53099,"_2682":53190},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3185":2431,"_28073":2431,"_5":13700,"_2682":53192,"_28416":53193,"_19451":53195,"_26530":2431},"3.8.0 to 4.0.0",[45599,53194],"Upgrades",[],{"_3185":2432,"_28073":2431,"_19451":53197,"_5":13353,"_26530":2431,"_2682":53198},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3185":2433,"_28073":2431,"_5":28413,"_19451":53200,"_26530":53201,"_2682":53202},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3185":2434,"_28073":2431,"_5":28413,"_19451":53204,"_26530":53205,"_2682":53206},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3185":2435,"_28073":2431,"_5":28413,"_19451":53208,"_26530":53209,"_2682":53210},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3185":2436,"_28073":2431,"_5":28413,"_19451":53212,"_26530":53213,"_2682":53214},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3185":2437,"_28073":2431,"_5":28413,"_19451":53216,"_26530":53217,"_2682":53218},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3185":2438,"_28073":2431,"_5":28413,"_19451":53220,"_26530":53221,"_2682":53222},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3185":2439,"_28073":2431,"_5":28413,"_19451":53224,"_26530":53225,"_2682":53226},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3185":2440,"_28073":2431,"_5":28413,"_19451":53228,"_26530":53229,"_2682":53230},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3185":2441,"_28073":2431,"_5":28413,"_19451":53232,"_26530":53233,"_2682":53234},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3185":2442,"_28073":2431,"_5":28413,"_19451":53236,"_26530":53237,"_2682":53238},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3185":2443,"_28073":2431,"_5":28413,"_19451":53240,"_26530":53241,"_2682":53242},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3185":2444,"_28073":2431,"_5":28413,"_19451":53244,"_26530":53245,"_2682":53246},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3185":2445,"_28073":2431,"_5":28413,"_19451":53248,"_26530":53249,"_2682":53250},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3185":2446,"_28073":2431,"_5":28413,"_19451":53252,"_26530":53253,"_2682":53254},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3185":2447,"_28073":2431,"_5":28413,"_19451":53256,"_26530":53257,"_2682":53258},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3185":2448,"_28073":2431,"_5":28413,"_19451":53260,"_26530":53261,"_2682":53262},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3185":2449,"_28073":2431,"_5":28413,"_19451":53264,"_26530":53265,"_2682":53266},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3185":2450,"_28073":2431,"_5":28413,"_19451":53268,"_26530":53269,"_2682":53270},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3185":2451,"_28073":2431,"_5":28413,"_19451":53272,"_26530":53273,"_2682":53274},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3185":2452,"_28073":2431,"_5":28413,"_19451":53276,"_26530":53277,"_2682":53278},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3185":2453,"_28073":2431,"_5":28413,"_19451":53280,"_26530":53281,"_2682":53282},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3185":2454,"_28073":2431,"_5":28413,"_19451":53284,"_26530":53285,"_2682":53286},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3185":2455,"_28073":2431,"_5":28413,"_19451":53288,"_26530":53289,"_2682":53290},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3185":2456,"_28073":2431,"_5":28413,"_19451":53292,"_26530":53293,"_2682":53294},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3185":2457,"_28073":2431,"_5":28413,"_19451":53296,"_26530":53297,"_2682":53298},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3185":2458,"_28073":2431,"_5":28413,"_19451":53300,"_26530":53301,"_2682":53302},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3185":2459,"_28073":2431,"_5":28413,"_19451":53304,"_26530":53305,"_2682":53306},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3185":2460,"_28073":2431,"_5":28413,"_19451":53308,"_26530":53309,"_2682":53310},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3185":2461,"_28073":2431,"_5":28413,"_19451":53312,"_26530":53313,"_2682":53314},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3185":2462,"_28073":2431,"_5":28413,"_19451":53316,"_26530":53317,"_2682":53318},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3185":2463,"_28073":2431,"_5":28413,"_19451":53320,"_26530":53321,"_2682":53322},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3185":2464,"_28073":2431,"_5":28413,"_19451":53324,"_26530":53325,"_2682":53326},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3185":2465,"_28073":2431,"_5":28413,"_19451":53328,"_26530":53329,"_2682":53330},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3185":2466,"_28073":2431,"_5":28413,"_19451":53332,"_26530":53333,"_2682":49552},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3185":2467,"_28073":2431,"_5":28413,"_19451":53335,"_26530":53336,"_2682":53337},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3185":2468,"_28073":2431,"_5":28413,"_19451":53339,"_26530":53340,"_2682":53341},[],"/docs/pr-preview/pr-42/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3185":2469,"_28073":2431,"_19451":53343,"_5":13353,"_26530":2431,"_2682":53344},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3185":2470,"_28073":2431,"_19451":53346,"_5":13353,"_26530":2431,"_2682":53347},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3185":2471,"_28073":2431,"_19451":53349,"_5":13353,"_26530":2431,"_2682":53350},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3185":2472,"_28073":2431,"_19451":53352,"_5":13353,"_26530":2431,"_2682":53353},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3185":2473,"_28073":2431,"_19451":53355,"_5":13353,"_26530":2431,"_2682":53356},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3185":2474,"_28073":2431,"_19451":53358,"_5":13353,"_26530":2431,"_2682":53359},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3185":2475,"_28073":2431,"_19451":53361,"_5":13353,"_26530":2431,"_2682":53362},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3185":2476,"_28073":2431,"_19451":53364,"_5":13353,"_26530":53205,"_2682":53365},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3185":2477,"_28073":2431,"_19451":53367,"_5":13353,"_26530":53205,"_2682":53368},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3185":2478,"_28073":2431,"_19451":53370,"_5":13353,"_26530":53209,"_2682":53371},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3185":2479,"_28073":2431,"_19451":53373,"_5":13353,"_26530":53209,"_2682":53374},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3185":2480,"_28073":2431,"_19451":53376,"_5":13353,"_26530":53213,"_2682":53377},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3185":2481,"_28073":2431,"_19451":53379,"_5":13353,"_26530":53217,"_2682":53380},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3185":2482,"_28073":2431,"_19451":53382,"_5":13353,"_26530":53217,"_2682":53383},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3185":2483,"_28073":2431,"_19451":53385,"_5":13353,"_26530":53217,"_2682":53386},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3185":2484,"_28073":2431,"_19451":53388,"_5":13353,"_26530":53217,"_2682":53389},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3185":2485,"_28073":2431,"_19451":53391,"_5":13353,"_26530":53217,"_2682":53392},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3185":2486,"_28073":2431,"_19451":53394,"_5":13353,"_26530":53221,"_2682":53395},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3185":2487,"_28073":2431,"_19451":53397,"_5":13353,"_26530":53221,"_2682":53398},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3185":2488,"_28073":2431,"_19451":53400,"_5":13353,"_26530":53221,"_2682":53401},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3185":2489,"_28073":2431,"_19451":53403,"_5":13353,"_26530":53221,"_2682":53404},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3185":2490,"_28073":2431,"_19451":53406,"_5":13353,"_26530":53221,"_2682":53407},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3185":2491,"_28073":2431,"_19451":53409,"_5":13353,"_26530":53225,"_2682":53410},[],"Change",{"_3185":2492,"_28073":2431,"_19451":53412,"_5":13353,"_26530":53225,"_2682":53413},[],"Who is affected",{"_3185":2493,"_28073":2431,"_19451":53415,"_5":13353,"_26530":53225,"_2682":53416},[],"Severity",{"_3185":2494,"_28073":2431,"_19451":53418,"_5":13353,"_26530":53225,"_2682":53419},[],"Action",{"_3185":2495,"_28073":2431,"_19451":53421,"_5":13353,"_26530":53225,"_2682":53234},[],{"_3185":2496,"_28073":2431,"_19451":53423,"_5":13353,"_26530":53225,"_2682":53424},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3185":2497,"_28073":2431,"_19451":53426,"_5":13353,"_26530":53225,"_2682":53427},[],"High: KMS and VA start on empty volumes",{"_3185":2498,"_28073":2431,"_19451":53429,"_5":13353,"_26530":53225,"_2682":53430},[],"Copy the data into the new volumes",{"_3185":2499,"_28073":2431,"_19451":53432,"_5":13353,"_26530":53225,"_2682":53238},[],{"_3185":2500,"_28073":2431,"_19451":53434,"_5":13353,"_26530":53225,"_2682":53435},[],"Every Helm release",{"_3185":2501,"_28073":2431,"_19451":53437,"_5":13353,"_26530":53225,"_2682":53438},[],"High: `helm upgrade` fails",{"_3185":2502,"_28073":2431,"_19451":53440,"_5":13353,"_26530":53225,"_2682":53441},[],"Remove or rename legacy keys",{"_3185":2503,"_28073":2431,"_19451":53443,"_5":13353,"_26530":53225,"_2682":53242},[],{"_3185":2504,"_28073":2431,"_19451":53445,"_5":13353,"_26530":53225,"_2682":53446},[],"Every deployment",{"_3185":2505,"_28073":2431,"_19451":53448,"_5":13353,"_26530":53225,"_2682":53449},[],"High: without a bootstrap principal there is no administrator",{"_3185":2506,"_28073":2431,"_19451":53451,"_5":13353,"_26530":53225,"_2682":53452},[],"Configure `services.authz`",{"_3185":2507,"_28073":2431,"_19451":53454,"_5":13353,"_26530":53225,"_2682":53246},[],{"_3185":2508,"_28073":2431,"_19451":53456,"_5":13353,"_26530":53225,"_2682":53435},[],{"_3185":2509,"_28073":2431,"_19451":53458,"_5":13353,"_26530":53225,"_2682":53459},[],"High: `helm upgrade` fails on the old keys",{"_3185":2510,"_28073":2431,"_19451":53461,"_5":13353,"_26530":53225,"_2682":53462},[],"Move JWKS and roles into `services.authz`",{"_3185":2511,"_28073":2431,"_19451":53464,"_5":13353,"_26530":53225,"_2682":53266},[],{"_3185":2512,"_28073":2431,"_19451":53466,"_5":13353,"_26530":53225,"_2682":53467},[],"3.8.0 deployments with per-service databases",{"_3185":2513,"_28073":2431,"_19451":53469,"_5":13353,"_26530":53225,"_2682":53470},[],"High: services find no data, or a migration aborts",{"_3185":2514,"_28073":2431,"_19451":53472,"_5":13353,"_26530":53225,"_2682":53473},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3185":2515,"_28073":2431,"_19451":53475,"_5":13353,"_26530":53225,"_2682":53270},[],{"_3185":2516,"_28073":2431,"_19451":53477,"_5":13353,"_26530":53225,"_2682":53478},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3185":2517,"_28073":2431,"_19451":53480,"_5":13353,"_26530":53225,"_2682":53481},[],"High: the backend no longer starts with them",{"_3185":2518,"_28073":2431,"_19451":53483,"_5":13353,"_26530":53225,"_2682":53484},[],"Move to PostgreSQL before upgrading",{"_3185":2519,"_28073":2431,"_19451":53486,"_5":13353,"_26530":53225,"_2682":53487},[],"Webhooks with file references",{"_3185":2520,"_28073":2431,"_19451":53489,"_5":13353,"_26530":53225,"_2682":53490},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3185":2521,"_28073":2431,"_19451":53492,"_5":13353,"_26530":53225,"_2682":53493},[],"High: enrollments calling the webhook fail",{"_3185":2522,"_28073":2431,"_19451":53495,"_5":13353,"_26530":53225,"_2682":53496},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3185":2523,"_28073":2431,"_19451":53498,"_5":13353,"_26530":53225,"_2682":53250},[],{"_3185":2524,"_28073":2431,"_19451":53500,"_5":13353,"_26530":53225,"_2682":53501},[],"Releases with per-service identity overrides or mounted key material",{"_3185":2525,"_28073":2431,"_19451":53503,"_5":13353,"_26530":53225,"_2682":53504},[],"Medium: services cannot read their files",{"_3185":2526,"_28073":2431,"_19451":53506,"_5":13353,"_26530":53225,"_2682":53507},[],"Remove the overrides and fix volume ownership",{"_3185":2527,"_28073":2431,"_19451":53509,"_5":13353,"_26530":53225,"_2682":53254},[],{"_3185":2528,"_28073":2431,"_19451":53511,"_5":13353,"_26530":53225,"_2682":53512},[],"Releases that set `amqp.tls`",{"_3185":2529,"_28073":2431,"_19451":53514,"_5":13353,"_26530":53225,"_2682":53515},[],"Medium: clients connect to the wrong port",{"_3185":2530,"_28073":2431,"_19451":53517,"_5":13353,"_26530":53225,"_2682":53518},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3185":2531,"_28073":2431,"_19451":53520,"_5":13353,"_26530":53225,"_2682":53274},[],{"_3185":2532,"_28073":2431,"_19451":53522,"_5":13353,"_26530":53225,"_2682":53523},[],"Installations whose CA keys predate the KMS",{"_3185":2533,"_28073":2431,"_19451":53525,"_5":13353,"_26530":53225,"_2682":53526},[],"Medium: CA keys stay unmanaged",{"_3185":2534,"_28073":2431,"_19451":53528,"_5":13353,"_26530":53225,"_2682":53529},[],"Run the CA-to-KMS migration",{"_3185":2535,"_28073":2431,"_19451":53531,"_5":13353,"_26530":53225,"_2682":53532},[],"Receiver certificate verification",{"_3185":2536,"_28073":2431,"_19451":53534,"_5":13353,"_26530":53225,"_2682":53535},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3185":2537,"_28073":2431,"_19451":53537,"_5":13353,"_26530":53225,"_2682":53538},[],"Medium: credentials go to an unverified receiver",{"_3185":2538,"_28073":2431,"_19451":53540,"_5":13353,"_26530":53225,"_2682":53541},[],"Set `insecure_skip_verify` to `false`",{"_3185":2539,"_28073":2431,"_19451":53543,"_5":13353,"_26530":53225,"_2682":53286},[],{"_3185":2540,"_28073":2431,"_19451":53545,"_5":13353,"_26530":53225,"_2682":53546},[],"Scripts and consoles that edit DMSs through the API",{"_3185":2541,"_28073":2431,"_19451":53548,"_5":13353,"_26530":53225,"_2682":53549},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3185":2542,"_28073":2431,"_19451":53551,"_5":13353,"_26530":53225,"_2682":53552},[],"Read the DMS before editing and use the new field",{"_3185":2543,"_28073":2431,"_19451":53554,"_5":13353,"_26530":53225,"_2682":53302},[],{"_3185":2544,"_28073":2431,"_19451":53556,"_5":13353,"_26530":53225,"_2682":53557},[],"Consumers that read the device `events` field",{"_3185":2545,"_28073":2431,"_19451":53559,"_5":13353,"_26530":53225,"_2682":53560},[],"Medium: the field disappears",{"_3185":2546,"_28073":2431,"_19451":53562,"_5":13353,"_26530":53225,"_2682":53563},[],"Use the new event endpoints",{"_3185":2547,"_28073":2431,"_19451":53565,"_5":13353,"_26530":53225,"_2682":53258},[],{"_3185":2548,"_28073":2431,"_19451":53567,"_5":13353,"_26530":53225,"_2682":53568},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3185":2549,"_28073":2431,"_19451":53570,"_5":13353,"_26530":53225,"_2682":53571},[],"Low to medium: validation errors or changed defaults",{"_3185":2550,"_28073":2431,"_19451":53573,"_5":13353,"_26530":53225,"_2682":53574},[],"Update the values file",{"_3185":2551,"_28073":2431,"_19451":53576,"_5":13353,"_26530":53225,"_2682":53294},[],{"_3185":2552,"_28073":2431,"_19451":53578,"_5":13353,"_26530":53225,"_2682":53579},[],"Clients that send the DMS ID in the update body",{"_3185":2553,"_28073":2431,"_19451":53581,"_5":13353,"_26530":53225,"_2682":53582},[],"Low: the ID in the URL wins",{"_3185":2554,"_28073":2431,"_19451":53584,"_5":13353,"_26530":53225,"_2682":53585},[],"Send the ID in the URL",{"_3185":2555,"_28073":2431,"_19451":53587,"_5":13353,"_26530":53225,"_2682":53298},[],{"_3185":2556,"_28073":2431,"_19451":53589,"_5":13353,"_26530":53225,"_2682":53590},[],"Consumers that match on certificate `type`",{"_3185":2557,"_28073":2431,"_19451":53592,"_5":13353,"_26530":53225,"_2682":53593},[],"Low: two values are renamed",{"_3185":2558,"_28073":2431,"_19451":53595,"_5":13353,"_26530":53225,"_2682":53596},[],"Adapt consumers",{"_3185":2559,"_28073":2431,"_19451":53598,"_5":13353,"_26530":53225,"_2682":53290},[],{"_3185":2560,"_28073":2431,"_19451":53600,"_5":13353,"_26530":53225,"_2682":53601},[],"Any DMS",{"_3185":2561,"_28073":2431,"_19451":53603,"_5":13353,"_26530":53225,"_2682":53604},[],"Low: informational",{"_3185":2562,"_28073":2431,"_19451":53606,"_5":13353,"_26530":53225,"_2682":53607},[],"Read both blocks before editing",{"_3185":2563,"_28073":2431,"_19451":53609,"_5":13353,"_26530":53233,"_2682":53610},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3185":2564,"_28073":2431,"_19451":53612,"_5":13353,"_26530":53233,"_2682":53613},[],"Step 4 of the migration guide copies the data.",{"_3185":2565,"_28073":2431,"_19451":53615,"_5":13353,"_26530":53237,"_2682":53616},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3185":2566,"_28073":2431,"_19451":53618,"_5":13353,"_26530":53241,"_2682":53619},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3185":2567,"_28073":2431,"_19451":53621,"_5":13353,"_26530":53245,"_2682":53622},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3185":2568,"_28073":2431,"_19451":53624,"_5":13353,"_26530":53249,"_2682":53625},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3185":2569,"_28073":2431,"_19451":53627,"_5":13353,"_26530":53249,"_2682":53628},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3185":2570,"_28073":2431,"_19451":53630,"_5":13353,"_26530":53253,"_2682":53631},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3185":2571,"_28073":2431,"_19451":53633,"_5":13353,"_26530":53257,"_2682":53634},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3185":2572,"_28073":2431,"_19451":53636,"_5":13353,"_26530":53257,"_2682":53637},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3185":2573,"_28073":2431,"_19451":53639,"_5":13353,"_26530":53257,"_2682":53640},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3185":2574,"_28073":2431,"_19451":53642,"_5":13353,"_26530":53257,"_2682":53643},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3185":2575,"_28073":2431,"_19451":53645,"_5":13353,"_26530":53257,"_2682":53646},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3185":2576,"_28073":2431,"_19451":53648,"_5":13353,"_26530":53257,"_2682":53649},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3185":2577,"_28073":2431,"_19451":53651,"_5":13353,"_26530":53265,"_2682":53652},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3185":2578,"_28073":2431,"_19451":53654,"_5":13353,"_26530":53265,"_2682":53655},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3185":2579,"_28073":2431,"_19451":53657,"_5":13353,"_26530":53265,"_2682":53658},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3185":2580,"_28073":2431,"_19451":53660,"_5":13353,"_26530":53265,"_2682":53661},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3185":2581,"_28073":2431,"_19451":53663,"_5":13353,"_26530":53265,"_2682":53664},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3185":2582,"_28073":2431,"_19451":53666,"_5":13353,"_26530":53269,"_2682":53667},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3185":2583,"_28073":2431,"_19451":53669,"_5":13353,"_26530":53273,"_2682":53670},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3185":2584,"_28073":2431,"_19451":53672,"_5":13353,"_26530":53273,"_2682":53673},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3185":2585,"_28073":2431,"_19451":53675,"_5":13353,"_26530":53273,"_2682":53676},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3185":2586,"_28073":2431,"_19451":53678,"_5":13353,"_26530":53273,"_2682":53679},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3185":2587,"_28073":2431,"_19451":53681,"_5":13353,"_26530":53273,"_2682":53682},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3185":2588,"_28073":2431,"_19451":53684,"_5":13353,"_26530":53273,"_2682":53685},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3185":2589,"_28073":2431,"_19451":53687,"_5":13353,"_26530":53281,"_2682":53688},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3185":2590,"_28073":2431,"_19451":53690,"_5":13353,"_26530":53281,"_2682":53691},[],"Field in 3.8.0",{"_3185":2591,"_28073":2431,"_19451":53693,"_5":13353,"_26530":53281,"_2682":53694},[],"Field in 4.0.0",{"_3185":2592,"_28073":2431,"_19451":53696,"_5":13353,"_26530":53281,"_2682":53697},[],"`validate_server_cert`",{"_3185":2593,"_28073":2431,"_19451":53699,"_5":13353,"_26530":53281,"_2682":53700},[],"`insecure_skip_verify` (value negated)",{"_3185":2594,"_28073":2431,"_19451":53702,"_5":13353,"_26530":53281,"_2682":53703},[],"`oidc`",{"_3185":2595,"_28073":2431,"_19451":53705,"_5":13353,"_26530":53281,"_2682":53706},[],"`jwt_options`",{"_3185":2596,"_28073":2431,"_19451":53708,"_5":13353,"_26530":53281,"_2682":53709},[],"`apikey`",{"_3185":2597,"_28073":2431,"_19451":53711,"_5":13353,"_26530":53281,"_2682":53712},[],"`apikey_options`",{"_3185":2598,"_28073":2431,"_19451":53714,"_5":13353,"_26530":53281,"_2682":53715},[],"`mtls`",{"_3185":2599,"_28073":2431,"_19451":53717,"_5":13353,"_26530":53281,"_2682":53718},[],"`mtls_options`",{"_3185":2600,"_28073":2431,"_19451":53720,"_5":13353,"_26530":53281,"_2682":53721},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3185":2601,"_28073":2431,"_19451":53723,"_5":13353,"_26530":53281,"_2682":53724},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3185":2602,"_28073":2431,"_19451":53726,"_5":13353,"_26530":53281,"_2682":53727},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3185":2603,"_28073":2431,"_19451":53729,"_5":13353,"_26530":53285,"_2682":53730},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3185":2604,"_28073":2431,"_19451":53732,"_5":13353,"_26530":53285,"_2682":53733},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3185":2605,"_28073":2431,"_19451":53735,"_5":13353,"_26530":53285,"_2682":53736},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3185":2606,"_28073":2431,"_19451":53738,"_5":13353,"_26530":53289,"_2682":53739},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. If the console version does not expose independent settings, edit them through the DMS API.",{"_3185":2607,"_28073":2431,"_19451":53741,"_5":13353,"_26530":53293,"_2682":53742},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3185":2608,"_28073":2431,"_19451":53744,"_5":13353,"_26530":53297,"_2682":53745},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3185":2609,"_28073":2431,"_19451":53747,"_5":13353,"_26530":53301,"_2682":53748},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3185":2610,"_28073":2431,"_19451":53750,"_5":13353,"_26530":53301,"_2682":53751},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3185":2611,"_28073":2431,"_19451":53753,"_5":13353,"_26530":53301,"_2682":53754},[],"`POST /v1/devices/:id/events` creates an event.",{"_3185":2612,"_28073":2431,"_19451":53756,"_5":13353,"_26530":53301,"_2682":53757},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3185":2613,"_28073":2431,"_19451":53759,"_5":13353,"_26530":53305,"_2682":53760},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3185":2614,"_28073":2431,"_19451":53762,"_5":13353,"_26530":53309,"_2682":53763},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3185":2615,"_28073":2431,"_19451":53765,"_5":13353,"_26530":53309,"_2682":53766},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3185":2616,"_28073":2431,"_19451":53768,"_5":13353,"_26530":53309,"_2682":53769},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3185":2617,"_28073":2431,"_19451":53771,"_5":13353,"_26530":53309,"_2682":53772},[],"Record the names of your local-storage PVCs:",{"_3185":2618,"_28073":2431,"_19451":53774,"_5":13353,"_26530":53309,"_2682":53775},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3185":2619,"_28073":2431,"_19451":53777,"_5":13353,"_26530":53313,"_2682":53778},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3185":2620,"_28073":2431,"_19451":53780,"_5":13353,"_26530":53313,"_2682":53781},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3185":2621,"_28073":2431,"_19451":53783,"_5":13353,"_26530":53313,"_2682":53784},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3185":2622,"_28073":2431,"_19451":53786,"_5":13353,"_26530":53313,"_2682":53787},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3185":2623,"_28073":2431,"_19451":53789,"_5":13353,"_26530":53313,"_2682":53790},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3185":2624,"_28073":2431,"_19451":53792,"_5":13353,"_26530":53313,"_2682":53793},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3185":2625,"_28073":2431,"_19451":53795,"_5":13353,"_26530":53313,"_2682":53796},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3185":2626,"_28073":2431,"_19451":53798,"_5":13353,"_26530":53313,"_2682":53799},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3185":2627,"_28073":2431,"_19451":53801,"_5":13353,"_26530":53313,"_2682":53802},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3185":2628,"_28073":2431,"_19451":53804,"_5":13353,"_26530":53313,"_2682":53805},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3185":2629,"_28073":2431,"_19451":53807,"_5":13353,"_26530":53313,"_2682":53808},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3185":2630,"_28073":2431,"_19451":53810,"_5":13353,"_26530":53313,"_2682":53811},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3185":2631,"_28073":2431,"_19451":53813,"_5":13353,"_26530":53317,"_2682":53814},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3185":2632,"_28073":2431,"_19451":53816,"_5":13353,"_26530":53317,"_2682":53817},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3185":2633,"_28073":2431,"_19451":53819,"_5":13353,"_26530":53321,"_2682":53820},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3185":2634,"_28073":2431,"_19451":53822,"_5":13353,"_26530":53321,"_2682":53823},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3185":2635,"_28073":2431,"_19451":53825,"_5":13353,"_26530":53321,"_2682":53826},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3185":2636,"_28073":2431,"_19451":53828,"_5":13353,"_26530":53321,"_2682":53829},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3185":2637,"_28073":2431,"_19451":53831,"_5":13353,"_26530":53321,"_2682":53832},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3185":2638,"_28073":2431,"_19451":53834,"_5":13353,"_26530":53321,"_2682":53835},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3185":2639,"_28073":2431,"_19451":53837,"_5":13353,"_26530":53321,"_2682":53838},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3185":2640,"_28073":2431,"_19451":53840,"_5":13353,"_26530":53321,"_2682":53841},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3185":2641,"_28073":2431,"_19451":53843,"_5":13353,"_26530":53321,"_2682":53844},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3185":2642,"_28073":2431,"_19451":53846,"_5":13353,"_26530":53321,"_2682":53847},[],"**Remove the helper and restore the recorded replica counts:**",{"_3185":2643,"_28073":2431,"_19451":53849,"_5":13353,"_26530":53321,"_2682":53850},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3185":2644,"_28073":2431,"_19451":53852,"_5":13353,"_26530":53325,"_2682":53853},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3185":2645,"_28073":2431,"_19451":53855,"_5":13353,"_26530":53325,"_2682":53856},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3185":2646,"_28073":2431,"_19451":53858,"_5":13353,"_26530":53329,"_2682":53859},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3185":2647,"_28073":2431,"_19451":53861,"_5":13353,"_26530":53329,"_2682":53862},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3185":2648,"_28073":2431,"_19451":53864,"_5":13353,"_26530":53329,"_2682":53865},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3185":2649,"_28073":2431,"_19451":53867,"_5":13353,"_26530":53329,"_2682":53868},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3185":2650,"_28073":2431,"_19451":53870,"_5":13353,"_26530":53329,"_2682":53871},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3185":2651,"_28073":2431,"_19451":53873,"_5":13353,"_26530":53333,"_2682":53874},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3185":2652,"_28073":2431,"_19451":53876,"_5":13353,"_26530":53333,"_2682":53877},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3185":2653,"_28073":2431,"_19451":53879,"_5":13353,"_26530":53333,"_2682":53880},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3185":2654,"_28073":2431,"_19451":53882,"_5":13353,"_26530":53333,"_2682":53883},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3185":2655,"_28073":2431,"_19451":53885,"_5":13353,"_26530":53333,"_2682":53886},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3185":2656,"_28073":2431,"_19451":53888,"_5":13353,"_26530":53333,"_2682":53889},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3185":2657,"_28073":2431,"_19451":53891,"_5":13353,"_26530":53333,"_2682":53892},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3185":2658,"_28073":2431,"_19451":53894,"_5":13353,"_26530":53336,"_2682":53895},[],"After the upgrade, check in this order:",{"_3185":2659,"_28073":2431,"_19451":53897,"_5":13353,"_26530":53336,"_2682":53898},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3185":2660,"_28073":2431,"_19451":53900,"_5":13353,"_26530":53336,"_2682":53901},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3185":2661,"_28073":2431,"_19451":53903,"_5":13353,"_26530":53336,"_2682":53904},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3185":2662,"_28073":2431,"_19451":53906,"_5":13353,"_26530":53336,"_2682":53907},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3185":2663,"_28073":2431,"_19451":53909,"_5":13353,"_26530":53336,"_2682":53910},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3185":2664,"_28073":2431,"_19451":53912,"_5":13353,"_26530":53336,"_2682":53913},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3185":2665,"_28073":2431,"_19451":53915,"_5":13353,"_26530":53336,"_2682":53916},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3185":2666,"_28073":2431,"_19451":53918,"_5":13353,"_26530":53336,"_2682":53919},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3185":2667,"_28073":2431,"_19451":53921,"_5":13353,"_26530":53336,"_2682":53922},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3185":2668,"_28073":2431,"_19451":53924,"_5":13353,"_26530":53336,"_2682":53925},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3185":2669,"_28073":2431,"_19451":53927,"_5":13353,"_26530":53336,"_2682":53928},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3185":2670,"_28073":2431,"_19451":53930,"_5":13353,"_26530":53336,"_2682":53931},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3185":2671,"_28073":2431,"_19451":53933,"_5":13353,"_26530":53336,"_2682":53934},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3185":2672,"_28073":2431,"_19451":53936,"_5":13353,"_26530":53336,"_2682":53937},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3185":2673,"_28073":2431,"_19451":53939,"_5":13353,"_26530":53340,"_2682":53940},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3185":2674,"_28073":2431,"_19451":53942,"_5":13353,"_26530":53340,"_2682":53943},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3185":2675,"_28073":2431,"_19451":53945,"_5":13353,"_26530":53340,"_2682":53946},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3185":2676,"_28073":2431,"_19451":53948,"_5":13353,"_26530":53340,"_2682":53949},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3185":2677,"_28073":2431,"_19451":53951,"_5":13353,"_26530":53340,"_2682":53952},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_53955":53956,"_53957":53958,"_53959":53960,"_53961":53962,"_16875":2704,"_64628":2704},"language","