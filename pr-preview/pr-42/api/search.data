046":117069,"_38049":117072,"_38051":117075,"_38053":117078,"_38056":117081,"_38058":117084,"_38060":117087,"_38062":117090,"_38064":117093,"_38066":117096,"_38068":117099,"_38070":117102,"_38072":117105,"_38074":117108,"_38076":117111,"_38078":117114,"_38080":117117,"_38082":117120,"_38084":117123,"_38086":117126,"_38088":117129,"_38091":117132,"_38093":117135,"_38095":117138,"_38097":117141,"_38099":117144,"_38101":117147,"_38103":117150,"_38105":117153,"_38107":117156,"_38109":117159,"_38111":117162,"_38113":117165,"_38115":117168,"_38117":117171,"_38119":117174,"_38121":117177,"_38123":117180,"_38125":117183,"_38127":117186,"_38129":117189,"_38131":117192,"_38134":117195,"_38136":117198,"_38138":117201},{"_3227":65623,"_28581":65623,"_5":13916,"_2720":108916,"_28924":108917,"_19785":108920,"_26003":65623},"Despliega desde AWS Marketplace",[46319,108918,108919],"Despliegue","Otros modelos",[],{"_3227":65624,"_28581":65623,"_19785":108922,"_5":13558,"_26003":65623,"_2720":108923},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3227":65625,"_28581":65623,"_5":28921,"_19785":108925,"_26003":108926,"_2720":108927},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3227":65626,"_28581":65623,"_5":28921,"_19785":108929,"_26003":108930,"_2720":108931},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3227":65627,"_28581":65623,"_5":28921,"_19785":108933,"_26003":108934,"_2720":108935},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3227":65628,"_28581":65623,"_5":28921,"_19785":108937,"_26003":108938,"_2720":108939},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3227":65629,"_28581":65623,"_5":28921,"_19785":108941,"_26003":108942,"_2720":108943},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3227":65630,"_28581":65623,"_5":28921,"_19785":108945,"_26003":108946,"_2720":108947},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3227":65631,"_28581":65623,"_5":28921,"_19785":108949,"_26003":108950,"_2720":108951},[],"/docs/pr-preview/pr-42/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3227":65632,"_28581":65623,"_19785":108953,"_5":13558,"_26003":65623,"_2720":108954},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3227":65633,"_28581":65623,"_19785":108956,"_5":13558,"_26003":108926,"_2720":108957},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3227":65634,"_28581":65623,"_19785":108959,"_5":13558,"_26003":108926,"_2720":108960},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3227":65635,"_28581":65623,"_19785":108962,"_5":13558,"_26003":108926,"_2720":108963},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3227":65636,"_28581":65623,"_19785":108965,"_5":13558,"_26003":108930,"_2720":108966},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3227":65637,"_28581":65623,"_19785":108968,"_5":13558,"_26003":108930,"_2720":108969},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3227":65638,"_28581":65623,"_19785":108971,"_5":13558,"_26003":108930,"_2720":108972},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3227":65639,"_28581":65623,"_19785":108974,"_5":13558,"_26003":108934,"_2720":108975},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3227":65640,"_28581":65623,"_19785":108977,"_5":13558,"_26003":108938,"_2720":108978},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3227":65641,"_28581":65623,"_19785":108980,"_5":13558,"_26003":108942,"_2720":108981},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3227":65642,"_28581":65623,"_19785":108983,"_5":13558,"_26003":108946,"_2720":108984},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3227":65643,"_28581":65623,"_19785":108986,"_5":13558,"_26003":108950,"_2720":108987},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3227":65644,"_28581":65644,"_5":13916,"_2720":108989,"_28924":108990,"_19785":108991,"_26003":65644},"Despliega Lamassu",[46319,108918],[],{"_3227":65645,"_28581":65644,"_19785":108993,"_5":13558,"_26003":65644,"_2720":108994},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3227":65646,"_28581":65644,"_5":28921,"_19785":108996,"_26003":108997,"_2720":108998},[],"/docs/pr-preview/pr-42/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3227":65647,"_28581":65644,"_5":28921,"_19785":109000,"_26003":109001,"_2720":109002},[],"/docs/pr-preview/pr-42/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3227":65648,"_28581":65644,"_5":28921,"_19785":109004,"_26003":109005,"_2720":109006},[],"/docs/pr-preview/pr-42/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3227":65649,"_28581":65644,"_19785":109008,"_5":13558,"_26003":65644,"_2720":109009},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3227":65650,"_28581":65644,"_19785":109011,"_5":13558,"_26003":108997,"_2720":109012},[],"Modelo",{"_3227":65651,"_28581":65644,"_19785":109014,"_5":13558,"_26003":108997,"_2720":109015},[],"Recomendado para",{"_3227":65652,"_28581":65644,"_19785":109017,"_5":13558,"_26003":108997,"_2720":109018},[],"Quién opera la infraestructura",{"_3227":65653,"_28581":65644,"_19785":109020,"_5":13558,"_26003":108997,"_2720":109021},[],"Punto de partida",{"_3227":65654,"_28581":65644,"_19785":109023,"_5":13558,"_26003":108997,"_2720":46426},[],{"_3227":65655,"_28581":65644,"_19785":109025,"_5":13558,"_26003":108997,"_2720":109026},[],"Producción, entornos regulados y despliegues personalizados",{"_3227":65656,"_28581":65644,"_19785":109028,"_5":13558,"_26003":108997,"_2720":109029},[],"Tu equipo",{"_3227":65657,"_28581":65644,"_19785":109031,"_5":13558,"_26003":108997,"_2720":109032},[],"Helm o Fastlane",{"_3227":65658,"_28581":65644,"_19785":109034,"_5":13558,"_26003":108997,"_2720":46438},[],{"_3227":65659,"_28581":65644,"_19785":109036,"_5":13558,"_26003":108997,"_2720":109037},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3227":65660,"_28581":65644,"_19785":109039,"_5":13558,"_26003":108997,"_2720":109029},[],{"_3227":65661,"_28581":65644,"_19785":109041,"_5":13558,"_26003":108997,"_2720":109042},[],"Imagen preconfigurada en EC2",{"_3227":65662,"_28581":65644,"_19785":109044,"_5":13558,"_26003":108997,"_2720":46449},[],{"_3227":65663,"_28581":65644,"_19785":109046,"_5":13558,"_26003":108997,"_2720":109047},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3227":65664,"_28581":65644,"_19785":109049,"_5":13558,"_26003":108997,"_2720":46455},[],{"_3227":65665,"_28581":65644,"_19785":109051,"_5":13558,"_26003":108997,"_2720":109052},[],"Suscripción gestionada",{"_3227":65666,"_28581":65644,"_19785":109054,"_5":13558,"_26003":108997,"_2720":109055},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3227":65667,"_28581":65644,"_19785":109057,"_5":13558,"_26003":108997,"_2720":109058},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3227":65668,"_28581":65644,"_19785":109060,"_5":13558,"_26003":108997,"_2720":109061},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3227":65669,"_28581":65644,"_19785":109063,"_5":13558,"_26003":109001,"_2720":109064},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3227":65670,"_28581":65644,"_19785":109066,"_5":13558,"_26003":109005,"_2720":109067},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3227":65671,"_28581":65671,"_5":13916,"_2720":109069,"_28924":109070,"_19785":109071,"_26003":65671},"Utiliza Lamassu como SaaS",[46319,108918,108919],[],{"_3227":65672,"_28581":65671,"_19785":109073,"_5":13558,"_26003":65671,"_2720":109074},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3227":65673,"_28581":65671,"_5":28921,"_19785":109076,"_26003":109077,"_2720":109078},[],"/docs/pr-preview/pr-42/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3227":65674,"_28581":65671,"_5":28921,"_19785":109080,"_26003":109081,"_2720":109082},[],"/docs/pr-preview/pr-42/es/deployment/saas#planes","Planes",{"_3227":65675,"_28581":65671,"_5":28921,"_19785":109084,"_26003":109085,"_2720":109086},[],"/docs/pr-preview/pr-42/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3227":65676,"_28581":65671,"_19785":109088,"_5":13558,"_26003":65671,"_2720":109089},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3227":65677,"_28581":65671,"_19785":109091,"_5":13558,"_26003":109077,"_2720":109092},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3227":65678,"_28581":65671,"_19785":109094,"_5":13558,"_26003":109077,"_2720":109095},[],"Copias de seguridad automáticas.",{"_3227":65679,"_28581":65671,"_19785":109097,"_5":13558,"_26003":109077,"_2720":109098},[],"Actualizaciones de versión.",{"_3227":65680,"_28581":65671,"_19785":109100,"_5":13558,"_26003":109077,"_2720":109101},[],"Soporte técnico y SLA según el plan contratado.",{"_3227":65681,"_28581":65671,"_19785":109103,"_5":13558,"_26003":109081,"_2720":46510},[],{"_3227":65682,"_28581":65671,"_19785":109105,"_5":13558,"_26003":109081,"_2720":109106},[],"Dispositivos",{"_3227":65683,"_28581":65671,"_19785":109108,"_5":13558,"_26003":109081,"_2720":109109},[],"Soporte",{"_3227":65684,"_28581":65671,"_19785":109111,"_5":13558,"_26003":109081,"_2720":46519},[],{"_3227":65685,"_28581":65671,"_19785":109113,"_5":13558,"_26003":109081,"_2720":46522},[],{"_3227":65686,"_28581":65671,"_19785":109115,"_5":13558,"_26003":109081,"_2720":109116},[],"Hasta 1.000",{"_3227":65687,"_28581":65671,"_19785":109118,"_5":13558,"_26003":109081,"_2720":46528},[],{"_3227":65688,"_28581":65671,"_19785":109120,"_5":13558,"_26003":109081,"_2720":109121},[],"99,5 %",{"_3227":65689,"_28581":65671,"_19785":109123,"_5":13558,"_26003":109081,"_2720":46534},[],{"_3227":65690,"_28581":65671,"_19785":109125,"_5":13558,"_26003":109081,"_2720":109126},[],"Hasta 10.000",{"_3227":65691,"_28581":65671,"_19785":109128,"_5":13558,"_26003":109081,"_2720":109129},[],"Email y chat",{"_3227":65692,"_28581":65671,"_19785":109131,"_5":13558,"_26003":109081,"_2720":109132},[],"99,9 %",{"_3227":65693,"_28581":65671,"_19785":109134,"_5":13558,"_26003":109081,"_2720":46546},[],{"_3227":65694,"_28581":65671,"_19785":109136,"_5":13558,"_26003":109081,"_2720":109137},[],"Ilimitados",{"_3227":65695,"_28581":65671,"_19785":109139,"_5":13558,"_26003":109081,"_2720":109140},[],"Dedicado",{"_3227":65696,"_28581":65671,"_19785":109142,"_5":13558,"_26003":109081,"_2720":109143},[],"99,99 %",{"_3227":65697,"_28581":65671,"_19785":109145,"_5":13558,"_26003":109085,"_2720":109146},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3227":65698,"_28581":65671,"_19785":109148,"_5":13558,"_26003":109085,"_2720":109149},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3227":65699,"_28581":65699,"_5":13916,"_2720":46563,"_28924":109151,"_19785":109153,"_26003":65699},[46319,108918,109152],"Kubernetes autogestionado",[],{"_3227":65700,"_28581":65699,"_19785":109155,"_5":13558,"_26003":65699,"_2720":109156},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3227":65701,"_28581":65699,"_5":28921,"_19785":109158,"_26003":109159,"_2720":109160},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3227":65702,"_28581":65699,"_5":28921,"_19785":109162,"_26003":109163,"_2720":109164},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3227":65703,"_28581":65699,"_5":28921,"_19785":109166,"_26003":109167,"_2720":109168},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3227":65704,"_28581":65699,"_5":28921,"_19785":109170,"_26003":109171,"_2720":109172},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3227":65705,"_28581":65699,"_5":28921,"_19785":109174,"_26003":109175,"_2720":109176},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3227":65706,"_28581":65699,"_5":28921,"_19785":109178,"_26003":109179,"_2720":109180},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3227":65707,"_28581":65699,"_5":28921,"_19785":109182,"_26003":109183,"_2720":109184},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3227":65708,"_28581":65699,"_5":28921,"_19785":109186,"_26003":109187,"_2720":109188},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3227":65709,"_28581":65699,"_5":28921,"_19785":109190,"_26003":109191,"_2720":109192},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3227":65710,"_28581":65699,"_5":28921,"_19785":109194,"_26003":109195,"_2720":109196},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3227":65711,"_28581":65699,"_5":28921,"_19785":109198,"_26003":109199,"_2720":109200},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3227":65712,"_28581":65699,"_19785":109202,"_5":13558,"_26003":109159,"_2720":109203},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3227":65713,"_28581":65699,"_19785":109205,"_5":13558,"_26003":109159,"_2720":109206},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3227":65714,"_28581":65699,"_19785":109208,"_5":13558,"_26003":109163,"_2720":109209},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3227":65715,"_28581":65699,"_19785":109211,"_5":13558,"_26003":109163,"_2720":109212},[],"Fastlane instala o configura",{"_3227":65716,"_28581":65699,"_19785":109214,"_5":13558,"_26003":109163,"_2720":109215},[],"Tú sigues proporcionando",{"_3227":65717,"_28581":65699,"_19785":109217,"_5":13558,"_26003":109163,"_2720":109218},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3227":65718,"_28581":65699,"_19785":109220,"_5":13558,"_26003":109163,"_2720":109221},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3227":65719,"_28581":65699,"_19785":109223,"_5":13558,"_26003":109163,"_2720":109224},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3227":65720,"_28581":65699,"_19785":109226,"_5":13558,"_26003":109163,"_2720":109227},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3227":65721,"_28581":65699,"_19785":109229,"_5":13558,"_26003":109163,"_2720":109230},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3227":65722,"_28581":65699,"_19785":109232,"_5":13558,"_26003":109163,"_2720":109233},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3227":65723,"_28581":65699,"_19785":109235,"_5":13558,"_26003":109163,"_2720":109236},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3227":65724,"_28581":65699,"_19785":109238,"_5":13558,"_26003":109163,"_2720":109239},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3227":65725,"_28581":65699,"_19785":109241,"_5":13558,"_26003":109163,"_2720":109242},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3227":65726,"_28581":65699,"_19785":109244,"_5":13558,"_26003":109167,"_2720":109245},[],"Necesitas:",{"_3227":65727,"_28581":65699,"_19785":109247,"_5":13558,"_26003":109167,"_2720":109248},[],"un clúster Kubernetes existente",{"_3227":65728,"_28581":65699,"_19785":109250,"_5":13558,"_26003":109167,"_2720":109251},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3227":65729,"_28581":65699,"_19785":109253,"_5":13558,"_26003":109167,"_2720":46665},[],{"_3227":65730,"_28581":65699,"_19785":109255,"_5":13558,"_26003":109167,"_2720":22412},[],{"_3227":65731,"_28581":65699,"_19785":109257,"_5":13558,"_26003":109167,"_2720":109258},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3227":65732,"_28581":65699,"_19785":109260,"_5":13558,"_26003":109167,"_2720":109261},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3227":65733,"_28581":65699,"_19785":109263,"_5":13558,"_26003":109167,"_2720":109264},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3227":65734,"_28581":65699,"_19785":109266,"_5":13558,"_26003":109167,"_2720":109267},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3227":65735,"_28581":65699,"_19785":109269,"_5":13558,"_26003":109167,"_2720":109270},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3227":65736,"_28581":65699,"_19785":109272,"_5":13558,"_26003":109171,"_2720":109273},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3227":65737,"_28581":65699,"_19785":109275,"_5":13558,"_26003":109171,"_2720":109276},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3227":65738,"_28581":65699,"_19785":109278,"_5":13558,"_26003":109175,"_2720":109279},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3227":65739,"_28581":65699,"_19785":109281,"_5":13558,"_26003":109175,"_2720":109282},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3227":65740,"_28581":65699,"_19785":109284,"_5":13558,"_26003":109175,"_2720":109285},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3227":65741,"_28581":65699,"_19785":109287,"_5":13558,"_26003":109175,"_2720":109288},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3227":65742,"_28581":65699,"_19785":109290,"_5":13558,"_26003":109179,"_2720":109291},[],"Opción",{"_3227":65743,"_28581":65699,"_19785":109293,"_5":13558,"_26003":109179,"_2720":109294},[],"Valor predeterminado",{"_3227":65744,"_28581":65699,"_19785":109296,"_5":13558,"_26003":109179,"_2720":109297},[],"Propósito",{"_3227":65745,"_28581":65699,"_19785":109299,"_5":13558,"_26003":109179,"_2720":46712},[],{"_3227":65746,"_28581":65699,"_19785":109301,"_5":13558,"_26003":109179,"_2720":46715},[],{"_3227":65747,"_28581":65699,"_19785":109303,"_5":13558,"_26003":109179,"_2720":109304},[],"Muestra la ayuda",{"_3227":65748,"_28581":65699,"_19785":109306,"_5":13558,"_26003":109179,"_2720":46721},[],{"_3227":65749,"_28581":65699,"_19785":109308,"_5":13558,"_26003":109179,"_2720":109309},[],"contexto actual",{"_3227":65750,"_28581":65699,"_19785":109311,"_5":13558,"_26003":109179,"_2720":109312},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3227":65751,"_28581":65699,"_19785":109314,"_5":13558,"_26003":109179,"_2720":46730},[],{"_3227":65752,"_28581":65699,"_19785":109316,"_5":13558,"_26003":109179,"_2720":6085},[],{"_3227":65753,"_28581":65699,"_19785":109318,"_5":13558,"_26003":109179,"_2720":109319},[],"Omite prompts y genera credenciales para las dependencias",{"_3227":65754,"_28581":65699,"_19785":109321,"_5":13558,"_26003":109179,"_2720":46738},[],{"_3227":65755,"_28581":65699,"_19785":109323,"_5":13558,"_26003":109179,"_2720":46741},[],{"_3227":65756,"_28581":65699,"_19785":109325,"_5":13558,"_26003":109179,"_2720":109326},[],"Namespace de la instalación",{"_3227":65757,"_28581":65699,"_19785":109328,"_5":13558,"_26003":109179,"_2720":46747},[],{"_3227":65758,"_28581":65699,"_19785":109330,"_5":13558,"_26003":109179,"_2720":46750},[],{"_3227":65759,"_28581":65699,"_19785":109332,"_5":13558,"_26003":109179,"_2720":109333},[],"Dominio usado por la UI, OIDC y el certificado",{"_3227":65760,"_28581":65699,"_19785":109335,"_5":13558,"_26003":109179,"_2720":46756},[],{"_3227":65761,"_28581":65699,"_19785":109337,"_5":13558,"_26003":109179,"_2720":14216},[],{"_3227":65762,"_28581":65699,"_19785":109339,"_5":13558,"_26003":109179,"_2720":109340},[],"Versión del chart de Lamassu",{"_3227":65763,"_28581":65699,"_19785":109342,"_5":13558,"_26003":109179,"_2720":46764},[],{"_3227":65764,"_28581":65699,"_19785":109344,"_5":13558,"_26003":109179,"_2720":46767},[],{"_3227":65765,"_28581":65699,"_19785":109346,"_5":13558,"_26003":109179,"_2720":109347},[],"Puerto del listener HTTPS",{"_3227":65766,"_28581":65699,"_19785":109349,"_5":13558,"_26003":109179,"_2720":46773},[],{"_3227":65767,"_28581":65699,"_19785":109351,"_5":13558,"_26003":109179,"_2720":46776},[],{"_3227":65768,"_28581":65699,"_19785":109353,"_5":13558,"_26003":109179,"_2720":109354},[],"Puerto del listener HTTP",{"_3227":65769,"_28581":65699,"_19785":109356,"_5":13558,"_26003":109179,"_2720":46782},[],{"_3227":65770,"_28581":65699,"_19785":109358,"_5":13558,"_26003":109179,"_2720":46715},[],{"_3227":65771,"_28581":65699,"_19785":109360,"_5":13558,"_26003":109179,"_2720":109361},[],"Certificado PEM para TLS downstream",{"_3227":65772,"_28581":65699,"_19785":109363,"_5":13558,"_26003":109179,"_2720":46790},[],{"_3227":65773,"_28581":65699,"_19785":109365,"_5":13558,"_26003":109179,"_2720":46715},[],{"_3227":65774,"_28581":65699,"_19785":109367,"_5":13558,"_26003":109179,"_2720":109368},[],"Clave privada PEM para TLS downstream",{"_3227":65775,"_28581":65699,"_19785":109370,"_5":13558,"_26003":109179,"_2720":46798},[],{"_3227":65776,"_28581":65699,"_19785":109372,"_5":13558,"_26003":109179,"_2720":109373},[],"chart del repositorio",{"_3227":65777,"_28581":65699,"_19785":109375,"_5":13558,"_26003":109179,"_2720":109376},[],"Usa un chart local de Lamassu sin empaquetar",{"_3227":65778,"_28581":65699,"_19785":109378,"_5":13558,"_26003":109179,"_2720":46807},[],{"_3227":65779,"_28581":65699,"_19785":109380,"_5":13558,"_26003":109179,"_2720":109381},[],"detección automática",{"_3227":65780,"_28581":65699,"_19785":109383,"_5":13558,"_26003":109179,"_2720":109384},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3227":65781,"_28581":65699,"_19785":109386,"_5":13558,"_26003":109179,"_2720":46815},[],{"_3227":65782,"_28581":65699,"_19785":109388,"_5":13558,"_26003":109179,"_2720":6085},[],{"_3227":65783,"_28581":65699,"_19785":109390,"_5":13558,"_26003":109179,"_2720":109391},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3227":65784,"_28581":65699,"_19785":109393,"_5":13558,"_26003":109179,"_2720":46823},[],{"_3227":65785,"_28581":65699,"_19785":109395,"_5":13558,"_26003":109179,"_2720":6085},[],{"_3227":65786,"_28581":65699,"_19785":109397,"_5":13558,"_26003":109179,"_2720":109398},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3227":65787,"_28581":65699,"_19785":109400,"_5":13558,"_26003":109179,"_2720":46831},[],{"_3227":65788,"_28581":65699,"_19785":109402,"_5":13558,"_26003":109179,"_2720":6085},[],{"_3227":65789,"_28581":65699,"_19785":109404,"_5":13558,"_26003":109179,"_2720":109405},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3227":65790,"_28581":65699,"_19785":109407,"_5":13558,"_26003":109179,"_2720":46839},[],{"_3227":65791,"_28581":65699,"_19785":109409,"_5":13558,"_26003":109179,"_2720":6085},[],{"_3227":65792,"_28581":65699,"_19785":109411,"_5":13558,"_26003":109179,"_2720":109412},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3227":65793,"_28581":65699,"_19785":109414,"_5":13558,"_26003":109179,"_2720":46847},[],{"_3227":65794,"_28581":65699,"_19785":109416,"_5":13558,"_26003":109179,"_2720":46850},[],{"_3227":65795,"_28581":65699,"_19785":109418,"_5":13558,"_26003":109179,"_2720":109419},[],"Usa otro chart local de SoftHSM",{"_3227":65796,"_28581":65699,"_19785":109421,"_5":13558,"_26003":109179,"_2720":109422},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3227":65797,"_28581":65699,"_19785":109424,"_5":13558,"_26003":109183,"_2720":109425},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3227":65798,"_28581":65699,"_19785":109427,"_5":13558,"_26003":109183,"_2720":109428},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3227":65799,"_28581":65699,"_19785":109430,"_5":13558,"_26003":109183,"_2720":109431},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3227":65800,"_28581":65699,"_19785":109433,"_5":13558,"_26003":109183,"_2720":109434},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3227":65801,"_28581":65699,"_19785":109436,"_5":13558,"_26003":109183,"_2720":109437},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3227":65802,"_28581":65699,"_19785":109439,"_5":13558,"_26003":109183,"_2720":109440},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3227":65803,"_28581":65699,"_19785":109442,"_5":13558,"_26003":109187,"_2720":46877},[],{"_3227":65804,"_28581":65699,"_19785":109444,"_5":13558,"_26003":109187,"_2720":109445},[],"valida las herramientas locales y el clúster seleccionado",{"_3227":65805,"_28581":65699,"_19785":109447,"_5":13558,"_26003":109187,"_2720":109448},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3227":65806,"_28581":65699,"_19785":109450,"_5":13558,"_26003":109187,"_2720":109451},[],"crea el namespace",{"_3227":65807,"_28581":65699,"_19785":109453,"_5":13558,"_26003":109187,"_2720":109454},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3227":65808,"_28581":65699,"_19785":109456,"_5":13558,"_26003":109187,"_2720":109457},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3227":65809,"_28581":65699,"_19785":109459,"_5":13558,"_26003":109187,"_2720":109460},[],"instala RabbitMQ",{"_3227":65810,"_28581":65699,"_19785":109462,"_5":13558,"_26003":109187,"_2720":109463},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3227":65811,"_28581":65699,"_19785":109465,"_5":13558,"_26003":109187,"_2720":109466},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3227":65812,"_28581":65699,"_19785":109468,"_5":13558,"_26003":109187,"_2720":109469},[],"carga datos de ejemplo opcionalmente",{"_3227":65813,"_28581":65699,"_19785":109471,"_5":13558,"_26003":109187,"_2720":109472},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3227":65814,"_28581":65699,"_19785":109474,"_5":13558,"_26003":109191,"_2720":109475},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3227":65815,"_28581":65699,"_19785":109477,"_5":13558,"_26003":109191,"_2720":109478},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3227":65816,"_28581":65699,"_19785":109480,"_5":13558,"_26003":109195,"_2720":109481},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3227":65817,"_28581":65699,"_19785":109483,"_5":13558,"_26003":109195,"_2720":109484},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3227":65818,"_28581":65699,"_19785":109486,"_5":13558,"_26003":109195,"_2720":109487},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3227":65819,"_28581":65699,"_19785":109489,"_5":13558,"_26003":109199,"_2720":109490},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3227":65820,"_28581":65820,"_5":13916,"_2720":109492,"_28924":109493,"_19785":109494,"_26003":65820},"Instala con Helm",[46319,108918,109152],[],{"_3227":65821,"_28581":65820,"_19785":109496,"_5":13558,"_26003":65820,"_2720":109497},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3227":65822,"_28581":65820,"_5":28921,"_19785":109499,"_26003":109500,"_2720":109501},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3227":65823,"_28581":65820,"_5":28921,"_19785":109503,"_26003":109504,"_2720":109168},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3227":65824,"_28581":65820,"_5":28921,"_19785":109506,"_26003":109507,"_2720":109508},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3227":65825,"_28581":65820,"_5":28921,"_19785":109510,"_26003":109511,"_2720":109512},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3227":65826,"_28581":65820,"_5":28921,"_19785":109514,"_26003":109515,"_2720":109516},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3227":65827,"_28581":65820,"_5":28921,"_19785":109518,"_26003":109519,"_2720":109520},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3227":65828,"_28581":65820,"_5":28921,"_19785":109522,"_26003":109523,"_2720":109524},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3227":65829,"_28581":65820,"_5":28921,"_19785":109526,"_26003":109527,"_2720":109528},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3227":65830,"_28581":65820,"_5":28921,"_19785":109530,"_26003":109531,"_2720":109532},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3227":65831,"_28581":65820,"_5":28921,"_19785":109534,"_26003":109535,"_2720":109536},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3227":65832,"_28581":65820,"_19785":109538,"_5":13558,"_26003":109500,"_2720":109539},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3227":65833,"_28581":65820,"_19785":109541,"_5":13558,"_26003":109504,"_2720":109542},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3227":65834,"_28581":65820,"_19785":109544,"_5":13558,"_26003":109504,"_2720":109545},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3227":65835,"_28581":65820,"_19785":109547,"_5":13558,"_26003":109504,"_2720":109548},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3227":65836,"_28581":65820,"_19785":109550,"_5":13558,"_26003":109504,"_2720":109551},[],"un broker RabbitMQ accesible y sus credenciales",{"_3227":65837,"_28581":65820,"_19785":109553,"_5":13558,"_26003":109504,"_2720":109554},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3227":65838,"_28581":65820,"_19785":109556,"_5":13558,"_26003":109504,"_2720":109557},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3227":65839,"_28581":65820,"_19785":109559,"_5":13558,"_26003":109504,"_2720":109560},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3227":65840,"_28581":65820,"_19785":109562,"_5":13558,"_26003":109504,"_2720":109563},[],"una StorageClass y un diseño de tráfico externo",{"_3227":65841,"_28581":65820,"_19785":109565,"_5":13558,"_26003":109504,"_2720":109566},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3227":65842,"_28581":65820,"_19785":109568,"_5":13558,"_26003":109504,"_2720":109569},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3227":65843,"_28581":65820,"_19785":109571,"_5":13558,"_26003":109504,"_2720":109572},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3227":65844,"_28581":65820,"_19785":109574,"_5":13558,"_26003":109507,"_2720":109575},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3227":65845,"_28581":65820,"_19785":109577,"_5":13558,"_26003":109507,"_2720":109578},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3227":65846,"_28581":65820,"_19785":109580,"_5":13558,"_26003":109507,"_2720":109581},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3227":65847,"_28581":65820,"_19785":109583,"_5":13558,"_26003":109511,"_2720":109584},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3227":65848,"_28581":65820,"_19785":109586,"_5":13558,"_26003":109511,"_2720":109587},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3227":65849,"_28581":65820,"_19785":109589,"_5":13558,"_26003":109511,"_2720":109590},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3227":65850,"_28581":65820,"_19785":109592,"_5":13558,"_26003":109511,"_2720":109593},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3227":65851,"_28581":65820,"_19785":109595,"_5":13558,"_26003":109515,"_2720":109596},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3227":65852,"_28581":65820,"_19785":109598,"_5":13558,"_26003":109519,"_2720":109599},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3227":65853,"_28581":65820,"_19785":109601,"_5":13558,"_26003":109519,"_2720":109602},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3227":65854,"_28581":65820,"_19785":109604,"_5":13558,"_26003":109519,"_2720":109605},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3227":65855,"_28581":65820,"_19785":109607,"_5":13558,"_26003":109519,"_2720":109608},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3227":65856,"_28581":65820,"_19785":109610,"_5":13558,"_26003":109519,"_2720":109611},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3227":65857,"_28581":65820,"_19785":109613,"_5":13558,"_26003":109519,"_2720":109614},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3227":65858,"_28581":65820,"_19785":109616,"_5":13558,"_26003":109519,"_2720":109617},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro.",{"_3227":65859,"_28581":65820,"_19785":109619,"_5":13558,"_26003":109523,"_2720":109620},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3227":65860,"_28581":65820,"_19785":109622,"_5":13558,"_26003":109523,"_2720":109623},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3227":65861,"_28581":65820,"_19785":109625,"_5":13558,"_26003":109523,"_2720":109626},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3227":65862,"_28581":65820,"_19785":109628,"_5":13558,"_26003":109523,"_2720":109629},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3227":65863,"_28581":65820,"_19785":109631,"_5":13558,"_26003":109527,"_2720":109632},[],"Para instalar un checkout local:",{"_3227":65864,"_28581":65820,"_19785":109634,"_5":13558,"_26003":109531,"_2720":109635},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3227":65865,"_28581":65820,"_19785":109637,"_5":13558,"_26003":109531,"_2720":109638},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3227":65866,"_28581":65820,"_19785":109640,"_5":13558,"_26003":109535,"_2720":109641},[],"Antes de pasar a producción, revisa:",{"_3227":65867,"_28581":65820,"_19785":109643,"_5":13558,"_26003":109535,"_2720":109644},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3227":65868,"_28581":65820,"_19785":109646,"_5":13558,"_26003":109535,"_2720":109647},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3227":65869,"_28581":65820,"_19785":109649,"_5":13558,"_26003":109535,"_2720":109650},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3227":65870,"_28581":65820,"_19785":109652,"_5":13558,"_26003":109535,"_2720":109653},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3227":65871,"_28581":65820,"_19785":109655,"_5":13558,"_26003":109535,"_2720":109656},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3227":65872,"_28581":65820,"_19785":109658,"_5":13558,"_26003":109535,"_2720":109659},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3227":65873,"_28581":65820,"_19785":109661,"_5":13558,"_26003":109535,"_2720":109662},[],"SMTP, observabilidad y entrega de alertas",{"_3227":65874,"_28581":65820,"_19785":109664,"_5":13558,"_26003":109535,"_2720":109665},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3227":65875,"_28581":65820,"_19785":109667,"_5":13558,"_26003":109535,"_2720":109668},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3227":65876,"_28581":65876,"_5":13916,"_2720":109670,"_28924":109671,"_19785":109672,"_26003":65876},"Expón el Gateway",[46319,108918,109152],[],{"_3227":65877,"_28581":65876,"_19785":109674,"_5":13558,"_26003":65876,"_2720":109675},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3227":65878,"_28581":65876,"_5":28921,"_19785":109677,"_26003":109678,"_2720":109679},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3227":65879,"_28581":65876,"_5":28921,"_19785":109681,"_26003":109682,"_2720":109683},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3227":65880,"_28581":65876,"_5":28921,"_19785":109685,"_26003":109686,"_2720":109687},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3227":65881,"_28581":65876,"_5":28921,"_19785":109689,"_26003":109690,"_2720":47126},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#k3s",{"_3227":65882,"_28581":65876,"_5":28921,"_19785":109692,"_26003":109693,"_2720":109694},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3227":65883,"_28581":65876,"_5":28921,"_19785":109696,"_26003":109697,"_2720":109698},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3227":65884,"_28581":65876,"_5":28921,"_19785":109700,"_26003":109701,"_2720":109702},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3227":65885,"_28581":65876,"_5":28921,"_19785":109704,"_26003":109705,"_2720":109706},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3227":65886,"_28581":65876,"_5":28921,"_19785":109708,"_26003":109709,"_2720":109710},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3227":65887,"_28581":65876,"_5":28921,"_19785":109712,"_26003":109713,"_2720":109714},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3227":65888,"_28581":65876,"_19785":109716,"_5":13558,"_26003":109678,"_2720":109717},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3227":65889,"_28581":65876,"_19785":109719,"_5":13558,"_26003":109678,"_2720":109720},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3227":65890,"_28581":65876,"_19785":109722,"_5":13558,"_26003":109682,"_2720":109723},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3227":65891,"_28581":65876,"_19785":109725,"_5":13558,"_26003":109682,"_2720":109726},[],"Defínelo únicamente cuando:",{"_3227":65892,"_28581":65876,"_19785":109728,"_5":13558,"_26003":109682,"_2720":109729},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3227":65893,"_28581":65876,"_19785":109731,"_5":13558,"_26003":109682,"_2720":109732},[],"esa dirección está asignada a este Gateway",{"_3227":65894,"_28581":65876,"_19785":109734,"_5":13558,"_26003":109682,"_2720":109735},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3227":65895,"_28581":65876,"_19785":109737,"_5":13558,"_26003":109682,"_2720":109738},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3227":65896,"_28581":65876,"_19785":109740,"_5":13558,"_26003":109682,"_2720":109741},[],"No confundas estos valores:",{"_3227":65897,"_28581":65876,"_19785":109743,"_5":13558,"_26003":109682,"_2720":109744},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3227":65898,"_28581":65876,"_19785":109746,"_5":13558,"_26003":109682,"_2720":109747},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3227":65899,"_28581":65876,"_19785":109749,"_5":13558,"_26003":109682,"_2720":109750},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3227":65900,"_28581":65876,"_19785":109752,"_5":13558,"_26003":109686,"_2720":109753},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3227":65901,"_28581":65876,"_19785":109755,"_5":13558,"_26003":109686,"_2720":109756},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3227":65902,"_28581":65876,"_19785":109758,"_5":13558,"_26003":109690,"_2720":109759},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3227":65903,"_28581":65876,"_19785":109761,"_5":13558,"_26003":109690,"_2720":109762},[],"Para el diseño recomendado:",{"_3227":65904,"_28581":65876,"_19785":109764,"_5":13558,"_26003":109690,"_2720":109765},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3227":65905,"_28581":65876,"_19785":109767,"_5":13558,"_26003":109690,"_2720":109768},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3227":65906,"_28581":65876,"_19785":109770,"_5":13558,"_26003":109690,"_2720":109771},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3227":65907,"_28581":65876,"_19785":109773,"_5":13558,"_26003":109690,"_2720":109774},[],"Apunta DNS a la dirección accesible de la VM.",{"_3227":65908,"_28581":65876,"_19785":109776,"_5":13558,"_26003":109690,"_2720":109777},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3227":65909,"_28581":65876,"_19785":109779,"_5":13558,"_26003":109693,"_2720":109780},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3227":65910,"_28581":65876,"_19785":109782,"_5":13558,"_26003":109697,"_2720":109783},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3227":65911,"_28581":65876,"_19785":109785,"_5":13558,"_26003":109697,"_2720":109786},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3227":65912,"_28581":65876,"_19785":109788,"_5":13558,"_26003":109701,"_2720":109789},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3227":65913,"_28581":65876,"_19785":109791,"_5":13558,"_26003":109701,"_2720":109792},[],"Requisito",{"_3227":65914,"_28581":65876,"_19785":109794,"_5":13558,"_26003":109701,"_2720":109795},[],"Diseño recomendado",{"_3227":65915,"_28581":65876,"_19785":109797,"_5":13558,"_26003":109701,"_2720":109798},[],"Consecuencia",{"_3227":65916,"_28581":65876,"_19785":109800,"_5":13558,"_26003":109701,"_2720":109801},[],"Varias URL o servicios de Lamassu",{"_3227":65917,"_28581":65876,"_19785":109803,"_5":13558,"_26003":109701,"_2720":109804},[],"Un Gateway con varias rutas",{"_3227":65918,"_28581":65876,"_19785":109806,"_5":13558,"_26003":109701,"_2720":109807},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3227":65919,"_28581":65876,"_19785":109809,"_5":13558,"_26003":109701,"_2720":109810},[],"Gateways independientes e IP externas distintas",{"_3227":65920,"_28581":65876,"_19785":109812,"_5":13558,"_26003":109701,"_2720":109813},[],"Una VIP por Gateway",{"_3227":65921,"_28581":65876,"_19785":109815,"_5":13558,"_26003":109701,"_2720":109816},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3227":65922,"_28581":65876,"_19785":109818,"_5":13558,"_26003":109701,"_2720":109819},[],"Gateways independientes, un nodo y una IP",{"_3227":65923,"_28581":65876,"_19785":109821,"_5":13558,"_26003":109701,"_2720":109822},[],"Puertos externos diferentes",{"_3227":65924,"_28581":65876,"_19785":109824,"_5":13558,"_26003":109701,"_2720":109825},[],"Los clientes deben indicar puertos no estándar",{"_3227":65925,"_28581":65876,"_19785":109827,"_5":13558,"_26003":109701,"_2720":109828},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3227":65926,"_28581":65876,"_19785":109830,"_5":13558,"_26003":109701,"_2720":109831},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3227":65927,"_28581":65876,"_19785":109833,"_5":13558,"_26003":109701,"_2720":109834},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3227":65928,"_28581":65876,"_19785":109836,"_5":13558,"_26003":109701,"_2720":109837},[],"Recursos Gateway separados pero proxy compartido",{"_3227":65929,"_28581":65876,"_19785":109839,"_5":13558,"_26003":109701,"_2720":109840},[],"Modo merged Gateway de Envoy",{"_3227":65930,"_28581":65876,"_19785":109842,"_5":13558,"_26003":109701,"_2720":109843},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3227":65931,"_28581":65876,"_19785":109845,"_5":13558,"_26003":109701,"_2720":109846},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3227":65932,"_28581":65876,"_19785":109848,"_5":13558,"_26003":109701,"_2720":109849},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3227":65933,"_28581":65876,"_19785":109851,"_5":13558,"_26003":109701,"_2720":109852},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3227":65934,"_28581":65876,"_19785":109854,"_5":13558,"_26003":109701,"_2720":109855},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3227":65935,"_28581":65876,"_19785":109857,"_5":13558,"_26003":109705,"_2720":109858},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3227":65936,"_28581":65876,"_19785":109860,"_5":13558,"_26003":109705,"_2720":109861},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3227":65937,"_28581":65876,"_19785":109863,"_5":13558,"_26003":109705,"_2720":109864},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3227":65938,"_28581":65876,"_19785":109866,"_5":13558,"_26003":109705,"_2720":109867},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3227":65939,"_28581":65876,"_19785":109869,"_5":13558,"_26003":109705,"_2720":109870},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3227":65940,"_28581":65876,"_19785":109872,"_5":13558,"_26003":109709,"_2720":109873},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3227":65941,"_28581":65876,"_19785":109875,"_5":13558,"_26003":109709,"_2720":109876},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3227":65942,"_28581":65876,"_19785":109878,"_5":13558,"_26003":109713,"_2720":109879},[],"Comprueba, en orden:",{"_3227":65943,"_28581":65876,"_19785":109881,"_5":13558,"_26003":109713,"_2720":109882},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3227":65944,"_28581":65876,"_19785":109884,"_5":13558,"_26003":109713,"_2720":109885},[],"Su estado contiene la dirección esperada.",{"_3227":65945,"_28581":65876,"_19785":109887,"_5":13558,"_26003":109713,"_2720":109888},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3227":65946,"_28581":65876,"_19785":109890,"_5":13558,"_26003":109713,"_2720":109891},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3227":65947,"_28581":65876,"_19785":109893,"_5":13558,"_26003":109713,"_2720":109894},[],"DNS resuelve al endpoint accesible externamente.",{"_3227":65948,"_28581":65876,"_19785":109896,"_5":13558,"_26003":109713,"_2720":109897},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3227":65949,"_28581":65876,"_19785":109899,"_5":13558,"_26003":109713,"_2720":109900},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3227":65950,"_28581":65950,"_5":13916,"_2720":46426,"_28924":109902,"_19785":109903,"_26003":65950},[46319,108918,109152],[],{"_3227":65951,"_28581":65950,"_19785":109905,"_5":13558,"_26003":65950,"_2720":109906},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3227":65952,"_28581":65950,"_5":28921,"_19785":109908,"_26003":109909,"_2720":109910},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3227":65953,"_28581":65950,"_5":28921,"_19785":109912,"_26003":109913,"_2720":109914},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3227":65954,"_28581":65950,"_5":28921,"_19785":109916,"_26003":109917,"_2720":109918},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3227":65955,"_28581":65950,"_5":28921,"_19785":109920,"_26003":109921,"_2720":109922},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3227":65956,"_28581":65950,"_5":28921,"_19785":109924,"_26003":109925,"_2720":109926},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3227":65957,"_28581":65950,"_5":28921,"_19785":109928,"_26003":109929,"_2720":109930},[],"/docs/pr-preview/pr-42/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3227":65958,"_28581":65950,"_19785":109932,"_5":13558,"_26003":109909,"_2720":109933},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3227":65959,"_28581":65950,"_19785":109935,"_5":13558,"_26003":109913,"_2720":109936},[],"Flujo",{"_3227":65960,"_28581":65950,"_19785":109938,"_5":13558,"_26003":109913,"_2720":109939},[],"Úsalo para",{"_3227":65961,"_28581":65950,"_19785":109941,"_5":13558,"_26003":109913,"_2720":109942},[],"Qué instala",{"_3227":65962,"_28581":65950,"_19785":109944,"_5":13558,"_26003":109913,"_2720":47381},[],{"_3227":65963,"_28581":65950,"_19785":109946,"_5":13558,"_26003":109913,"_2720":109947},[],"Producción y entornos controlados",{"_3227":65964,"_28581":65950,"_19785":109949,"_5":13558,"_26003":109913,"_2720":109950},[],"Servicios de Lamassu y recursos de Gateway API",{"_3227":65965,"_28581":65950,"_19785":109952,"_5":13558,"_26003":109913,"_2720":46563},[],{"_3227":65966,"_28581":65950,"_19785":109954,"_5":13558,"_26003":109913,"_2720":109955},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3227":65967,"_28581":65950,"_19785":109957,"_5":13558,"_26003":109913,"_2720":109958},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3227":65968,"_28581":65950,"_19785":109960,"_5":13558,"_26003":109917,"_2720":109961},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3227":65969,"_28581":65950,"_19785":109963,"_5":13558,"_26003":109917,"_2720":109964},[],"Área",{"_3227":65970,"_28581":65950,"_19785":109966,"_5":13558,"_26003":109917,"_2720":109967},[],"El chart de Lamassu proporciona",{"_3227":65971,"_28581":65950,"_19785":109969,"_5":13558,"_26003":109917,"_2720":109970},[],"Tú proporcionas",{"_3227":65972,"_28581":65950,"_19785":109972,"_5":13558,"_26003":109917,"_2720":109973},[],"Aplicaciones Lamassu",{"_3227":65973,"_28581":65950,"_19785":109975,"_5":13558,"_26003":109917,"_2720":109976},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3227":65974,"_28581":65950,"_19785":109978,"_5":13558,"_26003":109917,"_2720":109979},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3227":65975,"_28581":65950,"_19785":109981,"_5":13558,"_26003":109917,"_2720":109982},[],"Datos PostgreSQL",{"_3227":65976,"_28581":65950,"_19785":109984,"_5":13558,"_26003":109917,"_2720":109985},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3227":65977,"_28581":65950,"_19785":109987,"_5":13558,"_26003":109917,"_2720":109988},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3227":65978,"_28581":65950,"_19785":109990,"_5":13558,"_26003":109917,"_2720":109991},[],"Mensajería",{"_3227":65979,"_28581":65950,"_19785":109993,"_5":13558,"_26003":109917,"_2720":109994},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3227":65980,"_28581":65950,"_19785":109996,"_5":13558,"_26003":109917,"_2720":109997},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3227":65981,"_28581":65950,"_19785":109999,"_5":13558,"_26003":109917,"_2720":110000},[],"Identidad",{"_3227":65982,"_28581":65950,"_19785":110002,"_5":13558,"_26003":109917,"_2720":110003},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3227":65983,"_28581":65950,"_19785":110005,"_5":13558,"_26003":109917,"_2720":110006},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3227":65984,"_28581":65950,"_19785":110008,"_5":13558,"_26003":109917,"_2720":110009},[],"Enrutamiento externo",{"_3227":65985,"_28581":65950,"_19785":110011,"_5":13558,"_26003":109917,"_2720":110012},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3227":65986,"_28581":65950,"_19785":110014,"_5":13558,"_26003":109917,"_2720":110015},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3227":65987,"_28581":65950,"_19785":110017,"_5":13558,"_26003":109917,"_2720":47455},[],{"_3227":65988,"_28581":65950,"_19785":110019,"_5":13558,"_26003":109917,"_2720":110020},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3227":65989,"_28581":65950,"_19785":110022,"_5":13558,"_26003":109917,"_2720":110023},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3227":65990,"_28581":65950,"_19785":110025,"_5":13558,"_26003":109917,"_2720":110026},[],"Datos persistentes de la aplicación",{"_3227":65991,"_28581":65950,"_19785":110028,"_5":13558,"_26003":109917,"_2720":110029},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3227":65992,"_28581":65950,"_19785":110031,"_5":13558,"_26003":109917,"_2720":110032},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3227":65993,"_28581":65950,"_19785":110034,"_5":13558,"_26003":109917,"_2720":110035},[],"Integraciones opcionales",{"_3227":65994,"_28581":65950,"_19785":110037,"_5":13558,"_26003":109917,"_2720":110038},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3227":65995,"_28581":65950,"_19785":110040,"_5":13558,"_26003":109917,"_2720":110041},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3227":65996,"_28581":65950,"_19785":110043,"_5":13558,"_26003":109917,"_2720":110044},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3227":65997,"_28581":65950,"_19785":110046,"_5":13558,"_26003":109917,"_2720":110047},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3227":65998,"_28581":65950,"_19785":110049,"_5":13558,"_26003":109921,"_2720":110050},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3227":65999,"_28581":65950,"_19785":110052,"_5":13558,"_26003":109921,"_2720":110053},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3227":66000,"_28581":65950,"_19785":110055,"_5":13558,"_26003":109925,"_2720":110056},[],"Kubernetes 1.24 o posterior",{"_3227":66001,"_28581":65950,"_19785":110058,"_5":13558,"_26003":109925,"_2720":110059},[],"Helm 3.2 o posterior",{"_3227":66002,"_28581":65950,"_19785":110061,"_5":13558,"_26003":109925,"_2720":110062},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3227":66003,"_28581":65950,"_19785":110064,"_5":13558,"_26003":109925,"_2720":110065},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3227":66004,"_28581":65950,"_19785":110067,"_5":13558,"_26003":109925,"_2720":110068},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3227":66005,"_28581":65950,"_19785":110070,"_5":13558,"_26003":109925,"_2720":110071},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3227":66006,"_28581":65950,"_19785":110073,"_5":13558,"_26003":109925,"_2720":110074},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3227":66007,"_28581":65950,"_19785":110076,"_5":13558,"_26003":109929,"_2720":110077},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3227":66008,"_28581":65950,"_19785":110079,"_5":13558,"_26003":109929,"_2720":110080},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3227":66009,"_28581":65950,"_19785":110082,"_5":13558,"_26003":109929,"_2720":110083},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3227":66010,"_28581":65950,"_19785":110085,"_5":13558,"_26003":109929,"_2720":110086},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3227":66011,"_28581":66011,"_5":13916,"_2720":110088,"_28924":110089,"_19785":110091,"_26003":66011},"Resolución de problemas de despliegue",[46319,108918,110090],"Operación",[],{"_3227":66012,"_28581":66011,"_19785":110093,"_5":13558,"_26003":66011,"_2720":110094},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3227":66013,"_28581":66011,"_5":28921,"_19785":110096,"_26003":110097,"_2720":110098},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3227":66014,"_28581":66011,"_5":28921,"_19785":110100,"_26003":110101,"_2720":110102},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3227":66015,"_28581":66011,"_5":28921,"_19785":110104,"_26003":110105,"_2720":110106},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3227":66016,"_28581":66011,"_5":28921,"_19785":110108,"_26003":110109,"_2720":110110},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3227":66017,"_28581":66011,"_5":28921,"_19785":110112,"_26003":110113,"_2720":110114},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3227":66018,"_28581":66011,"_5":28921,"_19785":110116,"_26003":110117,"_2720":110118},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3227":66019,"_28581":66011,"_5":28921,"_19785":110120,"_26003":110121,"_2720":110122},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3227":66020,"_28581":66011,"_5":28921,"_19785":110124,"_26003":110125,"_2720":110126},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3227":66021,"_28581":66011,"_5":28921,"_19785":110128,"_26003":110129,"_2720":110130},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3227":66022,"_28581":66011,"_5":28921,"_19785":110132,"_26003":110133,"_2720":110134},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3227":66023,"_28581":66011,"_5":28921,"_19785":110136,"_26003":110137,"_2720":110138},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3227":66024,"_28581":66011,"_5":28921,"_19785":110140,"_26003":110141,"_2720":110142},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3227":66025,"_28581":66011,"_5":28921,"_19785":110144,"_26003":110145,"_2720":110146},[],"/docs/pr-preview/pr-42/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3227":66026,"_28581":66011,"_19785":110148,"_5":13558,"_26003":66011,"_2720":110149},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3227":66027,"_28581":66011,"_19785":110151,"_5":13558,"_26003":110101,"_2720":110152},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3227":66028,"_28581":66011,"_19785":110154,"_5":13558,"_26003":110105,"_2720":110155},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3227":66029,"_28581":66011,"_19785":110157,"_5":13558,"_26003":110109,"_2720":110158},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3227":66030,"_28581":66011,"_19785":110160,"_5":13558,"_26003":110113,"_2720":110161},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3227":66031,"_28581":66011,"_19785":110163,"_5":13558,"_26003":110117,"_2720":110164},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3227":66032,"_28581":66011,"_19785":110166,"_5":13558,"_26003":110121,"_2720":110167},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3227":66033,"_28581":66011,"_19785":110169,"_5":13558,"_26003":110121,"_2720":110170},[],"Ejecuta también la prueba de conectividad del chart:",{"_3227":66034,"_28581":66011,"_19785":110172,"_5":13558,"_26003":110121,"_2720":110173},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3227":66035,"_28581":66011,"_19785":110175,"_5":13558,"_26003":110121,"_2720":110176},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3227":66036,"_28581":66011,"_19785":110178,"_5":13558,"_26003":110125,"_2720":110179},[],"Si recibes un 401:",{"_3227":66037,"_28581":66011,"_19785":110181,"_5":13558,"_26003":110125,"_2720":110182},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3227":66038,"_28581":66011,"_19785":110184,"_5":13558,"_26003":110125,"_2720":110185},[],"verifica emisor, audiencia y expiración del token;",{"_3227":66039,"_28581":66011,"_19785":110187,"_5":13558,"_26003":110125,"_2720":110188},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3227":66040,"_28581":66011,"_19785":110190,"_5":13558,"_26003":110125,"_2720":110191},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3227":66041,"_28581":66011,"_19785":110193,"_5":13558,"_26003":110125,"_2720":110194},[],"Si el login termina pero las APIs devuelven 403:",{"_3227":66042,"_28581":66011,"_19785":110196,"_5":13558,"_26003":110125,"_2720":110197},[],"inspecciona los claims reales del token;",{"_3227":66043,"_28581":66011,"_19785":110199,"_5":13558,"_26003":110125,"_2720":110200},[],"confirma que coinciden con un principal activo;",{"_3227":66044,"_28581":66011,"_19785":110202,"_5":13558,"_26003":110125,"_2720":110203},[],"revisa las políticas concedidas al principal;",{"_3227":66045,"_28581":66011,"_19785":110205,"_5":13558,"_26003":110125,"_2720":110206},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3227":66046,"_28581":66011,"_19785":110208,"_5":13558,"_26003":110125,"_2720":110209},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3227":66047,"_28581":66011,"_19785":110211,"_5":13558,"_26003":110129,"_2720":110212},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3227":66048,"_28581":66011,"_19785":110214,"_5":13558,"_26003":110129,"_2720":110215},[],"Localiza el pod y Service de authz.",{"_3227":66049,"_28581":66011,"_19785":110217,"_5":13558,"_26003":110129,"_2720":110218},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3227":66050,"_28581":66011,"_19785":110220,"_5":13558,"_26003":110129,"_2720":110221},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3227":66051,"_28581":66011,"_19785":110223,"_5":13558,"_26003":110129,"_2720":110224},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3227":66052,"_28581":66011,"_19785":110226,"_5":13558,"_26003":110129,"_2720":110227},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3227":66053,"_28581":66011,"_19785":110229,"_5":13558,"_26003":110133,"_2720":110230},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3227":66054,"_28581":66011,"_19785":110232,"_5":13558,"_26003":110137,"_2720":110233},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3227":66055,"_28581":66011,"_19785":110235,"_5":13558,"_26003":110137,"_2720":110236},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3227":66056,"_28581":66011,"_19785":110238,"_5":13558,"_26003":110137,"_2720":110239},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3227":66057,"_28581":66011,"_19785":110241,"_5":13558,"_26003":110137,"_2720":110242},[],"volumen persistente sin enlazar;",{"_3227":66058,"_28581":66011,"_19785":110244,"_5":13558,"_26003":110137,"_2720":110245},[],"imagen inaccesible o política de pull incorrecta;",{"_3227":66059,"_28581":66011,"_19785":110247,"_5":13558,"_26003":110137,"_2720":110248},[],"configuración inválida del motor criptográfico;",{"_3227":66060,"_28581":66011,"_19785":110250,"_5":13558,"_26003":110137,"_2720":110251},[],"límites de CPU o memoria demasiado bajos;",{"_3227":66061,"_28581":66011,"_19785":110253,"_5":13558,"_26003":110137,"_2720":110254},[],"migración previa incompleta.",{"_3227":66062,"_28581":66011,"_19785":110256,"_5":13558,"_26003":110137,"_2720":110257},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3227":66063,"_28581":66011,"_19785":110259,"_5":13558,"_26003":110137,"_2720":110260},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3227":66064,"_28581":66011,"_19785":110262,"_5":13558,"_26003":110137,"_2720":110263},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3227":66065,"_28581":66011,"_19785":110265,"_5":13558,"_26003":110141,"_2720":110266},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3227":66066,"_28581":66011,"_19785":110268,"_5":13558,"_26003":110141,"_2720":110269},[],"verifica que esté habilitado en el servicio emisor;",{"_3227":66067,"_28581":66011,"_19785":110271,"_5":13558,"_26003":110141,"_2720":110272},[],"comprueba conectividad y credenciales AMQP;",{"_3227":66068,"_28581":66011,"_19785":110274,"_5":13558,"_26003":110141,"_2720":110275},[],"revisa exchange, routing key, colas y consumidores;",{"_3227":66069,"_28581":66011,"_19785":110277,"_5":13558,"_26003":110141,"_2720":110278},[],"inspecciona dead-letter queues;",{"_3227":66070,"_28581":66011,"_19785":110280,"_5":13558,"_26003":110141,"_2720":110281},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3227":66071,"_28581":66011,"_19785":110283,"_5":13558,"_26003":110141,"_2720":110284},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3227":66072,"_28581":66011,"_19785":110286,"_5":13558,"_26003":110141,"_2720":110287},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3227":66073,"_28581":66011,"_19785":110289,"_5":13558,"_26003":110141,"_2720":110290},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); sin él, los clientes confían en las CA del sistema;",{"_3227":66074,"_28581":66011,"_19785":110292,"_5":13558,"_26003":110141,"_2720":110293},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3227":66075,"_28581":66011,"_19785":110295,"_5":13558,"_26003":110141,"_2720":110296},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3227":66076,"_28581":66011,"_19785":110298,"_5":13558,"_26003":110141,"_2720":110299},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3227":66077,"_28581":66011,"_19785":110301,"_5":13558,"_26003":110141,"_2720":110302},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3227":66078,"_28581":66011,"_19785":110304,"_5":13558,"_26003":110145,"_2720":110305},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3227":66079,"_28581":66011,"_19785":110307,"_5":13558,"_26003":110145,"_2720":110308},[],"Antes de cerrar una incidencia, guarda:",{"_3227":66080,"_28581":66011,"_19785":110310,"_5":13558,"_26003":110145,"_2720":110311},[],"causa confirmada;",{"_3227":66081,"_28581":66011,"_19785":110313,"_5":13558,"_26003":110145,"_2720":110314},[],"alcance temporal y recursos afectados;",{"_3227":66082,"_28581":66011,"_19785":110316,"_5":13558,"_26003":110145,"_2720":110317},[],"comandos o consultas utilizados;",{"_3227":66083,"_28581":66011,"_19785":110319,"_5":13558,"_26003":110145,"_2720":110320},[],"cambio aplicado y forma de revertirlo;",{"_3227":66084,"_28581":66011,"_19785":110322,"_5":13558,"_26003":110145,"_2720":110323},[],"validación desde un consumidor;",{"_3227":66085,"_28581":66011,"_19785":110325,"_5":13558,"_26003":110145,"_2720":110326},[],"acción preventiva y propietario.",{"_3227":66086,"_28581":66086,"_5":13916,"_2720":110328,"_28924":110329,"_19785":110332,"_26003":66086},"Control de acceso",[46319,110330,110331],"Plataforma","Administración",[],{"_3227":66087,"_28581":66086,"_19785":110334,"_5":13558,"_26003":66086,"_2720":110335},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3227":66088,"_28581":66086,"_5":28921,"_19785":110337,"_26003":110338,"_2720":110339},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3227":66089,"_28581":66086,"_5":28921,"_19785":110341,"_26003":110342,"_2720":110343},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3227":66090,"_28581":66086,"_5":28921,"_19785":110345,"_26003":110346,"_2720":110347},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3227":66091,"_28581":66086,"_5":28921,"_19785":110349,"_26003":110350,"_2720":110351},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3227":66092,"_28581":66086,"_5":28921,"_19785":110353,"_26003":110354,"_2720":110355},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3227":66093,"_28581":66086,"_5":28921,"_19785":110357,"_26003":110358,"_2720":110359},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3227":66094,"_28581":66086,"_5":28921,"_19785":110361,"_26003":110362,"_2720":110363},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3227":66095,"_28581":66086,"_5":28921,"_19785":110365,"_26003":110366,"_2720":110367},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3227":66096,"_28581":66086,"_5":28921,"_19785":110369,"_26003":110370,"_2720":110371},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3227":66097,"_28581":66086,"_5":28921,"_19785":110373,"_26003":110374,"_2720":110375},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3227":66098,"_28581":66086,"_5":28921,"_19785":110377,"_26003":110378,"_2720":110379},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3227":66099,"_28581":66086,"_5":28921,"_19785":110381,"_26003":110382,"_2720":110383},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3227":66100,"_28581":66086,"_5":28921,"_19785":110385,"_26003":110386,"_2720":110387},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3227":66101,"_28581":66086,"_5":28921,"_19785":110389,"_26003":110390,"_2720":110391},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3227":66102,"_28581":66086,"_5":28921,"_19785":110393,"_26003":110394,"_2720":110395},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3227":66103,"_28581":66086,"_5":28921,"_19785":110397,"_26003":110398,"_2720":109524},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3227":66104,"_28581":66086,"_5":28921,"_19785":110400,"_26003":110401,"_2720":110402},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3227":66105,"_28581":66086,"_5":28921,"_19785":110404,"_26003":110405,"_2720":110406},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3227":66106,"_28581":66086,"_5":28921,"_19785":110408,"_26003":110409,"_2720":110410},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3227":66107,"_28581":66086,"_5":28921,"_19785":110412,"_26003":110413,"_2720":110414},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3227":66108,"_28581":66086,"_5":28921,"_19785":110416,"_26003":110417,"_2720":110418},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3227":66109,"_28581":66086,"_5":28921,"_19785":110420,"_26003":110421,"_2720":110422},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3227":66110,"_28581":66086,"_5":28921,"_19785":110424,"_26003":110425,"_2720":110426},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3227":66111,"_28581":66086,"_5":28921,"_19785":110428,"_26003":110429,"_2720":110430},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3227":66112,"_28581":66086,"_5":28921,"_19785":110432,"_26003":110433,"_2720":110434},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3227":66113,"_28581":66086,"_5":28921,"_19785":110436,"_26003":110437,"_2720":110438},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3227":66114,"_28581":66086,"_5":28921,"_19785":110440,"_26003":110441,"_2720":110442},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3227":66115,"_28581":66086,"_5":28921,"_19785":110444,"_26003":110445,"_2720":110446},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3227":66116,"_28581":66086,"_5":28921,"_19785":110448,"_26003":110449,"_2720":110450},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3227":66117,"_28581":66086,"_5":28921,"_19785":110452,"_26003":110453,"_2720":110454},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3227":66118,"_28581":66086,"_5":28921,"_19785":110456,"_26003":110457,"_2720":110458},[],"/docs/pr-preview/pr-42/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3227":66119,"_28581":66086,"_19785":110460,"_5":13558,"_26003":66086,"_2720":110461},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3227":66120,"_28581":66086,"_19785":110463,"_5":13558,"_26003":66086,"_2720":110464},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3227":66121,"_28581":66086,"_19785":110466,"_5":13558,"_26003":66086,"_2720":110467},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3227":66122,"_28581":66086,"_19785":110469,"_5":13558,"_26003":110338,"_2720":110470},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3227":66123,"_28581":66086,"_19785":110472,"_5":13558,"_26003":110338,"_2720":110473},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3227":66124,"_28581":66086,"_19785":110475,"_5":13558,"_26003":110338,"_2720":110476},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3227":66125,"_28581":66086,"_19785":110478,"_5":13558,"_26003":110338,"_2720":110479},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3227":66126,"_28581":66086,"_19785":110481,"_5":13558,"_26003":110338,"_2720":110482},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3227":66127,"_28581":66086,"_19785":110484,"_5":13558,"_26003":110338,"_2720":110485},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3227":66128,"_28581":66086,"_19785":110487,"_5":13558,"_26003":110342,"_2720":110488},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3227":66129,"_28581":66086,"_19785":110490,"_5":13558,"_26003":110342,"_2720":110491},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3227":66130,"_28581":66086,"_19785":110493,"_5":13558,"_26003":110346,"_2720":110494},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3227":66131,"_28581":66086,"_19785":110496,"_5":13558,"_26003":110346,"_2720":110497},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3227":66132,"_28581":66086,"_19785":110499,"_5":13558,"_26003":110346,"_2720":110500},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3227":66133,"_28581":66086,"_19785":110502,"_5":13558,"_26003":110346,"_2720":110503},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3227":66134,"_28581":66086,"_19785":110505,"_5":13558,"_26003":110346,"_2720":110506},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3227":66135,"_28581":66086,"_19785":110508,"_5":13558,"_26003":110346,"_2720":110509},[],"Carga por separado las políticas concedidas a cada principal.",{"_3227":66136,"_28581":66086,"_19785":110511,"_5":13558,"_26003":110346,"_2720":110512},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3227":66137,"_28581":66086,"_19785":110514,"_5":13558,"_26003":110346,"_2720":110515},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3227":66138,"_28581":66086,"_19785":110517,"_5":13558,"_26003":110346,"_2720":110518},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3227":66139,"_28581":66086,"_19785":110520,"_5":13558,"_26003":110346,"_2720":110521},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3227":66140,"_28581":66086,"_19785":110523,"_5":13558,"_26003":110346,"_2720":110524},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3227":66141,"_28581":66086,"_19785":110526,"_5":13558,"_26003":110346,"_2720":110527},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3227":66142,"_28581":66086,"_19785":110529,"_5":13558,"_26003":110350,"_2720":110530},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3227":66143,"_28581":66086,"_19785":110532,"_5":13558,"_26003":110350,"_2720":110533},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3227":66144,"_28581":66086,"_19785":110535,"_5":13558,"_26003":110350,"_2720":110536},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3227":66145,"_28581":66086,"_19785":110538,"_5":13558,"_26003":110350,"_2720":110539},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3227":66146,"_28581":66086,"_19785":110541,"_5":13558,"_26003":110350,"_2720":110542},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3227":66147,"_28581":66086,"_19785":110544,"_5":13558,"_26003":110350,"_2720":110545},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3227":66148,"_28581":66086,"_19785":110547,"_5":13558,"_26003":110350,"_2720":110548},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3227":66149,"_28581":66086,"_19785":110550,"_5":13558,"_26003":110350,"_2720":110551},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3227":66150,"_28581":66086,"_19785":110553,"_5":13558,"_26003":110354,"_2720":110554},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3227":66151,"_28581":66086,"_19785":110556,"_5":13558,"_26003":110354,"_2720":110557},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3227":66152,"_28581":66086,"_19785":110559,"_5":13558,"_26003":110354,"_2720":110560},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3227":66153,"_28581":66086,"_19785":110562,"_5":13558,"_26003":110354,"_2720":110563},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3227":66154,"_28581":66086,"_19785":110565,"_5":13558,"_26003":110354,"_2720":110566},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3227":66155,"_28581":66086,"_19785":110568,"_5":13558,"_26003":110354,"_2720":110569},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3227":66156,"_28581":66086,"_19785":110571,"_5":13558,"_26003":110354,"_2720":110572},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3227":66157,"_28581":66086,"_19785":110574,"_5":13558,"_26003":110354,"_2720":110575},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3227":66158,"_28581":66086,"_19785":110577,"_5":13558,"_26003":110354,"_2720":110578},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3227":66159,"_28581":66086,"_19785":110580,"_5":13558,"_26003":110354,"_2720":110581},[],"Las acciones se dividen en dos grupos:",{"_3227":66160,"_28581":66086,"_19785":110583,"_5":13558,"_26003":110354,"_2720":110584},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3227":66161,"_28581":66086,"_19785":110586,"_5":13558,"_26003":110354,"_2720":110587},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3227":66162,"_28581":66086,"_19785":110589,"_5":13558,"_26003":110354,"_2720":110590},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3227":66163,"_28581":66086,"_19785":110592,"_5":13558,"_26003":110358,"_2720":110593},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3227":66164,"_28581":66086,"_19785":110595,"_5":13558,"_26003":110358,"_2720":110596},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3227":66165,"_28581":66086,"_19785":110598,"_5":13558,"_26003":110358,"_2720":110599},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3227":66166,"_28581":66086,"_19785":110601,"_5":13558,"_26003":110362,"_2720":110602},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3227":66167,"_28581":66086,"_19785":110604,"_5":13558,"_26003":110362,"_2720":110605},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3227":66168,"_28581":66086,"_19785":110607,"_5":13558,"_26003":110362,"_2720":110608},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3227":66169,"_28581":66086,"_19785":110610,"_5":13558,"_26003":110362,"_2720":110611},[],"Los operadores implementados son:",{"_3227":66170,"_28581":66086,"_19785":110613,"_5":13558,"_26003":110362,"_2720":110614},[],"`equals`, para igualdad exacta;",{"_3227":66171,"_28581":66086,"_19785":110616,"_5":13558,"_26003":110362,"_2720":110617},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3227":66172,"_28581":66086,"_19785":110619,"_5":13558,"_26003":110362,"_2720":110620},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3227":66173,"_28581":66086,"_19785":110622,"_5":13558,"_26003":110362,"_2720":110623},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3227":66174,"_28581":66086,"_19785":110625,"_5":13558,"_26003":110366,"_2720":110626},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3227":66175,"_28581":66086,"_19785":110628,"_5":13558,"_26003":110366,"_2720":110629},[],"Los modos disponibles son:",{"_3227":66176,"_28581":66086,"_19785":110631,"_5":13558,"_26003":110366,"_2720":110632},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3227":66177,"_28581":66086,"_19785":110634,"_5":13558,"_26003":110366,"_2720":110635},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3227":66178,"_28581":66086,"_19785":110637,"_5":13558,"_26003":110366,"_2720":110638},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3227":66179,"_28581":66086,"_19785":110640,"_5":13558,"_26003":110366,"_2720":110641},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3227":66180,"_28581":66086,"_19785":110643,"_5":13558,"_26003":110366,"_2720":110644},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3227":66181,"_28581":66086,"_19785":110646,"_5":13558,"_26003":110366,"_2720":110647},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3227":66182,"_28581":66086,"_19785":110649,"_5":13558,"_26003":110370,"_2720":110650},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3227":66183,"_28581":66086,"_19785":110652,"_5":13558,"_26003":110370,"_2720":110653},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3227":66184,"_28581":66086,"_19785":110655,"_5":13558,"_26003":110370,"_2720":110656},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3227":66185,"_28581":66086,"_19785":110658,"_5":13558,"_26003":110370,"_2720":110659},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3227":66186,"_28581":66086,"_19785":110661,"_5":13558,"_26003":110378,"_2720":110662},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3227":66187,"_28581":66086,"_19785":110664,"_5":13558,"_26003":110378,"_2720":110665},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3227":66188,"_28581":66086,"_19785":110667,"_5":13558,"_26003":110382,"_2720":110668},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3227":66189,"_28581":66086,"_19785":110670,"_5":13558,"_26003":110382,"_2720":110671},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3227":66190,"_28581":66086,"_19785":110673,"_5":13558,"_26003":110386,"_2720":110674},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3227":66191,"_28581":66086,"_19785":110676,"_5":13558,"_26003":110386,"_2720":110677},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3227":66192,"_28581":66086,"_19785":110679,"_5":13558,"_26003":110386,"_2720":110680},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3227":66193,"_28581":66086,"_19785":110682,"_5":13558,"_26003":110390,"_2720":110683},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3227":66194,"_28581":66086,"_19785":110685,"_5":13558,"_26003":110390,"_2720":110686},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3227":66195,"_28581":66086,"_19785":110688,"_5":13558,"_26003":110390,"_2720":110689},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3227":66196,"_28581":66086,"_19785":110691,"_5":13558,"_26003":110390,"_2720":110692},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3227":66197,"_28581":66086,"_19785":110694,"_5":13558,"_26003":110390,"_2720":110695},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3227":66198,"_28581":66086,"_19785":110697,"_5":13558,"_26003":110390,"_2720":110698},[],"Ten en cuenta que:",{"_3227":66199,"_28581":66086,"_19785":110700,"_5":13558,"_26003":110390,"_2720":110701},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3227":66200,"_28581":66086,"_19785":110703,"_5":13558,"_26003":110390,"_2720":110704},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3227":66201,"_28581":66086,"_19785":110706,"_5":13558,"_26003":110390,"_2720":110707},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3227":66202,"_28581":66086,"_19785":110709,"_5":13558,"_26003":110394,"_2720":110710},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3227":66203,"_28581":66086,"_19785":110712,"_5":13558,"_26003":110394,"_2720":110713},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3227":66204,"_28581":66086,"_19785":110715,"_5":13558,"_26003":110394,"_2720":110716},[],"acceso completo y de solo lectura a KMS;",{"_3227":66205,"_28581":66086,"_19785":110718,"_5":13558,"_26003":110394,"_2720":110719},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3227":66206,"_28581":66086,"_19785":110721,"_5":13558,"_26003":110394,"_2720":110722},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3227":66207,"_28581":66086,"_19785":110724,"_5":13558,"_26003":110394,"_2720":110725},[],"acceso a la interfaz;",{"_3227":66208,"_28581":66086,"_19785":110727,"_5":13558,"_26003":110394,"_2720":110728},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3227":66209,"_28581":66086,"_19785":110730,"_5":13558,"_26003":110394,"_2720":110731},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3227":66210,"_28581":66086,"_19785":110733,"_5":13558,"_26003":110394,"_2720":110734},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3227":66211,"_28581":66086,"_19785":110736,"_5":13558,"_26003":110398,"_2720":110737},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3227":66212,"_28581":66086,"_19785":110739,"_5":13558,"_26003":110398,"_2720":110740},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3227":66213,"_28581":66086,"_19785":110742,"_5":13558,"_26003":110398,"_2720":110743},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3227":66214,"_28581":66086,"_19785":110745,"_5":13558,"_26003":110401,"_2720":110746},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3227":66215,"_28581":66086,"_19785":110748,"_5":13558,"_26003":110405,"_2720":110749},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3227":66216,"_28581":66086,"_19785":110751,"_5":13558,"_26003":110405,"_2720":110752},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3227":66217,"_28581":66086,"_19785":110754,"_5":13558,"_26003":110409,"_2720":110755},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3227":66218,"_28581":66086,"_19785":110757,"_5":13558,"_26003":110413,"_2720":110758},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3227":66219,"_28581":66086,"_19785":110760,"_5":13558,"_26003":110417,"_2720":110761},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3227":66220,"_28581":66086,"_19785":110763,"_5":13558,"_26003":110421,"_2720":110764},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3227":66221,"_28581":66086,"_19785":110766,"_5":13558,"_26003":110421,"_2720":110767},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3227":66222,"_28581":66086,"_19785":110769,"_5":13558,"_26003":110425,"_2720":110770},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3227":66223,"_28581":66086,"_19785":110772,"_5":13558,"_26003":110425,"_2720":110773},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3227":66224,"_28581":66086,"_19785":110775,"_5":13558,"_26003":110425,"_2720":110776},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3227":66225,"_28581":66086,"_19785":110778,"_5":13558,"_26003":110425,"_2720":110779},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3227":66226,"_28581":66086,"_19785":110781,"_5":13558,"_26003":110425,"_2720":110782},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3227":66227,"_28581":66086,"_19785":110784,"_5":13558,"_26003":110425,"_2720":110785},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3227":66228,"_28581":66086,"_19785":110787,"_5":13558,"_26003":110425,"_2720":110788},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3227":66229,"_28581":66086,"_19785":110790,"_5":13558,"_26003":110425,"_2720":110791},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3227":66230,"_28581":66086,"_19785":110793,"_5":13558,"_26003":110429,"_2720":110794},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3227":66231,"_28581":66086,"_19785":110796,"_5":13558,"_26003":110429,"_2720":110797},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3227":66232,"_28581":66086,"_19785":110799,"_5":13558,"_26003":110429,"_2720":110800},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3227":66233,"_28581":66086,"_19785":110802,"_5":13558,"_26003":110433,"_2720":110803},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3227":66234,"_28581":66086,"_19785":110805,"_5":13558,"_26003":110433,"_2720":110806},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3227":66235,"_28581":66086,"_19785":110808,"_5":13558,"_26003":110433,"_2720":110809},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3227":66236,"_28581":66086,"_19785":110811,"_5":13558,"_26003":110433,"_2720":110812},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3227":66237,"_28581":66086,"_19785":110814,"_5":13558,"_26003":110433,"_2720":110815},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3227":66238,"_28581":66086,"_19785":110817,"_5":13558,"_26003":110433,"_2720":110818},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3227":66239,"_28581":66086,"_19785":110820,"_5":13558,"_26003":110433,"_2720":110821},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3227":66240,"_28581":66086,"_19785":110823,"_5":13558,"_26003":110433,"_2720":110824},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3227":66241,"_28581":66086,"_19785":110826,"_5":13558,"_26003":110441,"_2720":110827},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3227":66242,"_28581":66086,"_19785":110829,"_5":13558,"_26003":110445,"_2720":110830},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3227":66243,"_28581":66086,"_19785":110832,"_5":13558,"_26003":110445,"_2720":110833},[],"que exista un principal activo del tipo correcto;",{"_3227":66244,"_28581":66086,"_19785":110835,"_5":13558,"_26003":110445,"_2720":110836},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3227":66245,"_28581":66086,"_19785":110838,"_5":13558,"_26003":110445,"_2720":110839},[],"que todas las condiciones del principal se cumplan;",{"_3227":66246,"_28581":66086,"_19785":110841,"_5":13558,"_26003":110445,"_2720":110842},[],"que el principal tenga concedida la política esperada;",{"_3227":66247,"_28581":66086,"_19785":110844,"_5":13558,"_26003":110445,"_2720":110845},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3227":66248,"_28581":66086,"_19785":110847,"_5":13558,"_26003":110445,"_2720":110848},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3227":66249,"_28581":66086,"_19785":110850,"_5":13558,"_26003":110445,"_2720":110851},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3227":66250,"_28581":66086,"_19785":110853,"_5":13558,"_26003":110449,"_2720":110854},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3227":66251,"_28581":66086,"_19785":110856,"_5":13558,"_26003":110453,"_2720":110857},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3227":66252,"_28581":66086,"_19785":110859,"_5":13558,"_26003":110457,"_2720":110860},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3227":66253,"_28581":66086,"_19785":110862,"_5":13558,"_26003":110457,"_2720":110863},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3227":66254,"_28581":66254,"_5":13916,"_2720":110865,"_28924":110866,"_19785":110867,"_26003":66254},"Alertas y suscripciones",[46319,110330,110331],[],{"_3227":66255,"_28581":66254,"_19785":110869,"_5":13558,"_26003":66254,"_2720":110870},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3227":66256,"_28581":66254,"_5":28921,"_19785":110872,"_26003":110873,"_2720":110874},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3227":66257,"_28581":66254,"_5":28921,"_19785":110876,"_26003":110877,"_2720":110878},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3227":66258,"_28581":66254,"_5":28921,"_19785":110880,"_26003":110881,"_2720":110882},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3227":66259,"_28581":66254,"_5":28921,"_19785":110884,"_26003":110885,"_2720":110886},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3227":66260,"_28581":66254,"_5":28921,"_19785":110888,"_26003":110889,"_2720":110890},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3227":66261,"_28581":66254,"_5":28921,"_19785":110892,"_26003":110893,"_2720":110894},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3227":66262,"_28581":66254,"_5":28921,"_19785":110896,"_26003":110897,"_2720":110898},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3227":66263,"_28581":66254,"_5":28921,"_19785":110900,"_26003":110901,"_2720":110902},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3227":66264,"_28581":66254,"_5":28921,"_19785":110904,"_26003":110905,"_2720":110906},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3227":66265,"_28581":66254,"_5":28921,"_19785":110908,"_26003":110909,"_2720":110910},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3227":66266,"_28581":66254,"_5":28921,"_19785":110912,"_26003":110913,"_2720":110914},[],"/docs/pr-preview/pr-42/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3227":66267,"_28581":66254,"_19785":110916,"_5":13558,"_26003":66254,"_2720":110917},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3227":66268,"_28581":66254,"_19785":110919,"_5":13558,"_26003":110873,"_2720":110920},[],"Un servicio publica un evento de dominio.",{"_3227":66269,"_28581":66254,"_19785":110922,"_5":13558,"_26003":110873,"_2720":110923},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3227":66270,"_28581":66254,"_19785":110925,"_5":13558,"_26003":110873,"_2720":110926},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3227":66271,"_28581":66254,"_19785":110928,"_5":13558,"_26003":110873,"_2720":110929},[],"Lamassu entrega el evento al canal configurado.",{"_3227":66272,"_28581":66254,"_19785":110931,"_5":13558,"_26003":110873,"_2720":110932},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3227":66273,"_28581":66254,"_19785":110934,"_5":13558,"_26003":110877,"_2720":110935},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3227":66274,"_28581":66254,"_19785":110937,"_5":13558,"_26003":110877,"_2720":110938},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3227":66275,"_28581":66254,"_19785":110940,"_5":13558,"_26003":110877,"_2720":110941},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3227":66276,"_28581":66254,"_19785":110943,"_5":13558,"_26003":110877,"_2720":110944},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3227":66277,"_28581":66254,"_19785":110946,"_5":13558,"_26003":110877,"_2720":110947},[],"`apikey_options` necesita `header` y `key`.",{"_3227":66278,"_28581":66254,"_19785":110949,"_5":13558,"_26003":110877,"_2720":110950},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3227":66279,"_28581":66254,"_19785":110952,"_5":13558,"_26003":110877,"_2720":110953},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3227":66280,"_28581":66254,"_19785":110955,"_5":13558,"_26003":110877,"_2720":110956},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3227":66281,"_28581":66254,"_19785":110958,"_5":13558,"_26003":110885,"_2720":110959},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3227":66282,"_28581":66254,"_19785":110961,"_5":13558,"_26003":110889,"_2720":110962},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3227":66283,"_28581":66254,"_19785":110964,"_5":13558,"_26003":110893,"_2720":110965},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3227":66284,"_28581":66254,"_19785":110967,"_5":13558,"_26003":110893,"_2720":110968},[],"**None** notifica todas las instancias del evento.",{"_3227":66285,"_28581":66254,"_19785":110970,"_5":13558,"_26003":110893,"_2720":110971},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3227":66286,"_28581":66254,"_19785":110973,"_5":13558,"_26003":110893,"_2720":110974},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3227":66287,"_28581":66254,"_19785":110976,"_5":13558,"_26003":110893,"_2720":110977},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3227":66288,"_28581":66254,"_19785":110979,"_5":13558,"_26003":110893,"_2720":110980},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3227":66289,"_28581":66254,"_19785":110982,"_5":13558,"_26003":110897,"_2720":110983},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3227":66290,"_28581":66254,"_19785":110985,"_5":13558,"_26003":110901,"_2720":110986},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3227":66291,"_28581":66254,"_19785":110988,"_5":13558,"_26003":110901,"_2720":110989},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3227":66292,"_28581":66254,"_19785":110991,"_5":13558,"_26003":110901,"_2720":110992},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3227":66293,"_28581":66254,"_19785":110994,"_5":13558,"_26003":110901,"_2720":110995},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3227":66294,"_28581":66254,"_19785":110997,"_5":13558,"_26003":110901,"_2720":110998},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3227":66295,"_28581":66254,"_19785":111000,"_5":13558,"_26003":110901,"_2720":111001},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3227":66296,"_28581":66254,"_19785":111003,"_5":13558,"_26003":110901,"_2720":111004},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3227":66297,"_28581":66254,"_19785":111006,"_5":13558,"_26003":110901,"_2720":111007},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3227":66298,"_28581":66254,"_19785":111009,"_5":13558,"_26003":110905,"_2720":111010},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3227":66299,"_28581":66254,"_19785":111012,"_5":13558,"_26003":110905,"_2720":111013},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3227":66300,"_28581":66254,"_19785":111015,"_5":13558,"_26003":110905,"_2720":111016},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3227":66301,"_28581":66254,"_19785":111018,"_5":13558,"_26003":110905,"_2720":111019},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3227":66302,"_28581":66254,"_19785":111021,"_5":13558,"_26003":110905,"_2720":111022},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3227":66303,"_28581":66254,"_19785":111024,"_5":13558,"_26003":110905,"_2720":111025},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3227":66304,"_28581":66254,"_19785":111027,"_5":13558,"_26003":110905,"_2720":111028},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3227":66305,"_28581":66254,"_19785":111030,"_5":13558,"_26003":110905,"_2720":111031},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3227":66306,"_28581":66254,"_19785":111033,"_5":13558,"_26003":110909,"_2720":111034},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3227":66307,"_28581":66254,"_19785":111036,"_5":13558,"_26003":110909,"_2720":111037},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3227":66308,"_28581":66254,"_19785":111039,"_5":13558,"_26003":110913,"_2720":111040},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3227":66309,"_28581":66254,"_19785":111042,"_5":13558,"_26003":110913,"_2720":111043},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3227":66310,"_28581":66254,"_19785":111045,"_5":13558,"_26003":110913,"_2720":111046},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3227":66311,"_28581":66254,"_19785":111048,"_5":13558,"_26003":110913,"_2720":111049},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3227":66312,"_28581":66254,"_19785":111051,"_5":13558,"_26003":110913,"_2720":111052},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3227":66313,"_28581":66254,"_19785":111054,"_5":13558,"_26003":110913,"_2720":111055},[],"**Validación:** `va.role.crl.create`.",{"_3227":66314,"_28581":66254,"_19785":111057,"_5":13558,"_26003":110913,"_2720":111058},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3227":66315,"_28581":66254,"_19785":111060,"_5":13558,"_26003":110913,"_2720":111061},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3227":66316,"_28581":66316,"_5":13916,"_2720":111063,"_28924":111064,"_19785":111065,"_26003":66316},"Registros de auditoría",[46319,110330,110331],[],{"_3227":66317,"_28581":66316,"_19785":111067,"_5":13558,"_26003":66316,"_2720":111068},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3227":66318,"_28581":66316,"_5":28921,"_19785":111070,"_26003":111071,"_2720":111072},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3227":66319,"_28581":66316,"_5":28921,"_19785":111074,"_26003":111075,"_2720":111076},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3227":66320,"_28581":66316,"_5":28921,"_19785":111078,"_26003":111079,"_2720":111080},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3227":66321,"_28581":66316,"_5":28921,"_19785":111082,"_26003":111083,"_2720":111084},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3227":66322,"_28581":66316,"_5":28921,"_19785":111086,"_26003":111087,"_2720":111088},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3227":66323,"_28581":66316,"_5":28921,"_19785":111090,"_26003":111091,"_2720":111092},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3227":66324,"_28581":66316,"_5":28921,"_19785":111094,"_26003":111095,"_2720":111096},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3227":66325,"_28581":66316,"_5":28921,"_19785":111098,"_26003":111099,"_2720":111100},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3227":66326,"_28581":66316,"_5":28921,"_19785":111102,"_26003":111103,"_2720":111104},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3227":66327,"_28581":66316,"_5":28921,"_19785":111106,"_26003":111107,"_2720":111108},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3227":66328,"_28581":66316,"_5":28921,"_19785":111110,"_26003":111111,"_2720":111112},[],"/docs/pr-preview/pr-42/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3227":66329,"_28581":66316,"_19785":111114,"_5":13558,"_26003":66316,"_2720":111115},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3227":66330,"_28581":66316,"_19785":111117,"_5":13558,"_26003":111071,"_2720":111118},[],"El cuerpo de auditoría incluye:",{"_3227":66331,"_28581":66316,"_19785":111120,"_5":13558,"_26003":111071,"_2720":111121},[],"input: datos recibidos por la operación;",{"_3227":66332,"_28581":66316,"_19785":111123,"_5":13558,"_26003":111071,"_2720":111124},[],"has\\_error: indica si el servicio devolvió un error;",{"_3227":66333,"_28581":66316,"_19785":111126,"_5":13558,"_26003":111071,"_2720":111127},[],"output: resultado producido o mensaje de error;",{"_3227":66334,"_28581":66316,"_19785":111129,"_5":13558,"_26003":111071,"_2720":111130},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3227":66335,"_28581":66316,"_19785":111132,"_5":13558,"_26003":111071,"_2720":111133},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3227":66336,"_28581":66316,"_19785":111135,"_5":13558,"_26003":111071,"_2720":111136},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3227":66337,"_28581":66316,"_19785":111138,"_5":13558,"_26003":111075,"_2720":111139},[],"El backend aplica auditoría a mutaciones de:",{"_3227":66338,"_28581":66316,"_19785":111141,"_5":13558,"_26003":111075,"_2720":111142},[],"autoridades, certificados y perfiles de emisión;",{"_3227":66339,"_28581":66316,"_19785":111144,"_5":13558,"_26003":111075,"_2720":111145},[],"claves y motores KMS;",{"_3227":66340,"_28581":66316,"_19785":111147,"_5":13558,"_26003":111075,"_2720":111148},[],"dispositivos e identidades;",{"_3227":66341,"_28581":66316,"_19785":111150,"_5":13558,"_26003":111075,"_2720":111151},[],"DMS y operaciones de enrolamiento;",{"_3227":66342,"_28581":66316,"_19785":111153,"_5":13558,"_26003":111075,"_2720":111154},[],"funciones de validación y CRL;",{"_3227":66343,"_28581":66316,"_19785":111156,"_5":13558,"_26003":111075,"_2720":111157},[],"principales, políticas y concesiones de autorización.",{"_3227":66344,"_28581":66316,"_19785":111159,"_5":13558,"_26003":111075,"_2720":111160},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3227":66345,"_28581":66316,"_19785":111162,"_5":13558,"_26003":111079,"_2720":111163},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3227":66346,"_28581":66316,"_19785":111165,"_5":13558,"_26003":111079,"_2720":111166},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3227":66347,"_28581":66316,"_19785":111168,"_5":13558,"_26003":111079,"_2720":111169},[],"Diseña el consumidor para:",{"_3227":66348,"_28581":66316,"_19785":111171,"_5":13558,"_26003":111079,"_2720":111172},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3227":66349,"_28581":66316,"_19785":111174,"_5":13558,"_26003":111079,"_2720":111175},[],"conservar el CloudEvent completo sin modificar;",{"_3227":66350,"_28581":66316,"_19785":111177,"_5":13558,"_26003":111079,"_2720":111178},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3227":66351,"_28581":66316,"_19785":111180,"_5":13558,"_26003":111079,"_2720":111181},[],"cifrar en tránsito y en reposo;",{"_3227":66352,"_28581":66316,"_19785":111183,"_5":13558,"_26003":111079,"_2720":111184},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3227":66353,"_28581":66316,"_19785":111186,"_5":13558,"_26003":111079,"_2720":111187},[],"aplicar una política explícita de retención y legal hold;",{"_3227":66354,"_28581":66316,"_19785":111189,"_5":13558,"_26003":111079,"_2720":111190},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3227":66355,"_28581":66316,"_19785":111192,"_5":13558,"_26003":111083,"_2720":111193},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3227":66356,"_28581":66316,"_19785":111195,"_5":13558,"_26003":111083,"_2720":111196},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3227":66357,"_28581":66316,"_19785":111198,"_5":13558,"_26003":111091,"_2720":111199},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3227":66358,"_28581":66316,"_19785":111201,"_5":13558,"_26003":111095,"_2720":111202},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3227":66359,"_28581":66316,"_19785":111204,"_5":13558,"_26003":111099,"_2720":111205},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3227":66360,"_28581":66316,"_19785":111207,"_5":13558,"_26003":111103,"_2720":111208},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3227":66361,"_28581":66316,"_19785":111210,"_5":13558,"_26003":111107,"_2720":111211},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3227":66362,"_28581":66316,"_19785":111213,"_5":13558,"_26003":111111,"_2720":111214},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3227":66363,"_28581":66316,"_19785":111216,"_5":13558,"_26003":111111,"_2720":111217},[],"aparece un evento de auditoría correcto;",{"_3227":66364,"_28581":66316,"_19785":111219,"_5":13558,"_26003":111111,"_2720":111220},[],"el principal coincide con la identidad utilizada;",{"_3227":66365,"_28581":66316,"_19785":111222,"_5":13558,"_26003":111111,"_2720":111223},[],"el consumidor lo persiste una sola vez;",{"_3227":66366,"_28581":66316,"_19785":111225,"_5":13558,"_26003":111111,"_2720":111226},[],"puede recuperarse por recurso, actor y periodo;",{"_3227":66367,"_28581":66316,"_19785":111228,"_5":13558,"_26003":111111,"_2720":111229},[],"una interrupción del consumidor produce una alerta.",{"_3227":66368,"_28581":66316,"_19785":111231,"_5":13558,"_26003":111111,"_2720":111232},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3227":66369,"_28581":66369,"_5":13916,"_2720":111234,"_28924":111235,"_19785":111236,"_26003":66369},"Arquitectura de la plataforma",[46319,110330],[],{"_3227":66370,"_28581":66369,"_19785":111238,"_5":13558,"_26003":66369,"_2720":111239},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3227":66371,"_28581":66369,"_5":28921,"_19785":111241,"_26003":111242,"_2720":111243},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3227":66372,"_28581":66369,"_5":28921,"_19785":111245,"_26003":111246,"_2720":111247},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3227":66373,"_28581":66369,"_5":28921,"_19785":111249,"_26003":111250,"_2720":111251},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3227":66374,"_28581":66369,"_5":28921,"_19785":111253,"_26003":111254,"_2720":111255},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3227":66375,"_28581":66369,"_5":28921,"_19785":111257,"_26003":111258,"_2720":111259},[],"/docs/pr-preview/pr-42/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3227":66376,"_28581":66369,"_19785":111261,"_5":13558,"_26003":66369,"_2720":111262},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3227":66377,"_28581":66369,"_19785":111264,"_5":13558,"_26003":66369,"_2720":111265},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3227":66378,"_28581":66369,"_19785":111267,"_5":13558,"_26003":111242,"_2720":111268},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3227":66379,"_28581":66369,"_19785":111270,"_5":13558,"_26003":111246,"_2720":111271},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3227":66380,"_28581":66369,"_19785":111273,"_5":13558,"_26003":111250,"_2720":111274},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3227":66381,"_28581":66369,"_19785":111276,"_5":13558,"_26003":111254,"_2720":111277},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3227":66382,"_28581":66369,"_19785":111279,"_5":13558,"_26003":111258,"_2720":111280},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3227":66383,"_28581":66383,"_5":13916,"_2720":111282,"_28924":111283,"_19785":111284,"_26003":66383},"Cómo funciona Lamassu",[46319,110330],[],{"_3227":66384,"_28581":66383,"_19785":111286,"_5":13558,"_26003":66383,"_2720":111287},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3227":66385,"_28581":66383,"_5":28921,"_19785":111289,"_26003":111290,"_2720":111291},[],"/docs/pr-preview/pr-42/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3227":66386,"_28581":66383,"_5":28921,"_19785":111293,"_26003":111294,"_2720":111295},[],"/docs/pr-preview/pr-42/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3227":66387,"_28581":66383,"_19785":111297,"_5":13558,"_26003":66383,"_2720":111298},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3227":66388,"_28581":66383,"_19785":111300,"_5":13558,"_26003":111290,"_2720":111301},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3227":66389,"_28581":66383,"_19785":111303,"_5":13558,"_26003":111290,"_2720":111304},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3227":66390,"_28581":66383,"_19785":111306,"_5":13558,"_26003":111290,"_2720":111307},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3227":66391,"_28581":66383,"_19785":111309,"_5":13558,"_26003":111290,"_2720":111310},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3227":66392,"_28581":66383,"_19785":111312,"_5":13558,"_26003":111290,"_2720":111313},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3227":66393,"_28581":66383,"_19785":111315,"_5":13558,"_26003":111294,"_2720":111316},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3227":66394,"_28581":66383,"_19785":111318,"_5":13558,"_26003":111294,"_2720":111319},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3227":66395,"_28581":66383,"_19785":111321,"_5":13558,"_26003":111294,"_2720":111322},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3227":66396,"_28581":66383,"_19785":111324,"_5":13558,"_26003":111294,"_2720":111325},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3227":66397,"_28581":66383,"_19785":111327,"_5":13558,"_26003":111294,"_2720":111328},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3227":66398,"_28581":66383,"_19785":111330,"_5":13558,"_26003":111294,"_2720":111331},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3227":66399,"_28581":66383,"_19785":111333,"_5":13558,"_26003":111294,"_2720":111334},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3227":66400,"_28581":66400,"_5":13916,"_2720":111336,"_28924":111337,"_19785":111338,"_26003":66400},"Dispositivos e identidades",[46319,110330,48776,111336],[],{"_3227":66401,"_28581":66400,"_19785":111340,"_5":13558,"_26003":66400,"_2720":111341},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3227":66402,"_28581":66400,"_5":28921,"_19785":111343,"_26003":111344,"_2720":111345},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3227":66403,"_28581":66400,"_5":28921,"_19785":111347,"_26003":111348,"_2720":111349},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3227":66404,"_28581":66400,"_5":28921,"_19785":111351,"_26003":111352,"_2720":111353},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3227":66405,"_28581":66400,"_5":28921,"_19785":111355,"_26003":111356,"_2720":111357},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3227":66406,"_28581":66400,"_5":28921,"_19785":111359,"_26003":111360,"_2720":111361},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3227":66407,"_28581":66400,"_5":28921,"_19785":111363,"_26003":111364,"_2720":111365},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3227":66408,"_28581":66400,"_5":28921,"_19785":111367,"_26003":111368,"_2720":111369},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3227":66409,"_28581":66400,"_5":28921,"_19785":111371,"_26003":111372,"_2720":111373},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3227":66410,"_28581":66400,"_5":28921,"_19785":111375,"_26003":111376,"_2720":111377},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3227":66411,"_28581":66400,"_5":28921,"_19785":111379,"_26003":111380,"_2720":111381},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3227":66412,"_28581":66400,"_5":28921,"_19785":111383,"_26003":111384,"_2720":111385},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3227":66413,"_28581":66400,"_19785":111387,"_5":13558,"_26003":66400,"_2720":111388},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3227":66414,"_28581":66400,"_19785":111390,"_5":13558,"_26003":66400,"_2720":111391},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3227":66415,"_28581":66400,"_19785":111393,"_5":13558,"_26003":111344,"_2720":111394},[],"Vista operativa",{"_3227":66416,"_28581":66400,"_19785":111396,"_5":13558,"_26003":111344,"_2720":111397},[],"Interpretación",{"_3227":66417,"_28581":66400,"_19785":111399,"_5":13558,"_26003":111344,"_2720":48839},[],{"_3227":66418,"_28581":66400,"_19785":111401,"_5":13558,"_26003":111344,"_2720":111402},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3227":66419,"_28581":66400,"_19785":111404,"_5":13558,"_26003":111344,"_2720":48845},[],{"_3227":66420,"_28581":66400,"_19785":111406,"_5":13558,"_26003":111344,"_2720":111407},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3227":66421,"_28581":66400,"_19785":111409,"_5":13558,"_26003":111344,"_2720":48851},[],{"_3227":66422,"_28581":66400,"_19785":111411,"_5":13558,"_26003":111344,"_2720":111412},[],"La identidad está en la ventana operativa de renovación.",{"_3227":66423,"_28581":66400,"_19785":111414,"_5":13558,"_26003":111344,"_2720":48857},[],{"_3227":66424,"_28581":66400,"_19785":111416,"_5":13558,"_26003":111344,"_2720":111417},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3227":66425,"_28581":66400,"_19785":111419,"_5":13558,"_26003":111344,"_2720":48863},[],{"_3227":66426,"_28581":66400,"_19785":111421,"_5":13558,"_26003":111344,"_2720":111422},[],"La identidad ha vencido.",{"_3227":66427,"_28581":66400,"_19785":111424,"_5":13558,"_26003":111344,"_2720":48869},[],{"_3227":66428,"_28581":66400,"_19785":111426,"_5":13558,"_26003":111344,"_2720":111427},[],"La identidad está marcada como revocada.",{"_3227":66429,"_28581":66400,"_19785":111429,"_5":13558,"_26003":111344,"_2720":48875},[],{"_3227":66430,"_28581":66400,"_19785":111431,"_5":13558,"_26003":111344,"_2720":111432},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3227":66431,"_28581":66400,"_19785":111434,"_5":13558,"_26003":111344,"_2720":111435},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3227":66432,"_28581":66400,"_19785":111437,"_5":13558,"_26003":111348,"_2720":111438},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3227":66433,"_28581":66400,"_19785":111440,"_5":13558,"_26003":111348,"_2720":111441},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3227":66434,"_28581":66400,"_19785":111443,"_5":13558,"_26003":111348,"_2720":111444},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3227":66435,"_28581":66400,"_19785":111446,"_5":13558,"_26003":111348,"_2720":111447},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3227":66436,"_28581":66400,"_19785":111449,"_5":13558,"_26003":111352,"_2720":111450},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3227":66437,"_28581":66400,"_19785":111452,"_5":13558,"_26003":111356,"_2720":111453},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3227":66438,"_28581":66400,"_19785":111455,"_5":13558,"_26003":111360,"_2720":111456},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3227":66439,"_28581":66400,"_19785":111458,"_5":13558,"_26003":111364,"_2720":111459},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3227":66440,"_28581":66400,"_19785":111461,"_5":13558,"_26003":111368,"_2720":111462},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3227":66441,"_28581":66400,"_19785":111464,"_5":13558,"_26003":111368,"_2720":111465},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3227":66442,"_28581":66400,"_19785":111467,"_5":13558,"_26003":111372,"_2720":111468},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3227":66443,"_28581":66400,"_19785":111470,"_5":13558,"_26003":111372,"_2720":111471},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3227":66444,"_28581":66400,"_19785":111473,"_5":13558,"_26003":111372,"_2720":111474},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3227":66445,"_28581":66400,"_19785":111476,"_5":13558,"_26003":111372,"_2720":111477},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3227":66446,"_28581":66400,"_19785":111479,"_5":13558,"_26003":111372,"_2720":111480},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3227":66447,"_28581":66400,"_19785":111482,"_5":13558,"_26003":111372,"_2720":111483},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3227":66448,"_28581":66400,"_19785":111485,"_5":13558,"_26003":111376,"_2720":111486},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3227":66449,"_28581":66400,"_19785":111488,"_5":13558,"_26003":111376,"_2720":111489},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3227":66450,"_28581":66400,"_19785":111491,"_5":13558,"_26003":111380,"_2720":111492},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3227":66451,"_28581":66400,"_19785":111494,"_5":13558,"_26003":111380,"_2720":111495},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3227":66452,"_28581":66400,"_19785":111497,"_5":13558,"_26003":111380,"_2720":111498},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3227":66453,"_28581":66400,"_19785":111500,"_5":13558,"_26003":111380,"_2720":111501},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3227":66454,"_28581":66400,"_19785":111503,"_5":13558,"_26003":111384,"_2720":111504},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3227":66455,"_28581":66400,"_19785":111506,"_5":13558,"_26003":111384,"_2720":111507},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3227":66456,"_28581":66456,"_5":13916,"_2720":111509,"_28924":111510,"_19785":111512,"_26003":66456},"Identidad inicial y autenticación",[46319,110330,48776,111336,111511],"Enrolamiento con PKI",[],{"_3227":66457,"_28581":66456,"_19785":111514,"_5":13558,"_26003":66456,"_2720":111515},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3227":66458,"_28581":66456,"_5":28921,"_19785":111517,"_26003":111518,"_2720":111519},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3227":66459,"_28581":66456,"_5":28921,"_19785":111521,"_26003":111522,"_2720":111523},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3227":66460,"_28581":66456,"_5":28921,"_19785":111525,"_26003":111526,"_2720":111527},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3227":66461,"_28581":66456,"_5":28921,"_19785":111529,"_26003":111530,"_2720":111531},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3227":66462,"_28581":66456,"_5":28921,"_19785":111533,"_26003":111534,"_2720":111535},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3227":66463,"_28581":66456,"_19785":111537,"_5":13558,"_26003":66456,"_2720":111538},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3227":66464,"_28581":66456,"_19785":111540,"_5":13558,"_26003":111518,"_2720":111541},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3227":66465,"_28581":66456,"_19785":111543,"_5":13558,"_26003":111518,"_2720":111544},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3227":66466,"_28581":66456,"_19785":111546,"_5":13558,"_26003":111522,"_2720":111547},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3227":66467,"_28581":66456,"_19785":111549,"_5":13558,"_26003":111522,"_2720":111550},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3227":66468,"_28581":66456,"_19785":111552,"_5":13558,"_26003":111522,"_2720":111553},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3227":66469,"_28581":66456,"_19785":111555,"_5":13558,"_26003":111526,"_2720":111556},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3227":66470,"_28581":66456,"_19785":111558,"_5":13558,"_26003":111526,"_2720":111559},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3227":66471,"_28581":66456,"_19785":111561,"_5":13558,"_26003":111530,"_2720":111562},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3227":66472,"_28581":66456,"_19785":111564,"_5":13558,"_26003":111530,"_2720":111565},[],"Ejemplo de cuerpo:",{"_3227":66473,"_28581":66456,"_19785":111567,"_5":13558,"_26003":111530,"_2720":111568},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3227":66474,"_28581":66456,"_19785":111570,"_5":13558,"_26003":111530,"_2720":111571},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3227":66475,"_28581":66456,"_19785":111573,"_5":13558,"_26003":111530,"_2720":111574},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3227":66476,"_28581":66456,"_19785":111576,"_5":13558,"_26003":111530,"_2720":111577},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3227":66477,"_28581":66456,"_19785":111579,"_5":13558,"_26003":111534,"_2720":111580},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3227":66478,"_28581":66456,"_19785":111582,"_5":13558,"_26003":111534,"_2720":111583},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3227":66479,"_28581":66479,"_5":13916,"_2720":111585,"_28924":111586,"_19785":111587,"_26003":66479},"Configura y opera el DMS",[46319,110330,48776,111336,111511],[],{"_3227":66480,"_28581":66479,"_19785":111589,"_5":13558,"_26003":66479,"_2720":111590},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3227":66481,"_28581":66479,"_5":28921,"_19785":111592,"_26003":111593,"_2720":108927},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3227":66482,"_28581":66479,"_5":28921,"_19785":111595,"_26003":111596,"_2720":111597},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3227":66483,"_28581":66479,"_5":28921,"_19785":111599,"_26003":111600,"_2720":111601},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3227":66484,"_28581":66479,"_5":28921,"_19785":111603,"_26003":111604,"_2720":111605},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3227":66485,"_28581":66479,"_5":28921,"_19785":111607,"_26003":111608,"_2720":111609},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3227":66486,"_28581":66479,"_5":28921,"_19785":111611,"_26003":111612,"_2720":111613},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3227":66487,"_28581":66479,"_5":28921,"_19785":111615,"_26003":111616,"_2720":111617},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3227":66488,"_28581":66479,"_5":28921,"_19785":111619,"_26003":111620,"_2720":111621},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3227":66489,"_28581":66479,"_5":28921,"_19785":111623,"_26003":111624,"_2720":49071},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3227":66490,"_28581":66479,"_5":28921,"_19785":111626,"_26003":111627,"_2720":49075},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3227":66491,"_28581":66479,"_5":28921,"_19785":111629,"_26003":111630,"_2720":111631},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3227":66492,"_28581":66479,"_5":28921,"_19785":111633,"_26003":111634,"_2720":111635},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3227":66493,"_28581":66479,"_5":28921,"_19785":111637,"_26003":111638,"_2720":111639},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3227":66494,"_28581":66479,"_5":28921,"_19785":111641,"_26003":111642,"_2720":111643},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3227":66495,"_28581":66479,"_5":28921,"_19785":111645,"_26003":111646,"_2720":49095},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3227":66496,"_28581":66479,"_5":28921,"_19785":111648,"_26003":111649,"_2720":111650},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3227":66497,"_28581":66479,"_5":28921,"_19785":111652,"_26003":111653,"_2720":111654},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3227":66498,"_28581":66479,"_5":28921,"_19785":111656,"_26003":111657,"_2720":111658},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3227":66499,"_28581":66479,"_19785":111660,"_5":13558,"_26003":66479,"_2720":111661},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3227":66500,"_28581":66479,"_19785":111663,"_5":13558,"_26003":111593,"_2720":111664},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3227":66501,"_28581":66479,"_19785":111666,"_5":13558,"_26003":111593,"_2720":111667},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3227":66502,"_28581":66479,"_19785":111669,"_5":13558,"_26003":111600,"_2720":111670},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3227":66503,"_28581":66479,"_19785":111672,"_5":13558,"_26003":111604,"_2720":111673},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3227":66504,"_28581":66479,"_19785":111675,"_5":13558,"_26003":111608,"_2720":111676},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3227":66505,"_28581":66479,"_19785":111678,"_5":13558,"_26003":111612,"_2720":111679},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3227":66506,"_28581":66479,"_19785":111681,"_5":13558,"_26003":111616,"_2720":111682},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3227":66507,"_28581":66479,"_19785":111684,"_5":13558,"_26003":111624,"_2720":111685},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3227":66508,"_28581":66479,"_19785":111687,"_5":13558,"_26003":111624,"_2720":111688},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3227":66509,"_28581":66479,"_19785":111690,"_5":13558,"_26003":111627,"_2720":111691},[],"Campo de `settings.enrollment_settings`",{"_3227":66510,"_28581":66479,"_19785":111693,"_5":13558,"_26003":111627,"_2720":111694},[],"Decisión",{"_3227":66511,"_28581":66479,"_19785":111696,"_5":13558,"_26003":111627,"_2720":49146},[],{"_3227":66512,"_28581":66479,"_19785":111698,"_5":13558,"_26003":111627,"_2720":111699},[],"`EST_RFC7030` para estas operaciones.",{"_3227":66513,"_28581":66479,"_19785":111701,"_5":13558,"_26003":111627,"_2720":49152},[],{"_3227":66514,"_28581":66479,"_19785":111703,"_5":13558,"_26003":111627,"_2720":111704},[],"ID de la CA que firmará.",{"_3227":66515,"_28581":66479,"_19785":111706,"_5":13558,"_26003":111627,"_2720":49158},[],{"_3227":66516,"_28581":66479,"_19785":111708,"_5":13558,"_26003":111627,"_2720":111709},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3227":66517,"_28581":66479,"_19785":111711,"_5":13558,"_26003":111627,"_2720":49164},[],{"_3227":66518,"_28581":66479,"_19785":111713,"_5":13558,"_26003":111627,"_2720":111714},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3227":66519,"_28581":66479,"_19785":111716,"_5":13558,"_26003":111627,"_2720":49170},[],{"_3227":66520,"_28581":66479,"_19785":111718,"_5":13558,"_26003":111627,"_2720":111719},[],"Uno de los cuatro modos de autenticación.",{"_3227":66521,"_28581":66479,"_19785":111721,"_5":13558,"_26003":111627,"_2720":111722},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3227":66522,"_28581":66479,"_19785":111724,"_5":13558,"_26003":111630,"_2720":111725},[],"Los bloques son independientes:",{"_3227":66523,"_28581":66479,"_19785":111727,"_5":13558,"_26003":111630,"_2720":111728},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3227":66524,"_28581":66479,"_19785":111730,"_5":13558,"_26003":111630,"_2720":111731},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3227":66525,"_28581":66479,"_19785":111733,"_5":13558,"_26003":111630,"_2720":49188},[],{"_3227":66526,"_28581":66479,"_19785":111735,"_5":13558,"_26003":111630,"_2720":111736},[],"Control aplicado en la operación configurada",{"_3227":66527,"_28581":66479,"_19785":111738,"_5":13558,"_26003":111630,"_2720":49194},[],{"_3227":66528,"_28581":66479,"_19785":111740,"_5":13558,"_26003":111630,"_2720":111741},[],"Validación del certificado presentado.",{"_3227":66529,"_28581":66479,"_19785":111743,"_5":13558,"_26003":111630,"_2720":49200},[],{"_3227":66530,"_28581":66479,"_19785":111745,"_5":13558,"_26003":111630,"_2720":111746},[],"Autorización del webhook configurado.",{"_3227":66531,"_28581":66479,"_19785":111748,"_5":13558,"_26003":111630,"_2720":49206},[],{"_3227":66532,"_28581":66479,"_19785":111750,"_5":13558,"_26003":111630,"_2720":111751},[],"Validación del certificado y, después, aprobación del webhook.",{"_3227":66533,"_28581":66479,"_19785":111753,"_5":13558,"_26003":111630,"_2720":49212},[],{"_3227":66534,"_28581":66479,"_19785":111755,"_5":13558,"_26003":111630,"_2720":111756},[],"Sin autenticación del solicitante por el DMS.",{"_3227":66535,"_28581":66479,"_19785":111758,"_5":13558,"_26003":111630,"_2720":111759},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3227":66536,"_28581":66479,"_19785":111761,"_5":13558,"_26003":111630,"_2720":111762},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3227":66537,"_28581":66479,"_19785":111764,"_5":13558,"_26003":111630,"_2720":111765},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3227":66538,"_28581":66479,"_19785":111767,"_5":13558,"_26003":111630,"_2720":111768},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3227":66539,"_28581":66479,"_19785":111770,"_5":13558,"_26003":111634,"_2720":111771},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3227":66540,"_28581":66479,"_19785":111773,"_5":13558,"_26003":111634,"_2720":111774},[],"Campo de `external_webhook_settings`",{"_3227":66541,"_28581":66479,"_19785":111776,"_5":13558,"_26003":111634,"_2720":111694},[],{"_3227":66542,"_28581":66479,"_19785":111778,"_5":13558,"_26003":111634,"_2720":49238},[],{"_3227":66543,"_28581":66479,"_19785":111780,"_5":13558,"_26003":111634,"_2720":111781},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3227":66544,"_28581":66479,"_19785":111783,"_5":13558,"_26003":111634,"_2720":49244},[],{"_3227":66545,"_28581":66479,"_19785":111785,"_5":13558,"_26003":111634,"_2720":111786},[],"`POST` o `PUT`; `POST` por defecto.",{"_3227":66546,"_28581":66479,"_19785":111788,"_5":13558,"_26003":111634,"_2720":49250},[],{"_3227":66547,"_28581":66479,"_19785":111790,"_5":13558,"_26003":111634,"_2720":111791},[],"Etiqueta usada en los logs del servicio.",{"_3227":66548,"_28581":66479,"_19785":111793,"_5":13558,"_26003":111634,"_2720":49256},[],{"_3227":66549,"_28581":66479,"_19785":111795,"_5":13558,"_26003":111634,"_2720":111796},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3227":66550,"_28581":66479,"_19785":111798,"_5":13558,"_26003":111634,"_2720":49262},[],{"_3227":66551,"_28581":66479,"_19785":111800,"_5":13558,"_26003":111634,"_2720":111801},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3227":66552,"_28581":66479,"_19785":111803,"_5":13558,"_26003":111634,"_2720":49268},[],{"_3227":66553,"_28581":66479,"_19785":111805,"_5":13558,"_26003":111634,"_2720":111806},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3227":66554,"_28581":66479,"_19785":111808,"_5":13558,"_26003":111634,"_2720":49274},[],{"_3227":66555,"_28581":66479,"_19785":111810,"_5":13558,"_26003":111634,"_2720":111811},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3227":66556,"_28581":66479,"_19785":111813,"_5":13558,"_26003":111634,"_2720":49280},[],{"_3227":66557,"_28581":66479,"_19785":111815,"_5":13558,"_26003":111634,"_2720":111816},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3227":66558,"_28581":66479,"_19785":111818,"_5":13558,"_26003":111634,"_2720":49286},[],{"_3227":66559,"_28581":66479,"_19785":111820,"_5":13558,"_26003":111634,"_2720":111821},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3227":66560,"_28581":66479,"_19785":111823,"_5":13558,"_26003":111634,"_2720":49292},[],{"_3227":66561,"_28581":66479,"_19785":111825,"_5":13558,"_26003":111634,"_2720":111826},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3227":66562,"_28581":66479,"_19785":111828,"_5":13558,"_26003":111634,"_2720":111829},[],"Reglas de esa configuración:",{"_3227":66563,"_28581":66479,"_19785":111831,"_5":13558,"_26003":111634,"_2720":111832},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3227":66564,"_28581":66479,"_19785":111834,"_5":13558,"_26003":111634,"_2720":111835},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3227":66565,"_28581":66479,"_19785":111837,"_5":13558,"_26003":111634,"_2720":111838},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3227":66566,"_28581":66479,"_19785":111840,"_5":13558,"_26003":111634,"_2720":111841},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3227":66567,"_28581":66479,"_19785":111843,"_5":13558,"_26003":111634,"_2720":111844},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3227":66568,"_28581":66479,"_19785":111846,"_5":13558,"_26003":111634,"_2720":111847},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3227":66569,"_28581":66479,"_19785":111849,"_5":13558,"_26003":111634,"_2720":111850},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3227":66570,"_28581":66479,"_19785":111852,"_5":13558,"_26003":111634,"_2720":111853},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3227":66571,"_28581":66479,"_19785":111855,"_5":13558,"_26003":111634,"_2720":111856},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3227":66572,"_28581":66479,"_19785":111858,"_5":13558,"_26003":111638,"_2720":111859},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3227":66573,"_28581":66479,"_19785":111861,"_5":13558,"_26003":111642,"_2720":111862},[],"Campo de `settings.reenrollment_settings`",{"_3227":66574,"_28581":66479,"_19785":111864,"_5":13558,"_26003":111642,"_2720":111865},[],"Función",{"_3227":66575,"_28581":66479,"_19785":111867,"_5":13558,"_26003":111642,"_2720":49336},[],{"_3227":66576,"_28581":66479,"_19785":111869,"_5":13558,"_26003":111642,"_2720":111870},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3227":66577,"_28581":66479,"_19785":111872,"_5":13558,"_26003":111642,"_2720":49342},[],{"_3227":66578,"_28581":66479,"_19785":111874,"_5":13558,"_26003":111642,"_2720":111875},[],"Umbral operativo preventivo de monitorización.",{"_3227":66579,"_28581":66479,"_19785":111877,"_5":13558,"_26003":111642,"_2720":49348},[],{"_3227":66580,"_28581":66479,"_19785":111879,"_5":13558,"_26003":111642,"_2720":111880},[],"Umbral operativo crítico de monitorización.",{"_3227":66581,"_28581":66479,"_19785":111882,"_5":13558,"_26003":111642,"_2720":49354},[],{"_3227":66582,"_28581":66479,"_19785":111884,"_5":13558,"_26003":111642,"_2720":111885},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3227":66583,"_28581":66479,"_19785":111887,"_5":13558,"_26003":111642,"_2720":49360},[],{"_3227":66584,"_28581":66479,"_19785":111889,"_5":13558,"_26003":111642,"_2720":111890},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3227":66585,"_28581":66479,"_19785":111892,"_5":13558,"_26003":111642,"_2720":49366},[],{"_3227":66586,"_28581":66479,"_19785":111894,"_5":13558,"_26003":111642,"_2720":111895},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3227":66587,"_28581":66479,"_19785":111897,"_5":13558,"_26003":111642,"_2720":111898},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3227":66588,"_28581":66479,"_19785":111900,"_5":13558,"_26003":111646,"_2720":111901},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3227":66589,"_28581":66479,"_19785":111903,"_5":13558,"_26003":111649,"_2720":109291},[],{"_3227":66590,"_28581":66479,"_19785":111905,"_5":13558,"_26003":111649,"_2720":111906},[],"Qué publica",{"_3227":66591,"_28581":66479,"_19785":111908,"_5":13558,"_26003":111649,"_2720":49383},[],{"_3227":66592,"_28581":66479,"_19785":111910,"_5":13558,"_26003":111649,"_2720":111911},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3227":66593,"_28581":66479,"_19785":111913,"_5":13558,"_26003":111649,"_2720":49389},[],{"_3227":66594,"_28581":66479,"_19785":111915,"_5":13558,"_26003":111649,"_2720":111916},[],"Certificado de la CA emisora seleccionada.",{"_3227":66595,"_28581":66479,"_19785":111918,"_5":13558,"_26003":111649,"_2720":49395},[],{"_3227":66596,"_28581":66479,"_19785":111920,"_5":13558,"_26003":111649,"_2720":111921},[],"Certificados de las CAs elegidas explícitamente.",{"_3227":66597,"_28581":66479,"_19785":111923,"_5":13558,"_26003":111649,"_2720":111924},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3227":66598,"_28581":66479,"_19785":111926,"_5":13558,"_26003":111653,"_2720":111927},[],"**Edit** cambia nombre, ajustes y metadatos. Al usar la API, lee el DMS antes de editarlo: `name` y `settings` se sustituyen por completo. `metadata` omitido o `null` conserva el almacenado, y un objeto lo sustituye por completo. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3227":66599,"_28581":66479,"_19785":111929,"_5":13558,"_26003":111653,"_2720":111930},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3227":66600,"_28581":66479,"_19785":111932,"_5":13558,"_26003":111653,"_2720":111933},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3227":66601,"_28581":66479,"_19785":111935,"_5":13558,"_26003":111657,"_2720":111936},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3227":66602,"_28581":66602,"_5":13916,"_2720":111938,"_28924":111939,"_19785":111940,"_26003":66602},"Integra el cliente EST",[46319,110330,48776,111336,111511],[],{"_3227":66603,"_28581":66602,"_19785":111942,"_5":13558,"_26003":66602,"_2720":111943},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3227":66604,"_28581":66602,"_5":28921,"_19785":111945,"_26003":111946,"_2720":108927},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3227":66605,"_28581":66602,"_5":28921,"_19785":111948,"_26003":111949,"_2720":111950},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3227":66606,"_28581":66602,"_5":28921,"_19785":111952,"_26003":111953,"_2720":111954},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3227":66607,"_28581":66602,"_5":28921,"_19785":111956,"_26003":111957,"_2720":111958},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3227":66608,"_28581":66602,"_5":28921,"_19785":111960,"_26003":111961,"_2720":111962},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3227":66609,"_28581":66602,"_5":28921,"_19785":111964,"_26003":111965,"_2720":111966},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3227":66610,"_28581":66602,"_19785":111968,"_5":13558,"_26003":66602,"_2720":111969},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3227":66611,"_28581":66602,"_19785":111971,"_5":13558,"_26003":111946,"_2720":111972},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3227":66612,"_28581":66602,"_19785":111974,"_5":13558,"_26003":111946,"_2720":111975},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3227":66613,"_28581":66602,"_19785":111977,"_5":13558,"_26003":111946,"_2720":111978},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3227":66614,"_28581":66602,"_19785":111980,"_5":13558,"_26003":111949,"_2720":111981},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3227":66615,"_28581":66602,"_19785":111983,"_5":13558,"_26003":111949,"_2720":111984},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3227":66616,"_28581":66602,"_19785":111986,"_5":13558,"_26003":111953,"_2720":111987},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3227":66617,"_28581":66602,"_19785":111989,"_5":13558,"_26003":111953,"_2720":111990},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3227":66618,"_28581":66602,"_19785":111992,"_5":13558,"_26003":111957,"_2720":111993},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3227":66619,"_28581":66602,"_19785":111995,"_5":13558,"_26003":111957,"_2720":111996},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3227":66620,"_28581":66602,"_19785":111998,"_5":13558,"_26003":111961,"_2720":111999},[],"Para el caso de una raíz que emite directamente:",{"_3227":66621,"_28581":66602,"_19785":112001,"_5":13558,"_26003":111961,"_2720":112002},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3227":66622,"_28581":66602,"_19785":112004,"_5":13558,"_26003":111961,"_2720":112005},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3227":66623,"_28581":66602,"_19785":112007,"_5":13558,"_26003":111965,"_2720":112008},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3227":66624,"_28581":66624,"_5":13916,"_2720":112010,"_28924":112011,"_19785":112012,"_26003":66624},"Referencia EST",[46319,110330,48776,111336,111511],[],{"_3227":66625,"_28581":66624,"_19785":112014,"_5":13558,"_26003":66624,"_2720":112015},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3227":66626,"_28581":66624,"_5":28921,"_19785":112017,"_26003":112018,"_2720":112019},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3227":66627,"_28581":66624,"_5":28921,"_19785":112021,"_26003":112022,"_2720":21503},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3227":66628,"_28581":66624,"_5":28921,"_19785":112024,"_26003":112025,"_2720":24652},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3227":66629,"_28581":66624,"_5":28921,"_19785":112027,"_26003":112028,"_2720":24659},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3227":66630,"_28581":66624,"_5":28921,"_19785":112030,"_26003":112031,"_2720":23992},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3227":66631,"_28581":66624,"_5":28921,"_19785":112033,"_26003":112034,"_2720":112035},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3227":66632,"_28581":66624,"_5":28921,"_19785":112037,"_26003":112038,"_2720":112039},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3227":66633,"_28581":66624,"_5":28921,"_19785":112041,"_26003":112042,"_2720":112043},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3227":66634,"_28581":66624,"_19785":112045,"_5":13558,"_26003":66624,"_2720":112046},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3227":66635,"_28581":66624,"_19785":112048,"_5":13558,"_26003":112018,"_2720":112049},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3227":66636,"_28581":66624,"_19785":112051,"_5":13558,"_26003":112018,"_2720":110090},[],{"_3227":66637,"_28581":66624,"_19785":112053,"_5":13558,"_26003":112018,"_2720":112054},[],"Método",{"_3227":66638,"_28581":66624,"_19785":112056,"_5":13558,"_26003":112018,"_2720":112057},[],"Autenticación y condición",{"_3227":66639,"_28581":66624,"_19785":112059,"_5":13558,"_26003":112018,"_2720":49538},[],{"_3227":66640,"_28581":66624,"_19785":112061,"_5":13558,"_26003":112018,"_2720":49541},[],{"_3227":66641,"_28581":66624,"_19785":112063,"_5":13558,"_26003":112018,"_2720":112064},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3227":66642,"_28581":66624,"_19785":112066,"_5":13558,"_26003":112018,"_2720":49547},[],{"_3227":66643,"_28581":66624,"_19785":112068,"_5":13558,"_26003":112018,"_2720":49550},[],{"_3227":66644,"_28581":66624,"_19785":112070,"_5":13558,"_26003":112018,"_2720":112071},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3227":66645,"_28581":66624,"_19785":112073,"_5":13558,"_26003":112018,"_2720":49556},[],{"_3227":66646,"_28581":66624,"_19785":112075,"_5":13558,"_26003":112018,"_2720":49550},[],{"_3227":66647,"_28581":66624,"_19785":112077,"_5":13558,"_26003":112018,"_2720":112078},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3227":66648,"_28581":66624,"_19785":112080,"_5":13558,"_26003":112018,"_2720":49564},[],{"_3227":66649,"_28581":66624,"_19785":112082,"_5":13558,"_26003":112018,"_2720":49550},[],{"_3227":66650,"_28581":66624,"_19785":112084,"_5":13558,"_26003":112018,"_2720":112085},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3227":66651,"_28581":66624,"_19785":112087,"_5":13558,"_26003":112018,"_2720":112088},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3227":66652,"_28581":66624,"_19785":112090,"_5":13558,"_26003":112022,"_2720":112091},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3227":66653,"_28581":66624,"_19785":112093,"_5":13558,"_26003":112022,"_2720":112094},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3227":66654,"_28581":66624,"_19785":112096,"_5":13558,"_26003":112025,"_2720":112097},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3227":66655,"_28581":66624,"_19785":112099,"_5":13558,"_26003":112025,"_2720":112100},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3227":66656,"_28581":66624,"_19785":112102,"_5":13558,"_26003":112028,"_2720":112103},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3227":66657,"_28581":66624,"_19785":112105,"_5":13558,"_26003":112028,"_2720":112106},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3227":66658,"_28581":66624,"_19785":112108,"_5":13558,"_26003":112031,"_2720":112109},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3227":66659,"_28581":66624,"_19785":112111,"_5":13558,"_26003":112031,"_2720":112112},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3227":66660,"_28581":66624,"_19785":112114,"_5":13558,"_26003":112034,"_2720":112115},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3227":66661,"_28581":66624,"_19785":112117,"_5":13558,"_26003":112034,"_2720":112118},[],"Parte",{"_3227":66662,"_28581":66624,"_19785":112120,"_5":13558,"_26003":112034,"_2720":112121},[],"Contenido tras decodificar su Base64",{"_3227":66663,"_28581":66624,"_19785":112123,"_5":13558,"_26003":112034,"_2720":49608},[],{"_3227":66664,"_28581":66624,"_19785":112125,"_5":13558,"_26003":112034,"_2720":112126},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3227":66665,"_28581":66624,"_19785":112128,"_5":13558,"_26003":112034,"_2720":49614},[],{"_3227":66666,"_28581":66624,"_19785":112130,"_5":13558,"_26003":112034,"_2720":112131},[],"PKCS#7 DER con el certificado emitido.",{"_3227":66667,"_28581":66624,"_19785":112133,"_5":13558,"_26003":112034,"_2720":112134},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3227":66668,"_28581":66624,"_19785":112136,"_5":13558,"_26003":112038,"_2720":112137},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3227":66669,"_28581":66624,"_19785":112139,"_5":13558,"_26003":112038,"_2720":112140},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3227":66670,"_28581":66624,"_19785":112142,"_5":13558,"_26003":112038,"_2720":112143},[],"Convierte y comprueba el resultado:",{"_3227":66671,"_28581":66624,"_19785":112145,"_5":13558,"_26003":112038,"_2720":112146},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3227":66672,"_28581":66624,"_19785":112148,"_5":13558,"_26003":112042,"_2720":112149},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3227":66673,"_28581":66624,"_19785":112151,"_5":13558,"_26003":112042,"_2720":112152},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3227":66674,"_28581":66674,"_5":13916,"_2720":111511,"_28924":112154,"_19785":112155,"_26003":66674},[46319,110330,48776,111336,111511],[],{"_3227":66675,"_28581":66674,"_19785":112157,"_5":13558,"_26003":66674,"_2720":112158},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3227":66676,"_28581":66674,"_5":28921,"_19785":112160,"_26003":112161,"_2720":112162},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3227":66677,"_28581":66674,"_5":28921,"_19785":112164,"_26003":112165,"_2720":112166},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3227":66678,"_28581":66674,"_5":28921,"_19785":112168,"_26003":112169,"_2720":112170},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3227":66679,"_28581":66674,"_5":28921,"_19785":112172,"_26003":112173,"_2720":112174},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3227":66680,"_28581":66674,"_19785":112176,"_5":13558,"_26003":66674,"_2720":112177},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3227":66681,"_28581":66674,"_19785":112179,"_5":13558,"_26003":112161,"_2720":112180},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3227":66682,"_28581":66674,"_19785":112182,"_5":13558,"_26003":112161,"_2720":112183},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3227":66683,"_28581":66674,"_19785":112185,"_5":13558,"_26003":112161,"_2720":112186},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3227":66684,"_28581":66674,"_19785":112188,"_5":13558,"_26003":112161,"_2720":112189},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3227":66685,"_28581":66674,"_19785":112191,"_5":13558,"_26003":112161,"_2720":112192},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3227":66686,"_28581":66674,"_19785":112194,"_5":13558,"_26003":112161,"_2720":112195},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3227":66687,"_28581":66674,"_19785":112197,"_5":13558,"_26003":112165,"_2720":112198},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3227":66688,"_28581":66674,"_19785":112200,"_5":13558,"_26003":112165,"_2720":112201},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3227":66689,"_28581":66674,"_19785":112203,"_5":13558,"_26003":112165,"_2720":112204},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3227":66690,"_28581":66674,"_19785":112206,"_5":13558,"_26003":112165,"_2720":112207},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3227":66691,"_28581":66674,"_19785":112209,"_5":13558,"_26003":112169,"_2720":112210},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3227":66692,"_28581":66674,"_19785":112212,"_5":13558,"_26003":112169,"_2720":112213},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3227":66693,"_28581":66674,"_19785":112215,"_5":13558,"_26003":112169,"_2720":112216},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3227":66694,"_28581":66674,"_19785":112218,"_5":13558,"_26003":112169,"_2720":112219},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3227":66695,"_28581":66674,"_19785":112221,"_5":13558,"_26003":112173,"_2720":112222},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3227":66696,"_28581":66674,"_19785":112224,"_5":13558,"_26003":112173,"_2720":112225},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3227":66697,"_28581":66697,"_5":13916,"_2720":112227,"_28924":112228,"_19785":112229,"_26003":66697},"Estrategias de aprovisionamiento",[46319,110330,48776,111336,111511],[],{"_3227":66698,"_28581":66697,"_19785":112231,"_5":13558,"_26003":66697,"_2720":112232},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3227":66699,"_28581":66697,"_5":28921,"_19785":112234,"_26003":112235,"_2720":112236},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3227":66700,"_28581":66697,"_5":28921,"_19785":112238,"_26003":112239,"_2720":112240},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3227":66701,"_28581":66697,"_5":28921,"_19785":112242,"_26003":112243,"_2720":112244},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3227":66702,"_28581":66697,"_5":28921,"_19785":112246,"_26003":112247,"_2720":112248},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3227":66703,"_28581":66697,"_5":28921,"_19785":112250,"_26003":112251,"_2720":112252},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3227":66704,"_28581":66697,"_19785":112254,"_5":13558,"_26003":66697,"_2720":112255},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3227":66705,"_28581":66697,"_19785":112257,"_5":13558,"_26003":112235,"_2720":112258},[],"Recorrido",{"_3227":66706,"_28581":66697,"_19785":112260,"_5":13558,"_26003":112235,"_2720":112261},[],"Cuándo existe el dispositivo",{"_3227":66707,"_28581":66697,"_19785":112263,"_5":13558,"_26003":112235,"_2720":112264},[],"Qué compruebas",{"_3227":66708,"_28581":66697,"_19785":112266,"_5":13558,"_26003":112235,"_2720":112267},[],"Asignación manual",{"_3227":66709,"_28581":66697,"_19785":112269,"_5":13558,"_26003":112235,"_2720":112270},[],"El operador lo crea antes de asociar un certificado.",{"_3227":66710,"_28581":66697,"_19785":112272,"_5":13558,"_26003":112235,"_2720":112273},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3227":66711,"_28581":66697,"_19785":112275,"_5":13558,"_26003":112235,"_2720":112276},[],"EST con `JITP`",{"_3227":66712,"_28581":66697,"_19785":112278,"_5":13558,"_26003":112235,"_2720":112279},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3227":66713,"_28581":66697,"_19785":112281,"_5":13558,"_26003":112235,"_2720":112282},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3227":66714,"_28581":66697,"_19785":112284,"_5":13558,"_26003":112235,"_2720":112285},[],"EST con `PRE_REGISTRATION`",{"_3227":66715,"_28581":66697,"_19785":112287,"_5":13558,"_26003":112235,"_2720":112288},[],"Debe existir antes de `/simpleenroll`.",{"_3227":66716,"_28581":66697,"_19785":112290,"_5":13558,"_26003":112235,"_2720":112291},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3227":66717,"_28581":66697,"_19785":112293,"_5":13558,"_26003":112235,"_2720":112294},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3227":66718,"_28581":66697,"_19785":112296,"_5":13558,"_26003":112235,"_2720":112297},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3227":66719,"_28581":66697,"_19785":112299,"_5":13558,"_26003":112239,"_2720":112300},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3227":66720,"_28581":66697,"_19785":112302,"_5":13558,"_26003":112239,"_2720":112303},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3227":66721,"_28581":66697,"_19785":112305,"_5":13558,"_26003":112239,"_2720":112306},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3227":66722,"_28581":66697,"_19785":112308,"_5":13558,"_26003":112243,"_2720":112309},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3227":66723,"_28581":66697,"_19785":112311,"_5":13558,"_26003":112243,"_2720":112312},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3227":66724,"_28581":66697,"_19785":112314,"_5":13558,"_26003":112243,"_2720":112315},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3227":66725,"_28581":66697,"_19785":112317,"_5":13558,"_26003":112243,"_2720":112318},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3227":66726,"_28581":66697,"_19785":112320,"_5":13558,"_26003":112243,"_2720":112321},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3227":66727,"_28581":66697,"_19785":112323,"_5":13558,"_26003":112243,"_2720":112324},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3227":66728,"_28581":66697,"_19785":112326,"_5":13558,"_26003":112247,"_2720":109291},[],{"_3227":66729,"_28581":66697,"_19785":112328,"_5":13558,"_26003":112247,"_2720":112329},[],"Material que atraviesa EST",{"_3227":66730,"_28581":66697,"_19785":112331,"_5":13558,"_26003":112247,"_2720":112332},[],"Clave generada por el dispositivo",{"_3227":66731,"_28581":66697,"_19785":112334,"_5":13558,"_26003":112247,"_2720":112335},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3227":66732,"_28581":66697,"_19785":112337,"_5":13558,"_26003":112247,"_2720":112338},[],"Clave ya disponible en el dispositivo",{"_3227":66733,"_28581":66697,"_19785":112340,"_5":13558,"_26003":112247,"_2720":112341},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3227":66734,"_28581":66697,"_19785":112343,"_5":13558,"_26003":112247,"_2720":49095},[],{"_3227":66735,"_28581":66697,"_19785":112345,"_5":13558,"_26003":112247,"_2720":112346},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3227":66736,"_28581":66697,"_19785":112348,"_5":13558,"_26003":112247,"_2720":112349},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3227":66737,"_28581":66697,"_19785":112351,"_5":13558,"_26003":112251,"_2720":112352},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3227":66738,"_28581":66738,"_5":13916,"_2720":112354,"_28924":112355,"_19785":112356,"_26003":66738},"Renovación y recuperación",[46319,110330,48776,111336,111511],[],{"_3227":66739,"_28581":66738,"_19785":112358,"_5":13558,"_26003":66738,"_2720":112359},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3227":66740,"_28581":66738,"_5":28921,"_19785":112361,"_26003":112362,"_2720":112363},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3227":66741,"_28581":66738,"_5":28921,"_19785":112365,"_26003":112366,"_2720":112367},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3227":66742,"_28581":66738,"_5":28921,"_19785":112369,"_26003":112370,"_2720":112371},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3227":66743,"_28581":66738,"_5":28921,"_19785":112373,"_26003":112374,"_2720":112375},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3227":66744,"_28581":66738,"_5":28921,"_19785":112377,"_26003":112378,"_2720":112379},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3227":66745,"_28581":66738,"_19785":112381,"_5":13558,"_26003":66738,"_2720":112382},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3227":66746,"_28581":66738,"_19785":112384,"_5":13558,"_26003":112362,"_2720":112385},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3227":66747,"_28581":66738,"_19785":112387,"_5":13558,"_26003":112362,"_2720":112388},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3227":66748,"_28581":66738,"_19785":112390,"_5":13558,"_26003":112362,"_2720":112391},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3227":66749,"_28581":66738,"_19785":112393,"_5":13558,"_26003":112362,"_2720":112394},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3227":66750,"_28581":66738,"_19785":112396,"_5":13558,"_26003":112366,"_2720":112397},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3227":66751,"_28581":66738,"_19785":112399,"_5":13558,"_26003":112366,"_2720":112400},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3227":66752,"_28581":66738,"_19785":112402,"_5":13558,"_26003":112370,"_2720":112403},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3227":66753,"_28581":66738,"_19785":112405,"_5":13558,"_26003":112370,"_2720":112406},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3227":66754,"_28581":66738,"_19785":112408,"_5":13558,"_26003":112370,"_2720":112409},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3227":66755,"_28581":66738,"_19785":112411,"_5":13558,"_26003":112374,"_2720":112412},[],"Situación",{"_3227":66756,"_28581":66738,"_19785":112414,"_5":13558,"_26003":112374,"_2720":112415},[],"Procedimiento",{"_3227":66757,"_28581":66738,"_19785":112417,"_5":13558,"_26003":112374,"_2720":112418},[],"Certificado vigente, fuera de ventana",{"_3227":66758,"_28581":66738,"_19785":112420,"_5":13558,"_26003":112374,"_2720":112421},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3227":66759,"_28581":66738,"_19785":112423,"_5":13558,"_26003":112374,"_2720":112424},[],"Certificado vencido, clave disponible",{"_3227":66760,"_28581":66738,"_19785":112426,"_5":13558,"_26003":112374,"_2720":112427},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3227":66761,"_28581":66738,"_19785":112429,"_5":13558,"_26003":112374,"_2720":112430},[],"Renovación por webhook o `NO_AUTH`",{"_3227":66762,"_28581":66738,"_19785":112432,"_5":13558,"_26003":112374,"_2720":112433},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3227":66763,"_28581":66738,"_19785":112435,"_5":13558,"_26003":112374,"_2720":112436},[],"Clave perdida o inaccesible",{"_3227":66764,"_28581":66738,"_19785":112438,"_5":13558,"_26003":112374,"_2720":112439},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3227":66765,"_28581":66738,"_19785":112441,"_5":13558,"_26003":112374,"_2720":112442},[],"Identidad actual revocada",{"_3227":66766,"_28581":66738,"_19785":112444,"_5":13558,"_26003":112374,"_2720":112445},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3227":66767,"_28581":66738,"_19785":112447,"_5":13558,"_26003":112374,"_2720":112448},[],"Dispositivo sin identidad",{"_3227":66768,"_28581":66738,"_19785":112450,"_5":13558,"_26003":112374,"_2720":112451},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3227":66769,"_28581":66738,"_19785":112453,"_5":13558,"_26003":112374,"_2720":112454},[],"Dispositivo retirado",{"_3227":66770,"_28581":66738,"_19785":112456,"_5":13558,"_26003":112374,"_2720":112457},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3227":66771,"_28581":66738,"_19785":112459,"_5":13558,"_26003":112374,"_2720":112460},[],"Timeout, HTTP 500 o fallo de instalación",{"_3227":66772,"_28581":66738,"_19785":112462,"_5":13558,"_26003":112374,"_2720":112463},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3227":66773,"_28581":66738,"_19785":112465,"_5":13558,"_26003":112378,"_2720":112466},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3227":66774,"_28581":66738,"_19785":112468,"_5":13558,"_26003":112378,"_2720":112469},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3227":66775,"_28581":66775,"_5":13916,"_2720":112471,"_28924":112472,"_19785":112473,"_26003":66775},"Diagnóstico de enrolamiento",[46319,110330,48776,111336,111511],[],{"_3227":66776,"_28581":66775,"_19785":112475,"_5":13558,"_26003":66775,"_2720":112476},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3227":66777,"_28581":66775,"_5":28921,"_19785":112478,"_26003":112479,"_2720":112480},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3227":66778,"_28581":66775,"_5":28921,"_19785":112482,"_26003":112483,"_2720":112484},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3227":66779,"_28581":66775,"_5":28921,"_19785":112486,"_26003":112487,"_2720":112043},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3227":66780,"_28581":66775,"_5":28921,"_19785":112489,"_26003":112490,"_2720":112491},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3227":66781,"_28581":66775,"_19785":112493,"_5":13558,"_26003":66775,"_2720":112494},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3227":66782,"_28581":66775,"_19785":112496,"_5":13558,"_26003":112483,"_2720":112497},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3227":66783,"_28581":66775,"_19785":112499,"_5":13558,"_26003":112483,"_2720":112500},[],"Síntoma o mensaje",{"_3227":66784,"_28581":66775,"_19785":112502,"_5":13558,"_26003":112483,"_2720":112503},[],"Qué revisar",{"_3227":66785,"_28581":66775,"_19785":112505,"_5":13558,"_26003":112483,"_2720":112506},[],"curl rechaza TLS, nombre o emisor",{"_3227":66786,"_28581":66775,"_19785":112508,"_5":13558,"_26003":112483,"_2720":112509},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3227":66787,"_28581":66775,"_19785":112511,"_5":13558,"_26003":112483,"_2720":112512},[],"404 o APS ausente",{"_3227":66788,"_28581":66775,"_19785":112514,"_5":13558,"_26003":112483,"_2720":112515},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3227":66789,"_28581":66775,"_19785":112517,"_5":13558,"_26003":112483,"_2720":112518},[],"400, error de CSR o formato",{"_3227":66790,"_28581":66775,"_19785":112520,"_5":13558,"_26003":112483,"_2720":112521},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3227":66791,"_28581":66775,"_19785":112523,"_5":13558,"_26003":112483,"_2720":112524},[],"Credencial ausente o certificado no válido",{"_3227":66792,"_28581":66775,"_19785":112526,"_5":13558,"_26003":112483,"_2720":112527},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3227":66793,"_28581":66775,"_19785":112529,"_5":13558,"_26003":112483,"_2720":112530},[],"Webhook deniega, expira o responde sin autorización",{"_3227":66794,"_28581":66775,"_19785":112532,"_5":13558,"_26003":112483,"_2720":112533},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3227":66795,"_28581":66775,"_19785":112535,"_5":13558,"_26003":112483,"_2720":50021},[],{"_3227":66796,"_28581":66775,"_19785":112537,"_5":13558,"_26003":112483,"_2720":112538},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3227":66797,"_28581":66775,"_19785":112540,"_5":13558,"_26003":112483,"_2720":50027},[],{"_3227":66798,"_28581":66775,"_19785":112542,"_5":13558,"_26003":112483,"_2720":112543},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3227":66799,"_28581":66775,"_19785":112545,"_5":13558,"_26003":112483,"_2720":50033},[],{"_3227":66800,"_28581":66775,"_19785":112547,"_5":13558,"_26003":112483,"_2720":112548},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3227":66801,"_28581":66775,"_19785":112550,"_5":13558,"_26003":112483,"_2720":50039},[],{"_3227":66802,"_28581":66775,"_19785":112552,"_5":13558,"_26003":112483,"_2720":112553},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3227":66803,"_28581":66775,"_19785":112555,"_5":13558,"_26003":112483,"_2720":50045},[],{"_3227":66804,"_28581":66775,"_19785":112557,"_5":13558,"_26003":112483,"_2720":112558},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3227":66805,"_28581":66775,"_19785":112560,"_5":13558,"_26003":112483,"_2720":112561},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3227":66806,"_28581":66775,"_19785":112563,"_5":13558,"_26003":112483,"_2720":112564},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3227":66807,"_28581":66775,"_19785":112566,"_5":13558,"_26003":112483,"_2720":112567},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3227":66808,"_28581":66775,"_19785":112569,"_5":13558,"_26003":112483,"_2720":112570},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3227":66809,"_28581":66775,"_19785":112572,"_5":13558,"_26003":112483,"_2720":50063},[],{"_3227":66810,"_28581":66775,"_19785":112574,"_5":13558,"_26003":112483,"_2720":112575},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3227":66811,"_28581":66775,"_19785":112577,"_5":13558,"_26003":112483,"_2720":50069},[],{"_3227":66812,"_28581":66775,"_19785":112579,"_5":13558,"_26003":112483,"_2720":112580},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3227":66813,"_28581":66775,"_19785":112582,"_5":13558,"_26003":112483,"_2720":112583},[],"DMS propietario distinto",{"_3227":66814,"_28581":66775,"_19785":112585,"_5":13558,"_26003":112483,"_2720":112586},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3227":66815,"_28581":66775,"_19785":112588,"_5":13558,"_26003":112483,"_2720":50081},[],{"_3227":66816,"_28581":66775,"_19785":112590,"_5":13558,"_26003":112483,"_2720":112591},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3227":66817,"_28581":66775,"_19785":112593,"_5":13558,"_26003":112483,"_2720":50087},[],{"_3227":66818,"_28581":66775,"_19785":112595,"_5":13558,"_26003":112483,"_2720":112596},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3227":66819,"_28581":66775,"_19785":112598,"_5":13558,"_26003":112483,"_2720":112599},[],"Certificado actual revocado",{"_3227":66820,"_28581":66775,"_19785":112601,"_5":13558,"_26003":112483,"_2720":112602},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3227":66821,"_28581":66775,"_19785":112604,"_5":13558,"_26003":112483,"_2720":112605},[],"Error de CA, perfil o firma",{"_3227":66822,"_28581":66775,"_19785":112607,"_5":13558,"_26003":112483,"_2720":112608},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3227":66823,"_28581":66775,"_19785":112610,"_5":13558,"_26003":112483,"_2720":112611},[],"HTTP 200 sin conexión del dispositivo",{"_3227":66824,"_28581":66775,"_19785":112613,"_5":13558,"_26003":112483,"_2720":112614},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3227":66825,"_28581":66775,"_19785":112616,"_5":13558,"_26003":112483,"_2720":112617},[],"Timeout o error después de emitir",{"_3227":66826,"_28581":66775,"_19785":112619,"_5":13558,"_26003":112483,"_2720":112620},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3227":66827,"_28581":66775,"_19785":112622,"_5":13558,"_26003":112487,"_2720":112623},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3227":66828,"_28581":66775,"_19785":112625,"_5":13558,"_26003":112487,"_2720":112626},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3227":66829,"_28581":66775,"_19785":112628,"_5":13558,"_26003":112490,"_2720":112629},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3227":66830,"_28581":66775,"_19785":112631,"_5":13558,"_26003":112490,"_2720":112632},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3227":66831,"_28581":66775,"_19785":112634,"_5":13558,"_26003":112490,"_2720":112635},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3227":66832,"_28581":66775,"_19785":112637,"_5":13558,"_26003":112490,"_2720":112638},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3227":66833,"_28581":66775,"_19785":112640,"_5":13558,"_26003":112490,"_2720":112641},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3227":66834,"_28581":66775,"_19785":112643,"_5":13558,"_26003":112490,"_2720":112644},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3227":66835,"_28581":66775,"_19785":112646,"_5":13558,"_26003":112490,"_2720":112647},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3227":66836,"_28581":66836,"_5":13916,"_2720":112649,"_28924":112650,"_19785":112651,"_26003":66836},"Distribución y actualización de confianza",[46319,110330,48776,111336,111511],[],{"_3227":66837,"_28581":66836,"_19785":112653,"_5":13558,"_26003":66836,"_2720":112654},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3227":66838,"_28581":66836,"_5":28921,"_19785":112656,"_26003":112657,"_2720":112658},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3227":66839,"_28581":66836,"_5":28921,"_19785":112660,"_26003":112661,"_2720":112662},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3227":66840,"_28581":66836,"_5":28921,"_19785":112664,"_26003":112665,"_2720":112666},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3227":66841,"_28581":66836,"_5":28921,"_19785":112668,"_26003":112669,"_2720":112670},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3227":66842,"_28581":66836,"_5":28921,"_19785":112672,"_26003":112673,"_2720":112674},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3227":66843,"_28581":66836,"_19785":112676,"_5":13558,"_26003":66836,"_2720":112677},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3227":66844,"_28581":66836,"_19785":112679,"_5":13558,"_26003":112657,"_2720":112680},[],"Relación",{"_3227":66845,"_28581":66836,"_19785":112682,"_5":13558,"_26003":112657,"_2720":112683},[],"Material que prepara el responsable",{"_3227":66846,"_28581":66836,"_19785":112685,"_5":13558,"_26003":112657,"_2720":112686},[],"Dispositivo → servidor EST",{"_3227":66847,"_28581":66836,"_19785":112688,"_5":13558,"_26003":112657,"_2720":112689},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3227":66848,"_28581":66836,"_19785":112691,"_5":13558,"_26003":112657,"_2720":112692},[],"DMS → solicitante",{"_3227":66849,"_28581":66836,"_19785":112694,"_5":13558,"_26003":112657,"_2720":112695},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3227":66850,"_28581":66836,"_19785":112697,"_5":13558,"_26003":112657,"_2720":112698},[],"Consumidor → dispositivo",{"_3227":66851,"_28581":66836,"_19785":112700,"_5":13558,"_26003":112657,"_2720":112701},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3227":66852,"_28581":66836,"_19785":112703,"_5":13558,"_26003":112657,"_2720":112704},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3227":66853,"_28581":66836,"_19785":112706,"_5":13558,"_26003":112661,"_2720":112707},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3227":66854,"_28581":66836,"_19785":112709,"_5":13558,"_26003":112661,"_2720":112710},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3227":66855,"_28581":66836,"_19785":112712,"_5":13558,"_26003":112665,"_2720":112713},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3227":66856,"_28581":66836,"_19785":112715,"_5":13558,"_26003":112665,"_2720":112716},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3227":66857,"_28581":66836,"_19785":112718,"_5":13558,"_26003":112665,"_2720":112719},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3227":66858,"_28581":66836,"_19785":112721,"_5":13558,"_26003":112665,"_2720":112722},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3227":66859,"_28581":66836,"_19785":112724,"_5":13558,"_26003":112665,"_2720":112725},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3227":66860,"_28581":66836,"_19785":112727,"_5":13558,"_26003":112665,"_2720":112728},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3227":66861,"_28581":66836,"_19785":112730,"_5":13558,"_26003":112669,"_2720":112731},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3227":66862,"_28581":66836,"_19785":112733,"_5":13558,"_26003":112669,"_2720":112734},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3227":66863,"_28581":66836,"_19785":112736,"_5":13558,"_26003":112669,"_2720":112737},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3227":66864,"_28581":66836,"_19785":112739,"_5":13558,"_26003":112673,"_2720":112740},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3227":66865,"_28581":66865,"_5":13916,"_2720":50236,"_28924":112742,"_19785":112744,"_26003":66865},[46319,110330,48776,111336,112743],"Integraciones",[],{"_3227":66866,"_28581":66865,"_19785":112746,"_5":13558,"_26003":66865,"_2720":112747},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3227":66867,"_28581":66865,"_5":28921,"_19785":112749,"_26003":112750,"_2720":112751},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3227":66868,"_28581":66865,"_5":28921,"_19785":112753,"_26003":112754,"_2720":112755},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3227":66869,"_28581":66865,"_5":28921,"_19785":112757,"_26003":112758,"_2720":112759},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3227":66870,"_28581":66865,"_5":28921,"_19785":112761,"_26003":112762,"_2720":112763},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3227":66871,"_28581":66865,"_5":28921,"_19785":112765,"_26003":112766,"_2720":112767},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3227":66872,"_28581":66865,"_5":28921,"_19785":112769,"_26003":112770,"_2720":112771},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3227":66873,"_28581":66865,"_5":28921,"_19785":112773,"_26003":112774,"_2720":50270},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3227":66874,"_28581":66865,"_5":28921,"_19785":112776,"_26003":112777,"_2720":50274},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3227":66875,"_28581":66865,"_5":28921,"_19785":112779,"_26003":112780,"_2720":112781},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3227":66876,"_28581":66865,"_5":28921,"_19785":112783,"_26003":112784,"_2720":112785},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3227":66877,"_28581":66865,"_5":28921,"_19785":112787,"_26003":112788,"_2720":112789},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3227":66878,"_28581":66865,"_5":28921,"_19785":112791,"_26003":112792,"_2720":112793},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3227":66879,"_28581":66865,"_5":28921,"_19785":112795,"_26003":112796,"_2720":112797},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3227":66880,"_28581":66865,"_5":28921,"_19785":112799,"_26003":112800,"_2720":112801},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3227":66881,"_28581":66865,"_5":28921,"_19785":112803,"_26003":112804,"_2720":112805},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3227":66882,"_28581":66865,"_5":28921,"_19785":112807,"_26003":112808,"_2720":112809},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3227":66883,"_28581":66865,"_5":28921,"_19785":112811,"_26003":112812,"_2720":112813},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3227":66884,"_28581":66865,"_5":28921,"_19785":112815,"_26003":112816,"_2720":112817},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3227":66885,"_28581":66865,"_5":28921,"_19785":112819,"_26003":112820,"_2720":112821},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3227":66886,"_28581":66865,"_5":28921,"_19785":112823,"_26003":112824,"_2720":112825},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3227":66887,"_28581":66865,"_19785":112827,"_5":13558,"_26003":66865,"_2720":112828},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3227":66888,"_28581":66865,"_19785":112830,"_5":13558,"_26003":66865,"_2720":112831},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3227":66889,"_28581":66865,"_19785":112833,"_5":13558,"_26003":66865,"_2720":112834},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3227":66890,"_28581":66865,"_19785":112836,"_5":13558,"_26003":112750,"_2720":112837},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3227":66891,"_28581":66865,"_19785":112839,"_5":13558,"_26003":112750,"_2720":112840},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3227":66892,"_28581":66865,"_19785":112842,"_5":13558,"_26003":112750,"_2720":112843},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3227":66893,"_28581":66865,"_19785":112845,"_5":13558,"_26003":112750,"_2720":112846},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3227":66894,"_28581":66865,"_19785":112848,"_5":13558,"_26003":112754,"_2720":112849},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3227":66895,"_28581":66865,"_19785":112851,"_5":13558,"_26003":112758,"_2720":112852},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3227":66896,"_28581":66865,"_19785":112854,"_5":13558,"_26003":112758,"_2720":112855},[],"Acción IAM",{"_3227":66897,"_28581":66865,"_19785":112857,"_5":13558,"_26003":112758,"_2720":109297},[],{"_3227":66898,"_28581":66865,"_19785":112859,"_5":13558,"_26003":112758,"_2720":50357},[],{"_3227":66899,"_28581":66865,"_19785":112861,"_5":13558,"_26003":112758,"_2720":112862},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3227":66900,"_28581":66865,"_19785":112864,"_5":13558,"_26003":112758,"_2720":50363},[],{"_3227":66901,"_28581":66865,"_19785":112866,"_5":13558,"_26003":112758,"_2720":112867},[],"Registrar la CA en AWS IoT",{"_3227":66902,"_28581":66865,"_19785":112869,"_5":13558,"_26003":112758,"_2720":50369},[],{"_3227":66903,"_28581":66865,"_19785":112871,"_5":13558,"_26003":112758,"_2720":112872},[],"Consultar el estado del registro de la CA",{"_3227":66904,"_28581":66865,"_19785":112874,"_5":13558,"_26003":112758,"_2720":50375},[],{"_3227":66905,"_28581":66865,"_19785":112876,"_5":13558,"_26003":112758,"_2720":112877},[],"Crear o actualizar Things en IoT Core",{"_3227":66906,"_28581":66865,"_19785":112879,"_5":13558,"_26003":112758,"_2720":50381},[],{"_3227":66907,"_28581":66865,"_19785":112881,"_5":13558,"_26003":112758,"_2720":112882},[],"Aprovisionar Things mediante plantilla",{"_3227":66908,"_28581":66865,"_19785":112884,"_5":13558,"_26003":112758,"_2720":50387},[],{"_3227":66909,"_28581":66865,"_19785":112886,"_5":13558,"_26003":112758,"_2720":112887},[],"Registrar certificados de dispositivo",{"_3227":66910,"_28581":66865,"_19785":112889,"_5":13558,"_26003":112758,"_2720":50393},[],{"_3227":66911,"_28581":66865,"_19785":112891,"_5":13558,"_26003":112758,"_2720":112892},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3227":66912,"_28581":66865,"_19785":112894,"_5":13558,"_26003":112758,"_2720":50399},[],{"_3227":66913,"_28581":66865,"_19785":112896,"_5":13558,"_26003":112758,"_2720":112897},[],"Crear y adjuntar políticas IoT",{"_3227":66914,"_28581":66865,"_19785":112899,"_5":13558,"_26003":112758,"_2720":50405},[],{"_3227":66915,"_28581":66865,"_19785":112901,"_5":13558,"_26003":112758,"_2720":112902},[],"Gestionar grupos de Things",{"_3227":66916,"_28581":66865,"_19785":112904,"_5":13558,"_26003":112758,"_2720":50411},[],{"_3227":66917,"_28581":66865,"_19785":112906,"_5":13558,"_26003":112758,"_2720":112907},[],"Crear plantillas JITP",{"_3227":66918,"_28581":66865,"_19785":112909,"_5":13558,"_26003":112758,"_2720":50417},[],{"_3227":66919,"_28581":66865,"_19785":112911,"_5":13558,"_26003":112758,"_2720":112912},[],"Leer y escribir el Device Shadow",{"_3227":66920,"_28581":66865,"_19785":112914,"_5":13558,"_26003":112758,"_2720":112915},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3227":66921,"_28581":66865,"_19785":112917,"_5":13558,"_26003":112762,"_2720":112918},[],"Parámetro",{"_3227":66922,"_28581":66865,"_19785":112920,"_5":13558,"_26003":112762,"_2720":112921},[],"Tipo",{"_3227":66923,"_28581":66865,"_19785":112923,"_5":13558,"_26003":112762,"_2720":112924},[],"Requerido",{"_3227":66924,"_28581":66865,"_19785":112926,"_5":13558,"_26003":112762,"_2720":112927},[],"Descripción",{"_3227":66925,"_28581":66865,"_19785":112929,"_5":13558,"_26003":112762,"_2720":50438},[],{"_3227":66926,"_28581":66865,"_19785":112931,"_5":13558,"_26003":112762,"_2720":23654},[],{"_3227":66927,"_28581":66865,"_19785":112933,"_5":13558,"_26003":112762,"_2720":112934},[],"Sí",{"_3227":66928,"_28581":66865,"_19785":112936,"_5":13558,"_26003":112762,"_2720":112937},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3227":66929,"_28581":66865,"_19785":112939,"_5":13558,"_26003":112762,"_2720":50449},[],{"_3227":66930,"_28581":66865,"_19785":112941,"_5":13558,"_26003":112762,"_2720":23654},[],{"_3227":66931,"_28581":66865,"_19785":112943,"_5":13558,"_26003":112762,"_2720":112934},[],{"_3227":66932,"_28581":66865,"_19785":112945,"_5":13558,"_26003":112762,"_2720":112946},[],"Región AWS donde opera el conector.",{"_3227":66933,"_28581":66865,"_19785":112948,"_5":13558,"_26003":112762,"_2720":50459},[],{"_3227":66934,"_28581":66865,"_19785":112950,"_5":13558,"_26003":112762,"_2720":23654},[],{"_3227":66935,"_28581":66865,"_19785":112952,"_5":13558,"_26003":112762,"_2720":112934},[],{"_3227":66936,"_28581":66865,"_19785":112954,"_5":13558,"_26003":112762,"_2720":112955},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3227":66937,"_28581":66865,"_19785":112957,"_5":13558,"_26003":112762,"_2720":50469},[],{"_3227":66938,"_28581":66865,"_19785":112959,"_5":13558,"_26003":112762,"_2720":23654},[],{"_3227":66939,"_28581":66865,"_19785":112961,"_5":13558,"_26003":112762,"_2720":112962},[],"Solo con `auth_method=static`",{"_3227":66940,"_28581":66865,"_19785":112964,"_5":13558,"_26003":112762,"_2720":112965},[],"Clave de acceso AWS.",{"_3227":66941,"_28581":66865,"_19785":112967,"_5":13558,"_26003":112762,"_2720":50480},[],{"_3227":66942,"_28581":66865,"_19785":112969,"_5":13558,"_26003":112762,"_2720":23654},[],{"_3227":66943,"_28581":66865,"_19785":112971,"_5":13558,"_26003":112762,"_2720":112962},[],{"_3227":66944,"_28581":66865,"_19785":112973,"_5":13558,"_26003":112762,"_2720":112974},[],"Clave secreta AWS.",{"_3227":66945,"_28581":66865,"_19785":112976,"_5":13558,"_26003":112762,"_2720":50490},[],{"_3227":66946,"_28581":66865,"_19785":112978,"_5":13558,"_26003":112762,"_2720":23654},[],{"_3227":66947,"_28581":66865,"_19785":112980,"_5":13558,"_26003":112762,"_2720":50495},[],{"_3227":66948,"_28581":66865,"_19785":112982,"_5":13558,"_26003":112762,"_2720":112983},[],"Token de sesión (con `auth_method=static`).",{"_3227":66949,"_28581":66865,"_19785":112985,"_5":13558,"_26003":112762,"_2720":50501},[],{"_3227":66950,"_28581":66865,"_19785":112987,"_5":13558,"_26003":112762,"_2720":23654},[],{"_3227":66951,"_28581":66865,"_19785":112989,"_5":13558,"_26003":112762,"_2720":112990},[],"Solo con `auth_method=role`",{"_3227":66952,"_28581":66865,"_19785":112992,"_5":13558,"_26003":112762,"_2720":112993},[],"ARN del rol a asumir.",{"_3227":66953,"_28581":66865,"_19785":112995,"_5":13558,"_26003":112762,"_2720":50512},[],{"_3227":66954,"_28581":66865,"_19785":112997,"_5":13558,"_26003":112762,"_2720":23654},[],{"_3227":66955,"_28581":66865,"_19785":112999,"_5":13558,"_26003":112762,"_2720":50495},[],{"_3227":66956,"_28581":66865,"_19785":113001,"_5":13558,"_26003":112762,"_2720":113002},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3227":66957,"_28581":66865,"_19785":113004,"_5":13558,"_26003":112762,"_2720":50522},[],{"_3227":66958,"_28581":66865,"_19785":113006,"_5":13558,"_26003":112762,"_2720":16666},[],{"_3227":66959,"_28581":66865,"_19785":113008,"_5":13558,"_26003":112762,"_2720":112934},[],{"_3227":66960,"_28581":66865,"_19785":113010,"_5":13558,"_26003":112762,"_2720":113011},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3227":66961,"_28581":66865,"_19785":113013,"_5":13558,"_26003":112762,"_2720":50532},[],{"_3227":66962,"_28581":66865,"_19785":113015,"_5":13558,"_26003":112762,"_2720":23654},[],{"_3227":66963,"_28581":66865,"_19785":113017,"_5":13558,"_26003":112762,"_2720":112934},[],{"_3227":66964,"_28581":66865,"_19785":113019,"_5":13558,"_26003":112762,"_2720":113020},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3227":66965,"_28581":66865,"_19785":113022,"_5":13558,"_26003":112762,"_2720":50542},[],{"_3227":66966,"_28581":66865,"_19785":113024,"_5":13558,"_26003":112762,"_2720":23654},[],{"_3227":66967,"_28581":66865,"_19785":113026,"_5":13558,"_26003":112762,"_2720":112934},[],{"_3227":66968,"_28581":66865,"_19785":113028,"_5":13558,"_26003":112762,"_2720":113029},[],"URL HTTP del Device Manager de Lamassu.",{"_3227":66969,"_28581":66865,"_19785":113031,"_5":13558,"_26003":112762,"_2720":50552},[],{"_3227":66970,"_28581":66865,"_19785":113033,"_5":13558,"_26003":112762,"_2720":23654},[],{"_3227":66971,"_28581":66865,"_19785":113035,"_5":13558,"_26003":112762,"_2720":112934},[],{"_3227":66972,"_28581":66865,"_19785":113037,"_5":13558,"_26003":112762,"_2720":113038},[],"URL HTTP del servicio de CA de Lamassu.",{"_3227":66973,"_28581":66865,"_19785":113040,"_5":13558,"_26003":112766,"_2720":113041},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3227":66974,"_28581":66865,"_19785":113043,"_5":13558,"_26003":112770,"_2720":113044},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3227":66975,"_28581":66865,"_19785":113046,"_5":13558,"_26003":112770,"_2720":113047},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3227":66976,"_28581":66865,"_19785":113049,"_5":13558,"_26003":112774,"_2720":113050},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3227":66977,"_28581":66865,"_19785":113052,"_5":13558,"_26003":112774,"_2720":113053},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3227":66978,"_28581":66865,"_19785":113055,"_5":13558,"_26003":112774,"_2720":113056},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3227":66979,"_28581":66865,"_19785":113058,"_5":13558,"_26003":112774,"_2720":113059},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3227":66980,"_28581":66865,"_19785":113061,"_5":13558,"_26003":112774,"_2720":113062},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3227":66981,"_28581":66865,"_19785":113064,"_5":13558,"_26003":112774,"_2720":113065},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3227":66982,"_28581":66865,"_19785":113067,"_5":13558,"_26003":112777,"_2720":113068},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3227":66983,"_28581":66865,"_19785":113070,"_5":13558,"_26003":112780,"_2720":113071},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3227":66984,"_28581":66865,"_19785":113073,"_5":13558,"_26003":112780,"_2720":113074},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3227":66985,"_28581":66865,"_19785":113076,"_5":13558,"_26003":112784,"_2720":113077},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3227":66986,"_28581":66865,"_19785":113079,"_5":13558,"_26003":112788,"_2720":113080},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3227":66987,"_28581":66865,"_19785":113082,"_5":13558,"_26003":112788,"_2720":113083},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3227":66988,"_28581":66865,"_19785":113085,"_5":13558,"_26003":112788,"_2720":113086},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3227":66989,"_28581":66865,"_19785":113088,"_5":13558,"_26003":112788,"_2720":113089},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3227":66990,"_28581":66865,"_19785":113091,"_5":13558,"_26003":112788,"_2720":113092},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3227":66991,"_28581":66865,"_19785":113094,"_5":13558,"_26003":112788,"_2720":113095},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3227":66992,"_28581":66865,"_19785":113097,"_5":13558,"_26003":112792,"_2720":113098},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. La plantilla se crea cuando el DMS se crea en Lamassu, no en el enrolamiento del dispositivo, y no se actualiza después (ver el aviso siguiente). A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3227":66993,"_28581":66865,"_19785":113100,"_5":13558,"_26003":112792,"_2720":113101},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3227":66994,"_28581":66865,"_19785":113103,"_5":13558,"_26003":112792,"_2720":113104},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3227":66995,"_28581":66865,"_19785":113106,"_5":13558,"_26003":112792,"_2720":113107},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3227":66996,"_28581":66865,"_19785":113109,"_5":13558,"_26003":112792,"_2720":113110},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3227":66997,"_28581":66865,"_19785":113112,"_5":13558,"_26003":112796,"_2720":113113},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3227":66998,"_28581":66865,"_19785":113115,"_5":13558,"_26003":112796,"_2720":113116},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3227":66999,"_28581":66865,"_19785":113118,"_5":13558,"_26003":112796,"_2720":113119},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3227":67000,"_28581":66865,"_19785":113121,"_5":13558,"_26003":112800,"_2720":113122},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3227":67001,"_28581":66865,"_19785":113124,"_5":13558,"_26003":112800,"_2720":113125},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3227":67002,"_28581":66865,"_19785":113127,"_5":13558,"_26003":112800,"_2720":113128},[],"Para que el flujo JITP funcione correctamente:",{"_3227":67003,"_28581":66865,"_19785":113130,"_5":13558,"_26003":112800,"_2720":113131},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3227":67004,"_28581":66865,"_19785":113133,"_5":13558,"_26003":112800,"_2720":113134},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3227":67005,"_28581":66865,"_19785":113136,"_5":13558,"_26003":112800,"_2720":113137},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3227":67006,"_28581":66865,"_19785":113139,"_5":13558,"_26003":112800,"_2720":113140},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3227":67007,"_28581":66865,"_19785":113142,"_5":13558,"_26003":112804,"_2720":113143},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3227":67008,"_28581":66865,"_19785":113145,"_5":13558,"_26003":112804,"_2720":113146},[],"Estado en Lamassu",{"_3227":67009,"_28581":66865,"_19785":113148,"_5":13558,"_26003":112804,"_2720":113149},[],"Razón de revocación",{"_3227":67010,"_28581":66865,"_19785":113151,"_5":13558,"_26003":112804,"_2720":113152},[],"Estado en AWS IoT Core",{"_3227":67011,"_28581":66865,"_19785":113154,"_5":13558,"_26003":112804,"_2720":50679},[],{"_3227":67012,"_28581":66865,"_19785":113156,"_5":13558,"_26003":112804,"_2720":113157},[],"Ninguna",{"_3227":67013,"_28581":66865,"_19785":113159,"_5":13558,"_26003":112804,"_2720":50685},[],{"_3227":67014,"_28581":66865,"_19785":113161,"_5":13558,"_26003":112804,"_2720":50688},[],{"_3227":67015,"_28581":66865,"_19785":113163,"_5":13558,"_26003":112804,"_2720":50691},[],{"_3227":67016,"_28581":66865,"_19785":113165,"_5":13558,"_26003":112804,"_2720":50694},[],{"_3227":67017,"_28581":66865,"_19785":113167,"_5":13558,"_26003":112804,"_2720":50688},[],{"_3227":67018,"_28581":66865,"_19785":113169,"_5":13558,"_26003":112804,"_2720":113170},[],"Cualquier otra razón",{"_3227":67019,"_28581":66865,"_19785":113172,"_5":13558,"_26003":112804,"_2720":50702},[],{"_3227":67020,"_28581":66865,"_19785":113174,"_5":13558,"_26003":112804,"_2720":113175},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3227":67021,"_28581":66865,"_19785":113177,"_5":13558,"_26003":112808,"_2720":113178},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3227":67022,"_28581":66865,"_19785":113180,"_5":13558,"_26003":112808,"_2720":113181},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3227":67023,"_28581":66865,"_19785":113183,"_5":13558,"_26003":112808,"_2720":113184},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3227":67024,"_28581":66865,"_19785":113186,"_5":13558,"_26003":112812,"_2720":113187},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3227":67025,"_28581":66865,"_19785":113189,"_5":13558,"_26003":112812,"_2720":113190},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3227":67026,"_28581":66865,"_19785":113192,"_5":13558,"_26003":112816,"_2720":113193},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3227":67027,"_28581":66865,"_19785":113195,"_5":13558,"_26003":112816,"_2720":113196},[],"Existen dos tipos de acciones:",{"_3227":67028,"_28581":66865,"_19785":113198,"_5":13558,"_26003":112816,"_2720":113199},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3227":67029,"_28581":66865,"_19785":113201,"_5":13558,"_26003":112816,"_2720":113202},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3227":67030,"_28581":66865,"_19785":113204,"_5":13558,"_26003":112816,"_2720":113205},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3227":67031,"_28581":66865,"_19785":113207,"_5":13558,"_26003":112820,"_2720":113208},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3227":67032,"_28581":66865,"_19785":113210,"_5":13558,"_26003":112820,"_2720":113211},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3227":67033,"_28581":66865,"_19785":113213,"_5":13558,"_26003":112820,"_2720":113214},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3227":67034,"_28581":66865,"_19785":113216,"_5":13558,"_26003":112824,"_2720":113217},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3227":67035,"_28581":66865,"_19785":113219,"_5":13558,"_26003":112824,"_2720":113220},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3227":67036,"_28581":66865,"_19785":113222,"_5":13558,"_26003":112824,"_2720":113223},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3227":67037,"_28581":66865,"_19785":113225,"_5":13558,"_26003":112824,"_2720":113226},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3227":67038,"_28581":66865,"_19785":113228,"_5":13558,"_26003":112824,"_2720":113229},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3227":67039,"_28581":66865,"_19785":113231,"_5":13558,"_26003":112824,"_2720":113232},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3227":67040,"_28581":66865,"_19785":113234,"_5":13558,"_26003":112824,"_2720":113235},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3227":67041,"_28581":66865,"_19785":113237,"_5":13558,"_26003":112824,"_2720":113238},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3227":67042,"_28581":66865,"_19785":113240,"_5":13558,"_26003":112824,"_2720":113241},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3227":67043,"_28581":66865,"_19785":113243,"_5":13558,"_26003":112824,"_2720":113244},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3227":67044,"_28581":66865,"_19785":113246,"_5":13558,"_26003":112824,"_2720":113247},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3227":67045,"_28581":66865,"_19785":113249,"_5":13558,"_26003":112824,"_2720":113250},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3227":67046,"_28581":66865,"_19785":113252,"_5":13558,"_26003":112824,"_2720":113253},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3227":67047,"_28581":66865,"_19785":113255,"_5":13558,"_26003":112824,"_2720":113256},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3227":67048,"_28581":66865,"_19785":113258,"_5":13558,"_26003":112824,"_2720":113259},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3227":67049,"_28581":66865,"_19785":113261,"_5":13558,"_26003":112824,"_2720":113262},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3227":67050,"_28581":66865,"_19785":113264,"_5":13558,"_26003":112824,"_2720":113265},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3227":67051,"_28581":66865,"_19785":113267,"_5":13558,"_26003":112824,"_2720":113268},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3227":67052,"_28581":66865,"_19785":113270,"_5":13558,"_26003":112824,"_2720":113271},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3227":67053,"_28581":66865,"_19785":113273,"_5":13558,"_26003":112824,"_2720":113274},[],"**Causa:** La edición dispara un nuevo intento de crear la plantilla JITP, que ya existe en AWS. El intento falla y se omiten los pasos posteriores del conector.",{"_3227":67054,"_28581":66865,"_19785":113276,"_5":13558,"_26003":112824,"_2720":113277},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3227":67055,"_28581":66865,"_19785":113279,"_5":13558,"_26003":112824,"_2720":113280},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3227":67056,"_28581":66865,"_19785":113282,"_5":13558,"_26003":112824,"_2720":113283},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3227":67057,"_28581":66865,"_19785":113285,"_5":13558,"_26003":112824,"_2720":113286},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3227":67058,"_28581":67058,"_5":13916,"_2720":48776,"_28924":113288,"_19785":113289,"_26003":67058},[46319,110330,48776],[],{"_3227":67059,"_28581":67058,"_19785":113291,"_5":13558,"_26003":67058,"_2720":113292},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3227":67060,"_28581":67058,"_5":28921,"_19785":113294,"_26003":113295,"_2720":113296},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3227":67061,"_28581":67058,"_5":28921,"_19785":113298,"_26003":113299,"_2720":111336},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3227":67062,"_28581":67058,"_5":28921,"_19785":113301,"_26003":113302,"_2720":111511},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3227":67063,"_28581":67058,"_5":28921,"_19785":113304,"_26003":113305,"_2720":112743},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#integraciones",{"_3227":67064,"_28581":67058,"_5":28921,"_19785":113307,"_26003":113308,"_2720":113309},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3227":67065,"_28581":67058,"_19785":113311,"_5":13558,"_26003":67058,"_2720":113312},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3227":67066,"_28581":67058,"_19785":113314,"_5":13558,"_26003":113295,"_2720":113315},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3227":67067,"_28581":67058,"_19785":113317,"_5":13558,"_26003":113295,"_2720":113318},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3227":67068,"_28581":67058,"_19785":113320,"_5":13558,"_26003":113299,"_2720":113321},[],"Recurso",{"_3227":67069,"_28581":67058,"_19785":113323,"_5":13558,"_26003":113299,"_2720":113324},[],"Qué representa",{"_3227":67070,"_28581":67058,"_19785":113326,"_5":13558,"_26003":113299,"_2720":113327},[],"**Dispositivo**",{"_3227":67071,"_28581":67058,"_19785":113329,"_5":13558,"_26003":113299,"_2720":113330},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3227":67072,"_28581":67058,"_19785":113332,"_5":13558,"_26003":113299,"_2720":113333},[],"**Identidad**",{"_3227":67073,"_28581":67058,"_19785":113335,"_5":13558,"_26003":113299,"_2720":113336},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3227":67074,"_28581":67058,"_19785":113338,"_5":13558,"_26003":113299,"_2720":50869},[],{"_3227":67075,"_28581":67058,"_19785":113340,"_5":13558,"_26003":113299,"_2720":113341},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3227":67076,"_28581":67058,"_19785":113343,"_5":13558,"_26003":113299,"_2720":113344},[],"**Flota**",{"_3227":67077,"_28581":67058,"_19785":113346,"_5":13558,"_26003":113299,"_2720":113347},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3227":67078,"_28581":67058,"_19785":113349,"_5":13558,"_26003":113299,"_2720":113350},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3227":67079,"_28581":67058,"_19785":113352,"_5":13558,"_26003":113299,"_2720":113353},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3227":67080,"_28581":67058,"_19785":113355,"_5":13558,"_26003":113302,"_2720":113356},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3227":67081,"_28581":67058,"_19785":113358,"_5":13558,"_26003":113302,"_2720":113359},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3227":67082,"_28581":67058,"_19785":113361,"_5":13558,"_26003":113302,"_2720":113362},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3227":67083,"_28581":67058,"_19785":113364,"_5":13558,"_26003":113302,"_2720":113365},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3227":67084,"_28581":67058,"_19785":113367,"_5":13558,"_26003":113302,"_2720":113368},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3227":67085,"_28581":67058,"_19785":113370,"_5":13558,"_26003":113302,"_2720":113371},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3227":67086,"_28581":67058,"_19785":113373,"_5":13558,"_26003":113302,"_2720":113374},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3227":67087,"_28581":67058,"_19785":113376,"_5":13558,"_26003":113302,"_2720":113377},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3227":67088,"_28581":67058,"_19785":113379,"_5":13558,"_26003":113305,"_2720":113380},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3227":67089,"_28581":67058,"_19785":113382,"_5":13558,"_26003":113305,"_2720":113383},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3227":67090,"_28581":67058,"_19785":113385,"_5":13558,"_26003":113308,"_2720":113386},[],"Participante",{"_3227":67091,"_28581":67058,"_19785":113388,"_5":13558,"_26003":113308,"_2720":113389},[],"Responsabilidad",{"_3227":67092,"_28581":67058,"_19785":113391,"_5":13558,"_26003":113308,"_2720":113392},[],"Administrador PKI",{"_3227":67093,"_28581":67058,"_19785":113394,"_5":13558,"_26003":113308,"_2720":113395},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3227":67094,"_28581":67058,"_19785":113397,"_5":13558,"_26003":113308,"_2720":113398},[],"Administrador del aprovisionamiento",{"_3227":67095,"_28581":67058,"_19785":113400,"_5":13558,"_26003":113308,"_2720":113401},[],"DMS, admisión, autenticación por operación e inventario.",{"_3227":67096,"_28581":67058,"_19785":113403,"_5":13558,"_26003":113308,"_2720":113404},[],"Integrador del dispositivo",{"_3227":67097,"_28581":67058,"_19785":113406,"_5":13558,"_26003":113308,"_2720":113407},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3227":67098,"_28581":67058,"_19785":113409,"_5":13558,"_26003":113308,"_2720":113410},[],"Integrador del consumidor",{"_3227":67099,"_28581":67058,"_19785":113412,"_5":13558,"_26003":113308,"_2720":113413},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3227":67100,"_28581":67058,"_19785":113415,"_5":13558,"_26003":113308,"_2720":113416},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3227":67101,"_28581":67101,"_5":13916,"_2720":113418,"_28924":113419,"_19785":113421,"_26003":67101},"Enrola y conecta tu primer dispositivo",[46319,110330,48776,113420],"Primeros pasos",[],{"_3227":67102,"_28581":67101,"_19785":113423,"_5":13558,"_26003":67101,"_2720":113424},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3227":67103,"_28581":67101,"_5":28921,"_19785":113426,"_26003":113427,"_2720":108927},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3227":67104,"_28581":67101,"_5":28921,"_19785":113429,"_26003":113430,"_2720":113431},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3227":67105,"_28581":67101,"_5":28921,"_19785":113433,"_26003":113434,"_2720":113435},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3227":67106,"_28581":67101,"_5":28921,"_19785":113437,"_26003":113438,"_2720":113439},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3227":67107,"_28581":67101,"_5":28921,"_19785":113441,"_26003":113442,"_2720":113443},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3227":67108,"_28581":67101,"_5":28921,"_19785":113445,"_26003":113446,"_2720":113447},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3227":67109,"_28581":67101,"_5":28921,"_19785":113449,"_26003":113450,"_2720":113451},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3227":67110,"_28581":67101,"_5":28921,"_19785":113453,"_26003":113454,"_2720":113455},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3227":67111,"_28581":67101,"_19785":113457,"_5":13558,"_26003":67101,"_2720":113458},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3227":67112,"_28581":67101,"_19785":113460,"_5":13558,"_26003":113427,"_2720":113461},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3227":67113,"_28581":67101,"_19785":113463,"_5":13558,"_26003":113427,"_2720":113464},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3227":67114,"_28581":67101,"_19785":113466,"_5":13558,"_26003":113427,"_2720":113467},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3227":67115,"_28581":67101,"_19785":113469,"_5":13558,"_26003":113427,"_2720":113470},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3227":67116,"_28581":67101,"_19785":113472,"_5":13558,"_26003":113427,"_2720":113473},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3227":67117,"_28581":67101,"_19785":113475,"_5":13558,"_26003":113430,"_2720":113476},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3227":67118,"_28581":67101,"_19785":113478,"_5":13558,"_26003":113430,"_2720":113479},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3227":67119,"_28581":67101,"_19785":113481,"_5":13558,"_26003":113434,"_2720":113482},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3227":67120,"_28581":67101,"_19785":113484,"_5":13558,"_26003":113434,"_2720":113485},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3227":67121,"_28581":67101,"_19785":113487,"_5":13558,"_26003":113434,"_2720":113488},[],"Ajuste",{"_3227":67122,"_28581":67101,"_19785":113490,"_5":13558,"_26003":113434,"_2720":113491},[],"Valor de evaluación",{"_3227":67123,"_28581":67101,"_19785":113493,"_5":13558,"_26003":113434,"_2720":51025},[],{"_3227":67124,"_28581":67101,"_19785":113495,"_5":13558,"_26003":113434,"_2720":113496},[],"Raíz emisora de `device-root.pem`.",{"_3227":67125,"_28581":67101,"_19785":113498,"_5":13558,"_26003":113434,"_2720":111639},[],{"_3227":67126,"_28581":67101,"_19785":113500,"_5":13558,"_26003":113434,"_2720":113501},[],"Perfil final de 1 hora que acabas de preparar.",{"_3227":67127,"_28581":67101,"_19785":113503,"_5":13558,"_26003":113434,"_2720":51036},[],{"_3227":67128,"_28581":67101,"_19785":113505,"_5":13558,"_26003":113434,"_2720":51039},[],{"_3227":67129,"_28581":67101,"_19785":113507,"_5":13558,"_26003":113434,"_2720":51042},[],{"_3227":67130,"_28581":67101,"_19785":113509,"_5":13558,"_26003":113434,"_2720":113510},[],"Habilitado.",{"_3227":67131,"_28581":67101,"_19785":113512,"_5":13558,"_26003":113434,"_2720":51048},[],{"_3227":67132,"_28581":67101,"_19785":113514,"_5":13558,"_26003":113434,"_2720":113515},[],"Deshabilitado; el ID debe ser nuevo.",{"_3227":67133,"_28581":67101,"_19785":113517,"_5":13558,"_26003":113434,"_2720":113518},[],"Autenticación inicial",{"_3227":67134,"_28581":67101,"_19785":113520,"_5":13558,"_26003":113434,"_2720":113521},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3227":67135,"_28581":67101,"_19785":113523,"_5":13558,"_26003":113434,"_2720":113524},[],"Autenticación de renovación",{"_3227":67136,"_28581":67101,"_19785":113526,"_5":13558,"_26003":113434,"_2720":113527},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3227":67137,"_28581":67101,"_19785":113529,"_5":13558,"_26003":113434,"_2720":51066},[],{"_3227":67138,"_28581":67101,"_19785":113531,"_5":13558,"_26003":113434,"_2720":113532},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3227":67139,"_28581":67101,"_19785":113534,"_5":13558,"_26003":113434,"_2720":51072},[],{"_3227":67140,"_28581":67101,"_19785":113536,"_5":13558,"_26003":113434,"_2720":113537},[],"1 hora.",{"_3227":67141,"_28581":67101,"_19785":113539,"_5":13558,"_26003":113434,"_2720":51078},[],{"_3227":67142,"_28581":67101,"_19785":113541,"_5":13558,"_26003":113434,"_2720":113542},[],"30 minutos / 10 minutos.",{"_3227":67143,"_28581":67101,"_19785":113544,"_5":13558,"_26003":113434,"_2720":51084},[],{"_3227":67144,"_28581":67101,"_19785":113546,"_5":13558,"_26003":113434,"_2720":113547},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3227":67145,"_28581":67101,"_19785":113549,"_5":13558,"_26003":113434,"_2720":49095},[],{"_3227":67146,"_28581":67101,"_19785":113551,"_5":13558,"_26003":113434,"_2720":113552},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3227":67147,"_28581":67101,"_19785":113554,"_5":13558,"_26003":113434,"_2720":51095},[],{"_3227":67148,"_28581":67101,"_19785":113556,"_5":13558,"_26003":113434,"_2720":113557},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3227":67149,"_28581":67101,"_19785":113559,"_5":13558,"_26003":113434,"_2720":113560},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3227":67150,"_28581":67101,"_19785":113562,"_5":13558,"_26003":113438,"_2720":113563},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3227":67151,"_28581":67101,"_19785":113565,"_5":13558,"_26003":113438,"_2720":113566},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3227":67152,"_28581":67101,"_19785":113568,"_5":13558,"_26003":113442,"_2720":113569},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3227":67153,"_28581":67101,"_19785":113571,"_5":13558,"_26003":113442,"_2720":113572},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3227":67154,"_28581":67101,"_19785":113574,"_5":13558,"_26003":113442,"_2720":113575},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3227":67155,"_28581":67101,"_19785":113577,"_5":13558,"_26003":113446,"_2720":113578},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3227":67156,"_28581":67101,"_19785":113580,"_5":13558,"_26003":113446,"_2720":113581},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3227":67157,"_28581":67101,"_19785":113583,"_5":13558,"_26003":113450,"_2720":113584},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3227":67158,"_28581":67101,"_19785":113586,"_5":13558,"_26003":113450,"_2720":113587},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3227":67159,"_28581":67101,"_19785":113589,"_5":13558,"_26003":113450,"_2720":113590},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3227":67160,"_28581":67101,"_19785":113592,"_5":13558,"_26003":113450,"_2720":113593},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3227":67161,"_28581":67101,"_19785":113595,"_5":13558,"_26003":113450,"_2720":113596},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3227":67162,"_28581":67101,"_19785":113598,"_5":13558,"_26003":113454,"_2720":113599},[],"Comprobación",{"_3227":67163,"_28581":67101,"_19785":113601,"_5":13558,"_26003":113454,"_2720":113602},[],"Resultado esperado",{"_3227":67164,"_28581":67101,"_19785":113604,"_5":13558,"_26003":113454,"_2720":113605},[],"Registro",{"_3227":67165,"_28581":67101,"_19785":113607,"_5":13558,"_26003":113454,"_2720":113608},[],"ID creado automáticamente y DMS correcto.",{"_3227":67166,"_28581":67101,"_19785":113610,"_5":13558,"_26003":113454,"_2720":113611},[],"Certificado",{"_3227":67167,"_28581":67101,"_19785":113613,"_5":13558,"_26003":113454,"_2720":113614},[],"CN, perfil, serie y clave verificados.",{"_3227":67168,"_28581":67101,"_19785":113616,"_5":13558,"_26003":113454,"_2720":113617},[],"Inventario",{"_3227":67169,"_28581":67101,"_19785":113619,"_5":13558,"_26003":113454,"_2720":113620},[],"Serie recibida visible como identidad actual y en el historial.",{"_3227":67170,"_28581":67101,"_19785":113622,"_5":13558,"_26003":113454,"_2720":113623},[],"Consumidor",{"_3227":67171,"_28581":67101,"_19785":113625,"_5":13558,"_26003":113454,"_2720":113626},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3227":67172,"_28581":67101,"_19785":113628,"_5":13558,"_26003":113454,"_2720":113629},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3227":67173,"_28581":67101,"_19785":113631,"_5":13558,"_26003":113454,"_2720":113632},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3227":67174,"_28581":67174,"_5":13916,"_2720":111353,"_28924":113634,"_19785":113635,"_26003":67174},[46319,110330,48776,113420],[],{"_3227":67175,"_28581":67174,"_19785":113637,"_5":13558,"_26003":67174,"_2720":113638},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3227":67176,"_28581":67174,"_5":28921,"_19785":113640,"_26003":113641,"_2720":108927},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3227":67177,"_28581":67174,"_5":28921,"_19785":113643,"_26003":113644,"_2720":113645},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3227":67178,"_28581":67174,"_5":28921,"_19785":113647,"_26003":113648,"_2720":113649},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3227":67179,"_28581":67174,"_5":28921,"_19785":113651,"_26003":113652,"_2720":113653},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3227":67180,"_28581":67174,"_5":28921,"_19785":113655,"_26003":113656,"_2720":113657},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3227":67181,"_28581":67174,"_5":28921,"_19785":113659,"_26003":113660,"_2720":113661},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3227":67182,"_28581":67174,"_5":28921,"_19785":113663,"_26003":113664,"_2720":113602},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3227":67183,"_28581":67174,"_5":28921,"_19785":113666,"_26003":113667,"_2720":113668},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3227":67184,"_28581":67174,"_5":28921,"_19785":113670,"_26003":113671,"_2720":113672},[],"/docs/pr-preview/pr-42/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3227":67185,"_28581":67174,"_19785":113674,"_5":13558,"_26003":67174,"_2720":113675},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3227":67186,"_28581":67174,"_19785":113677,"_5":13558,"_26003":67174,"_2720":113678},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3227":67187,"_28581":67174,"_19785":113680,"_5":13558,"_26003":113641,"_2720":113681},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3227":67188,"_28581":67174,"_19785":113683,"_5":13558,"_26003":113641,"_2720":113684},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3227":67189,"_28581":67174,"_19785":113686,"_5":13558,"_26003":113641,"_2720":113687},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3227":67190,"_28581":67174,"_19785":113689,"_5":13558,"_26003":113641,"_2720":113690},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3227":67191,"_28581":67174,"_19785":113692,"_5":13558,"_26003":113644,"_2720":113693},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3227":67192,"_28581":67174,"_19785":113695,"_5":13558,"_26003":113644,"_2720":113696},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3227":67193,"_28581":67174,"_19785":113698,"_5":13558,"_26003":113644,"_2720":113699},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3227":67194,"_28581":67174,"_19785":113701,"_5":13558,"_26003":113644,"_2720":113702},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3227":67195,"_28581":67174,"_19785":113704,"_5":13558,"_26003":113644,"_2720":113705},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3227":67196,"_28581":67174,"_19785":113707,"_5":13558,"_26003":113644,"_2720":113708},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3227":67197,"_28581":67174,"_19785":113710,"_5":13558,"_26003":113644,"_2720":113711},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3227":67198,"_28581":67174,"_19785":113713,"_5":13558,"_26003":113644,"_2720":113714},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3227":67199,"_28581":67174,"_19785":113716,"_5":13558,"_26003":113648,"_2720":113717},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3227":67200,"_28581":67174,"_19785":113719,"_5":13558,"_26003":113648,"_2720":51261},[],{"_3227":67201,"_28581":67174,"_19785":113721,"_5":13558,"_26003":113648,"_2720":113722},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3227":67202,"_28581":67174,"_19785":113724,"_5":13558,"_26003":113648,"_2720":113725},[],"**Icon** y **Tags**: clasificación opcional.",{"_3227":67203,"_28581":67174,"_19785":113727,"_5":13558,"_26003":113648,"_2720":113728},[],"Confirma el registro.",{"_3227":67204,"_28581":67174,"_19785":113730,"_5":13558,"_26003":113652,"_2720":113731},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3227":67205,"_28581":67174,"_19785":113733,"_5":13558,"_26003":113652,"_2720":113734},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3227":67206,"_28581":67174,"_19785":113736,"_5":13558,"_26003":113656,"_2720":113737},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3227":67207,"_28581":67174,"_19785":113739,"_5":13558,"_26003":113656,"_2720":113740},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3227":67208,"_28581":67174,"_19785":113742,"_5":13558,"_26003":113660,"_2720":113743},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3227":67209,"_28581":67174,"_19785":113745,"_5":13558,"_26003":113660,"_2720":113746},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3227":67210,"_28581":67174,"_19785":113748,"_5":13558,"_26003":113664,"_2720":113599},[],{"_3227":67211,"_28581":67174,"_19785":113750,"_5":13558,"_26003":113664,"_2720":113751},[],"Resultado",{"_3227":67212,"_28581":67174,"_19785":113753,"_5":13558,"_26003":113664,"_2720":113754},[],"Dispositivo",{"_3227":67213,"_28581":67174,"_19785":113756,"_5":13558,"_26003":113664,"_2720":113757},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3227":67214,"_28581":67174,"_19785":113759,"_5":13558,"_26003":113664,"_2720":113760},[],"Identidad actual",{"_3227":67215,"_28581":67174,"_19785":113762,"_5":13558,"_26003":113664,"_2720":113763},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3227":67216,"_28581":67174,"_19785":113765,"_5":13558,"_26003":113664,"_2720":113766},[],"Historial",{"_3227":67217,"_28581":67174,"_19785":113768,"_5":13558,"_26003":113664,"_2720":113769},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3227":67218,"_28581":67174,"_19785":113771,"_5":13558,"_26003":113664,"_2720":113772},[],"Clave y certificado",{"_3227":67219,"_28581":67174,"_19785":113774,"_5":13558,"_26003":113664,"_2720":113775},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3227":67220,"_28581":67174,"_19785":113777,"_5":13558,"_26003":113667,"_2720":113778},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3227":67221,"_28581":67174,"_19785":113780,"_5":13558,"_26003":113667,"_2720":113781},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3227":67222,"_28581":67174,"_19785":113783,"_5":13558,"_26003":113667,"_2720":113784},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3227":67223,"_28581":67174,"_19785":113786,"_5":13558,"_26003":113667,"_2720":113787},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3227":67224,"_28581":67174,"_19785":113789,"_5":13558,"_26003":113671,"_2720":113790},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3227":67225,"_28581":67174,"_19785":113792,"_5":13558,"_26003":113671,"_2720":113793},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3227":67226,"_28581":67174,"_19785":113795,"_5":13558,"_26003":113671,"_2720":113796},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3227":67227,"_28581":67227,"_5":13916,"_2720":113798,"_28924":113799,"_19785":113800,"_26003":67227},"Plataforma Lamassu IoT",[46319,110330],[],{"_3227":67228,"_28581":67227,"_19785":113802,"_5":13558,"_26003":67227,"_2720":113803},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3227":67229,"_28581":67227,"_5":28921,"_19785":113805,"_26003":113806,"_2720":113296},[],"/docs/pr-preview/pr-42/es/platform/overview#empieza-aquí",{"_3227":67230,"_28581":67227,"_5":28921,"_19785":113808,"_26003":113809,"_2720":113810},[],"/docs/pr-preview/pr-42/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3227":67231,"_28581":67227,"_5":28921,"_19785":113812,"_26003":113813,"_2720":113814},[],"/docs/pr-preview/pr-42/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3227":67232,"_28581":67227,"_5":28921,"_19785":113816,"_26003":113817,"_2720":113818},[],"/docs/pr-preview/pr-42/es/platform/overview#capacidades-principales","Capacidades principales",{"_3227":67233,"_28581":67227,"_5":28921,"_19785":113820,"_26003":113821,"_2720":113822},[],"/docs/pr-preview/pr-42/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3227":67234,"_28581":67227,"_5":28921,"_19785":113824,"_26003":113825,"_2720":113826},[],"/docs/pr-preview/pr-42/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3227":67235,"_28581":67227,"_5":28921,"_19785":113828,"_26003":113829,"_2720":113830},[],"/docs/pr-preview/pr-42/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3227":67236,"_28581":67227,"_5":28921,"_19785":113832,"_26003":113833,"_2720":113834},[],"/docs/pr-preview/pr-42/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3227":67237,"_28581":67227,"_5":28921,"_19785":113836,"_26003":113837,"_2720":113838},[],"/docs/pr-preview/pr-42/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3227":67238,"_28581":67227,"_5":28921,"_19785":113840,"_26003":113841,"_2720":113842},[],"/docs/pr-preview/pr-42/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3227":67239,"_28581":67227,"_5":28921,"_19785":113844,"_26003":113845,"_2720":113846},[],"/docs/pr-preview/pr-42/es/platform/overview#referencia-operativa","Referencia operativa",{"_3227":67240,"_28581":67227,"_19785":113848,"_5":13558,"_26003":67227,"_2720":113849},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3227":67241,"_28581":67227,"_19785":113851,"_5":13558,"_26003":113806,"_2720":113852},[],"Elige el resultado que necesitas obtener:",{"_3227":67242,"_28581":67227,"_19785":113854,"_5":13558,"_26003":113806,"_2720":113855},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3227":67243,"_28581":67227,"_19785":113857,"_5":13558,"_26003":113806,"_2720":113858},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3227":67244,"_28581":67227,"_19785":113860,"_5":13558,"_26003":113806,"_2720":113861},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3227":67245,"_28581":67227,"_19785":113863,"_5":13558,"_26003":113809,"_2720":113864},[],"Bloque",{"_3227":67246,"_28581":67227,"_19785":113866,"_5":13558,"_26003":113809,"_2720":113867},[],"Qué gestionas",{"_3227":67247,"_28581":67227,"_19785":113869,"_5":13558,"_26003":113809,"_2720":113870},[],"Punto de entrada",{"_3227":67248,"_28581":67227,"_19785":113872,"_5":13558,"_26003":113809,"_2720":51415},[],{"_3227":67249,"_28581":67227,"_19785":113874,"_5":13558,"_26003":113809,"_2720":113875},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3227":67250,"_28581":67227,"_19785":113877,"_5":13558,"_26003":113809,"_2720":113878},[],"Visión general de PKI",{"_3227":67251,"_28581":67227,"_19785":113880,"_5":13558,"_26003":113809,"_2720":51424},[],{"_3227":67252,"_28581":67227,"_19785":113882,"_5":13558,"_26003":113809,"_2720":113883},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3227":67253,"_28581":67227,"_19785":113885,"_5":13558,"_26003":113809,"_2720":113886},[],"Visión general de IoT Fleets",{"_3227":67254,"_28581":67227,"_19785":113888,"_5":13558,"_26003":113809,"_2720":113889},[],"**Administración**",{"_3227":67255,"_28581":67227,"_19785":113891,"_5":13558,"_26003":113809,"_2720":113892},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3227":67256,"_28581":67227,"_19785":113894,"_5":13558,"_26003":113809,"_2720":110328},[],{"_3227":67257,"_28581":67227,"_19785":113896,"_5":13558,"_26003":113809,"_2720":113897},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3227":67258,"_28581":67227,"_19785":113899,"_5":13558,"_26003":113813,"_2720":113900},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3227":67259,"_28581":67227,"_19785":113902,"_5":13558,"_26003":113813,"_2720":113903},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3227":67260,"_28581":67227,"_19785":113905,"_5":13558,"_26003":113813,"_2720":113906},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3227":67261,"_28581":67227,"_19785":113908,"_5":13558,"_26003":113813,"_2720":113909},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3227":67262,"_28581":67227,"_19785":113911,"_5":13558,"_26003":113813,"_2720":113912},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3227":67263,"_28581":67227,"_19785":113914,"_5":13558,"_26003":113813,"_2720":113915},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3227":67264,"_28581":67227,"_19785":113917,"_5":13558,"_26003":113821,"_2720":113918},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3227":67265,"_28581":67227,"_19785":113920,"_5":13558,"_26003":113825,"_2720":113921},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3227":67266,"_28581":67227,"_19785":113923,"_5":13558,"_26003":113829,"_2720":113924},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3227":67267,"_28581":67227,"_19785":113926,"_5":13558,"_26003":113833,"_2720":113927},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3227":67268,"_28581":67227,"_19785":113929,"_5":13558,"_26003":113837,"_2720":113930},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3227":67269,"_28581":67227,"_19785":113932,"_5":13558,"_26003":113841,"_2720":113933},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3227":67270,"_28581":67227,"_19785":113935,"_5":13558,"_26003":113845,"_2720":113389},[],{"_3227":67271,"_28581":67227,"_19785":113937,"_5":13558,"_26003":113845,"_2720":113938},[],"Qué prepara o comprueba",{"_3227":67272,"_28581":67227,"_19785":113940,"_5":13558,"_26003":113845,"_2720":113392},[],{"_3227":67273,"_28581":67227,"_19785":113942,"_5":13558,"_26003":113845,"_2720":113943},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3227":67274,"_28581":67227,"_19785":113945,"_5":13558,"_26003":113845,"_2720":113946},[],"Administrador de la flota",{"_3227":67275,"_28581":67227,"_19785":113948,"_5":13558,"_26003":113845,"_2720":113949},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3227":67276,"_28581":67227,"_19785":113951,"_5":13558,"_26003":113845,"_2720":113404},[],{"_3227":67277,"_28581":67227,"_19785":113953,"_5":13558,"_26003":113845,"_2720":113954},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3227":67278,"_28581":67227,"_19785":113956,"_5":13558,"_26003":113845,"_2720":113410},[],{"_3227":67279,"_28581":67227,"_19785":113958,"_5":13558,"_26003":113845,"_2720":113959},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3227":67280,"_28581":67227,"_19785":113961,"_5":13558,"_26003":113845,"_2720":113962},[],"Operador de infraestructura",{"_3227":67281,"_28581":67227,"_19785":113964,"_5":13558,"_26003":113845,"_2720":113965},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3227":67282,"_28581":67227,"_19785":113967,"_5":13558,"_26003":113845,"_2720":113968},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3227":67283,"_28581":67283,"_5":13916,"_2720":113970,"_28924":113971,"_19785":113973,"_26003":67283},"Jerarquía y rotación de CAs",[46319,110330,51516,113972],"Claves, autoridades y certificados",[],{"_3227":67284,"_28581":67283,"_19785":113975,"_5":13558,"_26003":67283,"_2720":113976},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3227":67285,"_28581":67283,"_5":28921,"_19785":113978,"_26003":113979,"_2720":113980},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3227":67286,"_28581":67283,"_5":28921,"_19785":113982,"_26003":113983,"_2720":113984},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3227":67287,"_28581":67283,"_5":28921,"_19785":113986,"_26003":113987,"_2720":113988},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3227":67288,"_28581":67283,"_5":28921,"_19785":113990,"_26003":113991,"_2720":113992},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3227":67289,"_28581":67283,"_5":28921,"_19785":113994,"_26003":113995,"_2720":113996},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3227":67290,"_28581":67283,"_5":28921,"_19785":113998,"_26003":113999,"_2720":114000},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3227":67291,"_28581":67283,"_5":28921,"_19785":114002,"_26003":114003,"_2720":114004},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3227":67292,"_28581":67283,"_5":28921,"_19785":114006,"_26003":114007,"_2720":114008},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3227":67293,"_28581":67283,"_5":28921,"_19785":114010,"_26003":114011,"_2720":114012},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3227":67294,"_28581":67283,"_5":28921,"_19785":114014,"_26003":114015,"_2720":114016},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3227":67295,"_28581":67283,"_5":28921,"_19785":114018,"_26003":114019,"_2720":114020},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3227":67296,"_28581":67283,"_5":28921,"_19785":114022,"_26003":114023,"_2720":114024},[],"/docs/pr-preview/pr-42/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3227":67297,"_28581":67283,"_19785":114026,"_5":13558,"_26003":67283,"_2720":114027},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3227":67298,"_28581":67283,"_19785":114029,"_5":13558,"_26003":67283,"_2720":114030},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3227":67299,"_28581":67283,"_19785":114032,"_5":13558,"_26003":113979,"_2720":114033},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3227":67300,"_28581":67283,"_19785":114035,"_5":13558,"_26003":113979,"_2720":114036},[],"entorno, como producción y preproducción;",{"_3227":67301,"_28581":67283,"_19785":114038,"_5":13558,"_26003":113979,"_2720":114039},[],"propietario o equipo operador;",{"_3227":67302,"_28581":67283,"_19785":114041,"_5":13558,"_26003":113979,"_2720":114042},[],"familia de dispositivos o proceso de fabricación;",{"_3227":67303,"_28581":67283,"_19785":114044,"_5":13558,"_26003":113979,"_2720":114045},[],"región o requisito regulatorio;",{"_3227":67304,"_28581":67283,"_19785":114047,"_5":13558,"_26003":113979,"_2720":114048},[],"motor criptográfico o política de clave;",{"_3227":67305,"_28581":67283,"_19785":114050,"_5":13558,"_26003":113979,"_2720":114051},[],"ventana de mantenimiento y ritmo de renovación.",{"_3227":67306,"_28581":67283,"_19785":114053,"_5":13558,"_26003":113979,"_2720":114054},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3227":67307,"_28581":67283,"_19785":114056,"_5":13558,"_26003":113979,"_2720":114057},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3227":67308,"_28581":67283,"_19785":114059,"_5":13558,"_26003":113983,"_2720":114060},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3227":67309,"_28581":67283,"_19785":114062,"_5":13558,"_26003":113983,"_2720":114063},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3227":67310,"_28581":67283,"_19785":114065,"_5":13558,"_26003":113983,"_2720":114066},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3227":67311,"_28581":67283,"_19785":114068,"_5":13558,"_26003":113987,"_2720":114069},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3227":67312,"_28581":67283,"_19785":114071,"_5":13558,"_26003":113987,"_2720":114072},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3227":67313,"_28581":67283,"_19785":114074,"_5":13558,"_26003":113987,"_2720":114075},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3227":67314,"_28581":67283,"_19785":114077,"_5":13558,"_26003":113987,"_2720":114078},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3227":67315,"_28581":67283,"_19785":114080,"_5":13558,"_26003":113995,"_2720":114081},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3227":67316,"_28581":67283,"_19785":114083,"_5":13558,"_26003":113999,"_2720":114084},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3227":67317,"_28581":67283,"_19785":114086,"_5":13558,"_26003":114003,"_2720":114087},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3227":67318,"_28581":67283,"_19785":114089,"_5":13558,"_26003":114007,"_2720":114090},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3227":67319,"_28581":67283,"_19785":114092,"_5":13558,"_26003":114011,"_2720":114093},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3227":67320,"_28581":67283,"_19785":114095,"_5":13558,"_26003":114015,"_2720":114096},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3227":67321,"_28581":67283,"_19785":114098,"_5":13558,"_26003":114019,"_2720":114099},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3227":67322,"_28581":67283,"_19785":114101,"_5":13558,"_26003":114019,"_2720":114102},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3227":67323,"_28581":67283,"_19785":114104,"_5":13558,"_26003":114019,"_2720":114105},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3227":67324,"_28581":67283,"_19785":114107,"_5":13558,"_26003":114019,"_2720":114108},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3227":67325,"_28581":67283,"_19785":114110,"_5":13558,"_26003":114023,"_2720":114111},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3227":67326,"_28581":67283,"_19785":114113,"_5":13558,"_26003":114023,"_2720":114114},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3227":67327,"_28581":67283,"_19785":114116,"_5":13558,"_26003":114023,"_2720":114117},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3227":67328,"_28581":67283,"_19785":114119,"_5":13558,"_26003":114023,"_2720":114120},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3227":67329,"_28581":67283,"_19785":114122,"_5":13558,"_26003":114023,"_2720":114123},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3227":67330,"_28581":67283,"_19785":114125,"_5":13558,"_26003":114023,"_2720":114126},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3227":67331,"_28581":67283,"_19785":114128,"_5":13558,"_26003":114023,"_2720":114129},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3227":67332,"_28581":67332,"_5":13916,"_2720":114131,"_28924":114132,"_19785":114133,"_26003":67332},"Autoridades de certificación",[46319,110330,51516,113972],[],{"_3227":67333,"_28581":67332,"_19785":114135,"_5":13558,"_26003":67332,"_2720":114136},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3227":67334,"_28581":67332,"_5":28921,"_19785":114138,"_26003":114139,"_2720":114140},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3227":67335,"_28581":67332,"_5":28921,"_19785":114142,"_26003":114143,"_2720":114144},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3227":67336,"_28581":67332,"_5":28921,"_19785":114146,"_26003":114147,"_2720":108927},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3227":67337,"_28581":67332,"_5":28921,"_19785":114149,"_26003":114150,"_2720":114151},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3227":67338,"_28581":67332,"_5":28921,"_19785":114153,"_26003":114154,"_2720":114155},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3227":67339,"_28581":67332,"_5":28921,"_19785":114157,"_26003":114158,"_2720":114159},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3227":67340,"_28581":67332,"_5":28921,"_19785":114161,"_26003":114162,"_2720":114163},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3227":67341,"_28581":67332,"_5":28921,"_19785":114165,"_26003":114166,"_2720":114167},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3227":67342,"_28581":67332,"_5":28921,"_19785":114169,"_26003":114170,"_2720":114171},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3227":67343,"_28581":67332,"_5":28921,"_19785":114173,"_26003":114174,"_2720":114175},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3227":67344,"_28581":67332,"_5":28921,"_19785":114177,"_26003":114178,"_2720":114179},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3227":67345,"_28581":67332,"_5":28921,"_19785":114181,"_26003":114182,"_2720":114183},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3227":67346,"_28581":67332,"_5":28921,"_19785":114185,"_26003":114186,"_2720":114187},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3227":67347,"_28581":67332,"_5":28921,"_19785":114189,"_26003":114190,"_2720":114191},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3227":67348,"_28581":67332,"_5":28921,"_19785":114193,"_26003":114194,"_2720":114195},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3227":67349,"_28581":67332,"_5":28921,"_19785":114197,"_26003":114198,"_2720":114199},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3227":67350,"_28581":67332,"_5":28921,"_19785":114201,"_26003":114202,"_2720":114203},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3227":67351,"_28581":67332,"_5":28921,"_19785":114205,"_26003":114206,"_2720":114207},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3227":67352,"_28581":67332,"_5":28921,"_19785":114209,"_26003":114210,"_2720":114211},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3227":67353,"_28581":67332,"_5":28921,"_19785":114213,"_26003":114214,"_2720":114215},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3227":67354,"_28581":67332,"_5":28921,"_19785":114217,"_26003":114218,"_2720":114219},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3227":67355,"_28581":67332,"_5":28921,"_19785":114221,"_26003":114222,"_2720":114223},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3227":67356,"_28581":67332,"_5":28921,"_19785":114225,"_26003":114226,"_2720":114227},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3227":67357,"_28581":67332,"_19785":114229,"_5":13558,"_26003":67332,"_2720":114230},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3227":67358,"_28581":67332,"_19785":114232,"_5":13558,"_26003":67332,"_2720":114233},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3227":67359,"_28581":67332,"_19785":114235,"_5":13558,"_26003":67332,"_2720":114236},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3227":67360,"_28581":67332,"_19785":114238,"_5":13558,"_26003":114139,"_2720":114239},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3227":67361,"_28581":67332,"_19785":114241,"_5":13558,"_26003":114139,"_2720":114242},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3227":67362,"_28581":67332,"_19785":114244,"_5":13558,"_26003":114139,"_2720":114245},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3227":67363,"_28581":67332,"_19785":114247,"_5":13558,"_26003":114139,"_2720":114248},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3227":67364,"_28581":67332,"_19785":114250,"_5":13558,"_26003":114139,"_2720":114251},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3227":67365,"_28581":67332,"_19785":114253,"_5":13558,"_26003":114147,"_2720":114254},[],"Decide si la CA será raíz o intermedia.",{"_3227":67366,"_28581":67332,"_19785":114256,"_5":13558,"_26003":114147,"_2720":114257},[],"Elige el motor que custodiará la clave.",{"_3227":67367,"_28581":67332,"_19785":114259,"_5":13558,"_26003":114147,"_2720":114260},[],"Define una validez superior a la de los certificados que emitirá.",{"_3227":67368,"_28581":67332,"_19785":114262,"_5":13558,"_26003":114147,"_2720":114263},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3227":67369,"_28581":67332,"_19785":114265,"_5":13558,"_26003":114150,"_2720":114266},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3227":67370,"_28581":67332,"_19785":114268,"_5":13558,"_26003":114154,"_2720":114269},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3227":67371,"_28581":67332,"_19785":114271,"_5":13558,"_26003":114154,"_2720":114272},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3227":67372,"_28581":67332,"_19785":114274,"_5":13558,"_26003":114158,"_2720":114275},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3227":67373,"_28581":67332,"_19785":114277,"_5":13558,"_26003":114162,"_2720":114278},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3227":67374,"_28581":67332,"_19785":114280,"_5":13558,"_26003":114162,"_2720":114281},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3227":67375,"_28581":67332,"_19785":114283,"_5":13558,"_26003":114162,"_2720":114284},[],"`ST`: estado o provincia.",{"_3227":67376,"_28581":67332,"_19785":114286,"_5":13558,"_26003":114162,"_2720":114287},[],"`L`: localidad.",{"_3227":67377,"_28581":67332,"_19785":114289,"_5":13558,"_26003":114162,"_2720":114290},[],"`O`: organización.",{"_3227":67378,"_28581":67332,"_19785":114292,"_5":13558,"_26003":114162,"_2720":114293},[],"`OU`: unidad organizativa.",{"_3227":67379,"_28581":67332,"_19785":114295,"_5":13558,"_26003":114162,"_2720":114296},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3227":67380,"_28581":67332,"_19785":114298,"_5":13558,"_26003":114166,"_2720":114299},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3227":67381,"_28581":67332,"_19785":114301,"_5":13558,"_26003":114166,"_2720":114302},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3227":67382,"_28581":67332,"_19785":114304,"_5":13558,"_26003":114170,"_2720":114305},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3227":67383,"_28581":67332,"_19785":114307,"_5":13558,"_26003":114170,"_2720":114308},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3227":67384,"_28581":67332,"_19785":114310,"_5":13558,"_26003":114174,"_2720":114311},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3227":67385,"_28581":67332,"_19785":114313,"_5":13558,"_26003":114174,"_2720":114314},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3227":67386,"_28581":67332,"_19785":114316,"_5":13558,"_26003":114178,"_2720":114317},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3227":67387,"_28581":67332,"_19785":114319,"_5":13558,"_26003":114182,"_2720":114320},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3227":67388,"_28581":67332,"_19785":114322,"_5":13558,"_26003":114186,"_2720":114323},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3227":67389,"_28581":67332,"_19785":114325,"_5":13558,"_26003":114190,"_2720":114326},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3227":67390,"_28581":67332,"_19785":114328,"_5":13558,"_26003":114194,"_2720":114329},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3227":67391,"_28581":67332,"_19785":114331,"_5":13558,"_26003":114194,"_2720":114332},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3227":67392,"_28581":67332,"_19785":114334,"_5":13558,"_26003":114198,"_2720":114335},[],"Abre una CA desde el inventario para consultar:",{"_3227":67393,"_28581":67332,"_19785":114337,"_5":13558,"_26003":114198,"_2720":114338},[],"Estado y periodo de validez.",{"_3227":67394,"_28581":67332,"_19785":114340,"_5":13558,"_26003":114198,"_2720":114341},[],"Certificado y cadena en formato PEM.",{"_3227":67395,"_28581":67332,"_19785":114343,"_5":13558,"_26003":114198,"_2720":114344},[],"Número de certificados activos, expirados y revocados.",{"_3227":67396,"_28581":67332,"_19785":114346,"_5":13558,"_26003":114198,"_2720":114347},[],"Certificados emitidos en **Issued Certificates**.",{"_3227":67397,"_28581":67332,"_19785":114349,"_5":13558,"_26003":114198,"_2720":114350},[],"CRL vinculada a la autoridad.",{"_3227":67398,"_28581":67332,"_19785":114352,"_5":13558,"_26003":114198,"_2720":114353},[],"Metadatos y motor criptográfico asociado.",{"_3227":67399,"_28581":67332,"_19785":114355,"_5":13558,"_26003":114198,"_2720":114356},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3227":67400,"_28581":67332,"_19785":114358,"_5":13558,"_26003":114202,"_2720":114359},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3227":67401,"_28581":67332,"_19785":114361,"_5":13558,"_26003":114202,"_2720":114362},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3227":67402,"_28581":67332,"_19785":114364,"_5":13558,"_26003":114202,"_2720":114365},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3227":67403,"_28581":67332,"_19785":114367,"_5":13558,"_26003":114202,"_2720":114368},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3227":67404,"_28581":67332,"_19785":114370,"_5":13558,"_26003":114206,"_2720":114371},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3227":67405,"_28581":67332,"_19785":114373,"_5":13558,"_26003":114210,"_2720":114374},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3227":67406,"_28581":67332,"_19785":114376,"_5":13558,"_26003":114214,"_2720":114377},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3227":67407,"_28581":67332,"_19785":114379,"_5":13558,"_26003":114218,"_2720":114380},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3227":67408,"_28581":67332,"_19785":114382,"_5":13558,"_26003":114222,"_2720":114383},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3227":67409,"_28581":67332,"_19785":114385,"_5":13558,"_26003":114226,"_2720":114386},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3227":67410,"_28581":67332,"_19785":114388,"_5":13558,"_26003":114226,"_2720":114389},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3227":67411,"_28581":67332,"_19785":114391,"_5":13558,"_26003":114226,"_2720":114392},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3227":67412,"_28581":67412,"_5":13916,"_2720":114394,"_28924":114395,"_19785":114396,"_26003":67412},"Perfiles de certificado",[46319,110330,51516,113972],[],{"_3227":67413,"_28581":67412,"_19785":114398,"_5":13558,"_26003":67412,"_2720":114399},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3227":67414,"_28581":67412,"_5":28921,"_19785":114401,"_26003":114402,"_2720":114403},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3227":67415,"_28581":67412,"_5":28921,"_19785":114405,"_26003":114406,"_2720":114407},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#validez","Validez",{"_3227":67416,"_28581":67412,"_5":28921,"_19785":114409,"_26003":114410,"_2720":114411},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3227":67417,"_28581":67412,"_5":28921,"_19785":114413,"_26003":114414,"_2720":114415},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3227":67418,"_28581":67412,"_5":28921,"_19785":114417,"_26003":114418,"_2720":114419},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3227":67419,"_28581":67412,"_5":28921,"_19785":114421,"_26003":114422,"_2720":114423},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3227":67420,"_28581":67412,"_5":28921,"_19785":114425,"_26003":114426,"_2720":114427},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3227":67421,"_28581":67412,"_5":28921,"_19785":114429,"_26003":114430,"_2720":114431},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3227":67422,"_28581":67412,"_5":28921,"_19785":114433,"_26003":114434,"_2720":114435},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3227":67423,"_28581":67412,"_5":28921,"_19785":114437,"_26003":114438,"_2720":114439},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3227":67424,"_28581":67412,"_5":28921,"_19785":114441,"_26003":114442,"_2720":114443},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3227":67425,"_28581":67412,"_5":28921,"_19785":114445,"_26003":114446,"_2720":114447},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3227":67426,"_28581":67412,"_5":28921,"_19785":114449,"_26003":114450,"_2720":114451},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3227":67427,"_28581":67412,"_5":28921,"_19785":114453,"_26003":114454,"_2720":114455},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3227":67428,"_28581":67412,"_5":28921,"_19785":114457,"_26003":114458,"_2720":114459},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3227":67429,"_28581":67412,"_5":28921,"_19785":114461,"_26003":114462,"_2720":114463},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3227":67430,"_28581":67412,"_19785":114465,"_5":13558,"_26003":67412,"_2720":114466},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3227":67431,"_28581":67412,"_19785":114468,"_5":13558,"_26003":67412,"_2720":114469},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3227":67432,"_28581":67412,"_19785":114471,"_5":13558,"_26003":114406,"_2720":114472},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3227":67433,"_28581":67412,"_19785":114474,"_5":13558,"_26003":114406,"_2720":114475},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3227":67434,"_28581":67412,"_19785":114477,"_5":13558,"_26003":114410,"_2720":114478},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3227":67435,"_28581":67412,"_19785":114480,"_5":13558,"_26003":114414,"_2720":114481},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3227":67436,"_28581":67412,"_19785":114483,"_5":13558,"_26003":114414,"_2720":114484},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3227":67437,"_28581":67412,"_19785":114486,"_5":13558,"_26003":114414,"_2720":114487},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3227":67438,"_28581":67412,"_19785":114489,"_5":13558,"_26003":114418,"_2720":114490},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3227":67439,"_28581":67412,"_19785":114492,"_5":13558,"_26003":114422,"_2720":114493},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3227":67440,"_28581":67412,"_19785":114495,"_5":13558,"_26003":114422,"_2720":114496},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3227":67441,"_28581":67412,"_19785":114498,"_5":13558,"_26003":114426,"_2720":114499},[],"La aplicación criptográfica puede:",{"_3227":67442,"_28581":67412,"_19785":114501,"_5":13558,"_26003":114426,"_2720":114502},[],"permitir o bloquear claves RSA;",{"_3227":67443,"_28581":67412,"_19785":114504,"_5":13558,"_26003":114426,"_2720":114505},[],"limitar los tamaños RSA admitidos;",{"_3227":67444,"_28581":67412,"_19785":114507,"_5":13558,"_26003":114426,"_2720":114508},[],"permitir o bloquear claves ECDSA;",{"_3227":67445,"_28581":67412,"_19785":114510,"_5":13558,"_26003":114426,"_2720":114511},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3227":67446,"_28581":67412,"_19785":114513,"_5":13558,"_26003":114426,"_2720":114514},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3227":67447,"_28581":67412,"_19785":114516,"_5":13558,"_26003":114430,"_2720":114517},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3227":67448,"_28581":67412,"_19785":114519,"_5":13558,"_26003":114430,"_2720":110090},[],{"_3227":67449,"_28581":67412,"_19785":114521,"_5":13558,"_26003":114430,"_2720":114522},[],"Primera opción",{"_3227":67450,"_28581":67412,"_19785":114524,"_5":13558,"_26003":114430,"_2720":114525},[],"Segunda opción",{"_3227":67451,"_28581":67412,"_19785":114527,"_5":13558,"_26003":114430,"_2720":114528},[],"Si no hay ninguna",{"_3227":67452,"_28581":67412,"_19785":114530,"_5":13558,"_26003":114430,"_2720":114531},[],"Firma directa con una CA",{"_3227":67453,"_28581":67412,"_19785":114533,"_5":13558,"_26003":114430,"_2720":114534},[],"`issuance_profile` incluido en la solicitud",{"_3227":67454,"_28581":67412,"_19785":114536,"_5":13558,"_26003":114430,"_2720":114537},[],"`issuance_profile_id` de la solicitud",{"_3227":67455,"_28581":67412,"_19785":114539,"_5":13558,"_26003":114430,"_2720":114540},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3227":67456,"_28581":67412,"_19785":114542,"_5":13558,"_26003":114430,"_2720":114543},[],"Emisión mediante DMS",{"_3227":67457,"_28581":67412,"_19785":114545,"_5":13558,"_26003":114430,"_2720":52091},[],{"_3227":67458,"_28581":67412,"_19785":114547,"_5":13558,"_26003":114430,"_2720":114548},[],"`settings.issuance_profile` incluido en el DMS",{"_3227":67459,"_28581":67412,"_19785":114550,"_5":13558,"_26003":114430,"_2720":114551},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3227":67460,"_28581":67412,"_19785":114553,"_5":13558,"_26003":114430,"_2720":114554},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3227":67461,"_28581":67412,"_19785":114556,"_5":13558,"_26003":114430,"_2720":114557},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3227":67462,"_28581":67412,"_19785":114559,"_5":13558,"_26003":114438,"_2720":114560},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3227":67463,"_28581":67412,"_19785":114562,"_5":13558,"_26003":114442,"_2720":114563},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3227":67464,"_28581":67412,"_19785":114565,"_5":13558,"_26003":114446,"_2720":114566},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3227":67465,"_28581":67412,"_19785":114568,"_5":13558,"_26003":114450,"_2720":114569},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3227":67466,"_28581":67412,"_19785":114571,"_5":13558,"_26003":114454,"_2720":114572},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3227":67467,"_28581":67412,"_19785":114574,"_5":13558,"_26003":114454,"_2720":114575},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3227":67468,"_28581":67412,"_19785":114577,"_5":13558,"_26003":114458,"_2720":114578},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3227":67469,"_28581":67412,"_19785":114580,"_5":13558,"_26003":114458,"_2720":114581},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3227":67470,"_28581":67412,"_19785":114583,"_5":13558,"_26003":114458,"_2720":114584},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3227":67471,"_28581":67412,"_19785":114586,"_5":13558,"_26003":114458,"_2720":114587},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3227":67472,"_28581":67412,"_19785":114589,"_5":13558,"_26003":114462,"_2720":114590},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3227":67473,"_28581":67412,"_19785":114592,"_5":13558,"_26003":114462,"_2720":114593},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3227":67474,"_28581":67474,"_5":13916,"_2720":114595,"_28924":114596,"_19785":114598,"_26003":67474},"Validación de certificados",[46319,110330,51516,114597],"Validación",[],{"_3227":67475,"_28581":67474,"_19785":114600,"_5":13558,"_26003":67474,"_2720":114601},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3227":67476,"_28581":67474,"_5":28921,"_19785":114603,"_26003":114604,"_2720":114605},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3227":67477,"_28581":67474,"_5":28921,"_19785":114607,"_26003":114608,"_2720":114609},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3227":67478,"_28581":67474,"_5":28921,"_19785":114611,"_26003":114612,"_2720":114613},[],"/docs/pr-preview/pr-42/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3227":67479,"_28581":67474,"_19785":114615,"_5":13558,"_26003":67474,"_2720":114616},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3227":67480,"_28581":67474,"_19785":114618,"_5":13558,"_26003":114604,"_2720":114619},[],"Verifica estos criterios juntos:",{"_3227":67481,"_28581":67474,"_19785":114621,"_5":13558,"_26003":114604,"_2720":113599},[],{"_3227":67482,"_28581":67474,"_19785":114623,"_5":13558,"_26003":114604,"_2720":114624},[],"Resultado necesario",{"_3227":67483,"_28581":67474,"_19785":114626,"_5":13558,"_26003":114604,"_2720":114627},[],"Cadena y firma",{"_3227":67484,"_28581":67474,"_19785":114629,"_5":13558,"_26003":114604,"_2720":114630},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3227":67485,"_28581":67474,"_19785":114632,"_5":13558,"_26003":114604,"_2720":114633},[],"Fechas",{"_3227":67486,"_28581":67474,"_19785":114635,"_5":13558,"_26003":114604,"_2720":114636},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3227":67487,"_28581":67474,"_19785":114638,"_5":13558,"_26003":114604,"_2720":110000},[],{"_3227":67488,"_28581":67474,"_19785":114640,"_5":13558,"_26003":114604,"_2720":114641},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3227":67489,"_28581":67474,"_19785":114643,"_5":13558,"_26003":114604,"_2720":114644},[],"Uso",{"_3227":67490,"_28581":67474,"_19785":114646,"_5":13558,"_26003":114604,"_2720":114647},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3227":67491,"_28581":67474,"_19785":114649,"_5":13558,"_26003":114604,"_2720":114650},[],"Revocación",{"_3227":67492,"_28581":67474,"_19785":114652,"_5":13558,"_26003":114604,"_2720":114653},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3227":67493,"_28581":67474,"_19785":114655,"_5":13558,"_26003":114604,"_2720":114656},[],"Autorización",{"_3227":67494,"_28581":67474,"_19785":114658,"_5":13558,"_26003":114604,"_2720":114659},[],"La aplicación permite la acción a esa identidad.",{"_3227":67495,"_28581":67474,"_19785":114661,"_5":13558,"_26003":114604,"_2720":114662},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3227":67496,"_28581":67474,"_19785":114664,"_5":13558,"_26003":114608,"_2720":114665},[],"Mecanismo",{"_3227":67497,"_28581":67474,"_19785":114667,"_5":13558,"_26003":114608,"_2720":114668},[],"Cuándo utilizarlo",{"_3227":67498,"_28581":67474,"_19785":114670,"_5":13558,"_26003":114608,"_2720":114671},[],"Qué debes mantener",{"_3227":67499,"_28581":67474,"_19785":114673,"_5":13558,"_26003":114608,"_2720":52219},[],{"_3227":67500,"_28581":67474,"_19785":114675,"_5":13558,"_26003":114608,"_2720":114676},[],"Consulta del estado de un certificado concreto.",{"_3227":67501,"_28581":67474,"_19785":114678,"_5":13558,"_26003":114608,"_2720":114679},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3227":67502,"_28581":67474,"_19785":114681,"_5":13558,"_26003":114608,"_2720":52228},[],{"_3227":67503,"_28581":67474,"_19785":114683,"_5":13558,"_26003":114608,"_2720":114684},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3227":67504,"_28581":67474,"_19785":114686,"_5":13558,"_26003":114608,"_2720":114687},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3227":67505,"_28581":67474,"_19785":114689,"_5":13558,"_26003":114608,"_2720":114690},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3227":67506,"_28581":67474,"_19785":114692,"_5":13558,"_26003":114608,"_2720":114693},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3227":67507,"_28581":67474,"_19785":114695,"_5":13558,"_26003":114612,"_2720":114696},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3227":67508,"_28581":67474,"_19785":114698,"_5":13558,"_26003":114612,"_2720":114699},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3227":67509,"_28581":67474,"_19785":114701,"_5":13558,"_26003":114612,"_2720":114702},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3227":67510,"_28581":67474,"_19785":114704,"_5":13558,"_26003":114612,"_2720":114705},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3227":67511,"_28581":67474,"_19785":114707,"_5":13558,"_26003":114612,"_2720":114708},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3227":67512,"_28581":67474,"_19785":114710,"_5":13558,"_26003":114612,"_2720":114711},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3227":67513,"_28581":67474,"_19785":114713,"_5":13558,"_26003":114612,"_2720":114714},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3227":67514,"_28581":67474,"_19785":114716,"_5":13558,"_26003":114612,"_2720":114717},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3227":67515,"_28581":67474,"_19785":114719,"_5":13558,"_26003":114612,"_2720":114720},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3227":67516,"_28581":67516,"_5":13916,"_2720":114722,"_28924":114723,"_19785":114724,"_26003":67516},"Certificados",[46319,110330,51516,113972],[],{"_3227":67517,"_28581":67516,"_19785":114726,"_5":13558,"_26003":67516,"_2720":114727},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3227":67518,"_28581":67516,"_5":28921,"_19785":114729,"_26003":114730,"_2720":114731},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3227":67519,"_28581":67516,"_5":28921,"_19785":114733,"_26003":114734,"_2720":114735},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3227":67520,"_28581":67516,"_5":28921,"_19785":114737,"_26003":114738,"_2720":114739},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3227":67521,"_28581":67516,"_5":28921,"_19785":114741,"_26003":114742,"_2720":114743},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3227":67522,"_28581":67516,"_5":28921,"_19785":114745,"_26003":114746,"_2720":114747},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3227":67523,"_28581":67516,"_5":28921,"_19785":114749,"_26003":114750,"_2720":114751},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3227":67524,"_28581":67516,"_5":28921,"_19785":114753,"_26003":114754,"_2720":114755},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3227":67525,"_28581":67516,"_5":28921,"_19785":114757,"_26003":114758,"_2720":114759},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3227":67526,"_28581":67516,"_5":28921,"_19785":114761,"_26003":114762,"_2720":114763},[],"/docs/pr-preview/pr-42/es/platform/pki/certificates#continúa","Continúa",{"_3227":67527,"_28581":67516,"_19785":114765,"_5":13558,"_26003":67516,"_2720":114766},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3227":67528,"_28581":67516,"_19785":114768,"_5":13558,"_26003":114730,"_2720":114769},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3227":67529,"_28581":67516,"_19785":114771,"_5":13558,"_26003":114730,"_2720":114772},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3227":67530,"_28581":67516,"_19785":114774,"_5":13558,"_26003":114734,"_2720":114775},[],"Descarga el PEM e inspecciónalo:",{"_3227":67531,"_28581":67516,"_19785":114777,"_5":13558,"_26003":114734,"_2720":114778},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3227":67532,"_28581":67516,"_19785":114780,"_5":13558,"_26003":114738,"_2720":114781},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3227":67533,"_28581":67516,"_19785":114783,"_5":13558,"_26003":114738,"_2720":114784},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3227":67534,"_28581":67516,"_19785":114786,"_5":13558,"_26003":114738,"_2720":114787},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3227":67535,"_28581":67516,"_19785":114789,"_5":13558,"_26003":114738,"_2720":114790},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3227":67536,"_28581":67516,"_19785":114792,"_5":13558,"_26003":114738,"_2720":114793},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3227":67537,"_28581":67516,"_19785":114795,"_5":13558,"_26003":114738,"_2720":114796},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3227":67538,"_28581":67516,"_19785":114798,"_5":13558,"_26003":114738,"_2720":114799},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3227":67539,"_28581":67516,"_19785":114801,"_5":13558,"_26003":114742,"_2720":114802},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3227":67540,"_28581":67516,"_19785":114804,"_5":13558,"_26003":114746,"_2720":114805},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3227":67541,"_28581":67516,"_19785":114807,"_5":13558,"_26003":114750,"_2720":114808},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3227":67542,"_28581":67516,"_19785":114810,"_5":13558,"_26003":114754,"_2720":114811},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3227":67543,"_28581":67516,"_19785":114813,"_5":13558,"_26003":114754,"_2720":114814},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3227":67544,"_28581":67516,"_19785":114816,"_5":13558,"_26003":114754,"_2720":114817},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3227":67545,"_28581":67516,"_19785":114819,"_5":13558,"_26003":114758,"_2720":114820},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3227":67546,"_28581":67516,"_19785":114822,"_5":13558,"_26003":114758,"_2720":114823},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3227":67547,"_28581":67516,"_19785":114825,"_5":13558,"_26003":114758,"_2720":114826},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3227":67548,"_28581":67516,"_19785":114828,"_5":13558,"_26003":114762,"_2720":114829},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3227":67549,"_28581":67516,"_19785":114831,"_5":13558,"_26003":114762,"_2720":114832},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3227":67550,"_28581":67550,"_5":13916,"_2720":114834,"_28924":114835,"_19785":114837,"_26003":67550},"Ciclo de vida de un certificado",[46319,110330,51516,114836],"Conceptos",[],{"_3227":67551,"_28581":67550,"_19785":114839,"_5":13558,"_26003":67550,"_2720":114840},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3227":67552,"_28581":67550,"_5":28921,"_19785":114842,"_26003":114843,"_2720":114844},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3227":67553,"_28581":67550,"_5":28921,"_19785":114846,"_26003":114847,"_2720":114848},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3227":67554,"_28581":67550,"_5":28921,"_19785":114850,"_26003":114851,"_2720":114852},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3227":67555,"_28581":67550,"_5":28921,"_19785":114854,"_26003":114855,"_2720":114856},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3227":67556,"_28581":67550,"_5":28921,"_19785":114858,"_26003":114859,"_2720":114860},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3227":67557,"_28581":67550,"_5":28921,"_19785":114862,"_26003":114863,"_2720":114864},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3227":67558,"_28581":67550,"_5":28921,"_19785":114866,"_26003":114867,"_2720":114868},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3227":67559,"_28581":67550,"_5":28921,"_19785":114870,"_26003":114871,"_2720":114872},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3227":67560,"_28581":67550,"_5":28921,"_19785":114874,"_26003":114875,"_2720":114876},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3227":67561,"_28581":67550,"_5":28921,"_19785":114878,"_26003":114879,"_2720":114880},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3227":67562,"_28581":67550,"_19785":114882,"_5":13558,"_26003":67550,"_2720":114883},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3227":67563,"_28581":67550,"_19785":114885,"_5":13558,"_26003":114847,"_2720":114886},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3227":67564,"_28581":67550,"_19785":114888,"_5":13558,"_26003":114851,"_2720":114889},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3227":67565,"_28581":67550,"_19785":114891,"_5":13558,"_26003":114855,"_2720":114892},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3227":67566,"_28581":67550,"_19785":114894,"_5":13558,"_26003":114859,"_2720":114895},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3227":67567,"_28581":67550,"_19785":114897,"_5":13558,"_26003":114863,"_2720":114898},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3227":67568,"_28581":67550,"_19785":114900,"_5":13558,"_26003":114867,"_2720":114901},[],"Lamassu persiste cuatro estados X.509:",{"_3227":67569,"_28581":67550,"_19785":114903,"_5":13558,"_26003":114867,"_2720":114904},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3227":67570,"_28581":67550,"_19785":114906,"_5":13558,"_26003":114867,"_2720":114907},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3227":67571,"_28581":67550,"_19785":114909,"_5":13558,"_26003":114867,"_2720":114910},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3227":67572,"_28581":67550,"_19785":114912,"_5":13558,"_26003":114867,"_2720":114913},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3227":67573,"_28581":67550,"_19785":114915,"_5":13558,"_26003":114867,"_2720":114916},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3227":67574,"_28581":67550,"_19785":114918,"_5":13558,"_26003":114871,"_2720":114919},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3227":67575,"_28581":67550,"_19785":114921,"_5":13558,"_26003":114871,"_2720":114922},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3227":67576,"_28581":67550,"_19785":114924,"_5":13558,"_26003":114871,"_2720":114925},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3227":67577,"_28581":67550,"_19785":114927,"_5":13558,"_26003":114875,"_2720":114928},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3227":67578,"_28581":67550,"_19785":114930,"_5":13558,"_26003":114875,"_2720":114931},[],"Antes de confirmar:",{"_3227":67579,"_28581":67550,"_19785":114933,"_5":13558,"_26003":114875,"_2720":114934},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3227":67580,"_28581":67550,"_19785":114936,"_5":13558,"_26003":114875,"_2720":114937},[],"Distribuye la nueva cadena de confianza.",{"_3227":67581,"_28581":67550,"_19785":114939,"_5":13558,"_26003":114875,"_2720":114940},[],"Reemite las identidades necesarias.",{"_3227":67582,"_28581":67550,"_19785":114942,"_5":13558,"_26003":114875,"_2720":114943},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3227":67583,"_28581":67550,"_19785":114945,"_5":13558,"_26003":114875,"_2720":114946},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3227":67584,"_28581":67550,"_19785":114948,"_5":13558,"_26003":114875,"_2720":114949},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3227":67585,"_28581":67550,"_19785":114951,"_5":13558,"_26003":114879,"_2720":114952},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3227":67586,"_28581":67550,"_19785":114954,"_5":13558,"_26003":114879,"_2720":114955},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3227":67587,"_28581":67550,"_19785":114957,"_5":13558,"_26003":114879,"_2720":114958},[],"Cambios de estado y razones de revocación.",{"_3227":67588,"_28581":67550,"_19785":114960,"_5":13558,"_26003":114879,"_2720":114961},[],"Publicación y vigencia de OCSP y CRLs.",{"_3227":67589,"_28581":67550,"_19785":114963,"_5":13558,"_26003":114879,"_2720":114964},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3227":67590,"_28581":67550,"_19785":114966,"_5":13558,"_26003":114879,"_2720":114967},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3227":67591,"_28581":67591,"_5":13916,"_2720":114969,"_28924":114970,"_19785":114971,"_26003":67591},"Modelo de confianza",[46319,110330,51516,114836],[],{"_3227":67592,"_28581":67591,"_19785":114973,"_5":13558,"_26003":67591,"_2720":114974},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3227":67593,"_28581":67591,"_5":28921,"_19785":114976,"_26003":114977,"_2720":114978},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3227":67594,"_28581":67591,"_5":28921,"_19785":114980,"_26003":114981,"_2720":114982},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3227":67595,"_28581":67591,"_5":28921,"_19785":114984,"_26003":114985,"_2720":114986},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3227":67596,"_28581":67591,"_5":28921,"_19785":114988,"_26003":114989,"_2720":114990},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3227":67597,"_28581":67591,"_5":28921,"_19785":114992,"_26003":114993,"_2720":114994},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3227":67598,"_28581":67591,"_5":28921,"_19785":114996,"_26003":114997,"_2720":114998},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3227":67599,"_28581":67591,"_5":28921,"_19785":115000,"_26003":115001,"_2720":115002},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3227":67600,"_28581":67591,"_5":28921,"_19785":115004,"_26003":115005,"_2720":115006},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3227":67601,"_28581":67591,"_5":28921,"_19785":115008,"_26003":115009,"_2720":115010},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3227":67602,"_28581":67591,"_5":28921,"_19785":115012,"_26003":115013,"_2720":115014},[],"/docs/pr-preview/pr-42/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3227":67603,"_28581":67591,"_19785":115016,"_5":13558,"_26003":67591,"_2720":115017},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3227":67604,"_28581":67591,"_19785":115019,"_5":13558,"_26003":114981,"_2720":115020},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3227":67605,"_28581":67591,"_19785":115022,"_5":13558,"_26003":114985,"_2720":115023},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3227":67606,"_28581":67591,"_19785":115025,"_5":13558,"_26003":114989,"_2720":115026},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3227":67607,"_28581":67591,"_19785":115028,"_5":13558,"_26003":114993,"_2720":115029},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3227":67608,"_28581":67591,"_19785":115031,"_5":13558,"_26003":114997,"_2720":115032},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3227":67609,"_28581":67591,"_19785":115034,"_5":13558,"_26003":114997,"_2720":115035},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3227":67610,"_28581":67591,"_19785":115037,"_5":13558,"_26003":114997,"_2720":115038},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3227":67611,"_28581":67591,"_19785":115040,"_5":13558,"_26003":114997,"_2720":115041},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3227":67612,"_28581":67591,"_19785":115043,"_5":13558,"_26003":114997,"_2720":115044},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3227":67613,"_28581":67591,"_19785":115046,"_5":13558,"_26003":114997,"_2720":115047},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3227":67614,"_28581":67591,"_19785":115049,"_5":13558,"_26003":115001,"_2720":115050},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3227":67615,"_28581":67591,"_19785":115052,"_5":13558,"_26003":115001,"_2720":115053},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3227":67616,"_28581":67591,"_19785":115055,"_5":13558,"_26003":115001,"_2720":115056},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3227":67617,"_28581":67591,"_19785":115058,"_5":13558,"_26003":115001,"_2720":115059},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3227":67618,"_28581":67591,"_19785":115061,"_5":13558,"_26003":115001,"_2720":115062},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3227":67619,"_28581":67591,"_19785":115064,"_5":13558,"_26003":115005,"_2720":115065},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3227":67620,"_28581":67591,"_19785":115067,"_5":13558,"_26003":115005,"_2720":115068},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3227":67621,"_28581":67591,"_19785":115070,"_5":13558,"_26003":115005,"_2720":115071},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3227":67622,"_28581":67591,"_19785":115073,"_5":13558,"_26003":115005,"_2720":115074},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3227":67623,"_28581":67591,"_19785":115076,"_5":13558,"_26003":115005,"_2720":115077},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3227":67624,"_28581":67591,"_19785":115079,"_5":13558,"_26003":115005,"_2720":115080},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3227":67625,"_28581":67591,"_19785":115082,"_5":13558,"_26003":115005,"_2720":115083},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3227":67626,"_28581":67591,"_19785":115085,"_5":13558,"_26003":115009,"_2720":115086},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3227":67627,"_28581":67591,"_19785":115088,"_5":13558,"_26003":115013,"_2720":115089},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3227":67628,"_28581":67591,"_19785":115091,"_5":13558,"_26003":115013,"_2720":115092},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3227":67629,"_28581":67591,"_19785":115094,"_5":13558,"_26003":115013,"_2720":115095},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3227":67630,"_28581":67591,"_19785":115097,"_5":13558,"_26003":115013,"_2720":115098},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3227":67631,"_28581":67591,"_19785":115100,"_5":13558,"_26003":115013,"_2720":115101},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3227":67632,"_28581":67591,"_19785":115103,"_5":13558,"_26003":115013,"_2720":115104},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3227":67633,"_28581":67591,"_19785":115106,"_5":13558,"_26003":115013,"_2720":115107},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3227":67634,"_28581":67634,"_5":13916,"_2720":115109,"_28924":115110,"_19785":115111,"_26003":67634},"Listas de revocación (CRL)",[46319,110330,51516,114597],[],{"_3227":67635,"_28581":67634,"_19785":115113,"_5":13558,"_26003":67634,"_2720":115114},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3227":67636,"_28581":67634,"_5":28921,"_19785":115116,"_26003":115117,"_2720":115118},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3227":67637,"_28581":67634,"_5":28921,"_19785":115120,"_26003":115121,"_2720":115122},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3227":67638,"_28581":67634,"_5":28921,"_19785":115124,"_26003":115125,"_2720":115126},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3227":67639,"_28581":67634,"_5":28921,"_19785":115128,"_26003":115129,"_2720":115130},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3227":67640,"_28581":67634,"_5":28921,"_19785":115132,"_26003":115133,"_2720":115134},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3227":67641,"_28581":67634,"_5":28921,"_19785":115136,"_26003":115137,"_2720":115138},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3227":67642,"_28581":67634,"_5":28921,"_19785":115140,"_26003":115141,"_2720":115142},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3227":67643,"_28581":67634,"_5":28921,"_19785":115144,"_26003":115145,"_2720":115146},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3227":67644,"_28581":67634,"_5":28921,"_19785":115148,"_26003":115149,"_2720":115150},[],"/docs/pr-preview/pr-42/es/platform/pki/crl#referencias","Referencias",{"_3227":67645,"_28581":67634,"_19785":115152,"_5":13558,"_26003":67634,"_2720":115153},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3227":67646,"_28581":67634,"_19785":115155,"_5":13558,"_26003":115117,"_2720":115156},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3227":67647,"_28581":67634,"_19785":115158,"_5":13558,"_26003":115117,"_2720":115159},[],"Campo de `crl_options`",{"_3227":67648,"_28581":67634,"_19785":115161,"_5":13558,"_26003":115117,"_2720":111865},[],{"_3227":67649,"_28581":67634,"_19785":115163,"_5":13558,"_26003":115117,"_2720":115164},[],"Valor inicial del backend",{"_3227":67650,"_28581":67634,"_19785":115166,"_5":13558,"_26003":115117,"_2720":52714},[],{"_3227":67651,"_28581":67634,"_19785":115168,"_5":13558,"_26003":115117,"_2720":115169},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3227":67652,"_28581":67634,"_19785":115171,"_5":13558,"_26003":115117,"_2720":115172},[],"7 días.",{"_3227":67653,"_28581":67634,"_19785":115174,"_5":13558,"_26003":115117,"_2720":52723},[],{"_3227":67654,"_28581":67634,"_19785":115176,"_5":13558,"_26003":115117,"_2720":115177},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_3227":67655,"_28581":67634,"_19785":115179,"_5":13558,"_26003":115117,"_2720":115180},[],"6 días y 23 horas.",{"_3227":67656,"_28581":67634,"_19785":115182,"_5":13558,"_26003":115117,"_2720":52732},[],{"_3227":67657,"_28581":67634,"_19785":115184,"_5":13558,"_26003":115117,"_2720":115185},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3227":67658,"_28581":67634,"_19785":115187,"_5":13558,"_26003":115117,"_2720":52738},[],{"_3227":67659,"_28581":67634,"_19785":115189,"_5":13558,"_26003":115117,"_2720":52741},[],{"_3227":67660,"_28581":67634,"_19785":115191,"_5":13558,"_26003":115117,"_2720":115192},[],"Número de serie del certificado existente que firma la CRL.",{"_3227":67661,"_28581":67634,"_19785":115194,"_5":13558,"_26003":115117,"_2720":115195},[],"Número de serie del certificado actual de la CA.",{"_3227":67662,"_28581":67634,"_19785":115197,"_5":13558,"_26003":115117,"_2720":115198},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3227":67663,"_28581":67634,"_19785":115200,"_5":13558,"_26003":115117,"_2720":115201},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_3227":67664,"_28581":67634,"_19785":115203,"_5":13558,"_26003":115117,"_2720":115204},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3227":67665,"_28581":67634,"_19785":115206,"_5":13558,"_26003":115117,"_2720":115207},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_3227":67666,"_28581":67634,"_19785":115209,"_5":13558,"_26003":115117,"_2720":115210},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3227":67667,"_28581":67634,"_19785":115212,"_5":13558,"_26003":115117,"_2720":115213},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3227":67668,"_28581":67634,"_19785":115215,"_5":13558,"_26003":115121,"_2720":115216},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3227":67669,"_28581":67634,"_19785":115218,"_5":13558,"_26003":115121,"_2720":115219},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.3) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3227":67670,"_28581":67634,"_19785":115221,"_5":13558,"_26003":115121,"_2720":115222},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3227":67671,"_28581":67634,"_19785":115224,"_5":13558,"_26003":115121,"_2720":115225},[],"Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Limita el permiso de importar CAs como control provisional. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3227":67672,"_28581":67634,"_19785":115227,"_5":13558,"_26003":115125,"_2720":115228},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3227":67673,"_28581":67634,"_19785":115230,"_5":13558,"_26003":115125,"_2720":115231},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3227":67674,"_28581":67634,"_19785":115233,"_5":13558,"_26003":115125,"_2720":115234},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3227":67675,"_28581":67634,"_19785":115236,"_5":13558,"_26003":115125,"_2720":115237},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3227":67676,"_28581":67634,"_19785":115239,"_5":13558,"_26003":115129,"_2720":115240},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3227":67677,"_28581":67634,"_19785":115242,"_5":13558,"_26003":115129,"_2720":115243},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3227":67678,"_28581":67634,"_19785":115245,"_5":13558,"_26003":115133,"_2720":115246},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3227":67679,"_28581":67634,"_19785":115248,"_5":13558,"_26003":115133,"_2720":115249},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3227":67680,"_28581":67634,"_19785":115251,"_5":13558,"_26003":115133,"_2720":115252},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3227":67681,"_28581":67634,"_19785":115254,"_5":13558,"_26003":115133,"_2720":115255},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3227":67682,"_28581":67634,"_19785":115257,"_5":13558,"_26003":115133,"_2720":115258},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3227":67683,"_28581":67634,"_19785":115260,"_5":13558,"_26003":115137,"_2720":115261},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3227":67684,"_28581":67634,"_19785":115263,"_5":13558,"_26003":115137,"_2720":112054},[],{"_3227":67685,"_28581":67634,"_19785":115265,"_5":13558,"_26003":115137,"_2720":115266},[],"Path relativo",{"_3227":67686,"_28581":67634,"_19785":115268,"_5":13558,"_26003":115137,"_2720":110090},[],{"_3227":67687,"_28581":67634,"_19785":115270,"_5":13558,"_26003":115137,"_2720":52823},[],{"_3227":67688,"_28581":67634,"_19785":115272,"_5":13558,"_26003":115137,"_2720":52826},[],{"_3227":67689,"_28581":67634,"_19785":115274,"_5":13558,"_26003":115137,"_2720":115275},[],"Consultar `crl_options` y `latest_crl`.",{"_3227":67690,"_28581":67634,"_19785":115277,"_5":13558,"_26003":115137,"_2720":52832},[],{"_3227":67691,"_28581":67634,"_19785":115279,"_5":13558,"_26003":115137,"_2720":52826},[],{"_3227":67692,"_28581":67634,"_19785":115281,"_5":13558,"_26003":115137,"_2720":115282},[],"Sustituir la configuración de CRL.",{"_3227":67693,"_28581":67634,"_19785":115284,"_5":13558,"_26003":115137,"_2720":115285},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3227":67694,"_28581":67634,"_19785":115287,"_5":13558,"_26003":115137,"_2720":115288},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3227":67695,"_28581":67634,"_19785":115290,"_5":13558,"_26003":115141,"_2720":115291},[],"Síntoma",{"_3227":67696,"_28581":67634,"_19785":115293,"_5":13558,"_26003":115141,"_2720":115294},[],"Causa",{"_3227":67697,"_28581":67634,"_19785":115296,"_5":13558,"_26003":115141,"_2720":115297},[],"Acción",{"_3227":67698,"_28581":67634,"_19785":115299,"_5":13558,"_26003":115141,"_2720":115300},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3227":67699,"_28581":67634,"_19785":115302,"_5":13558,"_26003":115141,"_2720":115303},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3227":67700,"_28581":67634,"_19785":115305,"_5":13558,"_26003":115141,"_2720":115306},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3227":67701,"_28581":67634,"_19785":115308,"_5":13558,"_26003":115141,"_2720":115309},[],"`PUT` devuelve 400.",{"_3227":67702,"_28581":67634,"_19785":115311,"_5":13558,"_26003":115141,"_2720":115312},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3227":67703,"_28581":67634,"_19785":115314,"_5":13558,"_26003":115141,"_2720":115315},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3227":67704,"_28581":67634,"_19785":115317,"_5":13558,"_26003":115141,"_2720":115318},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3227":67705,"_28581":67634,"_19785":115320,"_5":13558,"_26003":115141,"_2720":115321},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3227":67706,"_28581":67634,"_19785":115323,"_5":13558,"_26003":115141,"_2720":115324},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3227":67707,"_28581":67634,"_19785":115326,"_5":13558,"_26003":115141,"_2720":115327},[],"La CRL no cambia tras revocar un certificado.",{"_3227":67708,"_28581":67634,"_19785":115329,"_5":13558,"_26003":115141,"_2720":115330},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3227":67709,"_28581":67634,"_19785":115332,"_5":13558,"_26003":115141,"_2720":115333},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3227":67710,"_28581":67634,"_19785":115335,"_5":13558,"_26003":115141,"_2720":115336},[],"Un verificador rechaza la CRL por el emisor.",{"_3227":67711,"_28581":67634,"_19785":115338,"_5":13558,"_26003":115141,"_2720":115339},[],"Varias CAs comparten SKI.",{"_3227":67712,"_28581":67634,"_19785":115341,"_5":13558,"_26003":115141,"_2720":115342},[],"Consulta CAs que comparten clave.",{"_3227":67713,"_28581":67634,"_19785":115344,"_5":13558,"_26003":115145,"_2720":115345},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3227":67714,"_28581":67634,"_19785":115347,"_5":13558,"_26003":115149,"_2720":115348},[],"RFC 5280: perfil X.509 y CRL.",{"_3227":67715,"_28581":67634,"_19785":115350,"_5":13558,"_26003":115149,"_2720":52906},[],{"_3227":67716,"_28581":67634,"_19785":115352,"_5":13558,"_26003":115149,"_2720":52909},[],{"_3227":67717,"_28581":67634,"_19785":115354,"_5":13558,"_26003":115149,"_2720":115355},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3227":67718,"_28581":67634,"_19785":115357,"_5":13558,"_26003":115149,"_2720":115358},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3227":67719,"_28581":67719,"_5":13916,"_2720":115360,"_28924":115361,"_19785":115362,"_26003":67719},"Claves y motores criptográficos",[46319,110330,51516,113972],[],{"_3227":67720,"_28581":67719,"_19785":115364,"_5":13558,"_26003":67719,"_2720":115365},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3227":67721,"_28581":67719,"_5":28921,"_19785":115367,"_26003":115368,"_2720":115369},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3227":67722,"_28581":67719,"_5":28921,"_19785":115371,"_26003":115372,"_2720":115373},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3227":67723,"_28581":67719,"_5":28921,"_19785":115375,"_26003":115376,"_2720":52934},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#file-system",{"_3227":67724,"_28581":67719,"_5":28921,"_19785":115378,"_26003":115379,"_2720":52938},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#hashicorp-vault",{"_3227":67725,"_28581":67719,"_5":28921,"_19785":115381,"_26003":115382,"_2720":52942},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#aws-secrets-manager",{"_3227":67726,"_28581":67719,"_5":28921,"_19785":115384,"_26003":115385,"_2720":52946},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#aws-kms",{"_3227":67727,"_28581":67719,"_5":28921,"_19785":115387,"_26003":115388,"_2720":52950},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#pkcs11",{"_3227":67728,"_28581":67719,"_5":28921,"_19785":115390,"_26003":115391,"_2720":52954},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#azure-key-vault",{"_3227":67729,"_28581":67719,"_5":28921,"_19785":115393,"_26003":115394,"_2720":115395},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3227":67730,"_28581":67719,"_5":28921,"_19785":115397,"_26003":115398,"_2720":115399},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3227":67731,"_28581":67719,"_5":28921,"_19785":115401,"_26003":115402,"_2720":115403},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3227":67732,"_28581":67719,"_5":28921,"_19785":115405,"_26003":115406,"_2720":115407},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3227":67733,"_28581":67719,"_5":28921,"_19785":115409,"_26003":115410,"_2720":115411},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3227":67734,"_28581":67719,"_5":28921,"_19785":115413,"_26003":115414,"_2720":115415},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3227":67735,"_28581":67719,"_5":28921,"_19785":115417,"_26003":115418,"_2720":115419},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3227":67736,"_28581":67719,"_5":28921,"_19785":115421,"_26003":115422,"_2720":52986},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#sign",{"_3227":67737,"_28581":67719,"_5":28921,"_19785":115424,"_26003":115425,"_2720":52990},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#verify",{"_3227":67738,"_28581":67719,"_5":28921,"_19785":115427,"_26003":115428,"_2720":115429},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3227":67739,"_28581":67719,"_5":28921,"_19785":115431,"_26003":115432,"_2720":115433},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3227":67740,"_28581":67719,"_5":28921,"_19785":115435,"_26003":115436,"_2720":115437},[],"/docs/pr-preview/pr-42/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3227":67741,"_28581":67719,"_19785":115439,"_5":13558,"_26003":67719,"_2720":115440},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3227":67742,"_28581":67719,"_19785":115442,"_5":13558,"_26003":67719,"_2720":115443},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3227":67743,"_28581":67719,"_19785":115445,"_5":13558,"_26003":115368,"_2720":115446},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3227":67744,"_28581":67719,"_19785":115448,"_5":13558,"_26003":115368,"_2720":115449},[],"En la práctica, permite:",{"_3227":67745,"_28581":67719,"_19785":115451,"_5":13558,"_26003":115368,"_2720":115452},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3227":67746,"_28581":67719,"_19785":115454,"_5":13558,"_26003":115368,"_2720":115455},[],"Importar claves creadas externamente.",{"_3227":67747,"_28581":67719,"_19785":115457,"_5":13558,"_26003":115368,"_2720":115458},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3227":67748,"_28581":67719,"_19785":115460,"_5":13558,"_26003":115368,"_2720":115461},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3227":67749,"_28581":67719,"_19785":115463,"_5":13558,"_26003":115372,"_2720":115464},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3227":67750,"_28581":67719,"_19785":115466,"_5":13558,"_26003":115372,"_2720":115467},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3227":67751,"_28581":67719,"_19785":115469,"_5":13558,"_26003":115372,"_2720":115470},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3227":67752,"_28581":67719,"_19785":115472,"_5":13558,"_26003":115376,"_2720":115473},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3227":67753,"_28581":67719,"_19785":115475,"_5":13558,"_26003":115379,"_2720":115476},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3227":67754,"_28581":67719,"_19785":115478,"_5":13558,"_26003":115379,"_2720":115479},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3227":67755,"_28581":67719,"_19785":115481,"_5":13558,"_26003":115382,"_2720":115482},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3227":67756,"_28581":67719,"_19785":115484,"_5":13558,"_26003":115385,"_2720":115485},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3227":67757,"_28581":67719,"_19785":115487,"_5":13558,"_26003":115388,"_2720":115488},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3227":67758,"_28581":67719,"_19785":115490,"_5":13558,"_26003":115391,"_2720":115491},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3227":67759,"_28581":67719,"_19785":115493,"_5":13558,"_26003":115391,"_2720":115494},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3227":67760,"_28581":67719,"_19785":115496,"_5":13558,"_26003":115391,"_2720":115497},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3227":67761,"_28581":67719,"_19785":115499,"_5":13558,"_26003":115391,"_2720":115500},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3227":67762,"_28581":67719,"_19785":115502,"_5":13558,"_26003":115394,"_2720":115503},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3227":67763,"_28581":67719,"_19785":115505,"_5":13558,"_26003":115394,"_2720":115506},[],"La tabla incluye los siguientes campos:",{"_3227":67764,"_28581":67719,"_19785":115508,"_5":13558,"_26003":115394,"_2720":115509},[],"**Name**: nombre descriptivo de la clave.",{"_3227":67765,"_28581":67719,"_19785":115511,"_5":13558,"_26003":115394,"_2720":115512},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3227":67766,"_28581":67719,"_19785":115514,"_5":13558,"_26003":115394,"_2720":115515},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3227":67767,"_28581":67719,"_19785":115517,"_5":13558,"_26003":115394,"_2720":115518},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3227":67768,"_28581":67719,"_19785":115520,"_5":13558,"_26003":115394,"_2720":115521},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3227":67769,"_28581":67719,"_19785":115523,"_5":13558,"_26003":115394,"_2720":115524},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3227":67770,"_28581":67719,"_19785":115526,"_5":13558,"_26003":115394,"_2720":115527},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3227":67771,"_28581":67719,"_19785":115529,"_5":13558,"_26003":115394,"_2720":115530},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3227":67772,"_28581":67719,"_19785":115532,"_5":13558,"_26003":115394,"_2720":115533},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3227":67773,"_28581":67719,"_19785":115535,"_5":13558,"_26003":115394,"_2720":115536},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3227":67774,"_28581":67719,"_19785":115538,"_5":13558,"_26003":115394,"_2720":115539},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3227":67775,"_28581":67719,"_19785":115541,"_5":13558,"_26003":115394,"_2720":115542},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3227":67776,"_28581":67719,"_19785":115544,"_5":13558,"_26003":115394,"_2720":115545},[],"**Delete Key** para eliminar la clave del sistema.",{"_3227":67777,"_28581":67719,"_19785":115547,"_5":13558,"_26003":115398,"_2720":115548},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3227":67778,"_28581":67719,"_19785":115550,"_5":13558,"_26003":115402,"_2720":115551},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3227":67779,"_28581":67719,"_19785":115553,"_5":13558,"_26003":115402,"_2720":115554},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3227":67780,"_28581":67719,"_19785":115556,"_5":13558,"_26003":115402,"_2720":115557},[],"**Key Name**: nombre único y descriptivo.",{"_3227":67781,"_28581":67719,"_19785":115559,"_5":13558,"_26003":115402,"_2720":115560},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3227":67782,"_28581":67719,"_19785":115562,"_5":13558,"_26003":115402,"_2720":115563},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3227":67783,"_28581":67719,"_19785":115565,"_5":13558,"_26003":115402,"_2720":115566},[],"**Tags**: metadatos para clasificar la clave.",{"_3227":67784,"_28581":67719,"_19785":115568,"_5":13558,"_26003":115402,"_2720":115569},[],"**Metadata**: información adicional para usos avanzados.",{"_3227":67785,"_28581":67719,"_19785":115571,"_5":13558,"_26003":115406,"_2720":115572},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3227":67786,"_28581":67719,"_19785":115574,"_5":13558,"_26003":115406,"_2720":115575},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3227":67787,"_28581":67719,"_19785":115577,"_5":13558,"_26003":115406,"_2720":115578},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3227":67788,"_28581":67719,"_19785":115580,"_5":13558,"_26003":115406,"_2720":115581},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3227":67789,"_28581":67719,"_19785":115583,"_5":13558,"_26003":115406,"_2720":115584},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3227":67790,"_28581":67719,"_19785":115586,"_5":13558,"_26003":115406,"_2720":115587},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3227":67791,"_28581":67719,"_19785":115589,"_5":13558,"_26003":115406,"_2720":115590},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3227":67792,"_28581":67719,"_19785":115592,"_5":13558,"_26003":115406,"_2720":115593},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3227":67793,"_28581":67719,"_19785":115595,"_5":13558,"_26003":115406,"_2720":115596},[],"**Metadata**: información adicional opcional.",{"_3227":67794,"_28581":67719,"_19785":115598,"_5":13558,"_26003":115406,"_2720":115599},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3227":67795,"_28581":67719,"_19785":115601,"_5":13558,"_26003":115406,"_2720":115602},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3227":67796,"_28581":67719,"_19785":115604,"_5":13558,"_26003":115410,"_2720":115605},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3227":67797,"_28581":67719,"_19785":115607,"_5":13558,"_26003":115414,"_2720":115608},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3227":67798,"_28581":67719,"_19785":115610,"_5":13558,"_26003":115414,"_2720":115611},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3227":67799,"_28581":67719,"_19785":115613,"_5":13558,"_26003":115414,"_2720":115614},[],"**Key Name**: nombre descriptivo.",{"_3227":67800,"_28581":67719,"_19785":115616,"_5":13558,"_26003":115414,"_2720":115617},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3227":67801,"_28581":67719,"_19785":115619,"_5":13558,"_26003":115414,"_2720":115620},[],"**Tags**: etiquetas asociadas.",{"_3227":67802,"_28581":67719,"_19785":115622,"_5":13558,"_26003":115414,"_2720":115623},[],"**Aliases**: nombres alternativos.",{"_3227":67803,"_28581":67719,"_19785":115625,"_5":13558,"_26003":115414,"_2720":115626},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3227":67804,"_28581":67719,"_19785":115628,"_5":13558,"_26003":115414,"_2720":115629},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3227":67805,"_28581":67719,"_19785":115631,"_5":13558,"_26003":115414,"_2720":115632},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3227":67806,"_28581":67719,"_19785":115634,"_5":13558,"_26003":115414,"_2720":115635},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3227":67807,"_28581":67719,"_19785":115637,"_5":13558,"_26003":115418,"_2720":115638},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3227":67808,"_28581":67719,"_19785":115640,"_5":13558,"_26003":115418,"_2720":115641},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3227":67809,"_28581":67719,"_19785":115643,"_5":13558,"_26003":115418,"_2720":115644},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3227":67810,"_28581":67719,"_19785":115646,"_5":13558,"_26003":115422,"_2720":115647},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3227":67811,"_28581":67719,"_19785":115649,"_5":13558,"_26003":115422,"_2720":115650},[],"Campos principales:",{"_3227":67812,"_28581":67719,"_19785":115652,"_5":13558,"_26003":115422,"_2720":115653},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3227":67813,"_28581":67719,"_19785":115655,"_5":13558,"_26003":115422,"_2720":115656},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3227":67814,"_28581":67719,"_19785":115658,"_5":13558,"_26003":115422,"_2720":115659},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3227":67815,"_28581":67719,"_19785":115661,"_5":13558,"_26003":115422,"_2720":115662},[],"**Message**: contenido que se va a firmar.",{"_3227":67816,"_28581":67719,"_19785":115664,"_5":13558,"_26003":115422,"_2720":115665},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3227":67817,"_28581":67719,"_19785":115667,"_5":13558,"_26003":115425,"_2720":115668},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3227":67818,"_28581":67719,"_19785":115670,"_5":13558,"_26003":115425,"_2720":115650},[],{"_3227":67819,"_28581":67719,"_19785":115672,"_5":13558,"_26003":115425,"_2720":115673},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3227":67820,"_28581":67719,"_19785":115675,"_5":13558,"_26003":115425,"_2720":115676},[],"**Message Type**: `Raw` o `Digest`.",{"_3227":67821,"_28581":67719,"_19785":115678,"_5":13558,"_26003":115425,"_2720":115679},[],"**Payload Encoding**: codificación del mensaje.",{"_3227":67822,"_28581":67719,"_19785":115681,"_5":13558,"_26003":115425,"_2720":115682},[],"**Message**: mensaje original o hash.",{"_3227":67823,"_28581":67719,"_19785":115684,"_5":13558,"_26003":115425,"_2720":115685},[],"**Signature**: firma que se desea comprobar.",{"_3227":67824,"_28581":67719,"_19785":115687,"_5":13558,"_26003":115425,"_2720":115688},[],"**Result**: indicador del resultado de la validación.",{"_3227":67825,"_28581":67719,"_19785":115690,"_5":13558,"_26003":115428,"_2720":115691},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3227":67826,"_28581":67719,"_19785":115693,"_5":13558,"_26003":115428,"_2720":115694},[],"Este flujo es útil para:",{"_3227":67827,"_28581":67719,"_19785":115696,"_5":13558,"_26003":115428,"_2720":115697},[],"Solicitar certificados a una CA externa.",{"_3227":67828,"_28581":67719,"_19785":115699,"_5":13558,"_26003":115428,"_2720":115700},[],"Renovar una identidad manteniendo la misma clave.",{"_3227":67829,"_28581":67719,"_19785":115702,"_5":13558,"_26003":115428,"_2720":115703},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3227":67830,"_28581":67719,"_19785":115705,"_5":13558,"_26003":115428,"_2720":115706},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3227":67831,"_28581":67719,"_19785":115708,"_5":13558,"_26003":115428,"_2720":115709},[],"**Organization (O)**: organización o empresa.",{"_3227":67832,"_28581":67719,"_19785":115711,"_5":13558,"_26003":115428,"_2720":115712},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3227":67833,"_28581":67719,"_19785":115714,"_5":13558,"_26003":115428,"_2720":115715},[],"**Country (C)**: código de país de dos letras.",{"_3227":67834,"_28581":67719,"_19785":115717,"_5":13558,"_26003":115428,"_2720":115718},[],"**State / Province (ST)**: estado o provincia.",{"_3227":67835,"_28581":67719,"_19785":115720,"_5":13558,"_26003":115428,"_2720":115721},[],"**Locality (L)**: ciudad o localidad.",{"_3227":67836,"_28581":67719,"_19785":115723,"_5":13558,"_26003":115428,"_2720":115724},[],"**Email Address**: correo de contacto.",{"_3227":67837,"_28581":67719,"_19785":115726,"_5":13558,"_26003":115428,"_2720":115727},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3227":67838,"_28581":67719,"_19785":115729,"_5":13558,"_26003":115428,"_2720":115730},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3227":67839,"_28581":67719,"_19785":115732,"_5":13558,"_26003":115432,"_2720":115733},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3227":67840,"_28581":67719,"_19785":115735,"_5":13558,"_26003":115432,"_2720":53301},[],{"_3227":67841,"_28581":67719,"_19785":115737,"_5":13558,"_26003":115436,"_2720":115738},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3227":67842,"_28581":67842,"_5":13916,"_2720":115740,"_28924":115741,"_19785":115742,"_26003":67842},"Validación online con OCSP",[46319,110330,51516,114597],[],{"_3227":67843,"_28581":67842,"_19785":115744,"_5":13558,"_26003":67842,"_2720":115745},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3227":67844,"_28581":67842,"_5":28921,"_19785":115747,"_26003":115748,"_2720":115749},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3227":67845,"_28581":67842,"_5":28921,"_19785":115751,"_26003":115752,"_2720":115753},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3227":67846,"_28581":67842,"_5":28921,"_19785":115755,"_26003":115756,"_2720":115757},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3227":67847,"_28581":67842,"_5":28921,"_19785":115759,"_26003":115760,"_2720":115761},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3227":67848,"_28581":67842,"_5":28921,"_19785":115763,"_26003":115764,"_2720":115765},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3227":67849,"_28581":67842,"_5":28921,"_19785":115767,"_26003":115768,"_2720":115150},[],"/docs/pr-preview/pr-42/es/platform/pki/ocsp#referencias",{"_3227":67850,"_28581":67842,"_19785":115770,"_5":13558,"_26003":67842,"_2720":115771},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3227":67851,"_28581":67842,"_19785":115773,"_5":13558,"_26003":115748,"_2720":115774},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3227":67852,"_28581":67842,"_19785":115776,"_5":13558,"_26003":115748,"_2720":115777},[],"Estado del registro",{"_3227":67853,"_28581":67842,"_19785":115779,"_5":13558,"_26003":115748,"_2720":115780},[],"Respuesta firmada",{"_3227":67854,"_28581":67842,"_19785":115782,"_5":13558,"_26003":115748,"_2720":50685},[],{"_3227":67855,"_28581":67842,"_19785":115784,"_5":13558,"_26003":115748,"_2720":53351},[],{"_3227":67856,"_28581":67842,"_19785":115786,"_5":13558,"_26003":115748,"_2720":50702},[],{"_3227":67857,"_28581":67842,"_19785":115788,"_5":13558,"_26003":115748,"_2720":115789},[],"`Revoked`, con razón y fecha de revocación.",{"_3227":67858,"_28581":67842,"_19785":115791,"_5":13558,"_26003":115748,"_2720":115792},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3227":67859,"_28581":67842,"_19785":115794,"_5":13558,"_26003":115748,"_2720":115795},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3227":67860,"_28581":67842,"_19785":115797,"_5":13558,"_26003":115748,"_2720":115798},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3227":67861,"_28581":67842,"_19785":115800,"_5":13558,"_26003":115748,"_2720":115801},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3227":67862,"_28581":67842,"_19785":115803,"_5":13558,"_26003":115748,"_2720":115804},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3227":67863,"_28581":67842,"_19785":115806,"_5":13558,"_26003":115752,"_2720":115807},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3227":67864,"_28581":67842,"_19785":115809,"_5":13558,"_26003":115752,"_2720":115810},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3227":67865,"_28581":67842,"_19785":115812,"_5":13558,"_26003":115756,"_2720":115813},[],"El servicio acepta:",{"_3227":67866,"_28581":67842,"_19785":115815,"_5":13558,"_26003":115756,"_2720":112054},[],{"_3227":67867,"_28581":67842,"_19785":115817,"_5":13558,"_26003":115756,"_2720":115818},[],"Ruta del servicio VA",{"_3227":67868,"_28581":67842,"_19785":115820,"_5":13558,"_26003":115756,"_2720":115821},[],"Formato",{"_3227":67869,"_28581":67842,"_19785":115823,"_5":13558,"_26003":115756,"_2720":53391},[],{"_3227":67870,"_28581":67842,"_19785":115825,"_5":13558,"_26003":115756,"_2720":53394},[],{"_3227":67871,"_28581":67842,"_19785":115827,"_5":13558,"_26003":115756,"_2720":115828},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3227":67872,"_28581":67842,"_19785":115830,"_5":13558,"_26003":115756,"_2720":52823},[],{"_3227":67873,"_28581":67842,"_19785":115832,"_5":13558,"_26003":115756,"_2720":53402},[],{"_3227":67874,"_28581":67842,"_19785":115834,"_5":13558,"_26003":115756,"_2720":115835},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3227":67875,"_28581":67842,"_19785":115837,"_5":13558,"_26003":115756,"_2720":115838},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3227":67876,"_28581":67842,"_19785":115840,"_5":13558,"_26003":115760,"_2720":115841},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3227":67877,"_28581":67842,"_19785":115843,"_5":13558,"_26003":115760,"_2720":115844},[],"Genera la solicitud:",{"_3227":67878,"_28581":67842,"_19785":115846,"_5":13558,"_26003":115760,"_2720":115847},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3227":67879,"_28581":67842,"_19785":115849,"_5":13558,"_26003":115760,"_2720":115850},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3227":67880,"_28581":67842,"_19785":115852,"_5":13558,"_26003":115760,"_2720":115853},[],"Verifica el DER recibido:",{"_3227":67881,"_28581":67842,"_19785":115855,"_5":13558,"_26003":115760,"_2720":115856},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3227":67882,"_28581":67842,"_19785":115858,"_5":13558,"_26003":115764,"_2720":115859},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3227":67883,"_28581":67842,"_19785":115861,"_5":13558,"_26003":115764,"_2720":115862},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3227":67884,"_28581":67842,"_19785":115864,"_5":13558,"_26003":115768,"_2720":53435},[],{"_3227":67885,"_28581":67842,"_19785":115866,"_5":13558,"_26003":115768,"_2720":53438},[],{"_3227":67886,"_28581":67842,"_19785":115868,"_5":13558,"_26003":115768,"_2720":115869},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3227":67887,"_28581":67842,"_19785":115871,"_5":13558,"_26003":115768,"_2720":115358},[],{"_3227":67888,"_28581":67888,"_5":13916,"_2720":51516,"_28924":115873,"_19785":115874,"_26003":67888},[46319,110330,51516],[],{"_3227":67889,"_28581":67888,"_19785":115876,"_5":13558,"_26003":67888,"_2720":115877},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3227":67890,"_28581":67888,"_5":28921,"_19785":115879,"_26003":115880,"_2720":113296},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#empieza-aquí",{"_3227":67891,"_28581":67888,"_5":28921,"_19785":115882,"_26003":115883,"_2720":115884},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3227":67892,"_28581":67888,"_5":28921,"_19785":115886,"_26003":115887,"_2720":113818},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#capacidades-principales",{"_3227":67893,"_28581":67888,"_5":28921,"_19785":115889,"_26003":115890,"_2720":113822},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3227":67894,"_28581":67888,"_5":28921,"_19785":115892,"_26003":115893,"_2720":113826},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3227":67895,"_28581":67888,"_5":28921,"_19785":115895,"_26003":115896,"_2720":113830},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#emite-y-controla-certificados",{"_3227":67896,"_28581":67888,"_5":28921,"_19785":115898,"_26003":115899,"_2720":113838},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#publica-el-estado-de-validación",{"_3227":67897,"_28581":67888,"_5":28921,"_19785":115901,"_26003":115902,"_2720":115903},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3227":67898,"_28581":67888,"_5":28921,"_19785":115905,"_26003":115906,"_2720":114763},[],"/docs/pr-preview/pr-42/es/platform/pki/overview#continúa",{"_3227":67899,"_28581":67888,"_19785":115908,"_5":13558,"_26003":67888,"_2720":115909},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3227":67900,"_28581":67888,"_19785":115911,"_5":13558,"_26003":115880,"_2720":115912},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3227":67901,"_28581":67888,"_19785":115914,"_5":13558,"_26003":115880,"_2720":115915},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3227":67902,"_28581":67888,"_19785":115917,"_5":13558,"_26003":115883,"_2720":115918},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3227":67903,"_28581":67888,"_19785":115920,"_5":13558,"_26003":115883,"_2720":115921},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3227":67904,"_28581":67888,"_19785":115923,"_5":13558,"_26003":115883,"_2720":115924},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3227":67905,"_28581":67888,"_19785":115926,"_5":13558,"_26003":115883,"_2720":115927},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3227":67906,"_28581":67888,"_19785":115929,"_5":13558,"_26003":115883,"_2720":115930},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3227":67907,"_28581":67888,"_19785":115932,"_5":13558,"_26003":115890,"_2720":115933},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3227":67908,"_28581":67888,"_19785":115935,"_5":13558,"_26003":115893,"_2720":115936},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3227":67909,"_28581":67888,"_19785":115938,"_5":13558,"_26003":115896,"_2720":115939},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3227":67910,"_28581":67888,"_19785":115941,"_5":13558,"_26003":115899,"_2720":115942},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3227":67911,"_28581":67888,"_19785":115944,"_5":13558,"_26003":115902,"_2720":115945},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3227":67912,"_28581":67888,"_19785":115947,"_5":13558,"_26003":115902,"_2720":115948},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3227":67913,"_28581":67888,"_19785":115950,"_5":13558,"_26003":115902,"_2720":115951},[],"su clave pública corresponda a la clave privada del cliente;",{"_3227":67914,"_28581":67888,"_19785":115953,"_5":13558,"_26003":115902,"_2720":115954},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3227":67915,"_28581":67888,"_19785":115956,"_5":13558,"_26003":115902,"_2720":115957},[],"sus fechas y usos permitan la operación;",{"_3227":67916,"_28581":67888,"_19785":115959,"_5":13558,"_26003":115902,"_2720":115960},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3227":67917,"_28581":67888,"_19785":115962,"_5":13558,"_26003":115902,"_2720":115963},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3227":67918,"_28581":67888,"_19785":115965,"_5":13558,"_26003":115906,"_2720":115966},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3227":67919,"_28581":67888,"_19785":115968,"_5":13558,"_26003":115906,"_2720":115969},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3227":67920,"_28581":67888,"_19785":115971,"_5":13558,"_26003":115906,"_2720":115972},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3227":67921,"_28581":67921,"_5":13916,"_2720":115974,"_28924":115975,"_19785":115976,"_26003":67921},"Crea tu primera CA",[46319,110330,51516,113420],[],{"_3227":67922,"_28581":67921,"_19785":115978,"_5":13558,"_26003":67921,"_2720":115979},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3227":67923,"_28581":67921,"_5":28921,"_19785":115981,"_26003":115982,"_2720":108927},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3227":67924,"_28581":67921,"_5":28921,"_19785":115984,"_26003":115985,"_2720":115986},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3227":67925,"_28581":67921,"_5":28921,"_19785":115988,"_26003":115989,"_2720":115990},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3227":67926,"_28581":67921,"_5":28921,"_19785":115992,"_26003":115993,"_2720":115994},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3227":67927,"_28581":67921,"_5":28921,"_19785":115996,"_26003":115997,"_2720":115998},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3227":67928,"_28581":67921,"_5":28921,"_19785":116000,"_26003":116001,"_2720":116002},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3227":67929,"_28581":67921,"_5":28921,"_19785":116004,"_26003":116005,"_2720":116006},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3227":67930,"_28581":67921,"_5":28921,"_19785":116008,"_26003":116009,"_2720":113668},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3227":67931,"_28581":67921,"_5":28921,"_19785":116011,"_26003":116012,"_2720":108951},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3227":67932,"_28581":67921,"_19785":116014,"_5":13558,"_26003":67921,"_2720":116015},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3227":67933,"_28581":67921,"_19785":116017,"_5":13558,"_26003":115982,"_2720":116018},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3227":67934,"_28581":67921,"_19785":116020,"_5":13558,"_26003":115982,"_2720":116021},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3227":67935,"_28581":67921,"_19785":116023,"_5":13558,"_26003":115982,"_2720":116024},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3227":67936,"_28581":67921,"_19785":116026,"_5":13558,"_26003":115982,"_2720":116027},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3227":67937,"_28581":67921,"_19785":116029,"_5":13558,"_26003":115985,"_2720":116030},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3227":67938,"_28581":67921,"_19785":116032,"_5":13558,"_26003":115985,"_2720":116033},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3227":67939,"_28581":67921,"_19785":116035,"_5":13558,"_26003":115989,"_2720":116036},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3227":67940,"_28581":67921,"_19785":116038,"_5":13558,"_26003":115989,"_2720":116039},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3227":67941,"_28581":67921,"_19785":116041,"_5":13558,"_26003":115993,"_2720":116042},[],"Selecciona **Root CA** y completa:",{"_3227":67942,"_28581":67921,"_19785":116044,"_5":13558,"_26003":115993,"_2720":53617},[],{"_3227":67943,"_28581":67921,"_19785":116046,"_5":13558,"_26003":115993,"_2720":116047},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3227":67944,"_28581":67921,"_19785":116049,"_5":13558,"_26003":115993,"_2720":116050},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3227":67945,"_28581":67921,"_19785":116052,"_5":13558,"_26003":115993,"_2720":116053},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3227":67946,"_28581":67921,"_19785":116055,"_5":13558,"_26003":115993,"_2720":116056},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3227":67947,"_28581":67921,"_19785":116058,"_5":13558,"_26003":115997,"_2720":116059},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3227":67948,"_28581":67921,"_19785":116061,"_5":13558,"_26003":116001,"_2720":116062},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3227":67949,"_28581":67921,"_19785":116064,"_5":13558,"_26003":116001,"_2720":116065},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3227":67950,"_28581":67921,"_19785":116067,"_5":13558,"_26003":116005,"_2720":116068},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3227":67951,"_28581":67921,"_19785":116070,"_5":13558,"_26003":116005,"_2720":116071},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3227":67952,"_28581":67921,"_19785":116073,"_5":13558,"_26003":116005,"_2720":116074},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3227":67953,"_28581":67921,"_19785":116076,"_5":13558,"_26003":116009,"_2720":116077},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3227":67954,"_28581":67921,"_19785":116079,"_5":13558,"_26003":116009,"_2720":116080},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3227":67955,"_28581":67921,"_19785":116082,"_5":13558,"_26003":116009,"_2720":116083},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3227":67956,"_28581":67921,"_19785":116085,"_5":13558,"_26003":116009,"_2720":116086},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3227":67957,"_28581":67921,"_19785":116088,"_5":13558,"_26003":116012,"_2720":116089},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3227":67958,"_28581":67958,"_5":13916,"_2720":116091,"_28924":116092,"_19785":116093,"_26003":67958},"Emite y verifica un certificado",[46319,110330,51516,113420],[],{"_3227":67959,"_28581":67958,"_19785":116095,"_5":13558,"_26003":67958,"_2720":116096},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3227":67960,"_28581":67958,"_5":28921,"_19785":116098,"_26003":116099,"_2720":108927},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3227":67961,"_28581":67958,"_5":28921,"_19785":116101,"_26003":116102,"_2720":116103},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3227":67962,"_28581":67958,"_5":28921,"_19785":116105,"_26003":116106,"_2720":116107},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3227":67963,"_28581":67958,"_5":28921,"_19785":116109,"_26003":116110,"_2720":116111},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3227":67964,"_28581":67958,"_5":28921,"_19785":116113,"_26003":116114,"_2720":116115},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3227":67965,"_28581":67958,"_5":28921,"_19785":116117,"_26003":116118,"_2720":116119},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3227":67966,"_28581":67958,"_5":28921,"_19785":116121,"_26003":116122,"_2720":116002},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3227":67967,"_28581":67958,"_5":28921,"_19785":116124,"_26003":116125,"_2720":116126},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3227":67968,"_28581":67958,"_5":28921,"_19785":116128,"_26003":116129,"_2720":116130},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3227":67969,"_28581":67958,"_5":28921,"_19785":116132,"_26003":116133,"_2720":116134},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3227":67970,"_28581":67958,"_5":28921,"_19785":116136,"_26003":116137,"_2720":113668},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3227":67971,"_28581":67958,"_5":28921,"_19785":116139,"_26003":116140,"_2720":108951},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3227":67972,"_28581":67958,"_19785":116142,"_5":13558,"_26003":67958,"_2720":116143},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3227":67973,"_28581":67958,"_19785":116145,"_5":13558,"_26003":116099,"_2720":116146},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3227":67974,"_28581":67958,"_19785":116148,"_5":13558,"_26003":116099,"_2720":116149},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3227":67975,"_28581":67958,"_19785":116151,"_5":13558,"_26003":116099,"_2720":116152},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3227":67976,"_28581":67958,"_19785":116154,"_5":13558,"_26003":116099,"_2720":116155},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3227":67977,"_28581":67958,"_19785":116157,"_5":13558,"_26003":116099,"_2720":116158},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3227":67978,"_28581":67958,"_19785":116160,"_5":13558,"_26003":116102,"_2720":116161},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3227":67979,"_28581":67958,"_19785":116163,"_5":13558,"_26003":116106,"_2720":116164},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3227":67980,"_28581":67958,"_19785":116166,"_5":13558,"_26003":116106,"_2720":116167},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3227":67981,"_28581":67958,"_19785":116169,"_5":13558,"_26003":116110,"_2720":116170},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3227":67982,"_28581":67958,"_19785":116172,"_5":13558,"_26003":116110,"_2720":116173},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3227":67983,"_28581":67958,"_19785":116175,"_5":13558,"_26003":116114,"_2720":116176},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3227":67984,"_28581":67958,"_19785":116178,"_5":13558,"_26003":116114,"_2720":116179},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3227":67985,"_28581":67958,"_19785":116181,"_5":13558,"_26003":116118,"_2720":116182},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3227":67986,"_28581":67958,"_19785":116184,"_5":13558,"_26003":116122,"_2720":116185},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3227":67987,"_28581":67958,"_19785":116187,"_5":13558,"_26003":116125,"_2720":116188},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3227":67988,"_28581":67958,"_19785":116190,"_5":13558,"_26003":116129,"_2720":116191},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3227":67989,"_28581":67958,"_19785":116193,"_5":13558,"_26003":116129,"_2720":116194},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3227":67990,"_28581":67958,"_19785":116196,"_5":13558,"_26003":116129,"_2720":116197},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3227":67991,"_28581":67958,"_19785":116199,"_5":13558,"_26003":116133,"_2720":116200},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3227":67992,"_28581":67958,"_19785":116202,"_5":13558,"_26003":116133,"_2720":116203},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3227":67993,"_28581":67958,"_19785":116205,"_5":13558,"_26003":116133,"_2720":116206},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3227":67994,"_28581":67958,"_19785":116208,"_5":13558,"_26003":116137,"_2720":113751},[],{"_3227":67995,"_28581":67958,"_19785":116210,"_5":13558,"_26003":116137,"_2720":112503},[],{"_3227":67996,"_28581":67958,"_19785":116212,"_5":13558,"_26003":116137,"_2720":116213},[],"La CA rechaza la emisión",{"_3227":67997,"_28581":67958,"_19785":116215,"_5":13558,"_26003":116137,"_2720":116216},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3227":67998,"_28581":67958,"_19785":116218,"_5":13558,"_26003":116137,"_2720":116219},[],"Sujeto o usos diferentes",{"_3227":67999,"_28581":67958,"_19785":116221,"_5":13558,"_26003":116137,"_2720":116222},[],"Perfil aplicado y valores solicitados.",{"_3227":68000,"_28581":67958,"_19785":116224,"_5":13558,"_26003":116137,"_2720":116225},[],"No se encuentra el emisor",{"_3227":68001,"_28581":67958,"_19785":116227,"_5":13558,"_26003":116137,"_2720":116228},[],"CA descargada y cadena intermedia necesaria.",{"_3227":68002,"_28581":67958,"_19785":116230,"_5":13558,"_26003":116137,"_2720":116231},[],"Falla la vigencia",{"_3227":68003,"_28581":67958,"_19785":116233,"_5":13558,"_26003":116137,"_2720":116234},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3227":68004,"_28581":67958,"_19785":116236,"_5":13558,"_26003":116137,"_2720":116237},[],"Los resúmenes de clave difieren",{"_3227":68005,"_28581":67958,"_19785":116239,"_5":13558,"_26003":116137,"_2720":116240},[],"Archivos de certificado y clave de la misma emisión.",{"_3227":68006,"_28581":67958,"_19785":116242,"_5":13558,"_26003":116137,"_2720":116243},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3227":68007,"_28581":67958,"_19785":116245,"_5":13558,"_26003":116140,"_2720":116246},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3227":68008,"_28581":67958,"_19785":116248,"_5":13558,"_26003":116140,"_2720":116249},[],"Gestionar certificados para inspección, estado y revocación.",{"_3227":68009,"_28581":67958,"_19785":116251,"_5":13558,"_26003":116140,"_2720":116252},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3227":68010,"_28581":67958,"_19785":116254,"_5":13558,"_26003":116140,"_2720":116255},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3227":68011,"_28581":67958,"_19785":116257,"_5":13558,"_26003":116140,"_2720":116258},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3227":68012,"_28581":68012,"_5":13916,"_2720":116260,"_28924":116261,"_19785":116262,"_26003":68012},"Primeros pasos de PKI",[46319,110330,51516,113420],[],{"_3227":68013,"_28581":68012,"_19785":116264,"_5":13558,"_26003":68012,"_2720":116265},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3227":68014,"_28581":68012,"_5":28921,"_19785":116267,"_26003":116268,"_2720":108927},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3227":68015,"_28581":68012,"_5":28921,"_19785":116270,"_26003":116271,"_2720":116272},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3227":68016,"_28581":68012,"_5":28921,"_19785":116274,"_26003":116275,"_2720":113602},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3227":68017,"_28581":68012,"_5":28921,"_19785":116277,"_26003":116278,"_2720":116279},[],"/docs/pr-preview/pr-42/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3227":68018,"_28581":68012,"_19785":116281,"_5":13558,"_26003":68012,"_2720":116282},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3227":68019,"_28581":68012,"_19785":116284,"_5":13558,"_26003":116268,"_2720":116285},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3227":68020,"_28581":68012,"_19785":116287,"_5":13558,"_26003":116268,"_2720":116288},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3227":68021,"_28581":68012,"_19785":116290,"_5":13558,"_26003":116268,"_2720":116291},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3227":68022,"_28581":68012,"_19785":116293,"_5":13558,"_26003":116268,"_2720":116294},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3227":68023,"_28581":68012,"_19785":116296,"_5":13558,"_26003":116268,"_2720":116297},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3227":68024,"_28581":68012,"_19785":116299,"_5":13558,"_26003":116271,"_2720":116300},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3227":68025,"_28581":68012,"_19785":116302,"_5":13558,"_26003":116271,"_2720":116303},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3227":68026,"_28581":68012,"_19785":116305,"_5":13558,"_26003":116271,"_2720":116306},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3227":68027,"_28581":68012,"_19785":116308,"_5":13558,"_26003":116271,"_2720":116309},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3227":68028,"_28581":68012,"_19785":116311,"_5":13558,"_26003":116275,"_2720":116312},[],"Archivo o recurso",{"_3227":68029,"_28581":68012,"_19785":116314,"_5":13558,"_26003":116275,"_2720":113599},[],{"_3227":68030,"_28581":68012,"_19785":116316,"_5":13558,"_26003":116275,"_2720":116317},[],"CA raíz activa y `ca.pem`",{"_3227":68031,"_28581":68012,"_19785":116319,"_5":13558,"_26003":116275,"_2720":116320},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3227":68032,"_28581":68012,"_19785":116322,"_5":13558,"_26003":116275,"_2720":116323},[],"Certificado final y `device.crt`",{"_3227":68033,"_28581":68012,"_19785":116325,"_5":13558,"_26003":116275,"_2720":116326},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3227":68034,"_28581":68012,"_19785":116328,"_5":13558,"_26003":116275,"_2720":116329},[],"Clave privada `device.key`",{"_3227":68035,"_28581":68012,"_19785":116331,"_5":13558,"_26003":116275,"_2720":116332},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3227":68036,"_28581":68012,"_19785":116334,"_5":13558,"_26003":116275,"_2720":116335},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3227":68037,"_28581":68012,"_19785":116337,"_5":13558,"_26003":116278,"_2720":116338},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3227":68038,"_28581":68012,"_19785":116340,"_5":13558,"_26003":116278,"_2720":116341},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3227":68039,"_28581":68012,"_19785":116343,"_5":13558,"_26003":116278,"_2720":116344},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3227":68040,"_28581":68040,"_5":13916,"_2720":116346,"_28924":116347,"_19785":116349,"_26003":68040},"Resolución de problemas PKI",[46319,110330,51516,116348],"Resolución de problemas",[],{"_3227":68041,"_28581":68040,"_19785":116351,"_5":13558,"_26003":68040,"_2720":116352},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3227":68042,"_28581":68040,"_5":28921,"_19785":116354,"_26003":116355,"_2720":116356},[],"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3227":68043,"_28581":68040,"_5":28921,"_19785":116358,"_26003":116359,"_2720":116360},[],"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3227":68044,"_28581":68040,"_5":28921,"_19785":116362,"_26003":116363,"_2720":116364},[],"/docs/pr-preview/pr-42/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3227":68045,"_28581":68040,"_19785":116366,"_5":13558,"_26003":68040,"_2720":116367},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3227":68046,"_28581":68040,"_19785":116369,"_5":13558,"_26003":68040,"_2720":116370},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3227":68047,"_28581":68040,"_19785":116372,"_5":13558,"_26003":116355,"_2720":113599},[],{"_3227":68048,"_28581":68040,"_19785":116374,"_5":13558,"_26003":116355,"_2720":112503},[],{"_3227":68049,"_28581":68040,"_19785":116376,"_5":13558,"_26003":116355,"_2720":108951},[],{"_3227":68050,"_28581":68040,"_19785":116378,"_5":13558,"_26003":116355,"_2720":53953},[],{"_3227":68051,"_28581":68040,"_19785":116380,"_5":13558,"_26003":116355,"_2720":116381},[],"Existe, está activa y sus fechas son utilizables.",{"_3227":68052,"_28581":68040,"_19785":116383,"_5":13558,"_26003":116355,"_2720":116384},[],"Autoridades.",{"_3227":68053,"_28581":68040,"_19785":116386,"_5":13558,"_26003":116355,"_2720":116387},[],"Clave",{"_3227":68054,"_28581":68040,"_19785":116389,"_5":13558,"_26003":116355,"_2720":116390},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3227":68055,"_28581":68040,"_19785":116392,"_5":13558,"_26003":116355,"_2720":116393},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3227":68056,"_28581":68040,"_19785":116395,"_5":13558,"_26003":116355,"_2720":53971},[],{"_3227":68057,"_28581":68040,"_19785":116397,"_5":13558,"_26003":116355,"_2720":116398},[],"PEM correcto y firma verificable.",{"_3227":68058,"_28581":68040,"_19785":116400,"_5":13558,"_26003":116355,"_2720":53977},[],{"_3227":68059,"_28581":68040,"_19785":116402,"_5":13558,"_26003":116355,"_2720":116403},[],"Perfil",{"_3227":68060,"_28581":68040,"_19785":116405,"_5":13558,"_26003":116355,"_2720":116406},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3227":68061,"_28581":68040,"_19785":116408,"_5":13558,"_26003":116355,"_2720":116409},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3227":68062,"_28581":68040,"_19785":116411,"_5":13558,"_26003":116355,"_2720":113751},[],{"_3227":68063,"_28581":68040,"_19785":116413,"_5":13558,"_26003":116355,"_2720":116414},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3227":68064,"_28581":68040,"_19785":116416,"_5":13558,"_26003":116355,"_2720":116417},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3227":68065,"_28581":68040,"_19785":116419,"_5":13558,"_26003":116355,"_2720":116420},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3227":68066,"_28581":68040,"_19785":116422,"_5":13558,"_26003":116355,"_2720":116423},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3227":68067,"_28581":68040,"_19785":116425,"_5":13558,"_26003":116359,"_2720":116426},[],"Revisa cada frontera por separado:",{"_3227":68068,"_28581":68040,"_19785":116428,"_5":13558,"_26003":116359,"_2720":116429},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3227":68069,"_28581":68040,"_19785":116431,"_5":13558,"_26003":116359,"_2720":116432},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3227":68070,"_28581":68040,"_19785":116434,"_5":13558,"_26003":116359,"_2720":116435},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3227":68071,"_28581":68040,"_19785":116437,"_5":13558,"_26003":116359,"_2720":116438},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3227":68072,"_28581":68040,"_19785":116440,"_5":13558,"_26003":116359,"_2720":116441},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3227":68073,"_28581":68040,"_19785":116443,"_5":13558,"_26003":116359,"_2720":116444},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3227":68074,"_28581":68040,"_19785":116446,"_5":13558,"_26003":116363,"_2720":116447},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3227":68075,"_28581":68040,"_19785":116449,"_5":13558,"_26003":116363,"_2720":116450},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3227":68076,"_28581":68076,"_5":13916,"_2720":116452,"_28924":116453,"_19785":116455,"_26003":68076},"3.8.0 a 4.0.0",[46319,116454],"Actualizaciones",[],{"_3227":68077,"_28581":68076,"_19785":116457,"_5":13558,"_26003":68076,"_2720":116458},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3227":68078,"_28581":68076,"_5":28921,"_19785":116460,"_26003":116461,"_2720":116462},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3227":68079,"_28581":68076,"_5":28921,"_19785":116464,"_26003":116465,"_2720":116466},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3227":68080,"_28581":68076,"_5":28921,"_19785":116468,"_26003":116469,"_2720":116470},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3227":68081,"_28581":68076,"_5":28921,"_19785":116472,"_26003":116473,"_2720":116474},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3227":68082,"_28581":68076,"_5":28921,"_19785":116476,"_26003":116477,"_2720":116478},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3227":68083,"_28581":68076,"_5":28921,"_19785":116480,"_26003":116481,"_2720":116482},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3227":68084,"_28581":68076,"_5":28921,"_19785":116484,"_26003":116485,"_2720":54063},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3227":68085,"_28581":68076,"_5":28921,"_19785":116487,"_26003":116488,"_2720":116489},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3227":68086,"_28581":68076,"_5":28921,"_19785":116491,"_26003":116492,"_2720":116493},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3227":68087,"_28581":68076,"_5":28921,"_19785":116495,"_26003":116496,"_2720":116497},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3227":68088,"_28581":68076,"_5":28921,"_19785":116499,"_26003":116500,"_2720":116501},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3227":68089,"_28581":68076,"_5":28921,"_19785":116503,"_26003":116504,"_2720":116505},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3227":68090,"_28581":68076,"_5":28921,"_19785":116507,"_26003":116508,"_2720":116509},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3227":68091,"_28581":68076,"_5":28921,"_19785":116511,"_26003":116512,"_2720":116513},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3227":68092,"_28581":68076,"_5":28921,"_19785":116515,"_26003":116516,"_2720":116517},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3227":68093,"_28581":68076,"_5":28921,"_19785":116519,"_26003":116520,"_2720":116521},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3227":68094,"_28581":68076,"_5":28921,"_19785":116523,"_26003":116524,"_2720":116525},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3227":68095,"_28581":68076,"_5":28921,"_19785":116527,"_26003":116528,"_2720":116529},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3227":68096,"_28581":68076,"_5":28921,"_19785":116531,"_26003":116532,"_2720":116533},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3227":68097,"_28581":68076,"_5":28921,"_19785":116535,"_26003":116536,"_2720":116537},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3227":68098,"_28581":68076,"_5":28921,"_19785":116539,"_26003":116540,"_2720":116541},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3227":68099,"_28581":68076,"_5":28921,"_19785":116543,"_26003":116544,"_2720":116545},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3227":68100,"_28581":68076,"_5":28921,"_19785":116547,"_26003":116548,"_2720":116549},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3227":68101,"_28581":68076,"_5":28921,"_19785":116551,"_26003":116552,"_2720":116553},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3227":68102,"_28581":68076,"_5":28921,"_19785":116555,"_26003":116556,"_2720":116557},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3227":68103,"_28581":68076,"_5":28921,"_19785":116559,"_26003":116560,"_2720":116561},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3227":68104,"_28581":68076,"_5":28921,"_19785":116563,"_26003":116564,"_2720":116565},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3227":68105,"_28581":68076,"_5":28921,"_19785":116567,"_26003":116568,"_2720":116569},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3227":68106,"_28581":68076,"_5":28921,"_19785":116571,"_26003":116572,"_2720":116573},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3227":68107,"_28581":68076,"_5":28921,"_19785":116575,"_26003":116576,"_2720":116577},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3227":68108,"_28581":68076,"_5":28921,"_19785":116579,"_26003":116580,"_2720":116581},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3227":68109,"_28581":68076,"_5":28921,"_19785":116583,"_26003":116584,"_2720":116585},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3227":68110,"_28581":68076,"_5":28921,"_19785":116587,"_26003":116588,"_2720":116589},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3227":68111,"_28581":68076,"_5":28921,"_19785":116591,"_26003":116592,"_2720":112825},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3227":68112,"_28581":68076,"_5":28921,"_19785":116594,"_26003":116595,"_2720":116596},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3227":68113,"_28581":68076,"_5":28921,"_19785":116598,"_26003":116599,"_2720":116600},[],"/docs/pr-preview/pr-42/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3227":68114,"_28581":68076,"_19785":116602,"_5":13558,"_26003":68076,"_2720":116603},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3227":68115,"_28581":68076,"_19785":116605,"_5":13558,"_26003":68076,"_2720":116606},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3227":68116,"_28581":68076,"_19785":116608,"_5":13558,"_26003":68076,"_2720":116609},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3227":68117,"_28581":68076,"_19785":116611,"_5":13558,"_26003":68076,"_2720":116612},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3227":68118,"_28581":68076,"_19785":116614,"_5":13558,"_26003":68076,"_2720":116615},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3227":68119,"_28581":68076,"_19785":116617,"_5":13558,"_26003":68076,"_2720":116618},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3227":68120,"_28581":68076,"_19785":116620,"_5":13558,"_26003":68076,"_2720":116621},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3227":68121,"_28581":68076,"_19785":116623,"_5":13558,"_26003":116465,"_2720":116624},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3227":68122,"_28581":68076,"_19785":116626,"_5":13558,"_26003":116465,"_2720":116627},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3227":68123,"_28581":68076,"_19785":116629,"_5":13558,"_26003":116469,"_2720":116630},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3227":68124,"_28581":68076,"_19785":116632,"_5":13558,"_26003":116469,"_2720":116633},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3227":68125,"_28581":68076,"_19785":116635,"_5":13558,"_26003":116473,"_2720":116636},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3227":68126,"_28581":68076,"_19785":116638,"_5":13558,"_26003":116477,"_2720":116639},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3227":68127,"_28581":68076,"_19785":116641,"_5":13558,"_26003":116477,"_2720":116642},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3227":68128,"_28581":68076,"_19785":116644,"_5":13558,"_26003":116477,"_2720":116645},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3227":68129,"_28581":68076,"_19785":116647,"_5":13558,"_26003":116477,"_2720":116648},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3227":68130,"_28581":68076,"_19785":116650,"_5":13558,"_26003":116477,"_2720":116651},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3227":68131,"_28581":68076,"_19785":116653,"_5":13558,"_26003":116481,"_2720":116654},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3227":68132,"_28581":68076,"_19785":116656,"_5":13558,"_26003":116481,"_2720":116657},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3227":68133,"_28581":68076,"_19785":116659,"_5":13558,"_26003":116481,"_2720":116660},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3227":68134,"_28581":68076,"_19785":116662,"_5":13558,"_26003":116481,"_2720":116663},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3227":68135,"_28581":68076,"_19785":116665,"_5":13558,"_26003":116481,"_2720":116666},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3227":68136,"_28581":68076,"_19785":116668,"_5":13558,"_26003":116485,"_2720":116669},[],"Cambio",{"_3227":68137,"_28581":68076,"_19785":116671,"_5":13558,"_26003":116485,"_2720":116672},[],"A quién afecta",{"_3227":68138,"_28581":68076,"_19785":116674,"_5":13558,"_26003":116485,"_2720":116675},[],"Gravedad",{"_3227":68139,"_28581":68076,"_19785":116677,"_5":13558,"_26003":116485,"_2720":115297},[],{"_3227":68140,"_28581":68076,"_19785":116679,"_5":13558,"_26003":116485,"_2720":116493},[],{"_3227":68141,"_28581":68076,"_19785":116681,"_5":13558,"_26003":116485,"_2720":116682},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3227":68142,"_28581":68076,"_19785":116684,"_5":13558,"_26003":116485,"_2720":116685},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3227":68143,"_28581":68076,"_19785":116687,"_5":13558,"_26003":116485,"_2720":116688},[],"Copiar los datos a los volúmenes nuevos",{"_3227":68144,"_28581":68076,"_19785":116690,"_5":13558,"_26003":116485,"_2720":116497},[],{"_3227":68145,"_28581":68076,"_19785":116692,"_5":13558,"_26003":116485,"_2720":116693},[],"Todas las releases de Helm",{"_3227":68146,"_28581":68076,"_19785":116695,"_5":13558,"_26003":116485,"_2720":116696},[],"Alta: `helm upgrade` falla",{"_3227":68147,"_28581":68076,"_19785":116698,"_5":13558,"_26003":116485,"_2720":116699},[],"Eliminar o renombrar las claves heredadas",{"_3227":68148,"_28581":68076,"_19785":116701,"_5":13558,"_26003":116485,"_2720":116501},[],{"_3227":68149,"_28581":68076,"_19785":116703,"_5":13558,"_26003":116485,"_2720":116704},[],"Todos los despliegues",{"_3227":68150,"_28581":68076,"_19785":116706,"_5":13558,"_26003":116485,"_2720":116707},[],"Alta: sin principal de bootstrap no hay administrador",{"_3227":68151,"_28581":68076,"_19785":116709,"_5":13558,"_26003":116485,"_2720":116710},[],"Configurar `services.authz`",{"_3227":68152,"_28581":68076,"_19785":116712,"_5":13558,"_26003":116485,"_2720":116505},[],{"_3227":68153,"_28581":68076,"_19785":116714,"_5":13558,"_26003":116485,"_2720":116693},[],{"_3227":68154,"_28581":68076,"_19785":116716,"_5":13558,"_26003":116485,"_2720":116717},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3227":68155,"_28581":68076,"_19785":116719,"_5":13558,"_26003":116485,"_2720":116720},[],"Mover JWKS y roles a `services.authz`",{"_3227":68156,"_28581":68076,"_19785":116722,"_5":13558,"_26003":116485,"_2720":116525},[],{"_3227":68157,"_28581":68076,"_19785":116724,"_5":13558,"_26003":116485,"_2720":116725},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3227":68158,"_28581":68076,"_19785":116727,"_5":13558,"_26003":116485,"_2720":116728},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3227":68159,"_28581":68076,"_19785":116730,"_5":13558,"_26003":116485,"_2720":116731},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3227":68160,"_28581":68076,"_19785":116733,"_5":13558,"_26003":116485,"_2720":116529},[],{"_3227":68161,"_28581":68076,"_19785":116735,"_5":13558,"_26003":116485,"_2720":116736},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3227":68162,"_28581":68076,"_19785":116738,"_5":13558,"_26003":116485,"_2720":116739},[],"Alta: el backend ya no arranca con ellos",{"_3227":68163,"_28581":68076,"_19785":116741,"_5":13558,"_26003":116485,"_2720":116742},[],"Pasar a PostgreSQL antes de actualizar",{"_3227":68164,"_28581":68076,"_19785":116744,"_5":13558,"_26003":116485,"_2720":116745},[],"Webhooks con referencias a archivos",{"_3227":68165,"_28581":68076,"_19785":116747,"_5":13558,"_26003":116485,"_2720":116748},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3227":68166,"_28581":68076,"_19785":116750,"_5":13558,"_26003":116485,"_2720":116751},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3227":68167,"_28581":68076,"_19785":116753,"_5":13558,"_26003":116485,"_2720":116754},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3227":68168,"_28581":68076,"_19785":116756,"_5":13558,"_26003":116485,"_2720":116509},[],{"_3227":68169,"_28581":68076,"_19785":116758,"_5":13558,"_26003":116485,"_2720":116759},[],"Releases con identidades por servicio o material de claves montado",{"_3227":68170,"_28581":68076,"_19785":116761,"_5":13558,"_26003":116485,"_2720":116762},[],"Media: los servicios no pueden leer sus archivos",{"_3227":68171,"_28581":68076,"_19785":116764,"_5":13558,"_26003":116485,"_2720":116765},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3227":68172,"_28581":68076,"_19785":116767,"_5":13558,"_26003":116485,"_2720":116513},[],{"_3227":68173,"_28581":68076,"_19785":116769,"_5":13558,"_26003":116485,"_2720":116770},[],"Releases que definen `amqp.tls`",{"_3227":68174,"_28581":68076,"_19785":116772,"_5":13558,"_26003":116485,"_2720":116773},[],"Media: los clientes se conectan al puerto equivocado",{"_3227":68175,"_28581":68076,"_19785":116775,"_5":13558,"_26003":116485,"_2720":116776},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3227":68176,"_28581":68076,"_19785":116778,"_5":13558,"_26003":116485,"_2720":116533},[],{"_3227":68177,"_28581":68076,"_19785":116780,"_5":13558,"_26003":116485,"_2720":116781},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3227":68178,"_28581":68076,"_19785":116783,"_5":13558,"_26003":116485,"_2720":116784},[],"Media: las claves de CA quedan sin gestionar",{"_3227":68179,"_28581":68076,"_19785":116786,"_5":13558,"_26003":116485,"_2720":116787},[],"Ejecutar la migración de CA a KMS",{"_3227":68180,"_28581":68076,"_19785":116789,"_5":13558,"_26003":116485,"_2720":116790},[],"Verificación del certificado del receptor",{"_3227":68181,"_28581":68076,"_19785":116792,"_5":13558,"_26003":116485,"_2720":116793},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3227":68182,"_28581":68076,"_19785":116795,"_5":13558,"_26003":116485,"_2720":116796},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3227":68183,"_28581":68076,"_19785":116798,"_5":13558,"_26003":116485,"_2720":116799},[],"Poner `insecure_skip_verify` a `false`",{"_3227":68184,"_28581":68076,"_19785":116801,"_5":13558,"_26003":116485,"_2720":116545},[],{"_3227":68185,"_28581":68076,"_19785":116803,"_5":13558,"_26003":116485,"_2720":116804},[],"Scripts y consolas que editan DMS por API",{"_3227":68186,"_28581":68076,"_19785":116806,"_5":13558,"_26003":116485,"_2720":116807},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3227":68187,"_28581":68076,"_19785":116809,"_5":13558,"_26003":116485,"_2720":116810},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3227":68188,"_28581":68076,"_19785":116812,"_5":13558,"_26003":116485,"_2720":116561},[],{"_3227":68189,"_28581":68076,"_19785":116814,"_5":13558,"_26003":116485,"_2720":116815},[],"Consumidores que leen el campo `events` del dispositivo",{"_3227":68190,"_28581":68076,"_19785":116817,"_5":13558,"_26003":116485,"_2720":116818},[],"Media: el campo desaparece",{"_3227":68191,"_28581":68076,"_19785":116820,"_5":13558,"_26003":116485,"_2720":116821},[],"Usar los nuevos endpoints de eventos",{"_3227":68192,"_28581":68076,"_19785":116823,"_5":13558,"_26003":116485,"_2720":116517},[],{"_3227":68193,"_28581":68076,"_19785":116825,"_5":13558,"_26003":116485,"_2720":116826},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3227":68194,"_28581":68076,"_19785":116828,"_5":13558,"_26003":116485,"_2720":116829},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3227":68195,"_28581":68076,"_19785":116831,"_5":13558,"_26003":116485,"_2720":116832},[],"Actualizar el archivo de values",{"_3227":68196,"_28581":68076,"_19785":116834,"_5":13558,"_26003":116485,"_2720":116553},[],{"_3227":68197,"_28581":68076,"_19785":116836,"_5":13558,"_26003":116485,"_2720":116837},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3227":68198,"_28581":68076,"_19785":116839,"_5":13558,"_26003":116485,"_2720":116840},[],"Baja: prevalece el ID de la URL",{"_3227":68199,"_28581":68076,"_19785":116842,"_5":13558,"_26003":116485,"_2720":116843},[],"Enviar el ID en la URL",{"_3227":68200,"_28581":68076,"_19785":116845,"_5":13558,"_26003":116485,"_2720":116557},[],{"_3227":68201,"_28581":68076,"_19785":116847,"_5":13558,"_26003":116485,"_2720":116848},[],"Consumidores que comparan el `type` del certificado",{"_3227":68202,"_28581":68076,"_19785":116850,"_5":13558,"_26003":116485,"_2720":116851},[],"Baja: dos valores cambian de nombre",{"_3227":68203,"_28581":68076,"_19785":116853,"_5":13558,"_26003":116485,"_2720":116854},[],"Adaptar los consumidores",{"_3227":68204,"_28581":68076,"_19785":116856,"_5":13558,"_26003":116485,"_2720":116549},[],{"_3227":68205,"_28581":68076,"_19785":116858,"_5":13558,"_26003":116485,"_2720":116859},[],"Cualquier DMS",{"_3227":68206,"_28581":68076,"_19785":116861,"_5":13558,"_26003":116485,"_2720":116862},[],"Baja: solo informativo",{"_3227":68207,"_28581":68076,"_19785":116864,"_5":13558,"_26003":116485,"_2720":116865},[],"Revisar ambos bloques antes de editar",{"_3227":68208,"_28581":68076,"_19785":116867,"_5":13558,"_26003":116492,"_2720":116868},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3227":68209,"_28581":68076,"_19785":116870,"_5":13558,"_26003":116492,"_2720":116871},[],"El paso 4 de la guía de migración copia los datos.",{"_3227":68210,"_28581":68076,"_19785":116873,"_5":13558,"_26003":116496,"_2720":116874},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3227":68211,"_28581":68076,"_19785":116876,"_5":13558,"_26003":116500,"_2720":116877},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3227":68212,"_28581":68076,"_19785":116879,"_5":13558,"_26003":116504,"_2720":116880},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3227":68213,"_28581":68076,"_19785":116882,"_5":13558,"_26003":116508,"_2720":116883},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3227":68214,"_28581":68076,"_19785":116885,"_5":13558,"_26003":116508,"_2720":116886},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3227":68215,"_28581":68076,"_19785":116888,"_5":13558,"_26003":116512,"_2720":116889},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3227":68216,"_28581":68076,"_19785":116891,"_5":13558,"_26003":116516,"_2720":116892},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3227":68217,"_28581":68076,"_19785":116894,"_5":13558,"_26003":116516,"_2720":116895},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3227":68218,"_28581":68076,"_19785":116897,"_5":13558,"_26003":116516,"_2720":116898},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3227":68219,"_28581":68076,"_19785":116900,"_5":13558,"_26003":116516,"_2720":116901},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3227":68220,"_28581":68076,"_19785":116903,"_5":13558,"_26003":116516,"_2720":116904},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3227":68221,"_28581":68076,"_19785":116906,"_5":13558,"_26003":116516,"_2720":116907},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3227":68222,"_28581":68076,"_19785":116909,"_5":13558,"_26003":116524,"_2720":116910},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3227":68223,"_28581":68076,"_19785":116912,"_5":13558,"_26003":116524,"_2720":116913},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3227":68224,"_28581":68076,"_19785":116915,"_5":13558,"_26003":116524,"_2720":116916},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3227":68225,"_28581":68076,"_19785":116918,"_5":13558,"_26003":116524,"_2720":116919},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3227":68226,"_28581":68076,"_19785":116921,"_5":13558,"_26003":116524,"_2720":116922},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3227":68227,"_28581":68076,"_19785":116924,"_5":13558,"_26003":116528,"_2720":116925},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3227":68228,"_28581":68076,"_19785":116927,"_5":13558,"_26003":116532,"_2720":116928},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3227":68229,"_28581":68076,"_19785":116930,"_5":13558,"_26003":116532,"_2720":116931},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3227":68230,"_28581":68076,"_19785":116933,"_5":13558,"_26003":116532,"_2720":116934},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3227":68231,"_28581":68076,"_19785":116936,"_5":13558,"_26003":116532,"_2720":116937},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3227":68232,"_28581":68076,"_19785":116939,"_5":13558,"_26003":116532,"_2720":116940},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3227":68233,"_28581":68076,"_19785":116942,"_5":13558,"_26003":116532,"_2720":116943},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3227":68234,"_28581":68076,"_19785":116945,"_5":13558,"_26003":116540,"_2720":116946},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3227":68235,"_28581":68076,"_19785":116948,"_5":13558,"_26003":116540,"_2720":116949},[],"Campo en 3.8.0",{"_3227":68236,"_28581":68076,"_19785":116951,"_5":13558,"_26003":116540,"_2720":116952},[],"Campo en 4.0.0",{"_3227":68237,"_28581":68076,"_19785":116954,"_5":13558,"_26003":116540,"_2720":54533},[],{"_3227":68238,"_28581":68076,"_19785":116956,"_5":13558,"_26003":116540,"_2720":116957},[],"`insecure_skip_verify` (con el valor negado)",{"_3227":68239,"_28581":68076,"_19785":116959,"_5":13558,"_26003":116540,"_2720":54539},[],{"_3227":68240,"_28581":68076,"_19785":116961,"_5":13558,"_26003":116540,"_2720":54542},[],{"_3227":68241,"_28581":68076,"_19785":116963,"_5":13558,"_26003":116540,"_2720":54545},[],{"_3227":68242,"_28581":68076,"_19785":116965,"_5":13558,"_26003":116540,"_2720":54548},[],{"_3227":68243,"_28581":68076,"_19785":116967,"_5":13558,"_26003":116540,"_2720":54551},[],{"_3227":68244,"_28581":68076,"_19785":116969,"_5":13558,"_26003":116540,"_2720":54554},[],{"_3227":68245,"_28581":68076,"_19785":116971,"_5":13558,"_26003":116540,"_2720":116972},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3227":68246,"_28581":68076,"_19785":116974,"_5":13558,"_26003":116540,"_2720":116975},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3227":68247,"_28581":68076,"_19785":116977,"_5":13558,"_26003":116540,"_2720":116978},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3227":68248,"_28581":68076,"_19785":116980,"_5":13558,"_26003":116544,"_2720":116981},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3227":68249,"_28581":68076,"_19785":116983,"_5":13558,"_26003":116544,"_2720":116984},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3227":68250,"_28581":68076,"_19785":116986,"_5":13558,"_26003":116544,"_2720":116987},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3227":68251,"_28581":68076,"_19785":116989,"_5":13558,"_26003":116548,"_2720":116990},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3227":68252,"_28581":68076,"_19785":116992,"_5":13558,"_26003":116552,"_2720":116993},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3227":68253,"_28581":68076,"_19785":116995,"_5":13558,"_26003":116556,"_2720":116996},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3227":68254,"_28581":68076,"_19785":116998,"_5":13558,"_26003":116560,"_2720":116999},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3227":68255,"_28581":68076,"_19785":117001,"_5":13558,"_26003":116560,"_2720":117002},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3227":68256,"_28581":68076,"_19785":117004,"_5":13558,"_26003":116560,"_2720":117005},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3227":68257,"_28581":68076,"_19785":117007,"_5":13558,"_26003":116560,"_2720":117008},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3227":68258,"_28581":68076,"_19785":117010,"_5":13558,"_26003":116564,"_2720":117011},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3227":68259,"_28581":68076,"_19785":117013,"_5":13558,"_26003":116568,"_2720":117014},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3227":68260,"_28581":68076,"_19785":117016,"_5":13558,"_26003":116568,"_2720":117017},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3227":68261,"_28581":68076,"_19785":117019,"_5":13558,"_26003":116568,"_2720":117020},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3227":68262,"_28581":68076,"_19785":117022,"_5":13558,"_26003":116568,"_2720":117023},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3227":68263,"_28581":68076,"_19785":117025,"_5":13558,"_26003":116568,"_2720":117026},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3227":68264,"_28581":68076,"_19785":117028,"_5":13558,"_26003":116572,"_2720":117029},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3227":68265,"_28581":68076,"_19785":117031,"_5":13558,"_26003":116572,"_2720":117032},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3227":68266,"_28581":68076,"_19785":117034,"_5":13558,"_26003":116572,"_2720":117035},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3227":68267,"_28581":68076,"_19785":117037,"_5":13558,"_26003":116572,"_2720":117038},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3227":68268,"_28581":68076,"_19785":117040,"_5":13558,"_26003":116572,"_2720":117041},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3227":68269,"_28581":68076,"_19785":117043,"_5":13558,"_26003":116572,"_2720":117044},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3227":68270,"_28581":68076,"_19785":117046,"_5":13558,"_26003":116572,"_2720":117047},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3227":68271,"_28581":68076,"_19785":117049,"_5":13558,"_26003":116572,"_2720":117050},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3227":68272,"_28581":68076,"_19785":117052,"_5":13558,"_26003":116572,"_2720":117053},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3227":68273,"_28581":68076,"_19785":117055,"_5":13558,"_26003":116572,"_2720":117056},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3227":68274,"_28581":68076,"_19785":117058,"_5":13558,"_26003":116572,"_2720":117059},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3227":68275,"_28581":68076,"_19785":117061,"_5":13558,"_26003":116572,"_2720":117062},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3227":68276,"_28581":68076,"_19785":117064,"_5":13558,"_26003":116576,"_2720":117065},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3227":68277,"_28581":68076,"_19785":117067,"_5":13558,"_26003":116576,"_2720":117068},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3227":68278,"_28581":68076,"_19785":117070,"_5":13558,"_26003":116580,"_2720":117071},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3227":68279,"_28581":68076,"_19785":117073,"_5":13558,"_26003":116580,"_2720":117074},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3227":68280,"_28581":68076,"_19785":117076,"_5":13558,"_26003":116580,"_2720":117077},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3227":68281,"_28581":68076,"_19785":117079,"_5":13558,"_26003":116580,"_2720":117080},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3227":68282,"_28581":68076,"_19785":117082,"_5":13558,"_26003":116580,"_2720":117083},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3227":68283,"_28581":68076,"_19785":117085,"_5":13558,"_26003":116580,"_2720":117086},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3227":68284,"_28581":68076,"_19785":117088,"_5":13558,"_26003":116580,"_2720":117089},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3227":68285,"_28581":68076,"_19785":117091,"_5":13558,"_26003":116580,"_2720":117092},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3227":68286,"_28581":68076,"_19785":117094,"_5":13558,"_26003":116580,"_2720":117095},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3227":68287,"_28581":68076,"_19785":117097,"_5":13558,"_26003":116580,"_2720":117098},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3227":68288,"_28581":68076,"_19785":117100,"_5":13558,"_26003":116580,"_2720":117101},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3227":68289,"_28581":68076,"_19785":117103,"_5":13558,"_26003":116584,"_2720":117104},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3227":68290,"_28581":68076,"_19785":117106,"_5":13558,"_26003":116584,"_2720":117107},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3227":68291,"_28581":68076,"_19785":117109,"_5":13558,"_26003":116588,"_2720":117110},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3227":68292,"_28581":68076,"_19785":117112,"_5":13558,"_26003":116588,"_2720":117113},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3227":68293,"_28581":68076,"_19785":117115,"_5":13558,"_26003":116588,"_2720":117116},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3227":68294,"_28581":68076,"_19785":117118,"_5":13558,"_26003":116588,"_2720":117119},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3227":68295,"_28581":68076,"_19785":117121,"_5":13558,"_26003":116588,"_2720":117122},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3227":68296,"_28581":68076,"_19785":117124,"_5":13558,"_26003":116592,"_2720":117125},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3227":68297,"_28581":68076,"_19785":117127,"_5":13558,"_26003":116592,"_2720":117128},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3227":68298,"_28581":68076,"_19785":117130,"_5":13558,"_26003":116592,"_2720":117131},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3227":68299,"_28581":68076,"_19785":117133,"_5":13558,"_26003":116592,"_2720":117134},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3227":68300,"_28581":68076,"_19785":117136,"_5":13558,"_26003":116592,"_2720":117137},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3227":68301,"_28581":68076,"_19785":117139,"_5":13558,"_26003":116592,"_2720":117140},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3227":68302,"_28581":68076,"_19785":117142,"_5":13558,"_26003":116592,"_2720":117143},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3227":68303,"_28581":68076,"_19785":117145,"_5":13558,"_26003":116595,"_2720":117146},[],"Tras la actualización, comprueba en este orden:",{"_3227":68304,"_28581":68076,"_19785":117148,"_5":13558,"_26003":116595,"_2720":117149},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3227":68305,"_28581":68076,"_19785":117151,"_5":13558,"_26003":116595,"_2720":117152},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3227":68306,"_28581":68076,"_19785":117154,"_5":13558,"_26003":116595,"_2720":117155},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3227":68307,"_28581":68076,"_19785":117157,"_5":13558,"_26003":116595,"_2720":117158},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3227":68308,"_28581":68076,"_19785":117160,"_5":13558,"_26003":116595,"_2720":117161},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3227":68309,"_28581":68076,"_19785":117163,"_5":13558,"_26003":116595,"_2720":117164},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3227":68310,"_28581":68076,"_19785":117166,"_5":13558,"_26003":116595,"_2720":117167},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3227":68311,"_28581":68076,"_19785":117169,"_5":13558,"_26003":116595,"_2720":117170},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3227":68312,"_28581":68076,"_19785":117172,"_5":13558,"_26003":116595,"_2720":117173},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3227":68313,"_28581":68076,"_19785":117175,"_5":13558,"_26003":116595,"_2720":117176},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3227":68314,"_28581":68076,"_19785":117178,"_5":13558,"_26003":116595,"_2720":117179},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3227":68315,"_28581":68076,"_19785":117181,"_5":13558,"_26003":116595,"_2720":117182},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3227":68316,"_28581":68076,"_19785":117184,"_5":13558,"_26003":116595,"_2720":117185},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3227":68317,"_28581":68076,"_19785":117187,"_5":13558,"_26003":116595,"_2720":117188},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3227":68318,"_28581":68076,"_19785":117190,"_5":13558,"_26003":116599,"_2720":117191},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3227":68319,"_28581":68076,"_19785":117193,"_5":13558,"_26003":116599,"_2720":117194},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3227":68320,"_28581":68076,"_19785":117196,"_5":13558,"_26003":116599,"_2720":117197},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3227":68321,"_28581":68076,"_19785":117199,"_5":13558,"_26003":116599,"_2720":117200},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3227":68322,"_28581":68076,"_19785":117202,"_5":13558,"_26003":116599,"_2720":117203},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot