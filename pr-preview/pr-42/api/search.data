"_33849":48523,"_33851":48526,"_33853":48529,"_33855":48532,"_33857":48535,"_33859":48538,"_33861":48541,"_33863":48544,"_33865":48546,"_33867":48549,"_33869":48552,"_33871":48555,"_33873":48558,"_33875":48561,"_33877":48564,"_33879":48567,"_33881":48570,"_33883":48573,"_33885":48576,"_33887":48579,"_33889":48582},{"_2872":15,"_25347":15,"_5":12438,"_2399":41102,"_25683":41103,"_17690":41107,"_23966":15},"Deploy from AWS Marketplace",[41104,41105,41106],"Docs","Deployment","Other models",[],{"_2872":16,"_25347":15,"_17690":41109,"_5":17585,"_23966":15,"_2399":41110},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2872":17,"_25347":15,"_5":25680,"_17690":41112,"_23966":41113,"_2399":41114},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2872":18,"_25347":15,"_5":25680,"_17690":41116,"_23966":41117,"_2399":41118},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2872":19,"_25347":15,"_5":25680,"_17690":41120,"_23966":41121,"_2399":41122},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2872":20,"_25347":15,"_5":25680,"_17690":41124,"_23966":41125,"_2399":41126},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2872":21,"_25347":15,"_5":25680,"_17690":41128,"_23966":41129,"_2399":41130},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2872":22,"_25347":15,"_5":25680,"_17690":41132,"_23966":41133,"_2399":41134},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2872":23,"_25347":15,"_5":25680,"_17690":41136,"_23966":41137,"_2399":41138},[],"/docs/pr-preview/pr-42/deployment/aws-marketplace#next-step","Next step",{"_2872":24,"_25347":15,"_17690":41140,"_5":17585,"_23966":15,"_2399":41141},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2872":25,"_25347":15,"_17690":41143,"_5":17585,"_23966":41113,"_2399":41144},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2872":26,"_25347":15,"_17690":41146,"_5":17585,"_23966":41113,"_2399":41147},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2872":27,"_25347":15,"_17690":41149,"_5":17585,"_23966":41113,"_2399":41150},[],"A security group allowing the necessary endpoints.",{"_2872":28,"_25347":15,"_17690":41152,"_5":17585,"_23966":41117,"_2399":41153},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2872":29,"_25347":15,"_17690":41155,"_5":17585,"_23966":41117,"_2399":41156},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2872":30,"_25347":15,"_17690":41158,"_5":17585,"_23966":41117,"_2399":41159},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2872":31,"_25347":15,"_17690":41161,"_5":17585,"_23966":41121,"_2399":41162},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2872":32,"_25347":15,"_17690":41164,"_5":17585,"_23966":41125,"_2399":41165},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2872":33,"_25347":15,"_17690":41167,"_5":17585,"_23966":41129,"_2399":41168},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2872":34,"_25347":15,"_17690":41170,"_5":17585,"_23966":41133,"_2399":41171},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2872":35,"_25347":15,"_17690":41173,"_5":17585,"_23966":41137,"_2399":41174},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2872":36,"_25347":36,"_5":12438,"_2399":41176,"_25683":41177,"_17690":41178,"_23966":36},"Deploy Lamassu",[41104,41105],[],{"_2872":37,"_25347":36,"_17690":41180,"_5":17585,"_23966":36,"_2399":41181},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2872":38,"_25347":36,"_5":25680,"_17690":41183,"_23966":41184,"_2399":41185},[],"/docs/pr-preview/pr-42/deployment/overview#choose-a-model","Choose a model",{"_2872":39,"_25347":36,"_5":25680,"_17690":41187,"_23966":41188,"_2399":41189},[],"/docs/pr-preview/pr-42/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2872":40,"_25347":36,"_5":25680,"_17690":41191,"_23966":41192,"_2399":41193},[],"/docs/pr-preview/pr-42/deployment/overview#after-deployment","After deployment",{"_2872":41,"_25347":36,"_17690":41195,"_5":17585,"_23966":36,"_2399":41196},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2872":42,"_25347":36,"_17690":41198,"_5":17585,"_23966":41184,"_2399":41199},[],"Model",{"_2872":43,"_25347":36,"_17690":41201,"_5":17585,"_23966":41184,"_2399":41202},[],"Recommended for",{"_2872":44,"_25347":36,"_17690":41204,"_5":17585,"_23966":41184,"_2399":41205},[],"Who operates the infrastructure",{"_2872":45,"_25347":36,"_17690":41207,"_5":17585,"_23966":41184,"_2399":41208},[],"Starting point",{"_2872":46,"_25347":36,"_17690":41210,"_5":17585,"_23966":41184,"_2399":41211},[],"Kubernetes self-managed",{"_2872":47,"_25347":36,"_17690":41213,"_5":17585,"_23966":41184,"_2399":41214},[],"Production, regulated environments and custom deployments",{"_2872":48,"_25347":36,"_17690":41216,"_5":17585,"_23966":41184,"_2399":41217},[],"Your team",{"_2872":49,"_25347":36,"_17690":41219,"_5":17585,"_23966":41184,"_2399":41220},[],"Helm or Fastlane",{"_2872":50,"_25347":36,"_17690":41222,"_5":17585,"_23966":41184,"_2399":41223},[],"AWS Marketplace",{"_2872":51,"_25347":36,"_17690":41225,"_5":17585,"_23966":41184,"_2399":41226},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2872":52,"_25347":36,"_17690":41228,"_5":17585,"_23966":41184,"_2399":41217},[],{"_2872":53,"_25347":36,"_17690":41230,"_5":17585,"_23966":41184,"_2399":41231},[],"Preconfigured image on EC2",{"_2872":54,"_25347":36,"_17690":41233,"_5":17585,"_23966":41184,"_2399":41234},[],"SaaS",{"_2872":55,"_25347":36,"_17690":41236,"_5":17585,"_23966":41184,"_2399":41237},[],"Teams that want to use the platform without operating it",{"_2872":56,"_25347":36,"_17690":41239,"_5":17585,"_23966":41184,"_2399":41240},[],"Lamassu",{"_2872":57,"_25347":36,"_17690":41242,"_5":17585,"_23966":41184,"_2399":41243},[],"Managed subscription",{"_2872":58,"_25347":36,"_17690":41245,"_5":17585,"_23966":41184,"_2399":41246},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2872":59,"_25347":36,"_17690":41248,"_5":17585,"_23966":41184,"_2399":41249},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2872":60,"_25347":36,"_17690":41251,"_5":17585,"_23966":41184,"_2399":41252},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2872":61,"_25347":36,"_17690":41254,"_5":17585,"_23966":41188,"_2399":41255},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2872":62,"_25347":36,"_17690":41257,"_5":17585,"_23966":41192,"_2399":41258},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2872":63,"_25347":63,"_5":12438,"_2399":41260,"_25683":41261,"_17690":41262,"_23966":63},"Use Lamassu as SaaS",[41104,41105,41106],[],{"_2872":64,"_25347":63,"_17690":41264,"_5":17585,"_23966":63,"_2399":41265},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2872":65,"_25347":63,"_5":25680,"_17690":41267,"_23966":41268,"_2399":41269},[],"/docs/pr-preview/pr-42/deployment/saas#what-the-service-manages","What the service manages",{"_2872":66,"_25347":63,"_5":25680,"_17690":41271,"_23966":41272,"_2399":41273},[],"/docs/pr-preview/pr-42/deployment/saas#plans","Plans",{"_2872":67,"_25347":63,"_5":25680,"_17690":41275,"_23966":41276,"_2399":41277},[],"/docs/pr-preview/pr-42/deployment/saas#request-access","Request access",{"_2872":68,"_25347":63,"_17690":41279,"_5":17585,"_23966":63,"_2399":41280},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2872":69,"_25347":63,"_17690":41282,"_5":17585,"_23966":41268,"_2399":41283},[],"Platform availability and maintenance.",{"_2872":70,"_25347":63,"_17690":41285,"_5":17585,"_23966":41268,"_2399":41286},[],"Automatic backups.",{"_2872":71,"_25347":63,"_17690":41288,"_5":17585,"_23966":41268,"_2399":41289},[],"Version upgrades.",{"_2872":72,"_25347":63,"_17690":41291,"_5":17585,"_23966":41268,"_2399":41292},[],"Technical support and SLA according to your plan.",{"_2872":73,"_25347":63,"_17690":41294,"_5":17585,"_23966":41272,"_2399":41295},[],"Plan",{"_2872":74,"_25347":63,"_17690":41297,"_5":17585,"_23966":41272,"_2399":41298},[],"Devices",{"_2872":75,"_25347":63,"_17690":41300,"_5":17585,"_23966":41272,"_2399":41301},[],"Support",{"_2872":76,"_25347":63,"_17690":41303,"_5":17585,"_23966":41272,"_2399":41304},[],"SLA",{"_2872":77,"_25347":63,"_17690":41306,"_5":17585,"_23966":41272,"_2399":41307},[],"Starter",{"_2872":78,"_25347":63,"_17690":41309,"_5":17585,"_23966":41272,"_2399":41310},[],"Up to 1,000",{"_2872":79,"_25347":63,"_17690":41312,"_5":17585,"_23966":41272,"_2399":41313},[],"Email",{"_2872":80,"_25347":63,"_17690":41315,"_5":17585,"_23966":41272,"_2399":41316},[],"99.5 %",{"_2872":81,"_25347":63,"_17690":41318,"_5":17585,"_23966":41272,"_2399":41319},[],"Professional",{"_2872":82,"_25347":63,"_17690":41321,"_5":17585,"_23966":41272,"_2399":41322},[],"Up to 10,000",{"_2872":83,"_25347":63,"_17690":41324,"_5":17585,"_23966":41272,"_2399":41325},[],"Email and chat",{"_2872":84,"_25347":63,"_17690":41327,"_5":17585,"_23966":41272,"_2399":41328},[],"99.9 %",{"_2872":85,"_25347":63,"_17690":41330,"_5":17585,"_23966":41272,"_2399":41331},[],"Enterprise",{"_2872":86,"_25347":63,"_17690":41333,"_5":17585,"_23966":41272,"_2399":41334},[],"Unlimited",{"_2872":87,"_25347":63,"_17690":41336,"_5":17585,"_23966":41272,"_2399":41337},[],"Dedicated",{"_2872":88,"_25347":63,"_17690":41339,"_5":17585,"_23966":41272,"_2399":41340},[],"99.99 %",{"_2872":89,"_25347":63,"_17690":41342,"_5":17585,"_23966":41276,"_2399":41343},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2872":90,"_25347":63,"_17690":41345,"_5":17585,"_23966":41276,"_2399":41346},[],"When you receive your instance's credentials, continue with Get started.",{"_2872":91,"_25347":91,"_5":12438,"_2399":41348,"_25683":41349,"_17690":41350,"_23966":91},"Fastlane",[41104,41105,41211],[],{"_2872":92,"_25347":91,"_17690":41352,"_5":17585,"_23966":91,"_2399":41353},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2872":93,"_25347":91,"_5":25680,"_17690":41355,"_23966":41356,"_2399":41357},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2872":94,"_25347":91,"_5":25680,"_17690":41359,"_23966":41360,"_2399":41361},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2872":95,"_25347":91,"_5":25680,"_17690":41363,"_23966":41364,"_2399":41114},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#before-you-begin",{"_2872":96,"_25347":91,"_5":25680,"_17690":41366,"_23966":41367,"_2399":41368},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2872":97,"_25347":91,"_5":25680,"_17690":41370,"_23966":41371,"_2399":41372},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2872":98,"_25347":91,"_5":25680,"_17690":41374,"_23966":41375,"_2399":41376},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2872":99,"_25347":91,"_5":25680,"_17690":41378,"_23966":41379,"_2399":41380},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2872":100,"_25347":91,"_5":25680,"_17690":41382,"_23966":41383,"_2399":41384},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2872":101,"_25347":91,"_5":25680,"_17690":41386,"_23966":41387,"_2399":41388},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2872":102,"_25347":91,"_5":25680,"_17690":41390,"_23966":41391,"_2399":41392},[],"/docs/pr-preview/pr-42/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2872":103,"_25347":91,"_17690":41394,"_5":17585,"_23966":41356,"_2399":41395},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2872":104,"_25347":91,"_17690":41397,"_5":17585,"_23966":41356,"_2399":41398},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2872":105,"_25347":91,"_17690":41400,"_5":17585,"_23966":41360,"_2399":41401},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2872":106,"_25347":91,"_17690":41403,"_5":17585,"_23966":41360,"_2399":41404},[],"Fastlane installs or configures",{"_2872":107,"_25347":91,"_17690":41406,"_5":17585,"_23966":41360,"_2399":41407},[],"You still provide",{"_2872":108,"_25347":91,"_17690":41409,"_5":17585,"_23966":41360,"_2399":41410},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2872":109,"_25347":91,"_17690":41412,"_5":17585,"_23966":41360,"_2399":41413},[],"The Kubernetes cluster, nodes and persistent storage",{"_2872":110,"_25347":91,"_17690":41415,"_5":17585,"_23966":41360,"_2399":41416},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2872":111,"_25347":91,"_17690":41418,"_5":17585,"_23966":41360,"_2399":41419},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2872":112,"_25347":91,"_17690":41421,"_5":17585,"_23966":41360,"_2399":41422},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2872":113,"_25347":91,"_17690":41424,"_5":17585,"_23966":41360,"_2399":41425},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2872":114,"_25347":91,"_17690":41427,"_5":17585,"_23966":41360,"_2399":41428},[],"Optional observability and lab HSM components",{"_2872":115,"_25347":91,"_17690":41430,"_5":17585,"_23966":41360,"_2399":41431},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2872":116,"_25347":91,"_17690":41433,"_5":17585,"_23966":41360,"_2399":41434},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2872":117,"_25347":91,"_17690":41436,"_5":17585,"_23966":41364,"_2399":41437},[],"You need:",{"_2872":118,"_25347":91,"_17690":41439,"_5":17585,"_23966":41364,"_2399":41440},[],"an existing Kubernetes cluster",{"_2872":119,"_25347":91,"_17690":41442,"_5":17585,"_23966":41364,"_2399":41443},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2872":120,"_25347":91,"_17690":41445,"_5":17585,"_23966":41364,"_2399":41446},[],"`yq`",{"_2872":121,"_25347":91,"_17690":41448,"_5":17585,"_23966":41364,"_2399":20004},[],{"_2872":122,"_25347":91,"_17690":41450,"_5":17585,"_23966":41364,"_2399":41451},[],"`jq` only when using `--sample-data`",{"_2872":123,"_25347":91,"_17690":41453,"_5":17585,"_23966":41364,"_2399":41454},[],"free external ports 80 and 443 on a single-node K3s host",{"_2872":124,"_25347":91,"_17690":41456,"_5":17585,"_23966":41364,"_2399":41457},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2872":125,"_25347":91,"_17690":41459,"_5":17585,"_23966":41364,"_2399":41460},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2872":126,"_25347":91,"_17690":41462,"_5":17585,"_23966":41367,"_2399":41463},[],"Run the script from a clone of the Helm repository:",{"_2872":127,"_25347":91,"_17690":41465,"_5":17585,"_23966":41367,"_2399":41466},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2872":128,"_25347":91,"_17690":41468,"_5":17585,"_23966":41371,"_2399":41469},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2872":129,"_25347":91,"_17690":41471,"_5":17585,"_23966":41371,"_2399":41472},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2872":130,"_25347":91,"_17690":41474,"_5":17585,"_23966":41371,"_2399":41475},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2872":131,"_25347":91,"_17690":41477,"_5":17585,"_23966":41371,"_2399":41478},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2872":132,"_25347":91,"_17690":41480,"_5":17585,"_23966":41375,"_2399":41481},[],"Option",{"_2872":133,"_25347":91,"_17690":41483,"_5":17585,"_23966":41375,"_2399":41484},[],"Default",{"_2872":134,"_25347":91,"_17690":41486,"_5":17585,"_23966":41375,"_2399":41487},[],"Purpose",{"_2872":135,"_25347":91,"_17690":41489,"_5":17585,"_23966":41375,"_2399":41490},[],"`-h`, `--help`",{"_2872":136,"_25347":91,"_17690":41492,"_5":17585,"_23966":41375,"_2399":41493},[],"—",{"_2872":137,"_25347":91,"_17690":41495,"_5":17585,"_23966":41375,"_2399":41496},[],"Show help",{"_2872":138,"_25347":91,"_17690":41498,"_5":17585,"_23966":41375,"_2399":41499},[],"`-c`, `--context`",{"_2872":139,"_25347":91,"_17690":41501,"_5":17585,"_23966":41375,"_2399":41502},[],"current context",{"_2872":140,"_25347":91,"_17690":41504,"_5":17585,"_23966":41375,"_2399":41505},[],"Select the kubeconfig context for kubectl and Helm",{"_2872":141,"_25347":91,"_17690":41507,"_5":17585,"_23966":41375,"_2399":41508},[],"`-n`, `--non-interactive`",{"_2872":142,"_25347":91,"_17690":41510,"_5":17585,"_23966":41375,"_2399":5392},[],{"_2872":143,"_25347":91,"_17690":41512,"_5":17585,"_23966":41375,"_2399":41513},[],"Skip prompts and generate dependency credentials",{"_2872":144,"_25347":91,"_17690":41515,"_5":17585,"_23966":41375,"_2399":41516},[],"`-ns`, `--namespace`",{"_2872":145,"_25347":91,"_17690":41518,"_5":17585,"_23966":41375,"_2399":41519},[],"`lamassu-dev`",{"_2872":146,"_25347":91,"_17690":41521,"_5":17585,"_23966":41375,"_2399":41522},[],"Namespace for the installation",{"_2872":147,"_25347":91,"_17690":41524,"_5":17585,"_23966":41375,"_2399":41525},[],"`-d`, `--domain`",{"_2872":148,"_25347":91,"_17690":41527,"_5":17585,"_23966":41375,"_2399":41528},[],"`dev.lamassu.io`",{"_2872":149,"_25347":91,"_17690":41530,"_5":17585,"_23966":41375,"_2399":41531},[],"Domain used by the UI, OIDC and certificate",{"_2872":150,"_25347":91,"_17690":41533,"_5":17585,"_23966":41375,"_2399":41534},[],"`-v`, `--version`",{"_2872":151,"_25347":91,"_17690":41536,"_5":17585,"_23966":41375,"_2399":12664},[],{"_2872":152,"_25347":91,"_17690":41538,"_5":17585,"_23966":41375,"_2399":41539},[],"Lamassu chart version",{"_2872":153,"_25347":91,"_17690":41541,"_5":17585,"_23966":41375,"_2399":41542},[],"`--https-port`",{"_2872":154,"_25347":91,"_17690":41544,"_5":17585,"_23966":41375,"_2399":41545},[],"`443`",{"_2872":155,"_25347":91,"_17690":41547,"_5":17585,"_23966":41375,"_2399":41548},[],"Gateway HTTPS listener port",{"_2872":156,"_25347":91,"_17690":41550,"_5":17585,"_23966":41375,"_2399":41551},[],"`--http-port`",{"_2872":157,"_25347":91,"_17690":41553,"_5":17585,"_23966":41375,"_2399":41554},[],"`80`",{"_2872":158,"_25347":91,"_17690":41556,"_5":17585,"_23966":41375,"_2399":41557},[],"Gateway HTTP listener port",{"_2872":159,"_25347":91,"_17690":41559,"_5":17585,"_23966":41375,"_2399":41560},[],"`--tls-crt`",{"_2872":160,"_25347":91,"_17690":41562,"_5":17585,"_23966":41375,"_2399":41493},[],{"_2872":161,"_25347":91,"_17690":41564,"_5":17585,"_23966":41375,"_2399":41565},[],"PEM certificate for downstream TLS",{"_2872":162,"_25347":91,"_17690":41567,"_5":17585,"_23966":41375,"_2399":41568},[],"`--tls-key`",{"_2872":163,"_25347":91,"_17690":41570,"_5":17585,"_23966":41375,"_2399":41493},[],{"_2872":164,"_25347":91,"_17690":41572,"_5":17585,"_23966":41375,"_2399":41573},[],"PEM private key for downstream TLS",{"_2872":165,"_25347":91,"_17690":41575,"_5":17585,"_23966":41375,"_2399":41576},[],"`-l`, `--local-chart-path`",{"_2872":166,"_25347":91,"_17690":41578,"_5":17585,"_23966":41375,"_2399":41579},[],"repository chart",{"_2872":167,"_25347":91,"_17690":41581,"_5":17585,"_23966":41375,"_2399":41582},[],"Use an unpacked local Lamassu chart",{"_2872":168,"_25347":91,"_17690":41584,"_5":17585,"_23966":41375,"_2399":41585},[],"`-ip`, `--gateway-ip`",{"_2872":169,"_25347":91,"_17690":41587,"_5":17585,"_23966":41375,"_2399":7330},[],{"_2872":170,"_25347":91,"_17690":41589,"_5":17585,"_23966":41375,"_2399":41590},[],"Override the address written to `gateway.addresses`",{"_2872":171,"_25347":91,"_17690":41592,"_5":17585,"_23966":41375,"_2399":41593},[],"`--otel`",{"_2872":172,"_25347":91,"_17690":41595,"_5":17585,"_23966":41375,"_2399":5392},[],{"_2872":173,"_25347":91,"_17690":41597,"_5":17585,"_23966":41375,"_2399":41598},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2872":174,"_25347":91,"_17690":41600,"_5":17585,"_23966":41375,"_2399":41601},[],"`--sample-data`",{"_2872":175,"_25347":91,"_17690":41603,"_5":17585,"_23966":41375,"_2399":5392},[],{"_2872":176,"_25347":91,"_17690":41605,"_5":17585,"_23966":41375,"_2399":41606},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2872":177,"_25347":91,"_17690":41608,"_5":17585,"_23966":41375,"_2399":41609},[],"`--with-hsm`",{"_2872":178,"_25347":91,"_17690":41611,"_5":17585,"_23966":41375,"_2399":5392},[],{"_2872":179,"_25347":91,"_17690":41613,"_5":17585,"_23966":41375,"_2399":41614},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2872":180,"_25347":91,"_17690":41616,"_5":17585,"_23966":41375,"_2399":41617},[],"`--softhsm-chart-path`",{"_2872":181,"_25347":91,"_17690":41619,"_5":17585,"_23966":41375,"_2399":41620},[],"`./charts/softhsm`",{"_2872":182,"_25347":91,"_17690":41622,"_5":17585,"_23966":41375,"_2399":41623},[],"Use a different local SoftHSM chart",{"_2872":183,"_25347":91,"_17690":41625,"_5":17585,"_23966":41375,"_2399":41626},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2872":184,"_25347":91,"_17690":41628,"_5":17585,"_23966":41379,"_2399":41629},[],"Fastlane:",{"_2872":185,"_25347":91,"_17690":41631,"_5":17585,"_23966":41379,"_2399":41632},[],"validates local tools and the selected cluster",{"_2872":186,"_25347":91,"_17690":41634,"_5":17585,"_23966":41379,"_2399":41635},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2872":187,"_25347":91,"_17690":41637,"_5":17585,"_23966":41379,"_2399":41638},[],"creates the namespace",{"_2872":188,"_25347":91,"_17690":41640,"_5":17585,"_23966":41379,"_2399":41641},[],"installs PostgreSQL and creates the required databases",{"_2872":189,"_25347":91,"_17690":41643,"_5":17585,"_23966":41379,"_2399":41644},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2872":190,"_25347":91,"_17690":41646,"_5":17585,"_23966":41379,"_2399":41647},[],"installs RabbitMQ",{"_2872":191,"_25347":91,"_17690":41649,"_5":17585,"_23966":41379,"_2399":41650},[],"optionally installs observability and lab HSM components",{"_2872":192,"_25347":91,"_17690":41652,"_5":17585,"_23966":41379,"_2399":41653},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2872":193,"_25347":91,"_17690":41655,"_5":17585,"_23966":41379,"_2399":41656},[],"optionally loads sample data",{"_2872":194,"_25347":91,"_17690":41658,"_5":17585,"_23966":41379,"_2399":41659},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2872":195,"_25347":91,"_17690":41661,"_5":17585,"_23966":41383,"_2399":41662},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2872":196,"_25347":91,"_17690":41664,"_5":17585,"_23966":41383,"_2399":41665},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2872":197,"_25347":91,"_17690":41667,"_5":17585,"_23966":41387,"_2399":41668},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2872":198,"_25347":91,"_17690":41670,"_5":17585,"_23966":41387,"_2399":41671},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2872":199,"_25347":91,"_17690":41673,"_5":17585,"_23966":41387,"_2399":41674},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2872":200,"_25347":91,"_17690":41676,"_5":17585,"_23966":41391,"_2399":41677},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2872":201,"_25347":201,"_5":12438,"_2399":41679,"_25683":41680,"_17690":41681,"_23966":201},"Install with Helm",[41104,41105,41211],[],{"_2872":202,"_25347":201,"_17690":41683,"_5":17585,"_23966":201,"_2399":41684},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2872":203,"_25347":201,"_5":25680,"_17690":41686,"_23966":41687,"_2399":41688},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2872":204,"_25347":201,"_5":25680,"_17690":41690,"_23966":41691,"_2399":41114},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#before-you-begin",{"_2872":205,"_25347":201,"_5":25680,"_17690":41693,"_23966":41694,"_2399":41695},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2872":206,"_25347":201,"_5":25680,"_17690":41697,"_23966":41698,"_2399":41699},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2872":207,"_25347":201,"_5":25680,"_17690":41701,"_23966":41702,"_2399":41703},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2872":208,"_25347":201,"_5":25680,"_17690":41705,"_23966":41706,"_2399":41707},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_2872":209,"_25347":201,"_5":25680,"_17690":41709,"_23966":41710,"_2399":41711},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2872":210,"_25347":201,"_5":25680,"_17690":41713,"_23966":41714,"_2399":41715},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2872":211,"_25347":201,"_5":25680,"_17690":41717,"_23966":41718,"_2399":41719},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2872":212,"_25347":201,"_5":25680,"_17690":41721,"_23966":41722,"_2399":41723},[],"/docs/pr-preview/pr-42/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2872":213,"_25347":201,"_17690":41725,"_5":17585,"_23966":41687,"_2399":41726},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2872":214,"_25347":201,"_17690":41728,"_5":17585,"_23966":41691,"_2399":41729},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2872":215,"_25347":201,"_17690":41731,"_5":17585,"_23966":41691,"_2399":41732},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2872":216,"_25347":201,"_17690":41734,"_5":17585,"_23966":41691,"_2399":41735},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2872":217,"_25347":201,"_17690":41737,"_5":17585,"_23966":41691,"_2399":41738},[],"a reachable RabbitMQ broker and credentials",{"_2872":218,"_25347":201,"_17690":41740,"_5":17585,"_23966":41691,"_2399":41741},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2872":219,"_25347":201,"_17690":41743,"_5":17585,"_23966":41691,"_2399":41744},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2872":220,"_25347":201,"_17690":41746,"_5":17585,"_23966":41691,"_2399":41747},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2872":221,"_25347":201,"_17690":41749,"_5":17585,"_23966":41691,"_2399":41750},[],"a StorageClass and an external traffic design",{"_2872":222,"_25347":201,"_17690":41752,"_5":17585,"_23966":41691,"_2399":41753},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2872":223,"_25347":201,"_17690":41755,"_5":17585,"_23966":41691,"_2399":41756},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2872":224,"_25347":201,"_17690":41758,"_5":17585,"_23966":41691,"_2399":41759},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2872":225,"_25347":201,"_17690":41761,"_5":17585,"_23966":41694,"_2399":41762},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2872":226,"_25347":201,"_17690":41764,"_5":17585,"_23966":41694,"_2399":41765},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2872":227,"_25347":201,"_17690":41767,"_5":17585,"_23966":41694,"_2399":41768},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2872":228,"_25347":201,"_17690":41770,"_5":17585,"_23966":41698,"_2399":41771},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2872":229,"_25347":201,"_17690":41773,"_5":17585,"_23966":41698,"_2399":41774},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2872":230,"_25347":201,"_17690":41776,"_5":17585,"_23966":41698,"_2399":41777},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2872":231,"_25347":201,"_17690":41779,"_5":17585,"_23966":41698,"_2399":41780},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_2872":232,"_25347":201,"_17690":41782,"_5":17585,"_23966":41702,"_2399":41783},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2872":233,"_25347":201,"_17690":41785,"_5":17585,"_23966":41706,"_2399":41786},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_2872":234,"_25347":201,"_17690":41788,"_5":17585,"_23966":41706,"_2399":41789},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_2872":235,"_25347":201,"_17690":41791,"_5":17585,"_23966":41706,"_2399":41792},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_2872":236,"_25347":201,"_17690":41794,"_5":17585,"_23966":41706,"_2399":41795},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_2872":237,"_25347":201,"_17690":41797,"_5":17585,"_23966":41706,"_2399":41798},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_2872":238,"_25347":201,"_17690":41800,"_5":17585,"_23966":41706,"_2399":41801},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_2872":239,"_25347":201,"_17690":41803,"_5":17585,"_23966":41706,"_2399":41804},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP.",{"_2872":240,"_25347":201,"_17690":41806,"_5":17585,"_23966":41710,"_2399":41807},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2872":241,"_25347":201,"_17690":41809,"_5":17585,"_23966":41710,"_2399":41810},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2872":242,"_25347":201,"_17690":41812,"_5":17585,"_23966":41710,"_2399":41813},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2872":243,"_25347":201,"_17690":41815,"_5":17585,"_23966":41710,"_2399":41816},[],"See Access control for the principal and policy model.",{"_2872":244,"_25347":201,"_17690":41818,"_5":17585,"_23966":41714,"_2399":41819},[],"To install a local checkout instead:",{"_2872":245,"_25347":201,"_17690":41821,"_5":17585,"_23966":41718,"_2399":41822},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2872":246,"_25347":201,"_17690":41824,"_5":17585,"_23966":41718,"_2399":41825},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2872":247,"_25347":201,"_17690":41827,"_5":17585,"_23966":41722,"_2399":41828},[],"Before going live, review:",{"_2872":248,"_25347":201,"_17690":41830,"_5":17585,"_23966":41722,"_2399":41831},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2872":249,"_25347":201,"_17690":41833,"_5":17585,"_23966":41722,"_2399":41834},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2872":250,"_25347":201,"_17690":41836,"_5":17585,"_23966":41722,"_2399":41837},[],"shared VA storage before increasing VA replicas",{"_2872":251,"_25347":201,"_17690":41839,"_5":17585,"_23966":41722,"_2399":41840},[],"managed OIDC roles and removal of evaluation credentials",{"_2872":252,"_25347":201,"_17690":41842,"_5":17585,"_23966":41722,"_2399":41843},[],"a trusted TLS issuer or externally managed certificate",{"_2872":253,"_25347":201,"_17690":41845,"_5":17585,"_23966":41722,"_2399":41846},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2872":254,"_25347":201,"_17690":41848,"_5":17585,"_23966":41722,"_2399":41849},[],"SMTP, observability and alert delivery",{"_2872":255,"_25347":201,"_17690":41851,"_5":17585,"_23966":41722,"_2399":41852},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2872":256,"_25347":201,"_17690":41854,"_5":17585,"_23966":41722,"_2399":41855},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2872":257,"_25347":257,"_5":12438,"_2399":41857,"_25683":41858,"_17690":41859,"_23966":257},"Expose the Gateway",[41104,41105,41211],[],{"_2872":258,"_25347":257,"_17690":41861,"_5":17585,"_23966":257,"_2399":41862},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2872":259,"_25347":257,"_5":25680,"_17690":41864,"_23966":41865,"_2399":41866},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2872":260,"_25347":257,"_5":25680,"_17690":41868,"_23966":41869,"_2399":41870},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2872":261,"_25347":257,"_5":25680,"_17690":41872,"_23966":41873,"_2399":41874},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2872":262,"_25347":257,"_5":25680,"_17690":41876,"_23966":41877,"_2399":41878},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#k3s","K3s",{"_2872":263,"_25347":257,"_5":25680,"_17690":41880,"_23966":41881,"_2399":41882},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2872":264,"_25347":257,"_5":25680,"_17690":41884,"_23966":41885,"_2399":41886},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2872":265,"_25347":257,"_5":25680,"_17690":41888,"_23966":41889,"_2399":41890},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2872":266,"_25347":257,"_5":25680,"_17690":41892,"_23966":41893,"_2399":41894},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2872":267,"_25347":257,"_5":25680,"_17690":41896,"_23966":41897,"_2399":41898},[],"/docs/pr-preview/pr-42/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2872":268,"_25347":257,"_17690":41900,"_5":17585,"_23966":41865,"_2399":41901},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2872":269,"_25347":257,"_17690":41903,"_5":17585,"_23966":41865,"_2399":41904},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2872":270,"_25347":257,"_17690":41906,"_5":17585,"_23966":41869,"_2399":41907},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2872":271,"_25347":257,"_17690":41909,"_5":17585,"_23966":41869,"_2399":41910},[],"Set it only when:",{"_2872":272,"_25347":257,"_17690":41912,"_5":17585,"_23966":41869,"_2399":41913},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2872":273,"_25347":257,"_17690":41915,"_5":17585,"_23966":41869,"_2399":41916},[],"that address is allocated to this Gateway",{"_2872":274,"_25347":257,"_17690":41918,"_5":17585,"_23966":41869,"_2399":41919},[],"the surrounding network already routes traffic for it to the cluster",{"_2872":275,"_25347":257,"_17690":41921,"_5":17585,"_23966":41869,"_2399":41922},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2872":276,"_25347":257,"_17690":41924,"_5":17585,"_23966":41869,"_2399":41925},[],"Keep these two settings separate:",{"_2872":277,"_25347":257,"_17690":41927,"_5":17585,"_23966":41869,"_2399":41928},[],"`gateway.addresses` requests an address for the Gateway.",{"_2872":278,"_25347":257,"_17690":41930,"_5":17585,"_23966":41869,"_2399":41931},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2872":279,"_25347":257,"_17690":41933,"_5":17585,"_23966":41869,"_2399":41934},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2872":280,"_25347":257,"_17690":41936,"_5":17585,"_23966":41873,"_2399":41937},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2872":281,"_25347":257,"_17690":41939,"_5":17585,"_23966":41873,"_2399":41940},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2872":282,"_25347":257,"_17690":41942,"_5":17585,"_23966":41877,"_2399":41943},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2872":283,"_25347":257,"_17690":41945,"_5":17585,"_23966":41877,"_2399":41946},[],"For the recommended design:",{"_2872":284,"_25347":257,"_17690":41948,"_5":17585,"_23966":41877,"_2399":41949},[],"Use only one externally exposed Lamassu Gateway.",{"_2872":285,"_25347":257,"_17690":41951,"_5":17585,"_23966":41877,"_2399":41952},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2872":286,"_25347":257,"_17690":41954,"_5":17585,"_23966":41877,"_2399":41955},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2872":287,"_25347":257,"_17690":41957,"_5":17585,"_23966":41877,"_2399":41958},[],"Point DNS at the VM's reachable address.",{"_2872":288,"_25347":257,"_17690":41960,"_5":17585,"_23966":41877,"_2399":41961},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2872":289,"_25347":257,"_17690":41963,"_5":17585,"_23966":41881,"_2399":41964},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2872":290,"_25347":257,"_17690":41966,"_5":17585,"_23966":41885,"_2399":41967},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2872":291,"_25347":257,"_17690":41969,"_5":17585,"_23966":41885,"_2399":41970},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2872":292,"_25347":257,"_17690":41972,"_5":17585,"_23966":41889,"_2399":41973},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2872":293,"_25347":257,"_17690":41975,"_5":17585,"_23966":41889,"_2399":41976},[],"Requirement",{"_2872":294,"_25347":257,"_17690":41978,"_5":17585,"_23966":41889,"_2399":41979},[],"Recommended design",{"_2872":295,"_25347":257,"_17690":41981,"_5":17585,"_23966":41889,"_2399":41982},[],"Consequence",{"_2872":296,"_25347":257,"_17690":41984,"_5":17585,"_23966":41889,"_2399":41985},[],"Several Lamassu URLs or services",{"_2872":297,"_25347":257,"_17690":41987,"_5":17585,"_23966":41889,"_2399":41988},[],"One Gateway with multiple routes",{"_2872":298,"_25347":257,"_17690":41990,"_5":17585,"_23966":41889,"_2399":41991},[],"One IP and one proxy fleet; this is the chart default",{"_2872":299,"_25347":257,"_17690":41993,"_5":17585,"_23966":41889,"_2399":41994},[],"Independent Gateways and separate external IPs",{"_2872":300,"_25347":257,"_17690":41996,"_5":17585,"_23966":41889,"_2399":41997},[],"One VIP per Gateway",{"_2872":301,"_25347":257,"_17690":41999,"_5":17585,"_23966":41889,"_2399":42000},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2872":302,"_25347":257,"_17690":42002,"_5":17585,"_23966":41889,"_2399":42003},[],"Independent Gateways on one node and one IP",{"_2872":303,"_25347":257,"_17690":42005,"_5":17585,"_23966":41889,"_2399":42006},[],"Use different external ports",{"_2872":304,"_25347":257,"_17690":42008,"_5":17585,"_23966":41889,"_2399":42009},[],"Clients must include non-standard ports",{"_2872":305,"_25347":257,"_17690":42011,"_5":17585,"_23966":41889,"_2399":42012},[],"Separate TLS/mTLS termination behind one IP",{"_2872":306,"_25347":257,"_17690":42014,"_5":17585,"_23966":41889,"_2399":42015},[],"Front-door SNI routing to internal Gateways",{"_2872":307,"_25347":257,"_17690":42017,"_5":17585,"_23966":41889,"_2399":42018},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2872":308,"_25347":257,"_17690":42020,"_5":17585,"_23966":41889,"_2399":42021},[],"Separate Gateway resources but shared proxy infrastructure",{"_2872":309,"_25347":257,"_17690":42023,"_5":17585,"_23966":41889,"_2399":42024},[],"Envoy merged-Gateway mode",{"_2872":310,"_25347":257,"_17690":42026,"_5":17585,"_23966":41889,"_2399":42027},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2872":311,"_25347":257,"_17690":42029,"_5":17585,"_23966":41889,"_2399":42030},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2872":312,"_25347":257,"_17690":42032,"_5":17585,"_23966":41889,"_2399":42033},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2872":313,"_25347":257,"_17690":42035,"_5":17585,"_23966":41889,"_2399":42036},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2872":314,"_25347":257,"_17690":42038,"_5":17585,"_23966":41889,"_2399":42039},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2872":315,"_25347":257,"_17690":42041,"_5":17585,"_23966":41893,"_2399":42042},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2872":316,"_25347":257,"_17690":42044,"_5":17585,"_23966":41893,"_2399":42045},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2872":317,"_25347":257,"_17690":42047,"_5":17585,"_23966":41893,"_2399":42048},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2872":318,"_25347":257,"_17690":42050,"_5":17585,"_23966":41893,"_2399":42051},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2872":319,"_25347":257,"_17690":42053,"_5":17585,"_23966":41893,"_2399":42054},[],"If none of those are possible, use different external ports or change the external network design.",{"_2872":320,"_25347":257,"_17690":42056,"_5":17585,"_23966":41897,"_2399":42057},[],"Check, in order:",{"_2872":321,"_25347":257,"_17690":42059,"_5":17585,"_23966":41897,"_2399":42060},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2872":322,"_25347":257,"_17690":42062,"_5":17585,"_23966":41897,"_2399":42063},[],"Its status contains the expected address.",{"_2872":323,"_25347":257,"_17690":42065,"_5":17585,"_23966":41897,"_2399":42066},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2872":324,"_25347":257,"_17690":42068,"_5":17585,"_23966":41897,"_2399":42069},[],"Port 443 reaches that address from the client network.",{"_2872":325,"_25347":257,"_17690":42071,"_5":17585,"_23966":41897,"_2399":42072},[],"DNS resolves to the externally reachable endpoint.",{"_2872":326,"_25347":257,"_17690":42074,"_5":17585,"_23966":41897,"_2399":42075},[],"The certificate contains the DNS name or IP used by the client.",{"_2872":327,"_25347":257,"_17690":42077,"_5":17585,"_23966":41897,"_2399":42078},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2872":328,"_25347":328,"_5":12438,"_2399":41211,"_25683":42080,"_17690":42081,"_23966":328},[41104,41105,41211],[],{"_2872":329,"_25347":328,"_17690":42083,"_5":17585,"_23966":328,"_2399":42084},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2872":330,"_25347":328,"_5":25680,"_17690":42086,"_23966":42087,"_2399":42088},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2872":331,"_25347":328,"_5":25680,"_17690":42090,"_23966":42091,"_2399":42092},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2872":332,"_25347":328,"_5":25680,"_17690":42094,"_23966":42095,"_2399":42096},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2872":333,"_25347":328,"_5":25680,"_17690":42098,"_23966":42099,"_2399":42100},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2872":334,"_25347":328,"_5":25680,"_17690":42102,"_23966":42103,"_2399":42104},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2872":335,"_25347":328,"_5":25680,"_17690":42106,"_23966":42107,"_2399":42108},[],"/docs/pr-preview/pr-42/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2872":336,"_25347":328,"_17690":42110,"_5":17585,"_23966":42087,"_2399":42111},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2872":337,"_25347":328,"_17690":42113,"_5":17585,"_23966":42091,"_2399":42114},[],"Workflow",{"_2872":338,"_25347":328,"_17690":42116,"_5":17585,"_23966":42091,"_2399":42117},[],"Use it for",{"_2872":339,"_25347":328,"_17690":42119,"_5":17585,"_23966":42091,"_2399":42120},[],"What it installs",{"_2872":340,"_25347":328,"_17690":42122,"_5":17585,"_23966":42091,"_2399":42123},[],"Helm",{"_2872":341,"_25347":328,"_17690":42125,"_5":17585,"_23966":42091,"_2399":42126},[],"Production and controlled environments",{"_2872":342,"_25347":328,"_17690":42128,"_5":17585,"_23966":42091,"_2399":42129},[],"Lamassu services and Gateway API resources",{"_2872":343,"_25347":328,"_17690":42131,"_5":17585,"_23966":42091,"_2399":41348},[],{"_2872":344,"_25347":328,"_17690":42133,"_5":17585,"_23966":42091,"_2399":42134},[],"Evaluation, demos, CI and small lab clusters",{"_2872":345,"_25347":328,"_17690":42136,"_5":17585,"_23966":42091,"_2399":42137},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2872":346,"_25347":328,"_17690":42139,"_5":17585,"_23966":42095,"_2399":42140},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2872":347,"_25347":328,"_17690":42142,"_5":17585,"_23966":42095,"_2399":42143},[],"Area",{"_2872":348,"_25347":328,"_17690":42145,"_5":17585,"_23966":42095,"_2399":42146},[],"The Lamassu chart provides",{"_2872":349,"_25347":328,"_17690":42148,"_5":17585,"_23966":42095,"_2399":42149},[],"You provide",{"_2872":350,"_25347":328,"_17690":42151,"_5":17585,"_23966":42095,"_2399":42152},[],"Lamassu applications",{"_2872":351,"_25347":328,"_17690":42154,"_5":17585,"_23966":42095,"_2399":42155},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2872":352,"_25347":328,"_17690":42157,"_5":17585,"_23966":42095,"_2399":42158},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2872":353,"_25347":328,"_17690":42160,"_5":17585,"_23966":42095,"_2399":42161},[],"PostgreSQL data",{"_2872":354,"_25347":328,"_17690":42163,"_5":17585,"_23966":42095,"_2399":42164},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2872":355,"_25347":328,"_17690":42166,"_5":17585,"_23966":42095,"_2399":42167},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2872":356,"_25347":328,"_17690":42169,"_5":17585,"_23966":42095,"_2399":42170},[],"Messaging",{"_2872":357,"_25347":328,"_17690":42172,"_5":17585,"_23966":42095,"_2399":42173},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS with a private CA and an optional client certificate, both set through chart values",{"_2872":358,"_25347":328,"_17690":42175,"_5":17585,"_23966":42095,"_2399":42176},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2872":359,"_25347":328,"_17690":42178,"_5":17585,"_23966":42095,"_2399":42179},[],"Identity",{"_2872":360,"_25347":328,"_17690":42181,"_5":17585,"_23966":42095,"_2399":42182},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2872":361,"_25347":328,"_17690":42184,"_5":17585,"_23966":42095,"_2399":42185},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2872":362,"_25347":328,"_17690":42187,"_5":17585,"_23966":42095,"_2399":42188},[],"External routing",{"_2872":363,"_25347":328,"_17690":42190,"_5":17585,"_23966":42095,"_2399":42191},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2872":364,"_25347":328,"_17690":42193,"_5":17585,"_23966":42095,"_2399":42194},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2872":365,"_25347":328,"_17690":42196,"_5":17585,"_23966":42095,"_2399":42197},[],"TLS",{"_2872":366,"_25347":328,"_17690":42199,"_5":17585,"_23966":42095,"_2399":42200},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2872":367,"_25347":328,"_17690":42202,"_5":17585,"_23966":42095,"_2399":42203},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2872":368,"_25347":328,"_17690":42205,"_5":17585,"_23966":42095,"_2399":42206},[],"Persistent application data",{"_2872":369,"_25347":328,"_17690":42208,"_5":17585,"_23966":42095,"_2399":42209},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2872":370,"_25347":328,"_17690":42211,"_5":17585,"_23966":42095,"_2399":42212},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2872":371,"_25347":328,"_17690":42214,"_5":17585,"_23966":42095,"_2399":42215},[],"Optional integrations",{"_2872":372,"_25347":328,"_17690":42217,"_5":17585,"_23966":42095,"_2399":42218},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2872":373,"_25347":328,"_17690":42220,"_5":17585,"_23966":42095,"_2399":42221},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2872":374,"_25347":328,"_17690":42223,"_5":17585,"_23966":42095,"_2399":42224},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2872":375,"_25347":328,"_17690":42226,"_5":17585,"_23966":42095,"_2399":42227},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2872":376,"_25347":328,"_17690":42229,"_5":17585,"_23966":42099,"_2399":42230},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2872":377,"_25347":328,"_17690":42232,"_5":17585,"_23966":42099,"_2399":42233},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2872":378,"_25347":328,"_17690":42235,"_5":17585,"_23966":42103,"_2399":42236},[],"Kubernetes 1.24 or newer",{"_2872":379,"_25347":328,"_17690":42238,"_5":17585,"_23966":42103,"_2399":42239},[],"Helm 3.2 or newer",{"_2872":380,"_25347":328,"_17690":42241,"_5":17585,"_23966":42103,"_2399":42242},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2872":381,"_25347":328,"_17690":42244,"_5":17585,"_23966":42103,"_2399":42245},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2872":382,"_25347":328,"_17690":42247,"_5":17585,"_23966":42103,"_2399":42248},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2872":383,"_25347":328,"_17690":42250,"_5":17585,"_23966":42103,"_2399":42251},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2872":384,"_25347":328,"_17690":42253,"_5":17585,"_23966":42103,"_2399":42254},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2872":385,"_25347":328,"_17690":42256,"_5":17585,"_23966":42107,"_2399":42257},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2872":386,"_25347":328,"_17690":42259,"_5":17585,"_23966":42107,"_2399":42260},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2872":387,"_25347":328,"_17690":42262,"_5":17585,"_23966":42107,"_2399":42263},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2872":388,"_25347":388,"_5":12438,"_2399":42265,"_25683":42266,"_17690":42268,"_23966":388},"Deployment troubleshooting",[41104,41105,42267],"Operations",[],{"_2872":389,"_25347":388,"_17690":42270,"_5":17585,"_23966":388,"_2399":42271},[],"Diagnose access, service health and infrastructure dependencies.",{"_2872":390,"_25347":388,"_5":25680,"_17690":42273,"_23966":42274,"_2399":42275},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2872":391,"_25347":388,"_5":25680,"_17690":42277,"_23966":42278,"_2399":42279},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2872":392,"_25347":388,"_5":25680,"_17690":42281,"_23966":42282,"_2399":42283},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2872":393,"_25347":388,"_5":25680,"_17690":42285,"_23966":42286,"_2399":42287},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2872":394,"_25347":388,"_5":25680,"_17690":42289,"_23966":42290,"_2399":42291},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2872":395,"_25347":388,"_5":25680,"_17690":42293,"_23966":42294,"_2399":42295},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2872":396,"_25347":388,"_5":25680,"_17690":42297,"_23966":42298,"_2399":42299},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2872":397,"_25347":388,"_5":25680,"_17690":42301,"_23966":42302,"_2399":42303},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2872":398,"_25347":388,"_5":25680,"_17690":42305,"_23966":42306,"_2399":42307},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2872":399,"_25347":388,"_5":25680,"_17690":42309,"_23966":42310,"_2399":42311},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2872":400,"_25347":388,"_5":25680,"_17690":42313,"_23966":42314,"_2399":42315},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2872":401,"_25347":388,"_5":25680,"_17690":42317,"_23966":42318,"_2399":42319},[],"/docs/pr-preview/pr-42/deployment/troubleshooting#observability","Observability",{"_2872":402,"_25347":388,"_17690":42321,"_5":17585,"_23966":388,"_2399":42322},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2872":403,"_25347":388,"_17690":42324,"_5":17585,"_23966":42278,"_2399":42325},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2872":404,"_25347":388,"_17690":42327,"_5":17585,"_23966":42282,"_2399":42328},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2872":405,"_25347":388,"_17690":42330,"_5":17585,"_23966":42286,"_2399":42331},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2872":406,"_25347":388,"_17690":42333,"_5":17585,"_23966":42290,"_2399":42334},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2872":407,"_25347":388,"_17690":42336,"_5":17585,"_23966":42294,"_2399":42337},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2872":408,"_25347":388,"_17690":42339,"_5":17585,"_23966":42298,"_2399":42340},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2872":409,"_25347":388,"_17690":42342,"_5":17585,"_23966":42298,"_2399":42343},[],"Also run the chart's connectivity test:",{"_2872":410,"_25347":388,"_17690":42345,"_5":17585,"_23966":42298,"_2399":42346},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2872":411,"_25347":388,"_17690":42348,"_5":17585,"_23966":42298,"_2399":42349},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2872":412,"_25347":388,"_17690":42351,"_5":17585,"_23966":42302,"_2399":42352},[],"If you receive a 401:",{"_2872":413,"_25347":388,"_17690":42354,"_5":17585,"_23966":42302,"_2399":42355},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2872":414,"_25347":388,"_17690":42357,"_5":17585,"_23966":42302,"_2399":42358},[],"verify issuer, audience and expiration of the token;",{"_2872":415,"_25347":388,"_17690":42360,"_5":17585,"_23966":42302,"_2399":42361},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2872":416,"_25347":388,"_17690":42363,"_5":17585,"_23966":42302,"_2399":42364},[],"check that the provider's public and internal routes point to the same realm.",{"_2872":417,"_25347":388,"_17690":42366,"_5":17585,"_23966":42302,"_2399":42367},[],"If login succeeds but the APIs return 403:",{"_2872":418,"_25347":388,"_17690":42369,"_5":17585,"_23966":42302,"_2399":42370},[],"inspect the token's real claims;",{"_2872":419,"_25347":388,"_17690":42372,"_5":17585,"_23966":42302,"_2399":42373},[],"confirm they match an active principal;",{"_2872":420,"_25347":388,"_17690":42375,"_5":17585,"_23966":42302,"_2399":42376},[],"review the policies granted to that principal;",{"_2872":421,"_25347":388,"_17690":42378,"_5":17585,"_23966":42302,"_2399":42379},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2872":422,"_25347":388,"_17690":42381,"_5":17585,"_23966":42302,"_2399":42382},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2872":423,"_25347":388,"_17690":42384,"_5":17585,"_23966":42306,"_2399":42385},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2872":424,"_25347":388,"_17690":42387,"_5":17585,"_23966":42306,"_2399":42388},[],"Locate the authz pod and Service.",{"_2872":425,"_25347":388,"_17690":42390,"_5":17585,"_23966":42306,"_2399":42391},[],"Check /health, logs and its database connection.",{"_2872":426,"_25347":388,"_17690":42393,"_5":17585,"_23966":42306,"_2399":42394},[],"Verify the DNS and port configured in externalAuthorization.",{"_2872":427,"_25347":388,"_17690":42396,"_5":17585,"_23966":42306,"_2399":42397},[],"Check the check route is /v1/ext\\_authz/check.",{"_2872":428,"_25347":388,"_17690":42399,"_5":17585,"_23966":42306,"_2399":42400},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2872":429,"_25347":388,"_17690":42402,"_5":17585,"_23966":42310,"_2399":42403},[],"Review kubectl describe pod first. Common causes are:",{"_2872":430,"_25347":388,"_17690":42405,"_5":17585,"_23966":42310,"_2399":42406},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2872":431,"_25347":388,"_17690":42408,"_5":17585,"_23966":42310,"_2399":42409},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_2872":432,"_25347":388,"_17690":42411,"_5":17585,"_23966":42310,"_2399":42412},[],"unbound persistent volume;",{"_2872":433,"_25347":388,"_17690":42414,"_5":17585,"_23966":42310,"_2399":42415},[],"inaccessible image or incorrect pull policy;",{"_2872":434,"_25347":388,"_17690":42417,"_5":17585,"_23966":42310,"_2399":42418},[],"invalid cryptographic engine configuration;",{"_2872":435,"_25347":388,"_17690":42420,"_5":17585,"_23966":42310,"_2399":42421},[],"CPU or memory limits set too low;",{"_2872":436,"_25347":388,"_17690":42423,"_5":17585,"_23966":42310,"_2399":42424},[],"an incomplete prior migration.",{"_2872":437,"_25347":388,"_17690":42426,"_5":17585,"_23966":42310,"_2399":42427},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2872":438,"_25347":388,"_17690":42429,"_5":17585,"_23966":42310,"_2399":42430},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2872":439,"_25347":388,"_17690":42432,"_5":17585,"_23966":42314,"_2399":42433},[],"Domain and audit events depend on the bus publisher:",{"_2872":440,"_25347":388,"_17690":42435,"_5":17585,"_23966":42314,"_2399":42436},[],"verify it is enabled in the emitting service;",{"_2872":441,"_25347":388,"_17690":42438,"_5":17585,"_23966":42314,"_2399":42439},[],"check AMQP connectivity and credentials;",{"_2872":442,"_25347":388,"_17690":42441,"_5":17585,"_23966":42314,"_2399":42442},[],"review exchange, routing key, queues and consumers;",{"_2872":443,"_25347":388,"_17690":42444,"_5":17585,"_23966":42314,"_2399":42445},[],"inspect dead-letter queues;",{"_2872":444,"_25347":388,"_17690":42447,"_5":17585,"_23966":42314,"_2399":42448},[],"alert on orphan durable queues and backlog growth.",{"_2872":445,"_25347":388,"_17690":42450,"_5":17585,"_23966":42314,"_2399":42451},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_2872":446,"_25347":388,"_17690":42453,"_5":17585,"_23966":42314,"_2399":42454},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_2872":447,"_25347":388,"_17690":42456,"_5":17585,"_23966":42314,"_2399":42457},[],"confirm the CA Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey`;",{"_2872":448,"_25347":388,"_17690":42459,"_5":17585,"_23966":42314,"_2399":42460},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_2872":449,"_25347":388,"_17690":42462,"_5":17585,"_23966":42314,"_2399":42463},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_2872":450,"_25347":388,"_17690":42465,"_5":17585,"_23966":42314,"_2399":42466},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_2872":451,"_25347":388,"_17690":42468,"_5":17585,"_23966":42314,"_2399":42469},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2872":452,"_25347":388,"_17690":42471,"_5":17585,"_23966":42318,"_2399":42472},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2872":453,"_25347":388,"_17690":42474,"_5":17585,"_23966":42318,"_2399":42475},[],"Before closing an incident, record:",{"_2872":454,"_25347":388,"_17690":42477,"_5":17585,"_23966":42318,"_2399":42478},[],"the confirmed cause;",{"_2872":455,"_25347":388,"_17690":42480,"_5":17585,"_23966":42318,"_2399":42481},[],"the time scope and affected resources;",{"_2872":456,"_25347":388,"_17690":42483,"_5":17585,"_23966":42318,"_2399":42484},[],"the commands or queries used;",{"_2872":457,"_25347":388,"_17690":42486,"_5":17585,"_23966":42318,"_2399":42487},[],"the applied change and how to revert it;",{"_2872":458,"_25347":388,"_17690":42489,"_5":17585,"_23966":42318,"_2399":42490},[],"validation from a consumer;",{"_2872":459,"_25347":388,"_17690":42492,"_5":17585,"_23966":42318,"_2399":42493},[],"the preventive action and its owner.",{"_2872":460,"_25347":460,"_5":12438,"_2399":42495,"_25683":42496,"_17690":42499,"_23966":460},"Access control",[41104,42497,42498],"Platform","Administration",[],{"_2872":461,"_25347":460,"_17690":42501,"_5":17585,"_23966":460,"_2399":42502},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2872":462,"_25347":460,"_5":25680,"_17690":42504,"_23966":42505,"_2399":42506},[],"/docs/pr-preview/pr-42/platform/administration/access-control#essential-concepts","Essential concepts",{"_2872":463,"_25347":460,"_5":25680,"_17690":42508,"_23966":42509,"_2399":42510},[],"/docs/pr-preview/pr-42/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2872":464,"_25347":460,"_5":25680,"_17690":42512,"_23966":42513,"_2399":42514},[],"/docs/pr-preview/pr-42/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2872":465,"_25347":460,"_5":25680,"_17690":42516,"_23966":42517,"_2399":42518},[],"/docs/pr-preview/pr-42/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2872":466,"_25347":460,"_5":25680,"_17690":42520,"_23966":42521,"_2399":42522},[],"/docs/pr-preview/pr-42/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2872":467,"_25347":460,"_5":25680,"_17690":42524,"_23966":42525,"_2399":42526},[],"/docs/pr-preview/pr-42/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2872":468,"_25347":460,"_5":25680,"_17690":42528,"_23966":42529,"_2399":42530},[],"/docs/pr-preview/pr-42/platform/administration/access-control#oidc-principals","OIDC principals",{"_2872":469,"_25347":460,"_5":25680,"_17690":42532,"_23966":42533,"_2399":42534},[],"/docs/pr-preview/pr-42/platform/administration/access-control#x509-principals","X.509 principals",{"_2872":470,"_25347":460,"_5":25680,"_17690":42536,"_23966":42537,"_2399":42538},[],"/docs/pr-preview/pr-42/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2872":471,"_25347":460,"_5":25680,"_17690":42540,"_23966":42541,"_2399":42542},[],"/docs/pr-preview/pr-42/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2872":472,"_25347":460,"_5":25680,"_17690":42544,"_23966":42545,"_2399":42546},[],"/docs/pr-preview/pr-42/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2872":473,"_25347":460,"_5":25680,"_17690":42548,"_23966":42549,"_2399":42550},[],"/docs/pr-preview/pr-42/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2872":474,"_25347":460,"_5":25680,"_17690":42552,"_23966":42553,"_2399":42554},[],"/docs/pr-preview/pr-42/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2872":475,"_25347":460,"_5":25680,"_17690":42556,"_23966":42557,"_2399":42558},[],"/docs/pr-preview/pr-42/platform/administration/access-control#http-rules","HTTP rules",{"_2872":476,"_25347":460,"_5":25680,"_17690":42560,"_23966":42561,"_2399":42562},[],"/docs/pr-preview/pr-42/platform/administration/access-control#included-policies","Included policies",{"_2872":477,"_25347":460,"_5":25680,"_17690":42564,"_23966":42565,"_2399":41711},[],"/docs/pr-preview/pr-42/platform/administration/access-control#provision-the-first-administrator",{"_2872":478,"_25347":460,"_5":25680,"_17690":42567,"_23966":42568,"_2399":42569},[],"/docs/pr-preview/pr-42/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2872":479,"_25347":460,"_5":25680,"_17690":42571,"_23966":42572,"_2399":42573},[],"/docs/pr-preview/pr-42/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2872":480,"_25347":460,"_5":25680,"_17690":42575,"_23966":42576,"_2399":42577},[],"/docs/pr-preview/pr-42/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2872":481,"_25347":460,"_5":25680,"_17690":42579,"_23966":42580,"_2399":42581},[],"/docs/pr-preview/pr-42/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2872":482,"_25347":460,"_5":25680,"_17690":42583,"_23966":42584,"_2399":42585},[],"/docs/pr-preview/pr-42/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2872":483,"_25347":460,"_5":25680,"_17690":42587,"_23966":42588,"_2399":42589},[],"/docs/pr-preview/pr-42/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2872":484,"_25347":460,"_5":25680,"_17690":42591,"_23966":42592,"_2399":42593},[],"/docs/pr-preview/pr-42/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2872":485,"_25347":460,"_5":25680,"_17690":42595,"_23966":42596,"_2399":42597},[],"/docs/pr-preview/pr-42/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2872":486,"_25347":460,"_5":25680,"_17690":42599,"_23966":42600,"_2399":42601},[],"/docs/pr-preview/pr-42/platform/administration/access-control#operational-checklist","Operational checklist",{"_2872":487,"_25347":460,"_5":25680,"_17690":42603,"_23966":42604,"_2399":42605},[],"/docs/pr-preview/pr-42/platform/administration/access-control#diagnostics","Diagnostics",{"_2872":488,"_25347":460,"_5":25680,"_17690":42607,"_23966":42608,"_2399":42609},[],"/docs/pr-preview/pr-42/platform/administration/access-control#the-response-is-401","The response is 401",{"_2872":489,"_25347":460,"_5":25680,"_17690":42611,"_23966":42612,"_2399":42613},[],"/docs/pr-preview/pr-42/platform/administration/access-control#the-response-is-403","The response is 403",{"_2872":490,"_25347":460,"_5":25680,"_17690":42615,"_23966":42616,"_2399":42617},[],"/docs/pr-preview/pr-42/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2872":491,"_25347":460,"_5":25680,"_17690":42619,"_23966":42620,"_2399":42621},[],"/docs/pr-preview/pr-42/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2872":492,"_25347":460,"_5":25680,"_17690":42623,"_23966":42624,"_2399":42625},[],"/docs/pr-preview/pr-42/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2872":493,"_25347":460,"_17690":42627,"_5":17585,"_23966":460,"_2399":42628},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2872":494,"_25347":460,"_17690":42630,"_5":17585,"_23966":460,"_2399":42631},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2872":495,"_25347":460,"_17690":42633,"_5":17585,"_23966":460,"_2399":42634},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2872":496,"_25347":460,"_17690":42636,"_5":17585,"_23966":42505,"_2399":42637},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2872":497,"_25347":460,"_17690":42639,"_5":17585,"_23966":42505,"_2399":42640},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2872":498,"_25347":460,"_17690":42642,"_5":17585,"_23966":42505,"_2399":42643},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2872":499,"_25347":460,"_17690":42645,"_5":17585,"_23966":42505,"_2399":42646},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2872":500,"_25347":460,"_17690":42648,"_5":17585,"_23966":42505,"_2399":42649},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2872":501,"_25347":460,"_17690":42651,"_5":17585,"_23966":42505,"_2399":42652},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2872":502,"_25347":460,"_17690":42654,"_5":17585,"_23966":42509,"_2399":42655},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2872":503,"_25347":460,"_17690":42657,"_5":17585,"_23966":42509,"_2399":42658},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2872":504,"_25347":460,"_17690":42660,"_5":17585,"_23966":42513,"_2399":42661},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2872":505,"_25347":460,"_17690":42663,"_5":17585,"_23966":42513,"_2399":42664},[],"The decision is made **before forwarding the request to the service**:",{"_2872":506,"_25347":460,"_17690":42666,"_5":17585,"_23966":42513,"_2399":42667},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2872":507,"_25347":460,"_17690":42669,"_5":17585,"_23966":42513,"_2399":42670},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2872":508,"_25347":460,"_17690":42672,"_5":17585,"_23966":42513,"_2399":42673},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2872":509,"_25347":460,"_17690":42675,"_5":17585,"_23966":42513,"_2399":42676},[],"It separately loads the policies granted to each principal.",{"_2872":510,"_25347":460,"_17690":42678,"_5":17585,"_23966":42513,"_2399":42679},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2872":511,"_25347":460,"_17690":42681,"_5":17585,"_23966":42513,"_2399":42682},[],"`authz` looks for an HTTP rule granting that action.",{"_2872":512,"_25347":460,"_17690":42684,"_5":17585,"_23966":42513,"_2399":42685},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2872":513,"_25347":460,"_17690":42687,"_5":17585,"_23966":42513,"_2399":42688},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2872":514,"_25347":460,"_17690":42690,"_5":17585,"_23966":42513,"_2399":42691},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2872":515,"_25347":460,"_17690":42693,"_5":17585,"_23966":42513,"_2399":42694},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2872":516,"_25347":460,"_17690":42696,"_5":17585,"_23966":42517,"_2399":42697},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2872":517,"_25347":460,"_17690":42699,"_5":17585,"_23966":42517,"_2399":42700},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2872":518,"_25347":460,"_17690":42702,"_5":17585,"_23966":42517,"_2399":42703},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2872":519,"_25347":460,"_17690":42705,"_5":17585,"_23966":42517,"_2399":42706},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2872":520,"_25347":460,"_17690":42708,"_5":17585,"_23966":42517,"_2399":42709},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2872":521,"_25347":460,"_17690":42711,"_5":17585,"_23966":42517,"_2399":42712},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2872":522,"_25347":460,"_17690":42714,"_5":17585,"_23966":42517,"_2399":42715},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2872":523,"_25347":460,"_17690":42717,"_5":17585,"_23966":42517,"_2399":42718},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2872":524,"_25347":460,"_17690":42720,"_5":17585,"_23966":42521,"_2399":42721},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2872":525,"_25347":460,"_17690":42723,"_5":17585,"_23966":42521,"_2399":42724},[],"The decision is made with the domain operation context:",{"_2872":526,"_25347":460,"_17690":42726,"_5":17585,"_23966":42521,"_2399":42727},[],"The middleware extracts the credential and resolves the matching principals.",{"_2872":527,"_25347":460,"_17690":42729,"_5":17585,"_23966":42521,"_2399":42730},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2872":528,"_25347":460,"_17690":42732,"_5":17585,"_23966":42521,"_2399":42733},[],"`authz` gathers the entity rules of the granted policies.",{"_2872":529,"_25347":460,"_17690":42735,"_5":17585,"_23966":42521,"_2399":42736},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2872":530,"_25347":460,"_17690":42738,"_5":17585,"_23966":42521,"_2399":42739},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2872":531,"_25347":460,"_17690":42741,"_5":17585,"_23966":42521,"_2399":42742},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2872":532,"_25347":460,"_17690":42744,"_5":17585,"_23966":42521,"_2399":42745},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2872":533,"_25347":460,"_17690":42747,"_5":17585,"_23966":42521,"_2399":42748},[],"Actions fall into two groups:",{"_2872":534,"_25347":460,"_17690":42750,"_5":17585,"_23966":42521,"_2399":42751},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2872":535,"_25347":460,"_17690":42753,"_5":17585,"_23966":42521,"_2399":42754},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2872":536,"_25347":460,"_17690":42756,"_5":17585,"_23966":42521,"_2399":42757},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2872":537,"_25347":460,"_17690":42759,"_5":17585,"_23966":42525,"_2399":42760},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2872":538,"_25347":460,"_17690":42762,"_5":17585,"_23966":42525,"_2399":42763},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2872":539,"_25347":460,"_17690":42765,"_5":17585,"_23966":42525,"_2399":42766},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2872":540,"_25347":460,"_17690":42768,"_5":17585,"_23966":42529,"_2399":42769},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2872":541,"_25347":460,"_17690":42771,"_5":17585,"_23966":42529,"_2399":42772},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2872":542,"_25347":460,"_17690":42774,"_5":17585,"_23966":42529,"_2399":42775},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2872":543,"_25347":460,"_17690":42777,"_5":17585,"_23966":42529,"_2399":42778},[],"The implemented operators are:",{"_2872":544,"_25347":460,"_17690":42780,"_5":17585,"_23966":42529,"_2399":42781},[],"`equals`, for exact equality;",{"_2872":545,"_25347":460,"_17690":42783,"_5":17585,"_23966":42529,"_2399":42784},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2872":546,"_25347":460,"_17690":42786,"_5":17585,"_23966":42529,"_2399":42787},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2872":547,"_25347":460,"_17690":42789,"_5":17585,"_23966":42529,"_2399":42790},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2872":548,"_25347":460,"_17690":42792,"_5":17585,"_23966":42533,"_2399":42793},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2872":549,"_25347":460,"_17690":42795,"_5":17585,"_23966":42533,"_2399":42796},[],"The available modes are:",{"_2872":550,"_25347":460,"_17690":42798,"_5":17585,"_23966":42533,"_2399":42799},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2872":551,"_25347":460,"_17690":42801,"_5":17585,"_23966":42533,"_2399":42802},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2872":552,"_25347":460,"_17690":42804,"_5":17585,"_23966":42533,"_2399":42805},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2872":553,"_25347":460,"_17690":42807,"_5":17585,"_23966":42533,"_2399":42808},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2872":554,"_25347":460,"_17690":42810,"_5":17585,"_23966":42533,"_2399":42811},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2872":555,"_25347":460,"_17690":42813,"_5":17585,"_23966":42533,"_2399":42814},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2872":556,"_25347":460,"_17690":42816,"_5":17585,"_23966":42537,"_2399":42817},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2872":557,"_25347":460,"_17690":42819,"_5":17585,"_23966":42537,"_2399":42820},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2872":558,"_25347":460,"_17690":42822,"_5":17585,"_23966":42537,"_2399":42823},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2872":559,"_25347":460,"_17690":42825,"_5":17585,"_23966":42537,"_2399":42826},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2872":560,"_25347":460,"_17690":42828,"_5":17585,"_23966":42545,"_2399":42829},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2872":561,"_25347":460,"_17690":42831,"_5":17585,"_23966":42545,"_2399":42832},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2872":562,"_25347":460,"_17690":42834,"_5":17585,"_23966":42549,"_2399":42835},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2872":563,"_25347":460,"_17690":42837,"_5":17585,"_23966":42549,"_2399":42838},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2872":564,"_25347":460,"_17690":42840,"_5":17585,"_23966":42553,"_2399":42841},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2872":565,"_25347":460,"_17690":42843,"_5":17585,"_23966":42553,"_2399":42844},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2872":566,"_25347":460,"_17690":42846,"_5":17585,"_23966":42553,"_2399":42847},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2872":567,"_25347":460,"_17690":42849,"_5":17585,"_23966":42557,"_2399":42850},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2872":568,"_25347":460,"_17690":42852,"_5":17585,"_23966":42557,"_2399":42853},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2872":569,"_25347":460,"_17690":42855,"_5":17585,"_23966":42557,"_2399":42856},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2872":570,"_25347":460,"_17690":42858,"_5":17585,"_23966":42557,"_2399":42859},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2872":571,"_25347":460,"_17690":42861,"_5":17585,"_23966":42557,"_2399":42862},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2872":572,"_25347":460,"_17690":42864,"_5":17585,"_23966":42557,"_2399":42865},[],"Note that:",{"_2872":573,"_25347":460,"_17690":42867,"_5":17585,"_23966":42557,"_2399":42868},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2872":574,"_25347":460,"_17690":42870,"_5":17585,"_23966":42557,"_2399":42871},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2872":575,"_25347":460,"_17690":42873,"_5":17585,"_23966":42557,"_2399":42874},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2872":576,"_25347":460,"_17690":42876,"_5":17585,"_23966":42561,"_2399":42877},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2872":577,"_25347":460,"_17690":42879,"_5":17585,"_23966":42561,"_2399":42880},[],"full and read-only access to certificates and authorities;",{"_2872":578,"_25347":460,"_17690":42882,"_5":17585,"_23966":42561,"_2399":42883},[],"full and read-only access to the KMS;",{"_2872":579,"_25347":460,"_17690":42885,"_5":17585,"_23966":42561,"_2399":42886},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2872":580,"_25347":460,"_17690":42888,"_5":17585,"_23966":42561,"_2399":42889},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2872":581,"_25347":460,"_17690":42891,"_5":17585,"_23966":42561,"_2399":42892},[],"console access;",{"_2872":582,"_25347":460,"_17690":42894,"_5":17585,"_23966":42561,"_2399":42895},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2872":583,"_25347":460,"_17690":42897,"_5":17585,"_23966":42561,"_2399":42898},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2872":584,"_25347":460,"_17690":42900,"_5":17585,"_23966":42561,"_2399":42901},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2872":585,"_25347":460,"_17690":42903,"_5":17585,"_23966":42565,"_2399":42904},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2872":586,"_25347":460,"_17690":42906,"_5":17585,"_23966":42565,"_2399":42907},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2872":587,"_25347":460,"_17690":42909,"_5":17585,"_23966":42565,"_2399":42910},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2872":588,"_25347":460,"_17690":42912,"_5":17585,"_23966":42568,"_2399":42913},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2872":589,"_25347":460,"_17690":42915,"_5":17585,"_23966":42572,"_2399":42916},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2872":590,"_25347":460,"_17690":42918,"_5":17585,"_23966":42576,"_2399":42919},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2872":591,"_25347":460,"_17690":42921,"_5":17585,"_23966":42580,"_2399":42922},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2872":592,"_25347":460,"_17690":42924,"_5":17585,"_23966":42584,"_2399":42925},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2872":593,"_25347":460,"_17690":42927,"_5":17585,"_23966":42588,"_2399":42928},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2872":594,"_25347":460,"_17690":42930,"_5":17585,"_23966":42588,"_2399":42931},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2872":595,"_25347":460,"_17690":42933,"_5":17585,"_23966":42592,"_2399":42934},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2872":596,"_25347":460,"_17690":42936,"_5":17585,"_23966":42592,"_2399":42937},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2872":597,"_25347":460,"_17690":42939,"_5":17585,"_23966":42592,"_2399":42940},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2872":598,"_25347":460,"_17690":42942,"_5":17585,"_23966":42592,"_2399":42943},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2872":599,"_25347":460,"_17690":42945,"_5":17585,"_23966":42592,"_2399":42946},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2872":600,"_25347":460,"_17690":42948,"_5":17585,"_23966":42592,"_2399":42949},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2872":601,"_25347":460,"_17690":42951,"_5":17585,"_23966":42592,"_2399":42952},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2872":602,"_25347":460,"_17690":42954,"_5":17585,"_23966":42592,"_2399":42955},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2872":603,"_25347":460,"_17690":42957,"_5":17585,"_23966":42596,"_2399":42958},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2872":604,"_25347":460,"_17690":42960,"_5":17585,"_23966":42596,"_2399":42961},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2872":605,"_25347":460,"_17690":42963,"_5":17585,"_23966":42596,"_2399":42964},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2872":606,"_25347":460,"_17690":42966,"_5":17585,"_23966":42600,"_2399":42967},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2872":607,"_25347":460,"_17690":42969,"_5":17585,"_23966":42600,"_2399":42970},[],"Use groups or stable roles for people and independent identities for automations.",{"_2872":608,"_25347":460,"_17690":42972,"_5":17585,"_23966":42600,"_2399":42973},[],"Keep at least two recovery administrators and test their access periodically.",{"_2872":609,"_25347":460,"_17690":42975,"_5":17585,"_23966":42600,"_2399":42976},[],"Review active principals, their matches and their grants after IdP changes.",{"_2872":610,"_25347":460,"_17690":42978,"_5":17585,"_23966":42600,"_2399":42979},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2872":611,"_25347":460,"_17690":42981,"_5":17585,"_23966":42600,"_2399":42982},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2872":612,"_25347":460,"_17690":42984,"_5":17585,"_23966":42600,"_2399":42985},[],"Always test one allowed and one denied operation for each role.",{"_2872":613,"_25347":460,"_17690":42987,"_5":17585,"_23966":42600,"_2399":42988},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2872":614,"_25347":460,"_17690":42990,"_5":17585,"_23966":42608,"_2399":42991},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2872":615,"_25347":460,"_17690":42993,"_5":17585,"_23966":42612,"_2399":42994},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2872":616,"_25347":460,"_17690":42996,"_5":17585,"_23966":42612,"_2399":42997},[],"that an active principal of the correct type exists;",{"_2872":617,"_25347":460,"_17690":42999,"_5":17585,"_23966":42612,"_2399":43000},[],"that the claim paths and values match the real token exactly;",{"_2872":618,"_25347":460,"_17690":43002,"_5":17585,"_23966":42612,"_2399":43003},[],"that all of the principal's conditions hold;",{"_2872":619,"_25347":460,"_17690":43005,"_5":17585,"_23966":42612,"_2399":43006},[],"that the principal has the expected policy granted;",{"_2872":620,"_25347":460,"_17690":43008,"_5":17585,"_23966":42612,"_2399":43009},[],"that the policy includes the action and the requested resource type or route;",{"_2872":621,"_25347":460,"_17690":43011,"_5":17585,"_23966":42612,"_2399":43012},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2872":622,"_25347":460,"_17690":43014,"_5":17585,"_23966":42612,"_2399":43015},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2872":623,"_25347":460,"_17690":43017,"_5":17585,"_23966":42616,"_2399":43018},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2872":624,"_25347":460,"_17690":43020,"_5":17585,"_23966":42620,"_2399":43021},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2872":625,"_25347":460,"_17690":43023,"_5":17585,"_23966":42624,"_2399":43024},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2872":626,"_25347":460,"_17690":43026,"_5":17585,"_23966":42624,"_2399":43027},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2872":627,"_25347":627,"_5":12438,"_2399":43029,"_25683":43030,"_17690":43031,"_23966":627},"Alerts and subscriptions",[41104,42497,42498],[],{"_2872":628,"_25347":627,"_17690":43033,"_5":17585,"_23966":627,"_2399":43034},[],"Send PKI events to people and external systems.",{"_2872":629,"_25347":627,"_5":25680,"_17690":43036,"_23966":43037,"_2399":43038},[],"/docs/pr-preview/pr-42/platform/administration/alerts#how-it-works","How it works",{"_2872":630,"_25347":627,"_5":25680,"_17690":43040,"_23966":43041,"_2399":43042},[],"/docs/pr-preview/pr-42/platform/administration/alerts#available-channels","Available channels",{"_2872":631,"_25347":627,"_5":25680,"_17690":43044,"_23966":43045,"_2399":43046},[],"/docs/pr-preview/pr-42/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2872":632,"_25347":627,"_5":25680,"_17690":43048,"_23966":43049,"_2399":43050},[],"/docs/pr-preview/pr-42/platform/administration/alerts#choose-the-event","Choose the event",{"_2872":633,"_25347":627,"_5":25680,"_17690":43052,"_23966":43053,"_2399":43054},[],"/docs/pr-preview/pr-42/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2872":634,"_25347":627,"_5":25680,"_17690":43056,"_23966":43057,"_2399":43058},[],"/docs/pr-preview/pr-42/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2872":635,"_25347":627,"_5":25680,"_17690":43060,"_23966":43061,"_2399":43062},[],"/docs/pr-preview/pr-42/platform/administration/alerts#review-and-activate","Review and activate",{"_2872":636,"_25347":627,"_5":25680,"_17690":43064,"_23966":43065,"_2399":43066},[],"/docs/pr-preview/pr-42/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2872":637,"_25347":627,"_5":25680,"_17690":43068,"_23966":43069,"_2399":43070},[],"/docs/pr-preview/pr-42/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2872":638,"_25347":627,"_5":25680,"_17690":43072,"_23966":43073,"_2399":43074},[],"/docs/pr-preview/pr-42/platform/administration/alerts#event-families","Event families",{"_2872":639,"_25347":627,"_17690":43076,"_5":17585,"_23966":627,"_2399":43077},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2872":640,"_25347":627,"_17690":43079,"_5":17585,"_23966":43037,"_2399":43080},[],"A service publishes a domain event.",{"_2872":641,"_25347":627,"_17690":43082,"_5":17585,"_23966":43037,"_2399":43083},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2872":642,"_25347":627,"_17690":43085,"_5":17585,"_23966":43037,"_2399":43086},[],"Each subscription's filter decides whether it should be notified.",{"_2872":643,"_25347":627,"_17690":43088,"_5":17585,"_23966":43037,"_2399":43089},[],"Lamassu delivers the event to the configured channel.",{"_2872":644,"_25347":627,"_17690":43091,"_5":17585,"_23966":43037,"_2399":43092},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2872":645,"_25347":627,"_17690":43094,"_5":17585,"_23966":43041,"_2399":43095},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2872":646,"_25347":627,"_17690":43097,"_5":17585,"_23966":43041,"_2399":43098},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2872":647,"_25347":627,"_17690":43100,"_5":17585,"_23966":43041,"_2399":43101},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2872":648,"_25347":627,"_17690":43103,"_5":17585,"_23966":43041,"_2399":43104},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2872":649,"_25347":627,"_17690":43106,"_5":17585,"_23966":43041,"_2399":43107},[],"`apikey_options` requires `header` and `key`.",{"_2872":650,"_25347":627,"_17690":43109,"_5":17585,"_23966":43041,"_2399":43110},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2872":651,"_25347":627,"_17690":43112,"_5":17585,"_23966":43041,"_2399":43113},[],"`mtls_options` requires the inline PEM `cert_content` and `key_content`; values that reference files on the server are rejected.",{"_2872":652,"_25347":627,"_17690":43115,"_5":17585,"_23966":43041,"_2399":43116},[],"The alerts API reference documents the full `http_client` schema.",{"_2872":653,"_25347":627,"_17690":43118,"_5":17585,"_23966":43049,"_2399":43119},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2872":654,"_25347":627,"_17690":43121,"_5":17585,"_23966":43053,"_2399":43122},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2872":655,"_25347":627,"_17690":43124,"_5":17585,"_23966":43057,"_2399":43125},[],"Add a filter if you don't want to receive every instance of the event.",{"_2872":656,"_25347":627,"_17690":43127,"_5":17585,"_23966":43057,"_2399":43128},[],"**None** notifies all instances of the event.",{"_2872":657,"_25347":627,"_17690":43130,"_5":17585,"_23966":43057,"_2399":43131},[],"**JSON Path** evaluates one or more specific fields.",{"_2872":658,"_25347":627,"_17690":43133,"_5":17585,"_23966":43057,"_2399":43134},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2872":659,"_25347":627,"_17690":43136,"_5":17585,"_23966":43057,"_2399":43137},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2872":660,"_25347":627,"_17690":43139,"_5":17585,"_23966":43057,"_2399":43140},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2872":661,"_25347":627,"_17690":43142,"_5":17585,"_23966":43061,"_2399":43143},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2872":662,"_25347":627,"_17690":43145,"_5":17585,"_23966":43065,"_2399":43146},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2872":663,"_25347":627,"_17690":43148,"_5":17585,"_23966":43065,"_2399":43149},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2872":664,"_25347":627,"_17690":43151,"_5":17585,"_23966":43065,"_2399":43152},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2872":665,"_25347":627,"_17690":43154,"_5":17585,"_23966":43065,"_2399":43155},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2872":666,"_25347":627,"_17690":43157,"_5":17585,"_23966":43065,"_2399":43158},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2872":667,"_25347":627,"_17690":43160,"_5":17585,"_23966":43065,"_2399":43161},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2872":668,"_25347":627,"_17690":43163,"_5":17585,"_23966":43065,"_2399":43164},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2872":669,"_25347":627,"_17690":43166,"_5":17585,"_23966":43065,"_2399":43167},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2872":670,"_25347":627,"_17690":43169,"_5":17585,"_23966":43069,"_2399":43170},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2872":671,"_25347":627,"_17690":43172,"_5":17585,"_23966":43073,"_2399":43173},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2872":672,"_25347":627,"_17690":43175,"_5":17585,"_23966":43073,"_2399":43176},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2872":673,"_25347":627,"_17690":43178,"_5":17585,"_23966":43073,"_2399":43179},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2872":674,"_25347":627,"_17690":43181,"_5":17585,"_23966":43073,"_2399":43182},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2872":675,"_25347":627,"_17690":43184,"_5":17585,"_23966":43073,"_2399":43185},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2872":676,"_25347":627,"_17690":43187,"_5":17585,"_23966":43073,"_2399":43188},[],"**Validation:** `va.role.crl.create`.",{"_2872":677,"_25347":627,"_17690":43190,"_5":17585,"_23966":43073,"_2399":43191},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2872":678,"_25347":627,"_17690":43193,"_5":17585,"_23966":43073,"_2399":43194},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2872":679,"_25347":679,"_5":12438,"_2399":43196,"_25683":43197,"_17690":43198,"_23966":679},"Audit logs",[41104,42497,42498],[],{"_2872":680,"_25347":679,"_17690":43200,"_5":17585,"_23966":679,"_2399":43201},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2872":681,"_25347":679,"_5":25680,"_17690":43203,"_23966":43204,"_2399":43205},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2872":682,"_25347":679,"_5":25680,"_17690":43207,"_23966":43208,"_2399":43209},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#coverage","Coverage",{"_2872":683,"_25347":679,"_5":25680,"_17690":43211,"_23966":43212,"_2399":43213},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2872":684,"_25347":679,"_5":25680,"_17690":43215,"_23966":43216,"_2399":43217},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2872":685,"_25347":679,"_5":25680,"_17690":43219,"_23966":43220,"_2399":43221},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2872":686,"_25347":679,"_5":25680,"_17690":43223,"_23966":43224,"_2399":43225},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2872":687,"_25347":679,"_5":25680,"_17690":43227,"_23966":43228,"_2399":43229},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2872":688,"_25347":679,"_5":25680,"_17690":43231,"_23966":43232,"_2399":43233},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2872":689,"_25347":679,"_5":25680,"_17690":43235,"_23966":43236,"_2399":43237},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2872":690,"_25347":679,"_5":25680,"_17690":43239,"_23966":43240,"_2399":43241},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2872":691,"_25347":679,"_5":25680,"_17690":43243,"_23966":43244,"_2399":43245},[],"/docs/pr-preview/pr-42/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2872":692,"_25347":679,"_17690":43247,"_5":17585,"_23966":679,"_2399":43248},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2872":693,"_25347":679,"_17690":43250,"_5":17585,"_23966":43204,"_2399":43251},[],"The audit body includes:",{"_2872":694,"_25347":679,"_17690":43253,"_5":17585,"_23966":43204,"_2399":43254},[],"input: data received by the operation;",{"_2872":695,"_25347":679,"_17690":43256,"_5":17585,"_23966":43204,"_2399":43257},[],"has\\_error: whether the service returned an error;",{"_2872":696,"_25347":679,"_17690":43259,"_5":17585,"_23966":43204,"_2399":43260},[],"output: produced result or error message;",{"_2872":697,"_25347":679,"_17690":43262,"_5":17585,"_23966":43204,"_2399":43263},[],"principals: identifiers of the principals that matched the request.",{"_2872":698,"_25347":679,"_17690":43265,"_5":17585,"_23966":43204,"_2399":43266},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2872":699,"_25347":679,"_17690":43268,"_5":17585,"_23966":43204,"_2399":43269},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2872":700,"_25347":679,"_17690":43271,"_5":17585,"_23966":43208,"_2399":43272},[],"The backend applies auditing to mutations of:",{"_2872":701,"_25347":679,"_17690":43274,"_5":17585,"_23966":43208,"_2399":43275},[],"authorities, certificates and issuance profiles;",{"_2872":702,"_25347":679,"_17690":43277,"_5":17585,"_23966":43208,"_2399":43278},[],"keys and KMS engines;",{"_2872":703,"_25347":679,"_17690":43280,"_5":17585,"_23966":43208,"_2399":43281},[],"devices and identities;",{"_2872":704,"_25347":679,"_17690":43283,"_5":17585,"_23966":43208,"_2399":43284},[],"DMSs and enrollment operations;",{"_2872":705,"_25347":679,"_17690":43286,"_5":17585,"_23966":43208,"_2399":43287},[],"validation functions and CRL;",{"_2872":706,"_25347":679,"_17690":43289,"_5":17585,"_23966":43208,"_2399":43290},[],"principals, policies and authorization grants.",{"_2872":707,"_25347":679,"_17690":43292,"_5":17585,"_23966":43208,"_2399":43293},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2872":708,"_25347":679,"_17690":43295,"_5":17585,"_23966":43212,"_2399":43296},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2872":709,"_25347":679,"_17690":43298,"_5":17585,"_23966":43212,"_2399":43299},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2872":710,"_25347":679,"_17690":43301,"_5":17585,"_23966":43212,"_2399":43302},[],"Design the consumer to:",{"_2872":711,"_25347":679,"_17690":43304,"_5":17585,"_23966":43212,"_2399":43305},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2872":712,"_25347":679,"_17690":43307,"_5":17585,"_23966":43212,"_2399":43308},[],"keep the complete CloudEvent unmodified;",{"_2872":713,"_25347":679,"_17690":43310,"_5":17585,"_23966":43212,"_2399":43311},[],"record the ingestion time and detect duplicates by ID;",{"_2872":714,"_25347":679,"_17690":43313,"_5":17585,"_23966":43212,"_2399":43314},[],"encrypt in transit and at rest;",{"_2872":715,"_25347":679,"_17690":43316,"_5":17585,"_23966":43212,"_2399":43317},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2872":716,"_25347":679,"_17690":43319,"_5":17585,"_23966":43212,"_2399":43320},[],"apply an explicit retention and legal hold policy;",{"_2872":717,"_25347":679,"_17690":43322,"_5":17585,"_23966":43212,"_2399":43323},[],"alert if it stops consuming or the pending queue grows.",{"_2872":718,"_25347":679,"_17690":43325,"_5":17585,"_23966":43216,"_2399":43326},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2872":719,"_25347":679,"_17690":43328,"_5":17585,"_23966":43216,"_2399":43329},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2872":720,"_25347":679,"_17690":43331,"_5":17585,"_23966":43224,"_2399":43332},[],"Start from the reported time and normalize every source to UTC.",{"_2872":721,"_25347":679,"_17690":43334,"_5":17585,"_23966":43228,"_2399":43335},[],"Filter by event type, service source and resource identifier.",{"_2872":722,"_25347":679,"_17690":43337,"_5":17585,"_23966":43232,"_2399":43338},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2872":723,"_25347":679,"_17690":43340,"_5":17585,"_23966":43236,"_2399":43341},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2872":724,"_25347":679,"_17690":43343,"_5":17585,"_23966":43240,"_2399":43344},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2872":725,"_25347":679,"_17690":43346,"_5":17585,"_23966":43244,"_2399":43347},[],"Generate a controlled mutation in a test environment and check that:",{"_2872":726,"_25347":679,"_17690":43349,"_5":17585,"_23966":43244,"_2399":43350},[],"a successful audit event appears;",{"_2872":727,"_25347":679,"_17690":43352,"_5":17585,"_23966":43244,"_2399":43353},[],"the principal matches the identity used;",{"_2872":728,"_25347":679,"_17690":43355,"_5":17585,"_23966":43244,"_2399":43356},[],"the consumer persists it exactly once;",{"_2872":729,"_25347":679,"_17690":43358,"_5":17585,"_23966":43244,"_2399":43359},[],"it can be retrieved by resource, actor and period;",{"_2872":730,"_25347":679,"_17690":43361,"_5":17585,"_23966":43244,"_2399":43362},[],"a consumer outage raises an alert.",{"_2872":731,"_25347":679,"_17690":43364,"_5":17585,"_23966":43244,"_2399":43365},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2872":732,"_25347":732,"_5":12438,"_2399":43367,"_25683":43368,"_17690":43369,"_23966":732},"Platform architecture",[41104,42497],[],{"_2872":733,"_25347":732,"_17690":43371,"_5":17585,"_23966":732,"_2399":43372},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2872":734,"_25347":732,"_5":25680,"_17690":43374,"_23966":43375,"_2399":43376},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#control-plane","Control plane",{"_2872":735,"_25347":732,"_5":25680,"_17690":43378,"_23966":43379,"_2399":43380},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2872":736,"_25347":732,"_5":25680,"_17690":43382,"_23966":43383,"_2399":43384},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2872":737,"_25347":732,"_5":25680,"_17690":43386,"_23966":43387,"_2399":43388},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#status-and-validation","Status and validation",{"_2872":738,"_25347":732,"_5":25680,"_17690":43390,"_23966":43391,"_2399":43392},[],"/docs/pr-preview/pr-42/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2872":739,"_25347":732,"_17690":43394,"_5":17585,"_23966":732,"_2399":43395},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2872":740,"_25347":732,"_17690":43397,"_5":17585,"_23966":732,"_2399":43398},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2872":741,"_25347":732,"_17690":43400,"_5":17585,"_23966":43375,"_2399":43401},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2872":742,"_25347":732,"_17690":43403,"_5":17585,"_23966":43379,"_2399":43404},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2872":743,"_25347":732,"_17690":43406,"_5":17585,"_23966":43383,"_2399":43407},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2872":744,"_25347":732,"_17690":43409,"_5":17585,"_23966":43387,"_2399":43410},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2872":745,"_25347":732,"_17690":43412,"_5":17585,"_23966":43391,"_2399":43413},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2872":746,"_25347":746,"_5":12438,"_2399":43415,"_25683":43416,"_17690":43417,"_23966":746},"How Lamassu works",[41104,42497],[],{"_2872":747,"_25347":746,"_17690":43419,"_5":17585,"_23966":746,"_2399":43420},[],"The mental model of trust, keys, certificates and devices.",{"_2872":748,"_25347":746,"_5":25680,"_17690":43422,"_23966":43423,"_2399":43424},[],"/docs/pr-preview/pr-42/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2872":749,"_25347":746,"_5":25680,"_17690":43426,"_23966":43427,"_2399":43428},[],"/docs/pr-preview/pr-42/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2872":750,"_25347":746,"_17690":43430,"_5":17585,"_23966":746,"_2399":43431},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2872":751,"_25347":746,"_17690":43433,"_5":17585,"_23966":43423,"_2399":43434},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2872":752,"_25347":746,"_17690":43436,"_5":17585,"_23966":43423,"_2399":43437},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2872":753,"_25347":746,"_17690":43439,"_5":17585,"_23966":43423,"_2399":43440},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2872":754,"_25347":746,"_17690":43442,"_5":17585,"_23966":43423,"_2399":43443},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2872":755,"_25347":746,"_17690":43445,"_5":17585,"_23966":43423,"_2399":43446},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2872":756,"_25347":746,"_17690":43448,"_5":17585,"_23966":43427,"_2399":43449},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2872":757,"_25347":746,"_17690":43451,"_5":17585,"_23966":43427,"_2399":43452},[],"A DMS relates that CA to an enrollment policy.",{"_2872":758,"_25347":746,"_17690":43454,"_5":17585,"_23966":43427,"_2399":43455},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2872":759,"_25347":746,"_17690":43457,"_5":17585,"_23966":43427,"_2399":43458},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2872":760,"_25347":746,"_17690":43460,"_5":17585,"_23966":43427,"_2399":43461},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2872":761,"_25347":746,"_17690":43463,"_5":17585,"_23966":43427,"_2399":43464},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2872":762,"_25347":746,"_17690":43466,"_5":17585,"_23966":43427,"_2399":43467},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2872":763,"_25347":763,"_5":12438,"_2399":43469,"_25683":43470,"_17690":43472,"_23966":763},"Devices and identities",[41104,42497,43471,43469],"IoT Fleets",[],{"_2872":764,"_25347":763,"_17690":43474,"_5":17585,"_23966":763,"_2399":43475},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2872":765,"_25347":763,"_5":25680,"_17690":43477,"_23966":43478,"_2399":43479},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#device-states","Device states",{"_2872":766,"_25347":763,"_5":25680,"_17690":43481,"_23966":43482,"_2399":43483},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2872":767,"_25347":763,"_5":25680,"_17690":43485,"_23966":43486,"_2399":43487},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2872":768,"_25347":763,"_5":25680,"_17690":43489,"_23966":43490,"_2399":43491},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2872":769,"_25347":763,"_5":25680,"_17690":43493,"_23966":43494,"_2399":43495},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2872":770,"_25347":763,"_5":25680,"_17690":43497,"_23966":43498,"_2399":43499},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2872":771,"_25347":763,"_5":25680,"_17690":43501,"_23966":43502,"_2399":43503},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2872":772,"_25347":763,"_5":25680,"_17690":43505,"_23966":43506,"_2399":43507},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2872":773,"_25347":763,"_5":25680,"_17690":43509,"_23966":43510,"_2399":43511},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2872":774,"_25347":763,"_5":25680,"_17690":43513,"_23966":43514,"_2399":43515},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2872":775,"_25347":763,"_5":25680,"_17690":43517,"_23966":43518,"_2399":43519},[],"/docs/pr-preview/pr-42/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2872":776,"_25347":763,"_17690":43521,"_5":17585,"_23966":763,"_2399":43522},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2872":777,"_25347":763,"_17690":43524,"_5":17585,"_23966":763,"_2399":43525},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2872":778,"_25347":763,"_17690":43527,"_5":17585,"_23966":43478,"_2399":43528},[],"Operational view",{"_2872":779,"_25347":763,"_17690":43530,"_5":17585,"_23966":43478,"_2399":43531},[],"Meaning",{"_2872":780,"_25347":763,"_17690":43533,"_5":17585,"_23966":43478,"_2399":43534},[],"**No Identity**",{"_2872":781,"_25347":763,"_17690":43536,"_5":17585,"_23966":43478,"_2399":43537},[],"A record exists without an associated identity.",{"_2872":782,"_25347":763,"_17690":43539,"_5":17585,"_23966":43478,"_2399":43540},[],"**Active**",{"_2872":783,"_25347":763,"_17690":43542,"_5":17585,"_23966":43478,"_2399":43543},[],"The slot is active; also check certificate dates, status and usages.",{"_2872":784,"_25347":763,"_17690":43545,"_5":17585,"_23966":43478,"_2399":43546},[],"**Renewal Pending**",{"_2872":785,"_25347":763,"_17690":43548,"_5":17585,"_23966":43478,"_2399":43549},[],"The identity is in the operational renewal window.",{"_2872":786,"_25347":763,"_17690":43551,"_5":17585,"_23966":43478,"_2399":43552},[],"**Expiring Soon**",{"_2872":787,"_25347":763,"_17690":43554,"_5":17585,"_23966":43478,"_2399":43555},[],"Expiration is approaching according to configured thresholds.",{"_2872":788,"_25347":763,"_17690":43557,"_5":17585,"_23966":43478,"_2399":43558},[],"**Expired**",{"_2872":789,"_25347":763,"_17690":43560,"_5":17585,"_23966":43478,"_2399":43561},[],"The identity has expired.",{"_2872":790,"_25347":763,"_17690":43563,"_5":17585,"_23966":43478,"_2399":43564},[],"**Revoked**",{"_2872":791,"_25347":763,"_17690":43566,"_5":17585,"_23966":43478,"_2399":43567},[],"The identity is marked revoked.",{"_2872":792,"_25347":763,"_17690":43569,"_5":17585,"_23966":43478,"_2399":43570},[],"**Decommissioned**",{"_2872":793,"_25347":763,"_17690":43572,"_5":17585,"_23966":43478,"_2399":43573},[],"The record is retired and ordinary updates do not restore operation.",{"_2872":794,"_25347":763,"_17690":43575,"_5":17585,"_23966":43478,"_2399":43576},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2872":795,"_25347":763,"_17690":43578,"_5":17585,"_23966":43482,"_2399":43579},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2872":796,"_25347":763,"_17690":43581,"_5":17585,"_23966":43482,"_2399":43582},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2872":797,"_25347":763,"_17690":43584,"_5":17585,"_23966":43482,"_2399":43585},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2872":798,"_25347":763,"_17690":43587,"_5":17585,"_23966":43482,"_2399":43588},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2872":799,"_25347":763,"_17690":43590,"_5":17585,"_23966":43486,"_2399":43591},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2872":800,"_25347":763,"_17690":43593,"_5":17585,"_23966":43490,"_2399":43594},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2872":801,"_25347":763,"_17690":43596,"_5":17585,"_23966":43494,"_2399":43597},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2872":802,"_25347":763,"_17690":43599,"_5":17585,"_23966":43498,"_2399":43600},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2872":803,"_25347":763,"_17690":43602,"_5":17585,"_23966":43502,"_2399":43603},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2872":804,"_25347":763,"_17690":43605,"_5":17585,"_23966":43502,"_2399":43606},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2872":805,"_25347":763,"_17690":43608,"_5":17585,"_23966":43506,"_2399":43609},[],"From **No Identity**, use **Assign Identity**:",{"_2872":806,"_25347":763,"_17690":43611,"_5":17585,"_23966":43506,"_2399":43612},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2872":807,"_25347":763,"_17690":43614,"_5":17585,"_23966":43506,"_2399":43615},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2872":808,"_25347":763,"_17690":43617,"_5":17585,"_23966":43506,"_2399":43618},[],"Confirm and read the serial, active version and history again.",{"_2872":809,"_25347":763,"_17690":43620,"_5":17585,"_23966":43506,"_2399":43621},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2872":810,"_25347":763,"_17690":43623,"_5":17585,"_23966":43506,"_2399":43624},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2872":811,"_25347":763,"_17690":43626,"_5":17585,"_23966":43510,"_2399":43627},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2872":812,"_25347":763,"_17690":43629,"_5":17585,"_23966":43510,"_2399":43630},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2872":813,"_25347":763,"_17690":43632,"_5":17585,"_23966":43514,"_2399":43633},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2872":814,"_25347":763,"_17690":43635,"_5":17585,"_23966":43514,"_2399":43636},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2872":815,"_25347":763,"_17690":43638,"_5":17585,"_23966":43514,"_2399":43639},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2872":816,"_25347":763,"_17690":43641,"_5":17585,"_23966":43514,"_2399":43642},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2872":817,"_25347":763,"_17690":43644,"_5":17585,"_23966":43518,"_2399":43645},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2872":818,"_25347":763,"_17690":43647,"_5":17585,"_23966":43518,"_2399":43648},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2872":819,"_25347":819,"_5":12438,"_2399":43650,"_25683":43651,"_17690":43653,"_23966":819},"Bootstrap identity and authentication",[41104,42497,43471,43469,43652],"Enrollment with PKI",[],{"_2872":820,"_25347":819,"_17690":43655,"_5":17585,"_23966":819,"_2399":43656},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2872":821,"_25347":819,"_5":25680,"_17690":43658,"_23966":43659,"_2399":43660},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2872":822,"_25347":819,"_5":25680,"_17690":43662,"_23966":43663,"_2399":43664},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2872":823,"_25347":819,"_5":25680,"_17690":43666,"_23966":43667,"_2399":43668},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2872":824,"_25347":819,"_5":25680,"_17690":43670,"_23966":43671,"_2399":43672},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2872":825,"_25347":819,"_5":25680,"_17690":43674,"_23966":43675,"_2399":43676},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2872":826,"_25347":819,"_17690":43678,"_5":17585,"_23966":819,"_2399":43679},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2872":827,"_25347":819,"_17690":43681,"_5":17585,"_23966":43659,"_2399":43682},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2872":828,"_25347":819,"_17690":43684,"_5":17585,"_23966":43659,"_2399":43685},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2872":829,"_25347":819,"_17690":43687,"_5":17585,"_23966":43663,"_2399":43688},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2872":830,"_25347":819,"_17690":43690,"_5":17585,"_23966":43663,"_2399":43691},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2872":831,"_25347":819,"_17690":43693,"_5":17585,"_23966":43663,"_2399":43694},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2872":832,"_25347":819,"_17690":43696,"_5":17585,"_23966":43667,"_2399":43697},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2872":833,"_25347":819,"_17690":43699,"_5":17585,"_23966":43667,"_2399":43700},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2872":834,"_25347":819,"_17690":43702,"_5":17585,"_23966":43671,"_2399":43703},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2872":835,"_25347":819,"_17690":43705,"_5":17585,"_23966":43671,"_2399":43706},[],"Example body:",{"_2872":836,"_25347":819,"_17690":43708,"_5":17585,"_23966":43671,"_2399":43709},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2872":837,"_25347":819,"_17690":43711,"_5":17585,"_23966":43671,"_2399":43712},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2872":838,"_25347":819,"_17690":43714,"_5":17585,"_23966":43671,"_2399":43715},[],"Continuation requires a successful HTTP response and JSON:",{"_2872":839,"_25347":819,"_17690":43717,"_5":17585,"_23966":43671,"_2399":43718},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2872":840,"_25347":819,"_17690":43720,"_5":17585,"_23966":43675,"_2399":43721},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2872":841,"_25347":819,"_17690":43723,"_5":17585,"_23966":43675,"_2399":43724},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2872":842,"_25347":842,"_5":12438,"_2399":43726,"_25683":43727,"_17690":43728,"_23966":842},"Configure and operate the DMS",[41104,42497,43471,43469,43652],[],{"_2872":843,"_25347":842,"_17690":43730,"_5":17585,"_23966":842,"_2399":43731},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2872":844,"_25347":842,"_5":25680,"_17690":43733,"_23966":43734,"_2399":41114},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2872":845,"_25347":842,"_5":25680,"_17690":43736,"_23966":43737,"_2399":43738},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2872":846,"_25347":842,"_5":25680,"_17690":43740,"_23966":43741,"_2399":43742},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2872":847,"_25347":842,"_5":25680,"_17690":43744,"_23966":43745,"_2399":43746},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2872":848,"_25347":842,"_5":25680,"_17690":43748,"_23966":43749,"_2399":43750},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2872":849,"_25347":842,"_5":25680,"_17690":43752,"_23966":43753,"_2399":43754},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2872":850,"_25347":842,"_5":25680,"_17690":43756,"_23966":43757,"_2399":43758},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2872":851,"_25347":842,"_5":25680,"_17690":43760,"_23966":43761,"_2399":43762},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2872":852,"_25347":842,"_5":25680,"_17690":43764,"_23966":43765,"_2399":43766},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2872":853,"_25347":842,"_5":25680,"_17690":43768,"_23966":43769,"_2399":43770},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2872":854,"_25347":842,"_5":25680,"_17690":43772,"_23966":43773,"_2399":43774},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2872":855,"_25347":842,"_5":25680,"_17690":43776,"_23966":43777,"_2399":43778},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2872":856,"_25347":842,"_5":25680,"_17690":43780,"_23966":43781,"_2399":43782},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2872":857,"_25347":842,"_5":25680,"_17690":43784,"_23966":43785,"_2399":43786},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2872":858,"_25347":842,"_5":25680,"_17690":43788,"_23966":43789,"_2399":43790},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2872":859,"_25347":842,"_5":25680,"_17690":43792,"_23966":43793,"_2399":43794},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2872":860,"_25347":842,"_5":25680,"_17690":43796,"_23966":43797,"_2399":43798},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2872":861,"_25347":842,"_5":25680,"_17690":43800,"_23966":43801,"_2399":43802},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2872":862,"_25347":842,"_17690":43804,"_5":17585,"_23966":842,"_2399":43805},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2872":863,"_25347":842,"_17690":43807,"_5":17585,"_23966":43734,"_2399":43808},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2872":864,"_25347":842,"_17690":43810,"_5":17585,"_23966":43734,"_2399":43811},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2872":865,"_25347":842,"_17690":43813,"_5":17585,"_23966":43741,"_2399":43814},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2872":866,"_25347":842,"_17690":43816,"_5":17585,"_23966":43745,"_2399":43817},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2872":867,"_25347":842,"_17690":43819,"_5":17585,"_23966":43749,"_2399":43820},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2872":868,"_25347":842,"_17690":43822,"_5":17585,"_23966":43753,"_2399":43823},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2872":869,"_25347":842,"_17690":43825,"_5":17585,"_23966":43757,"_2399":43826},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2872":870,"_25347":842,"_17690":43828,"_5":17585,"_23966":43765,"_2399":43829},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2872":871,"_25347":842,"_17690":43831,"_5":17585,"_23966":43765,"_2399":43832},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2872":872,"_25347":842,"_17690":43834,"_5":17585,"_23966":43769,"_2399":43835},[],"`settings.enrollment_settings` field",{"_2872":873,"_25347":842,"_17690":43837,"_5":17585,"_23966":43769,"_2399":43838},[],"Decision",{"_2872":874,"_25347":842,"_17690":43840,"_5":17585,"_23966":43769,"_2399":43841},[],"`protocol`",{"_2872":875,"_25347":842,"_17690":43843,"_5":17585,"_23966":43769,"_2399":43844},[],"`EST_RFC7030` for these operations.",{"_2872":876,"_25347":842,"_17690":43846,"_5":17585,"_23966":43769,"_2399":43847},[],"`enrollment_ca`",{"_2872":877,"_25347":842,"_17690":43849,"_5":17585,"_23966":43769,"_2399":43850},[],"ID of the signing CA.",{"_2872":878,"_25347":842,"_17690":43852,"_5":17585,"_23966":43769,"_2399":43853},[],"`verify_csr_signature`",{"_2872":879,"_25347":842,"_17690":43855,"_5":17585,"_23966":43769,"_2399":43856},[],"Keep `true` to verify CSR key possession.",{"_2872":880,"_25347":842,"_17690":43858,"_5":17585,"_23966":43769,"_2399":43859},[],"`enable_replaceable_enrollment`",{"_2872":881,"_25347":842,"_17690":43861,"_5":17585,"_23966":43769,"_2399":43862},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2872":882,"_25347":842,"_17690":43864,"_5":17585,"_23966":43769,"_2399":43865},[],"`est_rfc7030_settings.auth_mode`",{"_2872":883,"_25347":842,"_17690":43867,"_5":17585,"_23966":43769,"_2399":43868},[],"One of the four authentication modes.",{"_2872":884,"_25347":842,"_17690":43870,"_5":17585,"_23966":43769,"_2399":43871},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2872":885,"_25347":842,"_17690":43873,"_5":17585,"_23966":43773,"_2399":43874},[],"The blocks are independent:",{"_2872":886,"_25347":842,"_17690":43876,"_5":17585,"_23966":43773,"_2399":43877},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2872":887,"_25347":842,"_17690":43879,"_5":17585,"_23966":43773,"_2399":43880},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2872":888,"_25347":842,"_17690":43882,"_5":17585,"_23966":43773,"_2399":43883},[],"`auth_mode`",{"_2872":889,"_25347":842,"_17690":43885,"_5":17585,"_23966":43773,"_2399":43886},[],"Control applied in the configured operation",{"_2872":890,"_25347":842,"_17690":43888,"_5":17585,"_23966":43773,"_2399":43889},[],"`CLIENT_CERTIFICATE`",{"_2872":891,"_25347":842,"_17690":43891,"_5":17585,"_23966":43773,"_2399":43892},[],"Presented certificate validation.",{"_2872":892,"_25347":842,"_17690":43894,"_5":17585,"_23966":43773,"_2399":43895},[],"`EXTERNAL_WEBHOOK`",{"_2872":893,"_25347":842,"_17690":43897,"_5":17585,"_23966":43773,"_2399":43898},[],"Configured webhook authorization.",{"_2872":894,"_25347":842,"_17690":43900,"_5":17585,"_23966":43773,"_2399":43901},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2872":895,"_25347":842,"_17690":43903,"_5":17585,"_23966":43773,"_2399":43904},[],"Certificate validation followed by webhook approval.",{"_2872":896,"_25347":842,"_17690":43906,"_5":17585,"_23966":43773,"_2399":43907},[],"`NO_AUTH`",{"_2872":897,"_25347":842,"_17690":43909,"_5":17585,"_23966":43773,"_2399":43910},[],"No DMS requester authentication.",{"_2872":898,"_25347":842,"_17690":43912,"_5":17585,"_23966":43773,"_2399":43913},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2872":899,"_25347":842,"_17690":43915,"_5":17585,"_23966":43773,"_2399":43916},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2872":900,"_25347":842,"_17690":43918,"_5":17585,"_23966":43773,"_2399":43919},[],"For certificate re-enrollment, the validator uses the enrollment CA, then `additional_validation_cas`, and `enable_expired_renewal`. Do not assume copying initial `validation_cas` changes those issuers.",{"_2872":901,"_25347":842,"_17690":43921,"_5":17585,"_23966":43773,"_2399":43922},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2872":902,"_25347":842,"_17690":43924,"_5":17585,"_23966":43777,"_2399":43925},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2872":903,"_25347":842,"_17690":43927,"_5":17585,"_23966":43777,"_2399":43928},[],"`external_webhook_settings` field",{"_2872":904,"_25347":842,"_17690":43930,"_5":17585,"_23966":43777,"_2399":43838},[],{"_2872":905,"_25347":842,"_17690":43932,"_5":17585,"_23966":43777,"_2399":43933},[],"`url`",{"_2872":906,"_25347":842,"_17690":43935,"_5":17585,"_23966":43777,"_2399":43936},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2872":907,"_25347":842,"_17690":43938,"_5":17585,"_23966":43777,"_2399":43939},[],"`method`",{"_2872":908,"_25347":842,"_17690":43941,"_5":17585,"_23966":43777,"_2399":43942},[],"`POST` or `PUT`; `POST` by default.",{"_2872":909,"_25347":842,"_17690":43944,"_5":17585,"_23966":43777,"_2399":43945},[],"`name`",{"_2872":910,"_25347":842,"_17690":43947,"_5":17585,"_23966":43777,"_2399":43948},[],"Label used in service logs.",{"_2872":911,"_25347":842,"_17690":43950,"_5":17585,"_23966":43777,"_2399":43951},[],"`config.auth_mode`",{"_2872":912,"_25347":842,"_17690":43953,"_5":17585,"_23966":43777,"_2399":43954},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2872":913,"_25347":842,"_17690":43956,"_5":17585,"_23966":43777,"_2399":43957},[],"`config.apikey_options`",{"_2872":914,"_25347":842,"_17690":43959,"_5":17585,"_23966":43777,"_2399":43960},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2872":915,"_25347":842,"_17690":43962,"_5":17585,"_23966":43777,"_2399":43963},[],"`config.jwt_options`",{"_2872":916,"_25347":842,"_17690":43965,"_5":17585,"_23966":43777,"_2399":43966},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2872":917,"_25347":842,"_17690":43968,"_5":17585,"_23966":43777,"_2399":43969},[],"`config.mtls_options`",{"_2872":918,"_25347":842,"_17690":43971,"_5":17585,"_23966":43777,"_2399":43972},[],"Required for `mtls`: `cert_content` and `key_content` as inline PEM.",{"_2872":919,"_25347":842,"_17690":43974,"_5":17585,"_23966":43777,"_2399":43975},[],"`config.insecure_skip_verify`",{"_2872":920,"_25347":842,"_17690":43977,"_5":17585,"_23966":43777,"_2399":43978},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2872":921,"_25347":842,"_17690":43980,"_5":17585,"_23966":43777,"_2399":43981},[],"`config.call_timeout`",{"_2872":922,"_25347":842,"_17690":43983,"_5":17585,"_23966":43777,"_2399":43984},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2872":923,"_25347":842,"_17690":43986,"_5":17585,"_23966":43777,"_2399":43987},[],"Rules for that configuration:",{"_2872":924,"_25347":842,"_17690":43989,"_5":17585,"_23966":43777,"_2399":43990},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so supply the PEM as `mtls_options.cert_content` and `key_content`.",{"_2872":925,"_25347":842,"_17690":43992,"_5":17585,"_23966":43777,"_2399":43993},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2872":926,"_25347":842,"_17690":43995,"_5":17585,"_23966":43777,"_2399":43996},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2872":927,"_25347":842,"_17690":43998,"_5":17585,"_23966":43777,"_2399":43999},[],"The API ignores the legacy fields `validate_server_cert`, `apikey`, `oidc` and `mtls`. A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` that still carries only the legacy option fields (`apikey`, `oidc`, `mtls`) fails validation with 400; only legacy `noauth` bodies are accepted, and their credentials are dropped.",{"_2872":928,"_25347":842,"_17690":44001,"_5":17585,"_23966":43777,"_2399":44002},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2872":929,"_25347":842,"_17690":44004,"_5":17585,"_23966":43777,"_2399":44005},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2872":930,"_25347":842,"_17690":44007,"_5":17585,"_23966":43777,"_2399":44008},[],"Migration `20260604110000` copies initial authentication into renewal settings if missing and the required structure exists. It preserves existing configuration. After upgrading, read both blocks; if your version’s console does not expose independent settings, use the DMS API.",{"_2872":931,"_25347":842,"_17690":44010,"_5":17585,"_23966":43777,"_2399":44011},[],"Migration `20261021120000` rewrites every stored webhook config into this layout: `validate_server_cert` becomes the negated `insecure_skip_verify` (a config where `validate_server_cert` was false keeps skipping verification), `oidc` becomes `jwt_options`, `apikey` becomes `apikey_options` and `mtls` becomes `mtls_options`. When both the legacy certificate and key are PEM, they move into `mtls_options.cert_content` and `key_content` and need no action. Otherwise, including a mixed config (PEM certificate, file-path key), both values become `mtls_options.cert_file` and `key_file`. Delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are re-entered as PEM content, or the leftover file fields are removed if the webhook does not use mTLS. If your version's console does not expose those fields, edit the DMS through the DMS API.",{"_2872":932,"_25347":842,"_17690":44013,"_5":17585,"_23966":43781,"_2399":44014},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2872":933,"_25347":842,"_17690":44016,"_5":17585,"_23966":43785,"_2399":44017},[],"`settings.reenrollment_settings` field",{"_2872":934,"_25347":842,"_17690":44019,"_5":17585,"_23966":43785,"_2399":41487},[],{"_2872":935,"_25347":842,"_17690":44021,"_5":17585,"_23966":43785,"_2399":44022},[],"`reenrollment_delta`",{"_2872":936,"_25347":842,"_17690":44024,"_5":17585,"_23966":43785,"_2399":44025},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2872":937,"_25347":842,"_17690":44027,"_5":17585,"_23966":43785,"_2399":44028},[],"`preventive_delta`",{"_2872":938,"_25347":842,"_17690":44030,"_5":17585,"_23966":43785,"_2399":44031},[],"Preventive operational monitoring threshold.",{"_2872":939,"_25347":842,"_17690":44033,"_5":17585,"_23966":43785,"_2399":44034},[],"`critical_delta`",{"_2872":940,"_25347":842,"_17690":44036,"_5":17585,"_23966":43785,"_2399":44037},[],"Critical operational monitoring threshold.",{"_2872":941,"_25347":842,"_17690":44039,"_5":17585,"_23966":43785,"_2399":44040},[],"`enable_expired_renewal`",{"_2872":942,"_25347":842,"_17690":44042,"_5":17585,"_23966":43785,"_2399":44043},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2872":943,"_25347":842,"_17690":44045,"_5":17585,"_23966":43785,"_2399":44046},[],"`additional_validation_cas`",{"_2872":944,"_25347":842,"_17690":44048,"_5":17585,"_23966":43785,"_2399":44049},[],"Additional mTLS credential issuers during migration.",{"_2872":945,"_25347":842,"_17690":44051,"_5":17585,"_23966":43785,"_2399":44052},[],"`revoke_on_reenrollment`",{"_2872":946,"_25347":842,"_17690":44054,"_5":17585,"_23966":43785,"_2399":44055},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2872":947,"_25347":842,"_17690":44057,"_5":17585,"_23966":43785,"_2399":44058},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2872":948,"_25347":842,"_17690":44060,"_5":17585,"_23966":43789,"_2399":44061},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2872":949,"_25347":842,"_17690":44063,"_5":17585,"_23966":43793,"_2399":41481},[],{"_2872":950,"_25347":842,"_17690":44065,"_5":17585,"_23966":43793,"_2399":44066},[],"Published material",{"_2872":951,"_25347":842,"_17690":44068,"_5":17585,"_23966":43793,"_2399":44069},[],"**Include Lamassu System CA**",{"_2872":952,"_25347":842,"_17690":44071,"_5":17585,"_23966":43793,"_2399":44072},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2872":953,"_25347":842,"_17690":44074,"_5":17585,"_23966":43793,"_2399":44075},[],"**Include Enrollment CA**",{"_2872":954,"_25347":842,"_17690":44077,"_5":17585,"_23966":43793,"_2399":44078},[],"Selected issuing CA certificate.",{"_2872":955,"_25347":842,"_17690":44080,"_5":17585,"_23966":43793,"_2399":44081},[],"**Managed CAs**",{"_2872":956,"_25347":842,"_17690":44083,"_5":17585,"_23966":43793,"_2399":44084},[],"Explicitly selected CA certificates.",{"_2872":957,"_25347":842,"_17690":44086,"_5":17585,"_23966":43793,"_2399":44087},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2872":958,"_25347":842,"_17690":44089,"_5":17585,"_23966":43797,"_2399":44090},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2872":959,"_25347":842,"_17690":44092,"_5":17585,"_23966":43797,"_2399":44093},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2872":960,"_25347":842,"_17690":44095,"_5":17585,"_23966":43797,"_2399":44096},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2872":961,"_25347":842,"_17690":44098,"_5":17585,"_23966":43801,"_2399":44099},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2872":962,"_25347":962,"_5":12438,"_2399":44101,"_25683":44102,"_17690":44103,"_23966":962},"Integrate the EST client",[41104,42497,43471,43469,43652],[],{"_2872":963,"_25347":962,"_17690":44105,"_5":17585,"_23966":962,"_2399":44106},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2872":964,"_25347":962,"_5":25680,"_17690":44108,"_23966":44109,"_2399":41114},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2872":965,"_25347":962,"_5":25680,"_17690":44111,"_23966":44112,"_2399":44113},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2872":966,"_25347":962,"_5":25680,"_17690":44115,"_23966":44116,"_2399":44117},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2872":967,"_25347":962,"_5":25680,"_17690":44119,"_23966":44120,"_2399":44121},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2872":968,"_25347":962,"_5":25680,"_17690":44123,"_23966":44124,"_2399":44125},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2872":969,"_25347":962,"_5":25680,"_17690":44127,"_23966":44128,"_2399":44129},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2872":970,"_25347":962,"_17690":44131,"_5":17585,"_23966":962,"_2399":44132},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2872":971,"_25347":962,"_17690":44134,"_5":17585,"_23966":44109,"_2399":44135},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2872":972,"_25347":962,"_17690":44137,"_5":17585,"_23966":44109,"_2399":44138},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2872":973,"_25347":962,"_17690":44140,"_5":17585,"_23966":44109,"_2399":44141},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2872":974,"_25347":962,"_17690":44143,"_5":17585,"_23966":44112,"_2399":44144},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2872":975,"_25347":962,"_17690":44146,"_5":17585,"_23966":44112,"_2399":44147},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2872":976,"_25347":962,"_17690":44149,"_5":17585,"_23966":44116,"_2399":44150},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2872":977,"_25347":962,"_17690":44152,"_5":17585,"_23966":44116,"_2399":44153},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2872":978,"_25347":962,"_17690":44155,"_5":17585,"_23966":44120,"_2399":44156},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2872":979,"_25347":962,"_17690":44158,"_5":17585,"_23966":44120,"_2399":44159},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2872":980,"_25347":962,"_17690":44161,"_5":17585,"_23966":44124,"_2399":44162},[],"For a root that issues directly:",{"_2872":981,"_25347":962,"_17690":44164,"_5":17585,"_23966":44124,"_2399":44165},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2872":982,"_25347":962,"_17690":44167,"_5":17585,"_23966":44124,"_2399":44168},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2872":983,"_25347":962,"_17690":44170,"_5":17585,"_23966":44128,"_2399":44171},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2872":984,"_25347":984,"_5":12438,"_2399":44173,"_25683":44174,"_17690":44175,"_23966":984},"EST reference",[41104,42497,43471,43469,43652],[],{"_2872":985,"_25347":984,"_17690":44177,"_5":17585,"_23966":984,"_2399":44178},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2872":986,"_25347":984,"_5":25680,"_17690":44180,"_23966":44181,"_2399":44182},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2872":987,"_25347":984,"_5":25680,"_17690":44184,"_23966":44185,"_2399":19194},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2872":988,"_25347":984,"_5":25680,"_17690":44187,"_23966":44188,"_2399":21985},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2872":989,"_25347":984,"_5":25680,"_17690":44190,"_23966":44191,"_2399":21992},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2872":990,"_25347":984,"_5":25680,"_17690":44193,"_23966":44194,"_2399":21356},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2872":991,"_25347":984,"_5":25680,"_17690":44196,"_23966":44197,"_2399":44198},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2872":992,"_25347":984,"_5":25680,"_17690":44200,"_23966":44201,"_2399":44202},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2872":993,"_25347":984,"_5":25680,"_17690":44204,"_23966":44205,"_2399":44206},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2872":994,"_25347":984,"_17690":44208,"_5":17585,"_23966":984,"_2399":44209},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2872":995,"_25347":984,"_17690":44211,"_5":17585,"_23966":44181,"_2399":44212},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2872":996,"_25347":984,"_17690":44214,"_5":17585,"_23966":44181,"_2399":44215},[],"Operation",{"_2872":997,"_25347":984,"_17690":44217,"_5":17585,"_23966":44181,"_2399":44218},[],"Method",{"_2872":998,"_25347":984,"_17690":44220,"_5":17585,"_23966":44181,"_2399":44221},[],"Authentication and condition",{"_2872":999,"_25347":984,"_17690":44223,"_5":17585,"_23966":44181,"_2399":44224},[],"`/cacerts`",{"_2872":1000,"_25347":984,"_17690":44226,"_5":17585,"_23966":44181,"_2399":44227},[],"GET",{"_2872":1001,"_25347":984,"_17690":44229,"_5":17585,"_23966":44181,"_2399":44230},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2872":1002,"_25347":984,"_17690":44232,"_5":17585,"_23966":44181,"_2399":44233},[],"`/simpleenroll`",{"_2872":1003,"_25347":984,"_17690":44235,"_5":17585,"_23966":44181,"_2399":44236},[],"POST",{"_2872":1004,"_25347":984,"_17690":44238,"_5":17585,"_23966":44181,"_2399":44239},[],"Initial authentication and DMS registration/replacement policy.",{"_2872":1005,"_25347":984,"_17690":44241,"_5":17585,"_23966":44181,"_2399":44242},[],"`/simplereenroll`",{"_2872":1006,"_25347":984,"_17690":44244,"_5":17585,"_23966":44181,"_2399":44236},[],{"_2872":1007,"_25347":984,"_17690":44246,"_5":17585,"_23966":44181,"_2399":44247},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2872":1008,"_25347":984,"_17690":44249,"_5":17585,"_23966":44181,"_2399":44250},[],"`/serverkeygen`",{"_2872":1009,"_25347":984,"_17690":44252,"_5":17585,"_23966":44181,"_2399":44236},[],{"_2872":1010,"_25347":984,"_17690":44254,"_5":17585,"_23966":44181,"_2399":44255},[],"Initial authentication and admission; server generation enabled.",{"_2872":1011,"_25347":984,"_17690":44257,"_5":17585,"_23966":44181,"_2399":44258},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2872":1012,"_25347":984,"_17690":44260,"_5":17585,"_23966":44185,"_2399":44261},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2872":1013,"_25347":984,"_17690":44263,"_5":17585,"_23966":44185,"_2399":44264},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2872":1014,"_25347":984,"_17690":44266,"_5":17585,"_23966":44188,"_2399":44267},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2872":1015,"_25347":984,"_17690":44269,"_5":17585,"_23966":44188,"_2399":44270},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2872":1016,"_25347":984,"_17690":44272,"_5":17585,"_23966":44191,"_2399":44273},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2872":1017,"_25347":984,"_17690":44275,"_5":17585,"_23966":44191,"_2399":44276},[],"The enrollment CA or an additional CA validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2872":1018,"_25347":984,"_17690":44278,"_5":17585,"_23966":44194,"_2399":44279},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2872":1019,"_25347":984,"_17690":44281,"_5":17585,"_23966":44194,"_2399":44282},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2872":1020,"_25347":984,"_17690":44284,"_5":17585,"_23966":44197,"_2399":44285},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2872":1021,"_25347":984,"_17690":44287,"_5":17585,"_23966":44197,"_2399":44288},[],"Part",{"_2872":1022,"_25347":984,"_17690":44290,"_5":17585,"_23966":44197,"_2399":44291},[],"Content after decoding its Base64",{"_2872":1023,"_25347":984,"_17690":44293,"_5":17585,"_23966":44197,"_2399":44294},[],"`application/pkcs8`",{"_2872":1024,"_25347":984,"_17690":44296,"_5":17585,"_23966":44197,"_2399":44297},[],"Unencrypted DER PKCS#8 private key.",{"_2872":1025,"_25347":984,"_17690":44299,"_5":17585,"_23966":44197,"_2399":44300},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2872":1026,"_25347":984,"_17690":44302,"_5":17585,"_23966":44197,"_2399":44303},[],"DER PKCS#7 containing the issued certificate.",{"_2872":1027,"_25347":984,"_17690":44305,"_5":17585,"_23966":44197,"_2399":44306},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2872":1028,"_25347":984,"_17690":44308,"_5":17585,"_23966":44201,"_2399":44309},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2872":1029,"_25347":984,"_17690":44311,"_5":17585,"_23966":44201,"_2399":44312},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2872":1030,"_25347":984,"_17690":44314,"_5":17585,"_23966":44201,"_2399":44315},[],"Convert and check the result:",{"_2872":1031,"_25347":984,"_17690":44317,"_5":17585,"_23966":44201,"_2399":44318},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2872":1032,"_25347":984,"_17690":44320,"_5":17585,"_23966":44205,"_2399":44321},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2872":1033,"_25347":984,"_17690":44323,"_5":17585,"_23966":44205,"_2399":44324},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2872":1034,"_25347":1034,"_5":12438,"_2399":43652,"_25683":44326,"_17690":44327,"_23966":1034},[41104,42497,43471,43469,43652],[],{"_2872":1035,"_25347":1034,"_17690":44329,"_5":17585,"_23966":1034,"_2399":44330},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2872":1036,"_25347":1034,"_5":25680,"_17690":44332,"_23966":44333,"_2399":44334},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2872":1037,"_25347":1034,"_5":25680,"_17690":44336,"_23966":44337,"_2399":44338},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2872":1038,"_25347":1034,"_5":25680,"_17690":44340,"_23966":44341,"_2399":44342},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2872":1039,"_25347":1034,"_5":25680,"_17690":44344,"_23966":44345,"_2399":44346},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2872":1040,"_25347":1034,"_17690":44348,"_5":17585,"_23966":1034,"_2399":44349},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2872":1041,"_25347":1034,"_17690":44351,"_5":17585,"_23966":44333,"_2399":44352},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2872":1042,"_25347":1034,"_17690":44354,"_5":17585,"_23966":44333,"_2399":44355},[],"The integrator installs initial EST server trust and an admission credential.",{"_2872":1043,"_25347":1034,"_17690":44357,"_5":17585,"_23966":44333,"_2399":44358},[],"The client requests an identity for its `Device ID` through EST.",{"_2872":1044,"_25347":1034,"_17690":44360,"_5":17585,"_23966":44333,"_2399":44361},[],"Certificate, device binding and key/certificate installation are checked.",{"_2872":1045,"_25347":1034,"_17690":44363,"_5":17585,"_23966":44333,"_2399":44364},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2872":1046,"_25347":1034,"_17690":44366,"_5":17585,"_23966":44333,"_2399":44367},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2872":1047,"_25347":1034,"_17690":44369,"_5":17585,"_23966":44337,"_2399":44370},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2872":1048,"_25347":1034,"_17690":44372,"_5":17585,"_23966":44337,"_2399":44373},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2872":1049,"_25347":1034,"_17690":44375,"_5":17585,"_23966":44337,"_2399":44376},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2872":1050,"_25347":1034,"_17690":44378,"_5":17585,"_23966":44337,"_2399":44379},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2872":1051,"_25347":1034,"_17690":44381,"_5":17585,"_23966":44341,"_2399":44382},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2872":1052,"_25347":1034,"_17690":44384,"_5":17585,"_23966":44341,"_2399":44385},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2872":1053,"_25347":1034,"_17690":44387,"_5":17585,"_23966":44341,"_2399":44388},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2872":1054,"_25347":1034,"_17690":44390,"_5":17585,"_23966":44341,"_2399":44391},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2872":1055,"_25347":1034,"_17690":44393,"_5":17585,"_23966":44345,"_2399":44394},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract and migrations, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2872":1056,"_25347":1034,"_17690":44396,"_5":17585,"_23966":44345,"_2399":44397},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2872":1057,"_25347":1057,"_5":12438,"_2399":44399,"_25683":44400,"_17690":44401,"_23966":1057},"Provisioning strategies",[41104,42497,43471,43469,43652],[],{"_2872":1058,"_25347":1057,"_17690":44403,"_5":17585,"_23966":1057,"_2399":44404},[],"Choose device registration, identity authorization and key generation.",{"_2872":1059,"_25347":1057,"_5":25680,"_17690":44406,"_23966":44407,"_2399":44408},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2872":1060,"_25347":1057,"_5":25680,"_17690":44410,"_23966":44411,"_2399":44412},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2872":1061,"_25347":1057,"_5":25680,"_17690":44414,"_23966":44415,"_2399":44416},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2872":1062,"_25347":1057,"_5":25680,"_17690":44418,"_23966":44419,"_2399":44420},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2872":1063,"_25347":1057,"_5":25680,"_17690":44422,"_23966":44423,"_2399":44424},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2872":1064,"_25347":1057,"_17690":44426,"_5":17585,"_23966":1057,"_2399":44427},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2872":1065,"_25347":1057,"_17690":44429,"_5":17585,"_23966":44407,"_2399":44430},[],"Path",{"_2872":1066,"_25347":1057,"_17690":44432,"_5":17585,"_23966":44407,"_2399":44433},[],"When the device exists",{"_2872":1067,"_25347":1057,"_17690":44435,"_5":17585,"_23966":44407,"_2399":44436},[],"What to check",{"_2872":1068,"_25347":1057,"_17690":44438,"_5":17585,"_23966":44407,"_2399":44439},[],"Manual assignment",{"_2872":1069,"_25347":1057,"_17690":44441,"_5":17585,"_23966":44407,"_2399":44442},[],"An operator creates it before associating a certificate.",{"_2872":1070,"_25347":1057,"_17690":44444,"_5":17585,"_23966":44407,"_2399":44445},[],"ID, owning DMS, certificate CN and bound serial.",{"_2872":1071,"_25347":1057,"_17690":44447,"_5":17585,"_23966":44407,"_2399":44448},[],"EST with `JITP`",{"_2872":1072,"_25347":1057,"_17690":44450,"_5":17585,"_23966":44407,"_2399":44451},[],"Created for an unknown CN during `/simpleenroll`.",{"_2872":1073,"_25347":1057,"_17690":44453,"_5":17585,"_23966":44407,"_2399":44454},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2872":1074,"_25347":1057,"_17690":44456,"_5":17585,"_23966":44407,"_2399":44457},[],"EST with `PRE_REGISTRATION`",{"_2872":1075,"_25347":1057,"_17690":44459,"_5":17585,"_23966":44407,"_2399":44460},[],"Must exist before `/simpleenroll`.",{"_2872":1076,"_25347":1057,"_17690":44462,"_5":17585,"_23966":44407,"_2399":44463},[],"Approved record, same DMS and replacement conditions for your version.",{"_2872":1077,"_25347":1057,"_17690":44465,"_5":17585,"_23966":44407,"_2399":44466},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2872":1078,"_25347":1057,"_17690":44468,"_5":17585,"_23966":44407,"_2399":44469},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2872":1079,"_25347":1057,"_17690":44471,"_5":17585,"_23966":44411,"_2399":44472},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2872":1080,"_25347":1057,"_17690":44474,"_5":17585,"_23966":44411,"_2399":44475},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2872":1081,"_25347":1057,"_17690":44477,"_5":17585,"_23966":44411,"_2399":44478},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2872":1082,"_25347":1057,"_17690":44480,"_5":17585,"_23966":44415,"_2399":44481},[],"Decide initial enrollment and re-enrollment separately:",{"_2872":1083,"_25347":1057,"_17690":44483,"_5":17585,"_23966":44415,"_2399":44484},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2872":1084,"_25347":1057,"_17690":44486,"_5":17585,"_23966":44415,"_2399":44487},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2872":1085,"_25347":1057,"_17690":44489,"_5":17585,"_23966":44415,"_2399":44490},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2872":1086,"_25347":1057,"_17690":44492,"_5":17585,"_23966":44415,"_2399":44493},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2872":1087,"_25347":1057,"_17690":44495,"_5":17585,"_23966":44415,"_2399":44496},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2872":1088,"_25347":1057,"_17690":44498,"_5":17585,"_23966":44419,"_2399":41481},[],{"_2872":1089,"_25347":1057,"_17690":44500,"_5":17585,"_23966":44419,"_2399":44501},[],"Material crossing EST",{"_2872":1090,"_25347":1057,"_17690":44503,"_5":17585,"_23966":44419,"_2399":44504},[],"Device-generated key",{"_2872":1091,"_25347":1057,"_17690":44506,"_5":17585,"_23966":44419,"_2399":44507},[],"Public CSR and certificate; the key stays on the client.",{"_2872":1092,"_25347":1057,"_17690":44509,"_5":17585,"_23966":44419,"_2399":44510},[],"Existing device key",{"_2872":1093,"_25347":1057,"_17690":44512,"_5":17585,"_23966":44419,"_2399":44513},[],"CSR signed with that key and a new certificate.",{"_2872":1094,"_25347":1057,"_17690":44515,"_5":17585,"_23966":44419,"_2399":43790},[],{"_2872":1095,"_25347":1057,"_17690":44517,"_5":17585,"_23966":44419,"_2399":44518},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2872":1096,"_25347":1057,"_17690":44520,"_5":17585,"_23966":44419,"_2399":44521},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2872":1097,"_25347":1057,"_17690":44523,"_5":17585,"_23966":44423,"_2399":44524},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2872":1098,"_25347":1098,"_5":12438,"_2399":44526,"_25683":44527,"_17690":44528,"_23966":1098},"Renewal and recovery",[41104,42497,43471,43469,43652],[],{"_2872":1099,"_25347":1098,"_17690":44530,"_5":17585,"_23966":1098,"_2399":44531},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2872":1100,"_25347":1098,"_5":25680,"_17690":44533,"_23966":44534,"_2399":44535},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2872":1101,"_25347":1098,"_5":25680,"_17690":44537,"_23966":44538,"_2399":44539},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2872":1102,"_25347":1098,"_5":25680,"_17690":44541,"_23966":44542,"_2399":44543},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2872":1103,"_25347":1098,"_5":25680,"_17690":44545,"_23966":44546,"_2399":44547},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2872":1104,"_25347":1098,"_5":25680,"_17690":44549,"_23966":44550,"_2399":44551},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2872":1105,"_25347":1098,"_17690":44553,"_5":17585,"_23966":1098,"_2399":44554},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2872":1106,"_25347":1098,"_17690":44556,"_5":17585,"_23966":44534,"_2399":44557},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2872":1107,"_25347":1098,"_17690":44559,"_5":17585,"_23966":44534,"_2399":44560},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2872":1108,"_25347":1098,"_17690":44562,"_5":17585,"_23966":44534,"_2399":44563},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2872":1109,"_25347":1098,"_17690":44565,"_5":17585,"_23966":44534,"_2399":44566},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2872":1110,"_25347":1098,"_17690":44568,"_5":17585,"_23966":44538,"_2399":44569},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2872":1111,"_25347":1098,"_17690":44571,"_5":17585,"_23966":44538,"_2399":44572},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2872":1112,"_25347":1098,"_17690":44574,"_5":17585,"_23966":44542,"_2399":44575},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2872":1113,"_25347":1098,"_17690":44577,"_5":17585,"_23966":44542,"_2399":44578},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2872":1114,"_25347":1098,"_17690":44580,"_5":17585,"_23966":44542,"_2399":44581},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2872":1115,"_25347":1098,"_17690":44583,"_5":17585,"_23966":44546,"_2399":44584},[],"Situation",{"_2872":1116,"_25347":1098,"_17690":44586,"_5":17585,"_23966":44546,"_2399":44587},[],"Procedure",{"_2872":1117,"_25347":1098,"_17690":44589,"_5":17585,"_23966":44546,"_2399":44590},[],"Valid certificate, outside the window",{"_2872":1118,"_25347":1098,"_17690":44592,"_5":17585,"_23966":44546,"_2399":44593},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2872":1119,"_25347":1098,"_17690":44595,"_5":17585,"_23966":44546,"_2399":44596},[],"Expired certificate, key available",{"_2872":1120,"_25347":1098,"_17690":44598,"_5":17585,"_23966":44546,"_2399":44599},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2872":1121,"_25347":1098,"_17690":44601,"_5":17585,"_23966":44546,"_2399":44602},[],"Renewal through webhook or `NO_AUTH`",{"_2872":1122,"_25347":1098,"_17690":44604,"_5":17585,"_23966":44546,"_2399":44605},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2872":1123,"_25347":1098,"_17690":44607,"_5":17585,"_23966":44546,"_2399":44608},[],"Lost or inaccessible key",{"_2872":1124,"_25347":1098,"_17690":44610,"_5":17585,"_23966":44546,"_2399":44611},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2872":1125,"_25347":1098,"_17690":44613,"_5":17585,"_23966":44546,"_2399":44614},[],"Current identity revoked",{"_2872":1126,"_25347":1098,"_17690":44616,"_5":17585,"_23966":44546,"_2399":44617},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2872":1127,"_25347":1098,"_17690":44619,"_5":17585,"_23966":44546,"_2399":44620},[],"Device without an identity",{"_2872":1128,"_25347":1098,"_17690":44622,"_5":17585,"_23966":44546,"_2399":44623},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2872":1129,"_25347":1098,"_17690":44625,"_5":17585,"_23966":44546,"_2399":44626},[],"Retired device",{"_2872":1130,"_25347":1098,"_17690":44628,"_5":17585,"_23966":44546,"_2399":44629},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2872":1131,"_25347":1098,"_17690":44631,"_5":17585,"_23966":44546,"_2399":44632},[],"Timeout, HTTP 500 or installation failure",{"_2872":1132,"_25347":1098,"_17690":44634,"_5":17585,"_23966":44546,"_2399":44635},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2872":1133,"_25347":1098,"_17690":44637,"_5":17585,"_23966":44550,"_2399":44638},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2872":1134,"_25347":1098,"_17690":44640,"_5":17585,"_23966":44550,"_2399":44641},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2872":1135,"_25347":1135,"_5":12438,"_2399":44643,"_25683":44644,"_17690":44645,"_23966":1135},"Enrollment troubleshooting",[41104,42497,43471,43469,43652],[],{"_2872":1136,"_25347":1135,"_17690":44647,"_5":17585,"_23966":1135,"_2399":44648},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2872":1137,"_25347":1135,"_5":25680,"_17690":44650,"_23966":44651,"_2399":44652},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2872":1138,"_25347":1135,"_5":25680,"_17690":44654,"_23966":44655,"_2399":44656},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2872":1139,"_25347":1135,"_5":25680,"_17690":44658,"_23966":44659,"_2399":44206},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2872":1140,"_25347":1135,"_5":25680,"_17690":44661,"_23966":44662,"_2399":44663},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2872":1141,"_25347":1135,"_17690":44665,"_5":17585,"_23966":1135,"_2399":44666},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2872":1142,"_25347":1135,"_17690":44668,"_5":17585,"_23966":44655,"_2399":44669},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2872":1143,"_25347":1135,"_17690":44671,"_5":17585,"_23966":44655,"_2399":44672},[],"Symptom or message",{"_2872":1144,"_25347":1135,"_17690":44674,"_5":17585,"_23966":44655,"_2399":44436},[],{"_2872":1145,"_25347":1135,"_17690":44676,"_5":17585,"_23966":44655,"_2399":44677},[],"curl rejects TLS, name or issuer",{"_2872":1146,"_25347":1135,"_17690":44679,"_5":17585,"_23966":44655,"_2399":44680},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2872":1147,"_25347":1135,"_17690":44682,"_5":17585,"_23966":44655,"_2399":44683},[],"404 or missing APS",{"_2872":1148,"_25347":1135,"_17690":44685,"_5":17585,"_23966":44655,"_2399":44686},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2872":1149,"_25347":1135,"_17690":44688,"_5":17585,"_23966":44655,"_2399":44689},[],"400, CSR or format error",{"_2872":1150,"_25347":1135,"_17690":44691,"_5":17585,"_23966":44655,"_2399":44692},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2872":1151,"_25347":1135,"_17690":44694,"_5":17585,"_23966":44655,"_2399":44695},[],"Missing credential or invalid certificate",{"_2872":1152,"_25347":1135,"_17690":44697,"_5":17585,"_23966":44655,"_2399":44698},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2872":1153,"_25347":1135,"_17690":44700,"_5":17585,"_23966":44655,"_2399":44701},[],"Webhook denies, times out or responds without authorization",{"_2872":1154,"_25347":1135,"_17690":44703,"_5":17585,"_23966":44655,"_2399":44704},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2872":1155,"_25347":1135,"_17690":44706,"_5":17585,"_23966":44655,"_2399":44707},[],"`unexpected status code: <n>: redirects are not followed`",{"_2872":1156,"_25347":1135,"_17690":44709,"_5":17585,"_23966":44655,"_2399":44710},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2872":1157,"_25347":1135,"_17690":44712,"_5":17585,"_23966":44655,"_2399":44713},[],"`webhook response exceeds 1048576 bytes`",{"_2872":1158,"_25347":1135,"_17690":44715,"_5":17585,"_23966":44655,"_2399":44716},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2872":1159,"_25347":1135,"_17690":44718,"_5":17585,"_23966":44655,"_2399":44719},[],"`webhook config must not reference files`",{"_2872":1160,"_25347":1135,"_17690":44721,"_5":17585,"_23966":44655,"_2399":44722},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the PEM as `cert_content` and `key_content`; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the upgrade note in DMS.",{"_2872":1161,"_25347":1135,"_17690":44724,"_5":17585,"_23966":44655,"_2399":44725},[],"400 `struct validation error` creating or updating a DMS",{"_2872":1162,"_25347":1135,"_17690":44727,"_5":17585,"_23966":44655,"_2399":44728},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2872":1163,"_25347":1135,"_17690":44730,"_5":17585,"_23966":44655,"_2399":44731},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2872":1164,"_25347":1135,"_17690":44733,"_5":17585,"_23966":44655,"_2399":44734},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2872":1165,"_25347":1135,"_17690":44736,"_5":17585,"_23966":44655,"_2399":44737},[],"`device not preregistered`",{"_2872":1166,"_25347":1135,"_17690":44739,"_5":17585,"_23966":44655,"_2399":44740},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2872":1167,"_25347":1135,"_17690":44742,"_5":17585,"_23966":44655,"_2399":44743},[],"`forbiddenNewEnrollment`",{"_2872":1168,"_25347":1135,"_17690":44745,"_5":17585,"_23966":44655,"_2399":44746},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2872":1169,"_25347":1135,"_17690":44748,"_5":17585,"_23966":44655,"_2399":44749},[],"Different owning DMS",{"_2872":1170,"_25347":1135,"_17690":44751,"_5":17585,"_23966":44655,"_2399":44752},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2872":1171,"_25347":1135,"_17690":44754,"_5":17585,"_23966":44655,"_2399":44755},[],"`invalid RawSubject bytes`",{"_2872":1172,"_25347":1135,"_17690":44757,"_5":17585,"_23966":44655,"_2399":44758},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2872":1173,"_25347":1135,"_17690":44760,"_5":17585,"_23966":44655,"_2399":44761},[],"`invalid reenroll window`",{"_2872":1174,"_25347":1135,"_17690":44763,"_5":17585,"_23966":44655,"_2399":44764},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2872":1175,"_25347":1135,"_17690":44766,"_5":17585,"_23966":44655,"_2399":44767},[],"Current certificate revoked",{"_2872":1176,"_25347":1135,"_17690":44769,"_5":17585,"_23966":44655,"_2399":44770},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2872":1177,"_25347":1135,"_17690":44772,"_5":17585,"_23966":44655,"_2399":44773},[],"CA, profile or signing error",{"_2872":1178,"_25347":1135,"_17690":44775,"_5":17585,"_23966":44655,"_2399":44776},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2872":1179,"_25347":1135,"_17690":44778,"_5":17585,"_23966":44655,"_2399":44779},[],"HTTP 200 without a device connection",{"_2872":1180,"_25347":1135,"_17690":44781,"_5":17585,"_23966":44655,"_2399":44782},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2872":1181,"_25347":1135,"_17690":44784,"_5":17585,"_23966":44655,"_2399":44785},[],"Timeout or error after issuance",{"_2872":1182,"_25347":1135,"_17690":44787,"_5":17585,"_23966":44655,"_2399":44788},[],"New certificates, current slot and previous identity's state before retrying.",{"_2872":1183,"_25347":1135,"_17690":44790,"_5":17585,"_23966":44659,"_2399":44791},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode after migration and Gateway behavior with expired certificates and the bootstrap CA.",{"_2872":1184,"_25347":1135,"_17690":44793,"_5":17585,"_23966":44659,"_2399":44794},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2872":1185,"_25347":1135,"_17690":44796,"_5":17585,"_23966":44662,"_2399":44797},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2872":1186,"_25347":1135,"_17690":44799,"_5":17585,"_23966":44662,"_2399":44800},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2872":1187,"_25347":1135,"_17690":44802,"_5":17585,"_23966":44662,"_2399":44803},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2872":1188,"_25347":1135,"_17690":44805,"_5":17585,"_23966":44662,"_2399":44806},[],"Make one request, save headers/body and query the device and certificates.",{"_2872":1189,"_25347":1135,"_17690":44808,"_5":17585,"_23966":44662,"_2399":44809},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2872":1190,"_25347":1135,"_17690":44811,"_5":17585,"_23966":44662,"_2399":44812},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2872":1191,"_25347":1135,"_17690":44814,"_5":17585,"_23966":44662,"_2399":44815},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2872":1192,"_25347":1192,"_5":12438,"_2399":44817,"_25683":44818,"_17690":44819,"_23966":1192},"Trust distribution and updates",[41104,42497,43471,43469,43652],[],{"_2872":1193,"_25347":1192,"_17690":44821,"_5":17585,"_23966":1192,"_2399":44822},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2872":1194,"_25347":1192,"_5":25680,"_17690":44824,"_23966":44825,"_2399":44826},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2872":1195,"_25347":1192,"_5":25680,"_17690":44828,"_23966":44829,"_2399":44830},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2872":1196,"_25347":1192,"_5":25680,"_17690":44832,"_23966":44833,"_2399":44834},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2872":1197,"_25347":1192,"_5":25680,"_17690":44836,"_23966":44837,"_2399":44838},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2872":1198,"_25347":1192,"_5":25680,"_17690":44840,"_23966":44841,"_2399":44842},[],"/docs/pr-preview/pr-42/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2872":1199,"_25347":1192,"_17690":44844,"_5":17585,"_23966":1192,"_2399":44845},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2872":1200,"_25347":1192,"_17690":44847,"_5":17585,"_23966":44825,"_2399":44848},[],"Relationship",{"_2872":1201,"_25347":1192,"_17690":44850,"_5":17585,"_23966":44825,"_2399":44851},[],"Material prepared by its owner",{"_2872":1202,"_25347":1192,"_17690":44853,"_5":17585,"_23966":44825,"_2399":44854},[],"Device → EST server",{"_2872":1203,"_25347":1192,"_17690":44856,"_5":17585,"_23966":44825,"_2399":44857},[],"Previously verified server root, chain or pin and TLS name.",{"_2872":1204,"_25347":1192,"_17690":44859,"_5":17585,"_23966":44825,"_2399":44860},[],"DMS → requester",{"_2872":1205,"_25347":1192,"_17690":44862,"_5":17585,"_23966":44825,"_2399":44863},[],"CAs and rules authorizing initial or renewal credentials.",{"_2872":1206,"_25347":1192,"_17690":44865,"_5":17585,"_23966":44825,"_2399":44866},[],"Consumer → device",{"_2872":1207,"_25347":1192,"_17690":44868,"_5":17585,"_23966":44825,"_2399":44869},[],"Operational identity roots, intermediates, validation and permissions.",{"_2872":1208,"_25347":1192,"_17690":44871,"_5":17585,"_23966":44825,"_2399":44872},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2872":1209,"_25347":1192,"_17690":44874,"_5":17585,"_23966":44829,"_2399":44875},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2872":1210,"_25347":1192,"_17690":44877,"_5":17585,"_23966":44829,"_2399":44878},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2872":1211,"_25347":1192,"_17690":44880,"_5":17585,"_23966":44833,"_2399":44881},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2872":1212,"_25347":1192,"_17690":44883,"_5":17585,"_23966":44833,"_2399":44884},[],"Select policy-approved roots as anchors.",{"_2872":1213,"_25347":1192,"_17690":44886,"_5":17585,"_23966":44833,"_2399":44887},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2872":1214,"_25347":1192,"_17690":44889,"_5":17585,"_23966":44833,"_2399":44890},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2872":1215,"_25347":1192,"_17690":44892,"_5":17585,"_23966":44833,"_2399":44893},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2872":1216,"_25347":1192,"_17690":44895,"_5":17585,"_23966":44833,"_2399":44896},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2872":1217,"_25347":1192,"_17690":44898,"_5":17585,"_23966":44837,"_2399":44899},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2872":1218,"_25347":1192,"_17690":44901,"_5":17585,"_23966":44837,"_2399":44902},[],"In the DMS, separate distributed CAs from `additional_validation_cas`, used for re-enrollment credentials. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2872":1219,"_25347":1192,"_17690":44904,"_5":17585,"_23966":44837,"_2399":44905},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2872":1220,"_25347":1192,"_17690":44907,"_5":17585,"_23966":44841,"_2399":44908},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2872":1221,"_25347":1221,"_5":12438,"_2399":44910,"_25683":44911,"_17690":44913,"_23966":1221},"AWS IoT Core",[41104,42497,43471,43469,44912],"Integrations",[],{"_2872":1222,"_25347":1221,"_17690":44915,"_5":17585,"_23966":1221,"_2399":44916},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2872":1223,"_25347":1221,"_5":25680,"_17690":44918,"_23966":44919,"_2399":44920},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2872":1224,"_25347":1221,"_5":25680,"_17690":44922,"_23966":44923,"_2399":44924},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2872":1225,"_25347":1221,"_5":25680,"_17690":44926,"_23966":44927,"_2399":44928},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2872":1226,"_25347":1221,"_5":25680,"_17690":44930,"_23966":44931,"_2399":44932},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2872":1227,"_25347":1221,"_5":25680,"_17690":44934,"_23966":44935,"_2399":44936},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2872":1228,"_25347":1221,"_5":25680,"_17690":44938,"_23966":44939,"_2399":44940},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2872":1229,"_25347":1221,"_5":25680,"_17690":44942,"_23966":44943,"_2399":44944},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2872":1230,"_25347":1221,"_5":25680,"_17690":44946,"_23966":44947,"_2399":44948},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2872":1231,"_25347":1221,"_5":25680,"_17690":44950,"_23966":44951,"_2399":44952},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2872":1232,"_25347":1221,"_5":25680,"_17690":44954,"_23966":44955,"_2399":44956},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2872":1233,"_25347":1221,"_5":25680,"_17690":44958,"_23966":44959,"_2399":44960},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2872":1234,"_25347":1221,"_5":25680,"_17690":44962,"_23966":44963,"_2399":44964},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2872":1235,"_25347":1221,"_5":25680,"_17690":44966,"_23966":44967,"_2399":44968},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2872":1236,"_25347":1221,"_5":25680,"_17690":44970,"_23966":44971,"_2399":44972},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2872":1237,"_25347":1221,"_5":25680,"_17690":44974,"_23966":44975,"_2399":44976},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2872":1238,"_25347":1221,"_5":25680,"_17690":44978,"_23966":44979,"_2399":44980},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2872":1239,"_25347":1221,"_5":25680,"_17690":44982,"_23966":44983,"_2399":44984},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2872":1240,"_25347":1221,"_5":25680,"_17690":44986,"_23966":44987,"_2399":44988},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2872":1241,"_25347":1221,"_5":25680,"_17690":44990,"_23966":44991,"_2399":44992},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2872":1242,"_25347":1221,"_5":25680,"_17690":44994,"_23966":44995,"_2399":44996},[],"/docs/pr-preview/pr-42/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2872":1243,"_25347":1221,"_17690":44998,"_5":17585,"_23966":1221,"_2399":44999},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2872":1244,"_25347":1221,"_17690":45001,"_5":17585,"_23966":1221,"_2399":45002},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2872":1245,"_25347":1221,"_17690":45004,"_5":17585,"_23966":1221,"_2399":45005},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2872":1246,"_25347":1221,"_17690":45007,"_5":17585,"_23966":44919,"_2399":45008},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2872":1247,"_25347":1221,"_17690":45010,"_5":17585,"_23966":44919,"_2399":45011},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2872":1248,"_25347":1221,"_17690":45013,"_5":17585,"_23966":44919,"_2399":45014},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2872":1249,"_25347":1221,"_17690":45016,"_5":17585,"_23966":44919,"_2399":45017},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2872":1250,"_25347":1221,"_17690":45019,"_5":17585,"_23966":44923,"_2399":45020},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2872":1251,"_25347":1221,"_17690":45022,"_5":17585,"_23966":44927,"_2399":45023},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2872":1252,"_25347":1221,"_17690":45025,"_5":17585,"_23966":44927,"_2399":45026},[],"IAM action",{"_2872":1253,"_25347":1221,"_17690":45028,"_5":17585,"_23966":44927,"_2399":41487},[],{"_2872":1254,"_25347":1221,"_17690":45030,"_5":17585,"_23966":44927,"_2399":45031},[],"`iot:GetRegistrationCode`",{"_2872":1255,"_25347":1221,"_17690":45033,"_5":17585,"_23966":44927,"_2399":45034},[],"Obtain the verification code for CA registration in the Primary Account",{"_2872":1256,"_25347":1221,"_17690":45036,"_5":17585,"_23966":44927,"_2399":45037},[],"`iot:RegisterCACertificate`",{"_2872":1257,"_25347":1221,"_17690":45039,"_5":17585,"_23966":44927,"_2399":45040},[],"Register the CA in AWS IoT",{"_2872":1258,"_25347":1221,"_17690":45042,"_5":17585,"_23966":44927,"_2399":45043},[],"`iot:DescribeCACertificate`",{"_2872":1259,"_25347":1221,"_17690":45045,"_5":17585,"_23966":44927,"_2399":45046},[],"Check the CA registration status",{"_2872":1260,"_25347":1221,"_17690":45048,"_5":17585,"_23966":44927,"_2399":45049},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2872":1261,"_25347":1221,"_17690":45051,"_5":17585,"_23966":44927,"_2399":45052},[],"Create or update Things in IoT Core",{"_2872":1262,"_25347":1221,"_17690":45054,"_5":17585,"_23966":44927,"_2399":45055},[],"`iot:RegisterThing`",{"_2872":1263,"_25347":1221,"_17690":45057,"_5":17585,"_23966":44927,"_2399":45058},[],"Provision Things through a template",{"_2872":1264,"_25347":1221,"_17690":45060,"_5":17585,"_23966":44927,"_2399":45061},[],"`iot:RegisterCertificate`",{"_2872":1265,"_25347":1221,"_17690":45063,"_5":17585,"_23966":44927,"_2399":45064},[],"Register device certificates",{"_2872":1266,"_25347":1221,"_17690":45066,"_5":17585,"_23966":44927,"_2399":45067},[],"`iot:UpdateCertificate`",{"_2872":1267,"_25347":1221,"_17690":45069,"_5":17585,"_23966":44927,"_2399":45070},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2872":1268,"_25347":1221,"_17690":45072,"_5":17585,"_23966":44927,"_2399":45073},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2872":1269,"_25347":1221,"_17690":45075,"_5":17585,"_23966":44927,"_2399":45076},[],"Create and attach IoT policies",{"_2872":1270,"_25347":1221,"_17690":45078,"_5":17585,"_23966":44927,"_2399":45079},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2872":1271,"_25347":1221,"_17690":45081,"_5":17585,"_23966":44927,"_2399":45082},[],"Manage Thing groups",{"_2872":1272,"_25347":1221,"_17690":45084,"_5":17585,"_23966":44927,"_2399":45085},[],"`iot:CreateProvisioningTemplate`",{"_2872":1273,"_25347":1221,"_17690":45087,"_5":17585,"_23966":44927,"_2399":45088},[],"Create JITP templates",{"_2872":1274,"_25347":1221,"_17690":45090,"_5":17585,"_23966":44927,"_2399":45091},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2872":1275,"_25347":1221,"_17690":45093,"_5":17585,"_23966":44927,"_2399":45094},[],"Read and write the Device Shadow",{"_2872":1276,"_25347":1221,"_17690":45096,"_5":17585,"_23966":44927,"_2399":45097},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2872":1277,"_25347":1221,"_17690":45099,"_5":17585,"_23966":44931,"_2399":45100},[],"Parameter",{"_2872":1278,"_25347":1221,"_17690":45102,"_5":17585,"_23966":44931,"_2399":45103},[],"Type",{"_2872":1279,"_25347":1221,"_17690":45105,"_5":17585,"_23966":44931,"_2399":45106},[],"Required",{"_2872":1280,"_25347":1221,"_17690":45108,"_5":17585,"_23966":44931,"_2399":45109},[],"Description",{"_2872":1281,"_25347":1221,"_17690":45111,"_5":17585,"_23966":44931,"_2399":45112},[],"`connector_id`",{"_2872":1282,"_25347":1221,"_17690":45114,"_5":17585,"_23966":44931,"_2399":21095},[],{"_2872":1283,"_25347":1221,"_17690":45116,"_5":17585,"_23966":44931,"_2399":45117},[],"Yes",{"_2872":1284,"_25347":1221,"_17690":45119,"_5":17585,"_23966":44931,"_2399":45120},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2872":1285,"_25347":1221,"_17690":45122,"_5":17585,"_23966":44931,"_2399":45123},[],"`aws_config.region`",{"_2872":1286,"_25347":1221,"_17690":45125,"_5":17585,"_23966":44931,"_2399":21095},[],{"_2872":1287,"_25347":1221,"_17690":45127,"_5":17585,"_23966":44931,"_2399":45117},[],{"_2872":1288,"_25347":1221,"_17690":45129,"_5":17585,"_23966":44931,"_2399":45130},[],"AWS region where the connector operates.",{"_2872":1289,"_25347":1221,"_17690":45132,"_5":17585,"_23966":44931,"_2399":45133},[],"`aws_config.auth_method`",{"_2872":1290,"_25347":1221,"_17690":45135,"_5":17585,"_23966":44931,"_2399":21095},[],{"_2872":1291,"_25347":1221,"_17690":45137,"_5":17585,"_23966":44931,"_2399":45117},[],{"_2872":1292,"_25347":1221,"_17690":45139,"_5":17585,"_23966":44931,"_2399":45140},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2872":1293,"_25347":1221,"_17690":45142,"_5":17585,"_23966":44931,"_2399":45143},[],"`aws_config.access_key_id`",{"_2872":1294,"_25347":1221,"_17690":45145,"_5":17585,"_23966":44931,"_2399":21095},[],{"_2872":1295,"_25347":1221,"_17690":45147,"_5":17585,"_23966":44931,"_2399":45148},[],"Only with `auth_method=static`",{"_2872":1296,"_25347":1221,"_17690":45150,"_5":17585,"_23966":44931,"_2399":45151},[],"AWS access key.",{"_2872":1297,"_25347":1221,"_17690":45153,"_5":17585,"_23966":44931,"_2399":45154},[],"`aws_config.secret_access_key`",{"_2872":1298,"_25347":1221,"_17690":45156,"_5":17585,"_23966":44931,"_2399":21095},[],{"_2872":1299,"_25347":1221,"_17690":45158,"_5":17585,"_23966":44931,"_2399":45148},[],{"_2872":1300,"_25347":1221,"_17690":45160,"_5":17585,"_23966":44931,"_2399":45161},[],"AWS secret key.",{"_2872":1301,"_25347":1221,"_17690":45163,"_5":17585,"_23966":44931,"_2399":45164},[],"`aws_config.session_token`",{"_2872":1302,"_25347":1221,"_17690":45166,"_5":17585,"_23966":44931,"_2399":21095},[],{"_2872":1303,"_25347":1221,"_17690":45168,"_5":17585,"_23966":44931,"_2399":45169},[],"No",{"_2872":1304,"_25347":1221,"_17690":45171,"_5":17585,"_23966":44931,"_2399":45172},[],"Session token (with `auth_method=static`).",{"_2872":1305,"_25347":1221,"_17690":45174,"_5":17585,"_23966":44931,"_2399":45175},[],"`aws_config.role_arn`",{"_2872":1306,"_25347":1221,"_17690":45177,"_5":17585,"_23966":44931,"_2399":21095},[],{"_2872":1307,"_25347":1221,"_17690":45179,"_5":17585,"_23966":44931,"_2399":45180},[],"Only with `auth_method=role`",{"_2872":1308,"_25347":1221,"_17690":45182,"_5":17585,"_23966":44931,"_2399":45183},[],"ARN of the role to assume.",{"_2872":1309,"_25347":1221,"_17690":45185,"_5":17585,"_23966":44931,"_2399":45186},[],"`aws_config.endpoint_url`",{"_2872":1310,"_25347":1221,"_17690":45188,"_5":17585,"_23966":44931,"_2399":21095},[],{"_2872":1311,"_25347":1221,"_17690":45190,"_5":17585,"_23966":44931,"_2399":45169},[],{"_2872":1312,"_25347":1221,"_17690":45192,"_5":17585,"_23966":44931,"_2399":45193},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2872":1313,"_25347":1221,"_17690":45195,"_5":17585,"_23966":44931,"_2399":45196},[],"`subscriber_event_bus`",{"_2872":1314,"_25347":1221,"_17690":45198,"_5":17585,"_23966":44931,"_2399":14857},[],{"_2872":1315,"_25347":1221,"_17690":45200,"_5":17585,"_23966":44931,"_2399":45117},[],{"_2872":1316,"_25347":1221,"_17690":45202,"_5":17585,"_23966":44931,"_2399":45203},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2872":1317,"_25347":1221,"_17690":45205,"_5":17585,"_23966":44931,"_2399":45206},[],"`dms_manager_client`",{"_2872":1318,"_25347":1221,"_17690":45208,"_5":17585,"_23966":44931,"_2399":21095},[],{"_2872":1319,"_25347":1221,"_17690":45210,"_5":17585,"_23966":44931,"_2399":45117},[],{"_2872":1320,"_25347":1221,"_17690":45212,"_5":17585,"_23966":44931,"_2399":45213},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2872":1321,"_25347":1221,"_17690":45215,"_5":17585,"_23966":44931,"_2399":45216},[],"`device_manager_client`",{"_2872":1322,"_25347":1221,"_17690":45218,"_5":17585,"_23966":44931,"_2399":21095},[],{"_2872":1323,"_25347":1221,"_17690":45220,"_5":17585,"_23966":44931,"_2399":45117},[],{"_2872":1324,"_25347":1221,"_17690":45222,"_5":17585,"_23966":44931,"_2399":45223},[],"HTTP URL of Lamassu's Device Manager.",{"_2872":1325,"_25347":1221,"_17690":45225,"_5":17585,"_23966":44931,"_2399":45226},[],"`ca_client`",{"_2872":1326,"_25347":1221,"_17690":45228,"_5":17585,"_23966":44931,"_2399":21095},[],{"_2872":1327,"_25347":1221,"_17690":45230,"_5":17585,"_23966":44931,"_2399":45117},[],{"_2872":1328,"_25347":1221,"_17690":45232,"_5":17585,"_23966":44931,"_2399":45233},[],"HTTP URL of Lamassu's CA service.",{"_2872":1329,"_25347":1221,"_17690":45235,"_5":17585,"_23966":44935,"_2399":45236},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2872":1330,"_25347":1221,"_17690":45238,"_5":17585,"_23966":44939,"_2399":45239},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2872":1331,"_25347":1221,"_17690":45241,"_5":17585,"_23966":44939,"_2399":45242},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2872":1332,"_25347":1221,"_17690":45244,"_5":17585,"_23966":44943,"_2399":45245},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2872":1333,"_25347":1221,"_17690":45247,"_5":17585,"_23966":44943,"_2399":45248},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2872":1334,"_25347":1221,"_17690":45250,"_5":17585,"_23966":44943,"_2399":45251},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2872":1335,"_25347":1221,"_17690":45253,"_5":17585,"_23966":44943,"_2399":45254},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2872":1336,"_25347":1221,"_17690":45256,"_5":17585,"_23966":44943,"_2399":45257},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2872":1337,"_25347":1221,"_17690":45259,"_5":17585,"_23966":44943,"_2399":45260},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2872":1338,"_25347":1221,"_17690":45262,"_5":17585,"_23966":44947,"_2399":45263},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2872":1339,"_25347":1221,"_17690":45265,"_5":17585,"_23966":44951,"_2399":45266},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2872":1340,"_25347":1221,"_17690":45268,"_5":17585,"_23966":44951,"_2399":45269},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2872":1341,"_25347":1221,"_17690":45271,"_5":17585,"_23966":44955,"_2399":45272},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2872":1342,"_25347":1221,"_17690":45274,"_5":17585,"_23966":44959,"_2399":45275},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2872":1343,"_25347":1221,"_17690":45277,"_5":17585,"_23966":44959,"_2399":45278},[],"Creates or updates the IoT policies configured in the DMS.",{"_2872":1344,"_25347":1221,"_17690":45280,"_5":17585,"_23966":44959,"_2399":45281},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2872":1345,"_25347":1221,"_17690":45283,"_5":17585,"_23966":44959,"_2399":45284},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2872":1346,"_25347":1221,"_17690":45286,"_5":17585,"_23966":44959,"_2399":45287},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2872":1347,"_25347":1221,"_17690":45289,"_5":17585,"_23966":44959,"_2399":45290},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2872":1348,"_25347":1221,"_17690":45292,"_5":17585,"_23966":44959,"_2399":45293},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2872":1349,"_25347":1221,"_17690":45295,"_5":17585,"_23966":44963,"_2399":45296},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2872":1350,"_25347":1221,"_17690":45298,"_5":17585,"_23966":44963,"_2399":45299},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2872":1351,"_25347":1221,"_17690":45301,"_5":17585,"_23966":44963,"_2399":45302},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2872":1352,"_25347":1221,"_17690":45304,"_5":17585,"_23966":44967,"_2399":45305},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2872":1353,"_25347":1221,"_17690":45307,"_5":17585,"_23966":44967,"_2399":45308},[],"The full flow from the device's perspective is:",{"_2872":1354,"_25347":1221,"_17690":45310,"_5":17585,"_23966":44967,"_2399":45311},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2872":1355,"_25347":1221,"_17690":45313,"_5":17585,"_23966":44971,"_2399":45314},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2872":1356,"_25347":1221,"_17690":45316,"_5":17585,"_23966":44971,"_2399":45317},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2872":1357,"_25347":1221,"_17690":45319,"_5":17585,"_23966":44971,"_2399":45320},[],"For the JITP flow to work correctly:",{"_2872":1358,"_25347":1221,"_17690":45322,"_5":17585,"_23966":44971,"_2399":45323},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2872":1359,"_25347":1221,"_17690":45325,"_5":17585,"_23966":44971,"_2399":45326},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2872":1360,"_25347":1221,"_17690":45328,"_5":17585,"_23966":44971,"_2399":45329},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2872":1361,"_25347":1221,"_17690":45331,"_5":17585,"_23966":44971,"_2399":45332},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2872":1362,"_25347":1221,"_17690":45334,"_5":17585,"_23966":44975,"_2399":45335},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2872":1363,"_25347":1221,"_17690":45337,"_5":17585,"_23966":44975,"_2399":45338},[],"Status in Lamassu",{"_2872":1364,"_25347":1221,"_17690":45340,"_5":17585,"_23966":44975,"_2399":45341},[],"Revocation reason",{"_2872":1365,"_25347":1221,"_17690":45343,"_5":17585,"_23966":44975,"_2399":45344},[],"Status in AWS IoT Core",{"_2872":1366,"_25347":1221,"_17690":45346,"_5":17585,"_23966":44975,"_2399":45347},[],"`Active`",{"_2872":1367,"_25347":1221,"_17690":45349,"_5":17585,"_23966":44975,"_2399":45350},[],"None",{"_2872":1368,"_25347":1221,"_17690":45352,"_5":17585,"_23966":44975,"_2399":45353},[],"`ACTIVE`",{"_2872":1369,"_25347":1221,"_17690":45355,"_5":17585,"_23966":44975,"_2399":45356},[],"`Revoked`",{"_2872":1370,"_25347":1221,"_17690":45358,"_5":17585,"_23966":44975,"_2399":45359},[],"`certificateHold`",{"_2872":1371,"_25347":1221,"_17690":45361,"_5":17585,"_23966":44975,"_2399":45362},[],"`INACTIVE`",{"_2872":1372,"_25347":1221,"_17690":45364,"_5":17585,"_23966":44975,"_2399":45356},[],{"_2872":1373,"_25347":1221,"_17690":45366,"_5":17585,"_23966":44975,"_2399":45367},[],"Any other reason",{"_2872":1374,"_25347":1221,"_17690":45369,"_5":17585,"_23966":44975,"_2399":45370},[],"`REVOKED`",{"_2872":1375,"_25347":1221,"_17690":45372,"_5":17585,"_23966":44975,"_2399":45373},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2872":1376,"_25347":1221,"_17690":45375,"_5":17585,"_23966":44979,"_2399":45376},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2872":1377,"_25347":1221,"_17690":45378,"_5":17585,"_23966":44979,"_2399":45379},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2872":1378,"_25347":1221,"_17690":45381,"_5":17585,"_23966":44979,"_2399":45382},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2872":1379,"_25347":1221,"_17690":45384,"_5":17585,"_23966":44983,"_2399":45385},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2872":1380,"_25347":1221,"_17690":45387,"_5":17585,"_23966":44983,"_2399":45388},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2872":1381,"_25347":1221,"_17690":45390,"_5":17585,"_23966":44987,"_2399":45391},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2872":1382,"_25347":1221,"_17690":45393,"_5":17585,"_23966":44987,"_2399":45394},[],"There are two action types:",{"_2872":1383,"_25347":1221,"_17690":45396,"_5":17585,"_23966":44987,"_2399":45397},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2872":1384,"_25347":1221,"_17690":45399,"_5":17585,"_23966":44987,"_2399":45400},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2872":1385,"_25347":1221,"_17690":45402,"_5":17585,"_23966":44987,"_2399":45403},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2872":1386,"_25347":1221,"_17690":45405,"_5":17585,"_23966":44991,"_2399":45406},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2872":1387,"_25347":1221,"_17690":45408,"_5":17585,"_23966":44991,"_2399":45409},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2872":1388,"_25347":1221,"_17690":45411,"_5":17585,"_23966":44991,"_2399":45412},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2872":1389,"_25347":1221,"_17690":45414,"_5":17585,"_23966":44995,"_2399":45415},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2872":1390,"_25347":1221,"_17690":45417,"_5":17585,"_23966":44995,"_2399":45418},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2872":1391,"_25347":1221,"_17690":45420,"_5":17585,"_23966":44995,"_2399":45421},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2872":1392,"_25347":1221,"_17690":45423,"_5":17585,"_23966":44995,"_2399":45424},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2872":1393,"_25347":1221,"_17690":45426,"_5":17585,"_23966":44995,"_2399":45427},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2872":1394,"_25347":1221,"_17690":45429,"_5":17585,"_23966":44995,"_2399":45430},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2872":1395,"_25347":1221,"_17690":45432,"_5":17585,"_23966":44995,"_2399":45433},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2872":1396,"_25347":1221,"_17690":45435,"_5":17585,"_23966":44995,"_2399":45436},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2872":1397,"_25347":1221,"_17690":45438,"_5":17585,"_23966":44995,"_2399":45439},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2872":1398,"_25347":1221,"_17690":45441,"_5":17585,"_23966":44995,"_2399":45442},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2872":1399,"_25347":1221,"_17690":45444,"_5":17585,"_23966":44995,"_2399":45445},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2872":1400,"_25347":1221,"_17690":45447,"_5":17585,"_23966":44995,"_2399":45448},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2872":1401,"_25347":1221,"_17690":45450,"_5":17585,"_23966":44995,"_2399":45451},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2872":1402,"_25347":1221,"_17690":45453,"_5":17585,"_23966":44995,"_2399":45454},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2872":1403,"_25347":1221,"_17690":45456,"_5":17585,"_23966":44995,"_2399":45457},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2872":1404,"_25347":1221,"_17690":45459,"_5":17585,"_23966":44995,"_2399":45460},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2872":1405,"_25347":1221,"_17690":45462,"_5":17585,"_23966":44995,"_2399":45463},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2872":1406,"_25347":1221,"_17690":45465,"_5":17585,"_23966":44995,"_2399":45466},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2872":1407,"_25347":1221,"_17690":45468,"_5":17585,"_23966":44995,"_2399":45469},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2872":1408,"_25347":1221,"_17690":45471,"_5":17585,"_23966":44995,"_2399":45472},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2872":1409,"_25347":1221,"_17690":45474,"_5":17585,"_23966":44995,"_2399":45475},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2872":1410,"_25347":1410,"_5":12438,"_2399":43471,"_25683":45477,"_17690":45478,"_23966":1410},[41104,42497,43471],[],{"_2872":1411,"_25347":1410,"_17690":45480,"_5":17585,"_23966":1410,"_2399":45481},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2872":1412,"_25347":1410,"_5":25680,"_17690":45483,"_23966":45484,"_2399":45485},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#start-here","Start here",{"_2872":1413,"_25347":1410,"_5":25680,"_17690":45487,"_23966":45488,"_2399":43469},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#devices-and-identities",{"_2872":1414,"_25347":1410,"_5":25680,"_17690":45490,"_23966":45491,"_2399":43652},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#enrollment-with-pki",{"_2872":1415,"_25347":1410,"_5":25680,"_17690":45493,"_23966":45494,"_2399":44912},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#integrations",{"_2872":1416,"_25347":1410,"_5":25680,"_17690":45496,"_23966":45497,"_2399":45498},[],"/docs/pr-preview/pr-42/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2872":1417,"_25347":1410,"_17690":45500,"_5":17585,"_23966":1410,"_2399":45501},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2872":1418,"_25347":1410,"_17690":45503,"_5":17585,"_23966":45484,"_2399":45504},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2872":1419,"_25347":1410,"_17690":45506,"_5":17585,"_23966":45484,"_2399":45507},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2872":1420,"_25347":1410,"_17690":45509,"_5":17585,"_23966":45488,"_2399":45510},[],"Resource",{"_2872":1421,"_25347":1410,"_17690":45512,"_5":17585,"_23966":45488,"_2399":45513},[],"What it represents",{"_2872":1422,"_25347":1410,"_17690":45515,"_5":17585,"_23966":45488,"_2399":45516},[],"**Device**",{"_2872":1423,"_25347":1410,"_17690":45518,"_5":17585,"_23966":45488,"_2399":45519},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2872":1424,"_25347":1410,"_17690":45521,"_5":17585,"_23966":45488,"_2399":45522},[],"**Identity**",{"_2872":1425,"_25347":1410,"_17690":45524,"_5":17585,"_23966":45488,"_2399":45525},[],"The device's association with its certificates: an active version and a history.",{"_2872":1426,"_25347":1410,"_17690":45527,"_5":17585,"_23966":45488,"_2399":45528},[],"**DMS**",{"_2872":1427,"_25347":1410,"_17690":45530,"_5":17585,"_23966":45488,"_2399":45531},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2872":1428,"_25347":1410,"_17690":45533,"_5":17585,"_23966":45488,"_2399":45534},[],"**Fleet**",{"_2872":1429,"_25347":1410,"_17690":45536,"_5":17585,"_23966":45488,"_2399":45537},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2872":1430,"_25347":1410,"_17690":45539,"_5":17585,"_23966":45488,"_2399":45540},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2872":1431,"_25347":1410,"_17690":45542,"_5":17585,"_23966":45488,"_2399":45543},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2872":1432,"_25347":1410,"_17690":45545,"_5":17585,"_23966":45491,"_2399":45546},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2872":1433,"_25347":1410,"_17690":45548,"_5":17585,"_23966":45491,"_2399":45549},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2872":1434,"_25347":1410,"_17690":45551,"_5":17585,"_23966":45491,"_2399":45552},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2872":1435,"_25347":1410,"_17690":45554,"_5":17585,"_23966":45491,"_2399":45555},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2872":1436,"_25347":1410,"_17690":45557,"_5":17585,"_23966":45491,"_2399":45558},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2872":1437,"_25347":1410,"_17690":45560,"_5":17585,"_23966":45491,"_2399":45561},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2872":1438,"_25347":1410,"_17690":45563,"_5":17585,"_23966":45491,"_2399":45564},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2872":1439,"_25347":1410,"_17690":45566,"_5":17585,"_23966":45491,"_2399":45567},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2872":1440,"_25347":1410,"_17690":45569,"_5":17585,"_23966":45494,"_2399":45570},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2872":1441,"_25347":1410,"_17690":45572,"_5":17585,"_23966":45494,"_2399":45573},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2872":1442,"_25347":1410,"_17690":45575,"_5":17585,"_23966":45497,"_2399":45576},[],"Participant",{"_2872":1443,"_25347":1410,"_17690":45578,"_5":17585,"_23966":45497,"_2399":45579},[],"Responsibility",{"_2872":1444,"_25347":1410,"_17690":45581,"_5":17585,"_23966":45497,"_2399":45582},[],"PKI administrator",{"_2872":1445,"_25347":1410,"_17690":45584,"_5":17585,"_23966":45497,"_2399":45585},[],"CA, issuance profile, chain and revocation publication.",{"_2872":1446,"_25347":1410,"_17690":45587,"_5":17585,"_23966":45497,"_2399":45588},[],"Provisioning administrator",{"_2872":1447,"_25347":1410,"_17690":45590,"_5":17585,"_23966":45497,"_2399":45591},[],"DMS, admission, authentication per operation and inventory.",{"_2872":1448,"_25347":1410,"_17690":45593,"_5":17585,"_23966":45497,"_2399":45594},[],"Device integrator",{"_2872":1449,"_25347":1410,"_17690":45596,"_5":17585,"_23966":45497,"_2399":45597},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2872":1450,"_25347":1410,"_17690":45599,"_5":17585,"_23966":45497,"_2399":45600},[],"Consumer integrator",{"_2872":1451,"_25347":1410,"_17690":45602,"_5":17585,"_23966":45497,"_2399":45603},[],"Trusted issuers, validation and device permissions in the destination.",{"_2872":1452,"_25347":1410,"_17690":45605,"_5":17585,"_23966":45497,"_2399":45606},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2872":1453,"_25347":1453,"_5":12438,"_2399":45608,"_25683":45609,"_17690":45611,"_23966":1453},"Enroll and connect your first device",[41104,42497,43471,45610],"Getting started",[],{"_2872":1454,"_25347":1453,"_17690":45613,"_5":17585,"_23966":1453,"_2399":45614},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2872":1455,"_25347":1453,"_5":25680,"_17690":45616,"_23966":45617,"_2399":41114},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2872":1456,"_25347":1453,"_5":25680,"_17690":45619,"_23966":45620,"_2399":45621},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2872":1457,"_25347":1453,"_5":25680,"_17690":45623,"_23966":45624,"_2399":45625},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2872":1458,"_25347":1453,"_5":25680,"_17690":45627,"_23966":45628,"_2399":45629},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2872":1459,"_25347":1453,"_5":25680,"_17690":45631,"_23966":45632,"_2399":45633},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2872":1460,"_25347":1453,"_5":25680,"_17690":45635,"_23966":45636,"_2399":45637},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2872":1461,"_25347":1453,"_5":25680,"_17690":45639,"_23966":45640,"_2399":45641},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2872":1462,"_25347":1453,"_5":25680,"_17690":45643,"_23966":45644,"_2399":45645},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2872":1463,"_25347":1453,"_17690":45647,"_5":17585,"_23966":1453,"_2399":45648},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2872":1464,"_25347":1453,"_17690":45650,"_5":17585,"_23966":45617,"_2399":45651},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2872":1465,"_25347":1453,"_17690":45653,"_5":17585,"_23966":45617,"_2399":45654},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2872":1466,"_25347":1453,"_17690":45656,"_5":17585,"_23966":45617,"_2399":45657},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2872":1467,"_25347":1453,"_17690":45659,"_5":17585,"_23966":45617,"_2399":45660},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2872":1468,"_25347":1453,"_17690":45662,"_5":17585,"_23966":45617,"_2399":45663},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2872":1469,"_25347":1453,"_17690":45665,"_5":17585,"_23966":45620,"_2399":45666},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2872":1470,"_25347":1453,"_17690":45668,"_5":17585,"_23966":45620,"_2399":45669},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2872":1471,"_25347":1453,"_17690":45671,"_5":17585,"_23966":45624,"_2399":45672},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2872":1472,"_25347":1453,"_17690":45674,"_5":17585,"_23966":45624,"_2399":45675},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2872":1473,"_25347":1453,"_17690":45677,"_5":17585,"_23966":45624,"_2399":45678},[],"Setting",{"_2872":1474,"_25347":1453,"_17690":45680,"_5":17585,"_23966":45624,"_2399":45681},[],"Evaluation value",{"_2872":1475,"_25347":1453,"_17690":45683,"_5":17585,"_23966":45624,"_2399":45684},[],"Enrollment CA",{"_2872":1476,"_25347":1453,"_17690":45686,"_5":17585,"_23966":45624,"_2399":45687},[],"Issuing root from `device-root.pem`.",{"_2872":1477,"_25347":1453,"_17690":45689,"_5":17585,"_23966":45624,"_2399":43782},[],{"_2872":1478,"_25347":1453,"_17690":45691,"_5":17585,"_23966":45624,"_2399":45692},[],"The 1-hour leaf profile you just prepared.",{"_2872":1479,"_25347":1453,"_17690":45694,"_5":17585,"_23966":45624,"_2399":45695},[],"Protocol / Registration Mode",{"_2872":1480,"_25347":1453,"_17690":45697,"_5":17585,"_23966":45624,"_2399":45698},[],"`EST_RFC7030` / `JITP`.",{"_2872":1481,"_25347":1453,"_17690":45700,"_5":17585,"_23966":45624,"_2399":45701},[],"Verify CSR Signature",{"_2872":1482,"_25347":1453,"_17690":45703,"_5":17585,"_23966":45624,"_2399":45704},[],"Enabled.",{"_2872":1483,"_25347":1453,"_17690":45706,"_5":17585,"_23966":45624,"_2399":45707},[],"Enable Replaceable Enrollment",{"_2872":1484,"_25347":1453,"_17690":45709,"_5":17585,"_23966":45624,"_2399":45710},[],"Disabled; the ID must be new.",{"_2872":1485,"_25347":1453,"_17690":45712,"_5":17585,"_23966":45624,"_2399":45713},[],"Initial authentication",{"_2872":1486,"_25347":1453,"_17690":45715,"_5":17585,"_23966":45624,"_2399":45716},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2872":1487,"_25347":1453,"_17690":45718,"_5":17585,"_23966":45624,"_2399":45719},[],"Renewal authentication",{"_2872":1488,"_25347":1453,"_17690":45721,"_5":17585,"_23966":45624,"_2399":45722},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2872":1489,"_25347":1453,"_17690":45724,"_5":17585,"_23966":45624,"_2399":45725},[],"Additional Validation CAs / Enable Expired Renewal",{"_2872":1490,"_25347":1453,"_17690":45727,"_5":17585,"_23966":45624,"_2399":45728},[],"Empty list for this direct issuance / disabled.",{"_2872":1491,"_25347":1453,"_17690":45730,"_5":17585,"_23966":45624,"_2399":45731},[],"Re-enrollment Delta",{"_2872":1492,"_25347":1453,"_17690":45733,"_5":17585,"_23966":45624,"_2399":45734},[],"1 hour.",{"_2872":1493,"_25347":1453,"_17690":45736,"_5":17585,"_23966":45624,"_2399":45737},[],"Preventive / Critical Delta",{"_2872":1494,"_25347":1453,"_17690":45739,"_5":17585,"_23966":45624,"_2399":45740},[],"30 minutes / 10 minutes.",{"_2872":1495,"_25347":1453,"_17690":45742,"_5":17585,"_23966":45624,"_2399":45743},[],"Revoke on Re-enrollment",{"_2872":1496,"_25347":1453,"_17690":45745,"_5":17585,"_23966":45624,"_2399":45746},[],"Disabled to test the successor before retiring the previous identity.",{"_2872":1497,"_25347":1453,"_17690":45748,"_5":17585,"_23966":45624,"_2399":43790},[],{"_2872":1498,"_25347":1453,"_17690":45750,"_5":17585,"_23966":45624,"_2399":45751},[],"Disabled; the operational key is generated in the client.",{"_2872":1499,"_25347":1453,"_17690":45753,"_5":17585,"_23966":45624,"_2399":45754},[],"CA Distribution",{"_2872":1500,"_25347":1453,"_17690":45756,"_5":17585,"_23966":45624,"_2399":45757},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2872":1501,"_25347":1453,"_17690":45759,"_5":17585,"_23966":45624,"_2399":45760},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2872":1502,"_25347":1453,"_17690":45762,"_5":17585,"_23966":45628,"_2399":45763},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2872":1503,"_25347":1453,"_17690":45765,"_5":17585,"_23966":45628,"_2399":45766},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2872":1504,"_25347":1453,"_17690":45768,"_5":17585,"_23966":45632,"_2399":45769},[],"Generate a new key and CSR with the selected identifier:",{"_2872":1505,"_25347":1453,"_17690":45771,"_5":17585,"_23966":45632,"_2399":45772},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2872":1506,"_25347":1453,"_17690":45774,"_5":17585,"_23966":45632,"_2399":45775},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2872":1507,"_25347":1453,"_17690":45777,"_5":17585,"_23966":45636,"_2399":45778},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2872":1508,"_25347":1453,"_17690":45780,"_5":17585,"_23966":45636,"_2399":45781},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2872":1509,"_25347":1453,"_17690":45783,"_5":17585,"_23966":45640,"_2399":45784},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2872":1510,"_25347":1453,"_17690":45786,"_5":17585,"_23966":45640,"_2399":45787},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2872":1511,"_25347":1453,"_17690":45789,"_5":17585,"_23966":45640,"_2399":45790},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2872":1512,"_25347":1453,"_17690":45792,"_5":17585,"_23966":45640,"_2399":45793},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2872":1513,"_25347":1453,"_17690":45795,"_5":17585,"_23966":45640,"_2399":45796},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2872":1514,"_25347":1453,"_17690":45798,"_5":17585,"_23966":45644,"_2399":45799},[],"Check",{"_2872":1515,"_25347":1453,"_17690":45801,"_5":17585,"_23966":45644,"_2399":45802},[],"Expected result",{"_2872":1516,"_25347":1453,"_17690":45804,"_5":17585,"_23966":45644,"_2399":45805},[],"Registration",{"_2872":1517,"_25347":1453,"_17690":45807,"_5":17585,"_23966":45644,"_2399":45808},[],"ID created automatically and correct DMS.",{"_2872":1518,"_25347":1453,"_17690":45810,"_5":17585,"_23966":45644,"_2399":45811},[],"Certificate",{"_2872":1519,"_25347":1453,"_17690":45813,"_5":17585,"_23966":45644,"_2399":45814},[],"CN, profile, serial and key verified.",{"_2872":1520,"_25347":1453,"_17690":45816,"_5":17585,"_23966":45644,"_2399":45817},[],"Inventory",{"_2872":1521,"_25347":1453,"_17690":45819,"_5":17585,"_23966":45644,"_2399":45820},[],"Received serial visible as the current identity and in history.",{"_2872":1522,"_25347":1453,"_17690":45822,"_5":17585,"_23966":45644,"_2399":45823},[],"Consumer",{"_2872":1523,"_25347":1453,"_17690":45825,"_5":17585,"_23966":45644,"_2399":45826},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2872":1524,"_25347":1453,"_17690":45828,"_5":17585,"_23966":45644,"_2399":45829},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2872":1525,"_25347":1453,"_17690":45831,"_5":17585,"_23966":45644,"_2399":45832},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2872":1526,"_25347":1526,"_5":12438,"_2399":43487,"_25683":45834,"_17690":45835,"_23966":1526},[41104,42497,43471,45610],[],{"_2872":1527,"_25347":1526,"_17690":45837,"_5":17585,"_23966":1526,"_2399":45838},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2872":1528,"_25347":1526,"_5":25680,"_17690":45840,"_23966":45841,"_2399":41114},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2872":1529,"_25347":1526,"_5":25680,"_17690":45843,"_23966":45844,"_2399":45845},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2872":1530,"_25347":1526,"_5":25680,"_17690":45847,"_23966":45848,"_2399":45849},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2872":1531,"_25347":1526,"_5":25680,"_17690":45851,"_23966":45852,"_2399":45853},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2872":1532,"_25347":1526,"_5":25680,"_17690":45855,"_23966":45856,"_2399":45857},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2872":1533,"_25347":1526,"_5":25680,"_17690":45859,"_23966":45860,"_2399":45861},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2872":1534,"_25347":1526,"_5":25680,"_17690":45863,"_23966":45864,"_2399":45802},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2872":1535,"_25347":1526,"_5":25680,"_17690":45866,"_23966":45867,"_2399":45868},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2872":1536,"_25347":1526,"_5":25680,"_17690":45870,"_23966":45871,"_2399":45872},[],"/docs/pr-preview/pr-42/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2872":1537,"_25347":1526,"_17690":45874,"_5":17585,"_23966":1526,"_2399":45875},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2872":1538,"_25347":1526,"_17690":45877,"_5":17585,"_23966":1526,"_2399":45878},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2872":1539,"_25347":1526,"_17690":45880,"_5":17585,"_23966":45841,"_2399":45881},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2872":1540,"_25347":1526,"_17690":45883,"_5":17585,"_23966":45841,"_2399":45884},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2872":1541,"_25347":1526,"_17690":45886,"_5":17585,"_23966":45841,"_2399":45887},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2872":1542,"_25347":1526,"_17690":45889,"_5":17585,"_23966":45841,"_2399":45890},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2872":1543,"_25347":1526,"_17690":45892,"_5":17585,"_23966":45844,"_2399":45893},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2872":1544,"_25347":1526,"_17690":45895,"_5":17585,"_23966":45844,"_2399":45896},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2872":1545,"_25347":1526,"_17690":45898,"_5":17585,"_23966":45844,"_2399":45899},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2872":1546,"_25347":1526,"_17690":45901,"_5":17585,"_23966":45844,"_2399":45902},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2872":1547,"_25347":1526,"_17690":45904,"_5":17585,"_23966":45844,"_2399":45905},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2872":1548,"_25347":1526,"_17690":45907,"_5":17585,"_23966":45844,"_2399":45908},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2872":1549,"_25347":1526,"_17690":45910,"_5":17585,"_23966":45844,"_2399":45911},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2872":1550,"_25347":1526,"_17690":45913,"_5":17585,"_23966":45844,"_2399":45914},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2872":1551,"_25347":1526,"_17690":45916,"_5":17585,"_23966":45848,"_2399":45917},[],"Open **Managed Devices** and the registration action. Complete:",{"_2872":1552,"_25347":1526,"_17690":45919,"_5":17585,"_23966":45848,"_2399":45920},[],"**Device ID**: `device-001`.",{"_2872":1553,"_25347":1526,"_17690":45922,"_5":17585,"_23966":45848,"_2399":45923},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2872":1554,"_25347":1526,"_17690":45925,"_5":17585,"_23966":45848,"_2399":45926},[],"**Icon** and **Tags**: optional classification.",{"_2872":1555,"_25347":1526,"_17690":45928,"_5":17585,"_23966":45848,"_2399":45929},[],"Confirm registration.",{"_2872":1556,"_25347":1526,"_17690":45931,"_5":17585,"_23966":45852,"_2399":45932},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2872":1557,"_25347":1526,"_17690":45934,"_5":17585,"_23966":45852,"_2399":45935},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2872":1558,"_25347":1526,"_17690":45937,"_5":17585,"_23966":45856,"_2399":45938},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2872":1559,"_25347":1526,"_17690":45940,"_5":17585,"_23966":45856,"_2399":45941},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2872":1560,"_25347":1526,"_17690":45943,"_5":17585,"_23966":45860,"_2399":45944},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2872":1561,"_25347":1526,"_17690":45946,"_5":17585,"_23966":45860,"_2399":45947},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2872":1562,"_25347":1526,"_17690":45949,"_5":17585,"_23966":45864,"_2399":45799},[],{"_2872":1563,"_25347":1526,"_17690":45951,"_5":17585,"_23966":45864,"_2399":45952},[],"Result",{"_2872":1564,"_25347":1526,"_17690":45954,"_5":17585,"_23966":45864,"_2399":45955},[],"Device",{"_2872":1565,"_25347":1526,"_17690":45957,"_5":17585,"_23966":45864,"_2399":45958},[],"`device-001` appears in inventory with the expected DMS.",{"_2872":1566,"_25347":1526,"_17690":45960,"_5":17585,"_23966":45864,"_2399":45961},[],"Current identity",{"_2872":1567,"_25347":1526,"_17690":45963,"_5":17585,"_23966":45864,"_2399":45964},[],"The associated certificate matches the one you verified in PKI.",{"_2872":1568,"_25347":1526,"_17690":45966,"_5":17585,"_23966":45864,"_2399":45967},[],"History",{"_2872":1569,"_25347":1526,"_17690":45969,"_5":17585,"_23966":45864,"_2399":45970},[],"The associated issuance appears with its serial number and dates.",{"_2872":1570,"_25347":1526,"_17690":45972,"_5":17585,"_23966":45864,"_2399":45973},[],"Key and certificate",{"_2872":1571,"_25347":1526,"_17690":45975,"_5":17585,"_23966":45864,"_2399":45976},[],"You have the verified pair ready to install on the device.",{"_2872":1572,"_25347":1526,"_17690":45978,"_5":17585,"_23966":45867,"_2399":45979},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2872":1573,"_25347":1526,"_17690":45981,"_5":17585,"_23966":45867,"_2399":45982},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2872":1574,"_25347":1526,"_17690":45984,"_5":17585,"_23966":45867,"_2399":45985},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2872":1575,"_25347":1526,"_17690":45987,"_5":17585,"_23966":45867,"_2399":45988},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2872":1576,"_25347":1526,"_17690":45990,"_5":17585,"_23966":45871,"_2399":45991},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2872":1577,"_25347":1526,"_17690":45993,"_5":17585,"_23966":45871,"_2399":45994},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2872":1578,"_25347":1526,"_17690":45996,"_5":17585,"_23966":45871,"_2399":45997},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2872":1579,"_25347":1579,"_5":12438,"_2399":45999,"_25683":46000,"_17690":46001,"_23966":1579},"Lamassu IoT Platform",[41104,42497],[],{"_2872":1580,"_25347":1579,"_17690":46003,"_5":17585,"_23966":1579,"_2399":46004},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2872":1581,"_25347":1579,"_5":25680,"_17690":46006,"_23966":46007,"_2399":45485},[],"/docs/pr-preview/pr-42/platform/overview#start-here",{"_2872":1582,"_25347":1579,"_5":25680,"_17690":46009,"_23966":46010,"_2399":46011},[],"/docs/pr-preview/pr-42/platform/overview#choose-your-path","Choose your path",{"_2872":1583,"_25347":1579,"_5":25680,"_17690":46013,"_23966":46014,"_2399":46015},[],"/docs/pr-preview/pr-42/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2872":1584,"_25347":1579,"_5":25680,"_17690":46017,"_23966":46018,"_2399":46019},[],"/docs/pr-preview/pr-42/platform/overview#core-capabilities","Core capabilities",{"_2872":1585,"_25347":1579,"_5":25680,"_17690":46021,"_23966":46022,"_2399":46023},[],"/docs/pr-preview/pr-42/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2872":1586,"_25347":1579,"_5":25680,"_17690":46025,"_23966":46026,"_2399":46027},[],"/docs/pr-preview/pr-42/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2872":1587,"_25347":1579,"_5":25680,"_17690":46029,"_23966":46030,"_2399":46031},[],"/docs/pr-preview/pr-42/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2872":1588,"_25347":1579,"_5":25680,"_17690":46033,"_23966":46034,"_2399":46035},[],"/docs/pr-preview/pr-42/platform/overview#automate-device-identities","Automate device identities",{"_2872":1589,"_25347":1579,"_5":25680,"_17690":46037,"_23966":46038,"_2399":46039},[],"/docs/pr-preview/pr-42/platform/overview#publish-validation-status","Publish validation status",{"_2872":1590,"_25347":1579,"_5":25680,"_17690":46041,"_23966":46042,"_2399":46043},[],"/docs/pr-preview/pr-42/platform/overview#react-to-events","React to events",{"_2872":1591,"_25347":1579,"_5":25680,"_17690":46045,"_23966":46046,"_2399":46047},[],"/docs/pr-preview/pr-42/platform/overview#operational-reference","Operational reference",{"_2872":1592,"_25347":1579,"_17690":46049,"_5":17585,"_23966":1579,"_2399":46050},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2872":1593,"_25347":1579,"_17690":46052,"_5":17585,"_23966":46007,"_2399":46053},[],"Choose the result you need:",{"_2872":1594,"_25347":1579,"_17690":46055,"_5":17585,"_23966":46007,"_2399":46056},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2872":1595,"_25347":1579,"_17690":46058,"_5":17585,"_23966":46007,"_2399":46059},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2872":1596,"_25347":1579,"_17690":46061,"_5":17585,"_23966":46007,"_2399":46062},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2872":1597,"_25347":1579,"_17690":46064,"_5":17585,"_23966":46010,"_2399":46065},[],"Section",{"_2872":1598,"_25347":1579,"_17690":46067,"_5":17585,"_23966":46010,"_2399":46068},[],"What you manage",{"_2872":1599,"_25347":1579,"_17690":46070,"_5":17585,"_23966":46010,"_2399":46071},[],"Entry point",{"_2872":1600,"_25347":1579,"_17690":46073,"_5":17585,"_23966":46010,"_2399":46074},[],"**PKI**",{"_2872":1601,"_25347":1579,"_17690":46076,"_5":17585,"_23966":46010,"_2399":46077},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2872":1602,"_25347":1579,"_17690":46079,"_5":17585,"_23966":46010,"_2399":46080},[],"PKI overview",{"_2872":1603,"_25347":1579,"_17690":46082,"_5":17585,"_23966":46010,"_2399":46083},[],"**IoT Fleets**",{"_2872":1604,"_25347":1579,"_17690":46085,"_5":17585,"_23966":46010,"_2399":46086},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2872":1605,"_25347":1579,"_17690":46088,"_5":17585,"_23966":46010,"_2399":46089},[],"IoT Fleets overview",{"_2872":1606,"_25347":1579,"_17690":46091,"_5":17585,"_23966":46010,"_2399":46092},[],"**Administration**",{"_2872":1607,"_25347":1579,"_17690":46094,"_5":17585,"_23966":46010,"_2399":46095},[],"Operator permissions, audit and event subscriptions.",{"_2872":1608,"_25347":1579,"_17690":46097,"_5":17585,"_23966":46010,"_2399":42495},[],{"_2872":1609,"_25347":1579,"_17690":46099,"_5":17585,"_23966":46010,"_2399":46100},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2872":1610,"_25347":1579,"_17690":46102,"_5":17585,"_23966":46014,"_2399":46103},[],"An identity's journey connects four responsibilities:",{"_2872":1611,"_25347":1579,"_17690":46105,"_5":17585,"_23966":46014,"_2399":46106},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2872":1612,"_25347":1579,"_17690":46108,"_5":17585,"_23966":46014,"_2399":46109},[],"The provisioning administrator configures the DMS and initial trust.",{"_2872":1613,"_25347":1579,"_17690":46111,"_5":17585,"_23966":46014,"_2399":46112},[],"The device client requests a certificate and installs it with the matching key.",{"_2872":1614,"_25347":1579,"_17690":46114,"_5":17585,"_23966":46014,"_2399":46115},[],"The consumer validates the identity and applies its access permissions.",{"_2872":1615,"_25347":1579,"_17690":46117,"_5":17585,"_23966":46014,"_2399":46118},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2872":1616,"_25347":1579,"_17690":46120,"_5":17585,"_23966":46022,"_2399":46121},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2872":1617,"_25347":1579,"_17690":46123,"_5":17585,"_23966":46026,"_2399":46124},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2872":1618,"_25347":1579,"_17690":46126,"_5":17585,"_23966":46030,"_2399":46127},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2872":1619,"_25347":1579,"_17690":46129,"_5":17585,"_23966":46034,"_2399":46130},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2872":1620,"_25347":1579,"_17690":46132,"_5":17585,"_23966":46038,"_2399":46133},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2872":1621,"_25347":1579,"_17690":46135,"_5":17585,"_23966":46042,"_2399":46136},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2872":1622,"_25347":1579,"_17690":46138,"_5":17585,"_23966":46046,"_2399":45579},[],{"_2872":1623,"_25347":1579,"_17690":46140,"_5":17585,"_23966":46046,"_2399":46141},[],"What it prepares or checks",{"_2872":1624,"_25347":1579,"_17690":46143,"_5":17585,"_23966":46046,"_2399":45582},[],{"_2872":1625,"_25347":1579,"_17690":46145,"_5":17585,"_23966":46046,"_2399":46146},[],"Key custody, CA hierarchy, profiles and validation.",{"_2872":1626,"_25347":1579,"_17690":46148,"_5":17585,"_23966":46046,"_2399":46149},[],"Fleet administrator",{"_2872":1627,"_25347":1579,"_17690":46151,"_5":17585,"_23966":46046,"_2399":46152},[],"DMS, device admission, renewal policy and inventory.",{"_2872":1628,"_25347":1579,"_17690":46154,"_5":17585,"_23966":46046,"_2399":45594},[],{"_2872":1629,"_25347":1579,"_17690":46156,"_5":17585,"_23966":46046,"_2399":46157},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2872":1630,"_25347":1579,"_17690":46159,"_5":17585,"_23966":46046,"_2399":45600},[],{"_2872":1631,"_25347":1579,"_17690":46161,"_5":17585,"_23966":46046,"_2399":46162},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2872":1632,"_25347":1579,"_17690":46164,"_5":17585,"_23966":46046,"_2399":46165},[],"Infrastructure operator",{"_2872":1633,"_25347":1579,"_17690":46167,"_5":17585,"_23966":46046,"_2399":46168},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2872":1634,"_25347":1579,"_17690":46170,"_5":17585,"_23966":46046,"_2399":46171},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2872":1635,"_25347":1635,"_5":12438,"_2399":46173,"_25683":46174,"_17690":46177,"_23966":1635},"CA hierarchy and rotation",[41104,42497,46175,46176],"PKI","Keys, authorities and certificates",[],{"_2872":1636,"_25347":1635,"_17690":46179,"_5":17585,"_23966":1635,"_2399":46180},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2872":1637,"_25347":1635,"_5":25680,"_17690":46182,"_23966":46183,"_2399":46184},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2872":1638,"_25347":1635,"_5":25680,"_17690":46186,"_23966":46187,"_2399":46188},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2872":1639,"_25347":1635,"_5":25680,"_17690":46190,"_23966":46191,"_2399":46192},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2872":1640,"_25347":1635,"_5":25680,"_17690":46194,"_23966":46195,"_2399":46196},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2872":1641,"_25347":1635,"_5":25680,"_17690":46198,"_23966":46199,"_2399":46200},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2872":1642,"_25347":1635,"_5":25680,"_17690":46202,"_23966":46203,"_2399":46204},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2872":1643,"_25347":1635,"_5":25680,"_17690":46206,"_23966":46207,"_2399":46208},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2872":1644,"_25347":1635,"_5":25680,"_17690":46210,"_23966":46211,"_2399":46212},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2872":1645,"_25347":1635,"_5":25680,"_17690":46214,"_23966":46215,"_2399":46216},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2872":1646,"_25347":1635,"_5":25680,"_17690":46218,"_23966":46219,"_2399":46220},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2872":1647,"_25347":1635,"_5":25680,"_17690":46222,"_23966":46223,"_2399":46224},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2872":1648,"_25347":1635,"_5":25680,"_17690":46226,"_23966":46227,"_2399":46228},[],"/docs/pr-preview/pr-42/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2872":1649,"_25347":1635,"_17690":46230,"_5":17585,"_23966":1635,"_2399":46231},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2872":1650,"_25347":1635,"_17690":46233,"_5":17585,"_23966":1635,"_2399":46234},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2872":1651,"_25347":1635,"_17690":46236,"_5":17585,"_23966":46183,"_2399":46237},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2872":1652,"_25347":1635,"_17690":46239,"_5":17585,"_23966":46183,"_2399":46240},[],"environment, such as production and preproduction;",{"_2872":1653,"_25347":1635,"_17690":46242,"_5":17585,"_23966":46183,"_2399":46243},[],"owner or operating team;",{"_2872":1654,"_25347":1635,"_17690":46245,"_5":17585,"_23966":46183,"_2399":46246},[],"device family or manufacturing process;",{"_2872":1655,"_25347":1635,"_17690":46248,"_5":17585,"_23966":46183,"_2399":46249},[],"region or regulatory requirement;",{"_2872":1656,"_25347":1635,"_17690":46251,"_5":17585,"_23966":46183,"_2399":46252},[],"cryptographic engine or key policy;",{"_2872":1657,"_25347":1635,"_17690":46254,"_5":17585,"_23966":46183,"_2399":46255},[],"maintenance window and renewal cadence.",{"_2872":1658,"_25347":1635,"_17690":46257,"_5":17585,"_23966":46183,"_2399":46258},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2872":1659,"_25347":1635,"_17690":46260,"_5":17585,"_23966":46183,"_2399":46261},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2872":1660,"_25347":1635,"_17690":46263,"_5":17585,"_23966":46187,"_2399":46264},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2872":1661,"_25347":1635,"_17690":46266,"_5":17585,"_23966":46187,"_2399":46267},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2872":1662,"_25347":1635,"_17690":46269,"_5":17585,"_23966":46187,"_2399":46270},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2872":1663,"_25347":1635,"_17690":46272,"_5":17585,"_23966":46191,"_2399":46273},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2872":1664,"_25347":1635,"_17690":46275,"_5":17585,"_23966":46191,"_2399":46276},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2872":1665,"_25347":1635,"_17690":46278,"_5":17585,"_23966":46191,"_2399":46279},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2872":1666,"_25347":1635,"_17690":46281,"_5":17585,"_23966":46191,"_2399":46282},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2872":1667,"_25347":1635,"_17690":46284,"_5":17585,"_23966":46199,"_2399":46285},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2872":1668,"_25347":1635,"_17690":46287,"_5":17585,"_23966":46203,"_2399":46288},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2872":1669,"_25347":1635,"_17690":46290,"_5":17585,"_23966":46207,"_2399":46291},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2872":1670,"_25347":1635,"_17690":46293,"_5":17585,"_23966":46211,"_2399":46294},[],"Update the enrollment CA and profile of the DMSs. Keep the additional validation CAs if old certificates still need to be accepted during re-enrollment.",{"_2872":1671,"_25347":1635,"_17690":46296,"_5":17585,"_23966":46215,"_2399":46297},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2872":1672,"_25347":1635,"_17690":46299,"_5":17585,"_23966":46219,"_2399":46300},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2872":1673,"_25347":1635,"_17690":46302,"_5":17585,"_23966":46223,"_2399":46303},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2872":1674,"_25347":1635,"_17690":46305,"_5":17585,"_23966":46223,"_2399":46306},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2872":1675,"_25347":1635,"_17690":46308,"_5":17585,"_23966":46223,"_2399":46309},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2872":1676,"_25347":1635,"_17690":46311,"_5":17585,"_23966":46223,"_2399":46312},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2872":1677,"_25347":1635,"_17690":46314,"_5":17585,"_23966":46227,"_2399":46315},[],"The new chain ends in an anchor installed by the consumer.",{"_2872":1678,"_25347":1635,"_17690":46317,"_5":17585,"_23966":46227,"_2399":46318},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2872":1679,"_25347":1635,"_17690":46320,"_5":17585,"_23966":46227,"_2399":46321},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2872":1680,"_25347":1635,"_17690":46323,"_5":17585,"_23966":46227,"_2399":46324},[],"Re-enrollment accepts the old identity during the planned period.",{"_2872":1681,"_25347":1635,"_17690":46326,"_5":17585,"_23966":46227,"_2399":46327},[],"OCSP and CRL respond for the authorities that remain active.",{"_2872":1682,"_25347":1635,"_17690":46329,"_5":17585,"_23966":46227,"_2399":46330},[],"No DMS is left accidentally issuing from the old CA.",{"_2872":1683,"_25347":1635,"_17690":46332,"_5":17585,"_23966":46227,"_2399":46333},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2872":1684,"_25347":1684,"_5":12438,"_2399":46335,"_25683":46336,"_17690":46337,"_23966":1684},"Certification authorities",[41104,42497,46175,46176],[],{"_2872":1685,"_25347":1684,"_17690":46339,"_5":17585,"_23966":1684,"_2399":46340},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2872":1686,"_25347":1684,"_5":25680,"_17690":46342,"_23966":46343,"_2399":46344},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2872":1687,"_25347":1684,"_5":25680,"_17690":46346,"_23966":46347,"_2399":46348},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2872":1688,"_25347":1684,"_5":25680,"_17690":46350,"_23966":46351,"_2399":41114},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#before-you-begin",{"_2872":1689,"_25347":1684,"_5":25680,"_17690":46353,"_23966":46354,"_2399":46355},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2872":1690,"_25347":1684,"_5":25680,"_17690":46357,"_23966":46358,"_2399":46359},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2872":1691,"_25347":1684,"_5":25680,"_17690":46361,"_23966":46362,"_2399":46363},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2872":1692,"_25347":1684,"_5":25680,"_17690":46365,"_23966":46366,"_2399":46367},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2872":1693,"_25347":1684,"_5":25680,"_17690":46369,"_23966":46370,"_2399":46371},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2872":1694,"_25347":1684,"_5":25680,"_17690":46373,"_23966":46374,"_2399":46375},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2872":1695,"_25347":1684,"_5":25680,"_17690":46377,"_23966":46378,"_2399":46379},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2872":1696,"_25347":1684,"_5":25680,"_17690":46381,"_23966":46382,"_2399":46383},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2872":1697,"_25347":1684,"_5":25680,"_17690":46385,"_23966":46386,"_2399":46387},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2872":1698,"_25347":1684,"_5":25680,"_17690":46389,"_23966":46390,"_2399":46391},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2872":1699,"_25347":1684,"_5":25680,"_17690":46393,"_23966":46394,"_2399":46395},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2872":1700,"_25347":1684,"_5":25680,"_17690":46397,"_23966":46398,"_2399":46399},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2872":1701,"_25347":1684,"_5":25680,"_17690":46401,"_23966":46402,"_2399":46403},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2872":1702,"_25347":1684,"_5":25680,"_17690":46405,"_23966":46406,"_2399":46407},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2872":1703,"_25347":1684,"_5":25680,"_17690":46409,"_23966":46410,"_2399":46411},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2872":1704,"_25347":1684,"_5":25680,"_17690":46413,"_23966":46414,"_2399":46415},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2872":1705,"_25347":1684,"_5":25680,"_17690":46417,"_23966":46418,"_2399":46419},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2872":1706,"_25347":1684,"_5":25680,"_17690":46421,"_23966":46422,"_2399":46423},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2872":1707,"_25347":1684,"_5":25680,"_17690":46425,"_23966":46426,"_2399":46427},[],"/docs/pr-preview/pr-42/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2872":1708,"_25347":1684,"_17690":46429,"_5":17585,"_23966":1684,"_2399":46430},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2872":1709,"_25347":1684,"_17690":46432,"_5":17585,"_23966":1684,"_2399":46433},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2872":1710,"_25347":1684,"_17690":46435,"_5":17585,"_23966":1684,"_2399":46436},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2872":1711,"_25347":1684,"_17690":46438,"_5":17585,"_23966":46343,"_2399":46439},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2872":1712,"_25347":1684,"_17690":46441,"_5":17585,"_23966":46343,"_2399":46442},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2872":1713,"_25347":1684,"_17690":46444,"_5":17585,"_23966":46343,"_2399":46445},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2872":1714,"_25347":1684,"_17690":46447,"_5":17585,"_23966":46343,"_2399":46448},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2872":1715,"_25347":1684,"_17690":46450,"_5":17585,"_23966":46343,"_2399":46451},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2872":1716,"_25347":1684,"_17690":46453,"_5":17585,"_23966":46351,"_2399":46454},[],"Decide whether the CA will be a root or an intermediate.",{"_2872":1717,"_25347":1684,"_17690":46456,"_5":17585,"_23966":46351,"_2399":46457},[],"Choose the engine that will keep the key.",{"_2872":1718,"_25347":1684,"_17690":46459,"_5":17585,"_23966":46351,"_2399":46460},[],"Define a validity longer than that of the certificates it will issue.",{"_2872":1719,"_25347":1684,"_17690":46462,"_5":17585,"_23966":46351,"_2399":46463},[],"For an intermediate CA, make sure the parent CA is active.",{"_2872":1720,"_25347":1684,"_17690":46465,"_5":17585,"_23966":46354,"_2399":46466},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2872":1721,"_25347":1684,"_17690":46468,"_5":17585,"_23966":46358,"_2399":46469},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2872":1722,"_25347":1684,"_17690":46471,"_5":17585,"_23966":46358,"_2399":46472},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2872":1723,"_25347":1684,"_17690":46474,"_5":17585,"_23966":46362,"_2399":46475},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2872":1724,"_25347":1684,"_17690":46477,"_5":17585,"_23966":46366,"_2399":46478},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2872":1725,"_25347":1684,"_17690":46480,"_5":17585,"_23966":46366,"_2399":46481},[],"`C`: two-letter ISO 3166-1 country code.",{"_2872":1726,"_25347":1684,"_17690":46483,"_5":17585,"_23966":46366,"_2399":46484},[],"`ST`: state or province.",{"_2872":1727,"_25347":1684,"_17690":46486,"_5":17585,"_23966":46366,"_2399":46487},[],"`L`: locality.",{"_2872":1728,"_25347":1684,"_17690":46489,"_5":17585,"_23966":46366,"_2399":46490},[],"`O`: organization.",{"_2872":1729,"_25347":1684,"_17690":46492,"_5":17585,"_23966":46366,"_2399":46493},[],"`OU`: organizational unit.",{"_2872":1730,"_25347":1684,"_17690":46495,"_5":17585,"_23966":46366,"_2399":46496},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2872":1731,"_25347":1684,"_17690":46498,"_5":17585,"_23966":46370,"_2399":46499},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2872":1732,"_25347":1684,"_17690":46501,"_5":17585,"_23966":46370,"_2399":46502},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2872":1733,"_25347":1684,"_17690":46504,"_5":17585,"_23966":46374,"_2399":46505},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2872":1734,"_25347":1684,"_17690":46507,"_5":17585,"_23966":46374,"_2399":46508},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2872":1735,"_25347":1684,"_17690":46510,"_5":17585,"_23966":46378,"_2399":46511},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2872":1736,"_25347":1684,"_17690":46513,"_5":17585,"_23966":46378,"_2399":46514},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2872":1737,"_25347":1684,"_17690":46516,"_5":17585,"_23966":46382,"_2399":46517},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2872":1738,"_25347":1684,"_17690":46519,"_5":17585,"_23966":46386,"_2399":46520},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2872":1739,"_25347":1684,"_17690":46522,"_5":17585,"_23966":46390,"_2399":46523},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2872":1740,"_25347":1684,"_17690":46525,"_5":17585,"_23966":46394,"_2399":46526},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2872":1741,"_25347":1684,"_17690":46528,"_5":17585,"_23966":46398,"_2399":46529},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2872":1742,"_25347":1684,"_17690":46531,"_5":17585,"_23966":46398,"_2399":46532},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2872":1743,"_25347":1684,"_17690":46534,"_5":17585,"_23966":46402,"_2399":46535},[],"Open a CA from the inventory to review:",{"_2872":1744,"_25347":1684,"_17690":46537,"_5":17585,"_23966":46402,"_2399":46538},[],"Status and validity period.",{"_2872":1745,"_25347":1684,"_17690":46540,"_5":17585,"_23966":46402,"_2399":46541},[],"Certificate and chain in PEM format.",{"_2872":1746,"_25347":1684,"_17690":46543,"_5":17585,"_23966":46402,"_2399":46544},[],"Number of active, expired and revoked certificates.",{"_2872":1747,"_25347":1684,"_17690":46546,"_5":17585,"_23966":46402,"_2399":46547},[],"Certificates issued in **Issued Certificates**.",{"_2872":1748,"_25347":1684,"_17690":46549,"_5":17585,"_23966":46402,"_2399":46550},[],"The CRL linked to the authority.",{"_2872":1749,"_25347":1684,"_17690":46552,"_5":17585,"_23966":46402,"_2399":46553},[],"Metadata and the associated cryptographic engine.",{"_2872":1750,"_25347":1684,"_17690":46555,"_5":17585,"_23966":46402,"_2399":46556},[],"You can filter the inventory by name, status and CA type.",{"_2872":1751,"_25347":1684,"_17690":46558,"_5":17585,"_23966":46406,"_2399":46559},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2872":1752,"_25347":1684,"_17690":46561,"_5":17585,"_23966":46406,"_2399":46562},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2872":1753,"_25347":1684,"_17690":46564,"_5":17585,"_23966":46406,"_2399":46565},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2872":1754,"_25347":1684,"_17690":46567,"_5":17585,"_23966":46406,"_2399":46568},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2872":1755,"_25347":1684,"_17690":46570,"_5":17585,"_23966":46410,"_2399":46571},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2872":1756,"_25347":1684,"_17690":46573,"_5":17585,"_23966":46414,"_2399":46574},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2872":1757,"_25347":1684,"_17690":46576,"_5":17585,"_23966":46418,"_2399":46577},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2872":1758,"_25347":1684,"_17690":46579,"_5":17585,"_23966":46422,"_2399":46580},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2872":1759,"_25347":1684,"_17690":46582,"_5":17585,"_23966":46426,"_2399":46583},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2872":1760,"_25347":1684,"_17690":46585,"_5":17585,"_23966":46426,"_2399":46586},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2872":1761,"_25347":1761,"_5":12438,"_2399":46588,"_25683":46589,"_17690":46590,"_23966":1761},"Certificate profiles",[41104,42497,46175,46176],[],{"_2872":1762,"_25347":1761,"_17690":46592,"_5":17585,"_23966":1761,"_2399":46593},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2872":1763,"_25347":1761,"_5":25680,"_17690":46595,"_23966":46596,"_2399":46597},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2872":1764,"_25347":1761,"_5":25680,"_17690":46599,"_23966":46600,"_2399":46601},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#validity","Validity",{"_2872":1765,"_25347":1761,"_5":25680,"_17690":46603,"_23966":46604,"_2399":46605},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2872":1766,"_25347":1761,"_5":25680,"_17690":46607,"_23966":46608,"_2399":46609},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2872":1767,"_25347":1761,"_5":25680,"_17690":46611,"_23966":46612,"_2399":46613},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#subject","Subject",{"_2872":1768,"_25347":1761,"_5":25680,"_17690":46615,"_23966":46616,"_2399":46617},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2872":1769,"_25347":1761,"_5":25680,"_17690":46619,"_23966":46620,"_2399":46621},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2872":1770,"_25347":1761,"_5":25680,"_17690":46623,"_23966":46624,"_2399":46625},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2872":1771,"_25347":1761,"_5":25680,"_17690":46627,"_23966":46628,"_2399":46629},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2872":1772,"_25347":1761,"_5":25680,"_17690":46631,"_23966":46632,"_2399":46633},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2872":1773,"_25347":1761,"_5":25680,"_17690":46635,"_23966":46636,"_2399":46637},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2872":1774,"_25347":1761,"_5":25680,"_17690":46639,"_23966":46640,"_2399":46641},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2872":1775,"_25347":1761,"_5":25680,"_17690":46643,"_23966":46644,"_2399":46645},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2872":1776,"_25347":1761,"_5":25680,"_17690":46647,"_23966":46648,"_2399":46649},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2872":1777,"_25347":1761,"_5":25680,"_17690":46651,"_23966":46652,"_2399":46653},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#design-examples","Design examples",{"_2872":1778,"_25347":1761,"_5":25680,"_17690":46655,"_23966":46656,"_2399":46657},[],"/docs/pr-preview/pr-42/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2872":1779,"_25347":1761,"_17690":46659,"_5":17585,"_23966":1761,"_2399":46660},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2872":1780,"_25347":1761,"_17690":46662,"_5":17585,"_23966":1761,"_2399":46663},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2872":1781,"_25347":1761,"_17690":46665,"_5":17585,"_23966":46600,"_2399":46666},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2872":1782,"_25347":1761,"_17690":46668,"_5":17585,"_23966":46600,"_2399":46669},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2872":1783,"_25347":1761,"_17690":46671,"_5":17585,"_23966":46604,"_2399":46672},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2872":1784,"_25347":1761,"_17690":46674,"_5":17585,"_23966":46608,"_2399":46675},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2872":1785,"_25347":1761,"_17690":46677,"_5":17585,"_23966":46608,"_2399":46678},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2872":1786,"_25347":1761,"_17690":46680,"_5":17585,"_23966":46608,"_2399":46681},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2872":1787,"_25347":1761,"_17690":46683,"_5":17585,"_23966":46612,"_2399":46684},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2872":1788,"_25347":1761,"_17690":46686,"_5":17585,"_23966":46616,"_2399":46687},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2872":1789,"_25347":1761,"_17690":46689,"_5":17585,"_23966":46616,"_2399":46690},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2872":1790,"_25347":1761,"_17690":46692,"_5":17585,"_23966":46620,"_2399":46693},[],"The cryptographic enforcement can:",{"_2872":1791,"_25347":1761,"_17690":46695,"_5":17585,"_23966":46620,"_2399":46696},[],"allow or block RSA keys;",{"_2872":1792,"_25347":1761,"_17690":46698,"_5":17585,"_23966":46620,"_2399":46699},[],"limit the supported RSA sizes;",{"_2872":1793,"_25347":1761,"_17690":46701,"_5":17585,"_23966":46620,"_2399":46702},[],"allow or block ECDSA keys;",{"_2872":1794,"_25347":1761,"_17690":46704,"_5":17585,"_23966":46620,"_2399":46705},[],"limit the supported ECDSA sizes or curves.",{"_2872":1795,"_25347":1761,"_17690":46707,"_5":17585,"_23966":46620,"_2399":46708},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2872":1796,"_25347":1761,"_17690":46710,"_5":17585,"_23966":46624,"_2399":46711},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2872":1797,"_25347":1761,"_17690":46713,"_5":17585,"_23966":46624,"_2399":44215},[],{"_2872":1798,"_25347":1761,"_17690":46715,"_5":17585,"_23966":46624,"_2399":46716},[],"First choice",{"_2872":1799,"_25347":1761,"_17690":46718,"_5":17585,"_23966":46624,"_2399":46719},[],"Second choice",{"_2872":1800,"_25347":1761,"_17690":46721,"_5":17585,"_23966":46624,"_2399":46722},[],"If neither is supplied",{"_2872":1801,"_25347":1761,"_17690":46724,"_5":17585,"_23966":46624,"_2399":46725},[],"Direct signing with a CA",{"_2872":1802,"_25347":1761,"_17690":46727,"_5":17585,"_23966":46624,"_2399":46728},[],"`issuance_profile` embedded in the request",{"_2872":1803,"_25347":1761,"_17690":46730,"_5":17585,"_23966":46624,"_2399":46731},[],"Request `issuance_profile_id`",{"_2872":1804,"_25347":1761,"_17690":46733,"_5":17585,"_23966":46624,"_2399":46734},[],"CA default profile (`profile_id`).",{"_2872":1805,"_25347":1761,"_17690":46736,"_5":17585,"_23966":46624,"_2399":46737},[],"Issuance through a DMS",{"_2872":1806,"_25347":1761,"_17690":46739,"_5":17585,"_23966":46624,"_2399":46740},[],"`settings.issuance_profile_id`",{"_2872":1807,"_25347":1761,"_17690":46742,"_5":17585,"_23966":46624,"_2399":46743},[],"`settings.issuance_profile` embedded in the DMS",{"_2872":1808,"_25347":1761,"_17690":46745,"_5":17585,"_23966":46624,"_2399":46746},[],"Enrollment CA default profile.",{"_2872":1809,"_25347":1761,"_17690":46748,"_5":17585,"_23966":46624,"_2399":46749},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2872":1810,"_25347":1761,"_17690":46751,"_5":17585,"_23966":46624,"_2399":46752},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2872":1811,"_25347":1761,"_17690":46754,"_5":17585,"_23966":46632,"_2399":46755},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2872":1812,"_25347":1761,"_17690":46757,"_5":17585,"_23966":46636,"_2399":46758},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2872":1813,"_25347":1761,"_17690":46760,"_5":17585,"_23966":46640,"_2399":46761},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2872":1814,"_25347":1761,"_17690":46763,"_5":17585,"_23966":46644,"_2399":46764},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2872":1815,"_25347":1761,"_17690":46766,"_5":17585,"_23966":46648,"_2399":46767},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2872":1816,"_25347":1761,"_17690":46769,"_5":17585,"_23966":46648,"_2399":46770},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2872":1817,"_25347":1761,"_17690":46772,"_5":17585,"_23966":46652,"_2399":46773},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2872":1818,"_25347":1761,"_17690":46775,"_5":17585,"_23966":46652,"_2399":46776},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2872":1819,"_25347":1761,"_17690":46778,"_5":17585,"_23966":46652,"_2399":46779},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2872":1820,"_25347":1761,"_17690":46781,"_5":17585,"_23966":46652,"_2399":46782},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2872":1821,"_25347":1761,"_17690":46784,"_5":17585,"_23966":46656,"_2399":46785},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2872":1822,"_25347":1761,"_17690":46787,"_5":17585,"_23966":46656,"_2399":46788},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2872":1823,"_25347":1823,"_5":12438,"_2399":46790,"_25683":46791,"_17690":46793,"_23966":1823},"Certificate validation",[41104,42497,46175,46792],"Validation",[],{"_2872":1824,"_25347":1823,"_17690":46795,"_5":17585,"_23966":1823,"_2399":46796},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2872":1825,"_25347":1823,"_5":25680,"_17690":46798,"_23966":46799,"_2399":46800},[],"/docs/pr-preview/pr-42/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2872":1826,"_25347":1823,"_5":25680,"_17690":46802,"_23966":46803,"_2399":46804},[],"/docs/pr-preview/pr-42/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2872":1827,"_25347":1823,"_5":25680,"_17690":46806,"_23966":46807,"_2399":46808},[],"/docs/pr-preview/pr-42/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2872":1828,"_25347":1823,"_17690":46810,"_5":17585,"_23966":1823,"_2399":46811},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2872":1829,"_25347":1823,"_17690":46813,"_5":17585,"_23966":46799,"_2399":46814},[],"Verify these criteria together:",{"_2872":1830,"_25347":1823,"_17690":46816,"_5":17585,"_23966":46799,"_2399":45799},[],{"_2872":1831,"_25347":1823,"_17690":46818,"_5":17585,"_23966":46799,"_2399":46819},[],"Required result",{"_2872":1832,"_25347":1823,"_17690":46821,"_5":17585,"_23966":46799,"_2399":46822},[],"Chain and signature",{"_2872":1833,"_25347":1823,"_17690":46824,"_5":17585,"_23966":46799,"_2399":46825},[],"Valid chain to a root deliberately installed in the consumer.",{"_2872":1834,"_25347":1823,"_17690":46827,"_5":17585,"_23966":46799,"_2399":46828},[],"Dates",{"_2872":1835,"_25347":1823,"_17690":46830,"_5":17585,"_23966":46799,"_2399":46831},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2872":1836,"_25347":1823,"_17690":46833,"_5":17585,"_23966":46799,"_2399":42179},[],{"_2872":1837,"_25347":1823,"_17690":46835,"_5":17585,"_23966":46799,"_2399":46836},[],"Name, SAN or identifier matches the expected peer.",{"_2872":1838,"_25347":1823,"_17690":46838,"_5":17585,"_23966":46799,"_2399":41487},[],{"_2872":1839,"_25347":1823,"_17690":46840,"_5":17585,"_23966":46799,"_2399":46841},[],"KU, EKU and constraints permit the specific operation.",{"_2872":1840,"_25347":1823,"_17690":46843,"_5":17585,"_23966":46799,"_2399":46844},[],"Revocation",{"_2872":1841,"_25347":1823,"_17690":46846,"_5":17585,"_23966":46799,"_2399":46847},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2872":1842,"_25347":1823,"_17690":46849,"_5":17585,"_23966":46799,"_2399":46850},[],"Authorization",{"_2872":1843,"_25347":1823,"_17690":46852,"_5":17585,"_23966":46799,"_2399":46853},[],"The application permits that identity to perform the action.",{"_2872":1844,"_25347":1823,"_17690":46855,"_5":17585,"_23966":46799,"_2399":46856},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2872":1845,"_25347":1823,"_17690":46858,"_5":17585,"_23966":46803,"_2399":46859},[],"Mechanism",{"_2872":1846,"_25347":1823,"_17690":46861,"_5":17585,"_23966":46803,"_2399":46862},[],"When to use it",{"_2872":1847,"_25347":1823,"_17690":46864,"_5":17585,"_23966":46803,"_2399":46865},[],"What you must maintain",{"_2872":1848,"_25347":1823,"_17690":46867,"_5":17585,"_23966":46803,"_2399":46868},[],"OCSP",{"_2872":1849,"_25347":1823,"_17690":46870,"_5":17585,"_23966":46803,"_2399":46871},[],"Status query for a specific certificate.",{"_2872":1850,"_25347":1823,"_17690":46873,"_5":17585,"_23966":46803,"_2399":46874},[],"Responder access, signature verification and cache/freshness policy.",{"_2872":1851,"_25347":1823,"_17690":46876,"_5":17585,"_23966":46803,"_2399":46877},[],"CRL",{"_2872":1852,"_25347":1823,"_17690":46879,"_5":17585,"_23966":46803,"_2399":46880},[],"Local checks for many certificates or offline operation.",{"_2872":1853,"_25347":1823,"_17690":46882,"_5":17585,"_23966":46803,"_2399":46883},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2872":1854,"_25347":1823,"_17690":46885,"_5":17585,"_23966":46803,"_2399":46886},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2872":1855,"_25347":1823,"_17690":46888,"_5":17585,"_23966":46803,"_2399":46889},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2872":1856,"_25347":1823,"_17690":46891,"_5":17585,"_23966":46807,"_2399":46892},[],"Accept a current, authorized certificate with a known chain.",{"_2872":1857,"_25347":1823,"_17690":46894,"_5":17585,"_23966":46807,"_2399":46895},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2872":1858,"_25347":1823,"_17690":46897,"_5":17585,"_23966":46807,"_2399":46898},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2872":1859,"_25347":1823,"_17690":46900,"_5":17585,"_23966":46807,"_2399":46901},[],"Check that a new connection with that identity is rejected.",{"_2872":1860,"_25347":1823,"_17690":46903,"_5":17585,"_23966":46807,"_2399":46904},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2872":1861,"_25347":1823,"_17690":46906,"_5":17585,"_23966":46807,"_2399":46907},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2872":1862,"_25347":1823,"_17690":46909,"_5":17585,"_23966":46807,"_2399":46910},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2872":1863,"_25347":1823,"_17690":46912,"_5":17585,"_23966":46807,"_2399":46913},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2872":1864,"_25347":1823,"_17690":46915,"_5":17585,"_23966":46807,"_2399":46916},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2872":1865,"_25347":1865,"_5":12438,"_2399":46918,"_25683":46919,"_17690":46920,"_23966":1865},"Certificates",[41104,42497,46175,46176],[],{"_2872":1866,"_25347":1865,"_17690":46922,"_5":17585,"_23966":1865,"_2399":46923},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2872":1867,"_25347":1865,"_5":25680,"_17690":46925,"_23966":46926,"_2399":46927},[],"/docs/pr-preview/pr-42/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2872":1868,"_25347":1865,"_5":25680,"_17690":46929,"_23966":46930,"_2399":46931},[],"/docs/pr-preview/pr-42/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2872":1869,"_25347":1865,"_5":25680,"_17690":46933,"_23966":46934,"_2399":46935},[],"/docs/pr-preview/pr-42/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2872":1870,"_25347":1865,"_5":25680,"_17690":46937,"_23966":46938,"_2399":46939},[],"/docs/pr-preview/pr-42/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2872":1871,"_25347":1865,"_5":25680,"_17690":46941,"_23966":46942,"_2399":46943},[],"/docs/pr-preview/pr-42/platform/pki/certificates#open-the-action","Open the action",{"_2872":1872,"_25347":1865,"_5":25680,"_17690":46945,"_23966":46946,"_2399":46947},[],"/docs/pr-preview/pr-42/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2872":1873,"_25347":1865,"_5":25680,"_17690":46949,"_23966":46950,"_2399":46951},[],"/docs/pr-preview/pr-42/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2872":1874,"_25347":1865,"_5":25680,"_17690":46953,"_23966":46954,"_2399":46955},[],"/docs/pr-preview/pr-42/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2872":1875,"_25347":1865,"_5":25680,"_17690":46957,"_23966":46958,"_2399":46959},[],"/docs/pr-preview/pr-42/platform/pki/certificates#continue","Continue",{"_2872":1876,"_25347":1865,"_17690":46961,"_5":17585,"_23966":1865,"_2399":46962},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2872":1877,"_25347":1865,"_17690":46964,"_5":17585,"_23966":46926,"_2399":46965},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2872":1878,"_25347":1865,"_17690":46967,"_5":17585,"_23966":46926,"_2399":46968},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2872":1879,"_25347":1865,"_17690":46970,"_5":17585,"_23966":46930,"_2399":46971},[],"Download the PEM and inspect it:",{"_2872":1880,"_25347":1865,"_17690":46973,"_5":17585,"_23966":46930,"_2399":46974},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2872":1881,"_25347":1865,"_17690":46976,"_5":17585,"_23966":46934,"_2399":46977},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2872":1882,"_25347":1865,"_17690":46979,"_5":17585,"_23966":46934,"_2399":46980},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2872":1883,"_25347":1865,"_17690":46982,"_5":17585,"_23966":46934,"_2399":46983},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2872":1884,"_25347":1865,"_17690":46985,"_5":17585,"_23966":46934,"_2399":46986},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2872":1885,"_25347":1865,"_17690":46988,"_5":17585,"_23966":46934,"_2399":46989},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2872":1886,"_25347":1865,"_17690":46991,"_5":17585,"_23966":46934,"_2399":46992},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2872":1887,"_25347":1865,"_17690":46994,"_5":17585,"_23966":46934,"_2399":46995},[],"For browser key generation, follow Issue your first certificate.",{"_2872":1888,"_25347":1865,"_17690":46997,"_5":17585,"_23966":46938,"_2399":46998},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2872":1889,"_25347":1865,"_17690":47000,"_5":17585,"_23966":46942,"_2399":47001},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2872":1890,"_25347":1865,"_17690":47003,"_5":17585,"_23966":46946,"_2399":47004},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2872":1891,"_25347":1865,"_17690":47006,"_5":17585,"_23966":46950,"_2399":47007},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2872":1892,"_25347":1865,"_17690":47009,"_5":17585,"_23966":46950,"_2399":47010},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2872":1893,"_25347":1865,"_17690":47012,"_5":17585,"_23966":46950,"_2399":47013},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2872":1894,"_25347":1865,"_17690":47015,"_5":17585,"_23966":46954,"_2399":47016},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2872":1895,"_25347":1865,"_17690":47018,"_5":17585,"_23966":46954,"_2399":47019},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2872":1896,"_25347":1865,"_17690":47021,"_5":17585,"_23966":46954,"_2399":47022},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2872":1897,"_25347":1865,"_17690":47024,"_5":17585,"_23966":46958,"_2399":47025},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2872":1898,"_25347":1865,"_17690":47027,"_5":17585,"_23966":46958,"_2399":47028},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2872":1899,"_25347":1899,"_5":12438,"_2399":47030,"_25683":47031,"_17690":47033,"_23966":1899},"Certificate lifecycle",[41104,42497,46175,47032],"Concepts",[],{"_2872":1900,"_25347":1899,"_17690":47035,"_5":17585,"_23966":1899,"_2399":47036},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2872":1901,"_25347":1899,"_5":25680,"_17690":47038,"_23966":47039,"_2399":47040},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2872":1902,"_25347":1899,"_5":25680,"_17690":47042,"_23966":47043,"_2399":47044},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2872":1903,"_25347":1899,"_5":25680,"_17690":47046,"_23966":47047,"_2399":47048},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2872":1904,"_25347":1899,"_5":25680,"_17690":47050,"_23966":47051,"_2399":47052},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2872":1905,"_25347":1899,"_5":25680,"_17690":47054,"_23966":47055,"_2399":47056},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2872":1906,"_25347":1899,"_5":25680,"_17690":47058,"_23966":47059,"_2399":47060},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2872":1907,"_25347":1899,"_5":25680,"_17690":47062,"_23966":47063,"_2399":47064},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2872":1908,"_25347":1899,"_5":25680,"_17690":47066,"_23966":47067,"_2399":47068},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2872":1909,"_25347":1899,"_5":25680,"_17690":47070,"_23966":47071,"_2399":47072},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2872":1910,"_25347":1899,"_5":25680,"_17690":47074,"_23966":47075,"_2399":47076},[],"/docs/pr-preview/pr-42/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2872":1911,"_25347":1899,"_17690":47078,"_5":17585,"_23966":1899,"_2399":47079},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2872":1912,"_25347":1899,"_17690":47081,"_5":17585,"_23966":47043,"_2399":47082},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2872":1913,"_25347":1899,"_17690":47084,"_5":17585,"_23966":47047,"_2399":47085},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2872":1914,"_25347":1899,"_17690":47087,"_5":17585,"_23966":47051,"_2399":47088},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2872":1915,"_25347":1899,"_17690":47090,"_5":17585,"_23966":47055,"_2399":47091},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2872":1916,"_25347":1899,"_17690":47093,"_5":17585,"_23966":47059,"_2399":47094},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2872":1917,"_25347":1899,"_17690":47096,"_5":17585,"_23966":47063,"_2399":47097},[],"Lamassu persists four X.509 states:",{"_2872":1918,"_25347":1899,"_17690":47099,"_5":17585,"_23966":47063,"_2399":47100},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2872":1919,"_25347":1899,"_17690":47102,"_5":17585,"_23966":47063,"_2399":47103},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2872":1920,"_25347":1899,"_17690":47105,"_5":17585,"_23966":47063,"_2399":47106},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2872":1921,"_25347":1899,"_17690":47108,"_5":17585,"_23966":47063,"_2399":47109},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2872":1922,"_25347":1899,"_17690":47111,"_5":17585,"_23966":47063,"_2399":47112},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2872":1923,"_25347":1899,"_17690":47114,"_5":17585,"_23966":47067,"_2399":47115},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2872":1924,"_25347":1899,"_17690":47117,"_5":17585,"_23966":47067,"_2399":47118},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2872":1925,"_25347":1899,"_17690":47120,"_5":17585,"_23966":47067,"_2399":47121},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2872":1926,"_25347":1899,"_17690":47123,"_5":17585,"_23966":47071,"_2399":47124},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2872":1927,"_25347":1899,"_17690":47126,"_5":17585,"_23966":47071,"_2399":47127},[],"Before confirming:",{"_2872":1928,"_25347":1899,"_17690":47129,"_5":17585,"_23966":47071,"_2399":47130},[],"Identify DMSs, devices and services that trust that chain.",{"_2872":1929,"_25347":1899,"_17690":47132,"_5":17585,"_23966":47071,"_2399":47133},[],"Distribute the new chain of trust.",{"_2872":1930,"_25347":1899,"_17690":47135,"_5":17585,"_23966":47071,"_2399":47136},[],"Reissue the necessary identities.",{"_2872":1931,"_25347":1899,"_17690":47138,"_5":17585,"_23966":47071,"_2399":47139},[],"Check OCSP and CRL from a real consumer.",{"_2872":1932,"_25347":1899,"_17690":47141,"_5":17585,"_23966":47071,"_2399":47142},[],"Revoke the old CA once no legitimate traffic remains.",{"_2872":1933,"_25347":1899,"_17690":47144,"_5":17585,"_23966":47071,"_2399":47145},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2872":1934,"_25347":1899,"_17690":47147,"_5":17585,"_23966":47075,"_2399":47148},[],"Certificates entering the preventive or critical renewal window.",{"_2872":1935,"_25347":1899,"_17690":47150,"_5":17585,"_23966":47075,"_2399":47151},[],"Repeated enrollment or re-enrollment failures.",{"_2872":1936,"_25347":1899,"_17690":47153,"_5":17585,"_23966":47075,"_2399":47154},[],"Status changes and revocation reasons.",{"_2872":1937,"_25347":1899,"_17690":47156,"_5":17585,"_23966":47075,"_2399":47157},[],"OCSP and CRL publication and validity.",{"_2872":1938,"_25347":1899,"_17690":47159,"_5":17585,"_23966":47075,"_2399":47160},[],"Dependencies still presenting a replaced certificate.",{"_2872":1939,"_25347":1899,"_17690":47162,"_5":17585,"_23966":47075,"_2399":47163},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2872":1940,"_25347":1940,"_5":12438,"_2399":47165,"_25683":47166,"_17690":47167,"_23966":1940},"Trust model",[41104,42497,46175,47032],[],{"_2872":1941,"_25347":1940,"_17690":47169,"_5":17585,"_23966":1940,"_2399":47170},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2872":1942,"_25347":1940,"_5":25680,"_17690":47172,"_23966":47173,"_2399":47174},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2872":1943,"_25347":1940,"_5":25680,"_17690":47176,"_23966":47177,"_2399":47178},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2872":1944,"_25347":1940,"_5":25680,"_17690":47180,"_23966":47181,"_2399":47182},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2872":1945,"_25347":1940,"_5":25680,"_17690":47184,"_23966":47185,"_2399":47186},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2872":1946,"_25347":1940,"_5":25680,"_17690":47188,"_23966":47189,"_2399":47190},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2872":1947,"_25347":1940,"_5":25680,"_17690":47192,"_23966":47193,"_2399":47194},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2872":1948,"_25347":1940,"_5":25680,"_17690":47196,"_23966":47197,"_2399":47198},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2872":1949,"_25347":1940,"_5":25680,"_17690":47200,"_23966":47201,"_2399":47202},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2872":1950,"_25347":1940,"_5":25680,"_17690":47204,"_23966":47205,"_2399":47206},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2872":1951,"_25347":1940,"_5":25680,"_17690":47208,"_23966":47209,"_2399":47210},[],"/docs/pr-preview/pr-42/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2872":1952,"_25347":1940,"_17690":47212,"_5":17585,"_23966":1940,"_2399":47213},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2872":1953,"_25347":1940,"_17690":47215,"_5":17585,"_23966":47177,"_2399":47216},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2872":1954,"_25347":1940,"_17690":47218,"_5":17585,"_23966":47181,"_2399":47219},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2872":1955,"_25347":1940,"_17690":47221,"_5":17585,"_23966":47185,"_2399":47222},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2872":1956,"_25347":1940,"_17690":47224,"_5":17585,"_23966":47189,"_2399":47225},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2872":1957,"_25347":1940,"_17690":47227,"_5":17585,"_23966":47193,"_2399":47228},[],"The device proves it can enroll according to the DMS policy.",{"_2872":1958,"_25347":1940,"_17690":47230,"_5":17585,"_23966":47193,"_2399":47231},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2872":1959,"_25347":1940,"_17690":47233,"_5":17585,"_23966":47193,"_2399":47234},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2872":1960,"_25347":1940,"_17690":47236,"_5":17585,"_23966":47193,"_2399":47237},[],"The device installs the certificate and the chain it needs.",{"_2872":1961,"_25347":1940,"_17690":47239,"_5":17585,"_23966":47193,"_2399":47240},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2872":1962,"_25347":1940,"_17690":47242,"_5":17585,"_23966":47193,"_2399":47243},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2872":1963,"_25347":1940,"_17690":47245,"_5":17585,"_23966":47197,"_2399":47246},[],"A DMS relates three sets that are worth designing separately:",{"_2872":1964,"_25347":1940,"_17690":47248,"_5":17585,"_23966":47197,"_2399":47249},[],"**Enrollment CA:** signs the new identities.",{"_2872":1965,"_25347":1940,"_17690":47251,"_5":17585,"_23966":47197,"_2399":47252},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the additional validation CAs.",{"_2872":1966,"_25347":1940,"_17690":47254,"_5":17585,"_23966":47197,"_2399":47255},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2872":1967,"_25347":1940,"_17690":47257,"_5":17585,"_23966":47197,"_2399":47258},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2872":1968,"_25347":1940,"_17690":47260,"_5":17585,"_23966":47201,"_2399":47261},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2872":1969,"_25347":1940,"_17690":47263,"_5":17585,"_23966":47201,"_2399":47264},[],"that the current date is between `Not Before` and `Not After`;",{"_2872":1970,"_25347":1940,"_17690":47266,"_5":17585,"_23966":47201,"_2399":47267},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2872":1971,"_25347":1940,"_17690":47269,"_5":17585,"_23966":47201,"_2399":47270},[],"that names, SANs and subject match the expected identity;",{"_2872":1972,"_25347":1940,"_17690":47272,"_5":17585,"_23966":47201,"_2399":47273},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2872":1973,"_25347":1940,"_17690":47275,"_5":17585,"_23966":47201,"_2399":47276},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2872":1974,"_25347":1940,"_17690":47278,"_5":17585,"_23966":47201,"_2399":47279},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2872":1975,"_25347":1940,"_17690":47281,"_5":17585,"_23966":47205,"_2399":47282},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2872":1976,"_25347":1940,"_17690":47284,"_5":17585,"_23966":47209,"_2399":47285},[],"Keep the root out of daily operations, or with very restricted access.",{"_2872":1977,"_25347":1940,"_17690":47287,"_5":17585,"_23966":47209,"_2399":47288},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2872":1978,"_25347":1940,"_17690":47290,"_5":17585,"_23966":47209,"_2399":47291},[],"Assign explicit profiles to every use case.",{"_2872":1979,"_25347":1940,"_17690":47293,"_5":17585,"_23966":47209,"_2399":47294},[],"Distribute the new trust before starting a rotation.",{"_2872":1980,"_25347":1940,"_17690":47296,"_5":17585,"_23966":47209,"_2399":47297},[],"Keep enough overlap to renew a disconnected fleet.",{"_2872":1981,"_25347":1940,"_17690":47299,"_5":17585,"_23966":47209,"_2399":47300},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2872":1982,"_25347":1940,"_17690":47302,"_5":17585,"_23966":47209,"_2399":47303},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2872":1983,"_25347":1983,"_5":12438,"_2399":47305,"_25683":47306,"_17690":47307,"_23966":1983},"Revocation lists (CRL)",[41104,42497,46175,46792],[],{"_2872":1984,"_25347":1983,"_17690":47309,"_5":17585,"_23966":1983,"_2399":47310},[],"Generate and distribute signed lists to validate certificates offline.",{"_2872":1985,"_25347":1983,"_5":25680,"_17690":47312,"_23966":47313,"_2399":47314},[],"/docs/pr-preview/pr-42/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2872":1986,"_25347":1983,"_5":25680,"_17690":47316,"_23966":47317,"_2399":47318},[],"/docs/pr-preview/pr-42/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2872":1987,"_25347":1983,"_5":25680,"_17690":47320,"_23966":47321,"_2399":47322},[],"/docs/pr-preview/pr-42/platform/pki/crl#crl-contents","CRL contents",{"_2872":1988,"_25347":1983,"_5":25680,"_17690":47324,"_23966":47325,"_2399":47326},[],"/docs/pr-preview/pr-42/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2872":1989,"_25347":1983,"_5":25680,"_17690":47328,"_23966":47329,"_2399":47330},[],"/docs/pr-preview/pr-42/platform/pki/crl#va-role-management-api","VA role management API",{"_2872":1990,"_25347":1983,"_5":25680,"_17690":47332,"_23966":47333,"_2399":47334},[],"/docs/pr-preview/pr-42/platform/pki/crl#from-the-interface","From the interface",{"_2872":1991,"_25347":1983,"_5":25680,"_17690":47336,"_23966":47337,"_2399":47338},[],"/docs/pr-preview/pr-42/platform/pki/crl#references","References",{"_2872":1992,"_25347":1983,"_17690":47340,"_5":17585,"_23966":1983,"_2399":47341},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2872":1993,"_25347":1983,"_17690":47343,"_5":17585,"_23966":47313,"_2399":47344},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2872":1994,"_25347":1983,"_17690":47346,"_5":17585,"_23966":47313,"_2399":47347},[],"`crl_options` field",{"_2872":1995,"_25347":1983,"_17690":47349,"_5":17585,"_23966":47313,"_2399":41487},[],{"_2872":1996,"_25347":1983,"_17690":47351,"_5":17585,"_23966":47313,"_2399":47352},[],"Backend initial value",{"_2872":1997,"_25347":1983,"_17690":47354,"_5":17585,"_23966":47313,"_2399":47355},[],"`validity`",{"_2872":1998,"_25347":1983,"_17690":47357,"_5":17585,"_23966":47313,"_2399":47358},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2872":1999,"_25347":1983,"_17690":47360,"_5":17585,"_23966":47313,"_2399":47361},[],"7 days.",{"_2872":2000,"_25347":1983,"_17690":47363,"_5":17585,"_23966":47313,"_2399":47364},[],"`refresh_interval`",{"_2872":2001,"_25347":1983,"_17690":47366,"_5":17585,"_23966":47313,"_2399":47367},[],"Time since publication that triggers scheduled renewal.",{"_2872":2002,"_25347":1983,"_17690":47369,"_5":17585,"_23966":47313,"_2399":47370},[],"6 days and 23 hours.",{"_2872":2003,"_25347":1983,"_17690":47372,"_5":17585,"_23966":47313,"_2399":47373},[],"`regenerate_on_revoke`",{"_2872":2004,"_25347":1983,"_17690":47375,"_5":17585,"_23966":47313,"_2399":47376},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2872":2005,"_25347":1983,"_17690":47378,"_5":17585,"_23966":47313,"_2399":47379},[],"`true`.",{"_2872":2006,"_25347":1983,"_17690":47381,"_5":17585,"_23966":47313,"_2399":47382},[],"`subject_key_id_signer`",{"_2872":2007,"_25347":1983,"_17690":47384,"_5":17585,"_23966":47313,"_2399":47385},[],"Configuration field initialized with the CA’s SKI.",{"_2872":2008,"_25347":1983,"_17690":47387,"_5":17585,"_23966":47313,"_2399":47388},[],"CA SKI.",{"_2872":2009,"_25347":1983,"_17690":47390,"_5":17585,"_23966":47313,"_2399":47391},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2872":2010,"_25347":1983,"_17690":47393,"_5":17585,"_23966":47313,"_2399":47394},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2872":2011,"_25347":1983,"_17690":47396,"_5":17585,"_23966":47317,"_2399":47397},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2872":2012,"_25347":1983,"_17690":47399,"_5":17585,"_23966":47317,"_2399":47400},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2872":2013,"_25347":1983,"_17690":47402,"_5":17585,"_23966":47317,"_2399":47403},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2872":2014,"_25347":1983,"_17690":47405,"_5":17585,"_23966":47321,"_2399":47406},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2872":2015,"_25347":1983,"_17690":47408,"_5":17585,"_23966":47321,"_2399":47409},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2872":2016,"_25347":1983,"_17690":47411,"_5":17585,"_23966":47325,"_2399":47412},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2872":2017,"_25347":1983,"_17690":47414,"_5":17585,"_23966":47325,"_2399":47415},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2872":2018,"_25347":1983,"_17690":47417,"_5":17585,"_23966":47325,"_2399":47418},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2872":2019,"_25347":1983,"_17690":47420,"_5":17585,"_23966":47325,"_2399":47421},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2872":2020,"_25347":1983,"_17690":47423,"_5":17585,"_23966":47325,"_2399":47424},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2872":2021,"_25347":1983,"_17690":47426,"_5":17585,"_23966":47329,"_2399":47427},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2872":2022,"_25347":1983,"_17690":47429,"_5":17585,"_23966":47329,"_2399":44218},[],{"_2872":2023,"_25347":1983,"_17690":47431,"_5":17585,"_23966":47329,"_2399":47432},[],"Relative path",{"_2872":2024,"_25347":1983,"_17690":47434,"_5":17585,"_23966":47329,"_2399":44215},[],{"_2872":2025,"_25347":1983,"_17690":47436,"_5":17585,"_23966":47329,"_2399":47437},[],"`GET`",{"_2872":2026,"_25347":1983,"_17690":47439,"_5":17585,"_23966":47329,"_2399":47440},[],"`/v1/roles/{ca-ski}`",{"_2872":2027,"_25347":1983,"_17690":47442,"_5":17585,"_23966":47329,"_2399":47443},[],"Read `crl_options` and `latest_crl`.",{"_2872":2028,"_25347":1983,"_17690":47445,"_5":17585,"_23966":47329,"_2399":47446},[],"`PUT`",{"_2872":2029,"_25347":1983,"_17690":47448,"_5":17585,"_23966":47329,"_2399":47440},[],{"_2872":2030,"_25347":1983,"_17690":47450,"_5":17585,"_23966":47329,"_2399":47451},[],"Replace CRL configuration.",{"_2872":2031,"_25347":1983,"_17690":47453,"_5":17585,"_23966":47329,"_2399":47454},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2872":2032,"_25347":1983,"_17690":47456,"_5":17585,"_23966":47329,"_2399":47457},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2872":2033,"_25347":1983,"_17690":47459,"_5":17585,"_23966":47333,"_2399":47460},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2872":2034,"_25347":1983,"_17690":47462,"_5":17585,"_23966":47337,"_2399":47463},[],"RFC 5280: X.509 and CRL profile.",{"_2872":2035,"_25347":1983,"_17690":47465,"_5":17585,"_23966":47337,"_2399":47466},[],"OpenSSL: openssl-crl.",{"_2872":2036,"_25347":1983,"_17690":47468,"_5":17585,"_23966":47337,"_2399":47469},[],"OpenSSL: openssl-verify.",{"_2872":2037,"_25347":1983,"_17690":47471,"_5":17585,"_23966":47337,"_2399":47472},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2872":2038,"_25347":1983,"_17690":47474,"_5":17585,"_23966":47337,"_2399":47475},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2872":2039,"_25347":2039,"_5":12438,"_2399":47477,"_25683":47478,"_17690":47479,"_23966":2039},"Keys and cryptographic engines",[41104,42497,46175,46176],[],{"_2872":2040,"_25347":2039,"_17690":47481,"_5":17585,"_23966":2039,"_2399":47482},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2872":2041,"_25347":2039,"_5":25680,"_17690":47484,"_23966":47485,"_2399":47486},[],"/docs/pr-preview/pr-42/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2872":2042,"_25347":2039,"_5":25680,"_17690":47488,"_23966":47489,"_2399":47490},[],"/docs/pr-preview/pr-42/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2872":2043,"_25347":2039,"_5":25680,"_17690":47492,"_23966":47493,"_2399":47494},[],"/docs/pr-preview/pr-42/platform/pki/key-management#file-system","File System",{"_2872":2044,"_25347":2039,"_5":25680,"_17690":47496,"_23966":47497,"_2399":47498},[],"/docs/pr-preview/pr-42/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2872":2045,"_25347":2039,"_5":25680,"_17690":47500,"_23966":47501,"_2399":47502},[],"/docs/pr-preview/pr-42/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2872":2046,"_25347":2039,"_5":25680,"_17690":47504,"_23966":47505,"_2399":47506},[],"/docs/pr-preview/pr-42/platform/pki/key-management#aws-kms","AWS KMS",{"_2872":2047,"_25347":2039,"_5":25680,"_17690":47508,"_23966":47509,"_2399":47510},[],"/docs/pr-preview/pr-42/platform/pki/key-management#pkcs11","PKCS#11",{"_2872":2048,"_25347":2039,"_5":25680,"_17690":47512,"_23966":47513,"_2399":47514},[],"/docs/pr-preview/pr-42/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2872":2049,"_25347":2039,"_5":25680,"_17690":47516,"_23966":47517,"_2399":47518},[],"/docs/pr-preview/pr-42/platform/pki/key-management#key-inventory","Key inventory",{"_2872":2050,"_25347":2039,"_5":25680,"_17690":47520,"_23966":47521,"_2399":47522},[],"/docs/pr-preview/pr-42/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2872":2051,"_25347":2039,"_5":25680,"_17690":47524,"_23966":47525,"_2399":47526},[],"/docs/pr-preview/pr-42/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2872":2052,"_25347":2039,"_5":25680,"_17690":47528,"_23966":47529,"_2399":47530},[],"/docs/pr-preview/pr-42/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2872":2053,"_25347":2039,"_5":25680,"_17690":47532,"_23966":47533,"_2399":47534},[],"/docs/pr-preview/pr-42/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2872":2054,"_25347":2039,"_5":25680,"_17690":47536,"_23966":47537,"_2399":47538},[],"/docs/pr-preview/pr-42/platform/pki/key-management#view-details","View details",{"_2872":2055,"_25347":2039,"_5":25680,"_17690":47540,"_23966":47541,"_2399":47542},[],"/docs/pr-preview/pr-42/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2872":2056,"_25347":2039,"_5":25680,"_17690":47544,"_23966":47545,"_2399":47546},[],"/docs/pr-preview/pr-42/platform/pki/key-management#sign","Sign",{"_2872":2057,"_25347":2039,"_5":25680,"_17690":47548,"_23966":47549,"_2399":47550},[],"/docs/pr-preview/pr-42/platform/pki/key-management#verify","Verify",{"_2872":2058,"_25347":2039,"_5":25680,"_17690":47552,"_23966":47553,"_2399":47554},[],"/docs/pr-preview/pr-42/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2872":2059,"_25347":2039,"_5":25680,"_17690":47556,"_23966":47557,"_2399":47558},[],"/docs/pr-preview/pr-42/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2872":2060,"_25347":2039,"_5":25680,"_17690":47560,"_23966":47561,"_2399":47562},[],"/docs/pr-preview/pr-42/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2872":2061,"_25347":2039,"_17690":47564,"_5":17585,"_23966":2039,"_2399":47565},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2872":2062,"_25347":2039,"_17690":47567,"_5":17585,"_23966":2039,"_2399":47568},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2872":2063,"_25347":2039,"_17690":47570,"_5":17585,"_23966":47485,"_2399":47571},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2872":2064,"_25347":2039,"_17690":47573,"_5":17585,"_23966":47485,"_2399":47574},[],"In practice, it lets you:",{"_2872":2065,"_25347":2039,"_17690":47576,"_5":17585,"_23966":47485,"_2399":47577},[],"Generate new key pairs from Lamassu IoT.",{"_2872":2066,"_25347":2039,"_17690":47579,"_5":17585,"_23966":47485,"_2399":47580},[],"Import keys created externally.",{"_2872":2067,"_25347":2039,"_17690":47582,"_5":17585,"_23966":47485,"_2399":47583},[],"Delegate custody and cryptographic operations to external engines.",{"_2872":2068,"_25347":2039,"_17690":47585,"_5":17585,"_23966":47485,"_2399":47586},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2872":2069,"_25347":2039,"_17690":47588,"_5":17585,"_23966":47489,"_2399":47589},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2872":2070,"_25347":2039,"_17690":47591,"_5":17585,"_23966":47489,"_2399":47592},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2872":2071,"_25347":2039,"_17690":47594,"_5":17585,"_23966":47489,"_2399":47595},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2872":2072,"_25347":2039,"_17690":47597,"_5":17585,"_23966":47493,"_2399":47598},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2872":2073,"_25347":2039,"_17690":47600,"_5":17585,"_23966":47497,"_2399":47601},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2872":2074,"_25347":2039,"_17690":47603,"_5":17585,"_23966":47501,"_2399":47604},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2872":2075,"_25347":2039,"_17690":47606,"_5":17585,"_23966":47505,"_2399":47607},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2872":2076,"_25347":2039,"_17690":47609,"_5":17585,"_23966":47509,"_2399":47610},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2872":2077,"_25347":2039,"_17690":47612,"_5":17585,"_23966":47513,"_2399":47613},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2872":2078,"_25347":2039,"_17690":47615,"_5":17585,"_23966":47513,"_2399":47616},[],"Lamassu shows the enabled engines in the console.",{"_2872":2079,"_25347":2039,"_17690":47618,"_5":17585,"_23966":47513,"_2399":47619},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2872":2080,"_25347":2039,"_17690":47621,"_5":17585,"_23966":47513,"_2399":47622},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2872":2081,"_25347":2039,"_17690":47624,"_5":17585,"_23966":47517,"_2399":47625},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2872":2082,"_25347":2039,"_17690":47627,"_5":17585,"_23966":47517,"_2399":47628},[],"The table includes the following fields:",{"_2872":2083,"_25347":2039,"_17690":47630,"_5":17585,"_23966":47517,"_2399":47631},[],"**Name**: descriptive name of the key.",{"_2872":2084,"_25347":2039,"_17690":47633,"_5":17585,"_23966":47517,"_2399":47634},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2872":2085,"_25347":2039,"_17690":47636,"_5":17585,"_23966":47517,"_2399":47637},[],"**Strength**: visual indicator of cryptographic strength.",{"_2872":2086,"_25347":2039,"_17690":47639,"_5":17585,"_23966":47517,"_2399":47640},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2872":2087,"_25347":2039,"_17690":47642,"_5":17585,"_23966":47517,"_2399":47643},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2872":2088,"_25347":2039,"_17690":47645,"_5":17585,"_23966":47517,"_2399":47646},[],"**Aliases**: alternative names associated with the key.",{"_2872":2089,"_25347":2039,"_17690":47648,"_5":17585,"_23966":47517,"_2399":47649},[],"**Tags**: labels for classification and search.",{"_2872":2090,"_25347":2039,"_17690":47651,"_5":17585,"_23966":47517,"_2399":47652},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2872":2091,"_25347":2039,"_17690":47654,"_5":17585,"_23966":47517,"_2399":47655},[],"From this view you also reach the most common actions:",{"_2872":2092,"_25347":2039,"_17690":47657,"_5":17585,"_23966":47517,"_2399":47658},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2872":2093,"_25347":2039,"_17690":47660,"_5":17585,"_23966":47517,"_2399":47661},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2872":2094,"_25347":2039,"_17690":47663,"_5":17585,"_23966":47517,"_2399":47664},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2872":2095,"_25347":2039,"_17690":47666,"_5":17585,"_23966":47517,"_2399":47667},[],"**Delete Key** to remove the key from the system.",{"_2872":2096,"_25347":2039,"_17690":47669,"_5":17585,"_23966":47521,"_2399":47670},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2872":2097,"_25347":2039,"_17690":47672,"_5":17585,"_23966":47525,"_2399":47673},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2872":2098,"_25347":2039,"_17690":47675,"_5":17585,"_23966":47525,"_2399":47676},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2872":2099,"_25347":2039,"_17690":47678,"_5":17585,"_23966":47525,"_2399":47679},[],"**Key Name**: unique and descriptive name.",{"_2872":2100,"_25347":2039,"_17690":47681,"_5":17585,"_23966":47525,"_2399":47682},[],"**Crypto Engine**: engine that will keep the key.",{"_2872":2101,"_25347":2039,"_17690":47684,"_5":17585,"_23966":47525,"_2399":47685},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2872":2102,"_25347":2039,"_17690":47687,"_5":17585,"_23966":47525,"_2399":47688},[],"**Tags**: metadata to classify the key.",{"_2872":2103,"_25347":2039,"_17690":47690,"_5":17585,"_23966":47525,"_2399":47691},[],"**Metadata**: additional information for advanced uses.",{"_2872":2104,"_25347":2039,"_17690":47693,"_5":17585,"_23966":47529,"_2399":47694},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2872":2105,"_25347":2039,"_17690":47696,"_5":17585,"_23966":47529,"_2399":47697},[],"When you have an exportable private key and the destination engine supports import.",{"_2872":2106,"_25347":2039,"_17690":47699,"_5":17585,"_23966":47529,"_2399":47700},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2872":2107,"_25347":2039,"_17690":47702,"_5":17585,"_23966":47529,"_2399":47703},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2872":2108,"_25347":2039,"_17690":47705,"_5":17585,"_23966":47529,"_2399":47706},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2872":2109,"_25347":2039,"_17690":47708,"_5":17585,"_23966":47529,"_2399":47709},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2872":2110,"_25347":2039,"_17690":47711,"_5":17585,"_23966":47529,"_2399":47712},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2872":2111,"_25347":2039,"_17690":47714,"_5":17585,"_23966":47529,"_2399":47715},[],"**Tags**: labels for organization and search.",{"_2872":2112,"_25347":2039,"_17690":47717,"_5":17585,"_23966":47529,"_2399":47718},[],"**Metadata**: additional optional information.",{"_2872":2113,"_25347":2039,"_17690":47720,"_5":17585,"_23966":47529,"_2399":47721},[],"**Private Key (PEM)**: private key in PEM format.",{"_2872":2114,"_25347":2039,"_17690":47723,"_5":17585,"_23966":47529,"_2399":47724},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2872":2115,"_25347":2039,"_17690":47726,"_5":17585,"_23966":47533,"_2399":47727},[],"Each registered key has a detail view and several operational actions.",{"_2872":2116,"_25347":2039,"_17690":47729,"_5":17585,"_23966":47537,"_2399":47730},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2872":2117,"_25347":2039,"_17690":47732,"_5":17585,"_23966":47537,"_2399":47733},[],"The **Overview** tab shows, among others, these fields:",{"_2872":2118,"_25347":2039,"_17690":47735,"_5":17585,"_23966":47537,"_2399":47736},[],"**Key Name**: descriptive name.",{"_2872":2119,"_25347":2039,"_17690":47738,"_5":17585,"_23966":47537,"_2399":47739},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2872":2120,"_25347":2039,"_17690":47741,"_5":17585,"_23966":47537,"_2399":47742},[],"**Tags**: associated labels.",{"_2872":2121,"_25347":2039,"_17690":47744,"_5":17585,"_23966":47537,"_2399":47745},[],"**Aliases**: alternative names.",{"_2872":2122,"_25347":2039,"_17690":47747,"_5":17585,"_23966":47537,"_2399":47748},[],"**Crypto Engine**: engine where the key resides.",{"_2872":2123,"_25347":2039,"_17690":47750,"_5":17585,"_23966":47537,"_2399":47751},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2872":2124,"_25347":2039,"_17690":47753,"_5":17585,"_23966":47537,"_2399":47754},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2872":2125,"_25347":2039,"_17690":47756,"_5":17585,"_23966":47537,"_2399":47757},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2872":2126,"_25347":2039,"_17690":47759,"_5":17585,"_23966":47541,"_2399":47760},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2872":2127,"_25347":2039,"_17690":47762,"_5":17585,"_23966":47541,"_2399":47763},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2872":2128,"_25347":2039,"_17690":47765,"_5":17585,"_23966":47541,"_2399":47766},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2872":2129,"_25347":2039,"_17690":47768,"_5":17585,"_23966":47545,"_2399":47769},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2872":2130,"_25347":2039,"_17690":47771,"_5":17585,"_23966":47545,"_2399":47772},[],"Main fields:",{"_2872":2131,"_25347":2039,"_17690":47774,"_5":17585,"_23966":47545,"_2399":47775},[],"**Algorithm**: signing algorithm available for the key type.",{"_2872":2132,"_25347":2039,"_17690":47777,"_5":17585,"_23966":47545,"_2399":47778},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2872":2133,"_25347":2039,"_17690":47780,"_5":17585,"_23966":47545,"_2399":47781},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2872":2134,"_25347":2039,"_17690":47783,"_5":17585,"_23966":47545,"_2399":47784},[],"**Message**: content to sign.",{"_2872":2135,"_25347":2039,"_17690":47786,"_5":17585,"_23966":47545,"_2399":47787},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2872":2136,"_25347":2039,"_17690":47789,"_5":17585,"_23966":47549,"_2399":47790},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2872":2137,"_25347":2039,"_17690":47792,"_5":17585,"_23966":47549,"_2399":47772},[],{"_2872":2138,"_25347":2039,"_17690":47794,"_5":17585,"_23966":47549,"_2399":47795},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2872":2139,"_25347":2039,"_17690":47797,"_5":17585,"_23966":47549,"_2399":47798},[],"**Message Type**: `Raw` or `Digest`.",{"_2872":2140,"_25347":2039,"_17690":47800,"_5":17585,"_23966":47549,"_2399":47801},[],"**Payload Encoding**: encoding of the message.",{"_2872":2141,"_25347":2039,"_17690":47803,"_5":17585,"_23966":47549,"_2399":47804},[],"**Message**: original message or hash.",{"_2872":2142,"_25347":2039,"_17690":47806,"_5":17585,"_23966":47549,"_2399":47807},[],"**Signature**: signature to check.",{"_2872":2143,"_25347":2039,"_17690":47809,"_5":17585,"_23966":47549,"_2399":47810},[],"**Result**: indicator of the validation result.",{"_2872":2144,"_25347":2039,"_17690":47812,"_5":17585,"_23966":47553,"_2399":47813},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2872":2145,"_25347":2039,"_17690":47815,"_5":17585,"_23966":47553,"_2399":47816},[],"This flow is useful for:",{"_2872":2146,"_25347":2039,"_17690":47818,"_5":17585,"_23966":47553,"_2399":47819},[],"Requesting certificates from an external CA.",{"_2872":2147,"_25347":2039,"_17690":47821,"_5":17585,"_23966":47553,"_2399":47822},[],"Renewing an identity while keeping the same key.",{"_2872":2148,"_25347":2039,"_17690":47824,"_5":17585,"_23966":47553,"_2399":47825},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2872":2149,"_25347":2039,"_17690":47827,"_5":17585,"_23966":47553,"_2399":47828},[],"**Common Name (CN)**: main name of the identity.",{"_2872":2150,"_25347":2039,"_17690":47830,"_5":17585,"_23966":47553,"_2399":47831},[],"**Organization (O)**: organization or company.",{"_2872":2151,"_25347":2039,"_17690":47833,"_5":17585,"_23966":47553,"_2399":47834},[],"**Organizational Unit (OU)**: department or unit.",{"_2872":2152,"_25347":2039,"_17690":47836,"_5":17585,"_23966":47553,"_2399":47837},[],"**Country (C)**: two-letter country code.",{"_2872":2153,"_25347":2039,"_17690":47839,"_5":17585,"_23966":47553,"_2399":47840},[],"**State / Province (ST)**: state or province.",{"_2872":2154,"_25347":2039,"_17690":47842,"_5":17585,"_23966":47553,"_2399":47843},[],"**Locality (L)**: city or locality.",{"_2872":2155,"_25347":2039,"_17690":47845,"_5":17585,"_23966":47553,"_2399":47846},[],"**Email Address**: contact email.",{"_2872":2156,"_25347":2039,"_17690":47848,"_5":17585,"_23966":47553,"_2399":47849},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2872":2157,"_25347":2039,"_17690":47851,"_5":17585,"_23966":47553,"_2399":47852},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2872":2158,"_25347":2039,"_17690":47854,"_5":17585,"_23966":47557,"_2399":47855},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2872":2159,"_25347":2039,"_17690":47857,"_5":17585,"_23966":47557,"_2399":47858},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2872":2160,"_25347":2039,"_17690":47860,"_5":17585,"_23966":47561,"_2399":47861},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2872":2161,"_25347":2161,"_5":12438,"_2399":47863,"_25683":47864,"_17690":47865,"_23966":2161},"Online validation with OCSP",[41104,42497,46175,46792],[],{"_2872":2162,"_25347":2161,"_17690":47867,"_5":17585,"_23966":2161,"_2399":47868},[],"Query signed status and verify the responder’s response.",{"_2872":2163,"_25347":2161,"_5":25680,"_17690":47870,"_23966":47871,"_2399":47872},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2872":2164,"_25347":2161,"_5":25680,"_17690":47874,"_23966":47875,"_2399":47876},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2872":2165,"_25347":2161,"_5":25680,"_17690":47878,"_23966":47879,"_2399":47880},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2872":2166,"_25347":2161,"_5":25680,"_17690":47882,"_23966":47883,"_2399":47884},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2872":2167,"_25347":2161,"_5":25680,"_17690":47886,"_23966":47887,"_2399":47888},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2872":2168,"_25347":2161,"_5":25680,"_17690":47890,"_23966":47891,"_2399":47338},[],"/docs/pr-preview/pr-42/platform/pki/ocsp#references",{"_2872":2169,"_25347":2161,"_17690":47893,"_5":17585,"_23966":2161,"_2399":47894},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2872":2170,"_25347":2161,"_17690":47896,"_5":17585,"_23966":47871,"_2399":47897},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2872":2171,"_25347":2161,"_17690":47899,"_5":17585,"_23966":47871,"_2399":47900},[],"Record status",{"_2872":2172,"_25347":2161,"_17690":47902,"_5":17585,"_23966":47871,"_2399":47903},[],"Signed response",{"_2872":2173,"_25347":2161,"_17690":47905,"_5":17585,"_23966":47871,"_2399":45353},[],{"_2872":2174,"_25347":2161,"_17690":47907,"_5":17585,"_23966":47871,"_2399":47908},[],"`Good`.",{"_2872":2175,"_25347":2161,"_17690":47910,"_5":17585,"_23966":47871,"_2399":45370},[],{"_2872":2176,"_25347":2161,"_17690":47912,"_5":17585,"_23966":47871,"_2399":47913},[],"`Revoked`, with revocation reason and timestamp.",{"_2872":2177,"_25347":2161,"_17690":47915,"_5":17585,"_23966":47871,"_2399":47916},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2872":2178,"_25347":2161,"_17690":47918,"_5":17585,"_23966":47871,"_2399":47919},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2872":2179,"_25347":2161,"_17690":47921,"_5":17585,"_23966":47871,"_2399":47922},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2872":2180,"_25347":2161,"_17690":47924,"_5":17585,"_23966":47871,"_2399":47925},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2872":2181,"_25347":2161,"_17690":47927,"_5":17585,"_23966":47871,"_2399":47928},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2872":2182,"_25347":2161,"_17690":47930,"_5":17585,"_23966":47875,"_2399":47931},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2872":2183,"_25347":2161,"_17690":47933,"_5":17585,"_23966":47875,"_2399":47934},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2872":2184,"_25347":2161,"_17690":47936,"_5":17585,"_23966":47879,"_2399":47937},[],"The service accepts:",{"_2872":2185,"_25347":2161,"_17690":47939,"_5":17585,"_23966":47879,"_2399":44218},[],{"_2872":2186,"_25347":2161,"_17690":47941,"_5":17585,"_23966":47879,"_2399":47942},[],"VA service path",{"_2872":2187,"_25347":2161,"_17690":47944,"_5":17585,"_23966":47879,"_2399":47945},[],"Format",{"_2872":2188,"_25347":2161,"_17690":47947,"_5":17585,"_23966":47879,"_2399":47948},[],"`POST`",{"_2872":2189,"_25347":2161,"_17690":47950,"_5":17585,"_23966":47879,"_2399":47951},[],"`/ocsp`",{"_2872":2190,"_25347":2161,"_17690":47953,"_5":17585,"_23966":47879,"_2399":47954},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2872":2191,"_25347":2161,"_17690":47956,"_5":17585,"_23966":47879,"_2399":47437},[],{"_2872":2192,"_25347":2161,"_17690":47958,"_5":17585,"_23966":47879,"_2399":47959},[],"`/ocsp/{ocsp_request}`",{"_2872":2193,"_25347":2161,"_17690":47961,"_5":17585,"_23966":47879,"_2399":47962},[],"DER request encoded using padded URL Base64.",{"_2872":2194,"_25347":2161,"_17690":47964,"_5":17585,"_23966":47879,"_2399":47965},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2872":2195,"_25347":2161,"_17690":47967,"_5":17585,"_23966":47883,"_2399":47968},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2872":2196,"_25347":2161,"_17690":47970,"_5":17585,"_23966":47883,"_2399":47971},[],"Generate the request:",{"_2872":2197,"_25347":2161,"_17690":47973,"_5":17585,"_23966":47883,"_2399":47974},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2872":2198,"_25347":2161,"_17690":47976,"_5":17585,"_23966":47883,"_2399":47977},[],"Replace the example URL with the inspected endpoint:",{"_2872":2199,"_25347":2161,"_17690":47979,"_5":17585,"_23966":47883,"_2399":47980},[],"Verify the returned DER:",{"_2872":2200,"_25347":2161,"_17690":47982,"_5":17585,"_23966":47883,"_2399":47983},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2872":2201,"_25347":2161,"_17690":47985,"_5":17585,"_23966":47887,"_2399":47986},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2872":2202,"_25347":2161,"_17690":47988,"_5":17585,"_23966":47887,"_2399":47989},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2872":2203,"_25347":2161,"_17690":47991,"_5":17585,"_23966":47891,"_2399":47992},[],"RFC 6960: OCSP.",{"_2872":2204,"_25347":2161,"_17690":47994,"_5":17585,"_23966":47891,"_2399":47995},[],"OpenSSL: openssl-ocsp.",{"_2872":2205,"_25347":2161,"_17690":47997,"_5":17585,"_23966":47891,"_2399":47998},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2872":2206,"_25347":2161,"_17690":48000,"_5":17585,"_23966":47891,"_2399":47475},[],{"_2872":2207,"_25347":2207,"_5":12438,"_2399":46175,"_25683":48002,"_17690":48003,"_23966":2207},[41104,42497,46175],[],{"_2872":2208,"_25347":2207,"_17690":48005,"_5":17585,"_23966":2207,"_2399":48006},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2872":2209,"_25347":2207,"_5":25680,"_17690":48008,"_23966":48009,"_2399":45485},[],"/docs/pr-preview/pr-42/platform/pki/overview#start-here",{"_2872":2210,"_25347":2207,"_5":25680,"_17690":48011,"_23966":48012,"_2399":48013},[],"/docs/pr-preview/pr-42/platform/pki/overview#what-you-need","What you need",{"_2872":2211,"_25347":2207,"_5":25680,"_17690":48015,"_23966":48016,"_2399":46019},[],"/docs/pr-preview/pr-42/platform/pki/overview#core-capabilities",{"_2872":2212,"_25347":2207,"_5":25680,"_17690":48018,"_23966":48019,"_2399":46023},[],"/docs/pr-preview/pr-42/platform/pki/overview#build-your-trust-hierarchy",{"_2872":2213,"_25347":2207,"_5":25680,"_17690":48021,"_23966":48022,"_2399":46027},[],"/docs/pr-preview/pr-42/platform/pki/overview#protect-cryptographic-keys",{"_2872":2214,"_25347":2207,"_5":25680,"_17690":48024,"_23966":48025,"_2399":46031},[],"/docs/pr-preview/pr-42/platform/pki/overview#issue-and-control-certificates",{"_2872":2215,"_25347":2207,"_5":25680,"_17690":48027,"_23966":48028,"_2399":46039},[],"/docs/pr-preview/pr-42/platform/pki/overview#publish-validation-status",{"_2872":2216,"_25347":2207,"_5":25680,"_17690":48030,"_23966":48031,"_2399":48032},[],"/docs/pr-preview/pr-42/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2872":2217,"_25347":2207,"_5":25680,"_17690":48034,"_23966":48035,"_2399":46959},[],"/docs/pr-preview/pr-42/platform/pki/overview#continue",{"_2872":2218,"_25347":2207,"_17690":48037,"_5":17585,"_23966":2207,"_2399":48038},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2872":2219,"_25347":2207,"_17690":48040,"_5":17585,"_23966":48009,"_2399":48041},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2872":2220,"_25347":2207,"_17690":48043,"_5":17585,"_23966":48009,"_2399":48044},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2872":2221,"_25347":2207,"_17690":48046,"_5":17585,"_23966":48012,"_2399":48047},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2872":2222,"_25347":2207,"_17690":48049,"_5":17585,"_23966":48012,"_2399":48050},[],"An available cryptographic engine to keep the authority's key.",{"_2872":2223,"_25347":2207,"_17690":48052,"_5":17585,"_23966":48012,"_2399":48053},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2872":2224,"_25347":2207,"_17690":48055,"_5":17585,"_23966":48012,"_2399":48056},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2872":2225,"_25347":2207,"_17690":48058,"_5":17585,"_23966":48012,"_2399":48059},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2872":2226,"_25347":2207,"_17690":48061,"_5":17585,"_23966":48019,"_2399":48062},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2872":2227,"_25347":2207,"_17690":48064,"_5":17585,"_23966":48022,"_2399":48065},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2872":2228,"_25347":2207,"_17690":48067,"_5":17585,"_23966":48025,"_2399":48068},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2872":2229,"_25347":2207,"_17690":48070,"_5":17585,"_23966":48028,"_2399":48071},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2872":2230,"_25347":2207,"_17690":48073,"_5":17585,"_23966":48031,"_2399":48074},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2872":2231,"_25347":2207,"_17690":48076,"_5":17585,"_23966":48031,"_2399":48077},[],"its subject and extensions identify the expected client;",{"_2872":2232,"_25347":2207,"_17690":48079,"_5":17585,"_23966":48031,"_2399":48080},[],"its public key matches the client's private key;",{"_2872":2233,"_25347":2207,"_17690":48082,"_5":17585,"_23966":48031,"_2399":48083},[],"its chain reaches a root trusted by the consumer;",{"_2872":2234,"_25347":2207,"_17690":48085,"_5":17585,"_23966":48031,"_2399":48086},[],"its dates and usages allow the operation;",{"_2872":2235,"_25347":2207,"_17690":48088,"_5":17585,"_23966":48031,"_2399":48089},[],"the consumer applies revocation checks and authorization.",{"_2872":2236,"_25347":2207,"_17690":48091,"_5":17585,"_23966":48031,"_2399":48092},[],"The issuance path includes the first independent checks.",{"_2872":2237,"_25347":2207,"_17690":48094,"_5":17585,"_23966":48035,"_2399":48095},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2872":2238,"_25347":2207,"_17690":48097,"_5":17585,"_23966":48035,"_2399":48098},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2872":2239,"_25347":2207,"_17690":48100,"_5":17585,"_23966":48035,"_2399":48101},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2872":2240,"_25347":2240,"_5":12438,"_2399":48103,"_25683":48104,"_17690":48105,"_23966":2240},"Create your first CA",[41104,42497,46175,45610],[],{"_2872":2241,"_25347":2240,"_17690":48107,"_5":17585,"_23966":2240,"_2399":48108},[],"Create an evaluation root and check its certificate before issuing.",{"_2872":2242,"_25347":2240,"_5":25680,"_17690":48110,"_23966":48111,"_2399":41114},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2872":2243,"_25347":2240,"_5":25680,"_17690":48113,"_23966":48114,"_2399":48115},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2872":2244,"_25347":2240,"_5":25680,"_17690":48117,"_23966":48118,"_2399":48119},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2872":2245,"_25347":2240,"_5":25680,"_17690":48121,"_23966":48122,"_2399":48123},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2872":2246,"_25347":2240,"_5":25680,"_17690":48125,"_23966":48126,"_2399":48127},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2872":2247,"_25347":2240,"_5":25680,"_17690":48129,"_23966":48130,"_2399":48131},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2872":2248,"_25347":2240,"_5":25680,"_17690":48133,"_23966":48134,"_2399":48135},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2872":2249,"_25347":2240,"_5":25680,"_17690":48137,"_23966":48138,"_2399":45868},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2872":2250,"_25347":2240,"_5":25680,"_17690":48140,"_23966":48141,"_2399":41138},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2872":2251,"_25347":2240,"_17690":48143,"_5":17585,"_23966":2240,"_2399":48144},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2872":2252,"_25347":2240,"_17690":48146,"_5":17585,"_23966":48111,"_2399":48147},[],"Console access and permission to create keys and authorities.",{"_2872":2253,"_25347":2240,"_17690":48149,"_5":17585,"_23966":48111,"_2399":48150},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2872":2254,"_25347":2240,"_17690":48152,"_5":17585,"_23966":48111,"_2399":48153},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2872":2255,"_25347":2240,"_17690":48155,"_5":17585,"_23966":48111,"_2399":48156},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2872":2256,"_25347":2240,"_17690":48158,"_5":17585,"_23966":48114,"_2399":48159},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2872":2257,"_25347":2240,"_17690":48161,"_5":17585,"_23966":48114,"_2399":48162},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2872":2258,"_25347":2240,"_17690":48164,"_5":17585,"_23966":48118,"_2399":48165},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2872":2259,"_25347":2240,"_17690":48167,"_5":17585,"_23966":48118,"_2399":48168},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2872":2260,"_25347":2240,"_17690":48170,"_5":17585,"_23966":48122,"_2399":48171},[],"Select **Root CA** and complete:",{"_2872":2261,"_25347":2240,"_17690":48173,"_5":17585,"_23966":48122,"_2399":48174},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2872":2262,"_25347":2240,"_17690":48176,"_5":17585,"_23966":48122,"_2399":48177},[],"**Subject**: organization and country details for your evaluation.",{"_2872":2263,"_25347":2240,"_17690":48179,"_5":17585,"_23966":48122,"_2399":48180},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2872":2264,"_25347":2240,"_17690":48182,"_5":17585,"_23966":48122,"_2399":48183},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2872":2265,"_25347":2240,"_17690":48185,"_5":17585,"_23966":48122,"_2399":48186},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2872":2266,"_25347":2240,"_17690":48188,"_5":17585,"_23966":48126,"_2399":48189},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2872":2267,"_25347":2240,"_17690":48191,"_5":17585,"_23966":48130,"_2399":48192},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2872":2268,"_25347":2240,"_17690":48194,"_5":17585,"_23966":48130,"_2399":48195},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2872":2269,"_25347":2240,"_17690":48197,"_5":17585,"_23966":48134,"_2399":48198},[],"Run from the directory where you saved `ca.pem`:",{"_2872":2270,"_25347":2240,"_17690":48200,"_5":17585,"_23966":48134,"_2399":48201},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2872":2271,"_25347":2240,"_17690":48203,"_5":17585,"_23966":48134,"_2399":48204},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2872":2272,"_25347":2240,"_17690":48206,"_5":17585,"_23966":48138,"_2399":48207},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2872":2273,"_25347":2240,"_17690":48209,"_5":17585,"_23966":48138,"_2399":48210},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2872":2274,"_25347":2240,"_17690":48212,"_5":17585,"_23966":48138,"_2399":48213},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2872":2275,"_25347":2240,"_17690":48215,"_5":17585,"_23966":48138,"_2399":48216},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2872":2276,"_25347":2240,"_17690":48218,"_5":17585,"_23966":48141,"_2399":48219},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2872":2277,"_25347":2277,"_5":12438,"_2399":48221,"_25683":48222,"_17690":48223,"_23966":2277},"Issue and verify a certificate",[41104,42497,46175,45610],[],{"_2872":2278,"_25347":2277,"_17690":48225,"_5":17585,"_23966":2277,"_2399":48226},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2872":2279,"_25347":2277,"_5":25680,"_17690":48228,"_23966":48229,"_2399":41114},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2872":2280,"_25347":2277,"_5":25680,"_17690":48231,"_23966":48232,"_2399":48233},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2872":2281,"_25347":2277,"_5":25680,"_17690":48235,"_23966":48236,"_2399":48237},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2872":2282,"_25347":2277,"_5":25680,"_17690":48239,"_23966":48240,"_2399":48241},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2872":2283,"_25347":2277,"_5":25680,"_17690":48243,"_23966":48244,"_2399":48245},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2872":2284,"_25347":2277,"_5":25680,"_17690":48247,"_23966":48248,"_2399":48249},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2872":2285,"_25347":2277,"_5":25680,"_17690":48251,"_23966":48252,"_2399":48131},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2872":2286,"_25347":2277,"_5":25680,"_17690":48254,"_23966":48255,"_2399":48256},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2872":2287,"_25347":2277,"_5":25680,"_17690":48258,"_23966":48259,"_2399":48260},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2872":2288,"_25347":2277,"_5":25680,"_17690":48262,"_23966":48263,"_2399":48264},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2872":2289,"_25347":2277,"_5":25680,"_17690":48266,"_23966":48267,"_2399":45868},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2872":2290,"_25347":2277,"_5":25680,"_17690":48269,"_23966":48270,"_2399":41138},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/issue-certificate#next-step",{"_2872":2291,"_25347":2277,"_17690":48272,"_5":17585,"_23966":2277,"_2399":48273},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2872":2292,"_25347":2277,"_17690":48275,"_5":17585,"_23966":48229,"_2399":48276},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2872":2293,"_25347":2277,"_17690":48278,"_5":17585,"_23966":48229,"_2399":48279},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2872":2294,"_25347":2277,"_17690":48281,"_5":17585,"_23966":48229,"_2399":48282},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2872":2295,"_25347":2277,"_17690":48284,"_5":17585,"_23966":48229,"_2399":48285},[],"A client identifier: here we use `device-001`.",{"_2872":2296,"_25347":2277,"_17690":48287,"_5":17585,"_23966":48229,"_2399":48288},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2872":2297,"_25347":2277,"_17690":48290,"_5":17585,"_23966":48232,"_2399":48291},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2872":2298,"_25347":2277,"_17690":48293,"_5":17585,"_23966":48236,"_2399":48294},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2872":2299,"_25347":2277,"_17690":48296,"_5":17585,"_23966":48236,"_2399":48297},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2872":2300,"_25347":2277,"_17690":48299,"_5":17585,"_23966":48240,"_2399":48300},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2872":2301,"_25347":2277,"_17690":48302,"_5":17585,"_23966":48240,"_2399":48303},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2872":2302,"_25347":2277,"_17690":48305,"_5":17585,"_23966":48244,"_2399":48306},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2872":2303,"_25347":2277,"_17690":48308,"_5":17585,"_23966":48244,"_2399":48309},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2872":2304,"_25347":2277,"_17690":48311,"_5":17585,"_23966":48248,"_2399":48312},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2872":2305,"_25347":2277,"_17690":48314,"_5":17585,"_23966":48252,"_2399":48315},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2872":2306,"_25347":2277,"_17690":48317,"_5":17585,"_23966":48255,"_2399":48318},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2872":2307,"_25347":2277,"_17690":48320,"_5":17585,"_23966":48259,"_2399":48321},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2872":2308,"_25347":2277,"_17690":48323,"_5":17585,"_23966":48259,"_2399":48324},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2872":2309,"_25347":2277,"_17690":48326,"_5":17585,"_23966":48259,"_2399":48327},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2872":2310,"_25347":2277,"_17690":48329,"_5":17585,"_23966":48263,"_2399":48330},[],"In Bash, compare the two public-key digests:",{"_2872":2311,"_25347":2277,"_17690":48332,"_5":17585,"_23966":48263,"_2399":48333},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2872":2312,"_25347":2277,"_17690":48335,"_5":17585,"_23966":48263,"_2399":48336},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2872":2313,"_25347":2277,"_17690":48338,"_5":17585,"_23966":48267,"_2399":45952},[],{"_2872":2314,"_25347":2277,"_17690":48340,"_5":17585,"_23966":48267,"_2399":48341},[],"What to review",{"_2872":2315,"_25347":2277,"_17690":48343,"_5":17585,"_23966":48267,"_2399":48344},[],"The CA rejects issuance",{"_2872":2316,"_25347":2277,"_17690":48346,"_5":17585,"_23966":48267,"_2399":48347},[],"Permissions, CA state and key, algorithm and profile.",{"_2872":2317,"_25347":2277,"_17690":48349,"_5":17585,"_23966":48267,"_2399":48350},[],"Different subject or usages",{"_2872":2318,"_25347":2277,"_17690":48352,"_5":17585,"_23966":48267,"_2399":48353},[],"Applied profile and requested values.",{"_2872":2319,"_25347":2277,"_17690":48355,"_5":17585,"_23966":48267,"_2399":48356},[],"Issuer cannot be found",{"_2872":2320,"_25347":2277,"_17690":48358,"_5":17585,"_23966":48267,"_2399":48359},[],"Downloaded CA and required intermediate chain.",{"_2872":2321,"_25347":2277,"_17690":48361,"_5":17585,"_23966":48267,"_2399":48362},[],"Validity fails",{"_2872":2322,"_25347":2277,"_17690":48364,"_5":17585,"_23966":48267,"_2399":48365},[],"Certificate and CA dates, and the computer's clock.",{"_2872":2323,"_25347":2277,"_17690":48367,"_5":17585,"_23966":48267,"_2399":48368},[],"Public-key digests differ",{"_2872":2324,"_25347":2277,"_17690":48370,"_5":17585,"_23966":48267,"_2399":48371},[],"Certificate and key files from the same issuance.",{"_2872":2325,"_25347":2277,"_17690":48373,"_5":17585,"_23966":48267,"_2399":48374},[],"See PKI diagnostics to narrow an issuance failure.",{"_2872":2326,"_25347":2277,"_17690":48376,"_5":17585,"_23966":48270,"_2399":48377},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2872":2327,"_25347":2277,"_17690":48379,"_5":17585,"_23966":48270,"_2399":48380},[],"Manage certificates for inspection, status and revocation.",{"_2872":2328,"_25347":2277,"_17690":48382,"_5":17585,"_23966":48270,"_2399":48383},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2872":2329,"_25347":2277,"_17690":48385,"_5":17585,"_23966":48270,"_2399":48386},[],"Prepare EST for the device to request its next identities.",{"_2872":2330,"_25347":2277,"_17690":48388,"_5":17585,"_23966":48270,"_2399":48389},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2872":2331,"_25347":2331,"_5":12438,"_2399":48391,"_25683":48392,"_17690":48393,"_23966":2331},"PKI getting started",[41104,42497,46175,45610],[],{"_2872":2332,"_25347":2331,"_17690":48395,"_5":17585,"_23966":2331,"_2399":48396},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2872":2333,"_25347":2331,"_5":25680,"_17690":48398,"_23966":48399,"_2399":41114},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#before-you-begin",{"_2872":2334,"_25347":2331,"_5":25680,"_17690":48401,"_23966":48402,"_2399":48403},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2872":2335,"_25347":2331,"_5":25680,"_17690":48405,"_23966":48406,"_2399":45802},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#expected-result",{"_2872":2336,"_25347":2331,"_5":25680,"_17690":48408,"_23966":48409,"_2399":48410},[],"/docs/pr-preview/pr-42/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2872":2337,"_25347":2331,"_17690":48412,"_5":17585,"_23966":2331,"_2399":48413},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2872":2338,"_25347":2331,"_17690":48415,"_5":17585,"_23966":48399,"_2399":48416},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2872":2339,"_25347":2331,"_17690":48418,"_5":17585,"_23966":48399,"_2399":48419},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2872":2340,"_25347":2331,"_17690":48421,"_5":17585,"_23966":48399,"_2399":48422},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2872":2341,"_25347":2331,"_17690":48424,"_5":17585,"_23966":48399,"_2399":48425},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2872":2342,"_25347":2331,"_17690":48427,"_5":17585,"_23966":48399,"_2399":48428},[],"A working directory with restricted access for the downloaded key.",{"_2872":2343,"_25347":2331,"_17690":48430,"_5":17585,"_23966":48402,"_2399":48431},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2872":2344,"_25347":2331,"_17690":48433,"_5":17585,"_23966":48402,"_2399":48434},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2872":2345,"_25347":2331,"_17690":48436,"_5":17585,"_23966":48402,"_2399":48437},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2872":2346,"_25347":2331,"_17690":48439,"_5":17585,"_23966":48402,"_2399":48440},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2872":2347,"_25347":2331,"_17690":48442,"_5":17585,"_23966":48406,"_2399":48443},[],"File or resource",{"_2872":2348,"_25347":2331,"_17690":48445,"_5":17585,"_23966":48406,"_2399":45799},[],{"_2872":2349,"_25347":2331,"_17690":48447,"_5":17585,"_23966":48406,"_2399":48448},[],"Active root CA and `ca.pem`",{"_2872":2350,"_25347":2331,"_17690":48450,"_5":17585,"_23966":48406,"_2399":48451},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2872":2351,"_25347":2331,"_17690":48453,"_5":17585,"_23966":48406,"_2399":48454},[],"End-entity certificate and `device.crt`",{"_2872":2352,"_25347":2331,"_17690":48456,"_5":17585,"_23966":48406,"_2399":48457},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2872":2353,"_25347":2331,"_17690":48459,"_5":17585,"_23966":48406,"_2399":48460},[],"Private key `device.key`",{"_2872":2354,"_25347":2331,"_17690":48462,"_5":17585,"_23966":48406,"_2399":48463},[],"Its public key matches the one included in `device.crt`.",{"_2872":2355,"_25347":2331,"_17690":48465,"_5":17585,"_23966":48406,"_2399":48466},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2872":2356,"_25347":2331,"_17690":48468,"_5":17585,"_23966":48409,"_2399":48469},[],"To operate certificates, continue with Certificates and Validation.",{"_2872":2357,"_25347":2331,"_17690":48471,"_5":17585,"_23966":48409,"_2399":48472},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2872":2358,"_25347":2331,"_17690":48474,"_5":17585,"_23966":48409,"_2399":48475},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2872":2359,"_25347":2359,"_5":12438,"_2399":48477,"_25683":48478,"_17690":48479,"_23966":2359},"PKI troubleshooting",[41104,42497,46175,44996],[],{"_2872":2360,"_25347":2359,"_17690":48481,"_5":17585,"_23966":2359,"_2399":48482},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2872":2361,"_25347":2359,"_5":25680,"_17690":48484,"_23966":48485,"_2399":48486},[],"/docs/pr-preview/pr-42/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2872":2362,"_25347":2359,"_5":25680,"_17690":48488,"_23966":48489,"_2399":48490},[],"/docs/pr-preview/pr-42/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2872":2363,"_25347":2359,"_5":25680,"_17690":48492,"_23966":48493,"_2399":48494},[],"/docs/pr-preview/pr-42/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2872":2364,"_25347":2359,"_17690":48496,"_5":17585,"_23966":2359,"_2399":48497},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2872":2365,"_25347":2359,"_17690":48499,"_5":17585,"_23966":2359,"_2399":48500},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2872":2366,"_25347":2359,"_17690":48502,"_5":17585,"_23966":48485,"_2399":45799},[],{"_2872":2367,"_25347":2359,"_17690":48504,"_5":17585,"_23966":48485,"_2399":48505},[],"What to inspect",{"_2872":2368,"_25347":2359,"_17690":48507,"_5":17585,"_23966":48485,"_2399":41138},[],{"_2872":2369,"_25347":2359,"_17690":48509,"_5":17585,"_23966":48485,"_2399":48510},[],"CA",{"_2872":2370,"_25347":2359,"_17690":48512,"_5":17585,"_23966":48485,"_2399":48513},[],"Exists, is active and has usable dates.",{"_2872":2371,"_25347":2359,"_17690":48515,"_5":17585,"_23966":48485,"_2399":48516},[],"Authorities.",{"_2872":2372,"_25347":2359,"_17690":48518,"_5":17585,"_23966":48485,"_2399":48519},[],"Key",{"_2872":2373,"_25347":2359,"_17690":48521,"_5":17585,"_23966":48485,"_2399":48522},[],"The record has a usable private key and the engine can sign.",{"_2872":2374,"_25347":2359,"_17690":48524,"_5":17585,"_23966":48485,"_2399":48525},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2872":2375,"_25347":2359,"_17690":48527,"_5":17585,"_23966":48485,"_2399":48528},[],"CSR",{"_2872":2376,"_25347":2359,"_17690":48530,"_5":17585,"_23966":48485,"_2399":48531},[],"Correct PEM and verifiable signature.",{"_2872":2377,"_25347":2359,"_17690":48533,"_5":17585,"_23966":48485,"_2399":48534},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2872":2378,"_25347":2359,"_17690":48536,"_5":17585,"_23966":48485,"_2399":48537},[],"Profile",{"_2872":2379,"_25347":2359,"_17690":48539,"_5":17585,"_23966":48485,"_2399":48540},[],"Selected source, existing ID, allowed algorithm and size.",{"_2872":2380,"_25347":2359,"_17690":48542,"_5":17585,"_23966":48485,"_2399":48543},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2872":2381,"_25347":2359,"_17690":48545,"_5":17585,"_23966":48485,"_2399":45952},[],{"_2872":2382,"_25347":2359,"_17690":48547,"_5":17585,"_23966":48485,"_2399":48548},[],"Appropriate subject, SAN, usages and dates.",{"_2872":2383,"_25347":2359,"_17690":48550,"_5":17585,"_23966":48485,"_2399":48551},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2872":2384,"_25347":2359,"_17690":48553,"_5":17585,"_23966":48485,"_2399":48554},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2872":2385,"_25347":2359,"_17690":48556,"_5":17585,"_23966":48485,"_2399":48557},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2872":2386,"_25347":2359,"_17690":48559,"_5":17585,"_23966":48489,"_2399":48560},[],"Check each boundary independently:",{"_2872":2387,"_25347":2359,"_17690":48562,"_5":17585,"_23966":48489,"_2399":48563},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2872":2388,"_25347":2359,"_17690":48565,"_5":17585,"_23966":48489,"_2399":48566},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2872":2389,"_25347":2359,"_17690":48568,"_5":17585,"_23966":48489,"_2399":48569},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2872":2390,"_25347":2359,"_17690":48571,"_5":17585,"_23966":48489,"_2399":48572},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2872":2391,"_25347":2359,"_17690":48574,"_5":17585,"_23966":48489,"_2399":48575},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2872":2392,"_25347":2359,"_17690":48577,"_5":17585,"_23966":48489,"_2399":48578},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2872":2393,"_25347":2359,"_17690":48580,"_5":17585,"_23966":48493,"_2399":48581},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2872":2394,"_25347":2359,"_17690":48583,"_5":17585,"_23966":48493,"_2399":48584},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.","count","sorting",{"_48588":48589,"_48590":48591,"_48592":48593,"_48594":48595,"_15302":2421,"_58129":2421},"language","english","sortableProperties",[2399,25347,5,23966],"sortablePropertiesWithTypes",{"_2399":21095,"_25347":21095,"_5":21095,"_23966":21095},"sorts",{"_2399":48596,"_25347":50980,"_5":53363,"_23966":55746},{"_3852":48597,"_48598":48599,"_5":21095},{"_12183":15860,"_12526":8866,"_12533":3649,"_24528":13221,"_24079":6320,"_16804":3004,"_12204":3854,"_12211":4169,"_24474":6317,"_24840":3964,"_24861":14157,"_24503":6265,"_29151":4752,"_24872":12561,"_29156":25041,"_29159":20007,"_29162":3600,"_29165":17095,"_29168":2827,"_25194":3662,"_29173":2829,"_29175":7187,"_25242":5738,"_25184":17045,"_29179":2708,"_25210":17044,"_29183":7237,"_24890":6316,"_25189":6335,"_25260":2935,"_29188":3021,"_29190":9602,"_29192":2477,"_29194":3077,"_29196":9408,"_29198":2625,"_29200":3553,"_29202":4497,"_29204":11798,"_24541":4291,"_29207":3084,"_25405":2719,"_24535":2736,"_24916":14619,"_29212":5711,"_29214":14620,"_29217":14394,"_24571":9591,"_29221":9315,"_24465":10235,"_29224":9512,"_24508":5761,"_29227":6340,"_29229":2727,"_29232":16895,"_25237":2874,"_29235":4607,"_29237":16415,"_29240":2861,"_29242":4933,"_29244":3420,"_29246":4816,"_29248":3020,"_16807":4038,"_29251":3766,"_29253":3157,"_24481":2478,"_24884":6376,"_29257":3547,"_29259":2559,"_29261":21995,"_29263":5795,"_29265":4927,"_29267":6258,"_29269":3530,"_25343":5212,"_24932":3013,"_29273":4921,"_29275":19750,"_24519":4057,"_29278":5525,"_29280":6396,"_29282":2686,"_25265":3676,"_29285":9317,"_29287":3773,"_29289":16184,"_29291":9316,"_29293":3453,"_24617":2682,"_29298":2467,"_24878":7151,"_29301":5656,"_29303":2474