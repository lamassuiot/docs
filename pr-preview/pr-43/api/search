-preview/pr-43/platform/administration/access-control#changes-and-access-revocation","content":"Changes and access revocation"},"472":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-25","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/access-control#operational-checklist","content":"Operational checklist"},"473":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-26","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/access-control#diagnostics","content":"Diagnostics"},"474":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-27","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-401","content":"The response is 401"},"475":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-28","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-403","content":"The response is 403"},"476":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-29","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/access-control#everything-returns-403","content":"Everything returns 403"},"477":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-30","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/access-control#access-appears-without-a-policy-grant","content":"Access appears without a policy grant"},"478":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-31","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/access-control#everything-fails-when-authz-is-unavailable","content":"Everything fails when authz is unavailable"},"479":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-32","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control","content":"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**."},"480":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-33","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control","content":"Lamassu does not assign permissions directly to users. The full chain is:"},"481":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-34","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control","content":"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider."},"482":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-35","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#essential-concepts","content":"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled."},"483":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-36","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#essential-concepts","content":"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both."},"484":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-37","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#essential-concepts","content":"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute."},"485":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-38","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#essential-concepts","content":"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter."},"486":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-39","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#essential-concepts","content":"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals."},"487":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-40","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#essential-concepts","content":"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions."},"488":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-41","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#two-decision-systems","content":"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way."},"489":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-42","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#two-decision-systems","content":"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries."},"490":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-43","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","content":"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema."},"491":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-44","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","content":"The decision is made **before forwarding the request to the service**:"},"492":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-45","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","content":"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS."},"493":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-46","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","content":"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`."},"494":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-47","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","content":"`authz` extracts the credential and resolves all active principals matching it."},"495":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-48","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","content":"It separately loads the policies granted to each principal."},"496":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-49","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","content":"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`."},"497":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-50","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","content":"`authz` looks for an HTTP rule granting that action."},"498":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-51","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","content":"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values."},"499":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-52","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","content":"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway."},"500":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-53","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","content":"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context."},"501":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-54","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","content":"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it."},"502":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-55","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"Two schema-level settings cover endpoints that policies do not mention:"},"503":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-56","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request."},"504":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-57","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal."},"505":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-58","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:"},"506":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-59","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`."},"507":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-60","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides."},"508":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-61","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load."},"509":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-62","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","content":"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service."},"510":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-63","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","content":"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others."},"511":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-64","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","content":"The decision is made with the domain operation context:"},"512":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-65","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","content":"The middleware extracts the credential and resolves the matching principals."},"513":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-66","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","content":"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource."},"514":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-67","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","content":"`authz` gathers the entity rules of the granted policies."},"515":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-68","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","content":"The engine evaluates direct grants, attribute filters and relations with other entities."},"516":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-69","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","content":"For an individual operation, it checks that the concrete resource satisfies the computed scope."},"517":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-70","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","content":"For a listing, it generates a SQL filter that the service adds to its own query."},"518":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-71","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","content":"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**."},"519":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-72","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","content":"Actions fall into two groups:"},"520":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-73","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","content":"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples."},"521":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-74","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","content":"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations."},"522":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-75","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","content":"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface."},"523":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-76","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#how-the-two-paths-relate","content":"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services."},"524":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-77","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#how-the-two-paths-relate","content":"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity."},"525":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-78","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#how-the-two-paths-relate","content":"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes."},"526":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-79","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#oidc-principals","content":"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens."},"527":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-80","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#oidc-principals","content":"The following principal represents any identity holding the `pki-operators` role in Keycloak:"},"528":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-81","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#oidc-principals","content":"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time."},"529":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-82","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#oidc-principals","content":"The implemented operators are:"},"530":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-83","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#oidc-principals","content":"`equals`, for exact equality;"},"531":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-84","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#oidc-principals","content":"`contains`, to check membership in a list or the presence of text in a scalar value."},"532":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-85","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#oidc-principals","content":"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's."},"533":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-86","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#oidc-principals","content":"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`."},"534":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-87","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#x509-principals","content":"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name."},"535":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-88","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#x509-principals","content":"The available modes are:"},"536":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-89","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#x509-principals","content":"`serial_and_ca`: an exact certificate, identified by serial number and CA;"},"537":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-90","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#x509-principals","content":"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;"},"538":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-91","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#x509-principals","content":"`any_from_ca`: any certificate issued directly by the given CA."},"539":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-92","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#x509-principals","content":"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:"},"540":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-93","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#x509-principals","content":"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA."},"541":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-94","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#x509-principals","content":"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs."},"542":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-95","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#when-several-principals-match","content":"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function."},"543":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-96","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#when-several-principals-match","content":"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them."},"544":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-97","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#when-several-principals-match","content":"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another."},"545":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-98","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#when-several-principals-match","content":"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive."},"546":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-99","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#global-and-direct-access","content":"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations."},"547":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-100","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#global-and-direct-access","content":"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible."},"548":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-101","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#access-inherited-through-relations","content":"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources."},"549":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-102","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#access-inherited-through-relations","content":"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy."},"550":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-103","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#attribute-filtered-access","content":"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND."},"551":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-104","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#attribute-filtered-access","content":"For example, this rule allows reading active certificates issued by a specific CA:"},"552":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-105","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#attribute-filtered-access","content":"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values."},"553":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-106","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#http-rules","content":"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs."},"554":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-107","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#http-rules","content":"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`."},"555":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-108","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#http-rules","content":"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases."},"556":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-109","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#http-rules","content":"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:"},"557":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-110","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#http-rules","content":"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`."},"558":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-111","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#http-rules","content":"Note that:"},"559":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-112","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#http-rules","content":"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`."},"560":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-113","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#http-rules","content":"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied."},"561":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-114","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#http-rules","content":"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass."},"562":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-115","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#included-policies","content":"The `authz` preload installs reusable policies for the main domains. Among them are:"},"563":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-116","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#included-policies","content":"full and read-only access to certificates and authorities;"},"564":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-117","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#included-policies","content":"full and read-only access to the KMS;"},"565":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-118","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#included-policies","content":"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;"},"566":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-119","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#included-policies","content":"an `Auditor` policy with PKI read access and authorization visibility;"},"567":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-120","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#included-policies","content":"console access;"},"568":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-121","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#included-policies","content":"administration and observation policies for the Job Manager NBI and SBI APIs;"},"569":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-122","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#included-policies","content":"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains."},"570":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-123","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#included-policies","content":"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions."},"571":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-124","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#provision-the-first-administrator","content":"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform."},"572":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-125","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#provision-the-first-administrator","content":"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API."},"573":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-126","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#provision-the-first-administrator","content":"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades."},"574":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-127","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#prepare-the-identity-provider","content":"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`."},"575":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-128","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#configure-token-validation","content":"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`."},"576":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-129","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#configure-token-validation","content":"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0."},"577":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-130","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#install-and-verify-administrative-access","content":"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation."},"578":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-131","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#test-an-unprivileged-identity","content":"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations."},"579":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-132","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","content":"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work."},"580":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-133","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#fastlane-bootstrap","content":"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`."},"581":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-134","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#fastlane-bootstrap","content":"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design."},"582":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-135","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#design-least-privilege-roles","content":"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:"},"583":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-136","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#design-least-privilege-roles","content":"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group."},"584":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-137","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#design-least-privilege-roles","content":"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access."},"585":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-138","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#design-least-privilege-roles","content":"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration."},"586":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-139","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#design-least-privilege-roles","content":"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting."},"587":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-140","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#design-least-privilege-roles","content":"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls."},"588":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-141","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#design-least-privilege-roles","content":"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions."},"589":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-142","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#design-least-privilege-roles","content":"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade."},"590":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-143","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#changes-and-access-revocation","content":"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching."},"591":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-144","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#changes-and-access-revocation","content":"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider."},"592":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-145","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#changes-and-access-revocation","content":"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one."},"593":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-146","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#operational-checklist","content":"Keep `failOpen: false` unless a documented risk assessment justifies otherwise."},"594":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-147","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#operational-checklist","content":"Use groups or stable roles for people and independent identities for automations."},"595":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-148","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#operational-checklist","content":"Keep at least two recovery administrators and test their access periodically."},"596":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-149","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#operational-checklist","content":"Review active principals, their matches and their grants after IdP changes."},"597":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-150","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#operational-checklist","content":"Search for wildcards in policies before upgrading Lamassu."},"598":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-151","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#operational-checklist","content":"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service."},"599":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-152","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#operational-checklist","content":"Always test one allowed and one denied operation for each role."},"600":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-153","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#operational-checklist","content":"Correlate changes to principals, policies and grants with the audit logs."},"601":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-154","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-401","content":"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential."},"602":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-155","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-403","content":"The credential could be processed but did not produce a positive authorization. Review in this order:"},"603":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-156","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-403","content":"that an active principal of the correct type exists;"},"604":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-157","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-403","content":"that the claim paths and values match the real token exactly;"},"605":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-158","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-403","content":"that all of the principal's conditions hold;"},"606":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-159","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-403","content":"that the principal has the expected policy granted;"},"607":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-160","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-403","content":"that the policy includes the action and the requested resource type or route;"},"608":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-161","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-403","content":"that the identifier, relation, column filter or HTTP constraint includes the real resource."},"609":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-162","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-403","content":"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace."},"610":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-163","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#everything-returns-403","content":"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster."},"611":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-164","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#access-appears-without-a-policy-grant","content":"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants."},"612":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-165","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#everything-fails-when-authz-is-unavailable","content":"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision."},"613":{"id":"/docs/pr-preview/pr-43/platform/administration/access-control-166","page_id":"/docs/pr-preview/pr-43/platform/administration/access-control","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/access-control#everything-fails-when-authz-is-unavailable","content":"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment."},"614":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","type":"page","content":"Alerts and subscriptions","breadcrumbs":["Docs","Platform","Administration"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/alerts"},"615":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-0","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts","content":"Send PKI events to people and external systems."},"616":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-1","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/alerts#how-it-works","content":"How it works"},"617":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-2","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/alerts#available-channels","content":"Available channels"},"618":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-3","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/alerts#create-a-subscription","content":"Create a subscription"},"619":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-4","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/alerts#choose-the-event","content":"Choose the event"},"620":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-5","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-destination","content":"Configure the destination"},"621":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-6","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/alerts#limit-the-notifications","content":"Limit the notifications"},"622":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-7","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/alerts#review-and-activate","content":"Review and activate"},"623":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-8","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-webhook-http-client","content":"Configure the webhook HTTP client"},"624":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-9","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/alerts#webhook-delivery-rules","content":"Webhook delivery rules"},"625":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-10","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/alerts#manage-a-subscription","content":"Manage a subscription"},"626":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-11","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/alerts#event-families","content":"Event families"},"627":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-12","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts","content":"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes."},"628":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-13","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#how-it-works","content":"A service publishes a domain event."},"629":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-14","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#how-it-works","content":"Lamassu evaluates the subscriptions associated with that event type."},"630":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-15","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#how-it-works","content":"Each subscription's filter decides whether it should be notified."},"631":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-16","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#how-it-works","content":"Lamassu delivers the event to the configured channel."},"632":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-17","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#how-it-works","content":"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter."},"633":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-18","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#available-channels","content":"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup."},"634":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-19","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#available-channels","content":"**Microsoft Teams** posts the notification to a channel through its webhook URL."},"635":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-20","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#available-channels","content":"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`."},"636":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-21","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#available-channels","content":"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:"},"637":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-22","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#available-channels","content":"`apikey_options` requires `header` and `key`."},"638":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-23","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#available-channels","content":"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`."},"639":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-24","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#available-channels","content":"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key."},"640":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-25","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#available-channels","content":"The alerts API reference documents the full `http_client` schema."},"641":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-26","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#choose-the-event","content":"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on."},"642":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-27","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-destination","content":"Select Email, Microsoft Teams or Webhook and enter the channel details."},"643":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-28","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#limit-the-notifications","content":"Add a filter if you don't want to receive every instance of the event."},"644":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-29","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#limit-the-notifications","content":"**None** notifies all instances of the event."},"645":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-30","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#limit-the-notifications","content":"**JSON Path** evaluates one or more specific fields."},"646":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-31","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#limit-the-notifications","content":"**JSON Schema** accepts only payloads with a particular structure."},"647":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-32","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#limit-the-notifications","content":"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`."},"648":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-33","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#limit-the-notifications","content":"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity."},"649":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-34","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#review-and-activate","content":"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery."},"650":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-35","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-webhook-http-client","content":"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:"},"651":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-36","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-webhook-http-client","content":"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default."},"652":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-37","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-webhook-http-client","content":"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded)."},"653":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-38","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-webhook-http-client","content":"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified)."},"654":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-39","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-webhook-http-client","content":"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**."},"655":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-40","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-webhook-http-client","content":"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below)."},"656":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-41","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-webhook-http-client","content":"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths."},"657":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-42","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-webhook-http-client","content":"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details."},"658":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-43","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#webhook-delivery-rules","content":"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:"},"659":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-44","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#webhook-delivery-rules","content":"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery."},"660":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-45","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#webhook-delivery-rules","content":"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working."},"661":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-46","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#webhook-delivery-rules","content":"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected."},"662":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-47","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#webhook-delivery-rules","content":"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body."},"663":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-48","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#webhook-delivery-rules","content":"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive."},"664":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-49","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#webhook-delivery-rules","content":"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created."},"665":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-50","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#webhook-delivery-rules","content":"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises."},"666":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-51","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#manage-a-subscription","content":"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints."},"667":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-52","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#manage-a-subscription","content":"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout."},"668":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-53","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#event-families","content":"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`."},"669":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-54","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#event-families","content":"**Certificates:** `ca.sign.certificate` and `certificate.delete`."},"670":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-55","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#event-families","content":"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`."},"671":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-56","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#event-families","content":"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`."},"672":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-57","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#event-families","content":"**Devices:** `device.create`, `device.identity.update` and `device.status.update`."},"673":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-58","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#event-families","content":"**Validation:** `va.role.crl.create`."},"674":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-59","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#event-families","content":"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`."},"675":{"id":"/docs/pr-preview/pr-43/platform/administration/alerts-60","page_id":"/docs/pr-preview/pr-43/platform/administration/alerts","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/alerts#event-families","content":"Use the catalog shown in the console as the source for the types available in your deployed version."},"676":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","type":"page","content":"Audit logs","breadcrumbs":["Docs","Platform","Administration"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/audit-logs"},"677":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-0","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs","content":"Understand which audit events Lamassu generates and how to turn them into a durable trail."},"678":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-1","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#what-an-event-contains","content":"What an event contains"},"679":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-2","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#coverage","content":"Coverage"},"680":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-3","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","content":"Publication and persistence"},"681":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-4","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#sensitive-data","content":"Sensitive data"},"682":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-5","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#a-reproducible-investigation","content":"A reproducible investigation"},"683":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-6","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#bound-the-interval","content":"Bound the interval"},"684":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-7","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#identify-the-operation","content":"Identify the operation"},"685":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-8","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#attribute-the-principal","content":"Attribute the principal"},"686":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-9","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#compare-intent-and-result","content":"Compare intent and result"},"687":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-10","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#follow-the-effect","content":"Follow the effect"},"688":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-11","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#periodic-verification","content":"Periodic verification"},"689":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-12","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs","content":"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error."},"690":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-13","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#what-an-event-contains","content":"The audit body includes:"},"691":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-14","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#what-an-event-contains","content":"input: data received by the operation;"},"692":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-15","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#what-an-event-contains","content":"has\\_error: whether the service returned an error;"},"693":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-16","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#what-an-event-contains","content":"output: produced result or error message;"},"694":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-17","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#what-an-event-contains","content":"principals: identifiers of the principals that matched the request."},"695":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-18","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#what-an-event-contains","content":"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type."},"696":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-19","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#what-an-event-contains","content":"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes."},"697":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-20","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#coverage","content":"The backend applies auditing to mutations of:"},"698":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-21","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#coverage","content":"authorities, certificates and issuance profiles;"},"699":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-22","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#coverage","content":"keys and KMS engines;"},"700":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-23","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#coverage","content":"devices and identities;"},"701":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-24","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#coverage","content":"DMSs and enrollment operations;"},"702":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-25","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#coverage","content":"validation functions and CRL;"},"703":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-26","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#coverage","content":"principals, policies and authorization grants."},"704":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-27","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#coverage","content":"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation."},"705":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-28","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","content":"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file."},"706":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-29","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","content":"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization."},"707":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-30","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","content":"Design the consumer to:"},"708":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-31","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","content":"subscribe to the audit.# types and also to operation types ending in .error;"},"709":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-32","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","content":"keep the complete CloudEvent unmodified;"},"710":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-33","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","content":"record the ingestion time and detect duplicates by ID;"},"711":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-34","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","content":"encrypt in transit and at rest;"},"712":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-35","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","content":"restrict reading and deletion to a role separate from the PKI operator;"},"713":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-36","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","content":"apply an explicit retention and legal hold policy;"},"714":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-37","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","content":"alert if it stops consuming or the pending queue grows."},"715":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-38","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#sensitive-data","content":"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform."},"716":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-39","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#sensitive-data","content":"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution."},"717":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-40","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#bound-the-interval","content":"Start from the reported time and normalize every source to UTC."},"718":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-41","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#identify-the-operation","content":"Filter by event type, service source and resource identifier."},"719":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-42","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#attribute-the-principal","content":"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment."},"720":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-43","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#compare-intent-and-result","content":"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed."},"721":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-44","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#follow-the-effect","content":"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations."},"722":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-45","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#periodic-verification","content":"Generate a controlled mutation in a test environment and check that:"},"723":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-46","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#periodic-verification","content":"a successful audit event appears;"},"724":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-47","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#periodic-verification","content":"the principal matches the identity used;"},"725":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-48","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#periodic-verification","content":"the consumer persists it exactly once;"},"726":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-49","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#periodic-verification","content":"it can be retrieved by resource, actor and period;"},"727":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-50","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#periodic-verification","content":"a consumer outage raises an alert."},"728":{"id":"/docs/pr-preview/pr-43/platform/administration/audit-logs-51","page_id":"/docs/pr-preview/pr-43/platform/administration/audit-logs","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/administration/audit-logs#periodic-verification","content":"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved."},"729":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","type":"page","content":"Platform architecture","breadcrumbs":["Docs","Platform"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/concepts/architecture"},"730":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture-0","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/architecture","content":"Lamassu components and how control, keys, issuance and devices relate."},"731":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture-1","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/concepts/architecture#control-plane","content":"Control plane"},"732":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture-2","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/concepts/architecture#key-custody-and-cryptographic-operations","content":"Key custody and cryptographic operations"},"733":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture-3","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/concepts/architecture#issuance-and-enrollment","content":"Issuance and enrollment"},"734":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture-4","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/concepts/architecture#status-and-validation","content":"Status and validation"},"735":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture-5","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/concepts/architecture#platform-dependencies","content":"Platform dependencies"},"736":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture-6","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/architecture","content":"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load."},"737":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture-7","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/architecture","content":"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies."},"738":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture-8","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/architecture#control-plane","content":"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform."},"739":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture-9","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/architecture#key-custody-and-cryptographic-operations","content":"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation."},"740":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture-10","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/architecture#issuance-and-enrollment","content":"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity."},"741":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture-11","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/architecture#status-and-validation","content":"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate."},"742":{"id":"/docs/pr-preview/pr-43/platform/concepts/architecture-12","page_id":"/docs/pr-preview/pr-43/platform/concepts/architecture","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/architecture#platform-dependencies","content":"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes."},"743":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","type":"page","content":"How Lamassu works","breadcrumbs":["Docs","Platform"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/concepts/overview"},"744":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-0","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview","content":"The mental model of trust, keys, certificates and devices."},"745":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-1","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/concepts/overview#the-model-in-five-pieces","content":"The model in five pieces"},"746":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-2","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/concepts/overview#from-onboarding-to-operation","content":"From onboarding to operation"},"747":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-3","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview","content":"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle."},"748":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-4","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview#the-model-in-five-pieces","content":"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services."},"749":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-5","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview#the-model-in-five-pieces","content":"**Certification Authority (CA).** Signs certificates and establishes the chain of trust."},"750":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-6","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview#the-model-in-five-pieces","content":"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed."},"751":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-7","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview#the-model-in-five-pieces","content":"**Device.** Keeps its private key and presents the certificate to prove its identity."},"752":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-8","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview#the-model-in-five-pieces","content":"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL."},"753":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-9","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview#from-onboarding-to-operation","content":"An administrator configures a cryptographic engine and creates or imports a CA."},"754":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-10","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview#from-onboarding-to-operation","content":"A DMS relates that CA to an enrollment policy."},"755":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-11","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview#from-onboarding-to-operation","content":"The device generates a key and requests a certificate through EST, or an operator assigns it an identity."},"756":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-12","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview#from-onboarding-to-operation","content":"Lamassu keeps the inventory, history and status of the identity."},"757":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-13","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview#from-onboarding-to-operation","content":"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid."},"758":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-14","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview#from-onboarding-to-operation","content":"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />"},"759":{"id":"/docs/pr-preview/pr-43/platform/concepts/overview-15","page_id":"/docs/pr-preview/pr-43/platform/concepts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/concepts/overview#from-onboarding-to-operation","content":"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />"},"760":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","type":"page","content":"Devices and identities","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management"},"761":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-0","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","content":"Register, inspect and retire devices while checking their current identity and history."},"762":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-1","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"Device states"},"763":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#inspect-a-device","content":"Inspect a device"},"764":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#register-a-device-manually","content":"Register a device manually"},"765":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-4","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#create-the-device","content":"Create the device"},"766":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-5","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#define-its-membership","content":"Define its membership"},"767":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-6","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#classify-the-device","content":"Classify the device"},"768":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-7","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#verify-the-registration","content":"Verify the registration"},"769":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-8","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Assign an identity manually"},"770":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-9","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#revoke-the-current-identity","content":"Revoke the current identity"},"771":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-10","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#decommission-a-device","content":"Decommission a device"},"772":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-11","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#automate-enrollment","content":"Automate enrollment"},"773":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-12","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","content":"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create."},"774":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-13","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","content":"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device."},"775":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-14","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"Operational view"},"776":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-15","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"Meaning"},"777":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-16","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"**No Identity**"},"778":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-17","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"A record exists without an associated identity."},"779":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-18","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"**Active**"},"780":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-19","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"The slot is active; also check certificate dates, status and usages."},"781":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-20","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"**Renewal Pending**"},"782":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-21","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"The identity is in the operational renewal window."},"783":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-22","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"**Expiring Soon**"},"784":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-23","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"Expiration is approaching according to configured thresholds."},"785":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-24","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"**Expired**"},"786":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-25","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"The identity has expired."},"787":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-26","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"**Revoked**"},"788":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-27","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"The identity is marked revoked."},"789":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-28","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"**Decommissioned**"},"790":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-29","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"The record is retired and ordinary updates do not restore operation."},"791":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-30","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","content":"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance."},"792":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-31","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#inspect-a-device","content":"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial."},"793":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-32","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#inspect-a-device","content":"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version."},"794":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-33","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#inspect-a-device","content":"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates."},"795":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-34","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#inspect-a-device","content":"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment."},"796":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-35","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#register-a-device-manually","content":"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS."},"797":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-36","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#create-the-device","content":"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet."},"798":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-37","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#define-its-membership","content":"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS."},"799":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-38","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#classify-the-device","content":"Add model, environment or location tags and an icon according to your inventory."},"800":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-39","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#verify-the-registration","content":"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment."},"801":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-40","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#verify-the-registration","content":"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies."},"802":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-41","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#assign-an-identity-manually","content":"From **No Identity**, use **Assign Identity**:"},"803":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-42","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`."},"804":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-43","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#assign-an-identity-manually","content":"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first."},"805":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-44","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Confirm and read the serial, active version and history again."},"806":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-45","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Install the key/certificate pair and required intermediates on the device and test usage."},"807":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-46","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#assign-an-identity-manually","content":"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it."},"808":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-47","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#revoke-the-current-identity","content":"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide."},"809":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-48","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#revoke-the-current-identity","content":"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes."},"810":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-49","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#decommission-a-device","content":"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer."},"811":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-50","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#decommission-a-device","content":"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial."},"812":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-51","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#decommission-a-device","content":"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control."},"813":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-52","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#decommission-a-device","content":"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change."},"814":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-53","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#automate-enrollment","content":"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />"},"815":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management-54","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#automate-enrollment","content":"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />"},"816":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","type":"page","content":"Bootstrap identity and authentication","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity"},"817":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-0","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","content":"Prepare server trust and admission proofs for enroll and reenroll."},"818":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-1","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","content":"Initial server trust"},"819":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"Bootstrap credential"},"820":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","content":"Modes per operation"},"821":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-4","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"Webhook contract"},"822":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-5","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","content":"Revocation and checks"},"823":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-6","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","content":"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID."},"824":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-7","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","content":"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`."},"825":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-8","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","content":"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies."},"826":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-9","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service."},"827":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-10","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device."},"828":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-11","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","content":"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity."},"829":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-12","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","content":"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears."},"830":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-13","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","content":"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication."},"831":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-14","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide."},"832":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-15","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"Example body:"},"833":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-16","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy."},"834":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-17","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client."},"835":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-18","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"Continuation requires a successful HTTP response and JSON:"},"836":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-19","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","content":"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification."},"837":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-20","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","content":"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source."},"838":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity-21","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","content":"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client."},"839":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"page","content":"Configure and operate the DMS","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms"},"840":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-0","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","content":"Define registration, authentication per operation, issuance, renewal and distributed trust."},"841":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-1","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#before-you-begin","content":"Before you begin"},"842":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#configure-a-dms","content":"Configure a DMS"},"843":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#identify-the-fleet","content":"Identify the fleet"},"844":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-4","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","content":"Select the enrollment CA"},"845":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-5","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#configure-est","content":"Configure EST"},"846":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-6","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#distribute-trust","content":"Distribute trust"},"847":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-7","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#verify-the-endpoints","content":"Verify the endpoints"},"848":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-8","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-configuration","content":"Enrollment configuration"},"849":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-9","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"Enrollment Device Registration"},"850":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-10","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Enrollment Settings"},"851":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-11","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Authentication per operation"},"852":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-12","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"External webhook settings"},"853":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-13","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#issuance-profile","content":"Issuance profile"},"854":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-14","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Re-enrollment configuration"},"855":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-15","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#serverkeygen","content":"ServerKeyGen"},"856":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-16","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Trust distribution"},"857":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-17","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"Operate the DMS inventory"},"858":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-18","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#integrate-the-devices","content":"Integrate the devices"},"859":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-19","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","content":"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator."},"860":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-20","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#before-you-begin","content":"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement."},"861":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-21","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#before-you-begin","content":"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication."},"862":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-22","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#identify-the-fleet","content":"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS."},"863":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-23","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","content":"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity."},"864":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-24","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#configure-est","content":"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key."},"865":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-25","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#distribute-trust","content":"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation."},"866":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-26","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#verify-the-endpoints","content":"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance."},"867":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-27","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration."},"868":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-28","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-device-registration","content":"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode."},"869":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-29","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`settings.enrollment_settings` field"},"870":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-30","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Decision"},"871":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-31","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`protocol`"},"872":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-32","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`EST_RFC7030` for these operations."},"873":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-33","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enrollment_ca`"},"874":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-34","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"ID of the signing CA."},"875":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-35","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`verify_csr_signature`"},"876":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-36","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Keep `true` to verify CSR key possession."},"877":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-37","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`enable_replaceable_enrollment`"},"878":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-38","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic."},"879":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-39","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"`est_rfc7030_settings.auth_mode`"},"880":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-40","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"One of the four authentication modes."},"881":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-41","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes."},"882":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-42","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"The blocks are independent:"},"883":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-43","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`."},"884":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-44","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`."},"885":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-45","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`auth_mode`"},"886":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-46","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Control applied in the configured operation"},"887":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-47","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`CLIENT_CERTIFICATE`"},"888":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-48","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Presented certificate validation."},"889":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-49","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`EXTERNAL_WEBHOOK`"},"890":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-50","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Configured webhook authorization."},"891":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-51","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"892":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-52","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Certificate validation followed by webhook approval."},"893":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-53","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"`NO_AUTH`"},"894":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-54","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"No DMS requester authentication."},"895":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-55","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails."},"896":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-56","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path."},"897":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-57","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`."},"898":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-58","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","content":"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID."},"899":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-59","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:"},"900":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-60","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`external_webhook_settings` field"},"901":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-61","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Decision"},"902":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-62","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`url`"},"903":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-63","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed."},"904":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-64","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`method`"},"905":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-65","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`POST` or `PUT`; `POST` by default."},"906":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-66","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`name`"},"907":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-67","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Label used in service logs."},"908":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-68","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.auth_mode`"},"909":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-69","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`."},"910":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-70","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.log_level`"},"911":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-71","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default."},"912":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-72","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.apikey_options`"},"913":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-73","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `apikey`: `header` and `key`. Reserved header names are rejected."},"914":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-74","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.jwt_options`"},"915":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-75","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`."},"916":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-76","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.mtls_options`"},"917":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-77","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted."},"918":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-78","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.insecure_skip_verify`"},"919":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-79","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here."},"920":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-80","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"`config.call_timeout`"},"921":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-81","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Maximum duration of the authorization call (for example `10s`); 10 seconds by default."},"922":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-82","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Rules for that configuration:"},"923":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-83","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM."},"924":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-84","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected."},"925":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-85","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`."},"926":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-86","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped."},"927":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-87","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The authorization response must be JSON of at most 1 MiB; a larger body fails the call."},"928":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-88","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises."},"929":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-89","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it)."},"930":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-90","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist."},"931":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-91","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","content":"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`."},"932":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-92","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#issuance-profile","content":"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust."},"933":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-93","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`settings.reenrollment_settings` field"},"934":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-94","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Purpose"},"935":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-95","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`reenrollment_delta`"},"936":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-96","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Opens the window at the active certificate’s `NotAfter` minus this delta."},"937":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-97","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`preventive_delta`"},"938":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-98","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Preventive operational monitoring threshold."},"939":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-99","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`critical_delta`"},"940":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-100","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Critical operational monitoring threshold."},"941":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-101","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`enable_expired_renewal`"},"942":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-102","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself."},"943":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-103","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`est_rfc7030_settings.client_certificate_settings.validation_cas`"},"944":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-104","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew."},"945":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-105","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"`revoke_on_reenrollment`"},"946":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-106","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor."},"947":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-107","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","content":"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures."},"948":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-108","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#serverkeygen","content":"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference."},"949":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-109","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Option"},"950":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-110","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Published material"},"951":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-111","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Include Lamassu System CA**"},"952":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-112","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Available downstream TLS certificate; it can be a leaf, not an issuing CA."},"953":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-113","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Include Enrollment CA**"},"954":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-114","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Selected issuing CA certificate."},"955":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-115","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#trust-distribution","content":"**Managed CAs**"},"956":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-116","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#trust-distribution","content":"Explicitly selected CA certificates."},"957":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-117","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#trust-distribution","content":"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust."},"958":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-118","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included."},"959":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-119","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs."},"960":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-120","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","content":"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement."},"961":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms-121","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#integrate-the-devices","content":"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures."},"962":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","type":"page","content":"Integrate the EST client","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client"},"963":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-0","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","content":"Prepare trust, send a CSR and check the identity you receive."},"964":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-1","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Before you begin"},"965":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"Download and inspect cacerts"},"966":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"Prepare the CSR"},"967":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-4","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"Request the identity"},"968":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-5","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Check and install the result"},"969":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-6","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#next-steps","content":"Next steps"},"970":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-7","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","content":"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device."},"971":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-8","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools."},"972":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-9","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity."},"973":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-10","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#before-you-begin","content":"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name."},"974":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-11","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file."},"975":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-12","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","content":"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works."},"976":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-13","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject."},"977":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-14","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#prepare-the-csr","content":"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles."},"978":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-15","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:"},"979":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-16","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#request-the-identity","content":"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance."},"980":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-17","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"For a root that issues directly:"},"981":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-18","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation."},"982":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-19","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","content":"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete."},"983":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client-20","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#next-steps","content":"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures."},"984":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","type":"page","content":"EST reference","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference"},"985":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-0","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","content":"Look up Lamassu routes, formats, authentication and multipart responses."},"986":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-1","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Endpoint reference"},"987":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#cacerts","content":"cacerts"},"988":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"simpleenroll"},"989":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-4","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"simplereenroll"},"990":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-5","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"serverkeygen"},"991":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-6","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#response-format","content":"Response format"},"992":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-7","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Request and extraction"},"993":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-8","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"Compatibility notes"},"994":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-9","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","content":"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy."},"995":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-10","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route."},"996":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-11","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Operation"},"997":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-12","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Method"},"998":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-13","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Authentication and condition"},"999":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-14","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/cacerts`"},"1000":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-15","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"GET"},"1001":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-16","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply."},"1002":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-17","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/simpleenroll`"},"1003":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-18","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"1004":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-19","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Initial authentication and DMS registration/replacement policy."},"1005":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-20","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/simplereenroll`"},"1006":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-21","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"1007":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-22","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Renewal authentication, existing identity, subject, revocation and window."},"1008":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-23","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"`/serverkeygen`"},"1009":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-24","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"POST"},"1010":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-25","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"Initial authentication and admission; server generation enabled."},"1011":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-26","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","content":"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract."},"1012":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-27","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#cacerts","content":"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor."},"1013":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-28","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#cacerts","content":"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots."},"1014":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-29","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy."},"1015":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-30","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR."},"1016":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-31","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate."},"1017":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-32","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery."},"1018":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-33","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM."},"1019":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-34","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement."},"1020":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-35","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#response-format","content":"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:"},"1021":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-36","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#response-format","content":"Part"},"1022":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-37","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#response-format","content":"Content after decoding its Base64"},"1023":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-38","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#response-format","content":"`application/pkcs8`"},"1024":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-39","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#response-format","content":"Unencrypted DER PKCS#8 private key."},"1025":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-40","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#response-format","content":"`application/pkcs7-mime; smime-type=certs-only`"},"1026":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-41","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#response-format","content":"DER PKCS#7 containing the issued certificate."},"1027":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-42","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#response-format","content":"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers."},"1028":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-43","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key."},"1029":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-44","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:"},"1030":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-45","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Convert and check the result:"},"1031":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-46","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#request-and-extraction","content":"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser."},"1032":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-47","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting."},"1033":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference-48","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#compatibility-notes","content":"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client."},"1034":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","type":"page","content":"Enrollment with PKI","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview"},"1035":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-0","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","content":"Choose admission policy and connect DMS, initial trust and the EST client."},"1036":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-1","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#the-journey","content":"The journey"},"1037":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"For the administrator"},"1038":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"For the integrator"},"1039":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-4","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#contract-version","content":"Contract version"},"1040":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-5","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","content":"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer."},"1041":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-6","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#the-journey","content":"The administrator prepares the CA, issuance profile and DMS."},"1042":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-7","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#the-journey","content":"The integrator installs initial EST server trust and an admission credential."},"1043":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-8","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#the-journey","content":"The client requests an identity for its `Device ID` through EST."},"1044":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-9","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#the-journey","content":"Certificate, device binding and key/certificate installation are checked."},"1045":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-10","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#the-journey","content":"The consumer validates and authorizes the identity; the client schedules renewal and recovery."},"1046":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-11","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#the-journey","content":"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test."},"1047":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-12","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />"},"1048":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-13","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1049":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-14","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />"},"1050":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-15","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-administrator","content":"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />"},"1051":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-16","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />"},"1052":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-17","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />"},"1053":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-18","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />"},"1054":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-19","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-integrator","content":"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />"},"1055":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-20","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#contract-version","content":"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan."},"1056":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview-21","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#contract-version","content":"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations."},"1057":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","type":"page","content":"Provisioning strategies","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies"},"1058":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-0","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","content":"Choose device registration, identity authorization and key generation."},"1059":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-1","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Choose registration"},"1060":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"Preregistration and replacement"},"1061":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"Choose authentication"},"1062":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-4","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Choose custody"},"1063":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-5","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","content":"Check the decision"},"1064":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-6","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","content":"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself."},"1065":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-7","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Path"},"1066":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-8","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"When the device exists"},"1067":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-9","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"What to check"},"1068":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-10","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Manual assignment"},"1069":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-11","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"An operator creates it before associating a certificate."},"1070":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-12","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"ID, owning DMS, certificate CN and bound serial."},"1071":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-13","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"EST with `JITP`"},"1072":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-14","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Created for an unknown CN during `/simpleenroll`."},"1073":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-15","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Authorized credential, unused ID, profile, resulting registration and identity."},"1074":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-16","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"EST with `PRE_REGISTRATION`"},"1075":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-17","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Must exist before `/simpleenroll`."},"1076":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-18","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Approved record, same DMS and replacement conditions for your version."},"1077":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-19","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions."},"1078":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-20","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration."},"1079":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-21","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path."},"1080":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-22","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state."},"1081":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-23","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying."},"1082":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-24","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"Decide initial enrollment and re-enrollment separately:"},"1083":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-25","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**Client certificate:** useful when each device has an initial credential whose key it controls."},"1084":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-26","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID."},"1085":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-27","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**Certificate and webhook:** requires both controls in the configured operation."},"1086":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-28","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS."},"1087":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-29","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication."},"1088":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-30","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Option"},"1089":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-31","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Material crossing EST"},"1090":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-32","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Device-generated key"},"1091":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-33","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Public CSR and certificate; the key stays on the client."},"1092":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-34","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Existing device key"},"1093":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-35","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"CSR signed with that key and a new certificate."},"1094":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-36","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"ServerKeyGen"},"1095":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-37","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"Private PKCS#8 key and certificate in a TLS-protected multipart response."},"1096":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-38","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","content":"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material."},"1097":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-39","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","content":"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate."},"1098":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","type":"page","content":"Renewal and recovery","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery"},"1099":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-0","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","content":"Renew without losing the identity and recover devices according to their actual state."},"1100":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-1","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Prepare renewal"},"1101":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","content":"Request the successor certificate"},"1102":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"Install and check the new pair"},"1103":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-4","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Recover according to state"},"1104":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-5","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","content":"Continuous operation"},"1105":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-6","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","content":"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps."},"1106":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-7","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key."},"1107":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-8","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted."},"1108":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-9","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window."},"1109":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-10","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","content":"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one."},"1110":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-11","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","content":"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes."},"1111":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-12","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","content":"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results."},"1112":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-13","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key."},"1113":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-14","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption."},"1114":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-15","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","content":"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation."},"1115":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-16","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Situation"},"1116":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-17","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Procedure"},"1117":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-18","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Valid certificate, outside the window"},"1118":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-19","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Schedule the request within the window. Do not use `simpleenroll` to bypass it."},"1119":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-20","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Expired certificate, key available"},"1120":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-21","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply."},"1121":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-22","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Renewal through webhook or `NO_AUTH`"},"1122":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-23","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition."},"1123":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-24","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Lost or inaccessible key"},"1124":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-25","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity."},"1125":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-26","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Current identity revoked"},"1126":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-27","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it."},"1127":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-28","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Device without an identity"},"1128":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-29","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning."},"1129":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-30","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Retired device"},"1130":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-31","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent."},"1131":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-32","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Timeout, HTTP 500 or installation failure"},"1132":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-33","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","content":"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked."},"1133":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-34","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","content":"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed."},"1134":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery-35","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","content":"Continue with Trust distribution, Devices and identities and Troubleshooting."},"1135":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","type":"page","content":"Enrollment troubleshooting","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting"},"1136":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-0","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","content":"Locate transport, authentication, registration, issuance and installation failures."},"1137":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-1","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","content":"Diagnostics and compatibility"},"1138":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Error codes and diagnostics"},"1139":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes","content":"Compatibility notes"},"1140":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-4","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"EST enrollment fails"},"1141":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-5","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","content":"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report."},"1142":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-6","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result."},"1143":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-7","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Symptom or message"},"1144":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-8","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"What to check"},"1145":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-9","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"curl rejects TLS, name or issuer"},"1146":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-10","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification."},"1147":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-11","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"404 or missing APS"},"1148":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-12","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name."},"1149":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-13","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"400, CSR or format error"},"1150":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-14","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding."},"1151":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-15","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Missing credential or invalid certificate"},"1152":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-16","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA."},"1153":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-17","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Webhook denies, times out or responds without authorization"},"1154":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-18","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`."},"1155":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-19","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`unexpected status code: <n>: redirects are not followed`"},"1156":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-20","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed."},"1157":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-21","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`webhook response exceeds 1048576 bytes`"},"1158":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-22","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook."},"1159":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-23","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`webhook config must not reference files`"},"1160":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-24","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS."},"1161":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-25","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`mtls_options.cert_content must be base64-encoded PEM`"},"1162":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-26","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value."},"1163":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-27","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`webhook mTLS certificate and key are invalid: …`"},"1164":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-28","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call."},"1165":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-29","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"400 `struct validation error` creating or updating a DMS"},"1166":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-30","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS."},"1167":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-31","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"HTTP 500 with an `err` body on enroll or reenroll"},"1168":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-32","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there."},"1169":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-33","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`device not preregistered`"},"1170":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-34","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"PRE\\_REGISTRATION requires an existing inventory entry."},"1171":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-35","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`forbiddenNewEnrollment`"},"1172":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-36","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag."},"1173":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-37","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Different owning DMS"},"1174":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-38","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"CN/ID, global inventory and owning DMS; do not reuse an ID from another context."},"1175":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-39","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`invalid RawSubject bytes`"},"1176":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-40","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"CSR subject versus the current certificate. Preserve its attributes as well as its CN."},"1177":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-41","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"`invalid reenroll window`"},"1178":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-42","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window."},"1179":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-43","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Current certificate revoked"},"1180":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-44","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Renewal rejected; prepare authorized recovery according to the cause."},"1181":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-45","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"CA, profile or signing error"},"1182":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-46","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance."},"1183":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-47","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"HTTP 200 without a device connection"},"1184":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-48","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history."},"1185":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-49","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"Timeout or error after issuance"},"1186":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-50","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","content":"New certificates, current slot and previous identity's state before retrying."},"1187":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-51","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes","content":"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA."},"1188":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-52","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes","content":"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference."},"1189":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-53","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"Check HTTPS with the approved root and query cacerts for the correct APS."},"1190":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-54","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window."},"1191":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-55","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"Verify the CSR locally and relate its CN to the inventory."},"1192":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-56","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"Make one request, save headers/body and query the device and certificates."},"1193":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-57","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"If you receive an identity, check the key, subject, use and connection with the consumer."},"1194":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-58","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either."},"1195":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting-59","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","content":"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities."},"1196":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","type":"page","content":"Trust distribution and updates","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution"},"1197":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-0","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","content":"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates."},"1198":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-1","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Three trust relationships"},"1199":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","content":"What cacerts returns"},"1200":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Install the required material"},"1201":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-4","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","content":"Migrate trust"},"1202":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-5","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#check-the-update","content":"Check the update"},"1203":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-6","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","content":"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors."},"1204":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-7","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Relationship"},"1205":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-8","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Material prepared by its owner"},"1206":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-9","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Device → EST server"},"1207":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-10","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Previously verified server root, chain or pin and TLS name."},"1208":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-11","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"DMS → requester"},"1209":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-12","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"CAs and rules authorizing initial or renewal credentials."},"1210":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-13","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Consumer → device"},"1211":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-14","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Operational identity roots, intermediates, validation and permissions."},"1212":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-15","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","content":"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model."},"1213":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-16","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","content":"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration."},"1214":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-17","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","content":"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client."},"1215":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-18","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Keep initial EST server trust separate from identity consumer trust."},"1216":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-19","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Select policy-approved roots as anchors."},"1217":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-20","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Retain intermediates for chain building or presentation; do not automatically turn them into roots."},"1218":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-21","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent."},"1219":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-22","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Verify chain, dates, names, usages and revocation from the consumer."},"1220":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-23","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","content":"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose."},"1221":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-24","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","content":"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains."},"1222":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-25","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","content":"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured."},"1223":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-26","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","content":"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation."},"1224":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution-27","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#check-the-update","content":"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device."},"1225":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"page","content":"AWS IoT Core","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Integrations"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core"},"1226":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-0","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","content":"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven."},"1227":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-1","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","content":"Connector architecture"},"1228":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#prerequisites","content":"Prerequisites"},"1229":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","content":"Required IAM permissions"},"1230":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-4","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","content":"Configuration parameters"},"1231":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-5","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#resource-state-machine","content":"Resource state machine"},"1232":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-6","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#events-the-connector-handles","content":"Events the connector handles"},"1233":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-7","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","content":"CA registration states"},"1234":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-8","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","content":"DMS registration-mode states"},"1235":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-9","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"Certificate status states"},"1236":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-10","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","content":"Thing lifecycle"},"1237":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-11","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","content":"CA registration in AWS IoT Core"},"1238":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-12","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","content":"How to request registration"},"1239":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-13","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Primary Account"},"1240":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-14","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","content":"Secondary Account (SNI-only)"},"1241":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-15","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","content":"DMS configuration"},"1242":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-16","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#none-mode","content":"`none` mode"},"1243":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-17","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"`auto` mode"},"1244":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-18","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","content":"`jitp` mode"},"1245":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-19","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"Device provisioning (automatic mode)"},"1246":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-20","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"Device provisioning (JITP mode)"},"1247":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-21","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"Certificate status synchronization"},"1248":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-22","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"Forced disconnect on revocation"},"1249":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-23","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","content":"Device Shadow and automation"},"1250":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-24","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"What the connector writes to the shadow"},"1251":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-25","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","content":"AWS IoT policies"},"1252":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-26","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"Troubleshooting"},"1253":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-27","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","content":"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued."},"1254":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-28","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","content":"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode)."},"1255":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-29","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","content":"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode."},"1256":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-30","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","content":"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP."},"1257":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-31","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","content":"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load."},"1258":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-32","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","content":"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow."},"1259":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-33","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","content":"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions."},"1260":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-34","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#prerequisites","content":"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation."},"1261":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-35","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","content":"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:"},"1262":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-36","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","content":"IAM action"},"1263":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-37","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","content":"Purpose"},"1264":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-38","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","content":"`iot:GetRegistrationCode`"},"1265":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-39","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","content":"Obtain the verification code for CA registration in the Primary Account"},"1266":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-40","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[