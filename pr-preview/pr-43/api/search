/platform/pki/crl-70","page_id":"/docs/pr-preview/pr-43/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/crl#common-va-role-errors","content":"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required."},"2175":{"id":"/docs/pr-preview/pr-43/platform/pki/crl-71","page_id":"/docs/pr-preview/pr-43/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/crl#common-va-role-errors","content":"Update the client to send the new field."},"2176":{"id":"/docs/pr-preview/pr-43/platform/pki/crl-72","page_id":"/docs/pr-preview/pr-43/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/crl#common-va-role-errors","content":"The CRL does not change after revoking a certificate."},"2177":{"id":"/docs/pr-preview/pr-43/platform/pki/crl-73","page_id":"/docs/pr-preview/pr-43/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/crl#common-va-role-errors","content":"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer."},"2178":{"id":"/docs/pr-preview/pr-43/platform/pki/crl-74","page_id":"/docs/pr-preview/pr-43/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/crl#common-va-role-errors","content":"Check the VA logs and the failed-events queue; fix the signer."},"2179":{"id":"/docs/pr-preview/pr-43/platform/pki/crl-75","page_id":"/docs/pr-preview/pr-43/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/crl#common-va-role-errors","content":"A verifier rejects the CRL because of the issuer."},"2180":{"id":"/docs/pr-preview/pr-43/platform/pki/crl-76","page_id":"/docs/pr-preview/pr-43/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/crl#common-va-role-errors","content":"Several CAs share an SKI."},"2181":{"id":"/docs/pr-preview/pr-43/platform/pki/crl-77","page_id":"/doc