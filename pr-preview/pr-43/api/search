su` realm, frontend client, admin role and initial user"},"187":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane-109","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#what-the-script-configures","content":"installs RabbitMQ"},"188":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane-110","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#what-the-script-configures","content":"optionally installs observability and lab HSM components"},"189":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane-111","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#what-the-script-configures","content":"generates `lamassu.yaml` and installs the Lamassu chart"},"190":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane-112","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#what-the-script-configures","content":"optionally loads sample data"},"191":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane-113","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#what-the-script-configures","content":"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator."},"192":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane-114","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#tls-behavior","content":"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`."},"193":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane-115","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#tls-behavior","content":"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system."},"194":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane-116","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#credentials-and-generated-files","content":"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent."},"195":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane-117","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#credentials-and-generated-files","content":"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it."},"196":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane-118","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#credentials-and-generated-files","content":"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production."},"197":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane-119","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#verify-the-installation","content":"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway."},"198":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","type":"page","content":"Install with Helm","breadcrumbs":["Docs","Deployment","Kubernetes self-managed"],"tags":[],"url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm"},"199":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-0","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","content":"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment."},"200":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-1","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#install-lamassu-with-helm","content":"Install Lamassu with Helm"},"201":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-2","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin","content":"Before you begin"},"202":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-3","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","content":"1\\. Install the Gateway prerequisites"},"203":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-4","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#2-create-a-values-file","content":"2\\. Create a values file"},"204":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-5","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#tls-with-an-existing-secret","content":"TLS with an existing Secret"},"205":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-6","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#amqp-tls-amqps","content":"AMQP TLS (AMQPS)"},"206":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-7","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#provision-the-first-administrator","content":"Provision the first administrator"},"207":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-8","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#3-install-lamassu","content":"3\\. Install Lamassu"},"208":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-9","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#4-verify-the-deployment","content":"4\\. Verify the deployment"},"209":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-10","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#production-decisions","content":"Production decisions"},"210":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-11","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#install-lamassu-with-helm","content":"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane."},"211":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-12","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin","content":"Prepare the platform services that are deliberately outside the Lamassu chart:"},"212":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-13","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin","content":"a Kubernetes 1.24+ cluster and Helm 3.2+"},"213":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-14","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin","content":"a reachable PostgreSQL server and a role allowed to create databases and schemas"},"214":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-15","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin","content":"a reachable RabbitMQ broker and credentials"},"215":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-16","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin","content":"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu"},"216":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-17","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin","content":"Envoy Gateway 1.8+ and a `GatewayClass`"},"217":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-18","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin","content":"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret"},"218":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-19","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin","content":"a StorageClass and an external traffic design"},"219":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-20","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin","content":"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name."},"220":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-21","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin","content":"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`."},"221":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-22","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin","content":"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager."},"222":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-23","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","content":"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:"},"223":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-24","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","content":"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:"},"224":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-25","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","content":"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead."},"225":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-26","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#2-create-a-values-file","content":"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:"},"226":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-27","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#2-create-a-values-file","content":"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value."},"227":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-28","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#2-create-a-values-file","content":"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`."},"228":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-29","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#2-create-a-values-file","content":"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above."},"229":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-30","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#tls-with-an-existing-secret","content":"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret."},"230":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-31","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#amqp-tls-amqps","content":"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`."},"231":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-32","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#amqp-tls-amqps","content":"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`)."},"232":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-33","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#amqp-tls-amqps","content":"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`)."},"233":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-34","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#amqp-tls-amqps","content":"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set."},"234":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-35","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#amqp-tls-amqps","content":"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start."},"235":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-36","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#amqp-tls-amqps","content":"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout."},"236":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-37","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#amqp-tls-amqps","content":"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext."},"237":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-38","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#provision-the-first-administrator","content":"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu."},"238":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-39","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#provision-the-first-administrator","content":"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added."},"239":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-40","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#provision-the-first-administrator","content":"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI."},"240":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-41","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#provision-the-first-administrator","content":"See Access control for the principal and policy model."},"241":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-42","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#3-install-lamassu","content":"To install a local checkout instead:"},"242":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-43","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#4-verify-the-deployment","content":"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway."},"243":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-44","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#4-verify-the-deployment","content":"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response."},"244":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-45","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#production-decisions","content":"Before going live, review:"},"245":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-46","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#production-decisions","content":"backup and recovery for PostgreSQL and persistent volumes"},"246":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-47","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#production-decisions","content":"a production KMS engine; the default filesystem engine is not an HA design"},"247":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm-48","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/helm#production-decisions","content":"shared VA storage before increasing VA replicas"},"248":{"id":"/docs/pr-preview/p