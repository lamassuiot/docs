ons."},"1075":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","type":"page","content":"Provisioning strategies","breadcrumbs":["Docs","Platform","IoT Fleets","Devices and identities","Enrollment with PKI"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies"},"1076":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-0","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","content":"Choose device registration, identity authorization and key generation."},"1077":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-1","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","content":"Choose registration"},"1078":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","content":"Preregistration and replacement"},"1079":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","content":"Choose authentication"},"1080":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies-4","page_id":"/do