preview/pr-43/es/platform/pki/key-management#verify","content":"**Algorithm**: debe coincidir con el algoritmo usado para la firma."},"2220":{"id":"/docs/pr-preview/pr-43/es/platform/pki/key-management-100","page_id":"/docs/pr-preview/pr-43/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/key-management#verify","content":"**Message Type**: `Raw` o `Digest`."},"2221":{"id":"/docs/pr-preview/pr-43/es/platform/pki/key-management-101","page_id":"/docs/pr-preview/pr-43/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/key-management#verify","content":"**Payload Encoding**: codificación del mensaje."},"2222":{"id":"/docs/pr-preview/pr-43/es/platform/pki/key-management-102","page_id":"/docs/pr-preview/pr-43/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/key-management#verify","content":"**Message**: mensaje original o hash."},"2223":{"id":"/docs/pr-preview/pr-43/es/platform/pki/key-management-103","page_id":"/docs/pr-preview/pr-43/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/key-management#verify","content":"**Signature**: firma que se desea comprobar."},"2224":{"id":"/docs/pr-preview/pr-43/es/platform/pki/key-management-104","page_id":"/docs/pr-preview/pr-43/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/key-management#verify","content":"**Result**: indicador del resultado de la validación."},"2225":{"id":"/docs/pr-preview/pr-43/es/platform/pki/key-management-105","page_id":"/docs/pr-preview/pr-43/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/key-management#generar-un-csr","content":"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico."},"2226":{"id":"/d