-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","content":"APIs y configuración almacenada"},"2498":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-21","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","content":"Webhooks del DMS"},"2499":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-22","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","content":"Conjunto de confianza del reenrolamiento"},"2500":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-23","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","content":"Autenticación de reenrolamiento independiente"},"2501":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-24","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","content":"API de actualización del DMS"},"2502":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-25","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","content":"Valores de tipo de certificado"},"2503":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-26","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","content":"Eventos de dispositivo"},"2504":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-27","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","content":"Guía de migración con Helm"},"2505":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-28","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","content":"Paso 1: Prepara"},"2506":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-29","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","content":"Paso 2: Actualiza el archivo de values"},"2507":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-30","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","content":"Paso 3: Ejecuta la actualización"},"2508":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-31","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","content":"Paso 4: Migra los datos del KMS y la VA"},"2509":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-32","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","content":"Paso 5: Elimina los values de migración puntual"},"2510":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-33","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","content":"Despliegues sin Helm"},"2511":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-34","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas","content":"Solución de problemas"},"2512":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-35","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","content":"Checklist de validación"},"2513":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-36","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","content":"Elimina los volúmenes antiguos"},"2514":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-37","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","content":"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después."},"2515":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-38","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","content":"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:"},"2516":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-39","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","content":"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola."},"2517":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-40","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","content":"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer."},"2518":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-41","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","content":"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm."},"2519":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-42","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","content":"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos."},"2520":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-43","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","content":"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción."},"2521":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-44","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","content":"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`."},"2522":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-45","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","content":"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0."},"2523":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-46","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","content":"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas."},"2524":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-47","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","content":"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador."},"2525":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-48","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","content":"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera."},"2526":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-49","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","content":"La versión 4.0.0 del chart refuerza la seguridad:"},"2527":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-50","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","content":"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo."},"2528":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-51","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","content":"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada."},"2529":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-52","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","content":"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio."},"2530":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-53","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","content":"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread."},"2531":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-54","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","content":"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:"},"2532":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-55","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","content":"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm."},"2533":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-56","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","content":"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento."},"2534":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-57","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","content":"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas."},"2535":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-58","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","content":"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm."},"2536":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-59","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#breaking-changes","content":"Cambio"},"2537":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-60","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":