tion"},"1411":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-167","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","content":"AWS calls"},"1412":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-168","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","content":"`Unconfigured` → `None` / `Auto`"},"1413":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-169","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","content":"none (configuration only)"},"1414":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-170","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","content":"`None` ↔ `Auto`"},"1415":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-171","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","content":"none (configuration only)"},"1416":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-172","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","content":"Any → `Jitp`"},"1417":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-173","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","content":"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)"},"1418":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-174","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","content":"`Jitp` → `None` / `Auto`"},"1419":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-175","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","content":"none (the template stays in the AWS account)"},"1420":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-176","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:"},"1421":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-177","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"Transition"},"1422":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-178","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"AWS calls"},"1423":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-179","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"`NotSynced` → `Active`"},"1424":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-180","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"`iot:UpdateCertificate`"},"1425":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-181","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"`Active` → `Inactive`"},"1426":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-182","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"`iot:UpdateCertificate` + forced MQTT disconnect"},"1427":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-183","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"`Active` → `Revoked`"},"1428":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-184","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"`iot:UpdateCertificate` + forced MQTT disconnect"},"1429":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-185","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"`Inactive` / `Revoked` → `Active`"},"1430":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-186","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"`iot:UpdateCertificate`"},"1431":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-187","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"`RenewalWindow` / `AboutToExpire` / `Expired`"},"1432":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-188","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","content":"none (these states are not synced to AWS)"},"1433":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-189","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","content":"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:"},"1434":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-190","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","content":"Transition"},"1435":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-191","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","content":"AWS calls"},"1436":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-192","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","content":"`Absent` → `Provisioned`"},"1437":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-193","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","content":"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)"},"1438":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-194","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","content":"`Provisioned` → `Provisioned` (re-enrollment)"},"1439":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-195","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","content":"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata"},"1440":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-196","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","content":"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own."},"1441":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-197","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","content":"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field."},"1442":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-198","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","content":"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API."},"1443":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-199","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","content":"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes."},"1444":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-200","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:"},"1445":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-201","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"It calls `iot:GetRegistrationCode` to obtain AWS's verification code."},"1446":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-202","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS."},"1447":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-203","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`."},"1448":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-204","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step."},"1449":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-205","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#primary-account","content":"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`."},"1450":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-206","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","content":"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously."},"1451":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-207","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","content":"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS."},"1452":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-208","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","content":"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy."},"1453":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-209","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#none-mode","content":"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date."},"1454":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-210","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:"},"1455":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-211","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"Creates or updates the IoT policies configured in the DMS."},"1456":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-212","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent."},"1457":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-213","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate."},"1458":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-214","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies."},"1459":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-215","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager."},"1460":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-216","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#auto-mode","content":"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core."},"1461":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-217","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","content":"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it."},"1462":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-218","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","content":"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core."},"1463":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-219","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","content":"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped."},"1464":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-220","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","content":"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode."},"1465":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-221","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","content":"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode."},"1466":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-222","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step."},"1467":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-223","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"The full flow from the device's perspective is:"},"1468":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-224","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","content":"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN."},"1469":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-225","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection."},"1470":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-226","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection."},"1471":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-227","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"For the JITP flow to work correctly:"},"1472":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-228","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP)."},"1473":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-229","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account."},"1474":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-230","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core."},"1475":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-231","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","content":"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section."},"1476":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-232","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:"},"1477":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-233","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"Status in Lamassu"},"1478":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-234","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"Revocation reason"},"1479":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-235","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"Status in AWS IoT Core"},"1480":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-236","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`Active`"},"1481":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-237","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"None"},"1482":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-238","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`ACTIVE`"},"1483":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-239","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`Revoked`"},"1484":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-240","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`certificateHold`"},"1485":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-241","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`INACTIVE`"},"1486":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-242","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`Revoked`"},"1487":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-243","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"Any other reason"},"1488":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-244","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"`REVOKED`"},"1489":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-245","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","content":"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`."},"1490":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-246","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment."},"1491":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-247","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`."},"1492":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-248","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","content":"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key."},"1493":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-249","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","content":"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`."},"1494":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-250","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","content":"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow)."},"1495":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-251","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly."},"1496":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-252","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"There are two action types:"},"1497":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-253","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires."},"1498":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-254","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store."},"1499":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-255","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","content":"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared."},"1500":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-256","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","content":"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:"},"1501":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-257","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","content":"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints."},"1502":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-258","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","content":"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector)."},"1503":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-259","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The CA registration stays in `REQUESTED` indefinitely."},"1504":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-260","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`."},"1505":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-261","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata."},"1506":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-262","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** A certificate's status is not synced to AWS after a revocation."},"1507":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-263","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata."},"1508":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-264","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning."},"1509":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-265","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation."},"1510":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-266","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session."},"1511":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-267","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core."},"1512":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-268","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core."},"1513":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-269","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu."},"1514":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-270","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier."},"1515":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-271","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The device's first MQTT connection in JITP mode fails or times out."},"1516":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-272","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection."},"1517":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-273","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies."},"1518":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-274","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** The Device Shadow is not updated when it should be."},"1519":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-275","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one."},"1520":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-276","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions."},"1521":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-277","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS."},"1522":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-278","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped."},"1523":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-279","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template."},"1524":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-280","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1525":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-281","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />"},"1526":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core-282","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","content":"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />"},"1527":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","type":"page","content":"IoT Fleets","breadcrumbs":["Docs","Platform","IoT Fleets"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview"},"1528":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-0","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","content":"Organize devices and their identities, prepare enrollment and integrate consumers."},"1529":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-1","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#start-here","content":"Start here"},"1530":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities","content":"Devices and identities"},"1531":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#enrollment-with-pki","content":"Enrollment with PKI"},"1532":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-4","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#integrations","content":"Integrations"},"1533":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-5","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#who-prepares-each-part","content":"Who prepares each part"},"1534":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-6","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","content":"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it."},"1535":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-7","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#start-here","content":"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks."},"1536":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-8","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#start-here","content":"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device."},"1537":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-9","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities","content":"Resource"},"1538":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-10","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities","content":"What it represents"},"1539":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-11","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities","content":"**Device**"},"1540":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-12","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities","content":"An inventory entry with an identifier, owning DMS and classification."},"1541":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-13","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities","content":"**Identity**"},"1542":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-14","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities","content":"The device's association with its certificates: an active version and a history."},"1543":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-15","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities","content":"**DMS**"},"1544":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-16","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities","content":"The service that configures admission, enrollment, renewal and trust distribution."},"1545":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-17","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities","content":"**Fleet**"},"1546":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-18","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities","content":"The population you operate, represented through devices, DMSs, tags and metadata."},"1547":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-19","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities","content":"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices."},"1548":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-20","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities","content":"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity."},"1549":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-21","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#enrollment-with-pki","content":"This section connects PKI rules to the device client. Preparation follows this order:"},"1550":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-22","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#enrollment-with-pki","content":"**CA and profile:** prepare the issuer and certificate rules in PKI."},"1551":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-23","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#enrollment-with-pki","content":"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed."},"1552":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-24","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#enrollment-with-pki","content":"**Client:** prepare the initial credential, server trust, and key generation or custody."},"1553":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-25","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#enrollment-with-pki","content":"**Result:** request the certificate, install it and check its association with the device."},"1554":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-26","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#enrollment-with-pki","content":"**Continuity:** configure renewal, successor installation and recovery according to DMS policy."},"1555":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-27","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#enrollment-with-pki","content":"<Card title=\