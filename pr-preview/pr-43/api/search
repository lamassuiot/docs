reate databases and schemas, and backup/HA operations"},"347":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-27","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Messaging"},"348":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-28","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"RabbitMQ connection configuration for the Lamassu services"},"349":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-29","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"A reachable RabbitMQ broker, credentials and its lifecycle"},"350":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-30","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Identity"},"351":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-31","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals"},"352":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-32","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"An OIDC provider, realm/tenant, client, users, groups and roles"},"353":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-33","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"External routing"},"354":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-34","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies"},"355":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-35","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path"},"356":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-36","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"TLS"},"357":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-37","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret"},"358":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-38","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret"},"359":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-39","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Persistent application data"},"360":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-40","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"PersistentVolumeClaims required by the default local KMS and VA storage"},"361":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-41","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one"},"362":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-42","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Optional integrations"},"363":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-43","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity"},"364":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-44","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The observability backends, cloud credentials and production HSM or external key service"},"365":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-45","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network."},"366":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-46","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","content":"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service."},"367":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-47","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#how-the-deployment-fits-together","content":"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway."},"368":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-48","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#how-the-deployment-fits-together","content":"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it."},"369":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-49","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#platform-requirements","content":"Kubernetes 1.24 or newer"},"370":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-50","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#platform-requirements","content":"Helm 3.2 or newer"},"371":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-51","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#platform-requirements","content":"Envoy Gateway 1.8 or newer and a `GatewayClass`"},"372":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-52","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#platform-requirements","content":"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`"},"373":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-53","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#platform-requirements","content":"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration"},"374":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-54","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#platform-requirements","content":"a load-balancer implementation or another deliberate path from clients to the Gateway"},"375":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-55","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#platform-requirements","content":"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations."},"376":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-56","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />"},"377":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-57","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />"},"378":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-58","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />"},"379":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview-59","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/overview#choose-the-next-page","content":"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />"},"380":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","type":"page","content":"Deployment troubleshooting","breadcrumbs":["Docs","Deployment","Operations"],"tags":[],"url":"/docs/pr-preview/pr-43/deployment/troubleshooting"},"381":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-0","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting","content":"Diagnose access, service health and infrastructure dependencies."},"382":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-1","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/troubleshooting#diagnostic-sequence","content":"Diagnostic sequence"},"383":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-2","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/troubleshooting#reproduce-a-single-operation","content":"Reproduce a single operation"},"384":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-3","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/troubleshooting#separate-client-gateway-and-service","content":"Separate client, Gateway and service"},"385":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-4","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/troubleshooting#review-kubernetes-status","content":"Review Kubernetes status"},"386":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-5","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/troubleshooting#query-the-affected-service","content":"Query the affected service"},"387":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-6","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/troubleshooting#validate-the-result-from-outside","content":"Validate the result from outside"},"388":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-7","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/troubleshooting#minimal-evidence-collection","content":"Minimal evidence collection"},"389":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-8","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","content":"I cannot sign in"},"390":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-9","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Everything returns 403 or 5xx"},"391":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-10","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/troubleshooting#a-pod-is-not-ready","content":"A pod is not Ready"},"392":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-11","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/troubleshooting#events-are-not-arriving","content":"Events are not arriving"},"393":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-12","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/deployment/troubleshooting#observability","content":"Observability"},"394":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-13","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting","content":"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics."},"395":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-14","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#reproduce-a-single-operation","content":"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion."},"396":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-15","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#separate-client-gateway-and-service","content":"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency."},"397":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-16","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#review-kubernetes-status","content":"Locate unready pods, restarts, recent events and the state of the release."},"398":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-17","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#query-the-affected-service","content":"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine."},"399":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-18","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#validate-the-result-from-outside","content":"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses."},"400":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-19","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#minimal-evidence-collection","content":"Replace the placeholders with your real release, namespace and deployment."},"401":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-20","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#minimal-evidence-collection","content":"Also run the chart's connectivity test:"},"402":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-21","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#minimal-evidence-collection","content":"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow."},"403":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-22","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#minimal-evidence-collection","content":"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails."},"404":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-23","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","content":"If you receive a 401:"},"405":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-24","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","content":"check that the UI's OIDC authority is reachable from the browser;"},"406":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-25","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","content":"verify issuer, audience and expiration of the token;"},"407":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-26","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","content":"confirm the Gateway can fetch the keys from the JWKS URI;"},"408":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-27","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","content":"check that the provider's public and internal routes point to the same realm."},"409":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-28","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","content":"If login succeeds but the APIs return 403:"},"410":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-29","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","content":"inspect the token's real claims;"},"411":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-30","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","content":"confirm they match an active principal;"},"412":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-31","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","content":"review the policies granted to that principal;"},"413":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-32","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","content":"verify that authz reaches PostgreSQL and its JWKS."},"414":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-33","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","content":"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap."},"415":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-34","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#everything-returns-403-or-5xx","content":"External authorization fails closed by default. If authz is unavailable, protected routes are blocked."},"416":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-35","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Locate the authz pod and Service."},"417":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-36","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Check /health, logs and its database connection."},"418":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-37","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Verify the DNS and port configured in externalAuthorization."},"419":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-38","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Check the check route is /v1/ext\\_authz/check."},"420":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-39","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#everything-returns-403-or-5xx","content":"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage."},"421":{"id":"/docs/pr-preview/pr-43/deployment/troubleshooting-40","page_id":"/docs/pr-preview/pr-43/deployment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/troubleshooting#a-pod-is-not-ready","content":"Review kubectl describe pod first. Common causes are:"},"422":{"id":"/docs/pr-preview/