iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Cuándo existe el dispositivo"},"1085":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-9","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Qué compruebas"},"1086":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-10","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Asignación manual"},"1087":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-11","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"El operador lo crea antes de asociar un certificado."},"1088":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-12","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"ID, DMS propietario, CN del certificado y serie vinculada."},"1089":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-13","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"EST con `JITP`"},"1090":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-14","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Se crea para un CN desconocido durante `/simpleenroll`."},"1091":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-15","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Credencial autorizada, ID libre, perfil, alta e identidad resultantes."},"1092":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-16","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"EST con `PRE_REGISTRATION`"},"1093":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-17","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Debe existir antes de `/simpleenroll`."},"1094":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-18","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión."},"1095":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-19","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes."},"1096":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-20","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","content":"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual."},"1097":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-21","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","content":"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION."},"1098":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-22","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","content":"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior."},"1099":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-23","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","content":"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar."},"1100":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-24","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","content":"Decide por separado primer enrolamiento y reenrolamiento:"},"1101":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-25","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","content":"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla."},"1102":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-26","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","content":"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID."},"1103":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-27","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","content":"**Certificado y webhook:** exige ambos controles en la operación configurada."},"1104":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-28","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","content":"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS."},"1105":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-29","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","content":"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación."},"1106":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-30","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"Opción"},"1107":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-31","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"Material que atraviesa EST"},"1108":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-32","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"Clave generada por el dispositivo"},"1109":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-33","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"CSR pública y certificado; la clave permanece en el cliente."},"1110":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-34","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"Clave ya disponible en el dispositivo"},"1111":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-35","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"CSR firmada con la clave existente y certificado nuevo."},"1112":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-36","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"ServerKeyGen"},"1113":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-37","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS."},"1114":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-38","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","content":"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material."},"1115":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies-39","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","content":"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar."},"1116":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","type":"page","content":"Renovación y recuperación","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery"},"1117":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-0","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","content":"Renueva sin perder la identidad y recupera dispositivos según su estado real."},"1118":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-1","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","content":"Prepara la renovación"},"1119":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-2","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","content":"Solicita el certificado sucesor"},"1120":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-3","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","content":"Instala y comprueba la nueva pareja"},"1121":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-4","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Recupera según el estado"},"1122":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-5","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","content":"Operación continua"},"1123":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-6","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","content":"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos."},"1124":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-7","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","content":"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente."},"1125":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-8","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","content":"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida."},"1126":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-9","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","content":"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana."},"1127":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-10","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","content":"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva."},"1128":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-11","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","content":"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos."},"1129":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-12","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","content":"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales."},"1130":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-13","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","content":"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión."},"1131":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-14","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","content":"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación."},"1132":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-15","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","content":"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación."},"1133":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-16","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Situación"},"1134":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-17","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Procedimiento"},"1135":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-18","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Certificado vigente, fuera de ventana"},"1136":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-19","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla."},"1137":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-20","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Certificado vencido, clave disponible"},"1138":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-21","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones."},"1139":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-22","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Renovación por webhook o `NO_AUTH`"},"1140":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-23","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal."},"1141":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-24","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Clave perdida o inaccesible"},"1142":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-25","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida."},"1143":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-26","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Identidad actual revocada"},"1144":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-27","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo."},"1145":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-28","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Dispositivo sin identidad"},"1146":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-29","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento."},"1147":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-30","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Dispositivo retirado"},"1148":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-31","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes."},"1149":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-32","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Timeout, HTTP 500 o fallo de instalación"},"1150":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-33","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","content":"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior."},"1151":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-34","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","content":"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse."},"1152":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery-35","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","content":"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico."},"1153":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","type":"page","content":"Diagnóstico de enrolamiento","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting"},"1154":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-0","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","content":"Localiza fallos de transporte, autenticación, registro, emisión e instalación."},"1155":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-1","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","content":"Diagnóstico y compatibilidad"},"1156":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-2","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Códigos de error y diagnóstico"},"1157":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-3","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad","content":"Notas de compatibilidad"},"1158":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-4","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"El enrolamiento EST falla"},"1159":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-5","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","content":"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe."},"1160":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-6","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido."},"1161":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-7","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Síntoma o mensaje"},"1162":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-8","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Qué revisar"},"1163":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-9","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"curl rechaza TLS, nombre o emisor"},"1164":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-10","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación."},"1165":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-11","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"404 o APS ausente"},"1166":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-12","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio."},"1167":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-13","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"400, error de CSR o formato"},"1168":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-14","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación."},"1169":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-15","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Credencial ausente o certificado no válido"},"1170":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-16","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap."},"1171":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-17","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Webhook deniega, expira o responde sin autorización"},"1172":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-18","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`."},"1173":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-19","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`unexpected status code: <n>: redirects are not followed`"},"1174":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-20","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones."},"1175":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-21","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`webhook response exceeds 1048576 bytes`"},"1176":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-22","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización."},"1177":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-23","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`webhook config must not reference files`"},"1178":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-24","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS."},"1179":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-25","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`mtls_options.cert_content must be base64-encoded PEM`"},"1180":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-26","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave."},"1181":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-27","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`webhook mTLS certificate and key are invalid: …`"},"1182":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-28","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook."},"1183":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-29","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"400 `struct validation error` al crear o actualizar un DMS"},"1184":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-30","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS."},"1185":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-31","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"HTTP 500 con cuerpo `err` en enroll o reenroll"},"1186":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-32","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí."},"1187":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-33","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`device not preregistered`"},"1188":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-34","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"PRE\\_REGISTRATION requiere la entrada de inventario previa."},"1189":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-35","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`forbiddenNewEnrollment`"},"1190":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-36","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag."},"1191":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-37","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"DMS propietario distinto"},"1192":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-38","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto."},"1193":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-39","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`invalid RawSubject bytes`"},"1194":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-40","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN."},"1195":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-41","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"`invalid reenroll window`"},"1196":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-42","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana."},"1197":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-43","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Certificado actual revocado"},"1198":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-44","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Renovación rechazada; prepara recuperación autorizada según la causa."},"1199":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-45","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Error de CA, perfil o firma"},"1200":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-46","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión."},"1201":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-47","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"HTTP 200 sin conexión del dispositivo"},"1202":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-48","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial."},"1203":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-49","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Timeout o error después de emitir"},"1204":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-50","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","content":"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir."},"1205":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-51","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad","content":"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial."},"1206":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-52","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad","content":"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST."},"1207":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-53","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto."},"1208":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-54","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana."},"1209":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-55","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Verifica la CSR localmente y relaciona su CN con el inventario."},"1210":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-56","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados."},"1211":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-57","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor."},"1212":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-58","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS."},"1213":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting-59","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","content":"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades."},"1214":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","type":"page","content":"Distribución y actualización de confianza","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution"},"1215":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-0","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","content":"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados."},"1216":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-1","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Tres relaciones de confianza"},"1217":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-2","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","content":"Qué devuelve cacerts"},"1218":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-3","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"Instala lo necesario"},"1219":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-4","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","content":"Migra la confianza"},"1220":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-5","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","content":"Comprueba la actualización"},"1221":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-6","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","content":"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables."},"1222":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-7","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Relación"},"1223":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-8","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Material que prepara el responsable"},"1224":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-9","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Dispositivo → servidor EST"},"1225":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-10","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS."},"1226":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-11","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"DMS → solicitante"},"1227":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-12","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"CAs y reglas que autorizan la credencial inicial o de renovación."},"1228":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-13","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Consumidor → dispositivo"},"1229":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-14","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Raíces de la identidad operativa, intermedias, validación y permisos."},"1230":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-15","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","content":"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza."},"1231":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-16","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","content":"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración."},"1232":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-17","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","content":"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST."},"1233":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-18","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades."},"1234":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-19","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"Selecciona raíces que tu política haya aprobado como anclas."},"1235":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-20","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces."},"1236":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-21","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella."},"1237":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-22","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor."},"1238":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-23","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","content":"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad."},"1239":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-24","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","content":"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva."},"1240":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-25","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","content":"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado."},"1241":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-26","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","content":"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI."},"1242":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution-27","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","content":"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos."},"1243":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core","type":"page","content":"AWS IoT Core","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Integraciones"],"tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core"},"1244":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core-0","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core","content":"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos."},"1245":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core-1","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","content":"Arquitectura del conector"},"1246":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core-2","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","content":"Prerrequisitos"},"1247":{"id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core-3","page_id":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","content":"Permisos IAM necesarios"},"1248":{"id":"/docs/p