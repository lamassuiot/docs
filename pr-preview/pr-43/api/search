43/platform/pki/quickstarts/overview-8","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#before-you-begin","content":"An available cryptographic engine for the CA key; check the keys and engines inventory."},"2491":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-9","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#before-you-begin","content":"OpenSSL 3.x on the computer where you will verify the files."},"2492":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-10","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#before-you-begin","content":"A working directory with restricted access for the downloaded key."},"2493":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-11","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#recommended-path","content":"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />"},"2494":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-12","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#recommended-path","content":"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />"},"2495":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-13","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#recommended-path","content":"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect."},"2496":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-14","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#recommended-path","content":"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy."},"2497":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-15","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#expected-result","content":"File or resource"},"2498":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-16","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#expected-result","content":"Check"},"2499":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-17","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#expected-result","content":"Active root CA and `ca.pem`"},"2500":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-18","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#expected-result","content":"It is a CA certificate, is currently valid and its self-signature verifies."},"2501":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-19","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#expected-result","content":"End-entity certificate and `device.crt`"},"2502":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-20","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#expected-result","content":"It identifies `device-001`, supports client authentication and verifies against `ca.pem`."},"2503":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-21","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#expected-result","content":"Private key `device.key`"},"2504":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-22","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#expected-result","content":"Its public key matches the one included in `device.crt`."},"2505":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-23","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#expected-result","content":"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration."},"2506":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-24","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To operate certificates, continue with Certificates and Validation."},"2507":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-25","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation."},"2508":{"id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview-26","page_id":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#continue-according-to-your-goal","content":"For the device to request its certificate, prepare the DMS and EST client."},"2509":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","type":"page","content":"PKI troubleshooting","breadcrumbs":["Docs","Platform","PKI","Troubleshooting"],"tags":[],"url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting"},"2510":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-0","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","content":"Diagnose certificate issuance, OCSP and CRL."},"2511":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-1","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Issuance fails"},"2512":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-2","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"OCSP or CRL do not reflect a change"},"2513":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-3","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"The chain validates but the connection fails"},"2514":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-4","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","content":"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics."},"2515":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-5","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","content":"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics."},"2516":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-6","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Check"},"2517":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-7","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"What to inspect"},"2518":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-8","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Next step"},"2519":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-9","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"CA"},"2520":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-10","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Exists, is active and has usable dates."},"2521":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-11","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Authorities."},"2522":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-12","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Key"},"2523":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-13","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"The record has a usable private key and the engine can sign."},"2524":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-14","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Try **Sign / Verify** in KMS; check provider permissions and availability."},"2525":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-15","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"CSR"},"2526":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-16","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Correct PEM and verifiable signature."},"2527":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-17","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"`openssl req -in request.csr -noout -verify -text`."},"2528":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-18","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Profile"},"2529":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-19","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Selected source, existing ID, allowed algorithm and size."},"2530":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-20","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Check Profiles precedence; CA and DMS resolve differently."},"2531":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-21","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Result"},"2532":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-22","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Appropriate subject, SAN, usages and dates."},"2533":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-23","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance."},"2534":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-24","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration."},"2535":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-25","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","content":"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation."},"2536":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-26","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Check each boundary independently:"},"2537":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-27","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions."},"2538":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-28","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy."},"2539":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-29","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`."},"2540":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-30","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator."},"2541":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-31","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection."},"2542":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-32","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","content":"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure."},"2543":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-33","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests."},"2544":{"id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting-34","page_id":"/docs/pr-preview/pr-43/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","content":"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures."},"2545":{"id":"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0","page_id":"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0","type":"page","content":"3.8.0 to 4.0.0","breadcrumbs":["Docs","Upgrades"],"tags":[],"url":"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0"},"2546":{"id":"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0-0","page_id":"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0","content":"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result."},"2547":{"id":"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0-1","page_id":"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#architecture-changes","content":"Architecture changes"},"2548":{"id":"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0-2","page_id":"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","content":"One PostgreSQL database with schemas"},"2549"