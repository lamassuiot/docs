-each-part","content":"Responsibility"},"1561":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-33","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#who-prepares-each-part","content":"PKI administrator"},"1562":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-34","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#who-prepares-each-part","content":"CA, issuance profile, chain and revocation publication."},"1563":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-35","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#who-prepares-each-part","content":"Provisioning administrator"},"1564":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-36","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#who-prepares-each-part","content":"DMS, admission, authentication per operation and inventory."},"1565":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-37","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#who-prepares-each-part","content":"Device integrator"},"1566":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-38","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/overview#who-prepares-each-part","content":"Initial credential, key, EST client, trust and certificate installation."},"1567":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview-39","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr