ooting-0","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","content":"Diagnostica emisión de certificados, OCSP y CRL."},"2510":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-1","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"La emisión falla"},"2511":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-2","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"OCSP o CRL no reflejan un cambio"},"2512":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-3","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","content":"La cadena se valida pero la conexión falla"},"2513":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-4","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","content":"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico."},"2514":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-5","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","content":"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST."},"2515":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-6","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Comprobación"},"2516":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-7","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Qué revisar"},"2517":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-8","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Siguiente paso"},"2518":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-9","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"CA"},"2519":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-10","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Existe, está activa y sus fechas son utilizables."},"2520":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-11","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Autoridades."},"2521":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-12","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Clave"},"2522":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-13","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"El registro tiene clave privada utilizable y el motor puede firmar."},"2523":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-14","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor."},"2524":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-15","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"CSR"},"2525":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-16","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"PEM correcto y firma verificable."},"2526":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-17","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"`openssl req -in request.csr -noout -verify -text`."},"2527":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-18","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Perfil"},"2528":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-19","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos."},"2529":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-20","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta."},"2530":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-21","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Resultado"},"2531":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-22","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Sujeto, SAN, usos y fechas adecuados."},"2532":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-23","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor."},"2533":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-24","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA."},"2534":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-25","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","content":"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación."},"2535":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-26","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"Revisa cada frontera por separado:"},"2536":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-27","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición."},"2537":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-28","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia."},"2538":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-29","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado."},"2539":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-30","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue."},"2540":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-31","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva."},"2541":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-32","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","content":"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación."},"2542":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-33","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","content":"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo."},"2543":{"id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting-34","page_id":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","content":"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora."},"2544":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"page","content":"3.8.0 a 4.0.0","breadcrumbs":["Docs","Actualizaciones"],"tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0"},"2545":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-0","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","content":"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado."},"2546":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-1","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","content":"Cambios de arquitectura"},"2547":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-2","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","content":"Una única base de datos PostgreSQL con esquemas"},"2548":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0-3","page_id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","content":"La autorización pasa al servicio authz"},"2549":{"id":"/docs/pr-preview/pr-43/es/upgrades/3-8-0-