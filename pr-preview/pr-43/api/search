/self-hosted/networking-12","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#expose-the-lamassu-gateway","content":"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT."},"268":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-13","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status."},"269":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-14","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"Set it only when:"},"270":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-15","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"your cloud or bare-metal load balancer supports requesting a specific address"},"271":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-16","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"that address is allocated to this Gateway"},"272":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-17","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"the surrounding network already routes traffic for it to the cluster"},"273":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-18","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable."},"274":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-19","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"Keep these two settings separate:"},"275":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-20","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"`gateway.addresses` requests an address for the Gateway."},"276":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-21","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate."},"277":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-22","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#do-you-need-gatewayaddresses","content":"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`."},"278":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-23","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#recommended-single-node-design","content":"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:"},"279":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-24","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#recommended-single-node-design","content":"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes."},"280":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-25","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#k3s","content":"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports."},"281":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-26","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#k3s","content":"For the recommended design:"},"282":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-27","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#k3s","content":"Use only one externally exposed Lamassu Gateway."},"283":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-28","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#k3s","content":"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path."},"284":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-29","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#k3s","content":"Allow those ports through the VM firewall and any upstream security group."},"285":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-30","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#k3s","content":"Point DNS at the VM's reachable address."},"286":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-31","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#k3s","content":"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation."},"287":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-32","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","content":"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded."},"288":{"id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking-33","page_id":"/docs/pr-preview/pr-43/deployment/self-hosted/networking","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","content":"An external public 