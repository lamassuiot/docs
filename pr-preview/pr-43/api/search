efore you begin"},"1626":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device-2","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","content":"Prepare the DMS"},"1627":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device-3","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#register-the-device","content":"Register the device"},"1628":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device-4","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","content":"Check the initial status"},"1629":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device-5","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#assign-an-identity","content":"Assign an identity"},"1630":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device-6","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#verify-the-device","content":"Verify the device"},"1631":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device-7","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#expected-result","content":"Expected result"},"1632":{"id":"