ckstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#register-the-device","content":"Open **Managed Devices** and the registration action. Complete:"},"1669":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device-25","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#register-the-device","content":"**Device ID**: `device-001`."},"1670":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device-26","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#register-the-device","content":"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role."},"1671":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device-27","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#register-the-device","content":"**Icon** and **Tags**: optional classification."},"1672":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device-28","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#register-the-device","content":"Confirm registration."},"1673":{"id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device-29","page_id":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","content":