0":103290,"_33712":103293,"_33714":103296,"_33716":103299},{"_2859":57834,"_25205":57834,"_5":12316,"_2386":96031,"_25540":96032,"_17596":96035,"_23867":57834},"Despliega desde AWS Marketplace",[40894,96033,96034],"Despliegue","Otros modelos",[],{"_2859":57835,"_25205":57834,"_17596":96037,"_5":17486,"_23867":57834,"_2386":96038},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2859":57836,"_25205":57834,"_5":25537,"_17596":96040,"_23867":96041,"_2386":96042},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2859":57837,"_25205":57834,"_5":25537,"_17596":96044,"_23867":96045,"_2386":96046},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2859":57838,"_25205":57834,"_5":25537,"_17596":96048,"_23867":96049,"_2386":96050},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2859":57839,"_25205":57834,"_5":25537,"_17596":96052,"_23867":96053,"_2386":96054},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2859":57840,"_25205":57834,"_5":25537,"_17596":96056,"_23867":96057,"_2386":96058},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2859":57841,"_25205":57834,"_5":25537,"_17596":96060,"_23867":96061,"_2386":96062},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2859":57842,"_25205":57834,"_5":25537,"_17596":96064,"_23867":96065,"_2386":96066},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2859":57843,"_25205":57834,"_17596":96068,"_5":17486,"_23867":57834,"_2386":96069},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2859":57844,"_25205":57834,"_17596":96071,"_5":17486,"_23867":96041,"_2386":96072},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2859":57845,"_25205":57834,"_17596":96074,"_5":17486,"_23867":96041,"_2386":96075},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2859":57846,"_25205":57834,"_17596":96077,"_5":17486,"_23867":96041,"_2386":96078},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2859":57847,"_25205":57834,"_17596":96080,"_5":17486,"_23867":96045,"_2386":96081},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2859":57848,"_25205":57834,"_17596":96083,"_5":17486,"_23867":96045,"_2386":96084},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2859":57849,"_25205":57834,"_17596":96086,"_5":17486,"_23867":96045,"_2386":96087},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2859":57850,"_25205":57834,"_17596":96089,"_5":17486,"_23867":96049,"_2386":96090},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2859":57851,"_25205":57834,"_17596":96092,"_5":17486,"_23867":96053,"_2386":96093},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2859":57852,"_25205":57834,"_17596":96095,"_5":17486,"_23867":96057,"_2386":96096},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2859":57853,"_25205":57834,"_17596":96098,"_5":17486,"_23867":96061,"_2386":96099},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2859":57854,"_25205":57834,"_17596":96101,"_5":17486,"_23867":96065,"_2386":96102},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2859":57855,"_25205":57855,"_5":12316,"_2386":96104,"_25540":96105,"_17596":96106,"_23867":57855},"Despliega Lamassu",[40894,96033],[],{"_2859":57856,"_25205":57855,"_17596":96108,"_5":17486,"_23867":57855,"_2386":96109},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2859":57857,"_25205":57855,"_5":25537,"_17596":96111,"_23867":96112,"_2386":96113},[],"/docs/pr-preview/pr-43/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2859":57858,"_25205":57855,"_5":25537,"_17596":96115,"_23867":96116,"_2386":96117},[],"/docs/pr-preview/pr-43/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2859":57859,"_25205":57855,"_5":25537,"_17596":96119,"_23867":96120,"_2386":96121},[],"/docs/pr-preview/pr-43/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2859":57860,"_25205":57855,"_17596":96123,"_5":17486,"_23867":57855,"_2386":96124},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2859":57861,"_25205":57855,"_17596":96126,"_5":17486,"_23867":96112,"_2386":96127},[],"Modelo",{"_2859":57862,"_25205":57855,"_17596":96129,"_5":17486,"_23867":96112,"_2386":96130},[],"Recomendado para",{"_2859":57863,"_25205":57855,"_17596":96132,"_5":17486,"_23867":96112,"_2386":96133},[],"Quién opera la infraestructura",{"_2859":57864,"_25205":57855,"_17596":96135,"_5":17486,"_23867":96112,"_2386":96136},[],"Punto de partida",{"_2859":57865,"_25205":57855,"_17596":96138,"_5":17486,"_23867":96112,"_2386":41001},[],{"_2859":57866,"_25205":57855,"_17596":96140,"_5":17486,"_23867":96112,"_2386":96141},[],"Producción, entornos regulados y despliegues personalizados",{"_2859":57867,"_25205":57855,"_17596":96143,"_5":17486,"_23867":96112,"_2386":96144},[],"Tu equipo",{"_2859":57868,"_25205":57855,"_17596":96146,"_5":17486,"_23867":96112,"_2386":96147},[],"Helm o Fastlane",{"_2859":57869,"_25205":57855,"_17596":96149,"_5":17486,"_23867":96112,"_2386":41013},[],{"_2859":57870,"_25205":57855,"_17596":96151,"_5":17486,"_23867":96112,"_2386":96152},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2859":57871,"_25205":57855,"_17596":96154,"_5":17486,"_23867":96112,"_2386":96144},[],{"_2859":57872,"_25205":57855,"_17596":96156,"_5":17486,"_23867":96112,"_2386":96157},[],"Imagen preconfigurada en EC2",{"_2859":57873,"_25205":57855,"_17596":96159,"_5":17486,"_23867":96112,"_2386":41024},[],{"_2859":57874,"_25205":57855,"_17596":96161,"_5":17486,"_23867":96112,"_2386":96162},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2859":57875,"_25205":57855,"_17596":96164,"_5":17486,"_23867":96112,"_2386":41030},[],{"_2859":57876,"_25205":57855,"_17596":96166,"_5":17486,"_23867":96112,"_2386":96167},[],"Suscripción gestionada",{"_2859":57877,"_25205":57855,"_17596":96169,"_5":17486,"_23867":96112,"_2386":96170},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2859":57878,"_25205":57855,"_17596":96172,"_5":17486,"_23867":96112,"_2386":96173},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2859":57879,"_25205":57855,"_17596":96175,"_5":17486,"_23867":96112,"_2386":96176},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2859":57880,"_25205":57855,"_17596":96178,"_5":17486,"_23867":96116,"_2386":96179},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2859":57881,"_25205":57855,"_17596":96181,"_5":17486,"_23867":96120,"_2386":96182},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2859":57882,"_25205":57882,"_5":12316,"_2386":96184,"_25540":96185,"_17596":96186,"_23867":57882},"Utiliza Lamassu como SaaS",[40894,96033,96034],[],{"_2859":57883,"_25205":57882,"_17596":96188,"_5":17486,"_23867":57882,"_2386":96189},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2859":57884,"_25205":57882,"_5":25537,"_17596":96191,"_23867":96192,"_2386":96193},[],"/docs/pr-preview/pr-43/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2859":57885,"_25205":57882,"_5":25537,"_17596":96195,"_23867":96196,"_2386":96197},[],"/docs/pr-preview/pr-43/es/deployment/saas#planes","Planes",{"_2859":57886,"_25205":57882,"_5":25537,"_17596":96199,"_23867":96200,"_2386":96201},[],"/docs/pr-preview/pr-43/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2859":57887,"_25205":57882,"_17596":96203,"_5":17486,"_23867":57882,"_2386":96204},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2859":57888,"_25205":57882,"_17596":96206,"_5":17486,"_23867":96192,"_2386":96207},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2859":57889,"_25205":57882,"_17596":96209,"_5":17486,"_23867":96192,"_2386":96210},[],"Copias de seguridad automáticas.",{"_2859":57890,"_25205":57882,"_17596":96212,"_5":17486,"_23867":96192,"_2386":96213},[],"Actualizaciones de versión.",{"_2859":57891,"_25205":57882,"_17596":96215,"_5":17486,"_23867":96192,"_2386":96216},[],"Soporte técnico y SLA según el plan contratado.",{"_2859":57892,"_25205":57882,"_17596":96218,"_5":17486,"_23867":96196,"_2386":41085},[],{"_2859":57893,"_25205":57882,"_17596":96220,"_5":17486,"_23867":96196,"_2386":96221},[],"Dispositivos",{"_2859":57894,"_25205":57882,"_17596":96223,"_5":17486,"_23867":96196,"_2386":96224},[],"Soporte",{"_2859":57895,"_25205":57882,"_17596":96226,"_5":17486,"_23867":96196,"_2386":41094},[],{"_2859":57896,"_25205":57882,"_17596":96228,"_5":17486,"_23867":96196,"_2386":41097},[],{"_2859":57897,"_25205":57882,"_17596":96230,"_5":17486,"_23867":96196,"_2386":96231},[],"Hasta 1.000",{"_2859":57898,"_25205":57882,"_17596":96233,"_5":17486,"_23867":96196,"_2386":41103},[],{"_2859":57899,"_25205":57882,"_17596":96235,"_5":17486,"_23867":96196,"_2386":96236},[],"99,5 %",{"_2859":57900,"_25205":57882,"_17596":96238,"_5":17486,"_23867":96196,"_2386":41109},[],{"_2859":57901,"_25205":57882,"_17596":96240,"_5":17486,"_23867":96196,"_2386":96241},[],"Hasta 10.000",{"_2859":57902,"_25205":57882,"_17596":96243,"_5":17486,"_23867":96196,"_2386":96244},[],"Email y chat",{"_2859":57903,"_25205":57882,"_17596":96246,"_5":17486,"_23867":96196,"_2386":96247},[],"99,9 %",{"_2859":57904,"_25205":57882,"_17596":96249,"_5":17486,"_23867":96196,"_2386":41121},[],{"_2859":57905,"_25205":57882,"_17596":96251,"_5":17486,"_23867":96196,"_2386":96252},[],"Ilimitados",{"_2859":57906,"_25205":57882,"_17596":96254,"_5":17486,"_23867":96196,"_2386":96255},[],"Dedicado",{"_2859":57907,"_25205":57882,"_17596":96257,"_5":17486,"_23867":96196,"_2386":96258},[],"99,99 %",{"_2859":57908,"_25205":57882,"_17596":96260,"_5":17486,"_23867":96200,"_2386":96261},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2859":57909,"_25205":57882,"_17596":96263,"_5":17486,"_23867":96200,"_2386":96264},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2859":57910,"_25205":57910,"_5":12316,"_2386":41138,"_25540":96266,"_17596":96268,"_23867":57910},[40894,96033,96267],"Kubernetes autogestionado",[],{"_2859":57911,"_25205":57910,"_17596":96270,"_5":17486,"_23867":57910,"_2386":96271},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2859":57912,"_25205":57910,"_5":25537,"_17596":96273,"_23867":96274,"_2386":96275},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2859":57913,"_25205":57910,"_5":25537,"_17596":96277,"_23867":96278,"_2386":96279},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2859":57914,"_25205":57910,"_5":25537,"_17596":96281,"_23867":96282,"_2386":96283},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2859":57915,"_25205":57910,"_5":25537,"_17596":96285,"_23867":96286,"_2386":96287},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2859":57916,"_25205":57910,"_5":25537,"_17596":96289,"_23867":96290,"_2386":96291},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2859":57917,"_25205":57910,"_5":25537,"_17596":96293,"_23867":96294,"_2386":96295},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2859":57918,"_25205":57910,"_5":25537,"_17596":96297,"_23867":96298,"_2386":96299},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2859":57919,"_25205":57910,"_5":25537,"_17596":96301,"_23867":96302,"_2386":96303},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2859":57920,"_25205":57910,"_5":25537,"_17596":96305,"_23867":96306,"_2386":96307},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2859":57921,"_25205":57910,"_5":25537,"_17596":96309,"_23867":96310,"_2386":96311},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2859":57922,"_25205":57910,"_17596":96313,"_5":17486,"_23867":96274,"_2386":96314},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2859":57923,"_25205":57910,"_17596":96316,"_5":17486,"_23867":96274,"_2386":96317},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2859":57924,"_25205":57910,"_17596":96319,"_5":17486,"_23867":96278,"_2386":96320},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2859":57925,"_25205":57910,"_17596":96322,"_5":17486,"_23867":96278,"_2386":96323},[],"Fastlane instala o configura",{"_2859":57926,"_25205":57910,"_17596":96325,"_5":17486,"_23867":96278,"_2386":96326},[],"Tú sigues proporcionando",{"_2859":57927,"_25205":57910,"_17596":96328,"_5":17486,"_23867":96278,"_2386":96329},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2859":57928,"_25205":57910,"_17596":96331,"_5":17486,"_23867":96278,"_2386":96332},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2859":57929,"_25205":57910,"_17596":96334,"_5":17486,"_23867":96278,"_2386":96335},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2859":57930,"_25205":57910,"_17596":96337,"_5":17486,"_23867":96278,"_2386":96338},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2859":57931,"_25205":57910,"_17596":96340,"_5":17486,"_23867":96278,"_2386":96341},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2859":57932,"_25205":57910,"_17596":96343,"_5":17486,"_23867":96278,"_2386":96344},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2859":57933,"_25205":57910,"_17596":96346,"_5":17486,"_23867":96278,"_2386":96347},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2859":57934,"_25205":57910,"_17596":96349,"_5":17486,"_23867":96278,"_2386":96350},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2859":57935,"_25205":57910,"_17596":96352,"_5":17486,"_23867":96278,"_2386":96353},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2859":57936,"_25205":57910,"_17596":96355,"_5":17486,"_23867":96282,"_2386":96356},[],"Necesitas:",{"_2859":57937,"_25205":57910,"_17596":96358,"_5":17486,"_23867":96282,"_2386":96359},[],"un clúster Kubernetes existente",{"_2859":57938,"_25205":57910,"_17596":96361,"_5":17486,"_23867":96282,"_2386":96362},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2859":57939,"_25205":57910,"_17596":96364,"_5":17486,"_23867":96282,"_2386":41236},[],{"_2859":57940,"_25205":57910,"_17596":96366,"_5":17486,"_23867":96282,"_2386":19914},[],{"_2859":57941,"_25205":57910,"_17596":96368,"_5":17486,"_23867":96282,"_2386":96369},[],"`jq` solo si usas `--sample-data`",{"_2859":57942,"_25205":57910,"_17596":96371,"_5":17486,"_23867":96282,"_2386":96372},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2859":57943,"_25205":57910,"_17596":96374,"_5":17486,"_23867":96282,"_2386":96375},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2859":57944,"_25205":57910,"_17596":96377,"_5":17486,"_23867":96282,"_2386":96378},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2859":57945,"_25205":57910,"_17596":96380,"_5":17486,"_23867":96286,"_2386":96381},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2859":57946,"_25205":57910,"_17596":96383,"_5":17486,"_23867":96286,"_2386":96384},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2859":57947,"_25205":57910,"_17596":96386,"_5":17486,"_23867":96290,"_2386":96387},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2859":57948,"_25205":57910,"_17596":96389,"_5":17486,"_23867":96290,"_2386":96390},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2859":57949,"_25205":57910,"_17596":96392,"_5":17486,"_23867":96290,"_2386":96393},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2859":57950,"_25205":57910,"_17596":96395,"_5":17486,"_23867":96290,"_2386":96396},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2859":57951,"_25205":57910,"_17596":96398,"_5":17486,"_23867":96294,"_2386":96399},[],"Opción",{"_2859":57952,"_25205":57910,"_17596":96401,"_5":17486,"_23867":96294,"_2386":96402},[],"Valor predeterminado",{"_2859":57953,"_25205":57910,"_17596":96404,"_5":17486,"_23867":96294,"_2386":96405},[],"Propósito",{"_2859":57954,"_25205":57910,"_17596":96407,"_5":17486,"_23867":96294,"_2386":41280},[],{"_2859":57955,"_25205":57910,"_17596":96409,"_5":17486,"_23867":96294,"_2386":41283},[],{"_2859":57956,"_25205":57910,"_17596":96411,"_5":17486,"_23867":96294,"_2386":96412},[],"Muestra la ayuda",{"_2859":57957,"_25205":57910,"_17596":96414,"_5":17486,"_23867":96294,"_2386":41289},[],{"_2859":57958,"_25205":57910,"_17596":96416,"_5":17486,"_23867":96294,"_2386":96417},[],"contexto actual",{"_2859":57959,"_25205":57910,"_17596":96419,"_5":17486,"_23867":96294,"_2386":96420},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2859":57960,"_25205":57910,"_17596":96422,"_5":17486,"_23867":96294,"_2386":41298},[],{"_2859":57961,"_25205":57910,"_17596":96424,"_5":17486,"_23867":96294,"_2386":5353},[],{"_2859":57962,"_25205":57910,"_17596":96426,"_5":17486,"_23867":96294,"_2386":96427},[],"Omite prompts y genera credenciales para las dependencias",{"_2859":57963,"_25205":57910,"_17596":96429,"_5":17486,"_23867":96294,"_2386":41306},[],{"_2859":57964,"_25205":57910,"_17596":96431,"_5":17486,"_23867":96294,"_2386":41309},[],{"_2859":57965,"_25205":57910,"_17596":96433,"_5":17486,"_23867":96294,"_2386":96434},[],"Namespace de la instalación",{"_2859":57966,"_25205":57910,"_17596":96436,"_5":17486,"_23867":96294,"_2386":41315},[],{"_2859":57967,"_25205":57910,"_17596":96438,"_5":17486,"_23867":96294,"_2386":41318},[],{"_2859":57968,"_25205":57910,"_17596":96440,"_5":17486,"_23867":96294,"_2386":96441},[],"Dominio usado por la UI, OIDC y el certificado",{"_2859":57969,"_25205":57910,"_17596":96443,"_5":17486,"_23867":96294,"_2386":41324},[],{"_2859":57970,"_25205":57910,"_17596":96445,"_5":17486,"_23867":96294,"_2386":12554},[],{"_2859":57971,"_25205":57910,"_17596":96447,"_5":17486,"_23867":96294,"_2386":96448},[],"Versión del chart de Lamassu",{"_2859":57972,"_25205":57910,"_17596":96450,"_5":17486,"_23867":96294,"_2386":41332},[],{"_2859":57973,"_25205":57910,"_17596":96452,"_5":17486,"_23867":96294,"_2386":41335},[],{"_2859":57974,"_25205":57910,"_17596":96454,"_5":17486,"_23867":96294,"_2386":96455},[],"Puerto del listener HTTPS",{"_2859":57975,"_25205":57910,"_17596":96457,"_5":17486,"_23867":96294,"_2386":41341},[],{"_2859":57976,"_25205":57910,"_17596":96459,"_5":17486,"_23867":96294,"_2386":41344},[],{"_2859":57977,"_25205":57910,"_17596":96461,"_5":17486,"_23867":96294,"_2386":96462},[],"Puerto del listener HTTP",{"_2859":57978,"_25205":57910,"_17596":96464,"_5":17486,"_23867":96294,"_2386":41350},[],{"_2859":57979,"_25205":57910,"_17596":96466,"_5":17486,"_23867":96294,"_2386":41283},[],{"_2859":57980,"_25205":57910,"_17596":96468,"_5":17486,"_23867":96294,"_2386":96469},[],"Certificado PEM para TLS downstream",{"_2859":57981,"_25205":57910,"_17596":96471,"_5":17486,"_23867":96294,"_2386":41358},[],{"_2859":57982,"_25205":57910,"_17596":96473,"_5":17486,"_23867":96294,"_2386":41283},[],{"_2859":57983,"_25205":57910,"_17596":96475,"_5":17486,"_23867":96294,"_2386":96476},[],"Clave privada PEM para TLS downstream",{"_2859":57984,"_25205":57910,"_17596":96478,"_5":17486,"_23867":96294,"_2386":41366},[],{"_2859":57985,"_25205":57910,"_17596":96480,"_5":17486,"_23867":96294,"_2386":96481},[],"chart del repositorio",{"_2859":57986,"_25205":57910,"_17596":96483,"_5":17486,"_23867":96294,"_2386":96484},[],"Usa un chart local de Lamassu sin empaquetar",{"_2859":57987,"_25205":57910,"_17596":96486,"_5":17486,"_23867":96294,"_2386":41375},[],{"_2859":57988,"_25205":57910,"_17596":96488,"_5":17486,"_23867":96294,"_2386":96489},[],"detección automática",{"_2859":57989,"_25205":57910,"_17596":96491,"_5":17486,"_23867":96294,"_2386":96492},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2859":57990,"_25205":57910,"_17596":96494,"_5":17486,"_23867":96294,"_2386":41383},[],{"_2859":57991,"_25205":57910,"_17596":96496,"_5":17486,"_23867":96294,"_2386":5353},[],{"_2859":57992,"_25205":57910,"_17596":96498,"_5":17486,"_23867":96294,"_2386":96499},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2859":57993,"_25205":57910,"_17596":96501,"_5":17486,"_23867":96294,"_2386":41391},[],{"_2859":57994,"_25205":57910,"_17596":96503,"_5":17486,"_23867":96294,"_2386":5353},[],{"_2859":57995,"_25205":57910,"_17596":96505,"_5":17486,"_23867":96294,"_2386":96506},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2859":57996,"_25205":57910,"_17596":96508,"_5":17486,"_23867":96294,"_2386":41399},[],{"_2859":57997,"_25205":57910,"_17596":96510,"_5":17486,"_23867":96294,"_2386":5353},[],{"_2859":57998,"_25205":57910,"_17596":96512,"_5":17486,"_23867":96294,"_2386":96513},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2859":57999,"_25205":57910,"_17596":96515,"_5":17486,"_23867":96294,"_2386":41407},[],{"_2859":58000,"_25205":57910,"_17596":96517,"_5":17486,"_23867":96294,"_2386":41410},[],{"_2859":58001,"_25205":57910,"_17596":96519,"_5":17486,"_23867":96294,"_2386":96520},[],"Usa otro chart local de SoftHSM",{"_2859":58002,"_25205":57910,"_17596":96522,"_5":17486,"_23867":96294,"_2386":96523},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2859":58003,"_25205":57910,"_17596":96525,"_5":17486,"_23867":96298,"_2386":41419},[],{"_2859":58004,"_25205":57910,"_17596":96527,"_5":17486,"_23867":96298,"_2386":96528},[],"valida las herramientas locales y el clúster seleccionado",{"_2859":58005,"_25205":57910,"_17596":96530,"_5":17486,"_23867":96298,"_2386":96531},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2859":58006,"_25205":57910,"_17596":96533,"_5":17486,"_23867":96298,"_2386":96534},[],"crea el namespace",{"_2859":58007,"_25205":57910,"_17596":96536,"_5":17486,"_23867":96298,"_2386":96537},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2859":58008,"_25205":57910,"_17596":96539,"_5":17486,"_23867":96298,"_2386":96540},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2859":58009,"_25205":57910,"_17596":96542,"_5":17486,"_23867":96298,"_2386":96543},[],"instala RabbitMQ",{"_2859":58010,"_25205":57910,"_17596":96545,"_5":17486,"_23867":96298,"_2386":96546},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2859":58011,"_25205":57910,"_17596":96548,"_5":17486,"_23867":96298,"_2386":96549},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2859":58012,"_25205":57910,"_17596":96551,"_5":17486,"_23867":96298,"_2386":96552},[],"carga datos de ejemplo opcionalmente",{"_2859":58013,"_25205":57910,"_17596":96554,"_5":17486,"_23867":96298,"_2386":96555},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2859":58014,"_25205":57910,"_17596":96557,"_5":17486,"_23867":96302,"_2386":96558},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2859":58015,"_25205":57910,"_17596":96560,"_5":17486,"_23867":96302,"_2386":96561},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2859":58016,"_25205":57910,"_17596":96563,"_5":17486,"_23867":96306,"_2386":96564},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2859":58017,"_25205":57910,"_17596":96566,"_5":17486,"_23867":96306,"_2386":96567},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2859":58018,"_25205":57910,"_17596":96569,"_5":17486,"_23867":96306,"_2386":96570},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2859":58019,"_25205":57910,"_17596":96572,"_5":17486,"_23867":96310,"_2386":96573},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2859":58020,"_25205":58020,"_5":12316,"_2386":96575,"_25540":96576,"_17596":96577,"_23867":58020},"Instala con Helm",[40894,96033,96267],[],{"_2859":58021,"_25205":58020,"_17596":96579,"_5":17486,"_23867":58020,"_2386":96580},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2859":58022,"_25205":58020,"_5":25537,"_17596":96582,"_23867":96583,"_2386":96584},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2859":58023,"_25205":58020,"_5":25537,"_17596":96586,"_23867":96587,"_2386":96283},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2859":58024,"_25205":58020,"_5":25537,"_17596":96589,"_23867":96590,"_2386":96591},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2859":58025,"_25205":58020,"_5":25537,"_17596":96593,"_23867":96594,"_2386":96595},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2859":58026,"_25205":58020,"_5":25537,"_17596":96597,"_23867":96598,"_2386":96599},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2859":58027,"_25205":58020,"_5":25537,"_17596":96601,"_23867":96602,"_2386":96603},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2859":58028,"_25205":58020,"_5":25537,"_17596":96605,"_23867":96606,"_2386":96607},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2859":58029,"_25205":58020,"_5":25537,"_17596":96609,"_23867":96610,"_2386":96611},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2859":58030,"_25205":58020,"_5":25537,"_17596":96613,"_23867":96614,"_2386":96615},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2859":58031,"_25205":58020,"_17596":96617,"_5":17486,"_23867":96583,"_2386":96618},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2859":58032,"_25205":58020,"_17596":96620,"_5":17486,"_23867":96587,"_2386":96621},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2859":58033,"_25205":58020,"_17596":96623,"_5":17486,"_23867":96587,"_2386":96624},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2859":58034,"_25205":58020,"_17596":96626,"_5":17486,"_23867":96587,"_2386":96627},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2859":58035,"_25205":58020,"_17596":96629,"_5":17486,"_23867":96587,"_2386":96630},[],"un broker RabbitMQ accesible y sus credenciales",{"_2859":58036,"_25205":58020,"_17596":96632,"_5":17486,"_23867":96587,"_2386":96633},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2859":58037,"_25205":58020,"_17596":96635,"_5":17486,"_23867":96587,"_2386":96636},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2859":58038,"_25205":58020,"_17596":96638,"_5":17486,"_23867":96587,"_2386":96639},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2859":58039,"_25205":58020,"_17596":96641,"_5":17486,"_23867":96587,"_2386":96642},[],"una StorageClass y un diseño de tráfico externo",{"_2859":58040,"_25205":58020,"_17596":96644,"_5":17486,"_23867":96587,"_2386":96645},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2859":58041,"_25205":58020,"_17596":96647,"_5":17486,"_23867":96587,"_2386":96648},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2859":58042,"_25205":58020,"_17596":96650,"_5":17486,"_23867":96587,"_2386":96651},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2859":58043,"_25205":58020,"_17596":96653,"_5":17486,"_23867":96590,"_2386":96654},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2859":58044,"_25205":58020,"_17596":96656,"_5":17486,"_23867":96590,"_2386":96657},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2859":58045,"_25205":58020,"_17596":96659,"_5":17486,"_23867":96590,"_2386":96660},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2859":58046,"_25205":58020,"_17596":96662,"_5":17486,"_23867":96594,"_2386":96663},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2859":58047,"_25205":58020,"_17596":96665,"_5":17486,"_23867":96594,"_2386":96666},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2859":58048,"_25205":58020,"_17596":96668,"_5":17486,"_23867":96594,"_2386":96669},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2859":58049,"_25205":58020,"_17596":96671,"_5":17486,"_23867":96598,"_2386":96672},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2859":58050,"_25205":58020,"_17596":96674,"_5":17486,"_23867":96602,"_2386":96675},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2859":58051,"_25205":58020,"_17596":96677,"_5":17486,"_23867":96602,"_2386":96678},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2859":58052,"_25205":58020,"_17596":96680,"_5":17486,"_23867":96602,"_2386":96681},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2859":58053,"_25205":58020,"_17596":96683,"_5":17486,"_23867":96602,"_2386":96684},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2859":58054,"_25205":58020,"_17596":96686,"_5":17486,"_23867":96606,"_2386":96687},[],"Para instalar un checkout local:",{"_2859":58055,"_25205":58020,"_17596":96689,"_5":17486,"_23867":96610,"_2386":96690},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2859":58056,"_25205":58020,"_17596":96692,"_5":17486,"_23867":96610,"_2386":96693},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2859":58057,"_25205":58020,"_17596":96695,"_5":17486,"_23867":96614,"_2386":96696},[],"Antes de pasar a producción, revisa:",{"_2859":58058,"_25205":58020,"_17596":96698,"_5":17486,"_23867":96614,"_2386":96699},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2859":58059,"_25205":58020,"_17596":96701,"_5":17486,"_23867":96614,"_2386":96702},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2859":58060,"_25205":58020,"_17596":96704,"_5":17486,"_23867":96614,"_2386":96705},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2859":58061,"_25205":58020,"_17596":96707,"_5":17486,"_23867":96614,"_2386":96708},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2859":58062,"_25205":58020,"_17596":96710,"_5":17486,"_23867":96614,"_2386":96711},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2859":58063,"_25205":58020,"_17596":96713,"_5":17486,"_23867":96614,"_2386":96714},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2859":58064,"_25205":58020,"_17596":96716,"_5":17486,"_23867":96614,"_2386":96717},[],"SMTP, observabilidad y entrega de alertas",{"_2859":58065,"_25205":58020,"_17596":96719,"_5":17486,"_23867":96614,"_2386":96720},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2859":58066,"_25205":58020,"_17596":96722,"_5":17486,"_23867":96614,"_2386":96723},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2859":58067,"_25205":58067,"_5":12316,"_2386":96725,"_25540":96726,"_17596":96727,"_23867":58067},"Expón el Gateway",[40894,96033,96267],[],{"_2859":58068,"_25205":58067,"_17596":96729,"_5":17486,"_23867":58067,"_2386":96730},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2859":58069,"_25205":58067,"_5":25537,"_17596":96732,"_23867":96733,"_2386":96734},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2859":58070,"_25205":58067,"_5":25537,"_17596":96736,"_23867":96737,"_2386":96738},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2859":58071,"_25205":58067,"_5":25537,"_17596":96740,"_23867":96741,"_2386":96742},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2859":58072,"_25205":58067,"_5":25537,"_17596":96744,"_23867":96745,"_2386":41640},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#k3s",{"_2859":58073,"_25205":58067,"_5":25537,"_17596":96747,"_23867":96748,"_2386":96749},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2859":58074,"_25205":58067,"_5":25537,"_17596":96751,"_23867":96752,"_2386":96753},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2859":58075,"_25205":58067,"_5":25537,"_17596":96755,"_23867":96756,"_2386":96757},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2859":58076,"_25205":58067,"_5":25537,"_17596":96759,"_23867":96760,"_2386":96761},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2859":58077,"_25205":58067,"_5":25537,"_17596":96763,"_23867":96764,"_2386":96765},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2859":58078,"_25205":58067,"_17596":96767,"_5":17486,"_23867":96733,"_2386":96768},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2859":58079,"_25205":58067,"_17596":96770,"_5":17486,"_23867":96733,"_2386":96771},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2859":58080,"_25205":58067,"_17596":96773,"_5":17486,"_23867":96737,"_2386":96774},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2859":58081,"_25205":58067,"_17596":96776,"_5":17486,"_23867":96737,"_2386":96777},[],"Defínelo únicamente cuando:",{"_2859":58082,"_25205":58067,"_17596":96779,"_5":17486,"_23867":96737,"_2386":96780},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2859":58083,"_25205":58067,"_17596":96782,"_5":17486,"_23867":96737,"_2386":96783},[],"esa dirección está asignada a este Gateway",{"_2859":58084,"_25205":58067,"_17596":96785,"_5":17486,"_23867":96737,"_2386":96786},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2859":58085,"_25205":58067,"_17596":96788,"_5":17486,"_23867":96737,"_2386":96789},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2859":58086,"_25205":58067,"_17596":96791,"_5":17486,"_23867":96737,"_2386":96792},[],"No confundas estos valores:",{"_2859":58087,"_25205":58067,"_17596":96794,"_5":17486,"_23867":96737,"_2386":96795},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2859":58088,"_25205":58067,"_17596":96797,"_5":17486,"_23867":96737,"_2386":96798},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2859":58089,"_25205":58067,"_17596":96800,"_5":17486,"_23867":96737,"_2386":96801},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2859":58090,"_25205":58067,"_17596":96803,"_5":17486,"_23867":96741,"_2386":96804},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2859":58091,"_25205":58067,"_17596":96806,"_5":17486,"_23867":96741,"_2386":96807},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2859":58092,"_25205":58067,"_17596":96809,"_5":17486,"_23867":96745,"_2386":96810},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2859":58093,"_25205":58067,"_17596":96812,"_5":17486,"_23867":96745,"_2386":96813},[],"Para el diseño recomendado:",{"_2859":58094,"_25205":58067,"_17596":96815,"_5":17486,"_23867":96745,"_2386":96816},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2859":58095,"_25205":58067,"_17596":96818,"_5":17486,"_23867":96745,"_2386":96819},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2859":58096,"_25205":58067,"_17596":96821,"_5":17486,"_23867":96745,"_2386":96822},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2859":58097,"_25205":58067,"_17596":96824,"_5":17486,"_23867":96745,"_2386":96825},[],"Apunta DNS a la dirección accesible de la VM.",{"_2859":58098,"_25205":58067,"_17596":96827,"_5":17486,"_23867":96745,"_2386":96828},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2859":58099,"_25205":58067,"_17596":96830,"_5":17486,"_23867":96748,"_2386":96831},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2859":58100,"_25205":58067,"_17596":96833,"_5":17486,"_23867":96752,"_2386":96834},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2859":58101,"_25205":58067,"_17596":96836,"_5":17486,"_23867":96752,"_2386":96837},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2859":58102,"_25205":58067,"_17596":96839,"_5":17486,"_23867":96756,"_2386":96840},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2859":58103,"_25205":58067,"_17596":96842,"_5":17486,"_23867":96756,"_2386":96843},[],"Requisito",{"_2859":58104,"_25205":58067,"_17596":96845,"_5":17486,"_23867":96756,"_2386":96846},[],"Diseño recomendado",{"_2859":58105,"_25205":58067,"_17596":96848,"_5":17486,"_23867":96756,"_2386":96849},[],"Consecuencia",{"_2859":58106,"_25205":58067,"_17596":96851,"_5":17486,"_23867":96756,"_2386":96852},[],"Varias URL o servicios de Lamassu",{"_2859":58107,"_25205":58067,"_17596":96854,"_5":17486,"_23867":96756,"_2386":96855},[],"Un Gateway con varias rutas",{"_2859":58108,"_25205":58067,"_17596":96857,"_5":17486,"_23867":96756,"_2386":96858},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2859":58109,"_25205":58067,"_17596":96860,"_5":17486,"_23867":96756,"_2386":96861},[],"Gateways independientes e IP externas distintas",{"_2859":58110,"_25205":58067,"_17596":96863,"_5":17486,"_23867":96756,"_2386":96864},[],"Una VIP por Gateway",{"_2859":58111,"_25205":58067,"_17596":96866,"_5":17486,"_23867":96756,"_2386":96867},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2859":58112,"_25205":58067,"_17596":96869,"_5":17486,"_23867":96756,"_2386":96870},[],"Gateways independientes, un nodo y una IP",{"_2859":58113,"_25205":58067,"_17596":96872,"_5":17486,"_23867":96756,"_2386":96873},[],"Puertos externos diferentes",{"_2859":58114,"_25205":58067,"_17596":96875,"_5":17486,"_23867":96756,"_2386":96876},[],"Los clientes deben indicar puertos no estándar",{"_2859":58115,"_25205":58067,"_17596":96878,"_5":17486,"_23867":96756,"_2386":96879},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2859":58116,"_25205":58067,"_17596":96881,"_5":17486,"_23867":96756,"_2386":96882},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2859":58117,"_25205":58067,"_17596":96884,"_5":17486,"_23867":96756,"_2386":96885},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2859":58118,"_25205":58067,"_17596":96887,"_5":17486,"_23867":96756,"_2386":96888},[],"Recursos Gateway separados pero proxy compartido",{"_2859":58119,"_25205":58067,"_17596":96890,"_5":17486,"_23867":96756,"_2386":96891},[],"Modo merged Gateway de Envoy",{"_2859":58120,"_25205":58067,"_17596":96893,"_5":17486,"_23867":96756,"_2386":96894},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2859":58121,"_25205":58067,"_17596":96896,"_5":17486,"_23867":96756,"_2386":96897},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2859":58122,"_25205":58067,"_17596":96899,"_5":17486,"_23867":96756,"_2386":96900},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2859":58123,"_25205":58067,"_17596":96902,"_5":17486,"_23867":96756,"_2386":96903},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2859":58124,"_25205":58067,"_17596":96905,"_5":17486,"_23867":96756,"_2386":96906},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2859":58125,"_25205":58067,"_17596":96908,"_5":17486,"_23867":96760,"_2386":96909},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2859":58126,"_25205":58067,"_17596":96911,"_5":17486,"_23867":96760,"_2386":96912},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2859":58127,"_25205":58067,"_17596":96914,"_5":17486,"_23867":96760,"_2386":96915},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2859":58128,"_25205":58067,"_17596":96917,"_5":17486,"_23867":96760,"_2386":96918},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2859":58129,"_25205":58067,"_17596":96920,"_5":17486,"_23867":96760,"_2386":96921},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2859":58130,"_25205":58067,"_17596":96923,"_5":17486,"_23867":96764,"_2386":96924},[],"Comprueba, en orden:",{"_2859":58131,"_25205":58067,"_17596":96926,"_5":17486,"_23867":96764,"_2386":96927},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2859":58132,"_25205":58067,"_17596":96929,"_5":17486,"_23867":96764,"_2386":96930},[],"Su estado contiene la dirección esperada.",{"_2859":58133,"_25205":58067,"_17596":96932,"_5":17486,"_23867":96764,"_2386":96933},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2859":58134,"_25205":58067,"_17596":96935,"_5":17486,"_23867":96764,"_2386":96936},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2859":58135,"_25205":58067,"_17596":96938,"_5":17486,"_23867":96764,"_2386":96939},[],"DNS resuelve al endpoint accesible externamente.",{"_2859":58136,"_25205":58067,"_17596":96941,"_5":17486,"_23867":96764,"_2386":96942},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2859":58137,"_25205":58067,"_17596":96944,"_5":17486,"_23867":96764,"_2386":96945},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2859":58138,"_25205":58138,"_5":12316,"_2386":41001,"_25540":96947,"_17596":96948,"_23867":58138},[40894,96033,96267],[],{"_2859":58139,"_25205":58138,"_17596":96950,"_5":17486,"_23867":58138,"_2386":96951},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2859":58140,"_25205":58138,"_5":25537,"_17596":96953,"_23867":96954,"_2386":96955},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2859":58141,"_25205":58138,"_5":25537,"_17596":96957,"_23867":96958,"_2386":96959},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2859":58142,"_25205":58138,"_5":25537,"_17596":96961,"_23867":96962,"_2386":96963},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2859":58143,"_25205":58138,"_5":25537,"_17596":96965,"_23867":96966,"_2386":96967},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2859":58144,"_25205":58138,"_5":25537,"_17596":96969,"_23867":96970,"_2386":96971},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2859":58145,"_25205":58138,"_5":25537,"_17596":96973,"_23867":96974,"_2386":96975},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2859":58146,"_25205":58138,"_17596":96977,"_5":17486,"_23867":96954,"_2386":96978},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2859":58147,"_25205":58138,"_17596":96980,"_5":17486,"_23867":96958,"_2386":96981},[],"Flujo",{"_2859":58148,"_25205":58138,"_17596":96983,"_5":17486,"_23867":96958,"_2386":96984},[],"Úsalo para",{"_2859":58149,"_25205":58138,"_17596":96986,"_5":17486,"_23867":96958,"_2386":96987},[],"Qué instala",{"_2859":58150,"_25205":58138,"_17596":96989,"_5":17486,"_23867":96958,"_2386":41885},[],{"_2859":58151,"_25205":58138,"_17596":96991,"_5":17486,"_23867":96958,"_2386":96992},[],"Producción y entornos controlados",{"_2859":58152,"_25205":58138,"_17596":96994,"_5":17486,"_23867":96958,"_2386":96995},[],"Servicios de Lamassu y recursos de Gateway API",{"_2859":58153,"_25205":58138,"_17596":96997,"_5":17486,"_23867":96958,"_2386":41138},[],{"_2859":58154,"_25205":58138,"_17596":96999,"_5":17486,"_23867":96958,"_2386":97000},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2859":58155,"_25205":58138,"_17596":97002,"_5":17486,"_23867":96958,"_2386":97003},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2859":58156,"_25205":58138,"_17596":97005,"_5":17486,"_23867":96962,"_2386":97006},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2859":58157,"_25205":58138,"_17596":97008,"_5":17486,"_23867":96962,"_2386":97009},[],"Área",{"_2859":58158,"_25205":58138,"_17596":97011,"_5":17486,"_23867":96962,"_2386":97012},[],"El chart de Lamassu proporciona",{"_2859":58159,"_25205":58138,"_17596":97014,"_5":17486,"_23867":96962,"_2386":97015},[],"Tú proporcionas",{"_2859":58160,"_25205":58138,"_17596":97017,"_5":17486,"_23867":96962,"_2386":97018},[],"Aplicaciones Lamassu",{"_2859":58161,"_25205":58138,"_17596":97020,"_5":17486,"_23867":96962,"_2386":97021},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2859":58162,"_25205":58138,"_17596":97023,"_5":17486,"_23867":96962,"_2386":97024},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2859":58163,"_25205":58138,"_17596":97026,"_5":17486,"_23867":96962,"_2386":97027},[],"Datos PostgreSQL",{"_2859":58164,"_25205":58138,"_17596":97029,"_5":17486,"_23867":96962,"_2386":97030},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2859":58165,"_25205":58138,"_17596":97032,"_5":17486,"_23867":96962,"_2386":97033},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2859":58166,"_25205":58138,"_17596":97035,"_5":17486,"_23867":96962,"_2386":97036},[],"Mensajería",{"_2859":58167,"_25205":58138,"_17596":97038,"_5":17486,"_23867":96962,"_2386":97039},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2859":58168,"_25205":58138,"_17596":97041,"_5":17486,"_23867":96962,"_2386":97042},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2859":58169,"_25205":58138,"_17596":97044,"_5":17486,"_23867":96962,"_2386":97045},[],"Identidad",{"_2859":58170,"_25205":58138,"_17596":97047,"_5":17486,"_23867":96962,"_2386":97048},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2859":58171,"_25205":58138,"_17596":97050,"_5":17486,"_23867":96962,"_2386":97051},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2859":58172,"_25205":58138,"_17596":97053,"_5":17486,"_23867":96962,"_2386":97054},[],"Enrutamiento externo",{"_2859":58173,"_25205":58138,"_17596":97056,"_5":17486,"_23867":96962,"_2386":97057},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2859":58174,"_25205":58138,"_17596":97059,"_5":17486,"_23867":96962,"_2386":97060},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2859":58175,"_25205":58138,"_17596":97062,"_5":17486,"_23867":96962,"_2386":41959},[],{"_2859":58176,"_25205":58138,"_17596":97064,"_5":17486,"_23867":96962,"_2386":97065},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2859":58177,"_25205":58138,"_17596":97067,"_5":17486,"_23867":96962,"_2386":97068},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2859":58178,"_25205":58138,"_17596":97070,"_5":17486,"_23867":96962,"_2386":97071},[],"Datos persistentes de la aplicación",{"_2859":58179,"_25205":58138,"_17596":97073,"_5":17486,"_23867":96962,"_2386":97074},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2859":58180,"_25205":58138,"_17596":97076,"_5":17486,"_23867":96962,"_2386":97077},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2859":58181,"_25205":58138,"_17596":97079,"_5":17486,"_23867":96962,"_2386":97080},[],"Integraciones opcionales",{"_2859":58182,"_25205":58138,"_17596":97082,"_5":17486,"_23867":96962,"_2386":97083},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2859":58183,"_25205":58138,"_17596":97085,"_5":17486,"_23867":96962,"_2386":97086},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2859":58184,"_25205":58138,"_17596":97088,"_5":17486,"_23867":96962,"_2386":97089},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2859":58185,"_25205":58138,"_17596":97091,"_5":17486,"_23867":96962,"_2386":97092},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2859":58186,"_25205":58138,"_17596":97094,"_5":17486,"_23867":96966,"_2386":97095},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2859":58187,"_25205":58138,"_17596":97097,"_5":17486,"_23867":96966,"_2386":97098},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2859":58188,"_25205":58138,"_17596":97100,"_5":17486,"_23867":96970,"_2386":97101},[],"Kubernetes 1.24 o posterior",{"_2859":58189,"_25205":58138,"_17596":97103,"_5":17486,"_23867":96970,"_2386":97104},[],"Helm 3.2 o posterior",{"_2859":58190,"_25205":58138,"_17596":97106,"_5":17486,"_23867":96970,"_2386":97107},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2859":58191,"_25205":58138,"_17596":97109,"_5":17486,"_23867":96970,"_2386":97110},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2859":58192,"_25205":58138,"_17596":97112,"_5":17486,"_23867":96970,"_2386":97113},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2859":58193,"_25205":58138,"_17596":97115,"_5":17486,"_23867":96970,"_2386":97116},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2859":58194,"_25205":58138,"_17596":97118,"_5":17486,"_23867":96970,"_2386":97119},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2859":58195,"_25205":58138,"_17596":97121,"_5":17486,"_23867":96974,"_2386":97122},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2859":58196,"_25205":58138,"_17596":97124,"_5":17486,"_23867":96974,"_2386":97125},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2859":58197,"_25205":58138,"_17596":97127,"_5":17486,"_23867":96974,"_2386":97128},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2859":58198,"_25205":58198,"_5":12316,"_2386":97130,"_25540":97131,"_17596":97133,"_23867":58198},"Resolución de problemas de despliegue",[40894,96033,97132],"Operación",[],{"_2859":58199,"_25205":58198,"_17596":97135,"_5":17486,"_23867":58198,"_2386":97136},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2859":58200,"_25205":58198,"_5":25537,"_17596":97138,"_23867":97139,"_2386":97140},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2859":58201,"_25205":58198,"_5":25537,"_17596":97142,"_23867":97143,"_2386":97144},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2859":58202,"_25205":58198,"_5":25537,"_17596":97146,"_23867":97147,"_2386":97148},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2859":58203,"_25205":58198,"_5":25537,"_17596":97150,"_23867":97151,"_2386":97152},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2859":58204,"_25205":58198,"_5":25537,"_17596":97154,"_23867":97155,"_2386":97156},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2859":58205,"_25205":58198,"_5":25537,"_17596":97158,"_23867":97159,"_2386":97160},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2859":58206,"_25205":58198,"_5":25537,"_17596":97162,"_23867":97163,"_2386":97164},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2859":58207,"_25205":58198,"_5":25537,"_17596":97166,"_23867":97167,"_2386":97168},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2859":58208,"_25205":58198,"_5":25537,"_17596":97170,"_23867":97171,"_2386":97172},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2859":58209,"_25205":58198,"_5":25537,"_17596":97174,"_23867":97175,"_2386":97176},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2859":58210,"_25205":58198,"_5":25537,"_17596":97178,"_23867":97179,"_2386":97180},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2859":58211,"_25205":58198,"_5":25537,"_17596":97182,"_23867":97183,"_2386":97184},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2859":58212,"_25205":58198,"_17596":97186,"_5":17486,"_23867":58198,"_2386":97187},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2859":58213,"_25205":58198,"_17596":97189,"_5":17486,"_23867":97143,"_2386":97190},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2859":58214,"_25205":58198,"_17596":97192,"_5":17486,"_23867":97147,"_2386":97193},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2859":58215,"_25205":58198,"_17596":97195,"_5":17486,"_23867":97151,"_2386":97196},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2859":58216,"_25205":58198,"_17596":97198,"_5":17486,"_23867":97155,"_2386":97199},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2859":58217,"_25205":58198,"_17596":97201,"_5":17486,"_23867":97159,"_2386":97202},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2859":58218,"_25205":58198,"_17596":97204,"_5":17486,"_23867":97163,"_2386":97205},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2859":58219,"_25205":58198,"_17596":97207,"_5":17486,"_23867":97163,"_2386":97208},[],"Ejecuta también la prueba de conectividad del chart:",{"_2859":58220,"_25205":58198,"_17596":97210,"_5":17486,"_23867":97163,"_2386":97211},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2859":58221,"_25205":58198,"_17596":97213,"_5":17486,"_23867":97163,"_2386":97214},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2859":58222,"_25205":58198,"_17596":97216,"_5":17486,"_23867":97167,"_2386":97217},[],"Si recibes un 401:",{"_2859":58223,"_25205":58198,"_17596":97219,"_5":17486,"_23867":97167,"_2386":97220},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2859":58224,"_25205":58198,"_17596":97222,"_5":17486,"_23867":97167,"_2386":97223},[],"verifica emisor, audiencia y expiración del token;",{"_2859":58225,"_25205":58198,"_17596":97225,"_5":17486,"_23867":97167,"_2386":97226},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2859":58226,"_25205":58198,"_17596":97228,"_5":17486,"_23867":97167,"_2386":97229},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2859":58227,"_25205":58198,"_17596":97231,"_5":17486,"_23867":97167,"_2386":97232},[],"Si el login termina pero las APIs devuelven 403:",{"_2859":58228,"_25205":58198,"_17596":97234,"_5":17486,"_23867":97167,"_2386":97235},[],"inspecciona los claims reales del token;",{"_2859":58229,"_25205":58198,"_17596":97237,"_5":17486,"_23867":97167,"_2386":97238},[],"confirma que coinciden con un principal activo;",{"_2859":58230,"_25205":58198,"_17596":97240,"_5":17486,"_23867":97167,"_2386":97241},[],"revisa las políticas concedidas al principal;",{"_2859":58231,"_25205":58198,"_17596":97243,"_5":17486,"_23867":97167,"_2386":97244},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2859":58232,"_25205":58198,"_17596":97246,"_5":17486,"_23867":97167,"_2386":97247},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2859":58233,"_25205":58198,"_17596":97249,"_5":17486,"_23867":97171,"_2386":97250},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2859":58234,"_25205":58198,"_17596":97252,"_5":17486,"_23867":97171,"_2386":97253},[],"Localiza el pod y Service de authz.",{"_2859":58235,"_25205":58198,"_17596":97255,"_5":17486,"_23867":97171,"_2386":97256},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2859":58236,"_25205":58198,"_17596":97258,"_5":17486,"_23867":97171,"_2386":97259},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2859":58237,"_25205":58198,"_17596":97261,"_5":17486,"_23867":97171,"_2386":97262},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2859":58238,"_25205":58198,"_17596":97264,"_5":17486,"_23867":97171,"_2386":97265},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2859":58239,"_25205":58198,"_17596":97267,"_5":17486,"_23867":97175,"_2386":97268},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2859":58240,"_25205":58198,"_17596":97270,"_5":17486,"_23867":97175,"_2386":97271},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2859":58241,"_25205":58198,"_17596":97273,"_5":17486,"_23867":97175,"_2386":97274},[],"volumen persistente sin enlazar;",{"_2859":58242,"_25205":58198,"_17596":97276,"_5":17486,"_23867":97175,"_2386":97277},[],"imagen inaccesible o política de pull incorrecta;",{"_2859":58243,"_25205":58198,"_17596":97279,"_5":17486,"_23867":97175,"_2386":97280},[],"configuración inválida del motor criptográfico;",{"_2859":58244,"_25205":58198,"_17596":97282,"_5":17486,"_23867":97175,"_2386":97283},[],"límites de CPU o memoria demasiado bajos;",{"_2859":58245,"_25205":58198,"_17596":97285,"_5":17486,"_23867":97175,"_2386":97286},[],"migración previa incompleta.",{"_2859":58246,"_25205":58198,"_17596":97288,"_5":17486,"_23867":97175,"_2386":97289},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2859":58247,"_25205":58198,"_17596":97291,"_5":17486,"_23867":97175,"_2386":97292},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2859":58248,"_25205":58198,"_17596":97294,"_5":17486,"_23867":97179,"_2386":97295},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2859":58249,"_25205":58198,"_17596":97297,"_5":17486,"_23867":97179,"_2386":97298},[],"verifica que esté habilitado en el servicio emisor;",{"_2859":58250,"_25205":58198,"_17596":97300,"_5":17486,"_23867":97179,"_2386":97301},[],"comprueba conectividad y credenciales AMQP;",{"_2859":58251,"_25205":58198,"_17596":97303,"_5":17486,"_23867":97179,"_2386":97304},[],"revisa exchange, routing key, colas y consumidores;",{"_2859":58252,"_25205":58198,"_17596":97306,"_5":17486,"_23867":97179,"_2386":97307},[],"inspecciona dead-letter queues;",{"_2859":58253,"_25205":58198,"_17596":97309,"_5":17486,"_23867":97179,"_2386":97310},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2859":58254,"_25205":58198,"_17596":97312,"_5":17486,"_23867":97179,"_2386":97313},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2859":58255,"_25205":58198,"_17596":97315,"_5":17486,"_23867":97183,"_2386":97316},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2859":58256,"_25205":58198,"_17596":97318,"_5":17486,"_23867":97183,"_2386":97319},[],"Antes de cerrar una incidencia, guarda:",{"_2859":58257,"_25205":58198,"_17596":97321,"_5":17486,"_23867":97183,"_2386":97322},[],"causa confirmada;",{"_2859":58258,"_25205":58198,"_17596":97324,"_5":17486,"_23867":97183,"_2386":97325},[],"alcance temporal y recursos afectados;",{"_2859":58259,"_25205":58198,"_17596":97327,"_5":17486,"_23867":97183,"_2386":97328},[],"comandos o consultas utilizados;",{"_2859":58260,"_25205":58198,"_17596":97330,"_5":17486,"_23867":97183,"_2386":97331},[],"cambio aplicado y forma de revertirlo;",{"_2859":58261,"_25205":58198,"_17596":97333,"_5":17486,"_23867":97183,"_2386":97334},[],"validación desde un consumidor;",{"_2859":58262,"_25205":58198,"_17596":97336,"_5":17486,"_23867":97183,"_2386":97337},[],"acción preventiva y propietario.",{"_2859":58263,"_25205":58263,"_5":12316,"_2386":97339,"_25540":97340,"_17596":97343,"_23867":58263},"Control de acceso",[40894,97341,97342],"Plataforma","Administración",[],{"_2859":58264,"_25205":58263,"_17596":97345,"_5":17486,"_23867":58263,"_2386":97346},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2859":58265,"_25205":58263,"_5":25537,"_17596":97348,"_23867":97349,"_2386":97350},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2859":58266,"_25205":58263,"_5":25537,"_17596":97352,"_23867":97353,"_2386":97354},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2859":58267,"_25205":58263,"_5":25537,"_17596":97356,"_23867":97357,"_2386":97358},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2859":58268,"_25205":58263,"_5":25537,"_17596":97360,"_23867":97361,"_2386":97362},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2859":58269,"_25205":58263,"_5":25537,"_17596":97364,"_23867":97365,"_2386":97366},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2859":58270,"_25205":58263,"_5":25537,"_17596":97368,"_23867":97369,"_2386":97370},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2859":58271,"_25205":58263,"_5":25537,"_17596":97372,"_23867":97373,"_2386":97374},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2859":58272,"_25205":58263,"_5":25537,"_17596":97376,"_23867":97377,"_2386":97378},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2859":58273,"_25205":58263,"_5":25537,"_17596":97380,"_23867":97381,"_2386":97382},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2859":58274,"_25205":58263,"_5":25537,"_17596":97384,"_23867":97385,"_2386":97386},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2859":58275,"_25205":58263,"_5":25537,"_17596":97388,"_23867":97389,"_2386":97390},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2859":58276,"_25205":58263,"_5":25537,"_17596":97392,"_23867":97393,"_2386":97394},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2859":58277,"_25205":58263,"_5":25537,"_17596":97396,"_23867":97397,"_2386":97398},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2859":58278,"_25205":58263,"_5":25537,"_17596":97400,"_23867":97401,"_2386":97402},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2859":58279,"_25205":58263,"_5":25537,"_17596":97404,"_23867":97405,"_2386":97406},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2859":58280,"_25205":58263,"_5":25537,"_17596":97408,"_23867":97409,"_2386":96603},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2859":58281,"_25205":58263,"_5":25537,"_17596":97411,"_23867":97412,"_2386":97413},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2859":58282,"_25205":58263,"_5":25537,"_17596":97415,"_23867":97416,"_2386":97417},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2859":58283,"_25205":58263,"_5":25537,"_17596":97419,"_23867":97420,"_2386":97421},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2859":58284,"_25205":58263,"_5":25537,"_17596":97423,"_23867":97424,"_2386":97425},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2859":58285,"_25205":58263,"_5":25537,"_17596":97427,"_23867":97428,"_2386":97429},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2859":58286,"_25205":58263,"_5":25537,"_17596":97431,"_23867":97432,"_2386":97433},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2859":58287,"_25205":58263,"_5":25537,"_17596":97435,"_23867":97436,"_2386":97437},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2859":58288,"_25205":58263,"_5":25537,"_17596":97439,"_23867":97440,"_2386":97441},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2859":58289,"_25205":58263,"_5":25537,"_17596":97443,"_23867":97444,"_2386":97445},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2859":58290,"_25205":58263,"_5":25537,"_17596":97447,"_23867":97448,"_2386":97449},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2859":58291,"_25205":58263,"_5":25537,"_17596":97451,"_23867":97452,"_2386":97453},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2859":58292,"_25205":58263,"_5":25537,"_17596":97455,"_23867":97456,"_2386":97457},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2859":58293,"_25205":58263,"_5":25537,"_17596":97459,"_23867":97460,"_2386":97461},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2859":58294,"_25205":58263,"_5":25537,"_17596":97463,"_23867":97464,"_2386":97465},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2859":58295,"_25205":58263,"_5":25537,"_17596":97467,"_23867":97468,"_2386":97469},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2859":58296,"_25205":58263,"_17596":97471,"_5":17486,"_23867":58263,"_2386":97472},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2859":58297,"_25205":58263,"_17596":97474,"_5":17486,"_23867":58263,"_2386":97475},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2859":58298,"_25205":58263,"_17596":97477,"_5":17486,"_23867":58263,"_2386":97478},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2859":58299,"_25205":58263,"_17596":97480,"_5":17486,"_23867":97349,"_2386":97481},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2859":58300,"_25205":58263,"_17596":97483,"_5":17486,"_23867":97349,"_2386":97484},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2859":58301,"_25205":58263,"_17596":97486,"_5":17486,"_23867":97349,"_2386":97487},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2859":58302,"_25205":58263,"_17596":97489,"_5":17486,"_23867":97349,"_2386":97490},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2859":58303,"_25205":58263,"_17596":97492,"_5":17486,"_23867":97349,"_2386":97493},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2859":58304,"_25205":58263,"_17596":97495,"_5":17486,"_23867":97349,"_2386":97496},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2859":58305,"_25205":58263,"_17596":97498,"_5":17486,"_23867":97353,"_2386":97499},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2859":58306,"_25205":58263,"_17596":97501,"_5":17486,"_23867":97353,"_2386":97502},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2859":58307,"_25205":58263,"_17596":97504,"_5":17486,"_23867":97357,"_2386":97505},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2859":58308,"_25205":58263,"_17596":97507,"_5":17486,"_23867":97357,"_2386":97508},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2859":58309,"_25205":58263,"_17596":97510,"_5":17486,"_23867":97357,"_2386":97511},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2859":58310,"_25205":58263,"_17596":97513,"_5":17486,"_23867":97357,"_2386":97514},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2859":58311,"_25205":58263,"_17596":97516,"_5":17486,"_23867":97357,"_2386":97517},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2859":58312,"_25205":58263,"_17596":97519,"_5":17486,"_23867":97357,"_2386":97520},[],"Carga por separado las políticas concedidas a cada principal.",{"_2859":58313,"_25205":58263,"_17596":97522,"_5":17486,"_23867":97357,"_2386":97523},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2859":58314,"_25205":58263,"_17596":97525,"_5":17486,"_23867":97357,"_2386":97526},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2859":58315,"_25205":58263,"_17596":97528,"_5":17486,"_23867":97357,"_2386":97529},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2859":58316,"_25205":58263,"_17596":97531,"_5":17486,"_23867":97357,"_2386":97532},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2859":58317,"_25205":58263,"_17596":97534,"_5":17486,"_23867":97357,"_2386":97535},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2859":58318,"_25205":58263,"_17596":97537,"_5":17486,"_23867":97357,"_2386":97538},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2859":58319,"_25205":58263,"_17596":97540,"_5":17486,"_23867":97361,"_2386":97541},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2859":58320,"_25205":58263,"_17596":97543,"_5":17486,"_23867":97361,"_2386":97544},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2859":58321,"_25205":58263,"_17596":97546,"_5":17486,"_23867":97361,"_2386":97547},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2859":58322,"_25205":58263,"_17596":97549,"_5":17486,"_23867":97361,"_2386":97550},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2859":58323,"_25205":58263,"_17596":97552,"_5":17486,"_23867":97361,"_2386":97553},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2859":58324,"_25205":58263,"_17596":97555,"_5":17486,"_23867":97361,"_2386":97556},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2859":58325,"_25205":58263,"_17596":97558,"_5":17486,"_23867":97361,"_2386":97559},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2859":58326,"_25205":58263,"_17596":97561,"_5":17486,"_23867":97361,"_2386":97562},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2859":58327,"_25205":58263,"_17596":97564,"_5":17486,"_23867":97365,"_2386":97565},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2859":58328,"_25205":58263,"_17596":97567,"_5":17486,"_23867":97365,"_2386":97568},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2859":58329,"_25205":58263,"_17596":97570,"_5":17486,"_23867":97365,"_2386":97571},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2859":58330,"_25205":58263,"_17596":97573,"_5":17486,"_23867":97365,"_2386":97574},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2859":58331,"_25205":58263,"_17596":97576,"_5":17486,"_23867":97365,"_2386":97577},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2859":58332,"_25205":58263,"_17596":97579,"_5":17486,"_23867":97365,"_2386":97580},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2859":58333,"_25205":58263,"_17596":97582,"_5":17486,"_23867":97365,"_2386":97583},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2859":58334,"_25205":58263,"_17596":97585,"_5":17486,"_23867":97365,"_2386":97586},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2859":58335,"_25205":58263,"_17596":97588,"_5":17486,"_23867":97365,"_2386":97589},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2859":58336,"_25205":58263,"_17596":97591,"_5":17486,"_23867":97365,"_2386":97592},[],"Las acciones se dividen en dos grupos:",{"_2859":58337,"_25205":58263,"_17596":97594,"_5":17486,"_23867":97365,"_2386":97595},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2859":58338,"_25205":58263,"_17596":97597,"_5":17486,"_23867":97365,"_2386":97598},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2859":58339,"_25205":58263,"_17596":97600,"_5":17486,"_23867":97365,"_2386":97601},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2859":58340,"_25205":58263,"_17596":97603,"_5":17486,"_23867":97369,"_2386":97604},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2859":58341,"_25205":58263,"_17596":97606,"_5":17486,"_23867":97369,"_2386":97607},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2859":58342,"_25205":58263,"_17596":97609,"_5":17486,"_23867":97369,"_2386":97610},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2859":58343,"_25205":58263,"_17596":97612,"_5":17486,"_23867":97373,"_2386":97613},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2859":58344,"_25205":58263,"_17596":97615,"_5":17486,"_23867":97373,"_2386":97616},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2859":58345,"_25205":58263,"_17596":97618,"_5":17486,"_23867":97373,"_2386":97619},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2859":58346,"_25205":58263,"_17596":97621,"_5":17486,"_23867":97373,"_2386":97622},[],"Los operadores implementados son:",{"_2859":58347,"_25205":58263,"_17596":97624,"_5":17486,"_23867":97373,"_2386":97625},[],"`equals`, para igualdad exacta;",{"_2859":58348,"_25205":58263,"_17596":97627,"_5":17486,"_23867":97373,"_2386":97628},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2859":58349,"_25205":58263,"_17596":97630,"_5":17486,"_23867":97373,"_2386":97631},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2859":58350,"_25205":58263,"_17596":97633,"_5":17486,"_23867":97373,"_2386":97634},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2859":58351,"_25205":58263,"_17596":97636,"_5":17486,"_23867":97377,"_2386":97637},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2859":58352,"_25205":58263,"_17596":97639,"_5":17486,"_23867":97377,"_2386":97640},[],"Los modos disponibles son:",{"_2859":58353,"_25205":58263,"_17596":97642,"_5":17486,"_23867":97377,"_2386":97643},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2859":58354,"_25205":58263,"_17596":97645,"_5":17486,"_23867":97377,"_2386":97646},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2859":58355,"_25205":58263,"_17596":97648,"_5":17486,"_23867":97377,"_2386":97649},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2859":58356,"_25205":58263,"_17596":97651,"_5":17486,"_23867":97377,"_2386":97652},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2859":58357,"_25205":58263,"_17596":97654,"_5":17486,"_23867":97377,"_2386":97655},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2859":58358,"_25205":58263,"_17596":97657,"_5":17486,"_23867":97377,"_2386":97658},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2859":58359,"_25205":58263,"_17596":97660,"_5":17486,"_23867":97381,"_2386":97661},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2859":58360,"_25205":58263,"_17596":97663,"_5":17486,"_23867":97381,"_2386":97664},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2859":58361,"_25205":58263,"_17596":97666,"_5":17486,"_23867":97381,"_2386":97667},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2859":58362,"_25205":58263,"_17596":97669,"_5":17486,"_23867":97381,"_2386":97670},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2859":58363,"_25205":58263,"_17596":97672,"_5":17486,"_23867":97389,"_2386":97673},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2859":58364,"_25205":58263,"_17596":97675,"_5":17486,"_23867":97389,"_2386":97676},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2859":58365,"_25205":58263,"_17596":97678,"_5":17486,"_23867":97393,"_2386":97679},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2859":58366,"_25205":58263,"_17596":97681,"_5":17486,"_23867":97393,"_2386":97682},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2859":58367,"_25205":58263,"_17596":97684,"_5":17486,"_23867":97397,"_2386":97685},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2859":58368,"_25205":58263,"_17596":97687,"_5":17486,"_23867":97397,"_2386":97688},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2859":58369,"_25205":58263,"_17596":97690,"_5":17486,"_23867":97397,"_2386":97691},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2859":58370,"_25205":58263,"_17596":97693,"_5":17486,"_23867":97401,"_2386":97694},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2859":58371,"_25205":58263,"_17596":97696,"_5":17486,"_23867":97401,"_2386":97697},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2859":58372,"_25205":58263,"_17596":97699,"_5":17486,"_23867":97401,"_2386":97700},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2859":58373,"_25205":58263,"_17596":97702,"_5":17486,"_23867":97401,"_2386":97703},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2859":58374,"_25205":58263,"_17596":97705,"_5":17486,"_23867":97401,"_2386":97706},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2859":58375,"_25205":58263,"_17596":97708,"_5":17486,"_23867":97401,"_2386":97709},[],"Ten en cuenta que:",{"_2859":58376,"_25205":58263,"_17596":97711,"_5":17486,"_23867":97401,"_2386":97712},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2859":58377,"_25205":58263,"_17596":97714,"_5":17486,"_23867":97401,"_2386":97715},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2859":58378,"_25205":58263,"_17596":97717,"_5":17486,"_23867":97401,"_2386":97718},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2859":58379,"_25205":58263,"_17596":97720,"_5":17486,"_23867":97405,"_2386":97721},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2859":58380,"_25205":58263,"_17596":97723,"_5":17486,"_23867":97405,"_2386":97724},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2859":58381,"_25205":58263,"_17596":97726,"_5":17486,"_23867":97405,"_2386":97727},[],"acceso completo y de solo lectura a KMS;",{"_2859":58382,"_25205":58263,"_17596":97729,"_5":17486,"_23867":97405,"_2386":97730},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2859":58383,"_25205":58263,"_17596":97732,"_5":17486,"_23867":97405,"_2386":97733},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2859":58384,"_25205":58263,"_17596":97735,"_5":17486,"_23867":97405,"_2386":97736},[],"acceso a la interfaz;",{"_2859":58385,"_25205":58263,"_17596":97738,"_5":17486,"_23867":97405,"_2386":97739},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2859":58386,"_25205":58263,"_17596":97741,"_5":17486,"_23867":97405,"_2386":97742},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2859":58387,"_25205":58263,"_17596":97744,"_5":17486,"_23867":97405,"_2386":97745},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2859":58388,"_25205":58263,"_17596":97747,"_5":17486,"_23867":97409,"_2386":97748},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2859":58389,"_25205":58263,"_17596":97750,"_5":17486,"_23867":97409,"_2386":97751},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2859":58390,"_25205":58263,"_17596":97753,"_5":17486,"_23867":97409,"_2386":97754},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2859":58391,"_25205":58263,"_17596":97756,"_5":17486,"_23867":97412,"_2386":97757},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2859":58392,"_25205":58263,"_17596":97759,"_5":17486,"_23867":97416,"_2386":97760},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2859":58393,"_25205":58263,"_17596":97762,"_5":17486,"_23867":97420,"_2386":97763},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2859":58394,"_25205":58263,"_17596":97765,"_5":17486,"_23867":97424,"_2386":97766},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2859":58395,"_25205":58263,"_17596":97768,"_5":17486,"_23867":97428,"_2386":97769},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2859":58396,"_25205":58263,"_17596":97771,"_5":17486,"_23867":97432,"_2386":97772},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2859":58397,"_25205":58263,"_17596":97774,"_5":17486,"_23867":97432,"_2386":97775},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2859":58398,"_25205":58263,"_17596":97777,"_5":17486,"_23867":97436,"_2386":97778},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2859":58399,"_25205":58263,"_17596":97780,"_5":17486,"_23867":97436,"_2386":97781},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2859":58400,"_25205":58263,"_17596":97783,"_5":17486,"_23867":97436,"_2386":97784},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2859":58401,"_25205":58263,"_17596":97786,"_5":17486,"_23867":97436,"_2386":97787},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2859":58402,"_25205":58263,"_17596":97789,"_5":17486,"_23867":97436,"_2386":97790},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2859":58403,"_25205":58263,"_17596":97792,"_5":17486,"_23867":97436,"_2386":97793},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2859":58404,"_25205":58263,"_17596":97795,"_5":17486,"_23867":97436,"_2386":97796},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2859":58405,"_25205":58263,"_17596":97798,"_5":17486,"_23867":97436,"_2386":97799},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2859":58406,"_25205":58263,"_17596":97801,"_5":17486,"_23867":97440,"_2386":97802},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2859":58407,"_25205":58263,"_17596":97804,"_5":17486,"_23867":97440,"_2386":97805},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2859":58408,"_25205":58263,"_17596":97807,"_5":17486,"_23867":97440,"_2386":97808},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2859":58409,"_25205":58263,"_17596":97810,"_5":17486,"_23867":97444,"_2386":97811},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2859":58410,"_25205":58263,"_17596":97813,"_5":17486,"_23867":97444,"_2386":97814},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2859":58411,"_25205":58263,"_17596":97816,"_5":17486,"_23867":97444,"_2386":97817},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2859":58412,"_25205":58263,"_17596":97819,"_5":17486,"_23867":97444,"_2386":97820},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2859":58413,"_25205":58263,"_17596":97822,"_5":17486,"_23867":97444,"_2386":97823},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2859":58414,"_25205":58263,"_17596":97825,"_5":17486,"_23867":97444,"_2386":97826},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2859":58415,"_25205":58263,"_17596":97828,"_5":17486,"_23867":97444,"_2386":97829},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2859":58416,"_25205":58263,"_17596":97831,"_5":17486,"_23867":97444,"_2386":97832},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2859":58417,"_25205":58263,"_17596":97834,"_5":17486,"_23867":97452,"_2386":97835},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2859":58418,"_25205":58263,"_17596":97837,"_5":17486,"_23867":97456,"_2386":97838},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2859":58419,"_25205":58263,"_17596":97840,"_5":17486,"_23867":97456,"_2386":97841},[],"que exista un principal activo del tipo correcto;",{"_2859":58420,"_25205":58263,"_17596":97843,"_5":17486,"_23867":97456,"_2386":97844},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2859":58421,"_25205":58263,"_17596":97846,"_5":17486,"_23867":97456,"_2386":97847},[],"que todas las condiciones del principal se cumplan;",{"_2859":58422,"_25205":58263,"_17596":97849,"_5":17486,"_23867":97456,"_2386":97850},[],"que el principal tenga concedida la política esperada;",{"_2859":58423,"_25205":58263,"_17596":97852,"_5":17486,"_23867":97456,"_2386":97853},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2859":58424,"_25205":58263,"_17596":97855,"_5":17486,"_23867":97456,"_2386":97856},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2859":58425,"_25205":58263,"_17596":97858,"_5":17486,"_23867":97456,"_2386":97859},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2859":58426,"_25205":58263,"_17596":97861,"_5":17486,"_23867":97460,"_2386":97862},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2859":58427,"_25205":58263,"_17596":97864,"_5":17486,"_23867":97464,"_2386":97865},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2859":58428,"_25205":58263,"_17596":97867,"_5":17486,"_23867":97468,"_2386":97868},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2859":58429,"_25205":58263,"_17596":97870,"_5":17486,"_23867":97468,"_2386":97871},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2859":58430,"_25205":58430,"_5":12316,"_2386":97873,"_25540":97874,"_17596":97875,"_23867":58430},"Alertas y suscripciones",[40894,97341,97342],[],{"_2859":58431,"_25205":58430,"_17596":97877,"_5":17486,"_23867":58430,"_2386":97878},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2859":58432,"_25205":58430,"_5":25537,"_17596":97880,"_23867":97881,"_2386":97882},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2859":58433,"_25205":58430,"_5":25537,"_17596":97884,"_23867":97885,"_2386":97886},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2859":58434,"_25205":58430,"_5":25537,"_17596":97888,"_23867":97889,"_2386":97890},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2859":58435,"_25205":58430,"_5":25537,"_17596":97892,"_23867":97893,"_2386":97894},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2859":58436,"_25205":58430,"_5":25537,"_17596":97896,"_23867":97897,"_2386":97898},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2859":58437,"_25205":58430,"_5":25537,"_17596":97900,"_23867":97901,"_2386":97902},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2859":58438,"_25205":58430,"_5":25537,"_17596":97904,"_23867":97905,"_2386":97906},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2859":58439,"_25205":58430,"_5":25537,"_17596":97908,"_23867":97909,"_2386":97910},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2859":58440,"_25205":58430,"_5":25537,"_17596":97912,"_23867":97913,"_2386":97914},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2859":58441,"_25205":58430,"_5":25537,"_17596":97916,"_23867":97917,"_2386":97918},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2859":58442,"_25205":58430,"_17596":97920,"_5":17486,"_23867":58430,"_2386":97921},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2859":58443,"_25205":58430,"_17596":97923,"_5":17486,"_23867":97881,"_2386":97924},[],"Un servicio publica un evento de dominio.",{"_2859":58444,"_25205":58430,"_17596":97926,"_5":17486,"_23867":97881,"_2386":97927},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2859":58445,"_25205":58430,"_17596":97929,"_5":17486,"_23867":97881,"_2386":97930},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2859":58446,"_25205":58430,"_17596":97932,"_5":17486,"_23867":97881,"_2386":97933},[],"Lamassu entrega el evento al canal configurado.",{"_2859":58447,"_25205":58430,"_17596":97935,"_5":17486,"_23867":97881,"_2386":97936},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2859":58448,"_25205":58430,"_17596":97938,"_5":17486,"_23867":97885,"_2386":97939},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2859":58449,"_25205":58430,"_17596":97941,"_5":17486,"_23867":97885,"_2386":97942},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2859":58450,"_25205":58430,"_17596":97944,"_5":17486,"_23867":97885,"_2386":97945},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2859":58451,"_25205":58430,"_17596":97947,"_5":17486,"_23867":97885,"_2386":97948},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2859":58452,"_25205":58430,"_17596":97950,"_5":17486,"_23867":97885,"_2386":97951},[],"`apikey_options` necesita `header` y `key`.",{"_2859":58453,"_25205":58430,"_17596":97953,"_5":17486,"_23867":97885,"_2386":97954},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2859":58454,"_25205":58430,"_17596":97956,"_5":17486,"_23867":97885,"_2386":97957},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2859":58455,"_25205":58430,"_17596":97959,"_5":17486,"_23867":97885,"_2386":97960},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2859":58456,"_25205":58430,"_17596":97962,"_5":17486,"_23867":97893,"_2386":97963},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2859":58457,"_25205":58430,"_17596":97965,"_5":17486,"_23867":97897,"_2386":97966},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2859":58458,"_25205":58430,"_17596":97968,"_5":17486,"_23867":97901,"_2386":97969},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2859":58459,"_25205":58430,"_17596":97971,"_5":17486,"_23867":97901,"_2386":97972},[],"**None** notifica todas las instancias del evento.",{"_2859":58460,"_25205":58430,"_17596":97974,"_5":17486,"_23867":97901,"_2386":97975},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2859":58461,"_25205":58430,"_17596":97977,"_5":17486,"_23867":97901,"_2386":97978},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2859":58462,"_25205":58430,"_17596":97980,"_5":17486,"_23867":97901,"_2386":97981},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2859":58463,"_25205":58430,"_17596":97983,"_5":17486,"_23867":97901,"_2386":97984},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2859":58464,"_25205":58430,"_17596":97986,"_5":17486,"_23867":97905,"_2386":97987},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2859":58465,"_25205":58430,"_17596":97989,"_5":17486,"_23867":97909,"_2386":97990},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2859":58466,"_25205":58430,"_17596":97992,"_5":17486,"_23867":97909,"_2386":97993},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2859":58467,"_25205":58430,"_17596":97995,"_5":17486,"_23867":97909,"_2386":97996},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2859":58468,"_25205":58430,"_17596":97998,"_5":17486,"_23867":97909,"_2386":97999},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2859":58469,"_25205":58430,"_17596":98001,"_5":17486,"_23867":97909,"_2386":98002},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2859":58470,"_25205":58430,"_17596":98004,"_5":17486,"_23867":97909,"_2386":98005},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2859":58471,"_25205":58430,"_17596":98007,"_5":17486,"_23867":97909,"_2386":98008},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2859":58472,"_25205":58430,"_17596":98010,"_5":17486,"_23867":97909,"_2386":98011},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2859":58473,"_25205":58430,"_17596":98013,"_5":17486,"_23867":97913,"_2386":98014},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2859":58474,"_25205":58430,"_17596":98016,"_5":17486,"_23867":97917,"_2386":98017},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2859":58475,"_25205":58430,"_17596":98019,"_5":17486,"_23867":97917,"_2386":98020},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2859":58476,"_25205":58430,"_17596":98022,"_5":17486,"_23867":97917,"_2386":98023},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2859":58477,"_25205":58430,"_17596":98025,"_5":17486,"_23867":97917,"_2386":98026},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2859":58478,"_25205":58430,"_17596":98028,"_5":17486,"_23867":97917,"_2386":98029},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2859":58479,"_25205":58430,"_17596":98031,"_5":17486,"_23867":97917,"_2386":98032},[],"**Validación:** `va.role.crl.create`.",{"_2859":58480,"_25205":58430,"_17596":98034,"_5":17486,"_23867":97917,"_2386":98035},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2859":58481,"_25205":58430,"_17596":98037,"_5":17486,"_23867":97917,"_2386":98038},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2859":58482,"_25205":58482,"_5":12316,"_2386":98040,"_25540":98041,"_17596":98042,"_23867":58482},"Registros de auditoría",[40894,97341,97342],[],{"_2859":58483,"_25205":58482,"_17596":98044,"_5":17486,"_23867":58482,"_2386":98045},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2859":58484,"_25205":58482,"_5":25537,"_17596":98047,"_23867":98048,"_2386":98049},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2859":58485,"_25205":58482,"_5":25537,"_17596":98051,"_23867":98052,"_2386":98053},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2859":58486,"_25205":58482,"_5":25537,"_17596":98055,"_23867":98056,"_2386":98057},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2859":58487,"_25205":58482,"_5":25537,"_17596":98059,"_23867":98060,"_2386":98061},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2859":58488,"_25205":58482,"_5":25537,"_17596":98063,"_23867":98064,"_2386":98065},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2859":58489,"_25205":58482,"_5":25537,"_17596":98067,"_23867":98068,"_2386":98069},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2859":58490,"_25205":58482,"_5":25537,"_17596":98071,"_23867":98072,"_2386":98073},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2859":58491,"_25205":58482,"_5":25537,"_17596":98075,"_23867":98076,"_2386":98077},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2859":58492,"_25205":58482,"_5":25537,"_17596":98079,"_23867":98080,"_2386":98081},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2859":58493,"_25205":58482,"_5":25537,"_17596":98083,"_23867":98084,"_2386":98085},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2859":58494,"_25205":58482,"_5":25537,"_17596":98087,"_23867":98088,"_2386":98089},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2859":58495,"_25205":58482,"_17596":98091,"_5":17486,"_23867":58482,"_2386":98092},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2859":58496,"_25205":58482,"_17596":98094,"_5":17486,"_23867":98048,"_2386":98095},[],"El cuerpo de auditoría incluye:",{"_2859":58497,"_25205":58482,"_17596":98097,"_5":17486,"_23867":98048,"_2386":98098},[],"input: datos recibidos por la operación;",{"_2859":58498,"_25205":58482,"_17596":98100,"_5":17486,"_23867":98048,"_2386":98101},[],"has\\_error: indica si el servicio devolvió un error;",{"_2859":58499,"_25205":58482,"_17596":98103,"_5":17486,"_23867":98048,"_2386":98104},[],"output: resultado producido o mensaje de error;",{"_2859":58500,"_25205":58482,"_17596":98106,"_5":17486,"_23867":98048,"_2386":98107},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2859":58501,"_25205":58482,"_17596":98109,"_5":17486,"_23867":98048,"_2386":98110},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2859":58502,"_25205":58482,"_17596":98112,"_5":17486,"_23867":98048,"_2386":98113},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2859":58503,"_25205":58482,"_17596":98115,"_5":17486,"_23867":98052,"_2386":98116},[],"El backend aplica auditoría a mutaciones de:",{"_2859":58504,"_25205":58482,"_17596":98118,"_5":17486,"_23867":98052,"_2386":98119},[],"autoridades, certificados y perfiles de emisión;",{"_2859":58505,"_25205":58482,"_17596":98121,"_5":17486,"_23867":98052,"_2386":98122},[],"claves y motores KMS;",{"_2859":58506,"_25205":58482,"_17596":98124,"_5":17486,"_23867":98052,"_2386":98125},[],"dispositivos e identidades;",{"_2859":58507,"_25205":58482,"_17596":98127,"_5":17486,"_23867":98052,"_2386":98128},[],"DMS y operaciones de enrolamiento;",{"_2859":58508,"_25205":58482,"_17596":98130,"_5":17486,"_23867":98052,"_2386":98131},[],"funciones de validación y CRL;",{"_2859":58509,"_25205":58482,"_17596":98133,"_5":17486,"_23867":98052,"_2386":98134},[],"principales, políticas y concesiones de autorización.",{"_2859":58510,"_25205":58482,"_17596":98136,"_5":17486,"_23867":98052,"_2386":98137},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2859":58511,"_25205":58482,"_17596":98139,"_5":17486,"_23867":98056,"_2386":98140},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2859":58512,"_25205":58482,"_17596":98142,"_5":17486,"_23867":98056,"_2386":98143},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2859":58513,"_25205":58482,"_17596":98145,"_5":17486,"_23867":98056,"_2386":98146},[],"Diseña el consumidor para:",{"_2859":58514,"_25205":58482,"_17596":98148,"_5":17486,"_23867":98056,"_2386":98149},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2859":58515,"_25205":58482,"_17596":98151,"_5":17486,"_23867":98056,"_2386":98152},[],"conservar el CloudEvent completo sin modificar;",{"_2859":58516,"_25205":58482,"_17596":98154,"_5":17486,"_23867":98056,"_2386":98155},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2859":58517,"_25205":58482,"_17596":98157,"_5":17486,"_23867":98056,"_2386":98158},[],"cifrar en tránsito y en reposo;",{"_2859":58518,"_25205":58482,"_17596":98160,"_5":17486,"_23867":98056,"_2386":98161},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2859":58519,"_25205":58482,"_17596":98163,"_5":17486,"_23867":98056,"_2386":98164},[],"aplicar una política explícita de retención y legal hold;",{"_2859":58520,"_25205":58482,"_17596":98166,"_5":17486,"_23867":98056,"_2386":98167},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2859":58521,"_25205":58482,"_17596":98169,"_5":17486,"_23867":98060,"_2386":98170},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2859":58522,"_25205":58482,"_17596":98172,"_5":17486,"_23867":98060,"_2386":98173},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2859":58523,"_25205":58482,"_17596":98175,"_5":17486,"_23867":98068,"_2386":98176},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2859":58524,"_25205":58482,"_17596":98178,"_5":17486,"_23867":98072,"_2386":98179},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2859":58525,"_25205":58482,"_17596":98181,"_5":17486,"_23867":98076,"_2386":98182},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2859":58526,"_25205":58482,"_17596":98184,"_5":17486,"_23867":98080,"_2386":98185},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2859":58527,"_25205":58482,"_17596":98187,"_5":17486,"_23867":98084,"_2386":98188},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2859":58528,"_25205":58482,"_17596":98190,"_5":17486,"_23867":98088,"_2386":98191},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2859":58529,"_25205":58482,"_17596":98193,"_5":17486,"_23867":98088,"_2386":98194},[],"aparece un evento de auditoría correcto;",{"_2859":58530,"_25205":58482,"_17596":98196,"_5":17486,"_23867":98088,"_2386":98197},[],"el principal coincide con la identidad utilizada;",{"_2859":58531,"_25205":58482,"_17596":98199,"_5":17486,"_23867":98088,"_2386":98200},[],"el consumidor lo persiste una sola vez;",{"_2859":58532,"_25205":58482,"_17596":98202,"_5":17486,"_23867":98088,"_2386":98203},[],"puede recuperarse por recurso, actor y periodo;",{"_2859":58533,"_25205":58482,"_17596":98205,"_5":17486,"_23867":98088,"_2386":98206},[],"una interrupción del consumidor produce una alerta.",{"_2859":58534,"_25205":58482,"_17596":98208,"_5":17486,"_23867":98088,"_2386":98209},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2859":58535,"_25205":58535,"_5":12316,"_2386":98211,"_25540":98212,"_17596":98213,"_23867":58535},"Arquitectura de la plataforma",[40894,97341],[],{"_2859":58536,"_25205":58535,"_17596":98215,"_5":17486,"_23867":58535,"_2386":98216},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2859":58537,"_25205":58535,"_5":25537,"_17596":98218,"_23867":98219,"_2386":98220},[],"/docs/pr-preview/pr-43/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2859":58538,"_25205":58535,"_5":25537,"_17596":98222,"_23867":98223,"_2386":98224},[],"/docs/pr-preview/pr-43/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2859":58539,"_25205":58535,"_5":25537,"_17596":98226,"_23867":98227,"_2386":98228},[],"/docs/pr-preview/pr-43/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2859":58540,"_25205":58535,"_5":25537,"_17596":98230,"_23867":98231,"_2386":98232},[],"/docs/pr-preview/pr-43/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2859":58541,"_25205":58535,"_5":25537,"_17596":98234,"_23867":98235,"_2386":98236},[],"/docs/pr-preview/pr-43/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2859":58542,"_25205":58535,"_17596":98238,"_5":17486,"_23867":58535,"_2386":98239},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2859":58543,"_25205":58535,"_17596":98241,"_5":17486,"_23867":58535,"_2386":98242},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2859":58544,"_25205":58535,"_17596":98244,"_5":17486,"_23867":98219,"_2386":98245},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2859":58545,"_25205":58535,"_17596":98247,"_5":17486,"_23867":98223,"_2386":98248},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2859":58546,"_25205":58535,"_17596":98250,"_5":17486,"_23867":98227,"_2386":98251},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2859":58547,"_25205":58535,"_17596":98253,"_5":17486,"_23867":98231,"_2386":98254},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2859":58548,"_25205":58535,"_17596":98256,"_5":17486,"_23867":98235,"_2386":98257},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2859":58549,"_25205":58549,"_5":12316,"_2386":98259,"_25540":98260,"_17596":98261,"_23867":58549},"Cómo funciona Lamassu",[40894,97341],[],{"_2859":58550,"_25205":58549,"_17596":98263,"_5":17486,"_23867":58549,"_2386":98264},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2859":58551,"_25205":58549,"_5":25537,"_17596":98266,"_23867":98267,"_2386":98268},[],"/docs/pr-preview/pr-43/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2859":58552,"_25205":58549,"_5":25537,"_17596":98270,"_23867":98271,"_2386":98272},[],"/docs/pr-preview/pr-43/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2859":58553,"_25205":58549,"_17596":98274,"_5":17486,"_23867":58549,"_2386":98275},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2859":58554,"_25205":58549,"_17596":98277,"_5":17486,"_23867":98267,"_2386":98278},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2859":58555,"_25205":58549,"_17596":98280,"_5":17486,"_23867":98267,"_2386":98281},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2859":58556,"_25205":58549,"_17596":98283,"_5":17486,"_23867":98267,"_2386":98284},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2859":58557,"_25205":58549,"_17596":98286,"_5":17486,"_23867":98267,"_2386":98287},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2859":58558,"_25205":58549,"_17596":98289,"_5":17486,"_23867":98267,"_2386":98290},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2859":58559,"_25205":58549,"_17596":98292,"_5":17486,"_23867":98271,"_2386":98293},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2859":58560,"_25205":58549,"_17596":98295,"_5":17486,"_23867":98271,"_2386":98296},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2859":58561,"_25205":58549,"_17596":98298,"_5":17486,"_23867":98271,"_2386":98299},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2859":58562,"_25205":58549,"_17596":98301,"_5":17486,"_23867":98271,"_2386":98302},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2859":58563,"_25205":58549,"_17596":98304,"_5":17486,"_23867":98271,"_2386":98305},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2859":58564,"_25205":58549,"_17596":98307,"_5":17486,"_23867":98271,"_2386":98308},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2859":58565,"_25205":58549,"_17596":98310,"_5":17486,"_23867":98271,"_2386":98311},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2859":58566,"_25205":58566,"_5":12316,"_2386":98313,"_25540":98314,"_17596":98315,"_23867":58566},"Dispositivos e identidades",[40894,97341,43212,98313],[],{"_2859":58567,"_25205":58566,"_17596":98317,"_5":17486,"_23867":58566,"_2386":98318},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2859":58568,"_25205":58566,"_5":25537,"_17596":98320,"_23867":98321,"_2386":98322},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2859":58569,"_25205":58566,"_5":25537,"_17596":98324,"_23867":98325,"_2386":98326},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2859":58570,"_25205":58566,"_5":25537,"_17596":98328,"_23867":98329,"_2386":98330},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2859":58571,"_25205":58566,"_5":25537,"_17596":98332,"_23867":98333,"_2386":98334},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2859":58572,"_25205":58566,"_5":25537,"_17596":98336,"_23867":98337,"_2386":98338},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2859":58573,"_25205":58566,"_5":25537,"_17596":98340,"_23867":98341,"_2386":98342},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2859":58574,"_25205":58566,"_5":25537,"_17596":98344,"_23867":98345,"_2386":98346},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2859":58575,"_25205":58566,"_5":25537,"_17596":98348,"_23867":98349,"_2386":98350},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2859":58576,"_25205":58566,"_5":25537,"_17596":98352,"_23867":98353,"_2386":98354},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2859":58577,"_25205":58566,"_5":25537,"_17596":98356,"_23867":98357,"_2386":98358},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2859":58578,"_25205":58566,"_5":25537,"_17596":98360,"_23867":98361,"_2386":98362},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2859":58579,"_25205":58566,"_17596":98364,"_5":17486,"_23867":58566,"_2386":98365},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2859":58580,"_25205":58566,"_17596":98367,"_5":17486,"_23867":58566,"_2386":98368},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2859":58581,"_25205":58566,"_17596":98370,"_5":17486,"_23867":98321,"_2386":98371},[],"Vista operativa",{"_2859":58582,"_25205":58566,"_17596":98373,"_5":17486,"_23867":98321,"_2386":98374},[],"Interpretación",{"_2859":58583,"_25205":58566,"_17596":98376,"_5":17486,"_23867":98321,"_2386":43275},[],{"_2859":58584,"_25205":58566,"_17596":98378,"_5":17486,"_23867":98321,"_2386":98379},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2859":58585,"_25205":58566,"_17596":98381,"_5":17486,"_23867":98321,"_2386":43281},[],{"_2859":58586,"_25205":58566,"_17596":98383,"_5":17486,"_23867":98321,"_2386":98384},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2859":58587,"_25205":58566,"_17596":98386,"_5":17486,"_23867":98321,"_2386":43287},[],{"_2859":58588,"_25205":58566,"_17596":98388,"_5":17486,"_23867":98321,"_2386":98389},[],"La identidad está en la ventana operativa de renovación.",{"_2859":58589,"_25205":58566,"_17596":98391,"_5":17486,"_23867":98321,"_2386":43293},[],{"_2859":58590,"_25205":58566,"_17596":98393,"_5":17486,"_23867":98321,"_2386":98394},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2859":58591,"_25205":58566,"_17596":98396,"_5":17486,"_23867":98321,"_2386":43299},[],{"_2859":58592,"_25205":58566,"_17596":98398,"_5":17486,"_23867":98321,"_2386":98399},[],"La identidad ha vencido.",{"_2859":58593,"_25205":58566,"_17596":98401,"_5":17486,"_23867":98321,"_2386":43305},[],{"_2859":58594,"_25205":58566,"_17596":98403,"_5":17486,"_23867":98321,"_2386":98404},[],"La identidad está marcada como revocada.",{"_2859":58595,"_25205":58566,"_17596":98406,"_5":17486,"_23867":98321,"_2386":43311},[],{"_2859":58596,"_25205":58566,"_17596":98408,"_5":17486,"_23867":98321,"_2386":98409},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2859":58597,"_25205":58566,"_17596":98411,"_5":17486,"_23867":98321,"_2386":98412},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2859":58598,"_25205":58566,"_17596":98414,"_5":17486,"_23867":98325,"_2386":98415},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2859":58599,"_25205":58566,"_17596":98417,"_5":17486,"_23867":98325,"_2386":98418},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2859":58600,"_25205":58566,"_17596":98420,"_5":17486,"_23867":98325,"_2386":98421},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2859":58601,"_25205":58566,"_17596":98423,"_5":17486,"_23867":98325,"_2386":98424},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2859":58602,"_25205":58566,"_17596":98426,"_5":17486,"_23867":98329,"_2386":98427},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2859":58603,"_25205":58566,"_17596":98429,"_5":17486,"_23867":98333,"_2386":98430},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2859":58604,"_25205":58566,"_17596":98432,"_5":17486,"_23867":98337,"_2386":98433},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2859":58605,"_25205":58566,"_17596":98435,"_5":17486,"_23867":98341,"_2386":98436},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2859":58606,"_25205":58566,"_17596":98438,"_5":17486,"_23867":98345,"_2386":98439},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2859":58607,"_25205":58566,"_17596":98441,"_5":17486,"_23867":98345,"_2386":98442},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2859":58608,"_25205":58566,"_17596":98444,"_5":17486,"_23867":98349,"_2386":98445},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2859":58609,"_25205":58566,"_17596":98447,"_5":17486,"_23867":98349,"_2386":98448},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2859":58610,"_25205":58566,"_17596":98450,"_5":17486,"_23867":98349,"_2386":98451},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2859":58611,"_25205":58566,"_17596":98453,"_5":17486,"_23867":98349,"_2386":98454},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2859":58612,"_25205":58566,"_17596":98456,"_5":17486,"_23867":98349,"_2386":98457},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2859":58613,"_25205":58566,"_17596":98459,"_5":17486,"_23867":98349,"_2386":98460},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2859":58614,"_25205":58566,"_17596":98462,"_5":17486,"_23867":98353,"_2386":98463},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2859":58615,"_25205":58566,"_17596":98465,"_5":17486,"_23867":98353,"_2386":98466},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2859":58616,"_25205":58566,"_17596":98468,"_5":17486,"_23867":98357,"_2386":98469},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2859":58617,"_25205":58566,"_17596":98471,"_5":17486,"_23867":98357,"_2386":98472},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2859":58618,"_25205":58566,"_17596":98474,"_5":17486,"_23867":98357,"_2386":98475},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2859":58619,"_25205":58566,"_17596":98477,"_5":17486,"_23867":98357,"_2386":98478},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2859":58620,"_25205":58566,"_17596":98480,"_5":17486,"_23867":98361,"_2386":98481},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2859":58621,"_25205":58566,"_17596":98483,"_5":17486,"_23867":98361,"_2386":98484},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2859":58622,"_25205":58622,"_5":12316,"_2386":98486,"_25540":98487,"_17596":98489,"_23867":58622},"Identidad inicial y autenticación",[40894,97341,43212,98313,98488],"Enrolamiento con PKI",[],{"_2859":58623,"_25205":58622,"_17596":98491,"_5":17486,"_23867":58622,"_2386":98492},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2859":58624,"_25205":58622,"_5":25537,"_17596":98494,"_23867":98495,"_2386":98496},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2859":58625,"_25205":58622,"_5":25537,"_17596":98498,"_23867":98499,"_2386":98500},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2859":58626,"_25205":58622,"_5":25537,"_17596":98502,"_23867":98503,"_2386":98504},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2859":58627,"_25205":58622,"_5":25537,"_17596":98506,"_23867":98507,"_2386":98508},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2859":58628,"_25205":58622,"_5":25537,"_17596":98510,"_23867":98511,"_2386":98512},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2859":58629,"_25205":58622,"_17596":98514,"_5":17486,"_23867":58622,"_2386":98515},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2859":58630,"_25205":58622,"_17596":98517,"_5":17486,"_23867":98495,"_2386":98518},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2859":58631,"_25205":58622,"_17596":98520,"_5":17486,"_23867":98495,"_2386":98521},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2859":58632,"_25205":58622,"_17596":98523,"_5":17486,"_23867":98499,"_2386":98524},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2859":58633,"_25205":58622,"_17596":98526,"_5":17486,"_23867":98499,"_2386":98527},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2859":58634,"_25205":58622,"_17596":98529,"_5":17486,"_23867":98499,"_2386":98530},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2859":58635,"_25205":58622,"_17596":98532,"_5":17486,"_23867":98503,"_2386":98533},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2859":58636,"_25205":58622,"_17596":98535,"_5":17486,"_23867":98503,"_2386":98536},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2859":58637,"_25205":58622,"_17596":98538,"_5":17486,"_23867":98507,"_2386":98539},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2859":58638,"_25205":58622,"_17596":98541,"_5":17486,"_23867":98507,"_2386":98542},[],"Ejemplo de cuerpo:",{"_2859":58639,"_25205":58622,"_17596":98544,"_5":17486,"_23867":98507,"_2386":98545},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2859":58640,"_25205":58622,"_17596":98547,"_5":17486,"_23867":98507,"_2386":98548},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2859":58641,"_25205":58622,"_17596":98550,"_5":17486,"_23867":98507,"_2386":98551},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2859":58642,"_25205":58622,"_17596":98553,"_5":17486,"_23867":98507,"_2386":98554},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2859":58643,"_25205":58622,"_17596":98556,"_5":17486,"_23867":98511,"_2386":98557},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2859":58644,"_25205":58622,"_17596":98559,"_5":17486,"_23867":98511,"_2386":98560},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2859":58645,"_25205":58645,"_5":12316,"_2386":98562,"_25540":98563,"_17596":98564,"_23867":58645},"Configura y opera el DMS",[40894,97341,43212,98313,98488],[],{"_2859":58646,"_25205":58645,"_17596":98566,"_5":17486,"_23867":58645,"_2386":98567},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2859":58647,"_25205":58645,"_5":25537,"_17596":98569,"_23867":98570,"_2386":96042},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2859":58648,"_25205":58645,"_5":25537,"_17596":98572,"_23867":98573,"_2386":98574},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2859":58649,"_25205":58645,"_5":25537,"_17596":98576,"_23867":98577,"_2386":98578},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2859":58650,"_25205":58645,"_5":25537,"_17596":98580,"_23867":98581,"_2386":98582},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2859":58651,"_25205":58645,"_5":25537,"_17596":98584,"_23867":98585,"_2386":98586},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2859":58652,"_25205":58645,"_5":25537,"_17596":98588,"_23867":98589,"_2386":98590},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2859":58653,"_25205":58645,"_5":25537,"_17596":98592,"_23867":98593,"_2386":98594},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2859":58654,"_25205":58645,"_5":25537,"_17596":98596,"_23867":98597,"_2386":98598},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2859":58655,"_25205":58645,"_5":25537,"_17596":98600,"_23867":98601,"_2386":43507},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2859":58656,"_25205":58645,"_5":25537,"_17596":98603,"_23867":98604,"_2386":43511},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2859":58657,"_25205":58645,"_5":25537,"_17596":98606,"_23867":98607,"_2386":98608},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2859":58658,"_25205":58645,"_5":25537,"_17596":98610,"_23867":98611,"_2386":98612},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2859":58659,"_25205":58645,"_5":25537,"_17596":98614,"_23867":98615,"_2386":98616},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2859":58660,"_25205":58645,"_5":25537,"_17596":98618,"_23867":98619,"_2386":98620},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2859":58661,"_25205":58645,"_5":25537,"_17596":98622,"_23867":98623,"_2386":43531},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2859":58662,"_25205":58645,"_5":25537,"_17596":98625,"_23867":98626,"_2386":98627},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2859":58663,"_25205":58645,"_5":25537,"_17596":98629,"_23867":98630,"_2386":98631},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2859":58664,"_25205":58645,"_5":25537,"_17596":98633,"_23867":98634,"_2386":98635},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2859":58665,"_25205":58645,"_17596":98637,"_5":17486,"_23867":58645,"_2386":98638},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2859":58666,"_25205":58645,"_17596":98640,"_5":17486,"_23867":98570,"_2386":98641},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2859":58667,"_25205":58645,"_17596":98643,"_5":17486,"_23867":98570,"_2386":98644},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2859":58668,"_25205":58645,"_17596":98646,"_5":17486,"_23867":98577,"_2386":98647},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2859":58669,"_25205":58645,"_17596":98649,"_5":17486,"_23867":98581,"_2386":98650},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2859":58670,"_25205":58645,"_17596":98652,"_5":17486,"_23867":98585,"_2386":98653},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2859":58671,"_25205":58645,"_17596":98655,"_5":17486,"_23867":98589,"_2386":98656},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2859":58672,"_25205":58645,"_17596":98658,"_5":17486,"_23867":98593,"_2386":98659},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2859":58673,"_25205":58645,"_17596":98661,"_5":17486,"_23867":98601,"_2386":98662},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2859":58674,"_25205":58645,"_17596":98664,"_5":17486,"_23867":98601,"_2386":98665},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2859":58675,"_25205":58645,"_17596":98667,"_5":17486,"_23867":98604,"_2386":98668},[],"Campo de `settings.enrollment_settings`",{"_2859":58676,"_25205":58645,"_17596":98670,"_5":17486,"_23867":98604,"_2386":98671},[],"Decisión",{"_2859":58677,"_25205":58645,"_17596":98673,"_5":17486,"_23867":98604,"_2386":43582},[],{"_2859":58678,"_25205":58645,"_17596":98675,"_5":17486,"_23867":98604,"_2386":98676},[],"`EST_RFC7030` para estas operaciones.",{"_2859":58679,"_25205":58645,"_17596":98678,"_5":17486,"_23867":98604,"_2386":43588},[],{"_2859":58680,"_25205":58645,"_17596":98680,"_5":17486,"_23867":98604,"_2386":98681},[],"ID de la CA que firmará.",{"_2859":58681,"_25205":58645,"_17596":98683,"_5":17486,"_23867":98604,"_2386":43594},[],{"_2859":58682,"_25205":58645,"_17596":98685,"_5":17486,"_23867":98604,"_2386":98686},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2859":58683,"_25205":58645,"_17596":98688,"_5":17486,"_23867":98604,"_2386":43600},[],{"_2859":58684,"_25205":58645,"_17596":98690,"_5":17486,"_23867":98604,"_2386":98691},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2859":58685,"_25205":58645,"_17596":98693,"_5":17486,"_23867":98604,"_2386":43606},[],{"_2859":58686,"_25205":58645,"_17596":98695,"_5":17486,"_23867":98604,"_2386":98696},[],"Uno de los cuatro modos de autenticación.",{"_2859":58687,"_25205":58645,"_17596":98698,"_5":17486,"_23867":98604,"_2386":98699},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2859":58688,"_25205":58645,"_17596":98701,"_5":17486,"_23867":98607,"_2386":98702},[],"Los bloques son independientes:",{"_2859":58689,"_25205":58645,"_17596":98704,"_5":17486,"_23867":98607,"_2386":98705},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2859":58690,"_25205":58645,"_17596":98707,"_5":17486,"_23867":98607,"_2386":98708},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2859":58691,"_25205":58645,"_17596":98710,"_5":17486,"_23867":98607,"_2386":43624},[],{"_2859":58692,"_25205":58645,"_17596":98712,"_5":17486,"_23867":98607,"_2386":98713},[],"Control aplicado en la operación configurada",{"_2859":58693,"_25205":58645,"_17596":98715,"_5":17486,"_23867":98607,"_2386":43630},[],{"_2859":58694,"_25205":58645,"_17596":98717,"_5":17486,"_23867":98607,"_2386":98718},[],"Validación del certificado presentado.",{"_2859":58695,"_25205":58645,"_17596":98720,"_5":17486,"_23867":98607,"_2386":43636},[],{"_2859":58696,"_25205":58645,"_17596":98722,"_5":17486,"_23867":98607,"_2386":98723},[],"Autorización del webhook configurado.",{"_2859":58697,"_25205":58645,"_17596":98725,"_5":17486,"_23867":98607,"_2386":43642},[],{"_2859":58698,"_25205":58645,"_17596":98727,"_5":17486,"_23867":98607,"_2386":98728},[],"Validación del certificado y, después, aprobación del webhook.",{"_2859":58699,"_25205":58645,"_17596":98730,"_5":17486,"_23867":98607,"_2386":43648},[],{"_2859":58700,"_25205":58645,"_17596":98732,"_5":17486,"_23867":98607,"_2386":98733},[],"Sin autenticación del solicitante por el DMS.",{"_2859":58701,"_25205":58645,"_17596":98735,"_5":17486,"_23867":98607,"_2386":98736},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2859":58702,"_25205":58645,"_17596":98738,"_5":17486,"_23867":98607,"_2386":98739},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2859":58703,"_25205":58645,"_17596":98741,"_5":17486,"_23867":98607,"_2386":98742},[],"En reenrolamiento con certificado, el validador utiliza la CA de enrolamiento, después `additional_validation_cas`, y la opción `enable_expired_renewal`. No presupongas que copiar `validation_cas` del bloque inicial cambia esos emisores.",{"_2859":58704,"_25205":58645,"_17596":98744,"_5":17486,"_23867":98607,"_2386":98745},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2859":58705,"_25205":58645,"_17596":98747,"_5":17486,"_23867":98611,"_2386":98748},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2859":58706,"_25205":58645,"_17596":98750,"_5":17486,"_23867":98611,"_2386":98751},[],"Campo de `external_webhook_settings`",{"_2859":58707,"_25205":58645,"_17596":98753,"_5":17486,"_23867":98611,"_2386":98671},[],{"_2859":58708,"_25205":58645,"_17596":98755,"_5":17486,"_23867":98611,"_2386":43674},[],{"_2859":58709,"_25205":58645,"_17596":98757,"_5":17486,"_23867":98611,"_2386":98758},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2859":58710,"_25205":58645,"_17596":98760,"_5":17486,"_23867":98611,"_2386":43680},[],{"_2859":58711,"_25205":58645,"_17596":98762,"_5":17486,"_23867":98611,"_2386":98763},[],"`POST` o `PUT`; `POST` por defecto.",{"_2859":58712,"_25205":58645,"_17596":98765,"_5":17486,"_23867":98611,"_2386":43686},[],{"_2859":58713,"_25205":58645,"_17596":98767,"_5":17486,"_23867":98611,"_2386":98768},[],"Etiqueta usada en los logs del servicio.",{"_2859":58714,"_25205":58645,"_17596":98770,"_5":17486,"_23867":98611,"_2386":43692},[],{"_2859":58715,"_25205":58645,"_17596":98772,"_5":17486,"_23867":98611,"_2386":98773},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2859":58716,"_25205":58645,"_17596":98775,"_5":17486,"_23867":98611,"_2386":43698},[],{"_2859":58717,"_25205":58645,"_17596":98777,"_5":17486,"_23867":98611,"_2386":98778},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2859":58718,"_25205":58645,"_17596":98780,"_5":17486,"_23867":98611,"_2386":43704},[],{"_2859":58719,"_25205":58645,"_17596":98782,"_5":17486,"_23867":98611,"_2386":98783},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2859":58720,"_25205":58645,"_17596":98785,"_5":17486,"_23867":98611,"_2386":43710},[],{"_2859":58721,"_25205":58645,"_17596":98787,"_5":17486,"_23867":98611,"_2386":98788},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2859":58722,"_25205":58645,"_17596":98790,"_5":17486,"_23867":98611,"_2386":43716},[],{"_2859":58723,"_25205":58645,"_17596":98792,"_5":17486,"_23867":98611,"_2386":98793},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2859":58724,"_25205":58645,"_17596":98795,"_5":17486,"_23867":98611,"_2386":43722},[],{"_2859":58725,"_25205":58645,"_17596":98797,"_5":17486,"_23867":98611,"_2386":98798},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2859":58726,"_25205":58645,"_17596":98800,"_5":17486,"_23867":98611,"_2386":98801},[],"Reglas de esa configuración:",{"_2859":58727,"_25205":58645,"_17596":98803,"_5":17486,"_23867":98611,"_2386":98804},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2859":58728,"_25205":58645,"_17596":98806,"_5":17486,"_23867":98611,"_2386":98807},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2859":58729,"_25205":58645,"_17596":98809,"_5":17486,"_23867":98611,"_2386":98810},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2859":58730,"_25205":58645,"_17596":98812,"_5":17486,"_23867":98611,"_2386":98813},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2859":58731,"_25205":58645,"_17596":98815,"_5":17486,"_23867":98611,"_2386":98816},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2859":58732,"_25205":58645,"_17596":98818,"_5":17486,"_23867":98611,"_2386":98819},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2859":58733,"_25205":58645,"_17596":98821,"_5":17486,"_23867":98611,"_2386":98822},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2859":58734,"_25205":58645,"_17596":98824,"_5":17486,"_23867":98611,"_2386":98825},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2859":58735,"_25205":58645,"_17596":98827,"_5":17486,"_23867":98615,"_2386":98828},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2859":58736,"_25205":58645,"_17596":98830,"_5":17486,"_23867":98619,"_2386":98831},[],"Campo de `settings.reenrollment_settings`",{"_2859":58737,"_25205":58645,"_17596":98833,"_5":17486,"_23867":98619,"_2386":98834},[],"Función",{"_2859":58738,"_25205":58645,"_17596":98836,"_5":17486,"_23867":98619,"_2386":43763},[],{"_2859":58739,"_25205":58645,"_17596":98838,"_5":17486,"_23867":98619,"_2386":98839},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2859":58740,"_25205":58645,"_17596":98841,"_5":17486,"_23867":98619,"_2386":43769},[],{"_2859":58741,"_25205":58645,"_17596":98843,"_5":17486,"_23867":98619,"_2386":98844},[],"Umbral operativo preventivo de monitorización.",{"_2859":58742,"_25205":58645,"_17596":98846,"_5":17486,"_23867":98619,"_2386":43775},[],{"_2859":58743,"_25205":58645,"_17596":98848,"_5":17486,"_23867":98619,"_2386":98849},[],"Umbral operativo crítico de monitorización.",{"_2859":58744,"_25205":58645,"_17596":98851,"_5":17486,"_23867":98619,"_2386":43781},[],{"_2859":58745,"_25205":58645,"_17596":98853,"_5":17486,"_23867":98619,"_2386":98854},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2859":58746,"_25205":58645,"_17596":98856,"_5":17486,"_23867":98619,"_2386":43787},[],{"_2859":58747,"_25205":58645,"_17596":98858,"_5":17486,"_23867":98619,"_2386":98859},[],"Emisores adicionales para la credencial mTLS durante una migración.",{"_2859":58748,"_25205":58645,"_17596":98861,"_5":17486,"_23867":98619,"_2386":43793},[],{"_2859":58749,"_25205":58645,"_17596":98863,"_5":17486,"_23867":98619,"_2386":98864},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2859":58750,"_25205":58645,"_17596":98866,"_5":17486,"_23867":98619,"_2386":98867},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2859":58751,"_25205":58645,"_17596":98869,"_5":17486,"_23867":98623,"_2386":98870},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2859":58752,"_25205":58645,"_17596":98872,"_5":17486,"_23867":98626,"_2386":96399},[],{"_2859":58753,"_25205":58645,"_17596":98874,"_5":17486,"_23867":98626,"_2386":98875},[],"Qué publica",{"_2859":58754,"_25205":58645,"_17596":98877,"_5":17486,"_23867":98626,"_2386":43810},[],{"_2859":58755,"_25205":58645,"_17596":98879,"_5":17486,"_23867":98626,"_2386":98880},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2859":58756,"_25205":58645,"_17596":98882,"_5":17486,"_23867":98626,"_2386":43816},[],{"_2859":58757,"_25205":58645,"_17596":98884,"_5":17486,"_23867":98626,"_2386":98885},[],"Certificado de la CA emisora seleccionada.",{"_2859":58758,"_25205":58645,"_17596":98887,"_5":17486,"_23867":98626,"_2386":43822},[],{"_2859":58759,"_25205":58645,"_17596":98889,"_5":17486,"_23867":98626,"_2386":98890},[],"Certificados de las CAs elegidas explícitamente.",{"_2859":58760,"_25205":58645,"_17596":98892,"_5":17486,"_23867":98626,"_2386":98893},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2859":58761,"_25205":58645,"_17596":98895,"_5":17486,"_23867":98630,"_2386":98896},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP.",{"_2859":58762,"_25205":58645,"_17596":98898,"_5":17486,"_23867":98630,"_2386":98899},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2859":58763,"_25205":58645,"_17596":98901,"_5":17486,"_23867":98630,"_2386":98902},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2859":58764,"_25205":58645,"_17596":98904,"_5":17486,"_23867":98634,"_2386":98905},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2859":58765,"_25205":58765,"_5":12316,"_2386":98907,"_25540":98908,"_17596":98909,"_23867":58765},"Integra el cliente EST",[40894,97341,43212,98313,98488],[],{"_2859":58766,"_25205":58765,"_17596":98911,"_5":17486,"_23867":58765,"_2386":98912},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2859":58767,"_25205":58765,"_5":25537,"_17596":98914,"_23867":98915,"_2386":96042},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2859":58768,"_25205":58765,"_5":25537,"_17596":98917,"_23867":98918,"_2386":98919},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2859":58769,"_25205":58765,"_5":25537,"_17596":98921,"_23867":98922,"_2386":98923},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2859":58770,"_25205":58765,"_5":25537,"_17596":98925,"_23867":98926,"_2386":98927},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2859":58771,"_25205":58765,"_5":25537,"_17596":98929,"_23867":98930,"_2386":98931},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2859":58772,"_25205":58765,"_5":25537,"_17596":98933,"_23867":98934,"_2386":98935},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2859":58773,"_25205":58765,"_17596":98937,"_5":17486,"_23867":58765,"_2386":98938},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2859":58774,"_25205":58765,"_17596":98940,"_5":17486,"_23867":98915,"_2386":98941},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2859":58775,"_25205":58765,"_17596":98943,"_5":17486,"_23867":98915,"_2386":98944},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2859":58776,"_25205":58765,"_17596":98946,"_5":17486,"_23867":98915,"_2386":98947},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2859":58777,"_25205":58765,"_17596":98949,"_5":17486,"_23867":98918,"_2386":98950},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2859":58778,"_25205":58765,"_17596":98952,"_5":17486,"_23867":98918,"_2386":98953},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2859":58779,"_25205":58765,"_17596":98955,"_5":17486,"_23867":98922,"_2386":98956},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2859":58780,"_25205":58765,"_17596":98958,"_5":17486,"_23867":98922,"_2386":98959},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2859":58781,"_25205":58765,"_17596":98961,"_5":17486,"_23867":98926,"_2386":98962},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2859":58782,"_25205":58765,"_17596":98964,"_5":17486,"_23867":98926,"_2386":98965},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2859":58783,"_25205":58765,"_17596":98967,"_5":17486,"_23867":98930,"_2386":98968},[],"Para el caso de una raíz que emite directamente:",{"_2859":58784,"_25205":58765,"_17596":98970,"_5":17486,"_23867":98930,"_2386":98971},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2859":58785,"_25205":58765,"_17596":98973,"_5":17486,"_23867":98930,"_2386":98974},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2859":58786,"_25205":58765,"_17596":98976,"_5":17486,"_23867":98934,"_2386":98977},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2859":58787,"_25205":58787,"_5":12316,"_2386":98979,"_25540":98980,"_17596":98981,"_23867":58787},"Referencia EST",[40894,97341,43212,98313,98488],[],{"_2859":58788,"_25205":58787,"_17596":98983,"_5":17486,"_23867":58787,"_2386":98984},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2859":58789,"_25205":58787,"_5":25537,"_17596":98986,"_23867":98987,"_2386":98988},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2859":58790,"_25205":58787,"_5":25537,"_17596":98990,"_23867":98991,"_2386":19104},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2859":58791,"_25205":58787,"_5":25537,"_17596":98993,"_23867":98994,"_2386":21895},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2859":58792,"_25205":58787,"_5":25537,"_17596":98996,"_23867":98997,"_2386":21902},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2859":58793,"_25205":58787,"_5":25537,"_17596":98999,"_23867":99000,"_2386":21272},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2859":58794,"_25205":58787,"_5":25537,"_17596":99002,"_23867":99003,"_2386":99004},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2859":58795,"_25205":58787,"_5":25537,"_17596":99006,"_23867":99007,"_2386":99008},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2859":58796,"_25205":58787,"_5":25537,"_17596":99010,"_23867":99011,"_2386":99012},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2859":58797,"_25205":58787,"_17596":99014,"_5":17486,"_23867":58787,"_2386":99015},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2859":58798,"_25205":58787,"_17596":99017,"_5":17486,"_23867":98987,"_2386":99018},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2859":58799,"_25205":58787,"_17596":99020,"_5":17486,"_23867":98987,"_2386":97132},[],{"_2859":58800,"_25205":58787,"_17596":99022,"_5":17486,"_23867":98987,"_2386":99023},[],"Método",{"_2859":58801,"_25205":58787,"_17596":99025,"_5":17486,"_23867":98987,"_2386":99026},[],"Autenticación y condición",{"_2859":58802,"_25205":58787,"_17596":99028,"_5":17486,"_23867":98987,"_2386":43965},[],{"_2859":58803,"_25205":58787,"_17596":99030,"_5":17486,"_23867":98987,"_2386":43968},[],{"_2859":58804,"_25205":58787,"_17596":99032,"_5":17486,"_23867":98987,"_2386":99033},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2859":58805,"_25205":58787,"_17596":99035,"_5":17486,"_23867":98987,"_2386":43974},[],{"_2859":58806,"_25205":58787,"_17596":99037,"_5":17486,"_23867":98987,"_2386":43977},[],{"_2859":58807,"_25205":58787,"_17596":99039,"_5":17486,"_23867":98987,"_2386":99040},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2859":58808,"_25205":58787,"_17596":99042,"_5":17486,"_23867":98987,"_2386":43983},[],{"_2859":58809,"_25205":58787,"_17596":99044,"_5":17486,"_23867":98987,"_2386":43977},[],{"_2859":58810,"_25205":58787,"_17596":99046,"_5":17486,"_23867":98987,"_2386":99047},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2859":58811,"_25205":58787,"_17596":99049,"_5":17486,"_23867":98987,"_2386":43991},[],{"_2859":58812,"_25205":58787,"_17596":99051,"_5":17486,"_23867":98987,"_2386":43977},[],{"_2859":58813,"_25205":58787,"_17596":99053,"_5":17486,"_23867":98987,"_2386":99054},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2859":58814,"_25205":58787,"_17596":99056,"_5":17486,"_23867":98987,"_2386":99057},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2859":58815,"_25205":58787,"_17596":99059,"_5":17486,"_23867":98991,"_2386":99060},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2859":58816,"_25205":58787,"_17596":99062,"_5":17486,"_23867":98991,"_2386":99063},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2859":58817,"_25205":58787,"_17596":99065,"_5":17486,"_23867":98994,"_2386":99066},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2859":58818,"_25205":58787,"_17596":99068,"_5":17486,"_23867":98994,"_2386":99069},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2859":58819,"_25205":58787,"_17596":99071,"_5":17486,"_23867":98997,"_2386":99072},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2859":58820,"_25205":58787,"_17596":99074,"_5":17486,"_23867":98997,"_2386":99075},[],"La CA de enrolamiento o una CA adicional valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2859":58821,"_25205":58787,"_17596":99077,"_5":17486,"_23867":99000,"_2386":99078},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2859":58822,"_25205":58787,"_17596":99080,"_5":17486,"_23867":99000,"_2386":99081},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2859":58823,"_25205":58787,"_17596":99083,"_5":17486,"_23867":99003,"_2386":99084},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2859":58824,"_25205":58787,"_17596":99086,"_5":17486,"_23867":99003,"_2386":99087},[],"Parte",{"_2859":58825,"_25205":58787,"_17596":99089,"_5":17486,"_23867":99003,"_2386":99090},[],"Contenido tras decodificar su Base64",{"_2859":58826,"_25205":58787,"_17596":99092,"_5":17486,"_23867":99003,"_2386":44035},[],{"_2859":58827,"_25205":58787,"_17596":99094,"_5":17486,"_23867":99003,"_2386":99095},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2859":58828,"_25205":58787,"_17596":99097,"_5":17486,"_23867":99003,"_2386":44041},[],{"_2859":58829,"_25205":58787,"_17596":99099,"_5":17486,"_23867":99003,"_2386":99100},[],"PKCS#7 DER con el certificado emitido.",{"_2859":58830,"_25205":58787,"_17596":99102,"_5":17486,"_23867":99003,"_2386":99103},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2859":58831,"_25205":58787,"_17596":99105,"_5":17486,"_23867":99007,"_2386":99106},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2859":58832,"_25205":58787,"_17596":99108,"_5":17486,"_23867":99007,"_2386":99109},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2859":58833,"_25205":58787,"_17596":99111,"_5":17486,"_23867":99007,"_2386":99112},[],"Convierte y comprueba el resultado:",{"_2859":58834,"_25205":58787,"_17596":99114,"_5":17486,"_23867":99007,"_2386":99115},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2859":58835,"_25205":58787,"_17596":99117,"_5":17486,"_23867":99011,"_2386":99118},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2859":58836,"_25205":58787,"_17596":99120,"_5":17486,"_23867":99011,"_2386":99121},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2859":58837,"_25205":58837,"_5":12316,"_2386":98488,"_25540":99123,"_17596":99124,"_23867":58837},[40894,97341,43212,98313,98488],[],{"_2859":58838,"_25205":58837,"_17596":99126,"_5":17486,"_23867":58837,"_2386":99127},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2859":58839,"_25205":58837,"_5":25537,"_17596":99129,"_23867":99130,"_2386":99131},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2859":58840,"_25205":58837,"_5":25537,"_17596":99133,"_23867":99134,"_2386":99135},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2859":58841,"_25205":58837,"_5":25537,"_17596":99137,"_23867":99138,"_2386":99139},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2859":58842,"_25205":58837,"_5":25537,"_17596":99141,"_23867":99142,"_2386":99143},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2859":58843,"_25205":58837,"_17596":99145,"_5":17486,"_23867":58837,"_2386":99146},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2859":58844,"_25205":58837,"_17596":99148,"_5":17486,"_23867":99130,"_2386":99149},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2859":58845,"_25205":58837,"_17596":99151,"_5":17486,"_23867":99130,"_2386":99152},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2859":58846,"_25205":58837,"_17596":99154,"_5":17486,"_23867":99130,"_2386":99155},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2859":58847,"_25205":58837,"_17596":99157,"_5":17486,"_23867":99130,"_2386":99158},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2859":58848,"_25205":58837,"_17596":99160,"_5":17486,"_23867":99130,"_2386":99161},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2859":58849,"_25205":58837,"_17596":99163,"_5":17486,"_23867":99130,"_2386":99164},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2859":58850,"_25205":58837,"_17596":99166,"_5":17486,"_23867":99134,"_2386":99167},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2859":58851,"_25205":58837,"_17596":99169,"_5":17486,"_23867":99134,"_2386":99170},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2859":58852,"_25205":58837,"_17596":99172,"_5":17486,"_23867":99134,"_2386":99173},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2859":58853,"_25205":58837,"_17596":99175,"_5":17486,"_23867":99134,"_2386":99176},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2859":58854,"_25205":58837,"_17596":99178,"_5":17486,"_23867":99138,"_2386":99179},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2859":58855,"_25205":58837,"_17596":99181,"_5":17486,"_23867":99138,"_2386":99182},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2859":58856,"_25205":58837,"_17596":99184,"_5":17486,"_23867":99138,"_2386":99185},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2859":58857,"_25205":58837,"_17596":99187,"_5":17486,"_23867":99138,"_2386":99188},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2859":58858,"_25205":58837,"_17596":99190,"_5":17486,"_23867":99142,"_2386":99191},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2859":58859,"_25205":58837,"_17596":99193,"_5":17486,"_23867":99142,"_2386":99194},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2859":58860,"_25205":58860,"_5":12316,"_2386":99196,"_25540":99197,"_17596":99198,"_23867":58860},"Estrategias de aprovisionamiento",[40894,97341,43212,98313,98488],[],{"_2859":58861,"_25205":58860,"_17596":99200,"_5":17486,"_23867":58860,"_2386":99201},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2859":58862,"_25205":58860,"_5":25537,"_17596":99203,"_23867":99204,"_2386":99205},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2859":58863,"_25205":58860,"_5":25537,"_17596":99207,"_23867":99208,"_2386":99209},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2859":58864,"_25205":58860,"_5":25537,"_17596":99211,"_23867":99212,"_2386":99213},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2859":58865,"_25205":58860,"_5":25537,"_17596":99215,"_23867":99216,"_2386":99217},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2859":58866,"_25205":58860,"_5":25537,"_17596":99219,"_23867":99220,"_2386":99221},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2859":58867,"_25205":58860,"_17596":99223,"_5":17486,"_23867":58860,"_2386":99224},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2859":58868,"_25205":58860,"_17596":99226,"_5":17486,"_23867":99204,"_2386":99227},[],"Recorrido",{"_2859":58869,"_25205":58860,"_17596":99229,"_5":17486,"_23867":99204,"_2386":99230},[],"Cuándo existe el dispositivo",{"_2859":58870,"_25205":58860,"_17596":99232,"_5":17486,"_23867":99204,"_2386":99233},[],"Qué compruebas",{"_2859":58871,"_25205":58860,"_17596":99235,"_5":17486,"_23867":99204,"_2386":99236},[],"Asignación manual",{"_2859":58872,"_25205":58860,"_17596":99238,"_5":17486,"_23867":99204,"_2386":99239},[],"El operador lo crea antes de asociar un certificado.",{"_2859":58873,"_25205":58860,"_17596":99241,"_5":17486,"_23867":99204,"_2386":99242},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2859":58874,"_25205":58860,"_17596":99244,"_5":17486,"_23867":99204,"_2386":99245},[],"EST con `JITP`",{"_2859":58875,"_25205":58860,"_17596":99247,"_5":17486,"_23867":99204,"_2386":99248},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2859":58876,"_25205":58860,"_17596":99250,"_5":17486,"_23867":99204,"_2386":99251},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2859":58877,"_25205":58860,"_17596":99253,"_5":17486,"_23867":99204,"_2386":99254},[],"EST con `PRE_REGISTRATION`",{"_2859":58878,"_25205":58860,"_17596":99256,"_5":17486,"_23867":99204,"_2386":99257},[],"Debe existir antes de `/simpleenroll`.",{"_2859":58879,"_25205":58860,"_17596":99259,"_5":17486,"_23867":99204,"_2386":99260},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2859":58880,"_25205":58860,"_17596":99262,"_5":17486,"_23867":99204,"_2386":99263},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2859":58881,"_25205":58860,"_17596":99265,"_5":17486,"_23867":99204,"_2386":99266},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2859":58882,"_25205":58860,"_17596":99268,"_5":17486,"_23867":99208,"_2386":99269},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2859":58883,"_25205":58860,"_17596":99271,"_5":17486,"_23867":99208,"_2386":99272},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2859":58884,"_25205":58860,"_17596":99274,"_5":17486,"_23867":99208,"_2386":99275},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2859":58885,"_25205":58860,"_17596":99277,"_5":17486,"_23867":99212,"_2386":99278},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2859":58886,"_25205":58860,"_17596":99280,"_5":17486,"_23867":99212,"_2386":99281},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2859":58887,"_25205":58860,"_17596":99283,"_5":17486,"_23867":99212,"_2386":99284},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2859":58888,"_25205":58860,"_17596":99286,"_5":17486,"_23867":99212,"_2386":99287},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2859":58889,"_25205":58860,"_17596":99289,"_5":17486,"_23867":99212,"_2386":99290},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2859":58890,"_25205":58860,"_17596":99292,"_5":17486,"_23867":99212,"_2386":99293},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2859":58891,"_25205":58860,"_17596":99295,"_5":17486,"_23867":99216,"_2386":96399},[],{"_2859":58892,"_25205":58860,"_17596":99297,"_5":17486,"_23867":99216,"_2386":99298},[],"Material que atraviesa EST",{"_2859":58893,"_25205":58860,"_17596":99300,"_5":17486,"_23867":99216,"_2386":99301},[],"Clave generada por el dispositivo",{"_2859":58894,"_25205":58860,"_17596":99303,"_5":17486,"_23867":99216,"_2386":99304},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2859":58895,"_25205":58860,"_17596":99306,"_5":17486,"_23867":99216,"_2386":99307},[],"Clave ya disponible en el dispositivo",{"_2859":58896,"_25205":58860,"_17596":99309,"_5":17486,"_23867":99216,"_2386":99310},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2859":58897,"_25205":58860,"_17596":99312,"_5":17486,"_23867":99216,"_2386":43531},[],{"_2859":58898,"_25205":58860,"_17596":99314,"_5":17486,"_23867":99216,"_2386":99315},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2859":58899,"_25205":58860,"_17596":99317,"_5":17486,"_23867":99216,"_2386":99318},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2859":58900,"_25205":58860,"_17596":99320,"_5":17486,"_23867":99220,"_2386":99321},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2859":58901,"_25205":58901,"_5":12316,"_2386":99323,"_25540":99324,"_17596":99325,"_23867":58901},"Renovación y recuperación",[40894,97341,43212,98313,98488],[],{"_2859":58902,"_25205":58901,"_17596":99327,"_5":17486,"_23867":58901,"_2386":99328},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2859":58903,"_25205":58901,"_5":25537,"_17596":99330,"_23867":99331,"_2386":99332},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2859":58904,"_25205":58901,"_5":25537,"_17596":99334,"_23867":99335,"_2386":99336},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2859":58905,"_25205":58901,"_5":25537,"_17596":99338,"_23867":99339,"_2386":99340},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2859":58906,"_25205":58901,"_5":25537,"_17596":99342,"_23867":99343,"_2386":99344},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2859":58907,"_25205":58901,"_5":25537,"_17596":99346,"_23867":99347,"_2386":99348},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2859":58908,"_25205":58901,"_17596":99350,"_5":17486,"_23867":58901,"_2386":99351},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2859":58909,"_25205":58901,"_17596":99353,"_5":17486,"_23867":99331,"_2386":99354},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2859":58910,"_25205":58901,"_17596":99356,"_5":17486,"_23867":99331,"_2386":99357},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2859":58911,"_25205":58901,"_17596":99359,"_5":17486,"_23867":99331,"_2386":99360},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2859":58912,"_25205":58901,"_17596":99362,"_5":17486,"_23867":99331,"_2386":99363},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2859":58913,"_25205":58901,"_17596":99365,"_5":17486,"_23867":99335,"_2386":99366},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2859":58914,"_25205":58901,"_17596":99368,"_5":17486,"_23867":99335,"_2386":99369},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2859":58915,"_25205":58901,"_17596":99371,"_5":17486,"_23867":99339,"_2386":99372},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2859":58916,"_25205":58901,"_17596":99374,"_5":17486,"_23867":99339,"_2386":99375},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2859":58917,"_25205":58901,"_17596":99377,"_5":17486,"_23867":99339,"_2386":99378},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2859":58918,"_25205":58901,"_17596":99380,"_5":17486,"_23867":99343,"_2386":99381},[],"Situación",{"_2859":58919,"_25205":58901,"_17596":99383,"_5":17486,"_23867":99343,"_2386":99384},[],"Procedimiento",{"_2859":58920,"_25205":58901,"_17596":99386,"_5":17486,"_23867":99343,"_2386":99387},[],"Certificado vigente, fuera de ventana",{"_2859":58921,"_25205":58901,"_17596":99389,"_5":17486,"_23867":99343,"_2386":99390},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2859":58922,"_25205":58901,"_17596":99392,"_5":17486,"_23867":99343,"_2386":99393},[],"Certificado vencido, clave disponible",{"_2859":58923,"_25205":58901,"_17596":99395,"_5":17486,"_23867":99343,"_2386":99396},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2859":58924,"_25205":58901,"_17596":99398,"_5":17486,"_23867":99343,"_2386":99399},[],"Renovación por webhook o `NO_AUTH`",{"_2859":58925,"_25205":58901,"_17596":99401,"_5":17486,"_23867":99343,"_2386":99402},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2859":58926,"_25205":58901,"_17596":99404,"_5":17486,"_23867":99343,"_2386":99405},[],"Clave perdida o inaccesible",{"_2859":58927,"_25205":58901,"_17596":99407,"_5":17486,"_23867":99343,"_2386":99408},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2859":58928,"_25205":58901,"_17596":99410,"_5":17486,"_23867":99343,"_2386":99411},[],"Identidad actual revocada",{"_2859":58929,"_25205":58901,"_17596":99413,"_5":17486,"_23867":99343,"_2386":99414},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2859":58930,"_25205":58901,"_17596":99416,"_5":17486,"_23867":99343,"_2386":99417},[],"Dispositivo sin identidad",{"_2859":58931,"_25205":58901,"_17596":99419,"_5":17486,"_23867":99343,"_2386":99420},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2859":58932,"_25205":58901,"_17596":99422,"_5":17486,"_23867":99343,"_2386":99423},[],"Dispositivo retirado",{"_2859":58933,"_25205":58901,"_17596":99425,"_5":17486,"_23867":99343,"_2386":99426},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2859":58934,"_25205":58901,"_17596":99428,"_5":17486,"_23867":99343,"_2386":99429},[],"Timeout, HTTP 500 o fallo de instalación",{"_2859":58935,"_25205":58901,"_17596":99431,"_5":17486,"_23867":99343,"_2386":99432},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2859":58936,"_25205":58901,"_17596":99434,"_5":17486,"_23867":99347,"_2386":99435},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2859":58937,"_25205":58901,"_17596":99437,"_5":17486,"_23867":99347,"_2386":99438},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2859":58938,"_25205":58938,"_5":12316,"_2386":99440,"_25540":99441,"_17596":99442,"_23867":58938},"Diagnóstico de enrolamiento",[40894,97341,43212,98313,98488],[],{"_2859":58939,"_25205":58938,"_17596":99444,"_5":17486,"_23867":58938,"_2386":99445},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2859":58940,"_25205":58938,"_5":25537,"_17596":99447,"_23867":99448,"_2386":99449},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2859":58941,"_25205":58938,"_5":25537,"_17596":99451,"_23867":99452,"_2386":99453},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2859":58942,"_25205":58938,"_5":25537,"_17596":99455,"_23867":99456,"_2386":99012},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2859":58943,"_25205":58938,"_5":25537,"_17596":99458,"_23867":99459,"_2386":99460},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2859":58944,"_25205":58938,"_17596":99462,"_5":17486,"_23867":58938,"_2386":99463},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2859":58945,"_25205":58938,"_17596":99465,"_5":17486,"_23867":99452,"_2386":99466},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2859":58946,"_25205":58938,"_17596":99468,"_5":17486,"_23867":99452,"_2386":99469},[],"Síntoma o mensaje",{"_2859":58947,"_25205":58938,"_17596":99471,"_5":17486,"_23867":99452,"_2386":99472},[],"Qué revisar",{"_2859":58948,"_25205":58938,"_17596":99474,"_5":17486,"_23867":99452,"_2386":99475},[],"curl rechaza TLS, nombre o emisor",{"_2859":58949,"_25205":58938,"_17596":99477,"_5":17486,"_23867":99452,"_2386":99478},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2859":58950,"_25205":58938,"_17596":99480,"_5":17486,"_23867":99452,"_2386":99481},[],"404 o APS ausente",{"_2859":58951,"_25205":58938,"_17596":99483,"_5":17486,"_23867":99452,"_2386":99484},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2859":58952,"_25205":58938,"_17596":99486,"_5":17486,"_23867":99452,"_2386":99487},[],"400, error de CSR o formato",{"_2859":58953,"_25205":58938,"_17596":99489,"_5":17486,"_23867":99452,"_2386":99490},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2859":58954,"_25205":58938,"_17596":99492,"_5":17486,"_23867":99452,"_2386":99493},[],"Credencial ausente o certificado no válido",{"_2859":58955,"_25205":58938,"_17596":99495,"_5":17486,"_23867":99452,"_2386":99496},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2859":58956,"_25205":58938,"_17596":99498,"_5":17486,"_23867":99452,"_2386":99499},[],"Webhook deniega, expira o responde sin autorización",{"_2859":58957,"_25205":58938,"_17596":99501,"_5":17486,"_23867":99452,"_2386":99502},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2859":58958,"_25205":58938,"_17596":99504,"_5":17486,"_23867":99452,"_2386":44448},[],{"_2859":58959,"_25205":58938,"_17596":99506,"_5":17486,"_23867":99452,"_2386":99507},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2859":58960,"_25205":58938,"_17596":99509,"_5":17486,"_23867":99452,"_2386":44454},[],{"_2859":58961,"_25205":58938,"_17596":99511,"_5":17486,"_23867":99452,"_2386":99512},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2859":58962,"_25205":58938,"_17596":99514,"_5":17486,"_23867":99452,"_2386":44460},[],{"_2859":58963,"_25205":58938,"_17596":99516,"_5":17486,"_23867":99452,"_2386":99517},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2859":58964,"_25205":58938,"_17596":99519,"_5":17486,"_23867":99452,"_2386":99520},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2859":58965,"_25205":58938,"_17596":99522,"_5":17486,"_23867":99452,"_2386":99523},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2859":58966,"_25205":58938,"_17596":99525,"_5":17486,"_23867":99452,"_2386":99526},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2859":58967,"_25205":58938,"_17596":99528,"_5":17486,"_23867":99452,"_2386":99529},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2859":58968,"_25205":58938,"_17596":99531,"_5":17486,"_23867":99452,"_2386":44478},[],{"_2859":58969,"_25205":58938,"_17596":99533,"_5":17486,"_23867":99452,"_2386":99534},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2859":58970,"_25205":58938,"_17596":99536,"_5":17486,"_23867":99452,"_2386":44484},[],{"_2859":58971,"_25205":58938,"_17596":99538,"_5":17486,"_23867":99452,"_2386":99539},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2859":58972,"_25205":58938,"_17596":99541,"_5":17486,"_23867":99452,"_2386":99542},[],"DMS propietario distinto",{"_2859":58973,"_25205":58938,"_17596":99544,"_5":17486,"_23867":99452,"_2386":99545},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2859":58974,"_25205":58938,"_17596":99547,"_5":17486,"_23867":99452,"_2386":44496},[],{"_2859":58975,"_25205":58938,"_17596":99549,"_5":17486,"_23867":99452,"_2386":99550},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2859":58976,"_25205":58938,"_17596":99552,"_5":17486,"_23867":99452,"_2386":44502},[],{"_2859":58977,"_25205":58938,"_17596":99554,"_5":17486,"_23867":99452,"_2386":99555},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2859":58978,"_25205":58938,"_17596":99557,"_5":17486,"_23867":99452,"_2386":99558},[],"Certificado actual revocado",{"_2859":58979,"_25205":58938,"_17596":99560,"_5":17486,"_23867":99452,"_2386":99561},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2859":58980,"_25205":58938,"_17596":99563,"_5":17486,"_23867":99452,"_2386":99564},[],"Error de CA, perfil o firma",{"_2859":58981,"_25205":58938,"_17596":99566,"_5":17486,"_23867":99452,"_2386":99567},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2859":58982,"_25205":58938,"_17596":99569,"_5":17486,"_23867":99452,"_2386":99570},[],"HTTP 200 sin conexión del dispositivo",{"_2859":58983,"_25205":58938,"_17596":99572,"_5":17486,"_23867":99452,"_2386":99573},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2859":58984,"_25205":58938,"_17596":99575,"_5":17486,"_23867":99452,"_2386":99576},[],"Timeout o error después de emitir",{"_2859":58985,"_25205":58938,"_17596":99578,"_5":17486,"_23867":99452,"_2386":99579},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2859":58986,"_25205":58938,"_17596":99581,"_5":17486,"_23867":99456,"_2386":99582},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2859":58987,"_25205":58938,"_17596":99584,"_5":17486,"_23867":99456,"_2386":99585},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2859":58988,"_25205":58938,"_17596":99587,"_5":17486,"_23867":99459,"_2386":99588},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2859":58989,"_25205":58938,"_17596":99590,"_5":17486,"_23867":99459,"_2386":99591},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2859":58990,"_25205":58938,"_17596":99593,"_5":17486,"_23867":99459,"_2386":99594},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2859":58991,"_25205":58938,"_17596":99596,"_5":17486,"_23867":99459,"_2386":99597},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2859":58992,"_25205":58938,"_17596":99599,"_5":17486,"_23867":99459,"_2386":99600},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2859":58993,"_25205":58938,"_17596":99602,"_5":17486,"_23867":99459,"_2386":99603},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2859":58994,"_25205":58938,"_17596":99605,"_5":17486,"_23867":99459,"_2386":99606},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2859":58995,"_25205":58995,"_5":12316,"_2386":99608,"_25540":99609,"_17596":99610,"_23867":58995},"Distribución y actualización de confianza",[40894,97341,43212,98313,98488],[],{"_2859":58996,"_25205":58995,"_17596":99612,"_5":17486,"_23867":58995,"_2386":99613},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2859":58997,"_25205":58995,"_5":25537,"_17596":99615,"_23867":99616,"_2386":99617},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2859":58998,"_25205":58995,"_5":25537,"_17596":99619,"_23867":99620,"_2386":99621},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2859":58999,"_25205":58995,"_5":25537,"_17596":99623,"_23867":99624,"_2386":99625},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2859":59000,"_25205":58995,"_5":25537,"_17596":99627,"_23867":99628,"_2386":99629},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2859":59001,"_25205":58995,"_5":25537,"_17596":99631,"_23867":99632,"_2386":99633},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2859":59002,"_25205":58995,"_17596":99635,"_5":17486,"_23867":58995,"_2386":99636},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2859":59003,"_25205":58995,"_17596":99638,"_5":17486,"_23867":99616,"_2386":99639},[],"Relación",{"_2859":59004,"_25205":58995,"_17596":99641,"_5":17486,"_23867":99616,"_2386":99642},[],"Material que prepara el responsable",{"_2859":59005,"_25205":58995,"_17596":99644,"_5":17486,"_23867":99616,"_2386":99645},[],"Dispositivo → servidor EST",{"_2859":59006,"_25205":58995,"_17596":99647,"_5":17486,"_23867":99616,"_2386":99648},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2859":59007,"_25205":58995,"_17596":99650,"_5":17486,"_23867":99616,"_2386":99651},[],"DMS → solicitante",{"_2859":59008,"_25205":58995,"_17596":99653,"_5":17486,"_23867":99616,"_2386":99654},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2859":59009,"_25205":58995,"_17596":99656,"_5":17486,"_23867":99616,"_2386":99657},[],"Consumidor → dispositivo",{"_2859":59010,"_25205":58995,"_17596":99659,"_5":17486,"_23867":99616,"_2386":99660},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2859":59011,"_25205":58995,"_17596":99662,"_5":17486,"_23867":99616,"_2386":99663},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2859":59012,"_25205":58995,"_17596":99665,"_5":17486,"_23867":99620,"_2386":99666},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2859":59013,"_25205":58995,"_17596":99668,"_5":17486,"_23867":99620,"_2386":99669},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2859":59014,"_25205":58995,"_17596":99671,"_5":17486,"_23867":99624,"_2386":99672},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2859":59015,"_25205":58995,"_17596":99674,"_5":17486,"_23867":99624,"_2386":99675},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2859":59016,"_25205":58995,"_17596":99677,"_5":17486,"_23867":99624,"_2386":99678},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2859":59017,"_25205":58995,"_17596":99680,"_5":17486,"_23867":99624,"_2386":99681},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2859":59018,"_25205":58995,"_17596":99683,"_5":17486,"_23867":99624,"_2386":99684},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2859":59019,"_25205":58995,"_17596":99686,"_5":17486,"_23867":99624,"_2386":99687},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2859":59020,"_25205":58995,"_17596":99689,"_5":17486,"_23867":99628,"_2386":99690},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2859":59021,"_25205":58995,"_17596":99692,"_5":17486,"_23867":99628,"_2386":99693},[],"En el DMS, separa las CAs distribuidas de `additional_validation_cas`, utilizadas para la credencial de reenrolamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2859":59022,"_25205":58995,"_17596":99695,"_5":17486,"_23867":99628,"_2386":99696},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2859":59023,"_25205":58995,"_17596":99698,"_5":17486,"_23867":99632,"_2386":99699},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2859":59024,"_25205":59024,"_5":12316,"_2386":44651,"_25540":99701,"_17596":99703,"_23867":59024},[40894,97341,43212,98313,99702],"Integraciones",[],{"_2859":59025,"_25205":59024,"_17596":99705,"_5":17486,"_23867":59024,"_2386":99706},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2859":59026,"_25205":59024,"_5":25537,"_17596":99708,"_23867":99709,"_2386":99710},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2859":59027,"_25205":59024,"_5":25537,"_17596":99712,"_23867":99713,"_2386":99714},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2859":59028,"_25205":59024,"_5":25537,"_17596":99716,"_23867":99717,"_2386":99718},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2859":59029,"_25205":59024,"_5":25537,"_17596":99720,"_23867":99721,"_2386":99722},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2859":59030,"_25205":59024,"_5":25537,"_17596":99724,"_23867":99725,"_2386":99726},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2859":59031,"_25205":59024,"_5":25537,"_17596":99728,"_23867":99729,"_2386":99730},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2859":59032,"_25205":59024,"_5":25537,"_17596":99732,"_23867":99733,"_2386":44685},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2859":59033,"_25205":59024,"_5":25537,"_17596":99735,"_23867":99736,"_2386":44689},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2859":59034,"_25205":59024,"_5":25537,"_17596":99738,"_23867":99739,"_2386":99740},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2859":59035,"_25205":59024,"_5":25537,"_17596":99742,"_23867":99743,"_2386":99744},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2859":59036,"_25205":59024,"_5":25537,"_17596":99746,"_23867":99747,"_2386":99748},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2859":59037,"_25205":59024,"_5":25537,"_17596":99750,"_23867":99751,"_2386":99752},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2859":59038,"_25205":59024,"_5":25537,"_17596":99754,"_23867":99755,"_2386":99756},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2859":59039,"_25205":59024,"_5":25537,"_17596":99758,"_23867":99759,"_2386":99760},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2859":59040,"_25205":59024,"_5":25537,"_17596":99762,"_23867":99763,"_2386":99764},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2859":59041,"_25205":59024,"_5":25537,"_17596":99766,"_23867":99767,"_2386":99768},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2859":59042,"_25205":59024,"_5":25537,"_17596":99770,"_23867":99771,"_2386":99772},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2859":59043,"_25205":59024,"_5":25537,"_17596":99774,"_23867":99775,"_2386":99776},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2859":59044,"_25205":59024,"_5":25537,"_17596":99778,"_23867":99779,"_2386":99780},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2859":59045,"_25205":59024,"_5":25537,"_17596":99782,"_23867":99783,"_2386":99784},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2859":59046,"_25205":59024,"_17596":99786,"_5":17486,"_23867":59024,"_2386":99787},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2859":59047,"_25205":59024,"_17596":99789,"_5":17486,"_23867":59024,"_2386":99790},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2859":59048,"_25205":59024,"_17596":99792,"_5":17486,"_23867":59024,"_2386":99793},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2859":59049,"_25205":59024,"_17596":99795,"_5":17486,"_23867":99709,"_2386":99796},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2859":59050,"_25205":59024,"_17596":99798,"_5":17486,"_23867":99709,"_2386":99799},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2859":59051,"_25205":59024,"_17596":99801,"_5":17486,"_23867":99709,"_2386":99802},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2859":59052,"_25205":59024,"_17596":99804,"_5":17486,"_23867":99709,"_2386":99805},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2859":59053,"_25205":59024,"_17596":99807,"_5":17486,"_23867":99713,"_2386":99808},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2859":59054,"_25205":59024,"_17596":99810,"_5":17486,"_23867":99717,"_2386":99811},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2859":59055,"_25205":59024,"_17596":99813,"_5":17486,"_23867":99717,"_2386":99814},[],"Acción IAM",{"_2859":59056,"_25205":59024,"_17596":99816,"_5":17486,"_23867":99717,"_2386":96405},[],{"_2859":59057,"_25205":59024,"_17596":99818,"_5":17486,"_23867":99717,"_2386":44772},[],{"_2859":59058,"_25205":59024,"_17596":99820,"_5":17486,"_23867":99717,"_2386":99821},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2859":59059,"_25205":59024,"_17596":99823,"_5":17486,"_23867":99717,"_2386":44778},[],{"_2859":59060,"_25205":59024,"_17596":99825,"_5":17486,"_23867":99717,"_2386":99826},[],"Registrar la CA en AWS IoT",{"_2859":59061,"_25205":59024,"_17596":99828,"_5":17486,"_23867":99717,"_2386":44784},[],{"_2859":59062,"_25205":59024,"_17596":99830,"_5":17486,"_23867":99717,"_2386":99831},[],"Consultar el estado del registro de la CA",{"_2859":59063,"_25205":59024,"_17596":99833,"_5":17486,"_23867":99717,"_2386":44790},[],{"_2859":59064,"_25205":59024,"_17596":99835,"_5":17486,"_23867":99717,"_2386":99836},[],"Crear o actualizar Things en IoT Core",{"_2859":59065,"_25205":59024,"_17596":99838,"_5":17486,"_23867":99717,"_2386":44796},[],{"_2859":59066,"_25205":59024,"_17596":99840,"_5":17486,"_23867":99717,"_2386":99841},[],"Aprovisionar Things mediante plantilla",{"_2859":59067,"_25205":59024,"_17596":99843,"_5":17486,"_23867":99717,"_2386":44802},[],{"_2859":59068,"_25205":59024,"_17596":99845,"_5":17486,"_23867":99717,"_2386":99846},[],"Registrar certificados de dispositivo",{"_2859":59069,"_25205":59024,"_17596":99848,"_5":17486,"_23867":99717,"_2386":44808},[],{"_2859":59070,"_25205":59024,"_17596":99850,"_5":17486,"_23867":99717,"_2386":99851},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2859":59071,"_25205":59024,"_17596":99853,"_5":17486,"_23867":99717,"_2386":44814},[],{"_2859":59072,"_25205":59024,"_17596":99855,"_5":17486,"_23867":99717,"_2386":99856},[],"Crear y adjuntar políticas IoT",{"_2859":59073,"_25205":59024,"_17596":99858,"_5":17486,"_23867":99717,"_2386":44820},[],{"_2859":59074,"_25205":59024,"_17596":99860,"_5":17486,"_23867":99717,"_2386":99861},[],"Gestionar grupos de Things",{"_2859":59075,"_25205":59024,"_17596":99863,"_5":17486,"_23867":99717,"_2386":44826},[],{"_2859":59076,"_25205":59024,"_17596":99865,"_5":17486,"_23867":99717,"_2386":99866},[],"Crear plantillas JITP",{"_2859":59077,"_25205":59024,"_17596":99868,"_5":17486,"_23867":99717,"_2386":44832},[],{"_2859":59078,"_25205":59024,"_17596":99870,"_5":17486,"_23867":99717,"_2386":99871},[],"Leer y escribir el Device Shadow",{"_2859":59079,"_25205":59024,"_17596":99873,"_5":17486,"_23867":99717,"_2386":99874},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2859":59080,"_25205":59024,"_17596":99876,"_5":17486,"_23867":99721,"_2386":99877},[],"Parámetro",{"_2859":59081,"_25205":59024,"_17596":99879,"_5":17486,"_23867":99721,"_2386":99880},[],"Tipo",{"_2859":59082,"_25205":59024,"_17596":99882,"_5":17486,"_23867":99721,"_2386":99883},[],"Requerido",{"_2859":59083,"_25205":59024,"_17596":99885,"_5":17486,"_23867":99721,"_2386":99886},[],"Descripción",{"_2859":59084,"_25205":59024,"_17596":99888,"_5":17486,"_23867":99721,"_2386":44853},[],{"_2859":59085,"_25205":59024,"_17596":99890,"_5":17486,"_23867":99721,"_2386":21016},[],{"_2859":59086,"_25205":59024,"_17596":99892,"_5":17486,"_23867":99721,"_2386":99893},[],"Sí",{"_2859":59087,"_25205":59024,"_17596":99895,"_5":17486,"_23867":99721,"_2386":99896},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2859":59088,"_25205":59024,"_17596":99898,"_5":17486,"_23867":99721,"_2386":44864},[],{"_2859":59089,"_25205":59024,"_17596":99900,"_5":17486,"_23867":99721,"_2386":21016},[],{"_2859":59090,"_25205":59024,"_17596":99902,"_5":17486,"_23867":99721,"_2386":99893},[],{"_2859":59091,"_25205":59024,"_17596":99904,"_5":17486,"_23867":99721,"_2386":99905},[],"Región AWS donde opera el conector.",{"_2859":59092,"_25205":59024,"_17596":99907,"_5":17486,"_23867":99721,"_2386":44874},[],{"_2859":59093,"_25205":59024,"_17596":99909,"_5":17486,"_23867":99721,"_2386":21016},[],{"_2859":59094,"_25205":59024,"_17596":99911,"_5":17486,"_23867":99721,"_2386":99893},[],{"_2859":59095,"_25205":59024,"_17596":99913,"_5":17486,"_23867":99721,"_2386":99914},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2859":59096,"_25205":59024,"_17596":99916,"_5":17486,"_23867":99721,"_2386":44884},[],{"_2859":59097,"_25205":59024,"_17596":99918,"_5":17486,"_23867":99721,"_2386":21016},[],{"_2859":59098,"_25205":59024,"_17596":99920,"_5":17486,"_23867":99721,"_2386":99921},[],"Solo con `auth_method=static`",{"_2859":59099,"_25205":59024,"_17596":99923,"_5":17486,"_23867":99721,"_2386":99924},[],"Clave de acceso AWS.",{"_2859":59100,"_25205":59024,"_17596":99926,"_5":17486,"_23867":99721,"_2386":44895},[],{"_2859":59101,"_25205":59024,"_17596":99928,"_5":17486,"_23867":99721,"_2386":21016},[],{"_2859":59102,"_25205":59024,"_17596":99930,"_5":17486,"_23867":99721,"_2386":99921},[],{"_2859":59103,"_25205":59024,"_17596":99932,"_5":17486,"_23867":99721,"_2386":99933},[],"Clave secreta AWS.",{"_2859":59104,"_25205":59024,"_17596":99935,"_5":17486,"_23867":99721,"_2386":44905},[],{"_2859":59105,"_25205":59024,"_17596":99937,"_5":17486,"_23867":99721,"_2386":21016},[],{"_2859":59106,"_25205":59024,"_17596":99939,"_5":17486,"_23867":99721,"_2386":44910},[],{"_2859":59107,"_25205":59024,"_17596":99941,"_5":17486,"_23867":99721,"_2386":99942},[],"Token de sesión (con `auth_method=static`).",{"_2859":59108,"_25205":59024,"_17596":99944,"_5":17486,"_23867":99721,"_2386":44916},[],{"_2859":59109,"_25205":59024,"_17596":99946,"_5":17486,"_23867":99721,"_2386":21016},[],{"_2859":59110,"_25205":59024,"_17596":99948,"_5":17486,"_23867":99721,"_2386":99949},[],"Solo con `auth_method=role`",{"_2859":59111,"_25205":59024,"_17596":99951,"_5":17486,"_23867":99721,"_2386":99952},[],"ARN del rol a asumir.",{"_2859":59112,"_25205":59024,"_17596":99954,"_5":17486,"_23867":99721,"_2386":44927},[],{"_2859":59113,"_25205":59024,"_17596":99956,"_5":17486,"_23867":99721,"_2386":21016},[],{"_2859":59114,"_25205":59024,"_17596":99958,"_5":17486,"_23867":99721,"_2386":44910},[],{"_2859":59115,"_25205":59024,"_17596":99960,"_5":17486,"_23867":99721,"_2386":99961},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2859":59116,"_25205":59024,"_17596":99963,"_5":17486,"_23867":99721,"_2386":44937},[],{"_2859":59117,"_25205":59024,"_17596":99965,"_5":17486,"_23867":99721,"_2386":14760},[],{"_2859":59118,"_25205":59024,"_17596":99967,"_5":17486,"_23867":99721,"_2386":99893},[],{"_2859":59119,"_25205":59024,"_17596":99969,"_5":17486,"_23867":99721,"_2386":99970},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2859":59120,"_25205":59024,"_17596":99972,"_5":17486,"_23867":99721,"_2386":44947},[],{"_2859":59121,"_25205":59024,"_17596":99974,"_5":17486,"_23867":99721,"_2386":21016},[],{"_2859":59122,"_25205":59024,"_17596":99976,"_5":17486,"_23867":99721,"_2386":99893},[],{"_2859":59123,"_25205":59024,"_17596":99978,"_5":17486,"_23867":99721,"_2386":99979},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2859":59124,"_25205":59024,"_17596":99981,"_5":17486,"_23867":99721,"_2386":44957},[],{"_2859":59125,"_25205":59024,"_17596":99983,"_5":17486,"_23867":99721,"_2386":21016},[],{"_2859":59126,"_25205":59024,"_17596":99985,"_5":17486,"_23867":99721,"_2386":99893},[],{"_2859":59127,"_25205":59024,"_17596":99987,"_5":17486,"_23867":99721,"_2386":99988},[],"URL HTTP del Device Manager de Lamassu.",{"_2859":59128,"_25205":59024,"_17596":99990,"_5":17486,"_23867":99721,"_2386":44967},[],{"_2859":59129,"_25205":59024,"_17596":99992,"_5":17486,"_23867":99721,"_2386":21016},[],{"_2859":59130,"_25205":59024,"_17596":99994,"_5":17486,"_23867":99721,"_2386":99893},[],{"_2859":59131,"_25205":59024,"_17596":99996,"_5":17486,"_23867":99721,"_2386":99997},[],"URL HTTP del servicio de CA de Lamassu.",{"_2859":59132,"_25205":59024,"_17596":99999,"_5":17486,"_23867":99725,"_2386":100000},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2859":59133,"_25205":59024,"_17596":100002,"_5":17486,"_23867":99729,"_2386":100003},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2859":59134,"_25205":59024,"_17596":100005,"_5":17486,"_23867":99729,"_2386":100006},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2859":59135,"_25205":59024,"_17596":100008,"_5":17486,"_23867":99733,"_2386":100009},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2859":59136,"_25205":59024,"_17596":100011,"_5":17486,"_23867":99733,"_2386":100012},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2859":59137,"_25205":59024,"_17596":100014,"_5":17486,"_23867":99733,"_2386":100015},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2859":59138,"_25205":59024,"_17596":100017,"_5":17486,"_23867":99733,"_2386":100018},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2859":59139,"_25205":59024,"_17596":100020,"_5":17486,"_23867":99733,"_2386":100021},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2859":59140,"_25205":59024,"_17596":100023,"_5":17486,"_23867":99733,"_2386":100024},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2859":59141,"_25205":59024,"_17596":100026,"_5":17486,"_23867":99736,"_2386":100027},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2859":59142,"_25205":59024,"_17596":100029,"_5":17486,"_23867":99739,"_2386":100030},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2859":59143,"_25205":59024,"_17596":100032,"_5":17486,"_23867":99739,"_2386":100033},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2859":59144,"_25205":59024,"_17596":100035,"_5":17486,"_23867":99743,"_2386":100036},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2859":59145,"_25205":59024,"_17596":100038,"_5":17486,"_23867":99747,"_2386":100039},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2859":59146,"_25205":59024,"_17596":100041,"_5":17486,"_23867":99747,"_2386":100042},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2859":59147,"_25205":59024,"_17596":100044,"_5":17486,"_23867":99747,"_2386":100045},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2859":59148,"_25205":59024,"_17596":100047,"_5":17486,"_23867":99747,"_2386":100048},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2859":59149,"_25205":59024,"_17596":100050,"_5":17486,"_23867":99747,"_2386":100051},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2859":59150,"_25205":59024,"_17596":100053,"_5":17486,"_23867":99747,"_2386":100054},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2859":59151,"_25205":59024,"_17596":100056,"_5":17486,"_23867":99751,"_2386":100057},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2859":59152,"_25205":59024,"_17596":100059,"_5":17486,"_23867":99751,"_2386":100060},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2859":59153,"_25205":59024,"_17596":100062,"_5":17486,"_23867":99751,"_2386":100063},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2859":59154,"_25205":59024,"_17596":100065,"_5":17486,"_23867":99755,"_2386":100066},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2859":59155,"_25205":59024,"_17596":100068,"_5":17486,"_23867":99755,"_2386":100069},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2859":59156,"_25205":59024,"_17596":100071,"_5":17486,"_23867":99755,"_2386":100072},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2859":59157,"_25205":59024,"_17596":100074,"_5":17486,"_23867":99759,"_2386":100075},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2859":59158,"_25205":59024,"_17596":100077,"_5":17486,"_23867":99759,"_2386":100078},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2859":59159,"_25205":59024,"_17596":100080,"_5":17486,"_23867":99759,"_2386":100081},[],"Para que el flujo JITP funcione correctamente:",{"_2859":59160,"_25205":59024,"_17596":100083,"_5":17486,"_23867":99759,"_2386":100084},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2859":59161,"_25205":59024,"_17596":100086,"_5":17486,"_23867":99759,"_2386":100087},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2859":59162,"_25205":59024,"_17596":100089,"_5":17486,"_23867":99759,"_2386":100090},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2859":59163,"_25205":59024,"_17596":100092,"_5":17486,"_23867":99759,"_2386":100093},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2859":59164,"_25205":59024,"_17596":100095,"_5":17486,"_23867":99763,"_2386":100096},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2859":59165,"_25205":59024,"_17596":100098,"_5":17486,"_23867":99763,"_2386":100099},[],"Estado en Lamassu",{"_2859":59166,"_25205":59024,"_17596":100101,"_5":17486,"_23867":99763,"_2386":100102},[],"Razón de revocación",{"_2859":59167,"_25205":59024,"_17596":100104,"_5":17486,"_23867":99763,"_2386":100105},[],"Estado en AWS IoT Core",{"_2859":59168,"_25205":59024,"_17596":100107,"_5":17486,"_23867":99763,"_2386":45088},[],{"_2859":59169,"_25205":59024,"_17596":100109,"_5":17486,"_23867":99763,"_2386":100110},[],"Ninguna",{"_2859":59170,"_25205":59024,"_17596":100112,"_5":17486,"_23867":99763,"_2386":45094},[],{"_2859":59171,"_25205":59024,"_17596":100114,"_5":17486,"_23867":99763,"_2386":45097},[],{"_2859":59172,"_25205":59024,"_17596":100116,"_5":17486,"_23867":99763,"_2386":45100},[],{"_2859":59173,"_25205":59024,"_17596":100118,"_5":17486,"_23867":99763,"_2386":45103},[],{"_2859":59174,"_25205":59024,"_17596":100120,"_5":17486,"_23867":99763,"_2386":45097},[],{"_2859":59175,"_25205":59024,"_17596":100122,"_5":17486,"_23867":99763,"_2386":100123},[],"Cualquier otra razón",{"_2859":59176,"_25205":59024,"_17596":100125,"_5":17486,"_23867":99763,"_2386":45111},[],{"_2859":59177,"_25205":59024,"_17596":100127,"_5":17486,"_23867":99763,"_2386":100128},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2859":59178,"_25205":59024,"_17596":100130,"_5":17486,"_23867":99767,"_2386":100131},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2859":59179,"_25205":59024,"_17596":100133,"_5":17486,"_23867":99767,"_2386":100134},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2859":59180,"_25205":59024,"_17596":100136,"_5":17486,"_23867":99767,"_2386":100137},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2859":59181,"_25205":59024,"_17596":100139,"_5":17486,"_23867":99771,"_2386":100140},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2859":59182,"_25205":59024,"_17596":100142,"_5":17486,"_23867":99771,"_2386":100143},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2859":59183,"_25205":59024,"_17596":100145,"_5":17486,"_23867":99775,"_2386":100146},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2859":59184,"_25205":59024,"_17596":100148,"_5":17486,"_23867":99775,"_2386":100149},[],"Existen dos tipos de acciones:",{"_2859":59185,"_25205":59024,"_17596":100151,"_5":17486,"_23867":99775,"_2386":100152},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2859":59186,"_25205":59024,"_17596":100154,"_5":17486,"_23867":99775,"_2386":100155},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2859":59187,"_25205":59024,"_17596":100157,"_5":17486,"_23867":99775,"_2386":100158},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2859":59188,"_25205":59024,"_17596":100160,"_5":17486,"_23867":99779,"_2386":100161},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2859":59189,"_25205":59024,"_17596":100163,"_5":17486,"_23867":99779,"_2386":100164},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2859":59190,"_25205":59024,"_17596":100166,"_5":17486,"_23867":99779,"_2386":100167},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2859":59191,"_25205":59024,"_17596":100169,"_5":17486,"_23867":99783,"_2386":100170},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2859":59192,"_25205":59024,"_17596":100172,"_5":17486,"_23867":99783,"_2386":100173},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2859":59193,"_25205":59024,"_17596":100175,"_5":17486,"_23867":99783,"_2386":100176},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2859":59194,"_25205":59024,"_17596":100178,"_5":17486,"_23867":99783,"_2386":100179},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2859":59195,"_25205":59024,"_17596":100181,"_5":17486,"_23867":99783,"_2386":100182},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2859":59196,"_25205":59024,"_17596":100184,"_5":17486,"_23867":99783,"_2386":100185},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2859":59197,"_25205":59024,"_17596":100187,"_5":17486,"_23867":99783,"_2386":100188},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2859":59198,"_25205":59024,"_17596":100190,"_5":17486,"_23867":99783,"_2386":100191},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2859":59199,"_25205":59024,"_17596":100193,"_5":17486,"_23867":99783,"_2386":100194},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2859":59200,"_25205":59024,"_17596":100196,"_5":17486,"_23867":99783,"_2386":100197},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2859":59201,"_25205":59024,"_17596":100199,"_5":17486,"_23867":99783,"_2386":100200},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2859":59202,"_25205":59024,"_17596":100202,"_5":17486,"_23867":99783,"_2386":100203},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2859":59203,"_25205":59024,"_17596":100205,"_5":17486,"_23867":99783,"_2386":100206},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2859":59204,"_25205":59024,"_17596":100208,"_5":17486,"_23867":99783,"_2386":100209},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2859":59205,"_25205":59024,"_17596":100211,"_5":17486,"_23867":99783,"_2386":100212},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2859":59206,"_25205":59024,"_17596":100214,"_5":17486,"_23867":99783,"_2386":100215},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2859":59207,"_25205":59024,"_17596":100217,"_5":17486,"_23867":99783,"_2386":100218},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2859":59208,"_25205":59024,"_17596":100220,"_5":17486,"_23867":99783,"_2386":100221},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2859":59209,"_25205":59024,"_17596":100223,"_5":17486,"_23867":99783,"_2386":100224},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en la cola de mensajes fallidos `lamassu-dlq`.",{"_2859":59210,"_25205":59024,"_17596":100226,"_5":17486,"_23867":99783,"_2386":100227},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`.",{"_2859":59211,"_25205":59024,"_17596":100229,"_5":17486,"_23867":99783,"_2386":100230},[],"**Resolución:** Verificar que la plantilla nombrada con el ID del DMS sigue existiendo en AWS IoT Core y que el enrolamiento JITP funciona. El mensaje de `lamassu-dlq` refleja el intento de recreación fallido, no un flujo JITP roto.",{"_2859":59212,"_25205":59024,"_17596":100232,"_5":17486,"_23867":99783,"_2386":100233},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2859":59213,"_25205":59024,"_17596":100235,"_5":17486,"_23867":99783,"_2386":100236},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2859":59214,"_25205":59024,"_17596":100238,"_5":17486,"_23867":99783,"_2386":100239},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2859":59215,"_25205":59215,"_5":12316,"_2386":43212,"_25540":100241,"_17596":100242,"_23867":59215},[40894,97341,43212],[],{"_2859":59216,"_25205":59215,"_17596":100244,"_5":17486,"_23867":59215,"_2386":100245},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2859":59217,"_25205":59215,"_5":25537,"_17596":100247,"_23867":100248,"_2386":100249},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2859":59218,"_25205":59215,"_5":25537,"_17596":100251,"_23867":100252,"_2386":98313},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2859":59219,"_25205":59215,"_5":25537,"_17596":100254,"_23867":100255,"_2386":98488},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2859":59220,"_25205":59215,"_5":25537,"_17596":100257,"_23867":100258,"_2386":99702},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/overview#integraciones",{"_2859":59221,"_25205":59215,"_5":25537,"_17596":100260,"_23867":100261,"_2386":100262},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2859":59222,"_25205":59215,"_17596":100264,"_5":17486,"_23867":59215,"_2386":100265},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2859":59223,"_25205":59215,"_17596":100267,"_5":17486,"_23867":100248,"_2386":100268},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2859":59224,"_25205":59215,"_17596":100270,"_5":17486,"_23867":100248,"_2386":100271},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2859":59225,"_25205":59215,"_17596":100273,"_5":17486,"_23867":100252,"_2386":100274},[],"Recurso",{"_2859":59226,"_25205":59215,"_17596":100276,"_5":17486,"_23867":100252,"_2386":100277},[],"Qué representa",{"_2859":59227,"_25205":59215,"_17596":100279,"_5":17486,"_23867":100252,"_2386":100280},[],"**Dispositivo**",{"_2859":59228,"_25205":59215,"_17596":100282,"_5":17486,"_23867":100252,"_2386":100283},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2859":59229,"_25205":59215,"_17596":100285,"_5":17486,"_23867":100252,"_2386":100286},[],"**Identidad**",{"_2859":59230,"_25205":59215,"_17596":100288,"_5":17486,"_23867":100252,"_2386":100289},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2859":59231,"_25205":59215,"_17596":100291,"_5":17486,"_23867":100252,"_2386":45278},[],{"_2859":59232,"_25205":59215,"_17596":100293,"_5":17486,"_23867":100252,"_2386":100294},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2859":59233,"_25205":59215,"_17596":100296,"_5":17486,"_23867":100252,"_2386":100297},[],"**Flota**",{"_2859":59234,"_25205":59215,"_17596":100299,"_5":17486,"_23867":100252,"_2386":100300},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2859":59235,"_25205":59215,"_17596":100302,"_5":17486,"_23867":100252,"_2386":100303},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2859":59236,"_25205":59215,"_17596":100305,"_5":17486,"_23867":100252,"_2386":100306},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2859":59237,"_25205":59215,"_17596":100308,"_5":17486,"_23867":100255,"_2386":100309},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2859":59238,"_25205":59215,"_17596":100311,"_5":17486,"_23867":100255,"_2386":100312},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2859":59239,"_25205":59215,"_17596":100314,"_5":17486,"_23867":100255,"_2386":100315},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2859":59240,"_25205":59215,"_17596":100317,"_5":17486,"_23867":100255,"_2386":100318},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2859":59241,"_25205":59215,"_17596":100320,"_5":17486,"_23867":100255,"_2386":100321},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2859":59242,"_25205":59215,"_17596":100323,"_5":17486,"_23867":100255,"_2386":100324},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2859":59243,"_25205":59215,"_17596":100326,"_5":17486,"_23867":100255,"_2386":100327},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2859":59244,"_25205":59215,"_17596":100329,"_5":17486,"_23867":100255,"_2386":100330},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2859":59245,"_25205":59215,"_17596":100332,"_5":17486,"_23867":100258,"_2386":100333},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2859":59246,"_25205":59215,"_17596":100335,"_5":17486,"_23867":100258,"_2386":100336},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2859":59247,"_25205":59215,"_17596":100338,"_5":17486,"_23867":100261,"_2386":100339},[],"Participante",{"_2859":59248,"_25205":59215,"_17596":100341,"_5":17486,"_23867":100261,"_2386":100342},[],"Responsabilidad",{"_2859":59249,"_25205":59215,"_17596":100344,"_5":17486,"_23867":100261,"_2386":100345},[],"Administrador PKI",{"_2859":59250,"_25205":59215,"_17596":100347,"_5":17486,"_23867":100261,"_2386":100348},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2859":59251,"_25205":59215,"_17596":100350,"_5":17486,"_23867":100261,"_2386":100351},[],"Administrador del aprovisionamiento",{"_2859":59252,"_25205":59215,"_17596":100353,"_5":17486,"_23867":100261,"_2386":100354},[],"DMS, admisión, autenticación por operación e inventario.",{"_2859":59253,"_25205":59215,"_17596":100356,"_5":17486,"_23867":100261,"_2386":100357},[],"Integrador del dispositivo",{"_2859":59254,"_25205":59215,"_17596":100359,"_5":17486,"_23867":100261,"_2386":100360},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2859":59255,"_25205":59215,"_17596":100362,"_5":17486,"_23867":100261,"_2386":100363},[],"Integrador del consumidor",{"_2859":59256,"_25205":59215,"_17596":100365,"_5":17486,"_23867":100261,"_2386":100366},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2859":59257,"_25205":59215,"_17596":100368,"_5":17486,"_23867":100261,"_2386":100369},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2859":59258,"_25205":59258,"_5":12316,"_2386":100371,"_25540":100372,"_17596":100374,"_23867":59258},"Enrola y conecta tu primer dispositivo",[40894,97341,43212,100373],"Primeros pasos",[],{"_2859":59259,"_25205":59258,"_17596":100376,"_5":17486,"_23867":59258,"_2386":100377},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2859":59260,"_25205":59258,"_5":25537,"_17596":100379,"_23867":100380,"_2386":96042},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2859":59261,"_25205":59258,"_5":25537,"_17596":100382,"_23867":100383,"_2386":100384},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2859":59262,"_25205":59258,"_5":25537,"_17596":100386,"_23867":100387,"_2386":100388},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2859":59263,"_25205":59258,"_5":25537,"_17596":100390,"_23867":100391,"_2386":100392},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2859":59264,"_25205":59258,"_5":25537,"_17596":100394,"_23867":100395,"_2386":100396},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2859":59265,"_25205":59258,"_5":25537,"_17596":100398,"_23867":100399,"_2386":100400},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2859":59266,"_25205":59258,"_5":25537,"_17596":100402,"_23867":100403,"_2386":100404},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2859":59267,"_25205":59258,"_5":25537,"_17596":100406,"_23867":100407,"_2386":100408},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2859":59268,"_25205":59258,"_17596":100410,"_5":17486,"_23867":59258,"_2386":100411},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2859":59269,"_25205":59258,"_17596":100413,"_5":17486,"_23867":100380,"_2386":100414},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2859":59270,"_25205":59258,"_17596":100416,"_5":17486,"_23867":100380,"_2386":100417},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2859":59271,"_25205":59258,"_17596":100419,"_5":17486,"_23867":100380,"_2386":100420},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2859":59272,"_25205":59258,"_17596":100422,"_5":17486,"_23867":100380,"_2386":100423},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2859":59273,"_25205":59258,"_17596":100425,"_5":17486,"_23867":100380,"_2386":100426},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2859":59274,"_25205":59258,"_17596":100428,"_5":17486,"_23867":100383,"_2386":100429},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2859":59275,"_25205":59258,"_17596":100431,"_5":17486,"_23867":100383,"_2386":100432},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2859":59276,"_25205":59258,"_17596":100434,"_5":17486,"_23867":100387,"_2386":100435},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2859":59277,"_25205":59258,"_17596":100437,"_5":17486,"_23867":100387,"_2386":100438},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2859":59278,"_25205":59258,"_17596":100440,"_5":17486,"_23867":100387,"_2386":100441},[],"Ajuste",{"_2859":59279,"_25205":59258,"_17596":100443,"_5":17486,"_23867":100387,"_2386":100444},[],"Valor de evaluación",{"_2859":59280,"_25205":59258,"_17596":100446,"_5":17486,"_23867":100387,"_2386":45434},[],{"_2859":59281,"_25205":59258,"_17596":100448,"_5":17486,"_23867":100387,"_2386":100449},[],"Raíz emisora de `device-root.pem`.",{"_2859":59282,"_25205":59258,"_17596":100451,"_5":17486,"_23867":100387,"_2386":98616},[],{"_2859":59283,"_25205":59258,"_17596":100453,"_5":17486,"_23867":100387,"_2386":100454},[],"Perfil final de 1 hora que acabas de preparar.",{"_2859":59284,"_25205":59258,"_17596":100456,"_5":17486,"_23867":100387,"_2386":45445},[],{"_2859":59285,"_25205":59258,"_17596":100458,"_5":17486,"_23867":100387,"_2386":45448},[],{"_2859":59286,"_25205":59258,"_17596":100460,"_5":17486,"_23867":100387,"_2386":45451},[],{"_2859":59287,"_25205":59258,"_17596":100462,"_5":17486,"_23867":100387,"_2386":100463},[],"Habilitado.",{"_2859":59288,"_25205":59258,"_17596":100465,"_5":17486,"_23867":100387,"_2386":45457},[],{"_2859":59289,"_25205":59258,"_17596":100467,"_5":17486,"_23867":100387,"_2386":100468},[],"Deshabilitado; el ID debe ser nuevo.",{"_2859":59290,"_25205":59258,"_17596":100470,"_5":17486,"_23867":100387,"_2386":100471},[],"Autenticación inicial",{"_2859":59291,"_25205":59258,"_17596":100473,"_5":17486,"_23867":100387,"_2386":100474},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2859":59292,"_25205":59258,"_17596":100476,"_5":17486,"_23867":100387,"_2386":100477},[],"Autenticación de renovación",{"_2859":59293,"_25205":59258,"_17596":100479,"_5":17486,"_23867":100387,"_2386":100480},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2859":59294,"_25205":59258,"_17596":100482,"_5":17486,"_23867":100387,"_2386":45475},[],{"_2859":59295,"_25205":59258,"_17596":100484,"_5":17486,"_23867":100387,"_2386":100485},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2859":59296,"_25205":59258,"_17596":100487,"_5":17486,"_23867":100387,"_2386":45481},[],{"_2859":59297,"_25205":59258,"_17596":100489,"_5":17486,"_23867":100387,"_2386":100490},[],"1 hora.",{"_2859":59298,"_25205":59258,"_17596":100492,"_5":17486,"_23867":100387,"_2386":45487},[],{"_2859":59299,"_25205":59258,"_17596":100494,"_5":17486,"_23867":100387,"_2386":100495},[],"30 minutos / 10 minutos.",{"_2859":59300,"_25205":59258,"_17596":100497,"_5":17486,"_23867":100387,"_2386":45493},[],{"_2859":59301,"_25205":59258,"_17596":100499,"_5":17486,"_23867":100387,"_2386":100500},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2859":59302,"_25205":59258,"_17596":100502,"_5":17486,"_23867":100387,"_2386":43531},[],{"_2859":59303,"_25205":59258,"_17596":100504,"_5":17486,"_23867":100387,"_2386":100505},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2859":59304,"_25205":59258,"_17596":100507,"_5":17486,"_23867":100387,"_2386":45504},[],{"_2859":59305,"_25205":59258,"_17596":100509,"_5":17486,"_23867":100387,"_2386":100510},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2859":59306,"_25205":59258,"_17596":100512,"_5":17486,"_23867":100387,"_2386":100513},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2859":59307,"_25205":59258,"_17596":100515,"_5":17486,"_23867":100391,"_2386":100516},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2859":59308,"_25205":59258,"_17596":100518,"_5":17486,"_23867":100391,"_2386":100519},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2859":59309,"_25205":59258,"_17596":100521,"_5":17486,"_23867":100395,"_2386":100522},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2859":59310,"_25205":59258,"_17596":100524,"_5":17486,"_23867":100395,"_2386":100525},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2859":59311,"_25205":59258,"_17596":100527,"_5":17486,"_23867":100395,"_2386":100528},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2859":59312,"_25205":59258,"_17596":100530,"_5":17486,"_23867":100399,"_2386":100531},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2859":59313,"_25205":59258,"_17596":100533,"_5":17486,"_23867":100399,"_2386":100534},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2859":59314,"_25205":59258,"_17596":100536,"_5":17486,"_23867":100403,"_2386":100537},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2859":59315,"_25205":59258,"_17596":100539,"_5":17486,"_23867":100403,"_2386":100540},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2859":59316,"_25205":59258,"_17596":100542,"_5":17486,"_23867":100403,"_2386":100543},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2859":59317,"_25205":59258,"_17596":100545,"_5":17486,"_23867":100403,"_2386":100546},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2859":59318,"_25205":59258,"_17596":100548,"_5":17486,"_23867":100403,"_2386":100549},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2859":59319,"_25205":59258,"_17596":100551,"_5":17486,"_23867":100407,"_2386":100552},[],"Comprobación",{"_2859":59320,"_25205":59258,"_17596":100554,"_5":17486,"_23867":100407,"_2386":100555},[],"Resultado esperado",{"_2859":59321,"_25205":59258,"_17596":100557,"_5":17486,"_23867":100407,"_2386":100558},[],"Registro",{"_2859":59322,"_25205":59258,"_17596":100560,"_5":17486,"_23867":100407,"_2386":100561},[],"ID creado automáticamente y DMS correcto.",{"_2859":59323,"_25205":59258,"_17596":100563,"_5":17486,"_23867":100407,"_2386":100564},[],"Certificado",{"_2859":59324,"_25205":59258,"_17596":100566,"_5":17486,"_23867":100407,"_2386":100567},[],"CN, perfil, serie y clave verificados.",{"_2859":59325,"_25205":59258,"_17596":100569,"_5":17486,"_23867":100407,"_2386":100570},[],"Inventario",{"_2859":59326,"_25205":59258,"_17596":100572,"_5":17486,"_23867":100407,"_2386":100573},[],"Serie recibida visible como identidad actual y en el historial.",{"_2859":59327,"_25205":59258,"_17596":100575,"_5":17486,"_23867":100407,"_2386":100576},[],"Consumidor",{"_2859":59328,"_25205":59258,"_17596":100578,"_5":17486,"_23867":100407,"_2386":100579},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2859":59329,"_25205":59258,"_17596":100581,"_5":17486,"_23867":100407,"_2386":100582},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2859":59330,"_25205":59258,"_17596":100584,"_5":17486,"_23867":100407,"_2386":100585},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2859":59331,"_25205":59331,"_5":12316,"_2386":98330,"_25540":100587,"_17596":100588,"_23867":59331},[40894,97341,43212,100373],[],{"_2859":59332,"_25205":59331,"_17596":100590,"_5":17486,"_23867":59331,"_2386":100591},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2859":59333,"_25205":59331,"_5":25537,"_17596":100593,"_23867":100594,"_2386":96042},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2859":59334,"_25205":59331,"_5":25537,"_17596":100596,"_23867":100597,"_2386":100598},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2859":59335,"_25205":59331,"_5":25537,"_17596":100600,"_23867":100601,"_2386":100602},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2859":59336,"_25205":59331,"_5":25537,"_17596":100604,"_23867":100605,"_2386":100606},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2859":59337,"_25205":59331,"_5":25537,"_17596":100608,"_23867":100609,"_2386":100610},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2859":59338,"_25205":59331,"_5":25537,"_17596":100612,"_23867":100613,"_2386":100614},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2859":59339,"_25205":59331,"_5":25537,"_17596":100616,"_23867":100617,"_2386":100555},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2859":59340,"_25205":59331,"_5":25537,"_17596":100619,"_23867":100620,"_2386":100621},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2859":59341,"_25205":59331,"_5":25537,"_17596":100623,"_23867":100624,"_2386":100625},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2859":59342,"_25205":59331,"_17596":100627,"_5":17486,"_23867":59331,"_2386":100628},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2859":59343,"_25205":59331,"_17596":100630,"_5":17486,"_23867":59331,"_2386":100631},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2859":59344,"_25205":59331,"_17596":100633,"_5":17486,"_23867":100594,"_2386":100634},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2859":59345,"_25205":59331,"_17596":100636,"_5":17486,"_23867":100594,"_2386":100637},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2859":59346,"_25205":59331,"_17596":100639,"_5":17486,"_23867":100594,"_2386":100640},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2859":59347,"_25205":59331,"_17596":100642,"_5":17486,"_23867":100594,"_2386":100643},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2859":59348,"_25205":59331,"_17596":100645,"_5":17486,"_23867":100597,"_2386":100646},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2859":59349,"_25205":59331,"_17596":100648,"_5":17486,"_23867":100597,"_2386":100649},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2859":59350,"_25205":59331,"_17596":100651,"_5":17486,"_23867":100597,"_2386":100652},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2859":59351,"_25205":59331,"_17596":100654,"_5":17486,"_23867":100597,"_2386":100655},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2859":59352,"_25205":59331,"_17596":100657,"_5":17486,"_23867":100597,"_2386":100658},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2859":59353,"_25205":59331,"_17596":100660,"_5":17486,"_23867":100597,"_2386":100661},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2859":59354,"_25205":59331,"_17596":100663,"_5":17486,"_23867":100597,"_2386":100664},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2859":59355,"_25205":59331,"_17596":100666,"_5":17486,"_23867":100597,"_2386":100667},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2859":59356,"_25205":59331,"_17596":100669,"_5":17486,"_23867":100601,"_2386":100670},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2859":59357,"_25205":59331,"_17596":100672,"_5":17486,"_23867":100601,"_2386":45670},[],{"_2859":59358,"_25205":59331,"_17596":100674,"_5":17486,"_23867":100601,"_2386":100675},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2859":59359,"_25205":59331,"_17596":100677,"_5":17486,"_23867":100601,"_2386":100678},[],"**Icon** y **Tags**: clasificación opcional.",{"_2859":59360,"_25205":59331,"_17596":100680,"_5":17486,"_23867":100601,"_2386":100681},[],"Confirma el registro.",{"_2859":59361,"_25205":59331,"_17596":100683,"_5":17486,"_23867":100605,"_2386":100684},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2859":59362,"_25205":59331,"_17596":100686,"_5":17486,"_23867":100605,"_2386":100687},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2859":59363,"_25205":59331,"_17596":100689,"_5":17486,"_23867":100609,"_2386":100690},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2859":59364,"_25205":59331,"_17596":100692,"_5":17486,"_23867":100609,"_2386":100693},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2859":59365,"_25205":59331,"_17596":100695,"_5":17486,"_23867":100613,"_2386":100696},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2859":59366,"_25205":59331,"_17596":100698,"_5":17486,"_23867":100613,"_2386":100699},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2859":59367,"_25205":59331,"_17596":100701,"_5":17486,"_23867":100617,"_2386":100552},[],{"_2859":59368,"_25205":59331,"_17596":100703,"_5":17486,"_23867":100617,"_2386":100704},[],"Resultado",{"_2859":59369,"_25205":59331,"_17596":100706,"_5":17486,"_23867":100617,"_2386":100707},[],"Dispositivo",{"_2859":59370,"_25205":59331,"_17596":100709,"_5":17486,"_23867":100617,"_2386":100710},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2859":59371,"_25205":59331,"_17596":100712,"_5":17486,"_23867":100617,"_2386":100713},[],"Identidad actual",{"_2859":59372,"_25205":59331,"_17596":100715,"_5":17486,"_23867":100617,"_2386":100716},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2859":59373,"_25205":59331,"_17596":100718,"_5":17486,"_23867":100617,"_2386":100719},[],"Historial",{"_2859":59374,"_25205":59331,"_17596":100721,"_5":17486,"_23867":100617,"_2386":100722},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2859":59375,"_25205":59331,"_17596":100724,"_5":17486,"_23867":100617,"_2386":100725},[],"Clave y certificado",{"_2859":59376,"_25205":59331,"_17596":100727,"_5":17486,"_23867":100617,"_2386":100728},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2859":59377,"_25205":59331,"_17596":100730,"_5":17486,"_23867":100620,"_2386":100731},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2859":59378,"_25205":59331,"_17596":100733,"_5":17486,"_23867":100620,"_2386":100734},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2859":59379,"_25205":59331,"_17596":100736,"_5":17486,"_23867":100620,"_2386":100737},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2859":59380,"_25205":59331,"_17596":100739,"_5":17486,"_23867":100620,"_2386":100740},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2859":59381,"_25205":59331,"_17596":100742,"_5":17486,"_23867":100624,"_2386":100743},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2859":59382,"_25205":59331,"_17596":100745,"_5":17486,"_23867":100624,"_2386":100746},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2859":59383,"_25205":59331,"_17596":100748,"_5":17486,"_23867":100624,"_2386":100749},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2859":59384,"_25205":59384,"_5":12316,"_2386":100751,"_25540":100752,"_17596":100753,"_23867":59384},"Plataforma Lamassu IoT",[40894,97341],[],{"_2859":59385,"_25205":59384,"_17596":100755,"_5":17486,"_23867":59384,"_2386":100756},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2859":59386,"_25205":59384,"_5":25537,"_17596":100758,"_23867":100759,"_2386":100249},[],"/docs/pr-preview/pr-43/es/platform/overview#empieza-aquí",{"_2859":59387,"_25205":59384,"_5":25537,"_17596":100761,"_23867":100762,"_2386":100763},[],"/docs/pr-preview/pr-43/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2859":59388,"_25205":59384,"_5":25537,"_17596":100765,"_23867":100766,"_2386":100767},[],"/docs/pr-preview/pr-43/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2859":59389,"_25205":59384,"_5":25537,"_17596":100769,"_23867":100770,"_2386":100771},[],"/docs/pr-preview/pr-43/es/platform/overview#capacidades-principales","Capacidades principales",{"_2859":59390,"_25205":59384,"_5":25537,"_17596":100773,"_23867":100774,"_2386":100775},[],"/docs/pr-preview/pr-43/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2859":59391,"_25205":59384,"_5":25537,"_17596":100777,"_23867":100778,"_2386":100779},[],"/docs/pr-preview/pr-43/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2859":59392,"_25205":59384,"_5":25537,"_17596":100781,"_23867":100782,"_2386":100783},[],"/docs/pr-preview/pr-43/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2859":59393,"_25205":59384,"_5":25537,"_17596":100785,"_23867":100786,"_2386":100787},[],"/docs/pr-preview/pr-43/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2859":59394,"_25205":59384,"_5":25537,"_17596":100789,"_23867":100790,"_2386":100791},[],"/docs/pr-preview/pr-43/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2859":59395,"_25205":59384,"_5":25537,"_17596":100793,"_23867":100794,"_2386":100795},[],"/docs/pr-preview/pr-43/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2859":59396,"_25205":59384,"_5":25537,"_17596":100797,"_23867":100798,"_2386":100799},[],"/docs/pr-preview/pr-43/es/platform/overview#referencia-operativa","Referencia operativa",{"_2859":59397,"_25205":59384,"_17596":100801,"_5":17486,"_23867":59384,"_2386":100802},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2859":59398,"_25205":59384,"_17596":100804,"_5":17486,"_23867":100759,"_2386":100805},[],"Elige el resultado que necesitas obtener:",{"_2859":59399,"_25205":59384,"_17596":100807,"_5":17486,"_23867":100759,"_2386":100808},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2859":59400,"_25205":59384,"_17596":100810,"_5":17486,"_23867":100759,"_2386":100811},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2859":59401,"_25205":59384,"_17596":100813,"_5":17486,"_23867":100759,"_2386":100814},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2859":59402,"_25205":59384,"_17596":100816,"_5":17486,"_23867":100762,"_2386":100817},[],"Bloque",{"_2859":59403,"_25205":59384,"_17596":100819,"_5":17486,"_23867":100762,"_2386":100820},[],"Qué gestionas",{"_2859":59404,"_25205":59384,"_17596":100822,"_5":17486,"_23867":100762,"_2386":100823},[],"Punto de entrada",{"_2859":59405,"_25205":59384,"_17596":100825,"_5":17486,"_23867":100762,"_2386":45824},[],{"_2859":59406,"_25205":59384,"_17596":100827,"_5":17486,"_23867":100762,"_2386":100828},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2859":59407,"_25205":59384,"_17596":100830,"_5":17486,"_23867":100762,"_2386":100831},[],"Visión general de PKI",{"_2859":59408,"_25205":59384,"_17596":100833,"_5":17486,"_23867":100762,"_2386":45833},[],{"_2859":59409,"_25205":59384,"_17596":100835,"_5":17486,"_23867":100762,"_2386":100836},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2859":59410,"_25205":59384,"_17596":100838,"_5":17486,"_23867":100762,"_2386":100839},[],"Visión general de IoT Fleets",{"_2859":59411,"_25205":59384,"_17596":100841,"_5":17486,"_23867":100762,"_2386":100842},[],"**Administración**",{"_2859":59412,"_25205":59384,"_17596":100844,"_5":17486,"_23867":100762,"_2386":100845},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2859":59413,"_25205":59384,"_17596":100847,"_5":17486,"_23867":100762,"_2386":97339},[],{"_2859":59414,"_25205":59384,"_17596":100849,"_5":17486,"_23867":100762,"_2386":100850},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2859":59415,"_25205":59384,"_17596":100852,"_5":17486,"_23867":100766,"_2386":100853},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2859":59416,"_25205":59384,"_17596":100855,"_5":17486,"_23867":100766,"_2386":100856},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2859":59417,"_25205":59384,"_17596":100858,"_5":17486,"_23867":100766,"_2386":100859},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2859":59418,"_25205":59384,"_17596":100861,"_5":17486,"_23867":100766,"_2386":100862},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2859":59419,"_25205":59384,"_17596":100864,"_5":17486,"_23867":100766,"_2386":100865},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2859":59420,"_25205":59384,"_17596":100867,"_5":17486,"_23867":100766,"_2386":100868},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2859":59421,"_25205":59384,"_17596":100870,"_5":17486,"_23867":100774,"_2386":100871},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2859":59422,"_25205":59384,"_17596":100873,"_5":17486,"_23867":100778,"_2386":100874},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2859":59423,"_25205":59384,"_17596":100876,"_5":17486,"_23867":100782,"_2386":100877},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2859":59424,"_25205":59384,"_17596":100879,"_5":17486,"_23867":100786,"_2386":100880},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2859":59425,"_25205":59384,"_17596":100882,"_5":17486,"_23867":100790,"_2386":100883},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2859":59426,"_25205":59384,"_17596":100885,"_5":17486,"_23867":100794,"_2386":100886},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2859":59427,"_25205":59384,"_17596":100888,"_5":17486,"_23867":100798,"_2386":100342},[],{"_2859":59428,"_25205":59384,"_17596":100890,"_5":17486,"_23867":100798,"_2386":100891},[],"Qué prepara o comprueba",{"_2859":59429,"_25205":59384,"_17596":100893,"_5":17486,"_23867":100798,"_2386":100345},[],{"_2859":59430,"_25205":59384,"_17596":100895,"_5":17486,"_23867":100798,"_2386":100896},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2859":59431,"_25205":59384,"_17596":100898,"_5":17486,"_23867":100798,"_2386":100899},[],"Administrador de la flota",{"_2859":59432,"_25205":59384,"_17596":100901,"_5":17486,"_23867":100798,"_2386":100902},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2859":59433,"_25205":59384,"_17596":100904,"_5":17486,"_23867":100798,"_2386":100357},[],{"_2859":59434,"_25205":59384,"_17596":100906,"_5":17486,"_23867":100798,"_2386":100907},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2859":59435,"_25205":59384,"_17596":100909,"_5":17486,"_23867":100798,"_2386":100363},[],{"_2859":59436,"_25205":59384,"_17596":100911,"_5":17486,"_23867":100798,"_2386":100912},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2859":59437,"_25205":59384,"_17596":100914,"_5":17486,"_23867":100798,"_2386":100915},[],"Operador de infraestructura",{"_2859":59438,"_25205":59384,"_17596":100917,"_5":17486,"_23867":100798,"_2386":100918},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2859":59439,"_25205":59384,"_17596":100920,"_5":17486,"_23867":100798,"_2386":100921},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2859":59440,"_25205":59440,"_5":12316,"_2386":100923,"_25540":100924,"_17596":100926,"_23867":59440},"Jerarquía y rotación de CAs",[40894,97341,45925,100925],"Claves, autoridades y certificados",[],{"_2859":59441,"_25205":59440,"_17596":100928,"_5":17486,"_23867":59440,"_2386":100929},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2859":59442,"_25205":59440,"_5":25537,"_17596":100931,"_23867":100932,"_2386":100933},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2859":59443,"_25205":59440,"_5":25537,"_17596":100935,"_23867":100936,"_2386":100937},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2859":59444,"_25205":59440,"_5":25537,"_17596":100939,"_23867":100940,"_2386":100941},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2859":59445,"_25205":59440,"_5":25537,"_17596":100943,"_23867":100944,"_2386":100945},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2859":59446,"_25205":59440,"_5":25537,"_17596":100947,"_23867":100948,"_2386":100949},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2859":59447,"_25205":59440,"_5":25537,"_17596":100951,"_23867":100952,"_2386":100953},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2859":59448,"_25205":59440,"_5":25537,"_17596":100955,"_23867":100956,"_2386":100957},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2859":59449,"_25205":59440,"_5":25537,"_17596":100959,"_23867":100960,"_2386":100961},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2859":59450,"_25205":59440,"_5":25537,"_17596":100963,"_23867":100964,"_2386":100965},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2859":59451,"_25205":59440,"_5":25537,"_17596":100967,"_23867":100968,"_2386":100969},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2859":59452,"_25205":59440,"_5":25537,"_17596":100971,"_23867":100972,"_2386":100973},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2859":59453,"_25205":59440,"_5":25537,"_17596":100975,"_23867":100976,"_2386":100977},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2859":59454,"_25205":59440,"_17596":100979,"_5":17486,"_23867":59440,"_2386":100980},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2859":59455,"_25205":59440,"_17596":100982,"_5":17486,"_23867":59440,"_2386":100983},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2859":59456,"_25205":59440,"_17596":100985,"_5":17486,"_23867":100932,"_2386":100986},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2859":59457,"_25205":59440,"_17596":100988,"_5":17486,"_23867":100932,"_2386":100989},[],"entorno, como producción y preproducción;",{"_2859":59458,"_25205":59440,"_17596":100991,"_5":17486,"_23867":100932,"_2386":100992},[],"propietario o equipo operador;",{"_2859":59459,"_25205":59440,"_17596":100994,"_5":17486,"_23867":100932,"_2386":100995},[],"familia de dispositivos o proceso de fabricación;",{"_2859":59460,"_25205":59440,"_17596":100997,"_5":17486,"_23867":100932,"_2386":100998},[],"región o requisito regulatorio;",{"_2859":59461,"_25205":59440,"_17596":101000,"_5":17486,"_23867":100932,"_2386":101001},[],"motor criptográfico o política de clave;",{"_2859":59462,"_25205":59440,"_17596":101003,"_5":17486,"_23867":100932,"_2386":101004},[],"ventana de mantenimiento y ritmo de renovación.",{"_2859":59463,"_25205":59440,"_17596":101006,"_5":17486,"_23867":100932,"_2386":101007},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2859":59464,"_25205":59440,"_17596":101009,"_5":17486,"_23867":100932,"_2386":101010},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2859":59465,"_25205":59440,"_17596":101012,"_5":17486,"_23867":100936,"_2386":101013},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2859":59466,"_25205":59440,"_17596":101015,"_5":17486,"_23867":100936,"_2386":101016},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2859":59467,"_25205":59440,"_17596":101018,"_5":17486,"_23867":100936,"_2386":101019},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2859":59468,"_25205":59440,"_17596":101021,"_5":17486,"_23867":100940,"_2386":101022},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2859":59469,"_25205":59440,"_17596":101024,"_5":17486,"_23867":100940,"_2386":101025},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2859":59470,"_25205":59440,"_17596":101027,"_5":17486,"_23867":100940,"_2386":101028},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2859":59471,"_25205":59440,"_17596":101030,"_5":17486,"_23867":100940,"_2386":101031},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2859":59472,"_25205":59440,"_17596":101033,"_5":17486,"_23867":100948,"_2386":101034},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2859":59473,"_25205":59440,"_17596":101036,"_5":17486,"_23867":100952,"_2386":101037},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2859":59474,"_25205":59440,"_17596":101039,"_5":17486,"_23867":100956,"_2386":101040},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2859":59475,"_25205":59440,"_17596":101042,"_5":17486,"_23867":100960,"_2386":101043},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mantén las CAs de validación adicionales si todavía deben aceptarse certificados antiguos durante el re-enrolamiento.",{"_2859":59476,"_25205":59440,"_17596":101045,"_5":17486,"_23867":100964,"_2386":101046},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2859":59477,"_25205":59440,"_17596":101048,"_5":17486,"_23867":100968,"_2386":101049},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2859":59478,"_25205":59440,"_17596":101051,"_5":17486,"_23867":100972,"_2386":101052},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2859":59479,"_25205":59440,"_17596":101054,"_5":17486,"_23867":100972,"_2386":101055},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2859":59480,"_25205":59440,"_17596":101057,"_5":17486,"_23867":100972,"_2386":101058},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2859":59481,"_25205":59440,"_17596":101060,"_5":17486,"_23867":100972,"_2386":101061},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2859":59482,"_25205":59440,"_17596":101063,"_5":17486,"_23867":100976,"_2386":101064},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2859":59483,"_25205":59440,"_17596":101066,"_5":17486,"_23867":100976,"_2386":101067},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2859":59484,"_25205":59440,"_17596":101069,"_5":17486,"_23867":100976,"_2386":101070},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2859":59485,"_25205":59440,"_17596":101072,"_5":17486,"_23867":100976,"_2386":101073},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2859":59486,"_25205":59440,"_17596":101075,"_5":17486,"_23867":100976,"_2386":101076},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2859":59487,"_25205":59440,"_17596":101078,"_5":17486,"_23867":100976,"_2386":101079},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2859":59488,"_25205":59440,"_17596":101081,"_5":17486,"_23867":100976,"_2386":101082},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2859":59489,"_25205":59489,"_5":12316,"_2386":101084,"_25540":101085,"_17596":101086,"_23867":59489},"Autoridades de certificación",[40894,97341,45925,100925],[],{"_2859":59490,"_25205":59489,"_17596":101088,"_5":17486,"_23867":59489,"_2386":101089},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2859":59491,"_25205":59489,"_5":25537,"_17596":101091,"_23867":101092,"_2386":101093},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2859":59492,"_25205":59489,"_5":25537,"_17596":101095,"_23867":101096,"_2386":101097},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2859":59493,"_25205":59489,"_5":25537,"_17596":101099,"_23867":101100,"_2386":96042},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2859":59494,"_25205":59489,"_5":25537,"_17596":101102,"_23867":101103,"_2386":101104},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2859":59495,"_25205":59489,"_5":25537,"_17596":101106,"_23867":101107,"_2386":101108},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2859":59496,"_25205":59489,"_5":25537,"_17596":101110,"_23867":101111,"_2386":101112},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2859":59497,"_25205":59489,"_5":25537,"_17596":101114,"_23867":101115,"_2386":101116},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2859":59498,"_25205":59489,"_5":25537,"_17596":101118,"_23867":101119,"_2386":101120},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2859":59499,"_25205":59489,"_5":25537,"_17596":101122,"_23867":101123,"_2386":101124},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2859":59500,"_25205":59489,"_5":25537,"_17596":101126,"_23867":101127,"_2386":101128},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2859":59501,"_25205":59489,"_5":25537,"_17596":101130,"_23867":101131,"_2386":101132},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2859":59502,"_25205":59489,"_5":25537,"_17596":101134,"_23867":101135,"_2386":101136},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2859":59503,"_25205":59489,"_5":25537,"_17596":101138,"_23867":101139,"_2386":101140},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2859":59504,"_25205":59489,"_5":25537,"_17596":101142,"_23867":101143,"_2386":101144},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2859":59505,"_25205":59489,"_5":25537,"_17596":101146,"_23867":101147,"_2386":101148},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2859":59506,"_25205":59489,"_5":25537,"_17596":101150,"_23867":101151,"_2386":101152},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2859":59507,"_25205":59489,"_5":25537,"_17596":101154,"_23867":101155,"_2386":101156},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2859":59508,"_25205":59489,"_5":25537,"_17596":101158,"_23867":101159,"_2386":101160},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2859":59509,"_25205":59489,"_5":25537,"_17596":101162,"_23867":101163,"_2386":101164},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2859":59510,"_25205":59489,"_5":25537,"_17596":101166,"_23867":101167,"_2386":101168},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2859":59511,"_25205":59489,"_5":25537,"_17596":101170,"_23867":101171,"_2386":101172},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2859":59512,"_25205":59489,"_5":25537,"_17596":101174,"_23867":101175,"_2386":101176},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2859":59513,"_25205":59489,"_17596":101178,"_5":17486,"_23867":59489,"_2386":101179},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2859":59514,"_25205":59489,"_17596":101181,"_5":17486,"_23867":59489,"_2386":101182},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2859":59515,"_25205":59489,"_17596":101184,"_5":17486,"_23867":59489,"_2386":101185},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2859":59516,"_25205":59489,"_17596":101187,"_5":17486,"_23867":101092,"_2386":101188},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2859":59517,"_25205":59489,"_17596":101190,"_5":17486,"_23867":101092,"_2386":101191},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2859":59518,"_25205":59489,"_17596":101193,"_5":17486,"_23867":101092,"_2386":101194},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2859":59519,"_25205":59489,"_17596":101196,"_5":17486,"_23867":101092,"_2386":101197},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2859":59520,"_25205":59489,"_17596":101199,"_5":17486,"_23867":101092,"_2386":101200},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2859":59521,"_25205":59489,"_17596":101202,"_5":17486,"_23867":101100,"_2386":101203},[],"Decide si la CA será raíz o intermedia.",{"_2859":59522,"_25205":59489,"_17596":101205,"_5":17486,"_23867":101100,"_2386":101206},[],"Elige el motor que custodiará la clave.",{"_2859":59523,"_25205":59489,"_17596":101208,"_5":17486,"_23867":101100,"_2386":101209},[],"Define una validez superior a la de los certificados que emitirá.",{"_2859":59524,"_25205":59489,"_17596":101211,"_5":17486,"_23867":101100,"_2386":101212},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2859":59525,"_25205":59489,"_17596":101214,"_5":17486,"_23867":101103,"_2386":101215},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2859":59526,"_25205":59489,"_17596":101217,"_5":17486,"_23867":101107,"_2386":101218},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2859":59527,"_25205":59489,"_17596":101220,"_5":17486,"_23867":101107,"_2386":101221},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2859":59528,"_25205":59489,"_17596":101223,"_5":17486,"_23867":101111,"_2386":101224},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2859":59529,"_25205":59489,"_17596":101226,"_5":17486,"_23867":101115,"_2386":101227},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2859":59530,"_25205":59489,"_17596":101229,"_5":17486,"_23867":101115,"_2386":101230},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2859":59531,"_25205":59489,"_17596":101232,"_5":17486,"_23867":101115,"_2386":101233},[],"`ST`: estado o provincia.",{"_2859":59532,"_25205":59489,"_17596":101235,"_5":17486,"_23867":101115,"_2386":101236},[],"`L`: localidad.",{"_2859":59533,"_25205":59489,"_17596":101238,"_5":17486,"_23867":101115,"_2386":101239},[],"`O`: organización.",{"_2859":59534,"_25205":59489,"_17596":101241,"_5":17486,"_23867":101115,"_2386":101242},[],"`OU`: unidad organizativa.",{"_2859":59535,"_25205":59489,"_17596":101244,"_5":17486,"_23867":101115,"_2386":101245},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2859":59536,"_25205":59489,"_17596":101247,"_5":17486,"_23867":101119,"_2386":101248},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2859":59537,"_25205":59489,"_17596":101250,"_5":17486,"_23867":101119,"_2386":101251},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2859":59538,"_25205":59489,"_17596":101253,"_5":17486,"_23867":101123,"_2386":101254},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2859":59539,"_25205":59489,"_17596":101256,"_5":17486,"_23867":101123,"_2386":101257},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2859":59540,"_25205":59489,"_17596":101259,"_5":17486,"_23867":101127,"_2386":101260},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2859":59541,"_25205":59489,"_17596":101262,"_5":17486,"_23867":101127,"_2386":101263},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2859":59542,"_25205":59489,"_17596":101265,"_5":17486,"_23867":101131,"_2386":101266},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2859":59543,"_25205":59489,"_17596":101268,"_5":17486,"_23867":101135,"_2386":101269},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2859":59544,"_25205":59489,"_17596":101271,"_5":17486,"_23867":101139,"_2386":101272},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2859":59545,"_25205":59489,"_17596":101274,"_5":17486,"_23867":101143,"_2386":101275},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2859":59546,"_25205":59489,"_17596":101277,"_5":17486,"_23867":101147,"_2386":101278},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2859":59547,"_25205":59489,"_17596":101280,"_5":17486,"_23867":101147,"_2386":101281},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2859":59548,"_25205":59489,"_17596":101283,"_5":17486,"_23867":101151,"_2386":101284},[],"Abre una CA desde el inventario para consultar:",{"_2859":59549,"_25205":59489,"_17596":101286,"_5":17486,"_23867":101151,"_2386":101287},[],"Estado y periodo de validez.",{"_2859":59550,"_25205":59489,"_17596":101289,"_5":17486,"_23867":101151,"_2386":101290},[],"Certificado y cadena en formato PEM.",{"_2859":59551,"_25205":59489,"_17596":101292,"_5":17486,"_23867":101151,"_2386":101293},[],"Número de certificados activos, expirados y revocados.",{"_2859":59552,"_25205":59489,"_17596":101295,"_5":17486,"_23867":101151,"_2386":101296},[],"Certificados emitidos en **Issued Certificates**.",{"_2859":59553,"_25205":59489,"_17596":101298,"_5":17486,"_23867":101151,"_2386":101299},[],"CRL vinculada a la autoridad.",{"_2859":59554,"_25205":59489,"_17596":101301,"_5":17486,"_23867":101151,"_2386":101302},[],"Metadatos y motor criptográfico asociado.",{"_2859":59555,"_25205":59489,"_17596":101304,"_5":17486,"_23867":101151,"_2386":101305},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2859":59556,"_25205":59489,"_17596":101307,"_5":17486,"_23867":101155,"_2386":101308},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2859":59557,"_25205":59489,"_17596":101310,"_5":17486,"_23867":101155,"_2386":101311},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2859":59558,"_25205":59489,"_17596":101313,"_5":17486,"_23867":101155,"_2386":101314},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2859":59559,"_25205":59489,"_17596":101316,"_5":17486,"_23867":101155,"_2386":101317},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2859":59560,"_25205":59489,"_17596":101319,"_5":17486,"_23867":101159,"_2386":101320},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2859":59561,"_25205":59489,"_17596":101322,"_5":17486,"_23867":101163,"_2386":101323},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2859":59562,"_25205":59489,"_17596":101325,"_5":17486,"_23867":101167,"_2386":101326},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2859":59563,"_25205":59489,"_17596":101328,"_5":17486,"_23867":101171,"_2386":101329},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2859":59564,"_25205":59489,"_17596":101331,"_5":17486,"_23867":101175,"_2386":101332},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2859":59565,"_25205":59489,"_17596":101334,"_5":17486,"_23867":101175,"_2386":101335},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2859":59566,"_25205":59566,"_5":12316,"_2386":101337,"_25540":101338,"_17596":101339,"_23867":59566},"Perfiles de certificado",[40894,97341,45925,100925],[],{"_2859":59567,"_25205":59566,"_17596":101341,"_5":17486,"_23867":59566,"_2386":101342},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2859":59568,"_25205":59566,"_5":25537,"_17596":101344,"_23867":101345,"_2386":101346},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2859":59569,"_25205":59566,"_5":25537,"_17596":101348,"_23867":101349,"_2386":101350},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#validez","Validez",{"_2859":59570,"_25205":59566,"_5":25537,"_17596":101352,"_23867":101353,"_2386":101354},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2859":59571,"_25205":59566,"_5":25537,"_17596":101356,"_23867":101357,"_2386":101358},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2859":59572,"_25205":59566,"_5":25537,"_17596":101360,"_23867":101361,"_2386":101362},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2859":59573,"_25205":59566,"_5":25537,"_17596":101364,"_23867":101365,"_2386":101366},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2859":59574,"_25205":59566,"_5":25537,"_17596":101368,"_23867":101369,"_2386":101370},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2859":59575,"_25205":59566,"_5":25537,"_17596":101372,"_23867":101373,"_2386":101374},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2859":59576,"_25205":59566,"_5":25537,"_17596":101376,"_23867":101377,"_2386":101378},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2859":59577,"_25205":59566,"_5":25537,"_17596":101380,"_23867":101381,"_2386":101382},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2859":59578,"_25205":59566,"_5":25537,"_17596":101384,"_23867":101385,"_2386":101386},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2859":59579,"_25205":59566,"_5":25537,"_17596":101388,"_23867":101389,"_2386":101390},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2859":59580,"_25205":59566,"_5":25537,"_17596":101392,"_23867":101393,"_2386":101394},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2859":59581,"_25205":59566,"_5":25537,"_17596":101396,"_23867":101397,"_2386":101398},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2859":59582,"_25205":59566,"_5":25537,"_17596":101400,"_23867":101401,"_2386":101402},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2859":59583,"_25205":59566,"_5":25537,"_17596":101404,"_23867":101405,"_2386":101406},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2859":59584,"_25205":59566,"_17596":101408,"_5":17486,"_23867":59566,"_2386":101409},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2859":59585,"_25205":59566,"_17596":101411,"_5":17486,"_23867":59566,"_2386":101412},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2859":59586,"_25205":59566,"_17596":101414,"_5":17486,"_23867":101349,"_2386":101415},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2859":59587,"_25205":59566,"_17596":101417,"_5":17486,"_23867":101349,"_2386":101418},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2859":59588,"_25205":59566,"_17596":101420,"_5":17486,"_23867":101353,"_2386":101421},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2859":59589,"_25205":59566,"_17596":101423,"_5":17486,"_23867":101357,"_2386":101424},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2859":59590,"_25205":59566,"_17596":101426,"_5":17486,"_23867":101357,"_2386":101427},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2859":59591,"_25205":59566,"_17596":101429,"_5":17486,"_23867":101357,"_2386":101430},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2859":59592,"_25205":59566,"_17596":101432,"_5":17486,"_23867":101361,"_2386":101433},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2859":59593,"_25205":59566,"_17596":101435,"_5":17486,"_23867":101365,"_2386":101436},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2859":59594,"_25205":59566,"_17596":101438,"_5":17486,"_23867":101365,"_2386":101439},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2859":59595,"_25205":59566,"_17596":101441,"_5":17486,"_23867":101369,"_2386":101442},[],"La aplicación criptográfica puede:",{"_2859":59596,"_25205":59566,"_17596":101444,"_5":17486,"_23867":101369,"_2386":101445},[],"permitir o bloquear claves RSA;",{"_2859":59597,"_25205":59566,"_17596":101447,"_5":17486,"_23867":101369,"_2386":101448},[],"limitar los tamaños RSA admitidos;",{"_2859":59598,"_25205":59566,"_17596":101450,"_5":17486,"_23867":101369,"_2386":101451},[],"permitir o bloquear claves ECDSA;",{"_2859":59599,"_25205":59566,"_17596":101453,"_5":17486,"_23867":101369,"_2386":101454},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2859":59600,"_25205":59566,"_17596":101456,"_5":17486,"_23867":101369,"_2386":101457},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2859":59601,"_25205":59566,"_17596":101459,"_5":17486,"_23867":101373,"_2386":101460},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2859":59602,"_25205":59566,"_17596":101462,"_5":17486,"_23867":101373,"_2386":97132},[],{"_2859":59603,"_25205":59566,"_17596":101464,"_5":17486,"_23867":101373,"_2386":101465},[],"Primera opción",{"_2859":59604,"_25205":59566,"_17596":101467,"_5":17486,"_23867":101373,"_2386":101468},[],"Segunda opción",{"_2859":59605,"_25205":59566,"_17596":101470,"_5":17486,"_23867":101373,"_2386":101471},[],"Si no hay ninguna",{"_2859":59606,"_25205":59566,"_17596":101473,"_5":17486,"_23867":101373,"_2386":101474},[],"Firma directa con una CA",{"_2859":59607,"_25205":59566,"_17596":101476,"_5":17486,"_23867":101373,"_2386":101477},[],"`issuance_profile` incluido en la solicitud",{"_2859":59608,"_25205":59566,"_17596":101479,"_5":17486,"_23867":101373,"_2386":101480},[],"`issuance_profile_id` de la solicitud",{"_2859":59609,"_25205":59566,"_17596":101482,"_5":17486,"_23867":101373,"_2386":101483},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2859":59610,"_25205":59566,"_17596":101485,"_5":17486,"_23867":101373,"_2386":101486},[],"Emisión mediante DMS",{"_2859":59611,"_25205":59566,"_17596":101488,"_5":17486,"_23867":101373,"_2386":46490},[],{"_2859":59612,"_25205":59566,"_17596":101490,"_5":17486,"_23867":101373,"_2386":101491},[],"`settings.issuance_profile` incluido en el DMS",{"_2859":59613,"_25205":59566,"_17596":101493,"_5":17486,"_23867":101373,"_2386":101494},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2859":59614,"_25205":59566,"_17596":101496,"_5":17486,"_23867":101373,"_2386":101497},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2859":59615,"_25205":59566,"_17596":101499,"_5":17486,"_23867":101373,"_2386":101500},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2859":59616,"_25205":59566,"_17596":101502,"_5":17486,"_23867":101381,"_2386":101503},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2859":59617,"_25205":59566,"_17596":101505,"_5":17486,"_23867":101385,"_2386":101506},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2859":59618,"_25205":59566,"_17596":101508,"_5":17486,"_23867":101389,"_2386":101509},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2859":59619,"_25205":59566,"_17596":101511,"_5":17486,"_23867":101393,"_2386":101512},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2859":59620,"_25205":59566,"_17596":101514,"_5":17486,"_23867":101397,"_2386":101515},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2859":59621,"_25205":59566,"_17596":101517,"_5":17486,"_23867":101397,"_2386":101518},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2859":59622,"_25205":59566,"_17596":101520,"_5":17486,"_23867":101401,"_2386":101521},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2859":59623,"_25205":59566,"_17596":101523,"_5":17486,"_23867":101401,"_2386":101524},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2859":59624,"_25205":59566,"_17596":101526,"_5":17486,"_23867":101401,"_2386":101527},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2859":59625,"_25205":59566,"_17596":101529,"_5":17486,"_23867":101401,"_2386":101530},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2859":59626,"_25205":59566,"_17596":101532,"_5":17486,"_23867":101405,"_2386":101533},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2859":59627,"_25205":59566,"_17596":101535,"_5":17486,"_23867":101405,"_2386":101536},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2859":59628,"_25205":59628,"_5":12316,"_2386":101538,"_25540":101539,"_17596":101541,"_23867":59628},"Validación de certificados",[40894,97341,45925,101540],"Validación",[],{"_2859":59629,"_25205":59628,"_17596":101543,"_5":17486,"_23867":59628,"_2386":101544},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2859":59630,"_25205":59628,"_5":25537,"_17596":101546,"_23867":101547,"_2386":101548},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2859":59631,"_25205":59628,"_5":25537,"_17596":101550,"_23867":101551,"_2386":101552},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2859":59632,"_25205":59628,"_5":25537,"_17596":101554,"_23867":101555,"_2386":101556},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2859":59633,"_25205":59628,"_17596":101558,"_5":17486,"_23867":59628,"_2386":101559},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2859":59634,"_25205":59628,"_17596":101561,"_5":17486,"_23867":101547,"_2386":101562},[],"Verifica estos criterios juntos:",{"_2859":59635,"_25205":59628,"_17596":101564,"_5":17486,"_23867":101547,"_2386":100552},[],{"_2859":59636,"_25205":59628,"_17596":101566,"_5":17486,"_23867":101547,"_2386":101567},[],"Resultado necesario",{"_2859":59637,"_25205":59628,"_17596":101569,"_5":17486,"_23867":101547,"_2386":101570},[],"Cadena y firma",{"_2859":59638,"_25205":59628,"_17596":101572,"_5":17486,"_23867":101547,"_2386":101573},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2859":59639,"_25205":59628,"_17596":101575,"_5":17486,"_23867":101547,"_2386":101576},[],"Fechas",{"_2859":59640,"_25205":59628,"_17596":101578,"_5":17486,"_23867":101547,"_2386":101579},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2859":59641,"_25205":59628,"_17596":101581,"_5":17486,"_23867":101547,"_2386":97045},[],{"_2859":59642,"_25205":59628,"_17596":101583,"_5":17486,"_23867":101547,"_2386":101584},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2859":59643,"_25205":59628,"_17596":101586,"_5":17486,"_23867":101547,"_2386":101587},[],"Uso",{"_2859":59644,"_25205":59628,"_17596":101589,"_5":17486,"_23867":101547,"_2386":101590},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2859":59645,"_25205":59628,"_17596":101592,"_5":17486,"_23867":101547,"_2386":101593},[],"Revocación",{"_2859":59646,"_25205":59628,"_17596":101595,"_5":17486,"_23867":101547,"_2386":101596},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2859":59647,"_25205":59628,"_17596":101598,"_5":17486,"_23867":101547,"_2386":101599},[],"Autorización",{"_2859":59648,"_25205":59628,"_17596":101601,"_5":17486,"_23867":101547,"_2386":101602},[],"La aplicación permite la acción a esa identidad.",{"_2859":59649,"_25205":59628,"_17596":101604,"_5":17486,"_23867":101547,"_2386":101605},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2859":59650,"_25205":59628,"_17596":101607,"_5":17486,"_23867":101551,"_2386":101608},[],"Mecanismo",{"_2859":59651,"_25205":59628,"_17596":101610,"_5":17486,"_23867":101551,"_2386":101611},[],"Cuándo utilizarlo",{"_2859":59652,"_25205":59628,"_17596":101613,"_5":17486,"_23867":101551,"_2386":101614},[],"Qué debes mantener",{"_2859":59653,"_25205":59628,"_17596":101616,"_5":17486,"_23867":101551,"_2386":46618},[],{"_2859":59654,"_25205":59628,"_17596":101618,"_5":17486,"_23867":101551,"_2386":101619},[],"Consulta del estado de un certificado concreto.",{"_2859":59655,"_25205":59628,"_17596":101621,"_5":17486,"_23867":101551,"_2386":101622},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2859":59656,"_25205":59628,"_17596":101624,"_5":17486,"_23867":101551,"_2386":46627},[],{"_2859":59657,"_25205":59628,"_17596":101626,"_5":17486,"_23867":101551,"_2386":101627},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2859":59658,"_25205":59628,"_17596":101629,"_5":17486,"_23867":101551,"_2386":101630},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2859":59659,"_25205":59628,"_17596":101632,"_5":17486,"_23867":101551,"_2386":101633},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2859":59660,"_25205":59628,"_17596":101635,"_5":17486,"_23867":101551,"_2386":101636},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2859":59661,"_25205":59628,"_17596":101638,"_5":17486,"_23867":101555,"_2386":101639},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2859":59662,"_25205":59628,"_17596":101641,"_5":17486,"_23867":101555,"_2386":101642},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2859":59663,"_25205":59628,"_17596":101644,"_5":17486,"_23867":101555,"_2386":101645},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2859":59664,"_25205":59628,"_17596":101647,"_5":17486,"_23867":101555,"_2386":101648},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2859":59665,"_25205":59628,"_17596":101650,"_5":17486,"_23867":101555,"_2386":101651},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2859":59666,"_25205":59628,"_17596":101653,"_5":17486,"_23867":101555,"_2386":101654},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2859":59667,"_25205":59628,"_17596":101656,"_5":17486,"_23867":101555,"_2386":101657},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2859":59668,"_25205":59628,"_17596":101659,"_5":17486,"_23867":101555,"_2386":101660},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2859":59669,"_25205":59628,"_17596":101662,"_5":17486,"_23867":101555,"_2386":101663},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2859":59670,"_25205":59670,"_5":12316,"_2386":101665,"_25540":101666,"_17596":101667,"_23867":59670},"Certificados",[40894,97341,45925,100925],[],{"_2859":59671,"_25205":59670,"_17596":101669,"_5":17486,"_23867":59670,"_2386":101670},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2859":59672,"_25205":59670,"_5":25537,"_17596":101672,"_23867":101673,"_2386":101674},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2859":59673,"_25205":59670,"_5":25537,"_17596":101676,"_23867":101677,"_2386":101678},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2859":59674,"_25205":59670,"_5":25537,"_17596":101680,"_23867":101681,"_2386":101682},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2859":59675,"_25205":59670,"_5":25537,"_17596":101684,"_23867":101685,"_2386":101686},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2859":59676,"_25205":59670,"_5":25537,"_17596":101688,"_23867":101689,"_2386":101690},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2859":59677,"_25205":59670,"_5":25537,"_17596":101692,"_23867":101693,"_2386":101694},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2859":59678,"_25205":59670,"_5":25537,"_17596":101696,"_23867":101697,"_2386":101698},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2859":59679,"_25205":59670,"_5":25537,"_17596":101700,"_23867":101701,"_2386":101702},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2859":59680,"_25205":59670,"_5":25537,"_17596":101704,"_23867":101705,"_2386":101706},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#continúa","Continúa",{"_2859":59681,"_25205":59670,"_17596":101708,"_5":17486,"_23867":59670,"_2386":101709},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2859":59682,"_25205":59670,"_17596":101711,"_5":17486,"_23867":101673,"_2386":101712},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2859":59683,"_25205":59670,"_17596":101714,"_5":17486,"_23867":101673,"_2386":101715},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2859":59684,"_25205":59670,"_17596":101717,"_5":17486,"_23867":101677,"_2386":101718},[],"Descarga el PEM e inspecciónalo:",{"_2859":59685,"_25205":59670,"_17596":101720,"_5":17486,"_23867":101677,"_2386":101721},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2859":59686,"_25205":59670,"_17596":101723,"_5":17486,"_23867":101681,"_2386":101724},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2859":59687,"_25205":59670,"_17596":101726,"_5":17486,"_23867":101681,"_2386":101727},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2859":59688,"_25205":59670,"_17596":101729,"_5":17486,"_23867":101681,"_2386":101730},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2859":59689,"_25205":59670,"_17596":101732,"_5":17486,"_23867":101681,"_2386":101733},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2859":59690,"_25205":59670,"_17596":101735,"_5":17486,"_23867":101681,"_2386":101736},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2859":59691,"_25205":59670,"_17596":101738,"_5":17486,"_23867":101681,"_2386":101739},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2859":59692,"_25205":59670,"_17596":101741,"_5":17486,"_23867":101681,"_2386":101742},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2859":59693,"_25205":59670,"_17596":101744,"_5":17486,"_23867":101685,"_2386":101745},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2859":59694,"_25205":59670,"_17596":101747,"_5":17486,"_23867":101689,"_2386":101748},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2859":59695,"_25205":59670,"_17596":101750,"_5":17486,"_23867":101693,"_2386":101751},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2859":59696,"_25205":59670,"_17596":101753,"_5":17486,"_23867":101697,"_2386":101754},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2859":59697,"_25205":59670,"_17596":101756,"_5":17486,"_23867":101697,"_2386":101757},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2859":59698,"_25205":59670,"_17596":101759,"_5":17486,"_23867":101697,"_2386":101760},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2859":59699,"_25205":59670,"_17596":101762,"_5":17486,"_23867":101701,"_2386":101763},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2859":59700,"_25205":59670,"_17596":101765,"_5":17486,"_23867":101701,"_2386":101766},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2859":59701,"_25205":59670,"_17596":101768,"_5":17486,"_23867":101701,"_2386":101769},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2859":59702,"_25205":59670,"_17596":101771,"_5":17486,"_23867":101705,"_2386":101772},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2859":59703,"_25205":59670,"_17596":101774,"_5":17486,"_23867":101705,"_2386":101775},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2859":59704,"_25205":59704,"_5":12316,"_2386":101777,"_25540":101778,"_17596":101780,"_23867":59704},"Ciclo de vida de un certificado",[40894,97341,45925,101779],"Conceptos",[],{"_2859":59705,"_25205":59704,"_17596":101782,"_5":17486,"_23867":59704,"_2386":101783},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2859":59706,"_25205":59704,"_5":25537,"_17596":101785,"_23867":101786,"_2386":101787},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2859":59707,"_25205":59704,"_5":25537,"_17596":101789,"_23867":101790,"_2386":101791},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2859":59708,"_25205":59704,"_5":25537,"_17596":101793,"_23867":101794,"_2386":101795},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2859":59709,"_25205":59704,"_5":25537,"_17596":101797,"_23867":101798,"_2386":101799},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2859":59710,"_25205":59704,"_5":25537,"_17596":101801,"_23867":101802,"_2386":101803},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2859":59711,"_25205":59704,"_5":25537,"_17596":101805,"_23867":101806,"_2386":101807},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2859":59712,"_25205":59704,"_5":25537,"_17596":101809,"_23867":101810,"_2386":101811},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2859":59713,"_25205":59704,"_5":25537,"_17596":101813,"_23867":101814,"_2386":101815},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2859":59714,"_25205":59704,"_5":25537,"_17596":101817,"_23867":101818,"_2386":101819},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2859":59715,"_25205":59704,"_5":25537,"_17596":101821,"_23867":101822,"_2386":101823},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2859":59716,"_25205":59704,"_17596":101825,"_5":17486,"_23867":59704,"_2386":101826},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2859":59717,"_25205":59704,"_17596":101828,"_5":17486,"_23867":101790,"_2386":101829},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2859":59718,"_25205":59704,"_17596":101831,"_5":17486,"_23867":101794,"_2386":101832},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2859":59719,"_25205":59704,"_17596":101834,"_5":17486,"_23867":101798,"_2386":101835},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2859":59720,"_25205":59704,"_17596":101837,"_5":17486,"_23867":101802,"_2386":101838},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2859":59721,"_25205":59704,"_17596":101840,"_5":17486,"_23867":101806,"_2386":101841},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2859":59722,"_25205":59704,"_17596":101843,"_5":17486,"_23867":101810,"_2386":101844},[],"Lamassu persiste cuatro estados X.509:",{"_2859":59723,"_25205":59704,"_17596":101846,"_5":17486,"_23867":101810,"_2386":101847},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2859":59724,"_25205":59704,"_17596":101849,"_5":17486,"_23867":101810,"_2386":101850},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2859":59725,"_25205":59704,"_17596":101852,"_5":17486,"_23867":101810,"_2386":101853},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2859":59726,"_25205":59704,"_17596":101855,"_5":17486,"_23867":101810,"_2386":101856},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2859":59727,"_25205":59704,"_17596":101858,"_5":17486,"_23867":101810,"_2386":101859},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2859":59728,"_25205":59704,"_17596":101861,"_5":17486,"_23867":101814,"_2386":101862},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2859":59729,"_25205":59704,"_17596":101864,"_5":17486,"_23867":101814,"_2386":101865},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2859":59730,"_25205":59704,"_17596":101867,"_5":17486,"_23867":101814,"_2386":101868},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2859":59731,"_25205":59704,"_17596":101870,"_5":17486,"_23867":101818,"_2386":101871},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2859":59732,"_25205":59704,"_17596":101873,"_5":17486,"_23867":101818,"_2386":101874},[],"Antes de confirmar:",{"_2859":59733,"_25205":59704,"_17596":101876,"_5":17486,"_23867":101818,"_2386":101877},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2859":59734,"_25205":59704,"_17596":101879,"_5":17486,"_23867":101818,"_2386":101880},[],"Distribuye la nueva cadena de confianza.",{"_2859":59735,"_25205":59704,"_17596":101882,"_5":17486,"_23867":101818,"_2386":101883},[],"Reemite las identidades necesarias.",{"_2859":59736,"_25205":59704,"_17596":101885,"_5":17486,"_23867":101818,"_2386":101886},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2859":59737,"_25205":59704,"_17596":101888,"_5":17486,"_23867":101818,"_2386":101889},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2859":59738,"_25205":59704,"_17596":101891,"_5":17486,"_23867":101818,"_2386":101892},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2859":59739,"_25205":59704,"_17596":101894,"_5":17486,"_23867":101822,"_2386":101895},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2859":59740,"_25205":59704,"_17596":101897,"_5":17486,"_23867":101822,"_2386":101898},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2859":59741,"_25205":59704,"_17596":101900,"_5":17486,"_23867":101822,"_2386":101901},[],"Cambios de estado y razones de revocación.",{"_2859":59742,"_25205":59704,"_17596":101903,"_5":17486,"_23867":101822,"_2386":101904},[],"Publicación y vigencia de OCSP y CRLs.",{"_2859":59743,"_25205":59704,"_17596":101906,"_5":17486,"_23867":101822,"_2386":101907},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2859":59744,"_25205":59704,"_17596":101909,"_5":17486,"_23867":101822,"_2386":101910},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2859":59745,"_25205":59745,"_5":12316,"_2386":101912,"_25540":101913,"_17596":101914,"_23867":59745},"Modelo de confianza",[40894,97341,45925,101779],[],{"_2859":59746,"_25205":59745,"_17596":101916,"_5":17486,"_23867":59745,"_2386":101917},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2859":59747,"_25205":59745,"_5":25537,"_17596":101919,"_23867":101920,"_2386":101921},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2859":59748,"_25205":59745,"_5":25537,"_17596":101923,"_23867":101924,"_2386":101925},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2859":59749,"_25205":59745,"_5":25537,"_17596":101927,"_23867":101928,"_2386":101929},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2859":59750,"_25205":59745,"_5":25537,"_17596":101931,"_23867":101932,"_2386":101933},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2859":59751,"_25205":59745,"_5":25537,"_17596":101935,"_23867":101936,"_2386":101937},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2859":59752,"_25205":59745,"_5":25537,"_17596":101939,"_23867":101940,"_2386":101941},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2859":59753,"_25205":59745,"_5":25537,"_17596":101943,"_23867":101944,"_2386":101945},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2859":59754,"_25205":59745,"_5":25537,"_17596":101947,"_23867":101948,"_2386":101949},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2859":59755,"_25205":59745,"_5":25537,"_17596":101951,"_23867":101952,"_2386":101953},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2859":59756,"_25205":59745,"_5":25537,"_17596":101955,"_23867":101956,"_2386":101957},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2859":59757,"_25205":59745,"_17596":101959,"_5":17486,"_23867":59745,"_2386":101960},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2859":59758,"_25205":59745,"_17596":101962,"_5":17486,"_23867":101924,"_2386":101963},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2859":59759,"_25205":59745,"_17596":101965,"_5":17486,"_23867":101928,"_2386":101966},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2859":59760,"_25205":59745,"_17596":101968,"_5":17486,"_23867":101932,"_2386":101969},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2859":59761,"_25205":59745,"_17596":101971,"_5":17486,"_23867":101936,"_2386":101972},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2859":59762,"_25205":59745,"_17596":101974,"_5":17486,"_23867":101940,"_2386":101975},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2859":59763,"_25205":59745,"_17596":101977,"_5":17486,"_23867":101940,"_2386":101978},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2859":59764,"_25205":59745,"_17596":101980,"_5":17486,"_23867":101940,"_2386":101981},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2859":59765,"_25205":59745,"_17596":101983,"_5":17486,"_23867":101940,"_2386":101984},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2859":59766,"_25205":59745,"_17596":101986,"_5":17486,"_23867":101940,"_2386":101987},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2859":59767,"_25205":59745,"_17596":101989,"_5":17486,"_23867":101940,"_2386":101990},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2859":59768,"_25205":59745,"_17596":101992,"_5":17486,"_23867":101944,"_2386":101993},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2859":59769,"_25205":59745,"_17596":101995,"_5":17486,"_23867":101944,"_2386":101996},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2859":59770,"_25205":59745,"_17596":101998,"_5":17486,"_23867":101944,"_2386":101999},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación adicionales.",{"_2859":59771,"_25205":59745,"_17596":102001,"_5":17486,"_23867":101944,"_2386":102002},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2859":59772,"_25205":59745,"_17596":102004,"_5":17486,"_23867":101944,"_2386":102005},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2859":59773,"_25205":59745,"_17596":102007,"_5":17486,"_23867":101948,"_2386":102008},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2859":59774,"_25205":59745,"_17596":102010,"_5":17486,"_23867":101948,"_2386":102011},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2859":59775,"_25205":59745,"_17596":102013,"_5":17486,"_23867":101948,"_2386":102014},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2859":59776,"_25205":59745,"_17596":102016,"_5":17486,"_23867":101948,"_2386":102017},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2859":59777,"_25205":59745,"_17596":102019,"_5":17486,"_23867":101948,"_2386":102020},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2859":59778,"_25205":59745,"_17596":102022,"_5":17486,"_23867":101948,"_2386":102023},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2859":59779,"_25205":59745,"_17596":102025,"_5":17486,"_23867":101948,"_2386":102026},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2859":59780,"_25205":59745,"_17596":102028,"_5":17486,"_23867":101952,"_2386":102029},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2859":59781,"_25205":59745,"_17596":102031,"_5":17486,"_23867":101956,"_2386":102032},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2859":59782,"_25205":59745,"_17596":102034,"_5":17486,"_23867":101956,"_2386":102035},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2859":59783,"_25205":59745,"_17596":102037,"_5":17486,"_23867":101956,"_2386":102038},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2859":59784,"_25205":59745,"_17596":102040,"_5":17486,"_23867":101956,"_2386":102041},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2859":59785,"_25205":59745,"_17596":102043,"_5":17486,"_23867":101956,"_2386":102044},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2859":59786,"_25205":59745,"_17596":102046,"_5":17486,"_23867":101956,"_2386":102047},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2859":59787,"_25205":59745,"_17596":102049,"_5":17486,"_23867":101956,"_2386":102050},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2859":59788,"_25205":59788,"_5":12316,"_2386":102052,"_25540":102053,"_17596":102054,"_23867":59788},"Listas de revocación (CRL)",[40894,97341,45925,101540],[],{"_2859":59789,"_25205":59788,"_17596":102056,"_5":17486,"_23867":59788,"_2386":102057},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2859":59790,"_25205":59788,"_5":25537,"_17596":102059,"_23867":102060,"_2386":102061},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2859":59791,"_25205":59788,"_5":25537,"_17596":102063,"_23867":102064,"_2386":102065},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2859":59792,"_25205":59788,"_5":25537,"_17596":102067,"_23867":102068,"_2386":102069},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2859":59793,"_25205":59788,"_5":25537,"_17596":102071,"_23867":102072,"_2386":102073},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2859":59794,"_25205":59788,"_5":25537,"_17596":102075,"_23867":102076,"_2386":102077},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2859":59795,"_25205":59788,"_5":25537,"_17596":102079,"_23867":102080,"_2386":102081},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2859":59796,"_25205":59788,"_5":25537,"_17596":102083,"_23867":102084,"_2386":102085},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#referencias","Referencias",{"_2859":59797,"_25205":59788,"_17596":102087,"_5":17486,"_23867":59788,"_2386":102088},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2859":59798,"_25205":59788,"_17596":102090,"_5":17486,"_23867":102060,"_2386":102091},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2859":59799,"_25205":59788,"_17596":102093,"_5":17486,"_23867":102060,"_2386":102094},[],"Campo de `crl_options`",{"_2859":59800,"_25205":59788,"_17596":102096,"_5":17486,"_23867":102060,"_2386":98834},[],{"_2859":59801,"_25205":59788,"_17596":102098,"_5":17486,"_23867":102060,"_2386":102099},[],"Valor inicial del backend",{"_2859":59802,"_25205":59788,"_17596":102101,"_5":17486,"_23867":102060,"_2386":47105},[],{"_2859":59803,"_25205":59788,"_17596":102103,"_5":17486,"_23867":102060,"_2386":102104},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2859":59804,"_25205":59788,"_17596":102106,"_5":17486,"_23867":102060,"_2386":102107},[],"7 días.",{"_2859":59805,"_25205":59788,"_17596":102109,"_5":17486,"_23867":102060,"_2386":47114},[],{"_2859":59806,"_25205":59788,"_17596":102111,"_5":17486,"_23867":102060,"_2386":102112},[],"Plazo desde la publicación que activa la renovación programada.",{"_2859":59807,"_25205":59788,"_17596":102114,"_5":17486,"_23867":102060,"_2386":102115},[],"6 días y 23 horas.",{"_2859":59808,"_25205":59788,"_17596":102117,"_5":17486,"_23867":102060,"_2386":47123},[],{"_2859":59809,"_25205":59788,"_17596":102119,"_5":17486,"_23867":102060,"_2386":102120},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2859":59810,"_25205":59788,"_17596":102122,"_5":17486,"_23867":102060,"_2386":47129},[],{"_2859":59811,"_25205":59788,"_17596":102124,"_5":17486,"_23867":102060,"_2386":47132},[],{"_2859":59812,"_25205":59788,"_17596":102126,"_5":17486,"_23867":102060,"_2386":102127},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2859":59813,"_25205":59788,"_17596":102129,"_5":17486,"_23867":102060,"_2386":102130},[],"SKI de la CA.",{"_2859":59814,"_25205":59788,"_17596":102132,"_5":17486,"_23867":102060,"_2386":102133},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2859":59815,"_25205":59788,"_17596":102135,"_5":17486,"_23867":102060,"_2386":102136},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2859":59816,"_25205":59788,"_17596":102138,"_5":17486,"_23867":102064,"_2386":102139},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2859":59817,"_25205":59788,"_17596":102141,"_5":17486,"_23867":102064,"_2386":102142},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2859":59818,"_25205":59788,"_17596":102144,"_5":17486,"_23867":102064,"_2386":102145},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2859":59819,"_25205":59788,"_17596":102147,"_5":17486,"_23867":102068,"_2386":102148},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2859":59820,"_25205":59788,"_17596":102150,"_5":17486,"_23867":102068,"_2386":102151},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2859":59821,"_25205":59788,"_17596":102153,"_5":17486,"_23867":102072,"_2386":102154},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2859":59822,"_25205":59788,"_17596":102156,"_5":17486,"_23867":102072,"_2386":102157},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2859":59823,"_25205":59788,"_17596":102159,"_5":17486,"_23867":102072,"_2386":102160},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2859":59824,"_25205":59788,"_17596":102162,"_5":17486,"_23867":102072,"_2386":102163},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2859":59825,"_25205":59788,"_17596":102165,"_5":17486,"_23867":102072,"_2386":102166},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2859":59826,"_25205":59788,"_17596":102168,"_5":17486,"_23867":102076,"_2386":102169},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2859":59827,"_25205":59788,"_17596":102171,"_5":17486,"_23867":102076,"_2386":99023},[],{"_2859":59828,"_25205":59788,"_17596":102173,"_5":17486,"_23867":102076,"_2386":102174},[],"Path relativo",{"_2859":59829,"_25205":59788,"_17596":102176,"_5":17486,"_23867":102076,"_2386":97132},[],{"_2859":59830,"_25205":59788,"_17596":102178,"_5":17486,"_23867":102076,"_2386":47187},[],{"_2859":59831,"_25205":59788,"_17596":102180,"_5":17486,"_23867":102076,"_2386":47190},[],{"_2859":59832,"_25205":59788,"_17596":102182,"_5":17486,"_23867":102076,"_2386":102183},[],"Consultar `crl_options` y `latest_crl`.",{"_2859":59833,"_25205":59788,"_17596":102185,"_5":17486,"_23867":102076,"_2386":47196},[],{"_2859":59834,"_25205":59788,"_17596":102187,"_5":17486,"_23867":102076,"_2386":47190},[],{"_2859":59835,"_25205":59788,"_17596":102189,"_5":17486,"_23867":102076,"_2386":102190},[],"Sustituir la configuración de CRL.",{"_2859":59836,"_25205":59788,"_17596":102192,"_5":17486,"_23867":102076,"_2386":102193},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2859":59837,"_25205":59788,"_17596":102195,"_5":17486,"_23867":102076,"_2386":102196},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2859":59838,"_25205":59788,"_17596":102198,"_5":17486,"_23867":102080,"_2386":102199},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2859":59839,"_25205":59788,"_17596":102201,"_5":17486,"_23867":102084,"_2386":102202},[],"RFC 5280: perfil X.509 y CRL.",{"_2859":59840,"_25205":59788,"_17596":102204,"_5":17486,"_23867":102084,"_2386":47216},[],{"_2859":59841,"_25205":59788,"_17596":102206,"_5":17486,"_23867":102084,"_2386":47219},[],{"_2859":59842,"_25205":59788,"_17596":102208,"_5":17486,"_23867":102084,"_2386":102209},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2859":59843,"_25205":59788,"_17596":102211,"_5":17486,"_23867":102084,"_2386":102212},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2859":59844,"_25205":59844,"_5":12316,"_2386":102214,"_25540":102215,"_17596":102216,"_23867":59844},"Claves y motores criptográficos",[40894,97341,45925,100925],[],{"_2859":59845,"_25205":59844,"_17596":102218,"_5":17486,"_23867":59844,"_2386":102219},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2859":59846,"_25205":59844,"_5":25537,"_17596":102221,"_23867":102222,"_2386":102223},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2859":59847,"_25205":59844,"_5":25537,"_17596":102225,"_23867":102226,"_2386":102227},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2859":59848,"_25205":59844,"_5":25537,"_17596":102229,"_23867":102230,"_2386":47244},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#file-system",{"_2859":59849,"_25205":59844,"_5":25537,"_17596":102232,"_23867":102233,"_2386":47248},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#hashicorp-vault",{"_2859":59850,"_25205":59844,"_5":25537,"_17596":102235,"_23867":102236,"_2386":47252},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#aws-secrets-manager",{"_2859":59851,"_25205":59844,"_5":25537,"_17596":102238,"_23867":102239,"_2386":47256},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#aws-kms",{"_2859":59852,"_25205":59844,"_5":25537,"_17596":102241,"_23867":102242,"_2386":47260},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#pkcs11",{"_2859":59853,"_25205":59844,"_5":25537,"_17596":102244,"_23867":102245,"_2386":47264},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#azure-key-vault",{"_2859":59854,"_25205":59844,"_5":25537,"_17596":102247,"_23867":102248,"_2386":102249},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2859":59855,"_25205":59844,"_5":25537,"_17596":102251,"_23867":102252,"_2386":102253},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2859":59856,"_25205":59844,"_5":25537,"_17596":102255,"_23867":102256,"_2386":102257},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2859":59857,"_25205":59844,"_5":25537,"_17596":102259,"_23867":102260,"_2386":102261},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2859":59858,"_25205":59844,"_5":25537,"_17596":102263,"_23867":102264,"_2386":102265},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2859":59859,"_25205":59844,"_5":25537,"_17596":102267,"_23867":102268,"_2386":102269},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2859":59860,"_25205":59844,"_5":25537,"_17596":102271,"_23867":102272,"_2386":102273},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2859":59861,"_25205":59844,"_5":25537,"_17596":102275,"_23867":102276,"_2386":47296},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#sign",{"_2859":59862,"_25205":59844,"_5":25537,"_17596":102278,"_23867":102279,"_2386":47300},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#verify",{"_2859":59863,"_25205":59844,"_5":25537,"_17596":102281,"_23867":102282,"_2386":102283},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2859":59864,"_25205":59844,"_5":25537,"_17596":102285,"_23867":102286,"_2386":102287},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2859":59865,"_25205":59844,"_5":25537,"_17596":102289,"_23867":102290,"_2386":102291},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2859":59866,"_25205":59844,"_17596":102293,"_5":17486,"_23867":59844,"_2386":102294},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2859":59867,"_25205":59844,"_17596":102296,"_5":17486,"_23867":59844,"_2386":102297},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2859":59868,"_25205":59844,"_17596":102299,"_5":17486,"_23867":102222,"_2386":102300},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2859":59869,"_25205":59844,"_17596":102302,"_5":17486,"_23867":102222,"_2386":102303},[],"En la práctica, permite:",{"_2859":59870,"_25205":59844,"_17596":102305,"_5":17486,"_23867":102222,"_2386":102306},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2859":59871,"_25205":59844,"_17596":102308,"_5":17486,"_23867":102222,"_2386":102309},[],"Importar claves creadas externamente.",{"_2859":59872,"_25205":59844,"_17596":102311,"_5":17486,"_23867":102222,"_2386":102312},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2859":59873,"_25205":59844,"_17596":102314,"_5":17486,"_23867":102222,"_2386":102315},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2859":59874,"_25205":59844,"_17596":102317,"_5":17486,"_23867":102226,"_2386":102318},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2859":59875,"_25205":59844,"_17596":102320,"_5":17486,"_23867":102226,"_2386":102321},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2859":59876,"_25205":59844,"_17596":102323,"_5":17486,"_23867":102226,"_2386":102324},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2859":59877,"_25205":59844,"_17596":102326,"_5":17486,"_23867":102230,"_2386":102327},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2859":59878,"_25205":59844,"_17596":102329,"_5":17486,"_23867":102233,"_2386":102330},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2859":59879,"_25205":59844,"_17596":102332,"_5":17486,"_23867":102236,"_2386":102333},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2859":59880,"_25205":59844,"_17596":102335,"_5":17486,"_23867":102239,"_2386":102336},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2859":59881,"_25205":59844,"_17596":102338,"_5":17486,"_23867":102242,"_2386":102339},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2859":59882,"_25205":59844,"_17596":102341,"_5":17486,"_23867":102245,"_2386":102342},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2859":59883,"_25205":59844,"_17596":102344,"_5":17486,"_23867":102245,"_2386":102345},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2859":59884,"_25205":59844,"_17596":102347,"_5":17486,"_23867":102245,"_2386":102348},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2859":59885,"_25205":59844,"_17596":102350,"_5":17486,"_23867":102245,"_2386":102351},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2859":59886,"_25205":59844,"_17596":102353,"_5":17486,"_23867":102248,"_2386":102354},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2859":59887,"_25205":59844,"_17596":102356,"_5":17486,"_23867":102248,"_2386":102357},[],"La tabla incluye los siguientes campos:",{"_2859":59888,"_25205":59844,"_17596":102359,"_5":17486,"_23867":102248,"_2386":102360},[],"**Name**: nombre descriptivo de la clave.",{"_2859":59889,"_25205":59844,"_17596":102362,"_5":17486,"_23867":102248,"_2386":102363},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2859":59890,"_25205":59844,"_17596":102365,"_5":17486,"_23867":102248,"_2386":102366},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2859":59891,"_25205":59844,"_17596":102368,"_5":17486,"_23867":102248,"_2386":102369},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2859":59892,"_25205":59844,"_17596":102371,"_5":17486,"_23867":102248,"_2386":102372},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2859":59893,"_25205":59844,"_17596":102374,"_5":17486,"_23867":102248,"_2386":102375},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2859":59894,"_25205":59844,"_17596":102377,"_5":17486,"_23867":102248,"_2386":102378},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2859":59895,"_25205":59844,"_17596":102380,"_5":17486,"_23867":102248,"_2386":102381},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2859":59896,"_25205":59844,"_17596":102383,"_5":17486,"_23867":102248,"_2386":102384},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2859":59897,"_25205":59844,"_17596":102386,"_5":17486,"_23867":102248,"_2386":102387},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2859":59898,"_25205":59844,"_17596":102389,"_5":17486,"_23867":102248,"_2386":102390},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2859":59899,"_25205":59844,"_17596":102392,"_5":17486,"_23867":102248,"_2386":102393},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2859":59900,"_25205":59844,"_17596":102395,"_5":17486,"_23867":102248,"_2386":102396},[],"**Delete Key** para eliminar la clave del sistema.",{"_2859":59901,"_25205":59844,"_17596":102398,"_5":17486,"_23867":102252,"_2386":102399},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2859":59902,"_25205":59844,"_17596":102401,"_5":17486,"_23867":102256,"_2386":102402},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2859":59903,"_25205":59844,"_17596":102404,"_5":17486,"_23867":102256,"_2386":102405},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2859":59904,"_25205":59844,"_17596":102407,"_5":17486,"_23867":102256,"_2386":102408},[],"**Key Name**: nombre único y descriptivo.",{"_2859":59905,"_25205":59844,"_17596":102410,"_5":17486,"_23867":102256,"_2386":102411},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2859":59906,"_25205":59844,"_17596":102413,"_5":17486,"_23867":102256,"_2386":102414},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2859":59907,"_25205":59844,"_17596":102416,"_5":17486,"_23867":102256,"_2386":102417},[],"**Tags**: metadatos para clasificar la clave.",{"_2859":59908,"_25205":59844,"_17596":102419,"_5":17486,"_23867":102256,"_2386":102420},[],"**Metadata**: información adicional para usos avanzados.",{"_2859":59909,"_25205":59844,"_17596":102422,"_5":17486,"_23867":102260,"_2386":102423},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2859":59910,"_25205":59844,"_17596":102425,"_5":17486,"_23867":102260,"_2386":102426},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2859":59911,"_25205":59844,"_17596":102428,"_5":17486,"_23867":102260,"_2386":102429},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2859":59912,"_25205":59844,"_17596":102431,"_5":17486,"_23867":102260,"_2386":102432},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2859":59913,"_25205":59844,"_17596":102434,"_5":17486,"_23867":102260,"_2386":102435},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2859":59914,"_25205":59844,"_17596":102437,"_5":17486,"_23867":102260,"_2386":102438},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2859":59915,"_25205":59844,"_17596":102440,"_5":17486,"_23867":102260,"_2386":102441},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2859":59916,"_25205":59844,"_17596":102443,"_5":17486,"_23867":102260,"_2386":102444},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2859":59917,"_25205":59844,"_17596":102446,"_5":17486,"_23867":102260,"_2386":102447},[],"**Metadata**: información adicional opcional.",{"_2859":59918,"_25205":59844,"_17596":102449,"_5":17486,"_23867":102260,"_2386":102450},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2859":59919,"_25205":59844,"_17596":102452,"_5":17486,"_23867":102260,"_2386":102453},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2859":59920,"_25205":59844,"_17596":102455,"_5":17486,"_23867":102264,"_2386":102456},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2859":59921,"_25205":59844,"_17596":102458,"_5":17486,"_23867":102268,"_2386":102459},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2859":59922,"_25205":59844,"_17596":102461,"_5":17486,"_23867":102268,"_2386":102462},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2859":59923,"_25205":59844,"_17596":102464,"_5":17486,"_23867":102268,"_2386":102465},[],"**Key Name**: nombre descriptivo.",{"_2859":59924,"_25205":59844,"_17596":102467,"_5":17486,"_23867":102268,"_2386":102468},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2859":59925,"_25205":59844,"_17596":102470,"_5":17486,"_23867":102268,"_2386":102471},[],"**Tags**: etiquetas asociadas.",{"_2859":59926,"_25205":59844,"_17596":102473,"_5":17486,"_23867":102268,"_2386":102474},[],"**Aliases**: nombres alternativos.",{"_2859":59927,"_25205":59844,"_17596":102476,"_5":17486,"_23867":102268,"_2386":102477},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2859":59928,"_25205":59844,"_17596":102479,"_5":17486,"_23867":102268,"_2386":102480},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2859":59929,"_25205":59844,"_17596":102482,"_5":17486,"_23867":102268,"_2386":102483},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2859":59930,"_25205":59844,"_17596":102485,"_5":17486,"_23867":102268,"_2386":102486},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2859":59931,"_25205":59844,"_17596":102488,"_5":17486,"_23867":102272,"_2386":102489},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2859":59932,"_25205":59844,"_17596":102491,"_5":17486,"_23867":102272,"_2386":102492},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2859":59933,"_25205":59844,"_17596":102494,"_5":17486,"_23867":102272,"_2386":102495},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2859":59934,"_25205":59844,"_17596":102497,"_5":17486,"_23867":102276,"_2386":102498},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2859":59935,"_25205":59844,"_17596":102500,"_5":17486,"_23867":102276,"_2386":102501},[],"Campos principales:",{"_2859":59936,"_25205":59844,"_17596":102503,"_5":17486,"_23867":102276,"_2386":102504},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2859":59937,"_25205":59844,"_17596":102506,"_5":17486,"_23867":102276,"_2386":102507},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2859":59938,"_25205":59844,"_17596":102509,"_5":17486,"_23867":102276,"_2386":102510},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2859":59939,"_25205":59844,"_17596":102512,"_5":17486,"_23867":102276,"_2386":102513},[],"**Message**: contenido que se va a firmar.",{"_2859":59940,"_25205":59844,"_17596":102515,"_5":17486,"_23867":102276,"_2386":102516},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2859":59941,"_25205":59844,"_17596":102518,"_5":17486,"_23867":102279,"_2386":102519},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2859":59942,"_25205":59844,"_17596":102521,"_5":17486,"_23867":102279,"_2386":102501},[],{"_2859":59943,"_25205":59844,"_17596":102523,"_5":17486,"_23867":102279,"_2386":102524},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2859":59944,"_25205":59844,"_17596":102526,"_5":17486,"_23867":102279,"_2386":102527},[],"**Message Type**: `Raw` o `Digest`.",{"_2859":59945,"_25205":59844,"_17596":102529,"_5":17486,"_23867":102279,"_2386":102530},[],"**Payload Encoding**: codificación del mensaje.",{"_2859":59946,"_25205":59844,"_17596":102532,"_5":17486,"_23867":102279,"_2386":102533},[],"**Message**: mensaje original o hash.",{"_2859":59947,"_25205":59844,"_17596":102535,"_5":17486,"_23867":102279,"_2386":102536},[],"**Signature**: firma que se desea comprobar.",{"_2859":59948,"_25205":59844,"_17596":102538,"_5":17486,"_23867":102279,"_2386":102539},[],"**Result**: indicador del resultado de la validación.",{"_2859":59949,"_25205":59844,"_17596":102541,"_5":17486,"_23867":102282,"_2386":102542},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2859":59950,"_25205":59844,"_17596":102544,"_5":17486,"_23867":102282,"_2386":102545},[],"Este flujo es útil para:",{"_2859":59951,"_25205":59844,"_17596":102547,"_5":17486,"_23867":102282,"_2386":102548},[],"Solicitar certificados a una CA externa.",{"_2859":59952,"_25205":59844,"_17596":102550,"_5":17486,"_23867":102282,"_2386":102551},[],"Renovar una identidad manteniendo la misma clave.",{"_2859":59953,"_25205":59844,"_17596":102553,"_5":17486,"_23867":102282,"_2386":102554},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2859":59954,"_25205":59844,"_17596":102556,"_5":17486,"_23867":102282,"_2386":102557},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2859":59955,"_25205":59844,"_17596":102559,"_5":17486,"_23867":102282,"_2386":102560},[],"**Organization (O)**: organización o empresa.",{"_2859":59956,"_25205":59844,"_17596":102562,"_5":17486,"_23867":102282,"_2386":102563},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2859":59957,"_25205":59844,"_17596":102565,"_5":17486,"_23867":102282,"_2386":102566},[],"**Country (C)**: código de país de dos letras.",{"_2859":59958,"_25205":59844,"_17596":102568,"_5":17486,"_23867":102282,"_2386":102569},[],"**State / Province (ST)**: estado o provincia.",{"_2859":59959,"_25205":59844,"_17596":102571,"_5":17486,"_23867":102282,"_2386":102572},[],"**Locality (L)**: ciudad o localidad.",{"_2859":59960,"_25205":59844,"_17596":102574,"_5":17486,"_23867":102282,"_2386":102575},[],"**Email Address**: correo de contacto.",{"_2859":59961,"_25205":59844,"_17596":102577,"_5":17486,"_23867":102282,"_2386":102578},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2859":59962,"_25205":59844,"_17596":102580,"_5":17486,"_23867":102282,"_2386":102581},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2859":59963,"_25205":59844,"_17596":102583,"_5":17486,"_23867":102286,"_2386":102584},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2859":59964,"_25205":59844,"_17596":102586,"_5":17486,"_23867":102286,"_2386":47608},[],{"_2859":59965,"_25205":59844,"_17596":102588,"_5":17486,"_23867":102290,"_2386":102589},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2859":59966,"_25205":59966,"_5":12316,"_2386":102591,"_25540":102592,"_17596":102593,"_23867":59966},"Validación online con OCSP",[40894,97341,45925,101540],[],{"_2859":59967,"_25205":59966,"_17596":102595,"_5":17486,"_23867":59966,"_2386":102596},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2859":59968,"_25205":59966,"_5":25537,"_17596":102598,"_23867":102599,"_2386":102600},[],"/docs/pr-preview/pr-43/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2859":59969,"_25205":59966,"_5":25537,"_17596":102602,"_23867":102603,"_2386":102604},[],"/docs/pr-preview/pr-43/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2859":59970,"_25205":59966,"_5":25537,"_17596":102606,"_23867":102607,"_2386":102608},[],"/docs/pr-preview/pr-43/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2859":59971,"_25205":59966,"_5":25537,"_17596":102610,"_23867":102611,"_2386":102612},[],"/docs/pr-preview/pr-43/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2859":59972,"_25205":59966,"_5":25537,"_17596":102614,"_23867":102615,"_2386":102616},[],"/docs/pr-preview/pr-43/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2859":59973,"_25205":59966,"_5":25537,"_17596":102618,"_23867":102619,"_2386":102085},[],"/docs/pr-preview/pr-43/es/platform/pki/ocsp#referencias",{"_2859":59974,"_25205":59966,"_17596":102621,"_5":17486,"_23867":59966,"_2386":102622},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2859":59975,"_25205":59966,"_17596":102624,"_5":17486,"_23867":102599,"_2386":102625},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2859":59976,"_25205":59966,"_17596":102627,"_5":17486,"_23867":102599,"_2386":102628},[],"Estado del registro",{"_2859":59977,"_25205":59966,"_17596":102630,"_5":17486,"_23867":102599,"_2386":102631},[],"Respuesta firmada",{"_2859":59978,"_25205":59966,"_17596":102633,"_5":17486,"_23867":102599,"_2386":45094},[],{"_2859":59979,"_25205":59966,"_17596":102635,"_5":17486,"_23867":102599,"_2386":47658},[],{"_2859":59980,"_25205":59966,"_17596":102637,"_5":17486,"_23867":102599,"_2386":45111},[],{"_2859":59981,"_25205":59966,"_17596":102639,"_5":17486,"_23867":102599,"_2386":102640},[],"`Revoked`, con razón y fecha de revocación.",{"_2859":59982,"_25205":59966,"_17596":102642,"_5":17486,"_23867":102599,"_2386":102643},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2859":59983,"_25205":59966,"_17596":102645,"_5":17486,"_23867":102599,"_2386":102646},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2859":59984,"_25205":59966,"_17596":102648,"_5":17486,"_23867":102599,"_2386":102649},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2859":59985,"_25205":59966,"_17596":102651,"_5":17486,"_23867":102599,"_2386":102652},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2859":59986,"_25205":59966,"_17596":102654,"_5":17486,"_23867":102599,"_2386":102655},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2859":59987,"_25205":59966,"_17596":102657,"_5":17486,"_23867":102603,"_2386":102658},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2859":59988,"_25205":59966,"_17596":102660,"_5":17486,"_23867":102603,"_2386":102661},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2859":59989,"_25205":59966,"_17596":102663,"_5":17486,"_23867":102607,"_2386":102664},[],"El servicio acepta:",{"_2859":59990,"_25205":59966,"_17596":102666,"_5":17486,"_23867":102607,"_2386":99023},[],{"_2859":59991,"_25205":59966,"_17596":102668,"_5":17486,"_23867":102607,"_2386":102669},[],"Ruta del servicio VA",{"_2859":59992,"_25205":59966,"_17596":102671,"_5":17486,"_23867":102607,"_2386":102672},[],"Formato",{"_2859":59993,"_25205":59966,"_17596":102674,"_5":17486,"_23867":102607,"_2386":47698},[],{"_2859":59994,"_25205":59966,"_17596":102676,"_5":17486,"_23867":102607,"_2386":47701},[],{"_2859":59995,"_25205":59966,"_17596":102678,"_5":17486,"_23867":102607,"_2386":102679},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2859":59996,"_25205":59966,"_17596":102681,"_5":17486,"_23867":102607,"_2386":47187},[],{"_2859":59997,"_25205":59966,"_17596":102683,"_5":17486,"_23867":102607,"_2386":47709},[],{"_2859":59998,"_25205":59966,"_17596":102685,"_5":17486,"_23867":102607,"_2386":102686},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2859":59999,"_25205":59966,"_17596":102688,"_5":17486,"_23867":102607,"_2386":102689},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2859":60000,"_25205":59966,"_17596":102691,"_5":17486,"_23867":102611,"_2386":102692},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2859":60001,"_25205":59966,"_17596":102694,"_5":17486,"_23867":102611,"_2386":102695},[],"Genera la solicitud:",{"_2859":60002,"_25205":59966,"_17596":102697,"_5":17486,"_23867":102611,"_2386":102698},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2859":60003,"_25205":59966,"_17596":102700,"_5":17486,"_23867":102611,"_2386":102701},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2859":60004,"_25205":59966,"_17596":102703,"_5":17486,"_23867":102611,"_2386":102704},[],"Verifica el DER recibido:",{"_2859":60005,"_25205":59966,"_17596":102706,"_5":17486,"_23867":102611,"_2386":102707},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2859":60006,"_25205":59966,"_17596":102709,"_5":17486,"_23867":102615,"_2386":102710},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2859":60007,"_25205":59966,"_17596":102712,"_5":17486,"_23867":102615,"_2386":102713},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2859":60008,"_25205":59966,"_17596":102715,"_5":17486,"_23867":102619,"_2386":47742},[],{"_2859":60009,"_25205":59966,"_17596":102717,"_5":17486,"_23867":102619,"_2386":47745},[],{"_2859":60010,"_25205":59966,"_17596":102719,"_5":17486,"_23867":102619,"_2386":102720},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2859":60011,"_25205":59966,"_17596":102722,"_5":17486,"_23867":102619,"_2386":102212},[],{"_2859":60012,"_25205":60012,"_5":12316,"_2386":45925,"_25540":102724,"_17596":102725,"_23867":60012},[40894,97341,45925],[],{"_2859":60013,"_25205":60012,"_17596":102727,"_5":17486,"_23867":60012,"_2386":102728},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2859":60014,"_25205":60012,"_5":25537,"_17596":102730,"_23867":102731,"_2386":100249},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#empieza-aquí",{"_2859":60015,"_25205":60012,"_5":25537,"_17596":102733,"_23867":102734,"_2386":102735},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2859":60016,"_25205":60012,"_5":25537,"_17596":102737,"_23867":102738,"_2386":100771},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#capacidades-principales",{"_2859":60017,"_25205":60012,"_5":25537,"_17596":102740,"_23867":102741,"_2386":100775},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2859":60018,"_25205":60012,"_5":25537,"_17596":102743,"_23867":102744,"_2386":100779},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2859":60019,"_25205":60012,"_5":25537,"_17596":102746,"_23867":102747,"_2386":100783},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#emite-y-controla-certificados",{"_2859":60020,"_25205":60012,"_5":25537,"_17596":102749,"_23867":102750,"_2386":100791},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#publica-el-estado-de-validación",{"_2859":60021,"_25205":60012,"_5":25537,"_17596":102752,"_23867":102753,"_2386":102754},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2859":60022,"_25205":60012,"_5":25537,"_17596":102756,"_23867":102757,"_2386":101706},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#continúa",{"_2859":60023,"_25205":60012,"_17596":102759,"_5":17486,"_23867":60012,"_2386":102760},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2859":60024,"_25205":60012,"_17596":102762,"_5":17486,"_23867":102731,"_2386":102763},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2859":60025,"_25205":60012,"_17596":102765,"_5":17486,"_23867":102731,"_2386":102766},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2859":60026,"_25205":60012,"_17596":102768,"_5":17486,"_23867":102734,"_2386":102769},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2859":60027,"_25205":60012,"_17596":102771,"_5":17486,"_23867":102734,"_2386":102772},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2859":60028,"_25205":60012,"_17596":102774,"_5":17486,"_23867":102734,"_2386":102775},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2859":60029,"_25205":60012,"_17596":102777,"_5":17486,"_23867":102734,"_2386":102778},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2859":60030,"_25205":60012,"_17596":102780,"_5":17486,"_23867":102734,"_2386":102781},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2859":60031,"_25205":60012,"_17596":102783,"_5":17486,"_23867":102741,"_2386":102784},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2859":60032,"_25205":60012,"_17596":102786,"_5":17486,"_23867":102744,"_2386":102787},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2859":60033,"_25205":60012,"_17596":102789,"_5":17486,"_23867":102747,"_2386":102790},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2859":60034,"_25205":60012,"_17596":102792,"_5":17486,"_23867":102750,"_2386":102793},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2859":60035,"_25205":60012,"_17596":102795,"_5":17486,"_23867":102753,"_2386":102796},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2859":60036,"_25205":60012,"_17596":102798,"_5":17486,"_23867":102753,"_2386":102799},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2859":60037,"_25205":60012,"_17596":102801,"_5":17486,"_23867":102753,"_2386":102802},[],"su clave pública corresponda a la clave privada del cliente;",{"_2859":60038,"_25205":60012,"_17596":102804,"_5":17486,"_23867":102753,"_2386":102805},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2859":60039,"_25205":60012,"_17596":102807,"_5":17486,"_23867":102753,"_2386":102808},[],"sus fechas y usos permitan la operación;",{"_2859":60040,"_25205":60012,"_17596":102810,"_5":17486,"_23867":102753,"_2386":102811},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2859":60041,"_25205":60012,"_17596":102813,"_5":17486,"_23867":102753,"_2386":102814},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2859":60042,"_25205":60012,"_17596":102816,"_5":17486,"_23867":102757,"_2386":102817},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2859":60043,"_25205":60012,"_17596":102819,"_5":17486,"_23867":102757,"_2386":102820},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2859":60044,"_25205":60012,"_17596":102822,"_5":17486,"_23867":102757,"_2386":102823},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2859":60045,"_25205":60045,"_5":12316,"_2386":102825,"_25540":102826,"_17596":102827,"_23867":60045},"Crea tu primera CA",[40894,97341,45925,100373],[],{"_2859":60046,"_25205":60045,"_17596":102829,"_5":17486,"_23867":60045,"_2386":102830},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2859":60047,"_25205":60045,"_5":25537,"_17596":102832,"_23867":102833,"_2386":96042},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2859":60048,"_25205":60045,"_5":25537,"_17596":102835,"_23867":102836,"_2386":102837},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2859":60049,"_25205":60045,"_5":25537,"_17596":102839,"_23867":102840,"_2386":102841},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2859":60050,"_25205":60045,"_5":25537,"_17596":102843,"_23867":102844,"_2386":102845},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2859":60051,"_25205":60045,"_5":25537,"_17596":102847,"_23867":102848,"_2386":102849},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2859":60052,"_25205":60045,"_5":25537,"_17596":102851,"_23867":102852,"_2386":102853},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2859":60053,"_25205":60045,"_5":25537,"_17596":102855,"_23867":102856,"_2386":102857},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2859":60054,"_25205":60045,"_5":25537,"_17596":102859,"_23867":102860,"_2386":100621},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2859":60055,"_25205":60045,"_5":25537,"_17596":102862,"_23867":102863,"_2386":96066},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2859":60056,"_25205":60045,"_17596":102865,"_5":17486,"_23867":60045,"_2386":102866},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2859":60057,"_25205":60045,"_17596":102868,"_5":17486,"_23867":102833,"_2386":102869},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2859":60058,"_25205":60045,"_17596":102871,"_5":17486,"_23867":102833,"_2386":102872},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2859":60059,"_25205":60045,"_17596":102874,"_5":17486,"_23867":102833,"_2386":102875},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2859":60060,"_25205":60045,"_17596":102877,"_5":17486,"_23867":102833,"_2386":102878},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2859":60061,"_25205":60045,"_17596":102880,"_5":17486,"_23867":102836,"_2386":102881},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2859":60062,"_25205":60045,"_17596":102883,"_5":17486,"_23867":102836,"_2386":102884},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2859":60063,"_25205":60045,"_17596":102886,"_5":17486,"_23867":102840,"_2386":102887},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2859":60064,"_25205":60045,"_17596":102889,"_5":17486,"_23867":102840,"_2386":102890},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2859":60065,"_25205":60045,"_17596":102892,"_5":17486,"_23867":102844,"_2386":102893},[],"Selecciona **Root CA** y completa:",{"_2859":60066,"_25205":60045,"_17596":102895,"_5":17486,"_23867":102844,"_2386":47924},[],{"_2859":60067,"_25205":60045,"_17596":102897,"_5":17486,"_23867":102844,"_2386":102898},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2859":60068,"_25205":60045,"_17596":102900,"_5":17486,"_23867":102844,"_2386":102901},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2859":60069,"_25205":60045,"_17596":102903,"_5":17486,"_23867":102844,"_2386":102904},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2859":60070,"_25205":60045,"_17596":102906,"_5":17486,"_23867":102844,"_2386":102907},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2859":60071,"_25205":60045,"_17596":102909,"_5":17486,"_23867":102848,"_2386":102910},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2859":60072,"_25205":60045,"_17596":102912,"_5":17486,"_23867":102852,"_2386":102913},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2859":60073,"_25205":60045,"_17596":102915,"_5":17486,"_23867":102852,"_2386":102916},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2859":60074,"_25205":60045,"_17596":102918,"_5":17486,"_23867":102856,"_2386":102919},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2859":60075,"_25205":60045,"_17596":102921,"_5":17486,"_23867":102856,"_2386":102922},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2859":60076,"_25205":60045,"_17596":102924,"_5":17486,"_23867":102856,"_2386":102925},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2859":60077,"_25205":60045,"_17596":102927,"_5":17486,"_23867":102860,"_2386":102928},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2859":60078,"_25205":60045,"_17596":102930,"_5":17486,"_23867":102860,"_2386":102931},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2859":60079,"_25205":60045,"_17596":102933,"_5":17486,"_23867":102860,"_2386":102934},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2859":60080,"_25205":60045,"_17596":102936,"_5":17486,"_23867":102860,"_2386":102937},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2859":60081,"_25205":60045,"_17596":102939,"_5":17486,"_23867":102863,"_2386":102940},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2859":60082,"_25205":60082,"_5":12316,"_2386":102942,"_25540":102943,"_17596":102944,"_23867":60082},"Emite y verifica un certificado",[40894,97341,45925,100373],[],{"_2859":60083,"_25205":60082,"_17596":102946,"_5":17486,"_23867":60082,"_2386":102947},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2859":60084,"_25205":60082,"_5":25537,"_17596":102949,"_23867":102950,"_2386":96042},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2859":60085,"_25205":60082,"_5":25537,"_17596":102952,"_23867":102953,"_2386":102954},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2859":60086,"_25205":60082,"_5":25537,"_17596":102956,"_23867":102957,"_2386":102958},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2859":60087,"_25205":60082,"_5":25537,"_17596":102960,"_23867":102961,"_2386":102962},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2859":60088,"_25205":60082,"_5":25537,"_17596":102964,"_23867":102965,"_2386":102966},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2859":60089,"_25205":60082,"_5":25537,"_17596":102968,"_23867":102969,"_2386":102970},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2859":60090,"_25205":60082,"_5":25537,"_17596":102972,"_23867":102973,"_2386":102853},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2859":60091,"_25205":60082,"_5":25537,"_17596":102975,"_23867":102976,"_2386":102977},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2859":60092,"_25205":60082,"_5":25537,"_17596":102979,"_23867":102980,"_2386":102981},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2859":60093,"_25205":60082,"_5":25537,"_17596":102983,"_23867":102984,"_2386":102985},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2859":60094,"_25205":60082,"_5":25537,"_17596":102987,"_23867":102988,"_2386":100621},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2859":60095,"_25205":60082,"_5":25537,"_17596":102990,"_23867":102991,"_2386":96066},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2859":60096,"_25205":60082,"_17596":102993,"_5":17486,"_23867":60082,"_2386":102994},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2859":60097,"_25205":60082,"_17596":102996,"_5":17486,"_23867":102950,"_2386":102997},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2859":60098,"_25205":60082,"_17596":102999,"_5":17486,"_23867":102950,"_2386":103000},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2859":60099,"_25205":60082,"_17596":103002,"_5":17486,"_23867":102950,"_2386":103003},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2859":60100,"_25205":60082,"_17596":103005,"_5":17486,"_23867":102950,"_2386":103006},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2859":60101,"_25205":60082,"_17596":103008,"_5":17486,"_23867":102950,"_2386":103009},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2859":60102,"_25205":60082,"_17596":103011,"_5":17486,"_23867":102953,"_2386":103012},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2859":60103,"_25205":60082,"_17596":103014,"_5":17486,"_23867":102957,"_2386":103015},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2859":60104,"_25205":60082,"_17596":103017,"_5":17486,"_23867":102957,"_2386":103018},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2859":60105,"_25205":60082,"_17596":103020,"_5":17486,"_23867":102961,"_2386":103021},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2859":60106,"_25205":60082,"_17596":103023,"_5":17486,"_23867":102961,"_2386":103024},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2859":60107,"_25205":60082,"_17596":103026,"_5":17486,"_23867":102965,"_2386":103027},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2859":60108,"_25205":60082,"_17596":103029,"_5":17486,"_23867":102965,"_2386":103030},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2859":60109,"_25205":60082,"_17596":103032,"_5":17486,"_23867":102969,"_2386":103033},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2859":60110,"_25205":60082,"_17596":103035,"_5":17486,"_23867":102973,"_2386":103036},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2859":60111,"_25205":60082,"_17596":103038,"_5":17486,"_23867":102976,"_2386":103039},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2859":60112,"_25205":60082,"_17596":103041,"_5":17486,"_23867":102980,"_2386":103042},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2859":60113,"_25205":60082,"_17596":103044,"_5":17486,"_23867":102980,"_2386":103045},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2859":60114,"_25205":60082,"_17596":103047,"_5":17486,"_23867":102980,"_2386":103048},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2859":60115,"_25205":60082,"_17596":103050,"_5":17486,"_23867":102984,"_2386":103051},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2859":60116,"_25205":60082,"_17596":103053,"_5":17486,"_23867":102984,"_2386":103054},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2859":60117,"_25205":60082,"_17596":103056,"_5":17486,"_23867":102984,"_2386":103057},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2859":60118,"_25205":60082,"_17596":103059,"_5":17486,"_23867":102988,"_2386":100704},[],{"_2859":60119,"_25205":60082,"_17596":103061,"_5":17486,"_23867":102988,"_2386":99472},[],{"_2859":60120,"_25205":60082,"_17596":103063,"_5":17486,"_23867":102988,"_2386":103064},[],"La CA rechaza la emisión",{"_2859":60121,"_25205":60082,"_17596":103066,"_5":17486,"_23867":102988,"_2386":103067},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2859":60122,"_25205":60082,"_17596":103069,"_5":17486,"_23867":102988,"_2386":103070},[],"Sujeto o usos diferentes",{"_2859":60123,"_25205":60082,"_17596":103072,"_5":17486,"_23867":102988,"_2386":103073},[],"Perfil aplicado y valores solicitados.",{"_2859":60124,"_25205":60082,"_17596":103075,"_5":17486,"_23867":102988,"_2386":103076},[],"No se encuentra el emisor",{"_2859":60125,"_25205":60082,"_17596":103078,"_5":17486,"_23867":102988,"_2386":103079},[],"CA descargada y cadena intermedia necesaria.",{"_2859":60126,"_25205":60082,"_17596":103081,"_5":17486,"_23867":102988,"_2386":103082},[],"Falla la vigencia",{"_2859":60127,"_25205":60082,"_17596":103084,"_5":17486,"_23867":102988,"_2386":103085},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2859":60128,"_25205":60082,"_17596":103087,"_5":17486,"_23867":102988,"_2386":103088},[],"Los resúmenes de clave difieren",{"_2859":60129,"_25205":60082,"_17596":103090,"_5":17486,"_23867":102988,"_2386":103091},[],"Archivos de certificado y clave de la misma emisión.",{"_2859":60130,"_25205":60082,"_17596":103093,"_5":17486,"_23867":102988,"_2386":103094},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2859":60131,"_25205":60082,"_17596":103096,"_5":17486,"_23867":102991,"_2386":103097},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2859":60132,"_25205":60082,"_17596":103099,"_5":17486,"_23867":102991,"_2386":103100},[],"Gestionar certificados para inspección, estado y revocación.",{"_2859":60133,"_25205":60082,"_17596":103102,"_5":17486,"_23867":102991,"_2386":103103},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2859":60134,"_25205":60082,"_17596":103105,"_5":17486,"_23867":102991,"_2386":103106},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2859":60135,"_25205":60082,"_17596":103108,"_5":17486,"_23867":102991,"_2386":103109},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2859":60136,"_25205":60136,"_5":12316,"_2386":103111,"_25540":103112,"_17596":103113,"_23867":60136},"Primeros pasos de PKI",[40894,97341,45925,100373],[],{"_2859":60137,"_25205":60136,"_17596":103115,"_5":17486,"_23867":60136,"_2386":103116},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2859":60138,"_25205":60136,"_5":25537,"_17596":103118,"_23867":103119,"_2386":96042},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2859":60139,"_25205":60136,"_5":25537,"_17596":103121,"_23867":103122,"_2386":103123},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2859":60140,"_25205":60136,"_5":25537,"_17596":103125,"_23867":103126,"_2386":100555},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2859":60141,"_25205":60136,"_5":25537,"_17596":103128,"_23867":103129,"_2386":103130},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2859":60142,"_25205":60136,"_17596":103132,"_5":17486,"_23867":60136,"_2386":103133},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2859":60143,"_25205":60136,"_17596":103135,"_5":17486,"_23867":103119,"_2386":103136},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2859":60144,"_25205":60136,"_17596":103138,"_5":17486,"_23867":103119,"_2386":103139},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2859":60145,"_25205":60136,"_17596":103141,"_5":17486,"_23867":103119,"_2386":103142},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2859":60146,"_25205":60136,"_17596":103144,"_5":17486,"_23867":103119,"_2386":103145},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2859":60147,"_25205":60136,"_17596":103147,"_5":17486,"_23867":103119,"_2386":103148},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2859":60148,"_25205":60136,"_17596":103150,"_5":17486,"_23867":103122,"_2386":103151},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2859":60149,"_25205":60136,"_17596":103153,"_5":17486,"_23867":103122,"_2386":103154},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2859":60150,"_25205":60136,"_17596":103156,"_5":17486,"_23867":103122,"_2386":103157},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2859":60151,"_25205":60136,"_17596":103159,"_5":17486,"_23867":103122,"_2386":103160},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2859":60152,"_25205":60136,"_17596":103162,"_5":17486,"_23867":103126,"_2386":103163},[],"Archivo o recurso",{"_2859":60153,"_25205":60136,"_17596":103165,"_5":17486,"_23867":103126,"_2386":100552},[],{"_2859":60154,"_25205":60136,"_17596":103167,"_5":17486,"_23867":103126,"_2386":103168},[],"CA raíz activa y `ca.pem`",{"_2859":60155,"_25205":60136,"_17596":103170,"_5":17486,"_23867":103126,"_2386":103171},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2859":60156,"_25205":60136,"_17596":103173,"_5":17486,"_23867":103126,"_2386":103174},[],"Certificado final y `device.crt`",{"_2859":60157,"_25205":60136,"_17596":103176,"_5":17486,"_23867":103126,"_2386":103177},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2859":60158,"_25205":60136,"_17596":103179,"_5":17486,"_23867":103126,"_2386":103180},[],"Clave privada `device.key`",{"_2859":60159,"_25205":60136,"_17596":103182,"_5":17486,"_23867":103126,"_2386":103183},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2859":60160,"_25205":60136,"_17596":103185,"_5":17486,"_23867":103126,"_2386":103186},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2859":60161,"_25205":60136,"_17596":103188,"_5":17486,"_23867":103129,"_2386":103189},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2859":60162,"_25205":60136,"_17596":103191,"_5":17486,"_23867":103129,"_2386":103192},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2859":60163,"_25205":60136,"_17596":103194,"_5":17486,"_23867":103129,"_2386":103195},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2859":60164,"_25205":60164,"_5":12316,"_2386":103197,"_25540":103198,"_17596":103200,"_23867":60164},"Resolución de problemas PKI",[40894,97341,45925,103199],"Resolución de problemas",[],{"_2859":60165,"_25205":60164,"_17596":103202,"_5":17486,"_23867":60164,"_2386":103203},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2859":60166,"_25205":60164,"_5":25537,"_17596":103205,"_23867":103206,"_2386":103207},[],"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2859":60167,"_25205":60164,"_5":25537,"_17596":103209,"_23867":103210,"_2386":103211},[],"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2859":60168,"_25205":60164,"_5":25537,"_17596":103213,"_23867":103214,"_2386":103215},[],"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2859":60169,"_25205":60164,"_17596":103217,"_5":17486,"_23867":60164,"_2386":103218},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2859":60170,"_25205":60164,"_17596":103220,"_5":17486,"_23867":60164,"_2386":103221},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2859":60171,"_25205":60164,"_17596":103223,"_5":17486,"_23867":103206,"_2386":100552},[],{"_2859":60172,"_25205":60164,"_17596":103225,"_5":17486,"_23867":103206,"_2386":99472},[],{"_2859":60173,"_25205":60164,"_17596":103227,"_5":17486,"_23867":103206,"_2386":96066},[],{"_2859":60174,"_25205":60164,"_17596":103229,"_5":17486,"_23867":103206,"_2386":48260},[],{"_2859":60175,"_25205":60164,"_17596":103231,"_5":17486,"_23867":103206,"_2386":103232},[],"Existe, está activa y sus fechas son utilizables.",{"_2859":60176,"_25205":60164,"_17596":103234,"_5":17486,"_23867":103206,"_2386":103235},[],"Autoridades.",{"_2859":60177,"_25205":60164,"_17596":103237,"_5":17486,"_23867":103206,"_2386":103238},[],"Clave",{"_2859":60178,"_25205":60164,"_17596":103240,"_5":17486,"_23867":103206,"_2386":103241},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2859":60179,"_25205":60164,"_17596":103243,"_5":17486,"_23867":103206,"_2386":103244},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2859":60180,"_25205":60164,"_17596":103246,"_5":17486,"_23867":103206,"_2386":48278},[],{"_2859":60181,"_25205":60164,"_17596":103248,"_5":17486,"_23867":103206,"_2386":103249},[],"PEM correcto y firma verificable.",{"_2859":60182,"_25205":60164,"_17596":103251,"_5":17486,"_23867":103206,"_2386":48284},[],{"_2859":60183,"_25205":60164,"_17596":103253,"_5":17486,"_23867":103206,"_2386":103254},[],"Perfil",{"_2859":60184,"_25205":60164,"_17596":103256,"_5":17486,"_23867":103206,"_2386":103257},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2859":60185,"_25205":60164,"_17596":103259,"_5":17486,"_23867":103206,"_2386":103260},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2859":60186,"_25205":60164,"_17596":103262,"_5":17486,"_23867":103206,"_2386":100704},[],{"_2859":60187,"_25205":60164,"_17596":103264,"_5":17486,"_23867":103206,"_2386":103265},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2859":60188,"_25205":60164,"_17596":103267,"_5":17486,"_23867":103206,"_2386":103268},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2859":60189,"_25205":60164,"_17596":103270,"_5":17486,"_23867":103206,"_2386":103271},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2859":60190,"_25205":60164,"_17596":103273,"_5":17486,"_23867":103206,"_2386":103274},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2859":60191,"_25205":60164,"_17596":103276,"_5":17486,"_23867":103210,"_2386":103277},[],"Revisa cada frontera por separado:",{"_2859":60192,"_25205":60164,"_17596":103279,"_5":17486,"_23867":103210,"_2386":103280},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2859":60193,"_25205":60164,"_17596":103282,"_5":17486,"_23867":103210,"_2386":103283},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2859":60194,"_25205":60164,"_17596":103285,"_5":17486,"_23867":103210,"_2386":103286},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2859":60195,"_25205":60164,"_17596":103288,"_5":17486,"_23867":103210,"_2386":103289},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2859":60196,"_25205":60164,"_17596":103291,"_5":17486,"_23867":103210,"_2386":103292},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2859":60197,"_25205":60164,"_17596":103294,"_5":17486,"_23867":103210,"_2386":103295},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2859":60198,"_25205":60164,"_17596":103297,"_5":17486,"_23867":103214,"_2386":103298},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2859":60199,"_25205":60164,"_17596":103300,"_5":17486,"_23867":103214,"_2386":103301},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48338":103303,"_48340":103304,"_48342":103305,"_48344":103306,"_15287":2408,"_57827":2408},"spanish",[2386,25205,5,23867],{"_2386":21016,"_25205":21016,"_5":21016,"_23867":21016},{"_2386":103307,"_25205":105676,"_5":108045,"_23867":110414},{"_3830":103308,"_48348":103309,"_5":21016},{"_12061":5058,"_12404":4004,"_12411":5344,"_24413":3939,"_23980":3369,"_16704":6141,"_12082":9204,"_12089":2914,"_24375":4933,"_24725":4512,"_24746":3103,"_24388":6164,"_29002":9209,"_24757":5652,"_29007":5149,"_29010":24881,"_29013":4112,"_29016":5738,"_29019":3232,"_25058":2709,"_29024":14403,"_29026":8499,"_25106":3799,"_25048":3802,"_29030":13160,"_25074":12535,"_29034":4009,"_24775":2465,"_25053":4156,"_25124":2772,"_29039":4921,"_29041":6254,"_29043":6288,"_29045":9208,"_29047":2700,"_29049":7551,"_29051":5707,"_29053":17986,"_29055":9496,"_24426":3834,"_29058":3907,"_29060":3916,"_24420":258