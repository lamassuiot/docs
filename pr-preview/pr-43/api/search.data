68":17,"_28512":15,"_5":28852,"_19817":46455,"_25978":46456,"_2758":46457},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3268":18,"_28512":15,"_5":28852,"_19817":46459,"_25978":46460,"_2758":46461},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3268":19,"_28512":15,"_5":28852,"_19817":46463,"_25978":46464,"_2758":46465},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3268":20,"_28512":15,"_5":28852,"_19817":46467,"_25978":46468,"_2758":46469},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3268":21,"_28512":15,"_5":28852,"_19817":46471,"_25978":46472,"_2758":46473},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3268":22,"_28512":15,"_5":28852,"_19817":46475,"_25978":46476,"_2758":46477},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3268":23,"_28512":15,"_5":28852,"_19817":46479,"_25978":46480,"_2758":46481},[],"/docs/pr-preview/pr-43/deployment/aws-marketplace#next-step","Next step",{"_3268":24,"_28512":15,"_19817":46483,"_5":13545,"_25978":15,"_2758":46484},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3268":25,"_28512":15,"_19817":46486,"_5":13545,"_25978":46456,"_2758":46487},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3268":26,"_28512":15,"_19817":46489,"_5":13545,"_25978":46456,"_2758":46490},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3268":27,"_28512":15,"_19817":46492,"_5":13545,"_25978":46456,"_2758":46493},[],"A security group allowing the necessary endpoints.",{"_3268":28,"_28512":15,"_19817":46495,"_5":13545,"_25978":46460,"_2758":46496},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3268":29,"_28512":15,"_19817":46498,"_5":13545,"_25978":46460,"_2758":46499},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3268":30,"_28512":15,"_19817":46501,"_5":13545,"_25978":46460,"_2758":46502},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3268":31,"_28512":15,"_19817":46504,"_5":13545,"_25978":46464,"_2758":46505},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3268":32,"_28512":15,"_19817":46507,"_5":13545,"_25978":46468,"_2758":46508},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3268":33,"_28512":15,"_19817":46510,"_5":13545,"_25978":46472,"_2758":46511},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3268":34,"_28512":15,"_19817":46513,"_5":13545,"_25978":46476,"_2758":46514},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3268":35,"_28512":15,"_19817":46516,"_5":13545,"_25978":46480,"_2758":46517},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3268":36,"_28512":36,"_5":13876,"_2758":46519,"_28855":46520,"_19817":46521,"_25978":36},"Deploy Lamassu",[46447,46448],[],{"_3268":37,"_28512":36,"_19817":46523,"_5":13545,"_25978":36,"_2758":46524},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3268":38,"_28512":36,"_5":28852,"_19817":46526,"_25978":46527,"_2758":46528},[],"/docs/pr-preview/pr-43/deployment/overview#choose-a-model","Choose a model",{"_3268":39,"_28512":36,"_5":28852,"_19817":46530,"_25978":46531,"_2758":46532},[],"/docs/pr-preview/pr-43/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3268":40,"_28512":36,"_5":28852,"_19817":46534,"_25978":46535,"_2758":46536},[],"/docs/pr-preview/pr-43/deployment/overview#after-deployment","After deployment",{"_3268":41,"_28512":36,"_19817":46538,"_5":13545,"_25978":36,"_2758":46539},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3268":42,"_28512":36,"_19817":46541,"_5":13545,"_25978":46527,"_2758":46542},[],"Model",{"_3268":43,"_28512":36,"_19817":46544,"_5":13545,"_25978":46527,"_2758":46545},[],"Recommended for",{"_3268":44,"_28512":36,"_19817":46547,"_5":13545,"_25978":46527,"_2758":46548},[],"Who operates the infrastructure",{"_3268":45,"_28512":36,"_19817":46550,"_5":13545,"_25978":46527,"_2758":46551},[],"Starting point",{"_3268":46,"_28512":36,"_19817":46553,"_5":13545,"_25978":46527,"_2758":46554},[],"Kubernetes self-managed",{"_3268":47,"_28512":36,"_19817":46556,"_5":13545,"_25978":46527,"_2758":46557},[],"Production, regulated environments and custom deployments",{"_3268":48,"_28512":36,"_19817":46559,"_5":13545,"_25978":46527,"_2758":46560},[],"Your team",{"_3268":49,"_28512":36,"_19817":46562,"_5":13545,"_25978":46527,"_2758":46563},[],"Helm or Fastlane",{"_3268":50,"_28512":36,"_19817":46565,"_5":13545,"_25978":46527,"_2758":46566},[],"AWS Marketplace",{"_3268":51,"_28512":36,"_19817":46568,"_5":13545,"_25978":46527,"_2758":46569},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3268":52,"_28512":36,"_19817":46571,"_5":13545,"_25978":46527,"_2758":46560},[],{"_3268":53,"_28512":36,"_19817":46573,"_5":13545,"_25978":46527,"_2758":46574},[],"Preconfigured image on EC2",{"_3268":54,"_28512":36,"_19817":46576,"_5":13545,"_25978":46527,"_2758":46577},[],"SaaS",{"_3268":55,"_28512":36,"_19817":46579,"_5":13545,"_25978":46527,"_2758":46580},[],"Teams that want to use the platform without operating it",{"_3268":56,"_28512":36,"_19817":46582,"_5":13545,"_25978":46527,"_2758":46583},[],"Lamassu",{"_3268":57,"_28512":36,"_19817":46585,"_5":13545,"_25978":46527,"_2758":46586},[],"Managed subscription",{"_3268":58,"_28512":36,"_19817":46588,"_5":13545,"_25978":46527,"_2758":46589},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3268":59,"_28512":36,"_19817":46591,"_5":13545,"_25978":46527,"_2758":46592},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3268":60,"_28512":36,"_19817":46594,"_5":13545,"_25978":46527,"_2758":46595},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3268":61,"_28512":36,"_19817":46597,"_5":13545,"_25978":46531,"_2758":46598},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3268":62,"_28512":36,"_19817":46600,"_5":13545,"_25978":46535,"_2758":46601},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3268":63,"_28512":63,"_5":13876,"_2758":46603,"_28855":46604,"_19817":46605,"_25978":63},"Use Lamassu as SaaS",[46447,46448,46449],[],{"_3268":64,"_28512":63,"_19817":46607,"_5":13545,"_25978":63,"_2758":46608},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3268":65,"_28512":63,"_5":28852,"_19817":46610,"_25978":46611,"_2758":46612},[],"/docs/pr-preview/pr-43/deployment/saas#what-the-service-manages","What the service manages",{"_3268":66,"_28512":63,"_5":28852,"_19817":46614,"_25978":46615,"_2758":46616},[],"/docs/pr-preview/pr-43/deployment/saas#plans","Plans",{"_3268":67,"_28512":63,"_5":28852,"_19817":46618,"_25978":46619,"_2758":46620},[],"/docs/pr-preview/pr-43/deployment/saas#request-access","Request access",{"_3268":68,"_28512":63,"_19817":46622,"_5":13545,"_25978":63,"_2758":46623},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3268":69,"_28512":63,"_19817":46625,"_5":13545,"_25978":46611,"_2758":46626},[],"Platform availability and maintenance.",{"_3268":70,"_28512":63,"_19817":46628,"_5":13545,"_25978":46611,"_2758":46629},[],"Automatic backups.",{"_3268":71,"_28512":63,"_19817":46631,"_5":13545,"_25978":46611,"_2758":46632},[],"Version upgrades.",{"_3268":72,"_28512":63,"_19817":46634,"_5":13545,"_25978":46611,"_2758":46635},[],"Technical support and SLA according to your plan.",{"_3268":73,"_28512":63,"_19817":46637,"_5":13545,"_25978":46615,"_2758":46638},[],"Plan",{"_3268":74,"_28512":63,"_19817":46640,"_5":13545,"_25978":46615,"_2758":46641},[],"Devices",{"_3268":75,"_28512":63,"_19817":46643,"_5":13545,"_25978":46615,"_2758":46644},[],"Support",{"_3268":76,"_28512":63,"_19817":46646,"_5":13545,"_25978":46615,"_2758":46647},[],"SLA",{"_3268":77,"_28512":63,"_19817":46649,"_5":13545,"_25978":46615,"_2758":46650},[],"Starter",{"_3268":78,"_28512":63,"_19817":46652,"_5":13545,"_25978":46615,"_2758":46653},[],"Up to 1,000",{"_3268":79,"_28512":63,"_19817":46655,"_5":13545,"_25978":46615,"_2758":46656},[],"Email",{"_3268":80,"_28512":63,"_19817":46658,"_5":13545,"_25978":46615,"_2758":46659},[],"99.5 %",{"_3268":81,"_28512":63,"_19817":46661,"_5":13545,"_25978":46615,"_2758":46662},[],"Professional",{"_3268":82,"_28512":63,"_19817":46664,"_5":13545,"_25978":46615,"_2758":46665},[],"Up to 10,000",{"_3268":83,"_28512":63,"_19817":46667,"_5":13545,"_25978":46615,"_2758":46668},[],"Email and chat",{"_3268":84,"_28512":63,"_19817":46670,"_5":13545,"_25978":46615,"_2758":46671},[],"99.9 %",{"_3268":85,"_28512":63,"_19817":46673,"_5":13545,"_25978":46615,"_2758":46674},[],"Enterprise",{"_3268":86,"_28512":63,"_19817":46676,"_5":13545,"_25978":46615,"_2758":46677},[],"Unlimited",{"_3268":87,"_28512":63,"_19817":46679,"_5":13545,"_25978":46615,"_2758":46680},[],"Dedicated",{"_3268":88,"_28512":63,"_19817":46682,"_5":13545,"_25978":46615,"_2758":46683},[],"99.99 %",{"_3268":89,"_28512":63,"_19817":46685,"_5":13545,"_25978":46619,"_2758":46686},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3268":90,"_28512":63,"_19817":46688,"_5":13545,"_25978":46619,"_2758":46689},[],"When you receive your instance's credentials, continue with Get started.",{"_3268":91,"_28512":91,"_5":13876,"_2758":46691,"_28855":46692,"_19817":46693,"_25978":91},"Fastlane",[46447,46448,46554],[],{"_3268":92,"_28512":91,"_19817":46695,"_5":13545,"_25978":91,"_2758":46696},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3268":93,"_28512":91,"_5":28852,"_19817":46698,"_25978":46699,"_2758":46700},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3268":94,"_28512":91,"_5":28852,"_19817":46702,"_25978":46703,"_2758":46704},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3268":95,"_28512":91,"_5":28852,"_19817":46706,"_25978":46707,"_2758":46457},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#before-you-begin",{"_3268":96,"_28512":91,"_5":28852,"_19817":46709,"_25978":46710,"_2758":46711},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3268":97,"_28512":91,"_5":28852,"_19817":46713,"_25978":46714,"_2758":46715},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3268":98,"_28512":91,"_5":28852,"_19817":46717,"_25978":46718,"_2758":46719},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3268":99,"_28512":91,"_5":28852,"_19817":46721,"_25978":46722,"_2758":46723},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3268":100,"_28512":91,"_5":28852,"_19817":46725,"_25978":46726,"_2758":46727},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3268":101,"_28512":91,"_5":28852,"_19817":46729,"_25978":46730,"_2758":46731},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3268":102,"_28512":91,"_5":28852,"_19817":46733,"_25978":46734,"_2758":46735},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3268":103,"_28512":91,"_5":28852,"_19817":46737,"_25978":46738,"_2758":46739},[],"/docs/pr-preview/pr-43/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3268":104,"_28512":91,"_19817":46741,"_5":13545,"_25978":46699,"_2758":46742},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3268":105,"_28512":91,"_19817":46744,"_5":13545,"_25978":46699,"_2758":46745},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3268":106,"_28512":91,"_19817":46747,"_5":13545,"_25978":46703,"_2758":46748},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3268":107,"_28512":91,"_19817":46750,"_5":13545,"_25978":46703,"_2758":46751},[],"Fastlane installs or configures",{"_3268":108,"_28512":91,"_19817":46753,"_5":13545,"_25978":46703,"_2758":46754},[],"You still provide",{"_3268":109,"_28512":91,"_19817":46756,"_5":13545,"_25978":46703,"_2758":46757},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3268":110,"_28512":91,"_19817":46759,"_5":13545,"_25978":46703,"_2758":46760},[],"The Kubernetes cluster, nodes and persistent storage",{"_3268":111,"_28512":91,"_19817":46762,"_5":13545,"_25978":46703,"_2758":46763},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3268":112,"_28512":91,"_19817":46765,"_5":13545,"_25978":46703,"_2758":46766},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3268":113,"_28512":91,"_19817":46768,"_5":13545,"_25978":46703,"_2758":46769},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3268":114,"_28512":91,"_19817":46771,"_5":13545,"_25978":46703,"_2758":46772},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3268":115,"_28512":91,"_19817":46774,"_5":13545,"_25978":46703,"_2758":46775},[],"Optional observability and lab HSM components",{"_3268":116,"_28512":91,"_19817":46777,"_5":13545,"_25978":46703,"_2758":46778},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3268":117,"_28512":91,"_19817":46780,"_5":13545,"_25978":46703,"_2758":46781},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3268":118,"_28512":91,"_19817":46783,"_5":13545,"_25978":46707,"_2758":46784},[],"You need:",{"_3268":119,"_28512":91,"_19817":46786,"_5":13545,"_25978":46707,"_2758":46787},[],"an existing Kubernetes cluster",{"_3268":120,"_28512":91,"_19817":46789,"_5":13545,"_25978":46707,"_2758":46790},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3268":121,"_28512":91,"_19817":46792,"_5":13545,"_25978":46707,"_2758":46793},[],"`yq`",{"_3268":122,"_28512":91,"_19817":46795,"_5":13545,"_25978":46707,"_2758":22414},[],{"_3268":123,"_28512":91,"_19817":46797,"_5":13545,"_25978":46707,"_2758":46798},[],"`jq` only when using `--sample-data` or `--development`",{"_3268":124,"_28512":91,"_19817":46800,"_5":13545,"_25978":46707,"_2758":46801},[],"`ssh-keygen` only when using `--with-hsm`",{"_3268":125,"_28512":91,"_19817":46803,"_5":13545,"_25978":46707,"_2758":46804},[],"free external ports 80 and 443 on a single-node K3s host",{"_3268":126,"_28512":91,"_19817":46806,"_5":13545,"_25978":46707,"_2758":46807},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3268":127,"_28512":91,"_19817":46809,"_5":13545,"_25978":46707,"_2758":46810},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3268":128,"_28512":91,"_19817":46812,"_5":13545,"_25978":46710,"_2758":46813},[],"Run the script from a clone of the Helm repository:",{"_3268":129,"_28512":91,"_19817":46815,"_5":13545,"_25978":46710,"_2758":46816},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3268":130,"_28512":91,"_19817":46818,"_5":13545,"_25978":46714,"_2758":46819},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3268":131,"_28512":91,"_19817":46821,"_5":13545,"_25978":46714,"_2758":46822},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3268":132,"_28512":91,"_19817":46824,"_5":13545,"_25978":46714,"_2758":46825},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3268":133,"_28512":91,"_19817":46827,"_5":13545,"_25978":46714,"_2758":46828},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3268":134,"_28512":91,"_19817":46830,"_5":13545,"_25978":46718,"_2758":46831},[],"Option",{"_3268":135,"_28512":91,"_19817":46833,"_5":13545,"_25978":46718,"_2758":46834},[],"Default",{"_3268":136,"_28512":91,"_19817":46836,"_5":13545,"_25978":46718,"_2758":46837},[],"Purpose",{"_3268":137,"_28512":91,"_19817":46839,"_5":13545,"_25978":46718,"_2758":46840},[],"`-h`, `--help`",{"_3268":138,"_28512":91,"_19817":46842,"_5":13545,"_25978":46718,"_2758":46843},[],"—",{"_3268":139,"_28512":91,"_19817":46845,"_5":13545,"_25978":46718,"_2758":46846},[],"Show help",{"_3268":140,"_28512":91,"_19817":46848,"_5":13545,"_25978":46718,"_2758":46849},[],"`-c`, `--context`",{"_3268":141,"_28512":91,"_19817":46851,"_5":13545,"_25978":46718,"_2758":46852},[],"current context",{"_3268":142,"_28512":91,"_19817":46854,"_5":13545,"_25978":46718,"_2758":46855},[],"Select the kubeconfig context for kubectl and Helm",{"_3268":143,"_28512":91,"_19817":46857,"_5":13545,"_25978":46718,"_2758":46858},[],"`-n`, `--non-interactive`",{"_3268":144,"_28512":91,"_19817":46860,"_5":13545,"_25978":46718,"_2758":6108},[],{"_3268":145,"_28512":91,"_19817":46862,"_5":13545,"_25978":46718,"_2758":46863},[],"Skip prompts and generate dependency credentials",{"_3268":146,"_28512":91,"_19817":46865,"_5":13545,"_25978":46718,"_2758":46866},[],"`-ns`, `--namespace`",{"_3268":147,"_28512":91,"_19817":46868,"_5":13545,"_25978":46718,"_2758":46869},[],"`lamassu-dev`",{"_3268":148,"_28512":91,"_19817":46871,"_5":13545,"_25978":46718,"_2758":46872},[],"Namespace for the installation",{"_3268":149,"_28512":91,"_19817":46874,"_5":13545,"_25978":46718,"_2758":46875},[],"`-d`, `--domain`",{"_3268":150,"_28512":91,"_19817":46877,"_5":13545,"_25978":46718,"_2758":46878},[],"`dev.lamassu.io`",{"_3268":151,"_28512":91,"_19817":46880,"_5":13545,"_25978":46718,"_2758":46881},[],"Domain used by the UI, OIDC and certificate",{"_3268":152,"_28512":91,"_19817":46883,"_5":13545,"_25978":46718,"_2758":46884},[],"`-v`, `--version`",{"_3268":153,"_28512":91,"_19817":46886,"_5":13545,"_25978":46718,"_2758":14177},[],{"_3268":154,"_28512":91,"_19817":46888,"_5":13545,"_25978":46718,"_2758":46889},[],"Lamassu chart version",{"_3268":155,"_28512":91,"_19817":46891,"_5":13545,"_25978":46718,"_2758":46892},[],"`--https-port`",{"_3268":156,"_28512":91,"_19817":46894,"_5":13545,"_25978":46718,"_2758":46895},[],"`443`",{"_3268":157,"_28512":91,"_19817":46897,"_5":13545,"_25978":46718,"_2758":46898},[],"Gateway HTTPS listener port",{"_3268":158,"_28512":91,"_19817":46900,"_5":13545,"_25978":46718,"_2758":46901},[],"`--http-port`",{"_3268":159,"_28512":91,"_19817":46903,"_5":13545,"_25978":46718,"_2758":46904},[],"`80`",{"_3268":160,"_28512":91,"_19817":46906,"_5":13545,"_25978":46718,"_2758":46907},[],"Gateway HTTP listener port",{"_3268":161,"_28512":91,"_19817":46909,"_5":13545,"_25978":46718,"_2758":46910},[],"`--tls-crt`",{"_3268":162,"_28512":91,"_19817":46912,"_5":13545,"_25978":46718,"_2758":46843},[],{"_3268":163,"_28512":91,"_19817":46914,"_5":13545,"_25978":46718,"_2758":46915},[],"PEM certificate for downstream TLS",{"_3268":164,"_28512":91,"_19817":46917,"_5":13545,"_25978":46718,"_2758":46918},[],"`--tls-key`",{"_3268":165,"_28512":91,"_19817":46920,"_5":13545,"_25978":46718,"_2758":46843},[],{"_3268":166,"_28512":91,"_19817":46922,"_5":13545,"_25978":46718,"_2758":46923},[],"PEM private key for downstream TLS",{"_3268":167,"_28512":91,"_19817":46925,"_5":13545,"_25978":46718,"_2758":46926},[],"`-l`, `--local-chart-path`",{"_3268":168,"_28512":91,"_19817":46928,"_5":13545,"_25978":46718,"_2758":46929},[],"repository chart",{"_3268":169,"_28512":91,"_19817":46931,"_5":13545,"_25978":46718,"_2758":46932},[],"Use an unpacked local Lamassu chart",{"_3268":170,"_28512":91,"_19817":46934,"_5":13545,"_25978":46718,"_2758":46935},[],"`-ip`, `--gateway-ip`",{"_3268":171,"_28512":91,"_19817":46937,"_5":13545,"_25978":46718,"_2758":8190},[],{"_3268":172,"_28512":91,"_19817":46939,"_5":13545,"_25978":46718,"_2758":46940},[],"Override the address written to `gateway.addresses`",{"_3268":173,"_28512":91,"_19817":46942,"_5":13545,"_25978":46718,"_2758":46943},[],"`--otel`",{"_3268":174,"_28512":91,"_19817":46945,"_5":13545,"_25978":46718,"_2758":6108},[],{"_3268":175,"_28512":91,"_19817":46947,"_5":13545,"_25978":46718,"_2758":46948},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3268":176,"_28512":91,"_19817":46950,"_5":13545,"_25978":46718,"_2758":46951},[],"`--development`",{"_3268":177,"_28512":91,"_19817":46953,"_5":13545,"_25978":46718,"_2758":6108},[],{"_3268":178,"_28512":91,"_19817":46955,"_5":13545,"_25978":46718,"_2758":46956},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3268":179,"_28512":91,"_19817":46958,"_5":13545,"_25978":46718,"_2758":46959},[],"`--sample-data`",{"_3268":180,"_28512":91,"_19817":46961,"_5":13545,"_25978":46718,"_2758":6108},[],{"_3268":181,"_28512":91,"_19817":46963,"_5":13545,"_25978":46718,"_2758":46964},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3268":182,"_28512":91,"_19817":46966,"_5":13545,"_25978":46718,"_2758":46967},[],"`--with-hsm`",{"_3268":183,"_28512":91,"_19817":46969,"_5":13545,"_25978":46718,"_2758":6108},[],{"_3268":184,"_28512":91,"_19817":46971,"_5":13545,"_25978":46718,"_2758":46972},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3268":185,"_28512":91,"_19817":46974,"_5":13545,"_25978":46718,"_2758":46975},[],"`--softhsm-chart-path`",{"_3268":186,"_28512":91,"_19817":46977,"_5":13545,"_25978":46718,"_2758":46978},[],"`./charts/softhsm`",{"_3268":187,"_28512":91,"_19817":46980,"_5":13545,"_25978":46718,"_2758":46981},[],"Use a different local SoftHSM chart",{"_3268":188,"_28512":91,"_19817":46983,"_5":13545,"_25978":46718,"_2758":46984},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3268":189,"_28512":91,"_19817":46986,"_5":13545,"_25978":46722,"_2758":46987},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3268":190,"_28512":91,"_19817":46989,"_5":13545,"_25978":46722,"_2758":46990},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3268":191,"_28512":91,"_19817":46992,"_5":13545,"_25978":46722,"_2758":46993},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3268":192,"_28512":91,"_19817":46995,"_5":13545,"_25978":46722,"_2758":46996},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3268":193,"_28512":91,"_19817":46998,"_5":13545,"_25978":46722,"_2758":46999},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3268":194,"_28512":91,"_19817":47001,"_5":13545,"_25978":46722,"_2758":47002},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3268":195,"_28512":91,"_19817":47004,"_5":13545,"_25978":46726,"_2758":47005},[],"Fastlane:",{"_3268":196,"_28512":91,"_19817":47007,"_5":13545,"_25978":46726,"_2758":47008},[],"validates local tools and the selected cluster",{"_3268":197,"_28512":91,"_19817":47010,"_5":13545,"_25978":46726,"_2758":47011},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3268":198,"_28512":91,"_19817":47013,"_5":13545,"_25978":46726,"_2758":47014},[],"creates the namespace",{"_3268":199,"_28512":91,"_19817":47016,"_5":13545,"_25978":46726,"_2758":47017},[],"installs PostgreSQL and creates the required databases",{"_3268":200,"_28512":91,"_19817":47019,"_5":13545,"_25978":46726,"_2758":47020},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3268":201,"_28512":91,"_19817":47022,"_5":13545,"_25978":46726,"_2758":47023},[],"installs RabbitMQ",{"_3268":202,"_28512":91,"_19817":47025,"_5":13545,"_25978":46726,"_2758":47026},[],"optionally installs observability and lab HSM components",{"_3268":203,"_28512":91,"_19817":47028,"_5":13545,"_25978":46726,"_2758":47029},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3268":204,"_28512":91,"_19817":47031,"_5":13545,"_25978":46726,"_2758":47032},[],"optionally loads sample data",{"_3268":205,"_28512":91,"_19817":47034,"_5":13545,"_25978":46726,"_2758":47035},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3268":206,"_28512":91,"_19817":47037,"_5":13545,"_25978":46730,"_2758":47038},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3268":207,"_28512":91,"_19817":47040,"_5":13545,"_25978":46730,"_2758":47041},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3268":208,"_28512":91,"_19817":47043,"_5":13545,"_25978":46734,"_2758":47044},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3268":209,"_28512":91,"_19817":47046,"_5":13545,"_25978":46734,"_2758":47047},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3268":210,"_28512":91,"_19817":47049,"_5":13545,"_25978":46734,"_2758":47050},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3268":211,"_28512":91,"_19817":47052,"_5":13545,"_25978":46738,"_2758":47053},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3268":212,"_28512":212,"_5":13876,"_2758":47055,"_28855":47056,"_19817":47057,"_25978":212},"Install with Helm",[46447,46448,46554],[],{"_3268":213,"_28512":212,"_19817":47059,"_5":13545,"_25978":212,"_2758":47060},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3268":214,"_28512":212,"_5":28852,"_19817":47062,"_25978":47063,"_2758":47064},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3268":215,"_28512":212,"_5":28852,"_19817":47066,"_25978":47067,"_2758":46457},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#before-you-begin",{"_3268":216,"_28512":212,"_5":28852,"_19817":47069,"_25978":47070,"_2758":47071},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3268":217,"_28512":212,"_5":28852,"_19817":47073,"_25978":47074,"_2758":47075},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3268":218,"_28512":212,"_5":28852,"_19817":47077,"_25978":47078,"_2758":47079},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3268":219,"_28512":212,"_5":28852,"_19817":47081,"_25978":47082,"_2758":47083},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3268":220,"_28512":212,"_5":28852,"_19817":47085,"_25978":47086,"_2758":47087},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3268":221,"_28512":212,"_5":28852,"_19817":47089,"_25978":47090,"_2758":47091},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3268":222,"_28512":212,"_5":28852,"_19817":47093,"_25978":47094,"_2758":47095},[],"/docs/pr-preview/pr-43/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3268":223,"_28512":212,"_19817":47097,"_5":13545,"_25978":47063,"_2758":47098},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3268":224,"_28512":212,"_19817":47100,"_5":13545,"_25978":47067,"_2758":47101},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3268":225,"_28512":212,"_19817":47103,"_5":13545,"_25978":47067,"_2758":47104},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3268":226,"_28512":212,"_19817":47106,"_5":13545,"_25978":47067,"_2758":47107},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3268":227,"_28512":212,"_19817":47109,"_5":13545,"_25978":47067,"_2758":47110},[],"a reachable RabbitMQ broker and credentials",{"_3268":228,"_28512":212,"_19817":47112,"_5":13545,"_25978":47067,"_2758":47113},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3268":229,"_28512":212,"_19817":47115,"_5":13545,"_25978":47067,"_2758":47116},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3268":230,"_28512":212,"_19817":47118,"_5":13545,"_25978":47067,"_2758":47119},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3268":231,"_28512":212,"_19817":47121,"_5":13545,"_25978":47067,"_2758":47122},[],"a StorageClass and an external traffic design",{"_3268":232,"_28512":212,"_19817":47124,"_5":13545,"_25978":47067,"_2758":47125},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3268":233,"_28512":212,"_19817":47127,"_5":13545,"_25978":47067,"_2758":47128},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3268":234,"_28512":212,"_19817":47130,"_5":13545,"_25978":47067,"_2758":47131},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3268":235,"_28512":212,"_19817":47133,"_5":13545,"_25978":47070,"_2758":47134},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3268":236,"_28512":212,"_19817":47136,"_5":13545,"_25978":47070,"_2758":47137},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3268":237,"_28512":212,"_19817":47139,"_5":13545,"_25978":47070,"_2758":47140},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3268":238,"_28512":212,"_19817":47142,"_5":13545,"_25978":47074,"_2758":47143},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3268":239,"_28512":212,"_19817":47145,"_5":13545,"_25978":47074,"_2758":47146},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3268":240,"_28512":212,"_19817":47148,"_5":13545,"_25978":47074,"_2758":47149},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3268":241,"_28512":212,"_19817":47151,"_5":13545,"_25978":47078,"_2758":47152},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3268":242,"_28512":212,"_19817":47154,"_5":13545,"_25978":47082,"_2758":47155},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3268":243,"_28512":212,"_19817":47157,"_5":13545,"_25978":47082,"_2758":47158},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3268":244,"_28512":212,"_19817":47160,"_5":13545,"_25978":47082,"_2758":47161},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3268":245,"_28512":212,"_19817":47163,"_5":13545,"_25978":47082,"_2758":47164},[],"See Access control for the principal and policy model.",{"_3268":246,"_28512":212,"_19817":47166,"_5":13545,"_25978":47086,"_2758":47167},[],"To install a local checkout instead:",{"_3268":247,"_28512":212,"_19817":47169,"_5":13545,"_25978":47090,"_2758":47170},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3268":248,"_28512":212,"_19817":47172,"_5":13545,"_25978":47090,"_2758":47173},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3268":249,"_28512":212,"_19817":47175,"_5":13545,"_25978":47094,"_2758":47176},[],"Before going live, review:",{"_3268":250,"_28512":212,"_19817":47178,"_5":13545,"_25978":47094,"_2758":47179},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3268":251,"_28512":212,"_19817":47181,"_5":13545,"_25978":47094,"_2758":47182},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3268":252,"_28512":212,"_19817":47184,"_5":13545,"_25978":47094,"_2758":47185},[],"shared VA storage before increasing VA replicas",{"_3268":253,"_28512":212,"_19817":47187,"_5":13545,"_25978":47094,"_2758":47188},[],"managed OIDC roles and removal of evaluation credentials",{"_3268":254,"_28512":212,"_19817":47190,"_5":13545,"_25978":47094,"_2758":47191},[],"a trusted TLS issuer or externally managed certificate",{"_3268":255,"_28512":212,"_19817":47193,"_5":13545,"_25978":47094,"_2758":47194},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3268":256,"_28512":212,"_19817":47196,"_5":13545,"_25978":47094,"_2758":47197},[],"SMTP, observability and alert delivery",{"_3268":257,"_28512":212,"_19817":47199,"_5":13545,"_25978":47094,"_2758":47200},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3268":258,"_28512":212,"_19817":47202,"_5":13545,"_25978":47094,"_2758":47203},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3268":259,"_28512":259,"_5":13876,"_2758":47205,"_28855":47206,"_19817":47207,"_25978":259},"Expose the Gateway",[46447,46448,46554],[],{"_3268":260,"_28512":259,"_19817":47209,"_5":13545,"_25978":259,"_2758":47210},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3268":261,"_28512":259,"_5":28852,"_19817":47212,"_25978":47213,"_2758":47214},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3268":262,"_28512":259,"_5":28852,"_19817":47216,"_25978":47217,"_2758":47218},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3268":263,"_28512":259,"_5":28852,"_19817":47220,"_25978":47221,"_2758":47222},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3268":264,"_28512":259,"_5":28852,"_19817":47224,"_25978":47225,"_2758":47226},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#k3s","K3s",{"_3268":265,"_28512":259,"_5":28852,"_19817":47228,"_25978":47229,"_2758":47230},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3268":266,"_28512":259,"_5":28852,"_19817":47232,"_25978":47233,"_2758":47234},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3268":267,"_28512":259,"_5":28852,"_19817":47236,"_25978":47237,"_2758":47238},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3268":268,"_28512":259,"_5":28852,"_19817":47240,"_25978":47241,"_2758":47242},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3268":269,"_28512":259,"_5":28852,"_19817":47244,"_25978":47245,"_2758":47246},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3268":270,"_28512":259,"_5":28852,"_19817":47248,"_25978":47249,"_2758":47250},[],"/docs/pr-preview/pr-43/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3268":271,"_28512":259,"_19817":47252,"_5":13545,"_25978":47213,"_2758":47253},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3268":272,"_28512":259,"_19817":47255,"_5":13545,"_25978":47213,"_2758":47256},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3268":273,"_28512":259,"_19817":47258,"_5":13545,"_25978":47217,"_2758":47259},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3268":274,"_28512":259,"_19817":47261,"_5":13545,"_25978":47217,"_2758":47262},[],"Set it only when:",{"_3268":275,"_28512":259,"_19817":47264,"_5":13545,"_25978":47217,"_2758":47265},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3268":276,"_28512":259,"_19817":47267,"_5":13545,"_25978":47217,"_2758":47268},[],"that address is allocated to this Gateway",{"_3268":277,"_28512":259,"_19817":47270,"_5":13545,"_25978":47217,"_2758":47271},[],"the surrounding network already routes traffic for it to the cluster",{"_3268":278,"_28512":259,"_19817":47273,"_5":13545,"_25978":47217,"_2758":47274},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3268":279,"_28512":259,"_19817":47276,"_5":13545,"_25978":47217,"_2758":47277},[],"Keep these two settings separate:",{"_3268":280,"_28512":259,"_19817":47279,"_5":13545,"_25978":47217,"_2758":47280},[],"`gateway.addresses` requests an address for the Gateway.",{"_3268":281,"_28512":259,"_19817":47282,"_5":13545,"_25978":47217,"_2758":47283},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3268":282,"_28512":259,"_19817":47285,"_5":13545,"_25978":47217,"_2758":47286},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3268":283,"_28512":259,"_19817":47288,"_5":13545,"_25978":47221,"_2758":47289},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3268":284,"_28512":259,"_19817":47291,"_5":13545,"_25978":47221,"_2758":47292},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3268":285,"_28512":259,"_19817":47294,"_5":13545,"_25978":47225,"_2758":47295},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3268":286,"_28512":259,"_19817":47297,"_5":13545,"_25978":47225,"_2758":47298},[],"For the recommended design:",{"_3268":287,"_28512":259,"_19817":47300,"_5":13545,"_25978":47225,"_2758":47301},[],"Use only one externally exposed Lamassu Gateway.",{"_3268":288,"_28512":259,"_19817":47303,"_5":13545,"_25978":47225,"_2758":47304},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3268":289,"_28512":259,"_19817":47306,"_5":13545,"_25978":47225,"_2758":47307},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3268":290,"_28512":259,"_19817":47309,"_5":13545,"_25978":47225,"_2758":47310},[],"Point DNS at the VM's reachable address.",{"_3268":291,"_28512":259,"_19817":47312,"_5":13545,"_25978":47225,"_2758":47313},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3268":292,"_28512":259,"_19817":47315,"_5":13545,"_25978":47229,"_2758":47316},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3268":293,"_28512":259,"_19817":47318,"_5":13545,"_25978":47233,"_2758":47319},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3268":294,"_28512":259,"_19817":47321,"_5":13545,"_25978":47233,"_2758":47322},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3268":295,"_28512":259,"_19817":47324,"_5":13545,"_25978":47237,"_2758":47325},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3268":296,"_28512":259,"_19817":47327,"_5":13545,"_25978":47237,"_2758":47328},[],"Requirement",{"_3268":297,"_28512":259,"_19817":47330,"_5":13545,"_25978":47237,"_2758":47331},[],"Recommended design",{"_3268":298,"_28512":259,"_19817":47333,"_5":13545,"_25978":47237,"_2758":47334},[],"Consequence",{"_3268":299,"_28512":259,"_19817":47336,"_5":13545,"_25978":47237,"_2758":47337},[],"Several Lamassu URLs or services",{"_3268":300,"_28512":259,"_19817":47339,"_5":13545,"_25978":47237,"_2758":47340},[],"One Gateway with multiple routes",{"_3268":301,"_28512":259,"_19817":47342,"_5":13545,"_25978":47237,"_2758":47343},[],"One IP and one proxy fleet; this is the chart default",{"_3268":302,"_28512":259,"_19817":47345,"_5":13545,"_25978":47237,"_2758":47346},[],"Independent Gateways and separate external IPs",{"_3268":303,"_28512":259,"_19817":47348,"_5":13545,"_25978":47237,"_2758":47349},[],"One VIP per Gateway",{"_3268":304,"_28512":259,"_19817":47351,"_5":13545,"_25978":47237,"_2758":47352},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3268":305,"_28512":259,"_19817":47354,"_5":13545,"_25978":47237,"_2758":47355},[],"Independent Gateways on one node and one IP",{"_3268":306,"_28512":259,"_19817":47357,"_5":13545,"_25978":47237,"_2758":47358},[],"Use different external ports",{"_3268":307,"_28512":259,"_19817":47360,"_5":13545,"_25978":47237,"_2758":47361},[],"Clients must include non-standard ports",{"_3268":308,"_28512":259,"_19817":47363,"_5":13545,"_25978":47237,"_2758":47364},[],"Separate TLS/mTLS termination behind one IP",{"_3268":309,"_28512":259,"_19817":47366,"_5":13545,"_25978":47237,"_2758":47367},[],"Front-door SNI routing to internal Gateways",{"_3268":310,"_28512":259,"_19817":47369,"_5":13545,"_25978":47237,"_2758":47370},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3268":311,"_28512":259,"_19817":47372,"_5":13545,"_25978":47237,"_2758":47373},[],"Separate Gateway resources but shared proxy infrastructure",{"_3268":312,"_28512":259,"_19817":47375,"_5":13545,"_25978":47237,"_2758":47376},[],"Envoy merged-Gateway mode",{"_3268":313,"_28512":259,"_19817":47378,"_5":13545,"_25978":47237,"_2758":47379},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3268":314,"_28512":259,"_19817":47381,"_5":13545,"_25978":47237,"_2758":47382},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3268":315,"_28512":259,"_19817":47384,"_5":13545,"_25978":47237,"_2758":47385},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3268":316,"_28512":259,"_19817":47387,"_5":13545,"_25978":47237,"_2758":47388},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3268":317,"_28512":259,"_19817":47390,"_5":13545,"_25978":47237,"_2758":47391},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3268":318,"_28512":259,"_19817":47393,"_5":13545,"_25978":47241,"_2758":47394},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3268":319,"_28512":259,"_19817":47396,"_5":13545,"_25978":47241,"_2758":47397},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3268":320,"_28512":259,"_19817":47399,"_5":13545,"_25978":47241,"_2758":47400},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3268":321,"_28512":259,"_19817":47402,"_5":13545,"_25978":47241,"_2758":47403},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3268":322,"_28512":259,"_19817":47405,"_5":13545,"_25978":47241,"_2758":47406},[],"If none of those are possible, use different external ports or change the external network design.",{"_3268":323,"_28512":259,"_19817":47408,"_5":13545,"_25978":47245,"_2758":47409},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3268":324,"_28512":259,"_19817":47411,"_5":13545,"_25978":47245,"_2758":47412},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3268":325,"_28512":259,"_19817":47414,"_5":13545,"_25978":47249,"_2758":47415},[],"Check, in order:",{"_3268":326,"_28512":259,"_19817":47417,"_5":13545,"_25978":47249,"_2758":47418},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3268":327,"_28512":259,"_19817":47420,"_5":13545,"_25978":47249,"_2758":47421},[],"Its status contains the expected address.",{"_3268":328,"_28512":259,"_19817":47423,"_5":13545,"_25978":47249,"_2758":47424},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3268":329,"_28512":259,"_19817":47426,"_5":13545,"_25978":47249,"_2758":47427},[],"Port 443 reaches that address from the client network.",{"_3268":330,"_28512":259,"_19817":47429,"_5":13545,"_25978":47249,"_2758":47430},[],"DNS resolves to the externally reachable endpoint.",{"_3268":331,"_28512":259,"_19817":47432,"_5":13545,"_25978":47249,"_2758":47433},[],"The certificate contains the DNS name or IP used by the client.",{"_3268":332,"_28512":259,"_19817":47435,"_5":13545,"_25978":47249,"_2758":47436},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3268":333,"_28512":333,"_5":13876,"_2758":46554,"_28855":47438,"_19817":47439,"_25978":333},[46447,46448,46554],[],{"_3268":334,"_28512":333,"_19817":47441,"_5":13545,"_25978":333,"_2758":47442},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3268":335,"_28512":333,"_5":28852,"_19817":47444,"_25978":47445,"_2758":47446},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3268":336,"_28512":333,"_5":28852,"_19817":47448,"_25978":47449,"_2758":47450},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3268":337,"_28512":333,"_5":28852,"_19817":47452,"_25978":47453,"_2758":47454},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3268":338,"_28512":333,"_5":28852,"_19817":47456,"_25978":47457,"_2758":47458},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3268":339,"_28512":333,"_5":28852,"_19817":47460,"_25978":47461,"_2758":47462},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3268":340,"_28512":333,"_5":28852,"_19817":47464,"_25978":47465,"_2758":47466},[],"/docs/pr-preview/pr-43/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3268":341,"_28512":333,"_19817":47468,"_5":13545,"_25978":47445,"_2758":47469},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3268":342,"_28512":333,"_19817":47471,"_5":13545,"_25978":47449,"_2758":47472},[],"Workflow",{"_3268":343,"_28512":333,"_19817":47474,"_5":13545,"_25978":47449,"_2758":47475},[],"Use it for",{"_3268":344,"_28512":333,"_19817":47477,"_5":13545,"_25978":47449,"_2758":47478},[],"What it installs",{"_3268":345,"_28512":333,"_19817":47480,"_5":13545,"_25978":47449,"_2758":47481},[],"Helm",{"_3268":346,"_28512":333,"_19817":47483,"_5":13545,"_25978":47449,"_2758":47484},[],"Production and controlled environments",{"_3268":347,"_28512":333,"_19817":47486,"_5":13545,"_25978":47449,"_2758":47487},[],"Lamassu services and Gateway API resources",{"_3268":348,"_28512":333,"_19817":47489,"_5":13545,"_25978":47449,"_2758":46691},[],{"_3268":349,"_28512":333,"_19817":47491,"_5":13545,"_25978":47449,"_2758":47492},[],"Evaluation, demos, CI and small lab clusters",{"_3268":350,"_28512":333,"_19817":47494,"_5":13545,"_25978":47449,"_2758":47495},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3268":351,"_28512":333,"_19817":47497,"_5":13545,"_25978":47453,"_2758":47498},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3268":352,"_28512":333,"_19817":47500,"_5":13545,"_25978":47453,"_2758":47501},[],"Area",{"_3268":353,"_28512":333,"_19817":47503,"_5":13545,"_25978":47453,"_2758":47504},[],"The Lamassu chart provides",{"_3268":354,"_28512":333,"_19817":47506,"_5":13545,"_25978":47453,"_2758":47507},[],"You provide",{"_3268":355,"_28512":333,"_19817":47509,"_5":13545,"_25978":47453,"_2758":47510},[],"Lamassu applications",{"_3268":356,"_28512":333,"_19817":47512,"_5":13545,"_25978":47453,"_2758":47513},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3268":357,"_28512":333,"_19817":47515,"_5":13545,"_25978":47453,"_2758":47516},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3268":358,"_28512":333,"_19817":47518,"_5":13545,"_25978":47453,"_2758":47519},[],"PostgreSQL data",{"_3268":359,"_28512":333,"_19817":47521,"_5":13545,"_25978":47453,"_2758":47522},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3268":360,"_28512":333,"_19817":47524,"_5":13545,"_25978":47453,"_2758":47525},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3268":361,"_28512":333,"_19817":47527,"_5":13545,"_25978":47453,"_2758":47528},[],"Messaging",{"_3268":362,"_28512":333,"_19817":47530,"_5":13545,"_25978":47453,"_2758":47531},[],"RabbitMQ connection configuration for the Lamassu services",{"_3268":363,"_28512":333,"_19817":47533,"_5":13545,"_25978":47453,"_2758":47534},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3268":364,"_28512":333,"_19817":47536,"_5":13545,"_25978":47453,"_2758":47537},[],"Identity",{"_3268":365,"_28512":333,"_19817":47539,"_5":13545,"_25978":47453,"_2758":47540},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3268":366,"_28512":333,"_19817":47542,"_5":13545,"_25978":47453,"_2758":47543},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3268":367,"_28512":333,"_19817":47545,"_5":13545,"_25978":47453,"_2758":47546},[],"External routing",{"_3268":368,"_28512":333,"_19817":47548,"_5":13545,"_25978":47453,"_2758":47549},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3268":369,"_28512":333,"_19817":47551,"_5":13545,"_25978":47453,"_2758":47552},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3268":370,"_28512":333,"_19817":47554,"_5":13545,"_25978":47453,"_2758":47555},[],"TLS",{"_3268":371,"_28512":333,"_19817":47557,"_5":13545,"_25978":47453,"_2758":47558},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3268":372,"_28512":333,"_19817":47560,"_5":13545,"_25978":47453,"_2758":47561},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3268":373,"_28512":333,"_19817":47563,"_5":13545,"_25978":47453,"_2758":47564},[],"Persistent application data",{"_3268":374,"_28512":333,"_19817":47566,"_5":13545,"_25978":47453,"_2758":47567},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3268":375,"_28512":333,"_19817":47569,"_5":13545,"_25978":47453,"_2758":47570},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3268":376,"_28512":333,"_19817":47572,"_5":13545,"_25978":47453,"_2758":47573},[],"Optional integrations",{"_3268":377,"_28512":333,"_19817":47575,"_5":13545,"_25978":47453,"_2758":47576},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3268":378,"_28512":333,"_19817":47578,"_5":13545,"_25978":47453,"_2758":47579},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3268":379,"_28512":333,"_19817":47581,"_5":13545,"_25978":47453,"_2758":47582},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3268":380,"_28512":333,"_19817":47584,"_5":13545,"_25978":47453,"_2758":47585},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3268":381,"_28512":333,"_19817":47587,"_5":13545,"_25978":47457,"_2758":47588},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3268":382,"_28512":333,"_19817":47590,"_5":13545,"_25978":47457,"_2758":47591},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3268":383,"_28512":333,"_19817":47593,"_5":13545,"_25978":47461,"_2758":47594},[],"Kubernetes 1.24 or newer",{"_3268":384,"_28512":333,"_19817":47596,"_5":13545,"_25978":47461,"_2758":47597},[],"Helm 3.2 or newer",{"_3268":385,"_28512":333,"_19817":47599,"_5":13545,"_25978":47461,"_2758":47600},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3268":386,"_28512":333,"_19817":47602,"_5":13545,"_25978":47461,"_2758":47603},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3268":387,"_28512":333,"_19817":47605,"_5":13545,"_25978":47461,"_2758":47606},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3268":388,"_28512":333,"_19817":47608,"_5":13545,"_25978":47461,"_2758":47609},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3268":389,"_28512":333,"_19817":47611,"_5":13545,"_25978":47461,"_2758":47612},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3268":390,"_28512":333,"_19817":47614,"_5":13545,"_25978":47465,"_2758":47615},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3268":391,"_28512":333,"_19817":47617,"_5":13545,"_25978":47465,"_2758":47618},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3268":392,"_28512":333,"_19817":47620,"_5":13545,"_25978":47465,"_2758":47621},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3268":393,"_28512":333,"_19817":47623,"_5":13545,"_25978":47465,"_2758":47624},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3268":394,"_28512":394,"_5":13876,"_2758":47626,"_28855":47627,"_19817":47629,"_25978":394},"Deployment troubleshooting",[46447,46448,47628],"Operations",[],{"_3268":395,"_28512":394,"_19817":47631,"_5":13545,"_25978":394,"_2758":47632},[],"Diagnose access, service health and infrastructure dependencies.",{"_3268":396,"_28512":394,"_5":28852,"_19817":47634,"_25978":47635,"_2758":47636},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3268":397,"_28512":394,"_5":28852,"_19817":47638,"_25978":47639,"_2758":47640},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3268":398,"_28512":394,"_5":28852,"_19817":47642,"_25978":47643,"_2758":47644},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3268":399,"_28512":394,"_5":28852,"_19817":47646,"_25978":47647,"_2758":47648},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3268":400,"_28512":394,"_5":28852,"_19817":47650,"_25978":47651,"_2758":47652},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3268":401,"_28512":394,"_5":28852,"_19817":47654,"_25978":47655,"_2758":47656},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3268":402,"_28512":394,"_5":28852,"_19817":47658,"_25978":47659,"_2758":47660},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3268":403,"_28512":394,"_5":28852,"_19817":47662,"_25978":47663,"_2758":47664},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3268":404,"_28512":394,"_5":28852,"_19817":47666,"_25978":47667,"_2758":47668},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3268":405,"_28512":394,"_5":28852,"_19817":47670,"_25978":47671,"_2758":47672},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3268":406,"_28512":394,"_5":28852,"_19817":47674,"_25978":47675,"_2758":47676},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3268":407,"_28512":394,"_5":28852,"_19817":47678,"_25978":47679,"_2758":47680},[],"/docs/pr-preview/pr-43/deployment/troubleshooting#observability","Observability",{"_3268":408,"_28512":394,"_19817":47682,"_5":13545,"_25978":394,"_2758":47683},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3268":409,"_28512":394,"_19817":47685,"_5":13545,"_25978":47639,"_2758":47686},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3268":410,"_28512":394,"_19817":47688,"_5":13545,"_25978":47643,"_2758":47689},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3268":411,"_28512":394,"_19817":47691,"_5":13545,"_25978":47647,"_2758":47692},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3268":412,"_28512":394,"_19817":47694,"_5":13545,"_25978":47651,"_2758":47695},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3268":413,"_28512":394,"_19817":47697,"_5":13545,"_25978":47655,"_2758":47698},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3268":414,"_28512":394,"_19817":47700,"_5":13545,"_25978":47659,"_2758":47701},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3268":415,"_28512":394,"_19817":47703,"_5":13545,"_25978":47659,"_2758":47704},[],"Also run the chart's connectivity test:",{"_3268":416,"_28512":394,"_19817":47706,"_5":13545,"_25978":47659,"_2758":47707},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3268":417,"_28512":394,"_19817":47709,"_5":13545,"_25978":47659,"_2758":47710},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3268":418,"_28512":394,"_19817":47712,"_5":13545,"_25978":47663,"_2758":47713},[],"If you receive a 401:",{"_3268":419,"_28512":394,"_19817":47715,"_5":13545,"_25978":47663,"_2758":47716},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3268":420,"_28512":394,"_19817":47718,"_5":13545,"_25978":47663,"_2758":47719},[],"verify issuer, audience and expiration of the token;",{"_3268":421,"_28512":394,"_19817":47721,"_5":13545,"_25978":47663,"_2758":47722},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3268":422,"_28512":394,"_19817":47724,"_5":13545,"_25978":47663,"_2758":47725},[],"check that the provider's public and internal routes point to the same realm.",{"_3268":423,"_28512":394,"_19817":47727,"_5":13545,"_25978":47663,"_2758":47728},[],"If login succeeds but the APIs return 403:",{"_3268":424,"_28512":394,"_19817":47730,"_5":13545,"_25978":47663,"_2758":47731},[],"inspect the token's real claims;",{"_3268":425,"_28512":394,"_19817":47733,"_5":13545,"_25978":47663,"_2758":47734},[],"confirm they match an active principal;",{"_3268":426,"_28512":394,"_19817":47736,"_5":13545,"_25978":47663,"_2758":47737},[],"review the policies granted to that principal;",{"_3268":427,"_28512":394,"_19817":47739,"_5":13545,"_25978":47663,"_2758":47740},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3268":428,"_28512":394,"_19817":47742,"_5":13545,"_25978":47663,"_2758":47743},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3268":429,"_28512":394,"_19817":47745,"_5":13545,"_25978":47667,"_2758":47746},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3268":430,"_28512":394,"_19817":47748,"_5":13545,"_25978":47667,"_2758":47749},[],"Locate the authz pod and Service.",{"_3268":431,"_28512":394,"_19817":47751,"_5":13545,"_25978":47667,"_2758":47752},[],"Check /health, logs and its database connection.",{"_3268":432,"_28512":394,"_19817":47754,"_5":13545,"_25978":47667,"_2758":47755},[],"Verify the DNS and port configured in externalAuthorization.",{"_3268":433,"_28512":394,"_19817":47757,"_5":13545,"_25978":47667,"_2758":47758},[],"Check the check route is /v1/ext\\_authz/check.",{"_3268":434,"_28512":394,"_19817":47760,"_5":13545,"_25978":47667,"_2758":47761},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3268":435,"_28512":394,"_19817":47763,"_5":13545,"_25978":47671,"_2758":47764},[],"Review kubectl describe pod first. Common causes are:",{"_3268":436,"_28512":394,"_19817":47766,"_5":13545,"_25978":47671,"_2758":47767},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3268":437,"_28512":394,"_19817":47769,"_5":13545,"_25978":47671,"_2758":47770},[],"unbound persistent volume;",{"_3268":438,"_28512":394,"_19817":47772,"_5":13545,"_25978":47671,"_2758":47773},[],"inaccessible image or incorrect pull policy;",{"_3268":439,"_28512":394,"_19817":47775,"_5":13545,"_25978":47671,"_2758":47776},[],"invalid cryptographic engine configuration;",{"_3268":440,"_28512":394,"_19817":47778,"_5":13545,"_25978":47671,"_2758":47779},[],"CPU or memory limits set too low;",{"_3268":441,"_28512":394,"_19817":47781,"_5":13545,"_25978":47671,"_2758":47782},[],"an incomplete prior migration.",{"_3268":442,"_28512":394,"_19817":47784,"_5":13545,"_25978":47671,"_2758":47785},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3268":443,"_28512":394,"_19817":47787,"_5":13545,"_25978":47671,"_2758":47788},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3268":444,"_28512":394,"_19817":47790,"_5":13545,"_25978":47671,"_2758":47791},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3268":445,"_28512":394,"_19817":47793,"_5":13545,"_25978":47675,"_2758":47794},[],"Domain and audit events depend on the bus publisher:",{"_3268":446,"_28512":394,"_19817":47796,"_5":13545,"_25978":47675,"_2758":47797},[],"verify it is enabled in the emitting service;",{"_3268":447,"_28512":394,"_19817":47799,"_5":13545,"_25978":47675,"_2758":47800},[],"check AMQP connectivity and credentials;",{"_3268":448,"_28512":394,"_19817":47802,"_5":13545,"_25978":47675,"_2758":47803},[],"review exchange, routing key, queues and consumers;",{"_3268":449,"_28512":394,"_19817":47805,"_5":13545,"_25978":47675,"_2758":47806},[],"inspect dead-letter queues;",{"_3268":450,"_28512":394,"_19817":47808,"_5":13545,"_25978":47675,"_2758":47809},[],"alert on orphan durable queues and backlog growth.",{"_3268":451,"_28512":394,"_19817":47811,"_5":13545,"_25978":47675,"_2758":47812},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3268":452,"_28512":394,"_19817":47814,"_5":13545,"_25978":47679,"_2758":47815},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3268":453,"_28512":394,"_19817":47817,"_5":13545,"_25978":47679,"_2758":47818},[],"Before closing an incident, record:",{"_3268":454,"_28512":394,"_19817":47820,"_5":13545,"_25978":47679,"_2758":47821},[],"the confirmed cause;",{"_3268":455,"_28512":394,"_19817":47823,"_5":13545,"_25978":47679,"_2758":47824},[],"the time scope and affected resources;",{"_3268":456,"_28512":394,"_19817":47826,"_5":13545,"_25978":47679,"_2758":47827},[],"the commands or queries used;",{"_3268":457,"_28512":394,"_19817":47829,"_5":13545,"_25978":47679,"_2758":47830},[],"the applied change and how to revert it;",{"_3268":458,"_28512":394,"_19817":47832,"_5":13545,"_25978":47679,"_2758":47833},[],"validation from a consumer;",{"_3268":459,"_28512":394,"_19817":47835,"_5":13545,"_25978":47679,"_2758":47836},[],"the preventive action and its owner.",{"_3268":460,"_28512":460,"_5":13876,"_2758":47838,"_28855":47839,"_19817":47842,"_25978":460},"Access control",[46447,47840,47841],"Platform","Administration",[],{"_3268":461,"_28512":460,"_19817":47844,"_5":13545,"_25978":460,"_2758":47845},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3268":462,"_28512":460,"_5":28852,"_19817":47847,"_25978":47848,"_2758":47849},[],"/docs/pr-preview/pr-43/platform/administration/access-control#essential-concepts","Essential concepts",{"_3268":463,"_28512":460,"_5":28852,"_19817":47851,"_25978":47852,"_2758":47853},[],"/docs/pr-preview/pr-43/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3268":464,"_28512":460,"_5":28852,"_19817":47855,"_25978":47856,"_2758":47857},[],"/docs/pr-preview/pr-43/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3268":465,"_28512":460,"_5":28852,"_19817":47859,"_25978":47860,"_2758":47861},[],"/docs/pr-preview/pr-43/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3268":466,"_28512":460,"_5":28852,"_19817":47863,"_25978":47864,"_2758":47865},[],"/docs/pr-preview/pr-43/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3268":467,"_28512":460,"_5":28852,"_19817":47867,"_25978":47868,"_2758":47869},[],"/docs/pr-preview/pr-43/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3268":468,"_28512":460,"_5":28852,"_19817":47871,"_25978":47872,"_2758":47873},[],"/docs/pr-preview/pr-43/platform/administration/access-control#oidc-principals","OIDC principals",{"_3268":469,"_28512":460,"_5":28852,"_19817":47875,"_25978":47876,"_2758":47877},[],"/docs/pr-preview/pr-43/platform/administration/access-control#x509-principals","X.509 principals",{"_3268":470,"_28512":460,"_5":28852,"_19817":47879,"_25978":47880,"_2758":47881},[],"/docs/pr-preview/pr-43/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3268":471,"_28512":460,"_5":28852,"_19817":47883,"_25978":47884,"_2758":47885},[],"/docs/pr-preview/pr-43/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3268":472,"_28512":460,"_5":28852,"_19817":47887,"_25978":47888,"_2758":47889},[],"/docs/pr-preview/pr-43/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3268":473,"_28512":460,"_5":28852,"_19817":47891,"_25978":47892,"_2758":47893},[],"/docs/pr-preview/pr-43/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3268":474,"_28512":460,"_5":28852,"_19817":47895,"_25978":47896,"_2758":47897},[],"/docs/pr-preview/pr-43/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3268":475,"_28512":460,"_5":28852,"_19817":47899,"_25978":47900,"_2758":47901},[],"/docs/pr-preview/pr-43/platform/administration/access-control#http-rules","HTTP rules",{"_3268":476,"_28512":460,"_5":28852,"_19817":47903,"_25978":47904,"_2758":47905},[],"/docs/pr-preview/pr-43/platform/administration/access-control#included-policies","Included policies",{"_3268":477,"_28512":460,"_5":28852,"_19817":47907,"_25978":47908,"_2758":47083},[],"/docs/pr-preview/pr-43/platform/administration/access-control#provision-the-first-administrator",{"_3268":478,"_28512":460,"_5":28852,"_19817":47910,"_25978":47911,"_2758":47912},[],"/docs/pr-preview/pr-43/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3268":479,"_28512":460,"_5":28852,"_19817":47914,"_25978":47915,"_2758":47916},[],"/docs/pr-preview/pr-43/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3268":480,"_28512":460,"_5":28852,"_19817":47918,"_25978":47919,"_2758":47920},[],"/docs/pr-preview/pr-43/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3268":481,"_28512":460,"_5":28852,"_19817":47922,"_25978":47923,"_2758":47924},[],"/docs/pr-preview/pr-43/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3268":482,"_28512":460,"_5":28852,"_19817":47926,"_25978":47927,"_2758":47928},[],"/docs/pr-preview/pr-43/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3268":483,"_28512":460,"_5":28852,"_19817":47930,"_25978":47931,"_2758":47932},[],"/docs/pr-preview/pr-43/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3268":484,"_28512":460,"_5":28852,"_19817":47934,"_25978":47935,"_2758":47936},[],"/docs/pr-preview/pr-43/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3268":485,"_28512":460,"_5":28852,"_19817":47938,"_25978":47939,"_2758":47940},[],"/docs/pr-preview/pr-43/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3268":486,"_28512":460,"_5":28852,"_19817":47942,"_25978":47943,"_2758":47944},[],"/docs/pr-preview/pr-43/platform/administration/access-control#operational-checklist","Operational checklist",{"_3268":487,"_28512":460,"_5":28852,"_19817":47946,"_25978":47947,"_2758":47948},[],"/docs/pr-preview/pr-43/platform/administration/access-control#diagnostics","Diagnostics",{"_3268":488,"_28512":460,"_5":28852,"_19817":47950,"_25978":47951,"_2758":47952},[],"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-401","The response is 401",{"_3268":489,"_28512":460,"_5":28852,"_19817":47954,"_25978":47955,"_2758":47956},[],"/docs/pr-preview/pr-43/platform/administration/access-control#the-response-is-403","The response is 403",{"_3268":490,"_28512":460,"_5":28852,"_19817":47958,"_25978":47959,"_2758":47960},[],"/docs/pr-preview/pr-43/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3268":491,"_28512":460,"_5":28852,"_19817":47962,"_25978":47963,"_2758":47964},[],"/docs/pr-preview/pr-43/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3268":492,"_28512":460,"_5":28852,"_19817":47966,"_25978":47967,"_2758":47968},[],"/docs/pr-preview/pr-43/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3268":493,"_28512":460,"_19817":47970,"_5":13545,"_25978":460,"_2758":47971},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3268":494,"_28512":460,"_19817":47973,"_5":13545,"_25978":460,"_2758":47974},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3268":495,"_28512":460,"_19817":47976,"_5":13545,"_25978":460,"_2758":47977},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3268":496,"_28512":460,"_19817":47979,"_5":13545,"_25978":47848,"_2758":47980},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3268":497,"_28512":460,"_19817":47982,"_5":13545,"_25978":47848,"_2758":47983},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3268":498,"_28512":460,"_19817":47985,"_5":13545,"_25978":47848,"_2758":47986},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3268":499,"_28512":460,"_19817":47988,"_5":13545,"_25978":47848,"_2758":47989},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3268":500,"_28512":460,"_19817":47991,"_5":13545,"_25978":47848,"_2758":47992},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3268":501,"_28512":460,"_19817":47994,"_5":13545,"_25978":47848,"_2758":47995},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3268":502,"_28512":460,"_19817":47997,"_5":13545,"_25978":47852,"_2758":47998},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3268":503,"_28512":460,"_19817":48000,"_5":13545,"_25978":47852,"_2758":48001},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3268":504,"_28512":460,"_19817":48003,"_5":13545,"_25978":47856,"_2758":48004},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3268":505,"_28512":460,"_19817":48006,"_5":13545,"_25978":47856,"_2758":48007},[],"The decision is made **before forwarding the request to the service**:",{"_3268":506,"_28512":460,"_19817":48009,"_5":13545,"_25978":47856,"_2758":48010},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3268":507,"_28512":460,"_19817":48012,"_5":13545,"_25978":47856,"_2758":48013},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3268":508,"_28512":460,"_19817":48015,"_5":13545,"_25978":47856,"_2758":48016},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3268":509,"_28512":460,"_19817":48018,"_5":13545,"_25978":47856,"_2758":48019},[],"It separately loads the policies granted to each principal.",{"_3268":510,"_28512":460,"_19817":48021,"_5":13545,"_25978":47856,"_2758":48022},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3268":511,"_28512":460,"_19817":48024,"_5":13545,"_25978":47856,"_2758":48025},[],"`authz` looks for an HTTP rule granting that action.",{"_3268":512,"_28512":460,"_19817":48027,"_5":13545,"_25978":47856,"_2758":48028},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3268":513,"_28512":460,"_19817":48030,"_5":13545,"_25978":47856,"_2758":48031},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3268":514,"_28512":460,"_19817":48033,"_5":13545,"_25978":47856,"_2758":48034},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3268":515,"_28512":460,"_19817":48036,"_5":13545,"_25978":47856,"_2758":48037},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3268":516,"_28512":460,"_19817":48039,"_5":13545,"_25978":47860,"_2758":48040},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3268":517,"_28512":460,"_19817":48042,"_5":13545,"_25978":47860,"_2758":48043},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3268":518,"_28512":460,"_19817":48045,"_5":13545,"_25978":47860,"_2758":48046},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3268":519,"_28512":460,"_19817":48048,"_5":13545,"_25978":47860,"_2758":48049},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3268":520,"_28512":460,"_19817":48051,"_5":13545,"_25978":47860,"_2758":48052},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3268":521,"_28512":460,"_19817":48054,"_5":13545,"_25978":47860,"_2758":48055},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3268":522,"_28512":460,"_19817":48057,"_5":13545,"_25978":47860,"_2758":48058},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3268":523,"_28512":460,"_19817":48060,"_5":13545,"_25978":47860,"_2758":48061},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3268":524,"_28512":460,"_19817":48063,"_5":13545,"_25978":47864,"_2758":48064},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3268":525,"_28512":460,"_19817":48066,"_5":13545,"_25978":47864,"_2758":48067},[],"The decision is made with the domain operation context:",{"_3268":526,"_28512":460,"_19817":48069,"_5":13545,"_25978":47864,"_2758":48070},[],"The middleware extracts the credential and resolves the matching principals.",{"_3268":527,"_28512":460,"_19817":48072,"_5":13545,"_25978":47864,"_2758":48073},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3268":528,"_28512":460,"_19817":48075,"_5":13545,"_25978":47864,"_2758":48076},[],"`authz` gathers the entity rules of the granted policies.",{"_3268":529,"_28512":460,"_19817":48078,"_5":13545,"_25978":47864,"_2758":48079},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3268":530,"_28512":460,"_19817":48081,"_5":13545,"_25978":47864,"_2758":48082},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3268":531,"_28512":460,"_19817":48084,"_5":13545,"_25978":47864,"_2758":48085},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3268":532,"_28512":460,"_19817":48087,"_5":13545,"_25978":47864,"_2758":48088},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3268":533,"_28512":460,"_19817":48090,"_5":13545,"_25978":47864,"_2758":48091},[],"Actions fall into two groups:",{"_3268":534,"_28512":460,"_19817":48093,"_5":13545,"_25978":47864,"_2758":48094},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3268":535,"_28512":460,"_19817":48096,"_5":13545,"_25978":47864,"_2758":48097},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3268":536,"_28512":460,"_19817":48099,"_5":13545,"_25978":47864,"_2758":48100},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3268":537,"_28512":460,"_19817":48102,"_5":13545,"_25978":47868,"_2758":48103},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3268":538,"_28512":460,"_19817":48105,"_5":13545,"_25978":47868,"_2758":48106},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3268":539,"_28512":460,"_19817":48108,"_5":13545,"_25978":47868,"_2758":48109},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3268":540,"_28512":460,"_19817":48111,"_5":13545,"_25978":47872,"_2758":48112},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3268":541,"_28512":460,"_19817":48114,"_5":13545,"_25978":47872,"_2758":48115},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3268":542,"_28512":460,"_19817":48117,"_5":13545,"_25978":47872,"_2758":48118},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3268":543,"_28512":460,"_19817":48120,"_5":13545,"_25978":47872,"_2758":48121},[],"The implemented operators are:",{"_3268":544,"_28512":460,"_19817":48123,"_5":13545,"_25978":47872,"_2758":48124},[],"`equals`, for exact equality;",{"_3268":545,"_28512":460,"_19817":48126,"_5":13545,"_25978":47872,"_2758":48127},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3268":546,"_28512":460,"_19817":48129,"_5":13545,"_25978":47872,"_2758":48130},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3268":547,"_28512":460,"_19817":48132,"_5":13545,"_25978":47872,"_2758":48133},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3268":548,"_28512":460,"_19817":48135,"_5":13545,"_25978":47876,"_2758":48136},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3268":549,"_28512":460,"_19817":48138,"_5":13545,"_25978":47876,"_2758":48139},[],"The available modes are:",{"_3268":550,"_28512":460,"_19817":48141,"_5":13545,"_25978":47876,"_2758":48142},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3268":551,"_28512":460,"_19817":48144,"_5":13545,"_25978":47876,"_2758":48145},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3268":552,"_28512":460,"_19817":48147,"_5":13545,"_25978":47876,"_2758":48148},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3268":553,"_28512":460,"_19817":48150,"_5":13545,"_25978":47876,"_2758":48151},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3268":554,"_28512":460,"_19817":48153,"_5":13545,"_25978":47876,"_2758":48154},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3268":555,"_28512":460,"_19817":48156,"_5":13545,"_25978":47876,"_2758":48157},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3268":556,"_28512":460,"_19817":48159,"_5":13545,"_25978":47880,"_2758":48160},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3268":557,"_28512":460,"_19817":48162,"_5":13545,"_25978":47880,"_2758":48163},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3268":558,"_28512":460,"_19817":48165,"_5":13545,"_25978":47880,"_2758":48166},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3268":559,"_28512":460,"_19817":48168,"_5":13545,"_25978":47880,"_2758":48169},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3268":560,"_28512":460,"_19817":48171,"_5":13545,"_25978":47888,"_2758":48172},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3268":561,"_28512":460,"_19817":48174,"_5":13545,"_25978":47888,"_2758":48175},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3268":562,"_28512":460,"_19817":48177,"_5":13545,"_25978":47892,"_2758":48178},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3268":563,"_28512":460,"_19817":48180,"_5":13545,"_25978":47892,"_2758":48181},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3268":564,"_28512":460,"_19817":48183,"_5":13545,"_25978":47896,"_2758":48184},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3268":565,"_28512":460,"_19817":48186,"_5":13545,"_25978":47896,"_2758":48187},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3268":566,"_28512":460,"_19817":48189,"_5":13545,"_25978":47896,"_2758":48190},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3268":567,"_28512":460,"_19817":48192,"_5":13545,"_25978":47900,"_2758":48193},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3268":568,"_28512":460,"_19817":48195,"_5":13545,"_25978":47900,"_2758":48196},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3268":569,"_28512":460,"_19817":48198,"_5":13545,"_25978":47900,"_2758":48199},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3268":570,"_28512":460,"_19817":48201,"_5":13545,"_25978":47900,"_2758":48202},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3268":571,"_28512":460,"_19817":48204,"_5":13545,"_25978":47900,"_2758":48205},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3268":572,"_28512":460,"_19817":48207,"_5":13545,"_25978":47900,"_2758":48208},[],"Note that:",{"_3268":573,"_28512":460,"_19817":48210,"_5":13545,"_25978":47900,"_2758":48211},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3268":574,"_28512":460,"_19817":48213,"_5":13545,"_25978":47900,"_2758":48214},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3268":575,"_28512":460,"_19817":48216,"_5":13545,"_25978":47900,"_2758":48217},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3268":576,"_28512":460,"_19817":48219,"_5":13545,"_25978":47904,"_2758":48220},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3268":577,"_28512":460,"_19817":48222,"_5":13545,"_25978":47904,"_2758":48223},[],"full and read-only access to certificates and authorities;",{"_3268":578,"_28512":460,"_19817":48225,"_5":13545,"_25978":47904,"_2758":48226},[],"full and read-only access to the KMS;",{"_3268":579,"_28512":460,"_19817":48228,"_5":13545,"_25978":47904,"_2758":48229},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3268":580,"_28512":460,"_19817":48231,"_5":13545,"_25978":47904,"_2758":48232},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3268":581,"_28512":460,"_19817":48234,"_5":13545,"_25978":47904,"_2758":48235},[],"console access;",{"_3268":582,"_28512":460,"_19817":48237,"_5":13545,"_25978":47904,"_2758":48238},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3268":583,"_28512":460,"_19817":48240,"_5":13545,"_25978":47904,"_2758":48241},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3268":584,"_28512":460,"_19817":48243,"_5":13545,"_25978":47904,"_2758":48244},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3268":585,"_28512":460,"_19817":48246,"_5":13545,"_25978":47908,"_2758":48247},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3268":586,"_28512":460,"_19817":48249,"_5":13545,"_25978":47908,"_2758":48250},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3268":587,"_28512":460,"_19817":48252,"_5":13545,"_25978":47908,"_2758":48253},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3268":588,"_28512":460,"_19817":48255,"_5":13545,"_25978":47911,"_2758":48256},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3268":589,"_28512":460,"_19817":48258,"_5":13545,"_25978":47915,"_2758":48259},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3268":590,"_28512":460,"_19817":48261,"_5":13545,"_25978":47915,"_2758":48262},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3268":591,"_28512":460,"_19817":48264,"_5":13545,"_25978":47919,"_2758":48265},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3268":592,"_28512":460,"_19817":48267,"_5":13545,"_25978":47923,"_2758":48268},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3268":593,"_28512":460,"_19817":48270,"_5":13545,"_25978":47927,"_2758":48271},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3268":594,"_28512":460,"_19817":48273,"_5":13545,"_25978":47931,"_2758":48274},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3268":595,"_28512":460,"_19817":48276,"_5":13545,"_25978":47931,"_2758":48277},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3268":596,"_28512":460,"_19817":48279,"_5":13545,"_25978":47935,"_2758":48280},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3268":597,"_28512":460,"_19817":48282,"_5":13545,"_25978":47935,"_2758":48283},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3268":598,"_28512":460,"_19817":48285,"_5":13545,"_25978":47935,"_2758":48286},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3268":599,"_28512":460,"_19817":48288,"_5":13545,"_25978":47935,"_2758":48289},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3268":600,"_28512":460,"_19817":48291,"_5":13545,"_25978":47935,"_2758":48292},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3268":601,"_28512":460,"_19817":48294,"_5":13545,"_25978":47935,"_2758":48295},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3268":602,"_28512":460,"_19817":48297,"_5":13545,"_25978":47935,"_2758":48298},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3268":603,"_28512":460,"_19817":48300,"_5":13545,"_25978":47935,"_2758":48301},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3268":604,"_28512":460,"_19817":48303,"_5":13545,"_25978":47939,"_2758":48304},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3268":605,"_28512":460,"_19817":48306,"_5":13545,"_25978":47939,"_2758":48307},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3268":606,"_28512":460,"_19817":48309,"_5":13545,"_25978":47939,"_2758":48310},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3268":607,"_28512":460,"_19817":48312,"_5":13545,"_25978":47943,"_2758":48313},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3268":608,"_28512":460,"_19817":48315,"_5":13545,"_25978":47943,"_2758":48316},[],"Use groups or stable roles for people and independent identities for automations.",{"_3268":609,"_28512":460,"_19817":48318,"_5":13545,"_25978":47943,"_2758":48319},[],"Keep at least two recovery administrators and test their access periodically.",{"_3268":610,"_28512":460,"_19817":48321,"_5":13545,"_25978":47943,"_2758":48322},[],"Review active principals, their matches and their grants after IdP changes.",{"_3268":611,"_28512":460,"_19817":48324,"_5":13545,"_25978":47943,"_2758":48325},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3268":612,"_28512":460,"_19817":48327,"_5":13545,"_25978":47943,"_2758":48328},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3268":613,"_28512":460,"_19817":48330,"_5":13545,"_25978":47943,"_2758":48331},[],"Always test one allowed and one denied operation for each role.",{"_3268":614,"_28512":460,"_19817":48333,"_5":13545,"_25978":47943,"_2758":48334},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3268":615,"_28512":460,"_19817":48336,"_5":13545,"_25978":47951,"_2758":48337},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3268":616,"_28512":460,"_19817":48339,"_5":13545,"_25978":47955,"_2758":48340},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3268":617,"_28512":460,"_19817":48342,"_5":13545,"_25978":47955,"_2758":48343},[],"that an active principal of the correct type exists;",{"_3268":618,"_28512":460,"_19817":48345,"_5":13545,"_25978":47955,"_2758":48346},[],"that the claim paths and values match the real token exactly;",{"_3268":619,"_28512":460,"_19817":48348,"_5":13545,"_25978":47955,"_2758":48349},[],"that all of the principal's conditions hold;",{"_3268":620,"_28512":460,"_19817":48351,"_5":13545,"_25978":47955,"_2758":48352},[],"that the principal has the expected policy granted;",{"_3268":621,"_28512":460,"_19817":48354,"_5":13545,"_25978":47955,"_2758":48355},[],"that the policy includes the action and the requested resource type or route;",{"_3268":622,"_28512":460,"_19817":48357,"_5":13545,"_25978":47955,"_2758":48358},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3268":623,"_28512":460,"_19817":48360,"_5":13545,"_25978":47955,"_2758":48361},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3268":624,"_28512":460,"_19817":48363,"_5":13545,"_25978":47959,"_2758":48364},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3268":625,"_28512":460,"_19817":48366,"_5":13545,"_25978":47963,"_2758":48367},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3268":626,"_28512":460,"_19817":48369,"_5":13545,"_25978":47967,"_2758":48370},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3268":627,"_28512":460,"_19817":48372,"_5":13545,"_25978":47967,"_2758":48373},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3268":628,"_28512":628,"_5":13876,"_2758":48375,"_28855":48376,"_19817":48377,"_25978":628},"Alerts and subscriptions",[46447,47840,47841],[],{"_3268":629,"_28512":628,"_19817":48379,"_5":13545,"_25978":628,"_2758":48380},[],"Send PKI events to people and external systems.",{"_3268":630,"_28512":628,"_5":28852,"_19817":48382,"_25978":48383,"_2758":48384},[],"/docs/pr-preview/pr-43/platform/administration/alerts#how-it-works","How it works",{"_3268":631,"_28512":628,"_5":28852,"_19817":48386,"_25978":48387,"_2758":48388},[],"/docs/pr-preview/pr-43/platform/administration/alerts#available-channels","Available channels",{"_3268":632,"_28512":628,"_5":28852,"_19817":48390,"_25978":48391,"_2758":48392},[],"/docs/pr-preview/pr-43/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3268":633,"_28512":628,"_5":28852,"_19817":48394,"_25978":48395,"_2758":48396},[],"/docs/pr-preview/pr-43/platform/administration/alerts#choose-the-event","Choose the event",{"_3268":634,"_28512":628,"_5":28852,"_19817":48398,"_25978":48399,"_2758":48400},[],"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3268":635,"_28512":628,"_5":28852,"_19817":48402,"_25978":48403,"_2758":48404},[],"/docs/pr-preview/pr-43/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3268":636,"_28512":628,"_5":28852,"_19817":48406,"_25978":48407,"_2758":48408},[],"/docs/pr-preview/pr-43/platform/administration/alerts#review-and-activate","Review and activate",{"_3268":637,"_28512":628,"_5":28852,"_19817":48410,"_25978":48411,"_2758":48412},[],"/docs/pr-preview/pr-43/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3268":638,"_28512":628,"_5":28852,"_19817":48414,"_25978":48415,"_2758":48416},[],"/docs/pr-preview/pr-43/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3268":639,"_28512":628,"_5":28852,"_19817":48418,"_25978":48419,"_2758":48420},[],"/docs/pr-preview/pr-43/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3268":640,"_28512":628,"_5":28852,"_19817":48422,"_25978":48423,"_2758":48424},[],"/docs/pr-preview/pr-43/platform/administration/alerts#event-families","Event families",{"_3268":641,"_28512":628,"_19817":48426,"_5":13545,"_25978":628,"_2758":48427},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3268":642,"_28512":628,"_19817":48429,"_5":13545,"_25978":48383,"_2758":48430},[],"A service publishes a domain event.",{"_3268":643,"_28512":628,"_19817":48432,"_5":13545,"_25978":48383,"_2758":48433},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3268":644,"_28512":628,"_19817":48435,"_5":13545,"_25978":48383,"_2758":48436},[],"Each subscription's filter decides whether it should be notified.",{"_3268":645,"_28512":628,"_19817":48438,"_5":13545,"_25978":48383,"_2758":48439},[],"Lamassu delivers the event to the configured channel.",{"_3268":646,"_28512":628,"_19817":48441,"_5":13545,"_25978":48383,"_2758":48442},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3268":647,"_28512":628,"_19817":48444,"_5":13545,"_25978":48387,"_2758":48445},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3268":648,"_28512":628,"_19817":48447,"_5":13545,"_25978":48387,"_2758":48448},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3268":649,"_28512":628,"_19817":48450,"_5":13545,"_25978":48387,"_2758":48451},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3268":650,"_28512":628,"_19817":48453,"_5":13545,"_25978":48387,"_2758":48454},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3268":651,"_28512":628,"_19817":48456,"_5":13545,"_25978":48387,"_2758":48457},[],"`apikey_options` requires `header` and `key`.",{"_3268":652,"_28512":628,"_19817":48459,"_5":13545,"_25978":48387,"_2758":48460},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3268":653,"_28512":628,"_19817":48462,"_5":13545,"_25978":48387,"_2758":48463},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3268":654,"_28512":628,"_19817":48465,"_5":13545,"_25978":48387,"_2758":48466},[],"The alerts API reference documents the full `http_client` schema.",{"_3268":655,"_28512":628,"_19817":48468,"_5":13545,"_25978":48395,"_2758":48469},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3268":656,"_28512":628,"_19817":48471,"_5":13545,"_25978":48399,"_2758":48472},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3268":657,"_28512":628,"_19817":48474,"_5":13545,"_25978":48403,"_2758":48475},[],"Add a filter if you don't want to receive every instance of the event.",{"_3268":658,"_28512":628,"_19817":48477,"_5":13545,"_25978":48403,"_2758":48478},[],"**None** notifies all instances of the event.",{"_3268":659,"_28512":628,"_19817":48480,"_5":13545,"_25978":48403,"_2758":48481},[],"**JSON Path** evaluates one or more specific fields.",{"_3268":660,"_28512":628,"_19817":48483,"_5":13545,"_25978":48403,"_2758":48484},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3268":661,"_28512":628,"_19817":48486,"_5":13545,"_25978":48403,"_2758":48487},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3268":662,"_28512":628,"_19817":48489,"_5":13545,"_25978":48403,"_2758":48490},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3268":663,"_28512":628,"_19817":48492,"_5":13545,"_25978":48407,"_2758":48493},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3268":664,"_28512":628,"_19817":48495,"_5":13545,"_25978":48411,"_2758":48496},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3268":665,"_28512":628,"_19817":48498,"_5":13545,"_25978":48411,"_2758":48499},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3268":666,"_28512":628,"_19817":48501,"_5":13545,"_25978":48411,"_2758":48502},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3268":667,"_28512":628,"_19817":48504,"_5":13545,"_25978":48411,"_2758":48505},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3268":668,"_28512":628,"_19817":48507,"_5":13545,"_25978":48411,"_2758":48508},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3268":669,"_28512":628,"_19817":48510,"_5":13545,"_25978":48411,"_2758":48511},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3268":670,"_28512":628,"_19817":48513,"_5":13545,"_25978":48411,"_2758":48514},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3268":671,"_28512":628,"_19817":48516,"_5":13545,"_25978":48411,"_2758":48517},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3268":672,"_28512":628,"_19817":48519,"_5":13545,"_25978":48415,"_2758":48520},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3268":673,"_28512":628,"_19817":48522,"_5":13545,"_25978":48415,"_2758":48523},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3268":674,"_28512":628,"_19817":48525,"_5":13545,"_25978":48415,"_2758":48526},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3268":675,"_28512":628,"_19817":48528,"_5":13545,"_25978":48415,"_2758":48529},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3268":676,"_28512":628,"_19817":48531,"_5":13545,"_25978":48415,"_2758":48532},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3268":677,"_28512":628,"_19817":48534,"_5":13545,"_25978":48415,"_2758":48535},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3268":678,"_28512":628,"_19817":48537,"_5":13545,"_25978":48415,"_2758":48538},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3268":679,"_28512":628,"_19817":48540,"_5":13545,"_25978":48415,"_2758":48541},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3268":680,"_28512":628,"_19817":48543,"_5":13545,"_25978":48419,"_2758":48544},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3268":681,"_28512":628,"_19817":48546,"_5":13545,"_25978":48419,"_2758":48547},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3268":682,"_28512":628,"_19817":48549,"_5":13545,"_25978":48423,"_2758":48550},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3268":683,"_28512":628,"_19817":48552,"_5":13545,"_25978":48423,"_2758":48553},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3268":684,"_28512":628,"_19817":48555,"_5":13545,"_25978":48423,"_2758":48556},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3268":685,"_28512":628,"_19817":48558,"_5":13545,"_25978":48423,"_2758":48559},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3268":686,"_28512":628,"_19817":48561,"_5":13545,"_25978":48423,"_2758":48562},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3268":687,"_28512":628,"_19817":48564,"_5":13545,"_25978":48423,"_2758":48565},[],"**Validation:** `va.role.crl.create`.",{"_3268":688,"_28512":628,"_19817":48567,"_5":13545,"_25978":48423,"_2758":48568},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3268":689,"_28512":628,"_19817":48570,"_5":13545,"_25978":48423,"_2758":48571},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3268":690,"_28512":690,"_5":13876,"_2758":48573,"_28855":48574,"_19817":48575,"_25978":690},"Audit logs",[46447,47840,47841],[],{"_3268":691,"_28512":690,"_19817":48577,"_5":13545,"_25978":690,"_2758":48578},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3268":692,"_28512":690,"_5":28852,"_19817":48580,"_25978":48581,"_2758":48582},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3268":693,"_28512":690,"_5":28852,"_19817":48584,"_25978":48585,"_2758":48586},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#coverage","Coverage",{"_3268":694,"_28512":690,"_5":28852,"_19817":48588,"_25978":48589,"_2758":48590},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3268":695,"_28512":690,"_5":28852,"_19817":48592,"_25978":48593,"_2758":48594},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3268":696,"_28512":690,"_5":28852,"_19817":48596,"_25978":48597,"_2758":48598},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3268":697,"_28512":690,"_5":28852,"_19817":48600,"_25978":48601,"_2758":48602},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3268":698,"_28512":690,"_5":28852,"_19817":48604,"_25978":48605,"_2758":48606},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3268":699,"_28512":690,"_5":28852,"_19817":48608,"_25978":48609,"_2758":48610},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3268":700,"_28512":690,"_5":28852,"_19817":48612,"_25978":48613,"_2758":48614},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3268":701,"_28512":690,"_5":28852,"_19817":48616,"_25978":48617,"_2758":48618},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3268":702,"_28512":690,"_5":28852,"_19817":48620,"_25978":48621,"_2758":48622},[],"/docs/pr-preview/pr-43/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3268":703,"_28512":690,"_19817":48624,"_5":13545,"_25978":690,"_2758":48625},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3268":704,"_28512":690,"_19817":48627,"_5":13545,"_25978":48581,"_2758":48628},[],"The audit body includes:",{"_3268":705,"_28512":690,"_19817":48630,"_5":13545,"_25978":48581,"_2758":48631},[],"input: data received by the operation;",{"_3268":706,"_28512":690,"_19817":48633,"_5":13545,"_25978":48581,"_2758":48634},[],"has\\_error: whether the service returned an error;",{"_3268":707,"_28512":690,"_19817":48636,"_5":13545,"_25978":48581,"_2758":48637},[],"output: produced result or error message;",{"_3268":708,"_28512":690,"_19817":48639,"_5":13545,"_25978":48581,"_2758":48640},[],"principals: identifiers of the principals that matched the request.",{"_3268":709,"_28512":690,"_19817":48642,"_5":13545,"_25978":48581,"_2758":48643},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3268":710,"_28512":690,"_19817":48645,"_5":13545,"_25978":48581,"_2758":48646},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3268":711,"_28512":690,"_19817":48648,"_5":13545,"_25978":48585,"_2758":48649},[],"The backend applies auditing to mutations of:",{"_3268":712,"_28512":690,"_19817":48651,"_5":13545,"_25978":48585,"_2758":48652},[],"authorities, certificates and issuance profiles;",{"_3268":713,"_28512":690,"_19817":48654,"_5":13545,"_25978":48585,"_2758":48655},[],"keys and KMS engines;",{"_3268":714,"_28512":690,"_19817":48657,"_5":13545,"_25978":48585,"_2758":48658},[],"devices and identities;",{"_3268":715,"_28512":690,"_19817":48660,"_5":13545,"_25978":48585,"_2758":48661},[],"DMSs and enrollment operations;",{"_3268":716,"_28512":690,"_19817":48663,"_5":13545,"_25978":48585,"_2758":48664},[],"validation functions and CRL;",{"_3268":717,"_28512":690,"_19817":48666,"_5":13545,"_25978":48585,"_2758":48667},[],"principals, policies and authorization grants.",{"_3268":718,"_28512":690,"_19817":48669,"_5":13545,"_25978":48585,"_2758":48670},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3268":719,"_28512":690,"_19817":48672,"_5":13545,"_25978":48589,"_2758":48673},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3268":720,"_28512":690,"_19817":48675,"_5":13545,"_25978":48589,"_2758":48676},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3268":721,"_28512":690,"_19817":48678,"_5":13545,"_25978":48589,"_2758":48679},[],"Design the consumer to:",{"_3268":722,"_28512":690,"_19817":48681,"_5":13545,"_25978":48589,"_2758":48682},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3268":723,"_28512":690,"_19817":48684,"_5":13545,"_25978":48589,"_2758":48685},[],"keep the complete CloudEvent unmodified;",{"_3268":724,"_28512":690,"_19817":48687,"_5":13545,"_25978":48589,"_2758":48688},[],"record the ingestion time and detect duplicates by ID;",{"_3268":725,"_28512":690,"_19817":48690,"_5":13545,"_25978":48589,"_2758":48691},[],"encrypt in transit and at rest;",{"_3268":726,"_28512":690,"_19817":48693,"_5":13545,"_25978":48589,"_2758":48694},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3268":727,"_28512":690,"_19817":48696,"_5":13545,"_25978":48589,"_2758":48697},[],"apply an explicit retention and legal hold policy;",{"_3268":728,"_28512":690,"_19817":48699,"_5":13545,"_25978":48589,"_2758":48700},[],"alert if it stops consuming or the pending queue grows.",{"_3268":729,"_28512":690,"_19817":48702,"_5":13545,"_25978":48593,"_2758":48703},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3268":730,"_28512":690,"_19817":48705,"_5":13545,"_25978":48593,"_2758":48706},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3268":731,"_28512":690,"_19817":48708,"_5":13545,"_25978":48601,"_2758":48709},[],"Start from the reported time and normalize every source to UTC.",{"_3268":732,"_28512":690,"_19817":48711,"_5":13545,"_25978":48605,"_2758":48712},[],"Filter by event type, service source and resource identifier.",{"_3268":733,"_28512":690,"_19817":48714,"_5":13545,"_25978":48609,"_2758":48715},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3268":734,"_28512":690,"_19817":48717,"_5":13545,"_25978":48613,"_2758":48718},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3268":735,"_28512":690,"_19817":48720,"_5":13545,"_25978":48617,"_2758":48721},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3268":736,"_28512":690,"_19817":48723,"_5":13545,"_25978":48621,"_2758":48724},[],"Generate a controlled mutation in a test environment and check that:",{"_3268":737,"_28512":690,"_19817":48726,"_5":13545,"_25978":48621,"_2758":48727},[],"a successful audit event appears;",{"_3268":738,"_28512":690,"_19817":48729,"_5":13545,"_25978":48621,"_2758":48730},[],"the principal matches the identity used;",{"_3268":739,"_28512":690,"_19817":48732,"_5":13545,"_25978":48621,"_2758":48733},[],"the consumer persists it exactly once;",{"_3268":740,"_28512":690,"_19817":48735,"_5":13545,"_25978":48621,"_2758":48736},[],"it can be retrieved by resource, actor and period;",{"_3268":741,"_28512":690,"_19817":48738,"_5":13545,"_25978":48621,"_2758":48739},[],"a consumer outage raises an alert.",{"_3268":742,"_28512":690,"_19817":48741,"_5":13545,"_25978":48621,"_2758":48742},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3268":743,"_28512":743,"_5":13876,"_2758":48744,"_28855":48745,"_19817":48746,"_25978":743},"Platform architecture",[46447,47840],[],{"_3268":744,"_28512":743,"_19817":48748,"_5":13545,"_25978":743,"_2758":48749},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3268":745,"_28512":743,"_5":28852,"_19817":48751,"_25978":48752,"_2758":48753},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#control-plane","Control plane",{"_3268":746,"_28512":743,"_5":28852,"_19817":48755,"_25978":48756,"_2758":48757},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3268":747,"_28512":743,"_5":28852,"_19817":48759,"_25978":48760,"_2758":48761},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3268":748,"_28512":743,"_5":28852,"_19817":48763,"_25978":48764,"_2758":48765},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#status-and-validation","Status and validation",{"_3268":749,"_28512":743,"_5":28852,"_19817":48767,"_25978":48768,"_2758":48769},[],"/docs/pr-preview/pr-43/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3268":750,"_28512":743,"_19817":48771,"_5":13545,"_25978":743,"_2758":48772},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3268":751,"_28512":743,"_19817":48774,"_5":13545,"_25978":743,"_2758":48775},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3268":752,"_28512":743,"_19817":48777,"_5":13545,"_25978":48752,"_2758":48778},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3268":753,"_28512":743,"_19817":48780,"_5":13545,"_25978":48756,"_2758":48781},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3268":754,"_28512":743,"_19817":48783,"_5":13545,"_25978":48760,"_2758":48784},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3268":755,"_28512":743,"_19817":48786,"_5":13545,"_25978":48764,"_2758":48787},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3268":756,"_28512":743,"_19817":48789,"_5":13545,"_25978":48768,"_2758":48790},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3268":757,"_28512":757,"_5":13876,"_2758":48792,"_28855":48793,"_19817":48794,"_25978":757},"How Lamassu works",[46447,47840],[],{"_3268":758,"_28512":757,"_19817":48796,"_5":13545,"_25978":757,"_2758":48797},[],"The mental model of trust, keys, certificates and devices.",{"_3268":759,"_28512":757,"_5":28852,"_19817":48799,"_25978":48800,"_2758":48801},[],"/docs/pr-preview/pr-43/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3268":760,"_28512":757,"_5":28852,"_19817":48803,"_25978":48804,"_2758":48805},[],"/docs/pr-preview/pr-43/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3268":761,"_28512":757,"_19817":48807,"_5":13545,"_25978":757,"_2758":48808},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3268":762,"_28512":757,"_19817":48810,"_5":13545,"_25978":48800,"_2758":48811},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3268":763,"_28512":757,"_19817":48813,"_5":13545,"_25978":48800,"_2758":48814},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3268":764,"_28512":757,"_19817":48816,"_5":13545,"_25978":48800,"_2758":48817},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3268":765,"_28512":757,"_19817":48819,"_5":13545,"_25978":48800,"_2758":48820},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3268":766,"_28512":757,"_19817":48822,"_5":13545,"_25978":48800,"_2758":48823},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3268":767,"_28512":757,"_19817":48825,"_5":13545,"_25978":48804,"_2758":48826},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3268":768,"_28512":757,"_19817":48828,"_5":13545,"_25978":48804,"_2758":48829},[],"A DMS relates that CA to an enrollment policy.",{"_3268":769,"_28512":757,"_19817":48831,"_5":13545,"_25978":48804,"_2758":48832},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3268":770,"_28512":757,"_19817":48834,"_5":13545,"_25978":48804,"_2758":48835},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3268":771,"_28512":757,"_19817":48837,"_5":13545,"_25978":48804,"_2758":48838},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3268":772,"_28512":757,"_19817":48840,"_5":13545,"_25978":48804,"_2758":48841},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3268":773,"_28512":757,"_19817":48843,"_5":13545,"_25978":48804,"_2758":48844},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3268":774,"_28512":774,"_5":13876,"_2758":48846,"_28855":48847,"_19817":48849,"_25978":774},"Devices and identities",[46447,47840,48848,48846],"IoT Fleets",[],{"_3268":775,"_28512":774,"_19817":48851,"_5":13545,"_25978":774,"_2758":48852},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3268":776,"_28512":774,"_5":28852,"_19817":48854,"_25978":48855,"_2758":48856},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#device-states","Device states",{"_3268":777,"_28512":774,"_5":28852,"_19817":48858,"_25978":48859,"_2758":48860},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3268":778,"_28512":774,"_5":28852,"_19817":48862,"_25978":48863,"_2758":48864},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3268":779,"_28512":774,"_5":28852,"_19817":48866,"_25978":48867,"_2758":48868},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3268":780,"_28512":774,"_5":28852,"_19817":48870,"_25978":48871,"_2758":48872},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3268":781,"_28512":774,"_5":28852,"_19817":48874,"_25978":48875,"_2758":48876},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3268":782,"_28512":774,"_5":28852,"_19817":48878,"_25978":48879,"_2758":48880},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3268":783,"_28512":774,"_5":28852,"_19817":48882,"_25978":48883,"_2758":48884},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3268":784,"_28512":774,"_5":28852,"_19817":48886,"_25978":48887,"_2758":48888},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3268":785,"_28512":774,"_5":28852,"_19817":48890,"_25978":48891,"_2758":48892},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3268":786,"_28512":774,"_5":28852,"_19817":48894,"_25978":48895,"_2758":48896},[],"/docs/pr-preview/pr-43/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3268":787,"_28512":774,"_19817":48898,"_5":13545,"_25978":774,"_2758":48899},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3268":788,"_28512":774,"_19817":48901,"_5":13545,"_25978":774,"_2758":48902},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3268":789,"_28512":774,"_19817":48904,"_5":13545,"_25978":48855,"_2758":48905},[],"Operational view",{"_3268":790,"_28512":774,"_19817":48907,"_5":13545,"_25978":48855,"_2758":48908},[],"Meaning",{"_3268":791,"_28512":774,"_19817":48910,"_5":13545,"_25978":48855,"_2758":48911},[],"**No Identity**",{"_3268":792,"_28512":774,"_19817":48913,"_5":13545,"_25978":48855,"_2758":48914},[],"A record exists without an associated identity.",{"_3268":793,"_28512":774,"_19817":48916,"_5":13545,"_25978":48855,"_2758":48917},[],"**Active**",{"_3268":794,"_28512":774,"_19817":48919,"_5":13545,"_25978":48855,"_2758":48920},[],"The slot is active; also check certificate dates, status and usages.",{"_3268":795,"_28512":774,"_19817":48922,"_5":13545,"_25978":48855,"_2758":48923},[],"**Renewal Pending**",{"_3268":796,"_28512":774,"_19817":48925,"_5":13545,"_25978":48855,"_2758":48926},[],"The identity is in the operational renewal window.",{"_3268":797,"_28512":774,"_19817":48928,"_5":13545,"_25978":48855,"_2758":48929},[],"**Expiring Soon**",{"_3268":798,"_28512":774,"_19817":48931,"_5":13545,"_25978":48855,"_2758":48932},[],"Expiration is approaching according to configured thresholds.",{"_3268":799,"_28512":774,"_19817":48934,"_5":13545,"_25978":48855,"_2758":48935},[],"**Expired**",{"_3268":800,"_28512":774,"_19817":48937,"_5":13545,"_25978":48855,"_2758":48938},[],"The identity has expired.",{"_3268":801,"_28512":774,"_19817":48940,"_5":13545,"_25978":48855,"_2758":48941},[],"**Revoked**",{"_3268":802,"_28512":774,"_19817":48943,"_5":13545,"_25978":48855,"_2758":48944},[],"The identity is marked revoked.",{"_3268":803,"_28512":774,"_19817":48946,"_5":13545,"_25978":48855,"_2758":48947},[],"**Decommissioned**",{"_3268":804,"_28512":774,"_19817":48949,"_5":13545,"_25978":48855,"_2758":48950},[],"The record is retired and ordinary updates do not restore operation.",{"_3268":805,"_28512":774,"_19817":48952,"_5":13545,"_25978":48855,"_2758":48953},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3268":806,"_28512":774,"_19817":48955,"_5":13545,"_25978":48859,"_2758":48956},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3268":807,"_28512":774,"_19817":48958,"_5":13545,"_25978":48859,"_2758":48959},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3268":808,"_28512":774,"_19817":48961,"_5":13545,"_25978":48859,"_2758":48962},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3268":809,"_28512":774,"_19817":48964,"_5":13545,"_25978":48859,"_2758":48965},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3268":810,"_28512":774,"_19817":48967,"_5":13545,"_25978":48863,"_2758":48968},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3268":811,"_28512":774,"_19817":48970,"_5":13545,"_25978":48867,"_2758":48971},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3268":812,"_28512":774,"_19817":48973,"_5":13545,"_25978":48871,"_2758":48974},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3268":813,"_28512":774,"_19817":48976,"_5":13545,"_25978":48875,"_2758":48977},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3268":814,"_28512":774,"_19817":48979,"_5":13545,"_25978":48879,"_2758":48980},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3268":815,"_28512":774,"_19817":48982,"_5":13545,"_25978":48879,"_2758":48983},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3268":816,"_28512":774,"_19817":48985,"_5":13545,"_25978":48883,"_2758":48986},[],"From **No Identity**, use **Assign Identity**:",{"_3268":817,"_28512":774,"_19817":48988,"_5":13545,"_25978":48883,"_2758":48989},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3268":818,"_28512":774,"_19817":48991,"_5":13545,"_25978":48883,"_2758":48992},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3268":819,"_28512":774,"_19817":48994,"_5":13545,"_25978":48883,"_2758":48995},[],"Confirm and read the serial, active version and history again.",{"_3268":820,"_28512":774,"_19817":48997,"_5":13545,"_25978":48883,"_2758":48998},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3268":821,"_28512":774,"_19817":49000,"_5":13545,"_25978":48883,"_2758":49001},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3268":822,"_28512":774,"_19817":49003,"_5":13545,"_25978":48887,"_2758":49004},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3268":823,"_28512":774,"_19817":49006,"_5":13545,"_25978":48887,"_2758":49007},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3268":824,"_28512":774,"_19817":49009,"_5":13545,"_25978":48891,"_2758":49010},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3268":825,"_28512":774,"_19817":49012,"_5":13545,"_25978":48891,"_2758":49013},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3268":826,"_28512":774,"_19817":49015,"_5":13545,"_25978":48891,"_2758":49016},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3268":827,"_28512":774,"_19817":49018,"_5":13545,"_25978":48891,"_2758":49019},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3268":828,"_28512":774,"_19817":49021,"_5":13545,"_25978":48895,"_2758":49022},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3268":829,"_28512":774,"_19817":49024,"_5":13545,"_25978":48895,"_2758":49025},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3268":830,"_28512":830,"_5":13876,"_2758":49027,"_28855":49028,"_19817":49030,"_25978":830},"Bootstrap identity and authentication",[46447,47840,48848,48846,49029],"Enrollment with PKI",[],{"_3268":831,"_28512":830,"_19817":49032,"_5":13545,"_25978":830,"_2758":49033},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3268":832,"_28512":830,"_5":28852,"_19817":49035,"_25978":49036,"_2758":49037},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3268":833,"_28512":830,"_5":28852,"_19817":49039,"_25978":49040,"_2758":49041},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3268":834,"_28512":830,"_5":28852,"_19817":49043,"_25978":49044,"_2758":49045},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3268":835,"_28512":830,"_5":28852,"_19817":49047,"_25978":49048,"_2758":49049},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3268":836,"_28512":830,"_5":28852,"_19817":49051,"_25978":49052,"_2758":49053},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3268":837,"_28512":830,"_19817":49055,"_5":13545,"_25978":830,"_2758":49056},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3268":838,"_28512":830,"_19817":49058,"_5":13545,"_25978":49036,"_2758":49059},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3268":839,"_28512":830,"_19817":49061,"_5":13545,"_25978":49036,"_2758":49062},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3268":840,"_28512":830,"_19817":49064,"_5":13545,"_25978":49040,"_2758":49065},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3268":841,"_28512":830,"_19817":49067,"_5":13545,"_25978":49040,"_2758":49068},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3268":842,"_28512":830,"_19817":49070,"_5":13545,"_25978":49040,"_2758":49071},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3268":843,"_28512":830,"_19817":49073,"_5":13545,"_25978":49044,"_2758":49074},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3268":844,"_28512":830,"_19817":49076,"_5":13545,"_25978":49044,"_2758":49077},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3268":845,"_28512":830,"_19817":49079,"_5":13545,"_25978":49048,"_2758":49080},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3268":846,"_28512":830,"_19817":49082,"_5":13545,"_25978":49048,"_2758":49083},[],"Example body:",{"_3268":847,"_28512":830,"_19817":49085,"_5":13545,"_25978":49048,"_2758":49086},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3268":848,"_28512":830,"_19817":49088,"_5":13545,"_25978":49048,"_2758":49089},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3268":849,"_28512":830,"_19817":49091,"_5":13545,"_25978":49048,"_2758":49092},[],"Continuation requires a successful HTTP response and JSON:",{"_3268":850,"_28512":830,"_19817":49094,"_5":13545,"_25978":49048,"_2758":49095},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3268":851,"_28512":830,"_19817":49097,"_5":13545,"_25978":49052,"_2758":49098},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3268":852,"_28512":830,"_19817":49100,"_5":13545,"_25978":49052,"_2758":49101},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3268":853,"_28512":853,"_5":13876,"_2758":49103,"_28855":49104,"_19817":49105,"_25978":853},"Configure and operate the DMS",[46447,47840,48848,48846,49029],[],{"_3268":854,"_28512":853,"_19817":49107,"_5":13545,"_25978":853,"_2758":49108},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3268":855,"_28512":853,"_5":28852,"_19817":49110,"_25978":49111,"_2758":46457},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3268":856,"_28512":853,"_5":28852,"_19817":49113,"_25978":49114,"_2758":49115},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3268":857,"_28512":853,"_5":28852,"_19817":49117,"_25978":49118,"_2758":49119},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3268":858,"_28512":853,"_5":28852,"_19817":49121,"_25978":49122,"_2758":49123},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3268":859,"_28512":853,"_5":28852,"_19817":49125,"_25978":49126,"_2758":49127},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3268":860,"_28512":853,"_5":28852,"_19817":49129,"_25978":49130,"_2758":49131},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3268":861,"_28512":853,"_5":28852,"_19817":49133,"_25978":49134,"_2758":49135},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3268":862,"_28512":853,"_5":28852,"_19817":49137,"_25978":49138,"_2758":49139},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3268":863,"_28512":853,"_5":28852,"_19817":49141,"_25978":49142,"_2758":49143},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3268":864,"_28512":853,"_5":28852,"_19817":49145,"_25978":49146,"_2758":49147},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3268":865,"_28512":853,"_5":28852,"_19817":49149,"_25978":49150,"_2758":49151},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3268":866,"_28512":853,"_5":28852,"_19817":49153,"_25978":49154,"_2758":49155},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3268":867,"_28512":853,"_5":28852,"_19817":49157,"_25978":49158,"_2758":49159},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3268":868,"_28512":853,"_5":28852,"_19817":49161,"_25978":49162,"_2758":49163},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3268":869,"_28512":853,"_5":28852,"_19817":49165,"_25978":49166,"_2758":49167},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3268":870,"_28512":853,"_5":28852,"_19817":49169,"_25978":49170,"_2758":49171},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3268":871,"_28512":853,"_5":28852,"_19817":49173,"_25978":49174,"_2758":49175},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3268":872,"_28512":853,"_5":28852,"_19817":49177,"_25978":49178,"_2758":49179},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3268":873,"_28512":853,"_19817":49181,"_5":13545,"_25978":853,"_2758":49182},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3268":874,"_28512":853,"_19817":49184,"_5":13545,"_25978":49111,"_2758":49185},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3268":875,"_28512":853,"_19817":49187,"_5":13545,"_25978":49111,"_2758":49188},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3268":876,"_28512":853,"_19817":49190,"_5":13545,"_25978":49118,"_2758":49191},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3268":877,"_28512":853,"_19817":49193,"_5":13545,"_25978":49122,"_2758":49194},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3268":878,"_28512":853,"_19817":49196,"_5":13545,"_25978":49126,"_2758":49197},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3268":879,"_28512":853,"_19817":49199,"_5":13545,"_25978":49130,"_2758":49200},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3268":880,"_28512":853,"_19817":49202,"_5":13545,"_25978":49134,"_2758":49203},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3268":881,"_28512":853,"_19817":49205,"_5":13545,"_25978":49142,"_2758":49206},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3268":882,"_28512":853,"_19817":49208,"_5":13545,"_25978":49142,"_2758":49209},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3268":883,"_28512":853,"_19817":49211,"_5":13545,"_25978":49146,"_2758":49212},[],"`settings.enrollment_settings` field",{"_3268":884,"_28512":853,"_19817":49214,"_5":13545,"_25978":49146,"_2758":49215},[],"Decision",{"_3268":885,"_28512":853,"_19817":49217,"_5":13545,"_25978":49146,"_2758":49218},[],"`protocol`",{"_3268":886,"_28512":853,"_19817":49220,"_5":13545,"_25978":49146,"_2758":49221},[],"`EST_RFC7030` for these operations.",{"_3268":887,"_28512":853,"_19817":49223,"_5":13545,"_25978":49146,"_2758":49224},[],"`enrollment_ca`",{"_3268":888,"_28512":853,"_19817":49226,"_5":13545,"_25978":49146,"_2758":49227},[],"ID of the signing CA.",{"_3268":889,"_28512":853,"_19817":49229,"_5":13545,"_25978":49146,"_2758":49230},[],"`verify_csr_signature`",{"_3268":890,"_28512":853,"_19817":49232,"_5":13545,"_25978":49146,"_2758":49233},[],"Keep `true` to verify CSR key possession.",{"_3268":891,"_28512":853,"_19817":49235,"_5":13545,"_25978":49146,"_2758":49236},[],"`enable_replaceable_enrollment`",{"_3268":892,"_28512":853,"_19817":49238,"_5":13545,"_25978":49146,"_2758":49239},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3268":893,"_28512":853,"_19817":49241,"_5":13545,"_25978":49146,"_2758":49242},[],"`est_rfc7030_settings.auth_mode`",{"_3268":894,"_28512":853,"_19817":49244,"_5":13545,"_25978":49146,"_2758":49245},[],"One of the four authentication modes.",{"_3268":895,"_28512":853,"_19817":49247,"_5":13545,"_25978":49146,"_2758":49248},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3268":896,"_28512":853,"_19817":49250,"_5":13545,"_25978":49150,"_2758":49251},[],"The blocks are independent:",{"_3268":897,"_28512":853,"_19817":49253,"_5":13545,"_25978":49150,"_2758":49254},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3268":898,"_28512":853,"_19817":49256,"_5":13545,"_25978":49150,"_2758":49257},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3268":899,"_28512":853,"_19817":49259,"_5":13545,"_25978":49150,"_2758":49260},[],"`auth_mode`",{"_3268":900,"_28512":853,"_19817":49262,"_5":13545,"_25978":49150,"_2758":49263},[],"Control applied in the configured operation",{"_3268":901,"_28512":853,"_19817":49265,"_5":13545,"_25978":49150,"_2758":49266},[],"`CLIENT_CERTIFICATE`",{"_3268":902,"_28512":853,"_19817":49268,"_5":13545,"_25978":49150,"_2758":49269},[],"Presented certificate validation.",{"_3268":903,"_28512":853,"_19817":49271,"_5":13545,"_25978":49150,"_2758":49272},[],"`EXTERNAL_WEBHOOK`",{"_3268":904,"_28512":853,"_19817":49274,"_5":13545,"_25978":49150,"_2758":49275},[],"Configured webhook authorization.",{"_3268":905,"_28512":853,"_19817":49277,"_5":13545,"_25978":49150,"_2758":49278},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3268":906,"_28512":853,"_19817":49280,"_5":13545,"_25978":49150,"_2758":49281},[],"Certificate validation followed by webhook approval.",{"_3268":907,"_28512":853,"_19817":49283,"_5":13545,"_25978":49150,"_2758":49284},[],"`NO_AUTH`",{"_3268":908,"_28512":853,"_19817":49286,"_5":13545,"_25978":49150,"_2758":49287},[],"No DMS requester authentication.",{"_3268":909,"_28512":853,"_19817":49289,"_5":13545,"_25978":49150,"_2758":49290},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3268":910,"_28512":853,"_19817":49292,"_5":13545,"_25978":49150,"_2758":49293},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3268":911,"_28512":853,"_19817":49295,"_5":13545,"_25978":49150,"_2758":49296},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3268":912,"_28512":853,"_19817":49298,"_5":13545,"_25978":49150,"_2758":49299},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3268":913,"_28512":853,"_19817":49301,"_5":13545,"_25978":49154,"_2758":49302},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3268":914,"_28512":853,"_19817":49304,"_5":13545,"_25978":49154,"_2758":49305},[],"`external_webhook_settings` field",{"_3268":915,"_28512":853,"_19817":49307,"_5":13545,"_25978":49154,"_2758":49215},[],{"_3268":916,"_28512":853,"_19817":49309,"_5":13545,"_25978":49154,"_2758":49310},[],"`url`",{"_3268":917,"_28512":853,"_19817":49312,"_5":13545,"_25978":49154,"_2758":49313},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3268":918,"_28512":853,"_19817":49315,"_5":13545,"_25978":49154,"_2758":49316},[],"`method`",{"_3268":919,"_28512":853,"_19817":49318,"_5":13545,"_25978":49154,"_2758":49319},[],"`POST` or `PUT`; `POST` by default.",{"_3268":920,"_28512":853,"_19817":49321,"_5":13545,"_25978":49154,"_2758":49322},[],"`name`",{"_3268":921,"_28512":853,"_19817":49324,"_5":13545,"_25978":49154,"_2758":49325},[],"Label used in service logs.",{"_3268":922,"_28512":853,"_19817":49327,"_5":13545,"_25978":49154,"_2758":49328},[],"`config.auth_mode`",{"_3268":923,"_28512":853,"_19817":49330,"_5":13545,"_25978":49154,"_2758":49331},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3268":924,"_28512":853,"_19817":49333,"_5":13545,"_25978":49154,"_2758":49334},[],"`config.log_level`",{"_3268":925,"_28512":853,"_19817":49336,"_5":13545,"_25978":49154,"_2758":49337},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3268":926,"_28512":853,"_19817":49339,"_5":13545,"_25978":49154,"_2758":49340},[],"`config.apikey_options`",{"_3268":927,"_28512":853,"_19817":49342,"_5":13545,"_25978":49154,"_2758":49343},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3268":928,"_28512":853,"_19817":49345,"_5":13545,"_25978":49154,"_2758":49346},[],"`config.jwt_options`",{"_3268":929,"_28512":853,"_19817":49348,"_5":13545,"_25978":49154,"_2758":49349},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3268":930,"_28512":853,"_19817":49351,"_5":13545,"_25978":49154,"_2758":49352},[],"`config.mtls_options`",{"_3268":931,"_28512":853,"_19817":49354,"_5":13545,"_25978":49154,"_2758":49355},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3268":932,"_28512":853,"_19817":49357,"_5":13545,"_25978":49154,"_2758":49358},[],"`config.insecure_skip_verify`",{"_3268":933,"_28512":853,"_19817":49360,"_5":13545,"_25978":49154,"_2758":49361},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3268":934,"_28512":853,"_19817":49363,"_5":13545,"_25978":49154,"_2758":49364},[],"`config.call_timeout`",{"_3268":935,"_28512":853,"_19817":49366,"_5":13545,"_25978":49154,"_2758":49367},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3268":936,"_28512":853,"_19817":49369,"_5":13545,"_25978":49154,"_2758":49370},[],"Rules for that configuration:",{"_3268":937,"_28512":853,"_19817":49372,"_5":13545,"_25978":49154,"_2758":49373},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3268":938,"_28512":853,"_19817":49375,"_5":13545,"_25978":49154,"_2758":49376},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3268":939,"_28512":853,"_19817":49378,"_5":13545,"_25978":49154,"_2758":49379},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3268":940,"_28512":853,"_19817":49381,"_5":13545,"_25978":49154,"_2758":49382},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3268":941,"_28512":853,"_19817":49384,"_5":13545,"_25978":49154,"_2758":49385},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3268":942,"_28512":853,"_19817":49387,"_5":13545,"_25978":49154,"_2758":49388},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3268":943,"_28512":853,"_19817":49390,"_5":13545,"_25978":49154,"_2758":49391},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3268":944,"_28512":853,"_19817":49393,"_5":13545,"_25978":49154,"_2758":49394},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3268":945,"_28512":853,"_19817":49396,"_5":13545,"_25978":49154,"_2758":49397},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3268":946,"_28512":853,"_19817":49399,"_5":13545,"_25978":49158,"_2758":49400},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3268":947,"_28512":853,"_19817":49402,"_5":13545,"_25978":49162,"_2758":49403},[],"`settings.reenrollment_settings` field",{"_3268":948,"_28512":853,"_19817":49405,"_5":13545,"_25978":49162,"_2758":46837},[],{"_3268":949,"_28512":853,"_19817":49407,"_5":13545,"_25978":49162,"_2758":49408},[],"`reenrollment_delta`",{"_3268":950,"_28512":853,"_19817":49410,"_5":13545,"_25978":49162,"_2758":49411},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3268":951,"_28512":853,"_19817":49413,"_5":13545,"_25978":49162,"_2758":49414},[],"`preventive_delta`",{"_3268":952,"_28512":853,"_19817":49416,"_5":13545,"_25978":49162,"_2758":49417},[],"Preventive operational monitoring threshold.",{"_3268":953,"_28512":853,"_19817":49419,"_5":13545,"_25978":49162,"_2758":49420},[],"`critical_delta`",{"_3268":954,"_28512":853,"_19817":49422,"_5":13545,"_25978":49162,"_2758":49423},[],"Critical operational monitoring threshold.",{"_3268":955,"_28512":853,"_19817":49425,"_5":13545,"_25978":49162,"_2758":49426},[],"`enable_expired_renewal`",{"_3268":956,"_28512":853,"_19817":49428,"_5":13545,"_25978":49162,"_2758":49429},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3268":957,"_28512":853,"_19817":49431,"_5":13545,"_25978":49162,"_2758":49432},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3268":958,"_28512":853,"_19817":49434,"_5":13545,"_25978":49162,"_2758":49435},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3268":959,"_28512":853,"_19817":49437,"_5":13545,"_25978":49162,"_2758":49438},[],"`revoke_on_reenrollment`",{"_3268":960,"_28512":853,"_19817":49440,"_5":13545,"_25978":49162,"_2758":49441},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3268":961,"_28512":853,"_19817":49443,"_5":13545,"_25978":49162,"_2758":49444},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3268":962,"_28512":853,"_19817":49446,"_5":13545,"_25978":49166,"_2758":49447},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3268":963,"_28512":853,"_19817":49449,"_5":13545,"_25978":49170,"_2758":46831},[],{"_3268":964,"_28512":853,"_19817":49451,"_5":13545,"_25978":49170,"_2758":49452},[],"Published material",{"_3268":965,"_28512":853,"_19817":49454,"_5":13545,"_25978":49170,"_2758":49455},[],"**Include Lamassu System CA**",{"_3268":966,"_28512":853,"_19817":49457,"_5":13545,"_25978":49170,"_2758":49458},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3268":967,"_28512":853,"_19817":49460,"_5":13545,"_25978":49170,"_2758":49461},[],"**Include Enrollment CA**",{"_3268":968,"_28512":853,"_19817":49463,"_5":13545,"_25978":49170,"_2758":49464},[],"Selected issuing CA certificate.",{"_3268":969,"_28512":853,"_19817":49466,"_5":13545,"_25978":49170,"_2758":49467},[],"**Managed CAs**",{"_3268":970,"_28512":853,"_19817":49469,"_5":13545,"_25978":49170,"_2758":49470},[],"Explicitly selected CA certificates.",{"_3268":971,"_28512":853,"_19817":49472,"_5":13545,"_25978":49170,"_2758":49473},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3268":972,"_28512":853,"_19817":49475,"_5":13545,"_25978":49174,"_2758":49476},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included.",{"_3268":973,"_28512":853,"_19817":49478,"_5":13545,"_25978":49174,"_2758":49479},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3268":974,"_28512":853,"_19817":49481,"_5":13545,"_25978":49174,"_2758":49482},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3268":975,"_28512":853,"_19817":49484,"_5":13545,"_25978":49178,"_2758":49485},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3268":976,"_28512":976,"_5":13876,"_2758":49487,"_28855":49488,"_19817":49489,"_25978":976},"Integrate the EST client",[46447,47840,48848,48846,49029],[],{"_3268":977,"_28512":976,"_19817":49491,"_5":13545,"_25978":976,"_2758":49492},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3268":978,"_28512":976,"_5":28852,"_19817":49494,"_25978":49495,"_2758":46457},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3268":979,"_28512":976,"_5":28852,"_19817":49497,"_25978":49498,"_2758":49499},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3268":980,"_28512":976,"_5":28852,"_19817":49501,"_25978":49502,"_2758":49503},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3268":981,"_28512":976,"_5":28852,"_19817":49505,"_25978":49506,"_2758":49507},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3268":982,"_28512":976,"_5":28852,"_19817":49509,"_25978":49510,"_2758":49511},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3268":983,"_28512":976,"_5":28852,"_19817":49513,"_25978":49514,"_2758":49515},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3268":984,"_28512":976,"_19817":49517,"_5":13545,"_25978":976,"_2758":49518},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3268":985,"_28512":976,"_19817":49520,"_5":13545,"_25978":49495,"_2758":49521},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3268":986,"_28512":976,"_19817":49523,"_5":13545,"_25978":49495,"_2758":49524},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3268":987,"_28512":976,"_19817":49526,"_5":13545,"_25978":49495,"_2758":49527},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3268":988,"_28512":976,"_19817":49529,"_5":13545,"_25978":49498,"_2758":49530},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3268":989,"_28512":976,"_19817":49532,"_5":13545,"_25978":49498,"_2758":49533},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3268":990,"_28512":976,"_19817":49535,"_5":13545,"_25978":49502,"_2758":49536},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3268":991,"_28512":976,"_19817":49538,"_5":13545,"_25978":49502,"_2758":49539},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3268":992,"_28512":976,"_19817":49541,"_5":13545,"_25978":49506,"_2758":49542},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3268":993,"_28512":976,"_19817":49544,"_5":13545,"_25978":49506,"_2758":49545},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3268":994,"_28512":976,"_19817":49547,"_5":13545,"_25978":49510,"_2758":49548},[],"For a root that issues directly:",{"_3268":995,"_28512":976,"_19817":49550,"_5":13545,"_25978":49510,"_2758":49551},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3268":996,"_28512":976,"_19817":49553,"_5":13545,"_25978":49510,"_2758":49554},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3268":997,"_28512":976,"_19817":49556,"_5":13545,"_25978":49514,"_2758":49557},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3268":998,"_28512":998,"_5":13876,"_2758":49559,"_28855":49560,"_19817":49561,"_25978":998},"EST reference",[46447,47840,48848,48846,49029],[],{"_3268":999,"_28512":998,"_19817":49563,"_5":13545,"_25978":998,"_2758":49564},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3268":1000,"_28512":998,"_5":28852,"_19817":49566,"_25978":49567,"_2758":49568},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3268":1001,"_28512":998,"_5":28852,"_19817":49570,"_25978":49571,"_2758":21508},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3268":1002,"_28512":998,"_5":28852,"_19817":49573,"_25978":49574,"_2758":24660},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3268":1003,"_28512":998,"_5":28852,"_19817":49576,"_25978":49577,"_2758":24667},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3268":1004,"_28512":998,"_5":28852,"_19817":49579,"_25978":49580,"_2758":24012},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3268":1005,"_28512":998,"_5":28852,"_19817":49582,"_25978":49583,"_2758":49584},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3268":1006,"_28512":998,"_5":28852,"_19817":49586,"_25978":49587,"_2758":49588},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3268":1007,"_28512":998,"_5":28852,"_19817":49590,"_25978":49591,"_2758":49592},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3268":1008,"_28512":998,"_19817":49594,"_5":13545,"_25978":998,"_2758":49595},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3268":1009,"_28512":998,"_19817":49597,"_5":13545,"_25978":49567,"_2758":49598},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3268":1010,"_28512":998,"_19817":49600,"_5":13545,"_25978":49567,"_2758":49601},[],"Operation",{"_3268":1011,"_28512":998,"_19817":49603,"_5":13545,"_25978":49567,"_2758":49604},[],"Method",{"_3268":1012,"_28512":998,"_19817":49606,"_5":13545,"_25978":49567,"_2758":49607},[],"Authentication and condition",{"_3268":1013,"_28512":998,"_19817":49609,"_5":13545,"_25978":49567,"_2758":49610},[],"`/cacerts`",{"_3268":1014,"_28512":998,"_19817":49612,"_5":13545,"_25978":49567,"_2758":49613},[],"GET",{"_3268":1015,"_28512":998,"_19817":49615,"_5":13545,"_25978":49567,"_2758":49616},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3268":1016,"_28512":998,"_19817":49618,"_5":13545,"_25978":49567,"_2758":49619},[],"`/simpleenroll`",{"_3268":1017,"_28512":998,"_19817":49621,"_5":13545,"_25978":49567,"_2758":49622},[],"POST",{"_3268":1018,"_28512":998,"_19817":49624,"_5":13545,"_25978":49567,"_2758":49625},[],"Initial authentication and DMS registration/replacement policy.",{"_3268":1019,"_28512":998,"_19817":49627,"_5":13545,"_25978":49567,"_2758":49628},[],"`/simplereenroll`",{"_3268":1020,"_28512":998,"_19817":49630,"_5":13545,"_25978":49567,"_2758":49622},[],{"_3268":1021,"_28512":998,"_19817":49632,"_5":13545,"_25978":49567,"_2758":49633},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3268":1022,"_28512":998,"_19817":49635,"_5":13545,"_25978":49567,"_2758":49636},[],"`/serverkeygen`",{"_3268":1023,"_28512":998,"_19817":49638,"_5":13545,"_25978":49567,"_2758":49622},[],{"_3268":1024,"_28512":998,"_19817":49640,"_5":13545,"_25978":49567,"_2758":49641},[],"Initial authentication and admission; server generation enabled.",{"_3268":1025,"_28512":998,"_19817":49643,"_5":13545,"_25978":49567,"_2758":49644},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3268":1026,"_28512":998,"_19817":49646,"_5":13545,"_25978":49571,"_2758":49647},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3268":1027,"_28512":998,"_19817":49649,"_5":13545,"_25978":49571,"_2758":49650},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3268":1028,"_28512":998,"_19817":49652,"_5":13545,"_25978":49574,"_2758":49653},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3268":1029,"_28512":998,"_19817":49655,"_5":13545,"_25978":49574,"_2758":49656},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3268":1030,"_28512":998,"_19817":49658,"_5":13545,"_25978":49577,"_2758":49659},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3268":1031,"_28512":998,"_19817":49661,"_5":13545,"_25978":49577,"_2758":49662},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3268":1032,"_28512":998,"_19817":49664,"_5":13545,"_25978":49580,"_2758":49665},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3268":1033,"_28512":998,"_19817":49667,"_5":13545,"_25978":49580,"_2758":49668},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3268":1034,"_28512":998,"_19817":49670,"_5":13545,"_25978":49583,"_2758":49671},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3268":1035,"_28512":998,"_19817":49673,"_5":13545,"_25978":49583,"_2758":49674},[],"Part",{"_3268":1036,"_28512":998,"_19817":49676,"_5":13545,"_25978":49583,"_2758":49677},[],"Content after decoding its Base64",{"_3268":1037,"_28512":998,"_19817":49679,"_5":13545,"_25978":49583,"_2758":49680},[],"`application/pkcs8`",{"_3268":1038,"_28512":998,"_19817":49682,"_5":13545,"_25978":49583,"_2758":49683},[],"Unencrypted DER PKCS#8 private key.",{"_3268":1039,"_28512":998,"_19817":49685,"_5":13545,"_25978":49583,"_2758":49686},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3268":1040,"_28512":998,"_19817":49688,"_5":13545,"_25978":49583,"_2758":49689},[],"DER PKCS#7 containing the issued certificate.",{"_3268":1041,"_28512":998,"_19817":49691,"_5":13545,"_25978":49583,"_2758":49692},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3268":1042,"_28512":998,"_19817":49694,"_5":13545,"_25978":49587,"_2758":49695},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3268":1043,"_28512":998,"_19817":49697,"_5":13545,"_25978":49587,"_2758":49698},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3268":1044,"_28512":998,"_19817":49700,"_5":13545,"_25978":49587,"_2758":49701},[],"Convert and check the result:",{"_3268":1045,"_28512":998,"_19817":49703,"_5":13545,"_25978":49587,"_2758":49704},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3268":1046,"_28512":998,"_19817":49706,"_5":13545,"_25978":49591,"_2758":49707},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3268":1047,"_28512":998,"_19817":49709,"_5":13545,"_25978":49591,"_2758":49710},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3268":1048,"_28512":1048,"_5":13876,"_2758":49029,"_28855":49712,"_19817":49713,"_25978":1048},[46447,47840,48848,48846,49029],[],{"_3268":1049,"_28512":1048,"_19817":49715,"_5":13545,"_25978":1048,"_2758":49716},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3268":1050,"_28512":1048,"_5":28852,"_19817":49718,"_25978":49719,"_2758":49720},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3268":1051,"_28512":1048,"_5":28852,"_19817":49722,"_25978":49723,"_2758":49724},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3268":1052,"_28512":1048,"_5":28852,"_19817":49726,"_25978":49727,"_2758":49728},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3268":1053,"_28512":1048,"_5":28852,"_19817":49730,"_25978":49731,"_2758":49732},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3268":1054,"_28512":1048,"_19817":49734,"_5":13545,"_25978":1048,"_2758":49735},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3268":1055,"_28512":1048,"_19817":49737,"_5":13545,"_25978":49719,"_2758":49738},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3268":1056,"_28512":1048,"_19817":49740,"_5":13545,"_25978":49719,"_2758":49741},[],"The integrator installs initial EST server trust and an admission credential.",{"_3268":1057,"_28512":1048,"_19817":49743,"_5":13545,"_25978":49719,"_2758":49744},[],"The client requests an identity for its `Device ID` through EST.",{"_3268":1058,"_28512":1048,"_19817":49746,"_5":13545,"_25978":49719,"_2758":49747},[],"Certificate, device binding and key/certificate installation are checked.",{"_3268":1059,"_28512":1048,"_19817":49749,"_5":13545,"_25978":49719,"_2758":49750},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3268":1060,"_28512":1048,"_19817":49752,"_5":13545,"_25978":49719,"_2758":49753},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3268":1061,"_28512":1048,"_19817":49755,"_5":13545,"_25978":49723,"_2758":49756},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3268":1062,"_28512":1048,"_19817":49758,"_5":13545,"_25978":49723,"_2758":49759},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3268":1063,"_28512":1048,"_19817":49761,"_5":13545,"_25978":49723,"_2758":49762},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3268":1064,"_28512":1048,"_19817":49764,"_5":13545,"_25978":49723,"_2758":49765},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3268":1065,"_28512":1048,"_19817":49767,"_5":13545,"_25978":49727,"_2758":49768},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3268":1066,"_28512":1048,"_19817":49770,"_5":13545,"_25978":49727,"_2758":49771},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3268":1067,"_28512":1048,"_19817":49773,"_5":13545,"_25978":49727,"_2758":49774},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3268":1068,"_28512":1048,"_19817":49776,"_5":13545,"_25978":49727,"_2758":49777},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3268":1069,"_28512":1048,"_19817":49779,"_5":13545,"_25978":49731,"_2758":49780},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3268":1070,"_28512":1048,"_19817":49782,"_5":13545,"_25978":49731,"_2758":49783},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3268":1071,"_28512":1071,"_5":13876,"_2758":49785,"_28855":49786,"_19817":49787,"_25978":1071},"Provisioning strategies",[46447,47840,48848,48846,49029],[],{"_3268":1072,"_28512":1071,"_19817":49789,"_5":13545,"_25978":1071,"_2758":49790},[],"Choose device registration, identity authorization and key generation.",{"_3268":1073,"_28512":1071,"_5":28852,"_19817":49792,"_25978":49793,"_2758":49794},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3268":1074,"_28512":1071,"_5":28852,"_19817":49796,"_25978":49797,"_2758":49798},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3268":1075,"_28512":1071,"_5":28852,"_19817":49800,"_25978":49801,"_2758":49802},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3268":1076,"_28512":1071,"_5":28852,"_19817":49804,"_25978":49805,"_2758":49806},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3268":1077,"_28512":1071,"_5":28852,"_19817":49808,"_25978":49809,"_2758":49810},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3268":1078,"_28512":1071,"_19817":49812,"_5":13545,"_25978":1071,"_2758":49813},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3268":1079,"_28512":1071,"_19817":49815,"_5":13545,"_25978":49793,"_2758":49816},[],"Path",{"_3268":1080,"_28512":1071,"_19817":49818,"_5":13545,"_25978":49793,"_2758":49819},[],"When the device exists",{"_3268":1081,"_28512":1071,"_19817":49821,"_5":13545,"_25978":49793,"_2758":49822},[],"What to check",{"_3268":1082,"_28512":1071,"_19817":49824,"_5":13545,"_25978":49793,"_2758":49825},[],"Manual assignment",{"_3268":1083,"_28512":1071,"_19817":49827,"_5":13545,"_25978":49793,"_2758":49828},[],"An operator creates it before associating a certificate.",{"_3268":1084,"_28512":1071,"_19817":49830,"_5":13545,"_25978":49793,"_2758":49831},[],"ID, owning DMS, certificate CN and bound serial.",{"_3268":1085,"_28512":1071,"_19817":49833,"_5":13545,"_25978":49793,"_2758":49834},[],"EST with `JITP`",{"_3268":1086,"_28512":1071,"_19817":49836,"_5":13545,"_25978":49793,"_2758":49837},[],"Created for an unknown CN during `/simpleenroll`.",{"_3268":1087,"_28512":1071,"_19817":49839,"_5":13545,"_25978":49793,"_2758":49840},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3268":1088,"_28512":1071,"_19817":49842,"_5":13545,"_25978":49793,"_2758":49843},[],"EST with `PRE_REGISTRATION`",{"_3268":1089,"_28512":1071,"_19817":49845,"_5":13545,"_25978":49793,"_2758":49846},[],"Must exist before `/simpleenroll`.",{"_3268":1090,"_28512":1071,"_19817":49848,"_5":13545,"_25978":49793,"_2758":49849},[],"Approved record, same DMS and replacement conditions for your version.",{"_3268":1091,"_28512":1071,"_19817":49851,"_5":13545,"_25978":49793,"_2758":49852},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3268":1092,"_28512":1071,"_19817":49854,"_5":13545,"_25978":49793,"_2758":49855},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3268":1093,"_28512":1071,"_19817":49857,"_5":13545,"_25978":49797,"_2758":49858},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3268":1094,"_28512":1071,"_19817":49860,"_5":13545,"_25978":49797,"_2758":49861},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3268":1095,"_28512":1071,"_19817":49863,"_5":13545,"_25978":49797,"_2758":49864},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3268":1096,"_28512":1071,"_19817":49866,"_5":13545,"_25978":49801,"_2758":49867},[],"Decide initial enrollment and re-enrollment separately:",{"_3268":1097,"_28512":1071,"_19817":49869,"_5":13545,"_25978":49801,"_2758":49870},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3268":1098,"_28512":1071,"_19817":49872,"_5":13545,"_25978":49801,"_2758":49873},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3268":1099,"_28512":1071,"_19817":49875,"_5":13545,"_25978":49801,"_2758":49876},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3268":1100,"_28512":1071,"_19817":49878,"_5":13545,"_25978":49801,"_2758":49879},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3268":1101,"_28512":1071,"_19817":49881,"_5":13545,"_25978":49801,"_2758":49882},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3268":1102,"_28512":1071,"_19817":49884,"_5":13545,"_25978":49805,"_2758":46831},[],{"_3268":1103,"_28512":1071,"_19817":49886,"_5":13545,"_25978":49805,"_2758":49887},[],"Material crossing EST",{"_3268":1104,"_28512":1071,"_19817":49889,"_5":13545,"_25978":49805,"_2758":49890},[],"Device-generated key",{"_3268":1105,"_28512":1071,"_19817":49892,"_5":13545,"_25978":49805,"_2758":49893},[],"Public CSR and certificate; the key stays on the client.",{"_3268":1106,"_28512":1071,"_19817":49895,"_5":13545,"_25978":49805,"_2758":49896},[],"Existing device key",{"_3268":1107,"_28512":1071,"_19817":49898,"_5":13545,"_25978":49805,"_2758":49899},[],"CSR signed with that key and a new certificate.",{"_3268":1108,"_28512":1071,"_19817":49901,"_5":13545,"_25978":49805,"_2758":49167},[],{"_3268":1109,"_28512":1071,"_19817":49903,"_5":13545,"_25978":49805,"_2758":49904},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3268":1110,"_28512":1071,"_19817":49906,"_5":13545,"_25978":49805,"_2758":49907},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3268":1111,"_28512":1071,"_19817":49909,"_5":13545,"_25978":49809,"_2758":49910},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3268":1112,"_28512":1112,"_5":13876,"_2758":49912,"_28855":49913,"_19817":49914,"_25978":1112},"Renewal and recovery",[46447,47840,48848,48846,49029],[],{"_3268":1113,"_28512":1112,"_19817":49916,"_5":13545,"_25978":1112,"_2758":49917},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3268":1114,"_28512":1112,"_5":28852,"_19817":49919,"_25978":49920,"_2758":49921},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3268":1115,"_28512":1112,"_5":28852,"_19817":49923,"_25978":49924,"_2758":49925},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3268":1116,"_28512":1112,"_5":28852,"_19817":49927,"_25978":49928,"_2758":49929},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3268":1117,"_28512":1112,"_5":28852,"_19817":49931,"_25978":49932,"_2758":49933},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3268":1118,"_28512":1112,"_5":28852,"_19817":49935,"_25978":49936,"_2758":49937},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3268":1119,"_28512":1112,"_19817":49939,"_5":13545,"_25978":1112,"_2758":49940},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3268":1120,"_28512":1112,"_19817":49942,"_5":13545,"_25978":49920,"_2758":49943},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3268":1121,"_28512":1112,"_19817":49945,"_5":13545,"_25978":49920,"_2758":49946},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3268":1122,"_28512":1112,"_19817":49948,"_5":13545,"_25978":49920,"_2758":49949},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3268":1123,"_28512":1112,"_19817":49951,"_5":13545,"_25978":49920,"_2758":49952},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3268":1124,"_28512":1112,"_19817":49954,"_5":13545,"_25978":49924,"_2758":49955},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3268":1125,"_28512":1112,"_19817":49957,"_5":13545,"_25978":49924,"_2758":49958},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3268":1126,"_28512":1112,"_19817":49960,"_5":13545,"_25978":49928,"_2758":49961},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3268":1127,"_28512":1112,"_19817":49963,"_5":13545,"_25978":49928,"_2758":49964},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3268":1128,"_28512":1112,"_19817":49966,"_5":13545,"_25978":49928,"_2758":49967},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3268":1129,"_28512":1112,"_19817":49969,"_5":13545,"_25978":49932,"_2758":49970},[],"Situation",{"_3268":1130,"_28512":1112,"_19817":49972,"_5":13545,"_25978":49932,"_2758":49973},[],"Procedure",{"_3268":1131,"_28512":1112,"_19817":49975,"_5":13545,"_25978":49932,"_2758":49976},[],"Valid certificate, outside the window",{"_3268":1132,"_28512":1112,"_19817":49978,"_5":13545,"_25978":49932,"_2758":49979},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3268":1133,"_28512":1112,"_19817":49981,"_5":13545,"_25978":49932,"_2758":49982},[],"Expired certificate, key available",{"_3268":1134,"_28512":1112,"_19817":49984,"_5":13545,"_25978":49932,"_2758":49985},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3268":1135,"_28512":1112,"_19817":49987,"_5":13545,"_25978":49932,"_2758":49988},[],"Renewal through webhook or `NO_AUTH`",{"_3268":1136,"_28512":1112,"_19817":49990,"_5":13545,"_25978":49932,"_2758":49991},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3268":1137,"_28512":1112,"_19817":49993,"_5":13545,"_25978":49932,"_2758":49994},[],"Lost or inaccessible key",{"_3268":1138,"_28512":1112,"_19817":49996,"_5":13545,"_25978":49932,"_2758":49997},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3268":1139,"_28512":1112,"_19817":49999,"_5":13545,"_25978":49932,"_2758":50000},[],"Current identity revoked",{"_3268":1140,"_28512":1112,"_19817":50002,"_5":13545,"_25978":49932,"_2758":50003},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3268":1141,"_28512":1112,"_19817":50005,"_5":13545,"_25978":49932,"_2758":50006},[],"Device without an identity",{"_3268":1142,"_28512":1112,"_19817":50008,"_5":13545,"_25978":49932,"_2758":50009},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3268":1143,"_28512":1112,"_19817":50011,"_5":13545,"_25978":49932,"_2758":50012},[],"Retired device",{"_3268":1144,"_28512":1112,"_19817":50014,"_5":13545,"_25978":49932,"_2758":50015},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3268":1145,"_28512":1112,"_19817":50017,"_5":13545,"_25978":49932,"_2758":50018},[],"Timeout, HTTP 500 or installation failure",{"_3268":1146,"_28512":1112,"_19817":50020,"_5":13545,"_25978":49932,"_2758":50021},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3268":1147,"_28512":1112,"_19817":50023,"_5":13545,"_25978":49936,"_2758":50024},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3268":1148,"_28512":1112,"_19817":50026,"_5":13545,"_25978":49936,"_2758":50027},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3268":1149,"_28512":1149,"_5":13876,"_2758":50029,"_28855":50030,"_19817":50031,"_25978":1149},"Enrollment troubleshooting",[46447,47840,48848,48846,49029],[],{"_3268":1150,"_28512":1149,"_19817":50033,"_5":13545,"_25978":1149,"_2758":50034},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3268":1151,"_28512":1149,"_5":28852,"_19817":50036,"_25978":50037,"_2758":50038},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3268":1152,"_28512":1149,"_5":28852,"_19817":50040,"_25978":50041,"_2758":50042},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3268":1153,"_28512":1149,"_5":28852,"_19817":50044,"_25978":50045,"_2758":49592},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3268":1154,"_28512":1149,"_5":28852,"_19817":50047,"_25978":50048,"_2758":50049},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3268":1155,"_28512":1149,"_19817":50051,"_5":13545,"_25978":1149,"_2758":50052},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3268":1156,"_28512":1149,"_19817":50054,"_5":13545,"_25978":50041,"_2758":50055},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3268":1157,"_28512":1149,"_19817":50057,"_5":13545,"_25978":50041,"_2758":50058},[],"Symptom or message",{"_3268":1158,"_28512":1149,"_19817":50060,"_5":13545,"_25978":50041,"_2758":49822},[],{"_3268":1159,"_28512":1149,"_19817":50062,"_5":13545,"_25978":50041,"_2758":50063},[],"curl rejects TLS, name or issuer",{"_3268":1160,"_28512":1149,"_19817":50065,"_5":13545,"_25978":50041,"_2758":50066},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3268":1161,"_28512":1149,"_19817":50068,"_5":13545,"_25978":50041,"_2758":50069},[],"404 or missing APS",{"_3268":1162,"_28512":1149,"_19817":50071,"_5":13545,"_25978":50041,"_2758":50072},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3268":1163,"_28512":1149,"_19817":50074,"_5":13545,"_25978":50041,"_2758":50075},[],"400, CSR or format error",{"_3268":1164,"_28512":1149,"_19817":50077,"_5":13545,"_25978":50041,"_2758":50078},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3268":1165,"_28512":1149,"_19817":50080,"_5":13545,"_25978":50041,"_2758":50081},[],"Missing credential or invalid certificate",{"_3268":1166,"_28512":1149,"_19817":50083,"_5":13545,"_25978":50041,"_2758":50084},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3268":1167,"_28512":1149,"_19817":50086,"_5":13545,"_25978":50041,"_2758":50087},[],"Webhook denies, times out or responds without authorization",{"_3268":1168,"_28512":1149,"_19817":50089,"_5":13545,"_25978":50041,"_2758":50090},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3268":1169,"_28512":1149,"_19817":50092,"_5":13545,"_25978":50041,"_2758":50093},[],"`unexpected status code: <n>: redirects are not followed`",{"_3268":1170,"_28512":1149,"_19817":50095,"_5":13545,"_25978":50041,"_2758":50096},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3268":1171,"_28512":1149,"_19817":50098,"_5":13545,"_25978":50041,"_2758":50099},[],"`webhook response exceeds 1048576 bytes`",{"_3268":1172,"_28512":1149,"_19817":50101,"_5":13545,"_25978":50041,"_2758":50102},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3268":1173,"_28512":1149,"_19817":50104,"_5":13545,"_25978":50041,"_2758":50105},[],"`webhook config must not reference files`",{"_3268":1174,"_28512":1149,"_19817":50107,"_5":13545,"_25978":50041,"_2758":50108},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3268":1175,"_28512":1149,"_19817":50110,"_5":13545,"_25978":50041,"_2758":50111},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3268":1176,"_28512":1149,"_19817":50113,"_5":13545,"_25978":50041,"_2758":50114},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3268":1177,"_28512":1149,"_19817":50116,"_5":13545,"_25978":50041,"_2758":50117},[],"`webhook mTLS certificate and key are invalid: …`",{"_3268":1178,"_28512":1149,"_19817":50119,"_5":13545,"_25978":50041,"_2758":50120},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3268":1179,"_28512":1149,"_19817":50122,"_5":13545,"_25978":50041,"_2758":50123},[],"400 `struct validation error` creating or updating a DMS",{"_3268":1180,"_28512":1149,"_19817":50125,"_5":13545,"_25978":50041,"_2758":50126},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3268":1181,"_28512":1149,"_19817":50128,"_5":13545,"_25978":50041,"_2758":50129},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3268":1182,"_28512":1149,"_19817":50131,"_5":13545,"_25978":50041,"_2758":50132},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3268":1183,"_28512":1149,"_19817":50134,"_5":13545,"_25978":50041,"_2758":50135},[],"`device not preregistered`",{"_3268":1184,"_28512":1149,"_19817":50137,"_5":13545,"_25978":50041,"_2758":50138},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3268":1185,"_28512":1149,"_19817":50140,"_5":13545,"_25978":50041,"_2758":50141},[],"`forbiddenNewEnrollment`",{"_3268":1186,"_28512":1149,"_19817":50143,"_5":13545,"_25978":50041,"_2758":50144},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3268":1187,"_28512":1149,"_19817":50146,"_5":13545,"_25978":50041,"_2758":50147},[],"Different owning DMS",{"_3268":1188,"_28512":1149,"_19817":50149,"_5":13545,"_25978":50041,"_2758":50150},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3268":1189,"_28512":1149,"_19817":50152,"_5":13545,"_25978":50041,"_2758":50153},[],"`invalid RawSubject bytes`",{"_3268":1190,"_28512":1149,"_19817":50155,"_5":13545,"_25978":50041,"_2758":50156},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3268":1191,"_28512":1149,"_19817":50158,"_5":13545,"_25978":50041,"_2758":50159},[],"`invalid reenroll window`",{"_3268":1192,"_28512":1149,"_19817":50161,"_5":13545,"_25978":50041,"_2758":50162},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3268":1193,"_28512":1149,"_19817":50164,"_5":13545,"_25978":50041,"_2758":50165},[],"Current certificate revoked",{"_3268":1194,"_28512":1149,"_19817":50167,"_5":13545,"_25978":50041,"_2758":50168},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3268":1195,"_28512":1149,"_19817":50170,"_5":13545,"_25978":50041,"_2758":50171},[],"CA, profile or signing error",{"_3268":1196,"_28512":1149,"_19817":50173,"_5":13545,"_25978":50041,"_2758":50174},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3268":1197,"_28512":1149,"_19817":50176,"_5":13545,"_25978":50041,"_2758":50177},[],"HTTP 200 without a device connection",{"_3268":1198,"_28512":1149,"_19817":50179,"_5":13545,"_25978":50041,"_2758":50180},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3268":1199,"_28512":1149,"_19817":50182,"_5":13545,"_25978":50041,"_2758":50183},[],"Timeout or error after issuance",{"_3268":1200,"_28512":1149,"_19817":50185,"_5":13545,"_25978":50041,"_2758":50186},[],"New certificates, current slot and previous identity's state before retrying.",{"_3268":1201,"_28512":1149,"_19817":50188,"_5":13545,"_25978":50045,"_2758":50189},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3268":1202,"_28512":1149,"_19817":50191,"_5":13545,"_25978":50045,"_2758":50192},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3268":1203,"_28512":1149,"_19817":50194,"_5":13545,"_25978":50048,"_2758":50195},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3268":1204,"_28512":1149,"_19817":50197,"_5":13545,"_25978":50048,"_2758":50198},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3268":1205,"_28512":1149,"_19817":50200,"_5":13545,"_25978":50048,"_2758":50201},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3268":1206,"_28512":1149,"_19817":50203,"_5":13545,"_25978":50048,"_2758":50204},[],"Make one request, save headers/body and query the device and certificates.",{"_3268":1207,"_28512":1149,"_19817":50206,"_5":13545,"_25978":50048,"_2758":50207},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3268":1208,"_28512":1149,"_19817":50209,"_5":13545,"_25978":50048,"_2758":50210},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3268":1209,"_28512":1149,"_19817":50212,"_5":13545,"_25978":50048,"_2758":50213},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3268":1210,"_28512":1210,"_5":13876,"_2758":50215,"_28855":50216,"_19817":50217,"_25978":1210},"Trust distribution and updates",[46447,47840,48848,48846,49029],[],{"_3268":1211,"_28512":1210,"_19817":50219,"_5":13545,"_25978":1210,"_2758":50220},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3268":1212,"_28512":1210,"_5":28852,"_19817":50222,"_25978":50223,"_2758":50224},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3268":1213,"_28512":1210,"_5":28852,"_19817":50226,"_25978":50227,"_2758":50228},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3268":1214,"_28512":1210,"_5":28852,"_19817":50230,"_25978":50231,"_2758":50232},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3268":1215,"_28512":1210,"_5":28852,"_19817":50234,"_25978":50235,"_2758":50236},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3268":1216,"_28512":1210,"_5":28852,"_19817":50238,"_25978":50239,"_2758":50240},[],"/docs/pr-preview/pr-43/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3268":1217,"_28512":1210,"_19817":50242,"_5":13545,"_25978":1210,"_2758":50243},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3268":1218,"_28512":1210,"_19817":50245,"_5":13545,"_25978":50223,"_2758":50246},[],"Relationship",{"_3268":1219,"_28512":1210,"_19817":50248,"_5":13545,"_25978":50223,"_2758":50249},[],"Material prepared by its owner",{"_3268":1220,"_28512":1210,"_19817":50251,"_5":13545,"_25978":50223,"_2758":50252},[],"Device → EST server",{"_3268":1221,"_28512":1210,"_19817":50254,"_5":13545,"_25978":50223,"_2758":50255},[],"Previously verified server root, chain or pin and TLS name.",{"_3268":1222,"_28512":1210,"_19817":50257,"_5":13545,"_25978":50223,"_2758":50258},[],"DMS → requester",{"_3268":1223,"_28512":1210,"_19817":50260,"_5":13545,"_25978":50223,"_2758":50261},[],"CAs and rules authorizing initial or renewal credentials.",{"_3268":1224,"_28512":1210,"_19817":50263,"_5":13545,"_25978":50223,"_2758":50264},[],"Consumer → device",{"_3268":1225,"_28512":1210,"_19817":50266,"_5":13545,"_25978":50223,"_2758":50267},[],"Operational identity roots, intermediates, validation and permissions.",{"_3268":1226,"_28512":1210,"_19817":50269,"_5":13545,"_25978":50223,"_2758":50270},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3268":1227,"_28512":1210,"_19817":50272,"_5":13545,"_25978":50227,"_2758":50273},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3268":1228,"_28512":1210,"_19817":50275,"_5":13545,"_25978":50227,"_2758":50276},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3268":1229,"_28512":1210,"_19817":50278,"_5":13545,"_25978":50231,"_2758":50279},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3268":1230,"_28512":1210,"_19817":50281,"_5":13545,"_25978":50231,"_2758":50282},[],"Select policy-approved roots as anchors.",{"_3268":1231,"_28512":1210,"_19817":50284,"_5":13545,"_25978":50231,"_2758":50285},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3268":1232,"_28512":1210,"_19817":50287,"_5":13545,"_25978":50231,"_2758":50288},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3268":1233,"_28512":1210,"_19817":50290,"_5":13545,"_25978":50231,"_2758":50291},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3268":1234,"_28512":1210,"_19817":50293,"_5":13545,"_25978":50231,"_2758":50294},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3268":1235,"_28512":1210,"_19817":50296,"_5":13545,"_25978":50235,"_2758":50297},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3268":1236,"_28512":1210,"_19817":50299,"_5":13545,"_25978":50235,"_2758":50300},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3268":1237,"_28512":1210,"_19817":50302,"_5":13545,"_25978":50235,"_2758":50303},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3268":1238,"_28512":1210,"_19817":50305,"_5":13545,"_25978":50239,"_2758":50306},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3268":1239,"_28512":1239,"_5":13876,"_2758":50308,"_28855":50309,"_19817":50311,"_25978":1239},"AWS IoT Core",[46447,47840,48848,48846,50310],"Integrations",[],{"_3268":1240,"_28512":1239,"_19817":50313,"_5":13545,"_25978":1239,"_2758":50314},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3268":1241,"_28512":1239,"_5":28852,"_19817":50316,"_25978":50317,"_2758":50318},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3268":1242,"_28512":1239,"_5":28852,"_19817":50320,"_25978":50321,"_2758":50322},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3268":1243,"_28512":1239,"_5":28852,"_19817":50324,"_25978":50325,"_2758":50326},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3268":1244,"_28512":1239,"_5":28852,"_19817":50328,"_25978":50329,"_2758":50330},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3268":1245,"_28512":1239,"_5":28852,"_19817":50332,"_25978":50333,"_2758":50334},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#resource-state-machine","Resource state machine",{"_3268":1246,"_28512":1239,"_5":28852,"_19817":50336,"_25978":50337,"_2758":50338},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#events-the-connector-handles","Events the connector handles",{"_3268":1247,"_28512":1239,"_5":28852,"_19817":50340,"_25978":50341,"_2758":50342},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3268":1248,"_28512":1239,"_5":28852,"_19817":50344,"_25978":50345,"_2758":50346},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3268":1249,"_28512":1239,"_5":28852,"_19817":50348,"_25978":50349,"_2758":50350},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3268":1250,"_28512":1239,"_5":28852,"_19817":50352,"_25978":50353,"_2758":50354},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3268":1251,"_28512":1239,"_5":28852,"_19817":50356,"_25978":50357,"_2758":50358},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3268":1252,"_28512":1239,"_5":28852,"_19817":50360,"_25978":50361,"_2758":50362},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3268":1253,"_28512":1239,"_5":28852,"_19817":50364,"_25978":50365,"_2758":50366},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3268":1254,"_28512":1239,"_5":28852,"_19817":50368,"_25978":50369,"_2758":50370},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3268":1255,"_28512":1239,"_5":28852,"_19817":50372,"_25978":50373,"_2758":50374},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3268":1256,"_28512":1239,"_5":28852,"_19817":50376,"_25978":50377,"_2758":50378},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3268":1257,"_28512":1239,"_5":28852,"_19817":50380,"_25978":50381,"_2758":50382},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3268":1258,"_28512":1239,"_5":28852,"_19817":50384,"_25978":50385,"_2758":50386},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3268":1259,"_28512":1239,"_5":28852,"_19817":50388,"_25978":50389,"_2758":50390},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3268":1260,"_28512":1239,"_5":28852,"_19817":50392,"_25978":50393,"_2758":50394},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3268":1261,"_28512":1239,"_5":28852,"_19817":50396,"_25978":50397,"_2758":50398},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3268":1262,"_28512":1239,"_5":28852,"_19817":50400,"_25978":50401,"_2758":50402},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3268":1263,"_28512":1239,"_5":28852,"_19817":50404,"_25978":50405,"_2758":50406},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3268":1264,"_28512":1239,"_5":28852,"_19817":50408,"_25978":50409,"_2758":50410},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3268":1265,"_28512":1239,"_5":28852,"_19817":50412,"_25978":50413,"_2758":50414},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3268":1266,"_28512":1239,"_5":28852,"_19817":50416,"_25978":50417,"_2758":50418},[],"/docs/pr-preview/pr-43/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3268":1267,"_28512":1239,"_19817":50420,"_5":13545,"_25978":1239,"_2758":50421},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3268":1268,"_28512":1239,"_19817":50423,"_5":13545,"_25978":1239,"_2758":50424},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3268":1269,"_28512":1239,"_19817":50426,"_5":13545,"_25978":1239,"_2758":50427},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3268":1270,"_28512":1239,"_19817":50429,"_5":13545,"_25978":50317,"_2758":50430},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3268":1271,"_28512":1239,"_19817":50432,"_5":13545,"_25978":50317,"_2758":50433},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3268":1272,"_28512":1239,"_19817":50435,"_5":13545,"_25978":50317,"_2758":50436},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3268":1273,"_28512":1239,"_19817":50438,"_5":13545,"_25978":50317,"_2758":50439},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3268":1274,"_28512":1239,"_19817":50441,"_5":13545,"_25978":50321,"_2758":50442},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3268":1275,"_28512":1239,"_19817":50444,"_5":13545,"_25978":50325,"_2758":50445},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3268":1276,"_28512":1239,"_19817":50447,"_5":13545,"_25978":50325,"_2758":50448},[],"IAM action",{"_3268":1277,"_28512":1239,"_19817":50450,"_5":13545,"_25978":50325,"_2758":46837},[],{"_3268":1278,"_28512":1239,"_19817":50452,"_5":13545,"_25978":50325,"_2758":50453},[],"`iot:GetRegistrationCode`",{"_3268":1279,"_28512":1239,"_19817":50455,"_5":13545,"_25978":50325,"_2758":50456},[],"Obtain the verification code for CA registration in the Primary Account",{"_3268":1280,"_28512":1239,"_19817":50458,"_5":13545,"_25978":50325,"_2758":50459},[],"`iot:RegisterCACertificate`",{"_3268":1281,"_28512":1239,"_19817":50461,"_5":13545,"_25978":50325,"_2758":50462},[],"Register the CA in AWS IoT",{"_3268":1282,"_28512":1239,"_19817":50464,"_5":13545,"_25978":50325,"_2758":50465},[],"`iot:DescribeCACertificate`",{"_3268":1283,"_28512":1239,"_19817":50467,"_5":13545,"_25978":50325,"_2758":50468},[],"Check the CA registration status",{"_3268":1284,"_28512":1239,"_19817":50470,"_5":13545,"_25978":50325,"_2758":50471},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3268":1285,"_28512":1239,"_19817":50473,"_5":13545,"_25978":50325,"_2758":50474},[],"Create or update Things in IoT Core",{"_3268":1286,"_28512":1239,"_19817":50476,"_5":13545,"_25978":50325,"_2758":50477},[],"`iot:RegisterThing`",{"_3268":1287,"_28512":1239,"_19817":50479,"_5":13545,"_25978":50325,"_2758":50480},[],"Provision Things through a template",{"_3268":1288,"_28512":1239,"_19817":50482,"_5":13545,"_25978":50325,"_2758":50483},[],"`iot:RegisterCertificate`",{"_3268":1289,"_28512":1239,"_19817":50485,"_5":13545,"_25978":50325,"_2758":50486},[],"Register device certificates",{"_3268":1290,"_28512":1239,"_19817":50488,"_5":13545,"_25978":50325,"_2758":50489},[],"`iot:UpdateCertificate`",{"_3268":1291,"_28512":1239,"_19817":50491,"_5":13545,"_25978":50325,"_2758":50492},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3268":1292,"_28512":1239,"_19817":50494,"_5":13545,"_25978":50325,"_2758":50495},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3268":1293,"_28512":1239,"_19817":50497,"_5":13545,"_25978":50325,"_2758":50498},[],"Create and attach IoT policies",{"_3268":1294,"_28512":1239,"_19817":50500,"_5":13545,"_25978":50325,"_2758":50501},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3268":1295,"_28512":1239,"_19817":50503,"_5":13545,"_25978":50325,"_2758":50504},[],"Manage Thing groups",{"_3268":1296,"_28512":1239,"_19817":50506,"_5":13545,"_25978":50325,"_2758":50507},[],"`iot:CreateProvisioningTemplate`",{"_3268":1297,"_28512":1239,"_19817":50509,"_5":13545,"_25978":50325,"_2758":50510},[],"Create JITP templates",{"_3268":1298,"_28512":1239,"_19817":50512,"_5":13545,"_25978":50325,"_2758":50513},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3268":1299,"_28512":1239,"_19817":50515,"_5":13545,"_25978":50325,"_2758":50516},[],"Read and write the Device Shadow",{"_3268":1300,"_28512":1239,"_19817":50518,"_5":13545,"_25978":50325,"_2758":50519},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3268":1301,"_28512":1239,"_19817":50521,"_5":13545,"_25978":50329,"_2758":50522},[],"Parameter",{"_3268":1302,"_28512":1239,"_19817":50524,"_5":13545,"_25978":50329,"_2758":50525},[],"Type",{"_3268":1303,"_28512":1239,"_19817":50527,"_5":13545,"_25978":50329,"_2758":50528},[],"Required",{"_3268":1304,"_28512":1239,"_19817":50530,"_5":13545,"_25978":50329,"_2758":50531},[],"Description",{"_3268":1305,"_28512":1239,"_19817":50533,"_5":13545,"_25978":50329,"_2758":50534},[],"`connector_id`",{"_3268":1306,"_28512":1239,"_19817":50536,"_5":13545,"_25978":50329,"_2758":23674},[],{"_3268":1307,"_28512":1239,"_19817":50538,"_5":13545,"_25978":50329,"_2758":50539},[],"Yes",{"_3268":1308,"_28512":1239,"_19817":50541,"_5":13545,"_25978":50329,"_2758":50542},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3268":1309,"_28512":1239,"_19817":50544,"_5":13545,"_25978":50329,"_2758":50545},[],"`aws_config.region`",{"_3268":1310,"_28512":1239,"_19817":50547,"_5":13545,"_25978":50329,"_2758":23674},[],{"_3268":1311,"_28512":1239,"_19817":50549,"_5":13545,"_25978":50329,"_2758":50539},[],{"_3268":1312,"_28512":1239,"_19817":50551,"_5":13545,"_25978":50329,"_2758":50552},[],"AWS region where the connector operates.",{"_3268":1313,"_28512":1239,"_19817":50554,"_5":13545,"_25978":50329,"_2758":50555},[],"`aws_config.auth_method`",{"_3268":1314,"_28512":1239,"_19817":50557,"_5":13545,"_25978":50329,"_2758":23674},[],{"_3268":1315,"_28512":1239,"_19817":50559,"_5":13545,"_25978":50329,"_2758":50539},[],{"_3268":1316,"_28512":1239,"_19817":50561,"_5":13545,"_25978":50329,"_2758":50562},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3268":1317,"_28512":1239,"_19817":50564,"_5":13545,"_25978":50329,"_2758":50565},[],"`aws_config.access_key_id`",{"_3268":1318,"_28512":1239,"_19817":50567,"_5":13545,"_25978":50329,"_2758":23674},[],{"_3268":1319,"_28512":1239,"_19817":50569,"_5":13545,"_25978":50329,"_2758":50570},[],"Only with `auth_method=static`",{"_3268":1320,"_28512":1239,"_19817":50572,"_5":13545,"_25978":50329,"_2758":50573},[],"AWS access key.",{"_3268":1321,"_28512":1239,"_19817":50575,"_5":13545,"_25978":50329,"_2758":50576},[],"`aws_config.secret_access_key`",{"_3268":1322,"_28512":1239,"_19817":50578,"_5":13545,"_25978":50329,"_2758":23674},[],{"_3268":1323,"_28512":1239,"_19817":50580,"_5":13545,"_25978":50329,"_2758":50570},[],{"_3268":1324,"_28512":1239,"_19817":50582,"_5":13545,"_25978":50329,"_2758":50583},[],"AWS secret key.",{"_3268":1325,"_28512":1239,"_19817":50585,"_5":13545,"_25978":50329,"_2758":50586},[],"`aws_config.session_token`",{"_3268":1326,"_28512":1239,"_19817":50588,"_5":13545,"_25978":50329,"_2758":23674},[],{"_3268":1327,"_28512":1239,"_19817":50590,"_5":13545,"_25978":50329,"_2758":50591},[],"No",{"_3268":1328,"_28512":1239,"_19817":50593,"_5":13545,"_25978":50329,"_2758":50594},[],"Session token (with `auth_method=static`).",{"_3268":1329,"_28512":1239,"_19817":50596,"_5":13545,"_25978":50329,"_2758":50597},[],"`aws_config.role_arn`",{"_3268":1330,"_28512":1239,"_19817":50599,"_5":13545,"_25978":50329,"_2758":23674},[],{"_3268":1331,"_28512":1239,"_19817":50601,"_5":13545,"_25978":50329,"_2758":50602},[],"Only with `auth_method=role`",{"_3268":1332,"_28512":1239,"_19817":50604,"_5":13545,"_25978":50329,"_2758":50605},[],"ARN of the role to assume.",{"_3268":1333,"_28512":1239,"_19817":50607,"_5":13545,"_25978":50329,"_2758":50608},[],"`aws_config.endpoint_url`",{"_3268":1334,"_28512":1239,"_19817":50610,"_5":13545,"_25978":50329,"_2758":23674},[],{"_3268":1335,"_28512":1239,"_19817":50612,"_5":13545,"_25978":50329,"_2758":50591},[],{"_3268":1336,"_28512":1239,"_19817":50614,"_5":13545,"_25978":50329,"_2758":50615},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3268":1337,"_28512":1239,"_19817":50617,"_5":13545,"_25978":50329,"_2758":50618},[],"`subscriber_event_bus`",{"_3268":1338,"_28512":1239,"_19817":50620,"_5":13545,"_25978":50329,"_2758":16632},[],{"_3268":1339,"_28512":1239,"_19817":50622,"_5":13545,"_25978":50329,"_2758":50539},[],{"_3268":1340,"_28512":1239,"_19817":50624,"_5":13545,"_25978":50329,"_2758":50625},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3268":1341,"_28512":1239,"_19817":50627,"_5":13545,"_25978":50329,"_2758":50628},[],"`dms_manager_client`",{"_3268":1342,"_28512":1239,"_19817":50630,"_5":13545,"_25978":50329,"_2758":23674},[],{"_3268":1343,"_28512":1239,"_19817":50632,"_5":13545,"_25978":50329,"_2758":50539},[],{"_3268":1344,"_28512":1239,"_19817":50634,"_5":13545,"_25978":50329,"_2758":50635},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3268":1345,"_28512":1239,"_19817":50637,"_5":13545,"_25978":50329,"_2758":50638},[],"`device_manager_client`",{"_3268":1346,"_28512":1239,"_19817":50640,"_5":13545,"_25978":50329,"_2758":23674},[],{"_3268":1347,"_28512":1239,"_19817":50642,"_5":13545,"_25978":50329,"_2758":50539},[],{"_3268":1348,"_28512":1239,"_19817":50644,"_5":13545,"_25978":50329,"_2758":50645},[],"HTTP URL of Lamassu's Device Manager.",{"_3268":1349,"_28512":1239,"_19817":50647,"_5":13545,"_25978":50329,"_2758":50648},[],"`ca_client`",{"_3268":1350,"_28512":1239,"_19817":50650,"_5":13545,"_25978":50329,"_2758":23674},[],{"_3268":1351,"_28512":1239,"_19817":50652,"_5":13545,"_25978":50329,"_2758":50539},[],{"_3268":1352,"_28512":1239,"_19817":50654,"_5":13545,"_25978":50329,"_2758":50655},[],"HTTP URL of Lamassu's CA service.",{"_3268":1353,"_28512":1239,"_19817":50657,"_5":13545,"_25978":50333,"_2758":50658},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each transition performs. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3268":1354,"_28512":1239,"_19817":50660,"_5":13545,"_25978":50337,"_2758":50661},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3268":1355,"_28512":1239,"_19817":50663,"_5":13545,"_25978":50337,"_2758":50664},[],"CloudEvent type",{"_3268":1356,"_28512":1239,"_19817":50666,"_5":13545,"_25978":50337,"_2758":50667},[],"Lamassu resource",{"_3268":1357,"_28512":1239,"_19817":50669,"_5":13545,"_25978":50337,"_2758":50670},[],"AWS Resource",{"_3268":1358,"_28512":1239,"_19817":50672,"_5":13545,"_25978":50337,"_2758":50673},[],"IAM actions",{"_3268":1359,"_28512":1239,"_19817":50675,"_5":13545,"_25978":50337,"_2758":50676},[],"AWS calls and effect",{"_3268":1360,"_28512":1239,"_19817":50678,"_5":13545,"_25978":50337,"_2758":50679},[],"Where in this page",{"_3268":1361,"_28512":1239,"_19817":50681,"_5":13545,"_25978":50337,"_2758":50682},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3268":1362,"_28512":1239,"_19817":50684,"_5":13545,"_25978":50337,"_2758":50685},[],"CA",{"_3268":1363,"_28512":1239,"_19817":50687,"_5":13545,"_25978":50337,"_2758":50688},[],"`IoTCore/CACertificate`",{"_3268":1364,"_28512":1239,"_19817":50690,"_5":13545,"_25978":50337,"_2758":50691},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3268":1365,"_28512":1239,"_19817":50693,"_5":13545,"_25978":50337,"_2758":50694},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3268":1366,"_28512":1239,"_19817":50696,"_5":13545,"_25978":50337,"_2758":50342},[],{"_3268":1367,"_28512":1239,"_19817":50698,"_5":13545,"_25978":50337,"_2758":50699},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3268":1368,"_28512":1239,"_19817":50701,"_5":13545,"_25978":50337,"_2758":50702},[],"DMS",{"_3268":1369,"_28512":1239,"_19817":50704,"_5":13545,"_25978":50337,"_2758":50705},[],"`IoTCore/ProvisioningTemplate`",{"_3268":1370,"_28512":1239,"_19817":50707,"_5":13545,"_25978":50337,"_2758":50708},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3268":1371,"_28512":1239,"_19817":50710,"_5":13545,"_25978":50337,"_2758":50711},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3268":1372,"_28512":1239,"_19817":50713,"_5":13545,"_25978":50337,"_2758":50346},[],{"_3268":1373,"_28512":1239,"_19817":50715,"_5":13545,"_25978":50337,"_2758":50716},[],"`EventBindDeviceIdentityKey`",{"_3268":1374,"_28512":1239,"_19817":50718,"_5":13545,"_25978":50337,"_2758":50719},[],"Device",{"_3268":1375,"_28512":1239,"_19817":50721,"_5":13545,"_25978":50337,"_2758":50722},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3268":1376,"_28512":1239,"_19817":50724,"_5":13545,"_25978":50337,"_2758":50725},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3268":1377,"_28512":1239,"_19817":50727,"_5":13545,"_25978":50337,"_2758":50728},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3268":1378,"_28512":1239,"_19817":50730,"_5":13545,"_25978":50337,"_2758":50354},[],{"_3268":1379,"_28512":1239,"_19817":50732,"_5":13545,"_25978":50337,"_2758":50733},[],"`EventUpdateCertificateStatusKey`",{"_3268":1380,"_28512":1239,"_19817":50735,"_5":13545,"_25978":50337,"_2758":50736},[],"Certificate",{"_3268":1381,"_28512":1239,"_19817":50738,"_5":13545,"_25978":50337,"_2758":50739},[],"`IoTCore/Certificate`",{"_3268":1382,"_28512":1239,"_19817":50741,"_5":13545,"_25978":50337,"_2758":50742},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3268":1383,"_28512":1239,"_19817":50744,"_5":13545,"_25978":50337,"_2758":50745},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3268":1384,"_28512":1239,"_19817":50747,"_5":13545,"_25978":50337,"_2758":50350},[],{"_3268":1385,"_28512":1239,"_19817":50749,"_5":13545,"_25978":50337,"_2758":50750},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3268":1386,"_28512":1239,"_19817":50752,"_5":13545,"_25978":50337,"_2758":50753},[],"Certificate / Device",{"_3268":1387,"_28512":1239,"_19817":50755,"_5":13545,"_25978":50337,"_2758":50756},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3268":1388,"_28512":1239,"_19817":50758,"_5":13545,"_25978":50337,"_2758":46843},[],{"_3268":1389,"_28512":1239,"_19817":50760,"_5":13545,"_25978":50337,"_2758":50761},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3268":1390,"_28512":1239,"_19817":50763,"_5":13545,"_25978":50337,"_2758":50406},[],{"_3268":1391,"_28512":1239,"_19817":50765,"_5":13545,"_25978":50341,"_2758":50766},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3268":1392,"_28512":1239,"_19817":50768,"_5":13545,"_25978":50341,"_2758":50769},[],"by the `registration.status` field of the CA's connector metadata:",{"_3268":1393,"_28512":1239,"_19817":50771,"_5":13545,"_25978":50341,"_2758":50772},[],"Transition",{"_3268":1394,"_28512":1239,"_19817":50774,"_5":13545,"_25978":50341,"_2758":50775},[],"AWS calls",{"_3268":1395,"_28512":1239,"_19817":50777,"_5":13545,"_25978":50341,"_2758":50778},[],"`NotRegistered` → `Requested`",{"_3268":1396,"_28512":1239,"_19817":50780,"_5":13545,"_25978":50341,"_2758":50781},[],"none (metadata write only)",{"_3268":1397,"_28512":1239,"_19817":50783,"_5":13545,"_25978":50341,"_2758":50784},[],"`Requested` → `Registering`",{"_3268":1398,"_28512":1239,"_19817":50786,"_5":13545,"_25978":50341,"_2758":50787},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3268":1399,"_28512":1239,"_19817":50789,"_5":13545,"_25978":50341,"_2758":50790},[],"`Registering` → `Succeeded`",{"_3268":1400,"_28512":1239,"_19817":50792,"_5":13545,"_25978":50341,"_2758":50793},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3268":1401,"_28512":1239,"_19817":50795,"_5":13545,"_25978":50341,"_2758":50796},[],"`Registering` → `Failed`",{"_3268":1402,"_28512":1239,"_19817":50798,"_5":13545,"_25978":50341,"_2758":50799},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3268":1403,"_28512":1239,"_19817":50801,"_5":13545,"_25978":50341,"_2758":50802},[],"`Failed` / `Succeeded` → `Requested`",{"_3268":1404,"_28512":1239,"_19817":50804,"_5":13545,"_25978":50341,"_2758":50805},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3268":1405,"_28512":1239,"_19817":50807,"_5":13545,"_25978":50345,"_2758":50808},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3268":1406,"_28512":1239,"_19817":50810,"_5":13545,"_25978":50345,"_2758":50772},[],{"_3268":1407,"_28512":1239,"_19817":50812,"_5":13545,"_25978":50345,"_2758":50775},[],{"_3268":1408,"_28512":1239,"_19817":50814,"_5":13545,"_25978":50345,"_2758":50815},[],"`Unconfigured` → `None` / `Auto`",{"_3268":1409,"_28512":1239,"_19817":50817,"_5":13545,"_25978":50345,"_2758":50818},[],"none (configuration only)",{"_3268":1410,"_28512":1239,"_19817":50820,"_5":13545,"_25978":50345,"_2758":50821},[],"`None` ↔ `Auto`",{"_3268":1411,"_28512":1239,"_19817":50823,"_5":13545,"_25978":50345,"_2758":50818},[],{"_3268":1412,"_28512":1239,"_19817":50825,"_5":13545,"_25978":50345,"_2758":50826},[],"Any → `Jitp`",{"_3268":1413,"_28512":1239,"_19817":50828,"_5":13545,"_25978":50345,"_2758":50829},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3268":1414,"_28512":1239,"_19817":50831,"_5":13545,"_25978":50345,"_2758":50832},[],"`Jitp` → `None` / `Auto`",{"_3268":1415,"_28512":1239,"_19817":50834,"_5":13545,"_25978":50345,"_2758":50835},[],"none (the template stays in the AWS account)",{"_3268":1416,"_28512":1239,"_19817":50837,"_5":13545,"_25978":50349,"_2758":50838},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3268":1417,"_28512":1239,"_19817":50840,"_5":13545,"_25978":50349,"_2758":50772},[],{"_3268":1418,"_28512":1239,"_19817":50842,"_5":13545,"_25978":50349,"_2758":50775},[],{"_3268":1419,"_28512":1239,"_19817":50844,"_5":13545,"_25978":50349,"_2758":50845},[],"`NotSynced` → `Active`",{"_3268":1420,"_28512":1239,"_19817":50847,"_5":13545,"_25978":50349,"_2758":50489},[],{"_3268":1421,"_28512":1239,"_19817":50849,"_5":13545,"_25978":50349,"_2758":50850},[],"`Active` → `Inactive`",{"_3268":1422,"_28512":1239,"_19817":50852,"_5":13545,"_25978":50349,"_2758":50853},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3268":1423,"_28512":1239,"_19817":50855,"_5":13545,"_25978":50349,"_2758":50856},[],"`Active` → `Revoked`",{"_3268":1424,"_28512":1239,"_19817":50858,"_5":13545,"_25978":50349,"_2758":50853},[],{"_3268":1425,"_28512":1239,"_19817":50860,"_5":13545,"_25978":50349,"_2758":50861},[],"`Inactive` / `Revoked` → `Active`",{"_3268":1426,"_28512":1239,"_19817":50863,"_5":13545,"_25978":50349,"_2758":50489},[],{"_3268":1427,"_28512":1239,"_19817":50865,"_5":13545,"_25978":50349,"_2758":50866},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3268":1428,"_28512":1239,"_19817":50868,"_5":13545,"_25978":50349,"_2758":50869},[],"none (these states are not synced to AWS)",{"_3268":1429,"_28512":1239,"_19817":50871,"_5":13545,"_25978":50353,"_2758":50872},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3268":1430,"_28512":1239,"_19817":50874,"_5":13545,"_25978":50353,"_2758":50772},[],{"_3268":1431,"_28512":1239,"_19817":50876,"_5":13545,"_25978":50353,"_2758":50775},[],{"_3268":1432,"_28512":1239,"_19817":50878,"_5":13545,"_25978":50353,"_2758":50879},[],"`Absent` → `Provisioned`",{"_3268":1433,"_28512":1239,"_19817":50881,"_5":13545,"_25978":50353,"_2758":50882},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3268":1434,"_28512":1239,"_19817":50884,"_5":13545,"_25978":50353,"_2758":50885},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3268":1435,"_28512":1239,"_19817":50887,"_5":13545,"_25978":50353,"_2758":50888},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3268":1436,"_28512":1239,"_19817":50890,"_5":13545,"_25978":50353,"_2758":50891},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3268":1437,"_28512":1239,"_19817":50893,"_5":13545,"_25978":50357,"_2758":50894},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3268":1438,"_28512":1239,"_19817":50896,"_5":13545,"_25978":50361,"_2758":50897},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3268":1439,"_28512":1239,"_19817":50899,"_5":13545,"_25978":50361,"_2758":50900},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3268":1440,"_28512":1239,"_19817":50902,"_5":13545,"_25978":50365,"_2758":50903},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3268":1441,"_28512":1239,"_19817":50905,"_5":13545,"_25978":50365,"_2758":50906},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3268":1442,"_28512":1239,"_19817":50908,"_5":13545,"_25978":50365,"_2758":50909},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3268":1443,"_28512":1239,"_19817":50911,"_5":13545,"_25978":50365,"_2758":50912},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3268":1444,"_28512":1239,"_19817":50914,"_5":13545,"_25978":50365,"_2758":50915},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3268":1445,"_28512":1239,"_19817":50917,"_5":13545,"_25978":50365,"_2758":50918},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3268":1446,"_28512":1239,"_19817":50920,"_5":13545,"_25978":50369,"_2758":50921},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3268":1447,"_28512":1239,"_19817":50923,"_5":13545,"_25978":50373,"_2758":50924},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3268":1448,"_28512":1239,"_19817":50926,"_5":13545,"_25978":50373,"_2758":50927},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3268":1449,"_28512":1239,"_19817":50929,"_5":13545,"_25978":50377,"_2758":50930},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3268":1450,"_28512":1239,"_19817":50932,"_5":13545,"_25978":50381,"_2758":50933},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3268":1451,"_28512":1239,"_19817":50935,"_5":13545,"_25978":50381,"_2758":50936},[],"Creates or updates the IoT policies configured in the DMS.",{"_3268":1452,"_28512":1239,"_19817":50938,"_5":13545,"_25978":50381,"_2758":50939},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3268":1453,"_28512":1239,"_19817":50941,"_5":13545,"_25978":50381,"_2758":50942},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3268":1454,"_28512":1239,"_19817":50944,"_5":13545,"_25978":50381,"_2758":50945},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3268":1455,"_28512":1239,"_19817":50947,"_5":13545,"_25978":50381,"_2758":50948},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3268":1456,"_28512":1239,"_19817":50950,"_5":13545,"_25978":50381,"_2758":50951},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3268":1457,"_28512":1239,"_19817":50953,"_5":13545,"_25978":50385,"_2758":50954},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3268":1458,"_28512":1239,"_19817":50956,"_5":13545,"_25978":50385,"_2758":50957},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3268":1459,"_28512":1239,"_19817":50959,"_5":13545,"_25978":50385,"_2758":50960},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3268":1460,"_28512":1239,"_19817":50962,"_5":13545,"_25978":50389,"_2758":50963},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3268":1461,"_28512":1239,"_19817":50965,"_5":13545,"_25978":50389,"_2758":50966},[],"The full flow from the device's perspective is:",{"_3268":1462,"_28512":1239,"_19817":50968,"_5":13545,"_25978":50389,"_2758":50969},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3268":1463,"_28512":1239,"_19817":50971,"_5":13545,"_25978":50393,"_2758":50972},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3268":1464,"_28512":1239,"_19817":50974,"_5":13545,"_25978":50393,"_2758":50975},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3268":1465,"_28512":1239,"_19817":50977,"_5":13545,"_25978":50393,"_2758":50978},[],"For the JITP flow to work correctly:",{"_3268":1466,"_28512":1239,"_19817":50980,"_5":13545,"_25978":50393,"_2758":50981},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3268":1467,"_28512":1239,"_19817":50983,"_5":13545,"_25978":50393,"_2758":50984},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3268":1468,"_28512":1239,"_19817":50986,"_5":13545,"_25978":50393,"_2758":50987},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3268":1469,"_28512":1239,"_19817":50989,"_5":13545,"_25978":50393,"_2758":50990},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3268":1470,"_28512":1239,"_19817":50992,"_5":13545,"_25978":50397,"_2758":50993},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3268":1471,"_28512":1239,"_19817":50995,"_5":13545,"_25978":50397,"_2758":50996},[],"Status in Lamassu",{"_3268":1472,"_28512":1239,"_19817":50998,"_5":13545,"_25978":50397,"_2758":50999},[],"Revocation reason",{"_3268":1473,"_28512":1239,"_19817":51001,"_5":13545,"_25978":50397,"_2758":51002},[],"Status in AWS IoT Core",{"_3268":1474,"_28512":1239,"_19817":51004,"_5":13545,"_25978":50397,"_2758":51005},[],"`Active`",{"_3268":1475,"_28512":1239,"_19817":51007,"_5":13545,"_25978":50397,"_2758":51008},[],"None",{"_3268":1476,"_28512":1239,"_19817":51010,"_5":13545,"_25978":50397,"_2758":51011},[],"`ACTIVE`",{"_3268":1477,"_28512":1239,"_19817":51013,"_5":13545,"_25978":50397,"_2758":51014},[],"`Revoked`",{"_3268":1478,"_28512":1239,"_19817":51016,"_5":13545,"_25978":50397,"_2758":51017},[],"`certificateHold`",{"_3268":1479,"_28512":1239,"_19817":51019,"_5":13545,"_25978":50397,"_2758":51020},[],"`INACTIVE`",{"_3268":1480,"_28512":1239,"_19817":51022,"_5":13545,"_25978":50397,"_2758":51014},[],{"_3268":1481,"_28512":1239,"_19817":51024,"_5":13545,"_25978":50397,"_2758":51025},[],"Any other reason",{"_3268":1482,"_28512":1239,"_19817":51027,"_5":13545,"_25978":50397,"_2758":51028},[],"`REVOKED`",{"_3268":1483,"_28512":1239,"_19817":51030,"_5":13545,"_25978":50397,"_2758":51031},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3268":1484,"_28512":1239,"_19817":51033,"_5":13545,"_25978":50401,"_2758":51034},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3268":1485,"_28512":1239,"_19817":51036,"_5":13545,"_25978":50401,"_2758":51037},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3268":1486,"_28512":1239,"_19817":51039,"_5":13545,"_25978":50401,"_2758":51040},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3268":1487,"_28512":1239,"_19817":51042,"_5":13545,"_25978":50405,"_2758":51043},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3268":1488,"_28512":1239,"_19817":51045,"_5":13545,"_25978":50405,"_2758":51046},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3268":1489,"_28512":1239,"_19817":51048,"_5":13545,"_25978":50409,"_2758":51049},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3268":1490,"_28512":1239,"_19817":51051,"_5":13545,"_25978":50409,"_2758":51052},[],"There are two action types:",{"_3268":1491,"_28512":1239,"_19817":51054,"_5":13545,"_25978":50409,"_2758":51055},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3268":1492,"_28512":1239,"_19817":51057,"_5":13545,"_25978":50409,"_2758":51058},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3268":1493,"_28512":1239,"_19817":51060,"_5":13545,"_25978":50409,"_2758":51061},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3268":1494,"_28512":1239,"_19817":51063,"_5":13545,"_25978":50413,"_2758":51064},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3268":1495,"_28512":1239,"_19817":51066,"_5":13545,"_25978":50413,"_2758":51067},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3268":1496,"_28512":1239,"_19817":51069,"_5":13545,"_25978":50413,"_2758":51070},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3268":1497,"_28512":1239,"_19817":51072,"_5":13545,"_25978":50417,"_2758":51073},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3268":1498,"_28512":1239,"_19817":51075,"_5":13545,"_25978":50417,"_2758":51076},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3268":1499,"_28512":1239,"_19817":51078,"_5":13545,"_25978":50417,"_2758":51079},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3268":1500,"_28512":1239,"_19817":51081,"_5":13545,"_25978":50417,"_2758":51082},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3268":1501,"_28512":1239,"_19817":51084,"_5":13545,"_25978":50417,"_2758":51085},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3268":1502,"_28512":1239,"_19817":51087,"_5":13545,"_25978":50417,"_2758":51088},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3268":1503,"_28512":1239,"_19817":51090,"_5":13545,"_25978":50417,"_2758":51091},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3268":1504,"_28512":1239,"_19817":51093,"_5":13545,"_25978":50417,"_2758":51094},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3268":1505,"_28512":1239,"_19817":51096,"_5":13545,"_25978":50417,"_2758":51097},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3268":1506,"_28512":1239,"_19817":51099,"_5":13545,"_25978":50417,"_2758":51100},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3268":1507,"_28512":1239,"_19817":51102,"_5":13545,"_25978":50417,"_2758":51103},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3268":1508,"_28512":1239,"_19817":51105,"_5":13545,"_25978":50417,"_2758":51106},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3268":1509,"_28512":1239,"_19817":51108,"_5":13545,"_25978":50417,"_2758":51109},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3268":1510,"_28512":1239,"_19817":51111,"_5":13545,"_25978":50417,"_2758":51112},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3268":1511,"_28512":1239,"_19817":51114,"_5":13545,"_25978":50417,"_2758":51115},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3268":1512,"_28512":1239,"_19817":51117,"_5":13545,"_25978":50417,"_2758":51118},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3268":1513,"_28512":1239,"_19817":51120,"_5":13545,"_25978":50417,"_2758":51121},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3268":1514,"_28512":1239,"_19817":51123,"_5":13545,"_25978":50417,"_2758":51124},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3268":1515,"_28512":1239,"_19817":51126,"_5":13545,"_25978":50417,"_2758":51127},[],"**Symptom:** After editing a DMS in `jitp` mode, messages about that DMS update appear in the `lamassu-dlq` poison queue.",{"_3268":1516,"_28512":1239,"_19817":51129,"_5":13545,"_25978":50417,"_2758":51130},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`.",{"_3268":1517,"_28512":1239,"_19817":51132,"_5":13545,"_25978":50417,"_2758":51133},[],"**Resolution:** Verify the template named after the DMS ID still exists in AWS IoT Core and that JITP enrollment works. The `lamassu-dlq` message reflects the failed re-creation attempt, not a broken JITP flow.",{"_3268":1518,"_28512":1239,"_19817":51135,"_5":13545,"_25978":50417,"_2758":51136},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3268":1519,"_28512":1239,"_19817":51138,"_5":13545,"_25978":50417,"_2758":51139},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3268":1520,"_28512":1239,"_19817":51141,"_5":13545,"_25978":50417,"_2758":51142},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3268":1521,"_28512":1521,"_5":13876,"_2758":48848,"_28855":51144,"_19817":51145,"_25978":1521},[46447,47840,48848],[],{"_3268":1522,"_28512":1521,"_19817":51147,"_5":13545,"_25978":1521,"_2758":51148},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3268":1523,"_28512":1521,"_5":28852,"_19817":51150,"_25978":51151,"_2758":51152},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#start-here","Start here",{"_3268":1524,"_28512":1521,"_5":28852,"_19817":51154,"_25978":51155,"_2758":48846},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#devices-and-identities",{"_3268":1525,"_28512":1521,"_5":28852,"_19817":51157,"_25978":51158,"_2758":49029},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#enrollment-with-pki",{"_3268":1526,"_28512":1521,"_5":28852,"_19817":51160,"_25978":51161,"_2758":50310},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#integrations",{"_3268":1527,"_28512":1521,"_5":28852,"_19817":51163,"_25978":51164,"_2758":51165},[],"/docs/pr-preview/pr-43/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3268":1528,"_28512":1521,"_19817":51167,"_5":13545,"_25978":1521,"_2758":51168},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3268":1529,"_28512":1521,"_19817":51170,"_5":13545,"_25978":51151,"_2758":51171},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3268":1530,"_28512":1521,"_19817":51173,"_5":13545,"_25978":51151,"_2758":51174},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3268":1531,"_28512":1521,"_19817":51176,"_5":13545,"_25978":51155,"_2758":51177},[],"Resource",{"_3268":1532,"_28512":1521,"_19817":51179,"_5":13545,"_25978":51155,"_2758":51180},[],"What it represents",{"_3268":1533,"_28512":1521,"_19817":51182,"_5":13545,"_25978":51155,"_2758":51183},[],"**Device**",{"_3268":1534,"_28512":1521,"_19817":51185,"_5":13545,"_25978":51155,"_2758":51186},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3268":1535,"_28512":1521,"_19817":51188,"_5":13545,"_25978":51155,"_2758":51189},[],"**Identity**",{"_3268":1536,"_28512":1521,"_19817":51191,"_5":13545,"_25978":51155,"_2758":51192},[],"The device's association with its certificates: an active version and a history.",{"_3268":1537,"_28512":1521,"_19817":51194,"_5":13545,"_25978":51155,"_2758":51195},[],"**DMS**",{"_3268":1538,"_28512":1521,"_19817":51197,"_5":13545,"_25978":51155,"_2758":51198},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3268":1539,"_28512":1521,"_19817":51200,"_5":13545,"_25978":51155,"_2758":51201},[],"**Fleet**",{"_3268":1540,"_28512":1521,"_19817":51203,"_5":13545,"_25978":51155,"_2758":51204},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3268":1541,"_28512":1521,"_19817":51206,"_5":13545,"_25978":51155,"_2758":51207},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3268":1542,"_28512":1521,"_19817":51209,"_5":13545,"_25978":51155,"_2758":51210},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3268":1543,"_28512":1521,"_19817":51212,"_5":13545,"_25978":51158,"_2758":51213},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3268":1544,"_28512":1521,"_19817":51215,"_5":13545,"_25978":51158,"_2758":51216},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3268":1545,"_28512":1521,"_19817":51218,"_5":13545,"_25978":51158,"_2758":51219},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3268":1546,"_28512":1521,"_19817":51221,"_5":13545,"_25978":51158,"_2758":51222},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3268":1547,"_28512":1521,"_19817":51224,"_5":13545,"_25978":51158,"_2758":51225},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3268":1548,"_28512":1521,"_19817":51227,"_5":13545,"_25978":51158,"_2758":51228},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3268":1549,"_28512":1521,"_19817":51230,"_5":13545,"_25978":51158,"_2758":51231},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3268":1550,"_28512":1521,"_19817":51233,"_5":13545,"_25978":51158,"_2758":51234},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3268":1551,"_28512":1521,"_19817":51236,"_5":13545,"_25978":51161,"_2758":51237},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3268":1552,"_28512":1521,"_19817":51239,"_5":13545,"_25978":51161,"_2758":51240},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3268":1553,"_28512":1521,"_19817":51242,"_5":13545,"_25978":51164,"_2758":51243},[],"Participant",{"_3268":1554,"_28512":1521,"_19817":51245,"_5":13545,"_25978":51164,"_2758":51246},[],"Responsibility",{"_3268":1555,"_28512":1521,"_19817":51248,"_5":13545,"_25978":51164,"_2758":51249},[],"PKI administrator",{"_3268":1556,"_28512":1521,"_19817":51251,"_5":13545,"_25978":51164,"_2758":51252},[],"CA, issuance profile, chain and revocation publication.",{"_3268":1557,"_28512":1521,"_19817":51254,"_5":13545,"_25978":51164,"_2758":51255},[],"Provisioning administrator",{"_3268":1558,"_28512":1521,"_19817":51257,"_5":13545,"_25978":51164,"_2758":51258},[],"DMS, admission, authentication per operation and inventory.",{"_3268":1559,"_28512":1521,"_19817":51260,"_5":13545,"_25978":51164,"_2758":51261},[],"Device integrator",{"_3268":1560,"_28512":1521,"_19817":51263,"_5":13545,"_25978":51164,"_2758":51264},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3268":1561,"_28512":1521,"_19817":51266,"_5":13545,"_25978":51164,"_2758":51267},[],"Consumer integrator",{"_3268":1562,"_28512":1521,"_19817":51269,"_5":13545,"_25978":51164,"_2758":51270},[],"Trusted issuers, validation and device permissions in the destination.",{"_3268":1563,"_28512":1521,"_19817":51272,"_5":13545,"_25978":51164,"_2758":51273},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3268":1564,"_28512":1564,"_5":13876,"_2758":51275,"_28855":51276,"_19817":51278,"_25978":1564},"Enroll and connect your first device",[46447,47840,48848,51277],"Getting started",[],{"_3268":1565,"_28512":1564,"_19817":51280,"_5":13545,"_25978":1564,"_2758":51281},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3268":1566,"_28512":1564,"_5":28852,"_19817":51283,"_25978":51284,"_2758":46457},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3268":1567,"_28512":1564,"_5":28852,"_19817":51286,"_25978":51287,"_2758":51288},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3268":1568,"_28512":1564,"_5":28852,"_19817":51290,"_25978":51291,"_2758":51292},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3268":1569,"_28512":1564,"_5":28852,"_19817":51294,"_25978":51295,"_2758":51296},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3268":1570,"_28512":1564,"_5":28852,"_19817":51298,"_25978":51299,"_2758":51300},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3268":1571,"_28512":1564,"_5":28852,"_19817":51302,"_25978":51303,"_2758":51304},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3268":1572,"_28512":1564,"_5":28852,"_19817":51306,"_25978":51307,"_2758":51308},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3268":1573,"_28512":1564,"_5":28852,"_19817":51310,"_25978":51311,"_2758":51312},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3268":1574,"_28512":1564,"_19817":51314,"_5":13545,"_25978":1564,"_2758":51315},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3268":1575,"_28512":1564,"_19817":51317,"_5":13545,"_25978":51284,"_2758":51318},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3268":1576,"_28512":1564,"_19817":51320,"_5":13545,"_25978":51284,"_2758":51321},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3268":1577,"_28512":1564,"_19817":51323,"_5":13545,"_25978":51284,"_2758":51324},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3268":1578,"_28512":1564,"_19817":51326,"_5":13545,"_25978":51284,"_2758":51327},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3268":1579,"_28512":1564,"_19817":51329,"_5":13545,"_25978":51284,"_2758":51330},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3268":1580,"_28512":1564,"_19817":51332,"_5":13545,"_25978":51287,"_2758":51333},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3268":1581,"_28512":1564,"_19817":51335,"_5":13545,"_25978":51287,"_2758":51336},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3268":1582,"_28512":1564,"_19817":51338,"_5":13545,"_25978":51291,"_2758":51339},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3268":1583,"_28512":1564,"_19817":51341,"_5":13545,"_25978":51291,"_2758":51342},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3268":1584,"_28512":1564,"_19817":51344,"_5":13545,"_25978":51291,"_2758":51345},[],"Setting",{"_3268":1585,"_28512":1564,"_19817":51347,"_5":13545,"_25978":51291,"_2758":51348},[],"Evaluation value",{"_3268":1586,"_28512":1564,"_19817":51350,"_5":13545,"_25978":51291,"_2758":51351},[],"Enrollment CA",{"_3268":1587,"_28512":1564,"_19817":51353,"_5":13545,"_25978":51291,"_2758":51354},[],"Issuing root from `device-root.pem`.",{"_3268":1588,"_28512":1564,"_19817":51356,"_5":13545,"_25978":51291,"_2758":49159},[],{"_3268":1589,"_28512":1564,"_19817":51358,"_5":13545,"_25978":51291,"_2758":51359},[],"The 1-hour leaf profile you just prepared.",{"_3268":1590,"_28512":1564,"_19817":51361,"_5":13545,"_25978":51291,"_2758":51362},[],"Protocol / Registration Mode",{"_3268":1591,"_28512":1564,"_19817":51364,"_5":13545,"_25978":51291,"_2758":51365},[],"`EST_RFC7030` / `JITP`.",{"_3268":1592,"_28512":1564,"_19817":51367,"_5":13545,"_25978":51291,"_2758":51368},[],"Verify CSR Signature",{"_3268":1593,"_28512":1564,"_19817":51370,"_5":13545,"_25978":51291,"_2758":51371},[],"Enabled.",{"_3268":1594,"_28512":1564,"_19817":51373,"_5":13545,"_25978":51291,"_2758":51374},[],"Enable Replaceable Enrollment",{"_3268":1595,"_28512":1564,"_19817":51376,"_5":13545,"_25978":51291,"_2758":51377},[],"Disabled; the ID must be new.",{"_3268":1596,"_28512":1564,"_19817":51379,"_5":13545,"_25978":51291,"_2758":51380},[],"Initial authentication",{"_3268":1597,"_28512":1564,"_19817":51382,"_5":13545,"_25978":51291,"_2758":51383},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3268":1598,"_28512":1564,"_19817":51385,"_5":13545,"_25978":51291,"_2758":51386},[],"Renewal authentication",{"_3268":1599,"_28512":1564,"_19817":51388,"_5":13545,"_25978":51291,"_2758":51389},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3268":1600,"_28512":1564,"_19817":51391,"_5":13545,"_25978":51291,"_2758":51392},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3268":1601,"_28512":1564,"_19817":51394,"_5":13545,"_25978":51291,"_2758":51395},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3268":1602,"_28512":1564,"_19817":51397,"_5":13545,"_25978":51291,"_2758":51398},[],"Re-enrollment Delta",{"_3268":1603,"_28512":1564,"_19817":51400,"_5":13545,"_25978":51291,"_2758":51401},[],"1 hour.",{"_3268":1604,"_28512":1564,"_19817":51403,"_5":13545,"_25978":51291,"_2758":51404},[],"Preventive / Critical Delta",{"_3268":1605,"_28512":1564,"_19817":51406,"_5":13545,"_25978":51291,"_2758":51407},[],"30 minutes / 10 minutes.",{"_3268":1606,"_28512":1564,"_19817":51409,"_5":13545,"_25978":51291,"_2758":51410},[],"Revoke on Re-enrollment",{"_3268":1607,"_28512":1564,"_19817":51412,"_5":13545,"_25978":51291,"_2758":51413},[],"Disabled to test the successor before retiring the previous identity.",{"_3268":1608,"_28512":1564,"_19817":51415,"_5":13545,"_25978":51291,"_2758":49167},[],{"_3268":1609,"_28512":1564,"_19817":51417,"_5":13545,"_25978":51291,"_2758":51418},[],"Disabled; the operational key is generated in the client.",{"_3268":1610,"_28512":1564,"_19817":51420,"_5":13545,"_25978":51291,"_2758":51421},[],"CA Distribution",{"_3268":1611,"_28512":1564,"_19817":51423,"_5":13545,"_25978":51291,"_2758":51424},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3268":1612,"_28512":1564,"_19817":51426,"_5":13545,"_25978":51291,"_2758":51427},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3268":1613,"_28512":1564,"_19817":51429,"_5":13545,"_25978":51295,"_2758":51430},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3268":1614,"_28512":1564,"_19817":51432,"_5":13545,"_25978":51295,"_2758":51433},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3268":1615,"_28512":1564,"_19817":51435,"_5":13545,"_25978":51299,"_2758":51436},[],"Generate a new key and CSR with the selected identifier:",{"_3268":1616,"_28512":1564,"_19817":51438,"_5":13545,"_25978":51299,"_2758":51439},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3268":1617,"_28512":1564,"_19817":51441,"_5":13545,"_25978":51299,"_2758":51442},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3268":1618,"_28512":1564,"_19817":51444,"_5":13545,"_25978":51303,"_2758":51445},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3268":1619,"_28512":1564,"_19817":51447,"_5":13545,"_25978":51303,"_2758":51448},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3268":1620,"_28512":1564,"_19817":51450,"_5":13545,"_25978":51307,"_2758":51451},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3268":1621,"_28512":1564,"_19817":51453,"_5":13545,"_25978":51307,"_2758":51454},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3268":1622,"_28512":1564,"_19817":51456,"_5":13545,"_25978":51307,"_2758":51457},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3268":1623,"_28512":1564,"_19817":51459,"_5":13545,"_25978":51307,"_2758":51460},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3268":1624,"_28512":1564,"_19817":51462,"_5":13545,"_25978":51307,"_2758":51463},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3268":1625,"_28512":1564,"_19817":51465,"_5":13545,"_25978":51311,"_2758":51466},[],"Check",{"_3268":1626,"_28512":1564,"_19817":51468,"_5":13545,"_25978":51311,"_2758":51469},[],"Expected result",{"_3268":1627,"_28512":1564,"_19817":51471,"_5":13545,"_25978":51311,"_2758":51472},[],"Registration",{"_3268":1628,"_28512":1564,"_19817":51474,"_5":13545,"_25978":51311,"_2758":51475},[],"ID created automatically and correct DMS.",{"_3268":1629,"_28512":1564,"_19817":51477,"_5":13545,"_25978":51311,"_2758":50736},[],{"_3268":1630,"_28512":1564,"_19817":51479,"_5":13545,"_25978":51311,"_2758":51480},[],"CN, profile, serial and key verified.",{"_3268":1631,"_28512":1564,"_19817":51482,"_5":13545,"_25978":51311,"_2758":51483},[],"Inventory",{"_3268":1632,"_28512":1564,"_19817":51485,"_5":13545,"_25978":51311,"_2758":51486},[],"Received serial visible as the current identity and in history.",{"_3268":1633,"_28512":1564,"_19817":51488,"_5":13545,"_25978":51311,"_2758":51489},[],"Consumer",{"_3268":1634,"_28512":1564,"_19817":51491,"_5":13545,"_25978":51311,"_2758":51492},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3268":1635,"_28512":1564,"_19817":51494,"_5":13545,"_25978":51311,"_2758":51495},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3268":1636,"_28512":1564,"_19817":51497,"_5":13545,"_25978":51311,"_2758":51498},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3268":1637,"_28512":1637,"_5":13876,"_2758":48864,"_28855":51500,"_19817":51501,"_25978":1637},[46447,47840,48848,51277],[],{"_3268":1638,"_28512":1637,"_19817":51503,"_5":13545,"_25978":1637,"_2758":51504},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3268":1639,"_28512":1637,"_5":28852,"_19817":51506,"_25978":51507,"_2758":46457},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3268":1640,"_28512":1637,"_5":28852,"_19817":51509,"_25978":51510,"_2758":51511},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3268":1641,"_28512":1637,"_5":28852,"_19817":51513,"_25978":51514,"_2758":51515},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3268":1642,"_28512":1637,"_5":28852,"_19817":51517,"_25978":51518,"_2758":51519},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3268":1643,"_28512":1637,"_5":28852,"_19817":51521,"_25978":51522,"_2758":51523},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3268":1644,"_28512":1637,"_5":28852,"_19817":51525,"_25978":51526,"_2758":51527},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3268":1645,"_28512":1637,"_5":28852,"_19817":51529,"_25978":51530,"_2758":51469},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3268":1646,"_28512":1637,"_5":28852,"_19817":51532,"_25978":51533,"_2758":51534},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3268":1647,"_28512":1637,"_5":28852,"_19817":51536,"_25978":51537,"_2758":51538},[],"/docs/pr-preview/pr-43/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3268":1648,"_28512":1637,"_19817":51540,"_5":13545,"_25978":1637,"_2758":51541},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3268":1649,"_28512":1637,"_19817":51543,"_5":13545,"_25978":1637,"_2758":51544},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3268":1650,"_28512":1637,"_19817":51546,"_5":13545,"_25978":51507,"_2758":51547},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3268":1651,"_28512":1637,"_19817":51549,"_5":13545,"_25978":51507,"_2758":51550},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3268":1652,"_28512":1637,"_19817":51552,"_5":13545,"_25978":51507,"_2758":51553},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3268":1653,"_28512":1637,"_19817":51555,"_5":13545,"_25978":51507,"_2758":51556},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3268":1654,"_28512":1637,"_19817":51558,"_5":13545,"_25978":51510,"_2758":51559},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3268":1655,"_28512":1637,"_19817":51561,"_5":13545,"_25978":51510,"_2758":51562},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3268":1656,"_28512":1637,"_19817":51564,"_5":13545,"_25978":51510,"_2758":51565},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3268":1657,"_28512":1637,"_19817":51567,"_5":13545,"_25978":51510,"_2758":51568},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3268":1658,"_28512":1637,"_19817":51570,"_5":13545,"_25978":51510,"_2758":51571},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3268":1659,"_28512":1637,"_19817":51573,"_5":13545,"_25978":51510,"_2758":51574},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3268":1660,"_28512":1637,"_19817":51576,"_5":13545,"_25978":51510,"_2758":51577},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3268":1661,"_28512":1637,"_19817":51579,"_5":13545,"_25978":51510,"_2758":51580},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3268":1662,"_28512":1637,"_19817":51582,"_5":13545,"_25978":51514,"_2758":51583},[],"Open **Managed Devices** and the registration action. Complete:",{"_3268":1663,"_28512":1637,"_19817":51585,"_5":13545,"_25978":51514,"_2758":51586},[],"**Device ID**: `device-001`.",{"_3268":1664,"_28512":1637,"_19817":51588,"_5":13545,"_25978":51514,"_2758":51589},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3268":1665,"_28512":1637,"_19817":51591,"_5":13545,"_25978":51514,"_2758":51592},[],"**Icon** and **Tags**: optional classification.",{"_3268":1666,"_28512":1637,"_19817":51594,"_5":13545,"_25978":51514,"_2758":51595},[],"Confirm registration.",{"_3268":1667,"_28512":1637,"_19817":51597,"_5":13545,"_25978":51518,"_2758":51598},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3268":1668,"_28512":1637,"_19817":51600,"_5":13545,"_25978":51518,"_2758":51601},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3268":1669,"_28512":1637,"_19817":51603,"_5":13545,"_25978":51522,"_2758":51604},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3268":1670,"_28512":1637,"_19817":51606,"_5":13545,"_25978":51522,"_2758":51607},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3268":1671,"_28512":1637,"_19817":51609,"_5":13545,"_25978":51526,"_2758":51610},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3268":1672,"_28512":1637,"_19817":51612,"_5":13545,"_25978":51526,"_2758":51613},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3268":1673,"_28512":1637,"_19817":51615,"_5":13545,"_25978":51530,"_2758":51466},[],{"_3268":1674,"_28512":1637,"_19817":51617,"_5":13545,"_25978":51530,"_2758":51618},[],"Result",{"_3268":1675,"_28512":1637,"_19817":51620,"_5":13545,"_25978":51530,"_2758":50719},[],{"_3268":1676,"_28512":1637,"_19817":51622,"_5":13545,"_25978":51530,"_2758":51623},[],"`device-001` appears in inventory with the expected DMS.",{"_3268":1677,"_28512":1637,"_19817":51625,"_5":13545,"_25978":51530,"_2758":51626},[],"Current identity",{"_3268":1678,"_28512":1637,"_19817":51628,"_5":13545,"_25978":51530,"_2758":51629},[],"The associated certificate matches the one you verified in PKI.",{"_3268":1679,"_28512":1637,"_19817":51631,"_5":13545,"_25978":51530,"_2758":51632},[],"History",{"_3268":1680,"_28512":1637,"_19817":51634,"_5":13545,"_25978":51530,"_2758":51635},[],"The associated issuance appears with its serial number and dates.",{"_3268":1681,"_28512":1637,"_19817":51637,"_5":13545,"_25978":51530,"_2758":51638},[],"Key and certificate",{"_3268":1682,"_28512":1637,"_19817":51640,"_5":13545,"_25978":51530,"_2758":51641},[],"You have the verified pair ready to install on the device.",{"_3268":1683,"_28512":1637,"_19817":51643,"_5":13545,"_25978":51533,"_2758":51644},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3268":1684,"_28512":1637,"_19817":51646,"_5":13545,"_25978":51533,"_2758":51647},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3268":1685,"_28512":1637,"_19817":51649,"_5":13545,"_25978":51533,"_2758":51650},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3268":1686,"_28512":1637,"_19817":51652,"_5":13545,"_25978":51533,"_2758":51653},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3268":1687,"_28512":1637,"_19817":51655,"_5":13545,"_25978":51537,"_2758":51656},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3268":1688,"_28512":1637,"_19817":51658,"_5":13545,"_25978":51537,"_2758":51659},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3268":1689,"_28512":1637,"_19817":51661,"_5":13545,"_25978":51537,"_2758":51662},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3268":1690,"_28512":1690,"_5":13876,"_2758":51664,"_28855":51665,"_19817":51666,"_25978":1690},"Lamassu IoT Platform",[46447,47840],[],{"_3268":1691,"_28512":1690,"_19817":51668,"_5":13545,"_25978":1690,"_2758":51669},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3268":1692,"_28512":1690,"_5":28852,"_19817":51671,"_25978":51672,"_2758":51152},[],"/docs/pr-preview/pr-43/platform/overview#start-here",{"_3268":1693,"_28512":1690,"_5":28852,"_19817":51674,"_25978":51675,"_2758":51676},[],"/docs/pr-preview/pr-43/platform/overview#choose-your-path","Choose your path",{"_3268":1694,"_28512":1690,"_5":28852,"_19817":51678,"_25978":51679,"_2758":51680},[],"/docs/pr-preview/pr-43/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3268":1695,"_28512":1690,"_5":28852,"_19817":51682,"_25978":51683,"_2758":51684},[],"/docs/pr-preview/pr-43/platform/overview#core-capabilities","Core capabilities",{"_3268":1696,"_28512":1690,"_5":28852,"_19817":51686,"_25978":51687,"_2758":51688},[],"/docs/pr-preview/pr-43/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3268":1697,"_28512":1690,"_5":28852,"_19817":51690,"_25978":51691,"_2758":51692},[],"/docs/pr-preview/pr-43/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3268":1698,"_28512":1690,"_5":28852,"_19817":51694,"_25978":51695,"_2758":51696},[],"/docs/pr-preview/pr-43/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3268":1699,"_28512":1690,"_5":28852,"_19817":51698,"_25978":51699,"_2758":51700},[],"/docs/pr-preview/pr-43/platform/overview#automate-device-identities","Automate device identities",{"_3268":1700,"_28512":1690,"_5":28852,"_19817":51702,"_25978":51703,"_2758":51704},[],"/docs/pr-preview/pr-43/platform/overview#publish-validation-status","Publish validation status",{"_3268":1701,"_28512":1690,"_5":28852,"_19817":51706,"_25978":51707,"_2758":51708},[],"/docs/pr-preview/pr-43/platform/overview#react-to-events","React to events",{"_3268":1702,"_28512":1690,"_5":28852,"_19817":51710,"_25978":51711,"_2758":51712},[],"/docs/pr-preview/pr-43/platform/overview#operational-reference","Operational reference",{"_3268":1703,"_28512":1690,"_19817":51714,"_5":13545,"_25978":1690,"_2758":51715},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3268":1704,"_28512":1690,"_19817":51717,"_5":13545,"_25978":51672,"_2758":51718},[],"Choose the result you need:",{"_3268":1705,"_28512":1690,"_19817":51720,"_5":13545,"_25978":51672,"_2758":51721},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3268":1706,"_28512":1690,"_19817":51723,"_5":13545,"_25978":51672,"_2758":51724},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3268":1707,"_28512":1690,"_19817":51726,"_5":13545,"_25978":51672,"_2758":51727},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3268":1708,"_28512":1690,"_19817":51729,"_5":13545,"_25978":51675,"_2758":51730},[],"Section",{"_3268":1709,"_28512":1690,"_19817":51732,"_5":13545,"_25978":51675,"_2758":51733},[],"What you manage",{"_3268":1710,"_28512":1690,"_19817":51735,"_5":13545,"_25978":51675,"_2758":51736},[],"Entry point",{"_3268":1711,"_28512":1690,"_19817":51738,"_5":13545,"_25978":51675,"_2758":51739},[],"**PKI**",{"_3268":1712,"_28512":1690,"_19817":51741,"_5":13545,"_25978":51675,"_2758":51742},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3268":1713,"_28512":1690,"_19817":51744,"_5":13545,"_25978":51675,"_2758":51745},[],"PKI overview",{"_3268":1714,"_28512":1690,"_19817":51747,"_5":13545,"_25978":51675,"_2758":51748},[],"**IoT Fleets**",{"_3268":1715,"_28512":1690,"_19817":51750,"_5":13545,"_25978":51675,"_2758":51751},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3268":1716,"_28512":1690,"_19817":51753,"_5":13545,"_25978":51675,"_2758":51754},[],"IoT Fleets overview",{"_3268":1717,"_28512":1690,"_19817":51756,"_5":13545,"_25978":51675,"_2758":51757},[],"**Administration**",{"_3268":1718,"_28512":1690,"_19817":51759,"_5":13545,"_25978":51675,"_2758":51760},[],"Operator permissions, audit and event subscriptions.",{"_3268":1719,"_28512":1690,"_19817":51762,"_5":13545,"_25978":51675,"_2758":47838},[],{"_3268":1720,"_28512":1690,"_19817":51764,"_5":13545,"_25978":51675,"_2758":51765},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3268":1721,"_28512":1690,"_19817":51767,"_5":13545,"_25978":51679,"_2758":51768},[],"An identity's journey connects four responsibilities:",{"_3268":1722,"_28512":1690,"_19817":51770,"_5":13545,"_25978":51679,"_2758":51771},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3268":1723,"_28512":1690,"_19817":51773,"_5":13545,"_25978":51679,"_2758":51774},[],"The provisioning administrator configures the DMS and initial trust.",{"_3268":1724,"_28512":1690,"_19817":51776,"_5":13545,"_25978":51679,"_2758":51777},[],"The device client requests a certificate and installs it with the matching key.",{"_3268":1725,"_28512":1690,"_19817":51779,"_5":13545,"_25978":51679,"_2758":51780},[],"The consumer validates the identity and applies its access permissions.",{"_3268":1726,"_28512":1690,"_19817":51782,"_5":13545,"_25978":51679,"_2758":51783},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3268":1727,"_28512":1690,"_19817":51785,"_5":13545,"_25978":51687,"_2758":51786},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3268":1728,"_28512":1690,"_19817":51788,"_5":13545,"_25978":51691,"_2758":51789},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3268":1729,"_28512":1690,"_19817":51791,"_5":13545,"_25978":51695,"_2758":51792},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3268":1730,"_28512":1690,"_19817":51794,"_5":13545,"_25978":51699,"_2758":51795},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3268":1731,"_28512":1690,"_19817":51797,"_5":13545,"_25978":51703,"_2758":51798},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3268":1732,"_28512":1690,"_19817":51800,"_5":13545,"_25978":51707,"_2758":51801},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3268":1733,"_28512":1690,"_19817":51803,"_5":13545,"_25978":51711,"_2758":51246},[],{"_3268":1734,"_28512":1690,"_19817":51805,"_5":13545,"_25978":51711,"_2758":51806},[],"What it prepares or checks",{"_3268":1735,"_28512":1690,"_19817":51808,"_5":13545,"_25978":51711,"_2758":51249},[],{"_3268":1736,"_28512":1690,"_19817":51810,"_5":13545,"_25978":51711,"_2758":51811},[],"Key custody, CA hierarchy, profiles and validation.",{"_3268":1737,"_28512":1690,"_19817":51813,"_5":13545,"_25978":51711,"_2758":51814},[],"Fleet administrator",{"_3268":1738,"_28512":1690,"_19817":51816,"_5":13545,"_25978":51711,"_2758":51817},[],"DMS, device admission, renewal policy and inventory.",{"_3268":1739,"_28512":1690,"_19817":51819,"_5":13545,"_25978":51711,"_2758":51261},[],{"_3268":1740,"_28512":1690,"_19817":51821,"_5":13545,"_25978":51711,"_2758":51822},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3268":1741,"_28512":1690,"_19817":51824,"_5":13545,"_25978":51711,"_2758":51267},[],{"_3268":1742,"_28512":1690,"_19817":51826,"_5":13545,"_25978":51711,"_2758":51827},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3268":1743,"_28512":1690,"_19817":51829,"_5":13545,"_25978":51711,"_2758":51830},[],"Infrastructure operator",{"_3268":1744,"_28512":1690,"_19817":51832,"_5":13545,"_25978":51711,"_2758":51833},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3268":1745,"_28512":1690,"_19817":51835,"_5":13545,"_25978":51711,"_2758":51836},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3268":1746,"_28512":1746,"_5":13876,"_2758":51838,"_28855":51839,"_19817":51842,"_25978":1746},"CA hierarchy and rotation",[46447,47840,51840,51841],"PKI","Keys, authorities and certificates",[],{"_3268":1747,"_28512":1746,"_19817":51844,"_5":13545,"_25978":1746,"_2758":51845},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3268":1748,"_28512":1746,"_5":28852,"_19817":51847,"_25978":51848,"_2758":51849},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3268":1749,"_28512":1746,"_5":28852,"_19817":51851,"_25978":51852,"_2758":51853},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3268":1750,"_28512":1746,"_5":28852,"_19817":51855,"_25978":51856,"_2758":51857},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3268":1751,"_28512":1746,"_5":28852,"_19817":51859,"_25978":51860,"_2758":51861},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3268":1752,"_28512":1746,"_5":28852,"_19817":51863,"_25978":51864,"_2758":51865},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3268":1753,"_28512":1746,"_5":28852,"_19817":51867,"_25978":51868,"_2758":51869},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3268":1754,"_28512":1746,"_5":28852,"_19817":51871,"_25978":51872,"_2758":51873},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3268":1755,"_28512":1746,"_5":28852,"_19817":51875,"_25978":51876,"_2758":51877},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3268":1756,"_28512":1746,"_5":28852,"_19817":51879,"_25978":51880,"_2758":51881},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3268":1757,"_28512":1746,"_5":28852,"_19817":51883,"_25978":51884,"_2758":51885},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3268":1758,"_28512":1746,"_5":28852,"_19817":51887,"_25978":51888,"_2758":51889},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3268":1759,"_28512":1746,"_5":28852,"_19817":51891,"_25978":51892,"_2758":51893},[],"/docs/pr-preview/pr-43/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3268":1760,"_28512":1746,"_19817":51895,"_5":13545,"_25978":1746,"_2758":51896},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3268":1761,"_28512":1746,"_19817":51898,"_5":13545,"_25978":1746,"_2758":51899},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3268":1762,"_28512":1746,"_19817":51901,"_5":13545,"_25978":51848,"_2758":51902},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3268":1763,"_28512":1746,"_19817":51904,"_5":13545,"_25978":51848,"_2758":51905},[],"environment, such as production and preproduction;",{"_3268":1764,"_28512":1746,"_19817":51907,"_5":13545,"_25978":51848,"_2758":51908},[],"owner or operating team;",{"_3268":1765,"_28512":1746,"_19817":51910,"_5":13545,"_25978":51848,"_2758":51911},[],"device family or manufacturing process;",{"_3268":1766,"_28512":1746,"_19817":51913,"_5":13545,"_25978":51848,"_2758":51914},[],"region or regulatory requirement;",{"_3268":1767,"_28512":1746,"_19817":51916,"_5":13545,"_25978":51848,"_2758":51917},[],"cryptographic engine or key policy;",{"_3268":1768,"_28512":1746,"_19817":51919,"_5":13545,"_25978":51848,"_2758":51920},[],"maintenance window and renewal cadence.",{"_3268":1769,"_28512":1746,"_19817":51922,"_5":13545,"_25978":51848,"_2758":51923},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3268":1770,"_28512":1746,"_19817":51925,"_5":13545,"_25978":51848,"_2758":51926},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3268":1771,"_28512":1746,"_19817":51928,"_5":13545,"_25978":51852,"_2758":51929},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3268":1772,"_28512":1746,"_19817":51931,"_5":13545,"_25978":51852,"_2758":51932},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3268":1773,"_28512":1746,"_19817":51934,"_5":13545,"_25978":51852,"_2758":51935},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3268":1774,"_28512":1746,"_19817":51937,"_5":13545,"_25978":51856,"_2758":51938},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3268":1775,"_28512":1746,"_19817":51940,"_5":13545,"_25978":51856,"_2758":51941},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3268":1776,"_28512":1746,"_19817":51943,"_5":13545,"_25978":51856,"_2758":51944},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3268":1777,"_28512":1746,"_19817":51946,"_5":13545,"_25978":51856,"_2758":51947},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3268":1778,"_28512":1746,"_19817":51949,"_5":13545,"_25978":51864,"_2758":51950},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3268":1779,"_28512":1746,"_19817":51952,"_5":13545,"_25978":51868,"_2758":51953},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3268":1780,"_28512":1746,"_19817":51955,"_5":13545,"_25978":51872,"_2758":51956},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3268":1781,"_28512":1746,"_19817":51958,"_5":13545,"_25978":51876,"_2758":51959},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3268":1782,"_28512":1746,"_19817":51961,"_5":13545,"_25978":51880,"_2758":51962},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3268":1783,"_28512":1746,"_19817":51964,"_5":13545,"_25978":51884,"_2758":51965},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3268":1784,"_28512":1746,"_19817":51967,"_5":13545,"_25978":51888,"_2758":51968},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3268":1785,"_28512":1746,"_19817":51970,"_5":13545,"_25978":51888,"_2758":51971},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3268":1786,"_28512":1746,"_19817":51973,"_5":13545,"_25978":51888,"_2758":51974},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3268":1787,"_28512":1746,"_19817":51976,"_5":13545,"_25978":51888,"_2758":51977},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3268":1788,"_28512":1746,"_19817":51979,"_5":13545,"_25978":51892,"_2758":51980},[],"The new chain ends in an anchor installed by the consumer.",{"_3268":1789,"_28512":1746,"_19817":51982,"_5":13545,"_25978":51892,"_2758":51983},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3268":1790,"_28512":1746,"_19817":51985,"_5":13545,"_25978":51892,"_2758":51986},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3268":1791,"_28512":1746,"_19817":51988,"_5":13545,"_25978":51892,"_2758":51989},[],"Re-enrollment accepts the old identity during the planned period.",{"_3268":1792,"_28512":1746,"_19817":51991,"_5":13545,"_25978":51892,"_2758":51992},[],"OCSP and CRL respond for the authorities that remain active.",{"_3268":1793,"_28512":1746,"_19817":51994,"_5":13545,"_25978":51892,"_2758":51995},[],"No DMS is left accidentally issuing from the old CA.",{"_3268":1794,"_28512":1746,"_19817":51997,"_5":13545,"_25978":51892,"_2758":51998},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3268":1795,"_28512":1795,"_5":13876,"_2758":52000,"_28855":52001,"_19817":52002,"_25978":1795},"Certification authorities",[46447,47840,51840,51841],[],{"_3268":1796,"_28512":1795,"_19817":52004,"_5":13545,"_25978":1795,"_2758":52005},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3268":1797,"_28512":1795,"_5":28852,"_19817":52007,"_25978":52008,"_2758":52009},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3268":1798,"_28512":1795,"_5":28852,"_19817":52011,"_25978":52012,"_2758":52013},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3268":1799,"_28512":1795,"_5":28852,"_19817":52015,"_25978":52016,"_2758":46457},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#before-you-begin",{"_3268":1800,"_28512":1795,"_5":28852,"_19817":52018,"_25978":52019,"_2758":52020},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3268":1801,"_28512":1795,"_5":28852,"_19817":52022,"_25978":52023,"_2758":52024},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3268":1802,"_28512":1795,"_5":28852,"_19817":52026,"_25978":52027,"_2758":52028},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3268":1803,"_28512":1795,"_5":28852,"_19817":52030,"_25978":52031,"_2758":52032},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3268":1804,"_28512":1795,"_5":28852,"_19817":52034,"_25978":52035,"_2758":52036},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3268":1805,"_28512":1795,"_5":28852,"_19817":52038,"_25978":52039,"_2758":52040},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3268":1806,"_28512":1795,"_5":28852,"_19817":52042,"_25978":52043,"_2758":52044},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3268":1807,"_28512":1795,"_5":28852,"_19817":52046,"_25978":52047,"_2758":52048},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3268":1808,"_28512":1795,"_5":28852,"_19817":52050,"_25978":52051,"_2758":52052},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3268":1809,"_28512":1795,"_5":28852,"_19817":52054,"_25978":52055,"_2758":52056},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3268":1810,"_28512":1795,"_5":28852,"_19817":52058,"_25978":52059,"_2758":52060},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3268":1811,"_28512":1795,"_5":28852,"_19817":52062,"_25978":52063,"_2758":52064},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3268":1812,"_28512":1795,"_5":28852,"_19817":52066,"_25978":52067,"_2758":52068},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3268":1813,"_28512":1795,"_5":28852,"_19817":52070,"_25978":52071,"_2758":52072},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3268":1814,"_28512":1795,"_5":28852,"_19817":52074,"_25978":52075,"_2758":52076},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3268":1815,"_28512":1795,"_5":28852,"_19817":52078,"_25978":52079,"_2758":52080},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3268":1816,"_28512":1795,"_5":28852,"_19817":52082,"_25978":52083,"_2758":52084},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3268":1817,"_28512":1795,"_5":28852,"_19817":52086,"_25978":52087,"_2758":52088},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3268":1818,"_28512":1795,"_5":28852,"_19817":52090,"_25978":52091,"_2758":52092},[],"/docs/pr-preview/pr-43/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3268":1819,"_28512":1795,"_19817":52094,"_5":13545,"_25978":1795,"_2758":52095},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3268":1820,"_28512":1795,"_19817":52097,"_5":13545,"_25978":1795,"_2758":52098},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3268":1821,"_28512":1795,"_19817":52100,"_5":13545,"_25978":1795,"_2758":52101},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3268":1822,"_28512":1795,"_19817":52103,"_5":13545,"_25978":52008,"_2758":52104},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3268":1823,"_28512":1795,"_19817":52106,"_5":13545,"_25978":52008,"_2758":52107},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3268":1824,"_28512":1795,"_19817":52109,"_5":13545,"_25978":52008,"_2758":52110},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3268":1825,"_28512":1795,"_19817":52112,"_5":13545,"_25978":52008,"_2758":52113},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3268":1826,"_28512":1795,"_19817":52115,"_5":13545,"_25978":52008,"_2758":52116},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3268":1827,"_28512":1795,"_19817":52118,"_5":13545,"_25978":52016,"_2758":52119},[],"Decide whether the CA will be a root or an intermediate.",{"_3268":1828,"_28512":1795,"_19817":52121,"_5":13545,"_25978":52016,"_2758":52122},[],"Choose the engine that will keep the key.",{"_3268":1829,"_28512":1795,"_19817":52124,"_5":13545,"_25978":52016,"_2758":52125},[],"Define a validity longer than that of the certificates it will issue.",{"_3268":1830,"_28512":1795,"_19817":52127,"_5":13545,"_25978":52016,"_2758":52128},[],"For an intermediate CA, make sure the parent CA is active.",{"_3268":1831,"_28512":1795,"_19817":52130,"_5":13545,"_25978":52019,"_2758":52131},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3268":1832,"_28512":1795,"_19817":52133,"_5":13545,"_25978":52023,"_2758":52134},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3268":1833,"_28512":1795,"_19817":52136,"_5":13545,"_25978":52023,"_2758":52137},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3268":1834,"_28512":1795,"_19817":52139,"_5":13545,"_25978":52027,"_2758":52140},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3268":1835,"_28512":1795,"_19817":52142,"_5":13545,"_25978":52031,"_2758":52143},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3268":1836,"_28512":1795,"_19817":52145,"_5":13545,"_25978":52031,"_2758":52146},[],"`C`: two-letter ISO 3166-1 country code.",{"_3268":1837,"_28512":1795,"_19817":52148,"_5":13545,"_25978":52031,"_2758":52149},[],"`ST`: state or province.",{"_3268":1838,"_28512":1795,"_19817":52151,"_5":13545,"_25978":52031,"_2758":52152},[],"`L`: locality.",{"_3268":1839,"_28512":1795,"_19817":52154,"_5":13545,"_25978":52031,"_2758":52155},[],"`O`: organization.",{"_3268":1840,"_28512":1795,"_19817":52157,"_5":13545,"_25978":52031,"_2758":52158},[],"`OU`: organizational unit.",{"_3268":1841,"_28512":1795,"_19817":52160,"_5":13545,"_25978":52031,"_2758":52161},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3268":1842,"_28512":1795,"_19817":52163,"_5":13545,"_25978":52035,"_2758":52164},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3268":1843,"_28512":1795,"_19817":52166,"_5":13545,"_25978":52035,"_2758":52167},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3268":1844,"_28512":1795,"_19817":52169,"_5":13545,"_25978":52039,"_2758":52170},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3268":1845,"_28512":1795,"_19817":52172,"_5":13545,"_25978":52039,"_2758":52173},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3268":1846,"_28512":1795,"_19817":52175,"_5":13545,"_25978":52043,"_2758":52176},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3268":1847,"_28512":1795,"_19817":52178,"_5":13545,"_25978":52043,"_2758":52179},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3268":1848,"_28512":1795,"_19817":52181,"_5":13545,"_25978":52047,"_2758":52182},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3268":1849,"_28512":1795,"_19817":52184,"_5":13545,"_25978":52051,"_2758":52185},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3268":1850,"_28512":1795,"_19817":52187,"_5":13545,"_25978":52055,"_2758":52188},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3268":1851,"_28512":1795,"_19817":52190,"_5":13545,"_25978":52059,"_2758":52191},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3268":1852,"_28512":1795,"_19817":52193,"_5":13545,"_25978":52063,"_2758":52194},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3268":1853,"_28512":1795,"_19817":52196,"_5":13545,"_25978":52063,"_2758":52197},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3268":1854,"_28512":1795,"_19817":52199,"_5":13545,"_25978":52067,"_2758":52200},[],"Open a CA from the inventory to review:",{"_3268":1855,"_28512":1795,"_19817":52202,"_5":13545,"_25978":52067,"_2758":52203},[],"Status and validity period.",{"_3268":1856,"_28512":1795,"_19817":52205,"_5":13545,"_25978":52067,"_2758":52206},[],"Certificate and chain in PEM format.",{"_3268":1857,"_28512":1795,"_19817":52208,"_5":13545,"_25978":52067,"_2758":52209},[],"Number of active, expired and revoked certificates.",{"_3268":1858,"_28512":1795,"_19817":52211,"_5":13545,"_25978":52067,"_2758":52212},[],"Certificates issued in **Issued Certificates**.",{"_3268":1859,"_28512":1795,"_19817":52214,"_5":13545,"_25978":52067,"_2758":52215},[],"The CRL linked to the authority.",{"_3268":1860,"_28512":1795,"_19817":52217,"_5":13545,"_25978":52067,"_2758":52218},[],"Metadata and the associated cryptographic engine.",{"_3268":1861,"_28512":1795,"_19817":52220,"_5":13545,"_25978":52067,"_2758":52221},[],"You can filter the inventory by name, status and CA type.",{"_3268":1862,"_28512":1795,"_19817":52223,"_5":13545,"_25978":52071,"_2758":52224},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3268":1863,"_28512":1795,"_19817":52226,"_5":13545,"_25978":52071,"_2758":52227},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3268":1864,"_28512":1795,"_19817":52229,"_5":13545,"_25978":52071,"_2758":52230},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3268":1865,"_28512":1795,"_19817":52232,"_5":13545,"_25978":52071,"_2758":52233},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3268":1866,"_28512":1795,"_19817":52235,"_5":13545,"_25978":52075,"_2758":52236},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3268":1867,"_28512":1795,"_19817":52238,"_5":13545,"_25978":52079,"_2758":52239},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3268":1868,"_28512":1795,"_19817":52241,"_5":13545,"_25978":52083,"_2758":52242},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3268":1869,"_28512":1795,"_19817":52244,"_5":13545,"_25978":52087,"_2758":52245},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3268":1870,"_28512":1795,"_19817":52247,"_5":13545,"_25978":52091,"_2758":52248},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3268":1871,"_28512":1795,"_19817":52250,"_5":13545,"_25978":52091,"_2758":52251},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3268":1872,"_28512":1872,"_5":13876,"_2758":52253,"_28855":52254,"_19817":52255,"_25978":1872},"Certificate profiles",[46447,47840,51840,51841],[],{"_3268":1873,"_28512":1872,"_19817":52257,"_5":13545,"_25978":1872,"_2758":52258},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3268":1874,"_28512":1872,"_5":28852,"_19817":52260,"_25978":52261,"_2758":52262},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3268":1875,"_28512":1872,"_5":28852,"_19817":52264,"_25978":52265,"_2758":52266},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#validity","Validity",{"_3268":1876,"_28512":1872,"_5":28852,"_19817":52268,"_25978":52269,"_2758":52270},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3268":1877,"_28512":1872,"_5":28852,"_19817":52272,"_25978":52273,"_2758":52274},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3268":1878,"_28512":1872,"_5":28852,"_19817":52276,"_25978":52277,"_2758":52278},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#subject","Subject",{"_3268":1879,"_28512":1872,"_5":28852,"_19817":52280,"_25978":52281,"_2758":52282},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3268":1880,"_28512":1872,"_5":28852,"_19817":52284,"_25978":52285,"_2758":52286},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3268":1881,"_28512":1872,"_5":28852,"_19817":52288,"_25978":52289,"_2758":52290},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3268":1882,"_28512":1872,"_5":28852,"_19817":52292,"_25978":52293,"_2758":52294},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3268":1883,"_28512":1872,"_5":28852,"_19817":52296,"_25978":52297,"_2758":52298},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3268":1884,"_28512":1872,"_5":28852,"_19817":52300,"_25978":52301,"_2758":52302},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3268":1885,"_28512":1872,"_5":28852,"_19817":52304,"_25978":52305,"_2758":52306},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3268":1886,"_28512":1872,"_5":28852,"_19817":52308,"_25978":52309,"_2758":52310},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3268":1887,"_28512":1872,"_5":28852,"_19817":52312,"_25978":52313,"_2758":52314},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3268":1888,"_28512":1872,"_5":28852,"_19817":52316,"_25978":52317,"_2758":52318},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#design-examples","Design examples",{"_3268":1889,"_28512":1872,"_5":28852,"_19817":52320,"_25978":52321,"_2758":52322},[],"/docs/pr-preview/pr-43/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3268":1890,"_28512":1872,"_19817":52324,"_5":13545,"_25978":1872,"_2758":52325},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3268":1891,"_28512":1872,"_19817":52327,"_5":13545,"_25978":1872,"_2758":52328},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3268":1892,"_28512":1872,"_19817":52330,"_5":13545,"_25978":52265,"_2758":52331},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3268":1893,"_28512":1872,"_19817":52333,"_5":13545,"_25978":52265,"_2758":52334},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3268":1894,"_28512":1872,"_19817":52336,"_5":13545,"_25978":52269,"_2758":52337},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3268":1895,"_28512":1872,"_19817":52339,"_5":13545,"_25978":52273,"_2758":52340},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3268":1896,"_28512":1872,"_19817":52342,"_5":13545,"_25978":52273,"_2758":52343},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3268":1897,"_28512":1872,"_19817":52345,"_5":13545,"_25978":52273,"_2758":52346},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3268":1898,"_28512":1872,"_19817":52348,"_5":13545,"_25978":52277,"_2758":52349},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3268":1899,"_28512":1872,"_19817":52351,"_5":13545,"_25978":52281,"_2758":52352},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3268":1900,"_28512":1872,"_19817":52354,"_5":13545,"_25978":52281,"_2758":52355},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3268":1901,"_28512":1872,"_19817":52357,"_5":13545,"_25978":52285,"_2758":52358},[],"The cryptographic enforcement can:",{"_3268":1902,"_28512":1872,"_19817":52360,"_5":13545,"_25978":52285,"_2758":52361},[],"allow or block RSA keys;",{"_3268":1903,"_28512":1872,"_19817":52363,"_5":13545,"_25978":52285,"_2758":52364},[],"limit the supported RSA sizes;",{"_3268":1904,"_28512":1872,"_19817":52366,"_5":13545,"_25978":52285,"_2758":52367},[],"allow or block ECDSA keys;",{"_3268":1905,"_28512":1872,"_19817":52369,"_5":13545,"_25978":52285,"_2758":52370},[],"limit the supported ECDSA sizes or curves.",{"_3268":1906,"_28512":1872,"_19817":52372,"_5":13545,"_25978":52285,"_2758":52373},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3268":1907,"_28512":1872,"_19817":52375,"_5":13545,"_25978":52289,"_2758":52376},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3268":1908,"_28512":1872,"_19817":52378,"_5":13545,"_25978":52289,"_2758":49601},[],{"_3268":1909,"_28512":1872,"_19817":52380,"_5":13545,"_25978":52289,"_2758":52381},[],"First choice",{"_3268":1910,"_28512":1872,"_19817":52383,"_5":13545,"_25978":52289,"_2758":52384},[],"Second choice",{"_3268":1911,"_28512":1872,"_19817":52386,"_5":13545,"_25978":52289,"_2758":52387},[],"If neither is supplied",{"_3268":1912,"_28512":1872,"_19817":52389,"_5":13545,"_25978":52289,"_2758":52390},[],"Direct signing with a CA",{"_3268":1913,"_28512":1872,"_19817":52392,"_5":13545,"_25978":52289,"_2758":52393},[],"`issuance_profile` embedded in the request",{"_3268":1914,"_28512":1872,"_19817":52395,"_5":13545,"_25978":52289,"_2758":52396},[],"Request `issuance_profile_id`",{"_3268":1915,"_28512":1872,"_19817":52398,"_5":13545,"_25978":52289,"_2758":52399},[],"CA default profile (`profile_id`).",{"_3268":1916,"_28512":1872,"_19817":52401,"_5":13545,"_25978":52289,"_2758":52402},[],"Issuance through a DMS",{"_3268":1917,"_28512":1872,"_19817":52404,"_5":13545,"_25978":52289,"_2758":52405},[],"`settings.issuance_profile_id`",{"_3268":1918,"_28512":1872,"_19817":52407,"_5":13545,"_25978":52289,"_2758":52408},[],"`settings.issuance_profile` embedded in the DMS",{"_3268":1919,"_28512":1872,"_19817":52410,"_5":13545,"_25978":52289,"_2758":52411},[],"Enrollment CA default profile.",{"_3268":1920,"_28512":1872,"_19817":52413,"_5":13545,"_25978":52289,"_2758":52414},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3268":1921,"_28512":1872,"_19817":52416,"_5":13545,"_25978":52289,"_2758":52417},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3268":1922,"_28512":1872,"_19817":52419,"_5":13545,"_25978":52297,"_2758":52420},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3268":1923,"_28512":1872,"_19817":52422,"_5":13545,"_25978":52301,"_2758":52423},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3268":1924,"_28512":1872,"_19817":52425,"_5":13545,"_25978":52305,"_2758":52426},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3268":1925,"_28512":1872,"_19817":52428,"_5":13545,"_25978":52309,"_2758":52429},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3268":1926,"_28512":1872,"_19817":52431,"_5":13545,"_25978":52313,"_2758":52432},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3268":1927,"_28512":1872,"_19817":52434,"_5":13545,"_25978":52313,"_2758":52435},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3268":1928,"_28512":1872,"_19817":52437,"_5":13545,"_25978":52317,"_2758":52438},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3268":1929,"_28512":1872,"_19817":52440,"_5":13545,"_25978":52317,"_2758":52441},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3268":1930,"_28512":1872,"_19817":52443,"_5":13545,"_25978":52317,"_2758":52444},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3268":1931,"_28512":1872,"_19817":52446,"_5":13545,"_25978":52317,"_2758":52447},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3268":1932,"_28512":1872,"_19817":52449,"_5":13545,"_25978":52321,"_2758":52450},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3268":1933,"_28512":1872,"_19817":52452,"_5":13545,"_25978":52321,"_2758":52453},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3268":1934,"_28512":1934,"_5":13876,"_2758":52455,"_28855":52456,"_19817":52458,"_25978":1934},"Certificate validation",[46447,47840,51840,52457],"Validation",[],{"_3268":1935,"_28512":1934,"_19817":52460,"_5":13545,"_25978":1934,"_2758":52461},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3268":1936,"_28512":1934,"_5":28852,"_19817":52463,"_25978":52464,"_2758":52465},[],"/docs/pr-preview/pr-43/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3268":1937,"_28512":1934,"_5":28852,"_19817":52467,"_25978":52468,"_2758":52469},[],"/docs/pr-preview/pr-43/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3268":1938,"_28512":1934,"_5":28852,"_19817":52471,"_25978":52472,"_2758":52473},[],"/docs/pr-preview/pr-43/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3268":1939,"_28512":1934,"_19817":52475,"_5":13545,"_25978":1934,"_2758":52476},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3268":1940,"_28512":1934,"_19817":52478,"_5":13545,"_25978":52464,"_2758":52479},[],"Verify these criteria together:",{"_3268":1941,"_28512":1934,"_19817":52481,"_5":13545,"_25978":52464,"_2758":51466},[],{"_3268":1942,"_28512":1934,"_19817":52483,"_5":13545,"_25978":52464,"_2758":52484},[],"Required result",{"_3268":1943,"_28512":1934,"_19817":52486,"_5":13545,"_25978":52464,"_2758":52487},[],"Chain and signature",{"_3268":1944,"_28512":1934,"_19817":52489,"_5":13545,"_25978":52464,"_2758":52490},[],"Valid chain to a root deliberately installed in the consumer.",{"_3268":1945,"_28512":1934,"_19817":52492,"_5":13545,"_25978":52464,"_2758":52493},[],"Dates",{"_3268":1946,"_28512":1934,"_19817":52495,"_5":13545,"_25978":52464,"_2758":52496},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3268":1947,"_28512":1934,"_19817":52498,"_5":13545,"_25978":52464,"_2758":47537},[],{"_3268":1948,"_28512":1934,"_19817":52500,"_5":13545,"_25978":52464,"_2758":52501},[],"Name, SAN or identifier matches the expected peer.",{"_3268":1949,"_28512":1934,"_19817":52503,"_5":13545,"_25978":52464,"_2758":46837},[],{"_3268":1950,"_28512":1934,"_19817":52505,"_5":13545,"_25978":52464,"_2758":52506},[],"KU, EKU and constraints permit the specific operation.",{"_3268":1951,"_28512":1934,"_19817":52508,"_5":13545,"_25978":52464,"_2758":52509},[],"Revocation",{"_3268":1952,"_28512":1934,"_19817":52511,"_5":13545,"_25978":52464,"_2758":52512},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3268":1953,"_28512":1934,"_19817":52514,"_5":13545,"_25978":52464,"_2758":52515},[],"Authorization",{"_3268":1954,"_28512":1934,"_19817":52517,"_5":13545,"_25978":52464,"_2758":52518},[],"The application permits that identity to perform the action.",{"_3268":1955,"_28512":1934,"_19817":52520,"_5":13545,"_25978":52464,"_2758":52521},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3268":1956,"_28512":1934,"_19817":52523,"_5":13545,"_25978":52468,"_2758":52524},[],"Mechanism",{"_3268":1957,"_28512":1934,"_19817":52526,"_5":13545,"_25978":52468,"_2758":52527},[],"When to use it",{"_3268":1958,"_28512":1934,"_19817":52529,"_5":13545,"_25978":52468,"_2758":52530},[],"What you must maintain",{"_3268":1959,"_28512":1934,"_19817":52532,"_5":13545,"_25978":52468,"_2758":52533},[],"OCSP",{"_3268":1960,"_28512":1934,"_19817":52535,"_5":13545,"_25978":52468,"_2758":52536},[],"Status query for a specific certificate.",{"_3268":1961,"_28512":1934,"_19817":52538,"_5":13545,"_25978":52468,"_2758":52539},[],"Responder access, signature verification and cache/freshness policy.",{"_3268":1962,"_28512":1934,"_19817":52541,"_5":13545,"_25978":52468,"_2758":52542},[],"CRL",{"_3268":1963,"_28512":1934,"_19817":52544,"_5":13545,"_25978":52468,"_2758":52545},[],"Local checks for many certificates or offline operation.",{"_3268":1964,"_28512":1934,"_19817":52547,"_5":13545,"_25978":52468,"_2758":52548},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3268":1965,"_28512":1934,"_19817":52550,"_5":13545,"_25978":52468,"_2758":52551},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3268":1966,"_28512":1934,"_19817":52553,"_5":13545,"_25978":52468,"_2758":52554},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3268":1967,"_28512":1934,"_19817":52556,"_5":13545,"_25978":52472,"_2758":52557},[],"Accept a current, authorized certificate with a known chain.",{"_3268":1968,"_28512":1934,"_19817":52559,"_5":13545,"_25978":52472,"_2758":52560},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3268":1969,"_28512":1934,"_19817":52562,"_5":13545,"_25978":52472,"_2758":52563},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3268":1970,"_28512":1934,"_19817":52565,"_5":13545,"_25978":52472,"_2758":52566},[],"Check that a new connection with that identity is rejected.",{"_3268":1971,"_28512":1934,"_19817":52568,"_5":13545,"_25978":52472,"_2758":52569},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3268":1972,"_28512":1934,"_19817":52571,"_5":13545,"_25978":52472,"_2758":52572},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3268":1973,"_28512":1934,"_19817":52574,"_5":13545,"_25978":52472,"_2758":52575},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3268":1974,"_28512":1934,"_19817":52577,"_5":13545,"_25978":52472,"_2758":52578},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3268":1975,"_28512":1934,"_19817":52580,"_5":13545,"_25978":52472,"_2758":52581},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3268":1976,"_28512":1976,"_5":13876,"_2758":52583,"_28855":52584,"_19817":52585,"_25978":1976},"Certificates",[46447,47840,51840,51841],[],{"_3268":1977,"_28512":1976,"_19817":52587,"_5":13545,"_25978":1976,"_2758":52588},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3268":1978,"_28512":1976,"_5":28852,"_19817":52590,"_25978":52591,"_2758":52592},[],"/docs/pr-preview/pr-43/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3268":1979,"_28512":1976,"_5":28852,"_19817":52594,"_25978":52595,"_2758":52596},[],"/docs/pr-preview/pr-43/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3268":1980,"_28512":1976,"_5":28852,"_19817":52598,"_25978":52599,"_2758":52600},[],"/docs/pr-preview/pr-43/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3268":1981,"_28512":1976,"_5":28852,"_19817":52602,"_25978":52603,"_2758":52604},[],"/docs/pr-preview/pr-43/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3268":1982,"_28512":1976,"_5":28852,"_19817":52606,"_25978":52607,"_2758":52608},[],"/docs/pr-preview/pr-43/platform/pki/certificates#open-the-action","Open the action",{"_3268":1983,"_28512":1976,"_5":28852,"_19817":52610,"_25978":52611,"_2758":52612},[],"/docs/pr-preview/pr-43/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3268":1984,"_28512":1976,"_5":28852,"_19817":52614,"_25978":52615,"_2758":52616},[],"/docs/pr-preview/pr-43/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3268":1985,"_28512":1976,"_5":28852,"_19817":52618,"_25978":52619,"_2758":52620},[],"/docs/pr-preview/pr-43/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3268":1986,"_28512":1976,"_5":28852,"_19817":52622,"_25978":52623,"_2758":52624},[],"/docs/pr-preview/pr-43/platform/pki/certificates#continue","Continue",{"_3268":1987,"_28512":1976,"_19817":52626,"_5":13545,"_25978":1976,"_2758":52627},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3268":1988,"_28512":1976,"_19817":52629,"_5":13545,"_25978":52591,"_2758":52630},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3268":1989,"_28512":1976,"_19817":52632,"_5":13545,"_25978":52591,"_2758":52633},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3268":1990,"_28512":1976,"_19817":52635,"_5":13545,"_25978":52595,"_2758":52636},[],"Download the PEM and inspect it:",{"_3268":1991,"_28512":1976,"_19817":52638,"_5":13545,"_25978":52595,"_2758":52639},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3268":1992,"_28512":1976,"_19817":52641,"_5":13545,"_25978":52599,"_2758":52642},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3268":1993,"_28512":1976,"_19817":52644,"_5":13545,"_25978":52599,"_2758":52645},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3268":1994,"_28512":1976,"_19817":52647,"_5":13545,"_25978":52599,"_2758":52648},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3268":1995,"_28512":1976,"_19817":52650,"_5":13545,"_25978":52599,"_2758":52651},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3268":1996,"_28512":1976,"_19817":52653,"_5":13545,"_25978":52599,"_2758":52654},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3268":1997,"_28512":1976,"_19817":52656,"_5":13545,"_25978":52599,"_2758":52657},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3268":1998,"_28512":1976,"_19817":52659,"_5":13545,"_25978":52599,"_2758":52660},[],"For browser key generation, follow Issue your first certificate.",{"_3268":1999,"_28512":1976,"_19817":52662,"_5":13545,"_25978":52603,"_2758":52663},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3268":2000,"_28512":1976,"_19817":52665,"_5":13545,"_25978":52607,"_2758":52666},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3268":2001,"_28512":1976,"_19817":52668,"_5":13545,"_25978":52611,"_2758":52669},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3268":2002,"_28512":1976,"_19817":52671,"_5":13545,"_25978":52615,"_2758":52672},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3268":2003,"_28512":1976,"_19817":52674,"_5":13545,"_25978":52615,"_2758":52675},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3268":2004,"_28512":1976,"_19817":52677,"_5":13545,"_25978":52615,"_2758":52678},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3268":2005,"_28512":1976,"_19817":52680,"_5":13545,"_25978":52619,"_2758":52681},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3268":2006,"_28512":1976,"_19817":52683,"_5":13545,"_25978":52619,"_2758":52684},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3268":2007,"_28512":1976,"_19817":52686,"_5":13545,"_25978":52619,"_2758":52687},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3268":2008,"_28512":1976,"_19817":52689,"_5":13545,"_25978":52623,"_2758":52690},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3268":2009,"_28512":1976,"_19817":52692,"_5":13545,"_25978":52623,"_2758":52693},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3268":2010,"_28512":2010,"_5":13876,"_2758":52695,"_28855":52696,"_19817":52698,"_25978":2010},"Certificate lifecycle",[46447,47840,51840,52697],"Concepts",[],{"_3268":2011,"_28512":2010,"_19817":52700,"_5":13545,"_25978":2010,"_2758":52701},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3268":2012,"_28512":2010,"_5":28852,"_19817":52703,"_25978":52704,"_2758":52705},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3268":2013,"_28512":2010,"_5":28852,"_19817":52707,"_25978":52708,"_2758":52709},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3268":2014,"_28512":2010,"_5":28852,"_19817":52711,"_25978":52712,"_2758":52713},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3268":2015,"_28512":2010,"_5":28852,"_19817":52715,"_25978":52716,"_2758":52717},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3268":2016,"_28512":2010,"_5":28852,"_19817":52719,"_25978":52720,"_2758":52721},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3268":2017,"_28512":2010,"_5":28852,"_19817":52723,"_25978":52724,"_2758":52725},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3268":2018,"_28512":2010,"_5":28852,"_19817":52727,"_25978":52728,"_2758":52729},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3268":2019,"_28512":2010,"_5":28852,"_19817":52731,"_25978":52732,"_2758":52733},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3268":2020,"_28512":2010,"_5":28852,"_19817":52735,"_25978":52736,"_2758":52737},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3268":2021,"_28512":2010,"_5":28852,"_19817":52739,"_25978":52740,"_2758":52741},[],"/docs/pr-preview/pr-43/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3268":2022,"_28512":2010,"_19817":52743,"_5":13545,"_25978":2010,"_2758":52744},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3268":2023,"_28512":2010,"_19817":52746,"_5":13545,"_25978":52708,"_2758":52747},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3268":2024,"_28512":2010,"_19817":52749,"_5":13545,"_25978":52712,"_2758":52750},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3268":2025,"_28512":2010,"_19817":52752,"_5":13545,"_25978":52716,"_2758":52753},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3268":2026,"_28512":2010,"_19817":52755,"_5":13545,"_25978":52720,"_2758":52756},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3268":2027,"_28512":2010,"_19817":52758,"_5":13545,"_25978":52724,"_2758":52759},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3268":2028,"_28512":2010,"_19817":52761,"_5":13545,"_25978":52728,"_2758":52762},[],"Lamassu persists four X.509 states:",{"_3268":2029,"_28512":2010,"_19817":52764,"_5":13545,"_25978":52728,"_2758":52765},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3268":2030,"_28512":2010,"_19817":52767,"_5":13545,"_25978":52728,"_2758":52768},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3268":2031,"_28512":2010,"_19817":52770,"_5":13545,"_25978":52728,"_2758":52771},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3268":2032,"_28512":2010,"_19817":52773,"_5":13545,"_25978":52728,"_2758":52774},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3268":2033,"_28512":2010,"_19817":52776,"_5":13545,"_25978":52728,"_2758":52777},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3268":2034,"_28512":2010,"_19817":52779,"_5":13545,"_25978":52732,"_2758":52780},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3268":2035,"_28512":2010,"_19817":52782,"_5":13545,"_25978":52732,"_2758":52783},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3268":2036,"_28512":2010,"_19817":52785,"_5":13545,"_25978":52732,"_2758":52786},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3268":2037,"_28512":2010,"_19817":52788,"_5":13545,"_25978":52736,"_2758":52789},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3268":2038,"_28512":2010,"_19817":52791,"_5":13545,"_25978":52736,"_2758":52792},[],"Before confirming:",{"_3268":2039,"_28512":2010,"_19817":52794,"_5":13545,"_25978":52736,"_2758":52795},[],"Identify DMSs, devices and services that trust that chain.",{"_3268":2040,"_28512":2010,"_19817":52797,"_5":13545,"_25978":52736,"_2758":52798},[],"Distribute the new chain of trust.",{"_3268":2041,"_28512":2010,"_19817":52800,"_5":13545,"_25978":52736,"_2758":52801},[],"Reissue the necessary identities.",{"_3268":2042,"_28512":2010,"_19817":52803,"_5":13545,"_25978":52736,"_2758":52804},[],"Check OCSP and CRL from a real consumer.",{"_3268":2043,"_28512":2010,"_19817":52806,"_5":13545,"_25978":52736,"_2758":52807},[],"Revoke the old CA once no legitimate traffic remains.",{"_3268":2044,"_28512":2010,"_19817":52809,"_5":13545,"_25978":52736,"_2758":52810},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3268":2045,"_28512":2010,"_19817":52812,"_5":13545,"_25978":52740,"_2758":52813},[],"Certificates entering the preventive or critical renewal window.",{"_3268":2046,"_28512":2010,"_19817":52815,"_5":13545,"_25978":52740,"_2758":52816},[],"Repeated enrollment or re-enrollment failures.",{"_3268":2047,"_28512":2010,"_19817":52818,"_5":13545,"_25978":52740,"_2758":52819},[],"Status changes and revocation reasons.",{"_3268":2048,"_28512":2010,"_19817":52821,"_5":13545,"_25978":52740,"_2758":52822},[],"OCSP and CRL publication and validity.",{"_3268":2049,"_28512":2010,"_19817":52824,"_5":13545,"_25978":52740,"_2758":52825},[],"Dependencies still presenting a replaced certificate.",{"_3268":2050,"_28512":2010,"_19817":52827,"_5":13545,"_25978":52740,"_2758":52828},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3268":2051,"_28512":2051,"_5":13876,"_2758":52830,"_28855":52831,"_19817":52832,"_25978":2051},"Trust model",[46447,47840,51840,52697],[],{"_3268":2052,"_28512":2051,"_19817":52834,"_5":13545,"_25978":2051,"_2758":52835},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3268":2053,"_28512":2051,"_5":28852,"_19817":52837,"_25978":52838,"_2758":52839},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3268":2054,"_28512":2051,"_5":28852,"_19817":52841,"_25978":52842,"_2758":52843},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3268":2055,"_28512":2051,"_5":28852,"_19817":52845,"_25978":52846,"_2758":52847},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3268":2056,"_28512":2051,"_5":28852,"_19817":52849,"_25978":52850,"_2758":52851},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3268":2057,"_28512":2051,"_5":28852,"_19817":52853,"_25978":52854,"_2758":52855},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3268":2058,"_28512":2051,"_5":28852,"_19817":52857,"_25978":52858,"_2758":52859},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3268":2059,"_28512":2051,"_5":28852,"_19817":52861,"_25978":52862,"_2758":52863},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3268":2060,"_28512":2051,"_5":28852,"_19817":52865,"_25978":52866,"_2758":52867},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3268":2061,"_28512":2051,"_5":28852,"_19817":52869,"_25978":52870,"_2758":52871},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3268":2062,"_28512":2051,"_5":28852,"_19817":52873,"_25978":52874,"_2758":52875},[],"/docs/pr-preview/pr-43/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3268":2063,"_28512":2051,"_19817":52877,"_5":13545,"_25978":2051,"_2758":52878},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3268":2064,"_28512":2051,"_19817":52880,"_5":13545,"_25978":52842,"_2758":52881},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3268":2065,"_28512":2051,"_19817":52883,"_5":13545,"_25978":52846,"_2758":52884},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3268":2066,"_28512":2051,"_19817":52886,"_5":13545,"_25978":52850,"_2758":52887},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3268":2067,"_28512":2051,"_19817":52889,"_5":13545,"_25978":52854,"_2758":52890},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3268":2068,"_28512":2051,"_19817":52892,"_5":13545,"_25978":52858,"_2758":52893},[],"The device proves it can enroll according to the DMS policy.",{"_3268":2069,"_28512":2051,"_19817":52895,"_5":13545,"_25978":52858,"_2758":52896},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3268":2070,"_28512":2051,"_19817":52898,"_5":13545,"_25978":52858,"_2758":52899},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3268":2071,"_28512":2051,"_19817":52901,"_5":13545,"_25978":52858,"_2758":52902},[],"The device installs the certificate and the chain it needs.",{"_3268":2072,"_28512":2051,"_19817":52904,"_5":13545,"_25978":52858,"_2758":52905},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3268":2073,"_28512":2051,"_19817":52907,"_5":13545,"_25978":52858,"_2758":52908},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3268":2074,"_28512":2051,"_19817":52910,"_5":13545,"_25978":52862,"_2758":52911},[],"A DMS relates three sets that are worth designing separately:",{"_3268":2075,"_28512":2051,"_19817":52913,"_5":13545,"_25978":52862,"_2758":52914},[],"**Enrollment CA:** signs the new identities.",{"_3268":2076,"_28512":2051,"_19817":52916,"_5":13545,"_25978":52862,"_2758":52917},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3268":2077,"_28512":2051,"_19817":52919,"_5":13545,"_25978":52862,"_2758":52920},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3268":2078,"_28512":2051,"_19817":52922,"_5":13545,"_25978":52862,"_2758":52923},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3268":2079,"_28512":2051,"_19817":52925,"_5":13545,"_25978":52866,"_2758":52926},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3268":2080,"_28512":2051,"_19817":52928,"_5":13545,"_25978":52866,"_2758":52929},[],"that the current date is between `Not Before` and `Not After`;",{"_3268":2081,"_28512":2051,"_19817":52931,"_5":13545,"_25978":52866,"_2758":52932},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3268":2082,"_28512":2051,"_19817":52934,"_5":13545,"_25978":52866,"_2758":52935},[],"that names, SANs and subject match the expected identity;",{"_3268":2083,"_28512":2051,"_19817":52937,"_5":13545,"_25978":52866,"_2758":52938},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3268":2084,"_28512":2051,"_19817":52940,"_5":13545,"_25978":52866,"_2758":52941},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3268":2085,"_28512":2051,"_19817":52943,"_5":13545,"_25978":52866,"_2758":52944},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3268":2086,"_28512":2051,"_19817":52946,"_5":13545,"_25978":52870,"_2758":52947},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3268":2087,"_28512":2051,"_19817":52949,"_5":13545,"_25978":52874,"_2758":52950},[],"Keep the root out of daily operations, or with very restricted access.",{"_3268":2088,"_28512":2051,"_19817":52952,"_5":13545,"_25978":52874,"_2758":52953},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3268":2089,"_28512":2051,"_19817":52955,"_5":13545,"_25978":52874,"_2758":52956},[],"Assign explicit profiles to every use case.",{"_3268":2090,"_28512":2051,"_19817":52958,"_5":13545,"_25978":52874,"_2758":52959},[],"Distribute the new trust before starting a rotation.",{"_3268":2091,"_28512":2051,"_19817":52961,"_5":13545,"_25978":52874,"_2758":52962},[],"Keep enough overlap to renew a disconnected fleet.",{"_3268":2092,"_28512":2051,"_19817":52964,"_5":13545,"_25978":52874,"_2758":52965},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3268":2093,"_28512":2051,"_19817":52967,"_5":13545,"_25978":52874,"_2758":52968},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3268":2094,"_28512":2094,"_5":13876,"_2758":52970,"_28855":52971,"_19817":52972,"_25978":2094},"Revocation lists (CRL)",[46447,47840,51840,52457],[],{"_3268":2095,"_28512":2094,"_19817":52974,"_5":13545,"_25978":2094,"_2758":52975},[],"Generate and distribute signed lists to validate certificates offline.",{"_3268":2096,"_28512":2094,"_5":28852,"_19817":52977,"_25978":52978,"_2758":52979},[],"/docs/pr-preview/pr-43/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3268":2097,"_28512":2094,"_5":28852,"_19817":52981,"_25978":52982,"_2758":52983},[],"/docs/pr-preview/pr-43/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3268":2098,"_28512":2094,"_5":28852,"_19817":52985,"_25978":52986,"_2758":52987},[],"/docs/pr-preview/pr-43/platform/pki/crl#crl-contents","CRL contents",{"_3268":2099,"_28512":2094,"_5":28852,"_19817":52989,"_25978":52990,"_2758":52991},[],"/docs/pr-preview/pr-43/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3268":2100,"_28512":2094,"_5":28852,"_19817":52993,"_25978":52994,"_2758":52995},[],"/docs/pr-preview/pr-43/platform/pki/crl#va-role-management-api","VA role management API",{"_3268":2101,"_28512":2094,"_5":28852,"_19817":52997,"_25978":52998,"_2758":52999},[],"/docs/pr-preview/pr-43/platform/pki/crl#from-the-interface","From the interface",{"_3268":2102,"_28512":2094,"_5":28852,"_19817":53001,"_25978":53002,"_2758":53003},[],"/docs/pr-preview/pr-43/platform/pki/crl#references","References",{"_3268":2103,"_28512":2094,"_19817":53005,"_5":13545,"_25978":2094,"_2758":53006},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3268":2104,"_28512":2094,"_19817":53008,"_5":13545,"_25978":52978,"_2758":53009},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3268":2105,"_28512":2094,"_19817":53011,"_5":13545,"_25978":52978,"_2758":53012},[],"`crl_options` field",{"_3268":2106,"_28512":2094,"_19817":53014,"_5":13545,"_25978":52978,"_2758":46837},[],{"_3268":2107,"_28512":2094,"_19817":53016,"_5":13545,"_25978":52978,"_2758":53017},[],"Backend initial value",{"_3268":2108,"_28512":2094,"_19817":53019,"_5":13545,"_25978":52978,"_2758":53020},[],"`validity`",{"_3268":2109,"_28512":2094,"_19817":53022,"_5":13545,"_25978":52978,"_2758":53023},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3268":2110,"_28512":2094,"_19817":53025,"_5":13545,"_25978":52978,"_2758":53026},[],"7 days.",{"_3268":2111,"_28512":2094,"_19817":53028,"_5":13545,"_25978":52978,"_2758":53029},[],"`refresh_interval`",{"_3268":2112,"_28512":2094,"_19817":53031,"_5":13545,"_25978":52978,"_2758":53032},[],"Time since publication that triggers scheduled renewal.",{"_3268":2113,"_28512":2094,"_19817":53034,"_5":13545,"_25978":52978,"_2758":53035},[],"6 days and 23 hours.",{"_3268":2114,"_28512":2094,"_19817":53037,"_5":13545,"_25978":52978,"_2758":53038},[],"`regenerate_on_revoke`",{"_3268":2115,"_28512":2094,"_19817":53040,"_5":13545,"_25978":52978,"_2758":53041},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3268":2116,"_28512":2094,"_19817":53043,"_5":13545,"_25978":52978,"_2758":53044},[],"`true`.",{"_3268":2117,"_28512":2094,"_19817":53046,"_5":13545,"_25978":52978,"_2758":53047},[],"`subject_key_id_signer`",{"_3268":2118,"_28512":2094,"_19817":53049,"_5":13545,"_25978":52978,"_2758":53050},[],"Configuration field initialized with the CA’s SKI.",{"_3268":2119,"_28512":2094,"_19817":53052,"_5":13545,"_25978":52978,"_2758":53053},[],"CA SKI.",{"_3268":2120,"_28512":2094,"_19817":53055,"_5":13545,"_25978":52978,"_2758":53056},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_3268":2121,"_28512":2094,"_19817":53058,"_5":13545,"_25978":52978,"_2758":53059},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3268":2122,"_28512":2094,"_19817":53061,"_5":13545,"_25978":52982,"_2758":53062},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3268":2123,"_28512":2094,"_19817":53064,"_5":13545,"_25978":52982,"_2758":53065},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3268":2124,"_28512":2094,"_19817":53067,"_5":13545,"_25978":52982,"_2758":53068},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3268":2125,"_28512":2094,"_19817":53070,"_5":13545,"_25978":52986,"_2758":53071},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3268":2126,"_28512":2094,"_19817":53073,"_5":13545,"_25978":52986,"_2758":53074},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3268":2127,"_28512":2094,"_19817":53076,"_5":13545,"_25978":52990,"_2758":53077},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3268":2128,"_28512":2094,"_19817":53079,"_5":13545,"_25978":52990,"_2758":53080},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3268":2129,"_28512":2094,"_19817":53082,"_5":13545,"_25978":52990,"_2758":53083},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3268":2130,"_28512":2094,"_19817":53085,"_5":13545,"_25978":52990,"_2758":53086},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3268":2131,"_28512":2094,"_19817":53088,"_5":13545,"_25978":52990,"_2758":53089},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3268":2132,"_28512":2094,"_19817":53091,"_5":13545,"_25978":52994,"_2758":53092},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3268":2133,"_28512":2094,"_19817":53094,"_5":13545,"_25978":52994,"_2758":49604},[],{"_3268":2134,"_28512":2094,"_19817":53096,"_5":13545,"_25978":52994,"_2758":53097},[],"Relative path",{"_3268":2135,"_28512":2094,"_19817":53099,"_5":13545,"_25978":52994,"_2758":49601},[],{"_3268":2136,"_28512":2094,"_19817":53101,"_5":13545,"_25978":52994,"_2758":53102},[],"`GET`",{"_3268":2137,"_28512":2094,"_19817":53104,"_5":13545,"_25978":52994,"_2758":53105},[],"`/v1/roles/{ca-ski}`",{"_3268":2138,"_28512":2094,"_19817":53107,"_5":13545,"_25978":52994,"_2758":53108},[],"Read `crl_options` and `latest_crl`.",{"_3268":2139,"_28512":2094,"_19817":53110,"_5":13545,"_25978":52994,"_2758":53111},[],"`PUT`",{"_3268":2140,"_28512":2094,"_19817":53113,"_5":13545,"_25978":52994,"_2758":53105},[],{"_3268":2141,"_28512":2094,"_19817":53115,"_5":13545,"_25978":52994,"_2758":53116},[],"Replace CRL configuration.",{"_3268":2142,"_28512":2094,"_19817":53118,"_5":13545,"_25978":52994,"_2758":53119},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3268":2143,"_28512":2094,"_19817":53121,"_5":13545,"_25978":52994,"_2758":53122},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3268":2144,"_28512":2094,"_19817":53124,"_5":13545,"_25978":52998,"_2758":53125},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3268":2145,"_28512":2094,"_19817":53127,"_5":13545,"_25978":53002,"_2758":53128},[],"RFC 5280: X.509 and CRL profile.",{"_3268":2146,"_28512":2094,"_19817":53130,"_5":13545,"_25978":53002,"_2758":53131},[],"OpenSSL: openssl-crl.",{"_3268":2147,"_28512":2094,"_19817":53133,"_5":13545,"_25978":53002,"_2758":53134},[],"OpenSSL: openssl-verify.",{"_3268":2148,"_28512":2094,"_19817":53136,"_5":13545,"_25978":53002,"_2758":53137},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3268":2149,"_28512":2094,"_19817":53139,"_5":13545,"_25978":53002,"_2758":53140},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3268":2150,"_28512":2150,"_5":13876,"_2758":53142,"_28855":53143,"_19817":53144,"_25978":2150},"Keys and cryptographic engines",[46447,47840,51840,51841],[],{"_3268":2151,"_28512":2150,"_19817":53146,"_5":13545,"_25978":2150,"_2758":53147},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3268":2152,"_28512":2150,"_5":28852,"_19817":53149,"_25978":53150,"_2758":53151},[],"/docs/pr-preview/pr-43/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3268":2153,"_28512":2150,"_5":28852,"_19817":53153,"_25978":53154,"_2758":53155},[],"/docs/pr-preview/pr-43/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3268":2154,"_28512":2150,"_5":28852,"_19817":53157,"_25978":53158,"_2758":53159},[],"/docs/pr-preview/pr-43/platform/pki/key-management#file-system","File System",{"_3268":2155,"_28512":2150,"_5":28852,"_19817":53161,"_25978":53162,"_2758":53163},[],"/docs/pr-preview/pr-43/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3268":2156,"_28512":2150,"_5":28852,"_19817":53165,"_25978":53166,"_2758":53167},[],"/docs/pr-preview/pr-43/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3268":2157,"_28512":2150,"_5":28852,"_19817":53169,"_25978":53170,"_2758":53171},[],"/docs/pr-preview/pr-43/platform/pki/key-management#aws-kms","AWS KMS",{"_3268":2158,"_28512":2150,"_5":28852,"_19817":53173,"_25978":53174,"_2758":53175},[],"/docs/pr-preview/pr-43/platform/pki/key-management#pkcs11","PKCS#11",{"_3268":2159,"_28512":2150,"_5":28852,"_19817":53177,"_25978":53178,"_2758":53179},[],"/docs/pr-preview/pr-43/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3268":2160,"_28512":2150,"_5":28852,"_19817":53181,"_25978":53182,"_2758":53183},[],"/docs/pr-preview/pr-43/platform/pki/key-management#key-inventory","Key inventory",{"_3268":2161,"_28512":2150,"_5":28852,"_19817":53185,"_25978":53186,"_2758":53187},[],"/docs/pr-preview/pr-43/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3268":2162,"_28512":2150,"_5":28852,"_19817":53189,"_25978":53190,"_2758":53191},[],"/docs/pr-preview/pr-43/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3268":2163,"_28512":2150,"_5":28852,"_19817":53193,"_25978":53194,"_2758":53195},[],"/docs/pr-preview/pr-43/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3268":2164,"_28512":2150,"_5":28852,"_19817":53197,"_25978":53198,"_2758":53199},[],"/docs/pr-preview/pr-43/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3268":2165,"_28512":2150,"_5":28852,"_19817":53201,"_25978":53202,"_2758":53203},[],"/docs/pr-preview/pr-43/platform/pki/key-management#view-details","View details",{"_3268":2166,"_28512":2150,"_5":28852,"_19817":53205,"_25978":53206,"_2758":53207},[],"/docs/pr-preview/pr-43/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3268":2167,"_28512":2150,"_5":28852,"_19817":53209,"_25978":53210,"_2758":53211},[],"/docs/pr-preview/pr-43/platform/pki/key-management#sign","Sign",{"_3268":2168,"_28512":2150,"_5":28852,"_19817":53213,"_25978":53214,"_2758":53215},[],"/docs/pr-preview/pr-43/platform/pki/key-management#verify","Verify",{"_3268":2169,"_28512":2150,"_5":28852,"_19817":53217,"_25978":53218,"_2758":53219},[],"/docs/pr-preview/pr-43/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3268":2170,"_28512":2150,"_5":28852,"_19817":53221,"_25978":53222,"_2758":53223},[],"/docs/pr-preview/pr-43/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3268":2171,"_28512":2150,"_5":28852,"_19817":53225,"_25978":53226,"_2758":53227},[],"/docs/pr-preview/pr-43/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3268":2172,"_28512":2150,"_19817":53229,"_5":13545,"_25978":2150,"_2758":53230},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3268":2173,"_28512":2150,"_19817":53232,"_5":13545,"_25978":2150,"_2758":53233},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3268":2174,"_28512":2150,"_19817":53235,"_5":13545,"_25978":53150,"_2758":53236},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3268":2175,"_28512":2150,"_19817":53238,"_5":13545,"_25978":53150,"_2758":53239},[],"In practice, it lets you:",{"_3268":2176,"_28512":2150,"_19817":53241,"_5":13545,"_25978":53150,"_2758":53242},[],"Generate new key pairs from Lamassu IoT.",{"_3268":2177,"_28512":2150,"_19817":53244,"_5":13545,"_25978":53150,"_2758":53245},[],"Import keys created externally.",{"_3268":2178,"_28512":2150,"_19817":53247,"_5":13545,"_25978":53150,"_2758":53248},[],"Delegate custody and cryptographic operations to external engines.",{"_3268":2179,"_28512":2150,"_19817":53250,"_5":13545,"_25978":53150,"_2758":53251},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3268":2180,"_28512":2150,"_19817":53253,"_5":13545,"_25978":53154,"_2758":53254},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3268":2181,"_28512":2150,"_19817":53256,"_5":13545,"_25978":53154,"_2758":53257},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3268":2182,"_28512":2150,"_19817":53259,"_5":13545,"_25978":53154,"_2758":53260},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3268":2183,"_28512":2150,"_19817":53262,"_5":13545,"_25978":53158,"_2758":53263},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3268":2184,"_28512":2150,"_19817":53265,"_5":13545,"_25978":53162,"_2758":53266},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3268":2185,"_28512":2150,"_19817":53268,"_5":13545,"_25978":53162,"_2758":53269},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3268":2186,"_28512":2150,"_19817":53271,"_5":13545,"_25978":53166,"_2758":53272},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3268":2187,"_28512":2150,"_19817":53274,"_5":13545,"_25978":53170,"_2758":53275},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3268":2188,"_28512":2150,"_19817":53277,"_5":13545,"_25978":53174,"_2758":53278},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3268":2189,"_28512":2150,"_19817":53280,"_5":13545,"_25978":53178,"_2758":53281},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3268":2190,"_28512":2150,"_19817":53283,"_5":13545,"_25978":53178,"_2758":53284},[],"Lamassu shows the enabled engines in the console.",{"_3268":2191,"_28512":2150,"_19817":53286,"_5":13545,"_25978":53178,"_2758":53287},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3268":2192,"_28512":2150,"_19817":53289,"_5":13545,"_25978":53178,"_2758":53290},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3268":2193,"_28512":2150,"_19817":53292,"_5":13545,"_25978":53182,"_2758":53293},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3268":2194,"_28512":2150,"_19817":53295,"_5":13545,"_25978":53182,"_2758":53296},[],"The table includes the following fields:",{"_3268":2195,"_28512":2150,"_19817":53298,"_5":13545,"_25978":53182,"_2758":53299},[],"**Name**: descriptive name of the key.",{"_3268":2196,"_28512":2150,"_19817":53301,"_5":13545,"_25978":53182,"_2758":53302},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3268":2197,"_28512":2150,"_19817":53304,"_5":13545,"_25978":53182,"_2758":53305},[],"**Strength**: visual indicator of cryptographic strength.",{"_3268":2198,"_28512":2150,"_19817":53307,"_5":13545,"_25978":53182,"_2758":53308},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3268":2199,"_28512":2150,"_19817":53310,"_5":13545,"_25978":53182,"_2758":53311},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3268":2200,"_28512":2150,"_19817":53313,"_5":13545,"_25978":53182,"_2758":53314},[],"**Aliases**: alternative names associated with the key.",{"_3268":2201,"_28512":2150,"_19817":53316,"_5":13545,"_25978":53182,"_2758":53317},[],"**Tags**: labels for classification and search.",{"_3268":2202,"_28512":2150,"_19817":53319,"_5":13545,"_25978":53182,"_2758":53320},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3268":2203,"_28512":2150,"_19817":53322,"_5":13545,"_25978":53182,"_2758":53323},[],"From this view you also reach the most common actions:",{"_3268":2204,"_28512":2150,"_19817":53325,"_5":13545,"_25978":53182,"_2758":53326},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3268":2205,"_28512":2150,"_19817":53328,"_5":13545,"_25978":53182,"_2758":53329},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3268":2206,"_28512":2150,"_19817":53331,"_5":13545,"_25978":53182,"_2758":53332},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3268":2207,"_28512":2150,"_19817":53334,"_5":13545,"_25978":53182,"_2758":53335},[],"**Delete Key** to remove the key from the system.",{"_3268":2208,"_28512":2150,"_19817":53337,"_5":13545,"_25978":53186,"_2758":53338},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3268":2209,"_28512":2150,"_19817":53340,"_5":13545,"_25978":53190,"_2758":53341},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3268":2210,"_28512":2150,"_19817":53343,"_5":13545,"_25978":53190,"_2758":53344},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3268":2211,"_28512":2150,"_19817":53346,"_5":13545,"_25978":53190,"_2758":53347},[],"**Key Name**: unique and descriptive name.",{"_3268":2212,"_28512":2150,"_19817":53349,"_5":13545,"_25978":53190,"_2758":53350},[],"**Crypto Engine**: engine that will keep the key.",{"_3268":2213,"_28512":2150,"_19817":53352,"_5":13545,"_25978":53190,"_2758":53353},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3268":2214,"_28512":2150,"_19817":53355,"_5":13545,"_25978":53190,"_2758":53356},[],"**Tags**: metadata to classify the key.",{"_3268":2215,"_28512":2150,"_19817":53358,"_5":13545,"_25978":53190,"_2758":53359},[],"**Metadata**: additional information for advanced uses.",{"_3268":2216,"_28512":2150,"_19817":53361,"_5":13545,"_25978":53194,"_2758":53362},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3268":2217,"_28512":2150,"_19817":53364,"_5":13545,"_25978":53194,"_2758":53365},[],"When you have an exportable private key and the destination engine supports import.",{"_3268":2218,"_28512":2150,"_19817":53367,"_5":13545,"_25978":53194,"_2758":53368},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3268":2219,"_28512":2150,"_19817":53370,"_5":13545,"_25978":53194,"_2758":53371},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3268":2220,"_28512":2150,"_19817":53373,"_5":13545,"_25978":53194,"_2758":53374},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3268":2221,"_28512":2150,"_19817":53376,"_5":13545,"_25978":53194,"_2758":53377},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3268":2222,"_28512":2150,"_19817":53379,"_5":13545,"_25978":53194,"_2758":53380},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3268":2223,"_28512":2150,"_19817":53382,"_5":13545,"_25978":53194,"_2758":53383},[],"**Tags**: labels for organization and search.",{"_3268":2224,"_28512":2150,"_19817":53385,"_5":13545,"_25978":53194,"_2758":53386},[],"**Metadata**: additional optional information.",{"_3268":2225,"_28512":2150,"_19817":53388,"_5":13545,"_25978":53194,"_2758":53389},[],"**Private Key (PEM)**: private key in PEM format.",{"_3268":2226,"_28512":2150,"_19817":53391,"_5":13545,"_25978":53194,"_2758":53392},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3268":2227,"_28512":2150,"_19817":53394,"_5":13545,"_25978":53198,"_2758":53395},[],"Each registered key has a detail view and several operational actions.",{"_3268":2228,"_28512":2150,"_19817":53397,"_5":13545,"_25978":53202,"_2758":53398},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3268":2229,"_28512":2150,"_19817":53400,"_5":13545,"_25978":53202,"_2758":53401},[],"The **Overview** tab shows, among others, these fields:",{"_3268":2230,"_28512":2150,"_19817":53403,"_5":13545,"_25978":53202,"_2758":53404},[],"**Key Name**: descriptive name.",{"_3268":2231,"_28512":2150,"_19817":53406,"_5":13545,"_25978":53202,"_2758":53407},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3268":2232,"_28512":2150,"_19817":53409,"_5":13545,"_25978":53202,"_2758":53410},[],"**Tags**: associated labels.",{"_3268":2233,"_28512":2150,"_19817":53412,"_5":13545,"_25978":53202,"_2758":53413},[],"**Aliases**: alternative names.",{"_3268":2234,"_28512":2150,"_19817":53415,"_5":13545,"_25978":53202,"_2758":53416},[],"**Crypto Engine**: engine where the key resides.",{"_3268":2235,"_28512":2150,"_19817":53418,"_5":13545,"_25978":53202,"_2758":53419},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3268":2236,"_28512":2150,"_19817":53421,"_5":13545,"_25978":53202,"_2758":53422},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3268":2237,"_28512":2150,"_19817":53424,"_5":13545,"_25978":53202,"_2758":53425},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3268":2238,"_28512":2150,"_19817":53427,"_5":13545,"_25978":53206,"_2758":53428},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3268":2239,"_28512":2150,"_19817":53430,"_5":13545,"_25978":53206,"_2758":53431},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3268":2240,"_28512":2150,"_19817":53433,"_5":13545,"_25978":53206,"_2758":53434},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3268":2241,"_28512":2150,"_19817":53436,"_5":13545,"_25978":53210,"_2758":53437},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3268":2242,"_28512":2150,"_19817":53439,"_5":13545,"_25978":53210,"_2758":53440},[],"Main fields:",{"_3268":2243,"_28512":2150,"_19817":53442,"_5":13545,"_25978":53210,"_2758":53443},[],"**Algorithm**: signing algorithm available for the key type.",{"_3268":2244,"_28512":2150,"_19817":53445,"_5":13545,"_25978":53210,"_2758":53446},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3268":2245,"_28512":2150,"_19817":53448,"_5":13545,"_25978":53210,"_2758":53449},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3268":2246,"_28512":2150,"_19817":53451,"_5":13545,"_25978":53210,"_2758":53452},[],"**Message**: content to sign.",{"_3268":2247,"_28512":2150,"_19817":53454,"_5":13545,"_25978":53210,"_2758":53455},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3268":2248,"_28512":2150,"_19817":53457,"_5":13545,"_25978":53214,"_2758":53458},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3268":2249,"_28512":2150,"_19817":53460,"_5":13545,"_25978":53214,"_2758":53440},[],{"_3268":2250,"_28512":2150,"_19817":53462,"_5":13545,"_25978":53214,"_2758":53463},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3268":2251,"_28512":2150,"_19817":53465,"_5":13545,"_25978":53214,"_2758":53466},[],"**Message Type**: `Raw` or `Digest`.",{"_3268":2252,"_28512":2150,"_19817":53468,"_5":13545,"_25978":53214,"_2758":53469},[],"**Payload Encoding**: encoding of the message.",{"_3268":2253,"_28512":2150,"_19817":53471,"_5":13545,"_25978":53214,"_2758":53472},[],"**Message**: original message or hash.",{"_3268":2254,"_28512":2150,"_19817":53474,"_5":13545,"_25978":53214,"_2758":53475},[],"**Signature**: signature to check.",{"_3268":2255,"_28512":2150,"_19817":53477,"_5":13545,"_25978":53214,"_2758":53478},[],"**Result**: indicator of the validation result.",{"_3268":2256,"_28512":2150,"_19817":53480,"_5":13545,"_25978":53218,"_2758":53481},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3268":2257,"_28512":2150,"_19817":53483,"_5":13545,"_25978":53218,"_2758":53484},[],"This flow is useful for:",{"_3268":2258,"_28512":2150,"_19817":53486,"_5":13545,"_25978":53218,"_2758":53487},[],"Requesting certificates from an external CA.",{"_3268":2259,"_28512":2150,"_19817":53489,"_5":13545,"_25978":53218,"_2758":53490},[],"Renewing an identity while keeping the same key.",{"_3268":2260,"_28512":2150,"_19817":53492,"_5":13545,"_25978":53218,"_2758":53493},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3268":2261,"_28512":2150,"_19817":53495,"_5":13545,"_25978":53218,"_2758":53496},[],"**Common Name (CN)**: main name of the identity.",{"_3268":2262,"_28512":2150,"_19817":53498,"_5":13545,"_25978":53218,"_2758":53499},[],"**Organization (O)**: organization or company.",{"_3268":2263,"_28512":2150,"_19817":53501,"_5":13545,"_25978":53218,"_2758":53502},[],"**Organizational Unit (OU)**: department or unit.",{"_3268":2264,"_28512":2150,"_19817":53504,"_5":13545,"_25978":53218,"_2758":53505},[],"**Country (C)**: two-letter country code.",{"_3268":2265,"_28512":2150,"_19817":53507,"_5":13545,"_25978":53218,"_2758":53508},[],"**State / Province (ST)**: state or province.",{"_3268":2266,"_28512":2150,"_19817":53510,"_5":13545,"_25978":53218,"_2758":53511},[],"**Locality (L)**: city or locality.",{"_3268":2267,"_28512":2150,"_19817":53513,"_5":13545,"_25978":53218,"_2758":53514},[],"**Email Address**: contact email.",{"_3268":2268,"_28512":2150,"_19817":53516,"_5":13545,"_25978":53218,"_2758":53517},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3268":2269,"_28512":2150,"_19817":53519,"_5":13545,"_25978":53218,"_2758":53520},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3268":2270,"_28512":2150,"_19817":53522,"_5":13545,"_25978":53222,"_2758":53523},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3268":2271,"_28512":2150,"_19817":53525,"_5":13545,"_25978":53222,"_2758":53526},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3268":2272,"_28512":2150,"_19817":53528,"_5":13545,"_25978":53226,"_2758":53529},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3268":2273,"_28512":2273,"_5":13876,"_2758":53531,"_28855":53532,"_19817":53533,"_25978":2273},"Online validation with OCSP",[46447,47840,51840,52457],[],{"_3268":2274,"_28512":2273,"_19817":53535,"_5":13545,"_25978":2273,"_2758":53536},[],"Query signed status and verify the responder’s response.",{"_3268":2275,"_28512":2273,"_5":28852,"_19817":53538,"_25978":53539,"_2758":53540},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3268":2276,"_28512":2273,"_5":28852,"_19817":53542,"_25978":53543,"_2758":53544},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3268":2277,"_28512":2273,"_5":28852,"_19817":53546,"_25978":53547,"_2758":53548},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3268":2278,"_28512":2273,"_5":28852,"_19817":53550,"_25978":53551,"_2758":53552},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3268":2279,"_28512":2273,"_5":28852,"_19817":53554,"_25978":53555,"_2758":53556},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3268":2280,"_28512":2273,"_5":28852,"_19817":53558,"_25978":53559,"_2758":53003},[],"/docs/pr-preview/pr-43/platform/pki/ocsp#references",{"_3268":2281,"_28512":2273,"_19817":53561,"_5":13545,"_25978":2273,"_2758":53562},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3268":2282,"_28512":2273,"_19817":53564,"_5":13545,"_25978":53539,"_2758":53565},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3268":2283,"_28512":2273,"_19817":53567,"_5":13545,"_25978":53539,"_2758":53568},[],"Record status",{"_3268":2284,"_28512":2273,"_19817":53570,"_5":13545,"_25978":53539,"_2758":53571},[],"Signed response",{"_3268":2285,"_28512":2273,"_19817":53573,"_5":13545,"_25978":53539,"_2758":51011},[],{"_3268":2286,"_28512":2273,"_19817":53575,"_5":13545,"_25978":53539,"_2758":53576},[],"`Good`.",{"_3268":2287,"_28512":2273,"_19817":53578,"_5":13545,"_25978":53539,"_2758":51028},[],{"_3268":2288,"_28512":2273,"_19817":53580,"_5":13545,"_25978":53539,"_2758":53581},[],"`Revoked`, with revocation reason and timestamp.",{"_3268":2289,"_28512":2273,"_19817":53583,"_5":13545,"_25978":53539,"_2758":53584},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3268":2290,"_28512":2273,"_19817":53586,"_5":13545,"_25978":53539,"_2758":53587},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3268":2291,"_28512":2273,"_19817":53589,"_5":13545,"_25978":53539,"_2758":53590},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3268":2292,"_28512":2273,"_19817":53592,"_5":13545,"_25978":53539,"_2758":53593},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3268":2293,"_28512":2273,"_19817":53595,"_5":13545,"_25978":53539,"_2758":53596},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3268":2294,"_28512":2273,"_19817":53598,"_5":13545,"_25978":53543,"_2758":53599},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3268":2295,"_28512":2273,"_19817":53601,"_5":13545,"_25978":53543,"_2758":53602},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3268":2296,"_28512":2273,"_19817":53604,"_5":13545,"_25978":53547,"_2758":53605},[],"The service accepts:",{"_3268":2297,"_28512":2273,"_19817":53607,"_5":13545,"_25978":53547,"_2758":49604},[],{"_3268":2298,"_28512":2273,"_19817":53609,"_5":13545,"_25978":53547,"_2758":53610},[],"VA service path",{"_3268":2299,"_28512":2273,"_19817":53612,"_5":13545,"_25978":53547,"_2758":53613},[],"Format",{"_3268":2300,"_28512":2273,"_19817":53615,"_5":13545,"_25978":53547,"_2758":53616},[],"`POST`",{"_3268":2301,"_28512":2273,"_19817":53618,"_5":13545,"_25978":53547,"_2758":53619},[],"`/ocsp`",{"_3268":2302,"_28512":2273,"_19817":53621,"_5":13545,"_25978":53547,"_2758":53622},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3268":2303,"_28512":2273,"_19817":53624,"_5":13545,"_25978":53547,"_2758":53102},[],{"_3268":2304,"_28512":2273,"_19817":53626,"_5":13545,"_25978":53547,"_2758":53627},[],"`/ocsp/{ocsp_request}`",{"_3268":2305,"_28512":2273,"_19817":53629,"_5":13545,"_25978":53547,"_2758":53630},[],"DER request encoded using padded URL Base64.",{"_3268":2306,"_28512":2273,"_19817":53632,"_5":13545,"_25978":53547,"_2758":53633},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3268":2307,"_28512":2273,"_19817":53635,"_5":13545,"_25978":53551,"_2758":53636},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3268":2308,"_28512":2273,"_19817":53638,"_5":13545,"_25978":53551,"_2758":53639},[],"Generate the request:",{"_3268":2309,"_28512":2273,"_19817":53641,"_5":13545,"_25978":53551,"_2758":53642},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3268":2310,"_28512":2273,"_19817":53644,"_5":13545,"_25978":53551,"_2758":53645},[],"Replace the example URL with the inspected endpoint:",{"_3268":2311,"_28512":2273,"_19817":53647,"_5":13545,"_25978":53551,"_2758":53648},[],"Verify the returned DER:",{"_3268":2312,"_28512":2273,"_19817":53650,"_5":13545,"_25978":53551,"_2758":53651},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3268":2313,"_28512":2273,"_19817":53653,"_5":13545,"_25978":53555,"_2758":53654},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3268":2314,"_28512":2273,"_19817":53656,"_5":13545,"_25978":53555,"_2758":53657},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3268":2315,"_28512":2273,"_19817":53659,"_5":13545,"_25978":53559,"_2758":53660},[],"RFC 6960: OCSP.",{"_3268":2316,"_28512":2273,"_19817":53662,"_5":13545,"_25978":53559,"_2758":53663},[],"OpenSSL: openssl-ocsp.",{"_3268":2317,"_28512":2273,"_19817":53665,"_5":13545,"_25978":53559,"_2758":53666},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3268":2318,"_28512":2273,"_19817":53668,"_5":13545,"_25978":53559,"_2758":53140},[],{"_3268":2319,"_28512":2319,"_5":13876,"_2758":51840,"_28855":53670,"_19817":53671,"_25978":2319},[46447,47840,51840],[],{"_3268":2320,"_28512":2319,"_19817":53673,"_5":13545,"_25978":2319,"_2758":53674},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3268":2321,"_28512":2319,"_5":28852,"_19817":53676,"_25978":53677,"_2758":51152},[],"/docs/pr-preview/pr-43/platform/pki/overview#start-here",{"_3268":2322,"_28512":2319,"_5":28852,"_19817":53679,"_25978":53680,"_2758":53681},[],"/docs/pr-preview/pr-43/platform/pki/overview#what-you-need","What you need",{"_3268":2323,"_28512":2319,"_5":28852,"_19817":53683,"_25978":53684,"_2758":51684},[],"/docs/pr-preview/pr-43/platform/pki/overview#core-capabilities",{"_3268":2324,"_28512":2319,"_5":28852,"_19817":53686,"_25978":53687,"_2758":51688},[],"/docs/pr-preview/pr-43/platform/pki/overview#build-your-trust-hierarchy",{"_3268":2325,"_28512":2319,"_5":28852,"_19817":53689,"_25978":53690,"_2758":51692},[],"/docs/pr-preview/pr-43/platform/pki/overview#protect-cryptographic-keys",{"_3268":2326,"_28512":2319,"_5":28852,"_19817":53692,"_25978":53693,"_2758":51696},[],"/docs/pr-preview/pr-43/platform/pki/overview#issue-and-control-certificates",{"_3268":2327,"_28512":2319,"_5":28852,"_19817":53695,"_25978":53696,"_2758":51704},[],"/docs/pr-preview/pr-43/platform/pki/overview#publish-validation-status",{"_3268":2328,"_28512":2319,"_5":28852,"_19817":53698,"_25978":53699,"_2758":53700},[],"/docs/pr-preview/pr-43/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3268":2329,"_28512":2319,"_5":28852,"_19817":53702,"_25978":53703,"_2758":52624},[],"/docs/pr-preview/pr-43/platform/pki/overview#continue",{"_3268":2330,"_28512":2319,"_19817":53705,"_5":13545,"_25978":2319,"_2758":53706},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3268":2331,"_28512":2319,"_19817":53708,"_5":13545,"_25978":53677,"_2758":53709},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3268":2332,"_28512":2319,"_19817":53711,"_5":13545,"_25978":53677,"_2758":53712},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3268":2333,"_28512":2319,"_19817":53714,"_5":13545,"_25978":53680,"_2758":53715},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3268":2334,"_28512":2319,"_19817":53717,"_5":13545,"_25978":53680,"_2758":53718},[],"An available cryptographic engine to keep the authority's key.",{"_3268":2335,"_28512":2319,"_19817":53720,"_5":13545,"_25978":53680,"_2758":53721},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3268":2336,"_28512":2319,"_19817":53723,"_5":13545,"_25978":53680,"_2758":53724},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3268":2337,"_28512":2319,"_19817":53726,"_5":13545,"_25978":53680,"_2758":53727},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3268":2338,"_28512":2319,"_19817":53729,"_5":13545,"_25978":53687,"_2758":53730},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3268":2339,"_28512":2319,"_19817":53732,"_5":13545,"_25978":53690,"_2758":53733},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3268":2340,"_28512":2319,"_19817":53735,"_5":13545,"_25978":53693,"_2758":53736},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3268":2341,"_28512":2319,"_19817":53738,"_5":13545,"_25978":53696,"_2758":53739},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3268":2342,"_28512":2319,"_19817":53741,"_5":13545,"_25978":53699,"_2758":53742},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3268":2343,"_28512":2319,"_19817":53744,"_5":13545,"_25978":53699,"_2758":53745},[],"its subject and extensions identify the expected client;",{"_3268":2344,"_28512":2319,"_19817":53747,"_5":13545,"_25978":53699,"_2758":53748},[],"its public key matches the client's private key;",{"_3268":2345,"_28512":2319,"_19817":53750,"_5":13545,"_25978":53699,"_2758":53751},[],"its chain reaches a root trusted by the consumer;",{"_3268":2346,"_28512":2319,"_19817":53753,"_5":13545,"_25978":53699,"_2758":53754},[],"its dates and usages allow the operation;",{"_3268":2347,"_28512":2319,"_19817":53756,"_5":13545,"_25978":53699,"_2758":53757},[],"the consumer applies revocation checks and authorization.",{"_3268":2348,"_28512":2319,"_19817":53759,"_5":13545,"_25978":53699,"_2758":53760},[],"The issuance path includes the first independent checks.",{"_3268":2349,"_28512":2319,"_19817":53762,"_5":13545,"_25978":53703,"_2758":53763},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3268":2350,"_28512":2319,"_19817":53765,"_5":13545,"_25978":53703,"_2758":53766},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3268":2351,"_28512":2319,"_19817":53768,"_5":13545,"_25978":53703,"_2758":53769},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3268":2352,"_28512":2352,"_5":13876,"_2758":53771,"_28855":53772,"_19817":53773,"_25978":2352},"Create your first CA",[46447,47840,51840,51277],[],{"_3268":2353,"_28512":2352,"_19817":53775,"_5":13545,"_25978":2352,"_2758":53776},[],"Create an evaluation root and check its certificate before issuing.",{"_3268":2354,"_28512":2352,"_5":28852,"_19817":53778,"_25978":53779,"_2758":46457},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3268":2355,"_28512":2352,"_5":28852,"_19817":53781,"_25978":53782,"_2758":53783},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3268":2356,"_28512":2352,"_5":28852,"_19817":53785,"_25978":53786,"_2758":53787},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3268":2357,"_28512":2352,"_5":28852,"_19817":53789,"_25978":53790,"_2758":53791},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3268":2358,"_28512":2352,"_5":28852,"_19817":53793,"_25978":53794,"_2758":53795},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3268":2359,"_28512":2352,"_5":28852,"_19817":53797,"_25978":53798,"_2758":53799},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3268":2360,"_28512":2352,"_5":28852,"_19817":53801,"_25978":53802,"_2758":53803},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3268":2361,"_28512":2352,"_5":28852,"_19817":53805,"_25978":53806,"_2758":51534},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3268":2362,"_28512":2352,"_5":28852,"_19817":53808,"_25978":53809,"_2758":46481},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3268":2363,"_28512":2352,"_19817":53811,"_5":13545,"_25978":2352,"_2758":53812},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3268":2364,"_28512":2352,"_19817":53814,"_5":13545,"_25978":53779,"_2758":53815},[],"Console access and permission to create keys and authorities.",{"_3268":2365,"_28512":2352,"_19817":53817,"_5":13545,"_25978":53779,"_2758":53818},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3268":2366,"_28512":2352,"_19817":53820,"_5":13545,"_25978":53779,"_2758":53821},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3268":2367,"_28512":2352,"_19817":53823,"_5":13545,"_25978":53779,"_2758":53824},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3268":2368,"_28512":2352,"_19817":53826,"_5":13545,"_25978":53782,"_2758":53827},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3268":2369,"_28512":2352,"_19817":53829,"_5":13545,"_25978":53782,"_2758":53830},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3268":2370,"_28512":2352,"_19817":53832,"_5":13545,"_25978":53786,"_2758":53833},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3268":2371,"_28512":2352,"_19817":53835,"_5":13545,"_25978":53786,"_2758":53836},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3268":2372,"_28512":2352,"_19817":53838,"_5":13545,"_25978":53790,"_2758":53839},[],"Select **Root CA** and complete:",{"_3268":2373,"_28512":2352,"_19817":53841,"_5":13545,"_25978":53790,"_2758":53842},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3268":2374,"_28512":2352,"_19817":53844,"_5":13545,"_25978":53790,"_2758":53845},[],"**Subject**: organization and country details for your evaluation.",{"_3268":2375,"_28512":2352,"_19817":53847,"_5":13545,"_25978":53790,"_2758":53848},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3268":2376,"_28512":2352,"_19817":53850,"_5":13545,"_25978":53790,"_2758":53851},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3268":2377,"_28512":2352,"_19817":53853,"_5":13545,"_25978":53790,"_2758":53854},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3268":2378,"_28512":2352,"_19817":53856,"_5":13545,"_25978":53794,"_2758":53857},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3268":2379,"_28512":2352,"_19817":53859,"_5":13545,"_25978":53798,"_2758":53860},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3268":2380,"_28512":2352,"_19817":53862,"_5":13545,"_25978":53798,"_2758":53863},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3268":2381,"_28512":2352,"_19817":53865,"_5":13545,"_25978":53802,"_2758":53866},[],"Run from the directory where you saved `ca.pem`:",{"_3268":2382,"_28512":2352,"_19817":53868,"_5":13545,"_25978":53802,"_2758":53869},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3268":2383,"_28512":2352,"_19817":53871,"_5":13545,"_25978":53802,"_2758":53872},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3268":2384,"_28512":2352,"_19817":53874,"_5":13545,"_25978":53806,"_2758":53875},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3268":2385,"_28512":2352,"_19817":53877,"_5":13545,"_25978":53806,"_2758":53878},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3268":2386,"_28512":2352,"_19817":53880,"_5":13545,"_25978":53806,"_2758":53881},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3268":2387,"_28512":2352,"_19817":53883,"_5":13545,"_25978":53806,"_2758":53884},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3268":2388,"_28512":2352,"_19817":53886,"_5":13545,"_25978":53809,"_2758":53887},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3268":2389,"_28512":2389,"_5":13876,"_2758":53889,"_28855":53890,"_19817":53891,"_25978":2389},"Issue and verify a certificate",[46447,47840,51840,51277],[],{"_3268":2390,"_28512":2389,"_19817":53893,"_5":13545,"_25978":2389,"_2758":53894},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3268":2391,"_28512":2389,"_5":28852,"_19817":53896,"_25978":53897,"_2758":46457},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3268":2392,"_28512":2389,"_5":28852,"_19817":53899,"_25978":53900,"_2758":53901},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3268":2393,"_28512":2389,"_5":28852,"_19817":53903,"_25978":53904,"_2758":53905},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3268":2394,"_28512":2389,"_5":28852,"_19817":53907,"_25978":53908,"_2758":53909},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3268":2395,"_28512":2389,"_5":28852,"_19817":53911,"_25978":53912,"_2758":53913},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3268":2396,"_28512":2389,"_5":28852,"_19817":53915,"_25978":53916,"_2758":53917},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3268":2397,"_28512":2389,"_5":28852,"_19817":53919,"_25978":53920,"_2758":53921},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3268":2398,"_28512":2389,"_5":28852,"_19817":53923,"_25978":53924,"_2758":53925},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3268":2399,"_28512":2389,"_5":28852,"_19817":53927,"_25978":53928,"_2758":53929},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3268":2400,"_28512":2389,"_5":28852,"_19817":53931,"_25978":53932,"_2758":53933},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3268":2401,"_28512":2389,"_5":28852,"_19817":53935,"_25978":53936,"_2758":51534},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3268":2402,"_28512":2389,"_5":28852,"_19817":53938,"_25978":53939,"_2758":46481},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/issue-certificate#next-step",{"_3268":2403,"_28512":2389,"_19817":53941,"_5":13545,"_25978":2389,"_2758":53942},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3268":2404,"_28512":2389,"_19817":53944,"_5":13545,"_25978":53897,"_2758":53945},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3268":2405,"_28512":2389,"_19817":53947,"_5":13545,"_25978":53897,"_2758":53948},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3268":2406,"_28512":2389,"_19817":53950,"_5":13545,"_25978":53897,"_2758":53951},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3268":2407,"_28512":2389,"_19817":53953,"_5":13545,"_25978":53897,"_2758":53954},[],"A client identifier: here we use `device-001`.",{"_3268":2408,"_28512":2389,"_19817":53956,"_5":13545,"_25978":53897,"_2758":53957},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3268":2409,"_28512":2389,"_19817":53959,"_5":13545,"_25978":53900,"_2758":53960},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3268":2410,"_28512":2389,"_19817":53962,"_5":13545,"_25978":53904,"_2758":53963},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3268":2411,"_28512":2389,"_19817":53965,"_5":13545,"_25978":53904,"_2758":53966},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3268":2412,"_28512":2389,"_19817":53968,"_5":13545,"_25978":53908,"_2758":53969},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3268":2413,"_28512":2389,"_19817":53971,"_5":13545,"_25978":53908,"_2758":53972},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3268":2414,"_28512":2389,"_19817":53974,"_5":13545,"_25978":53912,"_2758":53975},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3268":2415,"_28512":2389,"_19817":53977,"_5":13545,"_25978":53912,"_2758":53978},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3268":2416,"_28512":2389,"_19817":53980,"_5":13545,"_25978":53916,"_2758":53981},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3268":2417,"_28512":2389,"_19817":53983,"_5":13545,"_25978":53920,"_2758":53984},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3268":2418,"_28512":2389,"_19817":53986,"_5":13545,"_25978":53924,"_2758":53987},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3268":2419,"_28512":2389,"_19817":53989,"_5":13545,"_25978":53928,"_2758":53990},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3268":2420,"_28512":2389,"_19817":53992,"_5":13545,"_25978":53928,"_2758":53993},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3268":2421,"_28512":2389,"_19817":53995,"_5":13545,"_25978":53928,"_2758":53996},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3268":2422,"_28512":2389,"_19817":53998,"_5":13545,"_25978":53932,"_2758":53999},[],"In Bash, compare the two public-key digests:",{"_3268":2423,"_28512":2389,"_19817":54001,"_5":13545,"_25978":53932,"_2758":54002},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3268":2424,"_28512":2389,"_19817":54004,"_5":13545,"_25978":53932,"_2758":54005},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3268":2425,"_28512":2389,"_19817":54007,"_5":13545,"_25978":53936,"_2758":51618},[],{"_3268":2426,"_28512":2389,"_19817":54009,"_5":13545,"_25978":53936,"_2758":54010},[],"What to review",{"_3268":2427,"_28512":2389,"_19817":54012,"_5":13545,"_25978":53936,"_2758":54013},[],"The CA rejects issuance",{"_3268":2428,"_28512":2389,"_19817":54015,"_5":13545,"_25978":53936,"_2758":54016},[],"Permissions, CA state and key, algorithm and profile.",{"_3268":2429,"_28512":2389,"_19817":54018,"_5":13545,"_25978":53936,"_2758":54019},[],"Different subject or usages",{"_3268":2430,"_28512":2389,"_19817":54021,"_5":13545,"_25978":53936,"_2758":54022},[],"Applied profile and requested values.",{"_3268":2431,"_28512":2389,"_19817":54024,"_5":13545,"_25978":53936,"_2758":54025},[],"Issuer cannot be found",{"_3268":2432,"_28512":2389,"_19817":54027,"_5":13545,"_25978":53936,"_2758":54028},[],"Downloaded CA and required intermediate chain.",{"_3268":2433,"_28512":2389,"_19817":54030,"_5":13545,"_25978":53936,"_2758":54031},[],"Validity fails",{"_3268":2434,"_28512":2389,"_19817":54033,"_5":13545,"_25978":53936,"_2758":54034},[],"Certificate and CA dates, and the computer's clock.",{"_3268":2435,"_28512":2389,"_19817":54036,"_5":13545,"_25978":53936,"_2758":54037},[],"Public-key digests differ",{"_3268":2436,"_28512":2389,"_19817":54039,"_5":13545,"_25978":53936,"_2758":54040},[],"Certificate and key files from the same issuance.",{"_3268":2437,"_28512":2389,"_19817":54042,"_5":13545,"_25978":53936,"_2758":54043},[],"See PKI diagnostics to narrow an issuance failure.",{"_3268":2438,"_28512":2389,"_19817":54045,"_5":13545,"_25978":53939,"_2758":54046},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3268":2439,"_28512":2389,"_19817":54048,"_5":13545,"_25978":53939,"_2758":54049},[],"Manage certificates for inspection, status and revocation.",{"_3268":2440,"_28512":2389,"_19817":54051,"_5":13545,"_25978":53939,"_2758":54052},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3268":2441,"_28512":2389,"_19817":54054,"_5":13545,"_25978":53939,"_2758":54055},[],"Prepare EST for the device to request its next identities.",{"_3268":2442,"_28512":2389,"_19817":54057,"_5":13545,"_25978":53939,"_2758":54058},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3268":2443,"_28512":2443,"_5":13876,"_2758":54060,"_28855":54061,"_19817":54062,"_25978":2443},"PKI getting started",[46447,47840,51840,51277],[],{"_3268":2444,"_28512":2443,"_19817":54064,"_5":13545,"_25978":2443,"_2758":54065},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3268":2445,"_28512":2443,"_5":28852,"_19817":54067,"_25978":54068,"_2758":46457},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#before-you-begin",{"_3268":2446,"_28512":2443,"_5":28852,"_19817":54070,"_25978":54071,"_2758":54072},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3268":2447,"_28512":2443,"_5":28852,"_19817":54074,"_25978":54075,"_2758":51469},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#expected-result",{"_3268":2448,"_28512":2443,"_5":28852,"_19817":54077,"_25978":54078,"_2758":54079},[],"/docs/pr-preview/pr-43/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3268":2449,"_28512":2443,"_19817":54081,"_5":13545,"_25978":2443,"_2758":54082},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3268":2450,"_28512":2443,"_19817":54084,"_5":13545,"_25978":54068,"_2758":54085},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3268":2451,"_28512":2443,"_19817":54087,"_5":13545,"_25978":54068,"_2758":54088},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3268":2452,"_28512":2443,"_19817":54090,"_5":13545,"_25978":54068,"_2758":54091},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3268":2453,"_28512":2443,"_19817":54093,"_5":13545,"_25978":54068,"_2758":54094},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3268":2454,"_28512":2443,"_19817":54096,"_5":13545,"_25978":54068,"_2758":54097},[],"A working directory with restricted access for the downloaded key.",{"_3268":2455,"_28512":2443,"_19817":54099,"_5":13545,"_25978":54071,"_2758":54100},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3268":2456,"_28512":2443,"_19817":54102,"_5":13545,"_25978":54071,"_2758":54103},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3268":2457,"_28512":2443,"_19817":54105,"_5":13545,"_25978":54071,"_2758":54106},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3268":2458,"_28512":2443,"_19817":54108,"_5":13545,"_25978":54071,"_2758":54109},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3268":2459,"_28512":2443,"_19817":54111,"_5":13545,"_25978":54075,"_2758":54112},[],"File or resource",{"_3268":2460,"_28512":2443,"_19817":54114,"_5":13545,"_25978":54075,"_2758":51466},[],{"_3268":2461,"_28512":2443,"_19817":54116,"_5":13545,"_25978":54075,"_2758":54117},[],"Active root CA and `ca.pem`",{"_3268":2462,"_28512":2443,"_19817":54119,"_5":13545,"_25978":54075,"_2758":54120},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3268":2463,"_28512":2443,"_19817":54122,"_5":13545,"_25978":54075,"_2758":54123},[],"End-entity certificate and `device.crt`",{"_3268":2464,"_28512":2443,"_19817":54125,"_5":13545,"_25978":54075,"_2758":54126},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3268":2465,"_28512":2443,"_19817":54128,"_5":13545,"_25978":54075,"_2758":54129},[],"Private key `device.key`",{"_3268":2466,"_28512":2443,"_19817":54131,"_5":13545,"_25978":54075,"_2758":54132},[],"Its public key matches the one included in `device.crt`.",{"_3268":2467,"_28512":2443,"_19817":54134,"_5":13545,"_25978":54075,"_2758":54135},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3268":2468,"_28512":2443,"_19817":54137,"_5":13545,"_25978":54078,"_2758":54138},[],"To operate certificates, continue with Certificates and Validation.",{"_3268":2469,"_28512":2443,"_19817":54140,"_5":13545,"_25978":54078,"_2758":54141},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3268":2470,"_28512":2443,"_19817":54143,"_5":13545,"_25978":54078,"_2758":54144},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3268":2471,"_28512":2471,"_5":13876,"_2758":54146,"_28855":54147,"_19817":54148,"_25978":2471},"PKI troubleshooting",[46447,47840,51840,50418],[],{"_3268":2472,"_28512":2471,"_19817":54150,"_5":13545,"_25978":2471,"_2758":54151},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3268":2473,"_28512":2471,"_5":28852,"_19817":54153,"_25978":54154,"_2758":54155},[],"/docs/pr-preview/pr-43/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3268":2474,"_28512":2471,"_5":28852,"_19817":54157,"_25978":54158,"_2758":54159},[],"/docs/pr-preview/pr-43/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3268":2475,"_28512":2471,"_5":28852,"_19817":54161,"_25978":54162,"_2758":54163},[],"/docs/pr-preview/pr-43/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3268":2476,"_28512":2471,"_19817":54165,"_5":13545,"_25978":2471,"_2758":54166},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3268":2477,"_28512":2471,"_19817":54168,"_5":13545,"_25978":2471,"_2758":54169},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3268":2478,"_28512":2471,"_19817":54171,"_5":13545,"_25978":54154,"_2758":51466},[],{"_3268":2479,"_28512":2471,"_19817":54173,"_5":13545,"_25978":54154,"_2758":54174},[],"What to inspect",{"_3268":2480,"_28512":2471,"_19817":54176,"_5":13545,"_25978":54154,"_2758":46481},[],{"_3268":2481,"_28512":2471,"_19817":54178,"_5":13545,"_25978":54154,"_2758":50685},[],{"_3268":2482,"_28512":2471,"_19817":54180,"_5":13545,"_25978":54154,"_2758":54181},[],"Exists, is active and has usable dates.",{"_3268":2483,"_28512":2471,"_19817":54183,"_5":13545,"_25978":54154,"_2758":54184},[],"Authorities.",{"_3268":2484,"_28512":2471,"_19817":54186,"_5":13545,"_25978":54154,"_2758":54187},[],"Key",{"_3268":2485,"_28512":2471,"_19817":54189,"_5":13545,"_25978":54154,"_2758":54190},[],"The record has a usable private key and the engine can sign.",{"_3268":2486,"_28512":2471,"_19817":54192,"_5":13545,"_25978":54154,"_2758":54193},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3268":2487,"_28512":2471,"_19817":54195,"_5":13545,"_25978":54154,"_2758":54196},[],"CSR",{"_3268":2488,"_28512":2471,"_19817":54198,"_5":13545,"_25978":54154,"_2758":54199},[],"Correct PEM and verifiable signature.",{"_3268":2489,"_28512":2471,"_19817":54201,"_5":13545,"_25978":54154,"_2758":54202},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3268":2490,"_28512":2471,"_19817":54204,"_5":13545,"_25978":54154,"_2758":54205},[],"Profile",{"_3268":2491,"_28512":2471,"_19817":54207,"_5":13545,"_25978":54154,"_2758":54208},[],"Selected source, existing ID, allowed algorithm and size.",{"_3268":2492,"_28512":2471,"_19817":54210,"_5":13545,"_25978":54154,"_2758":54211},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3268":2493,"_28512":2471,"_19817":54213,"_5":13545,"_25978":54154,"_2758":51618},[],{"_3268":2494,"_28512":2471,"_19817":54215,"_5":13545,"_25978":54154,"_2758":54216},[],"Appropriate subject, SAN, usages and dates.",{"_3268":2495,"_28512":2471,"_19817":54218,"_5":13545,"_25978":54154,"_2758":54219},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3268":2496,"_28512":2471,"_19817":54221,"_5":13545,"_25978":54154,"_2758":54222},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3268":2497,"_28512":2471,"_19817":54224,"_5":13545,"_25978":54154,"_2758":54225},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3268":2498,"_28512":2471,"_19817":54227,"_5":13545,"_25978":54158,"_2758":54228},[],"Check each boundary independently:",{"_3268":2499,"_28512":2471,"_19817":54230,"_5":13545,"_25978":54158,"_2758":54231},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3268":2500,"_28512":2471,"_19817":54233,"_5":13545,"_25978":54158,"_2758":54234},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3268":2501,"_28512":2471,"_19817":54236,"_5":13545,"_25978":54158,"_2758":54237},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3268":2502,"_28512":2471,"_19817":54239,"_5":13545,"_25978":54158,"_2758":54240},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3268":2503,"_28512":2471,"_19817":54242,"_5":13545,"_25978":54158,"_2758":54243},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3268":2504,"_28512":2471,"_19817":54245,"_5":13545,"_25978":54158,"_2758":54246},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3268":2505,"_28512":2471,"_19817":54248,"_5":13545,"_25978":54162,"_2758":54249},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3268":2506,"_28512":2471,"_19817":54251,"_5":13545,"_25978":54162,"_2758":54252},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3268":2507,"_28512":2507,"_5":13876,"_2758":54254,"_28855":54255,"_19817":54257,"_25978":2507},"3.8.0 to 4.0.0",[46447,54256],"Upgrades",[],{"_3268":2508,"_28512":2507,"_19817":54259,"_5":13545,"_25978":2507,"_2758":54260},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3268":2509,"_28512":2507,"_5":28852,"_19817":54262,"_25978":54263,"_2758":54264},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3268":2510,"_28512":2507,"_5":28852,"_19817":54266,"_25978":54267,"_2758":54268},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3268":2511,"_28512":2507,"_5":28852,"_19817":54270,"_25978":54271,"_2758":54272},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3268":2512,"_28512":2507,"_5":28852,"_19817":54274,"_25978":54275,"_2758":54276},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3268":2513,"_28512":2507,"_5":28852,"_19817":54278,"_25978":54279,"_2758":54280},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3268":2514,"_28512":2507,"_5":28852,"_19817":54282,"_25978":54283,"_2758":54284},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3268":2515,"_28512":2507,"_5":28852,"_19817":54286,"_25978":54287,"_2758":54288},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3268":2516,"_28512":2507,"_5":28852,"_19817":54290,"_25978":54291,"_2758":54292},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3268":2517,"_28512":2507,"_5":28852,"_19817":54294,"_25978":54295,"_2758":54296},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3268":2518,"_28512":2507,"_5":28852,"_19817":54298,"_25978":54299,"_2758":54300},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3268":2519,"_28512":2507,"_5":28852,"_19817":54302,"_25978":54303,"_2758":54304},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3268":2520,"_28512":2507,"_5":28852,"_19817":54306,"_25978":54307,"_2758":54308},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3268":2521,"_28512":2507,"_5":28852,"_19817":54310,"_25978":54311,"_2758":54312},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3268":2522,"_28512":2507,"_5":28852,"_19817":54314,"_25978":54315,"_2758":54316},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3268":2523,"_28512":2507,"_5":28852,"_19817":54318,"_25978":54319,"_2758":54320},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3268":2524,"_28512":2507,"_5":28852,"_19817":54322,"_25978":54323,"_2758":54324},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3268":2525,"_28512":2507,"_5":28852,"_19817":54326,"_25978":54327,"_2758":54328},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3268":2526,"_28512":2507,"_5":28852,"_19817":54330,"_25978":54331,"_2758":54332},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3268":2527,"_28512":2507,"_5":28852,"_19817":54334,"_25978":54335,"_2758":54336},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3268":2528,"_28512":2507,"_5":28852,"_19817":54338,"_25978":54339,"_2758":54340},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3268":2529,"_28512":2507,"_5":28852,"_19817":54342,"_25978":54343,"_2758":54344},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3268":2530,"_28512":2507,"_5":28852,"_19817":54346,"_25978":54347,"_2758":54348},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3268":2531,"_28512":2507,"_5":28852,"_19817":54350,"_25978":54351,"_2758":54352},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3268":2532,"_28512":2507,"_5":28852,"_19817":54354,"_25978":54355,"_2758":54356},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3268":2533,"_28512":2507,"_5":28852,"_19817":54358,"_25978":54359,"_2758":54360},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3268":2534,"_28512":2507,"_5":28852,"_19817":54362,"_25978":54363,"_2758":54364},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3268":2535,"_28512":2507,"_5":28852,"_19817":54366,"_25978":54367,"_2758":54368},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3268":2536,"_28512":2507,"_5":28852,"_19817":54370,"_25978":54371,"_2758":54372},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3268":2537,"_28512":2507,"_5":28852,"_19817":54374,"_25978":54375,"_2758":54376},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3268":2538,"_28512":2507,"_5":28852,"_19817":54378,"_25978":54379,"_2758":54380},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3268":2539,"_28512":2507,"_5":28852,"_19817":54382,"_25978":54383,"_2758":54384},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3268":2540,"_28512":2507,"_5":28852,"_19817":54386,"_25978":54387,"_2758":54388},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3268":2541,"_28512":2507,"_5":28852,"_19817":54390,"_25978":54391,"_2758":54392},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3268":2542,"_28512":2507,"_5":28852,"_19817":54394,"_25978":54395,"_2758":50418},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3268":2543,"_28512":2507,"_5":28852,"_19817":54397,"_25978":54398,"_2758":54399},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3268":2544,"_28512":2507,"_5":28852,"_19817":54401,"_25978":54402,"_2758":54403},[],"/docs/pr-preview/pr-43/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3268":2545,"_28512":2507,"_19817":54405,"_5":13545,"_25978":2507,"_2758":54406},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3268":2546,"_28512":2507,"_19817":54408,"_5":13545,"_25978":2507,"_2758":54409},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3268":2547,"_28512":2507,"_19817":54411,"_5":13545,"_25978":2507,"_2758":54412},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3268":2548,"_28512":2507,"_19817":54414,"_5":13545,"_25978":2507,"_2758":54415},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3268":2549,"_28512":2507,"_19817":54417,"_5":13545,"_25978":2507,"_2758":54418},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3268":2550,"_28512":2507,"_19817":54420,"_5":13545,"_25978":2507,"_2758":54421},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3268":2551,"_28512":2507,"_19817":54423,"_5":13545,"_25978":2507,"_2758":54424},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3268":2552,"_28512":2507,"_19817":54426,"_5":13545,"_25978":54267,"_2758":54427},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3268":2553,"_28512":2507,"_19817":54429,"_5":13545,"_25978":54267,"_2758":54430},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3268":2554,"_28512":2507,"_19817":54432,"_5":13545,"_25978":54271,"_2758":54433},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3268":2555,"_28512":2507,"_19817":54435,"_5":13545,"_25978":54271,"_2758":54436},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3268":2556,"_28512":2507,"_19817":54438,"_5":13545,"_25978":54275,"_2758":54439},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3268":2557,"_28512":2507,"_19817":54441,"_5":13545,"_25978":54279,"_2758":54442},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3268":2558,"_28512":2507,"_19817":54444,"_5":13545,"_25978":54279,"_2758":54445},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3268":2559,"_28512":2507,"_19817":54447,"_5":13545,"_25978":54279,"_2758":54448},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3268":2560,"_28512":2507,"_19817":54450,"_5":13545,"_25978":54279,"_2758":54451},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3268":2561,"_28512":2507,"_19817":54453,"_5":13545,"_25978":54279,"_2758":54454},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3268":2562,"_28512":2507,"_19817":54456,"_5":13545,"_25978":54283,"_2758":54457},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3268":2563,"_28512":2507,"_19817":54459,"_5":13545,"_25978":54283,"_2758":54460},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3268":2564,"_28512":2507,"_19817":54462,"_5":13545,"_25978":54283,"_2758":54463},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3268":2565,"_28512":2507,"_19817":54465,"_5":13545,"_25978":54283,"_2758":54466},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3268":2566,"_28512":2507,"_19817":54468,"_5":13545,"_25978":54283,"_2758":54469},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3268":2567,"_28512":2507,"_19817":54471,"_5":13545,"_25978":54287,"_2758":54472},[],"Change",{"_3268":2568,"_28512":2507,"_19817":54474,"_5":13545,"_25978":54287,"_2758":54475},[],"Who is affected",{"_3268":2569,"_28512":2507,"_19817":54477,"_5":13545,"_25978":54287,"_2758":54478},[],"Severity",{"_3268":2570,"_28512":2507,"_19817":54480,"_5":13545,"_25978":54287,"_2758":54481},[],"Action",{"_3268":2571,"_28512":2507,"_19817":54483,"_5":13545,"_25978":54287,"_2758":54296},[],{"_3268":2572,"_28512":2507,"_19817":54485,"_5":13545,"_25978":54287,"_2758":54486},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3268":2573,"_28512":2507,"_19817":54488,"_5":13545,"_25978":54287,"_2758":54489},[],"High: KMS and VA start on empty volumes",{"_3268":2574,"_28512":2507,"_19817":54491,"_5":13545,"_25978":54287,"_2758":54492},[],"Copy the data into the new volumes",{"_3268":2575,"_28512":2507,"_19817":54494,"_5":13545,"_25978":54287,"_2758":54300},[],{"_3268":2576,"_28512":2507,"_19817":54496,"_5":13545,"_25978":54287,"_2758":54497},[],"Every Helm release",{"_3268":2577,"_28512":2507,"_19817":54499,"_5":13545,"_25978":54287,"_2758":54500},[],"High: `helm upgrade` fails",{"_3268":2578,"_28512":2507,"_19817":54502,"_5":13545,"_25978":54287,"_2758":54503},[],"Remove or rename legacy keys",{"_3268":2579,"_28512":2507,"_19817":54505,"_5":13545,"_25978":54287,"_2758":54304},[],{"_3268":2580,"_28512":2507,"_19817":54507,"_5":13545,"_25978":54287,"_2758":54508},[],"Every deployment",{"_3268":2581,"_28512":2507,"_19817":54510,"_5":13545,"_25978":54287,"_2758":54511},[],"High: without a bootstrap principal there is no administrator",{"_3268":2582,"_28512":2507,"_19817":54513,"_5":13545,"_25978":54287,"_2758":54514},[],"Configure `services.authz`",{"_3268":2583,"_28512":2507,"_19817":54516,"_5":13545,"_25978":54287,"_2758":54308},[],{"_3268":2584,"_28512":2507,"_19817":54518,"_5":13545,"_25978":54287,"_2758":54497},[],{"_3268":2585,"_28512":2507,"_19817":54520,"_5":13545,"_25978":54287,"_2758":54521},[],"High: `helm upgrade` fails on the old keys",{"_3268":2586,"_28512":2507,"_19817":54523,"_5":13545,"_25978":54287,"_2758":54524},[],"Move JWKS and roles into `services.authz`",{"_3268":2587,"_28512":2507,"_19817":54526,"_5":13545,"_25978":54287,"_2758":54328},[],{"_3268":2588,"_28512":2507,"_19817":54528,"_5":13545,"_25978":54287,"_2758":54529},[],"3.8.0 deployments with per-service databases",{"_3268":2589,"_28512":2507,"_19817":54531,"_5":13545,"_25978":54287,"_2758":54532},[],"High: services find no data, or a migration aborts",{"_3268":2590,"_28512":2507,"_19817":54534,"_5":13545,"_25978":54287,"_2758":54535},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3268":2591,"_28512":2507,"_19817":54537,"_5":13545,"_25978":54287,"_2758":54332},[],{"_3268":2592,"_28512":2507,"_19817":54539,"_5":13545,"_25978":54287,"_2758":54540},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3268":2593,"_28512":2507,"_19817":54542,"_5":13545,"_25978":54287,"_2758":54543},[],"High: the backend no longer starts with them",{"_3268":2594,"_28512":2507,"_19817":54545,"_5":13545,"_25978":54287,"_2758":54546},[],"Move to PostgreSQL before upgrading",{"_3268":2595,"_28512":2507,"_19817":54548,"_5":13545,"_25978":54287,"_2758":54549},[],"Webhooks with file references",{"_3268":2596,"_28512":2507,"_19817":54551,"_5":13545,"_25978":54287,"_2758":54552},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3268":2597,"_28512":2507,"_19817":54554,"_5":13545,"_25978":54287,"_2758":54555},[],"High: enrollments calling the webhook fail",{"_3268":2598,"_28512":2507,"_19817":54557,"_5":13545,"_25978":54287,"_2758":54558},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3268":2599,"_28512":2507,"_19817":54560,"_5":13545,"_25978":54287,"_2758":54312},[],{"_3268":2600,"_28512":2507,"_19817":54562,"_5":13545,"_25978":54287,"_2758":54563},[],"Releases with per-service identity overrides or mounted key material",{"_3268":2601,"_28512":2507,"_19817":54565,"_5":13545,"_25978":54287,"_2758":54566},[],"Medium: services cannot read their files",{"_3268":2602,"_28512":2507,"_19817":54568,"_5":13545,"_25978":54287,"_2758":54569},[],"Remove the overrides and fix volume ownership",{"_3268":2603,"_28512":2507,"_19817":54571,"_5":13545,"_25978":54287,"_2758":54316},[],{"_3268":2604,"_28512":2507,"_19817":54573,"_5":13545,"_25978":54287,"_2758":54574},[],"Releases that set `amqp.tls`",{"_3268":2605,"_28512":2507,"_19817":54576,"_5":13545,"_25978":54287,"_2758":54577},[],"Medium: clients connect to the wrong port",{"_3268":2606,"_28512":2507,"_19817":54579,"_5":13545,"_25978":54287,"_2758":54580},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3268":2607,"_28512":2507,"_19817":54582,"_5":13545,"_25978":54287,"_2758":54336},[],{"_3268":2608,"_28512":2507,"_19817":54584,"_5":13545,"_25978":54287,"_2758":54585},[],"Installations whose CA keys predate the KMS",{"_3268":2609,"_28512":2507,"_19817":54587,"_5":13545,"_25978":54287,"_2758":54588},[],"Medium: CA keys stay unmanaged",{"_3268":2610,"_28512":2507,"_19817":54590,"_5":13545,"_25978":54287,"_2758":54591},[],"Run the CA-to-KMS migration",{"_3268":2611,"_28512":2507,"_19817":54593,"_5":13545,"_25978":54287,"_2758":54594},[],"Receiver certificate verification",{"_3268":2612,"_28512":2507,"_19817":54596,"_5":13545,"_25978":54287,"_2758":54597},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3268":2613,"_28512":2507,"_19817":54599,"_5":13545,"_25978":54287,"_2758":54600},[],"Medium: credentials go to an unverified receiver",{"_3268":2614,"_28512":2507,"_19817":54602,"_5":13545,"_25978":54287,"_2758":54603},[],"Set `insecure_skip_verify` to `false`",{"_3268":2615,"_28512":2507,"_19817":54605,"_5":13545,"_25978":54287,"_2758":54348},[],{"_3268":2616,"_28512":2507,"_19817":54607,"_5":13545,"_25978":54287,"_2758":54608},[],"Scripts and consoles that edit DMSs through the API",{"_3268":2617,"_28512":2507,"_19817":54610,"_5":13545,"_25978":54287,"_2758":54611},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3268":2618,"_28512":2507,"_19817":54613,"_5":13545,"_25978":54287,"_2758":54614},[],"Read the DMS before editing and use the new field",{"_3268":2619,"_28512":2507,"_19817":54616,"_5":13545,"_25978":54287,"_2758":54364},[],{"_3268":2620,"_28512":2507,"_19817":54618,"_5":13545,"_25978":54287,"_2758":54619},[],"Consumers that read the device `events` field",{"_3268":2621,"_28512":2507,"_19817":54621,"_5":13545,"_25978":54287,"_2758":54622},[],"Medium: the field disappears",{"_3268":2622,"_28512":2507,"_19817":54624,"_5":13545,"_25978":54287,"_2758":54625},[],"Use the new event endpoints",{"_3268":2623,"_28512":2507,"_19817":54627,"_5":13545,"_25978":54287,"_2758":54320},[],{"_3268":2624,"_28512":2507,"_19817":54629,"_5":13545,"_25978":54287,"_2758":54630},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3268":2625,"_28512":2507,"_19817":54632,"_5":13545,"_25978":54287,"_2758":54633},[],"Low to medium: validation errors or changed defaults",{"_3268":2626,"_28512":2507,"_19817":54635,"_5":13545,"_25978":54287,"_2758":54636},[],"Update the values file",{"_3268":2627,"_28512":2507,"_19817":54638,"_5":13545,"_25978":54287,"_2758":54356},[],{"_3268":2628,"_28512":2507,"_19817":54640,"_5":13545,"_25978":54287,"_2758":54641},[],"Clients that send the DMS ID in the update body",{"_3268":2629,"_28512":2507,"_19817":54643,"_5":13545,"_25978":54287,"_2758":54644},[],"Low: the ID in the URL wins",{"_3268":2630,"_28512":2507,"_19817":54646,"_5":13545,"_25978":54287,"_2758":54647},[],"Send the ID in the URL",{"_3268":2631,"_28512":2507,"_19817":54649,"_5":13545,"_25978":54287,"_2758":54360},[],{"_3268":2632,"_28512":2507,"_19817":54651,"_5":13545,"_25978":54287,"_2758":54652},[],"Consumers that match on certificate `type`",{"_3268":2633,"_28512":2507,"_19817":54654,"_5":13545,"_25978":54287,"_2758":54655},[],"Low: two values are renamed",{"_3268":2634,"_28512":2507,"_19817":54657,"_5":13545,"_25978":54287,"_2758":54658},[],"Adapt consumers",{"_3268":2635,"_28512":2507,"_19817":54660,"_5":13545,"_25978":54287,"_2758":54352},[],{"_3268":2636,"_28512":2507,"_19817":54662,"_5":13545,"_25978":54287,"_2758":54663},[],"Any DMS",{"_3268":2637,"_28512":2507,"_19817":54665,"_5":13545,"_25978":54287,"_2758":54666},[],"Low: informational",{"_3268":2638,"_28512":2507,"_19817":54668,"_5":13545,"_25978":54287,"_2758":54669},[],"Read both blocks before editing",{"_3268":2639,"_28512":2507,"_19817":54671,"_5":13545,"_25978":54295,"_2758":54672},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3268":2640,"_28512":2507,"_19817":54674,"_5":13545,"_25978":54295,"_2758":54675},[],"Step 4 of the migration guide copies the data.",{"_3268":2641,"_28512":2507,"_19817":54677,"_5":13545,"_25978":54299,"_2758":54678},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3268":2642,"_28512":2507,"_19817":54680,"_5":13545,"_25978":54303,"_2758":54681},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3268":2643,"_28512":2507,"_19817":54683,"_5":13545,"_25978":54307,"_2758":54684},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3268":2644,"_28512":2507,"_19817":54686,"_5":13545,"_25978":54311,"_2758":54687},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3268":2645,"_28512":2507,"_19817":54689,"_5":13545,"_25978":54311,"_2758":54690},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3268":2646,"_28512":2507,"_19817":54692,"_5":13545,"_25978":54315,"_2758":54693},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3268":2647,"_28512":2507,"_19817":54695,"_5":13545,"_25978":54319,"_2758":54696},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3268":2648,"_28512":2507,"_19817":54698,"_5":13545,"_25978":54319,"_2758":54699},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3268":2649,"_28512":2507,"_19817":54701,"_5":13545,"_25978":54319,"_2758":54702},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3268":2650,"_28512":2507,"_19817":54704,"_5":13545,"_25978":54319,"_2758":54705},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3268":2651,"_28512":2507,"_19817":54707,"_5":13545,"_25978":54319,"_2758":54708},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3268":2652,"_28512":2507,"_19817":54710,"_5":13545,"_25978":54319,"_2758":54711},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3268":2653,"_28512":2507,"_19817":54713,"_5":13545,"_25978":54327,"_2758":54714},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3268":2654,"_28512":2507,"_19817":54716,"_5":13545,"_25978":54327,"_2758":54717},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3268":2655,"_28512":2507,"_19817":54719,"_5":13545,"_25978":54327,"_2758":54720},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3268":2656,"_28512":2507,"_19817":54722,"_5":13545,"_25978":54327,"_2758":54723},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3268":2657,"_28512":2507,"_19817":54725,"_5":13545,"_25978":54327,"_2758":54726},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3268":2658,"_28512":2507,"_19817":54728,"_5":13545,"_25978":54331,"_2758":54729},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3268":2659,"_28512":2507,"_19817":54731,"_5":13545,"_25978":54335,"_2758":54732},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3268":2660,"_28512":2507,"_19817":54734,"_5":13545,"_25978":54335,"_2758":54735},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3268":2661,"_28512":2507,"_19817":54737,"_5":13545,"_25978":54335,"_2758":54738},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3268":2662,"_28512":2507,"_19817":54740,"_5":13545,"_25978":54335,"_2758":54741},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3268":2663,"_28512":2507,"_19817":54743,"_5":13545,"_25978":54335,"_2758":54744},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3268":2664,"_28512":2507,"_19817":54746,"_5":13545,"_25978":54335,"_2758":54747},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3268":2665,"_28512":2507,"_19817":54749,"_5":13545,"_25978":54343,"_2758":54750},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3268":2666,"_28512":2507,"_19817":54752,"_5":13545,"_25978":54343,"_2758":54753},[],"Field in 3.8.0",{"_3268":2667,"_28512":2507,"_19817":54755,"_5":13545,"_25978":54343,"_2758":54756},[],"Field in 4.0.0",{"_3268":2668,"_28512":2507,"_19817":54758,"_5":13545,"_25978":54343,"_2758":54759},[],"`validate_server_cert`",{"_3268":2669,"_28512":2507,"_19817":54761,"_5":13545,"_25978":54343,"_2758":54762},[],"`insecure_skip_verify` (value negated)",{"_3268":2670,"_28512":2507,"_19817":54764,"_5":13545,"_25978":54343,"_2758":54765},[],"`oidc`",{"_3268":2671,"_28512":2507,"_19817":54767,"_5":13545,"_25978":54343,"_2758":54768},[],"`jwt_options`",{"_3268":2672,"_28512":2507,"_19817":54770,"_5":13545,"_25978":54343,"_2758":54771},[],"`apikey`",{"_3268":2673,"_28512":2507,"_19817":54773,"_5":13545,"_25978":54343,"_2758":54774},[],"`apikey_options`",{"_3268":2674,"_28512":2507,"_19817":54776,"_5":13545,"_25978":54343,"_2758":54777},[],"`mtls`",{"_3268":2675,"_28512":2507,"_19817":54779,"_5":13545,"_25978":54343,"_2758":54780},[],"`mtls_options`",{"_3268":2676,"_28512":2507,"_19817":54782,"_5":13545,"_25978":54343,"_2758":54783},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3268":2677,"_28512":2507,"_19817":54785,"_5":13545,"_25978":54343,"_2758":54786},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3268":2678,"_28512":2507,"_19817":54788,"_5":13545,"_25978":54343,"_2758":54789},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3268":2679,"_28512":2507,"_19817":54791,"_5":13545,"_25978":54347,"_2758":54792},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3268":2680,"_28512":2507,"_19817":54794,"_5":13545,"_25978":54347,"_2758":54795},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3268":2681,"_28512":2507,"_19817":54797,"_5":13545,"_25978":54347,"_2758":54798},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3268":2682,"_28512":2507,"_19817":54800,"_5":13545,"_25978":54351,"_2758":54801},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3268":2683,"_28512":2507,"_19817":54803,"_5":13545,"_25978":54355,"_2758":54804},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3268":2684,"_28512":2507,"_19817":54806,"_5":13545,"_25978":54359,"_2758":54807},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3268":2685,"_28512":2507,"_19817":54809,"_5":13545,"_25978":54363,"_2758":54810},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3268":2686,"_28512":2507,"_19817":54812,"_5":13545,"_25978":54363,"_2758":54813},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3268":2687,"_28512":2507,"_19817":54815,"_5":13545,"_25978":54363,"_2758":54816},[],"`POST /v1/devices/:id/events` creates an event.",{"_3268":2688,"_28512":2507,"_19817":54818,"_5":13545,"_25978":54363,"_2758":54819},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3268":2689,"_28512":2507,"_19817":54821,"_5":13545,"_25978":54367,"_2758":54822},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3268":2690,"_28512":2507,"_19817":54824,"_5":13545,"_25978":54371,"_2758":54825},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3268":2691,"_28512":2507,"_19817":54827,"_5":13545,"_25978":54371,"_2758":54828},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3268":2692,"_28512":2507,"_19817":54830,"_5":13545,"_25978":54371,"_2758":54831},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3268":2693,"_28512":2507,"_19817":54833,"_5":13545,"_25978":54371,"_2758":54834},[],"Record the names of your local-storage PVCs:",{"_3268":2694,"_28512":2507,"_19817":54836,"_5":13545,"_25978":54371,"_2758":54837},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3268":2695,"_28512":2507,"_19817":54839,"_5":13545,"_25978":54375,"_2758":54840},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3268":2696,"_28512":2507,"_19817":54842,"_5":13545,"_25978":54375,"_2758":54843},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3268":2697,"_28512":2507,"_19817":54845,"_5":13545,"_25978":54375,"_2758":54846},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3268":2698,"_28512":2507,"_19817":54848,"_5":13545,"_25978":54375,"_2758":54849},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3268":2699,"_28512":2507,"_19817":54851,"_5":13545,"_25978":54375,"_2758":54852},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3268":2700,"_28512":2507,"_19817":54854,"_5":13545,"_25978":54375,"_2758":54855},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3268":2701,"_28512":2507,"_19817":54857,"_5":13545,"_25978":54375,"_2758":54858},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3268":2702,"_28512":2507,"_19817":54860,"_5":13545,"_25978":54375,"_2758":54861},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3268":2703,"_28512":2507,"_19817":54863,"_5":13545,"_25978":54375,"_2758":54864},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3268":2704,"_28512":2507,"_19817":54866,"_5":13545,"_25978":54375,"_2758":54867},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3268":2705,"_28512":2507,"_19817":54869,"_5":13545,"_25978":54375,"_2758":54870},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3268":2706,"_28512":2507,"_19817":54872,"_5":13545,"_25978":54375,"_2758":54873},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3268":2707,"_28512":2507,"_19817":54875,"_5":13545,"_25978":54379,"_2758":54876},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3268":2708,"_28512":2507,"_19817":54878,"_5":13545,"_25978":54379,"_2758":54879},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3268":2709,"_28512":2507,"_19817":54881,"_5":13545,"_25978":54383,"_2758":54882},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3268":2710,"_28512":2507,"_19817":54884,"_5":13545,"_25978":54383,"_2758":54885},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3268":2711,"_28512":2507,"_19817":54887,"_5":13545,"_25978":54383,"_2758":54888},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3268":2712,"_28512":2507,"_19817":54890,"_5":13545,"_25978":54383,"_2758":54891},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3268":2713,"_28512":2507,"_19817":54893,"_5":13545,"_25978":54383,"_2758":54894},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3268":2714,"_28512":2507,"_19817":54896,"_5":13545,"_25978":54383,"_2758":54897},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3268":2715,"_28512":2507,"_19817":54899,"_5":13545,"_25978":54383,"_2758":54900},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3268":2716,"_28512":2507,"_19817":54902,"_5":13545,"_25978":54383,"_2758":54903},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3268":2717,"_28512":2507,"_19817":54905,"_5":13545,"_25978":54383,"_2758":54906},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3268":2718,"_28512":2507,"_19817":54908,"_5":13545,"_25978":54383,"_2758":54909},[],"**Remove the helper and restore the recorded replica counts:**",{"_3268":2719,"_28512":2507,"_19817":54911,"_5":13545,"_25978":54383,"_2758":54912},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3268":2720,"_28512":2507,"_19817":54914,"_5":13545,"_25978":54387,"_2758":54915},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3268":2721,"_28512":2507,"_19817":54917,"_5":13545,"_25978":54387,"_2758":54918},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3268":2722,"_28512":2507,"_19817":54920,"_5":13545,"_25978":54391,"_2758":54921},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3268":2723,"_28512":2507,"_19817":54923,"_5":13545,"_25978":54391,"_2758":54924},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3268":2724,"_28512":2507,"_19817":54926,"_5":13545,"_25978":54391,"_2758":54927},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3268":2725,"_28512":2507,"_19817":54929,"_5":13545,"_25978":54391,"_2758":54930},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3268":2726,"_28512":2507,"_19817":54932,"_5":13545,"_25978":54391,"_2758":54933},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3268":2727,"_28512":2507,"_19817":54935,"_5":13545,"_25978":54395,"_2758":54936},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3268":2728,"_28512":2507,"_19817":54938,"_5":13545,"_25978":54395,"_2758":54939},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3268":2729,"_28512":2507,"_19817":54941,"_5":13545,"_25978":54395,"_2758":54942},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3268":2730,"_28512":2507,"_19817":54944,"_5":13545,"_25978":54395,"_2758":54945},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3268":2731,"_28512":2507,"_19817":54947,"_5":13545,"_25978":54395,"_2758":54948},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3268":2732,"_28512":2507,"_19817":54950,"_5":13545,"_25978":54395,"_2758":54951},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3268":2733,"_28512":2507,"_19817":54953,"_5":13545,"_25978":54395,"_2758":54954},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3268":2734,"_28512":2507,"_19817":54956,"_5":13545,"_25978":54398,"_2758":54957},[],"After the upgrade, check in this order:",{"_3268":2735,"_28512":2507,"_19817":54959,"_5":13545,"_25978":54398,"_2758":54960},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3268":2736,"_28512":2507,"_19817":54962,"_5":13545,"_25978":54398,"_2758":54963},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3268":2737,"_28512":2507,"_19817":54965,"_5":13545,"_25978":54398,"_2758":54966},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3268":2738,"_28512":2507,"_19817":54968,"_5":13545,"_25978":54398,"_2758":54969},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3268":2739,"_28512":2507,"_19817":54971,"_5":13545,"_25978":54398,"_2758":54972},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3268":2740,"_28512":2507,"_19817":54974,"_5":13545,"_25978":54398,"_2758":54975},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3268":2741,"_28512":2507,"_19817":54977,"_5":13545,"_25978":54398,"_2758":54978},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3268":2742,"_28512":2507,"_19817":54980,"_5":13545,"_25978":54398,"_2758":54981},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3268":2743,"_28512":2507,"_19817":54983,"_5":13545,"_25978":54398,"_2758":54984},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3268":2744,"_28512":2507,"_19817":54986,"_5":13545,"_25978":54398,"_2758":54987},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3268":2745,"_28512":2507,"_19817":54989,"_5":13545,"_25978":54398,"_2758":54990},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3268":2746,"_28512":2507,"_19817":54992,"_5":13545,"_25978":54398,"_2758":54993},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3268":2747,"_28512":2507,"_19817":54995,"_5":13545,"_25978":54398,"_2758":54996},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3268":2748,"_28512":2507,"_19817":54998,"_5":13545,"_25978":54398,"_2758":54999},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3268":2749,"_28512":2507,"_19817":55001,"_5":13545,"_25978":54402,"_2758":55002},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3268":2750,"_28512":2507,"_19817":55004,"_5":13545,"_25978":54402,"_2758":55005},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3268":2751,"_28512":2507,"_19817":55007,"_5":13545,"_25978":54402,"_2758":55008},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3268":2752,"_28512":2507,"_19817":55010,"_5":13545,"_25978":54402,"_2758":55011},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3268":2753,"_28512":2507,"_19817":55013,"_5":13545,"_25978":54402,"_2758":55014}