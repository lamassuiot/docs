":116884,"_37861":116887,"_37863":116889,"_37865":116892,"_37867":116895,"_37869":116898,"_37871":116900,"_37873":116903,"_37875":116906,"_37877":116909,"_37879":116911,"_37881":116914,"_37883":116917,"_37885":116920,"_37887":116923,"_37889":116926,"_37891":116929,"_37893":116932,"_37895":116935,"_37897":116938,"_37899":116941,"_37901":116944,"_37903":116947,"_37905":116950,"_37907":116953,"_37909":116956,"_37911":116959,"_37913":116962,"_37915":116965,"_37917":116968,"_37919":116971,"_37922":116974,"_37924":116977,"_37926":116980,"_37928":116983,"_37930":116986,"_37932":116989,"_37934":116992,"_37936":116995,"_37938":116998,"_37940":117001,"_37942":117004,"_37944":117007,"_37946":117009,"_37948":117012,"_37950":117014,"_37952":117016,"_37954":117018,"_37956":117020,"_37958":117022,"_37960":117024,"_37962":117027,"_37964":117030,"_37966":117033,"_37968":117036,"_37970":117039,"_37972":117042,"_37974":117045,"_37976":117048,"_37978":117051,"_37980":117054,"_37982":117057,"_37984":117060,"_37986":117063,"_37988":117066,"_37990":117069,"_37992":117072,"_37994":117075,"_37996":117078,"_37999":117081,"_38001":117084,"_38003":117087,"_38005":117090,"_38007":117093,"_38009":117096,"_38011":117099,"_38013":117102,"_38015":117105,"_38017":117108,"_38019":117111,"_38022":117114,"_38024":117117,"_38026":117120,"_38028":117123,"_38030":117126,"_38032":117129,"_38034":117132,"_38036":117135,"_38038":117138,"_38040":117141,"_38042":117144,"_38044":117147,"_38046":117150,"_38048":117153,"_38050":117156,"_38052":117159,"_38054":117162,"_38056":117165,"_38058":117168,"_38060":117171,"_38063":117174,"_38065":117177,"_38067":117180,"_38070":117183,"_38072":117186,"_38074":117189,"_38076":117192,"_38078":117195,"_38080":117198,"_38082":117201,"_38084":117204,"_38086":117207,"_38088":117210,"_38090":117213,"_38092":117216,"_38094":117219,"_38096":117222,"_38098":117225,"_38100":117228,"_38102":117231,"_38105":117234,"_38107":117237,"_38109":117240,"_38111":117243,"_38113":117246,"_38115":117249,"_38117":117252,"_38119":117255},{"_3268":66001,"_28512":66001,"_5":13876,"_2758":108945,"_28855":108946,"_19817":108949,"_25978":66001},"Despliega desde AWS Marketplace",[46447,108947,108948],"Despliegue","Otros modelos",[],{"_3268":66002,"_28512":66001,"_19817":108951,"_5":13545,"_25978":66001,"_2758":108952},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3268":66003,"_28512":66001,"_5":28852,"_19817":108954,"_25978":108955,"_2758":108956},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3268":66004,"_28512":66001,"_5":28852,"_19817":108958,"_25978":108959,"_2758":108960},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3268":66005,"_28512":66001,"_5":28852,"_19817":108962,"_25978":108963,"_2758":108964},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3268":66006,"_28512":66001,"_5":28852,"_19817":108966,"_25978":108967,"_2758":108968},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3268":66007,"_28512":66001,"_5":28852,"_19817":108970,"_25978":108971,"_2758":108972},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3268":66008,"_28512":66001,"_5":28852,"_19817":108974,"_25978":108975,"_2758":108976},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3268":66009,"_28512":66001,"_5":28852,"_19817":108978,"_25978":108979,"_2758":108980},[],"/docs/pr-preview/pr-43/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3268":66010,"_28512":66001,"_19817":108982,"_5":13545,"_25978":66001,"_2758":108983},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3268":66011,"_28512":66001,"_19817":108985,"_5":13545,"_25978":108955,"_2758":108986},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3268":66012,"_28512":66001,"_19817":108988,"_5":13545,"_25978":108955,"_2758":108989},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3268":66013,"_28512":66001,"_19817":108991,"_5":13545,"_25978":108955,"_2758":108992},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3268":66014,"_28512":66001,"_19817":108994,"_5":13545,"_25978":108959,"_2758":108995},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3268":66015,"_28512":66001,"_19817":108997,"_5":13545,"_25978":108959,"_2758":108998},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3268":66016,"_28512":66001,"_19817":109000,"_5":13545,"_25978":108959,"_2758":109001},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3268":66017,"_28512":66001,"_19817":109003,"_5":13545,"_25978":108963,"_2758":109004},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3268":66018,"_28512":66001,"_19817":109006,"_5":13545,"_25978":108967,"_2758":109007},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3268":66019,"_28512":66001,"_19817":109009,"_5":13545,"_25978":108971,"_2758":109010},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3268":66020,"_28512":66001,"_19817":109012,"_5":13545,"_25978":108975,"_2758":109013},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3268":66021,"_28512":66001,"_19817":109015,"_5":13545,"_25978":108979,"_2758":109016},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3268":66022,"_28512":66022,"_5":13876,"_2758":109018,"_28855":109019,"_19817":109020,"_25978":66022},"Despliega Lamassu",[46447,108947],[],{"_3268":66023,"_28512":66022,"_19817":109022,"_5":13545,"_25978":66022,"_2758":109023},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3268":66024,"_28512":66022,"_5":28852,"_19817":109025,"_25978":109026,"_2758":109027},[],"/docs/pr-preview/pr-43/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3268":66025,"_28512":66022,"_5":28852,"_19817":109029,"_25978":109030,"_2758":109031},[],"/docs/pr-preview/pr-43/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3268":66026,"_28512":66022,"_5":28852,"_19817":109033,"_25978":109034,"_2758":109035},[],"/docs/pr-preview/pr-43/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3268":66027,"_28512":66022,"_19817":109037,"_5":13545,"_25978":66022,"_2758":109038},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3268":66028,"_28512":66022,"_19817":109040,"_5":13545,"_25978":109026,"_2758":109041},[],"Modelo",{"_3268":66029,"_28512":66022,"_19817":109043,"_5":13545,"_25978":109026,"_2758":109044},[],"Recomendado para",{"_3268":66030,"_28512":66022,"_19817":109046,"_5":13545,"_25978":109026,"_2758":109047},[],"Quién opera la infraestructura",{"_3268":66031,"_28512":66022,"_19817":109049,"_5":13545,"_25978":109026,"_2758":109050},[],"Punto de partida",{"_3268":66032,"_28512":66022,"_19817":109052,"_5":13545,"_25978":109026,"_2758":46554},[],{"_3268":66033,"_28512":66022,"_19817":109054,"_5":13545,"_25978":109026,"_2758":109055},[],"Producción, entornos regulados y despliegues personalizados",{"_3268":66034,"_28512":66022,"_19817":109057,"_5":13545,"_25978":109026,"_2758":109058},[],"Tu equipo",{"_3268":66035,"_28512":66022,"_19817":109060,"_5":13545,"_25978":109026,"_2758":109061},[],"Helm o Fastlane",{"_3268":66036,"_28512":66022,"_19817":109063,"_5":13545,"_25978":109026,"_2758":46566},[],{"_3268":66037,"_28512":66022,"_19817":109065,"_5":13545,"_25978":109026,"_2758":109066},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3268":66038,"_28512":66022,"_19817":109068,"_5":13545,"_25978":109026,"_2758":109058},[],{"_3268":66039,"_28512":66022,"_19817":109070,"_5":13545,"_25978":109026,"_2758":109071},[],"Imagen preconfigurada en EC2",{"_3268":66040,"_28512":66022,"_19817":109073,"_5":13545,"_25978":109026,"_2758":46577},[],{"_3268":66041,"_28512":66022,"_19817":109075,"_5":13545,"_25978":109026,"_2758":109076},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3268":66042,"_28512":66022,"_19817":109078,"_5":13545,"_25978":109026,"_2758":46583},[],{"_3268":66043,"_28512":66022,"_19817":109080,"_5":13545,"_25978":109026,"_2758":109081},[],"Suscripción gestionada",{"_3268":66044,"_28512":66022,"_19817":109083,"_5":13545,"_25978":109026,"_2758":109084},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3268":66045,"_28512":66022,"_19817":109086,"_5":13545,"_25978":109026,"_2758":109087},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3268":66046,"_28512":66022,"_19817":109089,"_5":13545,"_25978":109026,"_2758":109090},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3268":66047,"_28512":66022,"_19817":109092,"_5":13545,"_25978":109030,"_2758":109093},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3268":66048,"_28512":66022,"_19817":109095,"_5":13545,"_25978":109034,"_2758":109096},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3268":66049,"_28512":66049,"_5":13876,"_2758":109098,"_28855":109099,"_19817":109100,"_25978":66049},"Utiliza Lamassu como SaaS",[46447,108947,108948],[],{"_3268":66050,"_28512":66049,"_19817":109102,"_5":13545,"_25978":66049,"_2758":109103},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3268":66051,"_28512":66049,"_5":28852,"_19817":109105,"_25978":109106,"_2758":109107},[],"/docs/pr-preview/pr-43/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3268":66052,"_28512":66049,"_5":28852,"_19817":109109,"_25978":109110,"_2758":109111},[],"/docs/pr-preview/pr-43/es/deployment/saas#planes","Planes",{"_3268":66053,"_28512":66049,"_5":28852,"_19817":109113,"_25978":109114,"_2758":109115},[],"/docs/pr-preview/pr-43/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3268":66054,"_28512":66049,"_19817":109117,"_5":13545,"_25978":66049,"_2758":109118},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3268":66055,"_28512":66049,"_19817":109120,"_5":13545,"_25978":109106,"_2758":109121},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3268":66056,"_28512":66049,"_19817":109123,"_5":13545,"_25978":109106,"_2758":109124},[],"Copias de seguridad automáticas.",{"_3268":66057,"_28512":66049,"_19817":109126,"_5":13545,"_25978":109106,"_2758":109127},[],"Actualizaciones de versión.",{"_3268":66058,"_28512":66049,"_19817":109129,"_5":13545,"_25978":109106,"_2758":109130},[],"Soporte técnico y SLA según el plan contratado.",{"_3268":66059,"_28512":66049,"_19817":109132,"_5":13545,"_25978":109110,"_2758":46638},[],{"_3268":66060,"_28512":66049,"_19817":109134,"_5":13545,"_25978":109110,"_2758":109135},[],"Dispositivos",{"_3268":66061,"_28512":66049,"_19817":109137,"_5":13545,"_25978":109110,"_2758":109138},[],"Soporte",{"_3268":66062,"_28512":66049,"_19817":109140,"_5":13545,"_25978":109110,"_2758":46647},[],{"_3268":66063,"_28512":66049,"_19817":109142,"_5":13545,"_25978":109110,"_2758":46650},[],{"_3268":66064,"_28512":66049,"_19817":109144,"_5":13545,"_25978":109110,"_2758":109145},[],"Hasta 1.000",{"_3268":66065,"_28512":66049,"_19817":109147,"_5":13545,"_25978":109110,"_2758":46656},[],{"_3268":66066,"_28512":66049,"_19817":109149,"_5":13545,"_25978":109110,"_2758":109150},[],"99,5 %",{"_3268":66067,"_28512":66049,"_19817":109152,"_5":13545,"_25978":109110,"_2758":46662},[],{"_3268":66068,"_28512":66049,"_19817":109154,"_5":13545,"_25978":109110,"_2758":109155},[],"Hasta 10.000",{"_3268":66069,"_28512":66049,"_19817":109157,"_5":13545,"_25978":109110,"_2758":109158},[],"Email y chat",{"_3268":66070,"_28512":66049,"_19817":109160,"_5":13545,"_25978":109110,"_2758":109161},[],"99,9 %",{"_3268":66071,"_28512":66049,"_19817":109163,"_5":13545,"_25978":109110,"_2758":46674},[],{"_3268":66072,"_28512":66049,"_19817":109165,"_5":13545,"_25978":109110,"_2758":109166},[],"Ilimitados",{"_3268":66073,"_28512":66049,"_19817":109168,"_5":13545,"_25978":109110,"_2758":109169},[],"Dedicado",{"_3268":66074,"_28512":66049,"_19817":109171,"_5":13545,"_25978":109110,"_2758":109172},[],"99,99 %",{"_3268":66075,"_28512":66049,"_19817":109174,"_5":13545,"_25978":109114,"_2758":109175},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3268":66076,"_28512":66049,"_19817":109177,"_5":13545,"_25978":109114,"_2758":109178},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3268":66077,"_28512":66077,"_5":13876,"_2758":46691,"_28855":109180,"_19817":109182,"_25978":66077},[46447,108947,109181],"Kubernetes autogestionado",[],{"_3268":66078,"_28512":66077,"_19817":109184,"_5":13545,"_25978":66077,"_2758":109185},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3268":66079,"_28512":66077,"_5":28852,"_19817":109187,"_25978":109188,"_2758":109189},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3268":66080,"_28512":66077,"_5":28852,"_19817":109191,"_25978":109192,"_2758":109193},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3268":66081,"_28512":66077,"_5":28852,"_19817":109195,"_25978":109196,"_2758":109197},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3268":66082,"_28512":66077,"_5":28852,"_19817":109199,"_25978":109200,"_2758":109201},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3268":66083,"_28512":66077,"_5":28852,"_19817":109203,"_25978":109204,"_2758":109205},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3268":66084,"_28512":66077,"_5":28852,"_19817":109207,"_25978":109208,"_2758":109209},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3268":66085,"_28512":66077,"_5":28852,"_19817":109211,"_25978":109212,"_2758":109213},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3268":66086,"_28512":66077,"_5":28852,"_19817":109215,"_25978":109216,"_2758":109217},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3268":66087,"_28512":66077,"_5":28852,"_19817":109219,"_25978":109220,"_2758":109221},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3268":66088,"_28512":66077,"_5":28852,"_19817":109223,"_25978":109224,"_2758":109225},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3268":66089,"_28512":66077,"_5":28852,"_19817":109227,"_25978":109228,"_2758":109229},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3268":66090,"_28512":66077,"_19817":109231,"_5":13545,"_25978":109188,"_2758":109232},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3268":66091,"_28512":66077,"_19817":109234,"_5":13545,"_25978":109188,"_2758":109235},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3268":66092,"_28512":66077,"_19817":109237,"_5":13545,"_25978":109192,"_2758":109238},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3268":66093,"_28512":66077,"_19817":109240,"_5":13545,"_25978":109192,"_2758":109241},[],"Fastlane instala o configura",{"_3268":66094,"_28512":66077,"_19817":109243,"_5":13545,"_25978":109192,"_2758":109244},[],"Tú sigues proporcionando",{"_3268":66095,"_28512":66077,"_19817":109246,"_5":13545,"_25978":109192,"_2758":109247},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3268":66096,"_28512":66077,"_19817":109249,"_5":13545,"_25978":109192,"_2758":109250},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3268":66097,"_28512":66077,"_19817":109252,"_5":13545,"_25978":109192,"_2758":109253},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3268":66098,"_28512":66077,"_19817":109255,"_5":13545,"_25978":109192,"_2758":109256},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3268":66099,"_28512":66077,"_19817":109258,"_5":13545,"_25978":109192,"_2758":109259},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3268":66100,"_28512":66077,"_19817":109261,"_5":13545,"_25978":109192,"_2758":109262},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3268":66101,"_28512":66077,"_19817":109264,"_5":13545,"_25978":109192,"_2758":109265},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3268":66102,"_28512":66077,"_19817":109267,"_5":13545,"_25978":109192,"_2758":109268},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3268":66103,"_28512":66077,"_19817":109270,"_5":13545,"_25978":109192,"_2758":109271},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3268":66104,"_28512":66077,"_19817":109273,"_5":13545,"_25978":109196,"_2758":109274},[],"Necesitas:",{"_3268":66105,"_28512":66077,"_19817":109276,"_5":13545,"_25978":109196,"_2758":109277},[],"un clúster Kubernetes existente",{"_3268":66106,"_28512":66077,"_19817":109279,"_5":13545,"_25978":109196,"_2758":109280},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3268":66107,"_28512":66077,"_19817":109282,"_5":13545,"_25978":109196,"_2758":46793},[],{"_3268":66108,"_28512":66077,"_19817":109284,"_5":13545,"_25978":109196,"_2758":22414},[],{"_3268":66109,"_28512":66077,"_19817":109286,"_5":13545,"_25978":109196,"_2758":109287},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3268":66110,"_28512":66077,"_19817":109289,"_5":13545,"_25978":109196,"_2758":109290},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3268":66111,"_28512":66077,"_19817":109292,"_5":13545,"_25978":109196,"_2758":109293},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3268":66112,"_28512":66077,"_19817":109295,"_5":13545,"_25978":109196,"_2758":109296},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3268":66113,"_28512":66077,"_19817":109298,"_5":13545,"_25978":109196,"_2758":109299},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3268":66114,"_28512":66077,"_19817":109301,"_5":13545,"_25978":109200,"_2758":109302},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3268":66115,"_28512":66077,"_19817":109304,"_5":13545,"_25978":109200,"_2758":109305},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3268":66116,"_28512":66077,"_19817":109307,"_5":13545,"_25978":109204,"_2758":109308},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3268":66117,"_28512":66077,"_19817":109310,"_5":13545,"_25978":109204,"_2758":109311},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3268":66118,"_28512":66077,"_19817":109313,"_5":13545,"_25978":109204,"_2758":109314},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3268":66119,"_28512":66077,"_19817":109316,"_5":13545,"_25978":109204,"_2758":109317},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3268":66120,"_28512":66077,"_19817":109319,"_5":13545,"_25978":109208,"_2758":109320},[],"Opción",{"_3268":66121,"_28512":66077,"_19817":109322,"_5":13545,"_25978":109208,"_2758":109323},[],"Valor predeterminado",{"_3268":66122,"_28512":66077,"_19817":109325,"_5":13545,"_25978":109208,"_2758":109326},[],"Propósito",{"_3268":66123,"_28512":66077,"_19817":109328,"_5":13545,"_25978":109208,"_2758":46840},[],{"_3268":66124,"_28512":66077,"_19817":109330,"_5":13545,"_25978":109208,"_2758":46843},[],{"_3268":66125,"_28512":66077,"_19817":109332,"_5":13545,"_25978":109208,"_2758":109333},[],"Muestra la ayuda",{"_3268":66126,"_28512":66077,"_19817":109335,"_5":13545,"_25978":109208,"_2758":46849},[],{"_3268":66127,"_28512":66077,"_19817":109337,"_5":13545,"_25978":109208,"_2758":109338},[],"contexto actual",{"_3268":66128,"_28512":66077,"_19817":109340,"_5":13545,"_25978":109208,"_2758":109341},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3268":66129,"_28512":66077,"_19817":109343,"_5":13545,"_25978":109208,"_2758":46858},[],{"_3268":66130,"_28512":66077,"_19817":109345,"_5":13545,"_25978":109208,"_2758":6108},[],{"_3268":66131,"_28512":66077,"_19817":109347,"_5":13545,"_25978":109208,"_2758":109348},[],"Omite prompts y genera credenciales para las dependencias",{"_3268":66132,"_28512":66077,"_19817":109350,"_5":13545,"_25978":109208,"_2758":46866},[],{"_3268":66133,"_28512":66077,"_19817":109352,"_5":13545,"_25978":109208,"_2758":46869},[],{"_3268":66134,"_28512":66077,"_19817":109354,"_5":13545,"_25978":109208,"_2758":109355},[],"Namespace de la instalación",{"_3268":66135,"_28512":66077,"_19817":109357,"_5":13545,"_25978":109208,"_2758":46875},[],{"_3268":66136,"_28512":66077,"_19817":109359,"_5":13545,"_25978":109208,"_2758":46878},[],{"_3268":66137,"_28512":66077,"_19817":109361,"_5":13545,"_25978":109208,"_2758":109362},[],"Dominio usado por la UI, OIDC y el certificado",{"_3268":66138,"_28512":66077,"_19817":109364,"_5":13545,"_25978":109208,"_2758":46884},[],{"_3268":66139,"_28512":66077,"_19817":109366,"_5":13545,"_25978":109208,"_2758":14177},[],{"_3268":66140,"_28512":66077,"_19817":109368,"_5":13545,"_25978":109208,"_2758":109369},[],"Versión del chart de Lamassu",{"_3268":66141,"_28512":66077,"_19817":109371,"_5":13545,"_25978":109208,"_2758":46892},[],{"_3268":66142,"_28512":66077,"_19817":109373,"_5":13545,"_25978":109208,"_2758":46895},[],{"_3268":66143,"_28512":66077,"_19817":109375,"_5":13545,"_25978":109208,"_2758":109376},[],"Puerto del listener HTTPS",{"_3268":66144,"_28512":66077,"_19817":109378,"_5":13545,"_25978":109208,"_2758":46901},[],{"_3268":66145,"_28512":66077,"_19817":109380,"_5":13545,"_25978":109208,"_2758":46904},[],{"_3268":66146,"_28512":66077,"_19817":109382,"_5":13545,"_25978":109208,"_2758":109383},[],"Puerto del listener HTTP",{"_3268":66147,"_28512":66077,"_19817":109385,"_5":13545,"_25978":109208,"_2758":46910},[],{"_3268":66148,"_28512":66077,"_19817":109387,"_5":13545,"_25978":109208,"_2758":46843},[],{"_3268":66149,"_28512":66077,"_19817":109389,"_5":13545,"_25978":109208,"_2758":109390},[],"Certificado PEM para TLS downstream",{"_3268":66150,"_28512":66077,"_19817":109392,"_5":13545,"_25978":109208,"_2758":46918},[],{"_3268":66151,"_28512":66077,"_19817":109394,"_5":13545,"_25978":109208,"_2758":46843},[],{"_3268":66152,"_28512":66077,"_19817":109396,"_5":13545,"_25978":109208,"_2758":109397},[],"Clave privada PEM para TLS downstream",{"_3268":66153,"_28512":66077,"_19817":109399,"_5":13545,"_25978":109208,"_2758":46926},[],{"_3268":66154,"_28512":66077,"_19817":109401,"_5":13545,"_25978":109208,"_2758":109402},[],"chart del repositorio",{"_3268":66155,"_28512":66077,"_19817":109404,"_5":13545,"_25978":109208,"_2758":109405},[],"Usa un chart local de Lamassu sin empaquetar",{"_3268":66156,"_28512":66077,"_19817":109407,"_5":13545,"_25978":109208,"_2758":46935},[],{"_3268":66157,"_28512":66077,"_19817":109409,"_5":13545,"_25978":109208,"_2758":109410},[],"detección automática",{"_3268":66158,"_28512":66077,"_19817":109412,"_5":13545,"_25978":109208,"_2758":109413},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3268":66159,"_28512":66077,"_19817":109415,"_5":13545,"_25978":109208,"_2758":46943},[],{"_3268":66160,"_28512":66077,"_19817":109417,"_5":13545,"_25978":109208,"_2758":6108},[],{"_3268":66161,"_28512":66077,"_19817":109419,"_5":13545,"_25978":109208,"_2758":109420},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3268":66162,"_28512":66077,"_19817":109422,"_5":13545,"_25978":109208,"_2758":46951},[],{"_3268":66163,"_28512":66077,"_19817":109424,"_5":13545,"_25978":109208,"_2758":6108},[],{"_3268":66164,"_28512":66077,"_19817":109426,"_5":13545,"_25978":109208,"_2758":109427},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3268":66165,"_28512":66077,"_19817":109429,"_5":13545,"_25978":109208,"_2758":46959},[],{"_3268":66166,"_28512":66077,"_19817":109431,"_5":13545,"_25978":109208,"_2758":6108},[],{"_3268":66167,"_28512":66077,"_19817":109433,"_5":13545,"_25978":109208,"_2758":109434},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3268":66168,"_28512":66077,"_19817":109436,"_5":13545,"_25978":109208,"_2758":46967},[],{"_3268":66169,"_28512":66077,"_19817":109438,"_5":13545,"_25978":109208,"_2758":6108},[],{"_3268":66170,"_28512":66077,"_19817":109440,"_5":13545,"_25978":109208,"_2758":109441},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3268":66171,"_28512":66077,"_19817":109443,"_5":13545,"_25978":109208,"_2758":46975},[],{"_3268":66172,"_28512":66077,"_19817":109445,"_5":13545,"_25978":109208,"_2758":46978},[],{"_3268":66173,"_28512":66077,"_19817":109447,"_5":13545,"_25978":109208,"_2758":109448},[],"Usa otro chart local de SoftHSM",{"_3268":66174,"_28512":66077,"_19817":109450,"_5":13545,"_25978":109208,"_2758":109451},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3268":66175,"_28512":66077,"_19817":109453,"_5":13545,"_25978":109212,"_2758":109454},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3268":66176,"_28512":66077,"_19817":109456,"_5":13545,"_25978":109212,"_2758":109457},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3268":66177,"_28512":66077,"_19817":109459,"_5":13545,"_25978":109212,"_2758":109460},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3268":66178,"_28512":66077,"_19817":109462,"_5":13545,"_25978":109212,"_2758":109463},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3268":66179,"_28512":66077,"_19817":109465,"_5":13545,"_25978":109212,"_2758":109466},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3268":66180,"_28512":66077,"_19817":109468,"_5":13545,"_25978":109212,"_2758":109469},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3268":66181,"_28512":66077,"_19817":109471,"_5":13545,"_25978":109216,"_2758":47005},[],{"_3268":66182,"_28512":66077,"_19817":109473,"_5":13545,"_25978":109216,"_2758":109474},[],"valida las herramientas locales y el clúster seleccionado",{"_3268":66183,"_28512":66077,"_19817":109476,"_5":13545,"_25978":109216,"_2758":109477},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3268":66184,"_28512":66077,"_19817":109479,"_5":13545,"_25978":109216,"_2758":109480},[],"crea el namespace",{"_3268":66185,"_28512":66077,"_19817":109482,"_5":13545,"_25978":109216,"_2758":109483},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3268":66186,"_28512":66077,"_19817":109485,"_5":13545,"_25978":109216,"_2758":109486},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3268":66187,"_28512":66077,"_19817":109488,"_5":13545,"_25978":109216,"_2758":109489},[],"instala RabbitMQ",{"_3268":66188,"_28512":66077,"_19817":109491,"_5":13545,"_25978":109216,"_2758":109492},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3268":66189,"_28512":66077,"_19817":109494,"_5":13545,"_25978":109216,"_2758":109495},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3268":66190,"_28512":66077,"_19817":109497,"_5":13545,"_25978":109216,"_2758":109498},[],"carga datos de ejemplo opcionalmente",{"_3268":66191,"_28512":66077,"_19817":109500,"_5":13545,"_25978":109216,"_2758":109501},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3268":66192,"_28512":66077,"_19817":109503,"_5":13545,"_25978":109220,"_2758":109504},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3268":66193,"_28512":66077,"_19817":109506,"_5":13545,"_25978":109220,"_2758":109507},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3268":66194,"_28512":66077,"_19817":109509,"_5":13545,"_25978":109224,"_2758":109510},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3268":66195,"_28512":66077,"_19817":109512,"_5":13545,"_25978":109224,"_2758":109513},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3268":66196,"_28512":66077,"_19817":109515,"_5":13545,"_25978":109224,"_2758":109516},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3268":66197,"_28512":66077,"_19817":109518,"_5":13545,"_25978":109228,"_2758":109519},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3268":66198,"_28512":66198,"_5":13876,"_2758":109521,"_28855":109522,"_19817":109523,"_25978":66198},"Instala con Helm",[46447,108947,109181],[],{"_3268":66199,"_28512":66198,"_19817":109525,"_5":13545,"_25978":66198,"_2758":109526},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3268":66200,"_28512":66198,"_5":28852,"_19817":109528,"_25978":109529,"_2758":109530},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3268":66201,"_28512":66198,"_5":28852,"_19817":109532,"_25978":109533,"_2758":109197},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3268":66202,"_28512":66198,"_5":28852,"_19817":109535,"_25978":109536,"_2758":109537},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3268":66203,"_28512":66198,"_5":28852,"_19817":109539,"_25978":109540,"_2758":109541},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3268":66204,"_28512":66198,"_5":28852,"_19817":109543,"_25978":109544,"_2758":109545},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3268":66205,"_28512":66198,"_5":28852,"_19817":109547,"_25978":109548,"_2758":109549},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3268":66206,"_28512":66198,"_5":28852,"_19817":109551,"_25978":109552,"_2758":109553},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3268":66207,"_28512":66198,"_5":28852,"_19817":109555,"_25978":109556,"_2758":109557},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3268":66208,"_28512":66198,"_5":28852,"_19817":109559,"_25978":109560,"_2758":109561},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3268":66209,"_28512":66198,"_19817":109563,"_5":13545,"_25978":109529,"_2758":109564},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3268":66210,"_28512":66198,"_19817":109566,"_5":13545,"_25978":109533,"_2758":109567},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3268":66211,"_28512":66198,"_19817":109569,"_5":13545,"_25978":109533,"_2758":109570},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3268":66212,"_28512":66198,"_19817":109572,"_5":13545,"_25978":109533,"_2758":109573},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3268":66213,"_28512":66198,"_19817":109575,"_5":13545,"_25978":109533,"_2758":109576},[],"un broker RabbitMQ accesible y sus credenciales",{"_3268":66214,"_28512":66198,"_19817":109578,"_5":13545,"_25978":109533,"_2758":109579},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3268":66215,"_28512":66198,"_19817":109581,"_5":13545,"_25978":109533,"_2758":109582},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3268":66216,"_28512":66198,"_19817":109584,"_5":13545,"_25978":109533,"_2758":109585},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3268":66217,"_28512":66198,"_19817":109587,"_5":13545,"_25978":109533,"_2758":109588},[],"una StorageClass y un diseño de tráfico externo",{"_3268":66218,"_28512":66198,"_19817":109590,"_5":13545,"_25978":109533,"_2758":109591},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3268":66219,"_28512":66198,"_19817":109593,"_5":13545,"_25978":109533,"_2758":109594},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3268":66220,"_28512":66198,"_19817":109596,"_5":13545,"_25978":109533,"_2758":109597},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3268":66221,"_28512":66198,"_19817":109599,"_5":13545,"_25978":109536,"_2758":109600},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3268":66222,"_28512":66198,"_19817":109602,"_5":13545,"_25978":109536,"_2758":109603},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3268":66223,"_28512":66198,"_19817":109605,"_5":13545,"_25978":109536,"_2758":109606},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3268":66224,"_28512":66198,"_19817":109608,"_5":13545,"_25978":109540,"_2758":109609},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3268":66225,"_28512":66198,"_19817":109611,"_5":13545,"_25978":109540,"_2758":109612},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3268":66226,"_28512":66198,"_19817":109614,"_5":13545,"_25978":109540,"_2758":109615},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3268":66227,"_28512":66198,"_19817":109617,"_5":13545,"_25978":109544,"_2758":109618},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3268":66228,"_28512":66198,"_19817":109620,"_5":13545,"_25978":109548,"_2758":109621},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3268":66229,"_28512":66198,"_19817":109623,"_5":13545,"_25978":109548,"_2758":109624},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3268":66230,"_28512":66198,"_19817":109626,"_5":13545,"_25978":109548,"_2758":109627},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3268":66231,"_28512":66198,"_19817":109629,"_5":13545,"_25978":109548,"_2758":109630},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3268":66232,"_28512":66198,"_19817":109632,"_5":13545,"_25978":109552,"_2758":109633},[],"Para instalar un checkout local:",{"_3268":66233,"_28512":66198,"_19817":109635,"_5":13545,"_25978":109556,"_2758":109636},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3268":66234,"_28512":66198,"_19817":109638,"_5":13545,"_25978":109556,"_2758":109639},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3268":66235,"_28512":66198,"_19817":109641,"_5":13545,"_25978":109560,"_2758":109642},[],"Antes de pasar a producción, revisa:",{"_3268":66236,"_28512":66198,"_19817":109644,"_5":13545,"_25978":109560,"_2758":109645},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3268":66237,"_28512":66198,"_19817":109647,"_5":13545,"_25978":109560,"_2758":109648},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3268":66238,"_28512":66198,"_19817":109650,"_5":13545,"_25978":109560,"_2758":109651},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3268":66239,"_28512":66198,"_19817":109653,"_5":13545,"_25978":109560,"_2758":109654},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3268":66240,"_28512":66198,"_19817":109656,"_5":13545,"_25978":109560,"_2758":109657},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3268":66241,"_28512":66198,"_19817":109659,"_5":13545,"_25978":109560,"_2758":109660},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3268":66242,"_28512":66198,"_19817":109662,"_5":13545,"_25978":109560,"_2758":109663},[],"SMTP, observabilidad y entrega de alertas",{"_3268":66243,"_28512":66198,"_19817":109665,"_5":13545,"_25978":109560,"_2758":109666},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3268":66244,"_28512":66198,"_19817":109668,"_5":13545,"_25978":109560,"_2758":109669},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3268":66245,"_28512":66245,"_5":13876,"_2758":109671,"_28855":109672,"_19817":109673,"_25978":66245},"Expón el Gateway",[46447,108947,109181],[],{"_3268":66246,"_28512":66245,"_19817":109675,"_5":13545,"_25978":66245,"_2758":109676},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3268":66247,"_28512":66245,"_5":28852,"_19817":109678,"_25978":109679,"_2758":109680},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3268":66248,"_28512":66245,"_5":28852,"_19817":109682,"_25978":109683,"_2758":109684},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3268":66249,"_28512":66245,"_5":28852,"_19817":109686,"_25978":109687,"_2758":109688},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3268":66250,"_28512":66245,"_5":28852,"_19817":109690,"_25978":109691,"_2758":47226},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#k3s",{"_3268":66251,"_28512":66245,"_5":28852,"_19817":109693,"_25978":109694,"_2758":109695},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3268":66252,"_28512":66245,"_5":28852,"_19817":109697,"_25978":109698,"_2758":109699},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3268":66253,"_28512":66245,"_5":28852,"_19817":109701,"_25978":109702,"_2758":109703},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3268":66254,"_28512":66245,"_5":28852,"_19817":109705,"_25978":109706,"_2758":109707},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3268":66255,"_28512":66245,"_5":28852,"_19817":109709,"_25978":109710,"_2758":109711},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3268":66256,"_28512":66245,"_5":28852,"_19817":109713,"_25978":109714,"_2758":109715},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3268":66257,"_28512":66245,"_19817":109717,"_5":13545,"_25978":109679,"_2758":109718},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3268":66258,"_28512":66245,"_19817":109720,"_5":13545,"_25978":109679,"_2758":109721},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3268":66259,"_28512":66245,"_19817":109723,"_5":13545,"_25978":109683,"_2758":109724},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3268":66260,"_28512":66245,"_19817":109726,"_5":13545,"_25978":109683,"_2758":109727},[],"Defínelo únicamente cuando:",{"_3268":66261,"_28512":66245,"_19817":109729,"_5":13545,"_25978":109683,"_2758":109730},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3268":66262,"_28512":66245,"_19817":109732,"_5":13545,"_25978":109683,"_2758":109733},[],"esa dirección está asignada a este Gateway",{"_3268":66263,"_28512":66245,"_19817":109735,"_5":13545,"_25978":109683,"_2758":109736},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3268":66264,"_28512":66245,"_19817":109738,"_5":13545,"_25978":109683,"_2758":109739},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3268":66265,"_28512":66245,"_19817":109741,"_5":13545,"_25978":109683,"_2758":109742},[],"No confundas estos valores:",{"_3268":66266,"_28512":66245,"_19817":109744,"_5":13545,"_25978":109683,"_2758":109745},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3268":66267,"_28512":66245,"_19817":109747,"_5":13545,"_25978":109683,"_2758":109748},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3268":66268,"_28512":66245,"_19817":109750,"_5":13545,"_25978":109683,"_2758":109751},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3268":66269,"_28512":66245,"_19817":109753,"_5":13545,"_25978":109687,"_2758":109754},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3268":66270,"_28512":66245,"_19817":109756,"_5":13545,"_25978":109687,"_2758":109757},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3268":66271,"_28512":66245,"_19817":109759,"_5":13545,"_25978":109691,"_2758":109760},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3268":66272,"_28512":66245,"_19817":109762,"_5":13545,"_25978":109691,"_2758":109763},[],"Para el diseño recomendado:",{"_3268":66273,"_28512":66245,"_19817":109765,"_5":13545,"_25978":109691,"_2758":109766},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3268":66274,"_28512":66245,"_19817":109768,"_5":13545,"_25978":109691,"_2758":109769},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3268":66275,"_28512":66245,"_19817":109771,"_5":13545,"_25978":109691,"_2758":109772},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3268":66276,"_28512":66245,"_19817":109774,"_5":13545,"_25978":109691,"_2758":109775},[],"Apunta DNS a la dirección accesible de la VM.",{"_3268":66277,"_28512":66245,"_19817":109777,"_5":13545,"_25978":109691,"_2758":109778},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3268":66278,"_28512":66245,"_19817":109780,"_5":13545,"_25978":109694,"_2758":109781},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3268":66279,"_28512":66245,"_19817":109783,"_5":13545,"_25978":109698,"_2758":109784},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3268":66280,"_28512":66245,"_19817":109786,"_5":13545,"_25978":109698,"_2758":109787},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3268":66281,"_28512":66245,"_19817":109789,"_5":13545,"_25978":109702,"_2758":109790},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3268":66282,"_28512":66245,"_19817":109792,"_5":13545,"_25978":109702,"_2758":109793},[],"Requisito",{"_3268":66283,"_28512":66245,"_19817":109795,"_5":13545,"_25978":109702,"_2758":109796},[],"Diseño recomendado",{"_3268":66284,"_28512":66245,"_19817":109798,"_5":13545,"_25978":109702,"_2758":109799},[],"Consecuencia",{"_3268":66285,"_28512":66245,"_19817":109801,"_5":13545,"_25978":109702,"_2758":109802},[],"Varias URL o servicios de Lamassu",{"_3268":66286,"_28512":66245,"_19817":109804,"_5":13545,"_25978":109702,"_2758":109805},[],"Un Gateway con varias rutas",{"_3268":66287,"_28512":66245,"_19817":109807,"_5":13545,"_25978":109702,"_2758":109808},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3268":66288,"_28512":66245,"_19817":109810,"_5":13545,"_25978":109702,"_2758":109811},[],"Gateways independientes e IP externas distintas",{"_3268":66289,"_28512":66245,"_19817":109813,"_5":13545,"_25978":109702,"_2758":109814},[],"Una VIP por Gateway",{"_3268":66290,"_28512":66245,"_19817":109816,"_5":13545,"_25978":109702,"_2758":109817},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3268":66291,"_28512":66245,"_19817":109819,"_5":13545,"_25978":109702,"_2758":109820},[],"Gateways independientes, un nodo y una IP",{"_3268":66292,"_28512":66245,"_19817":109822,"_5":13545,"_25978":109702,"_2758":109823},[],"Puertos externos diferentes",{"_3268":66293,"_28512":66245,"_19817":109825,"_5":13545,"_25978":109702,"_2758":109826},[],"Los clientes deben indicar puertos no estándar",{"_3268":66294,"_28512":66245,"_19817":109828,"_5":13545,"_25978":109702,"_2758":109829},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3268":66295,"_28512":66245,"_19817":109831,"_5":13545,"_25978":109702,"_2758":109832},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3268":66296,"_28512":66245,"_19817":109834,"_5":13545,"_25978":109702,"_2758":109835},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3268":66297,"_28512":66245,"_19817":109837,"_5":13545,"_25978":109702,"_2758":109838},[],"Recursos Gateway separados pero proxy compartido",{"_3268":66298,"_28512":66245,"_19817":109840,"_5":13545,"_25978":109702,"_2758":109841},[],"Modo merged Gateway de Envoy",{"_3268":66299,"_28512":66245,"_19817":109843,"_5":13545,"_25978":109702,"_2758":109844},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3268":66300,"_28512":66245,"_19817":109846,"_5":13545,"_25978":109702,"_2758":109847},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3268":66301,"_28512":66245,"_19817":109849,"_5":13545,"_25978":109702,"_2758":109850},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3268":66302,"_28512":66245,"_19817":109852,"_5":13545,"_25978":109702,"_2758":109853},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3268":66303,"_28512":66245,"_19817":109855,"_5":13545,"_25978":109702,"_2758":109856},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3268":66304,"_28512":66245,"_19817":109858,"_5":13545,"_25978":109706,"_2758":109859},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3268":66305,"_28512":66245,"_19817":109861,"_5":13545,"_25978":109706,"_2758":109862},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3268":66306,"_28512":66245,"_19817":109864,"_5":13545,"_25978":109706,"_2758":109865},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3268":66307,"_28512":66245,"_19817":109867,"_5":13545,"_25978":109706,"_2758":109868},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3268":66308,"_28512":66245,"_19817":109870,"_5":13545,"_25978":109706,"_2758":109871},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3268":66309,"_28512":66245,"_19817":109873,"_5":13545,"_25978":109710,"_2758":109874},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3268":66310,"_28512":66245,"_19817":109876,"_5":13545,"_25978":109710,"_2758":109877},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3268":66311,"_28512":66245,"_19817":109879,"_5":13545,"_25978":109714,"_2758":109880},[],"Comprueba, en orden:",{"_3268":66312,"_28512":66245,"_19817":109882,"_5":13545,"_25978":109714,"_2758":109883},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3268":66313,"_28512":66245,"_19817":109885,"_5":13545,"_25978":109714,"_2758":109886},[],"Su estado contiene la dirección esperada.",{"_3268":66314,"_28512":66245,"_19817":109888,"_5":13545,"_25978":109714,"_2758":109889},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3268":66315,"_28512":66245,"_19817":109891,"_5":13545,"_25978":109714,"_2758":109892},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3268":66316,"_28512":66245,"_19817":109894,"_5":13545,"_25978":109714,"_2758":109895},[],"DNS resuelve al endpoint accesible externamente.",{"_3268":66317,"_28512":66245,"_19817":109897,"_5":13545,"_25978":109714,"_2758":109898},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3268":66318,"_28512":66245,"_19817":109900,"_5":13545,"_25978":109714,"_2758":109901},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3268":66319,"_28512":66319,"_5":13876,"_2758":46554,"_28855":109903,"_19817":109904,"_25978":66319},[46447,108947,109181],[],{"_3268":66320,"_28512":66319,"_19817":109906,"_5":13545,"_25978":66319,"_2758":109907},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3268":66321,"_28512":66319,"_5":28852,"_19817":109909,"_25978":109910,"_2758":109911},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3268":66322,"_28512":66319,"_5":28852,"_19817":109913,"_25978":109914,"_2758":109915},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3268":66323,"_28512":66319,"_5":28852,"_19817":109917,"_25978":109918,"_2758":109919},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3268":66324,"_28512":66319,"_5":28852,"_19817":109921,"_25978":109922,"_2758":109923},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3268":66325,"_28512":66319,"_5":28852,"_19817":109925,"_25978":109926,"_2758":109927},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3268":66326,"_28512":66319,"_5":28852,"_19817":109929,"_25978":109930,"_2758":109931},[],"/docs/pr-preview/pr-43/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3268":66327,"_28512":66319,"_19817":109933,"_5":13545,"_25978":109910,"_2758":109934},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3268":66328,"_28512":66319,"_19817":109936,"_5":13545,"_25978":109914,"_2758":109937},[],"Flujo",{"_3268":66329,"_28512":66319,"_19817":109939,"_5":13545,"_25978":109914,"_2758":109940},[],"Úsalo para",{"_3268":66330,"_28512":66319,"_19817":109942,"_5":13545,"_25978":109914,"_2758":109943},[],"Qué instala",{"_3268":66331,"_28512":66319,"_19817":109945,"_5":13545,"_25978":109914,"_2758":47481},[],{"_3268":66332,"_28512":66319,"_19817":109947,"_5":13545,"_25978":109914,"_2758":109948},[],"Producción y entornos controlados",{"_3268":66333,"_28512":66319,"_19817":109950,"_5":13545,"_25978":109914,"_2758":109951},[],"Servicios de Lamassu y recursos de Gateway API",{"_3268":66334,"_28512":66319,"_19817":109953,"_5":13545,"_25978":109914,"_2758":46691},[],{"_3268":66335,"_28512":66319,"_19817":109955,"_5":13545,"_25978":109914,"_2758":109956},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3268":66336,"_28512":66319,"_19817":109958,"_5":13545,"_25978":109914,"_2758":109959},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3268":66337,"_28512":66319,"_19817":109961,"_5":13545,"_25978":109918,"_2758":109962},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3268":66338,"_28512":66319,"_19817":109964,"_5":13545,"_25978":109918,"_2758":109965},[],"Área",{"_3268":66339,"_28512":66319,"_19817":109967,"_5":13545,"_25978":109918,"_2758":109968},[],"El chart de Lamassu proporciona",{"_3268":66340,"_28512":66319,"_19817":109970,"_5":13545,"_25978":109918,"_2758":109971},[],"Tú proporcionas",{"_3268":66341,"_28512":66319,"_19817":109973,"_5":13545,"_25978":109918,"_2758":109974},[],"Aplicaciones Lamassu",{"_3268":66342,"_28512":66319,"_19817":109976,"_5":13545,"_25978":109918,"_2758":109977},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3268":66343,"_28512":66319,"_19817":109979,"_5":13545,"_25978":109918,"_2758":109980},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3268":66344,"_28512":66319,"_19817":109982,"_5":13545,"_25978":109918,"_2758":109983},[],"Datos PostgreSQL",{"_3268":66345,"_28512":66319,"_19817":109985,"_5":13545,"_25978":109918,"_2758":109986},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3268":66346,"_28512":66319,"_19817":109988,"_5":13545,"_25978":109918,"_2758":109989},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3268":66347,"_28512":66319,"_19817":109991,"_5":13545,"_25978":109918,"_2758":109992},[],"Mensajería",{"_3268":66348,"_28512":66319,"_19817":109994,"_5":13545,"_25978":109918,"_2758":109995},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3268":66349,"_28512":66319,"_19817":109997,"_5":13545,"_25978":109918,"_2758":109998},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3268":66350,"_28512":66319,"_19817":110000,"_5":13545,"_25978":109918,"_2758":110001},[],"Identidad",{"_3268":66351,"_28512":66319,"_19817":110003,"_5":13545,"_25978":109918,"_2758":110004},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3268":66352,"_28512":66319,"_19817":110006,"_5":13545,"_25978":109918,"_2758":110007},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3268":66353,"_28512":66319,"_19817":110009,"_5":13545,"_25978":109918,"_2758":110010},[],"Enrutamiento externo",{"_3268":66354,"_28512":66319,"_19817":110012,"_5":13545,"_25978":109918,"_2758":110013},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3268":66355,"_28512":66319,"_19817":110015,"_5":13545,"_25978":109918,"_2758":110016},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3268":66356,"_28512":66319,"_19817":110018,"_5":13545,"_25978":109918,"_2758":47555},[],{"_3268":66357,"_28512":66319,"_19817":110020,"_5":13545,"_25978":109918,"_2758":110021},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3268":66358,"_28512":66319,"_19817":110023,"_5":13545,"_25978":109918,"_2758":110024},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3268":66359,"_28512":66319,"_19817":110026,"_5":13545,"_25978":109918,"_2758":110027},[],"Datos persistentes de la aplicación",{"_3268":66360,"_28512":66319,"_19817":110029,"_5":13545,"_25978":109918,"_2758":110030},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3268":66361,"_28512":66319,"_19817":110032,"_5":13545,"_25978":109918,"_2758":110033},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3268":66362,"_28512":66319,"_19817":110035,"_5":13545,"_25978":109918,"_2758":110036},[],"Integraciones opcionales",{"_3268":66363,"_28512":66319,"_19817":110038,"_5":13545,"_25978":109918,"_2758":110039},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3268":66364,"_28512":66319,"_19817":110041,"_5":13545,"_25978":109918,"_2758":110042},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3268":66365,"_28512":66319,"_19817":110044,"_5":13545,"_25978":109918,"_2758":110045},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3268":66366,"_28512":66319,"_19817":110047,"_5":13545,"_25978":109918,"_2758":110048},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3268":66367,"_28512":66319,"_19817":110050,"_5":13545,"_25978":109922,"_2758":110051},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3268":66368,"_28512":66319,"_19817":110053,"_5":13545,"_25978":109922,"_2758":110054},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3268":66369,"_28512":66319,"_19817":110056,"_5":13545,"_25978":109926,"_2758":110057},[],"Kubernetes 1.24 o posterior",{"_3268":66370,"_28512":66319,"_19817":110059,"_5":13545,"_25978":109926,"_2758":110060},[],"Helm 3.2 o posterior",{"_3268":66371,"_28512":66319,"_19817":110062,"_5":13545,"_25978":109926,"_2758":110063},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3268":66372,"_28512":66319,"_19817":110065,"_5":13545,"_25978":109926,"_2758":110066},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3268":66373,"_28512":66319,"_19817":110068,"_5":13545,"_25978":109926,"_2758":110069},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3268":66374,"_28512":66319,"_19817":110071,"_5":13545,"_25978":109926,"_2758":110072},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3268":66375,"_28512":66319,"_19817":110074,"_5":13545,"_25978":109926,"_2758":110075},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3268":66376,"_28512":66319,"_19817":110077,"_5":13545,"_25978":109930,"_2758":110078},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3268":66377,"_28512":66319,"_19817":110080,"_5":13545,"_25978":109930,"_2758":110081},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3268":66378,"_28512":66319,"_19817":110083,"_5":13545,"_25978":109930,"_2758":110084},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3268":66379,"_28512":66319,"_19817":110086,"_5":13545,"_25978":109930,"_2758":110087},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3268":66380,"_28512":66380,"_5":13876,"_2758":110089,"_28855":110090,"_19817":110092,"_25978":66380},"Resolución de problemas de despliegue",[46447,108947,110091],"Operación",[],{"_3268":66381,"_28512":66380,"_19817":110094,"_5":13545,"_25978":66380,"_2758":110095},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3268":66382,"_28512":66380,"_5":28852,"_19817":110097,"_25978":110098,"_2758":110099},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3268":66383,"_28512":66380,"_5":28852,"_19817":110101,"_25978":110102,"_2758":110103},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3268":66384,"_28512":66380,"_5":28852,"_19817":110105,"_25978":110106,"_2758":110107},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3268":66385,"_28512":66380,"_5":28852,"_19817":110109,"_25978":110110,"_2758":110111},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3268":66386,"_28512":66380,"_5":28852,"_19817":110113,"_25978":110114,"_2758":110115},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3268":66387,"_28512":66380,"_5":28852,"_19817":110117,"_25978":110118,"_2758":110119},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3268":66388,"_28512":66380,"_5":28852,"_19817":110121,"_25978":110122,"_2758":110123},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3268":66389,"_28512":66380,"_5":28852,"_19817":110125,"_25978":110126,"_2758":110127},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3268":66390,"_28512":66380,"_5":28852,"_19817":110129,"_25978":110130,"_2758":110131},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3268":66391,"_28512":66380,"_5":28852,"_19817":110133,"_25978":110134,"_2758":110135},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3268":66392,"_28512":66380,"_5":28852,"_19817":110137,"_25978":110138,"_2758":110139},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3268":66393,"_28512":66380,"_5":28852,"_19817":110141,"_25978":110142,"_2758":110143},[],"/docs/pr-preview/pr-43/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3268":66394,"_28512":66380,"_19817":110145,"_5":13545,"_25978":66380,"_2758":110146},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3268":66395,"_28512":66380,"_19817":110148,"_5":13545,"_25978":110102,"_2758":110149},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3268":66396,"_28512":66380,"_19817":110151,"_5":13545,"_25978":110106,"_2758":110152},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3268":66397,"_28512":66380,"_19817":110154,"_5":13545,"_25978":110110,"_2758":110155},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3268":66398,"_28512":66380,"_19817":110157,"_5":13545,"_25978":110114,"_2758":110158},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3268":66399,"_28512":66380,"_19817":110160,"_5":13545,"_25978":110118,"_2758":110161},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3268":66400,"_28512":66380,"_19817":110163,"_5":13545,"_25978":110122,"_2758":110164},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3268":66401,"_28512":66380,"_19817":110166,"_5":13545,"_25978":110122,"_2758":110167},[],"Ejecuta también la prueba de conectividad del chart:",{"_3268":66402,"_28512":66380,"_19817":110169,"_5":13545,"_25978":110122,"_2758":110170},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3268":66403,"_28512":66380,"_19817":110172,"_5":13545,"_25978":110122,"_2758":110173},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3268":66404,"_28512":66380,"_19817":110175,"_5":13545,"_25978":110126,"_2758":110176},[],"Si recibes un 401:",{"_3268":66405,"_28512":66380,"_19817":110178,"_5":13545,"_25978":110126,"_2758":110179},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3268":66406,"_28512":66380,"_19817":110181,"_5":13545,"_25978":110126,"_2758":110182},[],"verifica emisor, audiencia y expiración del token;",{"_3268":66407,"_28512":66380,"_19817":110184,"_5":13545,"_25978":110126,"_2758":110185},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3268":66408,"_28512":66380,"_19817":110187,"_5":13545,"_25978":110126,"_2758":110188},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3268":66409,"_28512":66380,"_19817":110190,"_5":13545,"_25978":110126,"_2758":110191},[],"Si el login termina pero las APIs devuelven 403:",{"_3268":66410,"_28512":66380,"_19817":110193,"_5":13545,"_25978":110126,"_2758":110194},[],"inspecciona los claims reales del token;",{"_3268":66411,"_28512":66380,"_19817":110196,"_5":13545,"_25978":110126,"_2758":110197},[],"confirma que coinciden con un principal activo;",{"_3268":66412,"_28512":66380,"_19817":110199,"_5":13545,"_25978":110126,"_2758":110200},[],"revisa las políticas concedidas al principal;",{"_3268":66413,"_28512":66380,"_19817":110202,"_5":13545,"_25978":110126,"_2758":110203},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3268":66414,"_28512":66380,"_19817":110205,"_5":13545,"_25978":110126,"_2758":110206},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3268":66415,"_28512":66380,"_19817":110208,"_5":13545,"_25978":110130,"_2758":110209},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3268":66416,"_28512":66380,"_19817":110211,"_5":13545,"_25978":110130,"_2758":110212},[],"Localiza el pod y Service de authz.",{"_3268":66417,"_28512":66380,"_19817":110214,"_5":13545,"_25978":110130,"_2758":110215},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3268":66418,"_28512":66380,"_19817":110217,"_5":13545,"_25978":110130,"_2758":110218},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3268":66419,"_28512":66380,"_19817":110220,"_5":13545,"_25978":110130,"_2758":110221},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3268":66420,"_28512":66380,"_19817":110223,"_5":13545,"_25978":110130,"_2758":110224},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3268":66421,"_28512":66380,"_19817":110226,"_5":13545,"_25978":110134,"_2758":110227},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3268":66422,"_28512":66380,"_19817":110229,"_5":13545,"_25978":110134,"_2758":110230},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3268":66423,"_28512":66380,"_19817":110232,"_5":13545,"_25978":110134,"_2758":110233},[],"volumen persistente sin enlazar;",{"_3268":66424,"_28512":66380,"_19817":110235,"_5":13545,"_25978":110134,"_2758":110236},[],"imagen inaccesible o política de pull incorrecta;",{"_3268":66425,"_28512":66380,"_19817":110238,"_5":13545,"_25978":110134,"_2758":110239},[],"configuración inválida del motor criptográfico;",{"_3268":66426,"_28512":66380,"_19817":110241,"_5":13545,"_25978":110134,"_2758":110242},[],"límites de CPU o memoria demasiado bajos;",{"_3268":66427,"_28512":66380,"_19817":110244,"_5":13545,"_25978":110134,"_2758":110245},[],"migración previa incompleta.",{"_3268":66428,"_28512":66380,"_19817":110247,"_5":13545,"_25978":110134,"_2758":110248},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3268":66429,"_28512":66380,"_19817":110250,"_5":13545,"_25978":110134,"_2758":110251},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3268":66430,"_28512":66380,"_19817":110253,"_5":13545,"_25978":110134,"_2758":110254},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3268":66431,"_28512":66380,"_19817":110256,"_5":13545,"_25978":110138,"_2758":110257},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3268":66432,"_28512":66380,"_19817":110259,"_5":13545,"_25978":110138,"_2758":110260},[],"verifica que esté habilitado en el servicio emisor;",{"_3268":66433,"_28512":66380,"_19817":110262,"_5":13545,"_25978":110138,"_2758":110263},[],"comprueba conectividad y credenciales AMQP;",{"_3268":66434,"_28512":66380,"_19817":110265,"_5":13545,"_25978":110138,"_2758":110266},[],"revisa exchange, routing key, colas y consumidores;",{"_3268":66435,"_28512":66380,"_19817":110268,"_5":13545,"_25978":110138,"_2758":110269},[],"inspecciona dead-letter queues;",{"_3268":66436,"_28512":66380,"_19817":110271,"_5":13545,"_25978":110138,"_2758":110272},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3268":66437,"_28512":66380,"_19817":110274,"_5":13545,"_25978":110138,"_2758":110275},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3268":66438,"_28512":66380,"_19817":110277,"_5":13545,"_25978":110142,"_2758":110278},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3268":66439,"_28512":66380,"_19817":110280,"_5":13545,"_25978":110142,"_2758":110281},[],"Antes de cerrar una incidencia, guarda:",{"_3268":66440,"_28512":66380,"_19817":110283,"_5":13545,"_25978":110142,"_2758":110284},[],"causa confirmada;",{"_3268":66441,"_28512":66380,"_19817":110286,"_5":13545,"_25978":110142,"_2758":110287},[],"alcance temporal y recursos afectados;",{"_3268":66442,"_28512":66380,"_19817":110289,"_5":13545,"_25978":110142,"_2758":110290},[],"comandos o consultas utilizados;",{"_3268":66443,"_28512":66380,"_19817":110292,"_5":13545,"_25978":110142,"_2758":110293},[],"cambio aplicado y forma de revertirlo;",{"_3268":66444,"_28512":66380,"_19817":110295,"_5":13545,"_25978":110142,"_2758":110296},[],"validación desde un consumidor;",{"_3268":66445,"_28512":66380,"_19817":110298,"_5":13545,"_25978":110142,"_2758":110299},[],"acción preventiva y propietario.",{"_3268":66446,"_28512":66446,"_5":13876,"_2758":110301,"_28855":110302,"_19817":110305,"_25978":66446},"Control de acceso",[46447,110303,110304],"Plataforma","Administración",[],{"_3268":66447,"_28512":66446,"_19817":110307,"_5":13545,"_25978":66446,"_2758":110308},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3268":66448,"_28512":66446,"_5":28852,"_19817":110310,"_25978":110311,"_2758":110312},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3268":66449,"_28512":66446,"_5":28852,"_19817":110314,"_25978":110315,"_2758":110316},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3268":66450,"_28512":66446,"_5":28852,"_19817":110318,"_25978":110319,"_2758":110320},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3268":66451,"_28512":66446,"_5":28852,"_19817":110322,"_25978":110323,"_2758":110324},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3268":66452,"_28512":66446,"_5":28852,"_19817":110326,"_25978":110327,"_2758":110328},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3268":66453,"_28512":66446,"_5":28852,"_19817":110330,"_25978":110331,"_2758":110332},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3268":66454,"_28512":66446,"_5":28852,"_19817":110334,"_25978":110335,"_2758":110336},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3268":66455,"_28512":66446,"_5":28852,"_19817":110338,"_25978":110339,"_2758":110340},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3268":66456,"_28512":66446,"_5":28852,"_19817":110342,"_25978":110343,"_2758":110344},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3268":66457,"_28512":66446,"_5":28852,"_19817":110346,"_25978":110347,"_2758":110348},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3268":66458,"_28512":66446,"_5":28852,"_19817":110350,"_25978":110351,"_2758":110352},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3268":66459,"_28512":66446,"_5":28852,"_19817":110354,"_25978":110355,"_2758":110356},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3268":66460,"_28512":66446,"_5":28852,"_19817":110358,"_25978":110359,"_2758":110360},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3268":66461,"_28512":66446,"_5":28852,"_19817":110362,"_25978":110363,"_2758":110364},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3268":66462,"_28512":66446,"_5":28852,"_19817":110366,"_25978":110367,"_2758":110368},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3268":66463,"_28512":66446,"_5":28852,"_19817":110370,"_25978":110371,"_2758":109549},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3268":66464,"_28512":66446,"_5":28852,"_19817":110373,"_25978":110374,"_2758":110375},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3268":66465,"_28512":66446,"_5":28852,"_19817":110377,"_25978":110378,"_2758":110379},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3268":66466,"_28512":66446,"_5":28852,"_19817":110381,"_25978":110382,"_2758":110383},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3268":66467,"_28512":66446,"_5":28852,"_19817":110385,"_25978":110386,"_2758":110387},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3268":66468,"_28512":66446,"_5":28852,"_19817":110389,"_25978":110390,"_2758":110391},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3268":66469,"_28512":66446,"_5":28852,"_19817":110393,"_25978":110394,"_2758":110395},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3268":66470,"_28512":66446,"_5":28852,"_19817":110397,"_25978":110398,"_2758":110399},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3268":66471,"_28512":66446,"_5":28852,"_19817":110401,"_25978":110402,"_2758":110403},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3268":66472,"_28512":66446,"_5":28852,"_19817":110405,"_25978":110406,"_2758":110407},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3268":66473,"_28512":66446,"_5":28852,"_19817":110409,"_25978":110410,"_2758":110411},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3268":66474,"_28512":66446,"_5":28852,"_19817":110413,"_25978":110414,"_2758":110415},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3268":66475,"_28512":66446,"_5":28852,"_19817":110417,"_25978":110418,"_2758":110419},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3268":66476,"_28512":66446,"_5":28852,"_19817":110421,"_25978":110422,"_2758":110423},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3268":66477,"_28512":66446,"_5":28852,"_19817":110425,"_25978":110426,"_2758":110427},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3268":66478,"_28512":66446,"_5":28852,"_19817":110429,"_25978":110430,"_2758":110431},[],"/docs/pr-preview/pr-43/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3268":66479,"_28512":66446,"_19817":110433,"_5":13545,"_25978":66446,"_2758":110434},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3268":66480,"_28512":66446,"_19817":110436,"_5":13545,"_25978":66446,"_2758":110437},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3268":66481,"_28512":66446,"_19817":110439,"_5":13545,"_25978":66446,"_2758":110440},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3268":66482,"_28512":66446,"_19817":110442,"_5":13545,"_25978":110311,"_2758":110443},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3268":66483,"_28512":66446,"_19817":110445,"_5":13545,"_25978":110311,"_2758":110446},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3268":66484,"_28512":66446,"_19817":110448,"_5":13545,"_25978":110311,"_2758":110449},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3268":66485,"_28512":66446,"_19817":110451,"_5":13545,"_25978":110311,"_2758":110452},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3268":66486,"_28512":66446,"_19817":110454,"_5":13545,"_25978":110311,"_2758":110455},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3268":66487,"_28512":66446,"_19817":110457,"_5":13545,"_25978":110311,"_2758":110458},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3268":66488,"_28512":66446,"_19817":110460,"_5":13545,"_25978":110315,"_2758":110461},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3268":66489,"_28512":66446,"_19817":110463,"_5":13545,"_25978":110315,"_2758":110464},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3268":66490,"_28512":66446,"_19817":110466,"_5":13545,"_25978":110319,"_2758":110467},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3268":66491,"_28512":66446,"_19817":110469,"_5":13545,"_25978":110319,"_2758":110470},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3268":66492,"_28512":66446,"_19817":110472,"_5":13545,"_25978":110319,"_2758":110473},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3268":66493,"_28512":66446,"_19817":110475,"_5":13545,"_25978":110319,"_2758":110476},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3268":66494,"_28512":66446,"_19817":110478,"_5":13545,"_25978":110319,"_2758":110479},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3268":66495,"_28512":66446,"_19817":110481,"_5":13545,"_25978":110319,"_2758":110482},[],"Carga por separado las políticas concedidas a cada principal.",{"_3268":66496,"_28512":66446,"_19817":110484,"_5":13545,"_25978":110319,"_2758":110485},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3268":66497,"_28512":66446,"_19817":110487,"_5":13545,"_25978":110319,"_2758":110488},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3268":66498,"_28512":66446,"_19817":110490,"_5":13545,"_25978":110319,"_2758":110491},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3268":66499,"_28512":66446,"_19817":110493,"_5":13545,"_25978":110319,"_2758":110494},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3268":66500,"_28512":66446,"_19817":110496,"_5":13545,"_25978":110319,"_2758":110497},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3268":66501,"_28512":66446,"_19817":110499,"_5":13545,"_25978":110319,"_2758":110500},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3268":66502,"_28512":66446,"_19817":110502,"_5":13545,"_25978":110323,"_2758":110503},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3268":66503,"_28512":66446,"_19817":110505,"_5":13545,"_25978":110323,"_2758":110506},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3268":66504,"_28512":66446,"_19817":110508,"_5":13545,"_25978":110323,"_2758":110509},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3268":66505,"_28512":66446,"_19817":110511,"_5":13545,"_25978":110323,"_2758":110512},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3268":66506,"_28512":66446,"_19817":110514,"_5":13545,"_25978":110323,"_2758":110515},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3268":66507,"_28512":66446,"_19817":110517,"_5":13545,"_25978":110323,"_2758":110518},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3268":66508,"_28512":66446,"_19817":110520,"_5":13545,"_25978":110323,"_2758":110521},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3268":66509,"_28512":66446,"_19817":110523,"_5":13545,"_25978":110323,"_2758":110524},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3268":66510,"_28512":66446,"_19817":110526,"_5":13545,"_25978":110327,"_2758":110527},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3268":66511,"_28512":66446,"_19817":110529,"_5":13545,"_25978":110327,"_2758":110530},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3268":66512,"_28512":66446,"_19817":110532,"_5":13545,"_25978":110327,"_2758":110533},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3268":66513,"_28512":66446,"_19817":110535,"_5":13545,"_25978":110327,"_2758":110536},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3268":66514,"_28512":66446,"_19817":110538,"_5":13545,"_25978":110327,"_2758":110539},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3268":66515,"_28512":66446,"_19817":110541,"_5":13545,"_25978":110327,"_2758":110542},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3268":66516,"_28512":66446,"_19817":110544,"_5":13545,"_25978":110327,"_2758":110545},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3268":66517,"_28512":66446,"_19817":110547,"_5":13545,"_25978":110327,"_2758":110548},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3268":66518,"_28512":66446,"_19817":110550,"_5":13545,"_25978":110327,"_2758":110551},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3268":66519,"_28512":66446,"_19817":110553,"_5":13545,"_25978":110327,"_2758":110554},[],"Las acciones se dividen en dos grupos:",{"_3268":66520,"_28512":66446,"_19817":110556,"_5":13545,"_25978":110327,"_2758":110557},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3268":66521,"_28512":66446,"_19817":110559,"_5":13545,"_25978":110327,"_2758":110560},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3268":66522,"_28512":66446,"_19817":110562,"_5":13545,"_25978":110327,"_2758":110563},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3268":66523,"_28512":66446,"_19817":110565,"_5":13545,"_25978":110331,"_2758":110566},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3268":66524,"_28512":66446,"_19817":110568,"_5":13545,"_25978":110331,"_2758":110569},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3268":66525,"_28512":66446,"_19817":110571,"_5":13545,"_25978":110331,"_2758":110572},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3268":66526,"_28512":66446,"_19817":110574,"_5":13545,"_25978":110335,"_2758":110575},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3268":66527,"_28512":66446,"_19817":110577,"_5":13545,"_25978":110335,"_2758":110578},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3268":66528,"_28512":66446,"_19817":110580,"_5":13545,"_25978":110335,"_2758":110581},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3268":66529,"_28512":66446,"_19817":110583,"_5":13545,"_25978":110335,"_2758":110584},[],"Los operadores implementados son:",{"_3268":66530,"_28512":66446,"_19817":110586,"_5":13545,"_25978":110335,"_2758":110587},[],"`equals`, para igualdad exacta;",{"_3268":66531,"_28512":66446,"_19817":110589,"_5":13545,"_25978":110335,"_2758":110590},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3268":66532,"_28512":66446,"_19817":110592,"_5":13545,"_25978":110335,"_2758":110593},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3268":66533,"_28512":66446,"_19817":110595,"_5":13545,"_25978":110335,"_2758":110596},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3268":66534,"_28512":66446,"_19817":110598,"_5":13545,"_25978":110339,"_2758":110599},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3268":66535,"_28512":66446,"_19817":110601,"_5":13545,"_25978":110339,"_2758":110602},[],"Los modos disponibles son:",{"_3268":66536,"_28512":66446,"_19817":110604,"_5":13545,"_25978":110339,"_2758":110605},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3268":66537,"_28512":66446,"_19817":110607,"_5":13545,"_25978":110339,"_2758":110608},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3268":66538,"_28512":66446,"_19817":110610,"_5":13545,"_25978":110339,"_2758":110611},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3268":66539,"_28512":66446,"_19817":110613,"_5":13545,"_25978":110339,"_2758":110614},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3268":66540,"_28512":66446,"_19817":110616,"_5":13545,"_25978":110339,"_2758":110617},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3268":66541,"_28512":66446,"_19817":110619,"_5":13545,"_25978":110339,"_2758":110620},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3268":66542,"_28512":66446,"_19817":110622,"_5":13545,"_25978":110343,"_2758":110623},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3268":66543,"_28512":66446,"_19817":110625,"_5":13545,"_25978":110343,"_2758":110626},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3268":66544,"_28512":66446,"_19817":110628,"_5":13545,"_25978":110343,"_2758":110629},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3268":66545,"_28512":66446,"_19817":110631,"_5":13545,"_25978":110343,"_2758":110632},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3268":66546,"_28512":66446,"_19817":110634,"_5":13545,"_25978":110351,"_2758":110635},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3268":66547,"_28512":66446,"_19817":110637,"_5":13545,"_25978":110351,"_2758":110638},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3268":66548,"_28512":66446,"_19817":110640,"_5":13545,"_25978":110355,"_2758":110641},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3268":66549,"_28512":66446,"_19817":110643,"_5":13545,"_25978":110355,"_2758":110644},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3268":66550,"_28512":66446,"_19817":110646,"_5":13545,"_25978":110359,"_2758":110647},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3268":66551,"_28512":66446,"_19817":110649,"_5":13545,"_25978":110359,"_2758":110650},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3268":66552,"_28512":66446,"_19817":110652,"_5":13545,"_25978":110359,"_2758":110653},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3268":66553,"_28512":66446,"_19817":110655,"_5":13545,"_25978":110363,"_2758":110656},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3268":66554,"_28512":66446,"_19817":110658,"_5":13545,"_25978":110363,"_2758":110659},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3268":66555,"_28512":66446,"_19817":110661,"_5":13545,"_25978":110363,"_2758":110662},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3268":66556,"_28512":66446,"_19817":110664,"_5":13545,"_25978":110363,"_2758":110665},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3268":66557,"_28512":66446,"_19817":110667,"_5":13545,"_25978":110363,"_2758":110668},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3268":66558,"_28512":66446,"_19817":110670,"_5":13545,"_25978":110363,"_2758":110671},[],"Ten en cuenta que:",{"_3268":66559,"_28512":66446,"_19817":110673,"_5":13545,"_25978":110363,"_2758":110674},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3268":66560,"_28512":66446,"_19817":110676,"_5":13545,"_25978":110363,"_2758":110677},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3268":66561,"_28512":66446,"_19817":110679,"_5":13545,"_25978":110363,"_2758":110680},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3268":66562,"_28512":66446,"_19817":110682,"_5":13545,"_25978":110367,"_2758":110683},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3268":66563,"_28512":66446,"_19817":110685,"_5":13545,"_25978":110367,"_2758":110686},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3268":66564,"_28512":66446,"_19817":110688,"_5":13545,"_25978":110367,"_2758":110689},[],"acceso completo y de solo lectura a KMS;",{"_3268":66565,"_28512":66446,"_19817":110691,"_5":13545,"_25978":110367,"_2758":110692},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3268":66566,"_28512":66446,"_19817":110694,"_5":13545,"_25978":110367,"_2758":110695},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3268":66567,"_28512":66446,"_19817":110697,"_5":13545,"_25978":110367,"_2758":110698},[],"acceso a la interfaz;",{"_3268":66568,"_28512":66446,"_19817":110700,"_5":13545,"_25978":110367,"_2758":110701},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3268":66569,"_28512":66446,"_19817":110703,"_5":13545,"_25978":110367,"_2758":110704},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3268":66570,"_28512":66446,"_19817":110706,"_5":13545,"_25978":110367,"_2758":110707},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3268":66571,"_28512":66446,"_19817":110709,"_5":13545,"_25978":110371,"_2758":110710},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3268":66572,"_28512":66446,"_19817":110712,"_5":13545,"_25978":110371,"_2758":110713},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3268":66573,"_28512":66446,"_19817":110715,"_5":13545,"_25978":110371,"_2758":110716},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3268":66574,"_28512":66446,"_19817":110718,"_5":13545,"_25978":110374,"_2758":110719},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3268":66575,"_28512":66446,"_19817":110721,"_5":13545,"_25978":110378,"_2758":110722},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3268":66576,"_28512":66446,"_19817":110724,"_5":13545,"_25978":110378,"_2758":110725},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3268":66577,"_28512":66446,"_19817":110727,"_5":13545,"_25978":110382,"_2758":110728},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3268":66578,"_28512":66446,"_19817":110730,"_5":13545,"_25978":110386,"_2758":110731},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3268":66579,"_28512":66446,"_19817":110733,"_5":13545,"_25978":110390,"_2758":110734},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3268":66580,"_28512":66446,"_19817":110736,"_5":13545,"_25978":110394,"_2758":110737},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3268":66581,"_28512":66446,"_19817":110739,"_5":13545,"_25978":110394,"_2758":110740},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3268":66582,"_28512":66446,"_19817":110742,"_5":13545,"_25978":110398,"_2758":110743},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3268":66583,"_28512":66446,"_19817":110745,"_5":13545,"_25978":110398,"_2758":110746},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3268":66584,"_28512":66446,"_19817":110748,"_5":13545,"_25978":110398,"_2758":110749},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3268":66585,"_28512":66446,"_19817":110751,"_5":13545,"_25978":110398,"_2758":110752},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3268":66586,"_28512":66446,"_19817":110754,"_5":13545,"_25978":110398,"_2758":110755},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3268":66587,"_28512":66446,"_19817":110757,"_5":13545,"_25978":110398,"_2758":110758},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3268":66588,"_28512":66446,"_19817":110760,"_5":13545,"_25978":110398,"_2758":110761},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3268":66589,"_28512":66446,"_19817":110763,"_5":13545,"_25978":110398,"_2758":110764},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3268":66590,"_28512":66446,"_19817":110766,"_5":13545,"_25978":110402,"_2758":110767},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3268":66591,"_28512":66446,"_19817":110769,"_5":13545,"_25978":110402,"_2758":110770},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3268":66592,"_28512":66446,"_19817":110772,"_5":13545,"_25978":110402,"_2758":110773},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3268":66593,"_28512":66446,"_19817":110775,"_5":13545,"_25978":110406,"_2758":110776},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3268":66594,"_28512":66446,"_19817":110778,"_5":13545,"_25978":110406,"_2758":110779},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3268":66595,"_28512":66446,"_19817":110781,"_5":13545,"_25978":110406,"_2758":110782},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3268":66596,"_28512":66446,"_19817":110784,"_5":13545,"_25978":110406,"_2758":110785},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3268":66597,"_28512":66446,"_19817":110787,"_5":13545,"_25978":110406,"_2758":110788},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3268":66598,"_28512":66446,"_19817":110790,"_5":13545,"_25978":110406,"_2758":110791},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3268":66599,"_28512":66446,"_19817":110793,"_5":13545,"_25978":110406,"_2758":110794},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3268":66600,"_28512":66446,"_19817":110796,"_5":13545,"_25978":110406,"_2758":110797},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3268":66601,"_28512":66446,"_19817":110799,"_5":13545,"_25978":110414,"_2758":110800},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3268":66602,"_28512":66446,"_19817":110802,"_5":13545,"_25978":110418,"_2758":110803},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3268":66603,"_28512":66446,"_19817":110805,"_5":13545,"_25978":110418,"_2758":110806},[],"que exista un principal activo del tipo correcto;",{"_3268":66604,"_28512":66446,"_19817":110808,"_5":13545,"_25978":110418,"_2758":110809},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3268":66605,"_28512":66446,"_19817":110811,"_5":13545,"_25978":110418,"_2758":110812},[],"que todas las condiciones del principal se cumplan;",{"_3268":66606,"_28512":66446,"_19817":110814,"_5":13545,"_25978":110418,"_2758":110815},[],"que el principal tenga concedida la política esperada;",{"_3268":66607,"_28512":66446,"_19817":110817,"_5":13545,"_25978":110418,"_2758":110818},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3268":66608,"_28512":66446,"_19817":110820,"_5":13545,"_25978":110418,"_2758":110821},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3268":66609,"_28512":66446,"_19817":110823,"_5":13545,"_25978":110418,"_2758":110824},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3268":66610,"_28512":66446,"_19817":110826,"_5":13545,"_25978":110422,"_2758":110827},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3268":66611,"_28512":66446,"_19817":110829,"_5":13545,"_25978":110426,"_2758":110830},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3268":66612,"_28512":66446,"_19817":110832,"_5":13545,"_25978":110430,"_2758":110833},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3268":66613,"_28512":66446,"_19817":110835,"_5":13545,"_25978":110430,"_2758":110836},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3268":66614,"_28512":66614,"_5":13876,"_2758":110838,"_28855":110839,"_19817":110840,"_25978":66614},"Alertas y suscripciones",[46447,110303,110304],[],{"_3268":66615,"_28512":66614,"_19817":110842,"_5":13545,"_25978":66614,"_2758":110843},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3268":66616,"_28512":66614,"_5":28852,"_19817":110845,"_25978":110846,"_2758":110847},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3268":66617,"_28512":66614,"_5":28852,"_19817":110849,"_25978":110850,"_2758":110851},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3268":66618,"_28512":66614,"_5":28852,"_19817":110853,"_25978":110854,"_2758":110855},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3268":66619,"_28512":66614,"_5":28852,"_19817":110857,"_25978":110858,"_2758":110859},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3268":66620,"_28512":66614,"_5":28852,"_19817":110861,"_25978":110862,"_2758":110863},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3268":66621,"_28512":66614,"_5":28852,"_19817":110865,"_25978":110866,"_2758":110867},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3268":66622,"_28512":66614,"_5":28852,"_19817":110869,"_25978":110870,"_2758":110871},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3268":66623,"_28512":66614,"_5":28852,"_19817":110873,"_25978":110874,"_2758":110875},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3268":66624,"_28512":66614,"_5":28852,"_19817":110877,"_25978":110878,"_2758":110879},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3268":66625,"_28512":66614,"_5":28852,"_19817":110881,"_25978":110882,"_2758":110883},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3268":66626,"_28512":66614,"_5":28852,"_19817":110885,"_25978":110886,"_2758":110887},[],"/docs/pr-preview/pr-43/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3268":66627,"_28512":66614,"_19817":110889,"_5":13545,"_25978":66614,"_2758":110890},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3268":66628,"_28512":66614,"_19817":110892,"_5":13545,"_25978":110846,"_2758":110893},[],"Un servicio publica un evento de dominio.",{"_3268":66629,"_28512":66614,"_19817":110895,"_5":13545,"_25978":110846,"_2758":110896},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3268":66630,"_28512":66614,"_19817":110898,"_5":13545,"_25978":110846,"_2758":110899},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3268":66631,"_28512":66614,"_19817":110901,"_5":13545,"_25978":110846,"_2758":110902},[],"Lamassu entrega el evento al canal configurado.",{"_3268":66632,"_28512":66614,"_19817":110904,"_5":13545,"_25978":110846,"_2758":110905},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3268":66633,"_28512":66614,"_19817":110907,"_5":13545,"_25978":110850,"_2758":110908},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3268":66634,"_28512":66614,"_19817":110910,"_5":13545,"_25978":110850,"_2758":110911},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3268":66635,"_28512":66614,"_19817":110913,"_5":13545,"_25978":110850,"_2758":110914},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3268":66636,"_28512":66614,"_19817":110916,"_5":13545,"_25978":110850,"_2758":110917},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3268":66637,"_28512":66614,"_19817":110919,"_5":13545,"_25978":110850,"_2758":110920},[],"`apikey_options` necesita `header` y `key`.",{"_3268":66638,"_28512":66614,"_19817":110922,"_5":13545,"_25978":110850,"_2758":110923},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3268":66639,"_28512":66614,"_19817":110925,"_5":13545,"_25978":110850,"_2758":110926},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3268":66640,"_28512":66614,"_19817":110928,"_5":13545,"_25978":110850,"_2758":110929},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3268":66641,"_28512":66614,"_19817":110931,"_5":13545,"_25978":110858,"_2758":110932},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3268":66642,"_28512":66614,"_19817":110934,"_5":13545,"_25978":110862,"_2758":110935},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3268":66643,"_28512":66614,"_19817":110937,"_5":13545,"_25978":110866,"_2758":110938},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3268":66644,"_28512":66614,"_19817":110940,"_5":13545,"_25978":110866,"_2758":110941},[],"**None** notifica todas las instancias del evento.",{"_3268":66645,"_28512":66614,"_19817":110943,"_5":13545,"_25978":110866,"_2758":110944},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3268":66646,"_28512":66614,"_19817":110946,"_5":13545,"_25978":110866,"_2758":110947},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3268":66647,"_28512":66614,"_19817":110949,"_5":13545,"_25978":110866,"_2758":110950},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3268":66648,"_28512":66614,"_19817":110952,"_5":13545,"_25978":110866,"_2758":110953},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3268":66649,"_28512":66614,"_19817":110955,"_5":13545,"_25978":110870,"_2758":110956},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3268":66650,"_28512":66614,"_19817":110958,"_5":13545,"_25978":110874,"_2758":110959},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3268":66651,"_28512":66614,"_19817":110961,"_5":13545,"_25978":110874,"_2758":110962},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3268":66652,"_28512":66614,"_19817":110964,"_5":13545,"_25978":110874,"_2758":110965},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3268":66653,"_28512":66614,"_19817":110967,"_5":13545,"_25978":110874,"_2758":110968},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3268":66654,"_28512":66614,"_19817":110970,"_5":13545,"_25978":110874,"_2758":110971},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3268":66655,"_28512":66614,"_19817":110973,"_5":13545,"_25978":110874,"_2758":110974},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3268":66656,"_28512":66614,"_19817":110976,"_5":13545,"_25978":110874,"_2758":110977},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3268":66657,"_28512":66614,"_19817":110979,"_5":13545,"_25978":110874,"_2758":110980},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3268":66658,"_28512":66614,"_19817":110982,"_5":13545,"_25978":110878,"_2758":110983},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3268":66659,"_28512":66614,"_19817":110985,"_5":13545,"_25978":110878,"_2758":110986},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3268":66660,"_28512":66614,"_19817":110988,"_5":13545,"_25978":110878,"_2758":110989},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3268":66661,"_28512":66614,"_19817":110991,"_5":13545,"_25978":110878,"_2758":110992},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3268":66662,"_28512":66614,"_19817":110994,"_5":13545,"_25978":110878,"_2758":110995},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3268":66663,"_28512":66614,"_19817":110997,"_5":13545,"_25978":110878,"_2758":110998},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3268":66664,"_28512":66614,"_19817":111000,"_5":13545,"_25978":110878,"_2758":111001},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3268":66665,"_28512":66614,"_19817":111003,"_5":13545,"_25978":110878,"_2758":111004},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3268":66666,"_28512":66614,"_19817":111006,"_5":13545,"_25978":110882,"_2758":111007},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3268":66667,"_28512":66614,"_19817":111009,"_5":13545,"_25978":110882,"_2758":111010},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3268":66668,"_28512":66614,"_19817":111012,"_5":13545,"_25978":110886,"_2758":111013},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3268":66669,"_28512":66614,"_19817":111015,"_5":13545,"_25978":110886,"_2758":111016},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3268":66670,"_28512":66614,"_19817":111018,"_5":13545,"_25978":110886,"_2758":111019},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3268":66671,"_28512":66614,"_19817":111021,"_5":13545,"_25978":110886,"_2758":111022},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3268":66672,"_28512":66614,"_19817":111024,"_5":13545,"_25978":110886,"_2758":111025},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3268":66673,"_28512":66614,"_19817":111027,"_5":13545,"_25978":110886,"_2758":111028},[],"**Validación:** `va.role.crl.create`.",{"_3268":66674,"_28512":66614,"_19817":111030,"_5":13545,"_25978":110886,"_2758":111031},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3268":66675,"_28512":66614,"_19817":111033,"_5":13545,"_25978":110886,"_2758":111034},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3268":66676,"_28512":66676,"_5":13876,"_2758":111036,"_28855":111037,"_19817":111038,"_25978":66676},"Registros de auditoría",[46447,110303,110304],[],{"_3268":66677,"_28512":66676,"_19817":111040,"_5":13545,"_25978":66676,"_2758":111041},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3268":66678,"_28512":66676,"_5":28852,"_19817":111043,"_25978":111044,"_2758":111045},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3268":66679,"_28512":66676,"_5":28852,"_19817":111047,"_25978":111048,"_2758":111049},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3268":66680,"_28512":66676,"_5":28852,"_19817":111051,"_25978":111052,"_2758":111053},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3268":66681,"_28512":66676,"_5":28852,"_19817":111055,"_25978":111056,"_2758":111057},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3268":66682,"_28512":66676,"_5":28852,"_19817":111059,"_25978":111060,"_2758":111061},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3268":66683,"_28512":66676,"_5":28852,"_19817":111063,"_25978":111064,"_2758":111065},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3268":66684,"_28512":66676,"_5":28852,"_19817":111067,"_25978":111068,"_2758":111069},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3268":66685,"_28512":66676,"_5":28852,"_19817":111071,"_25978":111072,"_2758":111073},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3268":66686,"_28512":66676,"_5":28852,"_19817":111075,"_25978":111076,"_2758":111077},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3268":66687,"_28512":66676,"_5":28852,"_19817":111079,"_25978":111080,"_2758":111081},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3268":66688,"_28512":66676,"_5":28852,"_19817":111083,"_25978":111084,"_2758":111085},[],"/docs/pr-preview/pr-43/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3268":66689,"_28512":66676,"_19817":111087,"_5":13545,"_25978":66676,"_2758":111088},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3268":66690,"_28512":66676,"_19817":111090,"_5":13545,"_25978":111044,"_2758":111091},[],"El cuerpo de auditoría incluye:",{"_3268":66691,"_28512":66676,"_19817":111093,"_5":13545,"_25978":111044,"_2758":111094},[],"input: datos recibidos por la operación;",{"_3268":66692,"_28512":66676,"_19817":111096,"_5":13545,"_25978":111044,"_2758":111097},[],"has\\_error: indica si el servicio devolvió un error;",{"_3268":66693,"_28512":66676,"_19817":111099,"_5":13545,"_25978":111044,"_2758":111100},[],"output: resultado producido o mensaje de error;",{"_3268":66694,"_28512":66676,"_19817":111102,"_5":13545,"_25978":111044,"_2758":111103},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3268":66695,"_28512":66676,"_19817":111105,"_5":13545,"_25978":111044,"_2758":111106},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3268":66696,"_28512":66676,"_19817":111108,"_5":13545,"_25978":111044,"_2758":111109},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3268":66697,"_28512":66676,"_19817":111111,"_5":13545,"_25978":111048,"_2758":111112},[],"El backend aplica auditoría a mutaciones de:",{"_3268":66698,"_28512":66676,"_19817":111114,"_5":13545,"_25978":111048,"_2758":111115},[],"autoridades, certificados y perfiles de emisión;",{"_3268":66699,"_28512":66676,"_19817":111117,"_5":13545,"_25978":111048,"_2758":111118},[],"claves y motores KMS;",{"_3268":66700,"_28512":66676,"_19817":111120,"_5":13545,"_25978":111048,"_2758":111121},[],"dispositivos e identidades;",{"_3268":66701,"_28512":66676,"_19817":111123,"_5":13545,"_25978":111048,"_2758":111124},[],"DMS y operaciones de enrolamiento;",{"_3268":66702,"_28512":66676,"_19817":111126,"_5":13545,"_25978":111048,"_2758":111127},[],"funciones de validación y CRL;",{"_3268":66703,"_28512":66676,"_19817":111129,"_5":13545,"_25978":111048,"_2758":111130},[],"principales, políticas y concesiones de autorización.",{"_3268":66704,"_28512":66676,"_19817":111132,"_5":13545,"_25978":111048,"_2758":111133},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3268":66705,"_28512":66676,"_19817":111135,"_5":13545,"_25978":111052,"_2758":111136},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3268":66706,"_28512":66676,"_19817":111138,"_5":13545,"_25978":111052,"_2758":111139},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3268":66707,"_28512":66676,"_19817":111141,"_5":13545,"_25978":111052,"_2758":111142},[],"Diseña el consumidor para:",{"_3268":66708,"_28512":66676,"_19817":111144,"_5":13545,"_25978":111052,"_2758":111145},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3268":66709,"_28512":66676,"_19817":111147,"_5":13545,"_25978":111052,"_2758":111148},[],"conservar el CloudEvent completo sin modificar;",{"_3268":66710,"_28512":66676,"_19817":111150,"_5":13545,"_25978":111052,"_2758":111151},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3268":66711,"_28512":66676,"_19817":111153,"_5":13545,"_25978":111052,"_2758":111154},[],"cifrar en tránsito y en reposo;",{"_3268":66712,"_28512":66676,"_19817":111156,"_5":13545,"_25978":111052,"_2758":111157},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3268":66713,"_28512":66676,"_19817":111159,"_5":13545,"_25978":111052,"_2758":111160},[],"aplicar una política explícita de retención y legal hold;",{"_3268":66714,"_28512":66676,"_19817":111162,"_5":13545,"_25978":111052,"_2758":111163},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3268":66715,"_28512":66676,"_19817":111165,"_5":13545,"_25978":111056,"_2758":111166},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3268":66716,"_28512":66676,"_19817":111168,"_5":13545,"_25978":111056,"_2758":111169},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3268":66717,"_28512":66676,"_19817":111171,"_5":13545,"_25978":111064,"_2758":111172},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3268":66718,"_28512":66676,"_19817":111174,"_5":13545,"_25978":111068,"_2758":111175},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3268":66719,"_28512":66676,"_19817":111177,"_5":13545,"_25978":111072,"_2758":111178},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3268":66720,"_28512":66676,"_19817":111180,"_5":13545,"_25978":111076,"_2758":111181},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3268":66721,"_28512":66676,"_19817":111183,"_5":13545,"_25978":111080,"_2758":111184},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3268":66722,"_28512":66676,"_19817":111186,"_5":13545,"_25978":111084,"_2758":111187},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3268":66723,"_28512":66676,"_19817":111189,"_5":13545,"_25978":111084,"_2758":111190},[],"aparece un evento de auditoría correcto;",{"_3268":66724,"_28512":66676,"_19817":111192,"_5":13545,"_25978":111084,"_2758":111193},[],"el principal coincide con la identidad utilizada;",{"_3268":66725,"_28512":66676,"_19817":111195,"_5":13545,"_25978":111084,"_2758":111196},[],"el consumidor lo persiste una sola vez;",{"_3268":66726,"_28512":66676,"_19817":111198,"_5":13545,"_25978":111084,"_2758":111199},[],"puede recuperarse por recurso, actor y periodo;",{"_3268":66727,"_28512":66676,"_19817":111201,"_5":13545,"_25978":111084,"_2758":111202},[],"una interrupción del consumidor produce una alerta.",{"_3268":66728,"_28512":66676,"_19817":111204,"_5":13545,"_25978":111084,"_2758":111205},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3268":66729,"_28512":66729,"_5":13876,"_2758":111207,"_28855":111208,"_19817":111209,"_25978":66729},"Arquitectura de la plataforma",[46447,110303],[],{"_3268":66730,"_28512":66729,"_19817":111211,"_5":13545,"_25978":66729,"_2758":111212},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3268":66731,"_28512":66729,"_5":28852,"_19817":111214,"_25978":111215,"_2758":111216},[],"/docs/pr-preview/pr-43/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3268":66732,"_28512":66729,"_5":28852,"_19817":111218,"_25978":111219,"_2758":111220},[],"/docs/pr-preview/pr-43/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3268":66733,"_28512":66729,"_5":28852,"_19817":111222,"_25978":111223,"_2758":111224},[],"/docs/pr-preview/pr-43/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3268":66734,"_28512":66729,"_5":28852,"_19817":111226,"_25978":111227,"_2758":111228},[],"/docs/pr-preview/pr-43/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3268":66735,"_28512":66729,"_5":28852,"_19817":111230,"_25978":111231,"_2758":111232},[],"/docs/pr-preview/pr-43/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3268":66736,"_28512":66729,"_19817":111234,"_5":13545,"_25978":66729,"_2758":111235},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3268":66737,"_28512":66729,"_19817":111237,"_5":13545,"_25978":66729,"_2758":111238},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3268":66738,"_28512":66729,"_19817":111240,"_5":13545,"_25978":111215,"_2758":111241},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3268":66739,"_28512":66729,"_19817":111243,"_5":13545,"_25978":111219,"_2758":111244},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3268":66740,"_28512":66729,"_19817":111246,"_5":13545,"_25978":111223,"_2758":111247},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3268":66741,"_28512":66729,"_19817":111249,"_5":13545,"_25978":111227,"_2758":111250},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3268":66742,"_28512":66729,"_19817":111252,"_5":13545,"_25978":111231,"_2758":111253},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3268":66743,"_28512":66743,"_5":13876,"_2758":111255,"_28855":111256,"_19817":111257,"_25978":66743},"Cómo funciona Lamassu",[46447,110303],[],{"_3268":66744,"_28512":66743,"_19817":111259,"_5":13545,"_25978":66743,"_2758":111260},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3268":66745,"_28512":66743,"_5":28852,"_19817":111262,"_25978":111263,"_2758":111264},[],"/docs/pr-preview/pr-43/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3268":66746,"_28512":66743,"_5":28852,"_19817":111266,"_25978":111267,"_2758":111268},[],"/docs/pr-preview/pr-43/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3268":66747,"_28512":66743,"_19817":111270,"_5":13545,"_25978":66743,"_2758":111271},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3268":66748,"_28512":66743,"_19817":111273,"_5":13545,"_25978":111263,"_2758":111274},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3268":66749,"_28512":66743,"_19817":111276,"_5":13545,"_25978":111263,"_2758":111277},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3268":66750,"_28512":66743,"_19817":111279,"_5":13545,"_25978":111263,"_2758":111280},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3268":66751,"_28512":66743,"_19817":111282,"_5":13545,"_25978":111263,"_2758":111283},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3268":66752,"_28512":66743,"_19817":111285,"_5":13545,"_25978":111263,"_2758":111286},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3268":66753,"_28512":66743,"_19817":111288,"_5":13545,"_25978":111267,"_2758":111289},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3268":66754,"_28512":66743,"_19817":111291,"_5":13545,"_25978":111267,"_2758":111292},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3268":66755,"_28512":66743,"_19817":111294,"_5":13545,"_25978":111267,"_2758":111295},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3268":66756,"_28512":66743,"_19817":111297,"_5":13545,"_25978":111267,"_2758":111298},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3268":66757,"_28512":66743,"_19817":111300,"_5":13545,"_25978":111267,"_2758":111301},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3268":66758,"_28512":66743,"_19817":111303,"_5":13545,"_25978":111267,"_2758":111304},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3268":66759,"_28512":66743,"_19817":111306,"_5":13545,"_25978":111267,"_2758":111307},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3268":66760,"_28512":66760,"_5":13876,"_2758":111309,"_28855":111310,"_19817":111311,"_25978":66760},"Dispositivos e identidades",[46447,110303,48848,111309],[],{"_3268":66761,"_28512":66760,"_19817":111313,"_5":13545,"_25978":66760,"_2758":111314},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3268":66762,"_28512":66760,"_5":28852,"_19817":111316,"_25978":111317,"_2758":111318},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3268":66763,"_28512":66760,"_5":28852,"_19817":111320,"_25978":111321,"_2758":111322},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3268":66764,"_28512":66760,"_5":28852,"_19817":111324,"_25978":111325,"_2758":111326},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3268":66765,"_28512":66760,"_5":28852,"_19817":111328,"_25978":111329,"_2758":111330},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3268":66766,"_28512":66760,"_5":28852,"_19817":111332,"_25978":111333,"_2758":111334},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3268":66767,"_28512":66760,"_5":28852,"_19817":111336,"_25978":111337,"_2758":111338},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3268":66768,"_28512":66760,"_5":28852,"_19817":111340,"_25978":111341,"_2758":111342},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3268":66769,"_28512":66760,"_5":28852,"_19817":111344,"_25978":111345,"_2758":111346},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3268":66770,"_28512":66760,"_5":28852,"_19817":111348,"_25978":111349,"_2758":111350},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3268":66771,"_28512":66760,"_5":28852,"_19817":111352,"_25978":111353,"_2758":111354},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3268":66772,"_28512":66760,"_5":28852,"_19817":111356,"_25978":111357,"_2758":111358},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3268":66773,"_28512":66760,"_19817":111360,"_5":13545,"_25978":66760,"_2758":111361},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3268":66774,"_28512":66760,"_19817":111363,"_5":13545,"_25978":66760,"_2758":111364},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3268":66775,"_28512":66760,"_19817":111366,"_5":13545,"_25978":111317,"_2758":111367},[],"Vista operativa",{"_3268":66776,"_28512":66760,"_19817":111369,"_5":13545,"_25978":111317,"_2758":111370},[],"Interpretación",{"_3268":66777,"_28512":66760,"_19817":111372,"_5":13545,"_25978":111317,"_2758":48911},[],{"_3268":66778,"_28512":66760,"_19817":111374,"_5":13545,"_25978":111317,"_2758":111375},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3268":66779,"_28512":66760,"_19817":111377,"_5":13545,"_25978":111317,"_2758":48917},[],{"_3268":66780,"_28512":66760,"_19817":111379,"_5":13545,"_25978":111317,"_2758":111380},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3268":66781,"_28512":66760,"_19817":111382,"_5":13545,"_25978":111317,"_2758":48923},[],{"_3268":66782,"_28512":66760,"_19817":111384,"_5":13545,"_25978":111317,"_2758":111385},[],"La identidad está en la ventana operativa de renovación.",{"_3268":66783,"_28512":66760,"_19817":111387,"_5":13545,"_25978":111317,"_2758":48929},[],{"_3268":66784,"_28512":66760,"_19817":111389,"_5":13545,"_25978":111317,"_2758":111390},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3268":66785,"_28512":66760,"_19817":111392,"_5":13545,"_25978":111317,"_2758":48935},[],{"_3268":66786,"_28512":66760,"_19817":111394,"_5":13545,"_25978":111317,"_2758":111395},[],"La identidad ha vencido.",{"_3268":66787,"_28512":66760,"_19817":111397,"_5":13545,"_25978":111317,"_2758":48941},[],{"_3268":66788,"_28512":66760,"_19817":111399,"_5":13545,"_25978":111317,"_2758":111400},[],"La identidad está marcada como revocada.",{"_3268":66789,"_28512":66760,"_19817":111402,"_5":13545,"_25978":111317,"_2758":48947},[],{"_3268":66790,"_28512":66760,"_19817":111404,"_5":13545,"_25978":111317,"_2758":111405},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3268":66791,"_28512":66760,"_19817":111407,"_5":13545,"_25978":111317,"_2758":111408},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3268":66792,"_28512":66760,"_19817":111410,"_5":13545,"_25978":111321,"_2758":111411},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3268":66793,"_28512":66760,"_19817":111413,"_5":13545,"_25978":111321,"_2758":111414},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3268":66794,"_28512":66760,"_19817":111416,"_5":13545,"_25978":111321,"_2758":111417},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3268":66795,"_28512":66760,"_19817":111419,"_5":13545,"_25978":111321,"_2758":111420},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3268":66796,"_28512":66760,"_19817":111422,"_5":13545,"_25978":111325,"_2758":111423},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3268":66797,"_28512":66760,"_19817":111425,"_5":13545,"_25978":111329,"_2758":111426},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3268":66798,"_28512":66760,"_19817":111428,"_5":13545,"_25978":111333,"_2758":111429},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3268":66799,"_28512":66760,"_19817":111431,"_5":13545,"_25978":111337,"_2758":111432},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3268":66800,"_28512":66760,"_19817":111434,"_5":13545,"_25978":111341,"_2758":111435},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3268":66801,"_28512":66760,"_19817":111437,"_5":13545,"_25978":111341,"_2758":111438},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3268":66802,"_28512":66760,"_19817":111440,"_5":13545,"_25978":111345,"_2758":111441},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3268":66803,"_28512":66760,"_19817":111443,"_5":13545,"_25978":111345,"_2758":111444},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3268":66804,"_28512":66760,"_19817":111446,"_5":13545,"_25978":111345,"_2758":111447},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3268":66805,"_28512":66760,"_19817":111449,"_5":13545,"_25978":111345,"_2758":111450},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3268":66806,"_28512":66760,"_19817":111452,"_5":13545,"_25978":111345,"_2758":111453},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3268":66807,"_28512":66760,"_19817":111455,"_5":13545,"_25978":111345,"_2758":111456},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3268":66808,"_28512":66760,"_19817":111458,"_5":13545,"_25978":111349,"_2758":111459},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3268":66809,"_28512":66760,"_19817":111461,"_5":13545,"_25978":111349,"_2758":111462},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3268":66810,"_28512":66760,"_19817":111464,"_5":13545,"_25978":111353,"_2758":111465},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3268":66811,"_28512":66760,"_19817":111467,"_5":13545,"_25978":111353,"_2758":111468},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3268":66812,"_28512":66760,"_19817":111470,"_5":13545,"_25978":111353,"_2758":111471},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3268":66813,"_28512":66760,"_19817":111473,"_5":13545,"_25978":111353,"_2758":111474},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3268":66814,"_28512":66760,"_19817":111476,"_5":13545,"_25978":111357,"_2758":111477},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3268":66815,"_28512":66760,"_19817":111479,"_5":13545,"_25978":111357,"_2758":111480},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3268":66816,"_28512":66816,"_5":13876,"_2758":111482,"_28855":111483,"_19817":111485,"_25978":66816},"Identidad inicial y autenticación",[46447,110303,48848,111309,111484],"Enrolamiento con PKI",[],{"_3268":66817,"_28512":66816,"_19817":111487,"_5":13545,"_25978":66816,"_2758":111488},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3268":66818,"_28512":66816,"_5":28852,"_19817":111490,"_25978":111491,"_2758":111492},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3268":66819,"_28512":66816,"_5":28852,"_19817":111494,"_25978":111495,"_2758":111496},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3268":66820,"_28512":66816,"_5":28852,"_19817":111498,"_25978":111499,"_2758":111500},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3268":66821,"_28512":66816,"_5":28852,"_19817":111502,"_25978":111503,"_2758":111504},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3268":66822,"_28512":66816,"_5":28852,"_19817":111506,"_25978":111507,"_2758":111508},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3268":66823,"_28512":66816,"_19817":111510,"_5":13545,"_25978":66816,"_2758":111511},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3268":66824,"_28512":66816,"_19817":111513,"_5":13545,"_25978":111491,"_2758":111514},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3268":66825,"_28512":66816,"_19817":111516,"_5":13545,"_25978":111491,"_2758":111517},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3268":66826,"_28512":66816,"_19817":111519,"_5":13545,"_25978":111495,"_2758":111520},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3268":66827,"_28512":66816,"_19817":111522,"_5":13545,"_25978":111495,"_2758":111523},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3268":66828,"_28512":66816,"_19817":111525,"_5":13545,"_25978":111495,"_2758":111526},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3268":66829,"_28512":66816,"_19817":111528,"_5":13545,"_25978":111499,"_2758":111529},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3268":66830,"_28512":66816,"_19817":111531,"_5":13545,"_25978":111499,"_2758":111532},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3268":66831,"_28512":66816,"_19817":111534,"_5":13545,"_25978":111503,"_2758":111535},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3268":66832,"_28512":66816,"_19817":111537,"_5":13545,"_25978":111503,"_2758":111538},[],"Ejemplo de cuerpo:",{"_3268":66833,"_28512":66816,"_19817":111540,"_5":13545,"_25978":111503,"_2758":111541},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3268":66834,"_28512":66816,"_19817":111543,"_5":13545,"_25978":111503,"_2758":111544},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3268":66835,"_28512":66816,"_19817":111546,"_5":13545,"_25978":111503,"_2758":111547},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3268":66836,"_28512":66816,"_19817":111549,"_5":13545,"_25978":111503,"_2758":111550},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3268":66837,"_28512":66816,"_19817":111552,"_5":13545,"_25978":111507,"_2758":111553},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3268":66838,"_28512":66816,"_19817":111555,"_5":13545,"_25978":111507,"_2758":111556},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3268":66839,"_28512":66839,"_5":13876,"_2758":111558,"_28855":111559,"_19817":111560,"_25978":66839},"Configura y opera el DMS",[46447,110303,48848,111309,111484],[],{"_3268":66840,"_28512":66839,"_19817":111562,"_5":13545,"_25978":66839,"_2758":111563},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3268":66841,"_28512":66839,"_5":28852,"_19817":111565,"_25978":111566,"_2758":108956},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3268":66842,"_28512":66839,"_5":28852,"_19817":111568,"_25978":111569,"_2758":111570},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3268":66843,"_28512":66839,"_5":28852,"_19817":111572,"_25978":111573,"_2758":111574},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3268":66844,"_28512":66839,"_5":28852,"_19817":111576,"_25978":111577,"_2758":111578},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3268":66845,"_28512":66839,"_5":28852,"_19817":111580,"_25978":111581,"_2758":111582},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3268":66846,"_28512":66839,"_5":28852,"_19817":111584,"_25978":111585,"_2758":111586},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3268":66847,"_28512":66839,"_5":28852,"_19817":111588,"_25978":111589,"_2758":111590},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3268":66848,"_28512":66839,"_5":28852,"_19817":111592,"_25978":111593,"_2758":111594},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3268":66849,"_28512":66839,"_5":28852,"_19817":111596,"_25978":111597,"_2758":49143},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3268":66850,"_28512":66839,"_5":28852,"_19817":111599,"_25978":111600,"_2758":49147},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3268":66851,"_28512":66839,"_5":28852,"_19817":111602,"_25978":111603,"_2758":111604},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3268":66852,"_28512":66839,"_5":28852,"_19817":111606,"_25978":111607,"_2758":111608},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3268":66853,"_28512":66839,"_5":28852,"_19817":111610,"_25978":111611,"_2758":111612},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3268":66854,"_28512":66839,"_5":28852,"_19817":111614,"_25978":111615,"_2758":111616},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3268":66855,"_28512":66839,"_5":28852,"_19817":111618,"_25978":111619,"_2758":49167},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3268":66856,"_28512":66839,"_5":28852,"_19817":111621,"_25978":111622,"_2758":111623},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3268":66857,"_28512":66839,"_5":28852,"_19817":111625,"_25978":111626,"_2758":111627},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3268":66858,"_28512":66839,"_5":28852,"_19817":111629,"_25978":111630,"_2758":111631},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3268":66859,"_28512":66839,"_19817":111633,"_5":13545,"_25978":66839,"_2758":111634},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3268":66860,"_28512":66839,"_19817":111636,"_5":13545,"_25978":111566,"_2758":111637},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3268":66861,"_28512":66839,"_19817":111639,"_5":13545,"_25978":111566,"_2758":111640},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3268":66862,"_28512":66839,"_19817":111642,"_5":13545,"_25978":111573,"_2758":111643},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3268":66863,"_28512":66839,"_19817":111645,"_5":13545,"_25978":111577,"_2758":111646},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3268":66864,"_28512":66839,"_19817":111648,"_5":13545,"_25978":111581,"_2758":111649},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3268":66865,"_28512":66839,"_19817":111651,"_5":13545,"_25978":111585,"_2758":111652},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3268":66866,"_28512":66839,"_19817":111654,"_5":13545,"_25978":111589,"_2758":111655},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3268":66867,"_28512":66839,"_19817":111657,"_5":13545,"_25978":111597,"_2758":111658},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3268":66868,"_28512":66839,"_19817":111660,"_5":13545,"_25978":111597,"_2758":111661},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3268":66869,"_28512":66839,"_19817":111663,"_5":13545,"_25978":111600,"_2758":111664},[],"Campo de `settings.enrollment_settings`",{"_3268":66870,"_28512":66839,"_19817":111666,"_5":13545,"_25978":111600,"_2758":111667},[],"Decisión",{"_3268":66871,"_28512":66839,"_19817":111669,"_5":13545,"_25978":111600,"_2758":49218},[],{"_3268":66872,"_28512":66839,"_19817":111671,"_5":13545,"_25978":111600,"_2758":111672},[],"`EST_RFC7030` para estas operaciones.",{"_3268":66873,"_28512":66839,"_19817":111674,"_5":13545,"_25978":111600,"_2758":49224},[],{"_3268":66874,"_28512":66839,"_19817":111676,"_5":13545,"_25978":111600,"_2758":111677},[],"ID de la CA que firmará.",{"_3268":66875,"_28512":66839,"_19817":111679,"_5":13545,"_25978":111600,"_2758":49230},[],{"_3268":66876,"_28512":66839,"_19817":111681,"_5":13545,"_25978":111600,"_2758":111682},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3268":66877,"_28512":66839,"_19817":111684,"_5":13545,"_25978":111600,"_2758":49236},[],{"_3268":66878,"_28512":66839,"_19817":111686,"_5":13545,"_25978":111600,"_2758":111687},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3268":66879,"_28512":66839,"_19817":111689,"_5":13545,"_25978":111600,"_2758":49242},[],{"_3268":66880,"_28512":66839,"_19817":111691,"_5":13545,"_25978":111600,"_2758":111692},[],"Uno de los cuatro modos de autenticación.",{"_3268":66881,"_28512":66839,"_19817":111694,"_5":13545,"_25978":111600,"_2758":111695},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3268":66882,"_28512":66839,"_19817":111697,"_5":13545,"_25978":111603,"_2758":111698},[],"Los bloques son independientes:",{"_3268":66883,"_28512":66839,"_19817":111700,"_5":13545,"_25978":111603,"_2758":111701},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3268":66884,"_28512":66839,"_19817":111703,"_5":13545,"_25978":111603,"_2758":111704},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3268":66885,"_28512":66839,"_19817":111706,"_5":13545,"_25978":111603,"_2758":49260},[],{"_3268":66886,"_28512":66839,"_19817":111708,"_5":13545,"_25978":111603,"_2758":111709},[],"Control aplicado en la operación configurada",{"_3268":66887,"_28512":66839,"_19817":111711,"_5":13545,"_25978":111603,"_2758":49266},[],{"_3268":66888,"_28512":66839,"_19817":111713,"_5":13545,"_25978":111603,"_2758":111714},[],"Validación del certificado presentado.",{"_3268":66889,"_28512":66839,"_19817":111716,"_5":13545,"_25978":111603,"_2758":49272},[],{"_3268":66890,"_28512":66839,"_19817":111718,"_5":13545,"_25978":111603,"_2758":111719},[],"Autorización del webhook configurado.",{"_3268":66891,"_28512":66839,"_19817":111721,"_5":13545,"_25978":111603,"_2758":49278},[],{"_3268":66892,"_28512":66839,"_19817":111723,"_5":13545,"_25978":111603,"_2758":111724},[],"Validación del certificado y, después, aprobación del webhook.",{"_3268":66893,"_28512":66839,"_19817":111726,"_5":13545,"_25978":111603,"_2758":49284},[],{"_3268":66894,"_28512":66839,"_19817":111728,"_5":13545,"_25978":111603,"_2758":111729},[],"Sin autenticación del solicitante por el DMS.",{"_3268":66895,"_28512":66839,"_19817":111731,"_5":13545,"_25978":111603,"_2758":111732},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3268":66896,"_28512":66839,"_19817":111734,"_5":13545,"_25978":111603,"_2758":111735},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3268":66897,"_28512":66839,"_19817":111737,"_5":13545,"_25978":111603,"_2758":111738},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3268":66898,"_28512":66839,"_19817":111740,"_5":13545,"_25978":111603,"_2758":111741},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3268":66899,"_28512":66839,"_19817":111743,"_5":13545,"_25978":111607,"_2758":111744},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3268":66900,"_28512":66839,"_19817":111746,"_5":13545,"_25978":111607,"_2758":111747},[],"Campo de `external_webhook_settings`",{"_3268":66901,"_28512":66839,"_19817":111749,"_5":13545,"_25978":111607,"_2758":111667},[],{"_3268":66902,"_28512":66839,"_19817":111751,"_5":13545,"_25978":111607,"_2758":49310},[],{"_3268":66903,"_28512":66839,"_19817":111753,"_5":13545,"_25978":111607,"_2758":111754},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3268":66904,"_28512":66839,"_19817":111756,"_5":13545,"_25978":111607,"_2758":49316},[],{"_3268":66905,"_28512":66839,"_19817":111758,"_5":13545,"_25978":111607,"_2758":111759},[],"`POST` o `PUT`; `POST` por defecto.",{"_3268":66906,"_28512":66839,"_19817":111761,"_5":13545,"_25978":111607,"_2758":49322},[],{"_3268":66907,"_28512":66839,"_19817":111763,"_5":13545,"_25978":111607,"_2758":111764},[],"Etiqueta usada en los logs del servicio.",{"_3268":66908,"_28512":66839,"_19817":111766,"_5":13545,"_25978":111607,"_2758":49328},[],{"_3268":66909,"_28512":66839,"_19817":111768,"_5":13545,"_25978":111607,"_2758":111769},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3268":66910,"_28512":66839,"_19817":111771,"_5":13545,"_25978":111607,"_2758":49334},[],{"_3268":66911,"_28512":66839,"_19817":111773,"_5":13545,"_25978":111607,"_2758":111774},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3268":66912,"_28512":66839,"_19817":111776,"_5":13545,"_25978":111607,"_2758":49340},[],{"_3268":66913,"_28512":66839,"_19817":111778,"_5":13545,"_25978":111607,"_2758":111779},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3268":66914,"_28512":66839,"_19817":111781,"_5":13545,"_25978":111607,"_2758":49346},[],{"_3268":66915,"_28512":66839,"_19817":111783,"_5":13545,"_25978":111607,"_2758":111784},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3268":66916,"_28512":66839,"_19817":111786,"_5":13545,"_25978":111607,"_2758":49352},[],{"_3268":66917,"_28512":66839,"_19817":111788,"_5":13545,"_25978":111607,"_2758":111789},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3268":66918,"_28512":66839,"_19817":111791,"_5":13545,"_25978":111607,"_2758":49358},[],{"_3268":66919,"_28512":66839,"_19817":111793,"_5":13545,"_25978":111607,"_2758":111794},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3268":66920,"_28512":66839,"_19817":111796,"_5":13545,"_25978":111607,"_2758":49364},[],{"_3268":66921,"_28512":66839,"_19817":111798,"_5":13545,"_25978":111607,"_2758":111799},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3268":66922,"_28512":66839,"_19817":111801,"_5":13545,"_25978":111607,"_2758":111802},[],"Reglas de esa configuración:",{"_3268":66923,"_28512":66839,"_19817":111804,"_5":13545,"_25978":111607,"_2758":111805},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3268":66924,"_28512":66839,"_19817":111807,"_5":13545,"_25978":111607,"_2758":111808},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3268":66925,"_28512":66839,"_19817":111810,"_5":13545,"_25978":111607,"_2758":111811},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3268":66926,"_28512":66839,"_19817":111813,"_5":13545,"_25978":111607,"_2758":111814},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3268":66927,"_28512":66839,"_19817":111816,"_5":13545,"_25978":111607,"_2758":111817},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3268":66928,"_28512":66839,"_19817":111819,"_5":13545,"_25978":111607,"_2758":111820},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3268":66929,"_28512":66839,"_19817":111822,"_5":13545,"_25978":111607,"_2758":111823},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3268":66930,"_28512":66839,"_19817":111825,"_5":13545,"_25978":111607,"_2758":111826},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3268":66931,"_28512":66839,"_19817":111828,"_5":13545,"_25978":111607,"_2758":111829},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3268":66932,"_28512":66839,"_19817":111831,"_5":13545,"_25978":111611,"_2758":111832},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3268":66933,"_28512":66839,"_19817":111834,"_5":13545,"_25978":111615,"_2758":111835},[],"Campo de `settings.reenrollment_settings`",{"_3268":66934,"_28512":66839,"_19817":111837,"_5":13545,"_25978":111615,"_2758":111838},[],"Función",{"_3268":66935,"_28512":66839,"_19817":111840,"_5":13545,"_25978":111615,"_2758":49408},[],{"_3268":66936,"_28512":66839,"_19817":111842,"_5":13545,"_25978":111615,"_2758":111843},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3268":66937,"_28512":66839,"_19817":111845,"_5":13545,"_25978":111615,"_2758":49414},[],{"_3268":66938,"_28512":66839,"_19817":111847,"_5":13545,"_25978":111615,"_2758":111848},[],"Umbral operativo preventivo de monitorización.",{"_3268":66939,"_28512":66839,"_19817":111850,"_5":13545,"_25978":111615,"_2758":49420},[],{"_3268":66940,"_28512":66839,"_19817":111852,"_5":13545,"_25978":111615,"_2758":111853},[],"Umbral operativo crítico de monitorización.",{"_3268":66941,"_28512":66839,"_19817":111855,"_5":13545,"_25978":111615,"_2758":49426},[],{"_3268":66942,"_28512":66839,"_19817":111857,"_5":13545,"_25978":111615,"_2758":111858},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3268":66943,"_28512":66839,"_19817":111860,"_5":13545,"_25978":111615,"_2758":49432},[],{"_3268":66944,"_28512":66839,"_19817":111862,"_5":13545,"_25978":111615,"_2758":111863},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3268":66945,"_28512":66839,"_19817":111865,"_5":13545,"_25978":111615,"_2758":49438},[],{"_3268":66946,"_28512":66839,"_19817":111867,"_5":13545,"_25978":111615,"_2758":111868},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3268":66947,"_28512":66839,"_19817":111870,"_5":13545,"_25978":111615,"_2758":111871},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3268":66948,"_28512":66839,"_19817":111873,"_5":13545,"_25978":111619,"_2758":111874},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3268":66949,"_28512":66839,"_19817":111876,"_5":13545,"_25978":111622,"_2758":109320},[],{"_3268":66950,"_28512":66839,"_19817":111878,"_5":13545,"_25978":111622,"_2758":111879},[],"Qué publica",{"_3268":66951,"_28512":66839,"_19817":111881,"_5":13545,"_25978":111622,"_2758":49455},[],{"_3268":66952,"_28512":66839,"_19817":111883,"_5":13545,"_25978":111622,"_2758":111884},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3268":66953,"_28512":66839,"_19817":111886,"_5":13545,"_25978":111622,"_2758":49461},[],{"_3268":66954,"_28512":66839,"_19817":111888,"_5":13545,"_25978":111622,"_2758":111889},[],"Certificado de la CA emisora seleccionada.",{"_3268":66955,"_28512":66839,"_19817":111891,"_5":13545,"_25978":111622,"_2758":49467},[],{"_3268":66956,"_28512":66839,"_19817":111893,"_5":13545,"_25978":111622,"_2758":111894},[],"Certificados de las CAs elegidas explícitamente.",{"_3268":66957,"_28512":66839,"_19817":111896,"_5":13545,"_25978":111622,"_2758":111897},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3268":66958,"_28512":66839,"_19817":111899,"_5":13545,"_25978":111626,"_2758":111900},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP.",{"_3268":66959,"_28512":66839,"_19817":111902,"_5":13545,"_25978":111626,"_2758":111903},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3268":66960,"_28512":66839,"_19817":111905,"_5":13545,"_25978":111626,"_2758":111906},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3268":66961,"_28512":66839,"_19817":111908,"_5":13545,"_25978":111630,"_2758":111909},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3268":66962,"_28512":66962,"_5":13876,"_2758":111911,"_28855":111912,"_19817":111913,"_25978":66962},"Integra el cliente EST",[46447,110303,48848,111309,111484],[],{"_3268":66963,"_28512":66962,"_19817":111915,"_5":13545,"_25978":66962,"_2758":111916},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3268":66964,"_28512":66962,"_5":28852,"_19817":111918,"_25978":111919,"_2758":108956},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3268":66965,"_28512":66962,"_5":28852,"_19817":111921,"_25978":111922,"_2758":111923},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3268":66966,"_28512":66962,"_5":28852,"_19817":111925,"_25978":111926,"_2758":111927},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3268":66967,"_28512":66962,"_5":28852,"_19817":111929,"_25978":111930,"_2758":111931},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3268":66968,"_28512":66962,"_5":28852,"_19817":111933,"_25978":111934,"_2758":111935},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3268":66969,"_28512":66962,"_5":28852,"_19817":111937,"_25978":111938,"_2758":111939},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3268":66970,"_28512":66962,"_19817":111941,"_5":13545,"_25978":66962,"_2758":111942},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3268":66971,"_28512":66962,"_19817":111944,"_5":13545,"_25978":111919,"_2758":111945},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3268":66972,"_28512":66962,"_19817":111947,"_5":13545,"_25978":111919,"_2758":111948},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3268":66973,"_28512":66962,"_19817":111950,"_5":13545,"_25978":111919,"_2758":111951},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3268":66974,"_28512":66962,"_19817":111953,"_5":13545,"_25978":111922,"_2758":111954},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3268":66975,"_28512":66962,"_19817":111956,"_5":13545,"_25978":111922,"_2758":111957},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3268":66976,"_28512":66962,"_19817":111959,"_5":13545,"_25978":111926,"_2758":111960},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3268":66977,"_28512":66962,"_19817":111962,"_5":13545,"_25978":111926,"_2758":111963},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3268":66978,"_28512":66962,"_19817":111965,"_5":13545,"_25978":111930,"_2758":111966},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3268":66979,"_28512":66962,"_19817":111968,"_5":13545,"_25978":111930,"_2758":111969},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3268":66980,"_28512":66962,"_19817":111971,"_5":13545,"_25978":111934,"_2758":111972},[],"Para el caso de una raíz que emite directamente:",{"_3268":66981,"_28512":66962,"_19817":111974,"_5":13545,"_25978":111934,"_2758":111975},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3268":66982,"_28512":66962,"_19817":111977,"_5":13545,"_25978":111934,"_2758":111978},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3268":66983,"_28512":66962,"_19817":111980,"_5":13545,"_25978":111938,"_2758":111981},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3268":66984,"_28512":66984,"_5":13876,"_2758":111983,"_28855":111984,"_19817":111985,"_25978":66984},"Referencia EST",[46447,110303,48848,111309,111484],[],{"_3268":66985,"_28512":66984,"_19817":111987,"_5":13545,"_25978":66984,"_2758":111988},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3268":66986,"_28512":66984,"_5":28852,"_19817":111990,"_25978":111991,"_2758":111992},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3268":66987,"_28512":66984,"_5":28852,"_19817":111994,"_25978":111995,"_2758":21508},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3268":66988,"_28512":66984,"_5":28852,"_19817":111997,"_25978":111998,"_2758":24660},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3268":66989,"_28512":66984,"_5":28852,"_19817":112000,"_25978":112001,"_2758":24667},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3268":66990,"_28512":66984,"_5":28852,"_19817":112003,"_25978":112004,"_2758":24012},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3268":66991,"_28512":66984,"_5":28852,"_19817":112006,"_25978":112007,"_2758":112008},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3268":66992,"_28512":66984,"_5":28852,"_19817":112010,"_25978":112011,"_2758":112012},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3268":66993,"_28512":66984,"_5":28852,"_19817":112014,"_25978":112015,"_2758":112016},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3268":66994,"_28512":66984,"_19817":112018,"_5":13545,"_25978":66984,"_2758":112019},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3268":66995,"_28512":66984,"_19817":112021,"_5":13545,"_25978":111991,"_2758":112022},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3268":66996,"_28512":66984,"_19817":112024,"_5":13545,"_25978":111991,"_2758":110091},[],{"_3268":66997,"_28512":66984,"_19817":112026,"_5":13545,"_25978":111991,"_2758":112027},[],"Método",{"_3268":66998,"_28512":66984,"_19817":112029,"_5":13545,"_25978":111991,"_2758":112030},[],"Autenticación y condición",{"_3268":66999,"_28512":66984,"_19817":112032,"_5":13545,"_25978":111991,"_2758":49610},[],{"_3268":67000,"_28512":66984,"_19817":112034,"_5":13545,"_25978":111991,"_2758":49613},[],{"_3268":67001,"_28512":66984,"_19817":112036,"_5":13545,"_25978":111991,"_2758":112037},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3268":67002,"_28512":66984,"_19817":112039,"_5":13545,"_25978":111991,"_2758":49619},[],{"_3268":67003,"_28512":66984,"_19817":112041,"_5":13545,"_25978":111991,"_2758":49622},[],{"_3268":67004,"_28512":66984,"_19817":112043,"_5":13545,"_25978":111991,"_2758":112044},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3268":67005,"_28512":66984,"_19817":112046,"_5":13545,"_25978":111991,"_2758":49628},[],{"_3268":67006,"_28512":66984,"_19817":112048,"_5":13545,"_25978":111991,"_2758":49622},[],{"_3268":67007,"_28512":66984,"_19817":112050,"_5":13545,"_25978":111991,"_2758":112051},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3268":67008,"_28512":66984,"_19817":112053,"_5":13545,"_25978":111991,"_2758":49636},[],{"_3268":67009,"_28512":66984,"_19817":112055,"_5":13545,"_25978":111991,"_2758":49622},[],{"_3268":67010,"_28512":66984,"_19817":112057,"_5":13545,"_25978":111991,"_2758":112058},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3268":67011,"_28512":66984,"_19817":112060,"_5":13545,"_25978":111991,"_2758":112061},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3268":67012,"_28512":66984,"_19817":112063,"_5":13545,"_25978":111995,"_2758":112064},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3268":67013,"_28512":66984,"_19817":112066,"_5":13545,"_25978":111995,"_2758":112067},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3268":67014,"_28512":66984,"_19817":112069,"_5":13545,"_25978":111998,"_2758":112070},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3268":67015,"_28512":66984,"_19817":112072,"_5":13545,"_25978":111998,"_2758":112073},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3268":67016,"_28512":66984,"_19817":112075,"_5":13545,"_25978":112001,"_2758":112076},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3268":67017,"_28512":66984,"_19817":112078,"_5":13545,"_25978":112001,"_2758":112079},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3268":67018,"_28512":66984,"_19817":112081,"_5":13545,"_25978":112004,"_2758":112082},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3268":67019,"_28512":66984,"_19817":112084,"_5":13545,"_25978":112004,"_2758":112085},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3268":67020,"_28512":66984,"_19817":112087,"_5":13545,"_25978":112007,"_2758":112088},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3268":67021,"_28512":66984,"_19817":112090,"_5":13545,"_25978":112007,"_2758":112091},[],"Parte",{"_3268":67022,"_28512":66984,"_19817":112093,"_5":13545,"_25978":112007,"_2758":112094},[],"Contenido tras decodificar su Base64",{"_3268":67023,"_28512":66984,"_19817":112096,"_5":13545,"_25978":112007,"_2758":49680},[],{"_3268":67024,"_28512":66984,"_19817":112098,"_5":13545,"_25978":112007,"_2758":112099},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3268":67025,"_28512":66984,"_19817":112101,"_5":13545,"_25978":112007,"_2758":49686},[],{"_3268":67026,"_28512":66984,"_19817":112103,"_5":13545,"_25978":112007,"_2758":112104},[],"PKCS#7 DER con el certificado emitido.",{"_3268":67027,"_28512":66984,"_19817":112106,"_5":13545,"_25978":112007,"_2758":112107},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3268":67028,"_28512":66984,"_19817":112109,"_5":13545,"_25978":112011,"_2758":112110},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3268":67029,"_28512":66984,"_19817":112112,"_5":13545,"_25978":112011,"_2758":112113},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3268":67030,"_28512":66984,"_19817":112115,"_5":13545,"_25978":112011,"_2758":112116},[],"Convierte y comprueba el resultado:",{"_3268":67031,"_28512":66984,"_19817":112118,"_5":13545,"_25978":112011,"_2758":112119},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3268":67032,"_28512":66984,"_19817":112121,"_5":13545,"_25978":112015,"_2758":112122},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3268":67033,"_28512":66984,"_19817":112124,"_5":13545,"_25978":112015,"_2758":112125},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3268":67034,"_28512":67034,"_5":13876,"_2758":111484,"_28855":112127,"_19817":112128,"_25978":67034},[46447,110303,48848,111309,111484],[],{"_3268":67035,"_28512":67034,"_19817":112130,"_5":13545,"_25978":67034,"_2758":112131},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3268":67036,"_28512":67034,"_5":28852,"_19817":112133,"_25978":112134,"_2758":112135},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3268":67037,"_28512":67034,"_5":28852,"_19817":112137,"_25978":112138,"_2758":112139},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3268":67038,"_28512":67034,"_5":28852,"_19817":112141,"_25978":112142,"_2758":112143},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3268":67039,"_28512":67034,"_5":28852,"_19817":112145,"_25978":112146,"_2758":112147},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3268":67040,"_28512":67034,"_19817":112149,"_5":13545,"_25978":67034,"_2758":112150},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3268":67041,"_28512":67034,"_19817":112152,"_5":13545,"_25978":112134,"_2758":112153},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3268":67042,"_28512":67034,"_19817":112155,"_5":13545,"_25978":112134,"_2758":112156},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3268":67043,"_28512":67034,"_19817":112158,"_5":13545,"_25978":112134,"_2758":112159},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3268":67044,"_28512":67034,"_19817":112161,"_5":13545,"_25978":112134,"_2758":112162},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3268":67045,"_28512":67034,"_19817":112164,"_5":13545,"_25978":112134,"_2758":112165},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3268":67046,"_28512":67034,"_19817":112167,"_5":13545,"_25978":112134,"_2758":112168},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3268":67047,"_28512":67034,"_19817":112170,"_5":13545,"_25978":112138,"_2758":112171},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3268":67048,"_28512":67034,"_19817":112173,"_5":13545,"_25978":112138,"_2758":112174},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3268":67049,"_28512":67034,"_19817":112176,"_5":13545,"_25978":112138,"_2758":112177},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3268":67050,"_28512":67034,"_19817":112179,"_5":13545,"_25978":112138,"_2758":112180},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3268":67051,"_28512":67034,"_19817":112182,"_5":13545,"_25978":112142,"_2758":112183},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3268":67052,"_28512":67034,"_19817":112185,"_5":13545,"_25978":112142,"_2758":112186},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3268":67053,"_28512":67034,"_19817":112188,"_5":13545,"_25978":112142,"_2758":112189},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3268":67054,"_28512":67034,"_19817":112191,"_5":13545,"_25978":112142,"_2758":112192},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3268":67055,"_28512":67034,"_19817":112194,"_5":13545,"_25978":112146,"_2758":112195},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3268":67056,"_28512":67034,"_19817":112197,"_5":13545,"_25978":112146,"_2758":112198},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3268":67057,"_28512":67057,"_5":13876,"_2758":112200,"_28855":112201,"_19817":112202,"_25978":67057},"Estrategias de aprovisionamiento",[46447,110303,48848,111309,111484],[],{"_3268":67058,"_28512":67057,"_19817":112204,"_5":13545,"_25978":67057,"_2758":112205},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3268":67059,"_28512":67057,"_5":28852,"_19817":112207,"_25978":112208,"_2758":112209},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3268":67060,"_28512":67057,"_5":28852,"_19817":112211,"_25978":112212,"_2758":112213},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3268":67061,"_28512":67057,"_5":28852,"_19817":112215,"_25978":112216,"_2758":112217},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3268":67062,"_28512":67057,"_5":28852,"_19817":112219,"_25978":112220,"_2758":112221},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3268":67063,"_28512":67057,"_5":28852,"_19817":112223,"_25978":112224,"_2758":112225},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3268":67064,"_28512":67057,"_19817":112227,"_5":13545,"_25978":67057,"_2758":112228},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3268":67065,"_28512":67057,"_19817":112230,"_5":13545,"_25978":112208,"_2758":112231},[],"Recorrido",{"_3268":67066,"_28512":67057,"_19817":112233,"_5":13545,"_25978":112208,"_2758":112234},[],"Cuándo existe el dispositivo",{"_3268":67067,"_28512":67057,"_19817":112236,"_5":13545,"_25978":112208,"_2758":112237},[],"Qué compruebas",{"_3268":67068,"_28512":67057,"_19817":112239,"_5":13545,"_25978":112208,"_2758":112240},[],"Asignación manual",{"_3268":67069,"_28512":67057,"_19817":112242,"_5":13545,"_25978":112208,"_2758":112243},[],"El operador lo crea antes de asociar un certificado.",{"_3268":67070,"_28512":67057,"_19817":112245,"_5":13545,"_25978":112208,"_2758":112246},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3268":67071,"_28512":67057,"_19817":112248,"_5":13545,"_25978":112208,"_2758":112249},[],"EST con `JITP`",{"_3268":67072,"_28512":67057,"_19817":112251,"_5":13545,"_25978":112208,"_2758":112252},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3268":67073,"_28512":67057,"_19817":112254,"_5":13545,"_25978":112208,"_2758":112255},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3268":67074,"_28512":67057,"_19817":112257,"_5":13545,"_25978":112208,"_2758":112258},[],"EST con `PRE_REGISTRATION`",{"_3268":67075,"_28512":67057,"_19817":112260,"_5":13545,"_25978":112208,"_2758":112261},[],"Debe existir antes de `/simpleenroll`.",{"_3268":67076,"_28512":67057,"_19817":112263,"_5":13545,"_25978":112208,"_2758":112264},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3268":67077,"_28512":67057,"_19817":112266,"_5":13545,"_25978":112208,"_2758":112267},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3268":67078,"_28512":67057,"_19817":112269,"_5":13545,"_25978":112208,"_2758":112270},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3268":67079,"_28512":67057,"_19817":112272,"_5":13545,"_25978":112212,"_2758":112273},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3268":67080,"_28512":67057,"_19817":112275,"_5":13545,"_25978":112212,"_2758":112276},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3268":67081,"_28512":67057,"_19817":112278,"_5":13545,"_25978":112212,"_2758":112279},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3268":67082,"_28512":67057,"_19817":112281,"_5":13545,"_25978":112216,"_2758":112282},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3268":67083,"_28512":67057,"_19817":112284,"_5":13545,"_25978":112216,"_2758":112285},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3268":67084,"_28512":67057,"_19817":112287,"_5":13545,"_25978":112216,"_2758":112288},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3268":67085,"_28512":67057,"_19817":112290,"_5":13545,"_25978":112216,"_2758":112291},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3268":67086,"_28512":67057,"_19817":112293,"_5":13545,"_25978":112216,"_2758":112294},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3268":67087,"_28512":67057,"_19817":112296,"_5":13545,"_25978":112216,"_2758":112297},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3268":67088,"_28512":67057,"_19817":112299,"_5":13545,"_25978":112220,"_2758":109320},[],{"_3268":67089,"_28512":67057,"_19817":112301,"_5":13545,"_25978":112220,"_2758":112302},[],"Material que atraviesa EST",{"_3268":67090,"_28512":67057,"_19817":112304,"_5":13545,"_25978":112220,"_2758":112305},[],"Clave generada por el dispositivo",{"_3268":67091,"_28512":67057,"_19817":112307,"_5":13545,"_25978":112220,"_2758":112308},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3268":67092,"_28512":67057,"_19817":112310,"_5":13545,"_25978":112220,"_2758":112311},[],"Clave ya disponible en el dispositivo",{"_3268":67093,"_28512":67057,"_19817":112313,"_5":13545,"_25978":112220,"_2758":112314},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3268":67094,"_28512":67057,"_19817":112316,"_5":13545,"_25978":112220,"_2758":49167},[],{"_3268":67095,"_28512":67057,"_19817":112318,"_5":13545,"_25978":112220,"_2758":112319},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3268":67096,"_28512":67057,"_19817":112321,"_5":13545,"_25978":112220,"_2758":112322},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3268":67097,"_28512":67057,"_19817":112324,"_5":13545,"_25978":112224,"_2758":112325},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3268":67098,"_28512":67098,"_5":13876,"_2758":112327,"_28855":112328,"_19817":112329,"_25978":67098},"Renovación y recuperación",[46447,110303,48848,111309,111484],[],{"_3268":67099,"_28512":67098,"_19817":112331,"_5":13545,"_25978":67098,"_2758":112332},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3268":67100,"_28512":67098,"_5":28852,"_19817":112334,"_25978":112335,"_2758":112336},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3268":67101,"_28512":67098,"_5":28852,"_19817":112338,"_25978":112339,"_2758":112340},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3268":67102,"_28512":67098,"_5":28852,"_19817":112342,"_25978":112343,"_2758":112344},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3268":67103,"_28512":67098,"_5":28852,"_19817":112346,"_25978":112347,"_2758":112348},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3268":67104,"_28512":67098,"_5":28852,"_19817":112350,"_25978":112351,"_2758":112352},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3268":67105,"_28512":67098,"_19817":112354,"_5":13545,"_25978":67098,"_2758":112355},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3268":67106,"_28512":67098,"_19817":112357,"_5":13545,"_25978":112335,"_2758":112358},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3268":67107,"_28512":67098,"_19817":112360,"_5":13545,"_25978":112335,"_2758":112361},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3268":67108,"_28512":67098,"_19817":112363,"_5":13545,"_25978":112335,"_2758":112364},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3268":67109,"_28512":67098,"_19817":112366,"_5":13545,"_25978":112335,"_2758":112367},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3268":67110,"_28512":67098,"_19817":112369,"_5":13545,"_25978":112339,"_2758":112370},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3268":67111,"_28512":67098,"_19817":112372,"_5":13545,"_25978":112339,"_2758":112373},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3268":67112,"_28512":67098,"_19817":112375,"_5":13545,"_25978":112343,"_2758":112376},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3268":67113,"_28512":67098,"_19817":112378,"_5":13545,"_25978":112343,"_2758":112379},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3268":67114,"_28512":67098,"_19817":112381,"_5":13545,"_25978":112343,"_2758":112382},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3268":67115,"_28512":67098,"_19817":112384,"_5":13545,"_25978":112347,"_2758":112385},[],"Situación",{"_3268":67116,"_28512":67098,"_19817":112387,"_5":13545,"_25978":112347,"_2758":112388},[],"Procedimiento",{"_3268":67117,"_28512":67098,"_19817":112390,"_5":13545,"_25978":112347,"_2758":112391},[],"Certificado vigente, fuera de ventana",{"_3268":67118,"_28512":67098,"_19817":112393,"_5":13545,"_25978":112347,"_2758":112394},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3268":67119,"_28512":67098,"_19817":112396,"_5":13545,"_25978":112347,"_2758":112397},[],"Certificado vencido, clave disponible",{"_3268":67120,"_28512":67098,"_19817":112399,"_5":13545,"_25978":112347,"_2758":112400},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3268":67121,"_28512":67098,"_19817":112402,"_5":13545,"_25978":112347,"_2758":112403},[],"Renovación por webhook o `NO_AUTH`",{"_3268":67122,"_28512":67098,"_19817":112405,"_5":13545,"_25978":112347,"_2758":112406},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3268":67123,"_28512":67098,"_19817":112408,"_5":13545,"_25978":112347,"_2758":112409},[],"Clave perdida o inaccesible",{"_3268":67124,"_28512":67098,"_19817":112411,"_5":13545,"_25978":112347,"_2758":112412},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3268":67125,"_28512":67098,"_19817":112414,"_5":13545,"_25978":112347,"_2758":112415},[],"Identidad actual revocada",{"_3268":67126,"_28512":67098,"_19817":112417,"_5":13545,"_25978":112347,"_2758":112418},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3268":67127,"_28512":67098,"_19817":112420,"_5":13545,"_25978":112347,"_2758":112421},[],"Dispositivo sin identidad",{"_3268":67128,"_28512":67098,"_19817":112423,"_5":13545,"_25978":112347,"_2758":112424},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3268":67129,"_28512":67098,"_19817":112426,"_5":13545,"_25978":112347,"_2758":112427},[],"Dispositivo retirado",{"_3268":67130,"_28512":67098,"_19817":112429,"_5":13545,"_25978":112347,"_2758":112430},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3268":67131,"_28512":67098,"_19817":112432,"_5":13545,"_25978":112347,"_2758":112433},[],"Timeout, HTTP 500 o fallo de instalación",{"_3268":67132,"_28512":67098,"_19817":112435,"_5":13545,"_25978":112347,"_2758":112436},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3268":67133,"_28512":67098,"_19817":112438,"_5":13545,"_25978":112351,"_2758":112439},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3268":67134,"_28512":67098,"_19817":112441,"_5":13545,"_25978":112351,"_2758":112442},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3268":67135,"_28512":67135,"_5":13876,"_2758":112444,"_28855":112445,"_19817":112446,"_25978":67135},"Diagnóstico de enrolamiento",[46447,110303,48848,111309,111484],[],{"_3268":67136,"_28512":67135,"_19817":112448,"_5":13545,"_25978":67135,"_2758":112449},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3268":67137,"_28512":67135,"_5":28852,"_19817":112451,"_25978":112452,"_2758":112453},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3268":67138,"_28512":67135,"_5":28852,"_19817":112455,"_25978":112456,"_2758":112457},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3268":67139,"_28512":67135,"_5":28852,"_19817":112459,"_25978":112460,"_2758":112016},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3268":67140,"_28512":67135,"_5":28852,"_19817":112462,"_25978":112463,"_2758":112464},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3268":67141,"_28512":67135,"_19817":112466,"_5":13545,"_25978":67135,"_2758":112467},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3268":67142,"_28512":67135,"_19817":112469,"_5":13545,"_25978":112456,"_2758":112470},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3268":67143,"_28512":67135,"_19817":112472,"_5":13545,"_25978":112456,"_2758":112473},[],"Síntoma o mensaje",{"_3268":67144,"_28512":67135,"_19817":112475,"_5":13545,"_25978":112456,"_2758":112476},[],"Qué revisar",{"_3268":67145,"_28512":67135,"_19817":112478,"_5":13545,"_25978":112456,"_2758":112479},[],"curl rechaza TLS, nombre o emisor",{"_3268":67146,"_28512":67135,"_19817":112481,"_5":13545,"_25978":112456,"_2758":112482},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3268":67147,"_28512":67135,"_19817":112484,"_5":13545,"_25978":112456,"_2758":112485},[],"404 o APS ausente",{"_3268":67148,"_28512":67135,"_19817":112487,"_5":13545,"_25978":112456,"_2758":112488},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3268":67149,"_28512":67135,"_19817":112490,"_5":13545,"_25978":112456,"_2758":112491},[],"400, error de CSR o formato",{"_3268":67150,"_28512":67135,"_19817":112493,"_5":13545,"_25978":112456,"_2758":112494},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3268":67151,"_28512":67135,"_19817":112496,"_5":13545,"_25978":112456,"_2758":112497},[],"Credencial ausente o certificado no válido",{"_3268":67152,"_28512":67135,"_19817":112499,"_5":13545,"_25978":112456,"_2758":112500},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3268":67153,"_28512":67135,"_19817":112502,"_5":13545,"_25978":112456,"_2758":112503},[],"Webhook deniega, expira o responde sin autorización",{"_3268":67154,"_28512":67135,"_19817":112505,"_5":13545,"_25978":112456,"_2758":112506},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3268":67155,"_28512":67135,"_19817":112508,"_5":13545,"_25978":112456,"_2758":50093},[],{"_3268":67156,"_28512":67135,"_19817":112510,"_5":13545,"_25978":112456,"_2758":112511},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3268":67157,"_28512":67135,"_19817":112513,"_5":13545,"_25978":112456,"_2758":50099},[],{"_3268":67158,"_28512":67135,"_19817":112515,"_5":13545,"_25978":112456,"_2758":112516},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3268":67159,"_28512":67135,"_19817":112518,"_5":13545,"_25978":112456,"_2758":50105},[],{"_3268":67160,"_28512":67135,"_19817":112520,"_5":13545,"_25978":112456,"_2758":112521},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3268":67161,"_28512":67135,"_19817":112523,"_5":13545,"_25978":112456,"_2758":50111},[],{"_3268":67162,"_28512":67135,"_19817":112525,"_5":13545,"_25978":112456,"_2758":112526},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3268":67163,"_28512":67135,"_19817":112528,"_5":13545,"_25978":112456,"_2758":50117},[],{"_3268":67164,"_28512":67135,"_19817":112530,"_5":13545,"_25978":112456,"_2758":112531},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3268":67165,"_28512":67135,"_19817":112533,"_5":13545,"_25978":112456,"_2758":112534},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3268":67166,"_28512":67135,"_19817":112536,"_5":13545,"_25978":112456,"_2758":112537},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3268":67167,"_28512":67135,"_19817":112539,"_5":13545,"_25978":112456,"_2758":112540},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3268":67168,"_28512":67135,"_19817":112542,"_5":13545,"_25978":112456,"_2758":112543},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3268":67169,"_28512":67135,"_19817":112545,"_5":13545,"_25978":112456,"_2758":50135},[],{"_3268":67170,"_28512":67135,"_19817":112547,"_5":13545,"_25978":112456,"_2758":112548},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3268":67171,"_28512":67135,"_19817":112550,"_5":13545,"_25978":112456,"_2758":50141},[],{"_3268":67172,"_28512":67135,"_19817":112552,"_5":13545,"_25978":112456,"_2758":112553},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3268":67173,"_28512":67135,"_19817":112555,"_5":13545,"_25978":112456,"_2758":112556},[],"DMS propietario distinto",{"_3268":67174,"_28512":67135,"_19817":112558,"_5":13545,"_25978":112456,"_2758":112559},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3268":67175,"_28512":67135,"_19817":112561,"_5":13545,"_25978":112456,"_2758":50153},[],{"_3268":67176,"_28512":67135,"_19817":112563,"_5":13545,"_25978":112456,"_2758":112564},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3268":67177,"_28512":67135,"_19817":112566,"_5":13545,"_25978":112456,"_2758":50159},[],{"_3268":67178,"_28512":67135,"_19817":112568,"_5":13545,"_25978":112456,"_2758":112569},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3268":67179,"_28512":67135,"_19817":112571,"_5":13545,"_25978":112456,"_2758":112572},[],"Certificado actual revocado",{"_3268":67180,"_28512":67135,"_19817":112574,"_5":13545,"_25978":112456,"_2758":112575},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3268":67181,"_28512":67135,"_19817":112577,"_5":13545,"_25978":112456,"_2758":112578},[],"Error de CA, perfil o firma",{"_3268":67182,"_28512":67135,"_19817":112580,"_5":13545,"_25978":112456,"_2758":112581},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3268":67183,"_28512":67135,"_19817":112583,"_5":13545,"_25978":112456,"_2758":112584},[],"HTTP 200 sin conexión del dispositivo",{"_3268":67184,"_28512":67135,"_19817":112586,"_5":13545,"_25978":112456,"_2758":112587},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3268":67185,"_28512":67135,"_19817":112589,"_5":13545,"_25978":112456,"_2758":112590},[],"Timeout o error después de emitir",{"_3268":67186,"_28512":67135,"_19817":112592,"_5":13545,"_25978":112456,"_2758":112593},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3268":67187,"_28512":67135,"_19817":112595,"_5":13545,"_25978":112460,"_2758":112596},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3268":67188,"_28512":67135,"_19817":112598,"_5":13545,"_25978":112460,"_2758":112599},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3268":67189,"_28512":67135,"_19817":112601,"_5":13545,"_25978":112463,"_2758":112602},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3268":67190,"_28512":67135,"_19817":112604,"_5":13545,"_25978":112463,"_2758":112605},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3268":67191,"_28512":67135,"_19817":112607,"_5":13545,"_25978":112463,"_2758":112608},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3268":67192,"_28512":67135,"_19817":112610,"_5":13545,"_25978":112463,"_2758":112611},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3268":67193,"_28512":67135,"_19817":112613,"_5":13545,"_25978":112463,"_2758":112614},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3268":67194,"_28512":67135,"_19817":112616,"_5":13545,"_25978":112463,"_2758":112617},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3268":67195,"_28512":67135,"_19817":112619,"_5":13545,"_25978":112463,"_2758":112620},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3268":67196,"_28512":67196,"_5":13876,"_2758":112622,"_28855":112623,"_19817":112624,"_25978":67196},"Distribución y actualización de confianza",[46447,110303,48848,111309,111484],[],{"_3268":67197,"_28512":67196,"_19817":112626,"_5":13545,"_25978":67196,"_2758":112627},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3268":67198,"_28512":67196,"_5":28852,"_19817":112629,"_25978":112630,"_2758":112631},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3268":67199,"_28512":67196,"_5":28852,"_19817":112633,"_25978":112634,"_2758":112635},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3268":67200,"_28512":67196,"_5":28852,"_19817":112637,"_25978":112638,"_2758":112639},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3268":67201,"_28512":67196,"_5":28852,"_19817":112641,"_25978":112642,"_2758":112643},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3268":67202,"_28512":67196,"_5":28852,"_19817":112645,"_25978":112646,"_2758":112647},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3268":67203,"_28512":67196,"_19817":112649,"_5":13545,"_25978":67196,"_2758":112650},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3268":67204,"_28512":67196,"_19817":112652,"_5":13545,"_25978":112630,"_2758":112653},[],"Relación",{"_3268":67205,"_28512":67196,"_19817":112655,"_5":13545,"_25978":112630,"_2758":112656},[],"Material que prepara el responsable",{"_3268":67206,"_28512":67196,"_19817":112658,"_5":13545,"_25978":112630,"_2758":112659},[],"Dispositivo → servidor EST",{"_3268":67207,"_28512":67196,"_19817":112661,"_5":13545,"_25978":112630,"_2758":112662},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3268":67208,"_28512":67196,"_19817":112664,"_5":13545,"_25978":112630,"_2758":112665},[],"DMS → solicitante",{"_3268":67209,"_28512":67196,"_19817":112667,"_5":13545,"_25978":112630,"_2758":112668},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3268":67210,"_28512":67196,"_19817":112670,"_5":13545,"_25978":112630,"_2758":112671},[],"Consumidor → dispositivo",{"_3268":67211,"_28512":67196,"_19817":112673,"_5":13545,"_25978":112630,"_2758":112674},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3268":67212,"_28512":67196,"_19817":112676,"_5":13545,"_25978":112630,"_2758":112677},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3268":67213,"_28512":67196,"_19817":112679,"_5":13545,"_25978":112634,"_2758":112680},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3268":67214,"_28512":67196,"_19817":112682,"_5":13545,"_25978":112634,"_2758":112683},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3268":67215,"_28512":67196,"_19817":112685,"_5":13545,"_25978":112638,"_2758":112686},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3268":67216,"_28512":67196,"_19817":112688,"_5":13545,"_25978":112638,"_2758":112689},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3268":67217,"_28512":67196,"_19817":112691,"_5":13545,"_25978":112638,"_2758":112692},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3268":67218,"_28512":67196,"_19817":112694,"_5":13545,"_25978":112638,"_2758":112695},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3268":67219,"_28512":67196,"_19817":112697,"_5":13545,"_25978":112638,"_2758":112698},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3268":67220,"_28512":67196,"_19817":112700,"_5":13545,"_25978":112638,"_2758":112701},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3268":67221,"_28512":67196,"_19817":112703,"_5":13545,"_25978":112642,"_2758":112704},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3268":67222,"_28512":67196,"_19817":112706,"_5":13545,"_25978":112642,"_2758":112707},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3268":67223,"_28512":67196,"_19817":112709,"_5":13545,"_25978":112642,"_2758":112710},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3268":67224,"_28512":67196,"_19817":112712,"_5":13545,"_25978":112646,"_2758":112713},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3268":67225,"_28512":67225,"_5":13876,"_2758":50308,"_28855":112715,"_19817":112717,"_25978":67225},[46447,110303,48848,111309,112716],"Integraciones",[],{"_3268":67226,"_28512":67225,"_19817":112719,"_5":13545,"_25978":67225,"_2758":112720},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3268":67227,"_28512":67225,"_5":28852,"_19817":112722,"_25978":112723,"_2758":112724},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3268":67228,"_28512":67225,"_5":28852,"_19817":112726,"_25978":112727,"_2758":112728},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3268":67229,"_28512":67225,"_5":28852,"_19817":112730,"_25978":112731,"_2758":112732},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3268":67230,"_28512":67225,"_5":28852,"_19817":112734,"_25978":112735,"_2758":112736},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3268":67231,"_28512":67225,"_5":28852,"_19817":112738,"_25978":112739,"_2758":112740},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#máquina-de-estados-de-los-recursos","Máquina de estados de los recursos",{"_3268":67232,"_28512":67225,"_5":28852,"_19817":112742,"_25978":112743,"_2758":112744},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#eventos-que-gestiona-el-conector","Eventos que gestiona el conector",{"_3268":67233,"_28512":67225,"_5":28852,"_19817":112746,"_25978":112747,"_2758":112748},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3268":67234,"_28512":67225,"_5":28852,"_19817":112750,"_25978":112751,"_2758":112752},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3268":67235,"_28512":67225,"_5":28852,"_19817":112754,"_25978":112755,"_2758":112756},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3268":67236,"_28512":67225,"_5":28852,"_19817":112758,"_25978":112759,"_2758":112760},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3268":67237,"_28512":67225,"_5":28852,"_19817":112762,"_25978":112763,"_2758":112764},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3268":67238,"_28512":67225,"_5":28852,"_19817":112766,"_25978":112767,"_2758":112768},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3268":67239,"_28512":67225,"_5":28852,"_19817":112770,"_25978":112771,"_2758":50366},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3268":67240,"_28512":67225,"_5":28852,"_19817":112773,"_25978":112774,"_2758":50370},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3268":67241,"_28512":67225,"_5":28852,"_19817":112776,"_25978":112777,"_2758":112778},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3268":67242,"_28512":67225,"_5":28852,"_19817":112780,"_25978":112781,"_2758":112782},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3268":67243,"_28512":67225,"_5":28852,"_19817":112784,"_25978":112785,"_2758":112786},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3268":67244,"_28512":67225,"_5":28852,"_19817":112788,"_25978":112789,"_2758":112790},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3268":67245,"_28512":67225,"_5":28852,"_19817":112792,"_25978":112793,"_2758":112794},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3268":67246,"_28512":67225,"_5":28852,"_19817":112796,"_25978":112797,"_2758":112798},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3268":67247,"_28512":67225,"_5":28852,"_19817":112800,"_25978":112801,"_2758":112802},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3268":67248,"_28512":67225,"_5":28852,"_19817":112804,"_25978":112805,"_2758":112806},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3268":67249,"_28512":67225,"_19817":112808,"_5":13545,"_25978":67225,"_2758":112809},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3268":67250,"_28512":67225,"_19817":112811,"_5":13545,"_25978":67225,"_2758":112812},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3268":67251,"_28512":67225,"_19817":112814,"_5":13545,"_25978":67225,"_2758":112815},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3268":67252,"_28512":67225,"_19817":112817,"_5":13545,"_25978":112723,"_2758":112818},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3268":67253,"_28512":67225,"_19817":112820,"_5":13545,"_25978":112723,"_2758":112821},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3268":67254,"_28512":67225,"_19817":112823,"_5":13545,"_25978":112723,"_2758":112824},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3268":67255,"_28512":67225,"_19817":112826,"_5":13545,"_25978":112723,"_2758":112827},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3268":67256,"_28512":67225,"_19817":112829,"_5":13545,"_25978":112727,"_2758":112830},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3268":67257,"_28512":67225,"_19817":112832,"_5":13545,"_25978":112731,"_2758":112833},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3268":67258,"_28512":67225,"_19817":112835,"_5":13545,"_25978":112731,"_2758":112836},[],"Acción IAM",{"_3268":67259,"_28512":67225,"_19817":112838,"_5":13545,"_25978":112731,"_2758":109326},[],{"_3268":67260,"_28512":67225,"_19817":112840,"_5":13545,"_25978":112731,"_2758":50453},[],{"_3268":67261,"_28512":67225,"_19817":112842,"_5":13545,"_25978":112731,"_2758":112843},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3268":67262,"_28512":67225,"_19817":112845,"_5":13545,"_25978":112731,"_2758":50459},[],{"_3268":67263,"_28512":67225,"_19817":112847,"_5":13545,"_25978":112731,"_2758":112848},[],"Registrar la CA en AWS IoT",{"_3268":67264,"_28512":67225,"_19817":112850,"_5":13545,"_25978":112731,"_2758":50465},[],{"_3268":67265,"_28512":67225,"_19817":112852,"_5":13545,"_25978":112731,"_2758":112853},[],"Consultar el estado del registro de la CA",{"_3268":67266,"_28512":67225,"_19817":112855,"_5":13545,"_25978":112731,"_2758":50471},[],{"_3268":67267,"_28512":67225,"_19817":112857,"_5":13545,"_25978":112731,"_2758":112858},[],"Crear o actualizar Things en IoT Core",{"_3268":67268,"_28512":67225,"_19817":112860,"_5":13545,"_25978":112731,"_2758":50477},[],{"_3268":67269,"_28512":67225,"_19817":112862,"_5":13545,"_25978":112731,"_2758":112863},[],"Aprovisionar Things mediante plantilla",{"_3268":67270,"_28512":67225,"_19817":112865,"_5":13545,"_25978":112731,"_2758":50483},[],{"_3268":67271,"_28512":67225,"_19817":112867,"_5":13545,"_25978":112731,"_2758":112868},[],"Registrar certificados de dispositivo",{"_3268":67272,"_28512":67225,"_19817":112870,"_5":13545,"_25978":112731,"_2758":50489},[],{"_3268":67273,"_28512":67225,"_19817":112872,"_5":13545,"_25978":112731,"_2758":112873},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3268":67274,"_28512":67225,"_19817":112875,"_5":13545,"_25978":112731,"_2758":50495},[],{"_3268":67275,"_28512":67225,"_19817":112877,"_5":13545,"_25978":112731,"_2758":112878},[],"Crear y adjuntar políticas IoT",{"_3268":67276,"_28512":67225,"_19817":112880,"_5":13545,"_25978":112731,"_2758":50501},[],{"_3268":67277,"_28512":67225,"_19817":112882,"_5":13545,"_25978":112731,"_2758":112883},[],"Gestionar grupos de Things",{"_3268":67278,"_28512":67225,"_19817":112885,"_5":13545,"_25978":112731,"_2758":50507},[],{"_3268":67279,"_28512":67225,"_19817":112887,"_5":13545,"_25978":112731,"_2758":112888},[],"Crear plantillas JITP",{"_3268":67280,"_28512":67225,"_19817":112890,"_5":13545,"_25978":112731,"_2758":50513},[],{"_3268":67281,"_28512":67225,"_19817":112892,"_5":13545,"_25978":112731,"_2758":112893},[],"Leer y escribir el Device Shadow",{"_3268":67282,"_28512":67225,"_19817":112895,"_5":13545,"_25978":112731,"_2758":112896},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3268":67283,"_28512":67225,"_19817":112898,"_5":13545,"_25978":112735,"_2758":112899},[],"Parámetro",{"_3268":67284,"_28512":67225,"_19817":112901,"_5":13545,"_25978":112735,"_2758":112902},[],"Tipo",{"_3268":67285,"_28512":67225,"_19817":112904,"_5":13545,"_25978":112735,"_2758":112905},[],"Requerido",{"_3268":67286,"_28512":67225,"_19817":112907,"_5":13545,"_25978":112735,"_2758":112908},[],"Descripción",{"_3268":67287,"_28512":67225,"_19817":112910,"_5":13545,"_25978":112735,"_2758":50534},[],{"_3268":67288,"_28512":67225,"_19817":112912,"_5":13545,"_25978":112735,"_2758":23674},[],{"_3268":67289,"_28512":67225,"_19817":112914,"_5":13545,"_25978":112735,"_2758":112915},[],"Sí",{"_3268":67290,"_28512":67225,"_19817":112917,"_5":13545,"_25978":112735,"_2758":112918},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3268":67291,"_28512":67225,"_19817":112920,"_5":13545,"_25978":112735,"_2758":50545},[],{"_3268":67292,"_28512":67225,"_19817":112922,"_5":13545,"_25978":112735,"_2758":23674},[],{"_3268":67293,"_28512":67225,"_19817":112924,"_5":13545,"_25978":112735,"_2758":112915},[],{"_3268":67294,"_28512":67225,"_19817":112926,"_5":13545,"_25978":112735,"_2758":112927},[],"Región AWS donde opera el conector.",{"_3268":67295,"_28512":67225,"_19817":112929,"_5":13545,"_25978":112735,"_2758":50555},[],{"_3268":67296,"_28512":67225,"_19817":112931,"_5":13545,"_25978":112735,"_2758":23674},[],{"_3268":67297,"_28512":67225,"_19817":112933,"_5":13545,"_25978":112735,"_2758":112915},[],{"_3268":67298,"_28512":67225,"_19817":112935,"_5":13545,"_25978":112735,"_2758":112936},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3268":67299,"_28512":67225,"_19817":112938,"_5":13545,"_25978":112735,"_2758":50565},[],{"_3268":67300,"_28512":67225,"_19817":112940,"_5":13545,"_25978":112735,"_2758":23674},[],{"_3268":67301,"_28512":67225,"_19817":112942,"_5":13545,"_25978":112735,"_2758":112943},[],"Solo con `auth_method=static`",{"_3268":67302,"_28512":67225,"_19817":112945,"_5":13545,"_25978":112735,"_2758":112946},[],"Clave de acceso AWS.",{"_3268":67303,"_28512":67225,"_19817":112948,"_5":13545,"_25978":112735,"_2758":50576},[],{"_3268":67304,"_28512":67225,"_19817":112950,"_5":13545,"_25978":112735,"_2758":23674},[],{"_3268":67305,"_28512":67225,"_19817":112952,"_5":13545,"_25978":112735,"_2758":112943},[],{"_3268":67306,"_28512":67225,"_19817":112954,"_5":13545,"_25978":112735,"_2758":112955},[],"Clave secreta AWS.",{"_3268":67307,"_28512":67225,"_19817":112957,"_5":13545,"_25978":112735,"_2758":50586},[],{"_3268":67308,"_28512":67225,"_19817":112959,"_5":13545,"_25978":112735,"_2758":23674},[],{"_3268":67309,"_28512":67225,"_19817":112961,"_5":13545,"_25978":112735,"_2758":50591},[],{"_3268":67310,"_28512":67225,"_19817":112963,"_5":13545,"_25978":112735,"_2758":112964},[],"Token de sesión (con `auth_method=static`).",{"_3268":67311,"_28512":67225,"_19817":112966,"_5":13545,"_25978":112735,"_2758":50597},[],{"_3268":67312,"_28512":67225,"_19817":112968,"_5":13545,"_25978":112735,"_2758":23674},[],{"_3268":67313,"_28512":67225,"_19817":112970,"_5":13545,"_25978":112735,"_2758":112971},[],"Solo con `auth_method=role`",{"_3268":67314,"_28512":67225,"_19817":112973,"_5":13545,"_25978":112735,"_2758":112974},[],"ARN del rol a asumir.",{"_3268":67315,"_28512":67225,"_19817":112976,"_5":13545,"_25978":112735,"_2758":50608},[],{"_3268":67316,"_28512":67225,"_19817":112978,"_5":13545,"_25978":112735,"_2758":23674},[],{"_3268":67317,"_28512":67225,"_19817":112980,"_5":13545,"_25978":112735,"_2758":50591},[],{"_3268":67318,"_28512":67225,"_19817":112982,"_5":13545,"_25978":112735,"_2758":112983},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3268":67319,"_28512":67225,"_19817":112985,"_5":13545,"_25978":112735,"_2758":50618},[],{"_3268":67320,"_28512":67225,"_19817":112987,"_5":13545,"_25978":112735,"_2758":16643},[],{"_3268":67321,"_28512":67225,"_19817":112989,"_5":13545,"_25978":112735,"_2758":112915},[],{"_3268":67322,"_28512":67225,"_19817":112991,"_5":13545,"_25978":112735,"_2758":112992},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3268":67323,"_28512":67225,"_19817":112994,"_5":13545,"_25978":112735,"_2758":50628},[],{"_3268":67324,"_28512":67225,"_19817":112996,"_5":13545,"_25978":112735,"_2758":23674},[],{"_3268":67325,"_28512":67225,"_19817":112998,"_5":13545,"_25978":112735,"_2758":112915},[],{"_3268":67326,"_28512":67225,"_19817":113000,"_5":13545,"_25978":112735,"_2758":113001},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3268":67327,"_28512":67225,"_19817":113003,"_5":13545,"_25978":112735,"_2758":50638},[],{"_3268":67328,"_28512":67225,"_19817":113005,"_5":13545,"_25978":112735,"_2758":23674},[],{"_3268":67329,"_28512":67225,"_19817":113007,"_5":13545,"_25978":112735,"_2758":112915},[],{"_3268":67330,"_28512":67225,"_19817":113009,"_5":13545,"_25978":112735,"_2758":113010},[],"URL HTTP del Device Manager de Lamassu.",{"_3268":67331,"_28512":67225,"_19817":113012,"_5":13545,"_25978":112735,"_2758":50648},[],{"_3268":67332,"_28512":67225,"_19817":113014,"_5":13545,"_25978":112735,"_2758":23674},[],{"_3268":67333,"_28512":67225,"_19817":113016,"_5":13545,"_25978":112735,"_2758":112915},[],{"_3268":67334,"_28512":67225,"_19817":113018,"_5":13545,"_25978":112735,"_2758":113019},[],"URL HTTP del servicio de CA de Lamassu.",{"_3268":67335,"_28512":67225,"_19817":113021,"_5":13545,"_25978":112739,"_2758":113022},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada transición. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3268":67336,"_28512":67225,"_19817":113024,"_5":13545,"_25978":112743,"_2758":113025},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3268":67337,"_28512":67225,"_19817":113027,"_5":13545,"_25978":112743,"_2758":113028},[],"Tipo de CloudEvent",{"_3268":67338,"_28512":67225,"_19817":113030,"_5":13545,"_25978":112743,"_2758":113031},[],"Recurso en Lamassu",{"_3268":67339,"_28512":67225,"_19817":113033,"_5":13545,"_25978":112743,"_2758":113034},[],"Recurso AWS",{"_3268":67340,"_28512":67225,"_19817":113036,"_5":13545,"_25978":112743,"_2758":113037},[],"Acciones IAM",{"_3268":67341,"_28512":67225,"_19817":113039,"_5":13545,"_25978":112743,"_2758":113040},[],"Llamadas AWS y efecto",{"_3268":67342,"_28512":67225,"_19817":113042,"_5":13545,"_25978":112743,"_2758":113043},[],"Dónde en esta página",{"_3268":67343,"_28512":67225,"_19817":113045,"_5":13545,"_25978":112743,"_2758":50682},[],{"_3268":67344,"_28512":67225,"_19817":113047,"_5":13545,"_25978":112743,"_2758":50685},[],{"_3268":67345,"_28512":67225,"_19817":113049,"_5":13545,"_25978":112743,"_2758":50688},[],{"_3268":67346,"_28512":67225,"_19817":113051,"_5":13545,"_25978":112743,"_2758":50691},[],{"_3268":67347,"_28512":67225,"_19817":113053,"_5":13545,"_25978":112743,"_2758":113054},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3268":67348,"_28512":67225,"_19817":113056,"_5":13545,"_25978":112743,"_2758":112748},[],{"_3268":67349,"_28512":67225,"_19817":113058,"_5":13545,"_25978":112743,"_2758":50699},[],{"_3268":67350,"_28512":67225,"_19817":113060,"_5":13545,"_25978":112743,"_2758":50702},[],{"_3268":67351,"_28512":67225,"_19817":113062,"_5":13545,"_25978":112743,"_2758":50705},[],{"_3268":67352,"_28512":67225,"_19817":113064,"_5":13545,"_25978":112743,"_2758":50708},[],{"_3268":67353,"_28512":67225,"_19817":113066,"_5":13545,"_25978":112743,"_2758":113067},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3268":67354,"_28512":67225,"_19817":113069,"_5":13545,"_25978":112743,"_2758":112752},[],{"_3268":67355,"_28512":67225,"_19817":113071,"_5":13545,"_25978":112743,"_2758":50716},[],{"_3268":67356,"_28512":67225,"_19817":113073,"_5":13545,"_25978":112743,"_2758":113074},[],"Dispositivo",{"_3268":67357,"_28512":67225,"_19817":113076,"_5":13545,"_25978":112743,"_2758":50722},[],{"_3268":67358,"_28512":67225,"_19817":113078,"_5":13545,"_25978":112743,"_2758":50725},[],{"_3268":67359,"_28512":67225,"_19817":113080,"_5":13545,"_25978":112743,"_2758":113081},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3268":67360,"_28512":67225,"_19817":113083,"_5":13545,"_25978":112743,"_2758":112760},[],{"_3268":67361,"_28512":67225,"_19817":113085,"_5":13545,"_25978":112743,"_2758":50733},[],{"_3268":67362,"_28512":67225,"_19817":113087,"_5":13545,"_25978":112743,"_2758":113088},[],"Certificado",{"_3268":67363,"_28512":67225,"_19817":113090,"_5":13545,"_25978":112743,"_2758":50739},[],{"_3268":67364,"_28512":67225,"_19817":113092,"_5":13545,"_25978":112743,"_2758":113093},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3268":67365,"_28512":67225,"_19817":113095,"_5":13545,"_25978":112743,"_2758":113096},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3268":67366,"_28512":67225,"_19817":113098,"_5":13545,"_25978":112743,"_2758":112756},[],{"_3268":67367,"_28512":67225,"_19817":113100,"_5":13545,"_25978":112743,"_2758":50750},[],{"_3268":67368,"_28512":67225,"_19817":113102,"_5":13545,"_25978":112743,"_2758":113103},[],"Certificado / Dispositivo",{"_3268":67369,"_28512":67225,"_19817":113105,"_5":13545,"_25978":112743,"_2758":50756},[],{"_3268":67370,"_28512":67225,"_19817":113107,"_5":13545,"_25978":112743,"_2758":46843},[],{"_3268":67371,"_28512":67225,"_19817":113109,"_5":13545,"_25978":112743,"_2758":113110},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3268":67372,"_28512":67225,"_19817":113112,"_5":13545,"_25978":112743,"_2758":112794},[],{"_3268":67373,"_28512":67225,"_19817":113114,"_5":13545,"_25978":112747,"_2758":113115},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3268":67374,"_28512":67225,"_19817":113117,"_5":13545,"_25978":112747,"_2758":113118},[],"por el campo `registration.status` de los metadatos del conector en la CA:",{"_3268":67375,"_28512":67225,"_19817":113120,"_5":13545,"_25978":112747,"_2758":113121},[],"Transición",{"_3268":67376,"_28512":67225,"_19817":113123,"_5":13545,"_25978":112747,"_2758":113124},[],"Llamadas AWS",{"_3268":67377,"_28512":67225,"_19817":113126,"_5":13545,"_25978":112747,"_2758":113127},[],"`NoRegistrada` → `Solicitada`",{"_3268":67378,"_28512":67225,"_19817":113129,"_5":13545,"_25978":112747,"_2758":113130},[],"ninguna (solo escritura de metadatos)",{"_3268":67379,"_28512":67225,"_19817":113132,"_5":13545,"_25978":112747,"_2758":113133},[],"`Solicitada` → `Registrando`",{"_3268":67380,"_28512":67225,"_19817":113135,"_5":13545,"_25978":112747,"_2758":113136},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3268":67381,"_28512":67225,"_19817":113138,"_5":13545,"_25978":112747,"_2758":113139},[],"`Registrando` → `Completada`",{"_3268":67382,"_28512":67225,"_19817":113141,"_5":13545,"_25978":112747,"_2758":113142},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3268":67383,"_28512":67225,"_19817":113144,"_5":13545,"_25978":112747,"_2758":113145},[],"`Registrando` → `Fallida`",{"_3268":67384,"_28512":67225,"_19817":113147,"_5":13545,"_25978":112747,"_2758":113148},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3268":67385,"_28512":67225,"_19817":113150,"_5":13545,"_25978":112747,"_2758":113151},[],"`Fallida` / `Completada` → `Solicitada`",{"_3268":67386,"_28512":67225,"_19817":113153,"_5":13545,"_25978":112747,"_2758":113154},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3268":67387,"_28512":67225,"_19817":113156,"_5":13545,"_25978":112751,"_2758":113157},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3268":67388,"_28512":67225,"_19817":113159,"_5":13545,"_25978":112751,"_2758":113121},[],{"_3268":67389,"_28512":67225,"_19817":113161,"_5":13545,"_25978":112751,"_2758":113124},[],{"_3268":67390,"_28512":67225,"_19817":113163,"_5":13545,"_25978":112751,"_2758":113164},[],"`SinConfigurar` → `None` / `Auto`",{"_3268":67391,"_28512":67225,"_19817":113166,"_5":13545,"_25978":112751,"_2758":113167},[],"ninguna (solo configuración)",{"_3268":67392,"_28512":67225,"_19817":113169,"_5":13545,"_25978":112751,"_2758":50821},[],{"_3268":67393,"_28512":67225,"_19817":113171,"_5":13545,"_25978":112751,"_2758":113167},[],{"_3268":67394,"_28512":67225,"_19817":113173,"_5":13545,"_25978":112751,"_2758":113174},[],"Cualquiera → `Jitp`",{"_3268":67395,"_28512":67225,"_19817":113176,"_5":13545,"_25978":112751,"_2758":113177},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3268":67396,"_28512":67225,"_19817":113179,"_5":13545,"_25978":112751,"_2758":50832},[],{"_3268":67397,"_28512":67225,"_19817":113181,"_5":13545,"_25978":112751,"_2758":113182},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3268":67398,"_28512":67225,"_19817":113184,"_5":13545,"_25978":112755,"_2758":113185},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3268":67399,"_28512":67225,"_19817":113187,"_5":13545,"_25978":112755,"_2758":113121},[],{"_3268":67400,"_28512":67225,"_19817":113189,"_5":13545,"_25978":112755,"_2758":113124},[],{"_3268":67401,"_28512":67225,"_19817":113191,"_5":13545,"_25978":112755,"_2758":113192},[],"`NoSincronizado` → `Active`",{"_3268":67402,"_28512":67225,"_19817":113194,"_5":13545,"_25978":112755,"_2758":50489},[],{"_3268":67403,"_28512":67225,"_19817":113196,"_5":13545,"_25978":112755,"_2758":50850},[],{"_3268":67404,"_28512":67225,"_19817":113198,"_5":13545,"_25978":112755,"_2758":113199},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3268":67405,"_28512":67225,"_19817":113201,"_5":13545,"_25978":112755,"_2758":50856},[],{"_3268":67406,"_28512":67225,"_19817":113203,"_5":13545,"_25978":112755,"_2758":113199},[],{"_3268":67407,"_28512":67225,"_19817":113205,"_5":13545,"_25978":112755,"_2758":50861},[],{"_3268":67408,"_28512":67225,"_19817":113207,"_5":13545,"_25978":112755,"_2758":50489},[],{"_3268":67409,"_28512":67225,"_19817":113209,"_5":13545,"_25978":112755,"_2758":50866},[],{"_3268":67410,"_28512":67225,"_19817":113211,"_5":13545,"_25978":112755,"_2758":113212},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3268":67411,"_28512":67225,"_19817":113214,"_5":13545,"_25978":112759,"_2758":113215},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3268":67412,"_28512":67225,"_19817":113217,"_5":13545,"_25978":112759,"_2758":113121},[],{"_3268":67413,"_28512":67225,"_19817":113219,"_5":13545,"_25978":112759,"_2758":113124},[],{"_3268":67414,"_28512":67225,"_19817":113221,"_5":13545,"_25978":112759,"_2758":113222},[],"`Ausente` → `Aprovisionado`",{"_3268":67415,"_28512":67225,"_19817":113224,"_5":13545,"_25978":112759,"_2758":113225},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3268":67416,"_28512":67225,"_19817":113227,"_5":13545,"_25978":112759,"_2758":113228},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3268":67417,"_28512":67225,"_19817":113230,"_5":13545,"_25978":112759,"_2758":113231},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3268":67418,"_28512":67225,"_19817":113233,"_5":13545,"_25978":112759,"_2758":113234},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3268":67419,"_28512":67225,"_19817":113236,"_5":13545,"_25978":112763,"_2758":113237},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3268":67420,"_28512":67225,"_19817":113239,"_5":13545,"_25978":112767,"_2758":113240},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3268":67421,"_28512":67225,"_19817":113242,"_5":13545,"_25978":112767,"_2758":113243},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3268":67422,"_28512":67225,"_19817":113245,"_5":13545,"_25978":112771,"_2758":113246},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3268":67423,"_28512":67225,"_19817":113248,"_5":13545,"_25978":112771,"_2758":113249},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3268":67424,"_28512":67225,"_19817":113251,"_5":13545,"_25978":112771,"_2758":113252},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3268":67425,"_28512":67225,"_19817":113254,"_5":13545,"_25978":112771,"_2758":113255},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3268":67426,"_28512":67225,"_19817":113257,"_5":13545,"_25978":112771,"_2758":113258},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3268":67427,"_28512":67225,"_19817":113260,"_5":13545,"_25978":112771,"_2758":113261},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3268":67428,"_28512":67225,"_19817":113263,"_5":13545,"_25978":112774,"_2758":113264},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3268":67429,"_28512":67225,"_19817":113266,"_5":13545,"_25978":112777,"_2758":113267},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3268":67430,"_28512":67225,"_19817":113269,"_5":13545,"_25978":112777,"_2758":113270},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3268":67431,"_28512":67225,"_19817":113272,"_5":13545,"_25978":112777,"_2758":113273},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3268":67432,"_28512":67225,"_19817":113275,"_5":13545,"_25978":112781,"_2758":113276},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3268":67433,"_28512":67225,"_19817":113278,"_5":13545,"_25978":112781,"_2758":113279},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3268":67434,"_28512":67225,"_19817":113281,"_5":13545,"_25978":112781,"_2758":113282},[],"Para que el flujo JITP funcione correctamente:",{"_3268":67435,"_28512":67225,"_19817":113284,"_5":13545,"_25978":112781,"_2758":113285},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3268":67436,"_28512":67225,"_19817":113287,"_5":13545,"_25978":112781,"_2758":113288},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3268":67437,"_28512":67225,"_19817":113290,"_5":13545,"_25978":112781,"_2758":113291},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3268":67438,"_28512":67225,"_19817":113293,"_5":13545,"_25978":112781,"_2758":113294},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3268":67439,"_28512":67225,"_19817":113296,"_5":13545,"_25978":112785,"_2758":113297},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3268":67440,"_28512":67225,"_19817":113299,"_5":13545,"_25978":112785,"_2758":113300},[],"Estado en Lamassu",{"_3268":67441,"_28512":67225,"_19817":113302,"_5":13545,"_25978":112785,"_2758":113303},[],"Razón de revocación",{"_3268":67442,"_28512":67225,"_19817":113305,"_5":13545,"_25978":112785,"_2758":113306},[],"Estado en AWS IoT Core",{"_3268":67443,"_28512":67225,"_19817":113308,"_5":13545,"_25978":112785,"_2758":51005},[],{"_3268":67444,"_28512":67225,"_19817":113310,"_5":13545,"_25978":112785,"_2758":113311},[],"Ninguna",{"_3268":67445,"_28512":67225,"_19817":113313,"_5":13545,"_25978":112785,"_2758":51011},[],{"_3268":67446,"_28512":67225,"_19817":113315,"_5":13545,"_25978":112785,"_2758":51014},[],{"_3268":67447,"_28512":67225,"_19817":113317,"_5":13545,"_25978":112785,"_2758":51017},[],{"_3268":67448,"_28512":67225,"_19817":113319,"_5":13545,"_25978":112785,"_2758":51020},[],{"_3268":67449,"_28512":67225,"_19817":113321,"_5":13545,"_25978":112785,"_2758":51014},[],{"_3268":67450,"_28512":67225,"_19817":113323,"_5":13545,"_25978":112785,"_2758":113324},[],"Cualquier otra razón",{"_3268":67451,"_28512":67225,"_19817":113326,"_5":13545,"_25978":112785,"_2758":51028},[],{"_3268":67452,"_28512":67225,"_19817":113328,"_5":13545,"_25978":112785,"_2758":113329},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3268":67453,"_28512":67225,"_19817":113331,"_5":13545,"_25978":112789,"_2758":113332},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3268":67454,"_28512":67225,"_19817":113334,"_5":13545,"_25978":112789,"_2758":113335},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3268":67455,"_28512":67225,"_19817":113337,"_5":13545,"_25978":112789,"_2758":113338},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3268":67456,"_28512":67225,"_19817":113340,"_5":13545,"_25978":112793,"_2758":113341},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3268":67457,"_28512":67225,"_19817":113343,"_5":13545,"_25978":112793,"_2758":113344},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3268":67458,"_28512":67225,"_19817":113346,"_5":13545,"_25978":112797,"_2758":113347},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3268":67459,"_28512":67225,"_19817":113349,"_5":13545,"_25978":112797,"_2758":113350},[],"Existen dos tipos de acciones:",{"_3268":67460,"_28512":67225,"_19817":113352,"_5":13545,"_25978":112797,"_2758":113353},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3268":67461,"_28512":67225,"_19817":113355,"_5":13545,"_25978":112797,"_2758":113356},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3268":67462,"_28512":67225,"_19817":113358,"_5":13545,"_25978":112797,"_2758":113359},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3268":67463,"_28512":67225,"_19817":113361,"_5":13545,"_25978":112801,"_2758":113362},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3268":67464,"_28512":67225,"_19817":113364,"_5":13545,"_25978":112801,"_2758":113365},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3268":67465,"_28512":67225,"_19817":113367,"_5":13545,"_25978":112801,"_2758":113368},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3268":67466,"_28512":67225,"_19817":113370,"_5":13545,"_25978":112805,"_2758":113371},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3268":67467,"_28512":67225,"_19817":113373,"_5":13545,"_25978":112805,"_2758":113374},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3268":67468,"_28512":67225,"_19817":113376,"_5":13545,"_25978":112805,"_2758":113377},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3268":67469,"_28512":67225,"_19817":113379,"_5":13545,"_25978":112805,"_2758":113380},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3268":67470,"_28512":67225,"_19817":113382,"_5":13545,"_25978":112805,"_2758":113383},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3268":67471,"_28512":67225,"_19817":113385,"_5":13545,"_25978":112805,"_2758":113386},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3268":67472,"_28512":67225,"_19817":113388,"_5":13545,"_25978":112805,"_2758":113389},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3268":67473,"_28512":67225,"_19817":113391,"_5":13545,"_25978":112805,"_2758":113392},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3268":67474,"_28512":67225,"_19817":113394,"_5":13545,"_25978":112805,"_2758":113395},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3268":67475,"_28512":67225,"_19817":113397,"_5":13545,"_25978":112805,"_2758":113398},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3268":67476,"_28512":67225,"_19817":113400,"_5":13545,"_25978":112805,"_2758":113401},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3268":67477,"_28512":67225,"_19817":113403,"_5":13545,"_25978":112805,"_2758":113404},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3268":67478,"_28512":67225,"_19817":113406,"_5":13545,"_25978":112805,"_2758":113407},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3268":67479,"_28512":67225,"_19817":113409,"_5":13545,"_25978":112805,"_2758":113410},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3268":67480,"_28512":67225,"_19817":113412,"_5":13545,"_25978":112805,"_2758":113413},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3268":67481,"_28512":67225,"_19817":113415,"_5":13545,"_25978":112805,"_2758":113416},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3268":67482,"_28512":67225,"_19817":113418,"_5":13545,"_25978":112805,"_2758":113419},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3268":67483,"_28512":67225,"_19817":113421,"_5":13545,"_25978":112805,"_2758":113422},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3268":67484,"_28512":67225,"_19817":113424,"_5":13545,"_25978":112805,"_2758":113425},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en la cola de mensajes fallidos `lamassu-dlq`.",{"_3268":67485,"_28512":67225,"_19817":113427,"_5":13545,"_25978":112805,"_2758":113428},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`.",{"_3268":67486,"_28512":67225,"_19817":113430,"_5":13545,"_25978":112805,"_2758":113431},[],"**Resolución:** Verificar que la plantilla nombrada con el ID del DMS sigue existiendo en AWS IoT Core y que el enrolamiento JITP funciona. El mensaje de `lamassu-dlq` refleja el intento de recreación fallido, no un flujo JITP roto.",{"_3268":67487,"_28512":67225,"_19817":113433,"_5":13545,"_25978":112805,"_2758":113434},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3268":67488,"_28512":67225,"_19817":113436,"_5":13545,"_25978":112805,"_2758":113437},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3268":67489,"_28512":67225,"_19817":113439,"_5":13545,"_25978":112805,"_2758":113440},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3268":67490,"_28512":67490,"_5":13876,"_2758":48848,"_28855":113442,"_19817":113443,"_25978":67490},[46447,110303,48848],[],{"_3268":67491,"_28512":67490,"_19817":113445,"_5":13545,"_25978":67490,"_2758":113446},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3268":67492,"_28512":67490,"_5":28852,"_19817":113448,"_25978":113449,"_2758":113450},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3268":67493,"_28512":67490,"_5":28852,"_19817":113452,"_25978":113453,"_2758":111309},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3268":67494,"_28512":67490,"_5":28852,"_19817":113455,"_25978":113456,"_2758":111484},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3268":67495,"_28512":67490,"_5":28852,"_19817":113458,"_25978":113459,"_2758":112716},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/overview#integraciones",{"_3268":67496,"_28512":67490,"_5":28852,"_19817":113461,"_25978":113462,"_2758":113463},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3268":67497,"_28512":67490,"_19817":113465,"_5":13545,"_25978":67490,"_2758":113466},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3268":67498,"_28512":67490,"_19817":113468,"_5":13545,"_25978":113449,"_2758":113469},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3268":67499,"_28512":67490,"_19817":113471,"_5":13545,"_25978":113449,"_2758":113472},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3268":67500,"_28512":67490,"_19817":113474,"_5":13545,"_25978":113453,"_2758":113475},[],"Recurso",{"_3268":67501,"_28512":67490,"_19817":113477,"_5":13545,"_25978":113453,"_2758":113478},[],"Qué representa",{"_3268":67502,"_28512":67490,"_19817":113480,"_5":13545,"_25978":113453,"_2758":113481},[],"**Dispositivo**",{"_3268":67503,"_28512":67490,"_19817":113483,"_5":13545,"_25978":113453,"_2758":113484},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3268":67504,"_28512":67490,"_19817":113486,"_5":13545,"_25978":113453,"_2758":113487},[],"**Identidad**",{"_3268":67505,"_28512":67490,"_19817":113489,"_5":13545,"_25978":113453,"_2758":113490},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3268":67506,"_28512":67490,"_19817":113492,"_5":13545,"_25978":113453,"_2758":51195},[],{"_3268":67507,"_28512":67490,"_19817":113494,"_5":13545,"_25978":113453,"_2758":113495},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3268":67508,"_28512":67490,"_19817":113497,"_5":13545,"_25978":113453,"_2758":113498},[],"**Flota**",{"_3268":67509,"_28512":67490,"_19817":113500,"_5":13545,"_25978":113453,"_2758":113501},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3268":67510,"_28512":67490,"_19817":113503,"_5":13545,"_25978":113453,"_2758":113504},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3268":67511,"_28512":67490,"_19817":113506,"_5":13545,"_25978":113453,"_2758":113507},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3268":67512,"_28512":67490,"_19817":113509,"_5":13545,"_25978":113456,"_2758":113510},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3268":67513,"_28512":67490,"_19817":113512,"_5":13545,"_25978":113456,"_2758":113513},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3268":67514,"_28512":67490,"_19817":113515,"_5":13545,"_25978":113456,"_2758":113516},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3268":67515,"_28512":67490,"_19817":113518,"_5":13545,"_25978":113456,"_2758":113519},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3268":67516,"_28512":67490,"_19817":113521,"_5":13545,"_25978":113456,"_2758":113522},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3268":67517,"_28512":67490,"_19817":113524,"_5":13545,"_25978":113456,"_2758":113525},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3268":67518,"_28512":67490,"_19817":113527,"_5":13545,"_25978":113456,"_2758":113528},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3268":67519,"_28512":67490,"_19817":113530,"_5":13545,"_25978":113456,"_2758":113531},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3268":67520,"_28512":67490,"_19817":113533,"_5":13545,"_25978":113459,"_2758":113534},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3268":67521,"_28512":67490,"_19817":113536,"_5":13545,"_25978":113459,"_2758":113537},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3268":67522,"_28512":67490,"_19817":113539,"_5":13545,"_25978":113462,"_2758":113540},[],"Participante",{"_3268":67523,"_28512":67490,"_19817":113542,"_5":13545,"_25978":113462,"_2758":113543},[],"Responsabilidad",{"_3268":67524,"_28512":67490,"_19817":113545,"_5":13545,"_25978":113462,"_2758":113546},[],"Administrador PKI",{"_3268":67525,"_28512":67490,"_19817":113548,"_5":13545,"_25978":113462,"_2758":113549},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3268":67526,"_28512":67490,"_19817":113551,"_5":13545,"_25978":113462,"_2758":113552},[],"Administrador del aprovisionamiento",{"_3268":67527,"_28512":67490,"_19817":113554,"_5":13545,"_25978":113462,"_2758":113555},[],"DMS, admisión, autenticación por operación e inventario.",{"_3268":67528,"_28512":67490,"_19817":113557,"_5":13545,"_25978":113462,"_2758":113558},[],"Integrador del dispositivo",{"_3268":67529,"_28512":67490,"_19817":113560,"_5":13545,"_25978":113462,"_2758":113561},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3268":67530,"_28512":67490,"_19817":113563,"_5":13545,"_25978":113462,"_2758":113564},[],"Integrador del consumidor",{"_3268":67531,"_28512":67490,"_19817":113566,"_5":13545,"_25978":113462,"_2758":113567},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3268":67532,"_28512":67490,"_19817":113569,"_5":13545,"_25978":113462,"_2758":113570},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3268":67533,"_28512":67533,"_5":13876,"_2758":113572,"_28855":113573,"_19817":113575,"_25978":67533},"Enrola y conecta tu primer dispositivo",[46447,110303,48848,113574],"Primeros pasos",[],{"_3268":67534,"_28512":67533,"_19817":113577,"_5":13545,"_25978":67533,"_2758":113578},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3268":67535,"_28512":67533,"_5":28852,"_19817":113580,"_25978":113581,"_2758":108956},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3268":67536,"_28512":67533,"_5":28852,"_19817":113583,"_25978":113584,"_2758":113585},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3268":67537,"_28512":67533,"_5":28852,"_19817":113587,"_25978":113588,"_2758":113589},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3268":67538,"_28512":67533,"_5":28852,"_19817":113591,"_25978":113592,"_2758":113593},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3268":67539,"_28512":67533,"_5":28852,"_19817":113595,"_25978":113596,"_2758":113597},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3268":67540,"_28512":67533,"_5":28852,"_19817":113599,"_25978":113600,"_2758":113601},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3268":67541,"_28512":67533,"_5":28852,"_19817":113603,"_25978":113604,"_2758":113605},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3268":67542,"_28512":67533,"_5":28852,"_19817":113607,"_25978":113608,"_2758":113609},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3268":67543,"_28512":67533,"_19817":113611,"_5":13545,"_25978":67533,"_2758":113612},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3268":67544,"_28512":67533,"_19817":113614,"_5":13545,"_25978":113581,"_2758":113615},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3268":67545,"_28512":67533,"_19817":113617,"_5":13545,"_25978":113581,"_2758":113618},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3268":67546,"_28512":67533,"_19817":113620,"_5":13545,"_25978":113581,"_2758":113621},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3268":67547,"_28512":67533,"_19817":113623,"_5":13545,"_25978":113581,"_2758":113624},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3268":67548,"_28512":67533,"_19817":113626,"_5":13545,"_25978":113581,"_2758":113627},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3268":67549,"_28512":67533,"_19817":113629,"_5":13545,"_25978":113584,"_2758":113630},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3268":67550,"_28512":67533,"_19817":113632,"_5":13545,"_25978":113584,"_2758":113633},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3268":67551,"_28512":67533,"_19817":113635,"_5":13545,"_25978":113588,"_2758":113636},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3268":67552,"_28512":67533,"_19817":113638,"_5":13545,"_25978":113588,"_2758":113639},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3268":67553,"_28512":67533,"_19817":113641,"_5":13545,"_25978":113588,"_2758":113642},[],"Ajuste",{"_3268":67554,"_28512":67533,"_19817":113644,"_5":13545,"_25978":113588,"_2758":113645},[],"Valor de evaluación",{"_3268":67555,"_28512":67533,"_19817":113647,"_5":13545,"_25978":113588,"_2758":51351},[],{"_3268":67556,"_28512":67533,"_19817":113649,"_5":13545,"_25978":113588,"_2758":113650},[],"Raíz emisora de `device-root.pem`.",{"_3268":67557,"_28512":67533,"_19817":113652,"_5":13545,"_25978":113588,"_2758":111612},[],{"_3268":67558,"_28512":67533,"_19817":113654,"_5":13545,"_25978":113588,"_2758":113655},[],"Perfil final de 1 hora que acabas de preparar.",{"_3268":67559,"_28512":67533,"_19817":113657,"_5":13545,"_25978":113588,"_2758":51362},[],{"_3268":67560,"_28512":67533,"_19817":113659,"_5":13545,"_25978":113588,"_2758":51365},[],{"_3268":67561,"_28512":67533,"_19817":113661,"_5":13545,"_25978":113588,"_2758":51368},[],{"_3268":67562,"_28512":67533,"_19817":113663,"_5":13545,"_25978":113588,"_2758":113664},[],"Habilitado.",{"_3268":67563,"_28512":67533,"_19817":113666,"_5":13545,"_25978":113588,"_2758":51374},[],{"_3268":67564,"_28512":67533,"_19817":113668,"_5":13545,"_25978":113588,"_2758":113669},[],"Deshabilitado; el ID debe ser nuevo.",{"_3268":67565,"_28512":67533,"_19817":113671,"_5":13545,"_25978":113588,"_2758":113672},[],"Autenticación inicial",{"_3268":67566,"_28512":67533,"_19817":113674,"_5":13545,"_25978":113588,"_2758":113675},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3268":67567,"_28512":67533,"_19817":113677,"_5":13545,"_25978":113588,"_2758":113678},[],"Autenticación de renovación",{"_3268":67568,"_28512":67533,"_19817":113680,"_5":13545,"_25978":113588,"_2758":113681},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3268":67569,"_28512":67533,"_19817":113683,"_5":13545,"_25978":113588,"_2758":51392},[],{"_3268":67570,"_28512":67533,"_19817":113685,"_5":13545,"_25978":113588,"_2758":113686},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3268":67571,"_28512":67533,"_19817":113688,"_5":13545,"_25978":113588,"_2758":51398},[],{"_3268":67572,"_28512":67533,"_19817":113690,"_5":13545,"_25978":113588,"_2758":113691},[],"1 hora.",{"_3268":67573,"_28512":67533,"_19817":113693,"_5":13545,"_25978":113588,"_2758":51404},[],{"_3268":67574,"_28512":67533,"_19817":113695,"_5":13545,"_25978":113588,"_2758":113696},[],"30 minutos / 10 minutos.",{"_3268":67575,"_28512":67533,"_19817":113698,"_5":13545,"_25978":113588,"_2758":51410},[],{"_3268":67576,"_28512":67533,"_19817":113700,"_5":13545,"_25978":113588,"_2758":113701},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3268":67577,"_28512":67533,"_19817":113703,"_5":13545,"_25978":113588,"_2758":49167},[],{"_3268":67578,"_28512":67533,"_19817":113705,"_5":13545,"_25978":113588,"_2758":113706},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3268":67579,"_28512":67533,"_19817":113708,"_5":13545,"_25978":113588,"_2758":51421},[],{"_3268":67580,"_28512":67533,"_19817":113710,"_5":13545,"_25978":113588,"_2758":113711},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3268":67581,"_28512":67533,"_19817":113713,"_5":13545,"_25978":113588,"_2758":113714},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3268":67582,"_28512":67533,"_19817":113716,"_5":13545,"_25978":113592,"_2758":113717},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3268":67583,"_28512":67533,"_19817":113719,"_5":13545,"_25978":113592,"_2758":113720},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3268":67584,"_28512":67533,"_19817":113722,"_5":13545,"_25978":113596,"_2758":113723},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3268":67585,"_28512":67533,"_19817":113725,"_5":13545,"_25978":113596,"_2758":113726},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3268":67586,"_28512":67533,"_19817":113728,"_5":13545,"_25978":113596,"_2758":113729},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3268":67587,"_28512":67533,"_19817":113731,"_5":13545,"_25978":113600,"_2758":113732},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3268":67588,"_28512":67533,"_19817":113734,"_5":13545,"_25978":113600,"_2758":113735},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3268":67589,"_28512":67533,"_19817":113737,"_5":13545,"_25978":113604,"_2758":113738},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3268":67590,"_28512":67533,"_19817":113740,"_5":13545,"_25978":113604,"_2758":113741},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3268":67591,"_28512":67533,"_19817":113743,"_5":13545,"_25978":113604,"_2758":113744},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3268":67592,"_28512":67533,"_19817":113746,"_5":13545,"_25978":113604,"_2758":113747},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3268":67593,"_28512":67533,"_19817":113749,"_5":13545,"_25978":113604,"_2758":113750},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3268":67594,"_28512":67533,"_19817":113752,"_5":13545,"_25978":113608,"_2758":113753},[],"Comprobación",{"_3268":67595,"_28512":67533,"_19817":113755,"_5":13545,"_25978":113608,"_2758":113756},[],"Resultado esperado",{"_3268":67596,"_28512":67533,"_19817":113758,"_5":13545,"_25978":113608,"_2758":113759},[],"Registro",{"_3268":67597,"_28512":67533,"_19817":113761,"_5":13545,"_25978":113608,"_2758":113762},[],"ID creado automáticamente y DMS correcto.",{"_3268":67598,"_28512":67533,"_19817":113764,"_5":13545,"_25978":113608,"_2758":113088},[],{"_3268":67599,"_28512":67533,"_19817":113766,"_5":13545,"_25978":113608,"_2758":113767},[],"CN, perfil, serie y clave verificados.",{"_3268":67600,"_28512":67533,"_19817":113769,"_5":13545,"_25978":113608,"_2758":113770},[],"Inventario",{"_3268":67601,"_28512":67533,"_19817":113772,"_5":13545,"_25978":113608,"_2758":113773},[],"Serie recibida visible como identidad actual y en el historial.",{"_3268":67602,"_28512":67533,"_19817":113775,"_5":13545,"_25978":113608,"_2758":113776},[],"Consumidor",{"_3268":67603,"_28512":67533,"_19817":113778,"_5":13545,"_25978":113608,"_2758":113779},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3268":67604,"_28512":67533,"_19817":113781,"_5":13545,"_25978":113608,"_2758":113782},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3268":67605,"_28512":67533,"_19817":113784,"_5":13545,"_25978":113608,"_2758":113785},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3268":67606,"_28512":67606,"_5":13876,"_2758":111326,"_28855":113787,"_19817":113788,"_25978":67606},[46447,110303,48848,113574],[],{"_3268":67607,"_28512":67606,"_19817":113790,"_5":13545,"_25978":67606,"_2758":113791},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3268":67608,"_28512":67606,"_5":28852,"_19817":113793,"_25978":113794,"_2758":108956},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3268":67609,"_28512":67606,"_5":28852,"_19817":113796,"_25978":113797,"_2758":113798},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3268":67610,"_28512":67606,"_5":28852,"_19817":113800,"_25978":113801,"_2758":113802},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3268":67611,"_28512":67606,"_5":28852,"_19817":113804,"_25978":113805,"_2758":113806},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3268":67612,"_28512":67606,"_5":28852,"_19817":113808,"_25978":113809,"_2758":113810},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3268":67613,"_28512":67606,"_5":28852,"_19817":113812,"_25978":113813,"_2758":113814},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3268":67614,"_28512":67606,"_5":28852,"_19817":113816,"_25978":113817,"_2758":113756},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3268":67615,"_28512":67606,"_5":28852,"_19817":113819,"_25978":113820,"_2758":113821},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3268":67616,"_28512":67606,"_5":28852,"_19817":113823,"_25978":113824,"_2758":113825},[],"/docs/pr-preview/pr-43/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3268":67617,"_28512":67606,"_19817":113827,"_5":13545,"_25978":67606,"_2758":113828},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3268":67618,"_28512":67606,"_19817":113830,"_5":13545,"_25978":67606,"_2758":113831},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3268":67619,"_28512":67606,"_19817":113833,"_5":13545,"_25978":113794,"_2758":113834},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3268":67620,"_28512":67606,"_19817":113836,"_5":13545,"_25978":113794,"_2758":113837},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3268":67621,"_28512":67606,"_19817":113839,"_5":13545,"_25978":113794,"_2758":113840},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3268":67622,"_28512":67606,"_19817":113842,"_5":13545,"_25978":113794,"_2758":113843},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3268":67623,"_28512":67606,"_19817":113845,"_5":13545,"_25978":113797,"_2758":113846},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3268":67624,"_28512":67606,"_19817":113848,"_5":13545,"_25978":113797,"_2758":113849},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3268":67625,"_28512":67606,"_19817":113851,"_5":13545,"_25978":113797,"_2758":113852},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3268":67626,"_28512":67606,"_19817":113854,"_5":13545,"_25978":113797,"_2758":113855},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3268":67627,"_28512":67606,"_19817":113857,"_5":13545,"_25978":113797,"_2758":113858},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3268":67628,"_28512":67606,"_19817":113860,"_5":13545,"_25978":113797,"_2758":113861},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3268":67629,"_28512":67606,"_19817":113863,"_5":13545,"_25978":113797,"_2758":113864},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3268":67630,"_28512":67606,"_19817":113866,"_5":13545,"_25978":113797,"_2758":113867},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3268":67631,"_28512":67606,"_19817":113869,"_5":13545,"_25978":113801,"_2758":113870},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3268":67632,"_28512":67606,"_19817":113872,"_5":13545,"_25978":113801,"_2758":51586},[],{"_3268":67633,"_28512":67606,"_19817":113874,"_5":13545,"_25978":113801,"_2758":113875},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3268":67634,"_28512":67606,"_19817":113877,"_5":13545,"_25978":113801,"_2758":113878},[],"**Icon** y **Tags**: clasificación opcional.",{"_3268":67635,"_28512":67606,"_19817":113880,"_5":13545,"_25978":113801,"_2758":113881},[],"Confirma el registro.",{"_3268":67636,"_28512":67606,"_19817":113883,"_5":13545,"_25978":113805,"_2758":113884},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3268":67637,"_28512":67606,"_19817":113886,"_5":13545,"_25978":113805,"_2758":113887},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3268":67638,"_28512":67606,"_19817":113889,"_5":13545,"_25978":113809,"_2758":113890},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3268":67639,"_28512":67606,"_19817":113892,"_5":13545,"_25978":113809,"_2758":113893},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3268":67640,"_28512":67606,"_19817":113895,"_5":13545,"_25978":113813,"_2758":113896},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3268":67641,"_28512":67606,"_19817":113898,"_5":13545,"_25978":113813,"_2758":113899},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3268":67642,"_28512":67606,"_19817":113901,"_5":13545,"_25978":113817,"_2758":113753},[],{"_3268":67643,"_28512":67606,"_19817":113903,"_5":13545,"_25978":113817,"_2758":113904},[],"Resultado",{"_3268":67644,"_28512":67606,"_19817":113906,"_5":13545,"_25978":113817,"_2758":113074},[],{"_3268":67645,"_28512":67606,"_19817":113908,"_5":13545,"_25978":113817,"_2758":113909},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3268":67646,"_28512":67606,"_19817":113911,"_5":13545,"_25978":113817,"_2758":113912},[],"Identidad actual",{"_3268":67647,"_28512":67606,"_19817":113914,"_5":13545,"_25978":113817,"_2758":113915},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3268":67648,"_28512":67606,"_19817":113917,"_5":13545,"_25978":113817,"_2758":113918},[],"Historial",{"_3268":67649,"_28512":67606,"_19817":113920,"_5":13545,"_25978":113817,"_2758":113921},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3268":67650,"_28512":67606,"_19817":113923,"_5":13545,"_25978":113817,"_2758":113924},[],"Clave y certificado",{"_3268":67651,"_28512":67606,"_19817":113926,"_5":13545,"_25978":113817,"_2758":113927},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3268":67652,"_28512":67606,"_19817":113929,"_5":13545,"_25978":113820,"_2758":113930},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3268":67653,"_28512":67606,"_19817":113932,"_5":13545,"_25978":113820,"_2758":113933},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3268":67654,"_28512":67606,"_19817":113935,"_5":13545,"_25978":113820,"_2758":113936},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3268":67655,"_28512":67606,"_19817":113938,"_5":13545,"_25978":113820,"_2758":113939},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3268":67656,"_28512":67606,"_19817":113941,"_5":13545,"_25978":113824,"_2758":113942},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3268":67657,"_28512":67606,"_19817":113944,"_5":13545,"_25978":113824,"_2758":113945},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3268":67658,"_28512":67606,"_19817":113947,"_5":13545,"_25978":113824,"_2758":113948},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3268":67659,"_28512":67659,"_5":13876,"_2758":113950,"_28855":113951,"_19817":113952,"_25978":67659},"Plataforma Lamassu IoT",[46447,110303],[],{"_3268":67660,"_28512":67659,"_19817":113954,"_5":13545,"_25978":67659,"_2758":113955},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3268":67661,"_28512":67659,"_5":28852,"_19817":113957,"_25978":113958,"_2758":113450},[],"/docs/pr-preview/pr-43/es/platform/overview#empieza-aquí",{"_3268":67662,"_28512":67659,"_5":28852,"_19817":113960,"_25978":113961,"_2758":113962},[],"/docs/pr-preview/pr-43/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3268":67663,"_28512":67659,"_5":28852,"_19817":113964,"_25978":113965,"_2758":113966},[],"/docs/pr-preview/pr-43/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3268":67664,"_28512":67659,"_5":28852,"_19817":113968,"_25978":113969,"_2758":113970},[],"/docs/pr-preview/pr-43/es/platform/overview#capacidades-principales","Capacidades principales",{"_3268":67665,"_28512":67659,"_5":28852,"_19817":113972,"_25978":113973,"_2758":113974},[],"/docs/pr-preview/pr-43/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3268":67666,"_28512":67659,"_5":28852,"_19817":113976,"_25978":113977,"_2758":113978},[],"/docs/pr-preview/pr-43/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3268":67667,"_28512":67659,"_5":28852,"_19817":113980,"_25978":113981,"_2758":113982},[],"/docs/pr-preview/pr-43/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3268":67668,"_28512":67659,"_5":28852,"_19817":113984,"_25978":113985,"_2758":113986},[],"/docs/pr-preview/pr-43/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3268":67669,"_28512":67659,"_5":28852,"_19817":113988,"_25978":113989,"_2758":113990},[],"/docs/pr-preview/pr-43/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3268":67670,"_28512":67659,"_5":28852,"_19817":113992,"_25978":113993,"_2758":113994},[],"/docs/pr-preview/pr-43/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3268":67671,"_28512":67659,"_5":28852,"_19817":113996,"_25978":113997,"_2758":113998},[],"/docs/pr-preview/pr-43/es/platform/overview#referencia-operativa","Referencia operativa",{"_3268":67672,"_28512":67659,"_19817":114000,"_5":13545,"_25978":67659,"_2758":114001},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3268":67673,"_28512":67659,"_19817":114003,"_5":13545,"_25978":113958,"_2758":114004},[],"Elige el resultado que necesitas obtener:",{"_3268":67674,"_28512":67659,"_19817":114006,"_5":13545,"_25978":113958,"_2758":114007},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3268":67675,"_28512":67659,"_19817":114009,"_5":13545,"_25978":113958,"_2758":114010},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3268":67676,"_28512":67659,"_19817":114012,"_5":13545,"_25978":113958,"_2758":114013},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3268":67677,"_28512":67659,"_19817":114015,"_5":13545,"_25978":113961,"_2758":114016},[],"Bloque",{"_3268":67678,"_28512":67659,"_19817":114018,"_5":13545,"_25978":113961,"_2758":114019},[],"Qué gestionas",{"_3268":67679,"_28512":67659,"_19817":114021,"_5":13545,"_25978":113961,"_2758":114022},[],"Punto de entrada",{"_3268":67680,"_28512":67659,"_19817":114024,"_5":13545,"_25978":113961,"_2758":51739},[],{"_3268":67681,"_28512":67659,"_19817":114026,"_5":13545,"_25978":113961,"_2758":114027},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3268":67682,"_28512":67659,"_19817":114029,"_5":13545,"_25978":113961,"_2758":114030},[],"Visión general de PKI",{"_3268":67683,"_28512":67659,"_19817":114032,"_5":13545,"_25978":113961,"_2758":51748},[],{"_3268":67684,"_28512":67659,"_19817":114034,"_5":13545,"_25978":113961,"_2758":114035},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3268":67685,"_28512":67659,"_19817":114037,"_5":13545,"_25978":113961,"_2758":114038},[],"Visión general de IoT Fleets",{"_3268":67686,"_28512":67659,"_19817":114040,"_5":13545,"_25978":113961,"_2758":114041},[],"**Administración**",{"_3268":67687,"_28512":67659,"_19817":114043,"_5":13545,"_25978":113961,"_2758":114044},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3268":67688,"_28512":67659,"_19817":114046,"_5":13545,"_25978":113961,"_2758":110301},[],{"_3268":67689,"_28512":67659,"_19817":114048,"_5":13545,"_25978":113961,"_2758":114049},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3268":67690,"_28512":67659,"_19817":114051,"_5":13545,"_25978":113965,"_2758":114052},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3268":67691,"_28512":67659,"_19817":114054,"_5":13545,"_25978":113965,"_2758":114055},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3268":67692,"_28512":67659,"_19817":114057,"_5":13545,"_25978":113965,"_2758":114058},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3268":67693,"_28512":67659,"_19817":114060,"_5":13545,"_25978":113965,"_2758":114061},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3268":67694,"_28512":67659,"_19817":114063,"_5":13545,"_25978":113965,"_2758":114064},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3268":67695,"_28512":67659,"_19817":114066,"_5":13545,"_25978":113965,"_2758":114067},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3268":67696,"_28512":67659,"_19817":114069,"_5":13545,"_25978":113973,"_2758":114070},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3268":67697,"_28512":67659,"_19817":114072,"_5":13545,"_25978":113977,"_2758":114073},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3268":67698,"_28512":67659,"_19817":114075,"_5":13545,"_25978":113981,"_2758":114076},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3268":67699,"_28512":67659,"_19817":114078,"_5":13545,"_25978":113985,"_2758":114079},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3268":67700,"_28512":67659,"_19817":114081,"_5":13545,"_25978":113989,"_2758":114082},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3268":67701,"_28512":67659,"_19817":114084,"_5":13545,"_25978":113993,"_2758":114085},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3268":67702,"_28512":67659,"_19817":114087,"_5":13545,"_25978":113997,"_2758":113543},[],{"_3268":67703,"_28512":67659,"_19817":114089,"_5":13545,"_25978":113997,"_2758":114090},[],"Qué prepara o comprueba",{"_3268":67704,"_28512":67659,"_19817":114092,"_5":13545,"_25978":113997,"_2758":113546},[],{"_3268":67705,"_28512":67659,"_19817":114094,"_5":13545,"_25978":113997,"_2758":114095},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3268":67706,"_28512":67659,"_19817":114097,"_5":13545,"_25978":113997,"_2758":114098},[],"Administrador de la flota",{"_3268":67707,"_28512":67659,"_19817":114100,"_5":13545,"_25978":113997,"_2758":114101},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3268":67708,"_28512":67659,"_19817":114103,"_5":13545,"_25978":113997,"_2758":113558},[],{"_3268":67709,"_28512":67659,"_19817":114105,"_5":13545,"_25978":113997,"_2758":114106},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3268":67710,"_28512":67659,"_19817":114108,"_5":13545,"_25978":113997,"_2758":113564},[],{"_3268":67711,"_28512":67659,"_19817":114110,"_5":13545,"_25978":113997,"_2758":114111},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3268":67712,"_28512":67659,"_19817":114113,"_5":13545,"_25978":113997,"_2758":114114},[],"Operador de infraestructura",{"_3268":67713,"_28512":67659,"_19817":114116,"_5":13545,"_25978":113997,"_2758":114117},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3268":67714,"_28512":67659,"_19817":114119,"_5":13545,"_25978":113997,"_2758":114120},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3268":67715,"_28512":67715,"_5":13876,"_2758":114122,"_28855":114123,"_19817":114125,"_25978":67715},"Jerarquía y rotación de CAs",[46447,110303,51840,114124],"Claves, autoridades y certificados",[],{"_3268":67716,"_28512":67715,"_19817":114127,"_5":13545,"_25978":67715,"_2758":114128},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3268":67717,"_28512":67715,"_5":28852,"_19817":114130,"_25978":114131,"_2758":114132},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3268":67718,"_28512":67715,"_5":28852,"_19817":114134,"_25978":114135,"_2758":114136},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3268":67719,"_28512":67715,"_5":28852,"_19817":114138,"_25978":114139,"_2758":114140},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3268":67720,"_28512":67715,"_5":28852,"_19817":114142,"_25978":114143,"_2758":114144},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3268":67721,"_28512":67715,"_5":28852,"_19817":114146,"_25978":114147,"_2758":114148},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3268":67722,"_28512":67715,"_5":28852,"_19817":114150,"_25978":114151,"_2758":114152},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3268":67723,"_28512":67715,"_5":28852,"_19817":114154,"_25978":114155,"_2758":114156},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3268":67724,"_28512":67715,"_5":28852,"_19817":114158,"_25978":114159,"_2758":114160},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3268":67725,"_28512":67715,"_5":28852,"_19817":114162,"_25978":114163,"_2758":114164},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3268":67726,"_28512":67715,"_5":28852,"_19817":114166,"_25978":114167,"_2758":114168},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3268":67727,"_28512":67715,"_5":28852,"_19817":114170,"_25978":114171,"_2758":114172},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3268":67728,"_28512":67715,"_5":28852,"_19817":114174,"_25978":114175,"_2758":114176},[],"/docs/pr-preview/pr-43/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3268":67729,"_28512":67715,"_19817":114178,"_5":13545,"_25978":67715,"_2758":114179},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3268":67730,"_28512":67715,"_19817":114181,"_5":13545,"_25978":67715,"_2758":114182},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3268":67731,"_28512":67715,"_19817":114184,"_5":13545,"_25978":114131,"_2758":114185},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3268":67732,"_28512":67715,"_19817":114187,"_5":13545,"_25978":114131,"_2758":114188},[],"entorno, como producción y preproducción;",{"_3268":67733,"_28512":67715,"_19817":114190,"_5":13545,"_25978":114131,"_2758":114191},[],"propietario o equipo operador;",{"_3268":67734,"_28512":67715,"_19817":114193,"_5":13545,"_25978":114131,"_2758":114194},[],"familia de dispositivos o proceso de fabricación;",{"_3268":67735,"_28512":67715,"_19817":114196,"_5":13545,"_25978":114131,"_2758":114197},[],"región o requisito regulatorio;",{"_3268":67736,"_28512":67715,"_19817":114199,"_5":13545,"_25978":114131,"_2758":114200},[],"motor criptográfico o política de clave;",{"_3268":67737,"_28512":67715,"_19817":114202,"_5":13545,"_25978":114131,"_2758":114203},[],"ventana de mantenimiento y ritmo de renovación.",{"_3268":67738,"_28512":67715,"_19817":114205,"_5":13545,"_25978":114131,"_2758":114206},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3268":67739,"_28512":67715,"_19817":114208,"_5":13545,"_25978":114131,"_2758":114209},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3268":67740,"_28512":67715,"_19817":114211,"_5":13545,"_25978":114135,"_2758":114212},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3268":67741,"_28512":67715,"_19817":114214,"_5":13545,"_25978":114135,"_2758":114215},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3268":67742,"_28512":67715,"_19817":114217,"_5":13545,"_25978":114135,"_2758":114218},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3268":67743,"_28512":67715,"_19817":114220,"_5":13545,"_25978":114139,"_2758":114221},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3268":67744,"_28512":67715,"_19817":114223,"_5":13545,"_25978":114139,"_2758":114224},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3268":67745,"_28512":67715,"_19817":114226,"_5":13545,"_25978":114139,"_2758":114227},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3268":67746,"_28512":67715,"_19817":114229,"_5":13545,"_25978":114139,"_2758":114230},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3268":67747,"_28512":67715,"_19817":114232,"_5":13545,"_25978":114147,"_2758":114233},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3268":67748,"_28512":67715,"_19817":114235,"_5":13545,"_25978":114151,"_2758":114236},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3268":67749,"_28512":67715,"_19817":114238,"_5":13545,"_25978":114155,"_2758":114239},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3268":67750,"_28512":67715,"_19817":114241,"_5":13545,"_25978":114159,"_2758":114242},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3268":67751,"_28512":67715,"_19817":114244,"_5":13545,"_25978":114163,"_2758":114245},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3268":67752,"_28512":67715,"_19817":114247,"_5":13545,"_25978":114167,"_2758":114248},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3268":67753,"_28512":67715,"_19817":114250,"_5":13545,"_25978":114171,"_2758":114251},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3268":67754,"_28512":67715,"_19817":114253,"_5":13545,"_25978":114171,"_2758":114254},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3268":67755,"_28512":67715,"_19817":114256,"_5":13545,"_25978":114171,"_2758":114257},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3268":67756,"_28512":67715,"_19817":114259,"_5":13545,"_25978":114171,"_2758":114260},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3268":67757,"_28512":67715,"_19817":114262,"_5":13545,"_25978":114175,"_2758":114263},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3268":67758,"_28512":67715,"_19817":114265,"_5":13545,"_25978":114175,"_2758":114266},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3268":67759,"_28512":67715,"_19817":114268,"_5":13545,"_25978":114175,"_2758":114269},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3268":67760,"_28512":67715,"_19817":114271,"_5":13545,"_25978":114175,"_2758":114272},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3268":67761,"_28512":67715,"_19817":114274,"_5":13545,"_25978":114175,"_2758":114275},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3268":67762,"_28512":67715,"_19817":114277,"_5":13545,"_25978":114175,"_2758":114278},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3268":67763,"_28512":67715,"_19817":114280,"_5":13545,"_25978":114175,"_2758":114281},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3268":67764,"_28512":67764,"_5":13876,"_2758":114283,"_28855":114284,"_19817":114285,"_25978":67764},"Autoridades de certificación",[46447,110303,51840,114124],[],{"_3268":67765,"_28512":67764,"_19817":114287,"_5":13545,"_25978":67764,"_2758":114288},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3268":67766,"_28512":67764,"_5":28852,"_19817":114290,"_25978":114291,"_2758":114292},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3268":67767,"_28512":67764,"_5":28852,"_19817":114294,"_25978":114295,"_2758":114296},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3268":67768,"_28512":67764,"_5":28852,"_19817":114298,"_25978":114299,"_2758":108956},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3268":67769,"_28512":67764,"_5":28852,"_19817":114301,"_25978":114302,"_2758":114303},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3268":67770,"_28512":67764,"_5":28852,"_19817":114305,"_25978":114306,"_2758":114307},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3268":67771,"_28512":67764,"_5":28852,"_19817":114309,"_25978":114310,"_2758":114311},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3268":67772,"_28512":67764,"_5":28852,"_19817":114313,"_25978":114314,"_2758":114315},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3268":67773,"_28512":67764,"_5":28852,"_19817":114317,"_25978":114318,"_2758":114319},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3268":67774,"_28512":67764,"_5":28852,"_19817":114321,"_25978":114322,"_2758":114323},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3268":67775,"_28512":67764,"_5":28852,"_19817":114325,"_25978":114326,"_2758":114327},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3268":67776,"_28512":67764,"_5":28852,"_19817":114329,"_25978":114330,"_2758":114331},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3268":67777,"_28512":67764,"_5":28852,"_19817":114333,"_25978":114334,"_2758":114335},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3268":67778,"_28512":67764,"_5":28852,"_19817":114337,"_25978":114338,"_2758":114339},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3268":67779,"_28512":67764,"_5":28852,"_19817":114341,"_25978":114342,"_2758":114343},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3268":67780,"_28512":67764,"_5":28852,"_19817":114345,"_25978":114346,"_2758":114347},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3268":67781,"_28512":67764,"_5":28852,"_19817":114349,"_25978":114350,"_2758":114351},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3268":67782,"_28512":67764,"_5":28852,"_19817":114353,"_25978":114354,"_2758":114355},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3268":67783,"_28512":67764,"_5":28852,"_19817":114357,"_25978":114358,"_2758":114359},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3268":67784,"_28512":67764,"_5":28852,"_19817":114361,"_25978":114362,"_2758":114363},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3268":67785,"_28512":67764,"_5":28852,"_19817":114365,"_25978":114366,"_2758":114367},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3268":67786,"_28512":67764,"_5":28852,"_19817":114369,"_25978":114370,"_2758":114371},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3268":67787,"_28512":67764,"_5":28852,"_19817":114373,"_25978":114374,"_2758":114375},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3268":67788,"_28512":67764,"_19817":114377,"_5":13545,"_25978":67764,"_2758":114378},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3268":67789,"_28512":67764,"_19817":114380,"_5":13545,"_25978":67764,"_2758":114381},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3268":67790,"_28512":67764,"_19817":114383,"_5":13545,"_25978":67764,"_2758":114384},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3268":67791,"_28512":67764,"_19817":114386,"_5":13545,"_25978":114291,"_2758":114387},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3268":67792,"_28512":67764,"_19817":114389,"_5":13545,"_25978":114291,"_2758":114390},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3268":67793,"_28512":67764,"_19817":114392,"_5":13545,"_25978":114291,"_2758":114393},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3268":67794,"_28512":67764,"_19817":114395,"_5":13545,"_25978":114291,"_2758":114396},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3268":67795,"_28512":67764,"_19817":114398,"_5":13545,"_25978":114291,"_2758":114399},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3268":67796,"_28512":67764,"_19817":114401,"_5":13545,"_25978":114299,"_2758":114402},[],"Decide si la CA será raíz o intermedia.",{"_3268":67797,"_28512":67764,"_19817":114404,"_5":13545,"_25978":114299,"_2758":114405},[],"Elige el motor que custodiará la clave.",{"_3268":67798,"_28512":67764,"_19817":114407,"_5":13545,"_25978":114299,"_2758":114408},[],"Define una validez superior a la de los certificados que emitirá.",{"_3268":67799,"_28512":67764,"_19817":114410,"_5":13545,"_25978":114299,"_2758":114411},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3268":67800,"_28512":67764,"_19817":114413,"_5":13545,"_25978":114302,"_2758":114414},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3268":67801,"_28512":67764,"_19817":114416,"_5":13545,"_25978":114306,"_2758":114417},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3268":67802,"_28512":67764,"_19817":114419,"_5":13545,"_25978":114306,"_2758":114420},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3268":67803,"_28512":67764,"_19817":114422,"_5":13545,"_25978":114310,"_2758":114423},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3268":67804,"_28512":67764,"_19817":114425,"_5":13545,"_25978":114314,"_2758":114426},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3268":67805,"_28512":67764,"_19817":114428,"_5":13545,"_25978":114314,"_2758":114429},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3268":67806,"_28512":67764,"_19817":114431,"_5":13545,"_25978":114314,"_2758":114432},[],"`ST`: estado o provincia.",{"_3268":67807,"_28512":67764,"_19817":114434,"_5":13545,"_25978":114314,"_2758":114435},[],"`L`: localidad.",{"_3268":67808,"_28512":67764,"_19817":114437,"_5":13545,"_25978":114314,"_2758":114438},[],"`O`: organización.",{"_3268":67809,"_28512":67764,"_19817":114440,"_5":13545,"_25978":114314,"_2758":114441},[],"`OU`: unidad organizativa.",{"_3268":67810,"_28512":67764,"_19817":114443,"_5":13545,"_25978":114314,"_2758":114444},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3268":67811,"_28512":67764,"_19817":114446,"_5":13545,"_25978":114318,"_2758":114447},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3268":67812,"_28512":67764,"_19817":114449,"_5":13545,"_25978":114318,"_2758":114450},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3268":67813,"_28512":67764,"_19817":114452,"_5":13545,"_25978":114322,"_2758":114453},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3268":67814,"_28512":67764,"_19817":114455,"_5":13545,"_25978":114322,"_2758":114456},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3268":67815,"_28512":67764,"_19817":114458,"_5":13545,"_25978":114326,"_2758":114459},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3268":67816,"_28512":67764,"_19817":114461,"_5":13545,"_25978":114326,"_2758":114462},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3268":67817,"_28512":67764,"_19817":114464,"_5":13545,"_25978":114330,"_2758":114465},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3268":67818,"_28512":67764,"_19817":114467,"_5":13545,"_25978":114334,"_2758":114468},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3268":67819,"_28512":67764,"_19817":114470,"_5":13545,"_25978":114338,"_2758":114471},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3268":67820,"_28512":67764,"_19817":114473,"_5":13545,"_25978":114342,"_2758":114474},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3268":67821,"_28512":67764,"_19817":114476,"_5":13545,"_25978":114346,"_2758":114477},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3268":67822,"_28512":67764,"_19817":114479,"_5":13545,"_25978":114346,"_2758":114480},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3268":67823,"_28512":67764,"_19817":114482,"_5":13545,"_25978":114350,"_2758":114483},[],"Abre una CA desde el inventario para consultar:",{"_3268":67824,"_28512":67764,"_19817":114485,"_5":13545,"_25978":114350,"_2758":114486},[],"Estado y periodo de validez.",{"_3268":67825,"_28512":67764,"_19817":114488,"_5":13545,"_25978":114350,"_2758":114489},[],"Certificado y cadena en formato PEM.",{"_3268":67826,"_28512":67764,"_19817":114491,"_5":13545,"_25978":114350,"_2758":114492},[],"Número de certificados activos, expirados y revocados.",{"_3268":67827,"_28512":67764,"_19817":114494,"_5":13545,"_25978":114350,"_2758":114495},[],"Certificados emitidos en **Issued Certificates**.",{"_3268":67828,"_28512":67764,"_19817":114497,"_5":13545,"_25978":114350,"_2758":114498},[],"CRL vinculada a la autoridad.",{"_3268":67829,"_28512":67764,"_19817":114500,"_5":13545,"_25978":114350,"_2758":114501},[],"Metadatos y motor criptográfico asociado.",{"_3268":67830,"_28512":67764,"_19817":114503,"_5":13545,"_25978":114350,"_2758":114504},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3268":67831,"_28512":67764,"_19817":114506,"_5":13545,"_25978":114354,"_2758":114507},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3268":67832,"_28512":67764,"_19817":114509,"_5":13545,"_25978":114354,"_2758":114510},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3268":67833,"_28512":67764,"_19817":114512,"_5":13545,"_25978":114354,"_2758":114513},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3268":67834,"_28512":67764,"_19817":114515,"_5":13545,"_25978":114354,"_2758":114516},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3268":67835,"_28512":67764,"_19817":114518,"_5":13545,"_25978":114358,"_2758":114519},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3268":67836,"_28512":67764,"_19817":114521,"_5":13545,"_25978":114362,"_2758":114522},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3268":67837,"_28512":67764,"_19817":114524,"_5":13545,"_25978":114366,"_2758":114525},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3268":67838,"_28512":67764,"_19817":114527,"_5":13545,"_25978":114370,"_2758":114528},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3268":67839,"_28512":67764,"_19817":114530,"_5":13545,"_25978":114374,"_2758":114531},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3268":67840,"_28512":67764,"_19817":114533,"_5":13545,"_25978":114374,"_2758":114534},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3268":67841,"_28512":67841,"_5":13876,"_2758":114536,"_28855":114537,"_19817":114538,"_25978":67841},"Perfiles de certificado",[46447,110303,51840,114124],[],{"_3268":67842,"_28512":67841,"_19817":114540,"_5":13545,"_25978":67841,"_2758":114541},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3268":67843,"_28512":67841,"_5":28852,"_19817":114543,"_25978":114544,"_2758":114545},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3268":67844,"_28512":67841,"_5":28852,"_19817":114547,"_25978":114548,"_2758":114549},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#validez","Validez",{"_3268":67845,"_28512":67841,"_5":28852,"_19817":114551,"_25978":114552,"_2758":114553},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3268":67846,"_28512":67841,"_5":28852,"_19817":114555,"_25978":114556,"_2758":114557},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3268":67847,"_28512":67841,"_5":28852,"_19817":114559,"_25978":114560,"_2758":114561},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3268":67848,"_28512":67841,"_5":28852,"_19817":114563,"_25978":114564,"_2758":114565},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3268":67849,"_28512":67841,"_5":28852,"_19817":114567,"_25978":114568,"_2758":114569},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3268":67850,"_28512":67841,"_5":28852,"_19817":114571,"_25978":114572,"_2758":114573},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3268":67851,"_28512":67841,"_5":28852,"_19817":114575,"_25978":114576,"_2758":114577},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3268":67852,"_28512":67841,"_5":28852,"_19817":114579,"_25978":114580,"_2758":114581},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3268":67853,"_28512":67841,"_5":28852,"_19817":114583,"_25978":114584,"_2758":114585},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3268":67854,"_28512":67841,"_5":28852,"_19817":114587,"_25978":114588,"_2758":114589},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3268":67855,"_28512":67841,"_5":28852,"_19817":114591,"_25978":114592,"_2758":114593},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3268":67856,"_28512":67841,"_5":28852,"_19817":114595,"_25978":114596,"_2758":114597},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3268":67857,"_28512":67841,"_5":28852,"_19817":114599,"_25978":114600,"_2758":114601},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3268":67858,"_28512":67841,"_5":28852,"_19817":114603,"_25978":114604,"_2758":114605},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3268":67859,"_28512":67841,"_19817":114607,"_5":13545,"_25978":67841,"_2758":114608},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3268":67860,"_28512":67841,"_19817":114610,"_5":13545,"_25978":67841,"_2758":114611},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3268":67861,"_28512":67841,"_19817":114613,"_5":13545,"_25978":114548,"_2758":114614},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3268":67862,"_28512":67841,"_19817":114616,"_5":13545,"_25978":114548,"_2758":114617},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3268":67863,"_28512":67841,"_19817":114619,"_5":13545,"_25978":114552,"_2758":114620},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3268":67864,"_28512":67841,"_19817":114622,"_5":13545,"_25978":114556,"_2758":114623},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3268":67865,"_28512":67841,"_19817":114625,"_5":13545,"_25978":114556,"_2758":114626},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3268":67866,"_28512":67841,"_19817":114628,"_5":13545,"_25978":114556,"_2758":114629},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3268":67867,"_28512":67841,"_19817":114631,"_5":13545,"_25978":114560,"_2758":114632},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3268":67868,"_28512":67841,"_19817":114634,"_5":13545,"_25978":114564,"_2758":114635},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3268":67869,"_28512":67841,"_19817":114637,"_5":13545,"_25978":114564,"_2758":114638},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3268":67870,"_28512":67841,"_19817":114640,"_5":13545,"_25978":114568,"_2758":114641},[],"La aplicación criptográfica puede:",{"_3268":67871,"_28512":67841,"_19817":114643,"_5":13545,"_25978":114568,"_2758":114644},[],"permitir o bloquear claves RSA;",{"_3268":67872,"_28512":67841,"_19817":114646,"_5":13545,"_25978":114568,"_2758":114647},[],"limitar los tamaños RSA admitidos;",{"_3268":67873,"_28512":67841,"_19817":114649,"_5":13545,"_25978":114568,"_2758":114650},[],"permitir o bloquear claves ECDSA;",{"_3268":67874,"_28512":67841,"_19817":114652,"_5":13545,"_25978":114568,"_2758":114653},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3268":67875,"_28512":67841,"_19817":114655,"_5":13545,"_25978":114568,"_2758":114656},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3268":67876,"_28512":67841,"_19817":114658,"_5":13545,"_25978":114572,"_2758":114659},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3268":67877,"_28512":67841,"_19817":114661,"_5":13545,"_25978":114572,"_2758":110091},[],{"_3268":67878,"_28512":67841,"_19817":114663,"_5":13545,"_25978":114572,"_2758":114664},[],"Primera opción",{"_3268":67879,"_28512":67841,"_19817":114666,"_5":13545,"_25978":114572,"_2758":114667},[],"Segunda opción",{"_3268":67880,"_28512":67841,"_19817":114669,"_5":13545,"_25978":114572,"_2758":114670},[],"Si no hay ninguna",{"_3268":67881,"_28512":67841,"_19817":114672,"_5":13545,"_25978":114572,"_2758":114673},[],"Firma directa con una CA",{"_3268":67882,"_28512":67841,"_19817":114675,"_5":13545,"_25978":114572,"_2758":114676},[],"`issuance_profile` incluido en la solicitud",{"_3268":67883,"_28512":67841,"_19817":114678,"_5":13545,"_25978":114572,"_2758":114679},[],"`issuance_profile_id` de la solicitud",{"_3268":67884,"_28512":67841,"_19817":114681,"_5":13545,"_25978":114572,"_2758":114682},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3268":67885,"_28512":67841,"_19817":114684,"_5":13545,"_25978":114572,"_2758":114685},[],"Emisión mediante DMS",{"_3268":67886,"_28512":67841,"_19817":114687,"_5":13545,"_25978":114572,"_2758":52405},[],{"_3268":67887,"_28512":67841,"_19817":114689,"_5":13545,"_25978":114572,"_2758":114690},[],"`settings.issuance_profile` incluido en el DMS",{"_3268":67888,"_28512":67841,"_19817":114692,"_5":13545,"_25978":114572,"_2758":114693},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3268":67889,"_28512":67841,"_19817":114695,"_5":13545,"_25978":114572,"_2758":114696},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3268":67890,"_28512":67841,"_19817":114698,"_5":13545,"_25978":114572,"_2758":114699},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3268":67891,"_28512":67841,"_19817":114701,"_5":13545,"_25978":114580,"_2758":114702},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3268":67892,"_28512":67841,"_19817":114704,"_5":13545,"_25978":114584,"_2758":114705},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3268":67893,"_28512":67841,"_19817":114707,"_5":13545,"_25978":114588,"_2758":114708},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3268":67894,"_28512":67841,"_19817":114710,"_5":13545,"_25978":114592,"_2758":114711},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3268":67895,"_28512":67841,"_19817":114713,"_5":13545,"_25978":114596,"_2758":114714},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3268":67896,"_28512":67841,"_19817":114716,"_5":13545,"_25978":114596,"_2758":114717},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3268":67897,"_28512":67841,"_19817":114719,"_5":13545,"_25978":114600,"_2758":114720},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3268":67898,"_28512":67841,"_19817":114722,"_5":13545,"_25978":114600,"_2758":114723},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3268":67899,"_28512":67841,"_19817":114725,"_5":13545,"_25978":114600,"_2758":114726},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3268":67900,"_28512":67841,"_19817":114728,"_5":13545,"_25978":114600,"_2758":114729},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3268":67901,"_28512":67841,"_19817":114731,"_5":13545,"_25978":114604,"_2758":114732},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3268":67902,"_28512":67841,"_19817":114734,"_5":13545,"_25978":114604,"_2758":114735},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3268":67903,"_28512":67903,"_5":13876,"_2758":114737,"_28855":114738,"_19817":114740,"_25978":67903},"Validación de certificados",[46447,110303,51840,114739],"Validación",[],{"_3268":67904,"_28512":67903,"_19817":114742,"_5":13545,"_25978":67903,"_2758":114743},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3268":67905,"_28512":67903,"_5":28852,"_19817":114745,"_25978":114746,"_2758":114747},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3268":67906,"_28512":67903,"_5":28852,"_19817":114749,"_25978":114750,"_2758":114751},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3268":67907,"_28512":67903,"_5":28852,"_19817":114753,"_25978":114754,"_2758":114755},[],"/docs/pr-preview/pr-43/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3268":67908,"_28512":67903,"_19817":114757,"_5":13545,"_25978":67903,"_2758":114758},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3268":67909,"_28512":67903,"_19817":114760,"_5":13545,"_25978":114746,"_2758":114761},[],"Verifica estos criterios juntos:",{"_3268":67910,"_28512":67903,"_19817":114763,"_5":13545,"_25978":114746,"_2758":113753},[],{"_3268":67911,"_28512":67903,"_19817":114765,"_5":13545,"_25978":114746,"_2758":114766},[],"Resultado necesario",{"_3268":67912,"_28512":67903,"_19817":114768,"_5":13545,"_25978":114746,"_2758":114769},[],"Cadena y firma",{"_3268":67913,"_28512":67903,"_19817":114771,"_5":13545,"_25978":114746,"_2758":114772},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3268":67914,"_28512":67903,"_19817":114774,"_5":13545,"_25978":114746,"_2758":114775},[],"Fechas",{"_3268":67915,"_28512":67903,"_19817":114777,"_5":13545,"_25978":114746,"_2758":114778},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3268":67916,"_28512":67903,"_19817":114780,"_5":13545,"_25978":114746,"_2758":110001},[],{"_3268":67917,"_28512":67903,"_19817":114782,"_5":13545,"_25978":114746,"_2758":114783},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3268":67918,"_28512":67903,"_19817":114785,"_5":13545,"_25978":114746,"_2758":114786},[],"Uso",{"_3268":67919,"_28512":67903,"_19817":114788,"_5":13545,"_25978":114746,"_2758":114789},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3268":67920,"_28512":67903,"_19817":114791,"_5":13545,"_25978":114746,"_2758":114792},[],"Revocación",{"_3268":67921,"_28512":67903,"_19817":114794,"_5":13545,"_25978":114746,"_2758":114795},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3268":67922,"_28512":67903,"_19817":114797,"_5":13545,"_25978":114746,"_2758":114798},[],"Autorización",{"_3268":67923,"_28512":67903,"_19817":114800,"_5":13545,"_25978":114746,"_2758":114801},[],"La aplicación permite la acción a esa identidad.",{"_3268":67924,"_28512":67903,"_19817":114803,"_5":13545,"_25978":114746,"_2758":114804},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3268":67925,"_28512":67903,"_19817":114806,"_5":13545,"_25978":114750,"_2758":114807},[],"Mecanismo",{"_3268":67926,"_28512":67903,"_19817":114809,"_5":13545,"_25978":114750,"_2758":114810},[],"Cuándo utilizarlo",{"_3268":67927,"_28512":67903,"_19817":114812,"_5":13545,"_25978":114750,"_2758":114813},[],"Qué debes mantener",{"_3268":67928,"_28512":67903,"_19817":114815,"_5":13545,"_25978":114750,"_2758":52533},[],{"_3268":67929,"_28512":67903,"_19817":114817,"_5":13545,"_25978":114750,"_2758":114818},[],"Consulta del estado de un certificado concreto.",{"_3268":67930,"_28512":67903,"_19817":114820,"_5":13545,"_25978":114750,"_2758":114821},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3268":67931,"_28512":67903,"_19817":114823,"_5":13545,"_25978":114750,"_2758":52542},[],{"_3268":67932,"_28512":67903,"_19817":114825,"_5":13545,"_25978":114750,"_2758":114826},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3268":67933,"_28512":67903,"_19817":114828,"_5":13545,"_25978":114750,"_2758":114829},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3268":67934,"_28512":67903,"_19817":114831,"_5":13545,"_25978":114750,"_2758":114832},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3268":67935,"_28512":67903,"_19817":114834,"_5":13545,"_25978":114750,"_2758":114835},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3268":67936,"_28512":67903,"_19817":114837,"_5":13545,"_25978":114754,"_2758":114838},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3268":67937,"_28512":67903,"_19817":114840,"_5":13545,"_25978":114754,"_2758":114841},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3268":67938,"_28512":67903,"_19817":114843,"_5":13545,"_25978":114754,"_2758":114844},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3268":67939,"_28512":67903,"_19817":114846,"_5":13545,"_25978":114754,"_2758":114847},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3268":67940,"_28512":67903,"_19817":114849,"_5":13545,"_25978":114754,"_2758":114850},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3268":67941,"_28512":67903,"_19817":114852,"_5":13545,"_25978":114754,"_2758":114853},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3268":67942,"_28512":67903,"_19817":114855,"_5":13545,"_25978":114754,"_2758":114856},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3268":67943,"_28512":67903,"_19817":114858,"_5":13545,"_25978":114754,"_2758":114859},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3268":67944,"_28512":67903,"_19817":114861,"_5":13545,"_25978":114754,"_2758":114862},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3268":67945,"_28512":67945,"_5":13876,"_2758":114864,"_28855":114865,"_19817":114866,"_25978":67945},"Certificados",[46447,110303,51840,114124],[],{"_3268":67946,"_28512":67945,"_19817":114868,"_5":13545,"_25978":67945,"_2758":114869},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3268":67947,"_28512":67945,"_5":28852,"_19817":114871,"_25978":114872,"_2758":114873},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3268":67948,"_28512":67945,"_5":28852,"_19817":114875,"_25978":114876,"_2758":114877},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3268":67949,"_28512":67945,"_5":28852,"_19817":114879,"_25978":114880,"_2758":114881},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3268":67950,"_28512":67945,"_5":28852,"_19817":114883,"_25978":114884,"_2758":114885},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3268":67951,"_28512":67945,"_5":28852,"_19817":114887,"_25978":114888,"_2758":114889},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3268":67952,"_28512":67945,"_5":28852,"_19817":114891,"_25978":114892,"_2758":114893},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3268":67953,"_28512":67945,"_5":28852,"_19817":114895,"_25978":114896,"_2758":114897},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3268":67954,"_28512":67945,"_5":28852,"_19817":114899,"_25978":114900,"_2758":114901},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3268":67955,"_28512":67945,"_5":28852,"_19817":114903,"_25978":114904,"_2758":114905},[],"/docs/pr-preview/pr-43/es/platform/pki/certificates#continúa","Continúa",{"_3268":67956,"_28512":67945,"_19817":114907,"_5":13545,"_25978":67945,"_2758":114908},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3268":67957,"_28512":67945,"_19817":114910,"_5":13545,"_25978":114872,"_2758":114911},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3268":67958,"_28512":67945,"_19817":114913,"_5":13545,"_25978":114872,"_2758":114914},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3268":67959,"_28512":67945,"_19817":114916,"_5":13545,"_25978":114876,"_2758":114917},[],"Descarga el PEM e inspecciónalo:",{"_3268":67960,"_28512":67945,"_19817":114919,"_5":13545,"_25978":114876,"_2758":114920},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3268":67961,"_28512":67945,"_19817":114922,"_5":13545,"_25978":114880,"_2758":114923},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3268":67962,"_28512":67945,"_19817":114925,"_5":13545,"_25978":114880,"_2758":114926},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3268":67963,"_28512":67945,"_19817":114928,"_5":13545,"_25978":114880,"_2758":114929},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3268":67964,"_28512":67945,"_19817":114931,"_5":13545,"_25978":114880,"_2758":114932},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3268":67965,"_28512":67945,"_19817":114934,"_5":13545,"_25978":114880,"_2758":114935},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3268":67966,"_28512":67945,"_19817":114937,"_5":13545,"_25978":114880,"_2758":114938},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3268":67967,"_28512":67945,"_19817":114940,"_5":13545,"_25978":114880,"_2758":114941},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3268":67968,"_28512":67945,"_19817":114943,"_5":13545,"_25978":114884,"_2758":114944},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3268":67969,"_28512":67945,"_19817":114946,"_5":13545,"_25978":114888,"_2758":114947},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3268":67970,"_28512":67945,"_19817":114949,"_5":13545,"_25978":114892,"_2758":114950},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3268":67971,"_28512":67945,"_19817":114952,"_5":13545,"_25978":114896,"_2758":114953},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3268":67972,"_28512":67945,"_19817":114955,"_5":13545,"_25978":114896,"_2758":114956},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3268":67973,"_28512":67945,"_19817":114958,"_5":13545,"_25978":114896,"_2758":114959},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3268":67974,"_28512":67945,"_19817":114961,"_5":13545,"_25978":114900,"_2758":114962},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3268":67975,"_28512":67945,"_19817":114964,"_5":13545,"_25978":114900,"_2758":114965},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3268":67976,"_28512":67945,"_19817":114967,"_5":13545,"_25978":114900,"_2758":114968},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3268":67977,"_28512":67945,"_19817":114970,"_5":13545,"_25978":114904,"_2758":114971},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3268":67978,"_28512":67945,"_19817":114973,"_5":13545,"_25978":114904,"_2758":114974},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3268":67979,"_28512":67979,"_5":13876,"_2758":114976,"_28855":114977,"_19817":114979,"_25978":67979},"Ciclo de vida de un certificado",[46447,110303,51840,114978],"Conceptos",[],{"_3268":67980,"_28512":67979,"_19817":114981,"_5":13545,"_25978":67979,"_2758":114982},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3268":67981,"_28512":67979,"_5":28852,"_19817":114984,"_25978":114985,"_2758":114986},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3268":67982,"_28512":67979,"_5":28852,"_19817":114988,"_25978":114989,"_2758":114990},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3268":67983,"_28512":67979,"_5":28852,"_19817":114992,"_25978":114993,"_2758":114994},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3268":67984,"_28512":67979,"_5":28852,"_19817":114996,"_25978":114997,"_2758":114998},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3268":67985,"_28512":67979,"_5":28852,"_19817":115000,"_25978":115001,"_2758":115002},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3268":67986,"_28512":67979,"_5":28852,"_19817":115004,"_25978":115005,"_2758":115006},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3268":67987,"_28512":67979,"_5":28852,"_19817":115008,"_25978":115009,"_2758":112756},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3268":67988,"_28512":67979,"_5":28852,"_19817":115011,"_25978":115012,"_2758":115013},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3268":67989,"_28512":67979,"_5":28852,"_19817":115015,"_25978":115016,"_2758":115017},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3268":67990,"_28512":67979,"_5":28852,"_19817":115019,"_25978":115020,"_2758":115021},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3268":67991,"_28512":67979,"_19817":115023,"_5":13545,"_25978":67979,"_2758":115024},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3268":67992,"_28512":67979,"_19817":115026,"_5":13545,"_25978":114989,"_2758":115027},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3268":67993,"_28512":67979,"_19817":115029,"_5":13545,"_25978":114993,"_2758":115030},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3268":67994,"_28512":67979,"_19817":115032,"_5":13545,"_25978":114997,"_2758":115033},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3268":67995,"_28512":67979,"_19817":115035,"_5":13545,"_25978":115001,"_2758":115036},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3268":67996,"_28512":67979,"_19817":115038,"_5":13545,"_25978":115005,"_2758":115039},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3268":67997,"_28512":67979,"_19817":115041,"_5":13545,"_25978":115009,"_2758":115042},[],"Lamassu persiste cuatro estados X.509:",{"_3268":67998,"_28512":67979,"_19817":115044,"_5":13545,"_25978":115009,"_2758":115045},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3268":67999,"_28512":67979,"_19817":115047,"_5":13545,"_25978":115009,"_2758":115048},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3268":68000,"_28512":67979,"_19817":115050,"_5":13545,"_25978":115009,"_2758":115051},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3268":68001,"_28512":67979,"_19817":115053,"_5":13545,"_25978":115009,"_2758":115054},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3268":68002,"_28512":67979,"_19817":115056,"_5":13545,"_25978":115009,"_2758":115057},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3268":68003,"_28512":67979,"_19817":115059,"_5":13545,"_25978":115012,"_2758":115060},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3268":68004,"_28512":67979,"_19817":115062,"_5":13545,"_25978":115012,"_2758":115063},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3268":68005,"_28512":67979,"_19817":115065,"_5":13545,"_25978":115012,"_2758":115066},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3268":68006,"_28512":67979,"_19817":115068,"_5":13545,"_25978":115016,"_2758":115069},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3268":68007,"_28512":67979,"_19817":115071,"_5":13545,"_25978":115016,"_2758":115072},[],"Antes de confirmar:",{"_3268":68008,"_28512":67979,"_19817":115074,"_5":13545,"_25978":115016,"_2758":115075},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3268":68009,"_28512":67979,"_19817":115077,"_5":13545,"_25978":115016,"_2758":115078},[],"Distribuye la nueva cadena de confianza.",{"_3268":68010,"_28512":67979,"_19817":115080,"_5":13545,"_25978":115016,"_2758":115081},[],"Reemite las identidades necesarias.",{"_3268":68011,"_28512":67979,"_19817":115083,"_5":13545,"_25978":115016,"_2758":115084},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3268":68012,"_28512":67979,"_19817":115086,"_5":13545,"_25978":115016,"_2758":115087},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3268":68013,"_28512":67979,"_19817":115089,"_5":13545,"_25978":115016,"_2758":115090},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3268":68014,"_28512":67979,"_19817":115092,"_5":13545,"_25978":115020,"_2758":115093},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3268":68015,"_28512":67979,"_19817":115095,"_5":13545,"_25978":115020,"_2758":115096},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3268":68016,"_28512":67979,"_19817":115098,"_5":13545,"_25978":115020,"_2758":115099},[],"Cambios de estado y razones de revocación.",{"_3268":68017,"_28512":67979,"_19817":115101,"_5":13545,"_25978":115020,"_2758":115102},[],"Publicación y vigencia de OCSP y CRLs.",{"_3268":68018,"_28512":67979,"_19817":115104,"_5":13545,"_25978":115020,"_2758":115105},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3268":68019,"_28512":67979,"_19817":115107,"_5":13545,"_25978":115020,"_2758":115108},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3268":68020,"_28512":68020,"_5":13876,"_2758":115110,"_28855":115111,"_19817":115112,"_25978":68020},"Modelo de confianza",[46447,110303,51840,114978],[],{"_3268":68021,"_28512":68020,"_19817":115114,"_5":13545,"_25978":68020,"_2758":115115},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3268":68022,"_28512":68020,"_5":28852,"_19817":115117,"_25978":115118,"_2758":115119},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3268":68023,"_28512":68020,"_5":28852,"_19817":115121,"_25978":115122,"_2758":115123},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3268":68024,"_28512":68020,"_5":28852,"_19817":115125,"_25978":115126,"_2758":115127},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3268":68025,"_28512":68020,"_5":28852,"_19817":115129,"_25978":115130,"_2758":115131},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3268":68026,"_28512":68020,"_5":28852,"_19817":115133,"_25978":115134,"_2758":115135},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3268":68027,"_28512":68020,"_5":28852,"_19817":115137,"_25978":115138,"_2758":115139},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3268":68028,"_28512":68020,"_5":28852,"_19817":115141,"_25978":115142,"_2758":115143},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3268":68029,"_28512":68020,"_5":28852,"_19817":115145,"_25978":115146,"_2758":115147},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3268":68030,"_28512":68020,"_5":28852,"_19817":115149,"_25978":115150,"_2758":115151},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3268":68031,"_28512":68020,"_5":28852,"_19817":115153,"_25978":115154,"_2758":115155},[],"/docs/pr-preview/pr-43/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3268":68032,"_28512":68020,"_19817":115157,"_5":13545,"_25978":68020,"_2758":115158},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3268":68033,"_28512":68020,"_19817":115160,"_5":13545,"_25978":115122,"_2758":115161},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3268":68034,"_28512":68020,"_19817":115163,"_5":13545,"_25978":115126,"_2758":115164},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3268":68035,"_28512":68020,"_19817":115166,"_5":13545,"_25978":115130,"_2758":115167},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3268":68036,"_28512":68020,"_19817":115169,"_5":13545,"_25978":115134,"_2758":115170},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3268":68037,"_28512":68020,"_19817":115172,"_5":13545,"_25978":115138,"_2758":115173},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3268":68038,"_28512":68020,"_19817":115175,"_5":13545,"_25978":115138,"_2758":115176},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3268":68039,"_28512":68020,"_19817":115178,"_5":13545,"_25978":115138,"_2758":115179},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3268":68040,"_28512":68020,"_19817":115181,"_5":13545,"_25978":115138,"_2758":115182},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3268":68041,"_28512":68020,"_19817":115184,"_5":13545,"_25978":115138,"_2758":115185},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3268":68042,"_28512":68020,"_19817":115187,"_5":13545,"_25978":115138,"_2758":115188},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3268":68043,"_28512":68020,"_19817":115190,"_5":13545,"_25978":115142,"_2758":115191},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3268":68044,"_28512":68020,"_19817":115193,"_5":13545,"_25978":115142,"_2758":115194},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3268":68045,"_28512":68020,"_19817":115196,"_5":13545,"_25978":115142,"_2758":115197},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3268":68046,"_28512":68020,"_19817":115199,"_5":13545,"_25978":115142,"_2758":115200},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3268":68047,"_28512":68020,"_19817":115202,"_5":13545,"_25978":115142,"_2758":115203},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3268":68048,"_28512":68020,"_19817":115205,"_5":13545,"_25978":115146,"_2758":115206},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3268":68049,"_28512":68020,"_19817":115208,"_5":13545,"_25978":115146,"_2758":115209},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3268":68050,"_28512":68020,"_19817":115211,"_5":13545,"_25978":115146,"_2758":115212},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3268":68051,"_28512":68020,"_19817":115214,"_5":13545,"_25978":115146,"_2758":115215},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3268":68052,"_28512":68020,"_19817":115217,"_5":13545,"_25978":115146,"_2758":115218},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3268":68053,"_28512":68020,"_19817":115220,"_5":13545,"_25978":115146,"_2758":115221},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3268":68054,"_28512":68020,"_19817":115223,"_5":13545,"_25978":115146,"_2758":115224},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3268":68055,"_28512":68020,"_19817":115226,"_5":13545,"_25978":115150,"_2758":115227},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3268":68056,"_28512":68020,"_19817":115229,"_5":13545,"_25978":115154,"_2758":115230},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3268":68057,"_28512":68020,"_19817":115232,"_5":13545,"_25978":115154,"_2758":115233},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3268":68058,"_28512":68020,"_19817":115235,"_5":13545,"_25978":115154,"_2758":115236},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3268":68059,"_28512":68020,"_19817":115238,"_5":13545,"_25978":115154,"_2758":115239},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3268":68060,"_28512":68020,"_19817":115241,"_5":13545,"_25978":115154,"_2758":115242},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3268":68061,"_28512":68020,"_19817":115244,"_5":13545,"_25978":115154,"_2758":115245},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3268":68062,"_28512":68020,"_19817":115247,"_5":13545,"_25978":115154,"_2758":115248},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3268":68063,"_28512":68063,"_5":13876,"_2758":115250,"_28855":115251,"_19817":115252,"_25978":68063},"Listas de revocación (CRL)",[46447,110303,51840,114739],[],{"_3268":68064,"_28512":68063,"_19817":115254,"_5":13545,"_25978":68063,"_2758":115255},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3268":68065,"_28512":68063,"_5":28852,"_19817":115257,"_25978":115258,"_2758":115259},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3268":68066,"_28512":68063,"_5":28852,"_19817":115261,"_25978":115262,"_2758":115263},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3268":68067,"_28512":68063,"_5":28852,"_19817":115265,"_25978":115266,"_2758":115267},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3268":68068,"_28512":68063,"_5":28852,"_19817":115269,"_25978":115270,"_2758":115271},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3268":68069,"_28512":68063,"_5":28852,"_19817":115273,"_25978":115274,"_2758":115275},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3268":68070,"_28512":68063,"_5":28852,"_19817":115277,"_25978":115278,"_2758":115279},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3268":68071,"_28512":68063,"_5":28852,"_19817":115281,"_25978":115282,"_2758":115283},[],"/docs/pr-preview/pr-43/es/platform/pki/crl#referencias","Referencias",{"_3268":68072,"_28512":68063,"_19817":115285,"_5":13545,"_25978":68063,"_2758":115286},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3268":68073,"_28512":68063,"_19817":115288,"_5":13545,"_25978":115258,"_2758":115289},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3268":68074,"_28512":68063,"_19817":115291,"_5":13545,"_25978":115258,"_2758":115292},[],"Campo de `crl_options`",{"_3268":68075,"_28512":68063,"_19817":115294,"_5":13545,"_25978":115258,"_2758":111838},[],{"_3268":68076,"_28512":68063,"_19817":115296,"_5":13545,"_25978":115258,"_2758":115297},[],"Valor inicial del backend",{"_3268":68077,"_28512":68063,"_19817":115299,"_5":13545,"_25978":115258,"_2758":53020},[],{"_3268":68078,"_28512":68063,"_19817":115301,"_5":13545,"_25978":115258,"_2758":115302},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3268":68079,"_28512":68063,"_19817":115304,"_5":13545,"_25978":115258,"_2758":115305},[],"7 días.",{"_3268":68080,"_28512":68063,"_19817":115307,"_5":13545,"_25978":115258,"_2758":53029},[],{"_3268":68081,"_28512":68063,"_19817":115309,"_5":13545,"_25978":115258,"_2758":115310},[],"Plazo desde la publicación que activa la renovación programada.",{"_3268":68082,"_28512":68063,"_19817":115312,"_5":13545,"_25978":115258,"_2758":115313},[],"6 días y 23 horas.",{"_3268":68083,"_28512":68063,"_19817":115315,"_5":13545,"_25978":115258,"_2758":53038},[],{"_3268":68084,"_28512":68063,"_19817":115317,"_5":13545,"_25978":115258,"_2758":115318},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3268":68085,"_28512":68063,"_19817":115320,"_5":13545,"_25978":115258,"_2758":53044},[],{"_3268":68086,"_28512":68063,"_19817":115322,"_5":13545,"_25978":115258,"_2758":53047},[],{"_3268":68087,"_28512":68063,"_19817":115324,"_5":13545,"_25978":115258,"_2758":115325},[],"Campo de configuración inicializado con el SKI de la CA.",{"_3268":68088,"_28512":68063,"_19817":115327,"_5":13545,"_25978":115258,"_2758":115328},[],"SKI de la CA.",{"_3268":68089,"_28512":68063,"_19817":115330,"_5":13545,"_25978":115258,"_2758":115331},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_3268":68090,"_28512":68063,"_19817":115333,"_5":13545,"_25978":115258,"_2758":115334},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3268":68091,"_28512":68063,"_19817":115336,"_5":13545,"_25978":115262,"_2758":115337},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3268":68092,"_28512":68063,"_19817":115339,"_5":13545,"_25978":115262,"_2758":115340},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3268":68093,"_28512":68063,"_19817":115342,"_5":13545,"_25978":115262,"_2758":115343},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3268":68094,"_28512":68063,"_19817":115345,"_5":13545,"_25978":115266,"_2758":115346},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3268":68095,"_28512":68063,"_19817":115348,"_5":13545,"_25978":115266,"_2758":115349},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3268":68096,"_28512":68063,"_19817":115351,"_5":13545,"_25978":115270,"_2758":115352},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3268":68097,"_28512":68063,"_19817":115354,"_5":13545,"_25978":115270,"_2758":115355},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3268":68098,"_28512":68063,"_19817":115357,"_5":13545,"_25978":115270,"_2758":115358},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3268":68099,"_28512":68063,"_19817":115360,"_5":13545,"_25978":115270,"_2758":115361},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3268":68100,"_28512":68063,"_19817":115363,"_5":13545,"_25978":115270,"_2758":115364},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3268":68101,"_28512":68063,"_19817":115366,"_5":13545,"_25978":115274,"_2758":115367},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3268":68102,"_28512":68063,"_19817":115369,"_5":13545,"_25978":115274,"_2758":112027},[],{"_3268":68103,"_28512":68063,"_19817":115371,"_5":13545,"_25978":115274,"_2758":115372},[],"Path relativo",{"_3268":68104,"_28512":68063,"_19817":115374,"_5":13545,"_25978":115274,"_2758":110091},[],{"_3268":68105,"_28512":68063,"_19817":115376,"_5":13545,"_25978":115274,"_2758":53102},[],{"_3268":68106,"_28512":68063,"_19817":115378,"_5":13545,"_25978":115274,"_2758":53105},[],{"_3268":68107,"_28512":68063,"_19817":115380,"_5":13545,"_25978":115274,"_2758":115381},[],"Consultar `crl_options` y `latest_crl`.",{"_3268":68108,"_28512":68063,"_19817":115383,"_5":13545,"_25978":115274,"_2758":53111},[],{"_3268":68109,"_28512":68063,"_19817":115385,"_5":13545,"_25978":115274,"_2758":53105},[],{"_3268":68110,"_28512":68063,"_19817":115387,"_5":13545,"_25978":115274,"_2758":115388},[],"Sustituir la configuración de CRL.",{"_3268":68111,"_28512":68063,"_19817":115390,"_5":13545,"_25978":115274,"_2758":115391},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3268":68112,"_28512":68063,"_19817":115393,"_5":13545,"_25978":115274,"_2758":115394},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3268":68113,"_28512":68063,"_19817":115396,"_5":13545,"_25978":115278,"_2758":115397},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3268":68114,"_28512":68063,"_19817":115399,"_5":13545,"_25978":115282,"_2758":115400},[],"RFC 5280: perfil X.509 y CRL.",{"_3268":68115,"_28512":68063,"_19817":115402,"_5":13545,"_25978":115282,"_2758":53131},[],{"_3268":68116,"_28512":68063,"_19817":115404,"_5":13545,"_25978":115282,"_2758":53134},[],{"_3268":68117,"_28512":68063,"_19817":115406,"_5":13545,"_25978":115282,"_2758":115407},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3268":68118,"_28512":68063,"_19817":115409,"_5":13545,"_25978":115282,"_2758":115410},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3268":68119,"_28512":68119,"_5":13876,"_2758":115412,"_28855":115413,"_19817":115414,"_25978":68119},"Claves y motores criptográficos",[46447,110303,51840,114124],[],{"_3268":68120,"_28512":68119,"_19817":115416,"_5":13545,"_25978":68119,"_2758":115417},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3268":68121,"_28512":68119,"_5":28852,"_19817":115419,"_25978":115420,"_2758":115421},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3268":68122,"_28512":68119,"_5":28852,"_19817":115423,"_25978":115424,"_2758":115425},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3268":68123,"_28512":68119,"_5":28852,"_19817":115427,"_25978":115428,"_2758":53159},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#file-system",{"_3268":68124,"_28512":68119,"_5":28852,"_19817":115430,"_25978":115431,"_2758":53163},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#hashicorp-vault",{"_3268":68125,"_28512":68119,"_5":28852,"_19817":115433,"_25978":115434,"_2758":53167},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#aws-secrets-manager",{"_3268":68126,"_28512":68119,"_5":28852,"_19817":115436,"_25978":115437,"_2758":53171},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#aws-kms",{"_3268":68127,"_28512":68119,"_5":28852,"_19817":115439,"_25978":115440,"_2758":53175},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#pkcs11",{"_3268":68128,"_28512":68119,"_5":28852,"_19817":115442,"_25978":115443,"_2758":53179},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#azure-key-vault",{"_3268":68129,"_28512":68119,"_5":28852,"_19817":115445,"_25978":115446,"_2758":115447},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3268":68130,"_28512":68119,"_5":28852,"_19817":115449,"_25978":115450,"_2758":115451},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3268":68131,"_28512":68119,"_5":28852,"_19817":115453,"_25978":115454,"_2758":115455},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3268":68132,"_28512":68119,"_5":28852,"_19817":115457,"_25978":115458,"_2758":115459},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3268":68133,"_28512":68119,"_5":28852,"_19817":115461,"_25978":115462,"_2758":115463},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3268":68134,"_28512":68119,"_5":28852,"_19817":115465,"_25978":115466,"_2758":115467},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3268":68135,"_28512":68119,"_5":28852,"_19817":115469,"_25978":115470,"_2758":115471},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3268":68136,"_28512":68119,"_5":28852,"_19817":115473,"_25978":115474,"_2758":53211},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#sign",{"_3268":68137,"_28512":68119,"_5":28852,"_19817":115476,"_25978":115477,"_2758":53215},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#verify",{"_3268":68138,"_28512":68119,"_5":28852,"_19817":115479,"_25978":115480,"_2758":115481},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3268":68139,"_28512":68119,"_5":28852,"_19817":115483,"_25978":115484,"_2758":115485},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3268":68140,"_28512":68119,"_5":28852,"_19817":115487,"_25978":115488,"_2758":115489},[],"/docs/pr-preview/pr-43/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3268":68141,"_28512":68119,"_19817":115491,"_5":13545,"_25978":68119,"_2758":115492},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3268":68142,"_28512":68119,"_19817":115494,"_5":13545,"_25978":68119,"_2758":115495},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3268":68143,"_28512":68119,"_19817":115497,"_5":13545,"_25978":115420,"_2758":115498},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3268":68144,"_28512":68119,"_19817":115500,"_5":13545,"_25978":115420,"_2758":115501},[],"En la práctica, permite:",{"_3268":68145,"_28512":68119,"_19817":115503,"_5":13545,"_25978":115420,"_2758":115504},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3268":68146,"_28512":68119,"_19817":115506,"_5":13545,"_25978":115420,"_2758":115507},[],"Importar claves creadas externamente.",{"_3268":68147,"_28512":68119,"_19817":115509,"_5":13545,"_25978":115420,"_2758":115510},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3268":68148,"_28512":68119,"_19817":115512,"_5":13545,"_25978":115420,"_2758":115513},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3268":68149,"_28512":68119,"_19817":115515,"_5":13545,"_25978":115424,"_2758":115516},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3268":68150,"_28512":68119,"_19817":115518,"_5":13545,"_25978":115424,"_2758":115519},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3268":68151,"_28512":68119,"_19817":115521,"_5":13545,"_25978":115424,"_2758":115522},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3268":68152,"_28512":68119,"_19817":115524,"_5":13545,"_25978":115428,"_2758":115525},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3268":68153,"_28512":68119,"_19817":115527,"_5":13545,"_25978":115431,"_2758":115528},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3268":68154,"_28512":68119,"_19817":115530,"_5":13545,"_25978":115431,"_2758":115531},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3268":68155,"_28512":68119,"_19817":115533,"_5":13545,"_25978":115434,"_2758":115534},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3268":68156,"_28512":68119,"_19817":115536,"_5":13545,"_25978":115437,"_2758":115537},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3268":68157,"_28512":68119,"_19817":115539,"_5":13545,"_25978":115440,"_2758":115540},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3268":68158,"_28512":68119,"_19817":115542,"_5":13545,"_25978":115443,"_2758":115543},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3268":68159,"_28512":68119,"_19817":115545,"_5":13545,"_25978":115443,"_2758":115546},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3268":68160,"_28512":68119,"_19817":115548,"_5":13545,"_25978":115443,"_2758":115549},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3268":68161,"_28512":68119,"_19817":115551,"_5":13545,"_25978":115443,"_2758":115552},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3268":68162,"_28512":68119,"_19817":115554,"_5":13545,"_25978":115446,"_2758":115555},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3268":68163,"_28512":68119,"_19817":115557,"_5":13545,"_25978":115446,"_2758":115558},[],"La tabla incluye los siguientes campos:",{"_3268":68164,"_28512":68119,"_19817":115560,"_5":13545,"_25978":115446,"_2758":115561},[],"**Name**: nombre descriptivo de la clave.",{"_3268":68165,"_28512":68119,"_19817":115563,"_5":13545,"_25978":115446,"_2758":115564},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3268":68166,"_28512":68119,"_19817":115566,"_5":13545,"_25978":115446,"_2758":115567},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3268":68167,"_28512":68119,"_19817":115569,"_5":13545,"_25978":115446,"_2758":115570},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3268":68168,"_28512":68119,"_19817":115572,"_5":13545,"_25978":115446,"_2758":115573},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3268":68169,"_28512":68119,"_19817":115575,"_5":13545,"_25978":115446,"_2758":115576},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3268":68170,"_28512":68119,"_19817":115578,"_5":13545,"_25978":115446,"_2758":115579},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3268":68171,"_28512":68119,"_19817":115581,"_5":13545,"_25978":115446,"_2758":115582},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3268":68172,"_28512":68119,"_19817":115584,"_5":13545,"_25978":115446,"_2758":115585},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3268":68173,"_28512":68119,"_19817":115587,"_5":13545,"_25978":115446,"_2758":115588},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3268":68174,"_28512":68119,"_19817":115590,"_5":13545,"_25978":115446,"_2758":115591},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3268":68175,"_28512":68119,"_19817":115593,"_5":13545,"_25978":115446,"_2758":115594},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3268":68176,"_28512":68119,"_19817":115596,"_5":13545,"_25978":115446,"_2758":115597},[],"**Delete Key** para eliminar la clave del sistema.",{"_3268":68177,"_28512":68119,"_19817":115599,"_5":13545,"_25978":115450,"_2758":115600},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3268":68178,"_28512":68119,"_19817":115602,"_5":13545,"_25978":115454,"_2758":115603},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3268":68179,"_28512":68119,"_19817":115605,"_5":13545,"_25978":115454,"_2758":115606},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3268":68180,"_28512":68119,"_19817":115608,"_5":13545,"_25978":115454,"_2758":115609},[],"**Key Name**: nombre único y descriptivo.",{"_3268":68181,"_28512":68119,"_19817":115611,"_5":13545,"_25978":115454,"_2758":115612},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3268":68182,"_28512":68119,"_19817":115614,"_5":13545,"_25978":115454,"_2758":115615},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3268":68183,"_28512":68119,"_19817":115617,"_5":13545,"_25978":115454,"_2758":115618},[],"**Tags**: metadatos para clasificar la clave.",{"_3268":68184,"_28512":68119,"_19817":115620,"_5":13545,"_25978":115454,"_2758":115621},[],"**Metadata**: información adicional para usos avanzados.",{"_3268":68185,"_28512":68119,"_19817":115623,"_5":13545,"_25978":115458,"_2758":115624},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3268":68186,"_28512":68119,"_19817":115626,"_5":13545,"_25978":115458,"_2758":115627},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3268":68187,"_28512":68119,"_19817":115629,"_5":13545,"_25978":115458,"_2758":115630},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3268":68188,"_28512":68119,"_19817":115632,"_5":13545,"_25978":115458,"_2758":115633},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3268":68189,"_28512":68119,"_19817":115635,"_5":13545,"_25978":115458,"_2758":115636},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3268":68190,"_28512":68119,"_19817":115638,"_5":13545,"_25978":115458,"_2758":115639},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3268":68191,"_28512":68119,"_19817":115641,"_5":13545,"_25978":115458,"_2758":115642},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3268":68192,"_28512":68119,"_19817":115644,"_5":13545,"_25978":115458,"_2758":115645},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3268":68193,"_28512":68119,"_19817":115647,"_5":13545,"_25978":115458,"_2758":115648},[],"**Metadata**: información adicional opcional.",{"_3268":68194,"_28512":68119,"_19817":115650,"_5":13545,"_25978":115458,"_2758":115651},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3268":68195,"_28512":68119,"_19817":115653,"_5":13545,"_25978":115458,"_2758":115654},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3268":68196,"_28512":68119,"_19817":115656,"_5":13545,"_25978":115462,"_2758":115657},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3268":68197,"_28512":68119,"_19817":115659,"_5":13545,"_25978":115466,"_2758":115660},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3268":68198,"_28512":68119,"_19817":115662,"_5":13545,"_25978":115466,"_2758":115663},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3268":68199,"_28512":68119,"_19817":115665,"_5":13545,"_25978":115466,"_2758":115666},[],"**Key Name**: nombre descriptivo.",{"_3268":68200,"_28512":68119,"_19817":115668,"_5":13545,"_25978":115466,"_2758":115669},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3268":68201,"_28512":68119,"_19817":115671,"_5":13545,"_25978":115466,"_2758":115672},[],"**Tags**: etiquetas asociadas.",{"_3268":68202,"_28512":68119,"_19817":115674,"_5":13545,"_25978":115466,"_2758":115675},[],"**Aliases**: nombres alternativos.",{"_3268":68203,"_28512":68119,"_19817":115677,"_5":13545,"_25978":115466,"_2758":115678},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3268":68204,"_28512":68119,"_19817":115680,"_5":13545,"_25978":115466,"_2758":115681},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3268":68205,"_28512":68119,"_19817":115683,"_5":13545,"_25978":115466,"_2758":115684},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3268":68206,"_28512":68119,"_19817":115686,"_5":13545,"_25978":115466,"_2758":115687},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3268":68207,"_28512":68119,"_19817":115689,"_5":13545,"_25978":115470,"_2758":115690},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3268":68208,"_28512":68119,"_19817":115692,"_5":13545,"_25978":115470,"_2758":115693},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3268":68209,"_28512":68119,"_19817":115695,"_5":13545,"_25978":115470,"_2758":115696},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3268":68210,"_28512":68119,"_19817":115698,"_5":13545,"_25978":115474,"_2758":115699},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3268":68211,"_28512":68119,"_19817":115701,"_5":13545,"_25978":115474,"_2758":115702},[],"Campos principales:",{"_3268":68212,"_28512":68119,"_19817":115704,"_5":13545,"_25978":115474,"_2758":115705},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3268":68213,"_28512":68119,"_19817":115707,"_5":13545,"_25978":115474,"_2758":115708},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3268":68214,"_28512":68119,"_19817":115710,"_5":13545,"_25978":115474,"_2758":115711},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3268":68215,"_28512":68119,"_19817":115713,"_5":13545,"_25978":115474,"_2758":115714},[],"**Message**: contenido que se va a firmar.",{"_3268":68216,"_28512":68119,"_19817":115716,"_5":13545,"_25978":115474,"_2758":115717},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3268":68217,"_28512":68119,"_19817":115719,"_5":13545,"_25978":115477,"_2758":115720},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3268":68218,"_28512":68119,"_19817":115722,"_5":13545,"_25978":115477,"_2758":115702},[],{"_3268":68219,"_28512":68119,"_19817":115724,"_5":13545,"_25978":115477,"_2758":115725},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3268":68220,"_28512":68119,"_19817":115727,"_5":13545,"_25978":115477,"_2758":115728},[],"**Message Type**: `Raw` o `Digest`.",{"_3268":68221,"_28512":68119,"_19817":115730,"_5":13545,"_25978":115477,"_2758":115731},[],"**Payload Encoding**: codificación del mensaje.",{"_3268":68222,"_28512":68119,"_19817":115733,"_5":13545,"_25978":115477,"_2758":115734},[],"**Message**: mensaje original o hash.",{"_3268":68223,"_28512":68119,"_19817":115736,"_5":13545,"_25978":115477,"_2758":115737},[],"**Signature**: firma que se desea comprobar.",{"_3268":68224,"_28512":68119,"_19817":115739,"_5":13545,"_25978":115477,"_2758":115740},[],"**Result**: indicador del resultado de la validación.",{"_3268":68225,"_28512":68119,"_19817":115742,"_5":13545,"_25978":115480,"_2758":115743},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3268":68226,"_28512":68119,"_19817":115745,"_5":13545,"_25978":115480,"_2758":115746},[],"Este flujo es útil para:",{"_3268":68227,"_28512":68119,"_19817":115748,"_5":13545,"_25978":115480,"_2758":115749},[],"Solicitar certificados a una CA externa.",{"_3268":68228,"_28512":68119,"_19817":115751,"_5":13545,"_25978":115480,"_2758":115752},[],"Renovar una identidad manteniendo la misma clave.",{"_3268":68229,"_28512":68119,"_19817":115754,"_5":13545,"_25978":115480,"_2758":115755},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3268":68230,"_28512":68119,"_19817":115757,"_5":13545,"_25978":115480,"_2758":115758},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3268":68231,"_28512":68119,"_19817":115760,"_5":13545,"_25978":115480,"_2758":115761},[],"**Organization (O)**: organización o empresa.",{"_3268":68232,"_28512":68119,"_19817":115763,"_5":13545,"_25978":115480,"_2758":115764},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3268":68233,"_28512":68119,"_19817":115766,"_5":13545,"_25978":115480,"_2758":115767},[],"**Country (C)**: código de país de dos letras.",{"_3268":68234,"_28512":68119,"_19817":115769,"_5":13545,"_25978":115480,"_2758":115770},[],"**State / Province (ST)**: estado o provincia.",{"_3268":68235,"_28512":68119,"_19817":115772,"_5":13545,"_25978":115480,"_2758":115773},[],"**Locality (L)**: ciudad o localidad.",{"_3268":68236,"_28512":68119,"_19817":115775,"_5":13545,"_25978":115480,"_2758":115776},[],"**Email Address**: correo de contacto.",{"_3268":68237,"_28512":68119,"_19817":115778,"_5":13545,"_25978":115480,"_2758":115779},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3268":68238,"_28512":68119,"_19817":115781,"_5":13545,"_25978":115480,"_2758":115782},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3268":68239,"_28512":68119,"_19817":115784,"_5":13545,"_25978":115484,"_2758":115785},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3268":68240,"_28512":68119,"_19817":115787,"_5":13545,"_25978":115484,"_2758":53526},[],{"_3268":68241,"_28512":68119,"_19817":115789,"_5":13545,"_25978":115488,"_2758":115790},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3268":68242,"_28512":68242,"_5":13876,"_2758":115792,"_28855":115793,"_19817":115794,"_25978":68242},"Validación online con OCSP",[46447,110303,51840,114739],[],{"_3268":68243,"_28512":68242,"_19817":115796,"_5":13545,"_25978":68242,"_2758":115797},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3268":68244,"_28512":68242,"_5":28852,"_19817":115799,"_25978":115800,"_2758":115801},[],"/docs/pr-preview/pr-43/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3268":68245,"_28512":68242,"_5":28852,"_19817":115803,"_25978":115804,"_2758":115805},[],"/docs/pr-preview/pr-43/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3268":68246,"_28512":68242,"_5":28852,"_19817":115807,"_25978":115808,"_2758":115809},[],"/docs/pr-preview/pr-43/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3268":68247,"_28512":68242,"_5":28852,"_19817":115811,"_25978":115812,"_2758":115813},[],"/docs/pr-preview/pr-43/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3268":68248,"_28512":68242,"_5":28852,"_19817":115815,"_25978":115816,"_2758":115817},[],"/docs/pr-preview/pr-43/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3268":68249,"_28512":68242,"_5":28852,"_19817":115819,"_25978":115820,"_2758":115283},[],"/docs/pr-preview/pr-43/es/platform/pki/ocsp#referencias",{"_3268":68250,"_28512":68242,"_19817":115822,"_5":13545,"_25978":68242,"_2758":115823},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3268":68251,"_28512":68242,"_19817":115825,"_5":13545,"_25978":115800,"_2758":115826},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3268":68252,"_28512":68242,"_19817":115828,"_5":13545,"_25978":115800,"_2758":115829},[],"Estado del registro",{"_3268":68253,"_28512":68242,"_19817":115831,"_5":13545,"_25978":115800,"_2758":115832},[],"Respuesta firmada",{"_3268":68254,"_28512":68242,"_19817":115834,"_5":13545,"_25978":115800,"_2758":51011},[],{"_3268":68255,"_28512":68242,"_19817":115836,"_5":13545,"_25978":115800,"_2758":53576},[],{"_3268":68256,"_28512":68242,"_19817":115838,"_5":13545,"_25978":115800,"_2758":51028},[],{"_3268":68257,"_28512":68242,"_19817":115840,"_5":13545,"_25978":115800,"_2758":115841},[],"`Revoked`, con razón y fecha de revocación.",{"_3268":68258,"_28512":68242,"_19817":115843,"_5":13545,"_25978":115800,"_2758":115844},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3268":68259,"_28512":68242,"_19817":115846,"_5":13545,"_25978":115800,"_2758":115847},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3268":68260,"_28512":68242,"_19817":115849,"_5":13545,"_25978":115800,"_2758":115850},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3268":68261,"_28512":68242,"_19817":115852,"_5":13545,"_25978":115800,"_2758":115853},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3268":68262,"_28512":68242,"_19817":115855,"_5":13545,"_25978":115800,"_2758":115856},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3268":68263,"_28512":68242,"_19817":115858,"_5":13545,"_25978":115804,"_2758":115859},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3268":68264,"_28512":68242,"_19817":115861,"_5":13545,"_25978":115804,"_2758":115862},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3268":68265,"_28512":68242,"_19817":115864,"_5":13545,"_25978":115808,"_2758":115865},[],"El servicio acepta:",{"_3268":68266,"_28512":68242,"_19817":115867,"_5":13545,"_25978":115808,"_2758":112027},[],{"_3268":68267,"_28512":68242,"_19817":115869,"_5":13545,"_25978":115808,"_2758":115870},[],"Ruta del servicio VA",{"_3268":68268,"_28512":68242,"_19817":115872,"_5":13545,"_25978":115808,"_2758":115873},[],"Formato",{"_3268":68269,"_28512":68242,"_19817":115875,"_5":13545,"_25978":115808,"_2758":53616},[],{"_3268":68270,"_28512":68242,"_19817":115877,"_5":13545,"_25978":115808,"_2758":53619},[],{"_3268":68271,"_28512":68242,"_19817":115879,"_5":13545,"_25978":115808,"_2758":115880},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3268":68272,"_28512":68242,"_19817":115882,"_5":13545,"_25978":115808,"_2758":53102},[],{"_3268":68273,"_28512":68242,"_19817":115884,"_5":13545,"_25978":115808,"_2758":53627},[],{"_3268":68274,"_28512":68242,"_19817":115886,"_5":13545,"_25978":115808,"_2758":115887},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3268":68275,"_28512":68242,"_19817":115889,"_5":13545,"_25978":115808,"_2758":115890},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3268":68276,"_28512":68242,"_19817":115892,"_5":13545,"_25978":115812,"_2758":115893},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3268":68277,"_28512":68242,"_19817":115895,"_5":13545,"_25978":115812,"_2758":115896},[],"Genera la solicitud:",{"_3268":68278,"_28512":68242,"_19817":115898,"_5":13545,"_25978":115812,"_2758":115899},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3268":68279,"_28512":68242,"_19817":115901,"_5":13545,"_25978":115812,"_2758":115902},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3268":68280,"_28512":68242,"_19817":115904,"_5":13545,"_25978":115812,"_2758":115905},[],"Verifica el DER recibido:",{"_3268":68281,"_28512":68242,"_19817":115907,"_5":13545,"_25978":115812,"_2758":115908},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3268":68282,"_28512":68242,"_19817":115910,"_5":13545,"_25978":115816,"_2758":115911},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3268":68283,"_28512":68242,"_19817":115913,"_5":13545,"_25978":115816,"_2758":115914},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3268":68284,"_28512":68242,"_19817":115916,"_5":13545,"_25978":115820,"_2758":53660},[],{"_3268":68285,"_28512":68242,"_19817":115918,"_5":13545,"_25978":115820,"_2758":53663},[],{"_3268":68286,"_28512":68242,"_19817":115920,"_5":13545,"_25978":115820,"_2758":115921},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3268":68287,"_28512":68242,"_19817":115923,"_5":13545,"_25978":115820,"_2758":115410},[],{"_3268":68288,"_28512":68288,"_5":13876,"_2758":51840,"_28855":115925,"_19817":115926,"_25978":68288},[46447,110303,51840],[],{"_3268":68289,"_28512":68288,"_19817":115928,"_5":13545,"_25978":68288,"_2758":115929},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3268":68290,"_28512":68288,"_5":28852,"_19817":115931,"_25978":115932,"_2758":113450},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#empieza-aquí",{"_3268":68291,"_28512":68288,"_5":28852,"_19817":115934,"_25978":115935,"_2758":115936},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3268":68292,"_28512":68288,"_5":28852,"_19817":115938,"_25978":115939,"_2758":113970},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#capacidades-principales",{"_3268":68293,"_28512":68288,"_5":28852,"_19817":115941,"_25978":115942,"_2758":113974},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3268":68294,"_28512":68288,"_5":28852,"_19817":115944,"_25978":115945,"_2758":113978},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3268":68295,"_28512":68288,"_5":28852,"_19817":115947,"_25978":115948,"_2758":113982},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#emite-y-controla-certificados",{"_3268":68296,"_28512":68288,"_5":28852,"_19817":115950,"_25978":115951,"_2758":113990},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#publica-el-estado-de-validación",{"_3268":68297,"_28512":68288,"_5":28852,"_19817":115953,"_25978":115954,"_2758":115955},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3268":68298,"_28512":68288,"_5":28852,"_19817":115957,"_25978":115958,"_2758":114905},[],"/docs/pr-preview/pr-43/es/platform/pki/overview#continúa",{"_3268":68299,"_28512":68288,"_19817":115960,"_5":13545,"_25978":68288,"_2758":115961},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3268":68300,"_28512":68288,"_19817":115963,"_5":13545,"_25978":115932,"_2758":115964},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3268":68301,"_28512":68288,"_19817":115966,"_5":13545,"_25978":115932,"_2758":115967},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3268":68302,"_28512":68288,"_19817":115969,"_5":13545,"_25978":115935,"_2758":115970},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3268":68303,"_28512":68288,"_19817":115972,"_5":13545,"_25978":115935,"_2758":115973},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3268":68304,"_28512":68288,"_19817":115975,"_5":13545,"_25978":115935,"_2758":115976},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3268":68305,"_28512":68288,"_19817":115978,"_5":13545,"_25978":115935,"_2758":115979},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3268":68306,"_28512":68288,"_19817":115981,"_5":13545,"_25978":115935,"_2758":115982},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3268":68307,"_28512":68288,"_19817":115984,"_5":13545,"_25978":115942,"_2758":115985},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3268":68308,"_28512":68288,"_19817":115987,"_5":13545,"_25978":115945,"_2758":115988},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3268":68309,"_28512":68288,"_19817":115990,"_5":13545,"_25978":115948,"_2758":115991},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3268":68310,"_28512":68288,"_19817":115993,"_5":13545,"_25978":115951,"_2758":115994},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3268":68311,"_28512":68288,"_19817":115996,"_5":13545,"_25978":115954,"_2758":115997},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3268":68312,"_28512":68288,"_19817":115999,"_5":13545,"_25978":115954,"_2758":116000},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3268":68313,"_28512":68288,"_19817":116002,"_5":13545,"_25978":115954,"_2758":116003},[],"su clave pública corresponda a la clave privada del cliente;",{"_3268":68314,"_28512":68288,"_19817":116005,"_5":13545,"_25978":115954,"_2758":116006},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3268":68315,"_28512":68288,"_19817":116008,"_5":13545,"_25978":115954,"_2758":116009},[],"sus fechas y usos permitan la operación;",{"_3268":68316,"_28512":68288,"_19817":116011,"_5":13545,"_25978":115954,"_2758":116012},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3268":68317,"_28512":68288,"_19817":116014,"_5":13545,"_25978":115954,"_2758":116015},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3268":68318,"_28512":68288,"_19817":116017,"_5":13545,"_25978":115958,"_2758":116018},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3268":68319,"_28512":68288,"_19817":116020,"_5":13545,"_25978":115958,"_2758":116021},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3268":68320,"_28512":68288,"_19817":116023,"_5":13545,"_25978":115958,"_2758":116024},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3268":68321,"_28512":68321,"_5":13876,"_2758":116026,"_28855":116027,"_19817":116028,"_25978":68321},"Crea tu primera CA",[46447,110303,51840,113574],[],{"_3268":68322,"_28512":68321,"_19817":116030,"_5":13545,"_25978":68321,"_2758":116031},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3268":68323,"_28512":68321,"_5":28852,"_19817":116033,"_25978":116034,"_2758":108956},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3268":68324,"_28512":68321,"_5":28852,"_19817":116036,"_25978":116037,"_2758":116038},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3268":68325,"_28512":68321,"_5":28852,"_19817":116040,"_25978":116041,"_2758":116042},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3268":68326,"_28512":68321,"_5":28852,"_19817":116044,"_25978":116045,"_2758":116046},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3268":68327,"_28512":68321,"_5":28852,"_19817":116048,"_25978":116049,"_2758":116050},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3268":68328,"_28512":68321,"_5":28852,"_19817":116052,"_25978":116053,"_2758":116054},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3268":68329,"_28512":68321,"_5":28852,"_19817":116056,"_25978":116057,"_2758":116058},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3268":68330,"_28512":68321,"_5":28852,"_19817":116060,"_25978":116061,"_2758":113821},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3268":68331,"_28512":68321,"_5":28852,"_19817":116063,"_25978":116064,"_2758":108980},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3268":68332,"_28512":68321,"_19817":116066,"_5":13545,"_25978":68321,"_2758":116067},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3268":68333,"_28512":68321,"_19817":116069,"_5":13545,"_25978":116034,"_2758":116070},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3268":68334,"_28512":68321,"_19817":116072,"_5":13545,"_25978":116034,"_2758":116073},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3268":68335,"_28512":68321,"_19817":116075,"_5":13545,"_25978":116034,"_2758":116076},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3268":68336,"_28512":68321,"_19817":116078,"_5":13545,"_25978":116034,"_2758":116079},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3268":68337,"_28512":68321,"_19817":116081,"_5":13545,"_25978":116037,"_2758":116082},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3268":68338,"_28512":68321,"_19817":116084,"_5":13545,"_25978":116037,"_2758":116085},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3268":68339,"_28512":68321,"_19817":116087,"_5":13545,"_25978":116041,"_2758":116088},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3268":68340,"_28512":68321,"_19817":116090,"_5":13545,"_25978":116041,"_2758":116091},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3268":68341,"_28512":68321,"_19817":116093,"_5":13545,"_25978":116045,"_2758":116094},[],"Selecciona **Root CA** y completa:",{"_3268":68342,"_28512":68321,"_19817":116096,"_5":13545,"_25978":116045,"_2758":53842},[],{"_3268":68343,"_28512":68321,"_19817":116098,"_5":13545,"_25978":116045,"_2758":116099},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3268":68344,"_28512":68321,"_19817":116101,"_5":13545,"_25978":116045,"_2758":116102},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3268":68345,"_28512":68321,"_19817":116104,"_5":13545,"_25978":116045,"_2758":116105},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3268":68346,"_28512":68321,"_19817":116107,"_5":13545,"_25978":116045,"_2758":116108},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3268":68347,"_28512":68321,"_19817":116110,"_5":13545,"_25978":116049,"_2758":116111},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3268":68348,"_28512":68321,"_19817":116113,"_5":13545,"_25978":116053,"_2758":116114},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3268":68349,"_28512":68321,"_19817":116116,"_5":13545,"_25978":116053,"_2758":116117},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3268":68350,"_28512":68321,"_19817":116119,"_5":13545,"_25978":116057,"_2758":116120},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3268":68351,"_28512":68321,"_19817":116122,"_5":13545,"_25978":116057,"_2758":116123},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3268":68352,"_28512":68321,"_19817":116125,"_5":13545,"_25978":116057,"_2758":116126},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3268":68353,"_28512":68321,"_19817":116128,"_5":13545,"_25978":116061,"_2758":116129},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3268":68354,"_28512":68321,"_19817":116131,"_5":13545,"_25978":116061,"_2758":116132},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3268":68355,"_28512":68321,"_19817":116134,"_5":13545,"_25978":116061,"_2758":116135},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3268":68356,"_28512":68321,"_19817":116137,"_5":13545,"_25978":116061,"_2758":116138},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3268":68357,"_28512":68321,"_19817":116140,"_5":13545,"_25978":116064,"_2758":116141},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3268":68358,"_28512":68358,"_5":13876,"_2758":116143,"_28855":116144,"_19817":116145,"_25978":68358},"Emite y verifica un certificado",[46447,110303,51840,113574],[],{"_3268":68359,"_28512":68358,"_19817":116147,"_5":13545,"_25978":68358,"_2758":116148},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3268":68360,"_28512":68358,"_5":28852,"_19817":116150,"_25978":116151,"_2758":108956},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3268":68361,"_28512":68358,"_5":28852,"_19817":116153,"_25978":116154,"_2758":116155},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3268":68362,"_28512":68358,"_5":28852,"_19817":116157,"_25978":116158,"_2758":116159},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3268":68363,"_28512":68358,"_5":28852,"_19817":116161,"_25978":116162,"_2758":116163},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3268":68364,"_28512":68358,"_5":28852,"_19817":116165,"_25978":116166,"_2758":116167},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3268":68365,"_28512":68358,"_5":28852,"_19817":116169,"_25978":116170,"_2758":116171},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3268":68366,"_28512":68358,"_5":28852,"_19817":116173,"_25978":116174,"_2758":116175},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3268":68367,"_28512":68358,"_5":28852,"_19817":116177,"_25978":116178,"_2758":116179},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3268":68368,"_28512":68358,"_5":28852,"_19817":116181,"_25978":116182,"_2758":116183},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3268":68369,"_28512":68358,"_5":28852,"_19817":116185,"_25978":116186,"_2758":116187},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3268":68370,"_28512":68358,"_5":28852,"_19817":116189,"_25978":116190,"_2758":113821},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3268":68371,"_28512":68358,"_5":28852,"_19817":116192,"_25978":116193,"_2758":108980},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3268":68372,"_28512":68358,"_19817":116195,"_5":13545,"_25978":68358,"_2758":116196},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3268":68373,"_28512":68358,"_19817":116198,"_5":13545,"_25978":116151,"_2758":116199},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3268":68374,"_28512":68358,"_19817":116201,"_5":13545,"_25978":116151,"_2758":116202},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3268":68375,"_28512":68358,"_19817":116204,"_5":13545,"_25978":116151,"_2758":116205},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3268":68376,"_28512":68358,"_19817":116207,"_5":13545,"_25978":116151,"_2758":116208},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3268":68377,"_28512":68358,"_19817":116210,"_5":13545,"_25978":116151,"_2758":116211},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3268":68378,"_28512":68358,"_19817":116213,"_5":13545,"_25978":116154,"_2758":116214},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3268":68379,"_28512":68358,"_19817":116216,"_5":13545,"_25978":116158,"_2758":116217},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3268":68380,"_28512":68358,"_19817":116219,"_5":13545,"_25978":116158,"_2758":116220},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3268":68381,"_28512":68358,"_19817":116222,"_5":13545,"_25978":116162,"_2758":116223},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3268":68382,"_28512":68358,"_19817":116225,"_5":13545,"_25978":116162,"_2758":116226},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3268":68383,"_28512":68358,"_19817":116228,"_5":13545,"_25978":116166,"_2758":116229},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3268":68384,"_28512":68358,"_19817":116231,"_5":13545,"_25978":116166,"_2758":116232},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3268":68385,"_28512":68358,"_19817":116234,"_5":13545,"_25978":116170,"_2758":116235},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3268":68386,"_28512":68358,"_19817":116237,"_5":13545,"_25978":116174,"_2758":116238},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3268":68387,"_28512":68358,"_19817":116240,"_5":13545,"_25978":116178,"_2758":116241},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3268":68388,"_28512":68358,"_19817":116243,"_5":13545,"_25978":116182,"_2758":116244},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3268":68389,"_28512":68358,"_19817":116246,"_5":13545,"_25978":116182,"_2758":116247},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3268":68390,"_28512":68358,"_19817":116249,"_5":13545,"_25978":116182,"_2758":116250},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3268":68391,"_28512":68358,"_19817":116252,"_5":13545,"_25978":116186,"_2758":116253},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3268":68392,"_28512":68358,"_19817":116255,"_5":13545,"_25978":116186,"_2758":116256},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3268":68393,"_28512":68358,"_19817":116258,"_5":13545,"_25978":116186,"_2758":116259},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3268":68394,"_28512":68358,"_19817":116261,"_5":13545,"_25978":116190,"_2758":113904},[],{"_3268":68395,"_28512":68358,"_19817":116263,"_5":13545,"_25978":116190,"_2758":112476},[],{"_3268":68396,"_28512":68358,"_19817":116265,"_5":13545,"_25978":116190,"_2758":116266},[],"La CA rechaza la emisión",{"_3268":68397,"_28512":68358,"_19817":116268,"_5":13545,"_25978":116190,"_2758":116269},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3268":68398,"_28512":68358,"_19817":116271,"_5":13545,"_25978":116190,"_2758":116272},[],"Sujeto o usos diferentes",{"_3268":68399,"_28512":68358,"_19817":116274,"_5":13545,"_25978":116190,"_2758":116275},[],"Perfil aplicado y valores solicitados.",{"_3268":68400,"_28512":68358,"_19817":116277,"_5":13545,"_25978":116190,"_2758":116278},[],"No se encuentra el emisor",{"_3268":68401,"_28512":68358,"_19817":116280,"_5":13545,"_25978":116190,"_2758":116281},[],"CA descargada y cadena intermedia necesaria.",{"_3268":68402,"_28512":68358,"_19817":116283,"_5":13545,"_25978":116190,"_2758":116284},[],"Falla la vigencia",{"_3268":68403,"_28512":68358,"_19817":116286,"_5":13545,"_25978":116190,"_2758":116287},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3268":68404,"_28512":68358,"_19817":116289,"_5":13545,"_25978":116190,"_2758":116290},[],"Los resúmenes de clave difieren",{"_3268":68405,"_28512":68358,"_19817":116292,"_5":13545,"_25978":116190,"_2758":116293},[],"Archivos de certificado y clave de la misma emisión.",{"_3268":68406,"_28512":68358,"_19817":116295,"_5":13545,"_25978":116190,"_2758":116296},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3268":68407,"_28512":68358,"_19817":116298,"_5":13545,"_25978":116193,"_2758":116299},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3268":68408,"_28512":68358,"_19817":116301,"_5":13545,"_25978":116193,"_2758":116302},[],"Gestionar certificados para inspección, estado y revocación.",{"_3268":68409,"_28512":68358,"_19817":116304,"_5":13545,"_25978":116193,"_2758":116305},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3268":68410,"_28512":68358,"_19817":116307,"_5":13545,"_25978":116193,"_2758":116308},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3268":68411,"_28512":68358,"_19817":116310,"_5":13545,"_25978":116193,"_2758":116311},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3268":68412,"_28512":68412,"_5":13876,"_2758":116313,"_28855":116314,"_19817":116315,"_25978":68412},"Primeros pasos de PKI",[46447,110303,51840,113574],[],{"_3268":68413,"_28512":68412,"_19817":116317,"_5":13545,"_25978":68412,"_2758":116318},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3268":68414,"_28512":68412,"_5":28852,"_19817":116320,"_25978":116321,"_2758":108956},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3268":68415,"_28512":68412,"_5":28852,"_19817":116323,"_25978":116324,"_2758":116325},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3268":68416,"_28512":68412,"_5":28852,"_19817":116327,"_25978":116328,"_2758":113756},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3268":68417,"_28512":68412,"_5":28852,"_19817":116330,"_25978":116331,"_2758":116332},[],"/docs/pr-preview/pr-43/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3268":68418,"_28512":68412,"_19817":116334,"_5":13545,"_25978":68412,"_2758":116335},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3268":68419,"_28512":68412,"_19817":116337,"_5":13545,"_25978":116321,"_2758":116338},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3268":68420,"_28512":68412,"_19817":116340,"_5":13545,"_25978":116321,"_2758":116341},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3268":68421,"_28512":68412,"_19817":116343,"_5":13545,"_25978":116321,"_2758":116344},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3268":68422,"_28512":68412,"_19817":116346,"_5":13545,"_25978":116321,"_2758":116347},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3268":68423,"_28512":68412,"_19817":116349,"_5":13545,"_25978":116321,"_2758":116350},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3268":68424,"_28512":68412,"_19817":116352,"_5":13545,"_25978":116324,"_2758":116353},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3268":68425,"_28512":68412,"_19817":116355,"_5":13545,"_25978":116324,"_2758":116356},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3268":68426,"_28512":68412,"_19817":116358,"_5":13545,"_25978":116324,"_2758":116359},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3268":68427,"_28512":68412,"_19817":116361,"_5":13545,"_25978":116324,"_2758":116362},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3268":68428,"_28512":68412,"_19817":116364,"_5":13545,"_25978":116328,"_2758":116365},[],"Archivo o recurso",{"_3268":68429,"_28512":68412,"_19817":116367,"_5":13545,"_25978":116328,"_2758":113753},[],{"_3268":68430,"_28512":68412,"_19817":116369,"_5":13545,"_25978":116328,"_2758":116370},[],"CA raíz activa y `ca.pem`",{"_3268":68431,"_28512":68412,"_19817":116372,"_5":13545,"_25978":116328,"_2758":116373},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3268":68432,"_28512":68412,"_19817":116375,"_5":13545,"_25978":116328,"_2758":116376},[],"Certificado final y `device.crt`",{"_3268":68433,"_28512":68412,"_19817":116378,"_5":13545,"_25978":116328,"_2758":116379},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3268":68434,"_28512":68412,"_19817":116381,"_5":13545,"_25978":116328,"_2758":116382},[],"Clave privada `device.key`",{"_3268":68435,"_28512":68412,"_19817":116384,"_5":13545,"_25978":116328,"_2758":116385},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3268":68436,"_28512":68412,"_19817":116387,"_5":13545,"_25978":116328,"_2758":116388},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3268":68437,"_28512":68412,"_19817":116390,"_5":13545,"_25978":116331,"_2758":116391},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3268":68438,"_28512":68412,"_19817":116393,"_5":13545,"_25978":116331,"_2758":116394},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3268":68439,"_28512":68412,"_19817":116396,"_5":13545,"_25978":116331,"_2758":116397},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3268":68440,"_28512":68440,"_5":13876,"_2758":116399,"_28855":116400,"_19817":116402,"_25978":68440},"Resolución de problemas PKI",[46447,110303,51840,116401],"Resolución de problemas",[],{"_3268":68441,"_28512":68440,"_19817":116404,"_5":13545,"_25978":68440,"_2758":116405},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3268":68442,"_28512":68440,"_5":28852,"_19817":116407,"_25978":116408,"_2758":116409},[],"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3268":68443,"_28512":68440,"_5":28852,"_19817":116411,"_25978":116412,"_2758":116413},[],"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3268":68444,"_28512":68440,"_5":28852,"_19817":116415,"_25978":116416,"_2758":116417},[],"/docs/pr-preview/pr-43/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3268":68445,"_28512":68440,"_19817":116419,"_5":13545,"_25978":68440,"_2758":116420},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3268":68446,"_28512":68440,"_19817":116422,"_5":13545,"_25978":68440,"_2758":116423},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3268":68447,"_28512":68440,"_19817":116425,"_5":13545,"_25978":116408,"_2758":113753},[],{"_3268":68448,"_28512":68440,"_19817":116427,"_5":13545,"_25978":116408,"_2758":112476},[],{"_3268":68449,"_28512":68440,"_19817":116429,"_5":13545,"_25978":116408,"_2758":108980},[],{"_3268":68450,"_28512":68440,"_19817":116431,"_5":13545,"_25978":116408,"_2758":50685},[],{"_3268":68451,"_28512":68440,"_19817":116433,"_5":13545,"_25978":116408,"_2758":116434},[],"Existe, está activa y sus fechas son utilizables.",{"_3268":68452,"_28512":68440,"_19817":116436,"_5":13545,"_25978":116408,"_2758":116437},[],"Autoridades.",{"_3268":68453,"_28512":68440,"_19817":116439,"_5":13545,"_25978":116408,"_2758":116440},[],"Clave",{"_3268":68454,"_28512":68440,"_19817":116442,"_5":13545,"_25978":116408,"_2758":116443},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3268":68455,"_28512":68440,"_19817":116445,"_5":13545,"_25978":116408,"_2758":116446},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3268":68456,"_28512":68440,"_19817":116448,"_5":13545,"_25978":116408,"_2758":54196},[],{"_3268":68457,"_28512":68440,"_19817":116450,"_5":13545,"_25978":116408,"_2758":116451},[],"PEM correcto y firma verificable.",{"_3268":68458,"_28512":68440,"_19817":116453,"_5":13545,"_25978":116408,"_2758":54202},[],{"_3268":68459,"_28512":68440,"_19817":116455,"_5":13545,"_25978":116408,"_2758":116456},[],"Perfil",{"_3268":68460,"_28512":68440,"_19817":116458,"_5":13545,"_25978":116408,"_2758":116459},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3268":68461,"_28512":68440,"_19817":116461,"_5":13545,"_25978":116408,"_2758":116462},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3268":68462,"_28512":68440,"_19817":116464,"_5":13545,"_25978":116408,"_2758":113904},[],{"_3268":68463,"_28512":68440,"_19817":116466,"_5":13545,"_25978":116408,"_2758":116467},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3268":68464,"_28512":68440,"_19817":116469,"_5":13545,"_25978":116408,"_2758":116470},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3268":68465,"_28512":68440,"_19817":116472,"_5":13545,"_25978":116408,"_2758":116473},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3268":68466,"_28512":68440,"_19817":116475,"_5":13545,"_25978":116408,"_2758":116476},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3268":68467,"_28512":68440,"_19817":116478,"_5":13545,"_25978":116412,"_2758":116479},[],"Revisa cada frontera por separado:",{"_3268":68468,"_28512":68440,"_19817":116481,"_5":13545,"_25978":116412,"_2758":116482},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3268":68469,"_28512":68440,"_19817":116484,"_5":13545,"_25978":116412,"_2758":116485},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3268":68470,"_28512":68440,"_19817":116487,"_5":13545,"_25978":116412,"_2758":116488},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3268":68471,"_28512":68440,"_19817":116490,"_5":13545,"_25978":116412,"_2758":116491},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3268":68472,"_28512":68440,"_19817":116493,"_5":13545,"_25978":116412,"_2758":116494},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3268":68473,"_28512":68440,"_19817":116496,"_5":13545,"_25978":116412,"_2758":116497},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3268":68474,"_28512":68440,"_19817":116499,"_5":13545,"_25978":116416,"_2758":116500},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3268":68475,"_28512":68440,"_19817":116502,"_5":13545,"_25978":116416,"_2758":116503},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3268":68476,"_28512":68476,"_5":13876,"_2758":116505,"_28855":116506,"_19817":116508,"_25978":68476},"3.8.0 a 4.0.0",[46447,116507],"Actualizaciones",[],{"_3268":68477,"_28512":68476,"_19817":116510,"_5":13545,"_25978":68476,"_2758":116511},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3268":68478,"_28512":68476,"_5":28852,"_19817":116513,"_25978":116514,"_2758":116515},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3268":68479,"_28512":68476,"_5":28852,"_19817":116517,"_25978":116518,"_2758":116519},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3268":68480,"_28512":68476,"_5":28852,"_19817":116521,"_25978":116522,"_2758":116523},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3268":68481,"_28512":68476,"_5":28852,"_19817":116525,"_25978":116526,"_2758":116527},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3268":68482,"_28512":68476,"_5":28852,"_19817":116529,"_25978":116530,"_2758":116531},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3268":68483,"_28512":68476,"_5":28852,"_19817":116533,"_25978":116534,"_2758":116535},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3268":68484,"_28512":68476,"_5":28852,"_19817":116537,"_25978":116538,"_2758":54288},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3268":68485,"_28512":68476,"_5":28852,"_19817":116540,"_25978":116541,"_2758":116542},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3268":68486,"_28512":68476,"_5":28852,"_19817":116544,"_25978":116545,"_2758":116546},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3268":68487,"_28512":68476,"_5":28852,"_19817":116548,"_25978":116549,"_2758":116550},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3268":68488,"_28512":68476,"_5":28852,"_19817":116552,"_25978":116553,"_2758":116554},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3268":68489,"_28512":68476,"_5":28852,"_19817":116556,"_25978":116557,"_2758":116558},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3268":68490,"_28512":68476,"_5":28852,"_19817":116560,"_25978":116561,"_2758":116562},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3268":68491,"_28512":68476,"_5":28852,"_19817":116564,"_25978":116565,"_2758":116566},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3268":68492,"_28512":68476,"_5":28852,"_19817":116568,"_25978":116569,"_2758":116570},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3268":68493,"_28512":68476,"_5":28852,"_19817":116572,"_25978":116573,"_2758":116574},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3268":68494,"_28512":68476,"_5":28852,"_19817":116576,"_25978":116577,"_2758":116578},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3268":68495,"_28512":68476,"_5":28852,"_19817":116580,"_25978":116581,"_2758":116582},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3268":68496,"_28512":68476,"_5":28852,"_19817":116584,"_25978":116585,"_2758":116586},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3268":68497,"_28512":68476,"_5":28852,"_19817":116588,"_25978":116589,"_2758":116590},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3268":68498,"_28512":68476,"_5":28852,"_19817":116592,"_25978":116593,"_2758":116594},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3268":68499,"_28512":68476,"_5":28852,"_19817":116596,"_25978":116597,"_2758":116598},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3268":68500,"_28512":68476,"_5":28852,"_19817":116600,"_25978":116601,"_2758":116602},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3268":68501,"_28512":68476,"_5":28852,"_19817":116604,"_25978":116605,"_2758":116606},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3268":68502,"_28512":68476,"_5":28852,"_19817":116608,"_25978":116609,"_2758":116610},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3268":68503,"_28512":68476,"_5":28852,"_19817":116612,"_25978":116613,"_2758":116614},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3268":68504,"_28512":68476,"_5":28852,"_19817":116616,"_25978":116617,"_2758":116618},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3268":68505,"_28512":68476,"_5":28852,"_19817":116620,"_25978":116621,"_2758":116622},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3268":68506,"_28512":68476,"_5":28852,"_19817":116624,"_25978":116625,"_2758":116626},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3268":68507,"_28512":68476,"_5":28852,"_19817":116628,"_25978":116629,"_2758":116630},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3268":68508,"_28512":68476,"_5":28852,"_19817":116632,"_25978":116633,"_2758":116634},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3268":68509,"_28512":68476,"_5":28852,"_19817":116636,"_25978":116637,"_2758":116638},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3268":68510,"_28512":68476,"_5":28852,"_19817":116640,"_25978":116641,"_2758":116642},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3268":68511,"_28512":68476,"_5":28852,"_19817":116644,"_25978":116645,"_2758":112806},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3268":68512,"_28512":68476,"_5":28852,"_19817":116647,"_25978":116648,"_2758":116649},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3268":68513,"_28512":68476,"_5":28852,"_19817":116651,"_25978":116652,"_2758":116653},[],"/docs/pr-preview/pr-43/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3268":68514,"_28512":68476,"_19817":116655,"_5":13545,"_25978":68476,"_2758":116656},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3268":68515,"_28512":68476,"_19817":116658,"_5":13545,"_25978":68476,"_2758":116659},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3268":68516,"_28512":68476,"_19817":116661,"_5":13545,"_25978":68476,"_2758":116662},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3268":68517,"_28512":68476,"_19817":116664,"_5":13545,"_25978":68476,"_2758":116665},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3268":68518,"_28512":68476,"_19817":116667,"_5":13545,"_25978":68476,"_2758":116668},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3268":68519,"_28512":68476,"_19817":116670,"_5":13545,"_25978":68476,"_2758":116671},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3268":68520,"_28512":68476,"_19817":116673,"_5":13545,"_25978":68476,"_2758":116674},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3268":68521,"_28512":68476,"_19817":116676,"_5":13545,"_25978":116518,"_2758":116677},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3268":68522,"_28512":68476,"_19817":116679,"_5":13545,"_25978":116518,"_2758":116680},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3268":68523,"_28512":68476,"_19817":116682,"_5":13545,"_25978":116522,"_2758":116683},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3268":68524,"_28512":68476,"_19817":116685,"_5":13545,"_25978":116522,"_2758":116686},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3268":68525,"_28512":68476,"_19817":116688,"_5":13545,"_25978":116526,"_2758":116689},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3268":68526,"_28512":68476,"_19817":116691,"_5":13545,"_25978":116530,"_2758":116692},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3268":68527,"_28512":68476,"_19817":116694,"_5":13545,"_25978":116530,"_2758":116695},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3268":68528,"_28512":68476,"_19817":116697,"_5":13545,"_25978":116530,"_2758":116698},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3268":68529,"_28512":68476,"_19817":116700,"_5":13545,"_25978":116530,"_2758":116701},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3268":68530,"_28512":68476,"_19817":116703,"_5":13545,"_25978":116530,"_2758":116704},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3268":68531,"_28512":68476,"_19817":116706,"_5":13545,"_25978":116534,"_2758":116707},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3268":68532,"_28512":68476,"_19817":116709,"_5":13545,"_25978":116534,"_2758":116710},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3268":68533,"_28512":68476,"_19817":116712,"_5":13545,"_25978":116534,"_2758":116713},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3268":68534,"_28512":68476,"_19817":116715,"_5":13545,"_25978":116534,"_2758":116716},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3268":68535,"_28512":68476,"_19817":116718,"_5":13545,"_25978":116534,"_2758":116719},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3268":68536,"_28512":68476,"_19817":116721,"_5":13545,"_25978":116538,"_2758":116722},[],"Cambio",{"_3268":68537,"_28512":68476,"_19817":116724,"_5":13545,"_25978":116538,"_2758":116725},[],"A quién afecta",{"_3268":68538,"_28512":68476,"_19817":116727,"_5":13545,"_25978":116538,"_2758":116728},[],"Gravedad",{"_3268":68539,"_28512":68476,"_19817":116730,"_5":13545,"_25978":116538,"_2758":116731},[],"Acción",{"_3268":68540,"_28512":68476,"_19817":116733,"_5":13545,"_25978":116538,"_2758":116546},[],{"_3268":68541,"_28512":68476,"_19817":116735,"_5":13545,"_25978":116538,"_2758":116736},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3268":68542,"_28512":68476,"_19817":116738,"_5":13545,"_25978":116538,"_2758":116739},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3268":68543,"_28512":68476,"_19817":116741,"_5":13545,"_25978":116538,"_2758":116742},[],"Copiar los datos a los volúmenes nuevos",{"_3268":68544,"_28512":68476,"_19817":116744,"_5":13545,"_25978":116538,"_2758":116550},[],{"_3268":68545,"_28512":68476,"_19817":116746,"_5":13545,"_25978":116538,"_2758":116747},[],"Todas las releases de Helm",{"_3268":68546,"_28512":68476,"_19817":116749,"_5":13545,"_25978":116538,"_2758":116750},[],"Alta: `helm upgrade` falla",{"_3268":68547,"_28512":68476,"_19817":116752,"_5":13545,"_25978":116538,"_2758":116753},[],"Eliminar o renombrar las claves heredadas",{"_3268":68548,"_28512":68476,"_19817":116755,"_5":13545,"_25978":116538,"_2758":116554},[],{"_3268":68549,"_28512":68476,"_19817":116757,"_5":13545,"_25978":116538,"_2758":116758},[],"Todos los despliegues",{"_3268":68550,"_28512":68476,"_19817":116760,"_5":13545,"_25978":116538,"_2758":116761},[],"Alta: sin principal de bootstrap no hay administrador",{"_3268":68551,"_28512":68476,"_19817":116763,"_5":13545,"_25978":116538,"_2758":116764},[],"Configurar `services.authz`",{"_3268":68552,"_28512":68476,"_19817":116766,"_5":13545,"_25978":116538,"_2758":116558},[],{"_3268":68553,"_28512":68476,"_19817":116768,"_5":13545,"_25978":116538,"_2758":116747},[],{"_3268":68554,"_28512":68476,"_19817":116770,"_5":13545,"_25978":116538,"_2758":116771},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3268":68555,"_28512":68476,"_19817":116773,"_5":13545,"_25978":116538,"_2758":116774},[],"Mover JWKS y roles a `services.authz`",{"_3268":68556,"_28512":68476,"_19817":116776,"_5":13545,"_25978":116538,"_2758":116578},[],{"_3268":68557,"_28512":68476,"_19817":116778,"_5":13545,"_25978":116538,"_2758":116779},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3268":68558,"_28512":68476,"_19817":116781,"_5":13545,"_25978":116538,"_2758":116782},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3268":68559,"_28512":68476,"_19817":116784,"_5":13545,"_25978":116538,"_2758":116785},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3268":68560,"_28512":68476,"_19817":116787,"_5":13545,"_25978":116538,"_2758":116582},[],{"_3268":68561,"_28512":68476,"_19817":116789,"_5":13545,"_25978":116538,"_2758":116790},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3268":68562,"_28512":68476,"_19817":116792,"_5":13545,"_25978":116538,"_2758":116793},[],"Alta: el backend ya no arranca con ellos",{"_3268":68563,"_28512":68476,"_19817":116795,"_5":13545,"_25978":116538,"_2758":116796},[],"Pasar a PostgreSQL antes de actualizar",{"_3268":68564,"_28512":68476,"_19817":116798,"_5":13545,"_25978":116538,"_2758":116799},[],"Webhooks con referencias a archivos",{"_3268":68565,"_28512":68476,"_19817":116801,"_5":13545,"_25978":116538,"_2758":116802},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3268":68566,"_28512":68476,"_19817":116804,"_5":13545,"_25978":116538,"_2758":116805},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3268":68567,"_28512":68476,"_19817":116807,"_5":13545,"_25978":116538,"_2758":116808},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3268":68568,"_28512":68476,"_19817":116810,"_5":13545,"_25978":116538,"_2758":116562},[],{"_3268":68569,"_28512":68476,"_19817":116812,"_5":13545,"_25978":116538,"_2758":116813},[],"Releases con identidades por servicio o material de claves montado",{"_3268":68570,"_28512":68476,"_19817":116815,"_5":13545,"_25978":116538,"_2758":116816},[],"Media: los servicios no pueden leer sus archivos",{"_3268":68571,"_28512":68476,"_19817":116818,"_5":13545,"_25978":116538,"_2758":116819},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3268":68572,"_28512":68476,"_19817":116821,"_5":13545,"_25978":116538,"_2758":116566},[],{"_3268":68573,"_28512":68476,"_19817":116823,"_5":13545,"_25978":116538,"_2758":116824},[],"Releases que definen `amqp.tls`",{"_3268":68574,"_28512":68476,"_19817":116826,"_5":13545,"_25978":116538,"_2758":116827},[],"Media: los clientes se conectan al puerto equivocado",{"_3268":68575,"_28512":68476,"_19817":116829,"_5":13545,"_25978":116538,"_2758":116830},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3268":68576,"_28512":68476,"_19817":116832,"_5":13545,"_25978":116538,"_2758":116586},[],{"_3268":68577,"_28512":68476,"_19817":116834,"_5":13545,"_25978":116538,"_2758":116835},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3268":68578,"_28512":68476,"_19817":116837,"_5":13545,"_25978":116538,"_2758":116838},[],"Media: las claves de CA quedan sin gestionar",{"_3268":68579,"_28512":68476,"_19817":116840,"_5":13545,"_25978":116538,"_2758":116841},[],"Ejecutar la migración de CA a KMS",{"_3268":68580,"_28512":68476,"_19817":116843,"_5":13545,"_25978":116538,"_2758":116844},[],"Verificación del certificado del receptor",{"_3268":68581,"_28512":68476,"_19817":116846,"_5":13545,"_25978":116538,"_2758":116847},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3268":68582,"_28512":68476,"_19817":116849,"_5":13545,"_25978":116538,"_2758":116850},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3268":68583,"_28512":68476,"_19817":116852,"_5":13545,"_25978":116538,"_2758":116853},[],"Poner `insecure_skip_verify` a `false`",{"_3268":68584,"_28512":68476,"_19817":116855,"_5":13545,"_25978":116538,"_2758":116598},[],{"_3268":68585,"_28512":68476,"_19817":116857,"_5":13545,"_25978":116538,"_2758":116858},[],"Scripts y consolas que editan DMS por API",{"_3268":68586,"_28512":68476,"_19817":116860,"_5":13545,"_25978":116538,"_2758":116861},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3268":68587,"_28512":68476,"_19817":116863,"_5":13545,"_25978":116538,"_2758":116864},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3268":68588,"_28512":68476,"_19817":116866,"_5":13545,"_25978":116538,"_2758":116614},[],{"_3268":68589,"_28512":68476,"_19817":116868,"_5":13545,"_25978":116538,"_2758":116869},[],"Consumidores que leen el campo `events` del dispositivo",{"_3268":68590,"_28512":68476,"_19817":116871,"_5":13545,"_25978":116538,"_2758":116872},[],"Media: el campo desaparece",{"_3268":68591,"_28512":68476,"_19817":116874,"_5":13545,"_25978":116538,"_2758":116875},[],"Usar los nuevos endpoints de eventos",{"_3268":68592,"_28512":68476,"_19817":116877,"_5":13545,"_25978":116538,"_2758":116570},[],{"_3268":68593,"_28512":68476,"_19817":116879,"_5":13545,"_25978":116538,"_2758":116880},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3268":68594,"_28512":68476,"_19817":116882,"_5":13545,"_25978":116538,"_2758":116883},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3268":68595,"_28512":68476,"_19817":116885,"_5":13545,"_25978":116538,"_2758":116886},[],"Actualizar el archivo de values",{"_3268":68596,"_28512":68476,"_19817":116888,"_5":13545,"_25978":116538,"_2758":116606},[],{"_3268":68597,"_28512":68476,"_19817":116890,"_5":13545,"_25978":116538,"_2758":116891},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3268":68598,"_28512":68476,"_19817":116893,"_5":13545,"_25978":116538,"_2758":116894},[],"Baja: prevalece el ID de la URL",{"_3268":68599,"_28512":68476,"_19817":116896,"_5":13545,"_25978":116538,"_2758":116897},[],"Enviar el ID en la URL",{"_3268":68600,"_28512":68476,"_19817":116899,"_5":13545,"_25978":116538,"_2758":116610},[],{"_3268":68601,"_28512":68476,"_19817":116901,"_5":13545,"_25978":116538,"_2758":116902},[],"Consumidores que comparan el `type` del certificado",{"_3268":68602,"_28512":68476,"_19817":116904,"_5":13545,"_25978":116538,"_2758":116905},[],"Baja: dos valores cambian de nombre",{"_3268":68603,"_28512":68476,"_19817":116907,"_5":13545,"_25978":116538,"_2758":116908},[],"Adaptar los consumidores",{"_3268":68604,"_28512":68476,"_19817":116910,"_5":13545,"_25978":116538,"_2758":116602},[],{"_3268":68605,"_28512":68476,"_19817":116912,"_5":13545,"_25978":116538,"_2758":116913},[],"Cualquier DMS",{"_3268":68606,"_28512":68476,"_19817":116915,"_5":13545,"_25978":116538,"_2758":116916},[],"Baja: solo informativo",{"_3268":68607,"_28512":68476,"_19817":116918,"_5":13545,"_25978":116538,"_2758":116919},[],"Revisar ambos bloques antes de editar",{"_3268":68608,"_28512":68476,"_19817":116921,"_5":13545,"_25978":116545,"_2758":116922},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3268":68609,"_28512":68476,"_19817":116924,"_5":13545,"_25978":116545,"_2758":116925},[],"El paso 4 de la guía de migración copia los datos.",{"_3268":68610,"_28512":68476,"_19817":116927,"_5":13545,"_25978":116549,"_2758":116928},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3268":68611,"_28512":68476,"_19817":116930,"_5":13545,"_25978":116553,"_2758":116931},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3268":68612,"_28512":68476,"_19817":116933,"_5":13545,"_25978":116557,"_2758":116934},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3268":68613,"_28512":68476,"_19817":116936,"_5":13545,"_25978":116561,"_2758":116937},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3268":68614,"_28512":68476,"_19817":116939,"_5":13545,"_25978":116561,"_2758":116940},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3268":68615,"_28512":68476,"_19817":116942,"_5":13545,"_25978":116565,"_2758":116943},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3268":68616,"_28512":68476,"_19817":116945,"_5":13545,"_25978":116569,"_2758":116946},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3268":68617,"_28512":68476,"_19817":116948,"_5":13545,"_25978":116569,"_2758":116949},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3268":68618,"_28512":68476,"_19817":116951,"_5":13545,"_25978":116569,"_2758":116952},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3268":68619,"_28512":68476,"_19817":116954,"_5":13545,"_25978":116569,"_2758":116955},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3268":68620,"_28512":68476,"_19817":116957,"_5":13545,"_25978":116569,"_2758":116958},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3268":68621,"_28512":68476,"_19817":116960,"_5":13545,"_25978":116569,"_2758":116961},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3268":68622,"_28512":68476,"_19817":116963,"_5":13545,"_25978":116577,"_2758":116964},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3268":68623,"_28512":68476,"_19817":116966,"_5":13545,"_25978":116577,"_2758":116967},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3268":68624,"_28512":68476,"_19817":116969,"_5":13545,"_25978":116577,"_2758":116970},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3268":68625,"_28512":68476,"_19817":116972,"_5":13545,"_25978":116577,"_2758":116973},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3268":68626,"_28512":68476,"_19817":116975,"_5":13545,"_25978":116577,"_2758":116976},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3268":68627,"_28512":68476,"_19817":116978,"_5":13545,"_25978":116581,"_2758":116979},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3268":68628,"_28512":68476,"_19817":116981,"_5":13545,"_25978":116585,"_2758":116982},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3268":68629,"_28512":68476,"_19817":116984,"_5":13545,"_25978":116585,"_2758":116985},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3268":68630,"_28512":68476,"_19817":116987,"_5":13545,"_25978":116585,"_2758":116988},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3268":68631,"_28512":68476,"_19817":116990,"_5":13545,"_25978":116585,"_2758":116991},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3268":68632,"_28512":68476,"_19817":116993,"_5":13545,"_25978":116585,"_2758":116994},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3268":68633,"_28512":68476,"_19817":116996,"_5":13545,"_25978":116585,"_2758":116997},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3268":68634,"_28512":68476,"_19817":116999,"_5":13545,"_25978":116593,"_2758":117000},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3268":68635,"_28512":68476,"_19817":117002,"_5":13545,"_25978":116593,"_2758":117003},[],"Campo en 3.8.0",{"_3268":68636,"_28512":68476,"_19817":117005,"_5":13545,"_25978":116593,"_2758":117006},[],"Campo en 4.0.0",{"_3268":68637,"_28512":68476,"_19817":117008,"_5":13545,"_25978":116593,"_2758":54759},[],{"_3268":68638,"_28512":68476,"_19817":117010,"_5":13545,"_25978":116593,"_2758":117011},[],"`insecure_skip_verify` (con el valor negado)",{"_3268":68639,"_28512":68476,"_19817":117013,"_5":13545,"_25978":116593,"_2758":54765},[],{"_3268":68640,"_28512":68476,"_19817":117015,"_5":13545,"_25978":116593,"_2758":54768},[],{"_3268":68641,"_28512":68476,"_19817":117017,"_5":13545,"_25978":116593,"_2758":54771},[],{"_3268":68642,"_28512":68476,"_19817":117019,"_5":13545,"_25978":116593,"_2758":54774},[],{"_3268":68643,"_28512":68476,"_19817":117021,"_5":13545,"_25978":116593,"_2758":54777},[],{"_3268":68644,"_28512":68476,"_19817":117023,"_5":13545,"_25978":116593,"_2758":54780},[],{"_3268":68645,"_28512":68476,"_19817":117025,"_5":13545,"_25978":116593,"_2758":117026},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3268":68646,"_28512":68476,"_19817":117028,"_5":13545,"_25978":116593,"_2758":117029},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3268":68647,"_28512":68476,"_19817":117031,"_5":13545,"_25978":116593,"_2758":117032},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3268":68648,"_28512":68476,"_19817":117034,"_5":13545,"_25978":116597,"_2758":117035},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3268":68649,"_28512":68476,"_19817":117037,"_5":13545,"_25978":116597,"_2758":117038},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3268":68650,"_28512":68476,"_19817":117040,"_5":13545,"_25978":116597,"_2758":117041},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3268":68651,"_28512":68476,"_19817":117043,"_5":13545,"_25978":116601,"_2758":117044},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3268":68652,"_28512":68476,"_19817":117046,"_5":13545,"_25978":116605,"_2758":117047},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3268":68653,"_28512":68476,"_19817":117049,"_5":13545,"_25978":116609,"_2758":117050},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3268":68654,"_28512":68476,"_19817":117052,"_5":13545,"_25978":116613,"_2758":117053},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3268":68655,"_28512":68476,"_19817":117055,"_5":13545,"_25978":116613,"_2758":117056},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3268":68656,"_28512":68476,"_19817":117058,"_5":13545,"_25978":116613,"_2758":117059},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3268":68657,"_28512":68476,"_19817":117061,"_5":13545,"_25978":116613,"_2758":117062},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3268":68658,"_28512":68476,"_19817":117064,"_5":13545,"_25978":116617,"_2758":117065},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3268":68659,"_28512":68476,"_19817":117067,"_5":13545,"_25978":116621,"_2758":117068},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3268":68660,"_28512":68476,"_19817":117070,"_5":13545,"_25978":116621,"_2758":117071},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3268":68661,"_28512":68476,"_19817":117073,"_5":13545,"_25978":116621,"_2758":117074},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3268":68662,"_28512":68476,"_19817":117076,"_5":13545,"_25978":116621,"_2758":117077},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3268":68663,"_28512":68476,"_19817":117079,"_5":13545,"_25978":116621,"_2758":117080},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3268":68664,"_28512":68476,"_19817":117082,"_5":13545,"_25978":116625,"_2758":117083},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3268":68665,"_28512":68476,"_19817":117085,"_5":13545,"_25978":116625,"_2758":117086},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3268":68666,"_28512":68476,"_19817":117088,"_5":13545,"_25978":116625,"_2758":117089},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3268":68667,"_28512":68476,"_19817":117091,"_5":13545,"_25978":116625,"_2758":117092},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3268":68668,"_28512":68476,"_19817":117094,"_5":13545,"_25978":116625,"_2758":117095},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3268":68669,"_28512":68476,"_19817":117097,"_5":13545,"_25978":116625,"_2758":117098},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3268":68670,"_28512":68476,"_19817":117100,"_5":13545,"_25978":116625,"_2758":117101},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3268":68671,"_28512":68476,"_19817":117103,"_5":13545,"_25978":116625,"_2758":117104},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3268":68672,"_28512":68476,"_19817":117106,"_5":13545,"_25978":116625,"_2758":117107},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3268":68673,"_28512":68476,"_19817":117109,"_5":13545,"_25978":116625,"_2758":117110},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3268":68674,"_28512":68476,"_19817":117112,"_5":13545,"_25978":116625,"_2758":117113},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3268":68675,"_28512":68476,"_19817":117115,"_5":13545,"_25978":116625,"_2758":117116},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3268":68676,"_28512":68476,"_19817":117118,"_5":13545,"_25978":116629,"_2758":117119},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3268":68677,"_28512":68476,"_19817":117121,"_5":13545,"_25978":116629,"_2758":117122},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3268":68678,"_28512":68476,"_19817":117124,"_5":13545,"_25978":116633,"_2758":117125},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3268":68679,"_28512":68476,"_19817":117127,"_5":13545,"_25978":116633,"_2758":117128},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3268":68680,"_28512":68476,"_19817":117130,"_5":13545,"_25978":116633,"_2758":117131},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3268":68681,"_28512":68476,"_19817":117133,"_5":13545,"_25978":116633,"_2758":117134},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3268":68682,"_28512":68476,"_19817":117136,"_5":13545,"_25978":116633,"_2758":117137},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3268":68683,"_28512":68476,"_19817":117139,"_5":13545,"_25978":116633,"_2758":117140},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3268":68684,"_28512":68476,"_19817":117142,"_5":13545,"_25978":116633,"_2758":117143},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3268":68685,"_28512":68476,"_19817":117145,"_5":13545,"_25978":116633,"_2758":117146},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3268":68686,"_28512":68476,"_19817":117148,"_5":13545,"_25978":116633,"_2758":117149},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3268":68687,"_28512":68476,"_19817":117151,"_5":13545,"_25978":116633,"_2758":117152},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3268":68688,"_28512":68476,"_19817":117154,"_5":13545,"_25978":116633,"_2758":117155},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3268":68689,"_28512":68476,"_19817":117157,"_5":13545,"_25978":116637,"_2758":117158},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3268":68690,"_28512":68476,"_19817":117160,"_5":13545,"_25978":116637,"_2758":117161},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3268":68691,"_28512":68476,"_19817":117163,"_5":13545,"_25978":116641,"_2758":117164},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3268":68692,"_28512":68476,"_19817":117166,"_5":13545,"_25978":116641,"_2758":117167},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3268":68693,"_28512":68476,"_19817":117169,"_5":13545,"_25978":116641,"_2758":117170},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3268":68694,"_28512":68476,"_19817":117172,"_5":13545,"_25978":116641,"_2758":117173},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3268":68695,"_28512":68476,"_19817":117175,"_5":13545,"_25978":116641,"_2758":117176},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3268":68696,"_28512":68476,"_19817":117178,"_5":13545,"_25978":116645,"_2758":117179},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3268":68697,"_28512":68476,"_19817":117181,"_5":13545,"_25978":116645,"_2758":117182},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3268":68698,"_28512":68476,"_19817":117184,"_5":13545,"_25978":116645,"_2758":117185},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3268":68699,"_28512":68476,"_19817":117187,"_5":13545,"_25978":116645,"_2758":117188},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3268":68700,"_28512":68476,"_19817":117190,"_5":13545,"_25978":116645,"_2758":117191},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3268":68701,"_28512":68476,"_19817":117193,"_5":13545,"_25978":116645,"_2758":117194},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3268":68702,"_28512":68476,"_19817":117196,"_5":13545,"_25978":116645,"_2758":117197},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3268":68703,"_28512":68476,"_19817":117199,"_5":13545,"_25978":116648,"_2758":117200},[],"Tras la actualización, comprueba en este orden:",{"_3268":68704,"_28512":68476,"_19817":117202,"_5":13545,"_25978":116648,"_2758":117203},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3268":68705,"_28512":68476,"_19817":117205,"_5":13545,"_25978":116648,"_2758":117206},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3268":68706,"_28512":68476,"_19817":117208,"_5":13545,"_25978":116648,"_2758":117209},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3268":68707,"_28512":68476,"_19817":117211,"_5":13545,"_25978":116648,"_2758":117212},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3268":68708,"_28512":68476,"_19817":117214,"_5":13545,"_25978":116648,"_2758":117215},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3268":68709,"_28512":68476,"_19817":117217,"_5":13545,"_25978":116648,"_2758":117218},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3268":68710,"_28512":68476,"_19817":117220,"_5":13545,"_25978":116648,"_2758":117221},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3268":68711,"_28512":68476,"_19817":117223,"_5":13545,"_25978":116648,"_2758":117224},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3268":68712,"_28512":68476,"_19817":117226,"_5":13545,"_25978":116648,"_2758":117227},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3268":68713,"_28512":68476,"_19817":117229,"_5":13545,"_25978":116648,"_2758":117230},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3268":68714,"_28512":68476,"_19817":117232,"_5":13545,"_25978":116648,"_2758":117233},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3268":68715,"_28512":68476,"_19817":117235,"_5":13545,"_25978":116648,"_2758":117236},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3268":68716,"_28512":68476,"_19817":117238,"_5":13545,"_25978":116648,"_2758":117239},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3268":68717,"_28512":68476,"_19817":117241,"_5":13545,"_25978":116648,"_2758":117242},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3268":68718,"_28512":68476,"_19817":117244,"_5":13545,"_25978":116652,"_2758":117245},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3268":68719,"_28512":68476,"_19817":117247,"_5":13545,"_25978":116652,"_2758":117248},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3268":68720,"_28512":68476,"_19817":117250,"_5":13545,"_25978":116652,"_2758":117251},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3268":68721,"_28512":68476,"_19817":117253,"_5":13545,"_25978":116652,"_2758":117254},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3268":68722,"_28512":68476,"_19817":117256,"_5":13545,"_25978":116652,"_2758":117257},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_55017":117259,"_55019":117260,"_55021":117261,"_55023":117262,"_17228":2780,"_65994":2780},"spanish",[2758,28512,5,25978],{"_2758":23674,"_28512":23674,"_5":23674,"_25978":23674},{"_2758":117263,"_28512":119988,"_5":122713,"_25978":125438},{"_4377":117264,"_55027":117265,"_5":23674},{"_13600":10935,"_13976":3065,"_13995":6732,"_12202":14886,"_13982":5572,"_18810":12469,"_13621":9016,"_13628":4356,"_27551":10700,"_27942":3158,"_27963":4360,"_27569":4680,"_32690":11494,"_27974":23508,"_28003":2798,"_32697":28041,"_32700":6124,"_32703":6556,"_32706":17169,"_28349":10658,"_32711":4812,"_32713":7092,"_28379":20602,"_13991":6592,"_32717":6721,"_32720":3054,"_32722":7009,"_27992":7534,"_28344":15632,"_28392":6547,"_32727":4126,"_32729":3143,"_32731":9576,"_32733":21641,"_32735":3233,"_32737":3808,"_32739":10669,"_32741":4139,"_32743":5214,"_27621":7174,"_32746":19480,"_32748":2940,"_27615":3195,"_32751":16246,"_32753":3912,"_32755":5285,"_32758":4556,"_27661":7087,"_32762":23243,"_27542":3777,"_32765":2898,"_27574":5075,"_32768":3338,"_32770":7204,"_32773":9013,"_13985":9337,"_32776":5239,"_32778":22508,"_32781":3180,"_32783":6510,"_32785":7183,"_32787":6895,"_32789":7184,"_18813":4846,"_32792":23682,"_32794":3000,"_27595":11574,"_27986":7113,"_32798":8121,"_32800":4327,"_32802":6264,"_28409":5184,"_32805":13756,"_32807":3769,"_32809":9732,"_28492":13195,"_28019":3355,"_32813":14243,"_32815":3052,"_27584":5241,"_32818":4220,"_32820":5187,"_32822":3851,"_28425":6537,"_27681":6531,"_27031":15626,"_32827":15867,"_32829":3045,"_32831":4528,"_27718":4459,"_32835":3169,"_27980":5861,"_32839":3356,"_32841":4951,"_32843":3135,"_32845":3067,"_32847":6156,"_32849":6495